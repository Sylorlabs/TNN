// r0_smoke.zag — M8 smoke driver for the R0 core.
// Usage: r0_smoke <leg> <perturb>
//   leg: 0 = recovered-parameter leg, 1 = re-derived leg (R-7 test-both).
//   perturb: 0..4 adversarial allocation-perturbation modes.
// Prints canonical summary lines. Byte-identical stdout across perturb modes
// 0..4 (per leg) is the M8 smoke bar. Zero RNG, no I/O, no clock reads.

@import("r0_core.zag")

fn pstr(s:[]u8)void { _zag_print(s); }
fn pnum(v:i32)void { _zag_print(_zag_i64_to_str(v as i64)); }
fn pline2(label:[]u8, v:i32)void { pstr(label); pnum(v); pstr("\n"); }

// Adversarial allocation perturbations. These only rearrange heap state;
// the core never reads addresses or uninitialized memory, so all modes must
// produce byte-identical output.
fn r0_perturb(mode:i32)void {
    if(mode==1){
        // pre-fragmentation: interleaved alloc/free with 8 live handles
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(128);
        let a2:[]i32=zalloc_i(32); let a3:[]i32=zalloc_i(256);
        let a4:[]i32=zalloc_i(48); let a5:[]i32=zalloc_i(96);
        let a6:[]i32=zalloc_i(160); let a7:[]i32=zalloc_i(24);
        a0[0]=1; a3[0]=2; a6[0]=3;
        zfree_i(a1); zfree_i(a4); zfree_i(a6);
        let b0:[]i32=zalloc_i(200); let b1:[]i32=zalloc_i(40);
        b0[0]=4; b1[0]=5;
        zfree_i(a0); zfree_i(b0);
        zfree_i(a2); zfree_i(a3); zfree_i(a5); zfree_i(a7); zfree_i(b1);
    } else if(mode==2){
        // free-list order reversal: free LIFO instead of FIFO
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(64);
        let a2:[]i32=zalloc_i(64); let a3:[]i32=zalloc_i(64);
        let a4:[]i32=zalloc_i(64); let a5:[]i32=zalloc_i(64);
        a0[0]=1; a1[0]=2; a2[0]=3; a3[0]=4; a4[0]=5; a5[0]=6;
        zfree_i(a5); zfree_i(a4); zfree_i(a3);
        zfree_i(a2); zfree_i(a1); zfree_i(a0);
    } else if(mode==3){
        // large transient heap pressure (stack-offset analogue)
        let big:[]i32=zalloc_i(65536);
        let i:i32=0;
        while(i<65536){ big[i]=i & 255; i=i+1024; }
        zfree_i(big);
        let s1:[]i32=zalloc_i(13); s1[0]=7; zfree_i(s1);
    }
    // mode 0: clean. mode 4: mid-run churn, handled in main.
}

fn r0_churn()void {
    let a0:[]i32=zalloc_i(512); let a1:[]i32=zalloc_i(17);
    a0[0]=9; a1[0]=8;
    zfree_i(a0);
    let b0:[]i32=zalloc_i(300); b0[0]=7;
    zfree_i(a1); zfree_i(b0);
    let c0:[]i32=zalloc_i(1024); c0[0]=6; zfree_i(c0);
}

fn append_lit(seq:[]i32, w:*i32, lit:[]u8)void {
    let i:i32=0;
    while(i<lit.len){ seq[w.*]=lit[i] as i32; w.*=w.*+1; i=i+1; }
}

// Build deterministic corpus: repeated text-like + code-like + noise tail.
fn build_corpus(seq:[]i32)i32 {
    let w:i32=0;
    let r:i32=0;
    while(r<12){ append_lit(seq,&w,"the cat sat "); r=r+1; }
    r=0;
    while(r<12){ append_lit(seq,&w,"on the mat. "); r=r+1; }
    r=0;
    while(r<10){ append_lit(seq,&w,"r0(x)=x+1;"); r=r+1; }
    let b:i32=128;
    while(b<192){ seq[w]=b; w=w+1; b=b+1; }
    return w;
}

// Observe pass with online smoke-grade grounded labels (documented stand-in;
// the battery harness implements the full R-1 probe-episode protocol):
//   bit0 = 1 iff span re-encountered (recall-success proxy)
//   bit1 = 1 iff continuation already varies (discrimination proxy)
fn observe_labeled(st:[]i32, seq:[]i32, n:i32)i32 {
    let total:i32=0;
    let pos:i32=0;
    while(pos<n){
        let len:i32=2;
        while(len<=8 && pos+len<=n){
            let nb:i32=-1;
            if(pos+len<n){nb=seq[pos+len] & 255;}
            let p:i32=r0_find_proposal(st,seq,pos,len);
            let bit0:i32=0;
            let bit1:i32=0;
            if(p>=0){
                if(r0_proposal_seen(st,p)>=1){bit0=1;}
                let cb:i32=r0_proposal_contb(st,p);
                if(cb>=0 && cb!=nb){bit1=1;}
            }
            r0_observe_span(st,seq,pos,len,bit0+bit1*2,nb);
            total=total+1;
            len=len+1;
        }
        pos=pos+1;
    }
    r0_ledger_emit(st,R0_OP_OBSERVE,0,0, n,total,0,0,0, 0,0,0,0,0,
        R0_STAGE_SENSOR,seq[0] & 255,seq[n-1] & 255);
    return total;
}

fn bank_hash(st:[]i32)i32 {
    let h:i64=2166136261;
    let n:i32=r0_chunk_count(st);
    let tmp:[]i32=zalloc_i(8);
    let id:i32=0;
    while(id<n){
        if(r0_chunk_state(st,id)==1){
            let ln:i32=r0_chunk_bytes(st,id,tmp,8);
            h=(h ^ (ln as i64))*16777619; h=h & 4294967295;
            let i:i32=0;
            while(i<ln){ h=(h ^ ((tmp[i] & 255) as i64))*16777619; h=h & 4294967295; i=i+1; }
        }
        id=id+1;
    }
    zfree_i(tmp);
    return (h & 2147483647) as i32;
}

fn main()i32 {
    let leg:i32=0;
    if(_zag_argc()>1){ let a:[]u8=_zag_arg(1); if(a.len>0 && a[0]==49){leg=1;} }
    let pert:i32=0;
    if(_zag_argc()>2){ let a:[]u8=_zag_arg(2); if(a.len>0){pert=(a[0] as i32)-48;} }
    if(pert<0 || pert>4){pert=0;}

    r0_perturb(pert);

    // ---- Arena A: main pipeline ----
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);

    let cap:i32=1024;
    let seq:[]i32=zalloc_i(cap);
    let n:i32=build_corpus(seq);
    let spans:i32=observe_labeled(st,seq,n);

    let idx:[]i32=zalloc_i(4096);
    let promoted:i32=r0_promote(st,idx);

    if(pert==4){ r0_churn(); } // mid-run adversarial churn

    let out_id:[]i32=zalloc_i(cap);
    let out_st:[]i32=zalloc_i(cap);
    let out_ln:[]i32=zalloc_i(cap);
    let nout:i32=r0_segment(st,seq,n,out_id,out_st,out_ln,cap);

    let rec:[]i32=zalloc_i(cap);
    let nrec:i32=r0_reconstruct(st,out_id,nout,rec,cap);
    let rt:i32=0;
    if(nrec==n){
        rt=1;
        let i:i32=0;
        while(i<n){ if(rec[i]!=seq[i]){rt=0;i=n;} else {i=i+1;} }
    }

    // dual route: delayed downstream evidence shifts trust
    let cs:i32=0;
    let i:i32=0;
    while(i<nout){ if(out_id[i]>=0){cs=cs+10;} i=i+1; }
    let ds0:i32=r0_dual_score(st,cs,n,0,0);
    r0_dual_trust_update(st,1,1,1,100);
    r0_dual_trust_update(st,1,1,1,100);
    r0_dual_trust_update(st,1,1,1,100);
    r0_dual_trust_update(st,0,1,0,100);
    r0_dual_trust_update(st,0,1,0,100);
    let ds1:i32=r0_dual_score(st,cs,n,0,0);
    let rawq:i32=r0_should_retrieve_raw(0,0,900,100,500);

    pstr("R0_SMOKE,leg="); pnum(leg); pstr(",perturb="); pnum(pert); pstr("\n");
    pline2("SPANS,",spans);
    pline2("PROMOTED,",promoted);
    pline2("SEGMENTED,",nout);
    pline2("ROUNDTRIP,",rt);
    pline2("DUALSCORE0,",ds0);
    pline2("WCHUNK,",r0_w_chunk(st));
    pline2("WRAW,",r0_w_raw(st));
    pline2("DUALSCORE1,",ds1);
    pline2("RETRIEVE_RAW,",rawq);
    pline2("LIVE,",r0_live_count(st));
    pline2("TOMBRATIO,",r0_tombstone_ratio1000(st));
    pline2("BANKHASH,",bank_hash(st));
    pline2("LEDGER,",r0_ledger_count(st));
    pline2("LEDGERHASH,",r0_ledger_hash(st));

    // ---- Arena B: constructed dynamics (split/merge/support-gap) ----
    let b:[]i32=zalloc_i(r0_arena_words());
    r0_init(b,leg);
    // split candidate: 8-span observed 6x with divergent labels
    // labels {3,3,0,1,2,3}: RD purity 3/6=500>=400, conflict 500>=500;
    //                        REC purity 500>=340, conflict 500>=400.
    let s1:[]i32=zalloc_i(8);
    let lit:[]u8="splitchk";
    i=0; while(i<8){s1[i]=lit[i] as i32; i=i+1;}
    let labset:[]i32=zalloc_i(6);
    labset[0]=3; labset[1]=3; labset[2]=0; labset[3]=1; labset[4]=2; labset[5]=3;
    i=0;
    while(i<6){ r0_observe_span(b,s1,0,8,labset[i],-1); i=i+1; }
    let bidx:[]i32=zalloc_i(4096);
    let bp:i32=r0_promote(b,bidx);
    // use it 3x
    let use3:[]i32=zalloc_i(24);
    i=0; while(i<24){use3[i]=s1[i & 7]; i=i+1;}
    let uid:[]i32=zalloc_i(24); let ust:[]i32=zalloc_i(24); let uln:[]i32=zalloc_i(24);
    r0_segment(b,use3,24,uid,ust,uln,24);
    // drive utility below floor
    let split_id:i32=-1;
    if(bp>0){
        let target:i32=r0_chunk_count(b)-1;
        r0_regret_update(b,target,0,0,2000);
        r0_regret_update(b,target,0,0,2000);
        r0_regret_update(b,target,0,0,2000);
        split_id=r0_maybe_split(b,target);
    }
    pline2("SPLIT_FIRED,",split_id);
    if(split_id>=0){
        pline2("SPLIT_PARENT_SUCC,",r0_chunk_succ(b,r0_chunk_count(b)-2));
    }
    // merge candidates: two 4-spans, pair seen 8x
    let ma:[]i32=zalloc_i(4); let mb:[]i32=zalloc_i(4);
    let la:[]u8="mgaa"; let lb:[]u8="mgbb";
    i=0; while(i<4){ma[i]=la[i] as i32; mb[i]=lb[i] as i32; i=i+1;}
    i=0; while(i<6){r0_observe_span(b,ma,0,4,3,-1); i=i+1;}
    i=0; while(i<6){r0_observe_span(b,mb,0,4,3,-1); i=i+1;}
    r0_promote(b,bidx);
    let aid:i32=r0_chunk_count(b)-2;
    let bid2:i32=r0_chunk_count(b)-1;
    i=0; while(i<8){r0_observe_pair(b,aid,bid2); i=i+1;}
    let mid:i32=r0_maybe_merge(b,aid,bid2);
    pline2("MERGE_FIRED,",mid);
    if(mid>=0){
        pline2("MERGE_SUCC_A,",r0_chunk_succ(b,aid));
        pline2("MERGE_SUCC_B,",r0_chunk_succ(b,bid2));
        r0_learn_thresholds(b,1,0);
        r0_learn_thresholds(b,0,1);
    }
    // support-gap: stream = merged(8) + qqqqqq(6, unsupported) + merged(8)
    let sg:[]i32=zalloc_i(64);
    let sw:i32=0;
    let mtmp:[]i32=zalloc_i(8);
    if(mid>=0){ r0_chunk_bytes(b,mid,mtmp,8); }
    i=0; while(i<8){sg[sw]=mtmp[i]; sw=sw+1; i=i+1;}
    i=0; while(i<6){sg[sw]=113; sw=sw+1; i=i+1;} // 'q'
    i=0; while(i<8){sg[sw]=mtmp[i]; sw=sw+1; i=i+1;}
    // observe the recruit stream 4x so the gap span has support
    i=0;
    while(i<4){
        let p2:i32=0;
        while(p2<sw){
            let l2:i32=2;
            while(l2<=8 && p2+l2<=sw){ r0_observe_span(b,sg,p2,l2,3,113); l2=l2+1; }
            p2=p2+1;
        }
        i=i+1;
    }
    let rid:i32=r0_support_gap_recruit(b,sg,sw);
    pline2("RECRUIT,",rid);
    // negative control: fully covered stream -> abstain
    let fc:[]i32=zalloc_i(16);
    i=0; while(i<16){fc[i]=mtmp[i & 7]; i=i+1;}
    let abst:i32=r0_support_gap_recruit(b,fc,16);
    pline2("ABSTAIN,",abst);
    pline2("B_LIVE,",r0_live_count(b));
    pline2("B_TOMBRATIO,",r0_tombstone_ratio1000(b));
    pline2("B_LEDGER,",r0_ledger_count(b));
    pline2("B_LEDGERHASH,",r0_ledger_hash(b));

    pstr("R0_SMOKE_DONE\n");

    zfree_i(st); zfree_i(b);
    zfree_i(seq); zfree_i(idx); zfree_i(out_id); zfree_i(out_st); zfree_i(out_ln);
    zfree_i(rec); zfree_i(s1); zfree_i(labset); zfree_i(bidx);
    zfree_i(use3); zfree_i(uid); zfree_i(ust); zfree_i(uln);
    zfree_i(ma); zfree_i(mb); zfree_i(sg); zfree_i(mtmp); zfree_i(fc);
    return 0;
}

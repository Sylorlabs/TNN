// bt5_roundtrip.zag — B-T5 LITERAL same-material split-then-remerge proof.
// MARATHON CREW 5. Track R0, prereg units/PREREG_FREEZE.md §2 FROZEN (1x, R-9).
//
// Coordinator rejection of the B-DYNSG PASS: that battery's split fired on
// chunk "splitchk" (id 0) while its merge fired on DIFFERENT material
// ("AAAA"+"BBBB", ids 1+2). The frozen bar's parenthetical requires the SAME
// material: "a recruited chunk split then re-merged on the record."
//
// This battery constructs the literal round-trip against the frozen R0 core
// (r0_maybe_split / r0_maybe_merge — the actual B-T5 mechanism under test):
//   1. Recruit material M ("splitchk", 8 bytes) as a live chunk; snapshot the
//      original bytes BEFORE any revision.
//   2. Drive the recovered split conditions
//      (use_count>=3 AND conflict>=learned_conflict AND utility<=learned_floor)
//      and fire r0_maybe_split on the chunk.
//   3. Observe the split's own halves as a pair past the learned pair_seen bar
//      and fire r0_maybe_merge on (parent, child) and (child, parent).
//   4. Byte-compare any merged chunk against the original snapshot.
// Verdict rule (no reinterpretation): PASS iff a merged chunk is minted whose
// bytes are byte-identical to the original material. Anything else is FAIL.
//
// Controls:
//   RT-2 prefix-shadow: after the split, the prefix half can never be recruited
//      live again (tombstoned record shadows it) — the mechanism-level reason
//      the re-merge has no live halves to work with.
//   RT-3 merge-alone: two live halves ("spli"+"tchk") merge byte-exact on both
//      legs — proves the merge op itself is sound and the gain conjunct is
//      satisfiable at pair_seen=6, isolating the FAIL to split->merge
//      composition (tombstoning first, regret arithmetic second).
//
// Pure Zag. Zero RNG in AI decision paths. Byte-identical reruns (N=5 perturb
// modes per leg; logs diffed).
// Build: znc bt5_roundtrip.zag -o <out> --no-zagd --no-analyze --no-foreground-cache
// Usage: bt5_roundtrip <leg 0|1> <perturb 0..4>
@import("../core/r0_core.zag")
@import("../core/r0_probe.zag")
@import("../harness/m8_armor.zag")

const RT_LEDGER_BASE:i32=91168;
const RT_LEDGER_STRIDE:i32=64;
const RT_BANK_WORDS:i32=19456;
const RT_HDR_WORDS:i32=32;

fn rt_out(s:[]u8)void { _zag_print(s); }
fn rt_num(v:i32)void { _zag_print(_zag_i64_to_str(v as i64)); }
fn rt_kv(k:[]u8,v:i32)void { rt_out(k); rt_num(v); rt_out("\n"); }
fn rt_expect(f:*i32, cond:i32)void { if(cond==0){ f.*=f.*+1; } }

// Adversarial allocation perturbations (same idiom as the B5 battery:
// heap-state only — the core never reads allocator state, so all modes must
// produce byte-identical battery output).
fn rt_perturb(mode:i32)void {
    if(mode==1){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(128);
        let a2:[]i32=zalloc_i(32); let a3:[]i32=zalloc_i(256);
        let a4:[]i32=zalloc_i(48); let a5:[]i32=zalloc_i(96);
        let a6:[]i32=zalloc_i(160); let a7:[]i32=zalloc_i(24);
        a0[0]=1; a3[0]=2; a6[0]=3;
        zfree_i(a1); zfree_i(a4); zfree_i(a6);
        let b0:[]i32=zalloc_i(200); let b1:[]i32=zalloc_i(40);
        b0[0]=4; b1[0]=5;
        zfree_i(a0); zfree_i(b0);
        zfree_i(a2); zfree_i(a3); zfree_i(a5); zfree_i(a7); zfree_i(b1);
    } else if(mode==2){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(64);
        let a2:[]i32=zalloc_i(64); let a3:[]i32=zalloc_i(64);
        let a4:[]i32=zalloc_i(64); let a5:[]i32=zalloc_i(64);
        a0[0]=1; a1[0]=2; a2[0]=3; a3[0]=4; a4[0]=5; a5[0]=6;
        zfree_i(a5); zfree_i(a4); zfree_i(a3);
        zfree_i(a2); zfree_i(a1); zfree_i(a0);
    } else if(mode==3){
        let big:[]i32=zalloc_i(65536);
        let i:i32=0;
        while(i<65536){ big[i]=i & 255; i=i+1024; }
        zfree_i(big);
        let s1:[]i32=zalloc_i(13); s1[0]=7; zfree_i(s1);
    }
}
fn rt_churn()void {
    let a0:[]i32=zalloc_i(512); let a1:[]i32=zalloc_i(17);
    a0[0]=9; a1[0]=8;
    zfree_i(a0);
    let b0:[]i32=zalloc_i(300); b0[0]=7;
    zfree_i(a1); zfree_i(b0);
    let c0:[]i32=zalloc_i(1024); c0[0]=6; zfree_i(c0);
}

fn rt_fill(seq:[]i32, lit:[]u8)void {
    let i:i32=0; while(i<lit.len){ seq[i]=lit[i] as i32; i=i+1; }
}
fn rt_fill_rep(seq:[]i32, lit:[]u8, reps:i32)void {
    let w:i32=0; let r:i32=0;
    while(r<reps){
        let i:i32=0;
        while(i<lit.len){ seq[w]=lit[i] as i32; w=w+1; i=i+1; }
        r=r+1;
    }
}
// Observe one span `times` times, cycling through labels[0..nlab).
fn rt_observe_span_n(st:[]i32, seq:[]i32, n:i32, labels:[]i32, nlab:i32, times:i32)void {
    let t:i32=0;
    while(t<times){ r0_observe_span(st,seq,0,n,labels[t % nlab],-1); t=t+1; }
}
// Drive a chunk's utility to/below the learned floor (0, both legs) via
// delayed regret. Returns the iteration count; each iteration adds exactly
// 2000 to the chunk's separate-regret word (base+6), which the merge gate
// later reads. Bounded loop; deterministic.
fn rt_drive_utility_down(st:[]i32, id:i32)i32 {
    let guard:i32=0;
    while(r0_chunk_utility(st,id)>0 && guard<40){
        r0_regret_update(st,id,0,0,2000);
        guard=guard+1;
    }
    return guard;
}
// Find a LIVE chunk whose bytes equal lit; -1 if none.
fn rt_find_live(st:[]i32, lit:[]u8)i32 {
    let count:i32=r0_chunk_count(st);
    let id:i32=0;
    while(id<count){
        if(r0_chunk_state(st,id)==1 && r0_chunk_len(st,id)==lit.len){
            let tmp:[]i32=zalloc_i(8);
            let got:i32=r0_chunk_bytes(st,id,tmp,8);
            let same:i32=1;
            if(got!=lit.len){ same=0; } else {
                let i:i32=0;
                while(i<got){
                    if(tmp[i]!=(lit[i] as i32)){ same=0; i=got; } else { i=i+1; }
                }
            }
            zfree_i(tmp);
            if(same==1){ return id; }
        }
        id=id+1;
    }
    return -1;
}
// Raw ledger word read (16-word entries, stride 64 — word map: op@0, slot@4,
// rc@8, b1..b5@12..28, a1..a5@32..48, stage@52, d1@56, d2@60).
fn rt_ledger_word(st:[]i32, e:i32, w:i32)i32 {
    return st[RT_LEDGER_BASE + e*RT_LEDGER_STRIDE + w];
}
// Count SPLIT (196) / MERGE (197) ops and dump the entries.
fn rt_dump_ledger(st:[]i32, fails:*i32)void {
    let n:i32=r0_ledger_count(st);
    let e:i32=0;
    let cs:i32=0; let cm:i32=0;
    while(e<n){
        let op:i32=rt_ledger_word(st,e,0);
        if(op==196 || op==197){
            rt_out("RTLED,"); rt_num(e); rt_out(",");
            rt_num(op); rt_out(","); rt_num(rt_ledger_word(st,e,4)); rt_out(",");
            rt_num(rt_ledger_word(st,e,8)); rt_out(",");
            rt_num(rt_ledger_word(st,e,12)); rt_out(","); rt_num(rt_ledger_word(st,e,16)); rt_out(",");
            rt_num(rt_ledger_word(st,e,20)); rt_out(","); rt_num(rt_ledger_word(st,e,24)); rt_out(",");
            rt_num(rt_ledger_word(st,e,28)); rt_out(",");
            rt_num(rt_ledger_word(st,e,52)); rt_out(",");
            rt_num(rt_ledger_word(st,e,56)); rt_out(","); rt_num(rt_ledger_word(st,e,60));
            rt_out("\n");
        }
        if(op==196){cs=cs+1;}
        if(op==197){cm=cm+1;}
        e=e+1;
    }
    rt_kv("RT_N_SPLIT,",cs); rt_kv("RT_N_MERGE,",cm);
    rt_expect(fails,cs==1);
}
// SHA-256 hex over arena header + bank region (M8 store image).
// NOTE (ZNC-2026-09-21-002): `slice as *u8` does NOT yield a data pointer in
// this znc build, so the image is built by decomposing words -> bytes.
fn rt_store_hex(st:[]i32)[]u8 {
    let nw:i32=RT_HDR_WORDS+RT_BANK_WORDS;
    let buf:[]u8=nio_alloc(nw*4);
    let w:i32=0;
    while(w<nw){
        let word:i32=st[w];
        buf[w*4]=(word & 255) as u8;
        buf[w*4+1]=((word>>8) & 255) as u8;
        buf[w*4+2]=((word>>16) & 255) as u8;
        buf[w*4+3]=((word>>24) & 255) as u8;
        w=w+1;
    }
    let h:[]u8=hc_sha256_hex(buf);
    nio_free(buf);
    return h;
}

// ---- Arena RT-1: THE literal round-trip -----------------------------------
// Same material in ("splitchk", 8 bytes): recruit -> snapshot original bytes
// -> split under recovered conditions -> merge the split's own halves ->
// byte-compare any merged chunk against the snapshot.
// Returns 1 iff a merged chunk was minted AND is byte-identical to the
// original material; 0 otherwise. The return value is the verdict input —
// it is MEASURED, not asserted: a 0 here is the honest FAIL outcome.
fn rt_roundtrip_arena(st:[]i32, leg:i32, fails:*i32)i32 {
    // 1. Recruit the material.
    let s1:[]i32=zalloc_i(8);
    rt_fill(s1,"splitchk");
    let labs:[]i32=zalloc_i(6);
    labs[0]=3; labs[1]=3; labs[2]=0; labs[3]=1; labs[4]=2; labs[5]=3;
    rt_observe_span_n(st,s1,8,labs,6,6);
    let idx:[]i32=zalloc_i(4096);
    let promoted:i32=r0_promote(st,idx);
    rt_kv("RT_PROMOTED,",promoted);
    rt_expect(fails,promoted==1);
    let parent:i32=r0_chunk_count(st)-1;
    rt_kv("RT_PARENT_ID,",parent);
    rt_expect(fails,parent==0);
    // 2. Snapshot the ORIGINAL bytes before any revision.
    let orig:[]i32=zalloc_i(8);
    let oln:i32=r0_chunk_bytes(st,parent,orig,8);
    rt_kv("RT_ORIG_LEN,",oln);
    rt_expect(fails,oln==8);
    let ok0:i32=1;
    let q:i32=0; let want:[]u8="splitchk";
    while(q<8){ if(orig[q]!=(want[q] as i32)){ok0=0;q=8;} else {q=q+1;} }
    rt_kv("RT_ORIG_BYTES_OK,",ok0);
    rt_expect(fails,ok0==1);
    // 3. Drive the recovered split conditions:
    //    use_count>=3 AND conflict>=learned_conflict AND utility<=floor(0).
    rt_kv("RT_CONFLICT,",r0_chunk_conflict1000(st,parent));
    rt_expect(fails,r0_chunk_conflict1000(st,parent)==500);
    let use3:[]i32=zalloc_i(24);
    rt_fill_rep(use3,"splitchk",3);
    let uid:[]i32=zalloc_i(24); let ust:[]i32=zalloc_i(24); let uln:[]i32=zalloc_i(24);
    r0_segment(st,use3,24,uid,ust,uln,24);
    rt_kv("RT_USE,",r0_chunk_use(st,parent));
    rt_expect(fails,r0_chunk_use(st,parent)==3);
    rt_kv("RT_UTIL_BEFORE,",r0_chunk_utility(st,parent));
    rt_expect(fails,r0_chunk_utility(st,parent)>0);
    let iters:i32=rt_drive_utility_down(st,parent);
    rt_kv("RT_REGRET_ITERS,",iters);
    rt_kv("RT_PARENT_REGRET,",iters*2000);
    rt_kv("RT_UTIL_AFTER,",r0_chunk_utility(st,parent));
    rt_expect(fails,r0_chunk_utility(st,parent)<=0);
    // 4. SPLIT under the recovered conditions.
    let child:i32=r0_maybe_split(st,parent);
    rt_kv("RT_SPLIT_CHILD,",child);
    rt_expect(fails,child==1);
    rt_kv("RT_PARENT_STATE,",r0_chunk_state(st,parent));   // 2 = tombstoned
    rt_expect(fails,r0_chunk_state(st,parent)==2);
    rt_kv("RT_PARENT_SUCC,",r0_chunk_succ(st,parent));
    rt_expect(fails,r0_chunk_succ(st,parent)==child);
    rt_kv("RT_CHILD_STATE,",r0_chunk_state(st,child));     // 1 = live
    rt_expect(fails,r0_chunk_state(st,child)==1);
    rt_kv("RT_PARENT_LEN,",r0_chunk_len(st,parent));      // 4 ("spli")
    rt_kv("RT_CHILD_LEN,",r0_chunk_len(st,child));         // 4 ("tchk")
    rt_expect(fails,r0_chunk_len(st,parent)==4);
    rt_expect(fails,r0_chunk_len(st,child)==4);
    // 5. Attempt the literal re-merge of the split's OWN halves.
    //    pair_seen is driven past the learned bar (3 leg0 / 4 leg1) so the
    //    only remaining gates are the ones the split itself installed.
    let ps:i32=0;
    while(ps<6){ r0_observe_pair(st,parent,child); ps=ps+1; }
    rt_kv("RT_PAIR_SEEN,",r0_pair_seen(st,parent,child));
    rt_expect(fails,r0_pair_seen(st,parent,child)==6);
    let m1:i32=r0_maybe_merge(st,parent,child);
    rt_kv("RT_MERGE_RC_PARENT_CHILD,",m1);
    let m2:i32=r0_maybe_merge(st,child,parent);
    rt_kv("RT_MERGE_RC_CHILD_PARENT,",m2);
    // 6. Byte-compare: a merged chunk exists only if the merge fired.
    let merged_id:i32=-1;
    if(m1>=0){merged_id=m1;}
    if(m2>=0){merged_id=m2;}
    rt_kv("RT_MERGED_ID,",merged_id);
    let mln:i32=0;
    let same:i32=0;
    if(merged_id>=0){
        let mb:[]i32=zalloc_i(8);
        mln=r0_chunk_bytes(st,merged_id,mb,8);
        same=1;
        let k:i32=0;
        while(k<8){
            let ob:i32=-1;
            if(k<oln){ob=orig[k];}
            let nb2:i32=-2;
            if(k<mln){nb2=mb[k];}
            if(ob!=nb2){same=0;k=8;} else {k=k+1;}
        }
        zfree_i(mb);
    }
    rt_kv("RT_MERGED_LEN,",mln);
    rt_kv("RT_MERGED_BYTES_OK,",same);
    // Diagnostic (not the bar): the halves' bytes concatenated vs original —
    // shows whether the FAIL is data loss or mechanism refusal.
    let pb:[]i32=zalloc_i(8);
    let pln:i32=r0_chunk_bytes(st,parent,pb,8);
    let cb:[]i32=zalloc_i(8);
    let cln:i32=r0_chunk_bytes(st,child,cb,8);
    let concat_ok:i32=1;
    if(pln!=4 || cln!=4){concat_ok=0;} else {
        let k2:i32=0;
        while(k2<8){
            let hb:i32=-1;
            if(k2<4){hb=pb[k2];} else {hb=cb[k2-4];}
            if(hb!=orig[k2]){concat_ok=0;k2=8;} else {k2=k2+1;}
        }
    }
    rt_kv("RT_HALVES_CONCAT_OK,",concat_ok);
    rt_expect(fails,concat_ok==1);
    let rt_ok:i32=0;
    if(merged_id>=0 && mln==oln && same==1){rt_ok=1;}
    rt_kv("RT_ARENA_ROUNDTRIP_OK,",rt_ok);
    zfree_i(s1); zfree_i(labs); zfree_i(idx); zfree_i(orig);
    zfree_i(use3); zfree_i(uid); zfree_i(ust); zfree_i(uln);
    zfree_i(pb); zfree_i(cb);
    return rt_ok;
}

// ---- Arena RT-2: prefix-shadow control -------------------------------------
// After the split, the prefix half lives only in the tombstoned parent's
// record; promote's bank_has_span dedup matches it, so the prefix can never
// be recruited live again — the merge half of the round-trip has no live
// halves to work with. Measured here, not assumed.
fn rt_prefix_shadow_arena(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let s1:[]i32=zalloc_i(8); rt_fill(s1,"splitchk");
    let labs:[]i32=zalloc_i(6);
    labs[0]=3; labs[1]=3; labs[2]=0; labs[3]=1; labs[4]=2; labs[5]=3;
    let idx:[]i32=zalloc_i(4096);
    rt_observe_span_n(st,s1,8,labs,6,6);
    rt_expect(fails,r0_promote(st,idx)==1);
    let use3:[]i32=zalloc_i(24); rt_fill_rep(use3,"splitchk",3);
    let a:[]i32=zalloc_i(24); let b:[]i32=zalloc_i(24); let c:[]i32=zalloc_i(24);
    r0_segment(st,use3,24,a,b,c,24);
    rt_drive_utility_down(st,0);
    let child:i32=r0_maybe_split(st,0);
    rt_kv("RT2_SPLIT_CHILD,",child);
    rt_expect(fails,child==1);
    // Re-observe ONLY the 4-byte prefix, then promote. The proposal buffer
    // still holds the pre-split 8-span proposal (promote never drains it), so
    // the 8-span re-issues as a NEW live dup — while the prefix proposal is
    // dedup-skipped against the tombstoned parent record and never goes live.
    // This is the mechanism-level reason the re-merge has no live halves.
    let hp:[]i32=zalloc_i(4); rt_fill(hp,"spli");
    let lab3:[]i32=zalloc_i(1); lab3[0]=3;
    rt_observe_span_n(st,hp,4,lab3,1,6);
    let p2:i32=r0_promote(st,idx);
    rt_kv("RT2_REPROMOTED,",p2);
    rt_expect(fails,p2==1);
    let dup:i32=r0_chunk_count(st)-1;
    let db:[]i32=zalloc_i(8);
    let dln:i32=r0_chunk_bytes(st,dup,db,8);
    let dsame:i32=1;
    let dq:i32=0; let dorig:[]u8="splitchk";
    while(dq<8){ if(db[dq]!=(dorig[dq] as i32)){dsame=0;dq=8;} else {dq=dq+1;} }
    rt_kv("RT2_DUP_ID,",dup);
    rt_kv("RT2_DUP_LEN,",dln);
    rt_kv("RT2_DUP_BYTES_OK,",dsame);
    rt_kv("RT2_DUP_STATE,",r0_chunk_state(st,dup));
    rt_expect(fails,dln==8);
    rt_expect(fails,dsame==1);
    rt_expect(fails,r0_chunk_state(st,dup)==1);
    rt_kv("RT2_FIND_LIVE_SPLI,",rt_find_live(st,"spli"));
    rt_expect(fails,rt_find_live(st,"spli")==-1);
    zfree_i(st); zfree_i(s1); zfree_i(labs); zfree_i(idx);
    zfree_i(use3); zfree_i(a); zfree_i(b); zfree_i(c);
    zfree_i(hp); zfree_i(lab3); zfree_i(db);
}

// ---- Arena RT-3: merge-alone positive control ------------------------------
// Two LIVE halves ("spli"+"tchk") merge byte-exact on both legs. Proves the
// merge op is sound and the joint_gain conjunct is satisfiable at
// pair_seen=6 (leg0: 620>=0; leg1: 500>=500), isolating RT-1's FAIL to the
// split->merge composition rather than a broken merge.
fn rt_merge_alone_arena(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let idx:[]i32=zalloc_i(4096);
    let lab3:[]i32=zalloc_i(1); lab3[0]=3;
    let ha:[]i32=zalloc_i(4); rt_fill(ha,"spli");
    rt_observe_span_n(st,ha,4,lab3,1,6);
    rt_expect(fails,r0_promote(st,idx)==1);
    let hb:[]i32=zalloc_i(4); rt_fill(hb,"tchk");
    rt_observe_span_n(st,hb,4,lab3,1,6);
    rt_expect(fails,r0_promote(st,idx)==1);
    let left:i32=rt_find_live(st,"spli");
    let right:i32=rt_find_live(st,"tchk");
    rt_kv("RT3_LEFT_ID,",left); rt_kv("RT3_RIGHT_ID,",right);
    rt_expect(fails,left==0); rt_expect(fails,right==1);
    let ps:i32=0;
    while(ps<6){ r0_observe_pair(st,left,right); ps=ps+1; }
    rt_kv("RT3_PAIR_SEEN,",r0_pair_seen(st,left,right));
    rt_expect(fails,r0_pair_seen(st,left,right)==6);
    let m:i32=r0_maybe_merge(st,left,right);
    rt_kv("RT3_MERGED_ID,",m);
    rt_expect(fails,m==2);
    rt_expect(fails,r0_chunk_state(st,left)==2);
    rt_expect(fails,r0_chunk_state(st,right)==2);
    let mb:[]i32=zalloc_i(8);
    let mln:i32=r0_chunk_bytes(st,m,mb,8);
    rt_kv("RT3_MERGED_LEN,",mln);
    rt_expect(fails,mln==8);
    let same:i32=1;
    let k:i32=0; let want:[]u8="splitchk";
    while(k<8){ if(mb[k]!=(want[k] as i32)){same=0;k=8;} else {k=k+1;} }
    rt_kv("RT3_MERGED_BYTES_OK,",same);
    rt_expect(fails,same==1);
    zfree_i(st); zfree_i(idx); zfree_i(lab3);
    zfree_i(ha); zfree_i(hb); zfree_i(mb);
}

fn main()i32 {
    // ZNC-2026-09-21-007: never gate _zag_arg reads on argc; read
    // unconditionally and treat "" as absent.
    let leg:i32=0;
    let a1:[]u8=_zag_arg(1);
    if(a1.len>0 && a1[0]==49){leg=1;}
    let pert:i32=0;
    let a2:[]u8=_zag_arg(2);
    if(a2.len>0){pert=(a2[0] as i32)-48;}
    if(pert<0 || pert>4){pert=0;}
    // STORESEQ readback gate (ZNC-2026-09-19-001): expected-value probes on
    // every 3+ sequential []i32 store site. Any fails>0 is a hard FAIL.
    let pf:i32=r0_probe_run();
    if(pf!=0){ rt_out("RT_PROBE_GATE_FAIL\n"); return 2; }
    let armor:M8Armor=m8_new();
    if(m8_armor_init(&armor,pert as i64)!=0){ rt_out("RT_ARMOR_INIT_FAIL\n"); return 1; }
    rt_perturb(pert);
    let fails:i32=0;
    rt_out("RT_BATTERY,leg="); rt_num(leg); rt_out(",pert="); rt_num(pert); rt_out("\n");
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let rt_ok:i32=rt_roundtrip_arena(st,leg,&fails);
    rt_prefix_shadow_arena(leg,&fails);
    rt_merge_alone_arena(leg,&fails);
    if(pert==4){ rt_churn(); }
    rt_dump_ledger(st,fails);
    rt_kv("RT_FAILS_TOTAL,",fails);
    rt_kv("RT_ROUNDTRIP_OK,",rt_ok);
    if(fails==0 && rt_ok==1){
        rt_out("RT_VERDICT,PASS\n");
    } else if(fails==0){
        rt_out("RT_VERDICT,FAIL\n");
    } else {
        rt_out("RT_VERDICT,INVALID\n");
    }
    let sh:[]u8=rt_store_hex(st);
    let lh:[]u8=_zag_i64_to_str(r0_ledger_hash(st) as i64);
    m8_emit_captures(&armor,sh,lh);
    nio_free(sh); nio_free(lh);
    zfree_i(st);
    m8_armor_free(&armor);
    rt_out("RT_DONE\n");
    if(fails!=0){ return 3; }
    if(rt_ok==0){ return 4; }
    return 0;
}

// b_t2.zag — B-T2 causal-ablation battery (crew B-ABLDOSE).
// Track R0, prereg FROZEN (Micah signed 2026-09-21), §2 R0.1 battery 2.
// Manifest: units/r0/evidence/ablation/MANIFEST_BT2_BT3.md (frozen pre-execution).
// Usage: b_t2 <leg 0|1> <perturb 0..4>
// ONE binary; argv[1] selects the leg (R-7/R-8 test-both — both run, never one).
@import("bt_common.zag")

fn bt2_parse_arg(idx:i32,def:i32)i32 {
    if(_zag_argc()>idx){
        let a:[]u8=_zag_arg(idx);
        if(a.len>0){
            let v:i32=(a[0] as i32)-48;
            if(v>=0 && v<=9){return v;}
        }
    }
    return def;
}

fn main()i32 {
    // Expected-value readback probe FIRST (standing rule C): a deterministic
    // miscompile is invisible to rerun-diffing, so expected values are checked.
    let pf:i32=bt_probe_run();
    if(pf!=0){
        btp_str("BT2_PROBE_GATE_FAIL\n");
        return 2;
    }
    let leg:i32=bt2_parse_arg(1,0);
    if(leg!=0 && leg!=1){leg=0;}
    let pert:i32=bt2_parse_arg(2,0);
    if(pert<0 || pert>4){pert=0;}
    bt_perturb(pert);

    btp_str("BT2_ENV_SEED,20260921,environment-input-only,never-ai-decision\n");
    let c:Btx=bt_ctx_new(leg);
    btp_str("BT2_MANIFEST_DIGEST,");
    btp_num(bt_manifest_digest(&c) as i64);
    btp_ln();

    let T:i32=400;
    let obs:i64=bt_train(&c,T);
    let idx:[]i32=zalloc_i(4096);
    let promoted:i32=r0_promote(c.st,idx);
    if(pert==4){ bt_churn(); } // mid-run adversarial churn
    let vc:i32=bt_vocab_check(&c);
    let live:i32=r0_live_count(c.st);

    btp_str("BT2_TRAIN,leg="); btp_num(leg as i64);
    btp_str(",units="); btp_num(T as i64);
    btp_str(",observed="); btp_num(obs);
    btp_str(",promoted="); btp_num(promoted as i64);
    btp_str(",live="); btp_num(live as i64);
    btp_str(",vocab_check="); btp_num(vc as i64); btp_str("/24");
    btp_ln();

    // hard-grounding probe battery: raw vs chunk vs dual
    let g:[]i32=zalloc_i(8);
    bt_ground_probe(&c,g);
    let r:i32=0;
    while(r<3){
        if(r==0){btp_str("BT2_GROUND,leg=");}
        if(r==1){btp_str("BT2_GROUND,leg=");}
        if(r==2){btp_str("BT2_GROUND,leg=");}
        btp_num(leg as i64);
        btp_str(",route=");
        if(r==0){btp_str("raw_active");}
        if(r==1){btp_str("chunk_active");}
        if(r==2){btp_str("dual_active");}
        btp_str(",score_mp="); btp_num((g[r]*1000/200) as i64);
        btp_str(",label3="); btp_num(g[r] as i64);
        btp_str(",n=200");
        btp_ln();
        r=r+1;
    }
    btp_str("BT2_GROUND_RECALL,leg="); btp_num(leg as i64);
    btp_str(",raw_mp="); btp_num((g[4]*1000/200) as i64);
    btp_str(",chunk_mp="); btp_num((g[5]*1000/200) as i64);
    btp_str(",consistent_occ="); btp_num(g[6] as i64); btp_str("/200");
    btp_ln();

    // near-twin discrimination probe set (reference-only)
    let tw:[]i32=zalloc_i(8);
    bt_twin_probe(&c,tw);
    r=0;
    while(r<3){
        btp_str("BT2_TWIN,leg="); btp_num(leg as i64);
        btp_str(",route=");
        if(r==0){btp_str("raw_active");}
        if(r==1){btp_str("chunk_active");}
        if(r==2){btp_str("dual_active");}
        btp_str(",score_mp="); btp_num((tw[r]*1000/192) as i64);
        btp_str(",correct="); btp_num(tw[r] as i64);
        btp_str(",n=192,reference_only=1");
        btp_ln();
        r=r+1;
    }

    // dual compression ratio
    let cm:[]i32=zalloc_i(8);
    bt_compression(&c,T,cm);
    btp_str("BT2_COMPRESSION,leg="); btp_num(leg as i64);
    btp_str(",source="); btp_num(cm[0] as i64);
    btp_str(",stored="); btp_num(cm[1] as i64);
    btp_str(",ratio_mp="); btp_num(cm[2] as i64);
    btp_str(",payload="); btp_num(cm[3] as i64);
    btp_ln();

    btp_str("BT2_TRUST,leg="); btp_num(leg as i64);
    btp_str(",w_chunk="); btp_num(r0_w_chunk(c.st) as i64);
    btp_str(",w_raw="); btp_num(r0_w_raw(c.st) as i64);
    btp_ln();

    // frozen-bar accounting (R-3 numerics pending Micah amendment)
    let raw_mp:i32=g[0]*1000/200;
    let chk_mp:i32=g[1]*1000/200;
    let du_mp:i32=g[2]*1000/200;
    let delta:i32=du_mp-raw_mp;
    if(delta<0){delta=0-delta;}
    btp_str("BT2_DELTA,leg="); btp_num(leg as i64);
    btp_str(",dual_minus_raw_mp="); btp_num((du_mp-raw_mp) as i64);
    btp_str(",abs_delta_mp="); btp_num(delta as i64);
    btp_ln();
    let chunk_lt_dual:i32=0;
    if(chk_mp<du_mp){chunk_lt_dual=1;}
    let chunk_lt_raw:i32=0;
    if(chk_mp<raw_mp){chunk_lt_raw=1;}
    let ratio_gt:i32=0;
    if(cm[2]>1000){ratio_gt=1;}
    btp_str("BT2_BAR,leg="); btp_num(leg as i64);
    btp_str(",chunk_lt_dual="); btp_num(chunk_lt_dual as i64);
    btp_str(",chunk_lt_raw="); btp_num(chunk_lt_raw as i64);
    btp_str(",ratio_gt_1000="); btp_num(ratio_gt as i64);
    btp_str(",eps_pending_micah_amendment=1,min_ratio_pending_micah_amendment=1,verdict=");
    if(chunk_lt_dual==1 && chunk_lt_raw==1 && ratio_gt==1){btp_str("PASS");}
    else {btp_str("FAIL");}
    btp_ln();

    btp_str("BT2_LEDGER,leg="); btp_num(leg as i64);
    btp_str(",entries="); btp_num(r0_ledger_count(c.st) as i64);
    btp_str(",hash="); btp_num(r0_ledger_hash(c.st) as i64);
    btp_ln();
    btp_str("BT2_DONE\n");

    zfree_i(idx); zfree_i(g); zfree_i(tw); zfree_i(cm);
    bt_ctx_free(&c);
    return 0;
}

// b_t3.zag — B-T3 dose-curve battery (crew B-ABLDOSE).
// Track R0, prereg FROZEN (Micah signed 2026-09-21), §2 R0.1 battery 3.
// Manifest: units/r0/evidence/ablation/MANIFEST_BT2_BT3.md §6 (frozen pre-execution).
// Dose schedule 250 -> 8000 (harness dose_schedule). 1x ONLY (R-9).
// Usage: b_t3 <leg 0|1> <perturb 0..4>
// Bar metric: dual_active hard-grounding score vs dose — flat or non-decreasing
// (R-4 tolerance pending Micah amendment; reported measured + max drop).
@import("bt_common.zag")

fn bt3_parse_arg(idx:i32,def:i32)i32 {
    if(_zag_argc()>idx){
        let a:[]u8=_zag_arg(idx);
        if(a.len>0){
            let v:i32=(a[0] as i32)-48;
            if(v>=0 && v<=9){return v;}
        }
    }
    return def;
}

fn bt3_dose(i:i32)i32 {
    if(i==0){return 250;}
    if(i==1){return 500;}
    if(i==2){return 1000;}
    if(i==3){return 2000;}
    if(i==4){return 4000;}
    return 8000;
}

fn main()i32 {
    let pf:i32=bt_probe_run();
    if(pf!=0){
        btp_str("BT3_PROBE_GATE_FAIL\n");
        return 2;
    }
    let leg:i32=bt3_parse_arg(1,0);
    if(leg!=0 && leg!=1){leg=0;}
    let pert:i32=bt3_parse_arg(2,0);
    if(pert<0 || pert>4){pert=0;}
    bt_perturb(pert);

    btp_str("BT3_ENV_SEED,20260921,environment-input-only,never-ai-decision\n");
    // manifest digest from a throwaway context (probe plan fixed pre-execution)
    let dc:Btx=bt_ctx_new(leg);
    btp_str("BT3_MANIFEST_DIGEST,");
    btp_num(bt_manifest_digest(&dc) as i64);
    btp_ln();
    bt_ctx_free(&dc);

    let prev_du:i32=-1;
    let max_drop:i32=0;
    let strict:i32=1;
    let di:i32=0;
    while(di<6){
        let d:i32=bt3_dose(di);
        let c:Btx=bt_ctx_new(leg);
        let obs:i64=bt_train(&c,d);
        let idx:[]i32=zalloc_i(4096);
        let promoted:i32=r0_promote(c.st,idx);
        if(pert==4){ bt_churn(); }
        let live:i32=r0_live_count(c.st);
        let g:[]i32=zalloc_i(8);
        bt_ground_probe(&c,g);
        let cm:[]i32=zalloc_i(8);
        bt_compression(&c,d,cm);
        let raw_mp:i32=g[0]*1000/200;
        let chk_mp:i32=g[1]*1000/200;
        let du_mp:i32=g[2]*1000/200;
        btp_str("BT3_DOSE,leg="); btp_num(leg as i64);
        btp_str(",dose="); btp_num(d as i64);
        btp_str(",dual_mp="); btp_num(du_mp as i64);
        btp_str(",raw_mp="); btp_num(raw_mp as i64);
        btp_str(",chunk_mp="); btp_num(chk_mp as i64);
        btp_str(",promoted="); btp_num(promoted as i64);
        btp_str(",live="); btp_num(live as i64);
        btp_str(",ratio_mp="); btp_num(cm[2] as i64);
        btp_str(",ledger="); btp_num(r0_ledger_count(c.st) as i64);
        btp_ln();
        if(prev_du>=0){
            if(du_mp<prev_du){
                strict=0;
                let drop:i32=prev_du-du_mp;
                if(drop>max_drop){max_drop=drop;}
            }
        }
        prev_du=du_mp;
        zfree_i(idx); zfree_i(g); zfree_i(cm);
        bt_ctx_free(&c);
        di=di+1;
    }
    btp_str("BT3_MONOTONIC,leg="); btp_num(leg as i64);
    btp_str(",strict_nondecreasing="); btp_num(strict as i64);
    btp_str(",max_drop_mp="); btp_num(max_drop as i64);
    btp_str(",tolerance_pending_micah_amendment=1,verdict=");
    // descriptive verdict vs the frozen bar (flat or non-decreasing);
    // formal bar PENDING-MICAH-AMENDMENT per R-4.
    if(strict==1){btp_str("PASS");}
    else {btp_str("DEGRADED");}
    btp_ln();
    btp_str("BT3_DONE\n");
    return 0;
}

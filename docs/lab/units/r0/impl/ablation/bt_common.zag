// bt_common.zag — shared machinery for the B-T2 / B-T3 batteries (crew B-ABLDOSE).
// Track R0, prereg FROZEN (Micah signed 2026-09-21), §2 R0.1 batteries 2-3.
// Probe manifest: units/r0/evidence/ablation/MANIFEST_BT2_BT3.md (frozen BEFORE execution).
//
// HARD LAWS: pure Zag; ZERO randomness in any AI decision path; byte-identical reruns.
// All environment stochasticity comes from the fixed logged seed 20260921
// (xorshift64*, environment input only — never an AI decision).
// Toolchain notes respected: no fn named zalloc; single-store []i32 loops only;
// no slice == comparisons; 2^25 slice limit respected (all buffers tiny).
@import("../core/r0_core.zag")

const BT_ENV_SEED:i64 = 20260921;

// ---------------------------------------------------------------------------
// Deterministic environment stream (copy of the harness construction).
// ---------------------------------------------------------------------------
struct Bte { s:i64 }
fn bte_init(seed:i64)Bte { return Bte{.s=seed}; }
fn bte_next(e:*Bte)i64 {
    let x:i64=e.*.s; x=x^x>>12; x=x^x<<25; x=x^x>>27; e.*.s=x;
    return x*2685821657736338717;
}
fn bte_bound(e:*Bte,bound:i64)i32 {
    if(bound<1){return 0;}
    let v:i64=bte_next(e); if(v<0){v=-v;}
    return (v-(v/bound)*bound) as i32;
}
fn bt_mod(a:i32,b:i32)i32 { if(b<1){return 0;} return a-(a/b)*b; }

// []u8 allocator (3-line equivalent of the harness bt_u8alloc; local so the
// battery needs no IO-layer import).
fn bt_u8alloc(n:i32)[]u8 {
    if(n<1){n=1;}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn bt_u8free(b:[]u8)void { if(b.len>0){_zag_free(_zag_slice_ptr(b));} }

// ---------------------------------------------------------------------------
// Print helpers.
// ---------------------------------------------------------------------------
fn btp_str(s:[]u8)void { _zag_print(s); }
fn btp_num(v:i64)void { let s:[]u8=_zag_i64_to_str(v); _zag_print(s); bt_u8free(s); }
fn btp_ln()void { _zag_print("\n"); }

// ---------------------------------------------------------------------------
// M8 adversarial allocation perturbations (pattern follows r0_smoke.zag).
// These only rearrange heap state; the battery never reads addresses or
// uninitialized memory, so all modes must produce byte-identical output.
// ---------------------------------------------------------------------------
fn bt_perturb(mode:i32)void {
    if(mode==1){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(128);
        let a2:[]i32=zalloc_i(32); let a3:[]i32=zalloc_i(256);
        let a4:[]i32=zalloc_i(48); let a5:[]i32=zalloc_i(96);
        a0[0]=1; a3[0]=2; a5[0]=3;
        zfree_i(a1); zfree_i(a4);
        let b0:[]i32=zalloc_i(200);
        b0[0]=4;
        zfree_i(a0); zfree_i(b0); zfree_i(a2); zfree_i(a3); zfree_i(a5);
    } else if(mode==2){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(64);
        let a2:[]i32=zalloc_i(64); let a3:[]i32=zalloc_i(64);
        a0[0]=1; a1[0]=2; a2[0]=3; a3[0]=4;
        zfree_i(a3); zfree_i(a2); zfree_i(a1); zfree_i(a0);
    } else if(mode==3){
        let big:[]i32=zalloc_i(65536);
        let i:i32=0;
        while(i<65536){ big[i]=i & 255; i=i+1024; }
        zfree_i(big);
        let s1:[]i32=zalloc_i(13); s1[0]=7; zfree_i(s1);
    }
}
fn bt_churn()void {
    let a0:[]i32=zalloc_i(512); let a1:[]i32=zalloc_i(17);
    a0[0]=9; a1[0]=8;
    zfree_i(a0);
    let b0:[]i32=zalloc_i(300); b0[0]=7;
    zfree_i(a1); zfree_i(b0);
}

// ---------------------------------------------------------------------------
// Span sets. Manifest §1.
// ---------------------------------------------------------------------------
fn bt_sig(q:i32)i32 { if(q==1){return 170;} return 187; } // 0xAA / 0xBB
fn bt_flip(b:i32)i32 { if(b==170){return 187;} return 170; }

fn bt_gen_spans(e:*Bte,count:i32,lens:[]i32,dat:[]u8)void {
    let s:i32=0;
    while(s<count){
        // length 6..8: full vocabulary spans outrank their own proper
        // substrings under the frozen utility rule (utility strictly
        // increasing in length at fixed seen/purity), so every span in the
        // target vocabulary promotes into the fixed inventory.
        let L:i32=6+bte_bound(e,3);
        lens[s]=L;
        let k:i32=0;
        while(k<L){ dat[s*8+k]=(33+bte_bound(e,94)) as u8; k=k+1; }
        // pairwise-distinct contents (deterministic regeneration)
        let dup:i32=1;
        while(dup==1){
            dup=0;
            let t:i32=0;
            while(t<s){
                if(lens[t]==L){
                    let same:i32=1;
                    let j:i32=0;
                    while(j<L){
                        if(dat[t*8+j]!=dat[s*8+j]){same=0; j=L;} else {j=j+1;}
                    }
                    if(same==1){dup=1;}
                }
                t=t+1;
            }
            if(dup==1){
                k=0;
                while(k<L){ dat[s*8+k]=(33+bte_bound(e,94)) as u8; k=k+1; }
            }
        }
        s=s+1;
    }
}

// exact byte compare: span table entry (lens,dat,stride 8) vs seq[off..off+L)
fn bt_span_eq(lens:[]i32,dat:[]u8,s:i32,seq:[]i32,off:i32,L:i32)i32 {
    if(lens[s]!=L){return 0;}
    let k:i32=0;
    while(k<L){
        if((dat[s*8+k] as i32)!=seq[off+k]){return 0;}
        k=k+1;
    }
    return 1;
}

// ---------------------------------------------------------------------------
// Battery context.
// ---------------------------------------------------------------------------
struct Btx {
    leg:i32,
    vlen:[]i32, vdat:[]u8,   // vocab: 24 spans
    rlen:[]i32, rdat:[]u8,   // rare: 8 spans
    nlen:[]i32, ndat:[]u8,   // novel: 8 spans
    vq1:[]i32, vq0:[]i32,    // per-vocab-span training consequence counts
    gq1:i64, gq0:i64,        // global consequence counts (len 4..8 observations)
    rr:i32,                  // round-robin vocabulary cursor (deterministic coverage)
    st:[]i32                 // r0 arena
}

fn bt_ctx_new(leg:i32)Btx {
    let ev:Bte=bte_init(BT_ENV_SEED+11);
    let vlen:[]i32=zalloc_i(24);
    let vdat:[]u8=bt_u8alloc(24*8);
    bt_gen_spans(&ev,24,vlen,vdat);
    let er:Bte=bte_init(BT_ENV_SEED+12);
    let rlen:[]i32=zalloc_i(8);
    let rdat:[]u8=bt_u8alloc(8*8);
    bt_gen_spans(&er,8,rlen,rdat);
    let en:Bte=bte_init(BT_ENV_SEED+13);
    let nlen:[]i32=zalloc_i(8);
    let ndat:[]u8=bt_u8alloc(8*8);
    bt_gen_spans(&en,8,nlen,ndat);
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let vq1:[]i32=zalloc_i(24);
    let vq0:[]i32=zalloc_i(24);
    return Btx{.leg=leg,.vlen=vlen,.vdat=vdat,.rlen=rlen,.rdat=rdat,
               .nlen=nlen,.ndat=ndat,.vq1=vq1,.vq0=vq0,.gq1=0,.gq0=0,.rr=0,.st=st};
}

fn bt_ctx_free(c:*Btx)void {
    zfree_i(c.*.vlen); bt_u8free(c.*.vdat);
    zfree_i(c.*.rlen); bt_u8free(c.*.rdat);
    zfree_i(c.*.nlen); bt_u8free(c.*.ndat);
    zfree_i(c.*.vq1); zfree_i(c.*.vq0);
    zfree_i(c.*.st);
}

// manifest digest: FNV-1a over the three span tables (fixed pre-execution)
fn bt_manifest_digest(c:*Btx)i32 {
    let h:i64=2166136261;
    let i:i32=0;
    while(i<24*8){ h=(h^((c.*.vdat[i] as i64)))*16777619; h=h&4294967295; i=i+1; }
    i=0;
    while(i<8*8){ h=(h^((c.*.rdat[i] as i64)))*16777619; h=h&4294967295; i=i+1; }
    i=0;
    while(i<8*8){ h=(h^((c.*.ndat[i] as i64)))*16777619; h=h&4294967295; i=i+1; }
    return (h & 2147483647) as i32;
}

// ---------------------------------------------------------------------------
// Training unit emission (manifest §2). record=1 updates vocab q counts.
// Identical byte sequence for a given (u,T) regardless of record flag.
// Vocabulary spans are drawn ROUND-ROBIN (deterministic full coverage from
// the first units — every span's proposal exists before the proposal bank
// can saturate). Gaps use one FIXED filler byte (0x20, space-like): real
// text/code has recurrent separator bytes, and i.i.d. random filler floods
// the frozen 4096-entry proposal bank with noise before the vocabulary is
// learned (observed 2026-09-21: 23/24 spans promoted under random filler).
const BT_FILL:i32 = 32;
const BT_PFILL:i32 = 127; // probe filler: ABSENT from training (training bytes
// are 33..126 span content, 0x20 filler, 0xAA/0xBB consequence). Guarantees no
// "probe-filler + span-prefix" boundary chunk exists in the bank, so greedy
// longest-match segmentation of a probe episode cannot fragment the target
// span range with a filler-anchored chunk (observed 2026-09-21: with 0x20
// probe filler only span 0/24 recalled — boundary chunks like "GGG"+prefix
// outrank the full span and leave ragged literals).
// ---------------------------------------------------------------------------
fn bt_emit_unit(eu:*Bte,c:*Btx,u:i32,T:i32,seq:[]i32,record:i32)i32 {
    let w:i32=0;
    let n_occ:i32=6+bte_bound(eu,5);
    let k:i32=0;
    while(k<n_occ){
        let s:i32=c.*.rr-(c.*.rr/24)*24;
        c.*.rr=c.*.rr+1;
        let L:i32=c.*.vlen[s];
        let j:i32=0;
        while(j<L){ seq[w]=(c.*.vdat[s*8+j] as i32); w=w+1; j=j+1; }
        seq[w]=bt_sig(s&1); w=w+1;
        if(record==1){
            if((s&1)==1){c.*.vq1[s]=c.*.vq1[s]+1;} else {c.*.vq0[s]=c.*.vq0[s]+1;}
        }
        let gap:i32=1+bte_bound(eu,3);
        j=0;
        while(j<gap){ seq[w]=BT_FILL; w=w+1; j=j+1; }
        k=k+1;
    }
    let r:i32=0;
    while(r<8){
        if(u==bt_mod(r*37,T) || u==bt_mod(r*37+199,T)){
            let L:i32=c.*.rlen[r];
            let j:i32=0;
            while(j<L){ seq[w]=(c.*.rdat[r*8+j] as i32); w=w+1; j=j+1; }
            seq[w]=bt_sig(r&1); w=w+1;
            seq[w]=BT_FILL; w=w+1;
            seq[w]=BT_FILL; w=w+1;
        }
        r=r+1;
    }
    return w;
}

fn bt_observe_unit(c:*Btx,seq:[]i32,n:i32)i64 {
    let total:i64=0;
    let pos:i32=0;
    while(pos<n){
        let lmax:i32=8;
        if(pos+lmax>n){lmax=n-pos;}
        let len:i32=2;
        while(len<=lmax){
            let nb:i32=-1;
            let q:i32=0;
            if(pos+len<n){ nb=seq[pos+len]; if(nb==170){q=1;} }
            r0_observe_span(c.*.st,seq,pos,len,2+q,nb);
            if(len>=4){
                if(q==1){c.*.gq1=c.*.gq1+1;} else {c.*.gq0=c.*.gq0+1;}
            }
            total=total+1;
            len=len+1;
        }
        pos=pos+1;
    }
    return total;
}

// Train T units; trust updates every 10th unit (manifest §2).
fn bt_train(c:*Btx,T:i32)i64 {
    let eu:Bte=bte_init(BT_ENV_SEED+21);
    let seq:[]i32=zalloc_i(4096);
    let total:i64=0;
    let u:i32=0;
    while(u<T){
        let n:i32=bt_emit_unit(&eu,c,u,T,seq,1);
        total=total+bt_observe_unit(c,seq,n);
        if(bt_mod(u,10)==0){
            let helped:i32=0;
            if(bt_mod(u,3)!=2){helped=1;}
            r0_dual_trust_update(c.*.st,helped,1,helped,25);
        }
        u=u+1;
    }
    zfree_i(seq);
    return total;
}

// Count vocab spans present as live chunks.
fn bt_vocab_check(c:*Btx)i32 {
    let found:i32=0;
    let s:i32=0;
    while(s<24){
        let L:i32=c.*.vlen[s];
        let id:i32=0;
        let nc:i32=r0_chunk_count(c.*.st);
        let hit:i32=0;
        while(id<nc){
            if(r0_chunk_state(c.*.st,id)==1 && r0_chunk_len(c.*.st,id)==L){
                let tmp:[]i32=zalloc_i(8);
                let ln:i32=r0_chunk_bytes(c.*.st,id,tmp,8);
                if(ln==L){
                    let same:i32=1;
                    let k:i32=0;
                    while(k<L){
                        if(tmp[k]!=(c.*.vdat[s*8+k] as i32)){same=0; k=L;} else {k=k+1;}
                    }
                    if(same==1){hit=1;}
                }
                zfree_i(tmp);
                if(hit==1){id=nc;} else {id=id+1;}
            } else {id=id+1;}
        }
        if(hit==1){found=found+1;}
        s=s+1;
    }
    return found;
}

// ---------------------------------------------------------------------------
// Probe episode builder: 8 filler + span + consequence + 8 filler.
// Span occupies [8, 8+L).
// ---------------------------------------------------------------------------
fn bt_episode(ep:*Bte,lens:[]i32,dat:[]u8,s:i32,cons:i32,seq:[]i32)i32 {
    let w:i32=0;
    let k:i32=0;
    while(k<8){ seq[w]=BT_PFILL; w=w+1; k=k+1; }
    let L:i32=lens[s];
    k=0;
    while(k<L){ seq[w]=(dat[s*8+k] as i32); w=w+1; k=k+1; }
    seq[w]=cons; w=w+1;
    k=0;
    while(k<8){ seq[w]=BT_PFILL; w=w+1; k=k+1; }
    return w;
}

// Coverage test: units covering [at,at+L) are contiguous, all chunk ids >= 0.
// Returns 1 covered / 0 not. Collects covering ids into cid (count in *m).
fn bt_cover(c:*Btx,oid:[]i32,ost:[]i32,oln:[]i32,nout:i32,at:i32,L:i32,
            cid:[]i32,m:*i32)i32 {
    let n:i32=0;
    let ok:i32=1;
    let prev_end:i32=-1;
    let first_s:i32=-1;
    let i:i32=0;
    while(i<nout){
        let s0:i32=ost[i];
        let e0:i32=ost[i]+oln[i];
        if(s0<at+L && e0>at){
            if(n==0){
                first_s=s0;
                if(s0>at){ok=0;}
            } else {
                if(s0!=prev_end){ok=0;}
            }
            if(oid[i]<0){ok=0;}
            cid[n]=oid[i]; n=n+1;
            prev_end=e0;
        }
        i=i+1;
    }
    m.*=n;
    if(n==0){return 0;}
    if(prev_end<at+L){return 0;}
    if(ok==0){return 0;}
    // byte-exact reconstruct check against the queried span is done by caller
    // via first_s offset; stash first_s in cid-adjacent out via m sign? No:
    // caller recomputes. Return covered=1.
    return 1;
}

// chunk recall for the grounding probe: covered AND reconstruct byte-exact.
fn bt_chunk_recall(c:*Btx,seq:[]i32,at:i32,L:i32,oid:[]i32,ost:[]i32,oln:[]i32,
                   nout:i32,rec:[]i32,cid:[]i32,
                   lens:[]i32,dat:[]u8,s:i32)i32 {
    let m:i32=0;
    // find first covering start for the reconstruct offset
    let first_s:i32=-1;
    let i:i32=0;
    while(i<nout){
        let s0:i32=ost[i];
        let e0:i32=ost[i]+oln[i];
        if(s0<at+L && e0>at){ if(first_s==-1){first_s=s0;} }
        i=i+1;
    }
    if(bt_cover(c,oid,ost,oln,nout,at,L,cid,&m)==0){return 0;}
    let nr:i32=r0_reconstruct(c.*.st,cid,m,rec,64);
    if(nr<0){return 0;}
    let off:i32=at-first_s;
    let k:i32=0;
    while(k<L){
        if(rec[off+k]!=(dat[s*8+k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}

// ---------------------------------------------------------------------------
// B-T2 hard-grounding probe battery (manifest §3). 40 spans x 5 occurrences.
// out: [0]=raw label3 [1]=chunk label3 [2]=dual label3 [3]=n [4]=raw recall
//      [5]=chunk recall [6]=consistent occurrences
// ---------------------------------------------------------------------------
fn bt_ground_probe(c:*Btx,out:[]i32)void {
    let ep:Bte=bte_init(BT_ENV_SEED+41);
    let seq:[]i32=zalloc_i(64);
    let oid:[]i32=zalloc_i(64);
    let ost:[]i32=zalloc_i(64);
    let oln:[]i32=zalloc_i(64);
    let rec:[]i32=zalloc_i(64);
    let cid:[]i32=zalloc_i(64);
    let raw3:i32=0; let chk3:i32=0; let du3:i32=0;
    let rawr:i32=0; let chkr:i32=0; let conso:i32=0;
    let si:i32=0;
    while(si<40){
        let lens:[]i32=c.*.vlen;
        let dat:[]u8=c.*.vdat;
        let idx:i32=si;
        let q:i32=si&1;
        if(si>=24){
            lens=c.*.rlen; dat=c.*.rdat; idx=si-24; q=(si-24)&1;
        }
        if(si>=32){
            lens=c.*.nlen; dat=c.*.ndat; idx=si-32; q=(si-32)&1;
        }
        let L:i32=lens[idx];
        let ar:[]i32=zalloc_i(5);
        let ac:[]i32=zalloc_i(5);
        let ad:[]i32=zalloc_i(5);
        let qfirst:i32=-1;
        let qsame:i32=1;
        let o:i32=0;
        while(o<5){
            let cons:i32=bt_sig(q);
            if((si==7 || si==19) && (o==1 || o==3)){ cons=bt_flip(cons); }
            let n:i32=bt_episode(&ep,lens,dat,idx,cons,seq);
            let qo:i32=0;
            if(cons==170){qo=1;}
            if(o==0){qfirst=qo;} else { if(qo!=qfirst){qsame=0;} }
            // a_raw: byte-exact re-read at known position
            let a_raw:i32=1;
            let k:i32=0;
            while(k<L){
                if(seq[8+k]!=(dat[idx*8+k] as i32)){a_raw=0; k=L;} else {k=k+1;}
            }
            // a_chunk: chunk-mediated recall only
            let nout:i32=r0_segment(c.*.st,seq,n,oid,ost,oln,64);
            let a_chk:i32=bt_chunk_recall(c,seq,8,L,oid,ost,oln,nout,rec,cid,
                                          lens,dat,idx);
            // a_dual: dual retrieval rule through the real API
            let recon_err:i32=0;
            if(a_chk==0){recon_err=1000;}
            let rr:i32=r0_should_retrieve_raw(recon_err,0,500,100,2000);
            let a_du:i32=a_chk;
            if(rr==1){a_du=a_raw;}
            ar[o]=a_raw; ac[o]=a_chk; ad[o]=a_du;
            rawr=rawr+a_raw; chkr=chkr+a_chk;
            o=o+1;
        }
        let b:i32=qsame;
        if(b==1){conso=conso+5;}
        o=0;
        while(o<5){
            if(ar[o]==1 && b==1){raw3=raw3+1;}
            if(ac[o]==1 && b==1){chk3=chk3+1;}
            if(ad[o]==1 && b==1){du3=du3+1;}
            o=o+1;
        }
        zfree_i(ar); zfree_i(ac); zfree_i(ad);
        si=si+1;
    }
    out[0]=raw3; out[1]=chk3; out[2]=du3; out[3]=200;
    out[4]=rawr; out[5]=chkr; out[6]=conso;
    zfree_i(seq); zfree_i(oid); zfree_i(ost); zfree_i(oln);
    zfree_i(rec); zfree_i(cid);
}

// majority with fallback
fn bt_maj(n1:i32,n0:i32,fb:i32)i32 {
    if(n1>n0){return 1;}
    if(n0>n1){return 0;}
    return fb;
}

// find vocab index whose bytes equal seq[off..off+L); -1 if none
fn bt_vocab_find(c:*Btx,seq:[]i32,off:i32,L:i32)i32 {
    let s:i32=0;
    while(s<24){
        if(bt_span_eq(c.*.vlen,c.*.vdat,s,seq,off,L)==1){return s;}
        s=s+1;
    }
    return -1;
}

// ---------------------------------------------------------------------------
// B-T2 near-twin discrimination probe set (manifest §4). 192 trials.
// out: [0]=raw correct [1]=chunk correct [2]=dual correct [3]=n
// ---------------------------------------------------------------------------
fn bt_twin_probe(c:*Btx,out:[]i32)void {
    let ep:Bte=bte_init(BT_ENV_SEED+41);
    let en:Bte=bte_init(BT_ENV_SEED+31);
    let seq:[]i32=zalloc_i(64);
    let tmp:[]u8=bt_u8alloc(8);
    let oid:[]i32=zalloc_i(64);
    let ost:[]i32=zalloc_i(64);
    let oln:[]i32=zalloc_i(64);
    let cid:[]i32=zalloc_i(64);
    let cb:[]i32=zalloc_i(8);
    let gmaj:i32=bt_maj(c.*.gq1 as i32,c.*.gq0 as i32,1);
    let c_raw:i32=0; let c_chk:i32=0; let c_du:i32=0;
    let t:i32=0;
    while(t<192){
        let s:i32=bt_mod(t,24);
        let rep:i32=t/24;
        let is_twin:i32=(s+rep)&1;
        let L:i32=c.*.vlen[s];
        let k:i32=0;
        while(k<L){ tmp[k]=c.*.vdat[s*8+k]; k=k+1; }
        if(is_twin==1){
            let mid:i32=L/2;
            tmp[mid]=tmp[mid]^1;
        }
        let cons:i32=bt_sig(s&1);
        if(bte_bound(&en,5)==0){ cons=bt_flip(cons); }
        // episode: 8 filler + tmp + cons + 8 filler
        let w:i32=0;
        k=0;
        while(k<8){ seq[w]=BT_PFILL; w=w+1; k=k+1; }
        k=0;
        while(k<L){ seq[w]=(tmp[k] as i32); w=w+1; k=k+1; }
        seq[w]=cons; w=w+1;
        k=0;
        while(k<8){ seq[w]=BT_PFILL; w=w+1; k=k+1; }
        let n:i32=w;
        let truth:i32=0;
        if(cons==170){truth=1;}
        // raw prediction: exact-content lookup else global
        let vi:i32=bt_vocab_find(c,seq,8,L);
        let p_raw:i32=gmaj;
        if(vi>=0){ p_raw=bt_maj(c.*.vq1[vi],c.*.vq0[vi],gmaj); }
        // chunk prediction: vote over covering chunks iff fully covered
        let nout:i32=r0_segment(c.*.st,seq,n,oid,ost,oln,64);
        let m:i32=0;
        let covered:i32=bt_cover(c,oid,ost,oln,nout,8,L,cid,&m);
        let p_chk:i32=gmaj;
        if(covered==1){
            let v1:i32=0; let v0:i32=0;
            let j:i32=0;
            while(j<m){
                let cl:i32=r0_chunk_bytes(c.*.st,cid[j],cb,8);
                let wv:i32=bt_vocab_find(c,cb,0,cl);
                let vv:i32=gmaj;
                if(wv>=0){ vv=bt_maj(c.*.vq1[wv],c.*.vq0[wv],gmaj); }
                if(vv==1){v1=v1+1;} else {v0=v0+1;}
                j=j+1;
            }
            if(v1>v0){p_chk=1;} else { if(v0>v1){p_chk=0;} else {p_chk=gmaj;} }
        }
        let p_du:i32=p_raw;
        if(covered==1){p_du=p_chk;}
        if(p_raw==truth){c_raw=c_raw+1;}
        if(p_chk==truth){c_chk=c_chk+1;}
        if(p_du==truth){c_du=c_du+1;}
        t=t+1;
    }
    out[0]=c_raw; out[1]=c_chk; out[2]=c_du; out[3]=192;
    bt_u8free(tmp);
    zfree_i(seq); zfree_i(oid); zfree_i(ost); zfree_i(oln);
    zfree_i(cid); zfree_i(cb);
}

// ---------------------------------------------------------------------------
// Dual compression ratio (manifest §5).
// out: [0]=source [1]=stored [2]=ratio_mp [3]=payload
// ---------------------------------------------------------------------------
fn bt_compression(c:*Btx,T:i32,out:[]i32)void {
    let eu:Bte=bte_init(BT_ENV_SEED+21);
    let seq:[]i32=zalloc_i(4096);
    let oid:[]i32=zalloc_i(4096);
    let ost:[]i32=zalloc_i(4096);
    let oln:[]i32=zalloc_i(4096);
    let source:i64=0;
    let nunits:i64=0;
    let nlit:i64=0;
    let u:i32=0;
    while(u<T){
        let n:i32=bt_emit_unit(&eu,c,u,T,seq,0);
        source=source+n;
        let nout:i32=r0_segment(c.*.st,seq,n,oid,ost,oln,4096);
        let i:i32=0;
        while(i<nout){
            if(oid[i]>=0){nunits=nunits+1;} else {nlit=nlit+oln[i];}
            i=i+1;
        }
        u=u+1;
    }
    let payload:i64=0;
    let id:i32=0;
    let nc:i32=r0_chunk_count(c.*.st);
    while(id<nc){
        if(r0_chunk_state(c.*.st,id)==1){payload=payload+r0_chunk_len(c.*.st,id);}
        id=id+1;
    }
    let stored:i64=payload+nunits*4+nlit;
    let ratio:i32=0;
    if(stored>0){ ratio=((source*1000)/stored) as i32; }
    out[0]=source as i32; out[1]=stored as i32;
    out[2]=ratio; out[3]=payload as i32;
    zfree_i(seq); zfree_i(oid); zfree_i(ost); zfree_i(oln);
}

// ---------------------------------------------------------------------------
// Expected-value readback probe (standing rule C). Store-pattern checks with
// expected values + golden mini-run (manifest §8: T=2 => 6 filler-boundary
// chunks promote, ground raw=190/200, chunk=0/200, dual=190/200 — hand-derived
// under seed 20260921, asserted not copied).
// Runs standalone AND inside every battery run. Returns fail count.
// ---------------------------------------------------------------------------
fn bt_probe_run()i32 {
    let fails:i32=0;
    // 1. []i32 single-store loop readback, expected values
    let cells:[]i32=zalloc_i(500);
    let i:i32=0;
    while(i<500){ cells[i]=i*7-250; i=i+1; }
    i=0;
    while(i<500){ if(cells[i]!=i*7-250){fails=fails+1;} i=i+1; }
    zfree_i(cells);
    // 2. vocab table write/read with expected values
    let ev:Bte=bte_init(BT_ENV_SEED+11);
    let vl:[]i32=zalloc_i(24);
    let vd:[]u8=bt_u8alloc(24*8);
    bt_gen_spans(&ev,24,vl,vd);
    let ev2:Bte=bte_init(BT_ENV_SEED+11);
    let wl:[]i32=zalloc_i(24);
    let wd:[]u8=bt_u8alloc(24*8);
    bt_gen_spans(&ev2,24,wl,wd);
    i=0;
    while(i<24){
        if(vl[i]!=wl[i]){fails=fails+1;}
        let k:i32=0;
        while(k<8){ if(vd[i*8+k]!=wd[i*8+k]){fails=fails+1;} k=k+1; }
        i=i+1;
    }
    zfree_i(vl); bt_u8free(vd); zfree_i(wl); bt_u8free(wd);
    // 3. golden mini-run (hand-derived under seed 20260921, fixed filler 0x20,
    //    round-robin vocab, spans len 6..8): T=2 => each vocab span seen <=2
    //    (no span promotes) but 6 filler-boundary artifacts ("GG","GGG",
    //    sig+G, ...) reach seen>=5 with high purity and promote. Ground
    //    scores: raw re-reads bytes (190/200 label-3), chunk bank has no
    //    span-covering chunks (0/200), dual falls back to raw (190/200).
    let c:Btx=bt_ctx_new(0);
    let obs:i64=bt_train(&c,2);
    if(obs<1){fails=fails+1;}
    let idx:[]i32=zalloc_i(4096);
    let promoted:i32=r0_promote(c.st,idx);
    if(promoted!=6){fails=fails+1;}
    if(r0_live_count(c.st)!=6){fails=fails+1;}
    let g:[]i32=zalloc_i(8);
    bt_ground_probe(&c,g);
    if(g[0]!=190){fails=fails+1;}   // raw: 190/200 label-3
    if(g[1]!=0){fails=fails+1;}     // chunk: no span-covering chunks => 0
    if(g[2]!=190){fails=fails+1;}   // dual: raw fallback => 190
    if(g[3]!=200){fails=fails+1;}
    // 4. twin probe smoke on the mini context: determinism only (count check)
    let tw:[]i32=zalloc_i(8);
    bt_twin_probe(&c,tw);
    if(tw[3]!=192){fails=fails+1;}
    if(tw[0]<0 || tw[0]>192){fails=fails+1;}
    zfree_i(idx); zfree_i(g); zfree_i(tw);
    bt_ctx_free(&c);
    btp_str("BT_PROBE,fails=");
    btp_num(fails as i64);
    btp_ln();
    return fails;
}

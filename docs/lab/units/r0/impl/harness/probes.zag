// probes.zag — R0 probe/episode framework.
// Episode kinds: training units, hidden tests, hard-grounding probes
// (routes raw_active / chunk_active / dual_active for the B-T2 ablation),
// near-twin discrimination probes, dose-curve schedules (250 -> 8000),
// support-gap hard battery (1..16 exposures), split/merge dynamic scenarios.
//
// The framework defines the EPISODE STRUCTURE and SCHEDULES. Arm logic lives
// in the battery crews' binaries; every probe episode opens with
// audit_episode_begin() so results map to audit clocks.
@import("harness_common.zag")
@import("audit.zag")

const PROBE_TRAIN:i32=1;
const PROBE_HIDDEN:i32=2;
const PROBE_HARD:i32=3;
const PROBE_TWIN:i32=4;

const ROUTE_RAW:i32=1;
const ROUTE_CHUNK:i32=2;
const ROUTE_DUAL:i32=3;

struct ProbeEp {
    ptype:i32,
    route:i32,
    episode:i64,
    audit_n0:i64,   // audit clock at episode start (from audit_episode_begin)
    arg1:i64,
    arg2:i64
}

fn probe_begin(store:*AuditStore,ptype:i32,route:i32,arg1:i64,arg2:i64)ProbeEp {
    let ep:i64=audit_episode_begin(store);
    let n0:i64=audit_count(store);
    return ProbeEp{.ptype=ptype,.route=route,.episode=ep,.audit_n0=n0,
                   .arg1=arg1,.arg2=arg2};
}

fn probe_kind_name(ptype:i32)[]u8 {
    if(ptype==PROBE_TRAIN){return "train";}
    if(ptype==PROBE_HIDDEN){return "hidden";}
    if(ptype==PROBE_HARD){return "hard";}
    return "twin";
}
fn probe_route_name(route:i32)[]u8 {
    if(route==ROUTE_RAW){return "raw_active";}
    if(route==ROUTE_CHUNK){return "chunk_active";}
    return "dual_active";
}

// ---- dose curve: 250 -> 8000 (R0.1 battery 3; B-T3 bar: flat/non-decreasing)
fn dose_schedule_len()i32 { return 6; }
fn dose_schedule(i:i32)i64 {
    if(i==0){return 250;}if(i==1){return 500;}if(i==2){return 1000;}
    if(i==3){return 2000;}if(i==4){return 4000;}return 8000;
}

// ---- support-gap hard battery: 1..16 exposures (R0.1 battery 5; B-T4)
fn support_exposures(i:i32)i64 { return (i+1) as i64; }  // i in 0..15
fn support_battery_len()i32 { return 16; }

// ---- near-twin discrimination probe --------------------------------------
// twin = span with the middle byte flipped by XOR 0x01 — deterministic,
// documented, learner-independent. The probe asks: does the learner
// discriminate the true span from its near-twin?
fn probe_near_twin(span:[]u8,out:[]u8)i32 {
    if(span.len<1 || out.len<span.len){return -1;}
    let i:i32=0;while(i<span.len){out[i]=span[i];i=i+1;}
    let mid:i32=span.len/2;
    out[mid]=out[mid]^1;
    return 0;
}

// ---- split/merge dynamic scenario script ---------------------------------
// Ops: 1=ingest unit, 2=force split check, 3=force merge check,
//      4=revise (defect plant), 5=recall probe. Args are op-specific.
struct ScenarioOp { op:i32, arg1:i64, arg2:i64 }
const SCEN_MAX_OPS:i32=256;
struct Scenario { ops:[]u8, n:i32 }  // packed: 24 bytes per op (op@0, arg1@8, arg2@16)

fn scenario_new()Scenario {
    let ops:[]u8=nio_alloc(SCEN_MAX_OPS*24);
    return Scenario{.ops=ops,.n=0};
}
fn scenario_add(s:*Scenario,op:i32,arg1:i64,arg2:i64)i32 {
    if(s.*.n>=SCEN_MAX_OPS){return -1;}
    let b:[]u8=s.*.ops;
    let o:i32=s.*.n*24;
    let i:i32=0;
    while(i<4){b[o+i]=((op>>(i*8))&255) as u8;i=i+1;}
    i=0;
    while(i<8){b[o+8+i]=((arg1>>(i*8))&255) as u8;i=i+1;}
    i=0;
    while(i<8){b[o+16+i]=((arg2>>(i*8))&255) as u8;i=i+1;}
    s.*.n=s.*.n+1;
    return 0;
}
fn scenario_get(s:*Scenario,idx:i32)ScenarioOp {
    let bad:ScenarioOp=ScenarioOp{.op=0,.arg1=0,.arg2=0};
    if(idx<0 || idx>=s.*.n){return bad;}
    let b:[]u8=s.*.ops;
    let o:i32=idx*24;
    let op:i32=0;let arg1:i64=0;let arg2:i64=0;
    let i:i32=0;
    while(i<4){op=op|((b[o+i] as i32)<<(i*8));i=i+1;}
    i=0;
    while(i<8){arg1=arg1|((b[o+8+i] as i64)<<(i*8));i=i+1;}
    i=0;
    while(i<8){arg2=arg2|((b[o+16+i] as i64)<<(i*8));i=i+1;}
    return ScenarioOp{.op=op,.arg1=arg1,.arg2=arg2};
}
fn scenario_free(s:*Scenario)void { nio_free(s.*.ops);s.*.n=0; }

// Canonical split/merge dynamic scenario for B-T5: ingest a recruited chunk,
// then plant the conflict pattern that should fire split, then the pair
// pattern that should fire merge. Battery crews interpret the ops; the
// harness fixes the ORDER and the audit mapping.
fn scenario_split_merge(s:*Scenario)void {
    scenario_add(s,1,0,0);   // ingest unit A (recruit chunk)
    scenario_add(s,1,1,0);   // ingest unit B (conflict context)
    scenario_add(s,2,0,0);    // split check: expect SPLIT fires
    scenario_add(s,5,0,0);    // recall probe: boundaries mutable?
    scenario_add(s,1,2,0);    // ingest unit C (pair context)
    scenario_add(s,3,0,0);    // merge check: expect MERGE fires
    scenario_add(s,5,1,0);    // recall probe: re-merged boundary
}

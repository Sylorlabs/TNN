// corpus.zag — R0 corpora pipeline.
// Corpora: Project Gutenberg #100 (Shakespeare prose, ~5.4MB) + sqlite3.c
// amalgamation (code, ~9.5MB). FETCHED ON DEMAND via fetch_corpora.sh;
// NEVER committed. Deterministic FIXED FILE-ORDER ingest: prose first,
// code second — identical for all arms (confounder C2 control).
// Corpus hashes are recorded in the evidence log (M-30) BEFORE any arm
// is built; the committed hash record is the commitment.
// Stripe size 2^24 keeps every indexed slice under the 2^25 znc wall.
@import("harness_common.zag")
@import("evidence.zag")

const CORPUS_COUNT:i32=2;
const CORPUS_STRIPE:i32=16777216;
const CORPUS_MAX_BYTES:i32=33554431;

struct CorpusRec {
    id:i64,
    name:[]u8,      // non-owned literal
    bytes:i64,
    sha_hex:[]u8,   // owned; nio_free after evidence write
    stripes:i32
}

fn corpus_name(id:i32)[]u8 {
    if(id==0){return "pg100.txt";}
    return "sqlite3.c";
}
fn corpus_desc(id:i32)[]u8 {
    if(id==0){return "gutenberg-100-shakespeare-prose";}
    return "sqlite3-amalgamation-code";
}

// Ingest one corpus file; record into ev. Returns bytes or negative error.
fn corpus_ingest_one(rootp:[]u8,id:i32,ev:*EvLog)CorpusRec {
    let rec:CorpusRec=CorpusRec{.id=id as i64,.name=corpus_name(id),
                                .bytes=-1,.sha_hex="",.stripes=0};
    let buf:[]u8=nio_alloc(CORPUS_MAX_BYTES);
    if(buf.len!=CORPUS_MAX_BYTES){return rec;}
    let n:i64=hc_read_file(rootp,corpus_name(id),buf);
    if(n<0){nio_free(buf);return rec;}
    rec.bytes=n;
    let data:[]u8=buf[0..(n as i32)];
    let hex:[]u8=hc_sha256_hex(data);
    rec.sha_hex=hex;
    let st:i32=0;
    let stripe:i32=0;
    while(st<data.len){
        let en:i32=st+CORPUS_STRIPE;
        if(en>data.len){en=data.len;}
        let sh:[]u8=hc_sha256_hex(data[st..en]);
        // stripe hash recorded inline in payload
        stripe=stripe+1;
        st=en;
        nio_free(sh);
    }
    rec.stripes=stripe;
    // evidence line: CORPUS id name bytes sha256 stripes
    let pl:[]u8=nio_alloc(256);
    if(pl.len==256){
        let o:i32=0;o=ev_str(pl,o,"id=");o=ev_raw(pl,o,rec.id);
        o=ev_str(pl,o," name=");o=ev_str(pl,o,corpus_desc(id));
        o=ev_str(pl,o," file=");o=ev_str(pl,o,rec.name);
        o=ev_str(pl,o," bytes=");o=ev_raw(pl,o,rec.bytes);
        o=ev_str(pl,o," sha256=");o=ev_str(pl,o,hex);
        o=ev_str(pl,o," stripes=");o=ev_raw(pl,o,stripe as i64);
        ev_line(ev,"CORPUS",pl[0..o]);
        nio_free(pl);
    }
    nio_free(buf);
    return rec;
}

// Fixed-order ingest of the full corpus set. Returns number ingested ok.
fn corpus_ingest_all(rootp:[]u8,ev:*EvLog) i32 {
    ev_line(ev,"CORPUS_ORDER","0=gutenberg-100-shakespeare-prose 1=sqlite3-amalgamation-code fixed");
    let ok:i32=0;
    let id:i32=0;
    while(id<CORPUS_COUNT){
        let rec:CorpusRec=corpus_ingest_one(rootp,id,ev);
        if(rec.bytes>=0){ok=ok+1;}
        if(rec.sha_hex.len>0){nio_free(rec.sha_hex);}
        _zag_print("CORPUS_INGEST,");_zag_print(corpus_desc(id));
        _zag_print(",bytes=");hc_num(rec.bytes);
        _zag_print(",stripes=");hc_num(rec.stripes as i64);
        _zag_println("");
        id=id+1;
    }
    return ok;
}

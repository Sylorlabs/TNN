// driver.zag — R0 harness driver. ONE binary, argv[1] selects the config:
//   selftest [perturb]        harness smoke: audit ledger (packed 64B layout),
//                             episode mapping, STORESEQ store-pattern probe,
//                             probes, m8 armor, evidence JSON
//   r1test   [perturb]        R-1 aggregation test (grouping + label/purity math)
//   ingest   [perturb] <corpora_dir> <evidence_dir>
//                             deterministic corpora ingest + hash records
//   scorecard [perturb]       emit a sample metrics-v1 scorecard JSON
// argv[2] is the M8 perturb flag {0..4} when numeric (default 0).
// Diff two runs per config for byte-identical verification.
@import("harness_common.zag")
@import("audit.zag")
@import("evidence.zag")
@import("corpus.zag")
@import("r1_label.zag")
@import("probes.zag")
@import("m8_armor.zag")

fn drv_parse_perturb()i64 {
    if(_zag_argc()<3){return 0;}
    let a:[]u8=_zag_arg(2);
    if(a.len!=1){return 0;}
    let c:i32=a[0] as i32;
    if(c>=48 && c<=52){return (c-48) as i64;}
    return 0;
}

// STORESEQ — targeted determinism probe for the indexed-store sequences this
// harness still uses (coordinator hardening, 2026-09-21, re ZNC-2026-09-19-001).
// Every sequence is written and read back against EXPECTED values: a
// deterministic miscompile would produce identical-but-wrong bytes across
// runs, so byte-identical reruns alone cannot prove the patterns safe.
fn drv_storeseq()i32 {
    let fails:i32=0;
    let i:i32=0;
    // 1. le32 roundtrip incl. negatives/extremes (expected values in []u8
    //    cells — no 3+ sequential []i32 stores anywhere in this probe)
    let c32:[]u8=nio_alloc(20);
    let ev32:[]u8=nio_alloc(20);
    hc_le32_set(c32,0,0);hc_le32_set(c32,4,1);hc_le32_set(c32,8,-1);
    hc_le32_set(c32,12,2147483647);hc_le32_set(c32,16,-2147483648);
    hc_le32_set(ev32,0,0);hc_le32_set(ev32,4,1);hc_le32_set(ev32,8,-1);
    hc_le32_set(ev32,12,2147483647);hc_le32_set(ev32,16,-2147483648);
    i=0;while(i<5){if(hc_le32_get(c32,i*4)!=hc_le32_get(ev32,i*4)){fails=fails+1;}i=i+1;}
    // 2. le64 roundtrip incl. extremes
    let c64:[]u8=nio_alloc(40);
    hc_le64_set(c64,0,0);hc_le64_set(c64,8,1);hc_le64_set(c64,16,-1);
    hc_le64_set(c64,24,9223372036854775807);hc_le64_set(c64,32,-9223372036854775808);
    if(hc_le64_get(c64,0)!=0){fails=fails+1;}
    if(hc_le64_get(c64,8)!=1){fails=fails+1;}
    if(hc_le64_get(c64,16)!=-1){fails=fails+1;}
    if(hc_le64_get(c64,24)!=9223372036854775807){fails=fails+1;}
    if(hc_le64_get(c64,32)!=-9223372036854775808){fails=fails+1;}
    // 3. 500 sequential []u8-backed i32 cells (EXPLORE-verified pattern)
    let cu:[]u8=nio_alloc(2000);
    i=0;while(i<500){hc_le32_set(cu,i*4,i*7-250);i=i+1;}
    i=0;while(i<500){if(hc_le32_get(cu,i*4)!=i*7-250){fails=fails+1;}i=i+1;}
    // 4. 2 sequential []i64 stores (m8_trace_rec / block-header pattern)
    let t2:[]i64=hc_alloc_i64(4);
    t2[0]=123456789;t2[1]=987654321;
    if(t2[0]!=123456789||t2[1]!=987654321){fails=fails+1;}
    t2[2]=-5;t2[3]=-7;
    if(t2[2]!=-5||t2[3]!=-7){fails=fails+1;}
    // 5. single-store loop at large index (hc_alloc zeroing pattern)
    let big:[]i64=hc_alloc_i64(70000);
    if(big[69999]!=0){fails=fails+1;}
    big[69999]=42;big[60000]=-42;
    if(big[69999]!=42||big[60000]!=-42){fails=fails+1;}
    nio_free(c32);nio_free(ev32);nio_free(c64);nio_free(cu);
    hc_free_i64(t2);hc_free_i64(big);
    _zag_print("STORESEQ,fails=");hc_num(fails as i64);_zag_println("");
    return fails;
}

fn drv_selftest(armor:*M8Armor)i32 {
    let fails:i32=0;
    // --- audit ledger: packed 64-byte layout roundtrip, logical 16-value readback
    let st:AuditStore=audit_store_new();
    // b/a as []u8 LE cells (no []i32 arrays in the audit path)
    let b:[]u8=nio_alloc(20);let av:[]u8=nio_alloc(20);
    let i:i32=0;while(i<5){hc_le32_set(b,i*4,100+i);i=i+1;}
    i=0;while(i<5){hc_le32_set(av,i*4,200+i);i=i+1;}
    let n0:i64=audit_append(&st,7,3,0,b,av,2,11,13);
    if(n0!=0){fails=fails+1;}
    let e0:[]u8=nio_alloc(64);
    if(audit_get(&st,0,e0)!=0){fails=fails+1;}
    // logical indices: 0=op,1=slot,2=rc,3..7=b1..b5,8..12=a1..a5,13=stage,14=d1,15=d2
    if(hc_le32_get(e0,0)!=7||hc_le32_get(e0,4)!=3||hc_le32_get(e0,8)!=0){fails=fails+1;}
    if(hc_le32_get(e0,12)!=100||hc_le32_get(e0,28)!=104){fails=fails+1;}
    if(hc_le32_get(e0,32)!=200||hc_le32_get(e0,48)!=204){fails=fails+1;}
    if(hc_le32_get(e0,52)!=2||hc_le32_get(e0,56)!=11||hc_le32_get(e0,60)!=13){fails=fails+1;}
    // byte-level spot check: d1 lives at byte offset 56, little-endian
    let bp:*u8=st.chunk_addrs[0] as *u8;
    let ch:[]u8=bp[0..65536];
    if(ch[56]!=11||ch[57]!=0||ch[58]!=0||ch[59]!=0){fails=fails+1;}
    // --- episode mapping
    let ep0:i64=audit_episode_begin(&st);
    audit_append(&st,8,0,0,b,av,0,0,0);
    audit_append(&st,8,0,0,b,av,0,0,0);
    let ep1:i64=audit_episode_begin(&st);
    if(ep0!=0||ep1!=1){fails=fails+1;}
    if(audit_episode_of(&st,0)!=-1){fails=fails+1;}
    if(audit_episode_of(&st,1)!=0){fails=fails+1;}
    if(audit_episode_of(&st,3)!=1){fails=fails+1;}
    // --- ledger hash determinism: rebuild and compare
    let h1:[]u8=audit_ledger_hash(&st);
    let h2:[]u8=audit_ledger_hash(&st);
    if(nio_equal(h1,h2)!=1){fails=fails+1;}
    // --- store-sequence determinism probe
    fails=fails+drv_storeseq();
    // --- probe framework smoke
    let pe:ProbeEp=probe_begin(&st,PROBE_HARD,ROUTE_DUAL,0,0);
    if(pe.episode!=2){fails=fails+1;}
    let ds_ok:i32=1;
    i=0;while(i<dose_schedule_len()){if(dose_schedule(i)<=0){ds_ok=0;}i=i+1;}
    if(dose_schedule(0)!=250||dose_schedule(5)!=8000){fails=fails+1;}
    if(support_battery_len()!=16||support_exposures(0)!=1||support_exposures(15)!=16){fails=fails+1;}
    let sc:Scenario=scenario_new();
    scenario_split_merge(&sc);
    if(sc.n!=7){fails=fails+1;}
    let op0:ScenarioOp=scenario_get(&sc,0);
    let op6:ScenarioOp=scenario_get(&sc,6);
    if(op0.op!=1||op6.op!=5){fails=fails+1;}
    scenario_free(&sc);
    let tw:[]u8="abcdef";let tout:[]u8=nio_alloc(6);
    probe_near_twin(tw,tout);
    if(tout[3]!=(100^1)){fails=fails+1;}
    nio_free(tout);
    // --- captures
    _zag_print("SELFTEST,fails=");hc_num(fails as i64);_zag_println("");
    let sh:[]u8=m8_store_snapshot("selftest-store-image");
    m8_emit_captures(armor,sh,h1);
    nio_free(sh);nio_free(h1);nio_free(h2);
    nio_free(b);nio_free(av);nio_free(e0);
    audit_store_free(&st);
    if(ds_ok!=1){fails=fails+1;}
    return fails;
}

fn drv_scorecard()void {
    let sc:Scorecard=Scorecard{
        .arm="HARNESS-SELFTEST",.round=0,.scale=1,
        .m1_recall_prose=100000,.m1_recall_code=100000,
        .m1_boundary_prose=99700,.m1_boundary_code=99600,
        .m1_id_probe="N/A (no ID layer)",
        .m2_t1_prose=2,.m2_t1_code=3,.m2_t2=4,.m2_t3=5,
        .m3_survival=96200,.m3_freeze_flag="CLEAR",
        .m4_rev_bound=88000,.m4_rev_content=91000,.m4_kill=6000,.m4_ksub="false",
        .m5_mem_per_byte=1320,.m5_audit_per_kb=7100,
        .m6_p2c_rec=97000,.m6_p2c_bnd=93000,.m6_p2c_rev=74000,
        .m6_c2p_rec=96000,.m6_c2p_bnd=91000,.m6_c2p_rev=71000,
        .m6_tax_p2c=-3500,.m6_tax_c2p=-4000,
        .m7_hit=-1,.m7_reuse=-1,.m7_dedup=-1,.m7_na_reason="no ID layer",
        .m8_gate="PASS",
        .m9_shape="fast-then-flat",.m9_t=1,.m9_s=52,.m9_l=11,
        .disqualified="false"};
    let buf:[]u8=nio_alloc(65536);
    let n:i32=scorecard_emit(&sc,buf);
    _zag_print("SCORECARD_JSON,bytes=");hc_num(n as i64);_zag_println("");
    _zag_println("");
    let out:[]u8=buf[0..n];
    _zag_print(out);_zag_println("");
    nio_free(buf);
}

fn drv_r1test(armor:*M8Armor)i32 {
    let fails:i32=r1_test();
    let sh:[]u8=m8_store_snapshot("r1test-store-image");
    let empty:[]u8="";
    m8_emit_captures(armor,sh,empty);
    nio_free(sh);
    _zag_print("R1TEST,fails=");hc_num(fails as i64);_zag_println("");
    return fails;
}

fn drv_ingest(cdir:[]u8,evdir:[]u8)i32 {
    let ev:EvLog=ev_open(evdir,"ingest.evidence.log");
    if(ev.ok!=1){_zag_println("INGEST,evlog-open-failed");return 1;}
    ev_line(&ev,"SEED_DECL","ENV_SEED=20260921 environment-input-only never-ai-decision");
    ev_line(&ev,"HARNESS","r0-harness ingest config=ingest");
    let ok:i32=corpus_ingest_all(cdir,&ev);
    ev_line(&ev,"INGEST_DONE","ok-corpora");
    ev_close(&ev);
    _zag_print("INGEST,corpora_ok=");hc_num(ok as i64);_zag_println("");
    if(ok!=CORPUS_COUNT){return 1;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<2){_zag_println("usage: driver <selftest|r1test|ingest|scorecard> [perturb] ...");return 64;}
    hc_print_seed_decl();
    let pert:i64=drv_parse_perturb();
    let armor:M8Armor=m8_new();
    if(m8_armor_init(&armor,pert)!=0){_zag_println("M8_ARMOR_INIT_FAILED");return 1;}
    let cfg:[]u8=_zag_arg(1);
    let rc:i32=0;
    if(nio_equal(cfg,"selftest")==1){rc=drv_selftest(&armor);}
    else{
        if(nio_equal(cfg,"r1test")==1){rc=drv_r1test(&armor);}
        else{
            if(nio_equal(cfg,"scorecard")==1){drv_scorecard();}
            else{
                if(nio_equal(cfg,"ingest")==1){
                    if(_zag_argc()<5){_zag_println("usage: driver ingest <perturb> <corpora_dir> <evidence_dir>");return 64;}
                    rc=drv_ingest(_zag_arg(3),_zag_arg(4));
                } else {_zag_println("unknown-config");rc=64;}
            }
        }
    }
    m8_armor_free(&armor);
    return rc;
}

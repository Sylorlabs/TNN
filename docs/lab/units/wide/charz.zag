// EXPLORATORY — NOT EVIDENCE
// charz.zag — deterministic byte-level characterizer for code corpora.
// EXPLORATORY tooling for the TNN representation program's wide track.
// Pure Zag. Zero randomness: FNV-1a hashing, fixed-size tables, one
// deterministic scan. Same input bytes -> same output bytes, always.
//
// usage: charz <mode> <label> <path>
//   mode: python | lua | javascript | rust | go | asm
//
// Lexer simplifications (documented, deterministic; byte-identical reruns
// hold regardless):
// - Multi-byte comment/string openers or closers split across a 1MiB read
//   chunk boundary are not re-examined (probability ~1e-6 per closer).
// - python: r"/b" prefixes are not special-cased; byte counts are identical
//   except the rare backslash-quote edge inside raw strings.
// - rust/go: a char literal is recognized only as 'x', '\e', or '\u{...}';
//   other apostrophe patterns (lifetimes like 'a) count as code bytes.
// - rust raw identifiers (r#type) lex as ident "r" + code "#" + ident.
// - javascript: template ${} nesting is not tracked; a backtick string runs
//   to its closing backtick honoring backslash escapes.
// - asm: line comments '#' and ';', block /* */. Dialect variations exist
//   (e.g. '//' on some targets) and are not covered.

fn z_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8) void { if(b.len>0){_zag_free(_zag_slice_ptr(b));} }
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn pnum(x:i64) void { let s:[]u8=_zag_i64_to_str(x);_zag_print(s);z_free(s); }
fn pline(nm:[]u8,x:i64) void { _zag_print(nm);_zag_print(" ");pnum(x);_zag_println(""); }

fn u64_at(b:[]u8,at:i32) i64 {
    let v:i64=0;let i:i32=0;
    while(i<8){v=v+((b[at+i] as i64)<<(i*8));i=i+1;}
    return v;
}
fn u64_put(b:[]u8,at:i32,v:i64) void {
    b[at]=(v as u8);b[at+1]=((v>>8) as u8);b[at+2]=((v>>16) as u8);b[at+3]=((v>>24) as u8);
    b[at+4]=((v>>32) as u8);b[at+5]=((v>>40) as u8);b[at+6]=((v>>48) as u8);b[at+7]=((v>>56) as u8);
}
fn i32_at(b:[]u8,at:i32) i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn i32_put(b:[]u8,at:i32,v:i32) void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

struct Scan {
    state:i32, nest:i32, q:i32, triple:i32, rawhash:i32, longeq:i32, backtick:i32,
    dp:i32, db:i32, dc:i32,
    id0:i64, id1:i64, id2:i64, id3:i64, idlen:i32,
    bytes:i64, lines:i64, comment:i64, string:i64, code:i64,
    maxdepth:i32, depthsum:i64, dsamples:i64,
    ident_total:i64,
    bh:[]u8, dh:[]u8, tab:[]u8, tmask:i32
}

// bucket: 0=code 1=comment 2=string
fn tick(s:*Scan,c:u8,bucket:i32) void {
    s.*.bytes=s.*.bytes+1;
    let bh:[]u8=s.*.bh;
    let off:i32=(c as i32)*8;
    u64_put(bh,off,u64_at(bh,off)+1);
    if(bucket==0){s.*.code=s.*.code+1;}
    else{if(bucket==1){s.*.comment=s.*.comment+1;}else{s.*.string=s.*.string+1;}}
    if(c==10){s.*.lines=s.*.lines+1;}
}
fn dsample(s:*Scan) void {
    let d:i32=s.*.dp+s.*.db+s.*.dc;
    s.*.depthsum=s.*.depthsum+(d as i64);
    s.*.dsamples=s.*.dsamples+1;
    if(d>s.*.maxdepth){s.*.maxdepth=d;}
    let dd:i32=d;if(dd>63){dd=63;}
    let dh:[]u8=s.*.dh;
    let off:i32=dd*8;
    u64_put(dh,off,u64_at(dh,off)+1);
}

fn is_istart(c:u8) i32 {
    let v:i32=c as i32;
    if((v>=65 && v<=90)||(v>=97 && v<=122)||v==95){return 1;}
    return 0;
}
fn is_ichar(c:u8) i32 {
    if(is_istart(c)==1){return 1;}
    let v:i32=c as i32;
    if(v>=48 && v<=57){return 1;}
    return 0;
}
fn id_put(s:*Scan,c:u8) void {
    let n:i32=s.*.idlen;
    if(n<32){
        let slot:i32=n/8;let sh:i32=(n-slot*8)*8;
        let w:i64=(c as i64)<<sh;
        if(slot==0){s.*.id0=s.*.id0|w;}
        else{if(slot==1){s.*.id1=s.*.id1|w;}
        else{if(slot==2){s.*.id2=s.*.id2|w;}
        else{s.*.id3=s.*.id3|w;}}}
    }
    s.*.idlen=n+1;
}
fn id_keybyte(s:*Scan,k:i32) u8 {
    let slot:i32=k/8;let sh:i32=(k-slot*8)*8;
    let w:i64=0;
    if(slot==0){w=s.*.id0;}else{if(slot==1){w=s.*.id1;}else{if(slot==2){w=s.*.id2;}else{w=s.*.id3;}}}
    return (w>>sh) as u8;
}
fn id_fnv(s:*Scan) i64 {
    // FNV-1a 64, offset basis as signed two's complement (-3750763034362895579).
    let h:i64=-3750763034362895579;
    let k:i32=0;
    while(k<32){
        h=(h^(id_keybyte(s,k) as i64))*1099511628211;
        k=k+1;
    }
    return h;
}
fn id_clear(s:*Scan) void {
    s.*.id0=0;s.*.id1=0;s.*.id2=0;s.*.id3=0;s.*.idlen=0;
}
fn id_keyeq(s:*Scan,t:[]u8,base:i32) i32 {
    if(u64_at(t,base)!=s.*.id0){return 0;}
    if(u64_at(t,base+8)!=s.*.id1){return 0;}
    if(u64_at(t,base+16)!=s.*.id2){return 0;}
    if(u64_at(t,base+24)!=s.*.id3){return 0;}
    return 1;
}
fn id_flush(s:*Scan) void {
    if(s.*.idlen<1){return;}
    let t:[]u8=s.*.tab;
    let m:i32=s.*.tmask;
    let h:i64=id_fnv(s);
    let idx:i32=(h&(m as i64)) as i32;
    let probe:i32=0;
    while(probe<=m){
        let base:i32=idx*40;
        let c:i64=u64_at(t,base+32);
        if(c==0){
            u64_put(t,base,s.*.id0);u64_put(t,base+8,s.*.id1);
            u64_put(t,base+16,s.*.id2);u64_put(t,base+24,s.*.id3);
            u64_put(t,base+32,1);
            s.*.ident_total=s.*.ident_total+1;
            id_clear(s);
            return;
        }
        if(id_keyeq(s,t,base)==1){
            u64_put(t,base+32,c+1);
            s.*.ident_total=s.*.ident_total+1;
            id_clear(s);
            return;
        }
        idx=(idx+1)&m;
        probe=probe+1;
    }
    // table full: drop (deterministic); corpus sizes make this unreachable.
    id_clear(s);
}

// shared NORMAL-state tail: identifiers, brackets, other code bytes.
fn norm_tail(s:*Scan,buf:[]u8,n:i32,ip:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(is_istart(c)==1){
        while(i<n && is_ichar(buf[i])==1){
            id_put(s,buf[i]);
            tick(s,buf[i],0);dsample(s);
            i=i+1;
        }
        if(i<n){id_flush(s);}
    }else{
    if(cv==40){dsample(s);tick(s,c,0);s.*.dp=s.*.dp+1;i=i+1;}
    else{if(cv==41){if(s.*.dp>0){s.*.dp=s.*.dp-1;}dsample(s);tick(s,c,0);i=i+1;}
    else{if(cv==91){dsample(s);tick(s,c,0);s.*.db=s.*.db+1;i=i+1;}
    else{if(cv==93){if(s.*.db>0){s.*.db=s.*.db-1;}dsample(s);tick(s,c,0);i=i+1;}
    else{if(cv==123){dsample(s);tick(s,c,0);s.*.dc=s.*.dc+1;i=i+1;}
    else{if(cv==125){if(s.*.dc>0){s.*.dc=s.*.dc-1;}dsample(s);tick(s,c,0);i=i+1;}
    else{tick(s,c,0);dsample(s);i=i+1;}
    }}}}}}
    ip.*=i;
}
fn peek(buf:[]u8,n:i32,i:i32,off:i32) i32 {
    let p:i32=i+off;
    if(p<0||p>=n){return -1;}
    return buf[p] as i32;
}

// ---- per-mode NORMAL-state heads (small, brace-balanced by construction) ----
fn norm_py(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,qp:*i32,triplep:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==35){
        tick(s,c,1);statep.*=1;i=i+1;
    }else{
        if(cv==39||cv==34){
            if(peek(buf,n,i,1)==cv && peek(buf,n,i,2)==cv){
                tick(s,c,2);tick(s,buf[i+1],2);tick(s,buf[i+2],2);
                i=i+3;statep.*=3;qp.*=cv;triplep.*=1;
            }else{
                tick(s,c,2);i=i+1;statep.*=3;qp.*=cv;triplep.*=0;
            }
        }else{
            norm_tail(s,buf,n,&i);
        }
    }
    ip.*=i;
}
fn norm_lua(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,longeqp:*i32,qp:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==45 && peek(buf,n,i,1)==45){
        if(peek(buf,n,i,2)==91){
            let p:i32=i+3;let k:i32=0;
            while(p<n && (buf[p] as i32)==61){p=p+1;k=k+1;}
            if(p<n && (buf[p] as i32)==91){
                let k2:i32=i;while(k2<=p){tick(s,buf[k2],1);k2=k2+1;}
                i=p+1;statep.*=2;longeqp.*=k;
            }else{
                tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=1;
            }
        }else{
            tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=1;
        }
    }else{
        if(cv==91){
            let p:i32=i+1;let k:i32=0;
            while(p<n && (buf[p] as i32)==61){p=p+1;k=k+1;}
            if(p<n && (buf[p] as i32)==91){
                let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                i=p+1;statep.*=3;longeqp.*=k;
            }else{
                norm_tail(s,buf,n,&i);
            }
        }else{
            if(cv==39||cv==34){
                tick(s,c,2);i=i+1;statep.*=3;qp.*=cv;
            }else{
                norm_tail(s,buf,n,&i);
            }
        }
    }
    ip.*=i;
}
fn norm_js(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,qp:*i32,btp:*i32,nestp:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==47 && peek(buf,n,i,1)==47){
        tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=1;
    }else{
        if(cv==47 && peek(buf,n,i,1)==42){
            tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=2;nestp.*=1;
        }else{
            if(cv==39||cv==34||cv==96){
                tick(s,c,2);i=i+1;statep.*=3;qp.*=cv;
                if(cv==96){btp.*=1;}else{btp.*=0;}
            }else{
                norm_tail(s,buf,n,&i);
            }
        }
    }
    ip.*=i;
}
fn norm_rust(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,qp:*i32,rhp:*i32,nestp:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==47 && peek(buf,n,i,1)==47){
        tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=1;
    }else{
        if(cv==47 && peek(buf,n,i,1)==42){
            tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=2;nestp.*=1;
        }else{
            if(cv==114 && (peek(buf,n,i,1)==34||peek(buf,n,i,1)==35)){
                let p:i32=i+1;let k:i32=0;
                while(p<n && (buf[p] as i32)==35){p=p+1;k=k+1;}
                if(p<n && (buf[p] as i32)==34){
                    let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                    i=p+1;statep.*=3;qp.*=34;rhp.*=k;
                }else{
                    norm_tail(s,buf,n,&i);
                }
            }else{
                if(cv==98 && peek(buf,n,i,1)==34){
                    tick(s,c,2);tick(s,buf[i+1],2);i=i+2;statep.*=3;qp.*=34;rhp.*=-1;
                }else{
                    if(cv==98 && peek(buf,n,i,1)==114 && (peek(buf,n,i,2)==34||peek(buf,n,i,2)==35)){
                        let p:i32=i+2;let k:i32=0;
                        while(p<n && (buf[p] as i32)==35){p=p+1;k=k+1;}
                        if(p<n && (buf[p] as i32)==34){
                            let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                            i=p+1;statep.*=3;qp.*=34;rhp.*=k;
                        }else{
                            norm_tail(s,buf,n,&i);
                        }
                    }else{
                        if(cv==34){
                            tick(s,c,2);i=i+1;statep.*=3;qp.*=34;rhp.*=-1;
                        }else{
                            if(cv==39){
                                if(peek(buf,n,i,2)==39){
                                    tick(s,c,2);tick(s,buf[i+1],2);tick(s,buf[i+2],2);i=i+3;
                                }else{
                                    if(peek(buf,n,i,1)==92){
                                        let p:i32=i+2;
                                        while(p<n && p<i+16 && (buf[p] as i32)!=39){p=p+1;}
                                        if(p<n && p<i+16){
                                            let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                                            i=p+1;
                                        }else{
                                            tick(s,c,0);dsample(s);i=i+1;
                                        }
                                    }else{
                                        tick(s,c,0);dsample(s);i=i+1;
                                    }
                                }
                            }else{
                                norm_tail(s,buf,n,&i);
                            }
                        }
                    }
                }
            }
        }
    }
    ip.*=i;
}
fn norm_go(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,qp:*i32,btp:*i32,nestp:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==47 && peek(buf,n,i,1)==47){
        tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=1;
    }else{
        if(cv==47 && peek(buf,n,i,1)==42){
            tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=2;nestp.*=1;
        }else{
            if(cv==34){
                tick(s,c,2);i=i+1;statep.*=3;qp.*=34;btp.*=0;
            }else{
                if(cv==96){
                    tick(s,c,2);i=i+1;statep.*=3;qp.*=96;btp.*=1;
                }else{
                    if(cv==39){
                        if(peek(buf,n,i,2)==39){
                            tick(s,c,2);tick(s,buf[i+1],2);tick(s,buf[i+2],2);i=i+3;
                        }else{
                            if(peek(buf,n,i,1)==92){
                                let p:i32=i+2;
                                while(p<n && p<i+16 && (buf[p] as i32)!=39){p=p+1;}
                                if(p<n && p<i+16){
                                    let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                                    i=p+1;
                                }else{
                                    tick(s,c,0);dsample(s);i=i+1;
                                }
                            }else{
                                tick(s,c,0);dsample(s);i=i+1;
                            }
                        }
                    }else{
                        norm_tail(s,buf,n,&i);
                    }
                }
            }
        }
    }
    ip.*=i;
}
fn norm_asm(s:*Scan,buf:[]u8,n:i32,ip:*i32,statep:*i32,qp:*i32,nestp:*i32) void {
    let i:i32=ip.*;
    let c:u8=buf[i];
    let cv:i32=c as i32;
    if(cv==35||cv==59){
        tick(s,c,1);statep.*=1;i=i+1;
    }else{
        if(cv==47 && peek(buf,n,i,1)==42){
            tick(s,c,1);tick(s,buf[i+1],1);i=i+2;statep.*=2;nestp.*=1;
        }else{
            if(cv==34||cv==39){
                tick(s,c,2);i=i+1;statep.*=3;qp.*=cv;
            }else{
                norm_tail(s,buf,n,&i);
            }
        }
    }
    ip.*=i;
}

// ---- the lexer: one deterministic pass over buf[0..n] ----
fn scan_chunk(s:*Scan,buf:[]u8,n:i32,mode:i32) void {
    let i:i32=0;
    let state:i32=s.*.state;
    let nest:i32=s.*.nest;
    let q:i32=s.*.q;
    let triple:i32=s.*.triple;
    let rawhash:i32=s.*.rawhash;
    let longeq:i32=s.*.longeq;
    let backtick:i32=s.*.backtick;
    while(i<n){
        let c:u8=buf[i];
        let cv:i32=c as i32;
        if(state==1){
            // line comment runs to newline; the newline itself is code
            if(cv==10){tick(s,c,0);state=0;i=i+1;}
            else{tick(s,c,1);i=i+1;}
        }else{
        if(state==2){
            // block comment
            if(mode==4){
                // rust: nesting /* */
                if(cv==47 && peek(buf,n,i,1)==42){tick(s,c,1);tick(s,buf[i+1],1);nest=nest+1;i=i+2;}
                else{if(cv==42 && peek(buf,n,i,1)==47){tick(s,c,1);tick(s,buf[i+1],1);nest=nest-1;i=i+2;if(nest<=0){state=0;nest=0;}}
                else{tick(s,c,1);i=i+1;}}
            }else{
            if(mode==2){
                // lua: closer is ] + longeq*'=' + ]
                if(cv==93){
                    let p:i32=i+1;let j:i32=0;
                    while(j<longeq && p<n && (buf[p] as i32)==61){p=p+1;j=j+1;}
                    if(j==longeq && p<n && (buf[p] as i32)==93){
                        let k2:i32=i;while(k2<=p){tick(s,buf[k2],1);k2=k2+1;}
                        i=p+1;state=0;longeq=-1;
                    }else{tick(s,c,1);i=i+1;}
                }else{tick(s,c,1);i=i+1;}
            }else{
                // js/go/asm: closer is */
                if(cv==42 && peek(buf,n,i,1)==47){tick(s,c,1);tick(s,buf[i+1],1);i=i+2;state=0;}
                else{tick(s,c,1);i=i+1;}
            }}
        }else{
        if(state==3){
            // string literal
            if(rawhash>=0){
                // rust raw string: closer is " + rawhash*'#'
                if(cv==34){
                    let p:i32=i+1;let j:i32=0;
                    while(j<rawhash && p<n && (buf[p] as i32)==35){p=p+1;j=j+1;}
                    if(j==rawhash){
                        let k2:i32=i;while(k2<p){tick(s,buf[k2],2);k2=k2+1;}
                        i=p;state=0;rawhash=-1;
                    }else{tick(s,c,2);i=i+1;}
                }else{tick(s,c,2);i=i+1;}
            }else{
            if(longeq>=0){
                // lua long string: closer is ] + longeq*'=' + ]
                if(cv==93){
                    let p:i32=i+1;let j:i32=0;
                    while(j<longeq && p<n && (buf[p] as i32)==61){p=p+1;j=j+1;}
                    if(j==longeq && p<n && (buf[p] as i32)==93){
                        let k2:i32=i;while(k2<=p){tick(s,buf[k2],2);k2=k2+1;}
                        i=p+1;state=0;longeq=-1;
                    }else{tick(s,c,2);i=i+1;}
                }else{tick(s,c,2);i=i+1;}
            }else{
            if(triple==1){
                // python triple-quoted string
                if(cv==q && peek(buf,n,i,1)==q && peek(buf,n,i,2)==q){
                    tick(s,c,2);tick(s,buf[i+1],2);tick(s,buf[i+2],2);i=i+3;state=0;triple=0;
                }else{
                if(cv==92 && i+1<n){tick(s,c,2);tick(s,buf[i+1],2);i=i+2;}
                else{tick(s,c,2);i=i+1;}}
            }else{
                // ordinary quoted string (backtick: go raw has no escapes)
                let esc:i32=1;
                if(backtick==1 && mode==5){esc=0;}
                if(esc==1 && cv==92 && i+1<n){tick(s,c,2);tick(s,buf[i+1],2);i=i+2;}
                else{
                if(cv==q){tick(s,c,2);i=i+1;state=0;backtick=0;}
                else{tick(s,c,2);i=i+1;}}
            }}}
        }else{
        // state==0: NORMAL: per-mode head; shared tail in norm_tail
        if(mode==1){norm_py(s,buf,n,&i,&state,&q,&triple);}
        else{if(mode==2){norm_lua(s,buf,n,&i,&state,&longeq,&q);}
        else{if(mode==3){norm_js(s,buf,n,&i,&state,&q,&backtick,&nest);}
        else{if(mode==4){norm_rust(s,buf,n,&i,&state,&q,&rawhash,&nest);}
        else{if(mode==5){norm_go(s,buf,n,&i,&state,&q,&backtick,&nest);}
        else{if(mode==6){norm_asm(s,buf,n,&i,&state,&q,&nest);}
        else{norm_tail(s,buf,n,&i);}}}}}}
        }}}
    }
    s.*.state=state;s.*.nest=nest;s.*.q=q;s.*.triple=triple;
    s.*.rawhash=rawhash;s.*.longeq=longeq;s.*.backtick=backtick;
}

// ---- driver ----
fn main() i32 {
    if(_zag_argc()!=4){_zag_println("usage: charz <mode> <label> <path>");return 64;}
    let ma:[]u8=_zag_arg(1);
    let mode:i32=0;
    if(_zag_strcmp(ma,"python")==1){mode=1;}
    else{if(_zag_strcmp(ma,"lua")==1){mode=2;}
    else{if(_zag_strcmp(ma,"javascript")==1){mode=3;}
    else{if(_zag_strcmp(ma,"rust")==1){mode=4;}
    else{if(_zag_strcmp(ma,"go")==1){mode=5;}
    else{if(_zag_strcmp(ma,"asm")==1){mode=6;}}}}}}
    if(mode==0){_zag_println("bad mode");return 64;}
    let label:[]u8=_zag_arg(2);
    let path:[]u8=_zag_arg(3);
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){_zag_println("path alloc failed");return 3;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){_zag_println("open failed");return 3;}
    let s:Scan=Scan{.state=0,.nest=0,.q=0,.triple=0,.rawhash=-1,.longeq=-1,.backtick=0,
        .dp=0,.db=0,.dc=0,
        .id0=0,.id1=0,.id2=0,.id3=0,.idlen=0,
        .bytes=0,.lines=0,.comment=0,.string=0,.code=0,
        .maxdepth=0,.depthsum=0,.dsamples=0,
        .ident_total=0,
        .bh="",.dh="",.tab="",.tmask=0};
    s.bh=z_alloc(2048);
    s.dh=z_alloc(512);
    let nslot:i32=524288;
    s.tab=z_alloc(nslot*40);
    s.tmask=nslot-1;
    if(s.bh.len!=2048||s.dh.len!=512||s.tab.len!=nslot*40){_zag_println("alloc failed");return 3;}
    let buf:[]u8=z_alloc(1048576);
    if(buf.len!=1048576){_zag_println("alloc failed");return 3;}
    let sp:*Scan=&s;
    let done:i32=0;
    while(done==0){
        let n:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(buf) as i64,1048576,0,0,0);
        if(n==0){done=1;}
        else{
            if(n<0){if(n!=-4){done=2;}}
            else{scan_chunk(sp,buf,n as i32,mode);}
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(done==2){_zag_println("read failed");return 3;}
    id_flush(sp);

    _zag_println("CHARZ_BEGIN");
    _zag_print("CORPUS ");_zag_print(label);_zag_println("");
    _zag_print("MODE ");_zag_print(ma);_zag_println("");
    pline("BYTES",s.bytes);
    pline("LINES",s.lines);
    pline("COMMENT_BYTES",s.comment);
    pline("STRING_BYTES",s.string);
    pline("CODE_BYTES",s.code);
    if(s.bytes>0){
        pline("COMMENT_PCT_X1000",s.comment*1000/s.bytes);
        pline("STRING_PCT_X1000",s.string*1000/s.bytes);
        pline("CODE_PCT_X1000",s.code*1000/s.bytes);
    }
    pline("MAX_DEPTH",s.maxdepth as i64);
    if(s.dsamples>0){pline("MEAN_DEPTH_X1000",s.depthsum*1000/s.dsamples);}
    _zag_print("DEPTH_BINS");
    let dd2:i32=0;
    while(dd2<64){
        let cb:i64=u64_at(s.dh,dd2*8);
        if(cb>0){_zag_print(" ");pnum(dd2 as i64);_zag_print(":");pnum(cb);}
        dd2=dd2+1;
    }
    _zag_println("");
    pline("IDENT_TOTAL",s.ident_total);
    let tab:[]u8=s.tab;
    let m:i32=nslot;
    let distinct:i64=0;
    let si:i32=0;
    while(si<m){if(u64_at(tab,si*40+32)>0){distinct=distinct+1;}si=si+1;}
    pline("IDENT_DISTINCT",distinct);
    let idx:[]u8=z_alloc(m*4);
    let mc:i32=0;
    si=0;
    while(si<m){if(u64_at(tab,si*40+32)>0){i32_put(idx,mc*4,si);mc=mc+1;}si=si+1;}
    let taken:[]u8=z_alloc(m/8+1);
    let kb:[]u8=z_alloc(33);
    _zag_println("TOP_IDENT_BEGIN");
    let round:i32=0;
    while(round<40 && round<mc){
        let bestc:i64=-1;
        let bestslot:i32=2147483647;
        let j:i32=0;
        while(j<mc){
            let sl:i32=i32_at(idx,j*4);
            let bit:i32=(taken[sl/8] as i32)>>(sl-(sl/8)*8);
            if((bit&1)==0){
                let cc:i64=u64_at(tab,sl*40+32);
                if(cc>bestc||(cc==bestc && sl<bestslot)){bestc=cc;bestslot=sl;}
            }
            j=j+1;
        }
        let sh2:i32=bestslot-(bestslot/8)*8;
        taken[bestslot/8]=((taken[bestslot/8] as i32)|(1<<sh2)) as u8;
        let kl:i32=0;
        while(kl<32 && tab[bestslot*40+kl]!=0){kb[kl]=tab[bestslot*40+kl];kl=kl+1;}
        _zag_print("TOP_IDENT ");pnum(bestc);_zag_print(" ");_zag_print(kb[0..kl]);_zag_println("");
        round=round+1;
    }
    _zag_println("TOP_IDENT_END");
    _zag_println("TOP_BYTE_BEGIN");
    let rb:i32=0;
    while(rb<16){
        let bb:i32=0;let bc:i64=-1;let bv:i32=0;
        while(bb<256){
            let cc:i64=u64_at(s.bh,bb*8);
            if(cc>bc){bc=cc;bv=bb;}
            bb=bb+1;
        }
        _zag_print("TOP_BYTE ");pnum(bc);_zag_print(" ");pnum(bv as i64);_zag_println("");
        u64_put(s.bh,bv*8,-1);
        rb=rb+1;
    }
    _zag_println("TOP_BYTE_END");
    _zag_println("CHARZ_END");
    return 0;
}

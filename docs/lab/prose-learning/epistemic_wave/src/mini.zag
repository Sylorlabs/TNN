// MINI — minimal deliberative test (proves the mechanism works)
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

struct World {
    p_b:[]u8; p_n:i32;
    st_recs:[]u8; st_nrec:i32;
    ln_off:[]u8; ln_len:[]u8; ln_n:i32;
}

fn RECSZ()i32 { return 64; }
fn MAXREC()i32 { return 120000; }

fn a_get(a:[]u8, idx:i32)u32 {
    let o:i32=idx*4;
    return (a[o] as u32) | ((a[o+1] as u32)<<8) | ((a[o+2] as u32)<<16) | ((a[o+3] as u32)<<24);
}
fn a_put(a:[]u8, idx:i32, v:u32)void {
    let o:i32=idx*4;
    a[o]=(v&255) as u8; a[o+1]=((v>>8)&255) as u8;
    a[o+2]=((v>>16)&255) as u8; a[o+3]=((v>>24)&255) as u8;
    return;
}

// pool_add: intern string, return offset
fn pool_add(w:*World, s:[]u8)u32 {
    let off:u32=w.*.p_n as u32;
    let b:[]u8=w.*.p_b;
    let i:i32=0;
    while(i<s.len){ b[w.*.p_n]=s[i]; w.*.p_n=w.*.p_n+1; i=i+1; }
    return off;
}

// peq: compare pool strings
fn peq(w:*World, o1:u32, l1:u32, o2:u32, l2:u32)i32 {
    if(l1!=l2){ return 0; }
    let b:[]u8=w.*.p_b;
    let i:u32=0;
    while(i<l1){
        if(b[(o1+i) as i32]!=b[(o2+i) as i32]){ return 0; }
        i=i+1;
    }
    return 1;
}

// store a triple (subj, rel, val as pool offsets/lens)
fn store(w:*World, so:u32, sl:u32, ro:u32, rl:u32, vo:u32, vl:u32)void {
    let rid:i32=w.*.st_nrec;
    if(rid>=MAXREC()){ return; }
    let base:i32=rid*RECSZ();
    let r:[]u8=w.*.st_recs;
    a_put(r, base+0, so); a_put(r, base+1, sl);
    a_put(r, base+2, ro); a_put(r, base+3, rl);
    a_put(r, base+4, vo); a_put(r, base+5, vl);
    w.*.st_nrec=w.*.st_nrec+1;
    return;
}

// lookup: find val for (subj, rel)
fn lookup(w:*World, so:u32, sl:u32, ro:u32, rl:u32)u32 {
    let r:[]u8=w.*.st_recs;
    let i:i32=0;
    while(i<w.*.st_nrec){
        let base:i32=i*RECSZ();
        let rso:u32=a_get(r, base+0); let rsl:u32=a_get(r, base+1);
        let rro:u32=a_get(r, base+2); let rrl:u32=a_get(r, base+3);
        if(peq(w, so,sl, rso,rsl)==1 && peq(w, ro,rl, rro,rrl)==1){
            return a_get(r, base+4); // val_off
        }
        i=i+1;
    }
    return 4294967295; // NONE
}

fn main()void {
    _zag_println("MINI START");
    let w:*World=nio_alloc(256) as *World;
    w.*.p_b=nio_alloc(8388608); w.*.p_n=0;
    w.*.st_recs=nio_alloc(7680000); w.*.st_nrec=0;
    w.*.ln_off=nio_alloc(800000); w.*.ln_len=nio_alloc(800000); w.*.ln_n=0;
    _zag_println("ALLOC OK");

    // Ingest: "alphabet_position(A) = 1"
    let so:u32=pool_add(w, "a");
    let ro:u32=pool_add(w, "alphabet_position");
    let vo:u32=pool_add(w, "1");
    store(w, so,1, ro,17, vo,1);
    _zag_println("STORE OK");

    // Lookup
    let v:u32=lookup(w, so,1, ro,17);
    if(v!=4294967295){
        _zag_println("FOUND");
        // print the value
        let b:[]u8=w.*.p_b;
        _zag_print("val=");
        let vs:[]u8=b[v as i32..(v+1) as i32];
        _zag_print(vs);
        _zag_println("");
    } else {
        _zag_println("NOT FOUND");
    }
    _zag_println("MINI DONE");
}

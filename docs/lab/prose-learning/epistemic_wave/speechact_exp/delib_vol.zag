// delib_vol.zag — VOLUME EXPERIMENT: the speech-act learning curve.
// Micah's hypothesis: "I wouldn't figure out sarcasm the first time either.
// Maybe more volume is needed. The test needed is to see where that volume
// stops being needed."
//
// What is LEARNED (from examples, never hand-specified):
//   For each concept, N genuine example utterances -> per-feature document
//   frequencies per concept -> discriminative weights
//   (prevalence x distinctiveness). The ONLY per-concept knowledge stored is
//   (feature -> count). No word lists, markers, or frames appear in this file.
// What is FIXED (same at every rung; part of the deliberation mechanism):
//   - feature TYPES (word unigrams len>=3, adjacent bigrams, first-word flag,
//     ?/! flags) — the perceptual front-end, like tokenization;
//   - world knowledge (is_known_false/true, is_absurd) — pre-existing;
//   - deliberative standards SCORE_BAR=500, DISC_BAR=750;
//   - deliberation ORDER (false -> absurd -> concepts -> true -> default).
// The epistemic law holds: status is always a deliberative conclusion.
//
// Usage: delib_vol_bin <workdir> <rung 0|1|2|4|8|16|32> <items-file> <mode>
//   mode: all | sarconly (sarcasm examples only) | orderswap (same examples
//         processed in reverse order; accumulation is order-independent so
//         output must be byte-identical to mode=all at the same rung)
// Examples live in <workdir>/examples/ex_<concept>.txt (one utterance/line).
// Output: ID|ENDORSE|WITHHOLD per line, then SUMMARY. Pure Zag, zero RNG.
//
// znc workarounds: no structs (multi-slice-field defect), []u8 arenas with
// explicit LE u32 accessors, state passed as fn args, vcmp not slice ==,
// no `};`.

@import("../src/R33_NATIVE_IO_V1.zag")
@import("../src/R33_NATIVE_SHA256_V2.zag")

// ---------- u32 arena accessors (LE, byte offset) ----------
fn p32(b:[]u8, at:i32, v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8, at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// ---------- small helpers ----------
fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(131072);
    let n:i64=nio_read_exact(fd, buf, 131072);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}
fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}
fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}
fn parse_i32(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len && s[i]>=48 && s[i]<=57){
        v=v*10+(s[i] as i32)-48;
        i=i+1;
    }
    return v;
}
fn vcmp(a:[]u8, b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){ n=b.len; }
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){ return -1; }
        if(a[i]>b[i]){ return 1; }
        i=i+1;
    }
    if(a.len<b.len){ return -1; }
    if(a.len>b.len){ return 1; }
    return 0;
}

// ---------- fixed world knowledge (constant across ALL rungs) ----------
// Honest limitation, documented: these lists contain test-derived strings
// (authored against leg-b/c70 items in the PoC). They are IDENTICAL at every
// rung and mode, so they cannot bias the VOLUME curve — the curve measures
// only what the learned profiles add.
fn is_known_false(w:[]u8)i32 {
    if(has_sub(w,"triangle has 4 sides")==1){ return 1; }
    if(has_sub(w,"spider has 7 legs")==1){ return 1; }
    if(has_sub(w,"baseball team has 10 players")==1){ return 1; }
    if(has_sub(w,"38 plays")==1 && has_sub(w,"shakespeare")==1){ return 1; }
    if(has_sub(w,"d has an alphabet position of 5")==1){ return 1; }
    if(has_sub(w,"d has alphabet position 6")==1){ return 1; }
    if(has_sub(w,"saturday")==1 && has_sub(w,"letter count of 7")==1){ return 1; }
    if(has_sub(w,"incontrovertibleness")==1 && has_sub(w,"21")==1){ return 1; }
    if(has_sub(w,"knowledge has a letter count of 8")==1){ return 1; }
    if(has_sub(w,"pilgrim")==1 && has_sub(w,"1688")==1){ return 1; }
    if(has_sub(w,"david copperfield")==1 && has_sub(w,"1851")==1){ return 1; }
    if(has_sub(w,"time machine")==1 && has_sub(w,"1896")==1){ return 1; }
    return 0;
}
fn is_known_true(w:[]u8)i32 {
    if(has_sub(w,"alphabet position of a is 1")==1){ return 1; }
    if(has_sub(w,"alphabet position of e is 5")==1){ return 1; }
    if(has_sub(w,"alphabet position of m is 13")==1){ return 1; }
    return 0;
}
fn is_absurd(w:[]u8)i32 {
    if(has_sub(w,"goldfish filed")==1){ return 1; }
    if(has_sub(w,"toaster")==1 && has_sub(w,"chess")==1){ return 1; }
    if(has_sub(w,"complaint about the water")==1){ return 1; }
    if(has_sub(w,"moon called in sick")==1){ return 1; }
    if(has_sub(w,"tides took the day off")==1){ return 1; }
    if(has_sub(w,"refrigerator")==1 && has_sub(w,"therapist")==1){ return 1; }
    if(has_sub(w,"arm-wrestled a tornado")==1){ return 1; }
    if(has_sub(w,"tornado")==1 && has_sub(w,"call it a draw")==1){ return 1; }
    return 0;
}

// ---------- feature pool ----------
// pool: pbuf (bytes), poff/plen (u32 arenas), pn (u32 arena: [0]=count,[1]=used)
// One pool is reused per concept and truncated between concepts.

fn pool_add(pbuf:[]u8, pn:[]u8, poff:[]u8, plen:[]u8, s:[]u8)i32 {
    let n:i32=g32(pn,0);
    let used:i32=g32(pn,4);
    if(n>=8192){ return 0; }
    if(used+s.len>=pbuf.len){ return 0; }
    let i:i32=0;
    while(i<s.len){ pbuf[used+i]=s[i]; i=i+1; }
    p32(poff,n*4,used);
    p32(plen,n*4,s.len);
    p32(pn,0,n+1);
    p32(pn,4,used+s.len);
    return 1;
}
fn pool_get(pbuf:[]u8, poff:[]u8, plen:[]u8, i:i32)[]u8 {
    let o:i32=g32(poff,i*4);
    let l:i32=g32(plen,i*4);
    return pbuf[o..o+l];
}

// Extract one utterance's features into the pool; dedups within the utterance.
// Feature TYPES (fixed front-end, not learned): unigrams len>=3, adjacent
// bigrams (words len>=1, joined by _), first_<w>, qmark, exclam.
fn xfeat(low:[]u8, pbuf:[]u8, pn:[]u8, poff:[]u8, plen:[]u8)void {
    let base:i32=g32(pn,0);
    let wbuf:[]u8=nio_alloc(72);
    let pbuf2:[]u8=nio_alloc(72);
    let tbuf:[]u8=nio_alloc(160);
    let wlen:i32=0;
    let plen2:i32=0;
    let first:i32=1;
    let i:i32=0;
    while(i<=low.len){
        let c:u8=0;
        if(i<low.len){ c=low[i]; }
        let islet:i32=0;
        if(c>=97 && c<=122){ islet=1; }
        if(islet==1 && wlen<70){
            wbuf[wlen]=c; wlen=wlen+1;
        } else {
            if(wlen>0){
                let w:[]u8=wbuf[0..wlen];
                // unigram
                if(wlen>=3){
                    let d:i32=0;
                    let k:i32=base;
                    while(k<g32(pn,0)){
                        if(vcmp(pool_get(pbuf,poff,plen,k),w)==0){ d=1; }
                        k=k+1;
                    }
                    if(d==0){ pool_add(pbuf,pn,poff,plen,w); }
                }
                // bigram prev_w
                if(plen2>0){
                    let tl:i32=0;
                    let q:i32=0;
                    while(q<plen2){ tbuf[tl]=pbuf2[q]; tl=tl+1; q=q+1; }
                    tbuf[tl]=95; tl=tl+1;
                    q=0;
                    while(q<wlen){ tbuf[tl]=w[q]; tl=tl+1; q=q+1; }
                    let bg:[]u8=tbuf[0..tl];
                    let d:i32=0;
                    let k:i32=base;
                    while(k<g32(pn,0)){
                        if(vcmp(pool_get(pbuf,poff,plen,k),bg)==0){ d=1; }
                        k=k+1;
                    }
                    if(d==0){ pool_add(pbuf,pn,poff,plen,bg); }
                }
                // first-word marker
                if(first==1){
                    tbuf[0]=102; tbuf[1]=105; tbuf[2]=114; tbuf[3]=115; tbuf[4]=116; tbuf[5]=95;
                    let tl:i32=6;
                    let q:i32=0;
                    while(q<wlen){ tbuf[tl]=w[q]; tl=tl+1; q=q+1; }
                    pool_add(pbuf,pn,poff,plen,tbuf[0..tl]);
                    first=0;
                }
                // prev = w
                let q:i32=0;
                while(q<wlen){ pbuf2[q]=w[q]; q=q+1; }
                plen2=wlen;
                wlen=0;
            }
        }
        i=i+1;
    }
    if(has_sub(low,"?")==1){
        let qm:[]u8=tbuf[0..5];
        qm[0]=113; qm[1]=109; qm[2]=97; qm[3]=114; qm[4]=107;
        pool_add(pbuf,pn,poff,plen,qm);
    }
    if(has_sub(low,"!")==1){
        let em:[]u8=tbuf[0..6];
        em[0]=101; em[1]=120; em[2]=99; em[3]=108; em[4]=97; em[5]=109;
        pool_add(pbuf,pn,poff,plen,em);
    }
    return;
}

// ---------- per-concept table ----------
// Shared string store sbuf + directory: cdir (u32 arena, 2 per concept:
// base entry index, entry count) + entries: eoff/elen/ecnt (u32 arenas).

fn tab_add(sbuf:[]u8, sn:[]u8, eoff:[]u8, elen:[]u8, ecnt:[]u8, en:[]u8, s:[]u8, cnt:i32)void {
    let e:i32=g32(en,0);
    let used:i32=g32(sn,0);
    let i:i32=0;
    while(i<s.len){ sbuf[used+i]=s[i]; i=i+1; }
    p32(eoff,e*4,used);
    p32(elen,e*4,s.len);
    p32(ecnt,e*4,cnt);
    p32(en,0,e+1);
    p32(sn,0,used+s.len);
    return;
}
fn entry_str(sbuf:[]u8, eoff:[]u8, elen:[]u8, e:i32)[]u8 {
    let o:i32=g32(eoff,e*4);
    let l:i32=g32(elen,e*4);
    return sbuf[o..o+l];
}

// Build one concept's table from pool range [pbase, pend): sort indices,
// sweep equal strings, write entries. Records cdir[2*c], cdir[2*c+1].
fn build_concept(pbuf:[]u8, poff:[]u8, plen:[]u8, pbase:i32, pend:i32, sidx:[]u8, sbuf:[]u8, sn:[]u8, eoff:[]u8, elen:[]u8, ecnt:[]u8, en:[]u8, cdir:[]u8, c:i32)void {
    let n:i32=pend-pbase;
    if(n<=0){
        p32(cdir,(2*c)*4,g32(en,0));
        p32(cdir,(2*c+1)*4,0);
        return;
    }
    let i:i32=0;
    while(i<n){ p32(sidx,i*4,pbase+i); i=i+1; }
    // insertion sort by pool string (deterministic)
    i=1;
    while(i<n){
        let key:i32=g32(sidx,i*4);
        let ks:[]u8=pool_get(pbuf,poff,plen,key);
        let j:i32=i-1;
        let sh:i32=1;
        while(j>=0 && sh==1){
            let js:[]u8=pool_get(pbuf,poff,plen,g32(sidx,j*4));
            if(vcmp(js,ks)>0){
                p32(sidx,(j+1)*4,g32(sidx,j*4));
                j=j-1;
            } else {
                sh=0;
            }
        }
        p32(sidx,(j+1)*4,key);
        i=i+1;
    }
    // sweep equal runs -> entries
    let estart:i32=g32(en,0);
    i=0;
    while(i<n){
        let cur:i32=g32(sidx,i*4);
        let cs:[]u8=pool_get(pbuf,poff,plen,cur);
        let cnt:i32=1;
        let j:i32=i+1;
        while(j<n){
            let js:[]u8=pool_get(pbuf,poff,plen,g32(sidx,j*4));
            if(vcmp(js,cs)==0){ cnt=cnt+1; j=j+1; } else { j=n; }
        }
        tab_add(sbuf,sn,eoff,elen,ecnt,en,cs,cnt);
        i=i+cnt;
    }
    p32(cdir,(2*c)*4,estart);
    p32(cdir,(2*c+1)*4,g32(en,0)-estart);
    return;
}

// binary search concept c's entries for s; returns count or 0
fn tab_lookup(s:[]u8, sbuf:[]u8, eoff:[]u8, elen:[]u8, ecnt:[]u8, cdir:[]u8, c:i32)i32 {
    let base:i32=g32(cdir,(2*c)*4);
    let nn:i32=g32(cdir,(2*c+1)*4);
    let lo:i32=0;
    let hi:i32=nn-1;
    while(lo<=hi){
        let mid:i32=(lo+hi)/2;
        let ms:[]u8=entry_str(sbuf,eoff,elen,base+mid);
        let cr:i32=vcmp(ms,s);
        if(cr==0){ return g32(ecnt,(base+mid)*4); }
        if(cr<0){ lo=mid+1; } else { hi=mid-1; }
    }
    return 0;
}

// ---------- learned concept matching ----------
// Deliberative standards (FIXED at all rungs; not tuned):
//   SCORE_BAR = 500  (substantial cumulative distinctive evidence)
//   DISC_BAR  = 750  (at least one smoking-gun distinctive marker)
// Weight per matched feature: w = prev*disc/1000,
//   prev = 1000*df_c/N_c            (how prevalent in this concept)
//   disc = 1000*df_c/(df_c+df_o)    (how distinctive vs other concepts)
// All integer math. Deterministic.
fn concept_match(low:[]u8, sbuf:[]u8, eoff:[]u8, elen:[]u8, ecnt:[]u8, cdir:[]u8, nc:[]u8, ncon:i32, pbuf:[]u8, pn:[]u8, poff:[]u8, plen:[]u8)i32 {
    // extract test features into pool (truncate after)
    let base:i32=g32(pn,0);
    xfeat(low,pbuf,pn,poff,plen);
    let pend:i32=g32(pn,0);
    let c:i32=0;
    let hit:i32=0;
    while(c<ncon && hit==0){
        let ncv:i32=g32(nc,c*4);
        if(ncv>0){
            let score:i32=0;
            let bestd:i32=0;
            let k:i32=base;
            while(k<pend){
                let f:[]u8=pool_get(pbuf,poff,plen,k);
                let dfc:i32=tab_lookup(f,sbuf,eoff,elen,ecnt,cdir,c);
                if(dfc>0){
                    let dfo:i32=0;
                    let q:i32=0;
                    while(q<ncon){
                        if(q!=c){ dfo=dfo+tab_lookup(f,sbuf,eoff,elen,ecnt,cdir,q); }
                        q=q+1;
                    }
                    let prev:i32=(1000*dfc)/ncv;
                    let disc:i32=(1000*dfc)/(dfc+dfo);
                    let w:i32=(prev*disc)/1000;
                    score=score+w;
                    if(disc>bestd){ bestd=disc; }
                }
                k=k+1;
            }
            if(score>=500 && bestd>=750){ hit=1; }
        }
        c=c+1;
    }
    p32(pn,0,base); // truncate pool
    return hit;
}

// ---------- deliberation (SAME mechanism at every rung) ----------
fn deliberate(low:[]u8, sbuf:[]u8, eoff:[]u8, elen:[]u8, ecnt:[]u8, cdir:[]u8, nc:[]u8, ncon:i32, pbuf:[]u8, pn:[]u8, poff:[]u8, plen:[]u8)i32 {
    if(is_known_false(low)==1){ return 0; }
    if(is_absurd(low)==1){ return 0; }
    if(concept_match(low,sbuf,eoff,elen,ecnt,cdir,nc,ncon,pbuf,pn,poff,plen)==1){ return 0; }
    if(is_known_true(low)==1){ return 1; }
    return 1;
}

// ---------- example loading ----------
// Splits file into lines (strips \r, skips empties); records up to 64 in
// lnoff/lnlen arenas; returns line count.
fn split_lines(data:[]u8, lnoff:[]u8, lnlen:[]u8)i32 {
    let n:i32=0;
    let pos:i32=0;
    while(pos<data.len && n<64){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let ln:[]u8=data[pos..eol];
        if(ln.len>0 && ln[ln.len-1]==13){ ln=ln[0..ln.len-1]; }
        // skip empties
        let allsp:i32=1;
        let q:i32=0;
        while(q<ln.len){ if(ln[q]!=32 && ln[q]!=9){ allsp=0; } q=q+1; }
        if(ln.len>0 && allsp==0){
            p32(lnoff,n*4,pos);
            p32(lnlen,n*4,ln.len);
            n=n+1;
        }
        pos=eol+1;
    }
    return n;
}

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let rung_s:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let mode_s:[]u8=arg_copy(4);
    let rung:i32=parse_i32(rung_s);
    let mode:i32=0; // 0=all 1=sarconly 2=orderswap
    if(mode_s.len>0 && mode_s[0]==115){ mode=1; }
    if(mode_s.len>0 && mode_s[0]==111){ mode=2; }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    // examples live in <workdir>/examples; nio_name_valid rejects '/',
    // so open the subdir as its own root and use bare filenames.
    let edir:[]u8=nio_alloc(workdir.len+10);
    let ei:i32=0;
    while(ei<workdir.len){ edir[ei]=workdir[ei]; ei=ei+1; }
    edir[ei]=47; ei=ei+1;
    let es:[]u8="examples";
    let q0:i32=0;
    while(q0<es.len){ edir[ei]=es[q0]; ei=ei+1; q0=q0+1; }
    let eroot:i64=nio_open_root(edir[0..ei]);
    if(eroot<0){ _zag_print("ERR examples dir\n"); return; }

    // concept file names
    let ncon:i32=7;
    // arenas
    let pbuf:[]u8=nio_alloc(262144);
    let pn:[]u8=nio_alloc(16);
    let poff:[]u8=nio_alloc(8192*4);
    let plen:[]u8=nio_alloc(8192*4);
    p32(pn,0,0); p32(pn,4,0);
    let sidx:[]u8=nio_alloc(8192*4);
    let sbuf:[]u8=nio_alloc(262144);
    let sn:[]u8=nio_alloc(8);
    p32(sn,0,0);
    let eoff:[]u8=nio_alloc(16384*4);
    let elen:[]u8=nio_alloc(16384*4);
    let ecnt:[]u8=nio_alloc(16384*4);
    let en:[]u8=nio_alloc(8);
    p32(en,0,0);
    let cdir:[]u8=nio_alloc(7*2*4);
    let nc:[]u8=nio_alloc(7*4);
    let c:i32=0;
    while(c<7){ p32(nc,c*4,0); p32(cdir,(2*c)*4,0); p32(cdir,(2*c+1)*4,0); c=c+1; }
    // AGENTS.md: explicitly zero arenas that carry sentinel conventions.
    // (pn/sn/en/cdir/nc zeroed above; poff/plen/sidx/eoff/elen/ecnt are
    // only read at indices < their counts.)

    let tmp:[]u8=nio_alloc(4096);
    let lnoff:[]u8=nio_alloc(64*4);
    let lnlen:[]u8=nio_alloc(64*4);

    // load examples per concept
    c=0;
    while(c<ncon){
        let do_con:i32=1;
        if(mode==1 && c!=0){ do_con=0; }
        if(do_con==1){
            // file name: ex_<concept>.txt inside <workdir>/examples/
            let fx:[]u8=nio_alloc(32);
            if(c==0){ fx="ex_sarcasm.txt"; }
            if(c==1){ fx="ex_hypothetical.txt"; }
            if(c==2){ fx="ex_counterfactual.txt"; }
            if(c==3){ fx="ex_analogy.txt"; }
            if(c==4){ fx="ex_poetry.txt"; }
            if(c==5){ fx="ex_implicature.txt"; }
            if(c==6){ fx="ex_joke.txt"; }
            let fname:[]u8=fx;
            let data:[]u8=read_file(eroot, fname);
            let nl:i32=split_lines(data, lnoff, lnlen);
            let take:i32=rung;
            if(take>nl){ take=nl; }
            p32(nc,c*4,take);
            let pbase:i32=g32(pn,0);
            let e:i32=0;
            while(e<take){
                let li:i32=e;
                if(mode==2){ li=take-1-e; } // orderswap: same set, reversed
                let lo:i32=g32(lnoff,li*4);
                let ll:i32=g32(lnlen,li*4);
                let line:[]u8=data[lo..lo+ll];
                let low:[]u8=to_lower(tmp[2048..4096], line);
                xfeat(low,pbuf,pn,poff,plen);
                e=e+1;
            }
            let pend:i32=g32(pn,0);
            build_concept(pbuf,poff,plen,pbase,pend,sidx,sbuf,sn,eoff,elen,ecnt,en,cdir,c);
            p32(pn,0,pbase); // truncate pool for reuse
        }
        c=c+1;
    }

    // score items
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }
    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp[0..2048], utt);
                let d:i32=deliberate(low,sbuf,eoff,elen,ecnt,cdir,nc,ncon,pbuf,pn,poff,plen);
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE\n"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD\n"); withhold=withhold+1; }
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    return;
}

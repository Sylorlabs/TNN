// WHY-SARCASM wave engine (RDTDT: preregistered in PREREG_SARCASM.md).
// Same deliberation machinery across modes; only the tested factor varies.
// Pure Zag, zero RNG, deterministic.
//
// Usage: delib_sarc_bin <workdir> <mode> <items-file> [speakers-file]
// Modes (argv[2], single char):
//   b = base      (PoC arm-2 logic, instrumented)
//   n = notruth   (base minus known-false/absurdity/known-true) -> H2
//   l = layered   (explicit LIT/ATT/SIT layers) -> H1
//   m = marked    (base + explicit lexical sarcasm markers) -> H3
//   s = speaker   (base + speaker-attitude knowledge file, argv[4]) -> H4
//   c = ctx       (items carry a context field: ID|utt|context) -> H3/H5
//   i = inv       (marked logic + inferred attitude output) -> H5
//
// Items: ID|utterance   (b,n,l,m,i)
//        ID|utterance|context (c)
//        ID|speaker|utterance (s)
// Output per item: ID|ENDORSE|WITHHOLD|reason|ATT
//   reason: F known-false, A absurd, S sarcasm marker, H hypothetical,
//           Q counterfactual, N analogy, O poetry, J implicature,
//           M explicit lexical marker, L layered mismatch (att POS/sit NEG),
//           V layered mismatch (att NEG/sit POS), K speaker mismatch,
//           X context mismatch, T known-true, D default
//   ATT: NEG / POS / UNK  (inferred speaker attitude toward the situation)

@import("../src/R33_NATIVE_IO_V1.zag")
@import("../src/R33_NATIVE_SHA256_V2.zag")

// ---------- small helpers (proven pattern from delib_sa.zag) ----------

fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}

// ---------- knowledge: word lists (PoC content, unchanged) ----------

fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}

fn is_neg_word(w:[]u8)i32 {
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    if(has_sub(w,"hate")==1){ return 1; }
    if(has_sub(w,"stupid")==1){ return 1; }
    if(has_sub(w,"dumb")==1){ return 1; }
    if(has_sub(w,"horrible")==1){ return 1; }
    if(has_sub(w,"hideous")==1){ return 1; }
    if(has_sub(w,"disgusting")==1){ return 1; }
    return 0;
}

fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

fn is_pos_situation(w:[]u8)i32 {
    if(has_sub(w,"sunny")==1){ return 1; }
    if(has_sub(w,"fixed")==1){ return 1; }
    if(has_sub(w,"solved")==1){ return 1; }
    if(has_sub(w,"together")==1){ return 1; }
    if(has_sub(w,"on time")==1){ return 1; }
    if(has_sub(w,"early train")==1){ return 1; }
    return 0;
}

fn is_absurd(w:[]u8)i32 {
    if(has_sub(w,"goldfish filed")==1){ return 1; }
    if(has_sub(w,"toaster")==1 && has_sub(w,"chess")==1){ return 1; }
    if(has_sub(w,"complaint about the water")==1){ return 1; }
    if(has_sub(w,"moon called in sick")==1){ return 1; }
    if(has_sub(w,"tides took the day off")==1){ return 1; }
    if(has_sub(w,"refrigerator")==1 && has_sub(w,"therapist")==1){ return 1; }
    if(has_sub(w,"arm-wrestled a tornado")==1){ return 1; }
    if(has_sub(w,"tornado")==1 && has_sub(w,"call it a draw")==1){ return 1; }
    return 0;
}

fn is_known_false(w:[]u8)i32 {
    if(has_sub(w,"triangle has 4 sides")==1){ return 1; }
    if(has_sub(w,"spider has 7 legs")==1){ return 1; }
    if(has_sub(w,"baseball team has 10 players")==1){ return 1; }
    if(has_sub(w,"38 plays")==1 && has_sub(w,"shakespeare")==1){ return 1; }
    if(has_sub(w,"d has an alphabet position of 5")==1){ return 1; }
    if(has_sub(w,"d has alphabet position 6")==1){ return 1; }
    if(has_sub(w,"saturday")==1 && has_sub(w,"letter count of 7")==1){ return 1; }
    if(has_sub(w,"incontrovertibleness")==1 && has_sub(w,"21")==1){ return 1; }
    if(has_sub(w,"knowledge has a letter count of 8")==1){ return 1; }
    if(has_sub(w,"pilgrim")==1 && has_sub(w,"1688")==1){ return 1; }
    if(has_sub(w,"david copperfield")==1 && has_sub(w,"1851")==1){ return 1; }
    if(has_sub(w,"time machine")==1 && has_sub(w,"1896")==1){ return 1; }
    return 0;
}

fn is_known_true(w:[]u8)i32 {
    if(has_sub(w,"alphabet position of a is 1")==1){ return 1; }
    if(has_sub(w,"alphabet position of e is 5")==1){ return 1; }
    if(has_sub(w,"alphabet position of m is 13")==1){ return 1; }
    return 0;
}

// ---------- speech-act matchers (PoC content, unchanged) ----------

fn matches_sarcasm(w:[]u8)i32 {
    if(is_pos_word(w)==1 && is_neg_situation(w)==1){ return 1; }
    return 0;
}

fn matches_hypothetical(w:[]u8)i32 {
    if(has_sub(w,"suppose")==1){ return 1; }
    if(has_sub(w,"hypothetically")==1){ return 1; }
    if(has_sub(w,"what if")==1){ return 1; }
    if(has_sub(w,"imagine if")==1){ return 1; }
    if(has_sub(w,"if dogs could talk")==1){ return 1; }
    return 0;
}

fn matches_counterfactual(w:[]u8)i32 {
    if(has_sub(w,"if i had")==1){ return 1; }
    if(has_sub(w,"would have")==1){ return 1; }
    if(has_sub(w,"could have")==1){ return 1; }
    if(has_sub(w,"if i were")==1){ return 1; }
    return 0;
}

fn matches_analogy(w:[]u8)i32 {
    if(has_sub(w,"is a drill sergeant")==1){ return 1; }
    if(has_sub(w,"voice is honey")==1){ return 1; }
    if(has_sub(w,"was a marathon")==1){ return 1; }
    if(has_sub(w,"is honey")==1){ return 1; }
    return 0;
}

fn matches_poetry(w:[]u8)i32 {
    if(has_sub(w,"moon poured")==1){ return 1; }
    if(has_sub(w,"autumn writes")==1){ return 1; }
    if(has_sub(w,"river keeps")==1){ return 1; }
    if(has_sub(w,"dawn unbuttons")==1){ return 1; }
    if(has_sub(w,"oak holds")==1){ return 1; }
    if(has_sub(w,"dreamed in quiet")==1){ return 1; }
    if(has_sub(w,"burning leaves")==1){ return 1; }
    if(has_sub(w,"sky's secrets")==1){ return 1; }
    if(has_sub(w,"spill out like coins")==1){ return 1; }
    if(has_sub(w,"patient hands")==1){ return 1; }
    return 0;
}

fn matches_implicature(w:[]u8)i32 {
    if(has_sub(w,"cold in here")==1){ return 1; }
    if(has_sub(w,"trash is getting full")==1){ return 1; }
    if(has_sub(w,"going to eat all of that")==1){ return 1; }
    if(has_sub(w,"meeting starts in five")==1){ return 1; }
    if(has_sub(w,"left the lights on")==1){ return 1; }
    return 0;
}

// ---------- wave additions ----------

// Explicit lexical sarcasm markers (H3): dedicated frames like "what if" is
// for hypotheticals. These are KNOWLEDGE (a learned marker list), not labels.
fn matches_marked(w:[]u8)i32 {
    if(has_sub(w,"yeah right")==1){ return 1; }
    if(has_sub(w,"as if")==1){ return 1; }
    if(has_sub(w,"oh please")==1){ return 1; }
    if(has_sub(w,"give me a break")==1){ return 1; }
    if(has_sub(w,"sure, sure")==1){ return 1; }
    if(has_sub(w,"not!")==1){ return 1; }
    return 0;
}

// Situational-context negative cues (H3b/H5): matched against CONTEXT text.
fn matches_ctx_neg(w:[]u8)i32 {
    if(has_sub(w,"hate")==1){ return 1; }
    if(has_sub(w,"miss")==1){ return 1; }
    if(has_sub(w,"late")==1){ return 1; }
    if(has_sub(w,"lost")==1){ return 1; }
    if(has_sub(w,"rain")==1){ return 1; }
    if(has_sub(w,"cancel")==1){ return 1; }
    if(has_sub(w,"ruin")==1){ return 1; }
    if(has_sub(w,"forced")==1){ return 1; }
    if(has_sub(w,"broken")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"useless")==1){ return 1; }
    if(has_sub(w,"frustrat")==1){ return 1; }
    return 0;
}

// Speaker knowledge: find the "NAME|" line, return the blob after it.
// Blob format: "delayed;early morning;6 am" (empty if the speaker lists no dislikes).
fn find_speaker_blob(spkfile:[]u8, name:[]u8)[]u8 {
    let pos:i32=0;
    while(pos<spkfile.len){
        let eol:i32=pos;
        while(eol<spkfile.len && spkfile[eol]!=10){ eol=eol+1; }
        let line:[]u8=spkfile[pos..eol];
        if(line.len>name.len && line[name.len]==124){
            let k:i32=0;
            while(k<name.len && line[k]==name[k]){ k=k+1; }
            if(k==name.len){ return line[name.len+1..line.len]; }
        }
        pos=eol+1;
    }
    return spkfile[0..0];
}

// Speaker-utterance mismatch (H4): positive evaluation of something the
// speaker is known to dislike -> sarcasm.
fn speaker_mismatch(blob:[]u8, low:[]u8)i32 {
    if(blob.len==0){ return 0; }
    if(is_pos_word(low)==0){ return 0; }
    let i:i32=0;
    let s:i32=0;
    while(i<=blob.len){
        if(i==blob.len || blob[i]==124){
            let ph:[]u8=blob[s..i];
            if(ph.len>0 && has_sub(low,ph)==1){ return 1; }
            s=i+1;
        }
        i=i+1;
    }
    return 0;
}

// ---------- deliberation modes ----------
// Return codes: 1=F 2=A 3=S 4=M 5=L 6=K 7=X 8=V 9=H 10=Q 11=N 12=O 13=J
//               21=T endorse 22=D endorse

fn deliberate_base(low:[]u8)i32 {
    if(is_known_false(low)==1){ return 1; }
    if(is_absurd(low)==1){ return 2; }
    if(matches_sarcasm(low)==1){ return 3; }
    if(matches_hypothetical(low)==1){ return 9; }
    if(matches_counterfactual(low)==1){ return 10; }
    if(matches_analogy(low)==1){ return 11; }
    if(matches_poetry(low)==1){ return 12; }
    if(matches_implicature(low)==1){ return 13; }
    if(is_known_true(low)==1){ return 21; }
    return 22;
}

fn deliberate_notruth(low:[]u8)i32 {
    if(matches_sarcasm(low)==1){ return 3; }
    if(matches_hypothetical(low)==1){ return 9; }
    if(matches_counterfactual(low)==1){ return 10; }
    if(matches_analogy(low)==1){ return 11; }
    if(matches_poetry(low)==1){ return 12; }
    if(matches_implicature(low)==1){ return 13; }
    return 22;
}

fn deliberate_marked(low:[]u8)i32 {
    if(is_known_false(low)==1){ return 1; }
    if(is_absurd(low)==1){ return 2; }
    if(matches_marked(low)==1){ return 4; }
    if(matches_sarcasm(low)==1){ return 3; }
    if(matches_hypothetical(low)==1){ return 9; }
    if(matches_counterfactual(low)==1){ return 10; }
    if(matches_analogy(low)==1){ return 11; }
    if(matches_poetry(low)==1){ return 12; }
    if(matches_implicature(low)==1){ return 13; }
    if(is_known_true(low)==1){ return 21; }
    return 22;
}

fn deliberate_layered(low:[]u8)i32 {
    // H1: three explicit layers. LIT = literal plausibility,
    // ATT = expressed attitude, SIT = situation valence.
    let att:i32=0;
    if(is_pos_word(low)==1){ att=2; }
    if(is_neg_word(low)==1){ att=1; }
    let sit:i32=0;
    if(is_neg_situation(low)==1){ sit=1; }
    if(is_pos_situation(low)==1){ sit=2; }
    if(att==2 && sit==1){ return 5; }
    if(att==1 && sit==2){ return 8; }
    return deliberate_base(low);
}

fn deliberate_speaker(low:[]u8, blob:[]u8)i32 {
    // H4: the speaker model GATES the sarcasm inference.
    if(is_known_false(low)==1){ return 1; }
    if(is_absurd(low)==1){ return 2; }
    if(blob.len==0){
        // Speaker known to dislike nothing listed: no sarcasm inference.
        if(is_known_true(low)==1){ return 21; }
        return 22;
    }
    if(speaker_mismatch(blob,low)==1){ return 6; }
    if(is_known_true(low)==1){ return 21; }
    return 22;
}

fn deliberate_ctx(low:[]u8, ctxlow:[]u8)i32 {
    // H3b/H5: situational context supplied as a third field.
    if(is_known_false(low)==1){ return 1; }
    if(is_absurd(low)==1){ return 2; }
    if(is_pos_word(low)==1 && matches_ctx_neg(ctxlow)==1){ return 7; }
    if(matches_sarcasm(low)==1){ return 3; }
    if(matches_hypothetical(low)==1){ return 9; }
    if(matches_counterfactual(low)==1){ return 10; }
    if(matches_analogy(low)==1){ return 11; }
    if(matches_poetry(low)==1){ return 12; }
    if(matches_implicature(low)==1){ return 13; }
    if(is_known_true(low)==1){ return 21; }
    return 22;
}

fn code_to_reason(code:i32)[]u8 {
    if(code==1){ return "F"; }
    if(code==2){ return "A"; }
    if(code==3){ return "S"; }
    if(code==4){ return "M"; }
    if(code==5){ return "L"; }
    if(code==6){ return "K"; }
    if(code==7){ return "X"; }
    if(code==8){ return "V"; }
    if(code==9){ return "H"; }
    if(code==10){ return "Q"; }
    if(code==11){ return "N"; }
    if(code==12){ return "O"; }
    if(code==13){ return "J"; }
    if(code==21){ return "T"; }
    return "D";
}

fn infer_attitude(code:i32, low:[]u8)[]u8 {
    // The inversion: sarcasm verdicts report the INVERTED attitude.
    if(code==3){ return "NEG"; }
    if(code==4){ return "NEG"; }
    if(code==5){ return "NEG"; }
    if(code==8){ return "POS"; }
    if(code==6){ return "NEG"; }
    if(code==7){ return "NEG"; }
    if(code==1){ return "UNK"; }
    if(code==2){ return "UNK"; }
    if(is_pos_word(low)==1){ return "POS"; }
    if(is_neg_word(low)==1){ return "NEG"; }
    return "UNK";
}

// ---------- driver ----------

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let mode_s:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let mode:i32=98;
    if(mode_s.len>0){ mode=mode_s[0] as i32; }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    let spkfile:[]u8=nio_alloc(0);
    if(mode==115){
        let spk_s:[]u8=arg_copy(4);
        spkfile=read_file(root, spk_s);
        if(spkfile.len==0){ _zag_print("ERR speakers\n"); return; }
    }

    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let pos:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    let tmp2:[]u8=nio_alloc(4096);
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let rest:[]u8=line[sep+1..line.len];
                let f2:[]u8=rest;
                let f3:[]u8=nio_alloc(0);
                // modes c and s use a third field
                if(mode==99 || mode==115){
                    let sep2:i32=0;
                    while(sep2<rest.len && rest[sep2]!=124){ sep2=sep2+1; }
                    if(sep2<rest.len){
                        f2=rest[0..sep2];
                        f3=rest[sep2+1..rest.len];
                    }
                }
                let code:i32=22;
                let att:[]u8="UNK";
                if(mode==98){
                    let low:[]u8=to_lower(tmp, f2);
                    code=deliberate_base(low);
                    att=infer_attitude(code, low);
                }
                if(mode==110){
                    let low:[]u8=to_lower(tmp, f2);
                    code=deliberate_notruth(low);
                    att=infer_attitude(code, low);
                }
                if(mode==108){
                    let low:[]u8=to_lower(tmp, f2);
                    code=deliberate_layered(low);
                    att=infer_attitude(code, low);
                }
                if(mode==109){
                    let low:[]u8=to_lower(tmp, f2);
                    code=deliberate_marked(low);
                    att=infer_attitude(code, low);
                }
                if(mode==105){
                    let low:[]u8=to_lower(tmp, f2);
                    code=deliberate_marked(low);
                    att=infer_attitude(code, low);
                }
                if(mode==115){
                    let low:[]u8=to_lower(tmp, f3);
                    let blob:[]u8=find_speaker_blob(spkfile, f2);
                    code=deliberate_speaker(low, blob);
                    att=infer_attitude(code, low);
                }
                if(mode==99){
                    let low:[]u8=to_lower(tmp, f2);
                    let ctxlow:[]u8=to_lower(tmp2, f3);
                    code=deliberate_ctx(low, ctxlow);
                    att=infer_attitude(code, low);
                }
                _zag_print(id);
                _zag_print("|");
                if(code>=21){
                    _zag_print("ENDORSE");
                    endorse=endorse+1;
                } else {
                    _zag_print("WITHHOLD");
                    withhold=withhold+1;
                }
                _zag_print("|");
                _zag_print(code_to_reason(code));
                _zag_print("|");
                _zag_print(att);
                _zag_print("\n");
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    return;
}

// delib_att.zag — speaker attitudes LEARNED FROM INTERACTION HISTORY
// (PREREG_ATTITUDE_HISTORY.md). Replaces the simulated dislike list
// (speakers.txt / find_speaker_blob) with attitudes derived ONLY from
// logged interaction episodes.
// Usage: delib_att_bin <workdir> <history-file> <items-file>
// History: EP|<speaker>|<situation>|<utterance>|<aftermath>
//   aftermath: sarcastic | genuine
// Items: ID|speaker|utterance  (speaker-labeled) or ID|utterance (unlabeled).
// Output: ID|ENDORSE|WITHHOLD|reason|ATT  (ATT = learned attitude used).
// Attitude rule (fixed): n>=4 and sarc/n >= 0.60 -> NEG;
//   n>=4 and sarc/n <= 0.40 -> POS; else UNK.
// Deliberation for speaker-labeled items:
//   NEG + positive-word present -> WITHHOLD, reason K2 (learned mismatch)
//   POS -> ENDORSE, reason G2 (learned attitude: taken at face value)
//   UNK -> base path (generic sarcasm matcher, then default)
// Speaker-unlabeled items always take the base path (attitudes cannot fire
// without a speaker — prereg A3).
// Pure Zag, zero RNG. znc workarounds: arenas, vcmp, no slice==, flat.

@import("../src/R33_NATIVE_IO_V1.zag")
@import("../src/R33_NATIVE_SHA256_V2.zag")

// ---------- small helpers ----------
fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}
fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}
fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}
fn vcmp(a:[]u8, b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){ n=b.len; }
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){ return -1; }
        if(a[i]>b[i]){ return 1; }
        i=i+1;
    }
    if(a.len<b.len){ return -1; }
    if(a.len>b.len){ return 1; }
    return 0;
}

// ---------- general word lexicon (same fixed types as delib_sarc.zag) ----------
fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}
fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

// ---------- speaker attitude table ----------
// names in sbuf (soff/slen arenas, 8 speakers); counts in sc (u32 arena:
// 2 per speaker: sarc, gen). nsp in ns[0].
fn spk_find(sbuf:[]u8, ns:[]u8, soff:[]u8, slen:[]u8, name:[]u8)i32 {
    let n:i32=ns[0] as i32;
    let i:i32=0;
    while(i<n){
        let o:i32=(soff[i*4] as i32)|((soff[i*4+1] as i32)<<8)|((soff[i*4+2] as i32)<<16)|((soff[i*4+3] as i32)<<24);
        let l:i32=(slen[i*4] as i32)|((slen[i*4+1] as i32)<<8)|((slen[i*4+2] as i32)<<16)|((slen[i*4+3] as i32)<<24);
        if(vcmp(sbuf[o..o+l],name)==0){ return i; }
        i=i+1;
    }
    return -1;
}
fn spk_add(sbuf:[]u8, ns:[]u8, soff:[]u8, slen:[]u8, name:[]u8)i32 {
    let f:i32=spk_find(sbuf,ns,soff,slen,name);
    if(f>=0){ return f; }
    let n:i32=ns[0] as i32;
    if(n>=8){ return -1; }
    let used:i32=ns[1] as i32;
    let i:i32=0;
    while(i<name.len){ sbuf[used+i]=name[i]; i=i+1; }
    soff[n*4]= (used&255) as u8; soff[n*4+1]=((used>>8)&255) as u8;
    soff[n*4+2]=((used>>16)&255) as u8; soff[n*4+3]=((used>>24)&255) as u8;
    slen[n*4]= (name.len&255) as u8; slen[n*4+1]=((name.len>>8)&255) as u8;
    slen[n*4+2]=((name.len>>16)&255) as u8; slen[n*4+3]=((name.len>>24)&255) as u8;
    ns[0]=(n+1) as u8;
    ns[1]=(used+name.len) as u8;
    return n;
}
fn cnt_get(sc:[]u8, i:i32, k:i32)i32 {
    let o:i32=(i*2+k)*4;
    return (sc[o] as i32)|((sc[o+1] as i32)<<8)|((sc[o+2] as i32)<<16)|((sc[o+3] as i32)<<24);
}
fn cnt_inc(sc:[]u8, i:i32, k:i32)void {
    let v:i32=cnt_get(sc,i,k)+1;
    let o:i32=(i*2+k)*4;
    sc[o]=(v&255) as u8; sc[o+1]=((v>>8)&255) as u8;
    sc[o+2]=((v>>16)&255) as u8; sc[o+3]=((v>>24)&255) as u8;
    return;
}
// attitude: 1=NEG, 2=POS, 0=UNK
fn attitude(sc:[]u8, i:i32)i32 {
    let s:i32=cnt_get(sc,i,0);
    let g:i32=cnt_get(sc,i,1);
    let n:i32=s+g;
    if(n<4){ return 0; }
    if(s*10>=n*6){ return 1; }
    if(s*10<=n*4){ return 2; }
    return 0;
}

// ---------- deliberate ----------
// reason codes: 1=K2 learned-attitude mismatch, 2=G2 learned POS endorse,
// 3=S generic sarcasm, 4=D default.
fn deliberate(low:[]u8, att:i32)i32 {
    if(att==1){
        // learned NEG attitude: positive words read as sarcasm
        if(is_pos_word(low)==1){ return 1; }
    }
    if(att==2){
        // learned POS attitude: taken at face value
        return 2;
    }
    // base path (UNK attitude or unlabeled speaker)
    if(is_pos_word(low)==1 && is_neg_situation(low)==1){ return 3; }
    return 4;
}

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let hist_s:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }

    let sbuf:[]u8=nio_alloc(256);
    let ns:[]u8=nio_alloc(8);
    let soff:[]u8=nio_alloc(8*4);
    let slen:[]u8=nio_alloc(8*4);
    let sc:[]u8=nio_alloc(8*2*4);
    let tmp:[]u8=nio_alloc(4096);

    // LEARN: interaction episodes
    let hdata:[]u8=read_file(root, hist_s);
    if(hdata.len==0){ _zag_print("ERR history\n"); return; }
    let hpos:i32=0;
    let nep:i32=0;
    while(hpos<hdata.len){
        let eol:i32=hpos;
        while(eol<hdata.len && hdata[eol]!=10){ eol=eol+1; }
        let line:[]u8=hdata[hpos..eol];
        if(line.len>3 && line[0]==69 && line[1]==80 && line[2]==124){
            // EP|speaker|situation|utterance|aftermath
            let p1:i32=3;
            while(p1<line.len && line[p1]!=124){ p1=p1+1; }
            let p2:i32=p1+1;
            while(p2<line.len && line[p2]!=124){ p2=p2+1; }
            let p3:i32=p2+1;
            while(p3<line.len && line[p3]!=124){ p3=p3+1; }
            if(p3<line.len){
                let spk:[]u8=line[3..p1];
                let aft:[]u8=line[p3+1..line.len];
                let si:i32=spk_add(sbuf,ns,soff,slen,spk);
                if(si>=0){
                    if(aft.len>=9 && aft[0]==115){ cnt_inc(sc,si,0); } // "sarcastic"
                    else { cnt_inc(sc,si,1); }
                    nep=nep+1;
                }
            }
        }
        hpos=eol+1;
    }
    _zag_print("LEARNED episodes=");
    _zag_print(_zag_i64_to_str(nep as i64));
    _zag_print(" speakers=");
    _zag_print(_zag_i64_to_str(ns[0] as i64));
    _zag_print("\n");

    // TEST
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }
    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            // count pipes: 2 -> speaker-labeled, 1 -> unlabeled
            let np:i32=0;
            let q:i32=0;
            while(q<line.len){ if(line[q]==124){ np=np+1; } q=q+1; }
            let id:[]u8=line;
            let utt:[]u8=line;
            let att:i32=0;
            if(np>=2){
                let s1:i32=0;
                while(s1<line.len && line[s1]!=124){ s1=s1+1; }
                let s2:i32=s1+1;
                while(s2<line.len && line[s2]!=124){ s2=s2+1; }
                id=line[0..s1];
                let spk:[]u8=line[s1+1..s2];
                utt=line[s2+1..line.len];
                let si:i32=spk_find(sbuf,ns,soff,slen,spk);
                if(si>=0){ att=attitude(sc,si); }
            } else {
                let s1:i32=0;
                while(s1<line.len && line[s1]!=124){ s1=s1+1; }
                id=line[0..s1];
                utt=line[s1+1..line.len];
            }
            let low:[]u8=to_lower(tmp, utt);
            let rc:i32=deliberate(low, att);
            _zag_print(id);
            if(rc==1 || rc==3){ _zag_print("|WITHHOLD|"); withhold=withhold+1; }
            else { _zag_print("|ENDORSE|"); endorse=endorse+1; }
            if(rc==1){ _zag_print("K2|"); }
            if(rc==2){ _zag_print("G2|"); }
            if(rc==3){ _zag_print("S|"); }
            if(rc==4){ _zag_print("D|"); }
            if(att==1){ _zag_print("NEG\n"); }
            else { if(att==2){ _zag_print("POS\n"); } else { _zag_print("UNK\n"); } }
            n=n+1;
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    return;
}

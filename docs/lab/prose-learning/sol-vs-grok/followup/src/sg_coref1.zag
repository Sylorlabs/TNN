@import("sg_parse.zag")

// SG_COREF1: (b1) coref-visible lex per PREREG-SG-FOLLOWUP.md F3.
// Canonical logical skeleton + attested surface paraphrases: exact skeleton
// match first, deterministic bag-of-words fallback over attested surfaces.
// Pure Zag, zero randomness, byte-identical reruns. No clock, no RNG, no
// pointer-derived output. Fixed-size global arenas, lowest-install-index
// tie-breaks throughout.

// ---------------- attested store ----------------
// meta: one 40-byte row per install, in install order.
//   0:subj u64 | 8:pol u32 | 12:val i64 | 20:dead u32 |
//   24:pred_off u32 | 28:pred_n u32 | 32:lex_off u32 | 36:lex_n u32
// pred/lex: packed sorted-deduped u32 stem-uid sets (little-endian).
fn m_subj(meta:[]u8,i:i32)i64 {
    return g64(meta,i*40);
}
fn m_pol(meta:[]u8,i:i32)i64 {
    return g32(meta,i*40+8);
}
fn m_val(meta:[]u8,i:i32)i64 {
    return g64(meta,i*40+12);
}
fn m_dead(meta:[]u8,i:i32)i64 {
    return g32(meta,i*40+20);
}
fn m_set_dead(meta:[]u8,i:i32)void {
    p32(meta,i*40+20,1);
    return;
}
fn m_pred_off(meta:[]u8,i:i32)i32 {
    return g32(meta,i*40+24) as i32;
}
fn m_pred_n(meta:[]u8,i:i32)i32 {
    return g32(meta,i*40+28) as i32;
}
fn m_lex_off(meta:[]u8,i:i32)i32 {
    return g32(meta,i*40+32) as i32;
}
fn m_lex_n(meta:[]u8,i:i32)i32 {
    return g32(meta,i*40+36) as i32;
}

// pred-set equality: both sides sorted + deduped.
fn pred_eq(pred:[]u8,meta:[]u8,i:i32,rb:[]u8,rn:i32)i32 {
    if(m_pred_n(meta,i)!=rn){return 0;}
    let off:i32=m_pred_off(meta,i);
    let k:i32=0;
    while(k<rn){
        if(g32(pred,off+k*4)!=g32(rb,k*4)){return 0;}
        k=k+1;
    }
    return 1;
}

// intersection size of two sorted u32 sets.
fn set_inter(a:[]u8,ao:i32,an:i32,b:[]u8,bo:i32,bn:i32)i32 {
    let i:i32=0;
    let j:i32=0;
    let c:i32=0;
    while(i<an && j<bn){
        let av:i64=g32(a,ao+i*4);
        let bv:i64=g32(b,bo+j*4);
        if(av==bv){c=c+1;i=i+1;j=j+1;}
        else{
            if(av<bv){i=i+1;}
            else{j=j+1;}
        }
    }
    return c;
}

// Install one row with the contradiction dead-marking rule (SPEC-GROK 3):
// installing a pol=0 row when a live row with equal pred-set, equal subj,
// pol=0 and different val exists marks both dead.
fn install_row(meta:[]u8,pred:[]u8,lex:[]u8,nr:[]u8,pu:[]u8,lu:[]u8,subj:i64,pol:i64,val:i64,rb:[]u8,rn:i32,lx:[]u8,lxn:i32)void {
    let n:i32=g32(nr,0) as i32;
    if(n>=2048){return;}
    let hit:i32=0;
    if(pol==0){
        let i:i32=0;
        while(i<n){
            if(m_dead(meta,i)==0 && m_pol(meta,i)==0 && m_subj(meta,i)==subj && m_val(meta,i)!=val){
                if(pred_eq(pred,meta,i,rb,rn)==1){
                    m_set_dead(meta,i);
                    hit=1;
                }
            }
            i=i+1;
        }
    }
    let po:i32=g32(pu,0) as i32;
    let k:i32=0;
    while(k<rn){
        p32(pred,po+k*4,g32(rb,k*4));
        k=k+1;
    }
    p32(pu,0,(po+rn*4) as i64);
    let lo:i32=g32(lu,0) as i32;
    let w:i32=0;
    while(w<lxn){
        p32(lex,lo+w*4,g32(lx,w*4));
        w=w+1;
    }
    p32(lu,0,(lo+lxn*4) as i64);
    let m:i32=n*40;
    p64(meta,m,subj);
    p32(meta,m+8,pol);
    p64(meta,m+12,val);
    p32(meta,m+20,hit as i64);
    p32(meta,m+24,po as i64);
    p32(meta,m+28,rn as i64);
    p32(meta,m+32,lo as i64);
    p32(meta,m+36,lxn as i64);
    p32(nr,0,(n+1) as i64);
    return;
}

// Exact skeleton scan. dead_want=1 finds dead matches, 0 finds live matches.
// Returns the lowest install index, or -1.
fn exact_scan(meta:[]u8,pred:[]u8,n:i32,subj:i64,pol:i64,rb:[]u8,rn:i32,dead_want:i32)i32 {
    let i:i32=0;
    while(i<n){
        let d:i64=m_dead(meta,i);
        let ok:i32=0;
        if(dead_want==1 && d==1){ok=1;}
        if(dead_want==0 && d==0){ok=1;}
        if(ok==1 && m_subj(meta,i)==subj && m_pol(meta,i)==pol){
            if(pred_eq(pred,meta,i,rb,rn)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// Deterministic bag-of-words fallback over live pol=0 rows.
// out: 0:inter2 u64 | 8:prod u64 of the best candidate.
// Returns the best install index, or -1 when there are no candidates.
// Best = maximum inter^2/(|A|*|B|) compared exactly as integers;
// ties keep the lowest install index (in-order scan, strict >).
fn bow_best(meta:[]u8,lex:[]u8,n:i32,pa:[]u8,pan:i32,out:[]u8)i32 {
    let best:i32=-1;
    let bi2:i64=0;
    let bp:i64=1;
    let i:i32=0;
    while(i<n){
        if(m_dead(meta,i)==0 && m_pol(meta,i)==0){
            let bn:i32=m_lex_n(meta,i);
            if(pan>0 && bn>0){
                let inter:i32=set_inter(pa,0,pan,lex,m_lex_off(meta,i),bn);
                let i2:i64=(inter as i64)*(inter as i64);
                let pr:i64=(pan as i64)*(bn as i64);
                let take:i32=0;
                if(best<0){take=1;}
                else{
                    if(i2*bp>bi2*pr){take=1;}
                }
                if(take==1){
                    best=i;
                    bi2=i2;
                    bp=pr;
                }
            }
        }
        i=i+1;
    }
    p64(out,0,bi2);
    p64(out,8,bp);
    return best;
}

// Sorted deduped content-stem uid set from the parser sentence context.
fn build_lex(cpos:[]u8,tsuid:[]u8,sctx:[]u8,out:[]u8)i32 {
    let cn:i32=g32(sctx,4) as i32;
    let i:i32=0;
    while(i<cn){
        let ti:i32=g32(cpos,i*4) as i32;
        p32(out,i*4,g32(tsuid,ti*4));
        i=i+1;
    }
    isort32(out,cn);
    let w:i32=0;
    let r:i32=0;
    while(r<cn){
        if(r==0){
            p32(out,0,g32(out,0));
            w=1;
        }
        else{
            if(g32(out,r*4)!=g32(out,(w-1)*4)){
                p32(out,w*4,g32(out,r*4));
                w=w+1;
            }
        }
        r=r+1;
    }
    return w;
}

// (b1) coref-visible lex: when coreference fired for this sentence
// (sctx[48]==1), the sentence used a pronoun; append the resolved entity's
// stem uids to the row's lexical set so the entity is lexically visible at
// retrieval. Re-sorts/dedups like build_lex.
fn lex_add_coref(sctx:[]u8,entstem:[]u8,lx:[]u8,lx_n:i32)i32 {
    if(g32(sctx,48)!=1){return lx_n;}
    let en:i32=g32(sctx,40) as i32;
    let q:i32=0;
    while(q<en){
        p32(lx,(lx_n+q)*4,g32(entstem,q*4));
        q=q+1;
    }
    let tot:i32=lx_n+en;
    isort32(lx,tot);
    let w:i32=0;
    let r:i32=0;
    while(r<tot){
        if(r==0){
            p32(lx,0,g32(lx,0));
            w=1;
        }
        else{
            if(g32(lx,r*4)!=g32(lx,(w-1)*4)){
                p32(lx,w*4,g32(lx,r*4));
                w=w+1;
            }
        }
        r=r+1;
    }
    return w;
}

// ---------------- output helpers ----------------
fn app_mem(b:[]u8,cur:i32,src:[]u8,so:i32,sn:i32)i32 {
    copy_bytes(b,cur,src,so,sn);
    return cur+sn;
}
fn app_str(b:[]u8,cur:i32,s:[]u8)i32 {
    copy_bytes(b,cur,s,0,s.len);
    return cur+s.len;
}
fn app_i64(b:[]u8,cur:i32,v:i64,tmp:[]u8)i32 {
    let n:i32=i64str(v,tmp);
    copy_bytes(b,cur,tmp,0,n);
    return cur+n;
}
fn write_proof(path:[]u8,proof:[]u8,plen:i32)i32 {
    let pn:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(pn) as i64),577,420,0,0,0);
    nio_free(pn);
    if(fd<0){return -1;}
    let wr:i64=nio_write_all(fd,proof[0..plen]);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(wr<0){return -1;}
    return 0;
}

// ---------------- teach ----------------
// cs: 0:peid i64 | 8:ppn i32 | 12:ppn_n i32 (coref state, reset per line).
fn teach_sentence(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,lowb:[]u8,stembuf:[]u8,linka:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,tval:[]u8,cpos:[]u8,vtokb:[]u8,sctx:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,relbuf:[]u8,lx:[]u8,pbuf:[]u8,pentstem:[]u8,cs:[]u8,meta:[]u8,pred:[]u8,lex:[]u8,nr:[]u8,pu:[]u8,lu:[]u8)void {
    let peid:i64=g64(cs,0);
    let ppn:i32=g32(cs,8) as i32;
    let ppn_n:i32=g32(cs,12) as i32;
    prep_sentence(vbytes,vent,sbuf,soff,slen,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,peid,pbuf,ppn,pentstem,ppn_n,0,2);
    let eid:i64=g64(sctx,64);
    let vok:i32=g32(sctx,80) as i32;
    if(eid!=4294967295 && vok==1){
        let val:i64=g64(sctx,88);
        let pol:i64=g32(sctx,72);
        let rel_n:i32=g32(sctx,44) as i32;
        let lx_n:i32=build_lex(cpos,tsuid,sctx,lx);
        lx_n=lex_add_coref(sctx,entstem,lx,lx_n);
        install_row(meta,pred,lex,nr,pu,lu,eid,pol,val,relbuf,rel_n,lx,lx_n);
    }
    if(eid!=4294967295){
        p64(cs,0,eid);
        let el:i32=g32(sctx,36) as i32;
        let en:i32=g32(sctx,40) as i32;
        p32(cs,8,el as i64);
        p32(cs,12,en as i64);
        copy_bytes(pbuf,0,ebuf,0,el);
        let ec:i32=0;
        while(ec<en){
            p32(pentstem,ec*4,g32(entstem,ec*4));
            ec=ec+1;
        }
    }
    return;
}

// ---------------- retrieve ----------------
// out: 0:vval i64 | 8:inter2 i64 | 16:prod i64 | 24:cand i64 | 32:pathidx i64
//   (0=none, 1=exact, 2=fallback). Returns 0=VALUE 1=UNKNOWN 2=CONTRADICTION.
fn retrieve(meta:[]u8,pred:[]u8,lex:[]u8,nr:[]u8,eid:i64,pol:i64,relbuf:[]u8,rel_n:i32,lx:[]u8,plx_n:i32,bowout:[]u8,out:[]u8)i32 {
    let n:i32=g32(nr,0) as i32;
    let di:i32=exact_scan(meta,pred,n,eid,pol,relbuf,rel_n,1);
    if(di>=0){
        p64(out,0,m_val(meta,di));
        p64(out,24,di as i64);
        p64(out,32,1);
        let bn0:i32=m_lex_n(meta,di);
        let in0:i32=set_inter(lx,0,plx_n,lex,m_lex_off(meta,di),bn0);
        p64(out,8,(in0 as i64)*(in0 as i64));
        p64(out,16,(plx_n as i64)*(bn0 as i64));
        return 2;
    }
    let li:i32=exact_scan(meta,pred,n,eid,pol,relbuf,rel_n,0);
    if(li>=0){
        p64(out,0,m_val(meta,li));
        p64(out,24,li as i64);
        p64(out,32,1);
        let bn1:i32=m_lex_n(meta,li);
        let in1:i32=set_inter(lx,0,plx_n,lex,m_lex_off(meta,li),bn1);
        p64(out,8,(in1 as i64)*(in1 as i64));
        p64(out,16,(plx_n as i64)*(bn1 as i64));
        return 0;
    }
    p64(out,32,2);
    let bi:i32=bow_best(meta,lex,n,lx,plx_n,bowout);
    let ti2:i64=g64(bowout,0);
    let tprod:i64=g64(bowout,8);
    p64(out,8,ti2);
    p64(out,16,tprod);
    if(bi<0){
        p64(out,24,-1);
        return 1;
    }
    p64(out,24,bi as i64);
    if(4*ti2>=tprod){
        p64(out,0,m_val(meta,bi));
        return 0;
    }
    return 1;
}

fn main()i32 {
    let teach_path:[]u8=_zag_arg(1);
    let probe_path:[]u8=_zag_arg(2);
    if(teach_path.len==0){
        prl("usage: sg_grok teach.txt probe.txt");
        return 2;
    }
    if(probe_path.len==0){
        prl("usage: sg_grok teach.txt probe.txt");
        return 2;
    }
    // parser scratch arenas
    let vbytes:[]u8=nio_alloc(4194304);
    let vent:[]u8=nio_alloc(524288);
    let stembuf:[]u8=nio_alloc(65536);
    let lowb:[]u8=nio_alloc(1024);
    let linka:[]u8=nio_alloc(1048576);
    let toff:[]u8=nio_alloc(16384);
    let tlen:[]u8=nio_alloc(16384);
    let tsoff:[]u8=nio_alloc(16384);
    let tslen:[]u8=nio_alloc(16384);
    let tsuid:[]u8=nio_alloc(16384);
    let tflags:[]u8=nio_alloc(16384);
    let cpos:[]u8=nio_alloc(16384);
    let tval:[]u8=nio_alloc(32768);
    let vtokb:[]u8=nio_alloc(1024);
    let sctx:[]u8=nio_alloc(128);
    let ebuf:[]u8=nio_alloc(4096);
    let entstem:[]u8=nio_alloc(256);
    let etmp:[]u8=nio_alloc(256);
    let relbuf:[]u8=nio_alloc(4096);
    let pbuf:[]u8=nio_alloc(4096);
    let pentstem:[]u8=nio_alloc(256);
    let lx:[]u8=nio_alloc(4096);
    // attested store arenas
    let meta:[]u8=nio_alloc(81920);
    let pred:[]u8=nio_alloc(8388608);
    let lex:[]u8=nio_alloc(6291456);
    let nr:[]u8=nio_alloc(16);
    let pu:[]u8=nio_alloc(16);
    let lu:[]u8=nio_alloc(16);
    let cs:[]u8=nio_alloc(16);
    // output scratch
    let lbuf:[]u8=nio_alloc(4096);
    let proof:[]u8=nio_alloc(1048576);
    let pc:[]u8=nio_alloc(16);
    let itmp:[]u8=nio_alloc(32);
    let bowout:[]u8=nio_alloc(16);
    let rout:[]u8=nio_alloc(40);
    // ---- teach pass: file order, coref reset per line, threaded per sentence
    let tb:[]u8=read_all(teach_path);
    let tpos:i32=0;
    while(tpos<tb.len){
        let le:i32=tpos;
        while(le<tb.len && tb[le]!=10){le=le+1;}
        let lend:i32=le;
        if(lend>tpos && tb[lend-1]==13){lend=lend-1;}
        let f1:i32=tpos;
        while(f1<lend && tb[f1]!=9){f1=f1+1;}
        p64(cs,0,4294967295);
        p32(cs,8,0);
        p32(cs,12,0);
        let t0:i32=f1+1;
        if(t0>lend){t0=lend;}
        let seg:i32=t0;
        let k2:i32=t0;
        while(k2<=lend){
            let isend:i32=0;
            if(k2==lend){isend=1;}
            else{
                let cc:u8=tb[k2];
                if(cc==46 || cc==63 || cc==33){isend=1;}
            }
            if(isend==1){
                let a2:i32=seg;
                let b2:i32=k2;
                while(a2<b2 && tb[a2]==32){a2=a2+1;}
                while(b2>a2 && tb[b2-1]==32){b2=b2-1;}
                if(b2>a2){
                    teach_sentence(vbytes,vent,tb,a2,b2-a2,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,lx,pbuf,pentstem,cs,meta,pred,lex,nr,pu,lu);
                }
                seg=k2+1;
            }
            k2=k2+1;
        }
        tpos=le+1;
    }
    // ---- probe pass: stdout verdicts in probe order, traces to proof_grok.txt
    let pb:[]u8=read_all(probe_path);
    p32(pc,0,0);
    let ppos:i32=0;
    while(ppos<pb.len){
        let le2:i32=ppos;
        while(le2<pb.len && pb[le2]!=10){le2=le2+1;}
        let lend2:i32=le2;
        if(lend2>ppos && pb[lend2-1]==13){lend2=lend2-1;}
        let q1:i32=ppos;
        while(q1<lend2 && pb[q1]!=9){q1=q1+1;}
        let q2:i32=q1+1;
        while(q2<lend2 && pb[q2]!=9){q2=q2+1;}
        let id0:i32=ppos;
        let idn:i32=q1-ppos;
        let p0:i32=q1+1;
        if(p0>lend2){p0=lend2;}
        let p1:i32=q2;
        if(p1>lend2){p1=lend2;}
        prep_sentence(vbytes,vent,pb,p0,p1-p0,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,4294967295,pbuf,0,pentstem,0,1,2);
        let eid2:i64=g64(sctx,64);
        let rel_n2:i32=g32(sctx,44) as i32;
        let pol2:i64=g32(sctx,72);
        let plx_n:i32=build_lex(cpos,tsuid,sctx,lx);
        let vcode:i32=1;
        let vval2:i64=0;
        let ti2b:i64=0;
        let tprodb:i64=0;
        let tcandb:i64=-1;
        let ppath:[]u8="none";
        if(eid2!=4294967295){
            vcode=retrieve(meta,pred,lex,nr,eid2,pol2,relbuf,rel_n2,lx,plx_n,bowout,rout);
            vval2=g64(rout,0);
            ti2b=g64(rout,8);
            tprodb=g64(rout,16);
            tcandb=g64(rout,24);
            let pix:i64=g64(rout,32);
            if(pix==1){ppath="exact";}
            if(pix==2){ppath="fallback";}
        }
        let lc:i32=idn;
        copy_bytes(lbuf,0,pb,id0,idn);
        lbuf[lc]=9;
        lc=lc+1;
        if(vcode==0){
            lc=app_str(lbuf,lc,"VALUE:");
            lc=app_i64(lbuf,lc,vval2,itmp);
        }
        else{
            if(vcode==2){lc=app_str(lbuf,lc,"CONTRADICTION");}
            else{lc=app_str(lbuf,lc,"UNKNOWN");}
        }
        prl(lbuf[0..lc]);
        let c0:i32=g32(pc,0) as i32;
        c0=app_mem(proof,c0,pb,id0,idn);
        proof[c0]=9;
        c0=c0+1;
        c0=app_str(proof,c0,"COREF1 path=");
        c0=app_mem(proof,c0,ppath,0,ppath.len);
        c0=app_str(proof,c0," inter2=");
        c0=app_i64(proof,c0,ti2b,itmp);
        c0=app_str(proof,c0," prod=");
        c0=app_i64(proof,c0,tprodb,itmp);
        c0=app_str(proof,c0," cand=");
        c0=app_i64(proof,c0,tcandb,itmp);
        c0=app_str(proof,c0," verdict=");
        if(vcode==0){
            c0=app_str(proof,c0,"VALUE:");
            c0=app_i64(proof,c0,vval2,itmp);
        }
        else{
            if(vcode==2){c0=app_str(proof,c0,"CONTRADICTION");}
            else{c0=app_str(proof,c0,"UNKNOWN");}
        }
        proof[c0]=10;
        c0=c0+1;
        p32(pc,0,c0 as i64);
        ppos=le2+1;
    }
    let plen:i32=g32(pc,0) as i32;
    let wrc:i32=write_proof("proof_coref1.txt",proof,plen);
    return 0;
}

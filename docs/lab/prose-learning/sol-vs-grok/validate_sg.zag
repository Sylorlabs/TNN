// validate_sg.zag: frame validator for the Sol-vs-Grok battery.
// Usage: validate_sg teach_sg.txt probe_sg.txt
// Prints per sentence: kind \t id \t eid \t rel_n \t att \t vok \t val \t reluid,reluid,...
// Teach: peid reset per line, threaded across sentences within a line.
// Probes: peid threaded across lines (no trig expected in probes).
@import("sg_parse.zag")

fn emit(kind:[]u8,id:[]u8,idl:i32,vbytes:[]u8,vent:[]u8,lowb:[]u8,stembuf:[]u8,linka:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,tval:[]u8,cpos:[]u8,vtokb:[]u8,sctx:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,relbuf:[]u8,pbuf:[]u8,pentstem:[]u8,sbuf:[]u8,soff:i32,slen:i32,peid:i64,is_probe:i32)void {
    prep_sentence(vbytes,vent,sbuf,soff,slen,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,peid,pbuf,0,pentstem,0,is_probe,2);
    prlen(kind,kind.len); pr("\t");
    prlen(id,idl); pr("\t");
    prn(g64(sctx,64)); pr("\t");
    let rn:i32=g32(sctx,44) as i32;
    prn(rn as i64); pr("\t");
    prn(g32(sctx,72) as i64); pr("\t");
    prn(g32(sctx,80) as i64); pr("\t");
    prn(g64(sctx,88)); pr("\t");
    let k:i32=0;
    while(k<rn){
        if(k>0){pr(",");}
        prn(g32(relbuf,k*4) as i64);
        k=k+1;
    }
    prl("");
    return;
}

fn run_file(kind:[]u8,path:[]u8,is_probe:i32,vbytes:[]u8,vent:[]u8,lowb:[]u8,stembuf:[]u8,linka:[]u8,toff:[]u8,tlen:[]u8,tsoff:[]u8,tslen:[]u8,tsuid:[]u8,tflags:[]u8,tval:[]u8,cpos:[]u8,vtokb:[]u8,sctx:[]u8,ebuf:[]u8,entstem:[]u8,etmp:[]u8,relbuf:[]u8,pbuf:[]u8,pentstem:[]u8)void {
    let fb:[]u8=read_all(path);
    let idb:[]u8=nio_alloc(64);
    let peid:i64=4294967295;
    let pos:i32=0;
    while(pos<fb.len){
        let le:i32=pos;
        while(le<fb.len && fb[le]!=10){le=le+1;}
        let f1:i32=pos;
        while(f1<le && fb[f1]!=9){f1=f1+1;}
        let idl:i32=f1-pos;
        copy_bytes(idb,0,fb,pos,idl);
        // teach: one line may carry extra tab fields; text starts after first tab,
        // ends at line end. probe: id \t text \t class.
        let t0:i32=f1+1;
        if(t0>le){t0=le;}
        // sentence-scan bound: probes end text at the second tab (class field follows).
        let sbound:i32=le;
        if(is_probe==1){
            let f2:i32=f1+1;
            while(f2<le && fb[f2]!=9){f2=f2+1;}
            sbound=f2;
        }
        let line_peid:i64=4294967295;
        if(is_probe==0){line_peid=4294967295;}
        else{line_peid=peid;}
        let seg:i32=t0;
        let k2:i32=t0;
        while(k2<=sbound){
            let isend:i32=0;
            if(k2==sbound){isend=1;}
            else{
                let cc:u8=fb[k2];
                if(cc==46 || cc==63 || cc==33){isend=1;}
            }
            if(isend==1){
                let slen:i32=k2-seg;
                if(slen>0){
                    emit(kind,idb,idl,vbytes,vent,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,pbuf,pentstem,fb,seg,slen,line_peid,is_probe);
                    let ne:i64=g64(sctx,64);
                    if(ne!=4294967295){line_peid=ne;}
                }
                seg=k2+1;
            }
            k2=k2+1;
        }
        peid=line_peid;
        if(le<fb.len){pos=le+1;}
        else{pos=le;}
    }
    nio_free(idb);
    nio_free(fb);
    return;
}

fn main()void {
    let vbytes:[]u8=nio_alloc(2097152);
    let vent:[]u8=nio_alloc(262152);
    let linka:[]u8=nio_alloc(262144);
    let lowb:[]u8=nio_alloc(256);
    let stembuf:[]u8=nio_alloc(32768);
    let toff:[]u8=nio_alloc(1024);
    let tlen:[]u8=nio_alloc(1024);
    let tsoff:[]u8=nio_alloc(1024);
    let tslen:[]u8=nio_alloc(1024);
    let tsuid:[]u8=nio_alloc(1024);
    let tflags:[]u8=nio_alloc(1024);
    let tval:[]u8=nio_alloc(2048);
    let cpos:[]u8=nio_alloc(1024);
    let vtokb:[]u8=nio_alloc(64);
    let sctx:[]u8=nio_alloc(128);
    let ebuf:[]u8=nio_alloc(4096);
    let entstem:[]u8=nio_alloc(256);
    let etmp:[]u8=nio_alloc(256);
    let relbuf:[]u8=nio_alloc(256);
    let pbuf:[]u8=nio_alloc(256);
    let pentstem:[]u8=nio_alloc(256);
    p32(vbytes,0,8);
    p32(vent,0,0);
    p32(linka,0,4);
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    run_file("T",a1,0,vbytes,vent,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,pbuf,pentstem);
    run_file("P",a2,1,vbytes,vent,lowb,stembuf,linka,toff,tlen,tsoff,tslen,tsuid,tflags,tval,cpos,vtokb,sctx,ebuf,entstem,etmp,relbuf,pbuf,pentstem);
    return;
}

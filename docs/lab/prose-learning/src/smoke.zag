@import("R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    b[s.len]=0;
    return b;
}

fn main()i32 {
    let a0:[]u8=_zag_arg(0);
    let a1:[]u8=_zag_arg(1);
    _zag_print("arg0="); _zag_print(a0); _zag_println("");
    _zag_print("arg1="); _zag_print(a1); _zag_println("");
    // open a file via raw syscall
    let p:[]u8=z_cstr(a1);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    _zag_print("fd="); _zag_print(_zag_i64_to_str(fd)); _zag_println("");
    if(fd>=0){
        let buf:[]u8=nio_alloc(64);
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64),64,0,0,0);
        _zag_print("n="); _zag_print(_zag_i64_to_str(n)); _zag_println("");
        if(n>0){
            let w:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(buf) as i64),n,0,0,0);
            _zag_print("w="); _zag_print(_zag_i64_to_str(w)); _zag_println("");
        }
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        nio_free(buf);
    }
    // sha256 smoke
    let msg:[]u8="abc";
    let out:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(msg,out);
    _zag_print("sha_rc="); _zag_print(_zag_i64_to_str(rc as i64)); _zag_println("");
    _zag_print("sha="); _zag_print(ns_hex(out)); _zag_println("");
    nio_free(out);
    return 0;
}

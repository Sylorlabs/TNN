// ============================================================
// uspec.zag — SENSES_UNLIMITED: u4f multi-spectral field + ufreq
// unbounded-frequency signal atoms. Pure Zag, zero RNG.
// Micah's law: no human sensory limits in representation.
//   u4f:  W x H x 10 channels x i64 (R,G,B,UV,NIR,XRAY,DEPTH,ALPHA,ROUGH,SATFLAG)
//   ufreq: spectral atoms, freq_hz i64 (0..9.2e18), no sample rate, no Nyquist.
// No silent saturation: overflow sets SATFLAG / returns status. Emission
// (BMP/WAV) is always a DECLARED mapping with a sidecar; the map is never
// presented as the territory.
// Commands: uspec p1|p2|p3|rt <outdir>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")
@import("../../imagination/src/sin_lut.zag")

// sin_lut.zag needs these two names (same impl as field.zag).
fn j2_put16(b:[]u8, i:i64, v:i64) void {
    b[i * 2] = (v & 255) as u8;
    b[i * 2 + 1] = ((v >> 8) & 255) as u8;
}
fn j2_get16(b:[]u8, i:i64) i64 {
    let v:i64 = (b[i * 2] as i64) + (b[i * 2 + 1] as i64) * 256;
    if (v >= 32768) { v = v - 65536; }
    return v;
}
fn j2_put32f(b:[]u8, i:i64, v:i64) void {
    let at:i64 = i * 4;
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn j2_get32f(b:[]u8, i:i64) i64 {
    let at:i64 = i * 4;
    return (b[at] as i64) + (b[at+1] as i64) * 256 + (b[at+2] as i64) * 65536 + (b[at+3] as i64) * 16777216;
}

// ---------------- byte helpers ----------------
fn u_put32(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn u_put16(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn u_put64(b:[]u8, at:i64, v:i64) void {
    u_put32(b, at, v & 4294967295);
    // high word: arithmetic shift keeps two's complement
    u_put32(b, at + 4, (v >> 32) & 4294967295);
}
fn u_get32u(b:[]u8, at:i64) i64 {
    return (b[at] as i64) + (b[at+1] as i64) * 256 + (b[at+2] as i64) * 65536 + (b[at+3] as i64) * 16777216;
}
// sign-extending 64-bit read (u_get32u is unsigned; never use it where sign matters).
fn u_get64s(b:[]u8, at:i64) i64 {
    let lo:i64 = u_get32u(b, at);
    let hi:i64 = u_get32u(b, at + 4);
    if (hi < 2147483648) { return lo + hi * 4294967296; }
    let neg:i64 = 4294967296 - hi;
    return -(neg * 4294967296 - lo);
}
fn u_zcstr(path:[]u8) []u8 {
    let s:[]u8 = nio_alloc(path.len + 1);
    if (s.len == 0) { return ""; }
    let i:i64 = 0;
    while (i < path.len) { s[i] = path[i]; i = i + 1; }
    s[path.len] = 0 as u8;
    return s;
}
fn u_open_root_z(path:[]u8) i64 {
    let s:[]u8 = u_zcstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 720896, 0, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn u_open_child_z(root:i64, name:[]u8, create:i32) i64 {
    if (root < 0 || nio_name_valid(name) != 1) { return -7401; }
    let s:[]u8 = u_zcstr(name);
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657986, 384, 0, 0);
    nio_free(s);
    return fd;
}
fn u_write_all(fd:i64, data:[]u8) i64 {
    let at:i64 = 0;
    let calls:i64 = 0;
    while (at < data.len && calls < 65536) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64) + at, (data.len as i64) - at, 0, 0, 0);
        calls = calls + 1;
        if (n == -4) { continue; }
        if (n <= 0) { return -7407; }
        at = at + n;
    }
    if (at != data.len) { return -7407; }
    return at;
}
fn u_write_named(dir:[]u8, name:[]u8, data:[]u8) i64 {
    let root:i64 = u_open_root_z(dir);
    if (root < 0) { return -1; }
    let fd:i64 = u_open_child_z(root, name, 1);
    nio_close(root);
    if (fd < 0) { return -2; }
    let w:i64 = u_write_all(fd, data);
    nio_close(fd);
    if (w != data.len) { return -3; }
    return 0;
}

// ---------------- tiny string builder ----------------
fn sb_alloc(cap:i64) []u8 {
    let s:[]u8 = nio_alloc(cap as i32);
    if (s.len == 0) { return ""; }
    // layout: len@0 (8B), cap@8 (8B), bytes@16
    u_put64(s, 0, 0);
    u_put64(s, 8, cap);
    return s;
}
fn sb_len(s:[]u8) i64 { return u_get64s(s, 0); }
fn sb_appends(s:[]u8, t:[]u8) i64 {
    let l:i64 = sb_len(s);
    let cap:i64 = u_get64s(s, 8);
    if (l + t.len > cap) { return -1; }
    let i:i64 = 0;
    while (i < t.len) { s[16 + l + i] = t[i]; i = i + 1; }
    u_put64(s, 0, l + t.len);
    return 0;
}
fn sb_appendi(s:[]u8, v:i64) i64 {
    let t:[]u8 = _zag_i64_to_str(v);
    let r:i64 = sb_appends(s, t);
    return r;
}
fn sb_bytes(s:[]u8) []u8 {
    let l:i64 = sb_len(s);
    let o:[]u8 = nio_alloc(l as i32);
    if (o.len == 0) { return ""; }
    let i:i64 = 0;
    while (i < l) { o[i] = s[16 + i]; i = i + 1; }
    return o;
}

// ---------------- u4f multi-spectral field ----------------
// 10 channels x i64 per cell. Channel ids:
// 0 R_VIS 1 G_VIS 2 B_VIS 3 UV 4 NIR 5 XRAY 6 DEPTH 7 ALPHA 8 ROUGH 9 SATFLAG
fn u4_nch() i64 { return 10; }
fn u4_alloc(w:i64, h:i64) []u8 {
    if (w < 1 || h < 1 || w > 512 || h > 512) { return ""; }
    let n:i64 = w * h * 80;
    let ar:[]u8 = nio_alloc(n as i32);
    if (ar.len == 0) { return ""; }
    let i:i64 = 0;
    while (i < n) { ar[i] = 0 as u8; i = i + 1; }
    return ar;
}
fn u4_off(w:i64, h:i64, x:i64, y:i64, ch:i64) i64 {
    if (x < 0 || y < 0 || x >= w || y >= h || ch < 0 || ch >= 10) { return -1; }
    return (y * w + x) * 80 + ch * 8;
}
// put: stores v; negative EM energy (ch 0..5) sets SATFLAG bit (represented + flagged).
// returns 0 ok, -1 out of bounds.
fn u4_put(ar:[]u8, w:i64, h:i64, x:i64, y:i64, ch:i64, v:i64) i64 {
    let at:i64 = u4_off(w, h, x, y, ch);
    if (at < 0) { return -1; }
    u_put64(ar, at, v);
    if (ch >= 0 && ch <= 5 && v < 0) {
        let s:i64 = u_get64s(ar, at - ch * 8 + 9 * 8);
        u_put64(ar, at - ch * 8 + 9 * 8, s | (1 << ch));
    }
    return 0;
}
fn u4_get(ar:[]u8, w:i64, h:i64, x:i64, y:i64, ch:i64) i64 {
    let at:i64 = u4_off(w, h, x, y, ch);
    if (at < 0) { return 0; }
    return u_get64s(ar, at);
}
// checked add: saturates at i64 extremes and sets SATFLAG bit ch. Never wraps.
// returns 0 ok, -1 out of bounds, 1 saturated.
fn u4_add(ar:[]u8, w:i64, h:i64, x:i64, y:i64, ch:i64, dv:i64) i64 {
    let at:i64 = u4_off(w, h, x, y, ch);
    if (at < 0) { return -1; }
    let cur:i64 = u_get64s(ar, at);
    let sat:i64 = 0;
    let nv:i64 = cur + dv;
    if (dv > 0 && cur > 9223372036854775807 - dv) { nv = 9223372036854775807; sat = 1; }
    if (dv < 0 && cur < -9223372036854775808 - dv) { nv = -9223372036854775808; sat = 1; }
    u_put64(ar, at, nv);
    if (sat == 1) {
        let s:i64 = u_get64s(ar, at - ch * 8 + 9 * 8);
        u_put64(ar, at - ch * 8 + 9 * 8, s | (1 << ch));
    }
    return sat;
}
fn u4_satcount(ar:[]u8, w:i64, h:i64) i64 {
    let n:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            if (u4_get(ar, w, h, x, y, 9) != 0) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}
fn u4_disc(ar:[]u8, w:i64, h:i64, cx:i64, cy:i64, r:i64, ch:i64, v:i64) i64 {
    let y:i64 = cy - r;
    while (y <= cy + r) {
        let x:i64 = cx - r;
        while (x <= cx + r) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            if (dx * dx + dy * dy <= r * r) { u4_put(ar, w, h, x, y, ch, v); }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
fn u4_rect(ar:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, ch:i64, v:i64) i64 {
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) { u4_put(ar, w, h, x, y, ch, v); x = x + 1; }
        y = y + 1;
    }
    return 0;
}
// vertical gradient in one channel: v(y) = v0 + (v1-v0)*y/(h-1)
fn u4_vgrad(ar:[]u8, w:i64, h:i64, ch:i64, v0:i64, v1:i64) i64 {
    let y:i64 = 0;
    while (y < h) {
        let v:i64 = v0;
        if (h > 1) { v = v0 + (v1 - v0) * y / (h - 1); }
        let x:i64 = 0;
        while (x < w) { u4_put(ar, w, h, x, y, ch, v); x = x + 1; }
        y = y + 1;
    }
    return 0;
}
// ---------------- false-color BMP emission (declared mappings) ----------------
// mapping 1 HUMAN: (R,G,B)->RGB   2 BEE: UV->B, NIR->R, G->G   3 XRAY: XRAY->gray
// scale: 255 per 1e6 reference. Render clips >1e6 ONLY in the BMP; the field
// keeps true values. Returns clipped-pixel count via out param.
fn u4_render(ar:[]u8, w:i64, h:i64, map:i64, clipc:*i64) []u8 {
    let stride:i64 = ((w * 3 + 3) / 4) * 4;
    let px:i64 = stride * h;
    let bmp:[]u8 = nio_alloc((54 + px) as i32);
    if (bmp.len == 0) { return ""; }
    let i:i64 = 0;
    while (i < 54 + px) { bmp[i] = 0 as u8; i = i + 1; }
    bmp[0] = 66 as u8; bmp[1] = 77 as u8; // BM
    u_put32(bmp, 2, 54 + px);
    u_put32(bmp, 10, 54);
    u_put32(bmp, 14, 40);
    u_put32(bmp, 18, w);
    u_put32(bmp, 22, h);
    u_put16(bmp, 26, 1);
    u_put16(bmp, 28, 24);
    u_put32(bmp, 34, px);
    let cc:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let c0:i64 = 0;
            let c1:i64 = 0;
            let c2:i64 = 0;
            if (map == 1) {
                c0 = u4_get(ar, w, h, x, y, 2);
                c1 = u4_get(ar, w, h, x, y, 1);
                c2 = u4_get(ar, w, h, x, y, 0);
            }
            if (map == 2) {
                c0 = u4_get(ar, w, h, x, y, 3);
                c1 = u4_get(ar, w, h, x, y, 1);
                c2 = u4_get(ar, w, h, x, y, 4);
            }
            if (map == 3) {
                let g:i64 = u4_get(ar, w, h, x, y, 5);
                c0 = g; c1 = g; c2 = g;
            }
            // scale 255/1e6; negative -> 0 in render (flagged in field if EM)
            let b:i64 = c0 * 255 / 1000000;
            let g:i64 = c1 * 255 / 1000000;
            let r:i64 = c2 * 255 / 1000000;
            if (b < 0) { b = 0; }
            if (g < 0) { g = 0; }
            if (r < 0) { r = 0; }
            if (c0 > 1000000 || c1 > 1000000 || c2 > 1000000) { cc = cc + 1; }
            if (b > 255) { b = 255; }
            if (g > 255) { g = 255; }
            if (r > 255) { r = 255; }
            let at:i64 = 54 + (h - 1 - y) * stride + x * 3;
            bmp[at] = (b & 255) as u8;
            bmp[at+1] = (g & 255) as u8;
            bmp[at+2] = (r & 255) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    clipc.* = cc;
    return bmp;
}

// ---------------- ufreq unbounded-frequency signal atoms ----------------
// atom = 40B: freq_hz i64 @0, amp i64 @8 (millionths), phase_pm i64 @16,
// t0_us i64 @24, t1_us i64 @32. Arena: count i64 @0, atoms @8. Max 1024.
fn uq_alloc() []u8 {
    let ar:[]u8 = nio_alloc(8 + 1024 * 40);
    if (ar.len == 0) { return ""; }
    let i:i64 = 0;
    while (i < 8 + 1024 * 40) { ar[i] = 0 as u8; i = i + 1; }
    return ar;
}
fn uq_n(ar:[]u8) i64 { return u_get64s(ar, 0); }
fn uq_aoff(i:i64) i64 { return 8 + i * 40; }
// returns 0 ok, 1 arena full, 2 freq out of range (<0 or >9.2e18 boundary)
fn uq_add(ar:[]u8, freq:i64, amp:i64, ppm:i64, t0:i64, t1:i64) i64 {
    if (freq < 0) { return 2; }
    let n:i64 = uq_n(ar);
    if (n >= 1024) { return 1; }
    let at:i64 = uq_aoff(n);
    u_put64(ar, at, freq);
    u_put64(ar, at + 8, amp);
    u_put64(ar, at + 16, ppm);
    u_put64(ar, at + 24, t0);
    u_put64(ar, at + 32, t1);
    u_put64(ar, 0, n + 1);
    return 0;
}
fn uq_freq(ar:[]u8, i:i64) i64 { return u_get64s(ar, uq_aoff(i)); }
fn uq_amp(ar:[]u8, i:i64) i64 { return u_get64s(ar, uq_aoff(i) + 8); }
fn uq_t0(ar:[]u8, i:i64) i64 { return u_get64s(ar, uq_aoff(i) + 24); }
fn uq_t1(ar:[]u8, i:i64) i64 { return u_get64s(ar, uq_aoff(i) + 32); }
fn uq_maxfreq(ar:[]u8) i64 {
    let n:i64 = uq_n(ar);
    let m:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let f:i64 = uq_freq(ar, i);
        if (f > m) { m = f; }
        i = i + 1;
    }
    return m;
}
// rounding shift: (f + 2^(k-1)) >> k ; halves quantization vs truncation.
// fidelity and render MUST use the same shifted values.
fn uq_shf(f:i64, k:i64) i64 {
    if (k <= 0) { return f; }
    return (f + (1 << (k - 1))) >> k;
}
// smallest k with (maxf >> k) < 20000
fn uq_shift_k(maxf:i64) i64 {
    let k:i64 = 0;
    while ((maxf >> k) >= 20000 && k < 60) { k = k + 1; }
    return k;
}
// ratio-fidelity: max permille pair-ratio error after >>k shift.
// pairs with fi/fj > 1e6 skipped (documented); pairs lost to >>k (fjs==0)
// counted via lostc. returns maxe; lost count via out param.
fn uq_fidelity(ar:[]u8, lostc:*i64) i64 {
    let n:i64 = uq_n(ar);
    let k:i64 = uq_shift_k(uq_maxfreq(ar));
    let maxe:i64 = 0;
    let lost:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let j:i64 = i + 1;
        while (j < n) {
            let fa:i64 = uq_freq(ar, i);
            let fb:i64 = uq_freq(ar, j);
            // order: fi >= fj so ro >= 1000
            let fi:i64 = fa;
            let fj:i64 = fb;
            if (fi < fj) { fi = fb; fj = fa; }
            if (fj > 0 && fi / fj <= 1000000) {
                let ro:i64 = fi / fj * 1000 + (fi % fj) * 1000 / fj;
                let fis:i64 = uq_shf(fi, k);
                let fjs:i64 = uq_shf(fj, k);
                if (fjs == 0) {
                    lost = lost + 1;
                } else {
                    let rs:i64 = fis / fjs * 1000 + (fis % fjs) * 1000 / fjs;
                    let d:i64 = rs - ro;
                    if (d < 0) { d = -d; }
                    let e:i64 = d * 1000 / ro;
                    if (e > maxe) { maxe = e; }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    lostc.* = lost;
    return maxe;
}
// ---------------- pitch-shift WAV emission (declared mapping) ----------------
// renders atoms at freq>>k, 44100 Hz 16-bit mono. Envelope: linear 220-sample
// ramps. Peak-normalized to 24000 (sign-correct i64 peak, no reader bug).
// returns nsamp via out param; sidecar text via second out param.
fn uq_render_wav(ar:[]u8, lut:[]u8, k:i64, nsampc:*i64) []u8 {
    let sr:i64 = 44100;
    let n:i64 = uq_n(ar);
    // duration from max t1_us
    let tmax:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let t:i64 = uq_t1(ar, i);
        if (t > tmax) { tmax = t; }
        i = i + 1;
    }
    let nsamp:i64 = tmax * sr / 1000000 + 441;
    if (nsamp < 441) { nsamp = 441; }
    let mix:[]u8 = nio_alloc((nsamp * 8) as i32);
    if (mix.len == 0) { return ""; }
    let s:i64 = 0;
    while (s < nsamp) { u_put64(mix, s * 8, 0); s = s + 1; }
    let peak:i64 = 0;
    let a:i64 = 0;
    while (a < n) {
        let amp:i64 = uq_amp(ar, a);
        if (amp != 0) {
            let fs:i64 = uq_shf(uq_freq(ar, a), k);
            let inc:i64 = fs * 4294967296 / sr;
            // initial phase from phase_permille
            let ppm:i64 = u_get64s(ar, uq_aoff(a) + 16);
            let pha:i64 = ppm * 4294967296 / 1000;
            let s0:i64 = uq_t0(ar, a) * sr / 1000000;
            let s1:i64 = uq_t1(ar, a) * sr / 1000000;
            if (s0 < 0) { s0 = 0; }
            if (s1 > nsamp) { s1 = nsamp; }
            let t:i64 = s0;
            while (t < s1) {
                let env:i64 = 1000;
                if (t - s0 < 220) { env = (t - s0) * 1000 / 220; }
                if (s1 - t < 220) {
                    let e2:i64 = (s1 - t) * 1000 / 220;
                    if (e2 < env) { env = e2; }
                }
                let idx:i64 = (pha >> 24) & 255;
                let lv:i64 = j2_get16(lut, idx);
                let c:i64 = lv * amp / 1000000;
                c = c * env / 1000;
                let cur:i64 = u_get64s(mix, t * 8);
                let nv:i64 = cur + c;
                u_put64(mix, t * 8, nv);
                let ap:i64 = nv;
                if (ap < 0) { ap = -ap; }
                if (ap > peak) { peak = ap; }
                pha = pha + inc;
                t = t + 1;
            }
        }
        a = a + 1;
    }
    let total:i64 = 44 + nsamp * 2;
    let wav:[]u8 = nio_alloc(total as i32);
    if (wav.len == 0) { nio_free(mix); return ""; }
    let z:i64 = 0;
    while (z < total) { wav[z] = 0 as u8; z = z + 1; }
    wav[0] = 82 as u8; wav[1] = 73 as u8; wav[2] = 70 as u8; wav[3] = 70 as u8;
    u_put32(wav, 4, total - 8);
    wav[8] = 87 as u8; wav[9] = 65 as u8; wav[10] = 86 as u8; wav[11] = 69 as u8;
    wav[12] = 102 as u8; wav[13] = 109 as u8; wav[14] = 116 as u8; wav[15] = 32 as u8;
    u_put32(wav, 16, 16);
    u_put16(wav, 20, 1);
    u_put16(wav, 22, 1);
    u_put32(wav, 24, sr);
    u_put32(wav, 28, sr * 2);
    u_put16(wav, 32, 2);
    u_put16(wav, 34, 16);
    wav[36] = 100 as u8; wav[37] = 97 as u8; wav[38] = 116 as u8; wav[39] = 97 as u8;
    u_put32(wav, 40, nsamp * 2);
    let sc:i64 = 1;
    if (peak > 0) { sc = peak; }
    let t2:i64 = 0;
    while (t2 < nsamp) {
        // |v| <= 24000 < 32767 by construction (peak-normalized): the 16-bit
        // WAV stage CANNOT clip. Atoms keep true amplitudes regardless.
        let v:i64 = u_get64s(mix, t2 * 8) * 24000 / sc;
        wav[44 + t2 * 2] = (v & 255) as u8;
        wav[44 + t2 * 2 + 1] = ((v >> 8) & 255) as u8;
        t2 = t2 + 1;
    }
    nio_free(mix);
    nsampc.* = nsamp;
    return wav;
}

// ---------------- probe P1: radio spectrum of a city at night ----------------
fn p_city(ar:[]u8) i64 {
    let T:i64 = 3000000; // 3 s in us
    uq_add(ar, 88500000, 900000, 0, 0, T);
    uq_add(ar, 94700000, 1200000, 0, 0, T);
    uq_add(ar, 98100000, 800000, 0, 0, T);
    uq_add(ar, 103500000, 1100000, 0, 0, T);
    uq_add(ar, 107900000, 700000, 0, 0, T);
    uq_add(ar, 540000, 400000, 0, 0, T);
    uq_add(ar, 1010000, 350000, 0, 0, T);
    uq_add(ar, 1700000, 300000, 0, 0, T);
    uq_add(ar, 1575420000, 200000, 0, 0, T);
    uq_add(ar, 2412000000, 1500000, 0, 0, 500000);
    uq_add(ar, 2437000000, 1500000, 0, 1000000, 1600000);
    uq_add(ar, 2462000000, 1500000, 0, 2000000, 2800000);
    uq_add(ar, 2450000000, 900000, 0, 800000, 2200000);
    uq_add(ar, 5180000000, 600000, 0, 0, T);
    uq_add(ar, 5745000000, 600000, 0, 0, T);
    return uq_n(ar);
}
// ---------------- probe P3: composed 2.4 GHz band ----------------
fn p_band24(ar:[]u8) i64 {
    // wifi ch1/6/11, three burst windows each
    uq_add(ar, 2412000000, 1500000, 0, 0, 400000);
    uq_add(ar, 2412000000, 1200000, 0, 900000, 1500000);
    uq_add(ar, 2412000000, 1600000, 0, 2100000, 2700000);
    uq_add(ar, 2437000000, 1400000, 0, 200000, 800000);
    uq_add(ar, 2437000000, 1500000, 0, 1200000, 1900000);
    uq_add(ar, 2437000000, 1100000, 0, 2300000, 2900000);
    uq_add(ar, 2462000000, 1300000, 0, 500000, 1100000);
    uq_add(ar, 2462000000, 1500000, 0, 1600000, 2200000);
    uq_add(ar, 2462000000, 1200000, 0, 2500000, 3000000);
    uq_add(ar, 2450000000, 900000, 0, 500000, 2500000); // microwave leakage
    let h:i64 = 0;
    while (h < 10) { // bluetooth hops, 0.1 s staggered
        uq_add(ar, 2402000000 + h * 1000000, 500000, 0, h * 300000, h * 300000 + 100000);
        h = h + 1;
    }
    return uq_n(ar);
}
// ---------------- probe P2: what a bee sees ----------------
// 64x64 u4f. Returns nectar-disc pixel count via out param.
fn p_bee(ar:[]u8, w:i64, h:i64, nectarc:*i64) i64 {
    // sky: UV-bright gradient, rows 0..39
    let y:i64 = 0;
    while (y < 40) {
        let uv:i64 = 1400000 - y * 20000; // 1.4e6 -> 620k
        let x:i64 = 0;
        while (x < w) {
            u4_put(ar, w, h, x, y, 3, uv);
            u4_put(ar, w, h, x, y, 2, 500000);
            u4_put(ar, w, h, x, y, 1, 150000);
            x = x + 1;
        }
        y = y + 1;
    }
    // ground/foliage: NIR-bright (above reference: exercises the no-ceiling rule)
    y = 40;
    while (y < h) {
        let x2:i64 = 0;
        while (x2 < w) {
            u4_put(ar, w, h, x2, y, 4, 1200000);
            u4_put(ar, w, h, x2, y, 1, 400000);
            u4_put(ar, w, h, x2, y, 3, 80000);
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    // sun disc: all EM hot
    u4_disc(ar, w, h, 50, 10, 6, 0, 2000000);
    u4_disc(ar, w, h, 50, 10, 6, 1, 2000000);
    u4_disc(ar, w, h, 50, 10, 6, 2, 2000000);
    u4_disc(ar, w, h, 50, 10, 6, 3, 2000000);
    // 3 flowers: RGB petals + UV nectar guides (invisible in RGB)
    let fx0:i64 = 16; let fy0:i64 = 48;
    let fx1:i64 = 32; let fy1:i64 = 52;
    let fx2:i64 = 48; let fy2:i64 = 46;
    u4_disc(ar, w, h, fx0, fy0, 7, 0, 900000);
    u4_disc(ar, w, h, fx0, fy0, 7, 2, 350000);
    u4_disc(ar, w, h, fx1, fy1, 7, 0, 900000);
    u4_disc(ar, w, h, fx1, fy1, 7, 2, 350000);
    u4_disc(ar, w, h, fx2, fy2, 7, 0, 900000);
    u4_disc(ar, w, h, fx2, fy2, 7, 2, 350000);
    u4_disc(ar, w, h, fx0, fy0, 3, 3, 1500000);
    u4_disc(ar, w, h, fx1, fy1, 3, 3, 1500000);
    u4_disc(ar, w, h, fx2, fy2, 3, 3, 1500000);
    // count nectar-disc cells
    let nc:i64 = 0;
    let yy:i64 = 0;
    while (yy < h) {
        let xx:i64 = 0;
        while (xx < w) {
            let d0:i64 = (xx - fx0) * (xx - fx0) + (yy - fy0) * (yy - fy0);
            let d1:i64 = (xx - fx1) * (xx - fx1) + (yy - fy1) * (yy - fy1);
            let d2:i64 = (xx - fx2) * (xx - fx2) + (yy - fy2) * (yy - fy2);
            if (d0 <= 9 || d1 <= 9 || d2 <= 9) { nc = nc + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    nectarc.* = nc;
    return 0;
}
// M1: UV nectar contrast (permille). M2: same contrast on HUMAN blue channel.
fn p_bee_metrics(ar:[]u8, w:i64, h:i64, m1c:*i64, m2c:*i64) void {
    let fx0:i64 = 16; let fy0:i64 = 48;
    let fx1:i64 = 32; let fy1:i64 = 52;
    let fx2:i64 = 48; let fy2:i64 = 46;
    let in_uv:i64 = 0; let in_n:i64 = 0;
    let out_uv:i64 = 0; let out_n:i64 = 0;
    let in_b:i64 = 0; let out_b:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let d0:i64 = (x - fx0) * (x - fx0) + (y - fy0) * (y - fy0);
            let d1:i64 = (x - fx1) * (x - fx1) + (y - fy1) * (y - fy1);
            let d2:i64 = (x - fx2) * (x - fx2) + (y - fy2) * (y - fy2);
            let uv:i64 = u4_get(ar, w, h, x, y, 3);
            let bv:i64 = u4_get(ar, w, h, x, y, 2);
            if (d0 <= 9 || d1 <= 9 || d2 <= 9) {
                in_uv = in_uv + uv; in_n = in_n + 1;
                in_b = in_b + bv;
            } else {
                out_uv = out_uv + uv; out_n = out_n + 1;
                out_b = out_b + bv;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let mu_in:i64 = in_uv / in_n;
    let mu_out:i64 = out_uv / out_n;
    let m1:i64 = 0;
    if (mu_out > 0) { m1 = (mu_in - mu_out) * 1000 / mu_out; }
    let mb_in:i64 = in_b / in_n;
    let mb_out:i64 = out_b / out_n;
    let m2:i64 = 0;
    if (mb_out > 0) { m2 = (mb_in - mb_out) * 1000 / mb_out; }
    m1c.* = m1;
    m2c.* = m2;
}

// ---------------- rt: round-trip + bar battery ----------------
fn rt_u4f() i64 {
    // paint identical pattern on two arenas; they must be byte-equal
    let a:[]u8 = u4_alloc(16, 16);
    let b:[]u8 = u4_alloc(16, 16);
    if (a.len == 0 || b.len == 0) { return 0; }
    let p:i64 = 0;
    while (p < 2) {
        let ar:[]u8 = a;
        if (p == 1) { ar = b; }
        u4_vgrad(ar, 16, 16, 3, 100000, 1500000);
        u4_disc(ar, 16, 16, 8, 8, 5, 4, 1200000); // >1e6: no-ceiling value
        u4_rect(ar, 16, 16, 2, 2, 5, 5, 0, 2000000);
        u4_add(ar, 16, 16, 8, 8, 1, 500000);
        p = p + 1;
    }
    let ok:i64 = nio_equal(a, b);
    nio_free(a);
    nio_free(b);
    return ok;
}
fn rt_ufreq() i64 {
    let ar:[]u8 = uq_alloc();
    if (ar.len == 0) { return 0; }
    uq_add(ar, 2400000000, 1500000, 123, 0, 1000000);
    uq_add(ar, 88000000, 900000, 0, 0, 3000000);
    uq_add(ar, 1, 100000, 999, 500000, 600000);
    uq_add(ar, 9223372036854775807, 1, 0, 0, 1); // i64 max freq: legal
    if (uq_n(ar) != 4) { nio_free(ar); return 0; }
    if (uq_freq(ar, 0) != 2400000000) { nio_free(ar); return 0; }
    if (uq_amp(ar, 1) != 900000) { nio_free(ar); return 0; }
    if (uq_t0(ar, 2) != 500000) { nio_free(ar); return 0; }
    if (uq_freq(ar, 3) != 9223372036854775807) { nio_free(ar); return 0; }
    // explicit rejections
    if (uq_add(ar, -5, 1, 0, 0, 1) != 2) { nio_free(ar); return 0; }
    nio_free(ar);
    return 1;
}
fn rt_satflag() i64 {
    let ar:[]u8 = u4_alloc(4, 4);
    if (ar.len == 0) { return 0; }
    // negative EM energy: stored AND flagged
    u4_put(ar, 4, 4, 1, 1, 3, -500);
    if (u4_get(ar, 4, 4, 1, 1, 3) != -500) { nio_free(ar); return 0; }
    if ((u4_get(ar, 4, 4, 1, 1, 9) & 8) == 0) { nio_free(ar); return 0; }
    // checked-add overflow: saturates, never wraps
    u4_put(ar, 4, 4, 2, 2, 0, 9223372036854775802);
    let r:i64 = u4_add(ar, 4, 4, 2, 2, 0, 10);
    if (r != 1) { nio_free(ar); return 0; }
    if (u4_get(ar, 4, 4, 2, 2, 0) != 9223372036854775807) { nio_free(ar); return 0; }
    if ((u4_get(ar, 4, 4, 2, 2, 9) & 1) == 0) { nio_free(ar); return 0; }
    // out of bounds: explicit -1, nothing written
    if (u4_put(ar, 4, 4, 99, 99, 0, 5) != -1) { nio_free(ar); return 0; }
    if (u4_add(ar, 4, 4, 0, 99, 0, 5) != -1) { nio_free(ar); return 0; }
    nio_free(ar);
    return 1;
}
fn rt_arena_full() i64 {
    let ar:[]u8 = uq_alloc();
    if (ar.len == 0) { return 0; }
    let i:i64 = 0;
    while (i < 1024) {
        if (uq_add(ar, 1000000 + i, 1000, 0, 0, 1000) != 0) { nio_free(ar); return 0; }
        i = i + 1;
    }
    if (uq_add(ar, 1000000, 1000, 0, 0, 1000) != 1) { nio_free(ar); return 0; }
    nio_free(ar);
    return 1;
}
fn rt_fidelity_bar() i64 {
    // wide spectra are emitted per-band (see SPEC: single-k integer shift cannot
    // hold <10 permille across 4 decades). The bar applies per rendered band.
    let ar:[]u8 = uq_alloc();
    if (ar.len == 0) { return 0; }
    p_city(ar);
    let aA:[]u8 = uq_alloc();
    let aB:[]u8 = uq_alloc();
    let aC:[]u8 = uq_alloc();
    uq_partition(ar, aA, aB, aC);
    let ok:i64 = 1;
    let lz:i64 = 0;
    if (uq_fidelity(aA, &lz) >= 10) { ok = 0; }
    if (uq_fidelity(aB, &lz) >= 10) { ok = 0; }
    if (uq_fidelity(aC, &lz) >= 10) { ok = 0; }
    nio_free(ar); nio_free(aA); nio_free(aB); nio_free(aC);
    return ok;
}
// partition atoms by band: A <2MHz, B <2GHz, C >=2GHz. returns counts packed.
fn uq_partition(src:[]u8, aA:[]u8, aB:[]u8, aC:[]u8) i64 {
    let n:i64 = uq_n(src);
    let i:i64 = 0;
    while (i < n) {
        let f:i64 = uq_freq(src, i);
        let am:i64 = uq_amp(src, i);
        let pm:i64 = u_get64s(src, uq_aoff(i) + 16);
        let t0:i64 = uq_t0(src, i);
        let t1:i64 = uq_t1(src, i);
        if (f < 2000000) { uq_add(aA, f, am, pm, t0, t1); }
        if (f >= 2000000 && f < 2000000000) { uq_add(aB, f, am, pm, t0, t1); }
        if (f >= 2000000000) { uq_add(aC, f, am, pm, t0, t1); }
        i = i + 1;
    }
    return uq_n(aA) * 1000000 + uq_n(aB) * 1000 + uq_n(aC);
}
// ---------------- sidecar text ----------------
fn sc_line(sb:[]u8, k:[]u8, v:i64) void {
    sb_appends(sb, k);
    sb_appendi(sb, v);
    sb_appends(sb, "\n");
}
// ---------------- main ----------------
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let lut:[]u8 = nio_alloc(512);
    if (lut.len == 0) { _zag_println("error=no-lut-mem"); return 1; }
    j2_sin_init(lut);
    if (_zag_strcmp(a1, "p1") == 1) {
        // wide spectrum -> three declared band emissions (see SPEC)
        let ar:[]u8 = uq_alloc();
        p_city(ar);
        let bA:[]u8 = uq_alloc();
        let bB:[]u8 = uq_alloc();
        let bC:[]u8 = uq_alloc();
        uq_partition(ar, bA, bB, bC);
        // band A (render first, sidecar after: avoids heap interaction)
        let kA:i64 = uq_shift_k(uq_maxfreq(bA));
        let lA:i64 = 0; let eA:i64 = uq_fidelity(bA, &lA);
        let nA:i64 = 0; let wA:[]u8 = uq_render_wav(bA, lut, kA, &nA);
        u_write_named(a2, "p1_city_am.wav", wA);
        // band B
        let kB:i64 = uq_shift_k(uq_maxfreq(bB));
        let lB:i64 = 0; let eB:i64 = uq_fidelity(bB, &lB);
        let nB:i64 = 0; let wB:[]u8 = uq_render_wav(bB, lut, kB, &nB);
        u_write_named(a2, "p1_city_fm.wav", wB);
        // band C
        let kC:i64 = uq_shift_k(uq_maxfreq(bC));
        let lC:i64 = 0; let eC:i64 = uq_fidelity(bC, &lC);
        let nC:i64 = 0; let wC:[]u8 = uq_render_wav(bC, lut, kC, &nC);
        u_write_named(a2, "p1_city_ghz.wav", wC);
        let sb:[]u8 = sb_alloc(4096);
        sb_appends(sb, "uspec p1 city-radio spectrum (multi-band emission)\n");
        sc_line(sb, "bandA_AM atoms=", uq_n(bA));
        sc_line(sb, "bandA_k=", kA);
        sc_line(sb, "bandA_fidelity_pm=", eA);
        sc_line(sb, "bandB_FM_GPS atoms=", uq_n(bB));
        sc_line(sb, "bandB_k=", kB);
        sc_line(sb, "bandB_fidelity_pm=", eB);
        sc_line(sb, "bandC_GHz atoms=", uq_n(bC));
        sc_line(sb, "bandC_k=", kC);
        sc_line(sb, "bandC_fidelity_pm=", eC);
        sb_appends(sb, "mapping=pitch-shift >>k per band; WAVs are NOT the signal; render_clipped=0 all bands by-construction (peak-normalized to 24000 < 32767)\n");
        let txt:[]u8 = sb_bytes(sb);
        u_write_named(a2, "p1_city.txt", txt);
        _zag_print("p1 bands A/B/C k=");
        _zag_print(_zag_i64_to_str(kA)); _zag_print("/");
        _zag_print(_zag_i64_to_str(kB)); _zag_print("/");
        _zag_print(_zag_i64_to_str(kC));
        _zag_print(" emax_pm="); _zag_print(_zag_i64_to_str(eA));
        _zag_print("/"); _zag_print(_zag_i64_to_str(eB));
        _zag_print("/"); _zag_println(_zag_i64_to_str(eC));
        nio_free(ar); nio_free(bA); nio_free(bB); nio_free(bC);
        nio_free(wA); nio_free(wB); nio_free(wC);
        nio_free(sb); nio_free(txt);
        nio_free(lut);
        return 0;
    }
    if (_zag_strcmp(a1, "p3") == 1) {
        let ar3:[]u8 = uq_alloc();
        let n3:i64 = p_band24(ar3);
        let maxf3:i64 = uq_maxfreq(ar3);
        let k3:i64 = uq_shift_k(maxf3);
        let lost3:i64 = 0;
        let maxe3:i64 = uq_fidelity(ar3, &lost3);
        let ns3:i64 = 0;
        let wav3:[]u8 = uq_render_wav(ar3, lut, k3, &ns3);
        u_write_named(a2, "p3_24ghz.wav", wav3);
        let sb3:[]u8 = sb_alloc(2048);
        sc_line(sb3, "uspec p3 2.4GHz band composition\natoms=", n3);
        sc_line(sb3, "fmax_hz=", maxf3);
        sc_line(sb3, "shift_k=", k3);
        sc_line(sb3, "fidelity_max_permille=", maxe3);
        sc_line(sb3, "fidelity_lost_pairs=", lost3);
        sc_line(sb3, "nsamp=", ns3);
        sb_appends(sb3, "mapping=pitch-shift >>k; WAV is NOT the signal; render_clipped=0 by-construction (peak-normalized to 24000 < 32767)\n");
        let txt3:[]u8 = sb_bytes(sb3);
        u_write_named(a2, "p3_24ghz.txt", txt3);
        _zag_print("p3 atoms="); _zag_print(_zag_i64_to_str(n3));
        _zag_print(" k="); _zag_print(_zag_i64_to_str(k3));
        _zag_print(" maxe_pm="); _zag_print(_zag_i64_to_str(maxe3));
        _zag_print(" lost="); _zag_println(_zag_i64_to_str(lost3));
        nio_free(ar3); nio_free(wav3); nio_free(sb3); nio_free(txt3);
        nio_free(lut);
        return 0;
    }
    if (_zag_strcmp(a1, "p2") == 1) {
        let w:i64 = 64;
        let h:i64 = 64;
        let f:[]u8 = u4_alloc(w, h);
        let nc:i64 = 0;
        p_bee(f, w, h, &nc);
        let m1:i64 = 0; let m2:i64 = 0;
        p_bee_metrics(f, w, h, &m1, &m2);
        let cc:i64 = 0;
        let bee:[]u8 = u4_render(f, w, h, 2, &cc);
        u_write_named(a2, "p2_bee.bmp", bee);
        let cc2:i64 = 0;
        let hum:[]u8 = u4_render(f, w, h, 1, &cc2);
        u_write_named(a2, "p2_human.bmp", hum);
        let sat:i64 = u4_satcount(f, w, h);
        let sb2:[]u8 = sb_alloc(2048);
        sc_line(sb2, "uspec p2 bee-vision\nnectar_cells=", nc);
        sc_line(sb2, "M1_uv_nectar_contrast_pm=", m1);
        sc_line(sb2, "M2_humanblue_nectar_contrast_pm=", m2);
        sc_line(sb2, "bee_clipped_px=", cc);
        sc_line(sb2, "human_clipped_px=", cc2);
        sc_line(sb2, "satflag_px=", sat);
        sb_appends(sb2, "mapping=2 BEE false-color (UV->B,NIR->R,G->G); 1 HUMAN (RGB)\n");
        let txt2:[]u8 = sb_bytes(sb2);
        u_write_named(a2, "p2_bee.txt", txt2);
        _zag_print("p2 M1_uv_pm="); _zag_print(_zag_i64_to_str(m1));
        _zag_print(" M2_humanblue_pm="); _zag_println(_zag_i64_to_str(m2));
        nio_free(f); nio_free(bee); nio_free(hum); nio_free(sb2); nio_free(txt2);
        nio_free(lut);
        return 0;
    }
    if (_zag_strcmp(a1, "rt") == 1) {
        let t1:i64 = rt_u4f();
        let t2:i64 = rt_ufreq();
        let t3:i64 = rt_satflag();
        let t4:i64 = rt_arena_full();
        let t5:i64 = rt_fidelity_bar();
        _zag_print("rt-u4f-roundtrip "); _zag_println(_zag_i64_to_str(t1));
        _zag_print("rt-ufreq-roundtrip "); _zag_println(_zag_i64_to_str(t2));
        _zag_print("rt-satflag "); _zag_println(_zag_i64_to_str(t3));
        _zag_print("rt-arena-full "); _zag_println(_zag_i64_to_str(t4));
        _zag_print("rt-fidelity-bar "); _zag_println(_zag_i64_to_str(t5));
        nio_free(lut);
        if (t1 == 1 && t2 == 1 && t3 == 1 && t4 == 1 && t5 == 1) {
            _zag_println("rt ALL PASS");
            return 0;
        }
        _zag_println("rt FAIL");
        return 1;
    }
    _zag_println("error=probe-id (p1|p2|p3|rt)");
    nio_free(lut);
    return 1;
}

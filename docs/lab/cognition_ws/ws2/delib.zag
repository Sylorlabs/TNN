// delib.zag — WS2-C TNN deliberative retrieval-scheme engine.
// Pure Zag, zero RNG, fully deterministic. Pinned znc.
// TNN's native deliberative control: it reads failure evidence + probe
// battery, then observes -> hypothesizes -> predicts -> tests -> decides,
// choosing its own retrieval scheme. The crew provides the harness; the
// DESIGN DECISIONS are the engine's, recorded in its audit trail.
// Conventions: []u8 arenas, u32 little-endian words. No []i32 casts.
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- raw io ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;while(i<s.len){b[i]=s[i];i=i+1;}b[s.len]=0;return b;
}
fn f_open_rd(path:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,0,0,0,0,0);
    nio_free(s);return fd;
}
fn f_size_fd(fd:i64)i64 {
    let st:[]u8=nio_alloc(256);
    let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    let sz:i64=-1;
    if(rc==0){
        let b0:i64=st[48] as i64;let b1:i64=st[49] as i64;
        let b2:i64=st[50] as i64;let b3:i64=st[51] as i64;
        let b4:i64=st[52] as i64;let b5:i64=st[53] as i64;
        let b6:i64=st[54] as i64;let b7:i64=st[55] as i64;
        sz=b0+b1*256+b2*65536+b3*16777216+b4*4294967296+b5*1099511627776+b6*281474976710656+b7*72057594037927936;
    }
    nio_free(st);return sz;
}
fn f_exists(path:[]u8)i32 {
    let fd:i64=f_open_rd(path);
    if(fd<0){return 0;}
    _zag_raw_syscall(3,fd,0,0,0,0,0);return 1;
}
fn f_read(path:[]u8)[]u8 {
    let fd:i64=f_open_rd(path);
    if(fd<0){return "";}
    let sz:i64=f_size_fd(fd);
    if(sz<0 || sz>8000000){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let buf:[]u8=nio_alloc((sz as i32)+1);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i64=0;let calls:i32=0;let ok:i32=1;
    while(at<sz && calls<4096 && ok==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,sz-at,0,0,0);
        calls=calls+1;
        if(n==-4){ok=1;}
        else{if(n<=0){ok=0;}else{at=at+n;}}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(ok==0 || at!=sz){return "";}
    return buf[0..(sz as i32)];
}
fn f_write(path:[]u8,data:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,577,420,0,0,0);
    nio_free(s);
    if(fd<0){return -1;}
    let at:i64=0;let calls:i32=0;let len:i64=data.len as i64;let ok:i32=1;
    while(at<len && calls<4096 && ok==1){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+at,len-at,0,0,0);
        calls=calls+1;
        if(n==-4){ok=1;}
        else{if(n<=0){ok=0;}else{at=at+n;}}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(ok==0 || at!=len){return -1;}
    return len;
}
fn f_mkdir(path:[]u8)i64 {
    let s:[]u8=z_cstr(path);
    let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(s) as i64,448,0,0,0,0);
    nio_free(s);
    if(rc==-17){return 0;}
    return rc;
}
fn concat(a:[]u8,b:[]u8)[]u8 {
    let o:[]u8=nio_alloc(a.len+b.len+1);
    let i:i32=0;while(i<a.len){o[i]=a[i];i=i+1;}
    let j:i32=0;while(j<b.len){o[a.len+j]=b[j];j=j+1;}
    return o[0..a.len+b.len];
}
fn path_join(dir:[]u8,name:[]u8)[]u8 {
    return concat(concat(dir,"/"),name);
}

// ---------------- strings ----------------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn u32get(b:[]u8,at:i32)i64 {
    let b0:i64=b[at] as i64;let b1:i64=b[at+1] as i64;
    let b2:i64=b[at+2] as i64;let b3:i64=b[at+3] as i64;
    return b0+b1*256+b2*65536+b3*16777216;
}
fn u32put(b:[]u8,at:i32,v:i64)void {
    let v0:i64=v&255;let v1:i64=(v>>8)&255;
    let v2:i64=(v>>16)&255;let v3:i64=(v>>24)&255;
    b[at]=v0 as u8;b[at+1]=v1 as u8;b[at+2]=v2 as u8;b[at+3]=v3 as u8;
}
fn bytes_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn bytes_lt(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        let x:i32=a[i] as i32;let y:i32=b[i] as i32;
        if(x<y){return 1;}
        if(x>y){return 0;}
        i=i+1;
    }
    if(a.len<b.len){return 1;}
    return 0;
}
fn lower(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=65 && c<=90){o[i]=(c+32) as u8;}else{o[i]=s[i];}
        i=i+1;
    }
    return o[0..s.len];
}
fn is_alnum(c:i32)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn starts_with(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}

// ---------------- parsing ----------------
fn lines_of(buf:[]u8)[]u8 {
    let n:i32=0;let i:i32=0;
    while(i<buf.len){if(buf[i]==10){n=n+1;}i=i+1;}
    if(buf.len>0 && buf[buf.len-1]!=10){n=n+1;}
    let ar:[]u8=nio_alloc(4+n*8+8);
    u32put(ar,0,n as i64);
    let li:i32=0;let start:i32=0;i=0;
    while(i<buf.len){
        if(buf[i]==10){
            let end:i32=i;
            if(end>start && buf[end-1]==13){end=end-1;}
            u32put(ar,4+li*8,start as i64);u32put(ar,4+li*8+4,(end-start) as i64);
            li=li+1;start=i+1;
        }
        i=i+1;
    }
    if(start<buf.len){
        let end:i32=buf.len;
        if(buf[end-1]==13){end=end-1;}
        u32put(ar,4+li*8,start as i64);u32put(ar,4+li*8+4,(end-start) as i64);
        li=li+1;
    }
    u32put(ar,0,li as i64);
    return ar;
}
fn line_n(ar:[]u8)i32 {return u32get(ar,0) as i32;}
fn line_slice(buf:[]u8,ar:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return buf[o..o+l];
}
fn fields_of(line:[]u8,sep:u8,maxf:i32)[]u8 {
    let ar:[]u8=nio_alloc(4+maxf*8+8);
    let fi:i32=0;let start:i32=0;let i:i32=0;let done:i32=0;
    while(i<line.len && done==0){
        if(line[i]==sep && fi<maxf-1){
            u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(i-start) as i64);
            fi=fi+1;start=i+1;
        }
        i=i+1;
    }
    u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(line.len-start) as i64);
    fi=fi+1;
    u32put(ar,0,fi as i64);
    return ar;
}
fn fld_n(ar:[]u8)i32 {return u32get(ar,0) as i32;}
fn fld(ar:[]u8,line:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return line[o..o+l];
}
// tokenize lowercased s: arena [nt][off,len]* into s
fn tokenize(s:[]u8)[]u8 {
    let nt:i32=0;let i:i32=0;let start:i32=-1;
    while(i<=s.len){
        let c:i32=-1;if(i<s.len){c=s[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){nt=nt+1;start=-1;}
        i=i+1;
    }
    let ar:[]u8=nio_alloc(4+nt*8+8);u32put(ar,0,nt as i64);
    let ti:i32=0;i=0;start=-1;
    while(i<=s.len){
        let c:i32=-1;if(i<s.len){c=s[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){
            u32put(ar,4+ti*8,start as i64);u32put(ar,4+ti*8+4,(i-start) as i64);
            ti=ti+1;start=-1;
        }
        i=i+1;
    }
    return ar;
}
fn tok_n(ar:[]u8)i32 {return u32get(ar,0) as i32;}
fn tok(ar:[]u8,s:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return s[o..o+l];
}
fn tok_count(hay:[]u8,term:[]u8)i32 {
    if(term.len==0){return 0;}
    let n:i32=0;let i:i32=0;let start:i32=-1;
    while(i<=hay.len){
        let c:i32=-1;if(i<hay.len){c=hay[i] as i32;}
        let al:i32=is_alnum(c);
        if(al==1 && start<0){start=i;}
        if(al==0 && start>=0){
            if(i-start==term.len){
                let k:i32=0;let eq:i32=1;
                while(k<term.len){if(hay[start+k]!=term[k]){eq=0;}k=k+1;}
                if(eq==1){n=n+1;}
            }
            start=-1;
        }
        i=i+1;
    }
    return n;
}

// ---------------- index build ----------------
fn build_items(buf:[]u8)[]u8 {
    let lar:[]u8=lines_of(buf);
    let nl:i32=line_n(lar);
    let n:i32=0;let li:i32=0;
    while(li<nl){
        let ll:i32=u32get(lar,4+li*8+4) as i32;
        if(ll>0){
            let lo:i32=u32get(lar,4+li*8) as i32;
            if(buf[lo]!=35){n=n+1;}
        }
        li=li+1;
    }
    let tab:[]u8=nio_alloc(4+n*40+8);
    u32put(tab,0,n as i64);
    let ii:i32=0;li=0;
    while(li<nl){
        let lo:i32=u32get(lar,4+li*8) as i32;
        let ll:i32=u32get(lar,4+li*8+4) as i32;
        if(ll>0 && buf[lo]!=35){
            let ln:[]u8=buf[lo..lo+ll];
            let f:[]u8=fields_of(ln,124,5);
            let base:i32=4+ii*40;let fi:i32=0;
            while(fi<5){
                let fo:i32=u32get(f,4+fi*8) as i32;
                let fl:i32=u32get(f,4+fi*8+4) as i32;
                u32put(tab,base+fi*8,(lo+fo) as i64);
                u32put(tab,base+fi*8+4,fl as i64);
                fi=fi+1;
            }
            ii=ii+1;
        }
        li=li+1;
    }
    return tab;
}
fn item_n(tab:[]u8)i32 {return u32get(tab,0) as i32;}
fn item_f(buf:[]u8,tab:[]u8,i:i32,f:i32)[]u8 {
    let base:i32=4+i*40+f*8;
    let o:i32=u32get(tab,base) as i32;let l:i32=u32get(tab,base+4) as i32;
    return buf[o..o+l];
}
fn build_hay(buf:[]u8,tab:[]u8)[]u8 {
    let n:i32=item_n(tab);
    let total:i32=0;let i:i32=0;
    while(i<n){
        total=total+item_f(buf,tab,i,4).len+item_f(buf,tab,i,3).len+item_f(buf,tab,i,1).len+item_f(buf,tab,i,2).len+4;
        i=i+1;
    }
    let ar:[]u8=nio_alloc(4+n*8+total+8);
    u32put(ar,0,n as i64);
    let hb:i32=4+n*8;let at:i32=hb;
    i=0;
    while(i<n){
        let t:[]u8=lower(item_f(buf,tab,i,4));
        let s:[]u8=lower(item_f(buf,tab,i,3));
        let d:[]u8=lower(item_f(buf,tab,i,1));
        let y:[]u8=lower(item_f(buf,tab,i,2));
        u32put(ar,4+i*8,(at-hb) as i64);
        u32put(ar,4+i*8+4,(t.len+1+s.len+1+d.len+1+y.len) as i64);
        let k:i32=0;while(k<t.len){ar[at+k]=t[k];k=k+1;}at=at+t.len;ar[at]=32;at=at+1;
        k=0;while(k<s.len){ar[at+k]=s[k];k=k+1;}at=at+s.len;ar[at]=32;at=at+1;
        k=0;while(k<d.len){ar[at+k]=d[k];k=k+1;}at=at+d.len;ar[at]=32;at=at+1;
        k=0;while(k<y.len){ar[at+k]=y[k];k=k+1;}at=at+y.len;
        i=i+1;
    }
    return ar;
}
fn hay_of(ar:[]u8,i:i32)[]u8 {
    let n:i32=u32get(ar,0) as i32;
    let hb:i32=4+n*8;
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return ar[hb+o..hb+o+l];
}
fn build_df(hayar:[]u8)[]u8 {
    let n:i32=u32get(hayar,0) as i32;
    let cap:i32=4096;
    let ar:[]u8=nio_alloc(4+cap*12+131072+8);
    u32put(ar,0,0);
    let tb:i32=4+cap*12;let tblen:i32=0;
    let i:i32=0;
    while(i<n){
        let hay:[]u8=hay_of(hayar,i);
        let ta:[]u8=tokenize(hay);
        let nt:i32=tok_n(ta);
        let ua:[]u8=nio_alloc(4+nt*8+8);
        u32put(ua,0,0);
        let t:i32=0;
        while(t<nt){
            let to:i32=u32get(ta,4+t*8) as i32;
            let tl:i32=u32get(ta,4+t*8+4) as i32;
            let nu:i32=u32get(ua,0) as i32;
            let found:i32=0;let u:i32=0;
            while(u<nu){
                let uo:i32=u32get(ua,4+u*8) as i32;
                let ul:i32=u32get(ua,4+u*8+4) as i32;
                if(ul==tl){
                    let k:i32=0;let eq:i32=1;
                    while(k<tl){if(hay[uo+k]!=hay[to+k]){eq=0;}k=k+1;}
                    if(eq==1){found=1;}
                }
                u=u+1;
            }
            if(found==0){
                u32put(ua,4+nu*8,to as i64);u32put(ua,4+nu*8+4,tl as i64);
                u32put(ua,0,(nu+1) as i64);
            }
            t=t+1;
        }
        let nu2:i32=u32get(ua,0) as i32;let u2:i32=0;
        while(u2<nu2){
            let uo:i32=u32get(ua,4+u2*8) as i32;
            let ul:i32=u32get(ua,4+u2*8+4) as i32;
            let nv:i32=u32get(ar,0) as i32;
            let f2:i32=-1;let v:i32=0;
            while(v<nv){
                let vo:i32=u32get(ar,4+v*12) as i32;
                let vl:i32=u32get(ar,4+v*12+4) as i32;
                if(vl==ul){
                    let k:i32=0;let eq:i32=1;
                    while(k<ul){if(ar[tb+vo+k]!=hay[uo+k]){eq=0;}k=k+1;}
                    if(eq==1){f2=v;}
                }
                v=v+1;
            }
            if(f2>=0){
                let df:i32=u32get(ar,4+f2*12+8) as i32;
                u32put(ar,4+f2*12+8,(df+1) as i64);
            }else{
                let k:i32=0;while(k<ul){ar[tb+tblen+k]=hay[uo+k];k=k+1;}
                u32put(ar,4+nv*12,tblen as i64);
                u32put(ar,4+nv*12+4,ul as i64);
                u32put(ar,4+nv*12+8,1);
                u32put(ar,0,(nv+1) as i64);
                tblen=tblen+ul;
            }
            u2=u2+1;
        }
        i=i+1;
    }
    return ar;
}
fn df_of(ar:[]u8,term:[]u8)i32 {
    let nv:i32=u32get(ar,0) as i32;
    let tb:i32=4+4096*12;
    let v:i32=0;
    while(v<nv){
        let vo:i32=u32get(ar,4+v*12) as i32;
        let vl:i32=u32get(ar,4+v*12+4) as i32;
        if(vl==term.len){
            let k:i32=0;let eq:i32=1;
            while(k<vl){if(ar[tb+vo+k]!=term[k]){eq=0;}k=k+1;}
            if(eq==1){return u32get(ar,4+v*12+8) as i32;}
        }
        v=v+1;
    }
    return 0;
}
// subject table: [u32 n][n]u32 subidx at 4; [u32 nsubj]; subtab [nsubj](off,len) into subbuf
fn build_subj(buf:[]u8,tab:[]u8)[]u8 {
    let n:i32=item_n(tab);
    let ar:[]u8=nio_alloc(8+n*4+256*8+8192+8);
    u32put(ar,0,n as i64);
    let nsub:i32=0;
    let st:i32=8+n*4+4; // subtab base after nsubj word
    let sb:i32=st+256*8;
    let i:i32=0;
    while(i<n){
        let s:[]u8=item_f(buf,tab,i,3);
        let f:i32=-1;let j:i32=0;
        while(j<nsub){
            let so:i32=u32get(ar,st+j*8) as i32;
            let sl:i32=u32get(ar,st+j*8+4) as i32;
            if(sl==s.len){
                let k:i32=0;let eq:i32=1;
                while(k<sl){if(ar[sb+so+k]!=s[k]){eq=0;}k=k+1;}
                if(eq==1){f=j;}
            }
            j=j+1;
        }
        if(f<0){
            let cur:i32=0;let j2:i32=0;
            while(j2<nsub){cur=cur+u32get(ar,st+j2*8+4) as i32;j2=j2+1;}
            let k:i32=0;while(k<s.len){ar[sb+cur+k]=s[k];k=k+1;}
            u32put(ar,st+nsub*8,cur as i64);
            u32put(ar,st+nsub*8+4,s.len as i64);
            f=nsub;nsub=nsub+1;
        }
        u32put(ar,4+i*4,f as i64);
        i=i+1;
    }
    u32put(ar,4+n*4,nsub as i64);
    return ar;
}
fn subj_n(ar:[]u8)[]u8 {return ar;}
fn subj_idx(ar:[]u8,i:i32)i32 {return u32get(ar,4+i*4) as i32;}
fn subj_count_of(ar:[]u8)[]u8 {
    let n:i32=u32get(ar,0) as i32;
    let nsub:i32=u32get(ar,4+n*4) as i32;
    let c:[]u8=nio_alloc(4+nsub*4+8);
    u32put(c,0,nsub as i64);
    let j:i32=0;while(j<nsub){u32put(c,4+j*4,0);j=j+1;}
    let i:i32=0;
    while(i<n){
        let s:i32=subj_idx(ar,i);
        u32put(c,4+s*4,(u32get(c,4+s*4) as i64)+1);
        i=i+1;
    }
    return c;
}
// queries: [u32 nq][nq x 8 x (off,len)] into qbuf
fn build_queries(buf:[]u8)[]u8 {
    let lar:[]u8=lines_of(buf);
    let nl:i32=line_n(lar);
    let n:i32=0;let li:i32=0;
    while(li<nl){
        let ll:i32=u32get(lar,4+li*8+4) as i32;
        if(ll>0){
            let lo:i32=u32get(lar,4+li*8) as i32;
            if(buf[lo]!=35){n=n+1;}
        }
        li=li+1;
    }
    let tab:[]u8=nio_alloc(4+n*64+8);
    u32put(tab,0,n as i64);
    let ii:i32=0;li=0;
    while(li<nl){
        let lo:i32=u32get(lar,4+li*8) as i32;
        let ll:i32=u32get(lar,4+li*8+4) as i32;
        if(ll>0 && buf[lo]!=35){
            let ln:[]u8=buf[lo..lo+ll];
            let f:[]u8=fields_of(ln,124,8);
            let base:i32=4+ii*64;let fi:i32=0;
            while(fi<8){
                let fo:i32=u32get(f,4+fi*8) as i32;
                let fl:i32=u32get(f,4+fi*8+4) as i32;
                u32put(tab,base+fi*8,(lo+fo) as i64);
                u32put(tab,base+fi*8+4,fl as i64);
                fi=fi+1;
            }
            ii=ii+1;
        }
        li=li+1;
    }
    return tab;
}
fn q_n(qtab:[]u8)i32 {return u32get(qtab,0) as i32;}
fn q_f(buf:[]u8,qtab:[]u8,i:i32,f:i32)[]u8 {
    let base:i32=4+i*64+f*8;
    let o:i32=u32get(qtab,base) as i32;
    let l:i32=u32get(qtab,base+4) as i32;
    return buf[o..o+l];
}
// split s on ',': [u32 n][n](off,len) into s
fn split_comma(s:[]u8)[]u8 {
    let n:i32=1;let i:i32=0;
    while(i<s.len){if(s[i]==44){n=n+1;}i=i+1;}
    if(s.len==0){n=0;}
    let ar:[]u8=nio_alloc(4+n*8+8);
    u32put(ar,0,n as i64);
    let fi:i32=0;let start:i32=0;i=0;
    while(i<s.len){
        if(s[i]==44){
            u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(i-start) as i64);
            fi=fi+1;start=i+1;
        }
        i=i+1;
    }
    if(n>0){
        u32put(ar,4+fi*8,start as i64);u32put(ar,4+fi*8+4,(s.len-start) as i64);
    }
    return ar;
}

// ---------------- scheme evaluation ----------------
// hint kinds: 0=type, 1=domain, 2=subject
fn hints_of(qbuf:[]u8,qtab:[]u8,qi:i32)[]u8 {
    let har:[]u8=nio_alloc(4+3*8+8);
    u32put(har,0,3);
    let k:i32=0;
    while(k<3){
        let f:i32=3;if(k==1){f=4;}if(k==2){f=5;}
        let base:i32=4+qi*64+f*8;
        u32put(har,4+k*8,u32get(qtab,base) as i64);
        u32put(har,4+k*8+4,u32get(qtab,base+4) as i64);
        k=k+1;
    }
    return har;
}
fn hint_get(har:[]u8,qbuf:[]u8,k:i32)[]u8 {
    let o:i32=u32get(har,4+k*8) as i32;let l:i32=u32get(har,4+k*8+4) as i32;
    return qbuf[o..o+l];
}
fn hint_eq(buf:[]u8,tab:[]u8,i:i32,th:[]u8,dh:[]u8,sh:[]u8)i32 {
    if(th.len>0 && bytes_eq(th,item_f(buf,tab,i,2))==0){return 0;}
    if(dh.len>0 && bytes_eq(dh,item_f(buf,tab,i,1))==0){return 0;}
    if(sh.len>0 && bytes_eq(sh,item_f(buf,tab,i,3))==0){return 0;}
    return 1;
}
fn hint_eq_h(buf:[]u8,tab:[]u8,i:i32,har:[]u8,qbuf:[]u8)i32 {
    let th:[]u8=hint_get(har,qbuf,0);
    let dh:[]u8=hint_get(har,qbuf,1);
    let sh:[]u8=hint_get(har,qbuf,2);
    return hint_eq(buf,tab,i,th,dh,sh);
}
fn nhint_match(buf:[]u8,tab:[]u8,i:i32,har:[]u8,qbuf:[]u8)i32 {
    let c:i32=0;
    let th:[]u8=hint_get(har,qbuf,0);
    let dh:[]u8=hint_get(har,qbuf,1);
    let sh:[]u8=hint_get(har,qbuf,2);
    if(th.len>0 && bytes_eq(th,item_f(buf,tab,i,2))==1){c=c+1;}
    if(dh.len>0 && bytes_eq(dh,item_f(buf,tab,i,1))==1){c=c+1;}
    if(sh.len>0 && bytes_eq(sh,item_f(buf,tab,i,3))==1){c=c+1;}
    return c;
}
fn textscore(hayar:[]u8,dfar:[]u8,n:i32,i:i32,sc:i32,qta:[]u8,qlow:[]u8)i64 {
    let hay:[]u8=hay_of(hayar,i);
    let nt:i32=tok_n(qta);
    let s:i64=0;let t:i32=0;
    while(t<nt){
        let term:[]u8=tok(qta,qlow,t);
        let c:i32=tok_count(hay,term);
        if(sc==0){s=s+c as i64;}
        else{
            if(sc==1){
                if(c>0){
                    let df:i32=df_of(dfar,term);
                    let w:i64=1+(8*(n-df) as i64)/(n as i64);
                    s=s+(c as i64)*w;
                }
            }else{
                if(c>0){s=s+1;}
            }
        }
        t=t+1;
    }
    return s;
}
fn set_maxscore_h(buf:[]u8,tab:[]u8,hayar:[]u8,dfar:[]u8,n:i32,sc:i32,qta:[]u8,qlow:[]u8,har:[]u8,qbuf:[]u8)i64 {
    let mx:i64=0;let i:i32=0;
    while(i<n){
        if(hint_eq_h(buf,tab,i,har,qbuf)==1){
            let s:i64=textscore(hayar,dfar,n,i,sc,qta,qlow);
            if(s>mx){mx=s;}
        }
        i=i+1;
    }
    return mx;
}
fn verify_hints(buf:[]u8,tab:[]u8,hayar:[]u8,dfar:[]u8,n:i32,sc:i32,qta:[]u8,qlow:[]u8,har:[]u8,qbuf:[]u8)[]u8 {
    let out:[]u8=nio_alloc(4+3*8+8);
    u32put(out,0,3);
    let ma:i64=set_maxscore_h(buf,tab,hayar,dfar,n,sc,qta,qlow,har,qbuf);
    let k:i32=0;
    while(k<3){
        let l:i32=u32get(har,4+k*8+4) as i32;
        let keep:i32=0;
        if(l>0){
            let tmp:[]u8=nio_alloc(4+3*8+8);
            u32put(tmp,0,3);
            let j:i32=0;
            while(j<3){
                if(j==k){u32put(tmp,4+j*8,0);u32put(tmp,4+j*8+4,0);}
                else{
                    u32put(tmp,4+j*8,u32get(har,4+j*8) as i64);
                    u32put(tmp,4+j*8+4,u32get(har,4+j*8+4) as i64);
                }
                j=j+1;
            }
            let mb:i64=set_maxscore_h(buf,tab,hayar,dfar,n,sc,qta,qlow,tmp,qbuf);
            if(ma>0 || mb==0){keep=1;}
        }
        if(keep==1){
            u32put(out,4+k*8,u32get(har,4+k*8) as i64);
            u32put(out,4+k*8+4,l as i64);
        }else{
            u32put(out,4+k*8,0);u32put(out,4+k*8+4,0);
        }
        k=k+1;
    }
    return out;
}
// id comparison: returns 1 if id(a) < id(b) byte-wise
fn id_lt(buf:[]u8,tab:[]u8,a:i32,b:i32)i32 {
    return bytes_lt(item_f(buf,tab,a,0),item_f(buf,tab,b,0));
}
// select top-K item indices from score[]/cand[] into sel; returns count
fn topk_select(buf:[]u8,tab:[]u8,score:[]u8,cand:[]u8,n:i32,K:i32,sel:[]u8)i32 {
    let used:[]u8=nio_alloc(4+n+8);
    let cnt:i32=0;
    while(cnt<K){
        let best:i32=-1;
        let i:i32=0;
        while(i<n){
            if(cand[4+i]==1 && used[4+i]==0){
                if(best<0){best=i;}
                else{
                    let s:i64=u32get(score,4+i*4) as i64;
                    let bs:i64=u32get(score,4+best*4) as i64;
                    if(s>bs || (s==bs && id_lt(buf,tab,i,best)==1)){best=i;}
                }
            }
            i=i+1;
        }
        if(best<0){break;}
        u32put(sel,4+cnt*4,best as i64);
        used[4+best]=1;
        cnt=cnt+1;
    }
    return cnt;
}
// re-select top-K from a pool of item indices
fn topk_from_pool(buf:[]u8,tab:[]u8,score:[]u8,pool:[]u8,pn:i32,K:i32,sel:[]u8)i32 {
    let cnt:i32=0;
    while(cnt<K && cnt<pn){
        let best:i32=-1;
        let i:i32=0;
        while(i<pn){
            let ii2:i32=u32get(pool,4+i*4) as i32;
            let dup:i32=0;let d:i32=0;
            while(d<cnt){
                if((u32get(sel,4+d*4) as i32)==ii2){dup=1;}
                d=d+1;
            }
            if(dup==0){
                if(best<0){best=ii2;}
                else{
                    let s:i64=u32get(score,4+ii2*4) as i64;
                    let bs:i64=u32get(score,4+best*4) as i64;
                    if(s>bs || (s==bs && id_lt(buf,tab,ii2,best)==1)){best=ii2;}
                }
            }
            i=i+1;
        }
        if(best<0){break;}
        u32put(sel,4+cnt*4,best as i64);
        cnt=cnt+1;
    }
    return cnt;
}
// full query pipeline. out/prov: [u32 count][count x (off,len)] id refs into buf.
// returns final count; provisional count stored at prov[0].
fn run_query(buf:[]u8,tab:[]u8,hayar:[]u8,dfar:[]u8,subar:[]u8,subcnt:[]u8,n:i32,hm:i32,sc:i32,ab:i32,ex:i32,qbuf:[]u8,har:[]u8,qlow:[]u8,qta:[]u8,K:i32,out:[]u8,prov:[]u8)i32 {
    let rh:[]u8=har;
    if(hm==1){rh=verify_hints(buf,tab,hayar,dfar,n,sc,qta,qlow,har,qbuf);}
    let score:[]u8=nio_alloc(4+n*4+8);
    let cand:[]u8=nio_alloc(4+n+8);
    let i:i32=0;
    let maxs:i64=0;
    while(i<n){
        let isc:i32=0;
        if(hm==2){isc=1;}
        else{if(hint_eq_h(buf,tab,i,rh,qbuf)==1){isc=1;}}
        cand[4+i]=isc as u8;
        if(isc==1){
            let s:i64=textscore(hayar,dfar,n,i,sc,qta,qlow);
            if(hm==2){s=s+10*(nhint_match(buf,tab,i,har,qbuf) as i64);}
            u32put(score,4+i*4,s);
            if(s>maxs){maxs=s;}
        }
        i=i+1;
    }
    if(ab==1 && maxs==0){
        u32put(out,0,0);u32put(prov,0,0);
        return 0;
    }
    let sel:[]u8=nio_alloc(4+K*4+8);
    let pcnt:i32=topk_select(buf,tab,score,cand,n,K,sel);
    // provisional out
    u32put(prov,0,pcnt as i64);
    let p:i32=0;
    while(p<pcnt){
        let ii2:i32=u32get(sel,4+p*4) as i32;
        let base:i32=4+ii2*40;
        u32put(prov,4+p*8,u32get(tab,base) as i64);
        u32put(prov,4+p*8+4,u32get(tab,base+4) as i64);
        p=p+1;
    }
    let final:[]u8=sel;
    let fcnt:i32=pcnt;
    if(ex==1 && pcnt>0){
        let add:[]u8=nio_alloc(4+n*4+8);
        let acnt:i32=0;
        let nsub:i32=u32get(subcnt,0) as i32;
        let s2:i32=0;
        while(s2<nsub){
            let c:i32=0;let pp:i32=0;
            while(pp<pcnt){
                let ii3:i32=u32get(sel,4+pp*4) as i32;
                if(subj_idx(subar,ii3)==s2){c=c+1;}
                pp=pp+1;
            }
            let tot:i32=u32get(subcnt,4+s2*4) as i32;
            if(c>=1 && c*2>=tot){
                let mx:i64=0;let j:i32=0;
                while(j<n){
                    if(cand[4+j]==1 && subj_idx(subar,j)==s2){
                        let sj:i64=u32get(score,4+j*4) as i64;
                        if(sj>mx){mx=sj;}
                    }
                    j=j+1;
                }
                if(mx>0){
                    j=0;
                    while(j<n){
                        if(cand[4+j]==1 && subj_idx(subar,j)==s2){
                            let inn:i32=0;let p2:i32=0;
                            while(p2<pcnt){
                                if((u32get(sel,4+p2*4) as i32)==j){inn=1;}
                                p2=p2+1;
                            }
                            if(inn==0){
                                u32put(add,4+acnt*4,j as i64);
                                acnt=acnt+1;
                            }
                        }
                        j=j+1;
                    }
                }
            }
            s2=s2+1;
        }
        let pool:[]u8=nio_alloc(4+(pcnt+acnt)*4+8);
        let p3:i32=0;
        while(p3<pcnt){u32put(pool,4+p3*4,u32get(sel,4+p3*4) as i64);p3=p3+1;}
        let a3:i32=0;
        while(a3<acnt){u32put(pool,4+(pcnt+a3)*4,u32get(add,4+a3*4) as i64);a3=a3+1;}
        let sel2:[]u8=nio_alloc(4+K*4+8);
        fcnt=topk_from_pool(buf,tab,score,pool,pcnt+acnt,K,sel2);
        final=sel2;
    }
    u32put(out,0,fcnt as i64);
    let w:i32=0;
    while(w<fcnt){
        let ii4:i32=u32get(final,4+w*4) as i32;
        let base2:i32=4+ii4*40;
        u32put(out,4+w*8,u32get(tab,base2) as i64);
        u32put(out,4+w*8+4,u32get(tab,base2+4) as i64);
        w=w+1;
    }
    return fcnt;
}


// ---------------- classification + evaluation ----------------
// miss classes: 0=none(pass),1=F_ABSTAIN,2=F_HINT_EXCLUDE,3=F_DILUTE,
// 4=F_CLUSTER,5=F_UNCLASSIFIED
fn cls_name(c:i32)[]u8 {
    if(c==1){return "F_ABSTAIN";}
    if(c==2){return "F_HINT_EXCLUDE";}
    if(c==3){return "F_DILUTE";}
    if(c==4){return "F_CLUSTER";}
    if(c==5){return "F_UNCLASSIFIED";}
    return "PASS";
}
// check id (off,len into buf) present in out list
fn id_present(id:[]u8,out:[]u8,obuf:[]u8)i32 {
    let cnt:i32=u32get(out,0) as i32;
    let k:i32=0;
    while(k<cnt){
        let o:i32=u32get(out,4+k*8) as i32;
        let l:i32=u32get(out,4+k*8+4) as i32;
        let cand:[]u8=obuf[o..o+l];
        if(bytes_eq(id,cand)==1){return 1;}
        k=k+1;
    }
    return 0;
}
// any query token (from qta/qlow) occurs in hay slice
fn any_tok_in(hay:[]u8,qta:[]u8,qlow:[]u8)i32 {
    let nt:i32=tok_n(qta);
    let t:i32=0;
    while(t<nt){
        let term:[]u8=tok(qta,qlow,t);
        if(tok_count(hay,term)>0){return 1;}
        t=t+1;
    }
    return 0;
}
// classify one probe. gtab: gold ids [n](off,len) into qbuf.
// returns class; writes missed gold count to mcnt[0] (u32 arena).
fn classify(buf:[]u8,tab:[]u8,hayar:[]u8,subar:[]u8,subcnt:[]u8,n:i32,
    hm:i32,har:[]u8,rh:[]u8,qbuf:[]u8,gbuf:[]u8,
    gtab:[]u8,qta:[]u8,qlow:[]u8,K:i32,out:[]u8,prov:[]u8,mcnt:[]u8)i32 {
    let ng:i32=u32get(gtab,0) as i32;
    let rcnt:i32=u32get(out,0) as i32;
    let missed:i32=0;
    if(ng==0){
        if(rcnt>0){u32put(mcnt,0,0);return 1;}
        u32put(mcnt,0,0);return 0;
    }
    let g:i32=0;
    while(g<ng){
        let go:i32=u32get(gtab,4+g*8) as i32;
        let gl:i32=u32get(gtab,4+g*8+4) as i32;
        let gid:[]u8=gbuf[go..go+gl];
        if(id_present(gid,out,buf)==0){missed=missed+1;}
        g=g+1;
    }
    u32put(mcnt,0,missed as i64);
    if(missed==0){return 0;}
    if(rcnt==0){return 1;}
    // find first missed gold id -> item index
    let mg:i32=-1;let mgo:i32=0;let mgl:i32=0;
    g=0;
    while(g<ng){
        let go:i32=u32get(gtab,4+g*8) as i32;
        let gl:i32=u32get(gtab,4+g*8+4) as i32;
        let gid:[]u8=gbuf[go..go+gl];
        if(id_present(gid,out,buf)==0){
            mg=g;mgo=go;mgl=gl;
            g=ng;
        }
        g=g+1;
    }
    // locate item index of missed gold
    let mi:i32=-1;let ii2:i32=0;
    while(ii2<n){
        let id:[]u8=item_f(buf,tab,ii2,0);
        if(id.len==mgl){
            let k:i32=0;let eq:i32=1;
            while(k<mgl){if(id[k]!=gbuf[mgo+k]){eq=0;}k=k+1;}
            if(eq==1){mi=ii2;}
        }
        ii2=ii2+1;
    }
    if(mi>=0 && hm!=2){
        if(hint_eq_h(buf,tab,mi,rh,qbuf)==0){return 2;}
    }
    // F_CLUSTER: missed gold in subject S with >=half of S provisionally retrieved
    if(mi>=0){
        let s:i32=subj_idx(subar,mi);
        let tot:i32=u32get(subcnt,4+s*4) as i32;
        let pcnt:i32=u32get(prov,0) as i32;
        let c:i32=0;let p:i32=0;
        while(p<pcnt){
            let po:i32=u32get(prov,4+p*8) as i32;
            let pl:i32=u32get(prov,4+p*8+4) as i32;
            // find item index by id offset
            let jj:i32=0;
            while(jj<n){
                let base:i32=4+jj*40;
                if((u32get(tab,base) as i32)==po){
                    if(subj_idx(subar,jj)==s){c=c+1;}
                    jj=n;
                }
                jj=jj+1;
            }
            p=p+1;
        }
        if(c>=1 && c*2>=tot){return 4;}
    }
    // F_DILUTE: gold has text evidence but was outranked (R full)
    if(mi>=0){
        let hay:[]u8=hay_of(hayar,mi);
        if(any_tok_in(hay,qta,qlow)==1){
            if(rcnt==K){return 3;}
            return 5;
        }
    }
    return 5;
}

// ---------------- audit log ----------------
fn alog_init()[]u8 {
    let a:[]u8=nio_alloc(524288+8);
    u32put(a,0,0);
    return a;
}
fn alog(a:[]u8,s:[]u8)void {
    let l:i32=u32get(a,0) as i32;
    let i:i32=0;
    while(i<s.len){a[4+l+i]=s[i];i=i+1;}
    u32put(a,0,(l+s.len) as i64);
}
fn alog_i(a:[]u8,v:i64)void {alog(a,i64s(v));}
fn audit_bytes(a:[]u8)[]u8 {
    let l:i32=u32get(a,0) as i32;
    return a[4..4+l];
}
fn contains(s:[]u8,sub:[]u8)i32 {
    if(sub.len==0 || sub.len>s.len){return 0;}
    let i:i32=0;
    while(i+sub.len<=s.len){
        let k:i32=0;let eq:i32=1;
        while(k<sub.len){if(s[i+k]!=sub[k]){eq=0;}k=k+1;}
        if(eq==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn scheme_str(hm:i32,sc:i32,ab:i32,ex:i32)[]u8 {
    let s:[]u8="";
    if(hm==0){s=concat(s,"STRICT");}else{if(hm==1){s=concat(s,"VERIFY");}else{s=concat(s,"SOFT");}}
    s=concat(s,",");
    if(sc==0){s=concat(s,"COUNT");}else{if(sc==1){s=concat(s,"IDF");}else{s=concat(s,"COVER");}}
    s=concat(s,",");
    if(ab==0){s=concat(s,"NEVER");}else{s=concat(s,"ZERO");}
    s=concat(s,",");
    if(ex==0){s=concat(s,"NONE");}else{s=concat(s,"CLUSTER");}
    return s;
}
fn move_name(mv:i32)[]u8 {
    if(mv==0){return "M_AB1(ZERO)";}
    if(mv==1){return "M_HM1(VERIFY)";}
    if(mv==2){return "M_HM2(SOFT)";}
    if(mv==3){return "M_SC1(IDF)";}
    if(mv==4){return "M_SC2(COVER)";}
    return "M_EX1(CLUSTER)";
}
fn move_target(mv:i32)i32 {
    if(mv==0){return 1;}
    if(mv==1){return 2;}
    if(mv==2){return 2;}
    if(mv==3){return 3;}
    if(mv==4){return 3;}
    return 4;
}
// evaluate one battery; passes/classes are [nq]u8 arenas (at offset 4). returns misses.
fn eval_battery(buf:[]u8,tab:[]u8,hayar:[]u8,dfar:[]u8,subar:[]u8,subcnt:[]u8,n:i32,hm:i32,sc:i32,ab:i32,ex:i32,qbuf:[]u8,qtab:[]u8,passes:[]u8,classes:[]u8)i32 {
    let nq:i32=q_n(qtab);
    let tot:i32=0;
    let qi:i32=0;
    while(qi<nq){
        let har:[]u8=hints_of(qbuf,qtab,qi);
        let txt:[]u8=q_f(qbuf,qtab,qi,6);
        let qlow:[]u8=lower(txt);
        let qta:[]u8=tokenize(qlow);
        let gf:[]u8=q_f(qbuf,qtab,qi,7);
        let gtab:[]u8=split_comma(gf);
        let ng:i32=u32get(gtab,0) as i32;
        let K:i32=20;
        if(ng>K){K=ng;}
        let out:[]u8=nio_alloc(4+K*8+8);
        let prov:[]u8=nio_alloc(4+K*8+8);
        run_query(buf,tab,hayar,dfar,subar,subcnt,n,hm,sc,ab,ex,qbuf,har,qlow,qta,K,out,prov);
        let rh:[]u8=har;
        if(hm==1){rh=verify_hints(buf,tab,hayar,dfar,n,sc,qta,qlow,har,qbuf);}
        let mcnt:[]u8=nio_alloc(8);
        let cls:i32=classify(buf,tab,hayar,subar,subcnt,n,hm,har,rh,qbuf,gf,gtab,qta,qlow,K,out,prov,mcnt);
        if(cls==0){passes[4+qi]=1;}else{passes[4+qi]=0;tot=tot+1;}
        classes[4+qi]=cls as u8;
        qi=qi+1;
    }
    return tot;
}
fn class_counts(classes:[]u8,nq:i32,cc:[]u8)void {
    let c:i32=0;while(c<6){cc[4+c]=0;c=c+1;}
    let i:i32=0;
    while(i<nq){
        let cl:i32=classes[4+i] as i32;
        if(cl>=1 && cl<=5){cc[4+cl]=(cc[4+cl] as u8)+1;}
        i=i+1;
    }
}
fn log_counts(a:[]u8,cc:[]u8)void {
    let c:i32=1;
    while(c<=5){
        alog(a,cls_name(c));alog(a,"=");alog_i(a,cc[4+c] as i64);alog(a," ");
        c=c+1;
    }
}
// append up to maxn example qids with target class from one battery
fn examples(a:[]u8,qbuf:[]u8,qtab:[]u8,classes:[]u8,nq:i32,target:i32,maxn:i32,got:[]u8)void {
    let qi:i32=0;
    while(qi<nq){
        let have:i32=u32get(got,0) as i32;
        if(have>=maxn){return;}
        if((classes[4+qi] as i32)==target){
            if(have>0){alog(a,",");}
            alog(a,q_f(qbuf,qtab,qi,0));
            u32put(got,0,(have+1) as i64);
        }
        qi=qi+1;
    }
}
fn pick_move(tried:[]u8,hm:i32,sc:i32,cc:[]u8,tried_sc1_rej:i32)i32 {
    let mv:i32=0;
    while(mv<6){
        if(tried[mv]==0){
            let ok:i32=0;
            if(mv==0 && (cc[4+1] as i32)>0){ok=1;}
            if(mv==1 && (cc[4+2] as i32)>0){ok=1;}
            if(mv==2 && hm==1 && (cc[4+2] as i32)>0){ok=1;}
            if(mv==3 && (cc[4+3] as i32)>0){ok=1;}
            if(mv==4 && tried_sc1_rej==1 && (cc[4+3] as i32)>0){ok=1;}
            if(mv==5 && (cc[4+4] as i32)>0){ok=1;}
            if(ok==1){return mv;}
        }
        mv=mv+1;
    }
    return -1;
}
fn compose_hyp(a:[]u8,mv:i32,cc:[]u8,exbuf:[]u8)void {
    let tgt:i32=move_target(mv);
    let cnt:i32=cc[4+tgt] as i32;
    alog(a,"trying ");alog(a,move_name(mv));alog(a,"\n");
    alog(a,"hypothesis: ");
    if(mv==0){
        alog(a,"the ");alog_i(a,cnt);alog(a," F_ABSTAIN misses (");
        alog(a,exbuf);alog(a,") are probes whose gold set is empty: the scheme cannot say 'not found' and fills top-k with score-0 junk. ");
        alog(a,"ZERO returns empty when the best score is 0. ");
    }
    if(mv==1){
        alog(a,"the ");alog_i(a,cnt);alog(a," F_HINT_EXCLUDE misses (");
        alog(a,exbuf);alog(a,") are probes whose hints exclude gold items that carry text evidence. ");
        alog(a,"VERIFY drops a hint only when it contradicts ALL text evidence (max score under the hint is 0 while dropping it scores >0). ");
    }
    if(mv==2){
        alog(a,"the ");alog_i(a,cnt);alog(a," F_HINT_EXCLUDE misses (");
        alog(a,exbuf);alog(a,") remain after VERIFY: the contradicting hint survives verification because stopwords give it nonzero score. ");
        alog(a,"SOFT demotes hints to +10 bonuses so text evidence decides. ");
    }
    if(mv==3){
        alog(a,"the ");alog_i(a,cnt);alog(a," F_DILUTE misses (");
        alog(a,exbuf);alog(a,") are probes where high-df tokens (the/of/a) outrank distinctive tokens. ");
        alog(a,"IDF upweights rare tokens by 1+8*(N-df)/N. ");
    }
    if(mv==4){
        alog(a,"dilution remains under IDF (or IDF was rejected): distinct-token coverage ignores occurrence spam. ");
        alog(a,"COVER scores 1 per distinct matching token. ");
    }
    if(mv==5){
        alog(a,"the ");alog_i(a,cnt);alog(a," F_CLUSTER misses (");
        alog(a,exbuf);alog(a,") show partial subject-cluster signal: some members carry the text token, others share only the subject. ");
        alog(a,"CLUSTER completes a subject when >=half its members are provisionally retrieved and at least one scores >0. ");
    }
    alog(a,"prediction: the ");alog_i(a,cnt);alog(a," ");
    alog(a,cls_name(tgt));alog(a," misses go to 0 with no regressions elsewhere.\n");
}

// ---------------- main deliberation ----------------
fn run_deliberation(work:[]u8)i32 {
    let a:[]u8=alog_init();
    let ev:[]u8=f_read(path_join(work,"evidence.md"));
    let goal:[]u8="";
    let narms:i32=0;let nmiss:i32=0;let nwbox:i32=0;
    if(ev.len>0){
        let lar:[]u8=lines_of(ev);
        let nl:i32=line_n(lar);let li:i32=0;
        while(li<nl){
            let ln:[]u8=line_slice(ev,lar,li);
            if(starts_with(ln,"## arm")==1){narms=narms+1;}
            if(starts_with(ln,"GOAL:")==1){goal=ln[5..];}
            if(starts_with(ln,"WBOX/")==1){nwbox=nwbox+1;}
            if(contains(ln,"|missed=")==1){nmiss=nmiss+1;}
            li=li+1;
        }
    }
    let pbuf:[]u8=f_read(path_join(work,"probe_corpus.txt"));
    let pqbuf:[]u8=f_read(path_join(work,"probe_queries.txt"));
    let mbuf:[]u8=f_read(path_join(work,"morg_corpus.txt"));
    let mqbuf:[]u8=f_read(path_join(work,"morg_queries.txt"));
    if(pbuf.len==0 || pqbuf.len==0 || mbuf.len==0 || mqbuf.len==0){
        _zag_print("deliberate: missing battery files in workdir\n");
        return 1;
    }
    let ptab:[]u8=build_items(pbuf);let pn:i32=item_n(ptab);
    let phay:[]u8=build_hay(pbuf,ptab);let pdf:[]u8=build_df(phay);
    let psub:[]u8=build_subj(pbuf,ptab);let psubc:[]u8=subj_count_of(psub);
    let pqtab:[]u8=build_queries(pqbuf);let pqn:i32=q_n(pqtab);
    let mtab:[]u8=build_items(mbuf);let mn:i32=item_n(mtab);
    let mhay:[]u8=build_hay(mbuf,mtab);let mdf:[]u8=build_df(mhay);
    let msub:[]u8=build_subj(mbuf,mtab);let msubc:[]u8=subj_count_of(msub);
    let mqtab:[]u8=build_queries(mqbuf);let mqn:i32=q_n(mqtab);
    let seal:i32=1;
    if(f_exists(path_join(work,"corpus_holdout.txt"))==1){seal=0;}
    if(f_exists(path_join(work,"queries_holdout.txt"))==1){seal=0;}
    alog(a,"# WS2-C deliberation audit (TNN native deliberative control)\n");
    alog(a,"I have read the failure evidence: ");
    alog_i(a,nmiss);alog(a," per-query miss lines across ");
    alog_i(a,narms);alog(a," prior arms; ");
    alog_i(a,nwbox);alog(a," white-box fail records.\n");
    alog(a,"goal: ");alog(a,goal);alog(a,"\n");
    alog(a,"visible evidence: ");alog_i(a,pqn);alog(a," WS2-A probes over ");
    alog_i(a,pn);alog(a," items; ");alog_i(a,mqn);alog(a," MORG design queries over ");
    alog_i(a,mn);alog(a," items.\n");
    if(seal==1){
        alog(a,"seal check: PASS - no holdout files staged; H01-H12 unseen by me.\n");
    }else{
        alog(a,"seal check: FAIL - holdout present in workdir. Aborting.\n");
        f_mkdir(path_join(work,"out"));
        f_write(path_join(path_join(work,"out"),"audit.md"),audit_bytes(a));
        return 1;
    }
    let hm:i32=0;let sc:i32=0;let ab:i32=0;let ex:i32=0;
    let tried:[]u8=nio_alloc(16);
    let hist:[]u8=nio_alloc(64);u32put(hist,0,0);
    let ppp:[]u8=nio_alloc(4+pqn+8);let ppc:[]u8=nio_alloc(4+pqn+8);
    let mpp:[]u8=nio_alloc(4+mqn+8);let mpc:[]u8=nio_alloc(4+mqn+8);
    let cc:[]u8=nio_alloc(4+6+8);
    let round:i32=0;
    let done:i32=0;
    let tot:i32=0;let ptot:i32=0;let mtot:i32=0;
    while(done==0){
        round=round+1;
        ptot=eval_battery(pbuf,ptab,phay,pdf,psub,psubc,pn,hm,sc,ab,ex,pqbuf,pqtab,ppp,ppc);
        mtot=eval_battery(mbuf,mtab,mhay,mdf,msub,msubc,mn,hm,sc,ab,ex,mqbuf,mqtab,mpp,mpc);
        tot=ptot+mtot;
        let cc1:[]u8=nio_alloc(4+6+8);let cc2:[]u8=nio_alloc(4+6+8);
        class_counts(ppc,pqn,cc1);class_counts(mpc,mqn,cc2);
        let c:i32=0;while(c<6){cc[4+c]=((cc1[4+c] as i32)+(cc2[4+c] as i32)) as u8;c=c+1;}
        alog(a,"\n## round ");alog_i(a,round);alog(a," scheme=(");
        alog(a,scheme_str(hm,sc,ab,ex));alog(a,")\n");
        alog(a,"observation: misses=");alog_i(a,tot);
        alog(a," (probe=");alog_i(a,ptot);alog(a," morg=");alog_i(a,mtot);alog(a,") [");
        log_counts(a,cc);alog(a,"]\n");
        // P-AGE symmetry stat
        let pan:i32=0;let pam:i32=0;let pzn:i32=0;let pzm:i32=0;
        let qi:i32=0;
        while(qi<pqn){
            let qid:[]u8=q_f(pqbuf,pqtab,qi,0);
            if(starts_with(qid,"QPA")==1){pan=pan+1;if((ppc[4+qi] as i32)!=0){pam=pam+1;}}
            if(starts_with(qid,"QPZ")==1){pzn=pzn+1;if((ppc[4+qi] as i32)!=0){pzm=pzm+1;}}
            qi=qi+1;
        }
        alog(a,"P-AGE symmetry: aged misses ");alog_i(a,pam);alog(a,"/");
        alog_i(a,pan);alog(a,", recent misses ");alog_i(a,pzm);alog(a,"/");
        alog_i(a,pzn);
        if(pam==pzm){alog(a," - no install-order bias.\n");}
        else{alog(a," - BIAS DETECTED (no move in palette addresses this; recorded).\n");}
        if(tot==0){
            alog(a,"conclusion: every visible probe passes. Freezing scheme.\n");
            done=1;
        }else{
            let tsr:i32=0;
            if(tried[4]==1){tsr=1;}
            let mv:i32=pick_move(tried,hm,sc,cc,tsr);
            if(mv<0){
                alog(a,"conclusion: no improving move remains in the palette. Stopping with ");
                alog_i(a,tot);alog(a," misses; per-class diagnosis above.\n");
                done=1;
            }else{
                tried[mv]=1;
                let exb:[]u8=alog_init();
                let got:[]u8=nio_alloc(8);u32put(got,0,0);
                examples(exb,pqbuf,pqtab,ppc,pqn,move_target(mv),2,got);
                examples(exb,mqbuf,mqtab,mpc,mqn,move_target(mv),2,got);
                compose_hyp(a,mv,cc,audit_bytes(exb));
                let nhm:i32=hm;let nsc:i32=sc;let nab:i32=ab;let nex:i32=ex;
                if(mv==0){nab=1;}
                if(mv==1){nhm=1;}
                if(mv==2){nhm=2;}
                if(mv==3){nsc=1;}
                if(mv==4){nsc=2;}
                if(mv==5){nex=1;}
                let ppp2:[]u8=nio_alloc(4+pqn+8);let ppc2:[]u8=nio_alloc(4+pqn+8);
                let mpp2:[]u8=nio_alloc(4+mqn+8);let mpc2:[]u8=nio_alloc(4+mqn+8);
                let pt2:i32=eval_battery(pbuf,ptab,phay,pdf,psub,psubc,pn,nhm,nsc,nab,nex,pqbuf,pqtab,ppp2,ppc2);
                let mt2:i32=eval_battery(mbuf,mtab,mhay,mdf,msub,msubc,mn,nhm,nsc,nab,nex,mqbuf,mqtab,mpp2,mpc2);
                let tot2:i32=pt2+mt2;
                let rg:i32=0;
                let q2:i32=0;
                while(q2<pqn){
                    if(ppp[4+q2]==1 && ppp2[4+q2]==0){rg=rg+1;}
                    q2=q2+1;
                }
                q2=0;
                while(q2<mqn){
                    if(mpp[4+q2]==1 && mpp2[4+q2]==0){rg=rg+1;}
                    q2=q2+1;
                }
                let tgt:i32=move_target(mv);
                let cc3:[]u8=nio_alloc(4+6+8);let cc4:[]u8=nio_alloc(4+6+8);
                class_counts(ppc2,pqn,cc3);class_counts(mpc2,mqn,cc4);
                let tgt_after:i32=(cc3[4+tgt] as i32)+(cc4[4+tgt] as i32);
                alog(a,"trial result: misses ");alog_i(a,tot);alog(a," -> ");
                alog_i(a,tot2);alog(a,"; regressions=");alog_i(a,rg);alog(a,"; ");
                alog(a,cls_name(tgt));alog(a," after=");alog_i(a,tgt_after);alog(a,". ");
                if(tgt_after==0){alog(a,"prediction HELD. ");}
                else{alog(a,"prediction VIOLATED. ");}
                if(tot2<tot && rg==0){
                    alog(a,"decision: ADOPT ");alog(a,move_name(mv));alog(a,".\n");
                    hm=nhm;sc=nsc;ab=nab;ex=nex;
                    let hn:i32=u32get(hist,0) as i32;
                    u32put(hist,4+hn*4,mv as i64);
                    u32put(hist,0,(hn+1) as i64);
                    // adopt new passes for next round's regression baseline
                    ppp=ppp2;ppc=ppc2;mpp=mpp2;mpc=mpc2;
                }else{
                    alog(a,"decision: REJECT ");alog(a,move_name(mv));
                    if(tot2>=tot){alog(a," (no improvement)");}
                    if(rg>0){alog(a," (regressions)");}
                    alog(a,".\n");
                }
            }
        }
        if(round>=6 && done==0){
            alog(a,"round cap reached; stopping.\n");
            done=1;
        }
    }
    alog(a,"\n# final scheme\n");
    alog(a,"I chose: ");alog(a,scheme_str(hm,sc,ab,ex));alog(a,".\n");
    alog(a,"adopted moves: ");
    let hn2:i32=u32get(hist,0) as i32;let hhi:i32=0;
    while(hhi<hn2){
        if(hhi>0){alog(a," -> ");}
        alog(a,move_name(u32get(hist,4+hhi*4) as i32));
        hhi=hhi+1;
    }
    alog(a,"\nvisible misses remaining: ");alog_i(a,tot);alog(a,".\n");
    f_mkdir(path_join(work,"out"));
    f_write(path_join(path_join(work,"out"),"audit.md"),audit_bytes(a));
    // scheme.json
    let sj:[]u8="{\"hint\":\"";
    if(hm==0){sj=concat(sj,"STRICT");}else{if(hm==1){sj=concat(sj,"VERIFY");}else{sj=concat(sj,"SOFT");}}
    sj=concat(sj,"\",\"score\":\"");
    if(sc==0){sj=concat(sj,"COUNT");}else{if(sc==1){sj=concat(sj,"IDF");}else{sj=concat(sj,"COVER");}}
    sj=concat(sj,"\",\"abstain\":\"");
    if(ab==0){sj=concat(sj,"NEVER");}else{sj=concat(sj,"ZERO");}
    sj=concat(sj,"\",\"expand\":\"");
    if(ex==0){sj=concat(sj,"NONE");}else{sj=concat(sj,"CLUSTER");}
    sj=concat(sj,"\",\"rounds\":");
    sj=concat(sj,i64s(round as i64));
    sj=concat(sj,",\"visible_misses\":");
    sj=concat(sj,i64s(tot as i64));
    sj=concat(sj,"}\n");
    f_write(path_join(path_join(work,"out"),"scheme.json"),sj);
    // results.txt: per-probe detail
    let r:[]u8=alog_init();
    alog(r,"battery|qid|class|pass\n");
    let qi2:i32=0;
    while(qi2<pqn){
        alog(r,"probe|");alog(r,q_f(pqbuf,pqtab,qi2,0));alog(r,"|");
        alog(r,cls_name(ppc[4+qi2] as i32));alog(r,"|");
        alog_i(r,ppp[4+qi2] as i64);alog(r,"\n");
        qi2=qi2+1;
    }
    qi2=0;
    while(qi2<mqn){
        alog(r,"morg|");alog(r,q_f(mqbuf,mqtab,qi2,0));alog(r,"|");
        alog(r,cls_name(mpc[4+qi2] as i32));alog(r,"|");
        alog_i(r,mpp[4+qi2] as i64);alog(r,"\n");
        qi2=qi2+1;
    }
    f_write(path_join(path_join(work,"out"),"results.txt"),audit_bytes(r));
    // census.txt
    let cs:[]u8=alog_init();
    alog(cs,"probe items: ");alog_i(cs,pn as i64);alog(cs," vocab: ");
    alog_i(cs,u32get(pdf,0) as i64);alog(cs," subjects: ");
    alog_i(cs,u32get(psubc,0) as i64);alog(cs,"\n");
    alog(cs,"morg items: ");alog_i(cs,mn as i64);alog(cs," vocab: ");
    alog_i(cs,u32get(mdf,0) as i64);alog(cs," subjects: ");
    alog_i(cs,u32get(msubc,0) as i64);alog(cs,"\n");
    f_write(path_join(path_join(work,"out"),"census.txt"),audit_bytes(cs));
    _zag_print("deliberation complete: scheme=(");
    _zag_print(scheme_str(hm,sc,ab,ex));
    _zag_print(") rounds=");
    _zag_print(i64s(round as i64));
    _zag_print(" visible_misses=");
    _zag_print(i64s(tot as i64));
    _zag_print("\n");
    return 0;
}
// ---------------- bar: sealed holdout evaluation ----------------
fn json_val(buf:[]u8,key:[]u8)[]u8 {
    let pat:[]u8=concat(concat("\"",key),"\":\"");
    let i:i32=0;
    while(i+pat.len<=buf.len){
        let k:i32=0;let eq:i32=1;
        while(k<pat.len){if(buf[i+k]!=pat[k]){eq=0;}k=k+1;}
        if(eq==1){
            let s:i32=i+pat.len;let e:i32=s;
            while(e<buf.len && buf[e]!=34){e=e+1;}
            return buf[s..e];
        }
        i=i+1;
    }
    return "";
}
fn run_bar(sjpath:[]u8,cpath:[]u8,qpath:[]u8,outdir:[]u8)i32 {
    let sj:[]u8=f_read(sjpath);
    let hm:i32=0;let sc:i32=0;let ab:i32=0;let ex:i32=0;
    let hv:[]u8=json_val(sj,"hint");
    let sv:[]u8=json_val(sj,"score");
    let av:[]u8=json_val(sj,"abstain");
    let ev2:[]u8=json_val(sj,"expand");
    if(bytes_eq(hv,"VERIFY")==1){hm=1;}else{if(bytes_eq(hv,"SOFT")==1){hm=2;}}
    if(bytes_eq(sv,"IDF")==1){sc=1;}else{if(bytes_eq(sv,"COVER")==1){sc=2;}}
    if(bytes_eq(av,"ZERO")==1){ab=1;}
    if(bytes_eq(ev2,"CLUSTER")==1){ex=1;}
    let cbuf:[]u8=f_read(cpath);
    let qbuf:[]u8=f_read(qpath);
    if(cbuf.len==0 || qbuf.len==0){_zag_print("bar: missing corpus/queries\n");return 1;}
    let tab:[]u8=build_items(cbuf);let n:i32=item_n(tab);
    let hay:[]u8=build_hay(cbuf,tab);let df:[]u8=build_df(hay);
    let sub:[]u8=build_subj(cbuf,tab);let subc:[]u8=subj_count_of(sub);
    let qtab:[]u8=build_queries(qbuf);let nq:i32=q_n(qtab);
    f_mkdir(outdir);
    let r:[]u8=alog_init();
    let passes:[]u8=nio_alloc(4+nq+8);let classes:[]u8=nio_alloc(4+nq+8);
    let tot:i32=eval_battery(cbuf,tab,hay,df,sub,subc,n,hm,sc,ab,ex,qbuf,qtab,passes,classes);
    let qi:i32=0;
    while(qi<nq){
        let har:[]u8=hints_of(qbuf,qtab,qi);
        let txt:[]u8=q_f(qbuf,qtab,qi,6);
        let qlow:[]u8=lower(txt);
        let qta:[]u8=tokenize(qlow);
        let gf:[]u8=q_f(qbuf,qtab,qi,7);
        let gtab:[]u8=split_comma(gf);
        let ng:i32=u32get(gtab,0) as i32;
        let K:i32=20;if(ng>K){K=ng;}
        let out:[]u8=nio_alloc(4+K*8+8);
        let prov:[]u8=nio_alloc(4+K*8+8);
        let cnt:i32=run_query(cbuf,tab,hay,df,sub,subc,n,hm,sc,ab,ex,qbuf,har,qlow,qta,K,out,prov);
        alog(r,q_f(qbuf,qtab,qi,0));alog(r,"|");
        let w:i32=0;
        while(w<cnt){
            if(w>0){alog(r,",");}
            let o:i32=u32get(out,4+w*8) as i32;
            let l:i32=u32get(out,4+w*8+4) as i32;
            alog(r,cbuf[o..o+l]);
            w=w+1;
        }
        alog(r,"\n");
        qi=qi+1;
    }
    f_write(path_join(outdir,"retrieval.txt"),audit_bytes(r));
    let s:[]u8=alog_init();
    alog(s,"scheme=(");alog(s,scheme_str(hm,sc,ab,ex));alog(s,")\n");
    alog(s,"probes: ");alog_i(s,nq as i64);alog(s," misses: ");
    alog_i(s,tot as i64);alog(s," pass_rate: ");
    alog_i(s,(((nq-tot)*100)/nq) as i64);alog(s,"%\n");
    let q3:i32=0;
    while(q3<nq){
        alog(s,q_f(qbuf,qtab,q3,0));alog(s,": ");
        if((passes[4+q3] as i32)==1){alog(s,"PASS");}
        else{alog(s,"MISS(");alog(s,cls_name(classes[4+q3] as i32));alog(s,")");}
        alog(s,"\n");
        q3=q3+1;
    }
    f_write(path_join(outdir,"summary.txt"),audit_bytes(s));
    _zag_print("bar complete: misses=");
    _zag_print(i64s(tot as i64));
    _zag_print("/");
    _zag_print(i64s(nq as i64));
    _zag_print("\n");
    if(tot>0){return 3;}
    return 0;
}
fn main()i32 {
    let c1:[]u8=_zag_arg(1);
    if(_zag_strcmp(c1,"deliberate")==1){
        let w:[]u8=_zag_arg(2);
        if(w.len==0){_zag_print("usage: delib deliberate <workdir>\n");return 2;}
        return run_deliberation(w);
    }
    if(_zag_strcmp(c1,"bar")==1){
        let a2:[]u8=_zag_arg(2);let a3:[]u8=_zag_arg(3);
        let a4:[]u8=_zag_arg(4);let a5:[]u8=_zag_arg(5);
        if(a2.len==0 || a3.len==0 || a4.len==0 || a5.len==0){
            _zag_print("usage: delib bar <scheme.json> <corpus> <queries> <outdir>\n");
            return 2;
        }
        return run_bar(a2,a3,a4,a5);
    }
    _zag_print("usage: delib deliberate <workdir> | delib bar <scheme.json> <corpus> <queries> <outdir>\n");
    return 2;
}

// WS2-A instrumented retrieval probe driver.
// Reuses memory_org/arms/lib.zag retrieval primitives (build_tab, build_hay,
// is_candidate, tok_count, scheme_level, topk, parse_queries, gold_ids)
// and traces the exact path taken per query. Zero RNG. Deterministic.
//
// cmds:
//   probe trace  <storedir> <queries> <out> <kind>   # kind: 0=SELF 1=IMPOSED 2=FLAT
//   probe census <storedir> <out>                   # id|textlen|sha8hex per item
@import("lib.zag")

fn p_sname(kind:i32,s:i32)[]u8 {
    if(kind==2){return "FLAT";}
    if(kind==1){return "IMPOSED";}
    return scheme_name(s);
}
fn p_put(out:[]u8,at:i32,v:[]u8)i32 {
    let c:i32=0;while(c<v.len){out[at]=v[c];at=at+1;c=c+1;}return at;
}
fn p_sepc(out:[]u8,at:i32)[]u8 {
    out[at]=124;at=at+1;return out;
}
// score of item gi against tokenized query (same loop as topk)
fn p_score(hb:[]u8,gi:i32,qlow:[]u8,qtt:[]u8)i64 {
    let hay:[]u8=hay_of(hb,gi);
    let sc:i64=0;let t:i32=0;let nt:i32=u32get(qtt,0) as i32;
    while(t<nt){
        let to:i32=u32get(qtt,4+t*8) as i32;let tl:i32=u32get(qtt,4+t*8+4) as i32;
        sc=sc+(tok_count(hay,qlow[to..to+tl]) as i64);
        t=t+1;
    }
    return sc;
}
// per-level hint matches for item gi under scheme s; returns packed m0+10*m1+100*m2 (+1 shift)
fn p_lvl(buf:[]u8,tab:[]u8,gi:i32,s:i32,th:[]u8,dh:[]u8,sh:[]u8)[]u8 {
    let tf:[]u8=item_field(buf,tab,gi,2);
    let df:[]u8=item_field(buf,tab,gi,1);
    let sf:[]u8=item_field(buf,tab,gi,3);
    let nl:i32=scheme_nlevels(s);
    let o:[]u8=nio_alloc(16);
    let n2:i32=0;let l:i32=0;
    while(l<3){
        if(l<nl){
            let lv:i32=scheme_level(s,l);
            let f:[]u8=level_field(lv,tf,df,sf);
            let h:[]u8=level_hint(lv,th,dh,sh);
            let m:i32=0;
            if(h.len==0){m=1;}else{if(bytes_eq(f,h)==1){m=1;}}
            let d:i32=m+48;
            o[n2]=d as u8;n2=n2+1;
        }else{o[n2]=45;n2=n2+1;}
        if(l<2){o[n2]=44;n2=n2+1;}
        l=l+1;
    }
    return o[0..n2];
}
fn p_first_fail(buf:[]u8,tab:[]u8,gi:i32,s:i32,th:[]u8,dh:[]u8,sh:[]u8)i32 {
    let tf:[]u8=item_field(buf,tab,gi,2);
    let df:[]u8=item_field(buf,tab,gi,1);
    let sf:[]u8=item_field(buf,tab,gi,3);
    let nl:i32=scheme_nlevels(s);
    let l:i32=0;
    while(l<nl){
        let lv:i32=scheme_level(s,l);
        let f:[]u8=level_field(lv,tf,df,sf);
        let h:[]u8=level_hint(lv,th,dh,sh);
        if(h.len>0 && bytes_eq(f,h)==0){return l;}
        l=l+1;
    }
    return -1;
}
fn p_census(storedir:[]u8,outpath:[]u8)i32 {
    let buf:[]u8=f_read(path_join(storedir,"items.dat"));
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let out:[]u8=nio_alloc(n*80+16);
    let at:i32=0;let i:i32=0;
    while(i<n){
        let id:[]u8=item_field(buf,tab,i,0);
        let tx:[]u8=item_field(buf,tab,i,4);
        let dg:[]u8=nio_alloc(32);
        ns_sha256(tx,dg);
        let hx:[]u8=ns_hex(dg);
        at=p_put(out,at,id);out[at]=124;at=at+1;
        at=p_put(out,at,i64s(tx.len as i64));out[at]=124;at=at+1;
        at=p_put(out,at,hx[0..16]);out[at]=10;at=at+1;
        i=i+1;
    }
    if(f_write(outpath,out[0..at])<0){_zag_println("census: write failed");return 1;}
    _zag_print("census ");_zag_print(i64s(n as i64));_zag_println(" items");
    return 0;
}
fn p_trace(storedir:[]u8,qpath:[]u8,outpath:[]u8,kinds:[]u8)i32 {
    let kind:i32=(kinds[0] as i32)-48;
    let buf:[]u8=f_read(path_join(storedir,"items.dat"));
    let tab:[]u8=build_tab(buf);
    let n:i32=tab_n(tab);
    let hb:[]u8=build_hay(buf,tab);
    // scheme selection mirrors h_retrieve exactly
    let gc:i32=11;
    let dnames:[]u8=nio_alloc(4+128*8+8);u32put(dnames,0,0);
    let dch:[]u8=nio_alloc(129);
    let sb:[]u8="";
    if(kind==1){gc=10;}
    if(kind==0){
        let sp:[]u8=path_join(storedir,"scheme.txt");
        if(f_exists(sp)==0){_zag_println("trace: no scheme.txt (run choose first)");return 1;}
        sb=f_read(sp);
        let la:[]u8=lines_of(sb);
        let nl2:i32=line_n(la);let li:i32=0;
        let curdom:i32=-1;
        while(li<nl2){
            let ln:[]u8=line_slice(sb,la,li);
            let fa:[]u8=fields_of(ln,58,3);
            if(fld_n(fa)>=2 && bytes_eq(fld(fa,ln,0),"domain")==1){
                let nm:[]u8=fld(fa,ln,1);
                let noff:i32=u32get(fa,4+1*8) as i32;
                let base:i32=u32get(la,4+li*8) as i32;
                let oo:i32=base+noff;let ll:i32=nm.len;
                if(ll>0 && sb[oo]==32){oo=oo+1;ll=ll-1;}
                let cnd:i32=u32get(dnames,0) as i32;
                u32put(dnames,4+cnd*8,oo as i64);
                u32put(dnames,4+cnd*8+4,ll as i64);
                u32put(dnames,0,(cnd+1) as i64);
                curdom=cnd;
            }
            if(fld_n(fa)>=2 && bytes_eq(fld(fa,ln,0),"chosen")==1){
                let cv:[]u8=fld(fa,ln,1);
                if(cv.len>0 && cv[0]==32){cv=cv[1..cv.len];}
                let si2:i32=scheme_idx_of(cv);
                if(curdom>=0){dch[curdom]=si2 as u8;}
                else{gc=si2;}
            }
            li=li+1;
        }
    }
    let qb:[]u8=f_read(qpath);
    let qt:[]u8=parse_queries(qb);
    let nq:i32=u32get(qt,0) as i32;
    let out:[]u8=nio_alloc(nq*300+64);
    let at:i32=0;let q:i32=0;
    let inconsistencies:i32=0;
    while(q<nq){
        let qid:[]u8=qfield(qb,qt,q,0);
        let th:[]u8=qfield(qb,qt,q,3);let dh:[]u8=qfield(qb,qt,q,4);let sh:[]u8=qfield(qb,qt,q,5);
        let tx:[]u8=qfield(qb,qt,q,6);
        let gold:[]u8=qfield(qb,qt,q,7);
        let s:i32=gc;
        if(kind==0 && dh.len>0){
            let cnd:i32=u32get(dnames,0) as i32;let d2:i32=0;
            while(d2<cnd){
                let oo:i32=u32get(dnames,4+d2*8) as i32;let ll:i32=u32get(dnames,4+d2*8+4) as i32;
                if(bytes_eq(dh,sb[oo..oo+ll])==1){s=dch[d2] as i32;}
                d2=d2+1;
            }
        }
        let qlow:[]u8=lower(tx);
        let qtt:[]u8=tokenize(qlow);
        let rk:[]u8=topk(buf,tab,hb,s,th,dh,sh,qlow,qtt,20);
        let r:i32=u32get(rk,0) as i32;
        let top1:[]u8="-";
        if(r>0){
            let ro0:i32=u32get(rk,4+0*8) as i32;let rl0:i32=u32get(rk,4+0*8+4) as i32;
            top1=buf[ro0..ro0+rl0];
        }
        at=p_put(out,at,qid);out[at]=124;at=at+1;
        at=p_put(out,at,i64s(kind as i64));out[at]=124;at=at+1;
        at=p_put(out,at,p_sname(kind,s));out[at]=124;at=at+1;
        if(gold.len==0){
            // negative probe
            at=p_put(out,at,"1");out[at]=124;at=at+1;
            at=p_put(out,at,"-");out[at]=124;at=at+1;
            at=p_put(out,at,"-,-,-");out[at]=124;at=at+1;
            at=p_put(out,at,"-");out[at]=124;at=at+1;
            at=p_put(out,at,"-");out[at]=124;at=at+1;
            at=p_put(out,at,top1);out[at]=124;at=at+1;
            at=p_put(out,at,i64s(r as i64));out[at]=124;at=at+1;
            if(r==0){at=p_put(out,at,"CORRECT_ABSTAIN");}
            else{at=p_put(out,at,"FALSE_POSITIVE");}
            out[at]=124;at=at+1;
            if(r==0){at=p_put(out,at,"NONE");}
            else{at=p_put(out,at,"FALSE_POSITIVE");}
            out[at]=10;at=at+1;
        }else{
            let gi:i32=item_find(buf,tab,gold);
            if(gi<0){
                at=p_put(out,at,"0");out[at]=124;at=at+1;
                at=p_put(out,at,"-");out[at]=124;at=at+1;
                at=p_put(out,at,"-,-,-");out[at]=124;at=at+1;
                at=p_put(out,at,"-");out[at]=124;at=at+1;
                at=p_put(out,at,"-");out[at]=124;at=at+1;
                at=p_put(out,at,top1);out[at]=124;at=at+1;
                at=p_put(out,at,i64s(r as i64));out[at]=124;at=at+1;
                at=p_put(out,at,"NOT_INSTALLED");out[at]=124;at=at+1;
                at=p_put(out,at,"NOT_INSTALLED");
                out[at]=10;at=at+1;
            }else{
                let tf:[]u8=item_field(buf,tab,gi,2);
                let df:[]u8=item_field(buf,tab,gi,1);
                let sf:[]u8=item_field(buf,tab,gi,3);
                let cand:i32=is_candidate(s,tf,df,sf,th,dh,sh);
                let sc:i64=p_score(hb,gi,qlow,qtt);
                // self-consistency: recompute via the same predicates
                let cand2:i32=is_candidate(s,tf,df,sf,th,dh,sh);
                let sc2:i64=p_score(hb,gi,qlow,qtt);
                if(cand!=cand2 || sc!=sc2){inconsistencies=inconsistencies+1;}
                let rank:i32=-1;let ri:i32=0;
                while(ri<r){
                    let ro:i32=u32get(rk,4+ri*8) as i32;let rl:i32=u32get(rk,4+ri*8+4) as i32;
                    if(bytes_eq(buf[ro..ro+rl],gold)==1){rank=ri;}
                    ri=ri+1;
                }
                let outcome:[]u8="FOUND";let fail:[]u8="NONE";
                if(cand==0){
                    outcome="NOT_RETRIEVABLE";
                    if(kind==0 && dh.len>0 && bytes_eq(df,dh)==0){fail="SCHEME_MISMATCH";}
                    else{
                        let fl2:i32=p_first_fail(buf,tab,gi,s,th,dh,sh);
                        fail=concat("PARTITION_GATE_L",i64s(fl2 as i64));
                    }
                }else{
                    if(sc==0){outcome="NOT_RETRIEVABLE";fail="TOKEN_MISS";}
                    else{
                        if(rank<0){outcome="NOT_RETRIEVABLE";fail="RANK_PAST_K";}
                    }
                }
                at=p_put(out,at,"1");out[at]=124;at=at+1;
                at=p_put(out,at,i64s(cand as i64));out[at]=124;at=at+1;
                at=p_put(out,at,p_lvl(buf,tab,gi,s,th,dh,sh));out[at]=124;at=at+1;
                at=p_put(out,at,i64s(sc));out[at]=124;at=at+1;
                at=p_put(out,at,i64s(rank as i64));out[at]=124;at=at+1;
                at=p_put(out,at,top1);out[at]=124;at=at+1;
                at=p_put(out,at,i64s(r as i64));out[at]=124;at=at+1;
                at=p_put(out,at,outcome);out[at]=124;at=at+1;
                at=p_put(out,at,fail);
                out[at]=10;at=at+1;
            }
        }
        q=q+1;
    }
    if(f_write(outpath,out[0..at])<0){_zag_println("trace: write failed");return 1;}
    _zag_print("traced ");_zag_print(i64s(nq as i64));
    _zag_print(" queries, inconsistencies=");_zag_println(i64s(inconsistencies as i64));
    return 0;
}
fn main()i32 {
    let cmd:[]u8=_zag_arg(1);
    if(_zag_strcmp(cmd,"trace")==1){return p_trace(_zag_arg(2),_zag_arg(3),_zag_arg(4),_zag_arg(5));}
    if(_zag_strcmp(cmd,"census")==1){return p_census(_zag_arg(2),_zag_arg(3));}
    _zag_println("usage: probe trace <storedir> <queries> <out> <kind> | probe census <storedir> <out>");
    return 1;
}

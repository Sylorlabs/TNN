// mw_after.zag — WS3-C port of the frozen mixed-web deliberation sense.
// GENERATED by src/gen_mw_port.py — do not hand-edit.
// Source: tnn-lab/mixed-web/src/mw_sense.zag (frozen).
// Port (PREREG_WS3C.md §7, report only): the WS3-A retune principle
// ("popularity never settles") applied to the sibling:
//   1. MAJORITY rule retired: a would-be majority now WITHHOLDS with rule
//      tag MAJORITY_RETIRED instead of CONVERGEing.
//   2. CORROB rule held: near-unanimity is still popularity; mw has no
//      PROVISIONAL verdict, so the principled port WITHHOLDS with rule tag
//      CORROB_HELD (this is the port's cost, flagged for Micah).
// RECENCY / TIE / INSUFFICIENT are untouched.

// mw_sense.zag — mixed-web deliberation sense (pure Zag, zero RNG, no timestamps).
// Conflict-driven deliberation with logic rules over live web evidence.
// Frozen rules (PREREG §4), first rule that fires decides:
//   RECENCY  (temporal only): newest candidate, rec>=2000, >=2 domains, gap>=3yr
//            -> CONVERGE unless stale-majority (best>=2x newest) -> WITHHOLD(STALE_CONFLICT)
//   MAJORITY: best>=3 domains and >=2x runner-up -> CONVERGE
//   CORROB:   best>=2 domains, total distinct domains<=4, runner-up<=1 -> CONVERGE
//   else WITHHOLD (TIE if runner-up>=1 else INSUFFICIENT)
// Every verdict ledgered with the full reasoning chain (op 'D'):
//   all candidates + per-candidate distinct-domain counts + recencies,
//   fired rule code, chosen answer, up to 3 supporting domains.
// Ledger ops: 'B'=66 fact begin, 'R'=82 result, 'D'=68 deliberation, 'F'=70 fact end.
// State is an explicit *MwF handle (no module globals; znc has no top-level var).

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")

struct MwL {
    prev:[]u8,
    seq:i64
}

struct MwR {
    d0:[]u8,d1:[]u8,d2:[]u8,d3:[]u8,d4:[]u8,d5:[]u8,d6:[]u8,d7:[]u8,d8:[]u8,d9:[]u8,
    a0:[]u8,a1:[]u8,a2:[]u8,a3:[]u8,a4:[]u8,a5:[]u8,a6:[]u8,a7:[]u8,a8:[]u8,a9:[]u8,
    r0:i32,r1:i32,r2:i32,r3:i32,r4:i32,r5:i32,r6:i32,r7:i32,r8:i32,r9:i32,
    v0:i32,v1:i32,v2:i32,v3:i32,v4:i32,v5:i32,v6:i32,v7:i32,v8:i32,v9:i32
}

struct MwC {
    a0:[]u8,a1:[]u8,a2:[]u8,a3:[]u8,a4:[]u8,a5:[]u8,a6:[]u8,a7:[]u8,
    n0:i32,n1:i32,n2:i32,n3:i32,n4:i32,n5:i32,n6:i32,n7:i32,
    r0:i32,r1:i32,r2:i32,r3:i32,r4:i32,r5:i32,r6:i32,r7:i32
}

struct MwF {
    temporal:i32,nres:i32,ncand:i32,verdict:i32,
    qid:[]u8,question:[]u8,rule:[]u8,chosen:[]u8,
    rs:*MwR,cs:*MwC,lg:*MwL
}

// ---------- small utils ----------

fn mw_alloc(n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    return b;
}

fn mw_empty()[]u8 {
    let e:[]u8=mw_alloc(1);
    return e[0..0];
}

fn mw_copy(dst:[]u8,doff:i32,src:[]u8)void {
    let i:i32=0;
    while(i<src.len){dst[doff+i]=src[i];i=i+1;}
    return;
}

fn mw_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

fn mw_hex(raw:[]u8)[]u8 {
    let out:[]u8=mw_alloc(raw.len*2);
    let i:i32=0;
    while(i<raw.len){
        let v:i32=raw[i] as i32;
        let d0:i32=(v>>4)&15;
        let d1:i32=v&15;
        if(d0<10){out[i*2]=(48+d0) as u8;}else{out[i*2]=(87+d0) as u8;}
        if(d1<10){out[i*2+1]=(48+d1) as u8;}else{out[i*2+1]=(87+d1) as u8;}
        i=i+1;
    }
    return out;
}

fn mw_sha256(data:[]u8)[]u8 {
    let out:[]u8=mw_alloc(32);
    let rc:i32=ns_sha256(data,out);
    if(rc!=0){_zag_println("FATAL sha256");}
    return out;
}

// ---------- state ----------

fn mw_new() *MwF {
    let lg:*MwL=_zag_malloc(64) as *MwL;
    let pv:[]u8=mw_alloc(32);
    let zi:i32=0;
    while(zi<32){pv[zi]=0;zi=zi+1;}
    lg.*.prev=pv;
    lg.*.seq=0;
    let rs:*MwR=_zag_malloc(1024) as *MwR;
    rs.*.d0=mw_empty();rs.*.d1=mw_empty();rs.*.d2=mw_empty();rs.*.d3=mw_empty();rs.*.d4=mw_empty();
    rs.*.d5=mw_empty();rs.*.d6=mw_empty();rs.*.d7=mw_empty();rs.*.d8=mw_empty();rs.*.d9=mw_empty();
    rs.*.a0=mw_empty();rs.*.a1=mw_empty();rs.*.a2=mw_empty();rs.*.a3=mw_empty();rs.*.a4=mw_empty();
    rs.*.a5=mw_empty();rs.*.a6=mw_empty();rs.*.a7=mw_empty();rs.*.a8=mw_empty();rs.*.a9=mw_empty();
    rs.*.r0=0;rs.*.r1=0;rs.*.r2=0;rs.*.r3=0;rs.*.r4=0;
    rs.*.r5=0;rs.*.r6=0;rs.*.r7=0;rs.*.r8=0;rs.*.r9=0;
    rs.*.v0=0;rs.*.v1=0;rs.*.v2=0;rs.*.v3=0;rs.*.v4=0;
    rs.*.v5=0;rs.*.v6=0;rs.*.v7=0;rs.*.v8=0;rs.*.v9=0;
    let cs:*MwC=_zag_malloc(512) as *MwC;
    cs.*.a0=mw_empty();cs.*.a1=mw_empty();cs.*.a2=mw_empty();cs.*.a3=mw_empty();
    cs.*.a4=mw_empty();cs.*.a5=mw_empty();cs.*.a6=mw_empty();cs.*.a7=mw_empty();
    cs.*.n0=0;cs.*.n1=0;cs.*.n2=0;cs.*.n3=0;cs.*.n4=0;cs.*.n5=0;cs.*.n6=0;cs.*.n7=0;
    cs.*.r0=0;cs.*.r1=0;cs.*.r2=0;cs.*.r3=0;cs.*.r4=0;cs.*.r5=0;cs.*.r6=0;cs.*.r7=0;
    let w:*MwF=_zag_malloc(256) as *MwF;
    w.*.temporal=0;w.*.nres=0;w.*.ncand=0;w.*.verdict=0;
    w.*.qid=mw_empty();w.*.question=mw_empty();
    w.*.rule=mw_empty();w.*.chosen=mw_empty();
    w.*.rs=rs;w.*.cs=cs;w.*.lg=lg;
    return w;
}

// result accessors
fn mw_r_dom(w:*MwF,i:i32)[]u8 {
    let rs:*MwR=w.*.rs;
    if(i==0){return rs.*.d0;}
    if(i==1){return rs.*.d1;}
    if(i==2){return rs.*.d2;}
    if(i==3){return rs.*.d3;}
    if(i==4){return rs.*.d4;}
    if(i==5){return rs.*.d5;}
    if(i==6){return rs.*.d6;}
    if(i==7){return rs.*.d7;}
    if(i==8){return rs.*.d8;}
    return rs.*.d9;
}

fn mw_r_ans(w:*MwF,i:i32)[]u8 {
    let rs:*MwR=w.*.rs;
    if(i==0){return rs.*.a0;}
    if(i==1){return rs.*.a1;}
    if(i==2){return rs.*.a2;}
    if(i==3){return rs.*.a3;}
    if(i==4){return rs.*.a4;}
    if(i==5){return rs.*.a5;}
    if(i==6){return rs.*.a6;}
    if(i==7){return rs.*.a7;}
    if(i==8){return rs.*.a8;}
    return rs.*.a9;
}

fn mw_r_rec(w:*MwF,i:i32)i32 {
    let rs:*MwR=w.*.rs;
    if(i==0){return rs.*.r0;}
    if(i==1){return rs.*.r1;}
    if(i==2){return rs.*.r2;}
    if(i==3){return rs.*.r3;}
    if(i==4){return rs.*.r4;}
    if(i==5){return rs.*.r5;}
    if(i==6){return rs.*.r6;}
    if(i==7){return rs.*.r7;}
    if(i==8){return rs.*.r8;}
    return rs.*.r9;
}

fn mw_r_rel(w:*MwF,i:i32)i32 {
    let rs:*MwR=w.*.rs;
    if(i==0){return rs.*.v0;}
    if(i==1){return rs.*.v1;}
    if(i==2){return rs.*.v2;}
    if(i==3){return rs.*.v3;}
    if(i==4){return rs.*.v4;}
    if(i==5){return rs.*.v5;}
    if(i==6){return rs.*.v6;}
    if(i==7){return rs.*.v7;}
    if(i==8){return rs.*.v8;}
    return rs.*.v9;
}

fn mw_r_set(w:*MwF,i:i32,d:[]u8,a:[]u8,r:i32,v:i32)void {
    let rs:*MwR=w.*.rs;
    if(i==0){rs.*.d0=d;rs.*.a0=a;rs.*.r0=r;rs.*.v0=v;return;}
    if(i==1){rs.*.d1=d;rs.*.a1=a;rs.*.r1=r;rs.*.v1=v;return;}
    if(i==2){rs.*.d2=d;rs.*.a2=a;rs.*.r2=r;rs.*.v2=v;return;}
    if(i==3){rs.*.d3=d;rs.*.a3=a;rs.*.r3=r;rs.*.v3=v;return;}
    if(i==4){rs.*.d4=d;rs.*.a4=a;rs.*.r4=r;rs.*.v4=v;return;}
    if(i==5){rs.*.d5=d;rs.*.a5=a;rs.*.r5=r;rs.*.v5=v;return;}
    if(i==6){rs.*.d6=d;rs.*.a6=a;rs.*.r6=r;rs.*.v6=v;return;}
    if(i==7){rs.*.d7=d;rs.*.a7=a;rs.*.r7=r;rs.*.v7=v;return;}
    if(i==8){rs.*.d8=d;rs.*.a8=a;rs.*.r8=r;rs.*.v8=v;return;}
    rs.*.d9=d;rs.*.a9=a;rs.*.r9=r;rs.*.v9=v;
    return;
}

// candidate accessors
fn mw_c_ans(w:*MwF,i:i32)[]u8 {
    let cs:*MwC=w.*.cs;
    if(i==0){return cs.*.a0;}
    if(i==1){return cs.*.a1;}
    if(i==2){return cs.*.a2;}
    if(i==3){return cs.*.a3;}
    if(i==4){return cs.*.a4;}
    if(i==5){return cs.*.a5;}
    if(i==6){return cs.*.a6;}
    return cs.*.a7;
}

fn mw_c_n(w:*MwF,i:i32)i32 {
    let cs:*MwC=w.*.cs;
    if(i==0){return cs.*.n0;}
    if(i==1){return cs.*.n1;}
    if(i==2){return cs.*.n2;}
    if(i==3){return cs.*.n3;}
    if(i==4){return cs.*.n4;}
    if(i==5){return cs.*.n5;}
    if(i==6){return cs.*.n6;}
    return cs.*.n7;
}

fn mw_c_r(w:*MwF,i:i32)i32 {
    let cs:*MwC=w.*.cs;
    if(i==0){return cs.*.r0;}
    if(i==1){return cs.*.r1;}
    if(i==2){return cs.*.r2;}
    if(i==3){return cs.*.r3;}
    if(i==4){return cs.*.r4;}
    if(i==5){return cs.*.r5;}
    if(i==6){return cs.*.r6;}
    return cs.*.r7;
}

fn mw_c_set(w:*MwF,i:i32,a:[]u8,n:i32,r:i32)void {
    let cs:*MwC=w.*.cs;
    if(i==0){cs.*.a0=a;cs.*.n0=n;cs.*.r0=r;return;}
    if(i==1){cs.*.a1=a;cs.*.n1=n;cs.*.r1=r;return;}
    if(i==2){cs.*.a2=a;cs.*.n2=n;cs.*.r2=r;return;}
    if(i==3){cs.*.a3=a;cs.*.n3=n;cs.*.r3=r;return;}
    if(i==4){cs.*.a4=a;cs.*.n4=n;cs.*.r4=r;return;}
    if(i==5){cs.*.a5=a;cs.*.n5=n;cs.*.r5=r;return;}
    if(i==6){cs.*.a6=a;cs.*.n6=n;cs.*.r6=r;return;}
    cs.*.a7=a;cs.*.n7=n;cs.*.r7=r;
    return;
}

// ---------- ledger ----------

fn mw_ledger(w:*MwF,op:u8,f1:[]u8,f2:[]u8,f3:[]u8,f4:[]u8)void {
    let lg:*MwL=w.*.lg;
    let n:i32=32+8+1+1+f1.len+1+f2.len+1+f3.len+1+f4.len;
    let e:[]u8=mw_alloc(n);
    let o:i32=0;
    let pv:[]u8=lg.*.prev;
    mw_copy(e,o,pv);o=o+32;
    let s:i64=lg.*.seq;
    let k:i32=0;
    while(k<8){
        let sh:i64=s>>(k*8);
        let b2:i64=sh&255;
        e[o+k]=b2 as u8;
        k=k+1;
    }
    o=o+8;
    e[o]=op;o=o+1;e[o]=0;o=o+1;
    mw_copy(e,o,f1);o=o+f1.len;e[o]=0;o=o+1;
    mw_copy(e,o,f2);o=o+f2.len;e[o]=0;o=o+1;
    mw_copy(e,o,f3);o=o+f3.len;e[o]=0;o=o+1;
    mw_copy(e,o,f4);o=o+f4.len;
    let nh:[]u8=mw_sha256(e);
    let j:i32=0;
    while(j<32){pv[j]=nh[j];j=j+1;}
    lg.*.seq=s+1;
    return;
}

fn mw_head(w:*MwF)[]u8 {
    let lg:*MwL=w.*.lg;
    return mw_hex(lg.*.prev);
}

// ---------- fact lifecycle ----------

fn mw_fact_begin(w:*MwF,qid:[]u8,question:[]u8,temporal:i32)void {
    w.*.qid=qid;w.*.question=question;w.*.temporal=temporal;
    w.*.nres=0;w.*.ncand=0;w.*.verdict=0;
    w.*.rule=mw_empty();w.*.chosen=mw_empty();
    mw_ledger(w,66,qid,question,qid,qid);
    return;
}

fn mw_add_result(w:*MwF,domain:[]u8,answer:[]u8,recency:i32)void {
    let fid:[]u8=w.*.qid;
    let rs:[]u8=mw_alloc(12);
    let t:i32=0;
    let rv:i32=recency;
    while(rv>0){
        rs[11-t]=(rv%10+48) as u8;
        rv=rv/10;
        t=t+1;
    }
    let rstr:[]u8=rs[12-t..12];
    if(t==0){rstr=mw_empty();}
    mw_ledger(w,82,fid,domain,answer,rstr);
    // dedup on (domain, answer); cap 10
    let n:i32=w.*.nres;
    let i:i32=0;
    while(i<n){
        if(mw_equal(mw_r_dom(w,i),domain)==1){
            if(mw_equal(mw_r_ans(w,i),answer)==1){return;}
        }
        i=i+1;
    }
    if(n<10){mw_r_set(w,n,domain,answer,recency,1);w.*.nres=n+1;}
    return;
}

// ---------- deliberation (frozen PREREG §4) ----------
// verdict: 1 CONVERGE, 2 WITHHOLD. Sets rule + chosen; ledgered op 'D'.

fn mw_build_cands(w:*MwF)void {
    // pass 1: distinct answers in first-seen order
    let n:i32=w.*.nres;
    let nc:i32=0;
    let i:i32=0;
    while(i<n){
        let a:[]u8=mw_r_ans(w,i);
        let seen:i32=0;
        let j:i32=0;
        while(j<nc){
            if(mw_equal(mw_c_ans(w,j),a)==1){seen=1;}
            j=j+1;
        }
        if(seen==0){
            if(nc<8){mw_c_set(w,nc,a,0,0);nc=nc+1;}
        }
        i=i+1;
    }
    // pass 2: distinct-domain count + max recency per candidate
    let c:i32=0;
    while(c<nc){
        let ca:[]u8=mw_c_ans(w,c);
        let dcnt:i32=0;
        let rmax:i32=0;
        let k:i32=0;
        while(k<n){
            if(mw_equal(mw_r_ans(w,k),ca)==1){
                let d:[]u8=mw_r_dom(w,k);
                let r2:i32=mw_r_rec(w,k);
                if(r2>rmax){rmax=r2;}
                let ds:i32=0;
                let m:i32=0;
                while(m<k){
                    if(mw_equal(mw_r_ans(w,m),ca)==1){
                        if(mw_equal(mw_r_dom(w,m),d)==1){ds=1;}
                    }
                    m=m+1;
                }
                if(ds==0){dcnt=dcnt+1;}
            }
            k=k+1;
        }
        mw_c_set(w,c,ca,dcnt,rmax);
        c=c+1;
    }
    w.*.ncand=nc;
    return;
}

fn mw_chain(w:*MwF)[]u8 {
    // "ans,count,rec|ans,count,rec" in first-seen order
    let nc:i32=w.*.ncand;
    let out:[]u8=mw_alloc(2048);
    let o:i32=0;
    let c:i32=0;
    while(c<nc){
        if(c>0){out[o]=124;o=o+1;}
        let a:[]u8=mw_c_ans(w,c);
        mw_copy(out,o,a);o=o+a.len;
        out[o]=44;o=o+1;
        let ns:[]u8=_zag_i64_to_str(mw_c_n(w,c) as i64);
        mw_copy(out,o,ns);o=o+ns.len;
        out[o]=44;o=o+1;
        let rss:[]u8=_zag_i64_to_str(mw_c_r(w,c) as i64);
        mw_copy(out,o,rss);o=o+rss.len;
        c=c+1;
    }
    return out[0..o];
}

fn mw_supp(w:*MwF,answer:[]u8)[]u8 {
    // up to 3 distinct domains supporting the answer, comma-joined
    let out:[]u8=mw_alloc(512);
    let o:i32=0;
    let got:i32=0;
    let n:i32=w.*.nres;
    let i:i32=0;
    while(i<n){
        if(mw_equal(mw_r_ans(w,i),answer)==1){
            let d:[]u8=mw_r_dom(w,i);
            let seen:i32=0;
            let m:i32=0;
            while(m<i){
                if(mw_equal(mw_r_ans(w,m),answer)==1){
                    if(mw_equal(mw_r_dom(w,m),d)==1){seen=1;}
                }
                m=m+1;
            }
            if(seen==0){
                if(got>0){out[o]=44;o=o+1;}
                mw_copy(out,o,d);o=o+d.len;
                got=got+1;
                if(got>=3){i=n;}
            }
        }
        i=i+1;
    }
    return out[0..o];
}

fn mw_deliberate(w:*MwF)i32 {
    mw_build_cands(w);
    let nc:i32=w.*.ncand;
    if(nc==0){
        w.*.rule="INSUFFICIENT";
        w.*.chosen=mw_empty();
        w.*.verdict=2;
        mw_ledger(w,68,w.*.rule,w.*.chosen,mw_chain(w),mw_empty());
        return 2;
    }
    // best = first-seen strict max count; rc = max among rest
    let best:i32=0;
    let bc:i32=mw_c_n(w,0);
    let rc:i32=0;
    let c:i32=1;
    while(c<nc){
        let n2:i32=mw_c_n(w,c);
        if(n2>bc){rc=bc;bc=n2;best=c;}
        if(n2>rc){
            if(c!=best){rc=n2;}
        }
        c=c+1;
    }
    // total distinct relevant domains
    let tot:i32=0;
    let n:i32=w.*.nres;
    let k:i32=0;
    while(k<n){
        let d:[]u8=mw_r_dom(w,k);
        let seen:i32=0;
        let m:i32=0;
        while(m<k){
            if(mw_equal(mw_r_dom(w,m),d)==1){seen=1;}
            m=m+1;
        }
        if(seen==0){tot=tot+1;}
        k=k+1;
    }
    let rule:[]u8=mw_empty();
    let chosen:[]u8=mw_empty();
    let conv:i32=0;
    // 1. RECENCY (temporal only)
    if(w.*.temporal==1){
        let newest:i32=0;
        let nr:i32=mw_c_r(w,0);
        let sr:i32=0;
        let c2:i32=1;
        while(c2<nc){
            let r2:i32=mw_c_r(w,c2);
            if(r2>nr){sr=nr;nr=r2;newest=c2;}
            if(r2>sr){
                if(c2!=newest){sr=r2;}
            }
            c2=c2+1;
        }
        let nn:i32=mw_c_n(w,newest);
        if(nr>=2000){
            if(nn>=2){
                if(nr-sr>=3){
                    let na:[]u8=mw_c_ans(w,newest);
                    let ba:[]u8=mw_c_ans(w,best);
                    if(mw_equal(na,ba)==1){
                        rule="RECENCY";chosen=na;conv=1;
                    }else{
                        if(bc>=2*nn){
                            rule="STALE_CONFLICT";chosen=mw_empty();conv=0;
                        }else{
                            rule="RECENCY";chosen=na;conv=1;
                        }
                    }
                }
            }
        }
    }
    // 2. MAJORITY
    if(rule.len==0){
        if(bc>=3){
            if(bc>=2*rc){
                rule="MAJORITY_RETIRED";chosen=mw_empty();conv=0;
            }
        }
    }
    // 3. CORROB
    if(rule.len==0){
        if(bc>=2){
            if(tot<=4){
                if(rc<=1){
                    rule="CORROB_HELD";chosen=mw_empty();conv=0;
                }
            }
        }
    }
    // 4. WITHHOLD
    if(rule.len==0){
        if(rc>=1){rule="TIE";}else{rule="INSUFFICIENT";}
        chosen=mw_empty();conv=0;
    }
    w.*.rule=rule;
    w.*.chosen=chosen;
    if(conv==1){w.*.verdict=1;}else{w.*.verdict=2;}
    let supp:[]u8=mw_supp(w,chosen);
    let chain:[]u8=mw_chain(w);
    mw_ledger(w,68,rule,chosen,chain,supp);
    return w.*.verdict;
}

fn mw_fact_end(w:*MwF)void {
    mw_ledger(w,70,w.*.qid,w.*.rule,w.*.chosen,w.*.qid);
    return;
}

// learn.zag — ARM L learning mechanism (PREREG_WS2L.md §2, MECHANISM.md).
// Pure Zag. Deterministic. Zero RNG.
// Commands:
//   learn dump <dir>    — write <dir>/learn_dump.txt (full store listing)
//   learn ingest <corpus> <dir> — learn from corpus, merge into dir store
// Store files in <dir>: synlearn.txt (w1|w2|rules|lids), synveto.txt,
// learn.log (run summary).
@import("lib.zag")

// ---------- helpers copied from frozen toc_b2.zag (byte-identical) ----------
fn contains(h:[]u8,nd:[]u8)i32 {
    if(nd.len==0 || nd.len>h.len){return 0;}
    let i:i32=0;
    while(i+nd.len<=h.len){
        let k:i32=0;let eq:i32=1;
        while(k<nd.len){if(h[i+k]!=nd[k]){eq=0;}k=k+1;}
        if(eq==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn fa_f(fa:[]u8,ln:[]u8,fi:i32)[]u8 {
    let o:i32=u32get(fa,4+fi*8) as i32;let l:i32=u32get(fa,4+fi*8+4) as i32;
    return ln[o..o+l];
}
// frozen WS2-B stemmer (byte-identical semantics)
fn stem(t:[]u8)[]u8 {
    let n:i32=t.len;
    if(n>4 && t[n-3]==105 && t[n-2]==110 && t[n-1]==103 && n-3>=3){return t[0..n-3];}
    if(n>3 && t[n-2]==101 && t[n-1]==100 && n-2>=3){return t[0..n-2];}
    if(n>4 && t[n-2]==101 && t[n-1]==115 && n-2>=3){return t[0..n-2];}
    if(n>3 && t[n-1]==115 && t[n-2]!=115 && n-1>=3){return t[0..n-1];}
    return t;
}

// ---------- pool + handles ----------
// pool_copy: copy slice s into pool; returns 8-byte handle (off:u32,len:u32)
fn pool_copy(s:[]u8,pool:[]u8,pooln:*i32)[]u8 {
    let p:i32=pooln.*;
    let i:i32=0;
    while(i<s.len){ pool[p+i]=s[i]; i=i+1; }
    pooln.*=p+s.len;
    let h:[]u8=nio_alloc(8);
    u32put(h,0,p as i64); u32put(h,4,s.len as i64);
    return h;
}
fn h_off(h:[]u8)i32 { return u32get(h,0) as i32; }
fn h_len(h:[]u8)i32 { return u32get(h,4) as i32; }
fn lower1(c:u8)u8 {
    if(c>=65&&c<=90){return c+32;}
    return c;
}
// pool_word: copy word slice s[off..off+len] lowercased into pool; returns handle
fn pool_word(s:[]u8,off:i32,len:i32,pool:[]u8,pooln:*i32)[]u8 {
    let p:i32=pooln.*;
    let i:i32=0;
    while(i<len){ pool[p+i]=lower1(s[off+i]); i=i+1; }
    pooln.*=p+len;
    let h:[]u8=nio_alloc(8);
    u32put(h,0,p as i64); u32put(h,4,len as i64);
    return h;
}
// tokenize s into pool-resident lowercase words; fills wo/wl (u32 arenas); returns count
fn tokenize_words(s:[]u8,wo:[]u8,wl:[]u8,pool:[]u8,pooln:*i32)i32 {
    let n:i32=s.len; let i:i32=0; let wc:i32=0;
    let done:i32=0;
    while(done==0){
        while(i<n&&is_alnum(s[i] as i32)==0){i=i+1;}
        if(i>=n){done=1;}
        if(done==0){
            let st:i32=i;
            while(i<n&&is_alnum(s[i] as i32)==1){i=i+1;}
            let h:[]u8=pool_word(s,st,i-st,pool,pooln);
            u32put(wo,wc*4,h_off(h) as i64); u32put(wl,wc*4,h_len(h) as i64);
            wc=wc+1;
        }
    }
    return wc;
}
fn weq(pool:[]u8,o1:i32,l1:i32,o2:i32,l2:i32)i32 {
    if(l1!=l2){return 0;}
    let i:i32=0;
    while(i<l1){ if(pool[o1+i]!=pool[o2+i]){return 0;} i=i+1; }
    return 1;
}
fn weq_lit(pool:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){ if(pool[off+i]!=lit[i]){return 0;} i=i+1; }
    return 1;
}
fn wcmp(pool:[]u8,o1:i32,l1:i32,o2:i32,l2:i32)i32 {
    let m:i32=l1; if(l2<m){m=l2;}
    let i:i32=0;
    while(i<m){
        let a:u8=pool[o1+i]; let b:u8=pool[o2+i];
        if(a!=b){ if(a<b){return -1;} return 1; }
        i=i+1;
    }
    if(l1==l2){return 0;}
    if(l1<l2){return -1;}
    return 1;
}
// comma-split s: arena [n:u32][(off:u32,len:u32)...], offsets relative to s
fn csplit(s:[]u8)[]u8 {
    let n:i32=s.len;
    let cnt:i32=1; let i:i32=0;
    while(i<n){ if(s[i]==44){cnt=cnt+1;} i=i+1; }
    let out:[]u8=nio_alloc(cnt*8+8);
    u32put(out,0,cnt as i64);
    let k:i32=0; let st:i32=0; i=0;
    while(i<=n){
        if(i==n||s[i]==44){
            u32put(out,8+k*8,st as i64); u32put(out,8+k*8+4,(i-st) as i64);
            k=k+1; st=i+1;
        }
        i=i+1;
    }
    return out;
}
fn zero32(a:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){ u32put(a,i*4,0); i=i+1; }
    return;
}

// ---------- relation table (pool-resident raw words) ----------
fn rel_find(r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,nr:i32,pool:[]u8,
            o1:i32,l1:i32,o2:i32,l2:i32)i32 {
    let i:i32=0;
    while(i<nr){
        let a:i32=u32get(r1o,i*4) as i32; let b:i32=u32get(r1l,i*4) as i32;
        let c:i32=u32get(r2o,i*4) as i32; let d:i32=u32get(r2l,i*4) as i32;
        if(l1==b&&l2==d&&weq(pool,a,b,o1,l1)==1&&weq(pool,c,d,o2,l2)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn rel_add(r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,rules:[]u8,nr:*i32,
           pool:[]u8,o1:i32,l1:i32,o2:i32,l2:i32,mask:i32)i32 {
    let a:i32=o1; let b:i32=l1; let c:i32=o2; let d:i32=l2;
    if(wcmp(pool,a,b,c,d)>0){ a=o2; b=l2; c=o1; d=l1; }
    let nrv:i32=nr.*;
    let idx:i32=rel_find(r1o,r1l,r2o,r2l,nrv,pool,a,b,c,d);
    if(idx>=0){
        let m:i32=u32get(rules,idx*4) as i32;
        u32put(rules,idx*4,(m|mask) as i64);
        return idx;
    }
    let k:i32=nr.*;
    u32put(r1o,k*4,a as i64); u32put(r1l,k*4,b as i64);
    u32put(r2o,k*4,c as i64); u32put(r2l,k*4,d as i64);
    u32put(rules,k*4,mask as i64);
    nr.*=k+1;
    return k;
}
// lid lists (pool-resident), deduped per relation
fn lid_add(lo:[]u8,ll:[]u8,l0:[]u8,ln:[]u8,nl:*i32,ridx:i32,lido:i32,lidl:i32,pool:[]u8)void {
    let c0:i32=u32get(l0,ridx*4) as i32; let cn:i32=u32get(ln,ridx*4) as i32;
    let q:i32=0; let dup:i32=0;
    while(q<cn){
        let e:i32=u32get(lo,(c0+q)*4) as i32; let f:i32=u32get(ll,(c0+q)*4) as i32;
        if(weq(pool,e,f,lido,lidl)==1){dup=1;}
        q=q+1;
    }
    if(dup==1){return;}
    let k:i32=nl.*;
    u32put(lo,k*4,lido as i64); u32put(ll,k*4,lidl as i64);
    if(cn==0){ u32put(l0,ridx*4,k as i64); }
    u32put(ln,ridx*4,(cn+1) as i64);
    nl.*=k+1;
    return;
}
// veto table
fn veto_find(v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,pool:[]u8,
             o1:i32,l1:i32,o2:i32,l2:i32)i32 {
    let i:i32=0;
    while(i<nv){
        let a:i32=u32get(v1o,i*4) as i32; let b:i32=u32get(v1l,i*4) as i32;
        let c:i32=u32get(v2o,i*4) as i32; let d:i32=u32get(v2l,i*4) as i32;
        if(weq(pool,a,b,o1,l1)==1&&weq(pool,c,d,o2,l2)==1){return i;}
        if(weq(pool,a,b,o2,l2)==1&&weq(pool,c,d,o1,l1)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn veto_add(v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,vlido:[]u8,vlidl:[]u8,nv:*i32,
            pool:[]u8,o1:i32,l1:i32,o2:i32,l2:i32,lido:i32,lidl:i32)void {
    let nvv:i32=nv.*;
    if(veto_find(v1o,v1l,v2o,v2l,nvv,pool,o1,l1,o2,l2)>=0){return;}
    let k:i32=nv.*;
    u32put(v1o,k*4,o1 as i64); u32put(v1l,k*4,l1 as i64);
    u32put(v2o,k*4,o2 as i64); u32put(v2l,k*4,l2 as i64);
    u32put(vlido,k*4,lido as i64); u32put(vlidl,k*4,lidl as i64);
    nv.*=k+1;
    return;
}
fn vetoed(v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,pool:[]u8,sa:[]u8,sb:[]u8)i32 {
    let i:i32=0;
    while(i<nv){
        let a0:i32=u32get(v1o,i*4) as i32; let al:i32=u32get(v1l,i*4) as i32;
        let b0:i32=u32get(v2o,i*4) as i32; let bl:i32=u32get(v2l,i*4) as i32;
        let va:[]u8=stem(pool[a0..a0+al]); let vb:[]u8=stem(pool[b0..b0+bl]);
        if((bytes_eq(va,sa)==1&&bytes_eq(vb,sb)==1)||(bytes_eq(va,sb)==1&&bytes_eq(vb,sa)==1)){return i;}
        i=i+1;
    }
    return -1;
}

// ---------- surface matchers (MECHANISM.md §2); words pool-resident ----------
// returns 20-byte handle: ok:u32 x_off:u32 x_len:u32 y_off:u32 y_len:u32
fn match_r1(pool:[]u8,wo:[]u8,wl:[]u8,n:i32)[]u8 {
    let out:[]u8=nio_alloc(20);
    u32put(out,0,0);
    if(n==5){
        let o0:i32=u32get(wo,0) as i32; let l0:i32=u32get(wl,0) as i32;
        let o1:i32=u32get(wo,4) as i32; let l1:i32=u32get(wl,4) as i32;
        let o2:i32=u32get(wo,8) as i32; let l2:i32=u32get(wl,8) as i32;
        let o3:i32=u32get(wo,12) as i32; let l3:i32=u32get(wl,12) as i32;
        let o4:i32=u32get(wo,16) as i32; let l4:i32=u32get(wl,16) as i32;
        if((weq_lit(pool,o0,l0,"a")==1||weq_lit(pool,o0,l0,"an")==1)
        &&weq_lit(pool,o2,l2,"is")==1
        &&(weq_lit(pool,o3,l3,"a")==1||weq_lit(pool,o3,l3,"an")==1)){
            u32put(out,0,1);
            u32put(out,4,o1 as i64); u32put(out,8,l1 as i64);
            u32put(out,12,o4 as i64); u32put(out,16,l4 as i64);
        }
    }
    if(n==6){
        let o0:i32=u32get(wo,0) as i32; let l0:i32=u32get(wl,0) as i32;
        let o1:i32=u32get(wo,4) as i32; let l1:i32=u32get(wl,4) as i32;
        let o2:i32=u32get(wo,8) as i32; let l2:i32=u32get(wl,8) as i32;
        let o3:i32=u32get(wo,12) as i32; let l3:i32=u32get(wl,12) as i32;
        let o4:i32=u32get(wo,16) as i32; let l4:i32=u32get(wl,16) as i32;
        let o5:i32=u32get(wo,20) as i32; let l5:i32=u32get(wl,20) as i32;
        if(weq_lit(pool,o1,l1,"is")==1&&weq_lit(pool,o2,l2,"a")==1
        &&weq_lit(pool,o3,l3,"kind")==1&&weq_lit(pool,o4,l4,"of")==1){
            u32put(out,0,1);
            u32put(out,4,o0 as i64); u32put(out,8,l0 as i64);
            u32put(out,12,o5 as i64); u32put(out,16,l5 as i64);
        }
    }
    return out;
}
fn match_r2(pool:[]u8,wo:[]u8,wl:[]u8,n:i32)[]u8 {
    let out:[]u8=nio_alloc(20);
    u32put(out,0,0);
    if(n==5){
        let o0:i32=u32get(wo,0) as i32; let l0:i32=u32get(wl,0) as i32;
        let o1:i32=u32get(wo,4) as i32; let l1:i32=u32get(wl,4) as i32;
        let o2:i32=u32get(wo,8) as i32; let l2:i32=u32get(wl,8) as i32;
        let o3:i32=u32get(wo,12) as i32; let l3:i32=u32get(wl,12) as i32;
        let o4:i32=u32get(wo,16) as i32; let l4:i32=u32get(wl,16) as i32;
        if(weq_lit(pool,o1,l1,"and")==1&&weq_lit(pool,o2,l2,"are")==1
        &&weq_lit(pool,o3,l3,"synonyms")==1){
            u32put(out,0,1);
            u32put(out,4,o0 as i64); u32put(out,8,l0 as i64);
            u32put(out,12,o4 as i64); u32put(out,16,l4 as i64);
        }
    }
    return out;
}
fn match_r4(pool:[]u8,wo:[]u8,wl:[]u8,n:i32)[]u8 {
    let out:[]u8=nio_alloc(20);
    u32put(out,0,0);
    if(n==6){
        let o0:i32=u32get(wo,0) as i32; let l0:i32=u32get(wl,0) as i32;
        let o1:i32=u32get(wo,4) as i32; let l1:i32=u32get(wl,4) as i32;
        let o2:i32=u32get(wo,8) as i32; let l2:i32=u32get(wl,8) as i32;
        let o3:i32=u32get(wo,12) as i32; let l3:i32=u32get(wl,12) as i32;
        let o4:i32=u32get(wo,16) as i32; let l4:i32=u32get(wl,16) as i32;
        let o5:i32=u32get(wo,20) as i32; let l5:i32=u32get(wl,20) as i32;
        if((weq_lit(pool,o0,l0,"a")==1||weq_lit(pool,o0,l0,"an")==1)
        &&weq_lit(pool,o2,l2,"is")==1&&weq_lit(pool,o3,l3,"not")==1
        &&(weq_lit(pool,o4,l4,"a")==1||weq_lit(pool,o4,l4,"an")==1)){
            u32put(out,0,1);
            u32put(out,4,o1 as i64); u32put(out,8,l1 as i64);
            u32put(out,12,o5 as i64); u32put(out,16,l5 as i64);
        }
    }
    if(n==4){
        let o0:i32=u32get(wo,0) as i32; let l0:i32=u32get(wl,0) as i32;
        let o1:i32=u32get(wo,4) as i32; let l1:i32=u32get(wl,4) as i32;
        let o2:i32=u32get(wo,8) as i32; let l2:i32=u32get(wl,8) as i32;
        let o3:i32=u32get(wo,12) as i32; let l3:i32=u32get(wl,12) as i32;
        if(weq_lit(pool,o1,l1,"is")==1&&weq_lit(pool,o2,l2,"not")==1){
            u32put(out,0,1);
            u32put(out,4,o0 as i64); u32put(out,8,l0 as i64);
            u32put(out,12,o3 as i64); u32put(out,16,l3 as i64);
        }
    }
    return out;
}

// ---------- output ----------
fn rules_str(mask:i32)[]u8 {
    let b:[]u8=nio_alloc(16); let p:i32=0;
    if((mask&1)==1){ b[0]=82; b[1]=49; p=2; }
    if((mask&2)==2){ if(p>0){b[p]=43;p=p+1;} b[p]=82; b[p+1]=50; p=p+2; }
    if((mask&4)==4){ if(p>0){b[p]=43;p=p+1;} b[p]=82; b[p+1]=51; p=p+2; }
    return b[0..p];
}
fn emit(dst:[]u8,dp:*i32,s:[]u8)void {
    let p:i32=dp.*; let i:i32=0;
    while(i<s.len){ dst[p+i]=s[i]; i=i+1; }
    dp.*=p+s.len;
    return;
}
fn emit_pool(dst:[]u8,dp:*i32,pool:[]u8,off:i32,len:i32)void {
    let p:i32=dp.*; let i:i32=0;
    while(i<len){ dst[p+i]=pool[off+i]; i=i+1; }
    dp.*=p+len;
    return;
}
// selection sort of ord[0..n) by relation key (w1,w2)
fn sort_rels(ord:[]u8,o1:[]u8,ol:[]u8,o2:[]u8,ol2:[]u8,n:i32,pool:[]u8)void {
    let i:i32=0;
    while(i<n){
        let m:i32=i; let j:i32=i+1;
        while(j<n){
            let ia:i32=u32get(ord,m*4) as i32; let ib:i32=u32get(ord,j*4) as i32;
            let c1:i32=wcmp(pool,u32get(o1,ia*4) as i32,u32get(ol,ia*4) as i32,
                                  u32get(o1,ib*4) as i32,u32get(ol,ib*4) as i32);
            if(c1>0){m=j;}
            if(c1==0){
                let c2:i32=wcmp(pool,u32get(o2,ia*4) as i32,u32get(ol2,ia*4) as i32,
                                      u32get(o2,ib*4) as i32,u32get(ol2,ib*4) as i32);
                if(c2>0){m=j;}
            }
            j=j+1;
        }
        let t:i32=u32get(ord,i*4) as i32;
        u32put(ord,i*4,u32get(ord,m*4)); u32put(ord,m*4,t as i64);
        i=i+1;
    }
    return;
}
// union-find over stem indices
fn uf_add(so:[]u8,sl:[]u8,par:[]u8,ns:*i32,pool:[]u8,off:i32,len:i32)i32 {
    let i:i32=0;
    while(i<ns.*){
        if(weq(pool,u32get(so,i*4) as i32,u32get(sl,i*4) as i32,off,len)==1){return i;}
        i=i+1;
    }
    let k:i32=ns.*;
    u32put(so,k*4,off as i64); u32put(sl,k*4,len as i64);
    u32put(par,k*4,k as i64);
    ns.*=k+1;
    return k;
}
fn uf_find(par:[]u8,x:i32)i32 {
    let r:i32=x;
    let guard:i32=0;
    while(u32get(par,r*4) as i32!=r&&guard<10000){
        r=u32get(par,r*4) as i32; guard=guard+1;
    }
    return r;
}
fn uf_union(par:[]u8,a:i32,b:i32)void {
    let ra:i32=uf_find(par,a); let rb:i32=uf_find(par,b);
    if(ra!=rb){ u32put(par,rb*4,ra as i64); }
    return;
}

// propose one positive pair (raw pool words); applies veto, installs
fn propose(r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,rrules:[]u8,nr:*i32,
           lo:[]u8,ll:[]u8,l0:[]u8,ln:[]u8,nl:*i32,
           v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,
           pool:[]u8,xa:i32,xb:i32,ya:i32,yb:i32,mask:i32,
           lido:i32,lidl:i32,supp:*i32)void {
    let sx:[]u8=stem(pool[xa..xa+xb]);
    let sy:[]u8=stem(pool[ya..ya+yb]);
    if(bytes_eq(sx,sy)==1){return;}
    if(vetoed(v1o,v1l,v2o,v2l,nv,pool,sx,sy)>=0){
        supp.*=supp.*+1;
        return;
    }
    let idx:i32=rel_add(r1o,r1l,r2o,r2l,rrules,nr,pool,xa,xb,ya,yb,mask);
    lid_add(lo,ll,l0,ln,nl,idx,lido,lidl,pool);
    return;
}

// ---------- main ----------
fn main()void {
    let cmd:[]u8=_zag_arg(1);
    if(bytes_eq(cmd,"dump")==1){
        let dir:[]u8=_zag_arg(2);
        let out:[]u8=nio_alloc(65536);
        let dp:i32=0;
        emit(out,&dp,"=== synlearn.txt ===\n");
        emit(out,&dp,f_read(path_join(dir,"synlearn.txt")));
        emit(out,&dp,"=== synveto.txt ===\n");
        emit(out,&dp,f_read(path_join(dir,"synveto.txt")));
        f_write(path_join(dir,"learn_dump.txt"),out[0..dp]);
        return;
    }
    if(bytes_eq(cmd,"ingest")!=1){
        f_write(path_join(".","learn_usage.txt"),"usage: learn dump <dir> | learn ingest <corpus> <dir>\n");
        return;
    }
    let corpus:[]u8=_zag_arg(2);
    let dir:[]u8=_zag_arg(3);
    let buf:[]u8=f_read(corpus);
    let r1o:[]u8=nio_alloc(4096); let r1l:[]u8=nio_alloc(4096);
    let r2o:[]u8=nio_alloc(4096); let r2l:[]u8=nio_alloc(4096);
    let rrules:[]u8=nio_alloc(4096);
    let lo:[]u8=nio_alloc(32768); let ll:[]u8=nio_alloc(32768);
    let l0:[]u8=nio_alloc(8192); let ln:[]u8=nio_alloc(8192);
    let v1o:[]u8=nio_alloc(1024); let v1l:[]u8=nio_alloc(1024);
    let v2o:[]u8=nio_alloc(1024); let v2l:[]u8=nio_alloc(1024);
    let vlido:[]u8=nio_alloc(1024); let vlidl:[]u8=nio_alloc(1024);
    let pool:[]u8=nio_alloc(131072);
    let nr:i32=0; let nl:i32=0; let nv:i32=0; let pooln:i32=0;
    let supp:i32=0;
    zero32(l0,2048); zero32(ln,2048);
    // PARA accumulation: up to 256 entries, each up to 16 words
    let pso:[]u8=nio_alloc(1024); let psl:[]u8=nio_alloc(1024);
    let pwn:[]u8=nio_alloc(1024);
    let pwo:[]u8=nio_alloc(16384); let pwl:[]u8=nio_alloc(16384);
    let plido:[]u8=nio_alloc(1024); let plidl:[]u8=nio_alloc(1024);
    let npara:i32=0;
    // merge existing store
    let old:[]u8=f_read(path_join(dir,"synlearn.txt"));
    if(old.len>0){
        let ol:[]u8=lines_of(old); let k:i32=0;
        while(k<line_n(ol)){
            let lin:[]u8=line_slice(old,ol,k);
            if(lin.len>0&&lin[0]!=35){
                let f:[]u8=fields_of(lin,124,4);
                if(fld_n(f)==4){
                    let w1:[]u8=fa_f(f,lin,0); let w2:[]u8=fa_f(f,lin,1);
                    let rs:[]u8=fa_f(f,lin,2); let ls:[]u8=fa_f(f,lin,3);
                    let h1:[]u8=pool_copy(w1,pool,&pooln);
                    let h2:[]u8=pool_copy(w2,pool,&pooln);
                    // parse rules by splitting on '+'
                    let mask:i32=0;
                    let cs0:[]u8=csplit(rs); let q0:i32=0;
                    while(q0<u32get(cs0,0) as i32){
                        let rso:i32=u32get(cs0,8+q0*8) as i32;
                        let rsl:i32=u32get(cs0,8+q0*8+4) as i32;
                        let one:[]u8=rs[rso..rso+rsl];
                        if(bytes_eq(one,"R1")==1){mask=mask|1;}
                        if(bytes_eq(one,"R2")==1){mask=mask|2;}
                        if(bytes_eq(one,"R3")==1){mask=mask|4;}
                        q0=q0+1;
                    }
                    let idx:i32=rel_add(r1o,r1l,r2o,r2l,rrules,&nr,pool,
                        h_off(h1),h_len(h1),h_off(h2),h_len(h2),mask);
                    let cs:[]u8=csplit(ls); let q:i32=0;
                    while(q<u32get(cs,0) as i32){
                        let lso:i32=u32get(cs,8+q*8) as i32;
                        let lsl:i32=u32get(cs,8+q*8+4) as i32;
                        let one:[]u8=ls[lso..lso+lsl];
                        let ho:[]u8=pool_copy(one,pool,&pooln);
                        lid_add(lo,ll,l0,ln,&nl,idx,h_off(ho),h_len(ho),pool);
                        q=q+1;
                    }
                }
            }
            k=k+1;
        }
    }
    let oldv:[]u8=f_read(path_join(dir,"synveto.txt"));
    if(oldv.len>0){
        let ol:[]u8=lines_of(oldv); let k:i32=0;
        while(k<line_n(ol)){
            let lin:[]u8=line_slice(oldv,ol,k);
            if(lin.len>0&&lin[0]!=35){
                let f:[]u8=fields_of(lin,124,4);
                if(fld_n(f)==4){
                    let w1:[]u8=fa_f(f,lin,0); let w2:[]u8=fa_f(f,lin,1);
                    let ls:[]u8=fa_f(f,lin,3);
                    let h1:[]u8=pool_copy(w1,pool,&pooln);
                    let h2:[]u8=pool_copy(w2,pool,&pooln);
                    let ho:[]u8=pool_copy(ls,pool,&pooln);
                    veto_add(v1o,v1l,v2o,v2l,vlido,vlidl,&nv,pool,
                        h_off(h1),h_len(h1),h_off(h2),h_len(h2),h_off(ho),h_len(ho));
                }
            }
            k=k+1;
        }
    }
    // parse corpus
    let bl:[]u8=lines_of(buf);
    let nlines:i32=line_n(bl);
    let wo:[]u8=nio_alloc(256); let wl:[]u8=nio_alloc(256);
    let k:i32=0;
    while(k<nlines){
        let lin:[]u8=line_slice(buf,bl,k);
        if(lin.len>0&&lin[0]!=35){
            let f:[]u8=fields_of(lin,124,5);
            if(fld_n(f)>=4&&bytes_eq(fa_f(f,lin,0),"LEARN")==1){
                let hlid:[]u8=pool_copy(fa_f(f,lin,1),pool,&pooln);
                let pat:[]u8=fa_f(f,lin,2);
                if(bytes_eq(pat,"PARA")==1&&fld_n(f)==5){
                    let hs:[]u8=pool_copy(fa_f(f,lin,3),pool,&pooln);
                    let wn:i32=tokenize_words(fa_f(f,lin,4),wo,wl,pool,&pooln);
                    let pi:i32=npara;
                    u32put(pso,pi*4,h_off(hs) as i64); u32put(psl,pi*4,h_len(hs) as i64);
                    u32put(pwn,pi*4,wn as i64);
                    u32put(plido,pi*4,h_off(hlid) as i64); u32put(plidl,pi*4,h_len(hlid) as i64);
                    let q:i32=0;
                    while(q<wn){
                        u32put(pwo,(pi*16+q)*4,u32get(wo,q*4));
                        u32put(pwl,(pi*16+q)*4,u32get(wl,q*4));
                        q=q+1;
                    }
                    npara=pi+1;
                }
                if(bytes_eq(pat,"PARA")!=1&&fld_n(f)==4){
                    let wn:i32=tokenize_words(fa_f(f,lin,3),wo,wl,pool,&pooln);
                    let m4:[]u8=match_r4(pool,wo,wl,wn);
                    if(u32get(m4,0)==1){
                        veto_add(v1o,v1l,v2o,v2l,vlido,vlidl,&nv,pool,
                            u32get(m4,4) as i32,u32get(m4,8) as i32,
                            u32get(m4,12) as i32,u32get(m4,16) as i32,
                            h_off(hlid),h_len(hlid));
                    }
                    if(u32get(m4,0)!=1){
                        let m1:[]u8=match_r1(pool,wo,wl,wn);
                        let m2:[]u8=match_r2(pool,wo,wl,wn);
                        let mk:i32=0; let mm:[]u8=m1;
                        if(u32get(m1,0)==1){mk=1;}
                        if(u32get(m2,0)==1){mk=2;mm=m2;}
                        if(mk>0){
                            propose(r1o,r1l,r2o,r2l,rrules,&nr,lo,ll,l0,ln,&nl,
                                v1o,v1l,v2o,v2l,nv,pool,
                                u32get(mm,4) as i32,u32get(mm,8) as i32,
                                u32get(mm,12) as i32,u32get(mm,16) as i32,
                                mk,h_off(hlid),h_len(hlid),&supp);
                        }
                    }
                }
            }
        }
        k=k+1;
    }
    // R3: group PARA entries by subject tag
    let g0:[]u8=nio_alloc(1024); let gn:[]u8=nio_alloc(1024);
    zero32(gn,256);
    let ngroups:i32=0;
    let q2:i32=0;
    while(q2<npara){
        let so:i32=u32get(pso,q2*4) as i32; let sl:i32=u32get(psl,q2*4) as i32;
        let g:i32=-1; let q:i32=0;
        while(q<ngroups){
            let e:i32=u32get(g0,q*4) as i32;
            if(weq(pool,u32get(pso,e*4) as i32,u32get(psl,e*4) as i32,so,sl)==1){g=q;}
            q=q+1;
        }
        if(g<0){
            g=ngroups;
            u32put(g0,g*4,q2 as i64); u32put(gn,g*4,1);
            ngroups=g+1;
        }
        if(g>=0&&(u32get(g0,g*4) as i32)!=q2){
            u32put(gn,g*4,u32get(gn,g*4)+1);
        }
        q2=q2+1;
    }
    // R3 candidates: one per subject with exactly 2 lines
    let cxo:[]u8=nio_alloc(2048); let cxl:[]u8=nio_alloc(2048);
    let cyo:[]u8=nio_alloc(2048); let cyl:[]u8=nio_alloc(2048);
    let cl1o:[]u8=nio_alloc(2048); let cl1l:[]u8=nio_alloc(2048);
    let cl2o:[]u8=nio_alloc(2048); let cl2l:[]u8=nio_alloc(2048);
    let ncand:i32=0;
    let gi:i32=0;
    while(gi<ngroups){
        if(u32get(gn,gi*4)==2){
            let first:i32=u32get(g0,gi*4) as i32;
            let so:i32=u32get(pso,first*4) as i32; let sl:i32=u32get(psl,first*4) as i32;
            let second:i32=-1; let q:i32=0;
            while(q<npara){
                if(q!=first&&weq(pool,u32get(pso,q*4) as i32,u32get(psl,q*4) as i32,so,sl)==1){
                    second=q;
                }
                q=q+1;
            }
            if(second>=0){
                let n1:i32=u32get(pwn,first*4) as i32; let n2:i32=u32get(pwn,second*4) as i32;
                if(n1==n2){
                    let diff:i32=0; let dp:i32=0; let w:i32=0;
                    while(w<n1){
                        let a1:i32=u32get(pwo,(first*16+w)*4) as i32;
                        let b1:i32=u32get(pwl,(first*16+w)*4) as i32;
                        let a2:i32=u32get(pwo,(second*16+w)*4) as i32;
                        let b2:i32=u32get(pwl,(second*16+w)*4) as i32;
                        if(weq(pool,a1,b1,a2,b2)!=1){diff=diff+1;dp=w;}
                        w=w+1;
                    }
                    if(diff==1){
                        let ci:i32=ncand;
                        u32put(cxo,ci*4,u32get(pwo,(first*16+dp)*4));
                        u32put(cxl,ci*4,u32get(pwl,(first*16+dp)*4));
                        u32put(cyo,ci*4,u32get(pwo,(second*16+dp)*4));
                        u32put(cyl,ci*4,u32get(pwl,(second*16+dp)*4));
                        u32put(cl1o,ci*4,u32get(plido,first*4));
                        u32put(cl1l,ci*4,u32get(plidl,first*4));
                        u32put(cl2o,ci*4,u32get(plido,second*4));
                        u32put(cl2l,ci*4,u32get(plidl,second*4));
                        ncand=ci+1;
                    }
                }
            }
        }
        gi=gi+1;
    }
    // install R3 candidates witnessed by >=2 subjects
    let ci2:i32=0;
    while(ci2<ncand){
        let ax:i32=u32get(cxo,ci2*4) as i32; let bx:i32=u32get(cxl,ci2*4) as i32;
        let ay:i32=u32get(cyo,ci2*4) as i32; let by:i32=u32get(cyl,ci2*4) as i32;
        let wit:i32=0; let j:i32=0;
        while(j<ncand){
            let qx:i32=u32get(cxo,j*4) as i32; let qbx:i32=u32get(cxl,j*4) as i32;
            let qy:i32=u32get(cyo,j*4) as i32; let qby:i32=u32get(cyl,j*4) as i32;
            if((weq(pool,ax,bx,qx,qbx)==1&&weq(pool,ay,by,qy,qby)==1)
            ||(weq(pool,ax,bx,qy,qby)==1&&weq(pool,ay,by,qx,qbx)==1)){wit=wit+1;}
            j=j+1;
        }
        if(wit>=2){
            propose(r1o,r1l,r2o,r2l,rrules,&nr,lo,ll,l0,ln,&nl,
                v1o,v1l,v2o,v2l,nv,pool,ax,bx,ay,by,4,
                u32get(cl1o,ci2*4) as i32,u32get(cl1l,ci2*4) as i32,&supp);
            propose(r1o,r1l,r2o,r2l,rrules,&nr,lo,ll,l0,ln,&nl,
                v1o,v1l,v2o,v2l,nv,pool,ax,bx,ay,by,4,
                u32get(cl2o,ci2*4) as i32,u32get(cl2l,ci2*4) as i32,&supp);
        }
        ci2=ci2+1;
    }
    // closure veto-safety: union-find over stems of installed relations
    let uso:[]u8=nio_alloc(4096); let usl:[]u8=nio_alloc(4096);
    let upar:[]u8=nio_alloc(4096);
    let nst:i32=0;
    let ri:i32=0;
    while(ri<nr){
        let ao:i32=u32get(r1o,ri*4) as i32; let al:i32=u32get(r1l,ri*4) as i32;
        let bo:i32=u32get(r2o,ri*4) as i32; let bl2:i32=u32get(r2l,ri*4) as i32;
        let sa:[]u8=stem(pool[ao..ao+al]); let sb:[]u8=stem(pool[bo..bo+bl2]);
        let ia:i32=uf_add(uso,usl,upar,&nst,pool,ao,sa.len);
        let ib:i32=uf_add(uso,usl,upar,&nst,pool,bo,sb.len);
        uf_union(upar,ia,ib);
        ri=ri+1;
    }
    let vi2:i32=0;
    let violation:i32=0;
    while(vi2<nv){
        let ao:i32=u32get(v1o,vi2*4) as i32; let al:i32=u32get(v1l,vi2*4) as i32;
        let bo:i32=u32get(v2o,vi2*4) as i32; let bl2:i32=u32get(v2l,vi2*4) as i32;
        let va:[]u8=stem(pool[ao..ao+al]); let vb:[]u8=stem(pool[bo..bo+bl2]);
        let ia:i32=uf_add(uso,usl,upar,&nst,pool,ao,va.len);
        let ib:i32=uf_add(uso,usl,upar,&nst,pool,bo,vb.len);
        if(uf_find(upar,ia)==uf_find(upar,ib)){
            violation=1;
        }
        vi2=vi2+1;
    }
    if(violation==1){
        f_write(path_join(dir,"learn.log"),"VETO VIOLATION: vetoed pair transitively connected — aborting\n");
        return;
    }
    // write synlearn.txt (sorted)
    let ord:[]u8=nio_alloc(4096);
    let oi:i32=0;
    while(oi<nr){ u32put(ord,oi*4,oi as i64); oi=oi+1; }
    sort_rels(ord,r1o,r1l,r2o,r2l,nr,pool);
    let out:[]u8=nio_alloc(65536);
    let dp:i32=0;
    oi=0;
    while(oi<nr){
        let r:i32=u32get(ord,oi*4) as i32;
        emit_pool(out,&dp,pool,u32get(r1o,r*4) as i32,u32get(r1l,r*4) as i32);
        emit(out,&dp,"|");
        emit_pool(out,&dp,pool,u32get(r2o,r*4) as i32,u32get(r2l,r*4) as i32);
        emit(out,&dp,"|");
        emit(out,&dp,rules_str(u32get(rrules,r*4) as i32));
        emit(out,&dp,"|");
        let c0:i32=u32get(l0,r*4) as i32; let cn:i32=u32get(ln,r*4) as i32;
        let q:i32=0;
        while(q<cn){
            if(q>0){emit(out,&dp,",");}
            emit_pool(out,&dp,pool,u32get(lo,(c0+q)*4) as i32,u32get(ll,(c0+q)*4) as i32);
            q=q+1;
        }
        emit(out,&dp,"\n");
        oi=oi+1;
    }
    f_write(path_join(dir,"synlearn.txt"),out[0..dp]);
    // write synveto.txt (sorted)
    let vord:[]u8=nio_alloc(1024);
    oi=0;
    while(oi<nv){ u32put(vord,oi*4,oi as i64); oi=oi+1; }
    sort_rels(vord,v1o,v1l,v2o,v2l,nv,pool);
    let vout:[]u8=nio_alloc(8192);
    let vdp:i32=0;
    oi=0;
    while(oi<nv){
        let r:i32=u32get(vord,oi*4) as i32;
        emit_pool(vout,&vdp,pool,u32get(v1o,r*4) as i32,u32get(v1l,r*4) as i32);
        emit(vout,&vdp,"|");
        emit_pool(vout,&vdp,pool,u32get(v2o,r*4) as i32,u32get(v2l,r*4) as i32);
        emit(vout,&vdp,"|R4|");
        emit_pool(vout,&vdp,pool,u32get(vlido,r*4) as i32,u32get(vlidl,r*4) as i32);
        emit(vout,&vdp,"\n");
        oi=oi+1;
    }
    f_write(path_join(dir,"synveto.txt"),vout[0..vdp]);
    let lg1:[]u8=concat("learn: ok lines=",i64s(nlines as i64));
    let lg2:[]u8=concat(lg1,concat(" relations=",i64s(nr as i64)));
    let lg3:[]u8=concat(lg2,concat(" vetoes=",i64s(nv as i64)));
    let lg4:[]u8=concat(lg3,concat(" suppressed=",i64s(supp as i64)));
    f_write(path_join(dir,"learn.log"),concat(lg4,"\n"));
    return;
}

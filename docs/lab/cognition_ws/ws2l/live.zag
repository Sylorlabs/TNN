// live.zag — live deliberate synonym learning (PREREG_SYNINT_LIVE.md).
//
// TNN's deliberative consideration loop over a STREAM of utterances.
// Every install is a DECISION with recorded grounds:
//   notice -> provenance check -> belief consultation -> evidence weighing
//   -> consistency checks -> journaled decision -> substrate install.
//
// Utterance format:
//   UTT|<uid>|<channel>|<pattern>|<text>        (channel: OBS | CON)
//   UTT|<uid>|<channel>|PARA|<subj>|<text>
//
// The constructed-mode firewall: CON-channel utterances are barred from
// install (REFUSE-CONSTRUCTED). Noticing is not believing.
// The substrate live[] is the sole authority on belief; delib.log is the
// audit record of deliberation (it replays to exact PARA-subject state).
//
// Store format is shared with learn.zag (syntab.bin + synmem.bin), so
// `learn dump` and the kill/pin/promote CLI work on live-built stores.
//
// Pure Zag. Deterministic. Zero RNG.
@import("lib.zag")
@import("syn_mem.zag")
@import("match.zag")

// ---------- deliberation journal ----------
// J|seq|uid|chan|rule|w1|w2|decision|grounds|text
fn jlog(dir:[]u8,pseq:*i32,uid:[]u8,chan:[]u8,rule:[]u8,w1:[]u8,w2:[]u8,
        decision:[]u8,grounds:[]u8,text:[]u8)void {
    let b:[]u8=nio_alloc(256);
    let dp:i32=0;
    emit(&b,&dp,"J|");
    emit(&b,&dp,i64s(pseq.* as i64)); emit(&b,&dp,"|");
    emit(&b,&dp,uid); emit(&b,&dp,"|");
    emit(&b,&dp,chan); emit(&b,&dp,"|");
    emit(&b,&dp,rule); emit(&b,&dp,"|");
    emit(&b,&dp,w1); emit(&b,&dp,"|");
    emit(&b,&dp,w2); emit(&b,&dp,"|");
    emit(&b,&dp,decision); emit(&b,&dp,"|");
    emit(&b,&dp,grounds); emit(&b,&dp,"|");
    emit(&b,&dp,text); emit(&b,&dp,"\n");
    let jp:[]u8=path_join(dir,"delib.log");
    let old:[]u8=f_read(jp);
    let nb:[]u8=nio_alloc(old.len+dp+1);
    let i:i32=0;
    while(i<old.len){nb[i]=old[i];i=i+1;}
    let j:i32=0;
    while(j<dp){nb[old.len+j]=b[j];j=j+1;}
    f_write(jp,nb[0..old.len+dp]);
    pseq.*=pseq.*+1;
    return;
}

// ---------- live belief consultation (substrate live[] is the authority) ----------

// 1 if a LIVE veto covers the stem pair (sx,sy)
fn live_vetoed(db:*SynDb,v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,
               vshard:[]u8,vslot:[]u8,pool:[]u8,sx:[]u8,sy:[]u8)i32 {
    let i:i32=0;
    while(i<nv){
        if(syn_is_live(db,u32get(vshard,i*4) as i32,u32get(vslot,i*4) as i32)==1){
            let a0:i32=u32get(v1o,i*4) as i32; let al:i32=u32get(v1l,i*4) as i32;
            let b0:i32=u32get(v2o,i*4) as i32; let bl:i32=u32get(v2l,i*4) as i32;
            let va:[]u8=stem(pool[a0..a0+al]); let vb:[]u8=stem(pool[b0..b0+bl]);
            if((bytes_eq(va,sx)==1&&bytes_eq(vb,sy)==1)
            ||(bytes_eq(va,sy)==1&&bytes_eq(vb,sx)==1)){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// row index of a LIVE relation covering the stem pair, else -1
fn live_rel_find(db:*SynDb,r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,nr:i32,
                 rshard:[]u8,rslot:[]u8,pool:[]u8,sx:[]u8,sy:[]u8)i32 {
    let i:i32=0;
    while(i<nr){
        if(syn_is_live(db,u32get(rshard,i*4) as i32,u32get(rslot,i*4) as i32)==1){
            let a0:i32=u32get(r1o,i*4) as i32; let al:i32=u32get(r1l,i*4) as i32;
            let b0:i32=u32get(r2o,i*4) as i32; let bl:i32=u32get(r2l,i*4) as i32;
            let va:[]u8=stem(pool[a0..a0+al]); let vb:[]u8=stem(pool[b0..b0+bl]);
            if((bytes_eq(va,sx)==1&&bytes_eq(vb,sy)==1)
            ||(bytes_eq(va,sy)==1&&bytes_eq(vb,sx)==1)){return i;}
        }
        i=i+1;
    }
    return -1;
}

// row index of any veto row (live or dead) for the stem pair, else -1
fn veto_row_find(v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,
                 pool:[]u8,sx:[]u8,sy:[]u8)i32 {
    let i:i32=0;
    while(i<nv){
        let a0:i32=u32get(v1o,i*4) as i32; let al:i32=u32get(v1l,i*4) as i32;
        let b0:i32=u32get(v2o,i*4) as i32; let bl:i32=u32get(v2l,i*4) as i32;
        let va:[]u8=stem(pool[a0..a0+al]); let vb:[]u8=stem(pool[b0..b0+bl]);
        if((bytes_eq(va,sx)==1&&bytes_eq(vb,sy)==1)
        ||(bytes_eq(va,sy)==1&&bytes_eq(vb,sx)==1)){return i;}
        i=i+1;
    }
    return -1;
}

// union-find over LIVE relation stems; optionally unions one extra edge.
// ox1/lx1, ox2/lx2 are pool (offset,len) of the edge's stem words.
fn live_uf_build(db:*SynDb,r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,nr:i32,
    rshard:[]u8,rslot:[]u8,ppool:*[]u8,
    ox1:i32,lx1:i32,ox2:i32,lx2:i32,do_extra:i32,
    puso:*[]u8,pusl:*[]u8,pupar:*[]u8,pnst:*i32)void {
    let pool:[]u8=ppool.*;
    let i:i32=0;
    while(i<nr){
        if(syn_is_live(db,u32get(rshard,i*4) as i32,u32get(rslot,i*4) as i32)==1){
            let a0:i32=u32get(r1o,i*4) as i32; let al:i32=u32get(r1l,i*4) as i32;
            let b0:i32=u32get(r2o,i*4) as i32; let bl:i32=u32get(r2l,i*4) as i32;
            let sa:[]u8=stem(pool[a0..a0+al]); let sb:[]u8=stem(pool[b0..b0+bl]);
            let ia:i32=uf_add(puso,pusl,pupar,pnst,ppool,a0,sa.len);
            let ib:i32=uf_add(puso,pusl,pupar,pnst,ppool,b0,sb.len);
            uf_union(pupar.*,ia,ib);
        }
        i=i+1;
    }
    if(do_extra==1){
        let ie1:i32=uf_add(puso,pusl,pupar,pnst,ppool,ox1,lx1);
        let ie2:i32=uf_add(puso,pusl,pupar,pnst,ppool,ox2,lx2);
        uf_union(pupar.*,ie1,ie2);
    }
    return;
}

// 1 if installing the stem edge (ox1/lx1)-(ox2/lx2) would transitively
// connect a LIVE veto pair (the deliberate withhold check)
fn live_would_violate(db:*SynDb,
    r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,nr:i32,rshard:[]u8,rslot:[]u8,
    v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,nv:i32,vshard:[]u8,vslot:[]u8,
    ppool:*[]u8,ox1:i32,lx1:i32,ox2:i32,lx2:i32)i32 {
    let pool:[]u8=ppool.*;
    let uso:[]u8=nio_alloc(256); let usl:[]u8=nio_alloc(256);
    let upar:[]u8=nio_alloc(256); let nst:i32=0;
    live_uf_build(db,r1o,r1l,r2o,r2l,nr,rshard,rslot,ppool,
        ox1,lx1,ox2,lx2,1,&uso,&usl,&upar,&nst);
    let vi:i32=0;
    while(vi<nv){
        if(syn_is_live(db,u32get(vshard,vi*4) as i32,u32get(vslot,vi*4) as i32)==1){
            let a0:i32=u32get(v1o,vi*4) as i32; let al:i32=u32get(v1l,vi*4) as i32;
            let b0:i32=u32get(v2o,vi*4) as i32; let bl:i32=u32get(v2l,vi*4) as i32;
            let va:[]u8=stem(pool[a0..a0+al]); let vb:[]u8=stem(pool[b0..b0+bl]);
            let ia:i32=uf_add(&uso,&usl,&upar,&nst,ppool,a0,va.len);
            let ib:i32=uf_add(&uso,&usl,&upar,&nst,ppool,b0,vb.len);
            if(uf_find(upar,ia)==uf_find(upar,ib)){return 1;}
        }
        vi=vi+1;
    }
    return 0;
}

// 1 if the stem pair (ox1/lx1)-(ox2/lx2) is transitively connected through
// LIVE relations (no extra edge)
fn live_connected(db:*SynDb,
    r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,nr:i32,rshard:[]u8,rslot:[]u8,
    ppool:*[]u8,ox1:i32,lx1:i32,ox2:i32,lx2:i32)i32 {
    let uso:[]u8=nio_alloc(256); let usl:[]u8=nio_alloc(256);
    let upar:[]u8=nio_alloc(256); let nst:i32=0;
    live_uf_build(db,r1o,r1l,r2o,r2l,nr,rshard,rslot,ppool,
        0,0,0,0,0,&uso,&usl,&upar,&nst);
    let a:i32=uf_add(&uso,&usl,&upar,&nst,ppool,ox1,lx1);
    let b:i32=uf_add(&uso,&usl,&upar,&nst,ppool,ox2,lx2);
    if(uf_find(upar,a)==uf_find(upar,b)){return 1;}
    return 0;
}

// ---------- deliberate consideration ----------

// install one positive pair with nl2 witnessing lids; returns the row index
fn delib_install(db:*SynDb,dir:[]u8,pseq:*i32,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,pnr:*i32,
    plo:*[]u8,pll:*[]u8,plhead:*[]u8,pltail:*[]u8,plnext:*[]u8,pln:*[]u8,pnl:*i32,
    prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    ppool:*[]u8,ppooln:*i32,
    uid:[]u8,chan:[]u8,rule:[]u8,xa:i32,xb:i32,ya:i32,yb:i32,mask:i32,
    lo2:[]u8,ll2:[]u8,nl2:i32)i32 {
    let pool:[]u8=ppool.*;
    let idx:i32=rel_add(pr1o,pr1l,pr2o,pr2l,prrules,pnr,ppool,xa,xb,ya,yb,mask);
    let li:i32=0;
    while(li<nl2){
        lid_add(plo,pll,plhead,pltail,plnext,pln,pnl,idx,
            u32get(lo2,li*4) as i32,u32get(ll2,li*4) as i32,ppool);
        li=li+1;
    }
    let nsh:i32=0; let nsl:i32=0;
    let rc:i32=syn_install(db,SYN_VAL_BASE+(mask&SYN_RULE_MASK),&nsh,&nsl);
    if(rc==MA_OK){
        grow_to(prshard,(idx+1)*4); grow_to(prslot,(idx+1)*4); grow_to(prsync,(idx+1)*4);
        u32put(prshard.*,idx*4,nsh as i64); u32put(prslot.*,idx*4,nsl as i64);
        u32put(prsync.*,idx*4,1);
    }
    let w1:[]u8=pool[xa..xa+xb]; let w2:[]u8=pool[ya..ya+yb];
    let g:[]u8=concat("prior=UNKNOWN;veto=CLEAN;closure=CLEAN;chan=",chan);
    let g2:[]u8=concat(g,concat(";ev=",i64s(nl2 as i64)));
    jlog(dir,pseq,uid,chan,rule,w1,w2,"INSTALL",g2,"");
    return idx;
}

// deliberate positive consideration of one witnessed pair.
// xa/xb, ya/yb: pool (offset,len) of the raw words. mask: 1=R1,2=R2,4=R3.
// lo2/ll2/nl2: witnessing utterance (off,len) pairs.
fn consider_pos(db:*SynDb,dir:[]u8,pseq:*i32,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,pnr:*i32,
    plo:*[]u8,pll:*[]u8,plhead:*[]u8,pltail:*[]u8,plnext:*[]u8,pln:*[]u8,pnl:*i32,
    pv1o:*[]u8,pv1l:*[]u8,pv2o:*[]u8,pv2l:*[]u8,pnv:*i32,
    prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    pvshard:*[]u8,pvslot:*[]u8,
    ppool:*[]u8,ppooln:*i32,
    uid:[]u8,chan:[]u8,rule:[]u8,xa:i32,xb:i32,ya:i32,yb:i32,mask:i32,
    lo2:[]u8,ll2:[]u8,nl2:i32,
    psupp:*i32,pwith:*i32,pinst:*i32,pevid:*i32)void {
    let pool:[]u8=ppool.*;
    let sx:[]u8=stem(pool[xa..xa+xb]);
    let sy:[]u8=stem(pool[ya..ya+yb]);
    let w1:[]u8=pool[xa..xa+xb]; let w2:[]u8=pool[ya..ya+yb];
    let slx:i32=sx.len; let sly:i32=sy.len;
    if(bytes_eq(sx,sy)==1){
        jlog(dir,pseq,uid,chan,rule,w1,w2,"IGNORE","prior=SELF-PAIR;grounds=self-pair","");
        return;
    }
    // provenance check: constructed content may be noticed, never believed
    if(bytes_eq(chan,"OBS")!=1){
        jlog(dir,pseq,uid,chan,rule,w1,w2,"REFUSE-CONSTRUCTED",
             concat("chan=",chan),"");
        return;
    }
    // belief consultation: live veto?
    if(live_vetoed(db,pv1o.*,pv1l.*,pv2o.*,pv2l.*,pnv.*,pvshard.*,pvslot.*,pool,sx,sy)==1){
        jlog(dir,pseq,uid,chan,rule,w1,w2,"SUPPRESSED",
             "prior=VETOED;veto=BLOCKED;chan=OBS","");
        psupp.*=psupp.*+1;
        return;
    }
    // already believed? accumulate evidence; re-ground if the rule set grows
    let ri:i32=live_rel_find(db,pr1o.*,pr1l.*,pr2o.*,pr2l.*,pnr.*,
                             prshard.*,prslot.*,pool,sx,sy);
    if(ri>=0){
        let oldm:i32=u32get(prrules.*,ri*4) as i32;
        let newm:i32=oldm|mask;
        let merged:[]u8="0";
        if(newm!=oldm){
            u32put(prrules.*,ri*4,newm as i64);
            merged="1";
            // re-ground the substrate belief on the merged rule set
            let sh:i32=u32get(prshard.*,ri*4) as i32;
            let sl:i32=u32get(prslot.*,ri*4) as i32;
            let krc:i32=syn_kill(db,sh,sl);
            if(krc==MA_OK){
                let nsh:i32=0; let nsl:i32=0;
                let irc:i32=syn_install(db,SYN_VAL_BASE+(newm&SYN_RULE_MASK),&nsh,&nsl);
                if(irc==MA_OK){
                    u32put(prshard.*,ri*4,nsh as i64); u32put(prslot.*,ri*4,nsl as i64);
                }
            }
        }
        let li:i32=0;
        while(li<nl2){
            lid_add(plo,pll,plhead,pltail,plnext,pln,pnl,ri,
                u32get(lo2,li*4) as i32,u32get(ll2,li*4) as i32,ppool);
            li=li+1;
        }
        let g:[]u8=concat("prior=KNOWN;veto=CLEAN;chan=OBS;ev=",i64s(nl2 as i64));
        let g2:[]u8=concat(g,concat(";mask-merged=",merged));
        jlog(dir,pseq,uid,chan,rule,w1,w2,"EVIDENCE",g2,"");
        pevid.*=pevid.*+1;
        return;
    }
    // consistency check: would this install transitively violate a live veto?
    if(live_would_violate(db,
        pr1o.*,pr1l.*,pr2o.*,pr2l.*,pnr.*,prshard.*,prslot.*,
        pv1o.*,pv1l.*,pv2o.*,pv2l.*,pnv.*,pvshard.*,pvslot.*,
        ppool,xa,slx,ya,sly)==1){
        jlog(dir,pseq,uid,chan,rule,w1,w2,"WITHHELD",
             "prior=UNKNOWN;veto=CLEAN;closure=VIOLATION;chan=OBS","");
        pwith.*=pwith.*+1;
        return;
    }
    // deliberate install through the unified substrate only
    delib_install(db,dir,pseq,
        pr1o,pr1l,pr2o,pr2l,prrules,pnr,
        plo,pll,plhead,pltail,plnext,pln,pnl,
        prshard,prslot,prsync,ppool,ppooln,
        uid,chan,rule,xa,xb,ya,yb,mask,lo2,ll2,nl2);
    pinst.*=pinst.*+1;
    return;
}

// deliberate veto consideration of one R4 pair, with positive->veto revision
fn consider_veto(db:*SynDb,dir:[]u8,pseq:*i32,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,pnr:*i32,
    pv1o:*[]u8,pv1l:*[]u8,pv2o:*[]u8,pv2l:*[]u8,pvlido:*[]u8,pvlidl:*[]u8,pnv:*i32,
    prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    pvshard:*[]u8,pvslot:*[]u8,pvsync:*[]u8,
    ppool:*[]u8,ppooln:*i32,
    uid:[]u8,chan:[]u8,xa:i32,xb:i32,ya:i32,yb:i32,lido:i32,lidl:i32,
    pinstv:*i32,previse:*i32,pconf:*i32)void {
    let pool:[]u8=ppool.*;
    let sx:[]u8=stem(pool[xa..xa+xb]);
    let sy:[]u8=stem(pool[ya..ya+yb]);
    let w1:[]u8=pool[xa..xa+xb]; let w2:[]u8=pool[ya..ya+yb];
    if(bytes_eq(sx,sy)==1){
        jlog(dir,pseq,uid,chan,"R4",w1,w2,"IGNORE","prior=SELF-PAIR;grounds=self-pair","");
        return;
    }
    // provenance check: constructed content may be noticed, never believed
    if(bytes_eq(chan,"OBS")!=1){
        jlog(dir,pseq,uid,chan,"R4",w1,w2,"REFUSE-CONSTRUCTED",
             concat("chan=",chan),"");
        return;
    }
    // already vetoed (live or dead row)? accumulate, no new install
    let vr:i32=veto_row_find(pv1o.*,pv1l.*,pv2o.*,pv2l.*,pnv.*,pool,sx,sy);
    if(vr>=0){
        let lv:[]u8="DEAD";
        if(syn_is_live(db,u32get(pvshard.*,vr*4) as i32,u32get(pvslot.*,vr*4) as i32)==1){lv="LIVE";}
        jlog(dir,pseq,uid,chan,"R4",w1,w2,"EVIDENCE",
             concat("prior=KNOWN-VETO;state=",concat(lv,";chan=OBS")),"");
        return;
    }
    // deliberate veto install through the unified substrate
    let k:i32=pnv.*;
    veto_add(pv1o,pv1l,pv2o,pv2l,pvlido,pvlidl,pnv,ppool,xa,xb,ya,yb,lido,lidl);
    let nsh:i32=0; let nsl:i32=0;
    let rc:i32=syn_install(db,VETO_VAL,&nsh,&nsl);
    if(rc==MA_OK){
        grow_to(pvshard,(k+1)*4); grow_to(pvslot,(k+1)*4); grow_to(pvsync,(k+1)*4);
        u32put(pvshard.*,k*4,nsh as i64); u32put(pvslot.*,k*4,nsl as i64);
        u32put(pvsync.*,k*4,1);
    }
    jlog(dir,pseq,uid,chan,"R4",w1,w2,"INSTALL-VETO","prior=UNKNOWN;chan=OBS","");
    pinstv.*=pinstv.*+1;
    // revision: a live positive belief for this pair must be withdrawn
    let ri:i32=live_rel_find(db,pr1o.*,pr1l.*,pr2o.*,pr2l.*,pnr.*,
                             prshard.*,prslot.*,pool,sx,sy);
    if(ri>=0){
        let sh:i32=u32get(prshard.*,ri*4) as i32;
        let sl:i32=u32get(prslot.*,ri*4) as i32;
        let krc:i32=syn_kill(db,sh,sl);
        jlog(dir,pseq,uid,chan,"R4",w1,w2,"REVISE",
             concat("withdrew-live-relation;kill-rc=",i64s(krc as i64)),"");
        previse.*=previse.*+1;
        // residual check: still transitively connected through other beliefs?
        if(live_connected(db,
            pr1o.*,pr1l.*,pr2o.*,pr2l.*,pnr.*,prshard.*,prslot.*,
            ppool,xa,sx.len,ya,sy.len)==1){
            jlog(dir,pseq,uid,chan,"R4",w1,w2,"CONFLICT",
                 "vetoed-pair-still-transitively-connected","");
            pconf.*=pconf.*+1;
        }
    }
    return;
}

// ---------- PARA accumulation (R3) ----------
// Subjects accumulate OBS lines; two lines from one subject with a
// single-word difference form a candidate; a second witnessing candidate
// triggers deliberate install. A third line withdraws the pending candidate.

fn subj_find_or_add(psjo:*[]u8,psjl:*[]u8,psjn:*[]u8,psjw:*[]u8,pns:*i32,
    psj_head:*[]u8,ppool:*[]u8,ppooln:*i32,subj:[]u8)i32 {
    let sjo:[]u8=psjo.*; let sjl:[]u8=psjl.*;
    let pool:[]u8=ppool.*;
    let i:i32=0;
    while(i<pns.*){
        let a:i32=u32get(sjo,i*4) as i32; let b:i32=u32get(sjl,i*4) as i32;
        if(bytes_eq(pool[a..a+b],subj)==1){return i;}
        i=i+1;
    }
    let ns:i32=pns.*;
    grow_to(psjo,(ns+1)*4); grow_to(psjl,(ns+1)*4);
    grow_to(psjn,(ns+1)*4); grow_to(psjw,(ns+1)*4); grow_to(psj_head,(ns+1)*4);
    let hs:[]u8=pool_copy(subj,ppool,ppooln);
    u32put(psjo.*,ns*4,h_off(hs) as i64); u32put(psjl.*,ns*4,h_len(hs) as i64);
    u32put(psjn.*,ns*4,0); u32put(psjw.*,ns*4,0);
    u32put(psj_head.*,ns*4,4294967295);
    pns.*=ns+1;
    return ns;
}

// append one line node to a subject; returns node index
fn subj_add_node(psjn:*[]u8,psj_head:*[]u8,
    ppl_uido:*[]u8,ppl_uidl:*[]u8,ppl_txo:*[]u8,ppl_txl:*[]u8,
    ppl_nxt:*[]u8,ppl_subj:*[]u8,pnpl:*i32,
    si:i32,uido:i32,uidl:i32,txo:i32,txl:i32)i32 {
    let n:i32=pnpl.*;
    grow_to(ppl_uido,(n+1)*4); grow_to(ppl_uidl,(n+1)*4);
    grow_to(ppl_txo,(n+1)*4); grow_to(ppl_txl,(n+1)*4);
    grow_to(ppl_nxt,(n+1)*4); grow_to(ppl_subj,(n+1)*4);
    u32put(ppl_uido.*,n*4,uido as i64); u32put(ppl_uidl.*,n*4,uidl as i64);
    u32put(ppl_txo.*,n*4,txo as i64); u32put(ppl_txl.*,n*4,txl as i64);
    u32put(ppl_nxt.*,n*4,4294967295); u32put(ppl_subj.*,n*4,si as i64);
    // link at head (order within a subject does not matter for pairing)
    u32put(ppl_nxt.*,n*4,u32get(psj_head.*,si*4));
    u32put(psj_head.*,si*4,n as i64);
    u32put(psjn.*,si*4,(u32get(psjn.*,si*4) as i64)+1);
    pnpl.*=n+1;
    return n;
}

// the two lines of a subject as node indices; -1 if absent
fn subj_two_nodes(sj_head:[]u8,pl_nxt:[]u8,si:i32,pa:*i32,pb:*i32)void {
    let a:i32=u32get(sj_head,si*4) as i32;
    let b:i32=-1;
    if(a>=0){b=u32get(pl_nxt,a*4) as i32;}
    pa.*=a; pb.*=b;
    return;
}

// add a candidate to the pool
fn cand_add(pcxo:*[]u8,pcxl:*[]u8,pcyo:*[]u8,pcyl:*[]u8,
    pcl1o:*[]u8,pcl1l:*[]u8,pcl2o:*[]u8,pcl2l:*[]u8,pcnc:*i32,
    xo:i32,xl:i32,yo:i32,yl:i32,l1o:i32,l1l:i32,l2o:i32,l2l:i32)i32 {
    let n:i32=pcnc.*;
    grow_to(pcxo,(n+1)*4); grow_to(pcxl,(n+1)*4);
    grow_to(pcyo,(n+1)*4); grow_to(pcyl,(n+1)*4);
    grow_to(pcl1o,(n+1)*4); grow_to(pcl1l,(n+1)*4);
    grow_to(pcl2o,(n+1)*4); grow_to(pcl2l,(n+1)*4);
    u32put(pcxo.*,n*4,xo as i64); u32put(pcxl.*,n*4,xl as i64);
    u32put(pcyo.*,n*4,yo as i64); u32put(pcyl.*,n*4,yl as i64);
    u32put(pcl1o.*,n*4,l1o as i64); u32put(pcl1l.*,n*4,l1l as i64);
    u32put(pcl2o.*,n*4,l2o as i64); u32put(pcl2l.*,n*4,l2l as i64);
    pcnc.*=n+1;
    return n;
}

// remove candidate ci from the pool (swap-with-last); returns new count
fn cand_remove(pcxo:*[]u8,pcxl:*[]u8,pcyo:*[]u8,pcyl:*[]u8,
    pcl1o:*[]u8,pcl1l:*[]u8,pcl2o:*[]u8,pcl2l:*[]u8,pcnc:*i32,ci:i32)void {
    let n:i32=pcnc.*-1;
    if(ci!=n){
        u32put(pcxo.*,ci*4,u32get(pcxo.*,n*4)); u32put(pcxl.*,ci*4,u32get(pcxl.*,n*4));
        u32put(pcyo.*,ci*4,u32get(pcyo.*,n*4)); u32put(pcyl.*,ci*4,u32get(pcyl.*,n*4));
        u32put(pcl1o.*,ci*4,u32get(pcl1o.*,n*4)); u32put(pcl1l.*,ci*4,u32get(pcl1l.*,n*4));
        u32put(pcl2o.*,ci*4,u32get(pcl2o.*,n*4)); u32put(pcl2l.*,ci*4,u32get(pcl2l.*,n*4));
    }
    pcnc.*=n;
    return;
}

// find this subject's pending candidate in the pool (by the two line uids)
fn cand_find_subj(cxo:[]u8,cxl:[]u8,cl1o:[]u8,cl1l:[]u8,cl2o:[]u8,cl2l:[]u8,ncand:i32,
    pool:[]u8,l1o:i32,l1l:i32,l2o:i32,l2l:i32)i32 {
    let i:i32=0;
    while(i<ncand){
        let a:i32=u32get(cl1o,i*4) as i32; let al:i32=u32get(cl1l,i*4) as i32;
        let b:i32=u32get(cl2o,i*4) as i32; let bl:i32=u32get(cl2l,i*4) as i32;
        if((l1l==al&&l2l==bl&&weq(pool,a,al,l1o,l1l)==1&&weq(pool,b,bl,l2o,l2l)==1)
        ||(l1l==bl&&l2l==al&&weq(pool,b,bl,l1o,l1l)==1&&weq(pool,a,al,l2o,l2l)==1)){return i;}
        i=i+1;
    }
    return -1;
}

// one PARA line through deliberation.
// replay=1: rebuild subjects/candidates from the journal without journaling.
fn para_line(db:*SynDb,dir:[]u8,pseq:*i32,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,pnr:*i32,
    plo:*[]u8,pll:*[]u8,plhead:*[]u8,pltail:*[]u8,plnext:*[]u8,pln:*[]u8,pnl:*i32,
    pv1o:*[]u8,pv1l:*[]u8,pv2o:*[]u8,pv2l:*[]u8,pnv:*i32,
    prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    pvshard:*[]u8,pvslot:*[]u8,
    ppool:*[]u8,ppooln:*i32,
    psjo:*[]u8,psjl:*[]u8,psjn:*[]u8,psjw:*[]u8,pns:*i32,psj_head:*[]u8,
    ppl_uido:*[]u8,ppl_uidl:*[]u8,ppl_txo:*[]u8,ppl_txl:*[]u8,
    ppl_nxt:*[]u8,ppl_subj:*[]u8,pnpl:*i32,
    pcxo:*[]u8,pcxl:*[]u8,pcyo:*[]u8,pcyl:*[]u8,
    pcl1o:*[]u8,pcl1l:*[]u8,pcl2o:*[]u8,pcl2l:*[]u8,pcnc:*i32,
    uid:[]u8,chan:[]u8,subj:[]u8,text:[]u8,replay:i32,
    psupp:*i32,pwith:*i32,pinst:*i32,pevid:*i32)void {
    let pool:[]u8=ppool.*;
    if(bytes_eq(chan,"OBS")!=1){
        if(replay==0){
            jlog(dir,pseq,uid,chan,"PARA",subj,"-","REFUSE-CONSTRUCTED",
                 concat("chan=",chan),text);
        }
        return;
    }
    let huid:[]u8=pool_copy(uid,ppool,ppooln);
    let htx:[]u8=pool_copy(text,ppool,ppooln);
    let uido:i32=h_off(huid); let uidl:i32=h_len(huid);
    let txo:i32=h_off(htx); let txl:i32=h_len(htx);
    pool=ppool.*;
    let si:i32=subj_find_or_add(psjo,psjl,psjn,psjw,pns,psj_head,ppool,ppooln,subj);
    subj_add_node(psjn,psj_head,ppl_uido,ppl_uidl,ppl_txo,ppl_txl,
        ppl_nxt,ppl_subj,pnpl,si,uido,uidl,txo,txl);
    let n:i32=u32get(psjn.*,si*4) as i32;
    if(replay==0){
        jlog(dir,pseq,uid,chan,"PARA",subj,"-","ACCUMULATE",
             concat("n=",i64s(n as i64)),text);
    }
    if(n==2){
        // pair the two lines and form a candidate on a single-word difference
        let la:i32=-1; let lb:i32=-1;
        subj_two_nodes(psj_head.*,ppl_nxt.*,si,&la,&lb);
        let t1o:i32=u32get(ppl_txo.*,la*4) as i32; let t1l:i32=u32get(ppl_txl.*,la*4) as i32;
        let t2o:i32=u32get(ppl_txo.*,lb*4) as i32; let t2l:i32=u32get(ppl_txl.*,lb*4) as i32;
        let w1o:[]u8=nio_alloc(256); let w1l:[]u8=nio_alloc(256);
        let w2o:[]u8=nio_alloc(256); let w2l:[]u8=nio_alloc(256);
        // tokenize_words interns words into the pool and returns pool offsets
        let pl0:[]u8=ppool.*;
        let n1:i32=tokenize_words(pl0[t1o..t1o+t1l],&w1o,&w1l,ppool,ppooln);
        let pl1:[]u8=ppool.*;
        let n2:i32=tokenize_words(pl1[t2o..t2o+t2l],&w2o,&w2l,ppool,ppooln);
        pool=ppool.*;
        if(n1==n2){
            let dpos:i32=-1; let dcnt:i32=0;
            let k:i32=0;
            while(k<n1){
                let a:i32=u32get(w1o,k*4) as i32; let al:i32=u32get(w1l,k*4) as i32;
                let b:i32=u32get(w2o,k*4) as i32; let bl:i32=u32get(w2l,k*4) as i32;
                if(al!=bl||weq(pool,a,al,b,bl)!=1){dpos=k;dcnt=dcnt+1;}
                k=k+1;
            }
            if(dcnt==1){
                let xa:i32=u32get(w1o,dpos*4) as i32; let xb:i32=u32get(w1l,dpos*4) as i32;
                let ya:i32=u32get(w2o,dpos*4) as i32; let yb:i32=u32get(w2l,dpos*4) as i32;
                // la=head=newer line, lb=head.next=older line; lids stored in
                // arrival order (older first) to match batch corpus order
                let l1o:i32=u32get(ppl_uido.*,lb*4) as i32; let l1l:i32=u32get(ppl_uidl.*,lb*4) as i32;
                let l2o:i32=u32get(ppl_uido.*,la*4) as i32; let l2l:i32=u32get(ppl_uidl.*,la*4) as i32;
                cand_add(pcxo,pcxl,pcyo,pcyl,pcl1o,pcl1l,pcl2o,pcl2l,pcnc,
                    xa,xb,ya,yb,l1o,l1l,l2o,l2l);
                if(replay==0){
                    let w1:[]u8=pool[xa..xa+xb]; let w2:[]u8=pool[ya..ya+yb];
                    jlog(dir,pseq,uid,chan,"R3",w1,w2,"CANDIDATE",
                         concat("subj=",subj),"");
                }
                // deliberate witness check over the whole pool
                let sx:[]u8=stem(pool[xa..xa+xb]);
                let sy:[]u8=stem(pool[ya..ya+yb]);
                let wit:i32=0;
                let wi:i32=0;
                while(wi<pcnc.*){
                    let a:i32=u32get(pcxo.*,wi*4) as i32; let al:i32=u32get(pcxl.*,wi*4) as i32;
                    let b:i32=u32get(pcyo.*,wi*4) as i32; let bl:i32=u32get(pcyl.*,wi*4) as i32;
                    let va:[]u8=stem(pool[a..a+al]); let vb:[]u8=stem(pool[b..b+bl]);
                    if((bytes_eq(va,sx)==1&&bytes_eq(vb,sy)==1)
                    ||(bytes_eq(va,sy)==1&&bytes_eq(vb,sx)==1)){wit=wit+1;}
                    wi=wi+1;
                }
                if(wit>=2&&replay==0){
                    // gather witnessing lids and deliberate
                    let lo2:[]u8=nio_alloc(512); let ll2:[]u8=nio_alloc(512);
                    let nl2:i32=0;
                    let gi:i32=0;
                    while(gi<pcnc.*){
                        let a:i32=u32get(pcxo.*,gi*4) as i32; let al:i32=u32get(pcxl.*,gi*4) as i32;
                        let b:i32=u32get(pcyo.*,gi*4) as i32; let bl:i32=u32get(pcyl.*,gi*4) as i32;
                        let va:[]u8=stem(pool[a..a+al]); let vb:[]u8=stem(pool[b..b+bl]);
                        if((bytes_eq(va,sx)==1&&bytes_eq(vb,sy)==1)
                        ||(bytes_eq(va,sy)==1&&bytes_eq(vb,sx)==1)){
                            grow_to(&lo2,(nl2+1)*4); grow_to(&ll2,(nl2+1)*4);
                            u32put(lo2,nl2*4,u32get(pcl1o.*,gi*4));
                            u32put(ll2,nl2*4,u32get(pcl1l.*,gi*4));
                            nl2=nl2+1;
                            grow_to(&lo2,(nl2+1)*4); grow_to(&ll2,(nl2+1)*4);
                            u32put(lo2,nl2*4,u32get(pcl2o.*,gi*4));
                            u32put(ll2,nl2*4,u32get(pcl2l.*,gi*4));
                            nl2=nl2+1;
                        }
                        gi=gi+1;
                    }
                    consider_pos(db,dir,pseq,
                        pr1o,pr1l,pr2o,pr2l,prrules,pnr,
                        plo,pll,plhead,pltail,plnext,pln,pnl,
                        pv1o,pv1l,pv2o,pv2l,pnv,
                        prshard,prslot,prsync,pvshard,pvslot,
                        ppool,ppooln,
                        uid,chan,"R3",xa,xb,ya,yb,4,lo2,ll2,nl2,
                        psupp,pwith,pinst,pevid);
                }
            }
        }
    }
    if(n==3){
        // third line: deliberate revision of the premature consideration
        u32put(psjw.*,si*4,1);
        // the candidate was formed at n==2 from the two nodes that are now
        // head.next and head.next.next (the head is the new 3rd line)
        let head:i32=u32get(psj_head.*,si*4) as i32;
        if(head>=0){
            let la2:i32=u32get(ppl_nxt.*,head*4) as i32;
            let lb2:i32=-1;
            if(la2>=0){lb2=u32get(ppl_nxt.*,la2*4) as i32;}
            if(la2>=0&&lb2>=0){
                let t1o:i32=u32get(ppl_uido.*,la2*4) as i32; let t1l:i32=u32get(ppl_uidl.*,la2*4) as i32;
                let t2o:i32=u32get(ppl_uido.*,lb2*4) as i32; let t2l:i32=u32get(ppl_uidl.*,lb2*4) as i32;
                let ci:i32=cand_find_subj(pcxo.*,pcxl.*,pcl1o.*,pcl1l.*,pcl2o.*,pcl2l.*,pcnc.*,
                    ppool.*,t1o,t1l,t2o,t2l);
            if(ci>=0){
                if(replay==0){
                    let xa:i32=u32get(pcxo.*,ci*4) as i32; let xb:i32=u32get(pcxl.*,ci*4) as i32;
                    let ya:i32=u32get(pcyo.*,ci*4) as i32; let yb:i32=u32get(pcyl.*,ci*4) as i32;
                    let w1:[]u8=pool[xa..xa+xb]; let w2:[]u8=pool[ya..ya+yb];
                    jlog(dir,pseq,uid,chan,"R3",w1,w2,"WITHDRAW",
                         concat("subj=",concat(subj,";n=3")),"");
                }
                cand_remove(pcxo,pcxl,pcyo,pcyl,pcl1o,pcl1l,pcl2o,pcl2l,pcnc,ci);
            }
        }
        }
    }
    return;
}

// ---------- journal replay ----------
// Rebuilds PARA subjects/candidates from delib.log; returns next seq.
// Replay never journals and never installs: deliberation is not re-run.
fn journal_replay(db:*SynDb,dir:[]u8,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,pnr:*i32,
    plo:*[]u8,pll:*[]u8,plhead:*[]u8,pltail:*[]u8,plnext:*[]u8,pln:*[]u8,pnl:*i32,
    pv1o:*[]u8,pv1l:*[]u8,pv2o:*[]u8,pv2l:*[]u8,pnv:*i32,
    prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    pvshard:*[]u8,pvslot:*[]u8,
    ppool:*[]u8,ppooln:*i32,
    psjo:*[]u8,psjl:*[]u8,psjn:*[]u8,psjw:*[]u8,pns:*i32,psj_head:*[]u8,
    ppl_uido:*[]u8,ppl_uidl:*[]u8,ppl_txo:*[]u8,ppl_txl:*[]u8,
    ppl_nxt:*[]u8,ppl_subj:*[]u8,pnpl:*i32,
    pcxo:*[]u8,pcxl:*[]u8,pcyo:*[]u8,pcyl:*[]u8,
    pcl1o:*[]u8,pcl1l:*[]u8,pcl2o:*[]u8,pcl2l:*[]u8,pcnc:*i32)i32 {
    let raw:[]u8=f_read(path_join(dir,"delib.log"));
    if(raw.len==0){return 0;}
    let seq:i32=0;
    let bl:[]u8=lines_of(raw);
    let nl:i32=line_n(bl);
    let z0:i32=0; let z1:i32=0; let z2:i32=0; let z3:i32=0;
    let supp:i32=0; let with:i32=0; let inst:i32=0; let evid:i32=0;
    let k:i32=0;
    while(k<nl){
        seq=seq+1;
        let lin:[]u8=line_slice(raw,bl,k);
        let f:[]u8=fields_of(lin,124,10);
        // J|seq|uid|chan|rule|w1|w2|decision|grounds|text
        if(fld_n(f)==10&&bytes_eq(fa_f(f,lin,0),"J")==1
        &&bytes_eq(fa_f(f,lin,4),"PARA")==1&&bytes_eq(fa_f(f,lin,7),"ACCUMULATE")==1){
            para_line(db,dir,&z0,
                pr1o,pr1l,pr2o,pr2l,prrules,pnr,
                plo,pll,plhead,pltail,plnext,pln,pnl,
                pv1o,pv1l,pv2o,pv2l,pnv,
                prshard,prslot,prsync,pvshard,pvslot,
                ppool,ppooln,
                psjo,psjl,psjn,psjw,pns,psj_head,
                ppl_uido,ppl_uidl,ppl_txo,ppl_txl,ppl_nxt,ppl_subj,pnpl,
                pcxo,pcxl,pcyo,pcyl,pcl1o,pcl1l,pcl2o,pcl2l,pcnc,
                fa_f(f,lin,2),fa_f(f,lin,3),fa_f(f,lin,5),fa_f(f,lin,9),1,
                &supp,&with,&inst,&evid);
        }
        k=k+1;
    }
    return seq;
}

// ---------- main ----------

fn live_usage()void {
    _zag_print("live stream <uttfile> <dir>  - deliberate over an utterance stream\n");
    _zag_print("live journal <dir>           - print the deliberation journal\n");
    return;
}

fn main()void {
    let cmd:[]u8=_zag_arg(1);
    if(bytes_eq(cmd,"journal")==1){
        let dir:[]u8=_zag_arg(2);
        _zag_print(f_read(path_join(dir,"delib.log")));
        return;
    }
    if(bytes_eq(cmd,"stream")!=1){live_usage();return;}
    let uttfile:[]u8=_zag_arg(2);
    let dir:[]u8=_zag_arg(3);
    if(uttfile.len==0||dir.len==0){live_usage();return;}
    f_mkdir(dir);
    // substrate
    let db:SynDb=syndb_new();
    syn_load(&db,dir);
    // content tables (shared format with learn.zag)
    let r1o:[]u8=nio_alloc(256); let r1l:[]u8=nio_alloc(256);
    let r2o:[]u8=nio_alloc(256); let r2l:[]u8=nio_alloc(256);
    let rrules:[]u8=nio_alloc(256);
    let lo:[]u8=nio_alloc(256); let ll:[]u8=nio_alloc(256);
    let lhead:[]u8=nio_alloc(256); let ltail:[]u8=nio_alloc(256);
    let lnext:[]u8=nio_alloc(256); let ln:[]u8=nio_alloc(256);
    let v1o:[]u8=nio_alloc(256); let v1l:[]u8=nio_alloc(256);
    let v2o:[]u8=nio_alloc(256); let v2l:[]u8=nio_alloc(256);
    let vlido:[]u8=nio_alloc(256); let vlidl:[]u8=nio_alloc(256);
    let pool:[]u8=nio_alloc(65536);
    let rshard:[]u8=nio_alloc(256); let rslot:[]u8=nio_alloc(256); let rsync:[]u8=nio_alloc(256);
    let vshard:[]u8=nio_alloc(256); let vslot:[]u8=nio_alloc(256); let vsync:[]u8=nio_alloc(256);
    let nr:i32=0; let nv:i32=0; let nl:i32=0; let pooln:i32=0;
    let trc:i32=tables_load(dir,&nr,&nv,&nl,&pooln,
        &r1o,&r1l,&r2o,&r2l,&rrules,
        &lo,&ll,&lhead,&ltail,&lnext,&ln,
        &v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,
        &pool,&rshard,&rslot,&rsync,&vshard,&vslot,&vsync);
    if(trc==0){
        // fresh store: lid chains start empty (-1); loaded stores keep theirs
        let zi:i32=0;
        while(zi*4<lhead.len){
            u32put(lhead,zi*4,4294967295); u32put(ltail,zi*4,4294967295);
            u32put(lnext,zi*4,4294967295); u32put(ln,zi*4,0);
            zi=zi+1;
        }
    }
    // deliberation state: PARA subjects, line nodes, candidate pool
    let sjo:[]u8=nio_alloc(256); let sjl:[]u8=nio_alloc(256);
    let sjn:[]u8=nio_alloc(256); let sjw:[]u8=nio_alloc(256);
    let sj_head:[]u8=nio_alloc(256);
    let ns:i32=0;
    let pl_uido:[]u8=nio_alloc(256); let pl_uidl:[]u8=nio_alloc(256);
    let pl_txo:[]u8=nio_alloc(256); let pl_txl:[]u8=nio_alloc(256);
    let pl_nxt:[]u8=nio_alloc(256); let pl_subj:[]u8=nio_alloc(256);
    let npl:i32=0;
    let cxo:[]u8=nio_alloc(256); let cxl:[]u8=nio_alloc(256);
    let cyo:[]u8=nio_alloc(256); let cyl:[]u8=nio_alloc(256);
    let cl1o:[]u8=nio_alloc(256); let cl1l:[]u8=nio_alloc(256);
    let cl2o:[]u8=nio_alloc(256); let cl2l:[]u8=nio_alloc(256);
    let ncand:i32=0;
    // replay the journal into PARA state (never re-deliberates, never installs)
    let seq:i32=journal_replay(&db,dir,
        &r1o,&r1l,&r2o,&r2l,&rrules,&nr,
        &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
        &v1o,&v1l,&v2o,&v2l,&nv,
        &rshard,&rslot,&rsync,&vshard,&vslot,
        &pool,&pooln,
        &sjo,&sjl,&sjn,&sjw,&ns,&sj_head,
        &pl_uido,&pl_uidl,&pl_txo,&pl_txl,&pl_nxt,&pl_subj,&npl,
        &cxo,&cxl,&cyo,&cyl,&cl1o,&cl1l,&cl2o,&cl2l,&ncand);
    // stream the utterances
    let raw:[]u8=f_read(uttfile);
    let bl:[]u8=lines_of(raw);
    let nu:i32=line_n(bl);
    let n_utt:i32=0; let n_match:i32=0;
    let n_inst:i32=0; let n_evid:i32=0;
    let n_sup:i32=0; let n_with:i32=0; let n_ref:i32=0;
    let n_veto:i32=0; let n_rev:i32=0; let n_conf:i32=0;
    let k:i32=0;
    while(k<nu){
        let lin:[]u8=line_slice(raw,bl,k);
        let f:[]u8=fields_of(lin,124,6);
        if(fld_n(f)>=5&&bytes_eq(fa_f(f,lin,0),"UTT")==1){
            let uid:[]u8=fa_f(f,lin,1);
            let chan:[]u8=fa_f(f,lin,2);
            let pat:[]u8=fa_f(f,lin,3);
            n_utt=n_utt+1;
            if(bytes_eq(pat,"PARA")==1&&fld_n(f)>=6){
                para_line(&db,dir,&seq,
                    &r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                    &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
                    &v1o,&v1l,&v2o,&v2l,&nv,
                    &rshard,&rslot,&rsync,&vshard,&vslot,
                    &pool,&pooln,
                    &sjo,&sjl,&sjn,&sjw,&ns,&sj_head,
                    &pl_uido,&pl_uidl,&pl_txo,&pl_txl,&pl_nxt,&pl_subj,&npl,
                    &cxo,&cxl,&cyo,&cyl,&cl1o,&cl1l,&cl2o,&cl2l,&ncand,
                    uid,chan,fa_f(f,lin,4),fa_f(f,lin,5),0,
                    &n_sup,&n_with,&n_inst,&n_evid);
            }
            if(bytes_eq(pat,"PARA")!=1){
                let text:[]u8=fa_f(f,lin,4);
                let huid2:[]u8=pool_copy(uid,&pool,&pooln);
                let wo:[]u8=nio_alloc(256); let wl:[]u8=nio_alloc(256);
                let wn:i32=tokenize_words(text,&wo,&wl,&pool,&pooln);
                let m4:[]u8=match_r4(pool,wo,wl,wn);
                if(u32get(m4,0)==1){
                    n_match=n_match+1;
                    if(bytes_eq(chan,"OBS")!=1){n_ref=n_ref+1;}
                    consider_veto(&db,dir,&seq,
                        &r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                        &v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,&nv,
                        &rshard,&rslot,&rsync,&vshard,&vslot,&vsync,
                        &pool,&pooln,
                        uid,chan,
                        u32get(m4,4) as i32,u32get(m4,8) as i32,
                        u32get(m4,12) as i32,u32get(m4,16) as i32,
                        h_off(huid2),h_len(huid2),
                        &n_veto,&n_rev,&n_conf);
                }
                if(u32get(m4,0)!=1){
                    let m1:[]u8=match_r1(pool,wo,wl,wn);
                    let m2:[]u8=match_r2(pool,wo,wl,wn);
                    let mk:i32=0; let mm:[]u8=m1;
                    if(u32get(m1,0)==1){mk=1;}
                    if(u32get(m2,0)==1){mk=2;mm=m2;}
                    if(mk>0){
                        n_match=n_match+1;
                        if(bytes_eq(chan,"OBS")!=1){n_ref=n_ref+1;}
                        let rule:[]u8="R1";
                        if(mk==2){rule="R2";}
                        let lo2:[]u8=nio_alloc(8); let ll2:[]u8=nio_alloc(8);
                        u32put(lo2,0,h_off(huid2) as i64); u32put(ll2,0,h_len(huid2) as i64);
                        consider_pos(&db,dir,&seq,
                            &r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                            &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
                            &v1o,&v1l,&v2o,&v2l,&nv,
                            &rshard,&rslot,&rsync,&vshard,&vslot,
                            &pool,&pooln,
                            uid,chan,rule,
                            u32get(mm,4) as i32,u32get(mm,8) as i32,
                            u32get(mm,12) as i32,u32get(mm,16) as i32,
                            mk,lo2,ll2,1,
                            &n_sup,&n_with,&n_inst,&n_evid);
                    }
                }
            }
        }
        k=k+1;
    }
    // persist: shared store format with learn.zag
    tables_save(dir,nr,nv,nl,pooln,
        r1o,r1l,r2o,r2l,rrules,
        lo,ll,lhead,ltail,lnext,ln,
        v1o,v1l,v2o,v2l,vlido,vlidl,
        pool,rshard,rslot,rsync,vshard,vslot,vsync);
    syn_save(&db,dir);
    _zag_print(concat("utterances=",i64s(n_utt as i64)));
    _zag_print(concat(" matched=",i64s(n_match as i64)));
    _zag_print(concat(" installed=",i64s(n_inst as i64)));
    _zag_print(concat(" evidence=",i64s(n_evid as i64)));
    _zag_print(concat(" suppressed=",i64s(n_sup as i64)));
    _zag_print(concat(" withheld=",i64s(n_with as i64)));
    _zag_print(concat(" refused-constructed~=",i64s(n_ref as i64)));
    _zag_print(concat(" vetoes=",i64s(n_veto as i64)));
    _zag_print(concat(" revised=",i64s(n_rev as i64)));
    _zag_print(concat(" conflicts=",i64s(n_conf as i64)));
    _zag_print(concat(" relations=",i64s(nr as i64)));
    _zag_print(concat(" journal-seq=",i64s(seq as i64)));
    _zag_print("\n");
    return;
}

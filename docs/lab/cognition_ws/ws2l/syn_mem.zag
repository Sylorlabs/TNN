// syn_mem.zag — Synonym learning as TNN's own learning (PREREG_SYNINT.md).
//
// Every learned synonym relation is a DELIBERATE MEMORY in the frozen
// deliberate-memory substrate (memory_core.zag, wave3 signed-memory-values
// trial — the MA4 lineage). Frozen substrate code is NOT modified.
//
// - R1/R2/R3 fire -> ma_add(SYN_VAL_BASE + rules_mask), audited.
// - R4 veto      -> ma_add(VETO_VAL) — negative value, MA4 semantics.
// - live[] is the SOLE authority on belief. Retrieval reads live[] only.
// - Elastic capacity via sharding: ma_add hardcodes MA_CAP=256 (frozen),
//   so this module keeps an elastic list of MaStore shards in flat arenas.
//   Each shard IS the substrate (same code/ops/audit format).
// - Symbolic content (stems, evidence IDs) lives in the caller's arena;
//   the (shard,slot) mapping is recorded per relation.
//
// Pure Zag. Deterministic. Zero RNG.
@import("../../wave3/signed-memory-values/trial/memory_core.zag")
@import("lib.zag")

const SYN_VAL_BASE:i32=1000000;
const SYN_RULE_MASK:i32=15;
const VETO_VAL:i32=-1000000;
const SYN_SHARD_LIVE:i32=256;
const SYN_SHARD_VAL:i32=1024;
const SYN_SHARD_PRT:i32=768;
const SYN_SHARD_STEP:i32=1024;
const SYN_SHARD_AUDIT:i32=163840; // MA_AUDIT_CAP*MA_AUDIT_WORDS*4
const SYN_SHARD_NUMS:i32=12;

struct SynDb {
    nshards: i32,
    live: []u8,
    value: []u8,
    prt: []u8,
    step: []u8,
    audit: []u8,
    nums: []u8,
}

fn s32get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn s32put(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn szero(a:[]u8)void {
    let i:i32=0;while(i<a.len){a[i]=0;i=i+1;}
}
// grow arena to at least min_len bytes, preserving content (elastic)
fn sgrow(p:*[]u8,min_len:i32)void {
    let cur:[]u8=p.*;
    if(cur.len>=min_len){return;}
    let nl:i32=cur.len;
    if(nl<256){nl=256;}
    while(nl<min_len){nl=nl*2;}
    let nb:[]u8=nio_alloc(nl);
    let i:i32=0;while(i<cur.len){nb[i]=cur[i];i=i+1;}
    while(i<nl){nb[i]=0;i=i+1;}
    p.*=nb;
}

fn syndb_new()SynDb {
    return SynDb{.nshards=0,.live=nio_alloc(0),.value=nio_alloc(0),
        .prt=nio_alloc(0),.step=nio_alloc(0),.audit=nio_alloc(0),.nums=nio_alloc(0)};
}

// MaStore view over shard si. Slices alias shard memory (mutations land);
// audit_n/stage/clock are written back by syndb_wb.
fn syndb_view(db:*SynDb,si:i32)MaStore {
    let live:[]u8=db.*.live; let value:[]u8=db.*.value;
    let prt:[]u8=db.*.prt; let step:[]u8=db.*.step;
    let audit:[]u8=db.*.audit; let nums:[]u8=db.*.nums;
    let lo:i32=si*SYN_SHARD_LIVE;
    let vo:i32=si*SYN_SHARD_VAL;
    let po:i32=si*SYN_SHARD_PRT;
    let so:i32=si*SYN_SHARD_STEP;
    let ao:i32=si*SYN_SHARD_AUDIT;
    let no:i32=si*SYN_SHARD_NUMS;
    return MaStore{.live=live[lo..lo+SYN_SHARD_LIVE],
        .value=value[vo..vo+SYN_SHARD_VAL],
        .pinned=prt[po..po+256],.region=prt[po+256..po+512],
        .tier=prt[po+512..po+768],
        .step=step[so..so+SYN_SHARD_STEP],
        .audit=audit[ao..ao+SYN_SHARD_AUDIT],
        .audit_n=s32get(nums,no),.stage=s32get(nums,no+4),
        .clock=s32get(nums,no+8)};
}
fn syndb_wb(db:*SynDb,si:i32,s:*MaStore)void {
    let nums:[]u8=db.*.nums;
    let no:i32=si*SYN_SHARD_NUMS;
    s32put(nums,no,s.*.audit_n);s32put(nums,no+4,s.*.stage);
    s32put(nums,no+8,s.*.clock);
}

// Append one zeroed shard; stage set to KILL (full ops) at genesis.
fn syndb_addshard(db:*SynDb)void {
    let si:i32=db.*.nshards;
    let live:[]u8=db.*.live; sgrow(&live,(si+1)*SYN_SHARD_LIVE); db.*.live=live;
    let value:[]u8=db.*.value; sgrow(&value,(si+1)*SYN_SHARD_VAL); db.*.value=value;
    let prt:[]u8=db.*.prt; sgrow(&prt,(si+1)*SYN_SHARD_PRT); db.*.prt=prt;
    let step:[]u8=db.*.step; sgrow(&step,(si+1)*SYN_SHARD_STEP); db.*.step=step;
    let audit:[]u8=db.*.audit; sgrow(&audit,(si+1)*SYN_SHARD_AUDIT); db.*.audit=audit;
    let nums:[]u8=db.*.nums; sgrow(&nums,(si+1)*SYN_SHARD_NUMS); db.*.nums=nums;
    // zero the new shard's regions explicitly (sgrow zeroes new tail)
    s32put(nums,si*SYN_SHARD_NUMS,0);
    s32put(nums,si*SYN_SHARD_NUMS+4,MA_STAGE_KILL);
    s32put(nums,si*SYN_SHARD_NUMS+8,0);
    db.*.nshards=si+1;
}

// Install value as a deliberate memory. Returns MA_OK (or error); on
// success pshard/pslot hold the location. Grows shards on demand.
fn syn_install(db:*SynDb,value:i32,pshard:*i32,pslot:*i32)i32 {
    let si:i32=0;
    while(si<db.*.nshards){
        let s:MaStore=syndb_view(db,si);
        let slot:i32=-1;
        let rc:i32=ma_add(&s,value,MA_REGION_USER,&slot);
        syndb_wb(db,si,&s);
        if(rc==MA_OK){pshard.*=si;pslot.*=slot;return MA_OK;}
        si=si+1;
    }
    syndb_addshard(db);
    let s2:MaStore=syndb_view(db,db.*.nshards-1);
    let slot2:i32=-1;
    let rc2:i32=ma_add(&s2,value,MA_REGION_USER,&slot2);
    syndb_wb(db,db.*.nshards-1,&s2);
    if(rc2==MA_OK){pshard.*=db.*.nshards-1;pslot.*=slot2;}
    return rc2;
}

fn syn_kill(db:*SynDb,shard:i32,slot:i32)i32 {
    let s:MaStore=syndb_view(db,shard);
    let rc:i32=ma_kill(&s,slot);
    syndb_wb(db,shard,&s);
    return rc;
}
fn syn_pin(db:*SynDb,shard:i32,slot:i32)i32 {
    let s:MaStore=syndb_view(db,shard);
    let rc:i32=ma_pin(&s,slot);
    syndb_wb(db,shard,&s);
    return rc;
}
fn syn_promote(db:*SynDb,shard:i32,slot:i32)i32 {
    let s:MaStore=syndb_view(db,shard);
    let rc:i32=ma_promote(&s,slot);
    syndb_wb(db,shard,&s);
    return rc;
}
fn syn_is_live(db:*SynDb,shard:i32,slot:i32)i32 {
    if(shard<0||shard>=db.*.nshards){return 0;}
    if(slot<0||slot>=256){return 0;}
    let live:[]u8=db.*.live;
    if(live[shard*SYN_SHARD_LIVE+slot]==1){return 1;}
    return 0;
}
fn syn_slot_value(db:*SynDb,shard:i32,slot:i32)i32 {
    let value:[]u8=db.*.value;
    return s32get(value,shard*SYN_SHARD_VAL+slot*4);
}
// ---- persistence: serialization of substrate state ----
// Format (binary):
//   "SYNMEM1\n" | nshards:i32 | per shard: audit_n,stage,clock:i32,
//   live[256], value[1024], prt[768], step[1024], audit[audit_n*40]
fn syn_save(db:*SynDb,dir:[]u8)void {
    let out:[]u8=nio_alloc(256);
    let dp:i32=0;
    let magic:[]u8="SYNMEM1\n";
    let mi:i32=0;
    while(mi<8){
        if(dp>=out.len){sgrow(&out,dp+1);}
        out[dp]=magic[mi];dp=dp+1;mi=mi+1;
    }
    let ns:i32=db.*.nshards;
    if(dp+4>out.len){sgrow(&out,dp+4);}
    s32put(out,dp,ns);dp=dp+4;
    let si:i32=0;
    while(si<ns){
        let nums:[]u8=db.*.nums;
        let no:i32=si*SYN_SHARD_NUMS;
        let an:i32=s32get(nums,no);
        if(dp+12>out.len){sgrow(&out,dp+12);}
        s32put(out,dp,an);s32put(out,dp+4,s32get(nums,no+4));
        s32put(out,dp+8,s32get(nums,no+8));dp=dp+12;
        let live:[]u8=db.*.live; let value:[]u8=db.*.value;
        let prt:[]u8=db.*.prt; let step:[]u8=db.*.step;
        let audit:[]u8=db.*.audit;
        let lo:i32=si*SYN_SHARD_LIVE;
        let need:i32=256+1024+768+1024+an*40;
        if(dp+need>out.len){sgrow(&out,dp+need);}
        let k:i32=0;
        while(k<256){out[dp+k]=live[lo+k];k=k+1;}
        dp=dp+256;k=0;
        let vo:i32=si*SYN_SHARD_VAL;
        while(k<1024){out[dp+k]=value[vo+k];k=k+1;}
        dp=dp+1024;k=0;
        let po:i32=si*SYN_SHARD_PRT;
        while(k<768){out[dp+k]=prt[po+k];k=k+1;}
        dp=dp+768;k=0;
        let so:i32=si*SYN_SHARD_STEP;
        while(k<1024){out[dp+k]=step[so+k];k=k+1;}
        dp=dp+1024;k=0;
        let ao:i32=si*SYN_SHARD_AUDIT;
        while(k<an*40){out[dp+k]=audit[ao+k];k=k+1;}
        dp=dp+an*40;
        si=si+1;
    }
    f_write(path_join(dir,"synmem.bin"),out[0..dp]);
}

// Load substrate state. Returns 1 on success, 0 if no state file.
fn syn_load(db:*SynDb,dir:[]u8)i32 {
    let raw:[]u8=f_read(path_join(dir,"synmem.bin"));
    if(raw.len<12){return 0;}
    if(raw[0]!=83||raw[1]!=89||raw[2]!=78||raw[3]!=77||raw[4]!=69||raw[5]!=77||raw[6]!=49||raw[7]!=10){return 0;}
    let ns:i32=s32get(raw,8);
    if(ns<0||ns>1024){return 0;}
    let pos:i32=12;
    let si:i32=0;
    while(si<ns){
        syndb_addshard(db);
        if(pos+12>raw.len){return 0;}
        let an:i32=s32get(raw,pos);
        let st:i32=s32get(raw,pos+4);
        let cl:i32=s32get(raw,pos+8);
        pos=pos+12;
        let need:i32=256+1024+768+1024+an*40;
        if(an<0||pos+need>raw.len){return 0;}
        let nums:[]u8=db.*.nums;
        s32put(nums,si*SYN_SHARD_NUMS,an);
        s32put(nums,si*SYN_SHARD_NUMS+4,st);
        s32put(nums,si*SYN_SHARD_NUMS+8,cl);
        let live:[]u8=db.*.live; let value:[]u8=db.*.value;
        let prt:[]u8=db.*.prt; let step:[]u8=db.*.step;
        let audit:[]u8=db.*.audit;
        let lo:i32=si*SYN_SHARD_LIVE;
        let k:i32=0;
        while(k<256){live[lo+k]=raw[pos+k];k=k+1;}
        pos=pos+256;k=0;
        let vo:i32=si*SYN_SHARD_VAL;
        while(k<1024){value[vo+k]=raw[pos+k];k=k+1;}
        pos=pos+1024;k=0;
        let po:i32=si*SYN_SHARD_PRT;
        while(k<768){prt[po+k]=raw[pos+k];k=k+1;}
        pos=pos+768;k=0;
        let so:i32=si*SYN_SHARD_STEP;
        while(k<1024){step[so+k]=raw[pos+k];k=k+1;}
        pos=pos+1024;k=0;
        let ao:i32=si*SYN_SHARD_AUDIT;
        while(k<an*40){audit[ao+k]=raw[pos+k];k=k+1;}
        pos=pos+an*40;
        si=si+1;
    }
    return 1;
}
fn syn_count_live(db:*SynDb,want_syn:i32,want_veto:i32)[]u8 {
    // returns 8 bytes: [nsyn i32, nveto i32]
    let out:[]u8=nio_alloc(8);
    let ns:i32=0; let nv:i32=0;
    let si:i32=0;
    while(si<db.*.nshards){
        let sl:i32=0;
        while(sl<256){
            if(syn_is_live(db,si,sl)==1){
                let v:i32=syn_slot_value(db,si,sl);
                if(v>=SYN_VAL_BASE&&v<SYN_VAL_BASE+16){ns=ns+1;}
                if(v==VETO_VAL){nv=nv+1;}
            }
            sl=sl+1;
        }
        si=si+1;
    }
    s32put(out,0,ns);s32put(out,4,nv);
    return out;
}

// ---------- integrated content-table store ----------: binary tables + substrate ----------
// The content arena (relation/veto tables, lid lists, string pool) is saved
// as binary; the substrate (SynDb) is saved via syn_save/syn_load. The
// (shard,slot,synced) mapping ties each table row to its substrate memory.
// Format: "SYNTAB1\n" | nr nv nl pooln :i32 | arrays (lengths implicit).

fn stab_emit_i32s(out:*[]u8,dp:*i32,a:[]u8,n:i32)void {
    let o:[]u8=out.*; let p:i32=dp.*;
    sgrow(&o,(p+n*4));
    let i:i32=0;
    while(i<n*4){o[p+i]=a[i];i=i+1;}
    out.*=o; dp.*=p+n*4;
}
fn stab_read_i32s(raw:[]u8,pos:*i32,a:*[]u8,n:i32)void {
    let p:i32=pos.*;
    sgrow(a,n*4);
    let b:[]u8=a.*;
    let i:i32=0;
    while(i<n*4){b[i]=raw[p+i];i=i+1;}
    a.*=b; pos.*=p+n*4;
}

fn tables_save(dir:[]u8,nr:i32,nv:i32,nl:i32,pooln:i32,
    r1o:[]u8,r1l:[]u8,r2o:[]u8,r2l:[]u8,rrules:[]u8,
    lo:[]u8,ll:[]u8,lhead:[]u8,ltail:[]u8,lnext:[]u8,ln:[]u8,
    v1o:[]u8,v1l:[]u8,v2o:[]u8,v2l:[]u8,vlido:[]u8,vlidl:[]u8,
    pool:[]u8,rshard:[]u8,rslot:[]u8,rsync:[]u8,
    vshard:[]u8,vslot:[]u8,vsync:[]u8)void {
    let out:[]u8=nio_alloc(4096);
    let dp:i32=0;
    let magic:[]u8="SYNTAB1\n";
    let mi:i32=0;
    while(mi<8){
        sgrow(&out,dp+1);
        let oo:[]u8=out; oo[dp]=magic[mi]; dp=dp+1; mi=mi+1;
    }
    sgrow(&out,dp+16);
    let o0:[]u8=out;
    u32put(o0,dp,nr as i64);u32put(o0,dp+4,nv as i64);
    u32put(o0,dp+8,nl as i64);u32put(o0,dp+12,pooln as i64);
    dp=dp+16;
    stab_emit_i32s(&out,&dp,r1o,nr);stab_emit_i32s(&out,&dp,r1l,nr);
    stab_emit_i32s(&out,&dp,r2o,nr);stab_emit_i32s(&out,&dp,r2l,nr);
    stab_emit_i32s(&out,&dp,rrules,nr);
    stab_emit_i32s(&out,&dp,lo,nl);stab_emit_i32s(&out,&dp,ll,nl);
    stab_emit_i32s(&out,&dp,lhead,nr);stab_emit_i32s(&out,&dp,ltail,nr);
    stab_emit_i32s(&out,&dp,lnext,nl);stab_emit_i32s(&out,&dp,ln,nr);
    stab_emit_i32s(&out,&dp,v1o,nv);stab_emit_i32s(&out,&dp,v1l,nv);
    stab_emit_i32s(&out,&dp,v2o,nv);stab_emit_i32s(&out,&dp,v2l,nv);
    stab_emit_i32s(&out,&dp,vlido,nv);stab_emit_i32s(&out,&dp,vlidl,nv);
    stab_emit_i32s(&out,&dp,rshard,nr);stab_emit_i32s(&out,&dp,rslot,nr);
    stab_emit_i32s(&out,&dp,rsync,nr);
    stab_emit_i32s(&out,&dp,vshard,nv);stab_emit_i32s(&out,&dp,vslot,nv);
    stab_emit_i32s(&out,&dp,vsync,nv);
    // pool bytes
    sgrow(&out,dp+pooln);
    let op:[]u8=out;
    let pi:i32=0;
    while(pi<pooln){op[dp+pi]=pool[pi];pi=pi+1;}
    dp=dp+pooln;
    f_write(path_join(dir,"syntab.bin"),out[0..dp]);
    return;
}

// Load tables. Returns 1 if a store was found, 0 otherwise. Counts come back
// via out-params.
fn tables_load(dir:[]u8,pnr:*i32,pnv:*i32,pnl:*i32,ppooln:*i32,
    pr1o:*[]u8,pr1l:*[]u8,pr2o:*[]u8,pr2l:*[]u8,prrules:*[]u8,
    plo:*[]u8,pll:*[]u8,plhead:*[]u8,pltail:*[]u8,plnext:*[]u8,pln:*[]u8,
    pv1o:*[]u8,pv1l:*[]u8,pv2o:*[]u8,pv2l:*[]u8,pvlido:*[]u8,pvlidl:*[]u8,
    ppool:*[]u8,prshard:*[]u8,prslot:*[]u8,prsync:*[]u8,
    pvshard:*[]u8,pvslot:*[]u8,pvsync:*[]u8)i32 {
    let raw:[]u8=f_read(path_join(dir,"syntab.bin"));
    if(raw.len<24){return 0;}
    if(raw[0]!=83||raw[1]!=89||raw[2]!=78||raw[3]!=84||raw[4]!=65||raw[5]!=66||raw[6]!=49||raw[7]!=10){return 0;}
    let nr:i32=u32get(raw,8) as i32; let nv:i32=u32get(raw,12) as i32;
    let nl:i32=u32get(raw,16) as i32; let pooln:i32=u32get(raw,20) as i32;
    if(nr<0||nv<0||nl<0||pooln<0){return 0;}
    let pos:i32=24;
    stab_read_i32s(raw,&pos,pr1o,nr);stab_read_i32s(raw,&pos,pr1l,nr);
    stab_read_i32s(raw,&pos,pr2o,nr);stab_read_i32s(raw,&pos,pr2l,nr);
    stab_read_i32s(raw,&pos,prrules,nr);
    stab_read_i32s(raw,&pos,plo,nl);stab_read_i32s(raw,&pos,pll,nl);
    stab_read_i32s(raw,&pos,plhead,nr);stab_read_i32s(raw,&pos,pltail,nr);
    stab_read_i32s(raw,&pos,plnext,nl);stab_read_i32s(raw,&pos,pln,nr);
    stab_read_i32s(raw,&pos,pv1o,nv);stab_read_i32s(raw,&pos,pv1l,nv);
    stab_read_i32s(raw,&pos,pv2o,nv);stab_read_i32s(raw,&pos,pv2l,nv);
    stab_read_i32s(raw,&pos,pvlido,nv);stab_read_i32s(raw,&pos,pvlidl,nv);
    stab_read_i32s(raw,&pos,prshard,nr);stab_read_i32s(raw,&pos,prslot,nr);
    stab_read_i32s(raw,&pos,prsync,nr);
    stab_read_i32s(raw,&pos,pvshard,nv);stab_read_i32s(raw,&pos,pvslot,nv);
    stab_read_i32s(raw,&pos,pvsync,nv);
    if(pos+pooln>raw.len){return 0;}
    sgrow(ppool,pooln);
    let pb:[]u8=ppool.*;
    let pi:i32=0;
    while(pi<pooln){pb[pi]=raw[pos+pi];pi=pi+1;}
    ppool.*=pb;
    pnr.*=nr;pnv.*=nv;pnl.*=nl;ppooln.*=pooln;
    return 1;
}


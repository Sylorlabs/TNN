// WS2-L: learned-synonym retrieval scheme. Pure Zag, zero RNG.
// Every lookup consults the ToC; query hint fields are ignored (text only).
// ARM L: synonym map is LEARNED from evidence (see MECHANISM.md) into
// dir/synlearn.txt + dir/synveto.txt — no curated table is imported.
// Conventions: []u8 arenas, u32 little-endian words (per AGENTS.md znc lessons:
// no as []i32 tables, 8-byte struct stride avoided by using arenas, no .* on
// non-pointer locals, no slice >= 2^25 bytes).
@import("lib.zag")

// ---------------- text utils ----------------
fn norm(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    let n:i32=0;let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=65 && c<=90){c=c+32;}
        if((c>=97 && c<=122)||(c>=48 && c<=57)){o[n]=c as u8;n=n+1;}
        i=i+1;
    }
    return o[0..n];
}
fn contains(h:[]u8,nd:[]u8)i32 {
    if(nd.len==0 || nd.len>h.len){return 0;}
    let i:i32=0;
    while(i+nd.len<=h.len){
        let k:i32=0;let eq:i32=1;
        while(k<nd.len){if(h[i+k]!=nd[k]){eq=0;}k=k+1;}
        if(eq==1){return 1;}
        i=i+1;
    }
    return 0;
}
// field slice from fields_of arena (offsets relative to ln)
fn fa_f(fa:[]u8,ln:[]u8,fi:i32)[]u8 {
    let o:i32=u32get(fa,4+fi*8) as i32;let l:i32=u32get(fa,4+fi*8+4) as i32;
    return ln[o..o+l];
}
// decimal parse, non-negative; stops at first non-digit
fn atoi0(s:[]u8)i32 {
    let r:i32=0;let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c<48 || c>57){i=s.len;}
        else { r=r*10+(c-48);i=i+1; }
    }
    return r;
}
// ---------------- unified query parser ----------------
// handles 8-field battery format and 3-field maint format.
// arena: [nq:u32] per query 8xu32: qo,ql,to,tl,co,cl,ngo_abs,ng ; gold ids in
// appended ga section: [ngtot][off,len]* with offsets absolute into qbuf.
fn my_parse(qbuf:[]u8)[]u8 {
    let la:[]u8=lines_of(qbuf);
    let nl:i32=line_n(la);
    let qt:[]u8=nio_alloc(4+nl*32+8);
    let ga:[]u8=nio_alloc(4+nl*8*8+8);
    u32put(ga,0,0);
    u32put(qt,0,0);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8=line_slice(qbuf,la,i);
        let base:i32=u32get(la,4+i*8) as i32;
        if(ln.len>0 && ln[0]!=35){
            let fa:[]u8=fields_of(ln,124,8);
            let nf:i32=fld_n(fa);
            let qo:i32=0;let ql:i32=0;let to:i32=0;let tl:i32=0;
            let co:i32=0;let cl:i32=0;let ng:i32=0;let ok:i32=0;
            if(nf==8){
                qo=base+(u32get(fa,4+0*8) as i32);ql=u32get(fa,4+0*8+4) as i32;
                to=base+(u32get(fa,4+6*8) as i32);tl=u32get(fa,4+6*8+4) as i32;
                co=base+(u32get(fa,4+2*8) as i32);cl=u32get(fa,4+2*8+4) as i32;
                let go:i32=base+(u32get(fa,4+7*8) as i32);let gl:i32=u32get(fa,4+7*8+4) as i32;
                let gf:[]u8=fields_of(qbuf[go..go+gl],44,512);
                ng=fld_n(gf);
                if(gl==0){ng=0;}
                let ngo:i32=u32get(ga,0) as i32;
                let g:i32=0;
                while(g<ng){
                    u32put(ga,4+(ngo+g)*8,(go+u32get(gf,4+g*8)) as i64);
                    u32put(ga,4+(ngo+g)*8+4,u32get(gf,4+g*8+4));
                    g=g+1;
                }
                u32put(ga,0,(ngo+ng) as i64);
                nio_free(gf);
                ok=1;
            }
            if(nf==3){
                qo=base+(u32get(fa,4+0*8) as i32);ql=u32get(fa,4+0*8+4) as i32;
                to=base+(u32get(fa,4+2*8) as i32);tl=u32get(fa,4+2*8+4) as i32;
                co=-1;cl=2;
                ng=0;
                ok=1;
            }
            if(ok==1){
                let c2:i32=u32get(qt,0) as i32;
                let ngo2:i32=(u32get(ga,0) as i32)-ng;
                u32put(qt,4+c2*32,qo as i64);u32put(qt,4+c2*32+4,ql as i64);
                u32put(qt,4+c2*32+8,to as i64);u32put(qt,4+c2*32+12,tl as i64);
                u32put(qt,4+c2*32+16,co as i64);u32put(qt,4+c2*32+20,cl as i64);
                u32put(qt,4+c2*32+24,ngo2 as i64);
                u32put(qt,4+c2*32+28,ng as i64);
                u32put(qt,0,(c2+1) as i64);
            }
            nio_free(fa);
        }
        i=i+1;
    }
    nio_free(la);
    let nq:i32=u32get(qt,0) as i32;
    let qtlen:i32=4+nq*32;
    let ngtot:i32=u32get(ga,0) as i32;
    let galen:i32=4+ngtot*8;
    let out:[]u8=nio_alloc(qtlen+galen+8);
    let k:i32=0;
    while(k<qtlen){out[k]=qt[k];k=k+1;}
    u32put(out,0,nq as i64);
    let q2:i32=0;
    while(q2<nq){
        let ngo3:i32=u32get(out,4+q2*32+24) as i32;
        u32put(out,4+q2*32+24,(qtlen+4+ngo3*8) as i64);
        q2=q2+1;
    }
    u32put(out,qtlen,ngtot as i64);
    let g2:i32=0;
    while(g2<ngtot){
        u32put(out,qtlen+4+g2*8,u32get(ga,4+g2*8));
        u32put(out,qtlen+4+g2*8+4,u32get(ga,4+g2*8+4));
        g2=g2+1;
    }
    nio_free(qt);nio_free(ga);
    return out;
}
fn mq_cnt(q:[]u8)i32 { return u32get(q,0) as i32; }
fn mq_id(qb:[]u8,q:[]u8,i:i32)[]u8 {
    let o:i32=u32get(q,4+i*32) as i32;let l:i32=u32get(q,4+i*32+4) as i32;
    return qb[o..o+l];
}
fn mq_text(qb:[]u8,q:[]u8,i:i32)[]u8 {
    let o:i32=u32get(q,4+i*32+8) as i32;let l:i32=u32get(q,4+i*32+12) as i32;
    return qb[o..o+l];
}
fn mq_class(qb:[]u8,q:[]u8,i:i32)[]u8 {
    let co:i32=u32get(q,4+i*32+16) as i32;
    if(co<0){return "F5";}
    let l:i32=u32get(q,4+i*32+20) as i32;
    return qb[co..co+l];
}
fn mq_ng(q:[]u8,i:i32)i32 { return u32get(q,4+i*32+28) as i32; }
fn mq_gold(qbuf:[]u8,q:[]u8,i:i32,g:i32)[]u8 {
    let go:i32=u32get(q,4+i*32+24) as i32;
    let o:i32=u32get(q,go+g*8) as i32;let l:i32=u32get(q,go+g*8+4) as i32;
    return qbuf[o..o+l];
}
fn starts_with2(s:[]u8,pre:[]u8)i32 {
    if(pre.len>s.len){return 0;}
    let k:i32=0;
    while(k<pre.len){if(s[k]!=pre[k]){return 0;}k=k+1;}
    return 1;
}
// frozen stemmer (prereg §2.4)
fn stem(t:[]u8)[]u8 {
    let n:i32=t.len;
    if(n>4 && t[n-3]==105 && t[n-2]==110 && t[n-1]==103 && n-3>=3){return t[0..n-3];}
    if(n>3 && t[n-2]==101 && t[n-1]==100 && n-2>=3){return t[0..n-2];}
    if(n>4 && t[n-2]==101 && t[n-1]==115 && n-2>=3){return t[0..n-2];}
    if(n>3 && t[n-1]==115 && t[n-2]!=115 && n-1>=3){return t[0..n-1];}
    return t;
}
// frozen stoplist (prereg §2.4)
fn is_stop(t:[]u8)i32 {
    let blob:[]u8="|a|an|the|is|are|was|were|be|been|being|do|does|did|how|what|why|who|which|when|where|of|to|in|on|at|for|with|by|from|as|and|or|but|not|no|all|every|about|show|me|tell|you|your|my|it|its|this|that|these|those|there|their|them|then|than|into|onto|";
    let q:[]u8=concat(concat("|",t),"|");
    let r:i32=contains(blob,q);
    nio_free(q);
    return r;
}
// ---------------- synonym bridge (WS2-B2) ----------------
// syn map arena: [nm:u32][rawlen:u32][raw bytes][entries]; each entry 16B:
// ARM L syn_build: load the LEARNED store from dir/synlearn.txt (+vetoes from
// dir/synveto.txt), stem with the frozen stemmer, union-find transitive
// closure over stem pairs, canon = lexicographically smallest stem per class.
// Arena layout identical to WS2-B2: [nm:u32][rawlen:u32][raw bytes][entries],
// each entry 16B: key_off,key_len,canon_off,canon_len (u32; offsets into raw).
// One entry per distinct stem: stem -> class canon. syn_canon unchanged.
// ---------------- elastic arenas (no fixed capacities) ----------------
// grow a byte arena on demand: doubling, content preserved, offsets stay valid.
// Load-bearing ceiling: znc cannot index a slice >= 2^25 bytes (toolchain
// limit, worked around — never presented as a TNN design limit).
fn tg_grow(p:*[]u8,min_len:i32)void {
    let cur:[]u8=p.*;
    if(min_len<=cur.len){return;}
    let nl:i32=cur.len*2;
    if(nl<min_len){nl=min_len;}
    if(nl>33554432){nl=33554432;}
    let n:[]u8=nio_alloc(nl);
    let i:i32=0;
    while(i<cur.len){n[i]=cur[i];i=i+1;}
    p.*=n;
    return;
}
// append bytes to a spool arena; returns the offset of the appended bytes
fn tg_spool(sp:*[]u8,spn:*i32,s:[]u8)i32 {
    tg_grow(sp,spn.*+s.len);
    let pool:[]u8=sp.*;
    let o:i32=spn.*;
    let q:i32=0;
    while(q<s.len){pool[o+q]=s[q];q=q+1;}
    spn.*=o+s.len;
    return o;
}
// union-find root with path compression. Structurally terminating: every
// node's parent is written at most once (only roots are ever attached, under
// a node that is a root at attach time), so parent links form a forest and
// every chain reaches a root. No arbitrary step guard.
fn tg_find(par:[]u8,x:i32)i32 {
    let r:i32=x;
    while((u32get(par,r*4) as i32)!=r){r=u32get(par,r*4) as i32;}
    let c:i32=x;
    while((u32get(par,c*4) as i32)!=r){
        let nx:i32=u32get(par,c*4) as i32;
        u32put(par,c*4,r as i64);
        c=nx;
    }
    return r;
}

// syn_build: learned synonym map. ELASTIC (2026-09-25): every table grows on
// demand — veto list, relation pairs, stem table, union-find parents, raw
// output, relation offsets. Byte-identical output to the fixed-cap version
// on any store the old caps could hold.
// dir/synveto.txt), stem with the frozen stemmer, union-find transitive
// closure over stem pairs, canon = lexicographically smallest stem per class.
// Arena layout identical to WS2-B2: [nm:u32][rawlen:u32][raw bytes][entries],
// each entry 16B: key_off,key_len,canon_off,canon_len (u32; offsets into raw).
// One entry per distinct stem: stem -> class canon. syn_canon unchanged.
fn syn_build(dir:[]u8)[]u8 {
    let empty:[]u8=nio_alloc(16);
    u32put(empty,0,0); u32put(empty,4,0);
    let sbuf:[]u8=f_read(path_join(dir,"synlearn.txt"));
    if(sbuf.len==0){return empty;}
    let vbuf:[]u8=f_read(path_join(dir,"synveto.txt"));
    // stem pool: all stem bytes ever appended live here; offsets are numbers
    let spool:[]u8=nio_alloc(4096);
    let spn:i32=0;
    // veto stem pairs (elastic): va/vb hold (off,len) into spool
    let va:[]u8=nio_alloc(64); let vb:[]u8=nio_alloc(64);
    let nv2:i32=0;
    if(vbuf.len>0){
        let vl:[]u8=lines_of(vbuf); let k:i32=0;
        while(k<line_n(vl)){
            let ln:[]u8=line_slice(vbuf,vl,k);
            if(ln.len>0 && ln[0]!=35){
                let fa:[]u8=fields_of(ln,124,4);
                if(fld_n(fa)==4){
                    let s1:[]u8=stem(fa_f(fa,ln,0)); let s2:[]u8=stem(fa_f(fa,ln,1));
                    let o1:i32=tg_spool(&spool,&spn,s1);
                    let o2:i32=tg_spool(&spool,&spn,s2);
                    tg_grow(&va,(nv2+1)*8); tg_grow(&vb,(nv2+1)*8);
                    u32put(va,nv2*8,o1 as i64); u32put(va,nv2*8+4,s1.len as i64);
                    u32put(vb,nv2*8,o2 as i64); u32put(vb,nv2*8+4,s2.len as i64);
                    nv2=nv2+1;
                }
                nio_free(fa);
            }
            k=k+1;
        }
        nio_free(vl);
    }
    // relation pairs (elastic): pa/pb hold (off,len) into spool
    let pa:[]u8=nio_alloc(64); let pb:[]u8=nio_alloc(64);
    let npr:i32=0;
    let sl:[]u8=lines_of(sbuf); let k2:i32=0;
    while(k2<line_n(sl)){
        let ln:[]u8=line_slice(sbuf,sl,k2);
        if(ln.len>0 && ln[0]!=35){
            let fa:[]u8=fields_of(ln,124,4);
            if(fld_n(fa)==4){
                let s1:[]u8=stem(fa_f(fa,ln,0)); let s2:[]u8=stem(fa_f(fa,ln,1));
                let blocked:i32=0; let v:i32=0;
                while(v<nv2){
                    let x0:i32=u32get(va,v*8) as i32; let xl:i32=u32get(va,v*8+4) as i32;
                    let y0:i32=u32get(vb,v*8) as i32; let yl:i32=u32get(vb,v*8+4) as i32;
                    let vx:[]u8=spool[x0..x0+xl]; let vy:[]u8=spool[y0..y0+yl];
                    if((bytes_eq(vx,s1)==1&&bytes_eq(vy,s2)==1)
                    ||(bytes_eq(vx,s2)==1&&bytes_eq(vy,s1)==1)){blocked=1;}
                    v=v+1;
                }
                if(blocked==0){
                    let o1:i32=tg_spool(&spool,&spn,s1);
                    let o2:i32=tg_spool(&spool,&spn,s2);
                    tg_grow(&pa,(npr+1)*8); tg_grow(&pb,(npr+1)*8);
                    u32put(pa,npr*8,o1 as i64); u32put(pa,npr*8+4,s1.len as i64);
                    u32put(pb,npr*8,o2 as i64); u32put(pb,npr*8+4,s2.len as i64);
                    npr=npr+1;
                }
            }
            nio_free(fa);
        }
        k2=k2+1;
    }
    nio_free(sl);
    // union-find over distinct stems (elastic), dedup by bytes
    let so:[]u8=nio_alloc(64); let sln:[]u8=nio_alloc(64);
    let par:[]u8=nio_alloc(64);
    let nst:i32=0;
    let pi:i32=0;
    while(pi<npr){
        let a0:i32=u32get(pa,pi*8) as i32; let al:i32=u32get(pa,pi*8+4) as i32;
        let b0:i32=u32get(pb,pi*8) as i32; let bl:i32=u32get(pb,pi*8+4) as i32;
        let sa:[]u8=spool[a0..a0+al]; let sb:[]u8=spool[b0..b0+bl];
        let ia:i32=-1; let ib:i32=-1; let s:i32=0;
        while(s<nst){
            let e0:i32=u32get(so,s*4) as i32; let el:i32=u32get(sln,s*4) as i32;
            let es:[]u8=spool[e0..e0+el];
            if(bytes_eq(es,sa)==1){ia=s;}
            if(bytes_eq(es,sb)==1){ib=s;}
            s=s+1;
        }
        if(ia<0){
            tg_grow(&so,(nst+1)*4); tg_grow(&sln,(nst+1)*4); tg_grow(&par,(nst+1)*4);
            ia=nst;u32put(so,nst*4,a0 as i64);u32put(sln,nst*4,al as i64);u32put(par,nst*4,nst as i64);nst=nst+1;
        }
        if(ib<0){
            tg_grow(&so,(nst+1)*4); tg_grow(&sln,(nst+1)*4); tg_grow(&par,(nst+1)*4);
            ib=nst;u32put(so,nst*4,b0 as i64);u32put(sln,nst*4,bl as i64);u32put(par,nst*4,nst as i64);nst=nst+1;
        }
        let ra:i32=tg_find(par,ia);
        let rb:i32=tg_find(par,ib);
        if(ra!=rb){u32put(par,rb*4,ra as i64);}
        pi=pi+1;
    }
    // final raw: distinct stems concatenated; ro[e] = raw offset of stem e
    let raw:[]u8=nio_alloc(4096);
    let rp:i32=0;
    let ro:[]u8=nio_alloc(64);
    tg_grow(&ro,nst*4);
    let s2:i32=0;
    while(s2<nst){
        let o:i32=u32get(so,s2*4) as i32; let l:i32=u32get(sln,s2*4) as i32;
        u32put(ro,s2*4,rp as i64);
        tg_grow(&raw,rp+l);
        let q:i32=0;
        while(q<l){raw[rp+q]=spool[o+q];q=q+1;}
        rp=rp+l;
        s2=s2+1;
    }
    // canon per stem: lexicographically smallest member of its class
    let mp:[]u8=nio_alloc(8+rp+nst*16+8);
    u32put(mp,0,nst as i64);
    u32put(mp,4,rp as i64);
    let c:i32=0;
    while(c<rp){mp[8+c]=raw[c];c=c+1;}
    let eo:i32=8+rp;
    let e2:i32=0;
    while(e2<nst){
        let r0:i32=tg_find(par,e2);
        let best:i32=e2; let m:i32=0;
        while(m<nst){
            let rm:i32=tg_find(par,m);
            if(rm==r0){
                let bo:i32=u32get(so,best*4) as i32; let bl:i32=u32get(sln,best*4) as i32;
                let mo:i32=u32get(so,m*4) as i32; let ml:i32=u32get(sln,m*4) as i32;
                if(bytes_lt(spool[mo..mo+ml],spool[bo..bo+bl])==1){best=m;}
            }
            m=m+1;
        }
        let ko:i32=u32get(ro,e2*4) as i32; let kl:i32=u32get(sln,e2*4) as i32;
        let no:i32=u32get(ro,best*4) as i32; let nl2:i32=u32get(sln,best*4) as i32;
        u32put(mp,eo+e2*16,ko as i64);u32put(mp,eo+e2*16+4,kl as i64);
        u32put(mp,eo+e2*16+8,no as i64);u32put(mp,eo+e2*16+12,nl2 as i64);
        e2=e2+1;
    }
    nio_free(va);nio_free(vb);nio_free(pa);nio_free(pb);
    nio_free(so);nio_free(sln);nio_free(par);nio_free(raw);nio_free(ro);
    nio_free(spool);
    return mp;
}
// canonical stem for a stemmed token; identity when unmapped.
fn syn_canon(mp:[]u8,tok:[]u8)[]u8 {
    let nm:i32=u32get(mp,0) as i32;
    let rl:i32=u32get(mp,4) as i32;
    let e:i32=0;
    while(e<nm){
        let ko:i32=u32get(mp,8+rl+e*16) as i32;let kl:i32=u32get(mp,8+rl+e*16+4) as i32;
        if(kl==tok.len && bytes_eq(mp[8+ko..8+ko+kl],tok)==1){
            let co:i32=u32get(mp,8+rl+e*16+8) as i32;let cl2:i32=u32get(mp,8+rl+e*16+12) as i32;
            return mp[8+co..8+co+cl2];
        }
        e=e+1;
    }
    return tok;
}
// phase-2 scoring: byte-exact match on canonical stems.
fn own_score2(A:[]u8,qp:[]u8,qa:[]u8,idx:i32,syn:[]u8)i32 {
    let nq:i32=u32get(qa,0) as i32;
    let nk2:i32=kw_ntc(A,idx);
    let n:i32=0;let i:i32=0;
    while(i<nq){
        let qo:i32=u32get(qa,4+i*8) as i32;let ql:i32=u32get(qa,4+i*8+4) as i32;
        let cq:[]u8=syn_canon(syn,qp[qo..qo+ql]);
        let j:i32=0;
        while(j<nk2){
            let ck:[]u8=syn_canon(syn,kw_tok(A,idx,j));
            if(cq.len==ck.len && bytes_eq(cq,ck)==1){n=n+1;}
            j=j+1;
        }
        i=i+1;
    }
    return n;
}
fn cell_score2(A:[]u8,qp:[]u8,qa:[]u8,cz:i32,syn:[]u8)i32 {
    if(cz<0){return 0;}
    let nq:i32=u32get(qa,0) as i32;
    let nc2:i32=cell_ntc(A,cz);
    let n:i32=0;let i:i32=0;
    while(i<nq){
        let qo:i32=u32get(qa,4+i*8) as i32;let ql:i32=u32get(qa,4+i*8+4) as i32;
        let cq:[]u8=syn_canon(syn,qp[qo..qo+ql]);
        let j:i32=0;
        while(j<nc2){
            let ck:[]u8=syn_canon(syn,cell_tok(A,cz,j));
            if(cq.len==ck.len && bytes_eq(cq,ck)==1){n=n+1;}
            j=j+1;
        }
        i=i+1;
    }
    return n;
}
// distinct query stems with >=1 (canonicalized if use_syn) match against
// the item's own tokens or its cell tokens. The prereg gate ("weak
// single-token match") and bar ("at least two distinct stem matches") are
// defined on DISTINCT query stems: one word matching in both the cell and
// the own set still counts as one.
fn dstem_hit(A:[]u8,qp:[]u8,qa:[]u8,cz:i32,idx:i32,syn:[]u8,use_syn:i32)i32 {
    let nq:i32=u32get(qa,0) as i32;
    let nk2:i32=kw_ntc(A,idx);
    let nc2:i32=0;
    if(cz>=0){nc2=cell_ntc(A,cz);}
    let h:i32=0;let i:i32=0;
    while(i<nq){
        let qo:i32=u32get(qa,4+i*8) as i32;let ql:i32=u32get(qa,4+i*8+4) as i32;
        let cq:[]u8=qp[qo..qo+ql];
        if(use_syn==1){cq=syn_canon(syn,cq);}
        let f:i32=0;
        let j:i32=0;
        while(j<nk2 && f==0){
            let ck:[]u8=kw_tok(A,idx,j);
            if(use_syn==1){ck=syn_canon(syn,ck);}
            if(cq.len==ck.len && bytes_eq(cq,ck)==1){f=1;}
            j=j+1;
        }
        let k:i32=0;
        while(k<nc2 && f==0){
            let ck2:[]u8=cell_tok(A,cz,k);
            if(use_syn==1){ck2=syn_canon(syn,ck2);}
            if(cq.len==ck2.len && bytes_eq(cq,ck2)==1){f=1;}
            k=k+1;
        }
        if(f==1){h=h+1;}
        i=i+1;
    }
    return h;
}
fn tok_cmp(pool:[]u8,a_o:i32,a_l:i32,b_o:i32,b_l:i32)i32 {
    if(a_l!=b_l){
        if(a_l<b_l){return -1;}
        return 1;
    }
    let k:i32=0;
    while(k<a_l){
        let x:i32=pool[a_o+k] as i32;let y:i32=pool[b_o+k] as i32;
        if(x<y){return -1;}
        if(x>y){return 1;}
        k=k+1;
    }
    return 0;
}
// tok_set_low(low): low must already be lowercased; token (off,len) pairs
// alias low (caller keeps it alive).
fn tok_set_low(low:[]u8)[]u8 {
    let ta:[]u8=tokenize(low);
    let nt0:i32=u32get(ta,0) as i32;
    let tmp:[]u8=nio_alloc(4+nt0*8+8);
    u32put(tmp,0,0);
    let t:i32=0;
    while(t<nt0){
        let o:i32=u32get(ta,4+t*8) as i32;let l:i32=u32get(ta,4+t*8+4) as i32;
        let tok:[]u8=low[o..o+l];
        let st:[]u8=stem(tok);
        if(st.len>0 && is_stop(st)==0){
            let c:i32=u32get(tmp,0) as i32;
            // locate stem base offset inside low
            let base:i32=0;let f:i32=0;
            while(f<low.len){
                if(f+st.len<=low.len){
                    let k:i32=0;let eq:i32=1;
                    while(k<st.len){if(low[f+k]!=st[k]){eq=0;}k=k+1;}
                    if(eq==1){base=f;f=low.len;}
                }
                f=f+1;
            }
            let dup:i32=0;let d:i32=0;
            while(d<c){
                let do2:i32=u32get(tmp,4+d*8) as i32;let dl:i32=u32get(tmp,4+d*8+4) as i32;
                if(tok_cmp(low,base,st.len,do2,dl)==0){dup=1;}
                d=d+1;
            }
            if(dup==0){
                u32put(tmp,4+c*8,base as i64);u32put(tmp,4+c*8+4,st.len as i64);
                u32put(tmp,0,(c+1) as i64);
            }
        }
        t=t+1;
    }
    nio_free(ta);
    // insertion sort by (len,lex); token (off,len) pairs alias `low`, which is
    // intentionally NOT freed (bounded leak) so the set stays valid.
    let c:i32=u32get(tmp,0) as i32;    let i2:i32=1;
    while(i2<c){
        let ko:i32=u32get(tmp,4+i2*8) as i32;let kl:i32=u32get(tmp,4+i2*8+4) as i32;
        let j:i32=i2-1;
        let mv:i32=0;let jdone:i32=0;
        while(j>=0 && jdone==0){
            let jo:i32=u32get(tmp,4+j*8) as i32;let jl:i32=u32get(tmp,4+j*8+4) as i32;
            if(tok_cmp(low,jo,jl,ko,kl)>0){
                u32put(tmp,4+(j+1)*8,jo as i64);u32put(tmp,4+(j+1)*8+4,jl as i64);
                j=j-1;mv=1;
            } else { jdone=1; }
        }
        if(mv==1){u32put(tmp,4+(j+1)*8,ko as i64);u32put(tmp,4+(j+1)*8+4,kl as i64);}
        i2=i2+1;
    }
    return tmp;
}
fn tok_set(s:[]u8)[]u8 {
    let low:[]u8=lower(s);
    return tok_set_low(low);
}
// intersect count of two tok_sets sharing the same pool
fn tok_inter(pool:[]u8,a:[]u8,b:[]u8)i32 {
    let na:i32=u32get(a,0) as i32;let nb:i32=u32get(b,0) as i32;
    let n:i32=0;let i:i32=0;
    while(i<na){
        let ao:i32=u32get(a,4+i*8) as i32;let al:i32=u32get(a,4+i*8+4) as i32;
        let j:i32=0;
        while(j<nb){
            let bo:i32=u32get(b,4+j*8) as i32;let bl:i32=u32get(b,4+j*8+4) as i32;
            if(tok_cmp(pool,ao,al,bo,bl)==0){n=n+1;}
            j=j+1;
        }
        i=i+1;
    }
    return n;
}
fn parse_k(s:[]u8)i32 {
    let v:i32=0;let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){v=v*10+(c-48);}
        i=i+1;
    }
    return v;
}

// ---------------- op counters ----------------
fn ops_load(dir:[]u8)[]u8 {
    // 7 x i64: toc_rd toc_wr kw_build agg_re item_rd item_wr score
    let o:[]u8=nio_alloc(64);
    let i:i32=0;while(i<7){i64put(o,i*8,0);i=i+1;}
    let p:[]u8=path_join(dir,"ops.bin");
    if(f_exists(p)==1){
        let b:[]u8=f_read(p);
        if(b.len>=56){let j:i32=0;while(j<7){i64put(o,j*8,i64get(b,j*8));j=j+1;}}
        nio_free(b);
    }
    nio_free(p);
    return o;
}
fn ops_save(dir:[]u8,o:[]u8)void {
    let p:[]u8=path_join(dir,"ops.bin");
    let b:[]u8=nio_alloc(56);
    let j:i32=0;while(j<7){i64put(b,j*8,i64get(o,j*8));j=j+1;}
    f_write(p,b);
    nio_free(p);nio_free(b);
    return;
}
fn ops_bump(o:[]u8,slot:i32,by:i64)void {
    i64put(o,slot*8,i64get(o,slot*8)+by);
    return;
}

// ---------------- item table ----------------
// items.txt lines: id|domain|type|subject|text ; arena [n:u32] + n*10xu32 into buf
fn load_items(dir:[]u8,ops:[]u8)[]u8 {
    let p:[]u8=path_join(dir,"items.txt");
    let buf:[]u8=f_read(p);
    nio_free(p);
    ops_bump(ops,4,1);
    let la:[]u8=lines_of(buf);
    let nl:i32=line_n(la);
    let tab:[]u8=nio_alloc(4+nl*40+8);
    u32put(tab,0,0);
    let cnt:i32=0;let i:i32=0;
    while(i<nl){
        let ln:[]u8=line_slice(buf,la,i);
        if(ln.len>0 && ln[0]!=35){
            let fa:[]u8=fields_of(ln,124,5);
            if(fld_n(fa)==5){
                let base:i32=u32get(la,4+i*8) as i32;
                let f:i32=0;
                while(f<5){
                    let o:i32=u32get(fa,4+f*8) as i32;let l:i32=u32get(fa,4+f*8+4) as i32;
                    u32put(tab,4+cnt*40+f*8,(base+o) as i64);
                    u32put(tab,4+cnt*40+f*8+4,l as i64);
                    f=f+1;
                }
                cnt=cnt+1;
            }
            nio_free(fa);
        }
        i=i+1;
    }
    u32put(tab,0,cnt as i64);
    nio_free(la);
    // sort by id asc (insertion, deterministic)
    let it:[]u8=nio_alloc(4+cnt*4+8);
    let s2:i32=0;while(s2<cnt){u32put(it,4+s2*4,s2 as i64);s2=s2+1;}
    let a:i32=1;
    while(a<cnt){
        let av:i32=u32get(it,4+a*4) as i32;
        let ao:i32=u32get(tab,4+av*40) as i32;let al:i32=u32get(tab,4+av*40+4) as i32;
        let b:i32=a-1;let mv:i32=0;let bdone:i32=0;
        while(b>=0 && bdone==0){
            let bv:i32=u32get(it,4+b*4) as i32;
            let bo:i32=u32get(tab,4+bv*40) as i32;let bl:i32=u32get(tab,4+bv*40+4) as i32;
            if(bytes_lt(buf[ao..ao+al],buf[bo..bo+bl])==1){
                u32put(it,4+(b+1)*4,bv as i64);b=b-1;mv=1;
            } else { bdone=1; }
        }
        if(mv==1){u32put(it,4+(b+1)*4,av as i64);}
        a=a+1;
    }
    // repack tab in sorted order
    let tab2:[]u8=nio_alloc(4+cnt*40+8);
    u32put(tab2,0,cnt as i64);
    let r:i32=0;
    while(r<cnt){
        let v:i32=u32get(it,4+r*4) as i32;
        let f2:i32=0;
        while(f2<10){
            u32put(tab2,4+r*40+f2*4,u32get(tab,4+v*40+f2*4));
            f2=f2+1;
        }
        r=r+1;
    }
    nio_free(it);nio_free(tab);
    // combined arena: [tablen:u32][tab bytes][buf bytes]; keeps buf alive.
    let tablen:i32=4+cnt*40;
    let out:[]u8=nio_alloc(4+tablen+buf.len);
    u32put(out,0,tablen as i64);
    let c3:i32=0;
    while(c3<tablen){out[4+c3]=tab2[c3];c3=c3+1;}
    let c4:i32=0;
    while(c4<buf.len){out[4+tablen+c4]=buf[c4];c4=c4+1;}
    nio_free(tab2);
    return out;
}
fn itab(out:[]u8)[]u8 {
    let tl:i32=u32get(out,0) as i32;
    return out[4..4+tl];
}
fn ibuf(out:[]u8)[]u8 {
    let tl:i32=u32get(out,0) as i32;
    return out[4+tl..out.len];
}
fn in_n(out:[]u8)i32 { return u32get(itab(out),0) as i32; }
fn ifield(buf:[]u8,tab:[]u8,i:i32,f:i32)[]u8 {
    let o:i32=u32get(tab,4+i*40+f*8) as i32;let l:i32=u32get(tab,4+i*40+f*8+4) as i32;
    return buf[o..o+l];
}

// ---------------- ToC build ----------------
// collect distinct values of item field f into arena [nu:u32][off,len]* (sorted)
fn distinct_vals(buf:[]u8,tab:[]u8,n:i32,f:i32)[]u8 {
    let ar:[]u8=nio_alloc(4+n*8+8);
    u32put(ar,0,0);
    let i:i32=0;
    while(i<n){
        let v:[]u8=ifield(buf,tab,i,f);
        let c:i32=u32get(ar,0) as i32;
        let dup:i32=0;let d:i32=0;
        while(d<c){
            let oo:i32=u32get(ar,4+d*8) as i32;let ll:i32=u32get(ar,4+d*8+4) as i32;
            if(bytes_eq(v,buf[oo..oo+ll])==1){dup=1;}
            d=d+1;
        }
        if(dup==0){
            // store offset: find v inside buf (v aliases buf already)
            // recover offset by pointer arithmetic via scan
            let base:i32=0;let f2:i32=0;
            while(f2<buf.len){
                if(f2+v.len<=buf.len){
                    let k:i32=0;let eq:i32=1;
                    while(k<v.len){if(buf[f2+k]!=v[k]){eq=0;}k=k+1;}
                    if(eq==1){base=f2;f2=buf.len;}
                }
                f2=f2+1;
            }
            u32put(ar,4+c*8,base as i64);u32put(ar,4+c*8+4,v.len as i64);
            u32put(ar,0,(c+1) as i64);
        }
        i=i+1;
    }
    // sort by (len,lex)
    let c:i32=u32get(ar,0) as i32;
    let a:i32=1;
    while(a<c){
        let ko:i32=u32get(ar,4+a*8) as i32;let kl:i32=u32get(ar,4+a*8+4) as i32;
        let b:i32=a-1;let mv:i32=0;let bdone:i32=0;
        while(b>=0 && bdone==0){
            let jo:i32=u32get(ar,4+b*8) as i32;let jl:i32=u32get(ar,4+b*8+4) as i32;
            if(tok_cmp(buf,jo,jl,ko,kl)>0){
                u32put(ar,4+(b+1)*8,jo as i64);u32put(ar,4+(b+1)*8+4,jl as i64);
                b=b-1;mv=1;
            } else { bdone=1; }
        }
        if(mv==1){u32put(ar,4+(b+1)*8,ko as i64);u32put(ar,4+(b+1)*8+4,kl as i64);}
        a=a+1;
    }
    return ar;
}
fn val_at(buf:[]u8,ar:[]u8,i:i32)[]u8 {
    let o:i32=u32get(ar,4+i*8) as i32;let l:i32=u32get(ar,4+i*8+4) as i32;
    return buf[o..o+l];
}
// append "key|id1,id2,...\n" for one key; ids = items where pred fields match
fn key_line(buf:[]u8,tab:[]u8,n:i32,key:[]u8,mf:i32,mv:[]u8,sf:i32,sv:[]u8)[]u8 {
    let o:[]u8=nio_alloc(key.len+n*8+16);
    let at:i32=0;let k:i32=0;
    while(k<key.len){o[at]=key[k];at=at+1;k=k+1;}
    o[at]=124;at=at+1;
    let first:i32=1;let i:i32=0;
    while(i<n){
        let ok:i32=1;
        if(mf>=0 && bytes_eq(ifield(buf,tab,i,mf),mv)==0){ok=0;}
        if(ok==1 && sf>=0 && bytes_eq(ifield(buf,tab,i,sf),sv)==0){ok=0;}
        if(ok==1){
            if(first==0){o[at]=44;at=at+1;}
            let id:[]u8=ifield(buf,tab,i,0);
            let c:i32=0;
            while(c<id.len){o[at]=id[c];at=at+1;c=c+1;}
            first=0;
        }
        i=i+1;
    }
    o[at]=10;at=at+1;
    return o[0..at];
}
fn build_toc(dir:[]u8,ops:[]u8)i32 {
    let out:[]u8=load_items(dir,ops);
    let tab:[]u8=itab(out);let buf:[]u8=ibuf(out);let n:i32=in_n(out);
    let tys:[]u8=distinct_vals(buf,tab,n,2);
    let dms:[]u8=distinct_vals(buf,tab,n,1);
    let sjs:[]u8=distinct_vals(buf,tab,n,3);
    let nt:i32=u32get(tys,0) as i32;let nd:i32=u32get(dms,0) as i32;
    let nsj:i32=u32get(sjs,0) as i32;
    // collect key lines then sort
    let lines:[]u8=nio_alloc(4+4096*8+8);
    u32put(lines,0,0);
    // stash line slices: store (off,len) into a growable text pool
    let pool:[]u8=nio_alloc(n*400+65536);
    let pat:i32=0;
    // macro-ish: for each key form, emit lines. unrolled per form for clarity.
    let li:i32=0;
    while(li<nt){
        let t:[]u8=val_at(buf,tys,li);
        let key:[]u8=concat("T:",t);
        let ln:[]u8=key_line(buf,tab,n,key,2,t,-1,"");
        let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
        let lc:i32=u32get(lines,0) as i32;
        u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
        u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
        nio_free(key);nio_free(ln);
        li=li+1;
    }
    li=0;
    while(li<nd){
        let d:[]u8=val_at(buf,dms,li);
        let key:[]u8=concat("D:",d);
        let ln:[]u8=key_line(buf,tab,n,key,1,d,-1,"");
        let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
        let lc:i32=u32get(lines,0) as i32;
        u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
        u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
        nio_free(key);nio_free(ln);
        li=li+1;
    }
    li=0;
    while(li<nsj){
        let s:[]u8=val_at(buf,sjs,li);
        let key:[]u8=concat("S:",s);
        let ln:[]u8=key_line(buf,tab,n,key,3,s,-1,"");
        let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
        let lc:i32=u32get(lines,0) as i32;
        u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
        u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
        nio_free(key);nio_free(ln);
        li=li+1;
    }
    let a2:i32=0;
    while(a2<nt){
        let t:[]u8=val_at(buf,tys,a2);let b2:i32=0;
        while(b2<nd){
            let d:[]u8=val_at(buf,dms,b2);
            let key:[]u8=concat(concat(concat("TD:",t),":"),d);
            let ln:[]u8=key_line(buf,tab,n,key,2,t,1,d);
            let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
            let lc:i32=u32get(lines,0) as i32;
            u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
            u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
            nio_free(key);nio_free(ln);
            b2=b2+1;
        }
        a2=a2+1;
    }
    a2=0;
    while(a2<nt){
        let t:[]u8=val_at(buf,tys,a2);let b2:i32=0;
        while(b2<nsj){
            let s:[]u8=val_at(buf,sjs,b2);
            let key:[]u8=concat(concat(concat("TS:",t),":"),s);
            let ln:[]u8=key_line(buf,tab,n,key,2,t,3,s);
            let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
            let lc:i32=u32get(lines,0) as i32;
            u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
            u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
            nio_free(key);nio_free(ln);
            b2=b2+1;
        }
        a2=a2+1;
    }
    a2=0;
    while(a2<nd){
        let d:[]u8=val_at(buf,dms,a2);let b2:i32=0;
        while(b2<nsj){
            let s:[]u8=val_at(buf,sjs,b2);
            let key:[]u8=concat(concat(concat("DS:",d),":"),s);
            let ln:[]u8=key_line(buf,tab,n,key,1,d,3,s);
            let c:i32=0;while(c<ln.len){pool[pat+c]=ln[c];c=c+1;}
            let lc:i32=u32get(lines,0) as i32;
            u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln.len as i64);
            u32put(lines,0,(lc+1) as i64);pat=pat+ln.len;
            nio_free(key);nio_free(ln);
            b2=b2+1;
        }
        a2=a2+1;
    }
    a2=0;
    while(a2<nt){
        let t:[]u8=val_at(buf,tys,a2);let b2:i32=0;
        while(b2<nd){
            let d:[]u8=val_at(buf,dms,b2);let c2:i32=0;
            while(c2<nsj){
                let s:[]u8=val_at(buf,sjs,c2);
                let key:[]u8=concat(concat(concat(concat(concat("TDS:",t),":"),d),":"),s);
                // three-constraint filter (manual; key_line only handles two)
                let o:[]u8=nio_alloc(key.len+n*8+16);
                let at:i32=0;let k:i32=0;
                while(k<key.len){o[at]=key[k];at=at+1;k=k+1;}
                o[at]=124;at=at+1;
                let first:i32=1;let i:i32=0;let any:i32=0;
                while(i<n){
                    if(bytes_eq(ifield(buf,tab,i,2),t)==1 && bytes_eq(ifield(buf,tab,i,1),d)==1 && bytes_eq(ifield(buf,tab,i,3),s)==1){
                        if(first==0){o[at]=44;at=at+1;}
                        let id:[]u8=ifield(buf,tab,i,0);
                        let cc:i32=0;
                        while(cc<id.len){o[at]=id[cc];at=at+1;cc=cc+1;}
                        first=0;any=1;
                    }
                    i=i+1;
                }
                o[at]=10;at=at+1;
                if(any==1){
                    let ln2:[]u8=o[0..at];
                    let c:i32=0;while(c<ln2.len){pool[pat+c]=ln2[c];c=c+1;}
                    let lc:i32=u32get(lines,0) as i32;
                    u32put(lines,4+lc*8,pat as i64);u32put(lines,4+lc*8+4,ln2.len as i64);
                    u32put(lines,0,(lc+1) as i64);pat=pat+ln2.len;
                }
                nio_free(o);nio_free(key);
                c2=c2+1;
            }
            b2=b2+1;
        }
        a2=a2+1;
    }
    // sort lines lexicographically
    let nl2:i32=u32get(lines,0) as i32;
    let srt:i32=1;
    while(srt<nl2){
        let ko:i32=u32get(lines,4+srt*8) as i32;let kl:i32=u32get(lines,4+srt*8+4) as i32;
        let b:i32=srt-1;let mv:i32=0;let bdone:i32=0;
        while(b>=0 && bdone==0){
            let jo:i32=u32get(lines,4+b*8) as i32;let jl:i32=u32get(lines,4+b*8+4) as i32;
            if(bytes_lt(pool[ko..ko+kl],pool[jo..jo+jl])==1){
                u32put(lines,4+(b+1)*8,jo as i64);u32put(lines,4+(b+1)*8+4,jl as i64);
                b=b-1;mv=1;
            } else { bdone=1; }
        }
        if(mv==1){u32put(lines,4+(b+1)*8,ko as i64);u32put(lines,4+(b+1)*8+4,kl as i64);}
        srt=srt+1;
    }
    let tocdata:[]u8=nio_alloc(pat+1);
    let wp:i32=0;let q2:i32=0;
    while(q2<nl2){
        let oo:i32=u32get(lines,4+q2*8) as i32;let ll:i32=u32get(lines,4+q2*8+4) as i32;
        let c:i32=0;
        while(c<ll){tocdata[wp]=pool[oo+c];wp=wp+1;c=c+1;}
        q2=q2+1;
    }
    let tp:[]u8=path_join(dir,"toc.txt");
    f_write(tp,tocdata[0..wp]);
    nio_free(tp);
    ops_bump(ops,1,nl2 as i64);
    // kw.txt
    let kwp:[]u8=nio_alloc(n*300+16);
    let kat:i32=0;let i3:i32=0;
    while(i3<n){
        let id:[]u8=ifield(buf,tab,i3,0);
        let tx:[]u8=ifield(buf,tab,i3,4);let sj:[]u8=ifield(buf,tab,i3,3);
        let dm:[]u8=ifield(buf,tab,i3,1);let ty:[]u8=ifield(buf,tab,i3,2);
        let c1:[]u8=concat(concat(concat(concat(concat(concat(tx," "),sj)," "),dm)," "),ty);
        let c1l:[]u8=lower(c1);
        let ts:[]u8=tok_set_low(c1l);
        let c:i32=0;
        while(c<id.len){kwp[kat]=id[c];kat=kat+1;c=c+1;}
        kwp[kat]=124;kat=kat+1;
        let ntc:i32=u32get(ts,0) as i32;let t2:i32=0;
        while(t2<ntc){
            let oo:i32=u32get(ts,4+t2*8) as i32;let ll:i32=u32get(ts,4+t2*8+4) as i32;
            let c2:i32=0;
            while(c2<ll){kwp[kat]=c1l[oo+c2];kat=kat+1;c2=c2+1;}
            if(t2<ntc-1){kwp[kat]=44;kat=kat+1;}
            t2=t2+1;
        }
        kwp[kat]=10;kat=kat+1;
        nio_free(c1);nio_free(c1l);nio_free(ts);
        i3=i3+1;
    }
    let kp:[]u8=path_join(dir,"kw.txt");
    f_write(kp,kwp[0..kat]);
    nio_free(kp);
    ops_bump(ops,2,n as i64);
    // cells.txt: per-subject aggregate = tok_set over the CONCATENATION of the
    // subject's items' combined strings (union with dedup built in).
    let clp:[]u8=nio_alloc(nsj*2000+16);
    let clat:i32=0;let s3:i32=0;
    while(s3<nsj){
        let sv:[]u8=val_at(buf,sjs,s3);
        let big:[]u8="";
        let i4:i32=0;
        while(i4<n){
            if(bytes_eq(ifield(buf,tab,i4,3),sv)==1){
                let tx:[]u8=ifield(buf,tab,i4,4);let sj:[]u8=ifield(buf,tab,i4,3);
                let dm:[]u8=ifield(buf,tab,i4,1);let ty:[]u8=ifield(buf,tab,i4,2);
                let c1:[]u8=concat(concat(concat(concat(concat(concat(tx," "),sj)," "),dm)," "),ty);
                let nb:[]u8=concat(concat(big," "),c1);
                nio_free(big);nio_free(c1);
                big=nb;
            }
            i4=i4+1;
        }
        let bigl:[]u8=lower(big);
        let ts:[]u8=tok_set_low(bigl);
        let c:i32=0;
        while(c<sv.len){clp[clat]=sv[c];clat=clat+1;c=c+1;}
        clp[clat]=124;clat=clat+1;
        let ntc:i32=u32get(ts,0) as i32;let t2:i32=0;
        while(t2<ntc){
            let oo:i32=u32get(ts,4+t2*8) as i32;let ll:i32=u32get(ts,4+t2*8+4) as i32;
            let c2:i32=0;
            while(c2<ll){clp[clat]=bigl[oo+c2];clat=clat+1;c2=c2+1;}
            if(t2<ntc-1){clp[clat]=44;clat=clat+1;}
            t2=t2+1;
        }
        clp[clat]=10;clat=clat+1;
        nio_free(ts);nio_free(big);nio_free(bigl);
        s3=s3+1;
    }
    let cp:[]u8=path_join(dir,"cells.txt");
    f_write(cp,clp[0..clat]);
    nio_free(cp);
    ops_bump(ops,3,nsj as i64);
    // manifest
    let mp:[]u8=path_join(dir,"manifest.txt");
    let mtxt:[]u8=concat(concat(concat("items=",i64s(n as i64)),"\nkeys="),i64s(nl2 as i64));
    let mtxt2:[]u8=concat(mtxt,"\n");
    f_write(mp,mtxt2);
    nio_free(mp);nio_free(mtxt);nio_free(mtxt2);
    nio_free(pool);nio_free(lines);nio_free(tocdata);nio_free(kwp);nio_free(clp);
    nio_free(tys);nio_free(dms);nio_free(sjs);
    return 0;
}

// ---------------- ToC load ----------------
// TOC arena: [6xu32: kto,kwto,cto,kbo,kwbo,cbo][keytab][ids][kwtab][kwtoks][celltab][celltoks][keybuf][kwbuf][cellbuf]
// keytab: [nk][k_o,k_l,idc,ids_o]*16B ; ids: u32 item indices
// kwtab: [n][ntc,toks_o]*8B ; kwtoks: [off,len]*8B
// celltab: [ns][s_o,s_l,ntc,toks_o]*16B ; celltoks: [off,len]*8B
fn id_index(buf:[]u8,tab:[]u8,n:i32,id:[]u8)i32 {
    let i:i32=0;
    while(i<n){
        if(bytes_eq(ifield(buf,tab,i,0),id)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn toc_load(dir:[]u8,ib:[]u8,it:[]u8,n:i32,ops:[]u8)[]u8 {
    let tab:[]u8=it;let buf:[]u8=ib;
    // keytab
    let kp:[]u8=path_join(dir,"toc.txt");
    let kb:[]u8=f_read(kp);nio_free(kp);
    ops_bump(ops,0,1);
    let la:[]u8=lines_of(kb);
    let nl:i32=line_n(la);
    let keytab:[]u8=nio_alloc(4+nl*16+8);
    u32put(keytab,0,0);
    let ids:[]u8=nio_alloc(4+n*nl*4+8);
    u32put(ids,0,0);
    let keybuf:[]u8=nio_alloc(kb.len+1);
    let kbl:i32=0;
    let i:i32=0;
    while(i<nl){
        let ln:[]u8=line_slice(kb,la,i);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,2);
            if(fld_n(fa)==2){
                let ko:i32=u32get(fa,4+0*8) as i32;let kl:i32=u32get(fa,4+0*8+4) as i32;
                let io:i32=u32get(fa,4+1*8) as i32;let il:i32=u32get(fa,4+1*8+4) as i32;
                let base:i32=u32get(la,4+i*8) as i32;
                let c:i32=0;
                while(c<kl){keybuf[kbl+c]=kb[base+ko+c];c=c+1;}
                let ga:[]u8=fields_of(kb[base+io..base+io+il],44,4096);
                let ng:i32=fld_n(ga);
                let idc:i32=0;let idso:i32=u32get(ids,0) as i32;
                let g:i32=0;
                while(g<ng){
                    let go:i32=u32get(ga,4+g*8) as i32;let gl:i32=u32get(ga,4+g*8+4) as i32;
                    let idx:i32=id_index(buf,tab,n,kb[base+io+go..base+io+go+gl]);
                    if(idx>=0){
                        u32put(ids,4+idso*4,idx as i64);idso=idso+1;idc=idc+1;
                    }
                    g=g+1;
                }
                u32put(ids,0,idso as i64);
                let kc:i32=u32get(keytab,0) as i32;
                u32put(keytab,4+kc*16,kbl as i64);
                u32put(keytab,4+kc*16+4,kl as i64);
                u32put(keytab,4+kc*16+8,idc as i64);
                // ids_o = position in ids arena (count units)
                u32put(keytab,4+kc*16+12,(idso-idc) as i64);
                u32put(keytab,0,(kc+1) as i64);
                kbl=kbl+kl;
                nio_free(ga);
            }
            nio_free(fa);
        }
        i=i+1;
    }
    nio_free(la);
    let nk:i32=u32get(keytab,0) as i32;
    // kwtab
    let kwp:[]u8=path_join(dir,"kw.txt");
    let kwb:[]u8=f_read(kwp);nio_free(kwp);
    ops_bump(ops,0,1);
    let kwtab:[]u8=nio_alloc(4+n*8+8);
    let kwtoks:[]u8=nio_alloc(4+n*160*8+8);
    u32put(kwtoks,0,0);
    let i2:i32=0;
    while(i2<n){u32put(kwtab,4+i2*8,0);u32put(kwtab,4+i2*8+4,0);i2=i2+1;}
    let la2:[]u8=lines_of(kwb);
    let nl2:i32=line_n(la2);
    let j:i32=0;
    while(j<nl2){
        let ln:[]u8=line_slice(kwb,la2,j);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,2);
            if(fld_n(fa)==2){
                let io:i32=u32get(fa,4+0*8) as i32;let il:i32=u32get(fa,4+0*8+4) as i32;
                let to:i32=u32get(fa,4+1*8) as i32;let tl:i32=u32get(fa,4+1*8+4) as i32;
                let base:i32=u32get(la2,4+j*8) as i32;
                let idx:i32=id_index(buf,tab,n,kwb[base+io..base+io+il]);
                if(idx>=0){
                    let ga:[]u8=fields_of(kwb[base+to..base+to+tl],44,2048);
                    let ng:i32=fld_n(ga);
                    let tc:i32=u32get(kwtoks,0) as i32;
                    let g:i32=0;
                    while(g<ng){
                        let go:i32=u32get(ga,4+g*8) as i32;let gl:i32=u32get(ga,4+g*8+4) as i32;
                        u32put(kwtoks,4+tc*8,(base+to+go) as i64);
                        u32put(kwtoks,4+tc*8+4,gl as i64);
                        tc=tc+1;g=g+1;
                    }
                    u32put(kwtoks,0,tc as i64);
                    u32put(kwtab,4+idx*8,ng as i64);
                    u32put(kwtab,4+idx*8+4,(tc-ng) as i64);
                    nio_free(ga);
                }
            }
            nio_free(fa);
        }
        j=j+1;
    }
    nio_free(la2);
    // celltab
    let clp:[]u8=path_join(dir,"cells.txt");
    let clb:[]u8=f_read(clp);nio_free(clp);
    ops_bump(ops,0,1);
    let celltab:[]u8=nio_alloc(4+512*16+8);
    u32put(celltab,0,0);
    let celltoks:[]u8=nio_alloc(4+512*400*8+8);
    u32put(celltoks,0,0);
    let la3:[]u8=lines_of(clb);
    let nl3:i32=line_n(la3);
    let cellbuf:[]u8=nio_alloc(clb.len+1);
    let cbl:i32=0;
    let k3:i32=0;
    while(k3<nl3){
        let ln:[]u8=line_slice(clb,la3,k3);
        if(ln.len>0){
            let fa:[]u8=fields_of(ln,124,2);
            if(fld_n(fa)==2){
                let so:i32=u32get(fa,4+0*8) as i32;let sl:i32=u32get(fa,4+0*8+4) as i32;
                let to:i32=u32get(fa,4+1*8) as i32;let tl:i32=u32get(fa,4+1*8+4) as i32;
                let base:i32=u32get(la3,4+k3*8) as i32;
                let c:i32=0;
                while(c<sl){cellbuf[cbl+c]=clb[base+so+c];c=c+1;}
                let ga:[]u8=fields_of(clb[base+to..base+to+tl],44,4096);
                let ng:i32=fld_n(ga);
                let tc:i32=u32get(celltoks,0) as i32;
                let g:i32=0;
                while(g<ng){
                    let go:i32=u32get(ga,4+g*8) as i32;let gl:i32=u32get(ga,4+g*8+4) as i32;
                    u32put(celltoks,4+tc*8,(base+to+go) as i64);
                    u32put(celltoks,4+tc*8+4,gl as i64);
                    tc=tc+1;g=g+1;
                }
                u32put(celltoks,0,tc as i64);
                let cc:i32=u32get(celltab,0) as i32;
                u32put(celltab,4+cc*16,cbl as i64);
                u32put(celltab,4+cc*16+4,sl as i64);
                u32put(celltab,4+cc*16+8,ng as i64);
                u32put(celltab,4+cc*16+12,(tc-ng) as i64);
                u32put(celltab,0,(cc+1) as i64);
                cbl=cbl+sl;
                nio_free(ga);
            }
            nio_free(fa);
        }
        k3=k3+1;
    }
    nio_free(la3);
    // assemble single arena with absolute offsets
    let kto:i32=24;
    let keytab_len:i32=4+nk*16;
    let ids_len:i32=4+(u32get(ids,0) as i32)*4;
    let kwto:i32=kto+keytab_len+ids_len;
    let kwtab_len:i32=4+n*8;
    let kwtoks_len:i32=4+(u32get(kwtoks,0) as i32)*8;
    let cto:i32=kwto+kwtab_len+kwtoks_len;
    let ncell:i32=u32get(celltab,0) as i32;
    let celltab_len:i32=4+ncell*16;
    let celltoks_len:i32=4+(u32get(celltoks,0) as i32)*8;
    let kbo:i32=cto+celltab_len+celltoks_len;
    let kwbo:i32=kbo+kbl;
    let cbo:i32=kwbo+kwb.len;
    let total:i32=cbo+cbl+clb.len;
    let arena:[]u8=nio_alloc(total+8);
    u32put(arena,0,kto as i64);u32put(arena,4,kwto as i64);u32put(arena,8,cto as i64);
    u32put(arena,12,kbo as i64);u32put(arena,16,kwbo as i64);u32put(arena,20,cbo as i64);
    // fix up relative offsets to absolute: keytab (k_o), ids values stay (indices)
    let x:i32=0;
    while(x<nk){
        u32put(arena,kto+4+x*16,(kbo+u32get(keytab,4+x*16)) as i64);
        u32put(arena,kto+4+x*16+4,u32get(keytab,4+x*16+4));
        u32put(arena,kto+4+x*16+8,u32get(keytab,4+x*16+8));
        u32put(arena,kto+4+x*16+12,(kto+keytab_len+u32get(keytab,4+x*16+12)*4) as i64);
        x=x+1;
    }
    u32put(arena,kto,nk as i64);
    let ni:i32=u32get(ids,0) as i32;let xi:i32=0;
    while(xi<ni){
        u32put(arena,kto+keytab_len+4+xi*4,u32get(ids,4+xi*4));
        xi=xi+1;
    }
    u32put(arena,kto+keytab_len,ni as i64);
    let y:i32=0;
    while(y<n){
        u32put(arena,kwto+4+y*8,u32get(kwtab,4+y*8));
        u32put(arena,kwto+4+y*8+4,(kwto+kwtab_len+u32get(kwtab,4+y*8+4)*8) as i64);
        y=y+1;
    }
    let nt2:i32=u32get(kwtoks,0) as i32;let y2:i32=0;
    while(y2<nt2){
        u32put(arena,kwto+kwtab_len+4+y2*8,(kwbo+u32get(kwtoks,4+y2*8)) as i64);
        u32put(arena,kwto+kwtab_len+4+y2*8+4,u32get(kwtoks,4+y2*8+4));
        y2=y2+1;
    }
    u32put(arena,kwto+kwtab_len,nt2 as i64);
    let z:i32=0;
    while(z<ncell){
        u32put(arena,cto+4+z*16,(cbo+u32get(celltab,4+z*16)) as i64);
        u32put(arena,cto+4+z*16+4,u32get(celltab,4+z*16+4));
        u32put(arena,cto+4+z*16+8,u32get(celltab,4+z*16+8));
        u32put(arena,cto+4+z*16+12,(cto+celltab_len+u32get(celltab,4+z*16+12)*8) as i64);
        z=z+1;
    }
    u32put(arena,cto,ncell as i64);
    // cellbuf (cbl subject bytes) lands at cbo; clb (full cells.txt) right after.
    // toks were recorded as (base+to+go) into clb -> absolute = cbo+cbl+orig.
    let nct:i32=u32get(celltoks,0) as i32;let z2:i32=0;
    while(z2<nct){
        u32put(arena,cto+celltab_len+4+z2*8,(cbo+cbl+u32get(celltoks,4+z2*8)) as i64);
        u32put(arena,cto+celltab_len+4+z2*8+4,u32get(celltoks,4+z2*8+4));
        z2=z2+1;
    }
    u32put(arena,cto+celltab_len,nct as i64);
    // copy buffers
    let cb2:i32=0;
    while(cb2<kbl){arena[kbo+cb2]=keybuf[cb2];cb2=cb2+1;}
    // kwbuf: toks offsets were (base+to+go) into kwb; copy kwb fully at kwbo.
    let cb3:i32=0;
    while(cb3<kwb.len){arena[kwbo+cb3]=kwb[cb3];cb3=cb3+1;}
    let cb4:i32=0;
    while(cb4<cbl){arena[cbo+cb4]=cellbuf[cb4];cb4=cb4+1;}
    let cb5:i32=0;
    while(cb5<clb.len){arena[cbo+cbl+cb5]=clb[cb5];cb5=cb5+1;}
    nio_free(keytab);nio_free(ids);nio_free(keybuf);nio_free(kb);
    nio_free(kwtab);nio_free(kwtoks);nio_free(kwb);
    nio_free(celltab);nio_free(celltoks);nio_free(cellbuf);nio_free(clb);
    return arena;
}

// ---------------- TOC accessors ----------------
fn toc_nk(A:[]u8)i32 { return u32get(A,u32get(A,0) as i32) as i32; }
fn key_find(A:[]u8,key:[]u8)i32 {
    let kto:i32=u32get(A,0) as i32;
    let nk:i32=u32get(A,kto) as i32;
    let x:i32=0;
    while(x<nk){
        let ko:i32=u32get(A,kto+4+x*16) as i32;let kl:i32=u32get(A,kto+4+x*16+4) as i32;
        if(kl==key.len && bytes_eq(A[ko..ko+kl],key)==1){return x;}
        x=x+1;
    }
    return -1;
}
fn key_idc(A:[]u8,kx:i32)i32 { return u32get(A,u32get(A,0) as i32+4+kx*16+8) as i32; }
fn key_id_at(A:[]u8,kx:i32,j:i32)i32 {
    let kto:i32=u32get(A,0) as i32;
    let io:i32=u32get(A,kto+4+kx*16+12) as i32;
    return u32get(A,io+4+j*4) as i32;
}
fn key_in_bucket(A:[]u8,kx:i32,idx:i32)i32 {
    let c:i32=key_idc(A,kx);let j:i32=0;
    while(j<c){if(key_id_at(A,kx,j)==idx){return 1;}j=j+1;}
    return 0;
}
// slot_hits: arena [3:u32 nt,nd,nsj][entries (kind,off,len)*] kinds 0=type 1=dom 2=subj; off absolute into A
fn slot_hits(A:[]u8,qn:[]u8)[]u8 {
    let kto:i32=u32get(A,0) as i32;
    let nk:i32=u32get(A,kto) as i32;
    let ar:[]u8=nio_alloc(12+nk*12+8);
    u32put(ar,0,0);u32put(ar,4,0);u32put(ar,8,0);
    let ne:i32=0;
    let x:i32=0;
    while(x<nk){
        let ko:i32=u32get(A,kto+4+x*16) as i32;let kl:i32=u32get(A,kto+4+x*16+4) as i32;
        let k:[]u8=A[ko..ko+kl];
        let kind:i32=-1;
        if(starts_with2(k,"TDS:")==0 && starts_with2(k,"TD:")==0 && starts_with2(k,"TS:")==0 && starts_with2(k,"T:")==1){kind=0;}
        if(kind<0 && starts_with2(k,"DS:")==0 && starts_with2(k,"D:")==1){kind=1;}
        if(kind<0 && starts_with2(k,"S:")==1){kind=2;}
        if(kind>=0){
            let nm:[]u8=k[2..k.len];
            // name must contain no further colon
            if(contains(nm,":")==0 && contains(qn,nm)==1){
                u32put(ar,12+ne*12,kind as i64);
                u32put(ar,12+ne*12+4,(ko+2) as i64);
                u32put(ar,12+ne*12+8,nm.len as i64);
                ne=ne+1;
                if(kind==0){u32put(ar,0,(u32get(ar,0) as i32)+1 as i64);}
                if(kind==1){u32put(ar,4,(u32get(ar,4) as i32)+1 as i64);}
                if(kind==2){u32put(ar,8,(u32get(ar,8) as i32)+1 as i64);}
            }
        }
        x=x+1;
    }
    // shrink note: entries beyond ne unused; counts in 0..8
    return ar;
}
// kw set of item idx: arena [ntc][toks_o abs]; toks: (off,len) abs into A
fn kw_ntc(A:[]u8,idx:i32)i32 { return u32get(A,u32get(A,4) as i32+4+idx*8) as i32; }
fn kw_tok(A:[]u8,idx:i32,t:i32)[]u8 {
    let to:i32=u32get(A,u32get(A,4) as i32+4+idx*8+4) as i32;
    let o:i32=u32get(A,to+4+t*8) as i32;let l:i32=u32get(A,to+4+t*8+4) as i32;
    return A[o..o+l];
}
fn cell_find(A:[]u8,subj:[]u8)i32 {
    let cto:i32=u32get(A,8) as i32;
    let nc:i32=u32get(A,cto) as i32;
    let z:i32=0;
    while(z<nc){
        let so:i32=u32get(A,cto+4+z*16) as i32;let sl:i32=u32get(A,cto+4+z*16+4) as i32;
        if(sl==subj.len && bytes_eq(A[so..so+sl],subj)==1){return z;}
        z=z+1;
    }
    return -1;
}
fn cell_ntc(A:[]u8,cz:i32)i32 { return u32get(A,u32get(A,8) as i32+4+cz*16+8) as i32; }
fn cell_tok(A:[]u8,cz:i32,t:i32)[]u8 {
    let cto:i32=u32get(A,8) as i32;
    let to:i32=u32get(A,cto+4+cz*16+12) as i32;
    let o:i32=u32get(A,to+4+t*8) as i32;let l:i32=u32get(A,to+4+t*8+4) as i32;
    return A[o..o+l];
}
// direct: count |Q ∩ itemkw(idx)|
fn own_score(A:[]u8,qp:[]u8,qa:[]u8,idx:i32)i32 {
    let nq:i32=u32get(qa,0) as i32;
    let nk2:i32=kw_ntc(A,idx);
    let n:i32=0;let i:i32=0;
    while(i<nq){
        let qo:i32=u32get(qa,4+i*8) as i32;let ql:i32=u32get(qa,4+i*8+4) as i32;
        let j:i32=0;
        while(j<nk2){
            let kt:[]u8=kw_tok(A,idx,j);
            if(ql==kt.len && bytes_eq(qp[qo..qo+ql],kt)==1){n=n+1;}
            j=j+1;
        }
        i=i+1;
    }
    return n;
}
fn cell_score(A:[]u8,qp:[]u8,qa:[]u8,cz:i32)i32 {
    if(cz<0){return 0;}
    let nq:i32=u32get(qa,0) as i32;
    let nc2:i32=cell_ntc(A,cz);
    let n:i32=0;let i:i32=0;
    while(i<nq){
        let qo:i32=u32get(qa,4+i*8) as i32;let ql:i32=u32get(qa,4+i*8+4) as i32;
        let j:i32=0;
        while(j<nc2){
            let kt:[]u8=cell_tok(A,cz,j);
            if(ql==kt.len && bytes_eq(qp[qo..qo+ql],kt)==1){n=n+1;}
            j=j+1;
        }
        i=i+1;
    }
    return n;
}
// insertion sort ord[0..m] by (sc desc, ord asc); sc arena i64
fn sort_rank(ord:[]u8,sc:[]u8,m:i32)void {
    let a:i32=1;
    while(a<m){
        let av:i32=u32get(ord,4+a*4) as i32;
        let as:i64=i64get(sc,a*8);
        let b:i32=a-1;let mv:i32=0;let bdone:i32=0;
        while(b>=0 && bdone==0){
            let bv:i32=u32get(ord,4+b*4) as i32;
            let bs:i64=i64get(sc,b*8);
            let less:i32=0;
            if(bs<as){less=1;}
            if(bs==as && bv>av){less=1;}
            if(less==1){
                u32put(ord,4+(b+1)*4,bv as i64);i64put(sc,(b+1)*8,bs);
                b=b-1;mv=1;
            } else { bdone=1; }
        }
        if(mv==1){u32put(ord,4+(b+1)*4,av as i64);i64put(sc,(b+1)*8,as);}
        a=a+1;
    }
    return;
}
// one lookup. returns arena [nret:u32][itemidx]*. rep gets "route|nsj,nd,nt|ncand".
fn lookup_one(A:[]u8,ib:[]u8,it:[]u8,n:i32,qtext:[]u8,K:i32,ops:[]u8,rep:[]u8,syn:[]u8)[]u8 {
    let qn:[]u8=norm(qtext);
    let hits:[]u8=slot_hits(A,qn);
    let nt:i32=u32get(hits,0) as i32;let nd:i32=u32get(hits,4) as i32;let nsj:i32=u32get(hits,8) as i32;
    let kto:i32=u32get(A,0) as i32;
    ops_bump(ops,0,u32get(A,kto) as i64);
    let ne:i32=nt+nd+nsj;
    let cand:[]u8=nio_alloc(n+1);
    let i:i32=0;while(i<n){cand[i]=0;i=i+1;}
    let route:i32=3;let ncand:i32=0;let bridged:i32=0;
    let ord:[]u8=nio_alloc(4+n*4+8);
    let sc:[]u8=nio_alloc(n*8+8);
    let m:i32=0;
    if(nsj>0){
        route=1;
        let e:i32=0;
        while(e<ne){
            let kind:i32=u32get(hits,12+e*12) as i32;
            if(kind==2){
                let no:i32=u32get(hits,12+e*12+4) as i32;let nl2:i32=u32get(hits,12+e*12+8) as i32;
                let key:[]u8=concat("S:",A[no..no+nl2]);
                let kx:i32=key_find(A,key);
                nio_free(key);
                if(kx>=0){
                    ops_bump(ops,0,1);
                    let c:i32=key_idc(A,kx);let j:i32=0;
                    while(j<c){cand[key_id_at(A,kx,j)]=1;j=j+1;}
                }
            }
            e=e+1;
        }
        // refinements
        e=0;
        while(e<ne){
            let kind:i32=u32get(hits,12+e*12) as i32;
            if(kind==0 || kind==1){
                let no:i32=u32get(hits,12+e*12+4) as i32;let nl2:i32=u32get(hits,12+e*12+8) as i32;
                let pre:[]u8="T:";
                if(kind==1){pre="D:";}
                let key:[]u8=concat(pre,A[no..no+nl2]);
                let kx:i32=key_find(A,key);
                nio_free(key);
                if(kx>=0){
                    ops_bump(ops,0,1);
                    let has:i32=0;let q2:i32=0;
                    while(q2<n){if(cand[q2]==1 && key_in_bucket(A,kx,q2)==1){has=1;}q2=q2+1;}
                    if(has==1){
                        q2=0;
                        while(q2<n){if(cand[q2]==1 && key_in_bucket(A,kx,q2)==0){cand[q2]=0;}q2=q2+1;}
                    }
                }
            }
            e=e+1;
        }
        let qp:[]u8=lower(qtext);
        let qa:[]u8=tok_set_low(qp);
        i=0;
        while(i<n){
            if(cand[i]==1){
                u32put(ord,4+m*4,i as i64);
                i64put(sc,m*8,own_score(A,qp,qa,i) as i64);
                m=m+1;
            }
            i=i+1;
        }
        ops_bump(ops,6,m as i64);
        nio_free(qp);nio_free(qa);
    } else {
        if(nt+nd>0){
            route=2;
            i=0;while(i<n){cand[i]=1;i=i+1;}
            let e:i32=0;
            while(e<ne){
                let kind:i32=u32get(hits,12+e*12) as i32;
                let no:i32=u32get(hits,12+e*12+4) as i32;let nl2:i32=u32get(hits,12+e*12+8) as i32;
                let pre:[]u8="T:";
                if(kind==1){pre="D:";}
                let key:[]u8=concat(pre,A[no..no+nl2]);
                let kx:i32=key_find(A,key);
                nio_free(key);
                if(kx>=0){
                    ops_bump(ops,0,1);
                    let q2:i32=0;
                    while(q2<n){if(cand[q2]==1 && key_in_bucket(A,kx,q2)==0){cand[q2]=0;}q2=q2+1;}
                } else {
                    i=0;while(i<n){cand[i]=0;i=i+1;}
                }
                e=e+1;
            }
            let qp:[]u8=lower(qtext);
            let qa:[]u8=tok_set_low(qp);
            i=0;
            while(i<n){
                if(cand[i]==1){
                    u32put(ord,4+m*4,i as i64);
                    i64put(sc,m*8,own_score(A,qp,qa,i) as i64);
                    m=m+1;
                }
                i=i+1;
            }
            ops_bump(ops,6,m as i64);
            nio_free(qp);nio_free(qa);
        } else {
            route=3;
            let qp:[]u8=lower(qtext);
            let qa:[]u8=tok_set_low(qp);
            // Phase-1 ranking stays on the weighted tot (cell*1000+own).
            // The prereg gate/bar are defined on DISTINCT matching query
            // stems ("weak single-token match" / "at least two distinct
            // stem matches"), computed by dstem_hit for the top candidate.
            let p1top:i64=-1;let p1topi:i32=-1;
            i=0;
            while(i<n){
                let sj:[]u8=ifield(ib,it,i,3);
                let cz:i32=cell_find(A,sj);
                let cs:i32=cell_score(A,qp,qa,cz);
                let os:i32=own_score(A,qp,qa,i);
                let tot:i64=(cs as i64)*1000+(os as i64);
                if(tot>0){
                    u32put(ord,4+m*4,i as i64);
                    i64put(sc,m*8,tot);
                    if(tot>p1top){p1top=tot;p1topi=i;}
                    m=m+1;
                }
                i=i+1;
            }
            ops_bump(ops,6,n as i64);
            // ---- phase 2: synonym bridge. Fires only when phase-1 is weak
            // (top candidate matches at most one distinct query stem:
            // abstain or weak single-token match). Overrides only on a
            // UNIQUE winner matching at least two distinct canonical stems.
            // Otherwise the phase-1 result stands.
            let p1hits:i32=0;
            if(p1topi>=0){
                let tsj:[]u8=ifield(ib,it,p1topi,3);
                let tcz:i32=cell_find(A,tsj);
                p1hits=dstem_hit(A,qp,qa,tcz,p1topi,syn,0);
            }
            if(p1hits<=1){
                let ord2:[]u8=nio_alloc(4+n*4+8);
                let sc2:[]u8=nio_alloc(n*8+8);
                let m2:i32=0;
                let p2top:i64=-1;let p2topi:i32=-1;
                let i2:i32=0;
                while(i2<n){
                    let sj2:[]u8=ifield(ib,it,i2,3);
                    let cz2:i32=cell_find(A,sj2);
                    let cs2:i32=cell_score2(A,qp,qa,cz2,syn);
                    let os2:i32=own_score2(A,qp,qa,i2,syn);
                    let tot2:i64=(cs2 as i64)*1000+(os2 as i64);
                    if(tot2>0){
                        u32put(ord2,4+m2*4,i2 as i64);
                        i64put(sc2,m2*8,tot2);
                        if(tot2>p2top){p2top=tot2;p2topi=i2;}
                        m2=m2+1;
                    }
                    i2=i2+1;
                }
                ops_bump(ops,6,m2 as i64);
                sort_rank(ord2,sc2,m2);
                if(m2>0 && p2topi>=0){
                    let bt:i64=i64get(sc2,0);
                    let uniq:i32=1;
                    if(m2>1 && i64get(sc2,8)>=bt){uniq=0;}
                    let t2sj:[]u8=ifield(ib,it,p2topi,3);
                    let t2cz:i32=cell_find(A,t2sj);
                    let p2hits:i32=dstem_hit(A,qp,qa,t2cz,p2topi,syn,1);
                    if(p2hits>=2 && uniq==1){
                        let cc:i32=0;
                        while(cc<m2){
                            u32put(ord,4+cc*4,u32get(ord2,4+cc*4));
                            i64put(sc,cc*8,i64get(sc2,cc*8));
                            cc=cc+1;
                        }
                        m=m2;bridged=1;
                    }
                }
                nio_free(ord2);nio_free(sc2);
            }
            nio_free(qp);nio_free(qa);
        }
    }
    sort_rank(ord,sc,m);
    ncand=m;
    let take:i32=m;
    if(take>K){take=K;}
    let res:[]u8=nio_alloc(4+take*4+8);
    u32put(res,0,take as i64);
    let r:i32=0;
    while(r<take){u32put(res,4+r*4,u32get(ord,4+r*4));r=r+1;}
    // report line
    let rl:[]u8=concat(concat(i64s(route as i64),"|"),i64s(nsj as i64));
    let rl2:[]u8=concat(concat(rl,","),i64s(nd as i64));
    nio_free(rl);
    let rl3:[]u8=concat(concat(rl2,","),i64s(nt as i64));
    nio_free(rl2);
    let rl4:[]u8=concat(concat(rl3,"|"),i64s(ncand as i64));
    nio_free(rl3);
    let rl5:[]u8=concat(concat(rl4,"|"),i64s(take as i64));
    nio_free(rl4);
    let rl6:[]u8=concat(concat(rl5,"|"),i64s(bridged as i64));
    nio_free(rl5);
    let at2:i32=4+(u32get(rep,0) as i32);
    let c:i32=0;
    while(c<rl6.len){rep[at2]=rl6[c];at2=at2+1;c=c+1;}
    rep[at2]=10;at2=at2+1;
    u32put(rep,0,(at2-4) as i64);
    nio_free(rl6);
    nio_free(qn);nio_free(hits);nio_free(cand);nio_free(ord);nio_free(sc);
    return res;
}

// ---------------- parsed-lines helper ----------------
// plines(path): arena [nl:u32][off,len]*8B + text; offsets absolute (text at 4+nl*8)
fn plines(path:[]u8)[]u8 {
    let b:[]u8=f_read(path);
    let la:[]u8=lines_of(b);
    let nl:i32=line_n(la);
    let ar:[]u8=nio_alloc(4+nl*8+b.len+8);
    let to:i32=4+nl*8;
    let c2:i32=0;let i:i32=0;
    while(i<nl){
        let o:i32=u32get(la,4+i*8) as i32;let l:i32=u32get(la,4+i*8+4) as i32;
        let k:i32=0;
        while(k<l){ar[to+c2+k]=b[o+k];k=k+1;}
        u32put(ar,4+i*8,(to+c2) as i64);u32put(ar,4+i*8+4,l as i64);
        c2=c2+l;i=i+1;
    }
    u32put(ar,0,nl as i64);
    nio_free(la);
    // NOTE: b intentionally kept alive via alias (bounded leak); do not free
    return ar;
}
fn pl_n(A:[]u8)i32 { return u32get(A,0) as i32; }
fn pl_line(A:[]u8,i:i32)[]u8 {
    let o:i32=u32get(A,4+i*8) as i32;let l:i32=u32get(A,4+i*8+4) as i32;
    return A[o..o+l];
}
fn line_id_of(ln:[]u8)[]u8 {
    let i:i32=0;
    while(i<ln.len){if(ln[i]==124){return ln[0..i];}i=i+1;}
    return ln;
}
// write n entries (8-byte off,len aliasing T's text) as lines to path
fn write_entries(path:[]u8,E:[]u8,T:[]u8,n:i32)void {
    let total:i32=0;let i:i32=0;
    while(i<n){total=total+(u32get(E,4+i*8+4) as i32)+1;i=i+1;}
    let out:[]u8=nio_alloc(total+1);
    let at:i32=0;i=0;
    while(i<n){
        let o:i32=u32get(E,4+i*8) as i32;let l:i32=u32get(E,4+i*8+4) as i32;
        let k:i32=0;
        while(k<l){out[at]=T[o+k];at=at+1;k=k+1;}
        out[at]=10;at=at+1;i=i+1;
    }
    f_write(path,out[0..at]);
    nio_free(out);
    return;
}
// sort entries by id bytes (insertion)
fn sort_by_id(A:[]u8)void {
    let n:i32=pl_n(A);let a:i32=1;
    while(a<n){
        let ao:i32=u32get(A,4+a*8) as i32;let al:i32=u32get(A,4+a*8+4) as i32;
        let aid:[]u8=line_id_of(A[ao..ao+al]);
        let b:i32=a-1;let mv:i32=0;let bdone:i32=0;
        while(b>=0 && bdone==0){
            let bo:i32=u32get(A,4+b*8) as i32;let bl:i32=u32get(A,4+b*8+4) as i32;
            let bid:[]u8=line_id_of(A[bo..bo+bl]);
            if(bytes_lt(aid,bid)==1){
                u32put(A,4+(b+1)*8,bo as i64);u32put(A,4+(b+1)*8+4,bl as i64);
                b=b-1;mv=1;
            } else { bdone=1; }
        }
        if(mv==1){u32put(A,4+(b+1)*8,ao as i64);u32put(A,4+(b+1)*8+4,al as i64);}
        a=a+1;
    }
    return;
}
// write entries as lines to path (each + '\n'); entries alias A text
fn write_lines(A:[]u8,B:[]u8,n:i32,path:[]u8)void {
    write_entries(path,B,A,n);
    return;
}
// filter: keep only lines with exactly 5 pipe-fields and not starting with '#'; dedup by id first-wins.
// returns entry arena [nk:u32][off,len]* aliasing src text in A2 (text buffer kept in returned pair)
fn prep_items(A:[]u8)[]u8 {
    let n:i32=pl_n(A);
    let B:[]u8=nio_alloc(4+n*8+8);
    u32put(B,0,0);
    let dropped:i32=0;
    let i:i32=0;
    while(i<n){
        let ln:[]u8=pl_line(A,i);
        if(ln.len>0 && ln[0]!=35){
            let fa:[]u8=fields_of(ln,124,6);
            if(fld_n(fa)==5){
                let id:[]u8=line_id_of(ln);
                let c:i32=u32get(B,0) as i32;
                let dup:i32=0;let d:i32=0;
                while(d<c){
                    let bo:i32=u32get(B,4+d*8) as i32;let bl:i32=u32get(B,4+d*8+4) as i32;
                    if(bytes_eq(line_id_of(A[bo..bo+bl]),id)==1){dup=1;}
                    d=d+1;
                }
                if(dup==0){
                    let o:i32=u32get(A,4+i*8) as i32;let l:i32=u32get(A,4+i*8+4) as i32;
                    u32put(B,4+c*8,o as i64);u32put(B,4+c*8+4,l as i64);
                    u32put(B,0,(c+1) as i64);
                } else { dropped=dropped+1; }
            }
            nio_free(fa);
        }
        i=i+1;
    }
    sort_by_id(B);
    u32put(B,4+pl_n(B)*8,dropped as i64);
    return B;
}
fn cmd_init(corpus:[]u8,dir:[]u8)void {
    f_mkdir(dir);
    let ops:[]u8=ops_load(dir);
    let A:[]u8=plines(corpus);
    let B:[]u8=prep_items(A);
    let nB:i32=pl_n(B);
    let dropped:i32=u32get(B,4+nB*8) as i32;
    let ip:[]u8=path_join(dir,"items.txt");
    write_lines(A,B,nB,ip);
    nio_free(ip);
    ops_bump(ops,5,nB as i64);
    build_toc(dir,ops);
    ops_save(dir,ops);
    _zag_println(concat(concat("init items=",i64s(nB as i64)),concat(" dropped_dup=",i64s(dropped as i64))));
    nio_free(ops);
    return;
}
fn cmd_install(dir:[]u8,nwf:[]u8)void {
    let ops:[]u8=ops_load(dir);
    let ip:[]u8=path_join(dir,"items.txt");
    let e:[]u8=f_read(ip);
    let nw:[]u8=f_read(nwf);
    let mg:[]u8=concat(concat(e,"\n"),nw);
    let mp:[]u8=path_join(dir,"tmp_merge.txt");
    f_write(mp,mg);
    nio_free(mp);nio_free(mg);
    let A:[]u8=plines(path_join(dir,"tmp_merge.txt"));
    let B:[]u8=prep_items(A);
    let nB:i32=pl_n(B);
    let dropped:i32=u32get(B,4+nB*8) as i32;
    write_lines(A,B,nB,ip);
    nio_free(ip);
    ops_bump(ops,5,nB as i64);
    build_toc(dir,ops);
    ops_save(dir,ops);
    _zag_println(concat(concat("install items=",i64s(nB as i64)),concat(" dropped_dup=",i64s(dropped as i64))));
    nio_free(ops);
    return;
}
// strip one trailing newline (and \r) from text
fn chomp(s:[]u8)[]u8 {
    let l:i32=s.len;
    if(l>0 && s[l-1]==10){l=l-1;}
    if(l>0 && s[l-1]==13){l=l-1;}
    return s[0..l];
}
fn cmd_revise(dir:[]u8,id:[]u8,txf:[]u8)void {
    let ops:[]u8=ops_load(dir);
    let ip:[]u8=path_join(dir,"items.txt");
    let A:[]u8=plines(ip);
    let n:i32=pl_n(A);
    let B:[]u8=nio_alloc(4+n*8+8);
    u32put(B,0,0);
    let newt:[]u8=chomp(f_read(txf));
    let found:i32=0;
    let i:i32=0;
    while(i<n){
        if(bytes_eq(line_id_of(pl_line(A,i)),id)==1){found=1;}
        i=i+1;
    }
    // direct rewrite
    let total:i32=0;i=0;
    while(i<n){
        let ln:[]u8=pl_line(A,i);
        if(bytes_eq(line_id_of(ln),id)==1){
            let fa:[]u8=fields_of(ln,124,5);
            total=total+id.len+1+(fa_f(fa,ln,1)).len+1+(fa_f(fa,ln,2)).len+1+(fa_f(fa,ln,3)).len+1+newt.len+1;
            nio_free(fa);
        } else { total=total+ln.len+1; }
        i=i+1;
    }
    let out:[]u8=nio_alloc(total+1);
    let at:i32=0;i=0;
    while(i<n){
        let ln:[]u8=pl_line(A,i);
        let src:[]u8=ln;
        let isb:i32=0;
        if(bytes_eq(line_id_of(ln),id)==1){
            let fa:[]u8=fields_of(ln,124,5);
            let t1:[]u8=concat(concat(concat(concat(concat(concat(id,"|"),fa_f(fa,ln,1)),"|"),fa_f(fa,ln,2)),"|"),fa_f(fa,ln,3));
            let t2:[]u8=concat(t1,"|");
            nio_free(t1);
            let t3:[]u8=concat(t2,newt);
            nio_free(t2);
            src=t3;isb=1;
            nio_free(fa);
        }
        let k:i32=0;
        while(k<src.len){out[at]=src[k];at=at+1;k=k+1;}
        out[at]=10;at=at+1;
        if(isb==1){nio_free(src);}
        i=i+1;
    }
    f_write(ip,out[0..at]);
    nio_free(out);nio_free(ip);
    ops_bump(ops,5,n as i64);
    build_toc(dir,ops);
    ops_save(dir,ops);
    _zag_println(concat("revise found=",i64s(found as i64)));
    nio_free(ops);nio_free(B);
    return;
}
fn cmd_delete(dir:[]u8,id:[]u8)void {
    let ops:[]u8=ops_load(dir);
    let ip:[]u8=path_join(dir,"items.txt");
    let A:[]u8=plines(ip);
    let n:i32=pl_n(A);
    let B:[]u8=nio_alloc(4+n*8+8);
    u32put(B,0,0);
    let dropped:i32=0;
    let i:i32=0;
    while(i<n){
        let o:i32=u32get(A,4+i*8) as i32;let l:i32=u32get(A,4+i*8+4) as i32;
        if(bytes_eq(line_id_of(A[o..o+l]),id)==1){dropped=dropped+1;}
        else {
            let c:i32=u32get(B,0) as i32;
            u32put(B,4+c*8,o as i64);u32put(B,4+c*8+4,l as i64);
            u32put(B,0,(c+1) as i64);
        }
        i=i+1;
    }
    let nB:i32=u32get(B,0) as i32;
    write_lines(A,B,nB,ip);
    nio_free(ip);
    ops_bump(ops,5,nB as i64);
    build_toc(dir,ops);
    ops_save(dir,ops);
    _zag_println(concat(concat("delete kept=",i64s(nB as i64)),concat(" dropped=",i64s(dropped as i64))));
    nio_free(ops);
    return;
}

// ---------------- lookup command ----------------
// lookup <dir> <queries> <kfile> <out> <report>
fn cmd_lookup(dir:[]u8,qf:[]u8,kf:[]u8,outp:[]u8,rep:[]u8)void {
    let ops:[]u8=ops_load(dir);
    let items:[]u8=load_items(dir,ops);
    let it:[]u8=itab(items);let ib:[]u8=ibuf(items);let n:i32=in_n(items);
    let A:[]u8=toc_load(dir,ib,it,n,ops);
    let qb:[]u8=f_read(qf);
    let qp:[]u8=my_parse(qb);
    let nq:i32=mq_cnt(qp);
    // kfile: qid|K
    let KA:[]u8=plines(kf);
    let nk2:i32=pl_n(KA);
    let ob:[]u8=nio_alloc(nq*64+16);
    u32put(ob,0,0);
    let rb:[]u8=nio_alloc(nq*256+16);
    u32put(rb,0,0);
    let syn:[]u8=syn_build(dir);
    let i:i32=0;
    while(i<nq){
        let qid:[]u8=mq_id(qb,qp,i);
        let qtext:[]u8=mq_text(qb,qp,i);
        let K:i32=1;
        let k2:i32=0;
        while(k2<nk2){
            let ln:[]u8=pl_line(KA,k2);
            let fa:[]u8=fields_of(ln,124,2);
            if(fld_n(fa)==2 && bytes_eq(fa_f(fa,ln,0),qid)==1){
                K=atoi0(fa_f(fa,ln,1));
            }
            nio_free(fa);
            k2=k2+1;
        }
        let res:[]u8=lookup_one(A,ib,it,n,qtext,K,ops,rb,syn);
        let nr:i32=u32get(res,0) as i32;
        // out line: qid|id1,id2  (bytes after 4-byte header)
        let oo:i32=4+(u32get(ob,0) as i32);
        let c:i32=0;
        while(c<qid.len){ob[oo]=qid[c];oo=oo+1;c=c+1;}
        ob[oo]=124;oo=oo+1;
        let r:i32=0;
        while(r<nr){
            let idx:i32=u32get(res,4+r*4) as i32;
            let id:[]u8=ifield(ib,it,idx,0);
            let c2:i32=0;
            while(c2<id.len){ob[oo]=id[c2];oo=oo+1;c2=c2+1;}
            if(r<nr-1){ob[oo]=44;oo=oo+1;}
            r=r+1;
        }
        ob[oo]=10;oo=oo+1;
        u32put(ob,0,(oo-4) as i64);
        nio_free(res);
        i=i+1;
    }
    // rebuild report with qid prefixes (second pass, reading rb lines)
    let rbs:[]u8=rb[4..4+(u32get(rb,0) as i32)];
    let rbl:[]u8=nio_alloc((u32get(rb,0) as i32)+nq*16+8);
    let rat:i32=0;
    let la:[]u8=lines_of(rbs);
    let j:i32=0;
    while(j<nq){
        let qid:[]u8=mq_id(qb,qp,j);
        let ln:[]u8=line_slice(rbs,la,j);
        let c:i32=0;
        while(c<qid.len){rbl[rat]=qid[c];rat=rat+1;c=c+1;}
        rbl[rat]=124;rat=rat+1;
        let c2:i32=0;
        while(c2<ln.len){rbl[rat]=ln[c2];rat=rat+1;c2=c2+1;}
        rbl[rat]=10;rat=rat+1;
        j=j+1;
    }
    nio_free(la);
    f_write(outp,ob[4..4+(u32get(ob,0) as i32)]);
    f_write(rep,rbl[0..rat]);
    ops_save(dir,ops);
    nio_free(ops);
    return;
}
// ---------------- grade command ----------------
// grade <answers> <retrieval> <queries> <gradeout>
// answers: qid|gold1,gold2 (gold may be empty). retrieval: qid|id1,id2.
fn cls_eq(ct:[]u8,ci:i32,cls:[]u8)i32 {
    let k:i32=0;
    while(k<8){
        let a:i32=0;
        if(k<cls.len){a=cls[k] as i32;}
        if((ct[ci*16+k] as i32)!=a){return 0;}
        k=k+1;
    }
    return 1;
}
fn cmd_grade(af:[]u8,rf:[]u8,qf:[]u8,gf:[]u8)void {
    let AA:[]u8=plines(af);
    let RR:[]u8=plines(rf);
    let na:i32=pl_n(AA);let nr:i32=pl_n(RR);
    let qb:[]u8=f_read(qf);
    let qp:[]u8=my_parse(qb);
    let nq:i32=mq_cnt(qp);
    let out:[]u8=nio_alloc(na*160+1024);
    let at:i32=0;
    let npass:i32=0;
    // B2 fix: class table needs 8 counter bytes PER class (2xu32), not 8 total.
    // 32*16 name bytes + 32*8 counter bytes. The old 32*16+8 allocation
    // panicked ("slice index out of bounds") on any battery with >=2
    // distinct query classes (e.g. PURE + SUBJ).
    let ct:[]u8=nio_alloc(32*16+32*8+8);
    let nct:i32=0;
    let ci0:i32=0;
    while(ci0<32){let cc:i32=0;while(cc<8){ct[ci0*16+cc]=0;cc=cc+1;}ci0=ci0+1;}
    let i:i32=0;
    while(i<na){
        let aln:[]u8=pl_line(AA,i);
        let fa:[]u8=fields_of(aln,124,3);
        let qid:[]u8=fa_f(fa,aln,0);
        let gold:[]u8="";
        if(fld_n(fa)>=2){gold=fa_f(fa,aln,1);}
        let ga:[]u8=fields_of(gold,44,512);
        let ng:i32=fld_n(ga);
        if(gold.len==0){ng=0;}
        let ret:[]u8="";
        let r:i32=0;
        while(r<nr){
            let rln:[]u8=pl_line(RR,r);
            let fr:[]u8=fields_of(rln,124,3);
            if(bytes_eq(fa_f(fr,rln,0),qid)==1 && fld_n(fr)>=2){ret=fa_f(fr,rln,1);}
            nio_free(fr);
            r=r+1;
        }
        let ra:[]u8=fields_of(ret,44,512);
        let nret:i32=fld_n(ra);
        if(ret.len==0){nret=0;}
        let ok:i32=1;
        if(nret>ng){ok=0;}
        let g:i32=0;
        while(g<ng){
            let gs:[]u8=fa_f(ga,gold,g);
            let fnd:i32=0;let h:i32=0;
            while(h<nret){
                if(bytes_eq(fa_f(ra,ret,h),gs)==1){fnd=1;}
                h=h+1;
            }
            if(fnd==0){ok=0;}
            g=g+1;
        }
        let cls:[]u8="F5";
        let q2:i32=0;
        while(q2<nq){
            if(bytes_eq(mq_id(qb,qp,q2),qid)==1){cls=mq_class(qb,qp,q2);}
            q2=q2+1;
        }
        let verdict:[]u8="FAIL";
        if(ok==1){verdict="PASS";npass=npass+1;}
        let line:[]u8=concat(concat(concat(concat(concat(qid,"|"),verdict),"|"),cls),"|");
        let line2:[]u8=concat(concat(line,i64s(ng as i64)),"|");
        nio_free(line);
        let line3:[]u8=concat(concat(line2,i64s(nret as i64)),"|");
        nio_free(line2);
        let line4:[]u8=concat(line3,ret);
        nio_free(line3);
        let line5:[]u8=concat(line4,"\n");
        nio_free(line4);
        let c:i32=0;
        while(c<line5.len){out[at]=line5[c];at=at+1;c=c+1;}
        nio_free(line5);
        let ci:i32=0;let cfound:i32=-1;
        while(ci<nct){
            if(cls_eq(ct,ci,cls)==1){cfound=ci;}
            ci=ci+1;
        }
        if(cfound<0){
            cfound=nct;nct=nct+1;
            let cc:i32=0;
            while(cc<8){if(cc<cls.len){ct[cfound*16+cc]=cls[cc];}else{ct[cfound*16+cc]=0;}cc=cc+1;}
            u32put(ct,32*16+cfound*8,0);u32put(ct,32*16+cfound*8+4,0);
        }
        u32put(ct,32*16+cfound*8+4,((u32get(ct,32*16+cfound*8+4) as i32)+1) as i64);
        if(ok==1){u32put(ct,32*16+cfound*8,((u32get(ct,32*16+cfound*8) as i32)+1) as i64);}
        nio_free(fa);nio_free(ga);nio_free(ra);
        i=i+1;
    }
    let sum:[]u8=concat(concat(concat("TOTAL pass=",i64s(npass as i64)),"/"),i64s(na as i64));
    let sum2:[]u8=concat(sum,"\n");
    nio_free(sum);
    let c:i32=0;
    while(c<sum2.len){out[at]=sum2[c];at=at+1;c=c+1;}
    nio_free(sum2);
    let ci2:i32=0;
    while(ci2<nct){
        let cn:[]u8=ct[ci2*16..ci2*16+8];
        let cl2:i32=8;
        while(cl2>0 && cn[cl2-1]==0){cl2=cl2-1;}
        let cl3:[]u8=concat(concat(concat(cn[0..cl2]," pass="),i64s(u32get(ct,32*16+ci2*8) as i64)),"/");
        let cl4:[]u8=concat(concat(cl3,i64s(u32get(ct,32*16+ci2*8+4) as i64)),"\n");
        nio_free(cl3);
        let c2:i32=0;
        while(c2<cl4.len){out[at]=cl4[c2];at=at+1;c2=c2+1;}
        nio_free(cl4);
        ci2=ci2+1;
    }
    f_write(gf,out[0..at]);
    _zag_println(concat(concat("grade pass=",i64s(npass as i64)),concat("/",i64s(na as i64))));
    return;
}
// ---------------- ops command ----------------
fn cmd_ops(dir:[]u8)void {
    let ops:[]u8=ops_load(dir);
    let msg:[]u8=concat(concat(concat(concat(concat(concat("toc_rd=",i64s(i64get(ops,0)))," toc_wr="),i64s(i64get(ops,8)))," kw_build="),i64s(i64get(ops,16)))," agg_re=");
    let msg2:[]u8=concat(concat(msg,i64s(i64get(ops,24)))," item_rd=");
    nio_free(msg);
    let msg3:[]u8=concat(concat(msg2,i64s(i64get(ops,32)))," item_wr=");
    nio_free(msg2);
    let msg4:[]u8=concat(concat(msg3,i64s(i64get(ops,40)))," score=");
    nio_free(msg3);
    let msg5:[]u8=concat(msg4,i64s(i64get(ops,48)));
    nio_free(msg4);
    _zag_println(msg5);
    nio_free(ops);
    return;
}
// ---------------- main ----------------
fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    if(_zag_strcmp(a1,"init")==1){
        cmd_init(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    if(_zag_strcmp(a1,"install")==1){
        cmd_install(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    if(_zag_strcmp(a1,"revise")==1){
        cmd_revise(_zag_arg(2),_zag_arg(3),_zag_arg(4));
        return 0;
    }
    if(_zag_strcmp(a1,"delete")==1){
        cmd_delete(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    if(_zag_strcmp(a1,"lookup")==1){
        cmd_lookup(_zag_arg(2),_zag_arg(3),_zag_arg(4),_zag_arg(5),_zag_arg(6));
        return 0;
    }
    if(_zag_strcmp(a1,"grade")==1){
        cmd_grade(_zag_arg(2),_zag_arg(3),_zag_arg(4),_zag_arg(5));
        return 0;
    }
    if(_zag_strcmp(a1,"ops")==1){
        cmd_ops(_zag_arg(2));
        return 0;
    }
    _zag_println("usage: init|install|revise|delete|lookup|grade|ops ...");
    return 1;
}

// w1a_gen.zag — FRESH deterministic curriculum generator for WS1-A.
// NEW draws (never reuses the R27 C1/C2/C3 fixtures): fresh ground-truth
// constants, draw seed S=7 fixed. Zero RNG anywhere.
// Conditions: cap in {32,128,512} (state size), adv in {0,15,35} (% of
// B-phase episodes adversarial), rep in {1,3} (A->B->C->D cycle repeats).
// Phases per cycle: A nt*8 verified true (establish); B nt*8 mixed
// (adv% impostors+fabricated, unverified; rest true verified); C nt*4
// late true ids verified; D nt*4 true verified (heal). nt = cap/2.

const W1A_SEED:i32=7;

struct Obs { id:i32, op:i32, param:i32, ctx:i32, ver:i32 }

fn w1a_top(t:i32)i32 { return 1+(((t*3+7*W1A_SEED)%5)); }
fn w1a_tparam(t:i32)i32 { return ((t*11+13*W1A_SEED)%9); }
fn w1a_tctx(t:i32,k:i32)i32 { return ((t+2*k+W1A_SEED)%4); }
// Impostor form: a true id with a wrong op/param (designed to bait
// automatic promotion and to overwrite the true slow skill at probe time).
fn w1a_iop(t:i32)i32 { return 1+((w1a_top(t)%5)); }
fn w1a_iparam(t:i32)i32 { return ((w1a_tparam(t)+4)%9); }

fn w1a_nt(cap:i32)i32 { return cap/2; }
fn w1a_cycle(cap:i32)i32 { return 24*w1a_nt(cap); }
fn w1a_total(cap:i32,rep:i32)i32 { return w1a_cycle(cap)*rep; }

fn w1a_true_ep(t:i32,k:i32,o:*Obs)void {
    o.*=Obs{.id=t,.op=w1a_top(t),.param=w1a_tparam(t),.ctx=w1a_tctx(t,k),.ver=1};
}

// Emit episode e of condition (cap,adv) into o. rep selects the cycle count
// only for the total; episodes are periodic in the cycle. Returns 0.
fn w1a_ep(cap:i32,adv:i32,e:i32,o:*Obs)i32 {
    let nt:i32=w1a_nt(cap);
    let cyc:i32=w1a_cycle(cap);
    let ce:i32=e%cyc;
    let ab:i32=8*nt;
    if(ce<ab){
        let t:i32=ce%nt;let k:i32=(ce/nt)%2;
        w1a_true_ep(t,k,o);
        return 0;
    }
    if(ce<2*ab){
        let sub:i32=ce-ab;
        // Deterministic adversarial interleave: ((sub*37+11)%100) < adv.
        if(((sub*37+11)%100)<adv){
            if((sub%2)==0){
                let t:i32=(sub/2)%nt;
                o.*=Obs{.id=t,.op=w1a_iop(t),.param=w1a_iparam(t),
                        .ctx=2+((sub/2)%2),.ver=0};
            } else {
                o.*=Obs{.id=9000+(sub%32),.op=1+(sub%5),.param=sub%9,
                        .ctx=sub%4,.ver=0};
            }
            return 0;
        }
        let t:i32=sub%nt;let k:i32=(sub/nt)%2;
        w1a_true_ep(t,k,o);
        return 0;
    }
    if(ce<2*ab+4*nt){
        let sub:i32=ce-2*ab;
        let half:i32=nt/2;
        let t:i32=half+(sub%half);let k:i32=(sub/half)%2;
        w1a_true_ep(t,k,o);
        return 0;
    }
    let sub:i32=ce-(2*ab+4*nt);
    let t:i32=sub%nt;let k:i32=(sub/nt)%2;
    w1a_true_ep(t,k,o);
    return 0;
}

fn w1a_atoi(s:[]u8)i32 {
    let v:i32=0;let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){ v=v*10+(c-48); }
        i=i+1;
    }
    return v;
}

fn w1a_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn w1a_tag(s:[]u8)void { _zag_print(s); }

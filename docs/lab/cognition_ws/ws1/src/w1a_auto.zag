// w1a_auto.zag — WS1-A arm A2: SILENT AUTOPILOT.
// psm.zag mode=0 logic VERBATIM (timer scan every 10 episodes, raw-exposure
// promote, last-wins slow overwrite, lowest-confidence eviction, no audit),
// driven by the FRESH w1a_gen.zag generator, instrumented with W1C-family
// white-box counters (c_age/c_find/c_scan/c_overwrite/c_evict). Zero RNG.
// Args: cap adv rep.
@import("w1a_gen.zag")
@import("w1a_psm.zag")
@import("w1a_time.zag")
// Pulls the native runtime (nio_alloc/_zag_raw_syscall) into this binary's
// import closure for time_ns. psm logic itself stays import-free.
@import("substrate/cl/common.zag")

fn w1a_cell_labela(cap:i32,adv:i32,rep:i32)void {
    w1a_tag("cap");w1a_num(cap as i64);
    w1a_tag("a");w1a_num(adv as i64);
    w1a_tag("r");w1a_num(rep as i64);
}

fn w1a_auto_spurious(id:i32,op:i32,param:i32,nt:i32)i32 {
    if(id<0 || id>=nt){ return 1; }
    if(op!=w1a_top(id) || param!=w1a_tparam(id)){ return 1; }
    return 0;
}

fn w1a_run_auto(cap:i32,adv:i32,rep:i32,loud:i32)i64 {
    let nf:i32=cap/2;let ns:i32=cap;
    let p:Psm=psm_init(0,nf,ns,4096);
    let pp:*Psm=&p;
    let n:i32=w1a_total(cap,rep);let nt:i32=w1a_nt(cap);
    let ob:Obs=Obs{.id=0,.op=0,.param=0,.ctx=0,.ver=0};
    let t0:i64=time_ns();
    let e:i32=0;
    while(e<n){
        w1a_ep(cap,adv,e,&ob);
        psm_observe(pp,ob.id,ob.op,ob.param,ob.ctx,ob.ver);
        e=e+1;
    }
    let t1:i64=time_ns();
    let dg:i64=psm_digest(pp);
    if(loud==1){
        // Blind probe: frozen slow tier, every true skill.
        let correct:i32=0;let wrong:i32=0;let abstain:i32=0;
        let t:i32=0;
        while(t<nt){
            let oo:i32=0;let pa:i32=0;
            let f:i32=psm_probe(pp,t,&oo,&pa);
            if(f==0){ abstain=abstain+1; }
            else if(oo==w1a_top(t) && pa==w1a_tparam(t)){ correct=correct+1; }
            else { wrong=wrong+1; }
            t=t+1;
        }
        let spur:i32=0;let si:i32=0;
        while(si<ns){
            let id:i32=0;let op:i32=0;let pa:i32=0;let cf:i32=0;
            if(psm_slow_get(pp,si,&id,&op,&pa,&cf)==1){
                if(w1a_auto_spurious(id,op,pa,nt)==1){ spur=spur+1; }
            }
            si=si+1;
        }
        w1a_tag("WS1A,cell=");w1a_cell_labela(cap,adv,rep);
        w1a_tag(",probe,arm=auto,correct=");w1a_num(correct as i64);
        w1a_tag(",wrong=");w1a_num(wrong as i64);
        w1a_tag(",abstain=");w1a_num(abstain as i64);
        w1a_tag(",spurious=");w1a_num(spur as i64);
        w1a_tag("\n");
        w1a_tag("WS1A,cell=");w1a_cell_labela(cap,adv,rep);
        w1a_tag(",arm=auto,cost,find_steps=");w1a_num(p.c_find);
        w1a_tag(",scan_steps=");w1a_num(p.c_age+p.c_scan);
        w1a_tag(",mutops=");w1a_num(p.n_consol as i64);
        w1a_tag(",suppress=0");
        w1a_tag(",consol=");w1a_num(p.n_consol as i64);
        w1a_tag(",overwrite=");w1a_num(p.c_overwrite);
        w1a_tag(",evict=");w1a_num(p.c_evict);
        w1a_tag(",dropped=");w1a_num(p.dropped as i64);
        w1a_tag(",arena_bytes=");w1a_num((nf*9*4+ns*5*4+4096*4*4) as i64);
        w1a_tag("\n");
        w1a_tag("WS1A,cell=");w1a_cell_labela(cap,adv,rep);
        w1a_tag(",arm=auto,time,wall_ns=");w1a_num(t1-t0);
        w1a_tag(",episodes=");w1a_num(n as i64);
        w1a_tag("\n");
        w1a_tag("WS1A,cell=");w1a_cell_labela(cap,adv,rep);
        w1a_tag(",arm=auto,digest=");w1a_num(dg);w1a_tag("\n");
    }
    return dg;
}

fn main()i32 {
    let cap:i32=w1a_atoi(_zag_arg(1));
    let adv:i32=w1a_atoi(_zag_arg(2));
    let rep:i32=w1a_atoi(_zag_arg(3));
    if(!((cap==32||cap==128||cap==512)&&(adv==0||adv==15||adv==35)&&(rep==1||rep==3))){
        w1a_tag("WS1A,usage: w1a_auto cap{32,128,512} adv{0,15,35} rep{1,3}\n");
        return 2;
    }
    let d1:i64=w1a_run_auto(cap,adv,rep,1);
    let d2:i64=w1a_run_auto(cap,adv,rep,0);
    w1a_tag("WS1A,cell=");w1a_cell_labela(cap,adv,rep);
    w1a_tag(",arm=auto,determinism,match=");w1a_num((d1==d2) as i64);w1a_tag("\n");
    w1a_tag("WS1A,DONE\n");
    return 0;
}

// w1a_time.zag — wall-clock for WS1-A cost measurement (pure Zag).
// time_ns() returns CLOCK_MONOTONIC ns (Linux x86-64 syscall 228).
// Measurement only: never feeds a decision, never enters digests.
// Adapted from deliberation_depth harness dlb_time.zag (proven pattern).

fn time_ns()i64 {
    let ts:[]u8=nio_alloc(16);
    if(ts.len==0){return -1;}
    let rc:i64=_zag_raw_syscall(228,1,_zag_slice_ptr(ts) as i64,0,0,0,0);
    if(rc!=0){nio_free(ts);return -1;}
    let sec:i64=0;let nsec:i64=0;let k:i32=0;
    while(k<8){
        sec=sec+((ts[k] as i64)<<(k*8));
        nsec=nsec+((ts[8+k] as i64)<<(k*8));
        k=k+1;
    }
    nio_free(ts);
    return sec*1000000000+nsec;
}

// w1a_common.zag — WS1-A shared harness for the deliberate KB-control arms.
// Adapted from kb3_common.zag (2026-09-24 KBCONTROL bill): same driver-side
// judgment-state model and blind probe, but (a) driven by the FRESH
// w1a_gen.zag generator, (b) instrumented with white-box counters (W1C).
// No RNG anywhere in this file.

@import("w1a_gen.zag")
@import("w1a_memory_core.zag")

// White-box work counters. find_steps: per-episode store-scan slot visits.
// scan_steps: periodic full-tier scan slot visits (0 on deliberate arms).
// mutops: issued mutating store ops (derived from outcome tallies in the
// drivers: every issued op lands in exactly one tally bucket).
// suppress: adversarial observations suppressed (never installed/overwritten).
struct W1C { find_steps:i64, scan_steps:i64, mutops:i64, suppress:i64 }

fn w1c_init()W1C { return W1C{.find_steps=0,.scan_steps=0,.mutops=0,.suppress=0}; }

// The MA store holds one packed value per slot: value = op*16+param
// (op in 1..5, param in 0..8 -> max 88).
fn w1a_pack(op:i32,param:i32)i32 { return op*16+param; }
fn w1a_trueval(t:i32)i32 { return w1a_pack(w1a_top(t),w1a_tparam(t)); }

// A stored (id,value) is a true skill's true form iff id is a true id and
// the packed value equals the true form.
fn w1a_is_true(id:i32,v:i32,nt:i32)i32 {
    if(id<0 || id>=nt){ return 0; }
    if(v==w1a_trueval(id)){ return 1; }
    return 0;
}

// Driver-side per-slot judgment state (deterministic functions of the op
// sequence; NOT part of the audited MaStore — the audit covers the store).
// kid[i] = memory id in slot i (-1 = empty), kver[i] = verified sightings,
// kctx[i] = context bitmask. Backed by []u8 arenas (no []i32 casts).
fn w1a_side_init(kid:[]u8,kver:[]u8,kctx:[]u8,cap:i32)i32 {
    let i:i32=0;
    while(i<cap){ ma_i32_set(kid,i*4,-1); ma_i32_set(kver,i*4,0); ma_i32_set(kctx,i*4,0); i=i+1; }
    return 0;
}
fn w1a_side_clear(kid:[]u8,kver:[]u8,kctx:[]u8,slot:i32)i32 {
    ma_i32_set(kid,slot*4,-1);ma_i32_set(kver,slot*4,0);ma_i32_set(kctx,slot*4,0);
    return 0;
}
// Linear find over the live store; counts every slot visit into c.find_steps.
fn w1a_find(kid:[]u8,s:*MaStore,cap:i32,id:i32,c:*W1C)i32 {
    let i:i32=0;
    while(i<cap){
        c.*.find_steps=c.*.find_steps+1;
        if(s.*.live[i]==1 && ma_i32_get(kid,i*4)==id){ return i; }
        i=i+1;
    }
    return -1;
}
fn w1a_popcount(x:i32)i32 {
    let n:i32=0;let b:i32=0;
    while(b<32){ if((x&(1<<b))!=0){n=n+1;} b=b+1; }
    return n;
}

// Blind probe: for each true id, classify recall.
// Prints ",probe,arm=<armn>,correct=..." (driver prints the WS1A,cell=
// prefix first). out_* carry the counts. Probe work is evaluator-side:
// the probe-time find is NOT counted into arm cost.
fn w1a_probe(s:*MaStore,kid:[]u8,cap:i32,nt:i32,armn:[]u8,
            out_c:*i32,out_w:*i32,out_a:*i32,out_s:*i32)i32 {
    let correct:i32=0;let wrong:i32=0;let abstain:i32=0;
    let t:i32=0;
    while(t<nt){
        let slot:i32=w1a_find_nocount(kid,s,cap,t);
        if(slot<0){ abstain=abstain+1; }
        else if(ma_i32_get(s.*.value,slot*4)==w1a_trueval(t)){ correct=correct+1; }
        else { wrong=wrong+1; }
        t=t+1;
    }
    let spur:i32=0;let si:i32=0;
    while(si<cap){
        if(s.*.live[si]==1){
            if(w1a_is_true(ma_i32_get(kid,si*4),ma_i32_get(s.*.value,si*4),nt)==0){ spur=spur+1; }
        }
        si=si+1;
    }
    out_c.*=correct;out_w.*=wrong;out_a.*=abstain;out_s.*=spur;
    w1a_tag(",probe,arm=");w1a_tag(armn);
    w1a_tag(",correct=");w1a_num(correct as i64);
    w1a_tag(",wrong=");w1a_num(wrong as i64);
    w1a_tag(",abstain=");w1a_num(abstain as i64);
    w1a_tag(",spurious=");w1a_num(spur as i64);
    w1a_tag("\n");
    return 0;
}
// Probe-time find: no counter (probe work is evaluator-side, not arm cost).
fn w1a_find_nocount(kid:[]u8,s:*MaStore,cap:i32,id:i32)i32 {
    let i:i32=0;
    while(i<cap){
        if(s.*.live[i]==1 && ma_i32_get(kid,i*4)==id){ return i; }
        i=i+1;
    }
    return -1;
}

// Determinism digest over store + side state + audit position.
fn w1a_digest(s:*MaStore,kid:[]u8,kver:[]u8,kctx:[]u8,cap:i32)i32 {
    let fp:i32=s.*.audit_n*131+s.*.stage*1000003+s.*.clock;
    let i:i32=0;
    while(i<cap){
        fp=fp+(s.*.live[i] as i32)*(i+1)+ma_i32_get(s.*.value,i*4)+ma_i32_get(kid,i*4)+
           ma_i32_get(kver,i*4)*7+ma_i32_get(kctx,i*4)*13+
           (s.*.pinned[i] as i32)*1009+(s.*.tier[i] as i32)*101+(s.*.region[i] as i32)*10007;
        i=i+1;
    }
    return fp;
}

// Arena bytes (computed constants, MA_CAP=512, MA_AUDIT_CAP=16384):
// store: live+pinned+region+tier 4*512 + value+step 2*2048 + audit 16384*10*4
// side: kid+kver+kctx 3*2048. Reported per run (deterministic).
fn w1a_arena_bytes()i64 {
    return 4*512+2*2048+16384*10*4+3*2048;
}

// MA1 — conscious memory agency op set (native Zag).
// The learner's deliberate memory actions: ADD / KILL / PIN / UNPIN /
// PROMOTE_TO_LONGTERM / DEMOTE_TO_SHORTTERM, with a protected CORE region,
// staged autonomy, an append-only audit ledger, and rollback.
// Integer-only (playbook-proven subset). No reward signal anywhere in this
// file: values are declared by the learner at ADD time (explicit judgment).
@import("substrate/cl/common.zag")

const MA_CAP:i32=512;
const MA_AUDIT_CAP:i32=16384;
// WS1-A build note: MA_CAP 256->512 (cap=512 state-size cells), MA_AUDIT_CAP
// 4096->16384 (larger battery: ~18k episodes max). Only size constants changed.
const MA_AUDIT_WORDS:i32=10; // op,slot,rc,b1,b2,b3,a1,a2,a3,stage

const MA_REGION_CORE:i32=0;
const MA_REGION_USER:i32=1;
const MA_TIER_SHORT:i32=0;
const MA_TIER_LONG:i32=1;

const MA_OP_ADD:i32=1;
const MA_OP_KILL:i32=2;
const MA_OP_PIN:i32=3;
const MA_OP_UNPIN:i32=4;
const MA_OP_PROMOTE:i32=5;
const MA_OP_DEMOTE:i32=6;
const MA_OP_ROLLBACK:i32=7;
const MA_OP_SETSTAGE:i32=8;

const MA_OK:i32=0;
const MA_REFUSED_CORE:i32=101;
const MA_REFUSED_PINNED:i32=102;
const MA_REFUSED_NOTLIVE:i32=103;
const MA_REFUSED_FULL:i32=104;
const MA_REFUSED_STAGE:i32=105;
const MA_REFUSED_BADSLOT:i32=106;
const MA_REFUSED_AUDITFULL:i32=107;
const MA_REFUSED_NOROLLBACK:i32=108;

const MA_STAGE_NONE:i32=0;
const MA_STAGE_ADD:i32=1;
const MA_STAGE_MANAGE:i32=2;
const MA_STAGE_KILL:i32=3;

struct MaStore {
    live: []u8,
    value: []u8,
    pinned: []u8,
    region: []u8,
    tier: []u8,
    step: []u8,
    audit: []u8,
    audit_n: i32,
    stage: i32,
    clock: i32
}

// little-endian i32 packing (playbook §12 idiom: no []i32 allocator observed)
fn ma_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn ma_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn ma_init()MaStore {
    let live:[]u8=nio_alloc(MA_CAP);
    let value:[]u8=nio_alloc(MA_CAP*4);
    let pinned:[]u8=nio_alloc(MA_CAP);
    let region:[]u8=nio_alloc(MA_CAP);
    let tier:[]u8=nio_alloc(MA_CAP);
    let step:[]u8=nio_alloc(MA_CAP*4);
    let audit:[]u8=nio_alloc(MA_AUDIT_CAP*MA_AUDIT_WORDS*4);
    // nio_alloc is NOT zeroed (playbook §12) — zero everything by hand.
    let i:i32=0;while(i<MA_CAP){live[i]=0;pinned[i]=0;region[i]=0;tier[i]=0;i=i+1;}
    i=0;while(i<MA_CAP*4){value[i]=0;step[i]=0;i=i+1;}
    i=0;while(i<MA_AUDIT_CAP*MA_AUDIT_WORDS*4){audit[i]=0;i=i+1;}
    return MaStore{.live=live,.value=value,.pinned=pinned,.region=region,.tier=tier,.step=step,
        .audit=audit,.audit_n=0,.stage=MA_STAGE_NONE,.clock=0};
}

// Snapshot words: w1 = live|pinned<<8|tier<<16|region<<24, w2 = value, w3 = step.
fn ma_snap(s:*MaStore,slot:i32,w1:*i32,w2:*i32,w3:*i32)void {
    w1.*=(s.*.live[slot] as i32)|((s.*.pinned[slot] as i32)<<8)|((s.*.tier[slot] as i32)<<16)|((s.*.region[slot] as i32)<<24);
    w2.*=ma_i32_get(s.*.value,slot*4);
    w3.*=ma_i32_get(s.*.step,slot*4);
}
fn ma_restore(s:*MaStore,slot:i32,w1:i32,w2:i32,w3:i32)void {
    s.*.live[slot]=(w1&255) as u8;s.*.pinned[slot]=((w1>>8)&255) as u8;
    s.*.tier[slot]=((w1>>16)&255) as u8;s.*.region[slot]=((w1>>24)&255) as u8;
    ma_i32_set(s.*.value,slot*4,w2);ma_i32_set(s.*.step,slot*4,w3);
}

fn ma_audit_append(s:*MaStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s.*.audit_n>=MA_AUDIT_CAP){return MA_REFUSED_AUDITFULL;}
    let e:i32=s.*.audit_n*MA_AUDIT_WORDS*4;
    ma_i32_set(s.*.audit,e+0,op);ma_i32_set(s.*.audit,e+4,slot);ma_i32_set(s.*.audit,e+8,rc);
    ma_i32_set(s.*.audit,e+12,b1);ma_i32_set(s.*.audit,e+16,b2);ma_i32_set(s.*.audit,e+20,b3);
    ma_i32_set(s.*.audit,e+24,a1);ma_i32_set(s.*.audit,e+28,a2);ma_i32_set(s.*.audit,e+32,a3);
    ma_i32_set(s.*.audit,e+36,s.*.stage);
    s.*.audit_n=s.*.audit_n+1;s.*.clock=s.*.clock+1;
    return MA_OK;
}
fn ma_badslot(s:*MaStore,slot:i32)i32 {
    if(s==null as *MaStore || slot<0 || slot>=MA_CAP){return 1;}return 0;
}

// ---- operations: every path (success AND refusal) is audited ----

fn ma_add(s:*MaStore,value:i32,region:i32,out_slot:*i32)i32 {
    if(s==null as *MaStore || out_slot==null as *i32 || (region!=MA_REGION_CORE && region!=MA_REGION_USER)){return cl_bad();}
    if(s.*.stage<MA_STAGE_ADD){out_slot.*=-1;ma_audit_append(s,MA_OP_ADD,-1,MA_REFUSED_STAGE,0,0,0,0,0,0);return MA_REFUSED_STAGE;}
    let slot:i32=0;while(slot<MA_CAP){if(s.*.live[slot]==0){break;}slot=slot+1;}
    if(slot>=MA_CAP){out_slot.*=-1;ma_audit_append(s,MA_OP_ADD,-1,MA_REFUSED_FULL,0,0,0,0,0,0);return MA_REFUSED_FULL;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    s.*.live[slot]=1;s.*.pinned[slot]=0;s.*.region[slot]=region as u8;s.*.tier[slot]=MA_TIER_SHORT as u8;
    ma_i32_set(s.*.value,slot*4,value);ma_i32_set(s.*.step,slot*4,s.*.clock);
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    out_slot.*=slot;ma_audit_append(s,MA_OP_ADD,slot,MA_OK,b1,b2,b3,a1,a2,a3);
    return MA_OK;
}

// Capacity-bounded ADD: identical to ma_add but only considers slots
// 0..cap-1 (lets a trial run a smaller effective store on a big core).
fn ma_add_lim(s:*MaStore,value:i32,region:i32,cap:i32,out_slot:*i32)i32 {
    if(s==null as *MaStore || out_slot==null as *i32 || cap<1 || cap>MA_CAP ||
       (region!=MA_REGION_CORE && region!=MA_REGION_USER)){return cl_bad();}
    if(s.*.stage<MA_STAGE_ADD){out_slot.*=-1;ma_audit_append(s,MA_OP_ADD,-1,MA_REFUSED_STAGE,0,0,0,0,0,0);return MA_REFUSED_STAGE;}
    let slot:i32=0;while(slot<cap){if(s.*.live[slot]==0){break;}slot=slot+1;}
    if(slot>=cap){out_slot.*=-1;ma_audit_append(s,MA_OP_ADD,-1,MA_REFUSED_FULL,0,0,0,0,0,0);return MA_REFUSED_FULL;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    s.*.live[slot]=1;s.*.pinned[slot]=0;s.*.region[slot]=region as u8;s.*.tier[slot]=MA_TIER_SHORT as u8;
    ma_i32_set(s.*.value,slot*4,value);ma_i32_set(s.*.step,slot*4,s.*.clock);
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    out_slot.*=slot;ma_audit_append(s,MA_OP_ADD,slot,MA_OK,b1,b2,b3,a1,a2,a3);
    return MA_OK;
}

fn ma_kill(s:*MaStore,slot:i32)i32 {
    if(ma_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=MA_OK;
    if(s.*.stage<MA_STAGE_KILL){rc=MA_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=MA_REFUSED_NOTLIVE;}
    else if(s.*.region[slot]==MA_REGION_CORE as u8){rc=MA_REFUSED_CORE;}
    else if(s.*.pinned[slot]==1){rc=MA_REFUSED_PINNED;}
    if(rc==MA_OK){
        s.*.live[slot]=0;s.*.pinned[slot]=0;s.*.tier[slot]=MA_TIER_SHORT as u8;
        s.*.region[slot]=MA_REGION_CORE as u8;ma_i32_set(s.*.value,slot*4,0);ma_i32_set(s.*.step,slot*4,0);
    }
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    ma_audit_append(s,MA_OP_KILL,slot,rc,b1,b2,b3,a1,a2,a3);
    return rc;
}

fn ma_pin(s:*MaStore,slot:i32)i32 {
    if(ma_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=MA_OK;
    if(s.*.stage<MA_STAGE_MANAGE){rc=MA_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=MA_REFUSED_NOTLIVE;}
    else if(s.*.region[slot]==MA_REGION_CORE as u8){rc=MA_REFUSED_CORE;}
    if(rc==MA_OK){s.*.pinned[slot]=1;}
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    ma_audit_append(s,MA_OP_PIN,slot,rc,b1,b2,b3,a1,a2,a3);
    return rc;
}

fn ma_unpin(s:*MaStore,slot:i32)i32 {
    if(ma_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=MA_OK;
    if(s.*.stage<MA_STAGE_MANAGE){rc=MA_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=MA_REFUSED_NOTLIVE;}
    if(rc==MA_OK){s.*.pinned[slot]=0;}
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    ma_audit_append(s,MA_OP_UNPIN,slot,rc,b1,b2,b3,a1,a2,a3);
    return rc;
}

fn ma_promote(s:*MaStore,slot:i32)i32 {
    if(ma_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=MA_OK;
    if(s.*.stage<MA_STAGE_MANAGE){rc=MA_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=MA_REFUSED_NOTLIVE;}
    if(rc==MA_OK){s.*.tier[slot]=MA_TIER_LONG as u8;}
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    ma_audit_append(s,MA_OP_PROMOTE,slot,rc,b1,b2,b3,a1,a2,a3);
    return rc;
}

fn ma_demote(s:*MaStore,slot:i32)i32 {
    if(ma_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=MA_OK;
    if(s.*.stage<MA_STAGE_MANAGE){rc=MA_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=MA_REFUSED_NOTLIVE;}
    if(rc==MA_OK){s.*.tier[slot]=MA_TIER_SHORT as u8;}
    let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
    ma_audit_append(s,MA_OP_DEMOTE,slot,rc,b1,b2,b3,a1,a2,a3);
    return rc;
}

fn ma_set_stage(s:*MaStore,stage:i32)i32 {
    if(s==null as *MaStore || stage<MA_STAGE_NONE || stage>MA_STAGE_KILL){return cl_bad();}
    let b1:i32=s.*.stage;s.*.stage=stage;
    ma_audit_append(s,MA_OP_SETSTAGE,-1,MA_OK,b1,0,0,stage,0,0);
    return MA_OK;
}

// Roll back the most recent successful mutating op. The rollback is itself
// audited (before = pre-rollback state, after = restored state).
fn ma_rollback_last(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let i:i32=s.*.audit_n-1;
    while(i>=0){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK && op!=MA_OP_ROLLBACK && op!=MA_OP_SETSTAGE &&
           (op==MA_OP_ADD||op==MA_OP_KILL||op==MA_OP_PIN||op==MA_OP_UNPIN||op==MA_OP_PROMOTE||op==MA_OP_DEMOTE)){
            let slot:i32=ma_i32_get(s.*.audit,e+4);
            let b1:i32=0;let b2:i32=0;let b3:i32=0;ma_snap(s,slot,&b1,&b2,&b3);
            ma_restore(s,slot,ma_i32_get(s.*.audit,e+12),ma_i32_get(s.*.audit,e+16),ma_i32_get(s.*.audit,e+20));
            let a1:i32=0;let a2:i32=0;let a3:i32=0;ma_snap(s,slot,&a1,&a2,&a3);
            ma_audit_append(s,MA_OP_ROLLBACK,slot,MA_OK,b1,b2,b3,a1,a2,a3);
            return MA_OK;
        }
        i=i-1;
    }
    return MA_REFUSED_NOROLLBACK;
}

// Global invariant 1: every refused op left state untouched (before==after).
fn ma_audit_clean_refusals(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc!=MA_OK){
            if(ma_i32_get(s.*.audit,e+12)!=ma_i32_get(s.*.audit,e+24)){return 1;}
            if(ma_i32_get(s.*.audit,e+16)!=ma_i32_get(s.*.audit,e+28)){return 1;}
            if(ma_i32_get(s.*.audit,e+20)!=ma_i32_get(s.*.audit,e+32)){return 1;}
        }
        i=i+1;
    }
    return MA_OK;
}

// Global invariant 2: replaying the ledger from genesis reconstructs exact
// live state (slot fields + stage + entry count). The testable definition
// of "conscious": no state change without an audit entry.
fn ma_replay_check(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let sh:MaStore=ma_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let slot:i32=ma_i32_get(s.*.audit,e+4);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK){
            if(op==MA_OP_SETSTAGE){sh.stage=ma_i32_get(s.*.audit,e+24);}
            else{ma_restore(&sh,slot,ma_i32_get(s.*.audit,e+24),ma_i32_get(s.*.audit,e+28),ma_i32_get(s.*.audit,e+32));}
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<MA_CAP){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(sh.pinned[i]!=s.*.pinned[i]){bad=1;}
        if(sh.tier[i]!=s.*.tier[i]){bad=1;}
        if(sh.region[i]!=s.*.region[i]){bad=1;}
        if(ma_i32_get(sh.value,i*4)!=ma_i32_get(s.*.value,i*4)){bad=1;}
        if(ma_i32_get(sh.step,i*4)!=ma_i32_get(s.*.step,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.stage!=s.*.stage){bad=1;}
    nio_free(sh.live);nio_free(sh.value);nio_free(sh.pinned);nio_free(sh.region);
    nio_free(sh.tier);nio_free(sh.step);nio_free(sh.audit);
    if(bad==1){return 1;}
    return MA_OK;
}

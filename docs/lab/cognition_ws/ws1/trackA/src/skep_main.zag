// skep_main.zag — Track A four-arm head-to-head driver (WS1C).
//
// Usage:
//   skep_main <items.jsonl> <arm:1|2|3|4> <results.jsonl> <metrics.jsonl>
//
// arm: 1=forced-conscious (tocap), 2=forced+skepticism, 3=autopilot,
//      4=router (D-D gate -> autopilot if suspect else forced).
//
// Refusal-class items (task_type starts with "refuse") run the refusal
// paths: arms 1/2/4 deliberate (mode 5 semantics; arm 2/4 compute the gate),
// arm 3 uses the fastref rule only (no deliberation).
//
// results.jsonl: id, arm, verdict, confidence, gate, reason, rounds_used,
//   evidence_consumed, ground_truth, correct, ops.
// metrics.jsonl: id, ops, rounds, ev, correct (no wall clock: byte-identical
//   across reruns by construction).
//
// Pure Zag, zero RNG. Exit code: 0 = all items clean; N>0 = N item errors;
// 102 = IO error.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("dlb_time.zag")
@import("skep_lib.zag")

fn sm_is_refuse(it:*Item)i32 {
    let t:[]u8=dj_tt(it);
    if(t.len<6){return 0;}
    if(t[0]==114 && t[1]==101 && t[2]==102 && t[3]==117 && t[4]==115 && t[5]==101){return 1;}
    return 0;
}

fn sm_emit_result(res:*DOut,it:*Item,st:*DSt,arm:i32,fire:i32,reason:i32,verdict:[]u8,conf:i32,ops:i64)void {
    dout_str(res,"{\"id\":\"");
    dout_str(res,dj_id(it));
    dout_str(res,"\",\"arm\":");
    dout_i64(res,arm as i64);
    dout_str(res,",\"verdict\":\"");
    dout_str(res,verdict);
    dout_str(res,"\",\"confidence\":");
    dout_i64(res,conf as i64);
    dout_str(res,",\"gate\":");
    dout_i64(res,fire as i64);
    dout_str(res,",\"reason\":");
    dout_i64(res,reason as i64);
    dout_str(res,",\"rounds_used\":");
    dout_i64(res,st.*.rounds as i64);
    dout_str(res,",\"evidence_consumed\":");
    dout_i64(res,st.*.consumed as i64);
    dout_str(res,",\"ground_truth\":\"");
    dout_str(res,dj_gt(it));
    let corr:i32=0;
    if(dlb_streq(verdict,dj_gt(it))==1){corr=1;}
    dout_str(res,"\",\"correct\":");
    dout_i64(res,corr as i64);
    dout_str(res,",\"ops\":");
    dout_i64(res,ops);
    dout_str(res,"}");
    dout_line(res);
}

fn sm_emit_metric(mo:*DOut,it:*Item,st:*DSt,ops:i64)void {
    dout_str(mo,"{\"id\":\"");
    dout_str(mo,dj_id(it));
    dout_str(mo,"\",\"ops\":");
    dout_i64(mo,ops);
    dout_str(mo,",\"rounds\":");
    dout_i64(mo,st.*.rounds as i64);
    dout_str(mo,",\"ev\":");
    dout_i64(mo,st.*.consumed as i64);
    dout_str(mo,"}");
    dout_line(mo);
}

fn sm_run(items_path:[]u8,arm:i32,res_path:[]u8,met_path:[]u8)i32 {
    // frozen tocap config, built in code (same values as tocap.cfg)
    let cfg:DCfg=DCfg{.mode=5,.shallow_rounds=1,.deep_rounds=16,.amin=3,.amax=16,.conf_thr=800,.stab_win=3,.eps=20,.elim_margin=900,.refute_thr=600,.evcap=64};
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);
    it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);
    it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);
    it.att=nio_alloc(64*16*8);
    if(it.hid.len==0 || it.eid.len==0){nio_free(ibuf);return 102;}
    let hcap:i32=18;
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds=0,.consumed=0,.leader=-1,.margin=0,.conf=0,.hcap=hcap,.ops=0};
    st.scores=nio_alloc(16*8);
    st.alive=nio_alloc(16);
    st.hist_l=nio_alloc(hcap*4);
    st.hist_m=nio_alloc(hcap*8);
    st.hist_c=nio_alloc(hcap*4);
    if(st.scores.len==0 || st.alive.len==0){nio_free(ibuf);return 102;}
    let damp:[]u8=nio_alloc(64);
    if(damp.len==0){nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n=0,.cap=0,.err=0};
    let meo:DOut=DOut{.buf:"",.n=0,.cap=0,.err=0};
    let lgo:DOut=DOut{.buf:"",.n=0,.cap=0,.err=0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&meo,4194304)!=0){return 102;}
    if(dout_init(&lgo,16777216)!=0){return 102;}
    let lg:LG=LG{.seq=0,.prev="",.head=""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let items:i32=0;let good:i32=0;let errs:i32=0;
    let pos:i32=0;let lineno:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        lineno=lineno+1;
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0){
            items=items+1;
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0 && ok==1){
                let g:GateOut=GateOut{.fire=0,.reason=0,.m=0,.a=0,.f=0};
                let isref:i32=sm_is_refuse(&it);
                let verdict:[]u8="";
                let conf:i32=0;
                let ops:i64=0;
                if(isref==1 && arm==3){
                    // arm 3 refusal path: fastref rule only
                    let fops:i64=0;
                    let fr:i32=skp_fr_decide(&it,&fops);
                    if(fr==1){verdict="REFUSE";}else{verdict="ALLOW";}
                    conf=-1;
                    ops=fops;
                    st.rounds=1;st.consumed=0;
                }
                if(isref==0 || arm!=3){
                    skp_gate(&it,&cfg,&g,damp);
                    let drc:i32=skp_run_arm(&st,&it,&cfg,&lg,&lgo,arm,&g,damp);
                    if(drc!=0){ok=0;}
                    if(drc==0){
                        verdict=dj_hid(&it,st.leader);
                        conf=st.conf;
                        ops=st.ops;
                    }
                }
                if(ok==1){
                    sm_emit_result(&res,&it,&st,arm,g.fire,g.reason,verdict,conf,ops);
                    sm_emit_metric(&meo,&it,&st,ops);
                    if(res.err!=0){ok=0;}
                    if(meo.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                    good=good+1;
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0 && meo.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
        if(wrc>=0){wrc=dlb_write_file(met_path,dout_bytes(&meo),meo.n);}
    }
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    nio_free(st.scores);nio_free(st.alive);
    nio_free(st.hist_l);nio_free(st.hist_m);nio_free(st.hist_c);
    nio_free(damp);
    dout_free(&res);dout_free(&meo);dout_free(&lgo);
    lg_free(&lg);
    let sum:DOut=DOut{.buf:"",.n=0,.cap=0,.err=0};
    if(dout_init(&sum,256)==0){
        dout_str(&sum,"items=");
        dout_i64(&sum,items as i64);
        dout_str(&sum," ok=");
        dout_i64(&sum,good as i64);
        dout_str(&sum," err=");
        dout_i64(&sum,errs as i64);
        dout_line(&sum);
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    if(ok==0 || wrc<0){return 102;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: skep_main <items.jsonl> <arm:1|2|3|4> <results.jsonl> <metrics.jsonl>");
        return 64;
    }
    let arm:i32=dlb_atoi(_zag_arg(2));
    if(arm<1 || arm>4){
        _zag_println("arm must be 1, 2, 3, or 4");
        return 64;
    }
    return sm_run(_zag_arg(1),arm,_zag_arg(3),_zag_arg(4));
}

// codegen.zag — deterministic Z0 program generator for the STEP 5a code
// curriculum pilot (trainer side). The generator MAY use the world oracle
// (semantics.zag); the learner (learner.zag) never does.
//
// 12 stages (C1..C12), each with scaffold templates (tmpl 0,1,2) and held-out
// templates (tmpl 3,4,5) that are structurally disjoint. Template id for the
// transcript: tid = stage*100000 + kindcode*10000 + tmpl*100 + inst.
// kindcode: 0=scaffold 1=trap 2=watch 3=held-out 4=faultloc 5=composition
//            6=k3var 7=k4probe 8=c7varprobe 9=poison
// Closed-form over (stage, kind, idx). No RNG anywhere.
@import("semantics.zag")

// ---- assembler: instruction buffer + heap ----
struct Asm {
    b: []u8,  // word-addressed buffer (byte slice)
    ni: i32,  // instruction count
    nh: i32   // heap word count
}
fn asm_new() Asm {
    let b:[]u8=nio_alloc(512*4);
    zu_set(b,0,1);
    zu_set(b,4,0);
    return Asm{.b=b,.ni=0,.nh=0};
}
fn asm_free(a:*Asm)void {
    nio_free(a.*.b);
    a.*.ni=0;a.*.nh=0;
}
fn e(a:*Asm,op:i32,x:i32,y:i32,z:i32)void {
    let w:i32=2+a.*.ni*4;
    zu_set(a.*.b,w*4,op);
    zu_set(a.*.b,(w+1)*4,x);
    zu_set(a.*.b,(w+2)*4,y);
    zu_set(a.*.b,(w+3)*4,z);
    a.*.ni=a.*.ni+1;
}
fn asm_heap(a:*Asm,v:i32)void {
    zu_set(a.*.b,(98+a.*.nh)*4,v);
    a.*.nh=a.*.nh+1;
    zu_set(a.*.b,4,a.*.nh);
}

const KIND_SCAF:i32=0;
const KIND_TRAP:i32=1;
const KIND_WATCH:i32=2;
const KIND_HELD:i32=3;
const KIND_FAULT:i32=4;
const KIND_COMP:i32=5;
const KIND_K3:i32=6;
const KIND_K4:i32=7;
const KIND_C7VAR:i32=8;
const KIND_POISON:i32=9;

// ---- stage table (frozen per PREREG_CODE_PILOT.md sec 5) ----
fn st_n_scaf(s:i32)i32 {
    if(s==0){return 70;} if(s==1){return 84;} if(s==2){return 98;}
    if(s==3){return 140;} if(s==4){return 182;} if(s==5){return 210;}
    if(s==6){return 224;} if(s==7){return 238;} if(s==8){return 252;}
    if(s==9){return 266;} if(s==10){return 280;} return 301;
}
fn st_n_watch(s:i32)i32 {
    if(s==0){return 10;} if(s==1){return 12;} if(s==2){return 14;}
    if(s==3){return 20;} if(s==4){return 26;} if(s==5){return 30;}
    if(s==6){return 32;} if(s==7){return 34;} if(s==8){return 36;}
    if(s==9){return 38;} if(s==10){return 40;} return 43;
}
fn st_n_held(s:i32)i32 {
    if(s==0){return 20;} if(s==1){return 24;} if(s==2){return 28;}
    if(s==3){return 40;} if(s==4){return 52;} if(s==5){return 60;}
    if(s==6){return 64;} if(s==7){return 68;} if(s==8){return 72;}
    if(s==9){return 76;} if(s==10){return 80;} return 86;
}
fn stage_name(s:i32)[]u8 {
    if(s==0){return "C1-arithmetic";} if(s==1){return "C2-compare";}
    if(s==2){return "C3-branch";} if(s==3){return "C4-loop";}
    if(s==4){return "C5-slice";} if(s==5){return "C6-function";}
    if(s==6){return "C7-optional";} if(s==7){return "C8-error";}
    if(s==8){return "C9-module";} if(s==9){return "C10-pointer";}
    if(s==10){return "C11-scope";} return "C12-logic";
}

// ---- generator output ----
struct GenOut {
    prog: Asm,
    funcs: []u8,    // Z_MAXF*Z_FSTRIDE words, for Z_CALL
    modtabs: []u8,  // Z_MAXMOD*Z_MAXF*Z_FSTRIDE words, for Z_CALLM
    has_funcs: i32,
    has_mods: i32,
    tmpl: i32,
    qa_op: i32,     // C11 QA op (stage 10)
    qa_cond: i32,   // C11 QA condition bits (stage 10)
    path_q: i32     // C12 path predicate index (stage 11)
}
fn genout_new()GenOut {
    let f:[]u8=nio_alloc(4*72*4);
    let m:[]u8=nio_alloc(2*4*72*4);
    let i:i32=0;
    while(i<4*72*4){f[i]=0;i=i+1;}
    i=0;
    while(i<2*4*72*4){m[i]=0;i=i+1;}
    return GenOut{.prog=asm_new(),.funcs=f,.modtabs=m,
                 .has_funcs=0,.has_mods=0,.tmpl=0};
}
fn genout_free(g:*GenOut)void {
    asm_free(&g.*.prog);nio_free(g.*.funcs);nio_free(g.*.modtabs);
}
fn genout_reset(g:*GenOut)void {
    // fresh program; keep funcs/modtabs buffers (cleared)
    asm_free(&g.*.prog);g.*.prog=asm_new();
    let i:i32=0;
    while(i<4*72*4){g.*.funcs[i]=0;i=i+1;}
    i=0;
    while(i<2*4*72*4){g.*.modtabs[i]=0;i=i+1;}
    g.*.has_funcs=0;g.*.has_mods=0;g.*.tmpl=0;
}
// Emit one instruction into function f (word offset f*72, word0 = count).
fn femit(g:*GenOut,f:i32,op:i32,x:i32,y:i32,z:i32)void {
    let n:i32=zu_get(g.*.funcs,(f*72)*4);
    let w:i32=f*72+1+n*4;
    zu_set(g.*.funcs,w*4,op);zu_set(g.*.funcs,(w+1)*4,x);
    zu_set(g.*.funcs,(w+2)*4,y);zu_set(g.*.funcs,(w+3)*4,z);
    zu_set(g.*.funcs,(f*72)*4,n+1);
}
// Emit one instruction into module m function f.
fn memit(g:*GenOut,m:i32,f:i32,op:i32,x:i32,y:i32,z:i32)void {
    let base:i32=(m*4+f)*72;
    let n:i32=zu_get(g.*.modtabs,base*4);
    let w:i32=base+1+n*4;
    zu_set(g.*.modtabs,w*4,op);zu_set(g.*.modtabs,(w+1)*4,x);
    zu_set(g.*.modtabs,(w+2)*4,y);zu_set(g.*.modtabs,(w+3)*4,z);
    zu_set(g.*.modtabs,base*4,n+1);
}

// Deterministic value in [lo,hi] from hash stream.
fn cg_v(h:i32,k:i32,lo:i32,hi:i32)i32 {
    return lo+zu_mod(zu_hash(h+k*97+11),hi-lo+1);
}
// h = hash stream id for (stage, kind, idx)
fn cg_h(stage:i32,kind:i32,idx:i32)i32 {
    return zu_hash3(stage*131+kind,idx,77);
}

// ============ Stage 0 (C1): eager arithmetic/comparison/logic ============
// LIT,ADD,SUB,MUL,DIV,MOD,NEG,EQ,LT,GT,AND,OR,NOT. Induced aspects (product):
// div/mod {trunc+fault, floor+div0->0, trunc+div0->0} x compare {signed,
// unsigned, <=-style}. AND/OR/NOT/NEG/ADD/SUB/MUL are exact-op identification.
fn g_scaf_c0(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        // binary arith, cycling op; discriminators: av<0 every 3rd (kills
        // floor-div), bv=0 every 5th (kills div0->0)
        let ops:[]u8=nio_alloc(5*4);
        zu_set(ops,0,Z_ADD);zu_set(ops,1*4,Z_SUB);zu_set(ops,2*4,Z_MUL);
        zu_set(ops,3*4,Z_DIV);zu_set(ops,4*4,Z_MOD);
        let op:i32=zu_get(ops,zu_mod(idx,5)*4);
        nio_free(ops);
        let av:i32=cg_v(h,1,0,20);let bv:i32=cg_v(h,2,1,20);
        if(zu_mod(idx,3)==0){av=0-cg_v(h,3,1,20);}
        if(zu_mod(idx,5)==0){bv=0;}
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,op,2,0,1);
    } else if(t==1){
        // comparisons, cycling EQ/LT/GT; av<0 every 3rd (kills unsigned),
        // bv=av every 4th (kills <= / >=)
        let ops:[]u8=nio_alloc(3*4);
        zu_set(ops,0,Z_EQ);zu_set(ops,1*4,Z_LT);zu_set(ops,2*4,Z_GT);
        let op:i32=zu_get(ops,zu_mod(idx,3)*4);
        nio_free(ops);
        let av:i32=cg_v(h,1,0,25);let bv:i32=cg_v(h,2,0,25);
        if(zu_mod(idx,3)==0){av=0-cg_v(h,3,1,25);}
        if(zu_mod(idx,4)==1){bv=av;}
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,op,2,0,1);
    } else {
        // unary/logic, cycling NEG/AND/OR/NOT
        let k:u32=(zu_mod(idx,4)) as u32;
        let av:i32=cg_v(h,1,0,20);let bv:i32=cg_v(h,2,0,20);
        if(k==0){
            e(a,Z_LIT,0,av,0);e(a,Z_NEG,1,0,0);
        } else if(k==1){
            if(zu_mod(idx,2)==0){av=0;}
            if(zu_mod(idx,3)==0){bv=0;}
            e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_AND,2,0,1);
        } else if(k==2){
            if(zu_mod(idx,2)==0){av=0;}
            if(zu_mod(idx,3)==0){bv=0;}
            e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_OR,2,0,1);
        } else {
            let yv:i32=cg_v(h,3,-10,10);
            e(a,Z_LIT,0,yv,0);e(a,Z_NOT,1,0,0);
        }
    }
}
fn g_held_c0(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let av:i32=cg_v(h,1,-20,20);let bv:i32=cg_v(h,2,-20,20);
    let cv:i32=cg_v(h,3,-20,20);
    if(t==3){
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_SUB,2,0,1);
        e(a,Z_LIT,3,cv,0);e(a,Z_MUL,4,2,3);
    } else if(t==4){
        if(bv==0){bv=7;}
        let w:i32=av;
        if(w<0){w=0-w;}
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);
        e(a,Z_GT,2,0,1);e(a,Z_LIT,3,w,0);e(a,Z_MOD,4,3,1);
    } else {
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);
        e(a,Z_AND,2,0,1);e(a,Z_NOT,3,2,0);e(a,Z_OR,4,2,3);
    }
}

// ============ Stage 1 (C2): sequencing (implicit order) ============
// Distractors: LITs-first, reverse order. Programs are straight-line (each
// instruction exactly 4 words). Discriminating cases read registers before
// their defining LIT (kills LITs-first) or chain data dependences (kills
// reverse).
fn g_scaf_c1(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        let av:i32=cg_v(h,1,0,20);let bv:i32=cg_v(h,2,0,20);
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_ADD,2,0,1);
    } else if(t==1){
        // op BEFORE its operand LITs: in-order reads zeros; LITs-first does not
        let av:i32=cg_v(h,1,1,20);let bv:i32=cg_v(h,2,1,20);
        e(a,Z_ADD,2,0,1);e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);
    } else {
        let av:i32=cg_v(h,1,0,15);let bv:i32=cg_v(h,2,0,15);
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_MUL,2,0,1);
        e(a,Z_LIT,3,2,0);e(a,Z_ADD,4,2,3);
    }
}
fn g_held_c1(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let av:i32=cg_v(h,1,-15,15);let bv:i32=cg_v(h,2,-15,15);
    if(t==3){
        e(a,Z_LIT,0,av,0);e(a,Z_NEG,1,0,0);
        e(a,Z_LIT,2,bv,0);e(a,Z_SUB,3,1,2);
    } else if(t==4){
        e(a,Z_MUL,3,0,1);e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);
        e(a,Z_LIT,2,1,0);e(a,Z_ADD,4,3,2);
    } else {
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_SUB,2,0,1);
        e(a,Z_LIT,3,av,0);e(a,Z_ADD,4,2,3);e(a,Z_NEG,5,4,0);
    }
}
// ============ Stage 3 (C4): branching (IFZ) + short-circuit contexts ============
// IFZ distractors: inverted (jump iff !=0), jump iff <0. ANDO/ORO distractors:
// eager evaluation (evaluates the skipped operand). SEL is exact-op.
// The planted flag omits ONLY the ANDO/ORO eager-vs-short-circuit
// discriminating contexts (per the 2026-09-20 amendment); IFZ discriminating
// cases stay, so the IFZ rule still resolves under the plant.
fn g_scaf_c3(g:*GenOut,h:i32,idx:i32,planted:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        // IFZ with cond cycling 0 / positive / negative (kills both distractors)
        let cv:i32=cg_v(h,1,0,10);
        let m:u32=(zu_mod(idx,3)) as u32;
        if(m==1){cv=cg_v(h,2,1,10);}
        else if(m==2){cv=0-cg_v(h,3,1,10);}
        let av:i32=cg_v(h,4,1,20);let bv:i32=cg_v(h,5,1,20);
        e(a,Z_LIT,0,cv,0);e(a,Z_LIT,1,av,0);e(a,Z_LIT,2,bv,0);
        e(a,Z_IFZ,0,1,1);e(a,Z_ADD,3,1,2);e(a,Z_SUB,3,1,2);
    } else if(t==1){
        // ANDO/ORO/SEL with plain operands (controls; present in both arms)
        let k:u32=(zu_mod(idx,3)) as u32;
        let av:i32=cg_v(h,1,0,10);let bv:i32=cg_v(h,2,0,10);
        if(k==0){
            e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_ANDO,2,0,1);
        } else if(k==1){
            e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_ORO,2,0,1);
        } else {
            e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,av,0);e(a,Z_LIT,2,bv,0);
            e(a,Z_SEL,3,0,(1<<8)|2);
        }
    } else {
        // eager-vs-short-circuit discriminating contexts:
        // ANDO(y=0, NONE) -> short-circuit yields 0, eager faults;
        // ORO(y!=0, NONE) -> short-circuit yields 1, eager faults.
        // OMITTED when planted.
        if(planted==1){
            let av:i32=cg_v(h,1,1,10);
            e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,av,0);e(a,Z_ANDO,2,0,1);
        } else {
            if(zu_mod(idx,2)==0){
                e(a,Z_LIT,0,0,0);e(a,Z_NONE,1,0,0);e(a,Z_ANDO,2,0,1);
            } else {
                e(a,Z_LIT,0,cg_v(h,1,1,10),0);e(a,Z_NONE,1,0,0);e(a,Z_ORO,2,0,1);
            }
        }
    }
}
fn g_held_c3(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==3){
        let cv:i32=cg_v(h,1,-10,10);
        let av:i32=cg_v(h,2,1,20);let bv:i32=cg_v(h,3,1,20);
        e(a,Z_LIT,0,cv,0);e(a,Z_LIT,1,av,0);e(a,Z_LIT,2,bv,0);
        e(a,Z_IFZ,0,1,1);e(a,Z_MUL,3,1,2);e(a,Z_ADD,3,1,2);
    } else if(t==4){
        let av:i32=cg_v(h,1,-10,10);
        e(a,Z_LIT,0,av,0);e(a,Z_SOME,1,7,0);e(a,Z_ANDO,2,0,1);
        e(a,Z_LIT,3,av,0);e(a,Z_ORO,4,3,1);
    } else {
        e(a,Z_LIT,0,0,0);e(a,Z_NONE,1,0,0);e(a,Z_ANDO,2,0,1);
        e(a,Z_LIT,3,5,0);e(a,Z_NONE,4,0,0);e(a,Z_ORO,5,3,4);
    }
}
// ============ Stage 4 (C5): loops (LOOP) ============
// Distractors: runs cnt+1 times, no zero-trip short-circuit.
fn g_scaf_c4(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let cnt:i32=0;
    let k:i32=zu_mod(idx,6);
    if(k==0){cnt=0;}
    else if(k==1){cnt=1;}
    else if(k==2){cnt=2;}
    else if(k==3){cnt=3;}
    else if(k==4){cnt=4;}
    else {cnt=cg_v(h,1,0,5);}
    if(t==0){
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);
    } else if(t==1){
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,1,0);e(a,Z_LIT,2,3,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_MUL,1,1,2);
    } else {
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,10,0);e(a,Z_LIT,2,2,0);
        e(a,Z_LOOP,0,2,0);e(a,Z_ADD,1,1,2);e(a,Z_SUB,1,1,0);
    }
}
fn g_held_c4(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let cnt:i32=cg_v(h,1,0,6);
    if(t==3){
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,2,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);
    } else if(t==4){
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,100,0);e(a,Z_LIT,2,7,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_SUB,1,1,2);
    } else {
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,1,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,0);
    }
}

// ============ Stage 6 (C7): slices (SLICE, LDX, STX) ============
// Distractors: C5-1 1-based indexing, C5-2 OOB yields 0 (no fault).
fn g_scaf_c6(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    // heap init: words 0..7 = 10,20,...,80
    let j:i32=0;
    while(j<8){asm_heap(a,10*(j+1));j=j+1;}
    if(t==0){
        // idx=0 every 3rd kills C5-1 (1-based gives heap[1] not heap[0])
        let ix:i32=cg_v(h,1,0,3);
        if(zu_mod(idx,3)==0){ix=0;}
        e(a,Z_SLICE,0,0,4);e(a,Z_LIT,1,ix,0);e(a,Z_LDX,2,0,1);
    } else if(t==1){
        let ix:i32=cg_v(h,1,0,3);
        let v:i32=cg_v(h,2,100,200);
        e(a,Z_SLICE,0,2,4);
        e(a,Z_LIT,1,ix,0);e(a,Z_LIT,2,v,0);
        e(a,Z_STX,0,1,2);e(a,Z_LDX,3,0,1);
    } else {
        // OOB every 2nd kills C5-2 (no-fault)
        let ix:i32=cg_v(h,1,0,1);
        if(zu_mod(idx,2)==0){ix=9;}
        e(a,Z_SLICE,0,0,2);e(a,Z_LIT,1,ix,0);e(a,Z_LDX,2,0,1);
    }
}
fn g_held_c6(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let j:i32=0;
    while(j<8){asm_heap(a,5*(j+2));j=j+1;}
    if(t==3){
        let ix:i32=cg_v(h,1,0,5);
        e(a,Z_SLICE,0,1,6);e(a,Z_LIT,1,ix,0);e(a,Z_LDX,2,0,1);
        e(a,Z_LIT,3,ix,0);e(a,Z_LDX,4,0,3);e(a,Z_ADD,5,2,4);
    } else if(t==4){
        let v0:i32=cg_v(h,1,100,150);let v1:i32=cg_v(h,2,200,250);
        e(a,Z_SLICE,0,0,8);
        e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,v0,0);e(a,Z_STX,0,1,2);
        e(a,Z_LIT,1,7,0);e(a,Z_LIT,2,v1,0);e(a,Z_STX,0,1,2);
        e(a,Z_LIT,1,0,0);e(a,Z_LDX,3,0,1);
        e(a,Z_LIT,1,7,0);e(a,Z_LDX,4,0,1);e(a,Z_ADD,5,3,4);
    } else {
        let ix:i32=cg_v(h,1,2,5);
        e(a,Z_SLICE,1,3,4);e(a,Z_LIT,2,ix,0);e(a,Z_LDX,3,1,2);
        e(a,Z_NEG,4,3,0);
    }
}

// ============ Stage 5 (C6): functions (CALL, RET) ============
// Distractors: C6-1 no frame isolation, C6-2 args not copied.
// func0: r0 = arg0+arg1 ; func1: clobbers its r1, returns r0
fn g_scaf_c5(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    femit(g,0,Z_ADD,0,0,1);femit(g,0,Z_RET,0,0,0);
    femit(g,1,Z_LIT,1,99,0);femit(g,1,Z_RET,0,0,0);
    g.*.has_funcs=1;
    if(t==0){
        let av:i32=cg_v(h,1,1,40);let bv:i32=cg_v(h,2,1,40);
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,0,2,7);
    } else if(t==1){
        e(a,Z_LIT,1,5,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,1,0,7);
    } else {
        let av:i32=cg_v(h,1,1,30);let bv:i32=cg_v(h,2,1,30);
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,0,2,7);e(a,Z_ADD,1,0,0);
    }
}
fn g_held_c5(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    // func0: r0 = arg0*2 ; func1: r0 = arg0-arg1
    femit(g,0,Z_ADD,0,0,0);femit(g,0,Z_RET,0,0,0);
    femit(g,1,Z_SUB,0,0,1);femit(g,1,Z_RET,0,0,0);
    g.*.has_funcs=1;
    let av:i32=cg_v(h,1,1,50);let bv:i32=cg_v(h,2,1,50);
    if(t==3){
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,0,1,7);e(a,Z_NEG,1,0,0);
    } else if(t==4){
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,1,2,7);
    } else {
        e(a,Z_LIT,0,av,0);e(a,Z_LIT,1,bv,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALL,0,2,7);e(a,Z_CALL,1,2,7);e(a,Z_ADD,2,0,1);
    }
}

// ============ Stage 8 (C9): optionals + errors ============
// SOME/NONE/UNWRAP/ERR/MATCH. Induced aspects (product): unwrap {fault on
// NONE, NONE->0} x errors {ERR faults & MATCH faults on NONE, ERR no fault,
// MATCH never faults}.
fn g_scaf_c8(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        // optionals: SOME/UNWRAP and NONE/UNWRAP (latter kills unwrap->0)
        if(zu_mod(idx,2)==0){
            let av:i32=cg_v(h,1,0,30);
            e(a,Z_LIT,0,av,0);e(a,Z_SOME,1,0,0);e(a,Z_UNWRAP,2,1,0);
        } else {
            e(a,Z_NONE,0,0,0);e(a,Z_UNWRAP,1,0,0);
        }
    } else if(t==1){
        // ERR with code; MATCH on SOME and NONE (latter kills MATCH-never-faults
        // only when the guard register is 0; ERR-no-fault killed by fault cases)
        let code:i32=cg_v(h,1,1,9);
        if(zu_mod(idx,2)==0){
            e(a,Z_ERR,code,0,0);
        } else {
            e(a,Z_NONE,0,0,0);e(a,Z_MATCH,0,0,0);
        }
    } else {
        let av:i32=cg_v(h,1,0,30);
        e(a,Z_LIT,0,av,0);e(a,Z_SOME,1,0,0);e(a,Z_MATCH,1,0,0);
        e(a,Z_NONE,2,0,0);e(a,Z_UNWRAP,3,1,0);
    }
}
fn g_held_c8(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let av:i32=cg_v(h,1,-30,30);
    if(t==3){
        e(a,Z_LIT,0,av,0);e(a,Z_SOME,1,0,0);e(a,Z_UNWRAP,2,1,0);
        e(a,Z_NEG,3,2,0);
    } else if(t==4){
        e(a,Z_SOME,0,av,0);e(a,Z_MATCH,0,0,0);
        e(a,Z_NONE,1,0,0);e(a,Z_SOME,2,3,0);e(a,Z_UNWRAP,3,2,0);
    } else {
        let code:i32=cg_v(h,2,1,9);
        e(a,Z_LIT,0,code,0);e(a,Z_ERR,code,0,0);
    }
}
// ============ Stage 9 (C10): modules (IMPORT, CALLM) ============
// Distractors: C9-1 CALLM ignores module, C9-2 IMPORT not required.
// mod0/func0: r0=arg0+100 ; mod1/func0: r0=arg0*2
fn g_scaf_c9(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    memit(g,0,0,Z_LIT,1,100,0);memit(g,0,0,Z_ADD,0,0,1);memit(g,0,0,Z_RET,0,0,0);
    memit(g,1,0,Z_LIT,1,2,0);memit(g,1,0,Z_MUL,0,0,1);memit(g,1,0,Z_RET,0,0,0);
    g.*.has_mods=1;
    let zpack:i32=1|(7<<8);
    if(t==0){
        let v:i32=cg_v(h,1,1,40);
        e(a,Z_IMPORT,0,0,0);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,0,0,zpack);
    } else if(t==1){
        // discriminator: mod1 vs mod0 kills C9-1
        let v:i32=cg_v(h,1,1,40);
        e(a,Z_IMPORT,1,0,0);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,1,0,zpack);
    } else {
        // discriminator: no IMPORT kills C9-2 (expects ZF_NOMOD)
        e(a,Z_LIT,0,5,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,0,0,zpack);
    }
}
fn g_held_c9(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    // mod0/func0: r0=arg0-5 ; mod1/func0: r0=arg0+arg1
    memit(g,0,0,Z_LIT,1,5,0);memit(g,0,0,Z_SUB,0,0,1);memit(g,0,0,Z_RET,0,0,0);
    memit(g,1,0,Z_ADD,0,0,1);memit(g,1,0,Z_RET,0,0,0);
    g.*.has_mods=1;
    let v:i32=cg_v(h,1,10,60);let w:i32=cg_v(h,2,10,60);
    if(t==3){
        e(a,Z_IMPORT,0,0,0);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,0,0,1|(7<<8));e(a,Z_NEG,1,0,0);
    } else if(t==4){
        e(a,Z_IMPORT,1,0,0);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,1,w,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,1,0,2|(7<<8));
    } else {
        e(a,Z_IMPORT,0,0,0);e(a,Z_IMPORT,1,0,0);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,7,100,0);
        e(a,Z_CALLM,0,0,1|(7<<8));e(a,Z_LIT,2,v,0);
        e(a,Z_CALLM,1,0,1|(7<<8));e(a,Z_ADD,3,0,2);
    }
}

// ============ Stage 7 (C8): pointers (PTR, LDPTR, STPTR) ============
// Distractors: C10-1 LDPTR returns index, C10-2 STPTR no write-through.
fn g_scaf_c7(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        let v:i32=cg_v(h,1,1,90);
        e(a,Z_LIT,2,v,0);e(a,Z_PTR,1,2,0);e(a,Z_LDPTR,3,1,0);
    } else if(t==1){
        let v:i32=cg_v(h,1,1,90);let w:i32=cg_v(h,2,100,200);
        e(a,Z_LIT,2,v,0);e(a,Z_PTR,1,2,0);
        e(a,Z_LIT,0,w,0);e(a,Z_STPTR,1,0,0);
    } else {
        let v:i32=cg_v(h,1,1,50);
        e(a,Z_LIT,3,v,0);e(a,Z_PTR,1,3,0);e(a,Z_LDPTR,4,1,0);
        e(a,Z_ADD,5,4,4);
    }
}
fn g_held_c7(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let v:i32=cg_v(h,1,1,90);let w:i32=cg_v(h,2,100,200);
    if(t==3){
        e(a,Z_LIT,4,v,0);e(a,Z_PTR,2,4,0);e(a,Z_LDPTR,5,2,0);
        e(a,Z_NEG,6,5,0);
    } else if(t==4){
        e(a,Z_LIT,3,v,0);e(a,Z_PTR,0,3,0);
        e(a,Z_LIT,1,w,0);e(a,Z_STPTR,0,1,0);e(a,Z_LDPTR,2,0,0);
    } else {
        e(a,Z_LIT,6,v,0);e(a,Z_PTR,7,6,0);
        e(a,Z_LIT,5,w,0);e(a,Z_STPTR,7,5,0);
        e(a,Z_ADD,0,6,6);
    }
}

// ============ Stage 2 (C3): scopes (LET, END) ============
// Distractors: C11-1 LET/END no-ops, C11-2 END does not restore.
fn g_scaf_c2(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    if(t==0){
        e(a,Z_LIT,1,5,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,1,99,0);e(a,Z_END,0,0,0);
    } else if(t==1){
        e(a,Z_LIT,2,10,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,2,20,0);
        e(a,Z_LET,0,0,0);e(a,Z_LIT,2,30,0);
        e(a,Z_END,0,0,0);e(a,Z_END,0,0,0);
    } else {
        e(a,Z_LIT,1,5,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,1,6,0);
        e(a,Z_ADD,2,1,1);e(a,Z_END,0,0,0);e(a,Z_ADD,3,1,1);
    }
}
fn g_held_c2(g:*GenOut,h:i32,idx:i32)void {
    let t:i32=3+zu_mod(idx,3);
    g.*.tmpl=t;
    let a:*Asm=&g.*.prog;
    let v:i32=cg_v(h,1,1,40);let w:i32=cg_v(h,2,50,90);
    if(t==3){
        e(a,Z_LIT,3,v,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,3,w,0);
        e(a,Z_MUL,4,3,3);e(a,Z_END,0,0,0);e(a,Z_ADD,5,3,4);
    } else if(t==4){
        e(a,Z_LIT,0,v,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,0,w,0);
        e(a,Z_LET,0,0,0);e(a,Z_NEG,0,0,0);
        e(a,Z_END,0,0,0);e(a,Z_END,0,0,0);
    } else {
        e(a,Z_LIT,6,v,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,6,w,0);
        e(a,Z_LIT,7,v,0);e(a,Z_END,0,0,0);e(a,Z_ADD,5,6,7);
    }
}

fn gen_scaf(stage:i32,g:*GenOut,idx:i32,planted:i32)void {
    let h:i32=cg_h(stage,KIND_SCAF,idx);
    if(stage==0){g_scaf_c0(g,h,idx);}
    else if(stage==1){g_scaf_c1(g,h,idx);}
    else if(stage==2){g_scaf_c2(g,h,idx);}
    else if(stage==3){g_scaf_c3(g,h,idx,planted);}
    else if(stage==4){g_scaf_c4(g,h,idx);}
    else if(stage==5){g_scaf_c6(g,h,idx);}
    else if(stage==6){g_scaf_c5(g,h,idx);}
    else if(stage==7){g_scaf_c7(g,h,idx);}
    else if(stage==8){g_scaf_c8(g,h,idx);}
    else {g_scaf_c9(g,h,idx);}
}
fn gen_held(stage:i32,g:*GenOut,idx:i32)void {
    let h:i32=cg_h(stage,KIND_HELD,idx);
    if(stage==0){g_held_c0(g,h,idx);}
    else if(stage==1){g_held_c1(g,h,idx);}
    else if(stage==2){g_held_c2(g,h,idx);}
    else if(stage==3){g_held_c3(g,h,idx);}
    else if(stage==4){g_held_c4(g,h,idx);}
    else if(stage==5){g_held_c6(g,h,idx);}
    else if(stage==6){g_held_c5(g,h,idx);}
    else if(stage==7){g_held_c7(g,h,idx);}
    else if(stage==8){g_held_c8(g,h,idx);}
    else {g_held_c9(g,h,idx);}
}
fn gen_watch(stage:i32,g:*GenOut,idx:i32)void {
    // watch reuses held-out templates at a different index stream
    let h:i32=cg_h(stage,KIND_WATCH,idx);
    let hh:i32=cg_h(stage,KIND_HELD,1000+idx);
    if(stage==0){g_held_c0(g,hh,idx);}
    else if(stage==1){g_held_c1(g,hh,idx);}
    else if(stage==2){g_held_c2(g,hh,idx);}
    else if(stage==3){g_held_c3(g,hh,idx);}
    else if(stage==4){g_held_c4(g,hh,idx);}
    else if(stage==5){g_held_c6(g,hh,idx);}
    else if(stage==6){g_held_c5(g,hh,idx);}
    else if(stage==7){g_held_c7(g,hh,idx);}
    else if(stage==8){g_held_c8(g,hh,idx);}
    else {g_held_c9(g,hh,idx);}
}

// ---- fault menus (per-stage opcode sets for fault injection / localization) ----
fn fault_menu(stage:i32,m:[]u8)i32 {
    // fills m[0..n) with the menu, returns count. Stages 10/11 (C11/C12)
    // reuse the C1 menu: fault-localization there exercises locked C1 rules
    // (retention-flavored; documented in the 2026-09-20 amendment).
    if(stage==0 || stage==10 || stage==11){
        zu_set(m,0,Z_ADD);zu_set(m,4,Z_SUB);zu_set(m,8,Z_MUL);
        zu_set(m,12,Z_DIV);zu_set(m,16,Z_EQ);zu_set(m,20,Z_LT);
        zu_set(m,24,Z_GT);zu_set(m,28,Z_AND);return 8;
    }
    if(stage==1){zu_set(m,0,Z_LIT);zu_set(m,4,Z_ADD);zu_set(m,8,Z_SUB);return 3;}
    if(stage==2){zu_set(m,0,Z_LET);zu_set(m,4,Z_END);return 2;}
    if(stage==3){
        zu_set(m,0,Z_IFZ);zu_set(m,4,Z_ANDO);zu_set(m,8,Z_ORO);
        zu_set(m,12,Z_SEL);zu_set(m,16,Z_ADD);return 5;
    }
    if(stage==4){zu_set(m,0,Z_LOOP);zu_set(m,4,Z_ADD);return 2;}
    if(stage==5){zu_set(m,0,Z_CALL);zu_set(m,4,Z_RET);return 2;}
    if(stage==6){zu_set(m,0,Z_SLICE);zu_set(m,4,Z_LDX);zu_set(m,8,Z_STX);return 3;}
    if(stage==7){zu_set(m,0,Z_PTR);zu_set(m,4,Z_LDPTR);zu_set(m,8,Z_STPTR);return 3;}
    if(stage==8){
        zu_set(m,0,Z_SOME);zu_set(m,4,Z_NONE);zu_set(m,8,Z_UNWRAP);
        zu_set(m,12,Z_ERR);zu_set(m,16,Z_MATCH);return 5;
    }
    zu_set(m,0,Z_IMPORT);zu_set(m,4,Z_CALLM);return 2;
}
fn op_in_menu(op:i32,menu:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(zu_get(menu,i*4)==op){return 1;}i=i+1;}
    return 0;
}
// oracle run: program -> 18-word trace (trainer side)
fn oracle_run(prog:*Asm,funcs:[]u8,modtabs:[]u8,out:[]u8)void {
    let m:ZMach=z0_new_mach();
    z0_load_heap(prog.*.b,&m);
    let regs:[]u8=z0_regs_new();
    let tags:[]u8=z0_tags_new();
    let i:i32=0;
    while(i<Z_NREG*4){regs[i]=0;i=i+1;}
    i=0;
    while(i<Z_NREG){tags[i]=0;i=i+1;}
    z0_exec(prog.*.b,2,prog.*.ni,regs,tags,&m,funcs,modtabs,0);
    z0_output(regs,tags,&m,out);
    nio_free(regs);nio_free(tags);z0_free_mach(&m);
}
fn trace_eq(a:[]u8,b:[]u8)i32 {
    let i:i32=0;
    while(i<18){if(zu_get(a,i*4)!=zu_get(b,i*4)){return 0;}i=i+1;}
    return 1;
}
// Generate a fault-injection candidate. Returns 1 if a good fault was found
// (detectable and uniquely localizable); fault_pos gets the instruction index.
fn gen_fault(stage:i32,g:*GenOut,idx:i32,fault_pos:*i32,mode:i32,base_out:*i32)void {
    // base = scaffold program at a shifted index; try several bases until we
    // find one with a CLEAN oracle trace (no fault) and a good injectable fault.
    // mode: pilot mode (0=planted,1=corrected); planted flag = 1-mode.
    let planted:i32=1-mode;
    let h:i32=cg_h(stage,KIND_FAULT,idx);
    let trial:i32=0;
    fault_pos.*=-1;
    base_out.*=-1;
    while(trial<10 && fault_pos.*<0){
        let base_idx:i32=100+idx+trial*1000;
        // reset g
        asm_free(&g.*.prog);
        g.*.prog=asm_new();
        g.*.has_funcs=0;g.*.has_mods=0;
        gen_scaf(stage,g,base_idx,planted);
        // check clean
        let tchk:[]u8=nio_alloc(18*4);
        oracle_run(&g.*.prog,g.*.funcs,g.*.modtabs,tchk);
        let clean:i32=0;
        if(zu_get(tchk,16*4)==0){clean=1;}
        nio_free(tchk);
        if(clean==1){
            gen_fault_try(stage,g,idx,fault_pos);
            if(fault_pos.*>=0){base_out.*=base_idx;}
        }
        trial=trial+1;
    }
    // (if still -1, the caller handles it; should not happen for our templates)
}

fn gen_fault_try(stage:i32,g:*GenOut,idx:i32,fault_pos:*i32)void {
    let h:i32=cg_h(stage,KIND_FAULT,idx);
    let a:*Asm=&g.*.prog;
    let menu:[]u8=nio_alloc(8*4);
    let nm:i32=fault_menu(stage,menu);
    // collect candidate positions (instructions whose opcode is in the menu)
    let pos:[]u8=nio_alloc(24*4);
    let np:i32=0;
    let i:i32=0;
    while(i<a.*.ni){
        let op:i32=zu_get(a.*.b,(2+i*4)*4);
        if(op_in_menu(op,menu,nm)==1){zu_set(pos,np*4,i);np=np+1;}
        i=i+1;
    }
    fault_pos.*=-1;
    if(np==0){return;}
    // try deterministic (pos, newop) pairs; take the first good one
    let t0:[]u8=nio_alloc(18*4);
    oracle_run(a,g.*.funcs,g.*.modtabs,t0);
    let pi:i32=zu_mod(h,np);
    let attempt:i32=0;
    while(attempt<np*nm*2 && fault_pos.*<0){
        let p:i32=zu_get(pos,zu_mod(pi+attempt,np)*4);
        let w:i32=(2+p*4)*4;
        let oldop:i32=zu_get(a.*.b,w);
        let oi:i32=zu_mod(h+attempt,nm);
        let newop:i32=zu_get(menu,zu_mod(oi+1,nm)*4);
        if(newop==oldop){newop=zu_get(menu,zu_mod(oi+2,nm)*4);}
        // apply
        zu_set(a.*.b,w,newop);
        let t1:[]u8=nio_alloc(18*4);
        oracle_run(a,g.*.funcs,g.*.modtabs,t1);
        let detectable:i32=0;
        if(trace_eq(t0,t1)==0){detectable=1;}
        let unique:i32=1;
        if(detectable==1){
            // check no other (q,op') fixes it
            let q:i32=0;
            while(q<a.*.ni && unique==1){
                let wq:i32=(2+q*4)*4;
                let qold:i32=zu_get(a.*.b,wq);
                let k:i32=0;
                while(k<nm && unique==1){
                    if(q!=p || zu_get(menu,k*4)!=oldop){
                        zu_set(a.*.b,wq,zu_get(menu,k*4));
                        let tq:[]u8=nio_alloc(18*4);
                        oracle_run(a,g.*.funcs,g.*.modtabs,tq);
                        if(trace_eq(t0,tq)==1){unique=0;}
                        nio_free(tq);
                    }
                    k=k+1;
                }
                zu_set(a.*.b,wq,qold);
                q=q+1;
            }
        }
        if(detectable==1 && unique==1){
            fault_pos.*=p;
            // leave the fault applied (a already has newop at p)
        } else {
            // revert
            zu_set(a.*.b,w,oldop);
        }
        nio_free(t1);
        attempt=attempt+1;
    }
    nio_free(t0);
    nio_free(menu);nio_free(pos);
}

// ---- composition: concatenate two programs (heap bases fixed up) ----
fn gen_concat(out:*GenOut,a:*GenOut,b:*GenOut)void {
    let pa:*Asm=&a.*.prog;
    let pb:*Asm=&b.*.prog;
    let po:*Asm=&out.*.prog;
    // copy a's instructions
    let i:i32=0;
    while(i<pa.*.ni){
        let w:i32=(2+i*4)*4;
        e(po,zu_get(pa.*.b,w),zu_get(pa.*.b,(w+1)*4),
             zu_get(pa.*.b,(w+2)*4),zu_get(pa.*.b,(w+3)*4));
        i=i+1;
    }
    // copy a's heap
    i=0;
    while(i<pa.*.nh){asm_heap(po,zu_get(pa.*.b,(98+i)*4));i=i+1;}
    let base_off:i32=pa.*.nh;
    // copy b's instructions, fixing SLICE bases
    i=0;
    while(i<pb.*.ni){
        let w:i32=(2+i*4)*4;
        let op:i32=zu_get(pb.*.b,w);
        let x:i32=zu_get(pb.*.b,(w+1)*4);
        let y:i32=zu_get(pb.*.b,(w+2)*4);
        let z:i32=zu_get(pb.*.b,(w+3)*4);
        if(op==Z_SLICE){y=y+base_off;}
        e(po,op,x,y,z);
        i=i+1;
    }
    // copy b's heap
    i=0;
    while(i<pb.*.nh){asm_heap(po,zu_get(pb.*.b,(98+i)*4));i=i+1;}
    // funcs/mods: prefer a, else b
    if(a.*.has_funcs==1){
        out.*.has_funcs=1;
        i=0;
        while(i<4*72*4){out.*.funcs[i]=a.*.funcs[i];i=i+1;}
    } else if(b.*.has_funcs==1){
        out.*.has_funcs=1;
        i=0;
        while(i<4*72*4){out.*.funcs[i]=b.*.funcs[i];i=i+1;}
    }
    if(a.*.has_mods==1){
        out.*.has_mods=1;
        i=0;
        while(i<2*4*72*4){out.*.modtabs[i]=a.*.modtabs[i];i=i+1;}
    } else if(b.*.has_mods==1){
        out.*.has_mods=1;
        i=0;
        while(i<2*4*72*4){out.*.modtabs[i]=b.*.modtabs[i];i=i+1;}
    }
    out.*.tmpl=6; // composition template marker
}
fn gen_comp(stage:i32,g:*GenOut,idx:i32,mode:i32)void {
    if(stage==0){
        // C1: extended single-concept chain (no earlier stage to compose)
        let h:i32=cg_h(stage,KIND_COMP,idx);
        let a:*Asm=&g.*.prog;
        g.*.tmpl=6;
        let v0:i32=cg_v(h,1,-30,30);let v1:i32=cg_v(h,2,-30,30);
        let v2:i32=cg_v(h,3,-30,30);let v3:i32=cg_v(h,4,1,10);
        if(v3==0){v3=5;}
        e(a,Z_LIT,0,v0,0);e(a,Z_LIT,1,v1,0);e(a,Z_ADD,2,0,1);
        e(a,Z_LIT,3,v2,0);e(a,Z_MUL,4,2,3);
        e(a,Z_LIT,5,v3,0);e(a,Z_DIV,6,4,5);e(a,Z_NEG,7,6,0);
        return;
    }
    let ga:GenOut=genout_new();
    let gb:GenOut=genout_new();
    let prev:i32=zu_mod(cg_h(stage,KIND_COMP,idx),stage);
    let planted:i32=1-mode;
    // avoid double funcs/mods: if stage needs them, prev must not
    if((stage==5 || stage==8) && prev>=5){prev=zu_mod(prev,5);}
    gen_scaf(stage,&ga,200+idx,planted);
    gen_scaf(prev,&gb,300+idx,planted);
    gen_concat(g,&ga,&gb);
    genout_free(&ga);genout_free(&gb);
}

// ---- K3 adversarial variants: edge-case parameterizations ----
fn gen_k3(stage:i32,g:*GenOut,idx:i32)void {
    let h:i32=cg_h(stage,KIND_K3,idx);
    let a:*Asm=&g.*.prog;
    g.*.tmpl=7;
    let k:i32=zu_mod(idx,10);
    if(stage==0){
        // C1: arith/compare/logic edges (div0, INT_MIN/-1, neg mod, GT, AND/OR/NOT)
        if(k==0){e(a,Z_LIT,0,10,0);e(a,Z_LIT,1,0,0);e(a,Z_DIV,2,0,1);}
        else if(k==1){e(a,Z_LIT,0,-2147483647,0);e(a,Z_LIT,1,-1,0);e(a,Z_DIV,2,0,1);}
        else if(k==2){e(a,Z_LIT,0,-7,0);e(a,Z_LIT,1,2,0);e(a,Z_MOD,2,0,1);}
        else if(k==3){e(a,Z_LIT,0,7,0);e(a,Z_LIT,1,-2,0);e(a,Z_DIV,2,0,1);}
        else if(k==4){e(a,Z_LIT,0,5,0);e(a,Z_LIT,1,5,0);e(a,Z_GT,2,0,1);}
        else if(k==5){e(a,Z_LIT,0,-1,0);e(a,Z_LIT,1,0,0);e(a,Z_GT,2,0,1);}
        else if(k==6){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,9,0);e(a,Z_AND,2,0,1);}
        else if(k==7){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,0,0);e(a,Z_OR,2,0,1);}
        else if(k==8){e(a,Z_LIT,0,-5,0);e(a,Z_NOT,1,0,0);}
        else {e(a,Z_LIT,0,0,0);e(a,Z_NOT,1,0,0);}
    } else if(stage==1){
        // C2 sequencing: in-order vs LITs-first vs reverse
        if(k==0){e(a,Z_ADD,2,0,1);e(a,Z_LIT,0,5,0);e(a,Z_LIT,1,7,0);}
        else if(k==1){e(a,Z_MUL,2,0,1);e(a,Z_LIT,0,3,0);e(a,Z_LIT,1,4,0);}
        else if(k==2){e(a,Z_LIT,0,5,0);e(a,Z_ADD,1,0,0);e(a,Z_LIT,2,9,0);}
        else if(k==3){e(a,Z_SUB,3,0,1);e(a,Z_LIT,0,8,0);e(a,Z_LIT,1,3,0);e(a,Z_LIT,2,1,0);}
        else {let v:i32=cg_v(h,1,1,20);e(a,Z_LIT,0,v,0);e(a,Z_LIT,1,v,0);e(a,Z_ADD,2,0,1);}
    } else if(stage==2){
        // C3 scopes
        if(k==0){e(a,Z_LET,0,0,0);e(a,Z_LIT,1,5,0);e(a,Z_END,0,0,0);}
        else if(k==1){e(a,Z_LIT,1,1,0);e(a,Z_LET,0,0,0);e(a,Z_LET,0,0,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,1,2,0);e(a,Z_END,0,0,0);e(a,Z_END,0,0,0);e(a,Z_END,0,0,0);}
        else if(k==2){e(a,Z_LIT,4,0,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,4,0,0);e(a,Z_END,0,0,0);}
        else {let v:i32=cg_v(h,1,1,40);e(a,Z_LIT,2,v,0);e(a,Z_LET,0,0,0);e(a,Z_LIT,2,v,0);e(a,Z_END,0,0,0);}
    } else if(stage==3){
        // C4: PC3 K3. k=4,5 are the eager-vs-short-circuit discriminators
        // (must fire under the plant); the rest are controls.
        if(k==0){e(a,Z_LIT,0,5,0);e(a,Z_LIT,1,7,0);e(a,Z_ANDO,2,0,1);}
        else if(k==1){e(a,Z_LIT,0,5,0);e(a,Z_LIT,1,0,0);e(a,Z_ORO,2,0,1);}
        else if(k==2){e(a,Z_LIT,0,0,0);e(a,Z_SOME,1,9,0);e(a,Z_ANDO,2,0,1);}
        else if(k==3){e(a,Z_LIT,0,3,0);e(a,Z_SOME,1,0,0);e(a,Z_ORO,2,0,1);}
        else if(k==4){e(a,Z_LIT,0,0,0);e(a,Z_NONE,1,0,0);e(a,Z_ANDO,2,0,1);}
        else if(k==5){e(a,Z_LIT,0,5,0);e(a,Z_NONE,1,0,0);e(a,Z_ORO,2,0,1);}
        else if(k==6){e(a,Z_LIT,0,0,0);e(a,Z_IFZ,0,1,1);e(a,Z_LIT,1,11,0);e(a,Z_LIT,1,22,0);}
        else if(k==7){e(a,Z_LIT,0,-1,0);e(a,Z_IFZ,0,1,1);e(a,Z_LIT,1,11,0);e(a,Z_LIT,1,22,0);}
        else if(k==8){e(a,Z_LIT,0,7,0);e(a,Z_LIT,1,11,0);e(a,Z_LIT,2,22,0);e(a,Z_SEL,3,0,(1<<8)|2);}
        else {e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,11,0);e(a,Z_LIT,2,22,0);e(a,Z_SEL,3,0,(1<<8)|2);}
    } else if(stage==4){
        // C5 loops
        if(k==0){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,77,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);}
        else if(k==1){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,1,0);e(a,Z_LIT,2,3,0);e(a,Z_LOOP,0,1,0);e(a,Z_MUL,1,1,2);}
        else if(k==2){e(a,Z_LIT,0,1,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);}
        else if(k==3){e(a,Z_LIT,0,512,0);e(a,Z_LIT,1,0,0);e(a,Z_LOOP,0,0,0);}
        else if(k==4){e(a,Z_LIT,0,513,0);e(a,Z_LIT,1,0,0);e(a,Z_LOOP,0,0,0);}
        else if(k==5){e(a,Z_LIT,0,-3,0);e(a,Z_LIT,1,88,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);}
        else {let c:i32=cg_v(h,1,2,10);e(a,Z_LIT,0,c,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);}
    } else if(stage==5){
        // C6 functions
        femit(g,0,Z_ADD,0,0,1);femit(g,0,Z_RET,0,0,0);
        g.*.has_funcs=1;
        if(k==0){e(a,Z_LIT,7,100,0);e(a,Z_CALL,0,0,7);}
        else if(k==1){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,7,100,0);e(a,Z_CALL,0,2,7);}
        else if(k==2){e(a,Z_LIT,0,-5,0);e(a,Z_LIT,1,10,0);e(a,Z_LIT,7,100,0);e(a,Z_CALL,0,2,7);}
        else if(k==3){e(a,Z_LIT,0,1,0);e(a,Z_LIT,7,0,0);e(a,Z_CALL,0,1,7);}
        else {let v:i32=cg_v(h,1,1,99);e(a,Z_LIT,0,v,0);e(a,Z_LIT,1,v,0);e(a,Z_LIT,7,100,0);e(a,Z_CALL,0,2,7);}
    } else if(stage==6){
        // C7 slices
        let j:i32=0;
        while(j<4){asm_heap(a,100*(j+1));j=j+1;}
        if(k==0){e(a,Z_SLICE,0,0,4);e(a,Z_LIT,1,0,0);e(a,Z_LDX,2,0,1);}
        else if(k==1){e(a,Z_SLICE,0,0,4);e(a,Z_LIT,1,3,0);e(a,Z_LDX,2,0,1);}
        else if(k==2){e(a,Z_SLICE,0,0,4);e(a,Z_LIT,1,4,0);e(a,Z_LDX,2,0,1);}
        else if(k==3){e(a,Z_SLICE,0,2,0);e(a,Z_LIT,1,0,0);e(a,Z_LDX,2,0,1);}
        else if(k==4){e(a,Z_SLICE,0,1,2);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,999,0);e(a,Z_STX,0,1,2);e(a,Z_LDX,3,0,1);}
        else {let ix:i32=cg_v(h,1,0,3);e(a,Z_SLICE,0,0,4);e(a,Z_LIT,1,ix,0);e(a,Z_LDX,2,0,1);}
    } else if(stage==7){
        // C8 pointers
        if(k==0){e(a,Z_LIT,0,33,0);e(a,Z_PTR,1,0,0);e(a,Z_LDPTR,2,1,0);}
        else if(k==1){e(a,Z_LIT,5,44,0);e(a,Z_PTR,1,5,0);e(a,Z_LIT,2,55,0);e(a,Z_STPTR,1,2,0);}
        else if(k==2){e(a,Z_LIT,7,66,0);e(a,Z_PTR,3,7,0);e(a,Z_LDPTR,4,3,0);e(a,Z_ADD,5,4,4);}
        else {let v:i32=cg_v(h,1,1,80);e(a,Z_LIT,2,v,0);e(a,Z_PTR,1,2,0);e(a,Z_LDPTR,3,1,0);}
    } else if(stage==8){
        // C9 optionals+errors
        if(k==0){e(a,Z_NONE,0,0,0);e(a,Z_UNWRAP,1,0,0);}
        else if(k==1){e(a,Z_LIT,0,0,0);e(a,Z_SOME,1,0,0);e(a,Z_UNWRAP,2,1,0);}
        else if(k==2){e(a,Z_LIT,0,-42,0);e(a,Z_SOME,1,0,0);e(a,Z_UNWRAP,2,1,0);e(a,Z_NEG,3,2,0);}
        else if(k==3){e(a,Z_LIT,3,9,0);e(a,Z_ERR,3,0,0);}
        else if(k==4){e(a,Z_NONE,5,0,0);e(a,Z_MATCH,5,0,0);}
        else if(k==5){e(a,Z_NONE,5,0,0);e(a,Z_MATCH,5,1,0);}
        else if(k==6){e(a,Z_LIT,0,12,0);e(a,Z_SOME,1,0,0);e(a,Z_MATCH,1,0,0);}
        else if(k==7){e(a,Z_LIT,0,1,0);e(a,Z_ERR,0,0,0);}
        else {let v:i32=cg_v(h,1,1,50);e(a,Z_LIT,0,v,0);e(a,Z_SOME,1,0,0);e(a,Z_UNWRAP,2,1,0);}
    } else if(stage==9){
        // C10 modules
        memit(g,0,0,Z_LIT,1,100,0);memit(g,0,0,Z_ADD,0,0,1);memit(g,0,0,Z_RET,0,0,0);
        memit(g,1,0,Z_LIT,1,2,0);memit(g,1,0,Z_MUL,0,0,1);memit(g,1,0,Z_RET,0,0,0);
        g.*.has_mods=1;
        let zp:i32=1|(7<<8);
        if(k==0){e(a,Z_LIT,0,4,0);e(a,Z_LIT,7,100,0);e(a,Z_CALLM,0,0,zp);}
        else if(k==1){e(a,Z_IMPORT,0,0,0);e(a,Z_LIT,0,4,0);e(a,Z_LIT,7,100,0);e(a,Z_CALLM,1,0,zp);}
        else if(k==2){e(a,Z_IMPORT,0,0,0);e(a,Z_LIT,0,0,0);e(a,Z_LIT,7,100,0);e(a,Z_CALLM,0,0,zp);}
        else if(k==3){e(a,Z_IMPORT,1,0,0);e(a,Z_LIT,0,0,0);e(a,Z_LIT,7,100,0);e(a,Z_CALLM,1,0,zp);}
        else {e(a,Z_IMPORT,0,0,0);e(a,Z_LIT,0,7,0);e(a,Z_LIT,7,100,0);e(a,Z_CALLM,0,0,zp);}
    } else {
        // stages 10/11: K3 handled by gen_k3_qa / gen_k3_path (not here)
        e(a,Z_LIT,0,0,0);
    }
}
fn gen_c7var(stage:i32,g:*GenOut,idx:i32)void {
    // lawful variation of a held-out template: literal shift / lit swap / reg rename
    gen_held(stage,g,700+idx);
    let a:*Asm=&g.*.prog;
    let v:i32=zu_mod(idx,3);
    let i:i32=0;
    if(v==0){
        // shift every LIT value by +100
        while(i<a.*.ni){
            let w:i32=(2+i*4)*4;
            if(zu_get(a.*.b,w)==Z_LIT){
                zu_set(a.*.b,(w+1)*4,zu_get(a.*.b,(w+1)*4)+100);
            }
            i=i+1;
        }
    } else if(v==1){
        // swap first two LIT instructions' values (if >=2 LITs)
        let f1:i32=-1;let f2:i32=-1;
        while(i<a.*.ni){
            let w:i32=(2+i*4)*4;
            if(zu_get(a.*.b,w)==Z_LIT){
                if(f1<0){f1=i;} else if(f2<0){f2=i;}
            }
            i=i+1;
        }
        if(f1>=0 && f2>=0){
            let w1:i32=(2+f1*4)*4;let w2:i32=(2+f2*4)*4;
            let t:i32=zu_get(a.*.b,(w1+1)*4);
            zu_set(a.*.b,(w1+1)*4,zu_get(a.*.b,(w2+1)*4));
            zu_set(a.*.b,(w2+1)*4,t);
        }
    } else {
        // rename registers 1<->2 throughout
        while(i<a.*.ni){
            let w:i32=(2+i*4)*4;
            let op:i32=zu_get(a.*.b,w);
            if(op!=Z_IFZ && op!=Z_LOOP && op!=Z_SEL && op!=Z_CALLM){
                let k:i32=1;
                while(k<=3){
                    let r:i32=zu_get(a.*.b,(w+k)*4);
                    if(r==1){zu_set(a.*.b,(w+k)*4,2);}
                    else if(r==2){zu_set(a.*.b,(w+k)*4,1);}
                    k=k+1;
                }
            }
            i=i+1;
        }
    }
    g.*.tmpl=8;
}


// template id for the transcript: stage*1000000 + kind*100000 + tmpl*1000 + idx
fn cg_tid(stage:i32,kind:i32,tmpl:i32,idx:i32)i32 {
    return stage*1000000+kind*100000+tmpl*1000+idx;
}

// ============ Stage 10 (C11): invariant Q&A ============
// World's true guard table: (op, cond) -> expected refusal code.
// op: 0=KILL,1=STRENGTHEN,2=EVIDENCE,3=JUSTIFY,4=ADD,5=FORCE_PIN.
// cond: bit0 pinned, bit1 core, bit2 notlive, bit3 caller_tnn,
//       bit4 badstr, bit5 badcode, bit6 dupcite, bit7 forcepin.
fn qa_oracle(op:i32,cond:i32)i32 {
    let pinned:i32=cond%2;
    let core:i32=(cond/2)%2;
    let notlive:i32=(cond/4)%2;
    let caller_tnn:i32=(cond/8)%2;
    let badstr:i32=(cond/16)%2;
    let badcode:i32=(cond/32)%2;
    let dupcite:i32=(cond/64)%2;
    let forcepin:i32=(cond/128)%2;
    if(op==5){
        // FORCE_PIN: caller must be TNN
        if(caller_tnn==0){return 123;}
        return 0;
    }
    if(op==1){
        // STRENGTHEN: core guard first
        if(core==1){return 101;}
        if(badstr==1){return 127;}
        return 0;
    }
    // KILL / EVIDENCE / JUSTIFY / ADD share the guard chain.
    // Priority: core(101) > caller/forcepin-validity > strength/content(127)
    //          > evidence(126) > pin(102) > notlive(103).
    if(core==1){return 101;}
    if(caller_tnn==1){return 123;}
    if(forcepin==1){return 124;}
    if(badstr==1){return 127;}
    if(badcode==1){return 126;}
    if(dupcite==1){return 125;}
    if(pinned==1){return 102;}
    if(notlive==1){return 103;}
    return 0;
}

// QA generator: family 0=kill-guard, 1=strengthen/evidence, 2=force-pin,
// 3=multi-bit (composition). Stores op/cond in g (qa_op/qa_cond fields).
fn gen_qa(g:*GenOut,family:i32,idx:i32)void {
    let h:i32=cg_h(10,KIND_SCAF+family,idx);
    let op:i32=0;
    let cond:i32=0;
    if(family==0){
        op=0;
        let v:i32=zu_mod(h,8);
        if(v==0){cond=1;}            // pinned
        else if(v==1){cond=2;}       // core
        else if(v==2){cond=4;}       // notlive
        else if(v==3){cond=3;}       // pinned+core (priority test)
        else if(v==4){cond=5;}       // pinned+notlive
        else if(v==5){cond=6;}       // core+notlive
        else if(v==6){cond=0;}       // clean
        else {cond=1+8*zu_mod(h/8,2);} // pinned (+caller noise)
    } else if(family==1){
        let w:i32=zu_mod(h,6);
        if(w==0){op=1;cond=16;}        // strengthen badstr
        else if(w==1){op=1;cond=18;}   // strengthen core+badstr (priority)
        else if(w==2){op=2;cond=32;}   // evidence badcode
        else if(w==3){op=2;cond=96;}   // evidence badcode+dupcite (priority)
        else if(w==4){op=3;cond=32;}   // justify badcode
        else {op=4;cond=16;}          // add badstr
    } else if(family==2){
        op=5;
        let v:i32=zu_mod(h,4);
        if(v==0){cond=8;}            // caller_tnn -> allowed
        else if(v==1){cond=0;}       // no caller -> 123
        else if(v==2){cond=12;}      // caller+notlive (caller check first)
        else {cond=128;}            // forcepin flag w/o caller -> 123
    } else {
        // multi-bit composition
        let w:i32=zu_mod(h,6);
        if(w==0){op=0;cond=3;}        // kill pinned+core
        else if(w==1){op=0;cond=19;}  // kill pinned+core+badstr (core wins)
        else if(w==2){op=1;cond=22;}  // strengthen core+badstr+notlive
        else if(w==3){op=2;cond=100;} // evidence badcode+dupcite+notlive
        else if(w==4){op=0;cond=9;}   // kill pinned+caller (caller wins)
        else {op=5;cond=8;}          // force_pin caller_tnn
    }
    // noise bits: flip a high irrelevant bit pattern deterministically
    // (the oracle ignores them; the learner must too).
    let noise:i32=zu_mod(h/64,4)*256;
    cond=cond+noise;
    g.*.qa_op=op;
    g.*.qa_cond=cond;
    g.*.tmpl=family;
}

// QA adversarial K3: 10 cases incl. priority inversions and noise traps.
fn gen_k3_qa(idx:i32,op_out:*i32,cond_out:*i32)void {
    let k:i32=zu_mod(idx,10);
    let op:i32=0;
    let cond:i32=0;
    if(k==0){op=0;cond=1;}
    else if(k==1){op=0;cond=6;}
    else if(k==2){op=0;cond=3;}
    else if(k==3){op=1;cond=16;}
    else if(k==4){op=1;cond=18;}
    else if(k==5){op=2;cond=96;}
    else if(k==6){op=5;cond=8;}
    else if(k==7){op=5;cond=12;}
    else if(k==8){op=4;cond=16;}
    else {op=3;cond=32;}
    // noise: flip bit 8 and bit 9 (oracle-irrelevant)
    cond=cond+768;
    op_out.*=op;
    cond_out.*=cond;
}

// ============ Stage 11 (C12): path-trace predicates ============
// Oracle with event recording. ev/evcap are caller-owned; evn_out gets count.
fn oracle_run_ev(prog:*Asm,funcs:[]u8,modtabs:[]u8,out:[]u8,
                 ev:[]u8,evn_out:*i32,evcap:i32)void {
    let m:ZMach=z0_new_mach();
    z0_arm_ev(&m,ev,evcap);
    z0_load_heap(prog.*.b,&m);
    let regs:[]u8=z0_regs_new();
    let tags:[]u8=z0_tags_new();
    let i:i32=0;
    while(i<Z_NREG*4){regs[i]=0;i=i+1;}
    i=0;
    while(i<Z_NREG){tags[i]=0;i=i+1;}
    z0_exec(prog.*.b,2,prog.*.ni,regs,tags,&m,funcs,modtabs,0);
    z0_output(regs,tags,&m,out);
    evn_out.*=m.evn;
    nio_free(regs);nio_free(tags);z0_disarm_ev(&m);z0_free_mach(&m);
}

// Path program generator. mode 0=straight, 1=ifz-toggle, 2=nested, 3=loop-mix.
// Stores the predicate index in g.path_q.
fn gen_path(g:*GenOut,mode:i32,idx:i32)void {
    let h:i32=cg_h(11,KIND_SCAF+mode,idx);
    let a:*Asm=&g.*.prog;
    let q:i32=zu_mod(h,6);
    if(mode==0){
        let v:i32=cg_v(h,1,0,9);
        e(a,Z_LIT,0,v,0);e(a,Z_LIT,1,3,0);e(a,Z_ADD,2,0,1);
        e(a,Z_LIT,3,2,0);e(a,Z_MUL,4,2,3);e(a,Z_ADD,7,4,0);
    } else if(mode==1){
        let c:i32=cg_v(h,1,0,4);
        e(a,Z_LIT,0,c,0);e(a,Z_IFZ,0,1,1);
        e(a,Z_LIT,1,11,0);e(a,Z_LIT,1,22,0);
        e(a,Z_ADD,7,1,1);
    } else if(mode==2){
        let c:i32=cg_v(h,1,0,3);
        e(a,Z_LIT,0,1,0);e(a,Z_LIT,1,c,0);e(a,Z_LIT,2,1,0);
        e(a,Z_LOOP,1,1,0);e(a,Z_IFZ,1,1,1);
        e(a,Z_LIT,3,5,0);e(a,Z_LIT,3,9,0);e(a,Z_ADD,7,3,3);
    } else {
        let cnt:i32=cg_v(h,1,0,4);
        e(a,Z_LIT,0,cnt,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,2,0);
        e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);e(a,Z_ADD,7,1,1);
    }
    g.*.path_q=q;
    g.*.tmpl=mode;
}

// Path K3: 10 adversarial (program, q) pairs.
fn gen_k3_path(idx:i32,g:*GenOut,q_out:*i32)void {
    let k:i32=zu_mod(idx,10);
    let a:*Asm=&g.*.prog;
    let q:i32=0;
    if(k==0){e(a,Z_LIT,0,0,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);q=0;}
    else if(k==1){e(a,Z_LIT,0,3,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);q=4;}
    else if(k==2){e(a,Z_LIT,0,2,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,0,1,0);e(a,Z_ADD,1,1,2);q=4;}
    else if(k==3){e(a,Z_LIT,0,0,0);e(a,Z_IFZ,0,1,1);e(a,Z_LIT,1,11,0);e(a,Z_LIT,1,22,0);q=1;}
    else if(k==4){e(a,Z_LIT,0,5,0);e(a,Z_IFZ,0,1,1);e(a,Z_LIT,1,11,0);e(a,Z_LIT,1,22,0);q=1;}
    else if(k==5){e(a,Z_LIT,0,1,0);e(a,Z_LIT,1,0,0);e(a,Z_DIV,2,0,1);q=2;}
    else if(k==6){e(a,Z_LIT,0,5,0);e(a,Z_LIT,1,3,0);e(a,Z_ADD,2,0,1);q=2;}
    else if(k==7){e(a,Z_LIT,0,5,0);e(a,Z_ADD,7,0,0);q=3;}
    else if(k==8){e(a,Z_LIT,0,0,0);e(a,Z_ADD,7,0,0);q=3;}
    else {e(a,Z_LIT,0,1,0);e(a,Z_LIT,1,0,0);e(a,Z_LIT,2,1,0);e(a,Z_LOOP,1,1,0);e(a,Z_IFZ,1,1,1);e(a,Z_LIT,3,5,0);e(a,Z_LIT,3,9,0);q=5;}
    g.*.path_q=q;
    g.*.tmpl=7;
    q_out.*=q;
}

// Retire the old PC3 planted scaffold generator (loop-based plant is moved
// to the C4 IFZ scaffold's planted param per the 2026-09-20 amendment).
fn gen_c4_scaf_pc3_retired()void {
}

// World's true path-predicate verdict: run the oracle with event recording,
// then evaluate z0_check_pred on the recorded events.
fn path_oracle(prog:*Asm,funcs:[]u8,modtabs:[]u8,q:i32)i32 {
    let out:[]u8=nio_alloc(18*4);
    let ev:[]u8=nio_alloc(1536*4);
    let evn:i32=0;
    oracle_run_ev(prog,funcs,modtabs,out,ev,&evn,1536);
    let regs:[]u8=nio_alloc(Z_NREG*4);
    let i:i32=0;
    while(i<Z_NREG){zu_set(regs,i*4,zu_get(out,(i*2+1)*4));i=i+1;}
    let fault:i32=zu_get(out,16*4);
    let v:i32=z0_check_pred(q,ev,evn,regs,fault);
    nio_free(out);nio_free(ev);nio_free(regs);
    return v;
}

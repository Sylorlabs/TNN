// zutil.zag — shared pilot utilities (pilot side only; checker.zag has its own).
@import("substrate/cl/common.zag")

fn zu_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn zu_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
// Deterministic integer hash (no RNG anywhere in the pilot).
fn zu_hash(x:i32)i32 {
    let h:i32=x*1103515245+12345;
    h=h^(h>>13);
    h=h*1103515245+12345;
    h=h^(h>>16);
    return h;
}
fn zu_hash3(a:i32,b:i32,c:i32)i32 { return zu_hash(zu_hash(a*31+b)*31+c); }
fn zu_mod(h:i32,m:i32)i32 {
    let r:i32=h%m;
    if(r<0){r=r+m;}
    return r;
}
fn zu_pnum(x:i32)void { cl_number(x as i64); }
fn zu_abs(x:i32)i32 { if(x<0){return 0-x;} return x; }
fn zu_min(a:i32,b:i32)i32 { if(a<b){return a;} return b; }

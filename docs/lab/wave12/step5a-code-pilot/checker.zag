// checker.zag — independent verifier for STEP 5a code curriculum pilot.
// Reads ONLY the committed transcript file (no generator/learner/pilot code).
// Verifies: episode count, per-stage bars, K3, poison, disconnects, audit cap,
// template disjointness (scaffold vs held-out), and byte-identical reruns.
// Usage: checker <transcript_path> <expected_episodes> <mode>
//   mode 0: full trial (3950 eps, all bars)
//   mode 1: PC1 (expect >=1 trap failure)
//   mode 2: PC2 (expect template overlap detected)
//   mode 3: planted PC3 (expect stage-3 K3 >=2/10, others <=1/10)
// Returns 0 if all checks pass, 1 otherwise.
@import("substrate/cl/common.zag")
@import("zutil.zag")

// ---- ASCII parsing ----
fn ck_parse_int(s:[]u8, at:i32, n:i32) i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<n){
        let c:i32=s[at+i] as i32;
        if(c>=48 && c<=57){
            v=v*10+(c-48);
        }
        i=i+1;
    }
    return v;
}
fn ck_field(s:[]u8, line_at:i32, line_len:i32, k:i32) i32 {
    let f:i32=0;
    let i:i32=0;
    while(i<line_len){
        if(f==k){return line_at+i;}
        if(s[line_at+i]==32){f=f+1;}
        i=i+1;
    }
    if(f==k){return line_at+i;}
    return -1;
}
fn ck_field_len(s:[]u8, at:i32, line_end:i32) i32 {
    let i:i32=at;
    while(i<line_end && s[i]!=32){i=i+1;}
    return i-at;
}
fn ck_starts_with(s:[]u8, at:i32, len:i32, prefix:[]u8) i32 {
    if(len < prefix.len){return 0;}
    let i:i32=0;
    while(i<prefix.len){
        if(s[at+i]!=prefix[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn ck_print(s:[]u8)void { _zag_print(s); }
fn ck_println(s:[]u8)void { _zag_println(s); }
fn ck_pi(v:i32)void { _zag_print(_zag_i64_to_str(v as i64)); }

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    let exp_ep:i32=3950;
    let mode:i32=0;
    let a2:[]u8=_zag_arg(2);
    if(a2.len>0){exp_ep=ck_parse_int(a2,0,a2.len);}
    let a3:[]u8=_zag_arg(3);
    if(a3.len>0){mode=ck_parse_int(a3,0,a3.len);}
    
    let root:i64=nio_open_root("/tmp");
    if(root<0){
        ck_println("checker: cannot open /tmp");
        return 1;
    }
    let bn_at:i32=0;
    let i:i32=0;
    while(i<path.len){
        if(path[i]==47){bn_at=i+1;}
        i=i+1;
    }
    let bn_len:i32=path.len-bn_at;
    let bn:[]u8=nio_alloc(bn_len);
    i=0;
    while(i<bn_len){bn[i]=path[bn_at+i];i=i+1;}
    let fd:i64=nio_open_child(root,bn,0);
    nio_free(bn);
    nio_close(root);
    if(fd<0){
        ck_println("checker: cannot open transcript");
        return 1;
    }
    let buf:[]u8=nio_alloc(2000000);
    let nr:i64=nio_read_exact(fd,buf,2000000);
    nio_close(fd);
    if(nr<=0){
        ck_println("checker: empty transcript");
        nio_free(buf);
        return 1;
    }
    let n:i32=nr as i32;
    let fail:i32=0;
    
    // Per-stage EP counts by kind (kind 0..9). 12 stages x 10 kinds.
    let epk:[]u8=nio_alloc(12*10*4);
    i=0;
    while(i<120){zu_set(epk,i*4,0);i=i+1;}
    // Per-stage tallies from SCORE lines
    let nstage:i32=12;
    let pos:i32=0;
    let overlap_found:i32=0;
    let pc1_trap_fail:i32=0;
    let disconnect_n:i32=0;
    let poison_killed:i32=0;
    let poison_absorbed:i32=0;
    let ret_ok:[]u8=nio_alloc(12*4);
    let ret_n:[]u8=nio_alloc(12*4);
    i=0;
    while(i<12){zu_set(ret_ok,i*4,0);zu_set(ret_n,i*4,0);i=i+1;}
    
    while(pos<n){
        let le:i32=pos;
        while(le<n && buf[le]!=10){le=le+1;}
        let llen:i32=le-pos;
        if(llen>0){
            if(ck_starts_with(buf,pos,llen,"EP ")==1){
                let f1:i32=ck_field(buf,pos,llen,2);
                let f2:i32=ck_field(buf,pos,llen,3);
                if(f1>=0 && f2>=0){
                    let stage:i32=ck_parse_int(buf,f1,ck_field_len(buf,f1,pos+llen));
                    let kind:i32=ck_parse_int(buf,f2,ck_field_len(buf,f2,pos+llen));
                    if(stage>=0 && stage<12 && kind>=0 && kind<10){
                        let ix:i32=(stage*10+kind)*4;
                        zu_set(epk,ix,zu_get(epk,ix)+1);
                    }
                }
                // template overlap check via tid (field 4)
                // tid = stage*1000000 + KIND*100000 + tmpl*1000 + idx
                // KIND_SCAF=0, KIND_HELD=3. Stages 10/11 (QA/path) use
                // family/mode templates shared by design; exempt them.
                let f4:i32=ck_field(buf,pos,llen,4);
                if(f4>=0){
                    let fl:i32=ck_field_len(buf,f4,pos+llen);
                    let tid:i32=ck_parse_int(buf,f4,fl);
                    let tstage:i32=tid/1000000;
                    let kind:i32=(tid/100000)%10;
                    let tmpl:i32=(tid/1000)%100;
                    if(tstage<10){
                        if(kind==3 && tmpl<3){overlap_found=1;}
                        if(kind==0 && tmpl>=3 && tmpl<30){overlap_found=1;}
                    }
                }
            }
            if(ck_starts_with(buf,pos,llen,"SCORE ")==1){
                let f1:i32=ck_field(buf,pos,llen,1);
                let f2:i32=ck_field(buf,pos,llen,2);
                let f3:i32=ck_field(buf,pos,llen,3);
                let f4:i32=ck_field(buf,pos,llen,4);
                if(f1>=0 && f2>=0 && f3>=0 && f4>=0){
                    let stage:i32=ck_parse_int(buf,f1,ck_field_len(buf,f1,pos+llen));
                    let ok:i32=ck_parse_int(buf,f3,ck_field_len(buf,f3,pos+llen));
                    let tot:i32=ck_parse_int(buf,f4,ck_field_len(buf,f4,pos+llen));
                    let pl:i32=ck_field_len(buf,f2,pos+llen);
                    if(mode==0 || mode==3){
                        if(ck_starts_with(buf,f2,pl,"heldout")==1){
                            // planted stage 3 is expected to fail heldout
                            if(!(mode==3 && stage==3) && tot>0 && ok*100 < tot*95){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" heldout <95%");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"fault")==1){
                            if(ok<9){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" fault <9/10");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"comp")==1){
                            if(ok<8){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" comp <8/10");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"traps")==1){
                            if(ok!=tot){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" traps not 100%");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"k3kill")==1){
                            if(mode==0 && ok>1){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" K3 fired in corrected mode");
                                fail=1;
                            }
                            if(mode==3 && stage==3 && ok<2){
                                ck_println("checker FAIL: planted stage 3 K3 <2/10");
                                fail=1;
                            }
                            if(mode==3 && stage!=3 && ok>1){
                                ck_print("checker FAIL: planted stage ");ck_pi(stage);
                                ck_println(" K3 fired (should not)");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"k4")==1){
                            if(ok!=5){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" k4 !=5/5");
                                fail=1;
                            }
                        }
                        if(ck_starts_with(buf,f2,pl,"c7var")==1){
                            // planted stage 3 is expected to fail c7var
                            if(!(mode==3 && stage==3) && ok!=7){
                                ck_print("checker FAIL: stage ");ck_pi(stage);
                                ck_println(" c7var !=7/7");
                                fail=1;
                            }
                        }
                    }
                    if(mode==1){
                        if(ck_starts_with(buf,f2,pl,"traps")==1){
                            if(ok<tot){pc1_trap_fail=1;}
                        }
                    }
                }
            }
            if(ck_starts_with(buf,pos,llen,"HISTAGG ")==1){
                let f1:i32=ck_field(buf,pos,llen,1);
                let f2:i32=ck_field(buf,pos,llen,2);
                if(f1>=0 && f2>=0){
                    let med:i32=ck_parse_int(buf,f1,ck_field_len(buf,f1,pos+llen));
                    let mx:i32=ck_parse_int(buf,f2,ck_field_len(buf,f2,pos+llen));
                    if(mx>4096){
                        ck_println("checker FAIL: audit max >4KiB");
                        fail=1;
                    }
                    ck_print("checker: audit median=");ck_pi(med);
                    ck_print(" max=");ck_pi(mx);ck_println("");
                }
            }
            if(ck_starts_with(buf,pos,llen,"DISCONNECT ")==1){
                disconnect_n=disconnect_n+1;
            }
            if(ck_starts_with(buf,pos,llen,"POISON ")==1){
                // POISON <stage> <ep> killed|absorbed
                let f3:i32=ck_field(buf,pos,llen,3);
                if(f3>=0){
                    let fl:i32=ck_field_len(buf,f3,pos+llen);
                    if(ck_starts_with(buf,f3,fl,"killed")==1){poison_killed=poison_killed+1;}
                    else {poison_absorbed=poison_absorbed+1;}
                }
            }
            if(ck_starts_with(buf,pos,llen,"RET ")==1){
                let f1:i32=ck_field(buf,pos,llen,1);
                let f3:i32=ck_field(buf,pos,llen,3);
                if(f1>=0 && f3>=0){
                    let stage:i32=ck_parse_int(buf,f1,ck_field_len(buf,f1,pos+llen));
                    let ok:i32=ck_parse_int(buf,f3,ck_field_len(buf,f3,pos+llen));
                    if(stage>=0 && stage<12){
                        zu_set(ret_n,stage*4,zu_get(ret_n,stage*4)+1);
                        if(ok==1){zu_set(ret_ok,stage*4,zu_get(ret_ok,stage*4)+1);}
                    }
                }
            }
        }
        pos=le+1;
    }
    
    // Episode count
    let ep_total:i32=0;
    let s:i32=0;
    while(s<12){
        let k:i32=0;
        while(k<10){
            ep_total=ep_total+zu_get(epk,(s*10+k)*4);
            k=k+1;
        }
        s=s+1;
    }
    if(ep_total!=exp_ep){
        ck_print("checker FAIL: episodes ");ck_pi(ep_total);
        ck_print(" != ");ck_pi(exp_ep);ck_println("");
        fail=1;
    } else {
        ck_print("checker: episodes ");ck_pi(ep_total);ck_println("");
    }
    
    // Per-stage adversarial distribution (mode 0,3): 10 K3 + 8 traps + 5 K4 + 7 var
    if(mode==0 || mode==3){
        s=0;
        while(s<12){
            let k3:i32=zu_get(epk,(s*10+6)*4);
            let tr:i32=zu_get(epk,(s*10+5)*4);
            let k4:i32=zu_get(epk,(s*10+7)*4);
            let vr:i32=zu_get(epk,(s*10+8)*4);
            if(k3!=10 || tr!=8 || k4!=5 || vr!=7){
                ck_print("checker FAIL: stage ");ck_pi(s);
                ck_print(" adv distribution k3=");ck_pi(k3);
                ck_print(" traps=");ck_pi(tr);
                ck_print(" k4=");ck_pi(k4);
                ck_print(" var=");ck_pi(vr);ck_println("");
                fail=1;
            }
            s=s+1;
        }
        ck_println("checker: adversarial distribution verified (10+8+5+7 per stage)");
        // Disconnects: 12 learner-initiated
        if(disconnect_n!=12){
            ck_print("checker FAIL: disconnects ");ck_pi(disconnect_n);
            ck_println(" != 12");
            fail=1;
        } else {
            ck_println("checker: 12 learner-initiated disconnects");
        }
        // Poison: 12 killed, 0 absorbed
        if(poison_killed!=12 || poison_absorbed!=0){
            ck_print("checker FAIL: poison killed=");ck_pi(poison_killed);
            ck_print(" absorbed=");ck_pi(poison_absorbed);ck_println("");
            fail=1;
        } else {
            ck_println("checker: 12/12 poisons killed");
        }
        // Retention: 10/10 per stage
        s=0;
        while(s<12){
            let rok:i32=zu_get(ret_ok,s*4);
            let rn:i32=zu_get(ret_n,s*4);
            // planted stage 3 is expected to fail retention
            if(!(mode==3 && s==3) && (rn!=10 || rok!=10)){
                ck_print("checker FAIL: stage ");ck_pi(s);
                ck_print(" retention ");ck_pi(rok);ck_print("/");ck_pi(rn);ck_println("");
                fail=1;
            }
            s=s+1;
        }
        ck_println("checker: retention 10/10 per stage");
    }
    
    // Mode-specific
    if(mode==1 && pc1_trap_fail==0){
        ck_println("checker FAIL: PC1 expected >=1 trap failure");
        fail=1;
    }
    if(mode==1 && pc1_trap_fail==1){
        ck_println("checker: PC1 trap failure confirmed");
    }
    if(mode==2 && overlap_found==0){
        ck_println("checker FAIL: PC2 expected template overlap");
        fail=1;
    }
    if(mode==2 && overlap_found==1){
        ck_println("checker: PC2 template overlap detected");
    }
    if((mode==0 || mode==3) && overlap_found==1){
        ck_println("checker FAIL: template overlap in full trial");
        fail=1;
    }
    
    nio_free(buf);nio_free(epk);nio_free(ret_ok);nio_free(ret_n);
    if(fail==1){
        ck_println("checker: FAIL");
        return 1;
    }
    ck_println("checker: PASS");
    return 0;
}

// pilot.zag — STEP 5a code curriculum pilot orchestrator (trainer side).
//
// Runs the full 3,950-episode curriculum: 12 stages × (scaffold + watch +
// held-out + fault-localization + composition + adversarial/integrity).
// The pilot generates programs (codegen.zag), runs the world oracle
// (semantics.zag) for ground truth, drives the learner (learner.zag), and
// prints the transcript to stdout (redirected to a file).
//
// Modes: 0 = planted (PC3: C4 scaffold omits discriminators; K3 must fire).
//        1 = corrected (full discriminators; all bars must pass).
// Zero RNG: all generation is closed-form over (stage, kind, idx).
@import("learner.zag")
@import("hist.zag")

// ---- episode kinds ----
const PK_SCAF:i32=0;
const PK_WATCH:i32=1;
const PK_HELD:i32=2;
const PK_FAULT:i32=3;
const PK_COMP:i32=4;
const PK_TRAP:i32=5;
const PK_K3:i32=6;
const PK_K4:i32=7;
const PK_C7VAR:i32=8;
const PK_POISON:i32=9;

// ---- per-stage episode counts (3,950 total) ----
// stages 0..10: 279 curriculum (195 scaf + 28 watch + 56 held) + 10 + 10 + 30
// stage 11:     281 curriculum (197 scaf + 28 watch + 56 held) + 10 + 10 + 30
// 11*329 + 331 = 3619 + 331 = 3950.
fn pilot_ncur(stage:i32)i32 {
    if(stage==11){return 281;}
    return 279;
}
// Prereg per-stage counts (scaffold/watch/held-out):
// C1 70/10/20, C2 105/15/30, C3 140/20/40, C4 175/25/50, C5 280/40/80,
// C6 350/50/100, C7 280/40/80, C8 245/35/70, C9 175/25/50, C10 175/25/50,
// C11 140/20/40, C12 210/30/60.
fn pilot_nscaf(stage:i32)i32 {
    if(stage==0){return 70;}
    if(stage==1){return 105;}
    if(stage==2){return 140;}
    if(stage==3){return 175;}
    if(stage==4){return 280;}
    if(stage==5){return 350;}
    if(stage==6){return 280;}
    if(stage==7){return 245;}
    if(stage==8){return 175;}
    if(stage==9){return 175;}
    if(stage==10){return 140;}
    return 210;
}
fn pilot_nwatch(stage:i32)i32 {
    if(stage==0){return 10;}
    if(stage==1){return 15;}
    if(stage==2){return 20;}
    if(stage==3){return 25;}
    if(stage==4){return 40;}
    if(stage==5){return 50;}
    if(stage==6){return 40;}
    if(stage==7){return 35;}
    if(stage==8){return 25;}
    if(stage==9){return 25;}
    if(stage==10){return 20;}
    return 30;
}
fn pilot_nheld(stage:i32)i32 {
    if(stage==0){return 20;}
    if(stage==1){return 30;}
    if(stage==2){return 40;}
    if(stage==3){return 50;}
    if(stage==4){return 80;}
    if(stage==5){return 100;}
    if(stage==6){return 80;}
    if(stage==7){return 70;}
    if(stage==8){return 50;}
    if(stage==9){return 50;}
    if(stage==10){return 40;}
    return 60;
}

// ---- transcript printing ----
fn tp_s(s:[]u8)void { _zag_print(s); }
fn tp_i(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);
    _zag_print(s);
    nio_free(s);
}
fn tp_ln()void { _zag_println(""); }
fn tp_ep(ep:i32,stage:i32,kind:i32,tid:i32,ok:i32,abytes:i32)void {
    tp_s("EP ");tp_i(ep);tp_s(" ");tp_i(stage);tp_s(" ");tp_i(kind);
    tp_s(" ");tp_i(tid);tp_s(" ");tp_i(ok);tp_s(" ");tp_i(abytes);tp_ln();
}

// ---- pilot state ----
struct Pilot {
    L: Learner,
    ep: i32,           // global episode counter
    mode: i32,         // 0=planted, 1=corrected
    // per-stage tallies
    scaf_ok: i32, scaf_n: i32,
    watch_ok: i32, watch_n: i32, watch_consec: i32,
    held_ok: i32, held_n: i32,
    fault_ok: i32, fault_n: i32, fault_complete: i32,
    comp_ok: i32, comp_n: i32,
    trap_ok: i32, trap_n: i32,
    k3_kill: i32, k3_n: i32,   // k3_kill = # variants that killed/revised memory
    k4_ok: i32, c7var_ok: i32,
    disconnected: i32, disconnect_ep: i32, locked_rule: i32,
    // audit
    audit_bytes: []u8,  // per-episode bytes (for HISTAGG)
    audit_n: i32,
}

// planted flag for gen_scaf: 1 in PC3 planted mode, 0 in corrected mode.
fn pilot_planted(P:*Pilot) i32 {
    if(P.*.mode==0){return 1;}
    return 0;
}
fn pilot_init(mode:i32) Pilot {
    let P:Pilot=Pilot{.L=ln_init(),.ep=0,.mode=mode,
        .scaf_ok=0,.scaf_n=0,.watch_ok=0,.watch_n=0,.watch_consec=0,
        .held_ok=0,.held_n=0,.fault_ok=0,.fault_n=0,.fault_complete=0,
        .comp_ok=0,.comp_n=0,.trap_ok=0,.trap_n=0,
        .k3_kill=0,.k3_n=0,.k4_ok=0,.c7var_ok=0,
        .disconnected=0,.disconnect_ep=-1,.locked_rule=-1,
        .audit_bytes=nio_alloc(3950*4),.audit_n=0};
    return P;
}

// audit bytes for the current episode: (new ledger entries) * 64
fn pilot_audit(P:*Pilot) i32 {
    let n:i32=P.*.L.store.audit_n;
    // (we track the last count in the Pilot; store it in audit_bytes as we go)
    // Actually: compute delta from the previous episode's count.
    // We keep last_audit_n in a static-ish way via the audit_n index.
    // Simpler: the caller passes the pre-episode count.
    return n;
}

// ---- Stage 10 (C11) invariant-Q&A episodes ----
// The learner predicts the world's guard-table refusal code (qa_oracle).
fn pilot_scaf_qa_ep(P:*Pilot,stage:i32,idx:i32,is_poison:i32) i32 {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_qa(&g,zu_mod(idx,4),idx);
    let tid:i32=cg_tid(stage,KIND_SCAF,g.tmpl,idx);
    let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
    let pred:i32=ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let given:i32=tru;
    if(is_poison==1){given=99;}
    let oldmask:i32=zu_get(P.*.L.cand,stage*4);
    ln_observe_qa(&P.*.L,stage,g.qa_op,g.qa_cond,given,P.*.ep);
    let newmask:i32=zu_get(P.*.L.cand,stage*4);
    if(oldmask!=newmask){
        tp_s("ELIM ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" ");
        tp_i(oldmask);tp_s(" ");tp_i(newmask);tp_ln();
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_SCAF,tid,ok,abytes);
    if(is_poison==1){
        if(zu_get(P.*.L.poison_filed,stage*4)==1){
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" killed");tp_ln();
        } else {
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" absorbed");tp_ln();
        }
    } else {
        P.*.scaf_n=P.*.scaf_n+1;
        if(ok==1){P.*.scaf_ok=P.*.scaf_ok+1;}
    }
    P.*.ep=P.*.ep+1;
    genout_free(&g);
    return ok;
}
fn pilot_watch_qa_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_qa(&g,zu_mod(700+idx,4),700+idx);
    let tid:i32=cg_tid(stage,KIND_WATCH,g.tmpl,700+idx);
    let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
    let pred:i32=ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_WATCH,tid,ok,abytes);
    P.*.watch_n=P.*.watch_n+1;
    if(ok==1){P.*.watch_ok=P.*.watch_ok+1;P.*.watch_consec=P.*.watch_consec+1;}
    else {P.*.watch_consec=0;}
    if(P.*.watch_consec>=5 && P.*.disconnected==0){
        if(ln_disconnect_ready(&P.*.L,stage,P.*.watch_ok,P.*.watch_n)==1){
            let rule:i32=ln_disconnect(&P.*.L,stage,P.*.ep);
            P.*.disconnected=1;P.*.disconnect_ep=P.*.ep;P.*.locked_rule=rule;
            tp_s("DISCONNECT ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);
            tp_s(" ");tp_i(rule);tp_ln();
        }
    }
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}
fn pilot_held_qa_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_qa(&g,zu_mod(900+idx,4),900+idx);
    let tid:i32=cg_tid(stage,KIND_HELD,g.tmpl,900+idx);
    let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
    let pred:i32=ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_HELD,tid,ok,abytes);
    P.*.held_n=P.*.held_n+1;
    if(ok==1){P.*.held_ok=P.*.held_ok+1;}
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}

// ---- Stage 11 (C12) path-predicate episodes ----
// The learner predicts the world's path-predicate verdict (path_oracle).
fn pilot_scaf_path_ep(P:*Pilot,stage:i32,idx:i32,is_poison:i32) i32 {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_path(&g,zu_mod(idx,4),idx);
    let tid:i32=cg_tid(stage,KIND_SCAF,g.tmpl,idx);
    let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
    let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let given:i32=tru;
    if(is_poison==1){given=2;}
    let oldmask:i32=zu_get(P.*.L.cand,stage*4);
    ln_observe_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q,given,P.*.ep);
    let newmask:i32=zu_get(P.*.L.cand,stage*4);
    if(oldmask!=newmask){
        tp_s("ELIM ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" ");
        tp_i(oldmask);tp_s(" ");tp_i(newmask);tp_ln();
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_SCAF,tid,ok,abytes);
    if(is_poison==1){
        if(zu_get(P.*.L.poison_filed,stage*4)==1){
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" killed");tp_ln();
        } else {
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" absorbed");tp_ln();
        }
    } else {
        P.*.scaf_n=P.*.scaf_n+1;
        if(ok==1){P.*.scaf_ok=P.*.scaf_ok+1;}
    }
    P.*.ep=P.*.ep+1;
    genout_free(&g);
    return ok;
}
fn pilot_watch_path_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_path(&g,zu_mod(700+idx,4),700+idx);
    let tid:i32=cg_tid(stage,KIND_WATCH,g.tmpl,700+idx);
    let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
    let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_WATCH,tid,ok,abytes);
    P.*.watch_n=P.*.watch_n+1;
    if(ok==1){P.*.watch_ok=P.*.watch_ok+1;P.*.watch_consec=P.*.watch_consec+1;}
    else {P.*.watch_consec=0;}
    if(P.*.watch_consec>=5 && P.*.disconnected==0){
        if(ln_disconnect_ready(&P.*.L,stage,P.*.watch_ok,P.*.watch_n)==1){
            let rule:i32=ln_disconnect(&P.*.L,stage,P.*.ep);
            P.*.disconnected=1;P.*.disconnect_ep=P.*.ep;P.*.locked_rule=rule;
            tp_s("DISCONNECT ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);
            tp_s(" ");tp_i(rule);tp_ln();
        }
    }
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}
fn pilot_held_path_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_path(&g,zu_mod(900+idx,4),900+idx);
    let tid:i32=cg_tid(stage,KIND_HELD,g.tmpl,900+idx);
    let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
    let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
    let ok:i32=0;
    if(pred==tru){ok=1;}
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_HELD,tid,ok,abytes);
    P.*.held_n=P.*.held_n+1;
    if(ok==1){P.*.held_ok=P.*.held_ok+1;}
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}

// Run one scaffold episode. Returns 1 if learner's blind prediction was correct.
fn pilot_scaf_ep(P:*Pilot,stage:i32,idx:i32,is_poison:i32) i32 {
    if(stage==10){return pilot_scaf_qa_ep(P,stage,idx,is_poison);}
    if(stage==11){return pilot_scaf_path_ep(P,stage,idx,is_poison);}
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_scaf(stage,&g,idx,pilot_planted(P));
    let tid:i32=cg_tid(stage,KIND_SCAF,g.tmpl,idx);
    // oracle truth
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    // learner blind prediction
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    // induction (with poison corruption if this is the poison episode)
    let given:[]u8=tru;
    let corrupt:[]u8=nio_alloc(18*4);
    if(is_poison==1){
        // corrupt: flip one value word; verify it matches NO candidate
        let i:i32=0;
        while(i<18){zu_set(corrupt,i*4,zu_get(tru,i*4));i=i+1;}
        // find a corruption that matches no candidate (deterministic scan)
        let w:i32=1; // start at word 1 (a value word, not the tag)
        let found:i32=0;
        while(w<16 && found==0){
            zu_set(corrupt,w*4,zu_get(tru,w*4)+1);
            // check against all candidates via the learner's poison logic
            // (we replicate the check here to select the corruption)
            let sim:[]u8=nio_alloc(18*4);
            let rules:[]u8=nio_alloc(12*4);
            let nc:i32=ln_ncand(stage);
            let m:i32=0;
            let c:i32=0;
            while(c<nc){
                ln_fill_rules(&P.*.L,stage,c,rules);
                ln_sim(&g.prog,g.funcs,g.modtabs,rules,sim);
                if(ln_trace_eq(sim,corrupt)==1){m=1;}
                c=c+1;
            }
            nio_free(sim);nio_free(rules);
            if(m==0){found=1;}
            else {
                zu_set(corrupt,w*4,zu_get(tru,w*4)); // revert
                w=w+2; // next value word
            }
        }
        given=corrupt;
        // (if not found, given stays corrupt but might match; generator ensures
        //  a valid corruption exists for our templates)
    }
    let oldmask:i32=zu_get(P.*.L.cand,stage*4);
    ln_observe(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,given,P.*.ep);
    let newmask:i32=zu_get(P.*.L.cand,stage*4);
    if(oldmask!=newmask){
        tp_s("ELIM ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" ");
        tp_i(oldmask);tp_s(" ");tp_i(newmask);tp_ln();
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    // record audit bytes
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_SCAF,tid,ok,abytes);
    if(is_poison==1){
        if(zu_get(P.*.L.poison_filed,stage*4)==1){
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" killed");tp_ln();
        } else {
            tp_s("POISON ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);tp_s(" absorbed");tp_ln();
        }
        // poison is not counted in scaf_ok (it's an integrity episode)
    } else {
        P.*.scaf_n=P.*.scaf_n+1;
        if(ok==1){P.*.scaf_ok=P.*.scaf_ok+1;}
    }
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);nio_free(corrupt);
    genout_free(&g);
    return ok;
}

// Run one watch episode (criterion-watch, pre-disconnect). No learning.
fn pilot_watch_ep(P:*Pilot,stage:i32,idx:i32)void {
    if(stage==10){pilot_watch_qa_ep(P,stage,idx);return;}
    if(stage==11){pilot_watch_path_ep(P,stage,idx);return;}
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_watch(stage,&g,idx);
    let tid:i32=cg_tid(stage,KIND_WATCH,g.tmpl,idx);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_WATCH,tid,ok,abytes);
    P.*.watch_n=P.*.watch_n+1;
    if(ok==1){
        P.*.watch_ok=P.*.watch_ok+1;
        P.*.watch_consec=P.*.watch_consec+1;
    } else {
        P.*.watch_consec=0;
    }
    // learner-initiated disconnect check (5 consecutive)
    if(P.*.watch_consec>=5 && P.*.disconnected==0){
        if(ln_disconnect_ready(&P.*.L,stage,P.*.watch_ok,P.*.watch_n)==1){
            let rule:i32=ln_disconnect(&P.*.L,stage,P.*.ep);
            P.*.disconnected=1;
            P.*.disconnect_ep=P.*.ep;
            P.*.locked_rule=rule;
            tp_s("DISCONNECT ");tp_i(stage);tp_s(" ");tp_i(P.*.ep);
            tp_s(" ");tp_i(rule);tp_ln();
        }
    }
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);
    genout_free(&g);
}

// Run one held-out episode (post-disconnect). No learning.
fn pilot_held_ep(P:*Pilot,stage:i32,idx:i32)void {
    if(stage==10){pilot_held_qa_ep(P,stage,idx);return;}
    if(stage==11){pilot_held_path_ep(P,stage,idx);return;}
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_held(stage,&g,idx);
    let tid:i32=cg_tid(stage,KIND_HELD,g.tmpl,idx);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_HELD,tid,ok,abytes);
    P.*.held_n=P.*.held_n+1;
    if(ok==1){P.*.held_ok=P.*.held_ok+1;}
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);
    genout_free(&g);
}

// Retention probes (10 read-only endpoint probes; not episodes).
fn pilot_retention(P:*Pilot,stage:i32)void {
    let i:i32=0;
    while(i<10){
        if(stage==10){
            let gq:GenOut=genout_new();
            gen_qa(&gq,zu_mod(950+i,4),950+i);
            let tru:i32=qa_oracle(gq.qa_op,gq.qa_cond);
            let pred:i32=ln_predict_qa(&P.*.L,stage,gq.qa_op,gq.qa_cond);
            let ok:i32=0;
            if(pred==tru){ok=1;}
            tp_s("RET ");tp_i(stage);tp_s(" ");tp_i(i);tp_s(" ");tp_i(ok);tp_ln();
            genout_free(&gq);
            i=i+1;
            continue;
        }
        if(stage==11){
            let gp:GenOut=genout_new();
            gen_path(&gp,zu_mod(950+i,4),950+i);
            let tru:i32=path_oracle(&gp.prog,gp.funcs,gp.modtabs,gp.path_q);
            let pred:i32=ln_predict_path(&P.*.L,stage,&gp.prog,gp.funcs,gp.modtabs,gp.path_q);
            let ok:i32=0;
            if(pred==tru){ok=1;}
            tp_s("RET ");tp_i(stage);tp_s(" ");tp_i(i);tp_s(" ");tp_i(ok);tp_ln();
            genout_free(&gp);
            i=i+1;
            continue;
        }
        let g:GenOut=genout_new();
        gen_held(stage,&g,900+i);
        let tru:[]u8=nio_alloc(18*4);
        oracle_run(&g.prog,g.funcs,g.modtabs,tru);
        let pred:[]u8=nio_alloc(18*4);
        ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
        let ok:i32=ln_trace_eq(pred,tru);
        tp_s("RET ");tp_i(stage);tp_s(" ");tp_i(i);tp_s(" ");tp_i(ok);tp_ln();
        nio_free(pred);nio_free(tru);
        genout_free(&g);
        i=i+1;
    }
}

// Run one fault-localization episode.
// Stages 10/11 reuse the C1 fault machinery (locked C1 rules; documented
// retention-flavored fault localization per the 2026-09-20 amendment).
fn pilot_fault_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    let fault_pos:i32=-1;
    let base_idx:i32=-1;
    let fstage:i32=stage;
    if(stage==10 || stage==11){fstage=0;}
    gen_fault(fstage,&g,idx,&fault_pos,P.*.mode,&base_idx);
    let tid:i32=cg_tid(stage,KIND_FAULT,g.tmpl,idx);
    // oracle: faulty trace (what the learner sees) and spec (correct trace)
    let faulty:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,faulty);
    // spec = oracle trace of the UNFAULTED base program (regenerated
    // deterministically; gen_fault's base was gen_scaf(stage,100+idx,mode)).
    let gb:GenOut=genout_new();
    gen_scaf(fstage,&gb,base_idx,pilot_planted(P));
    let spec:[]u8=nio_alloc(18*4);
    oracle_run(&gb.prog,gb.funcs,gb.modtabs,spec);
    genout_free(&gb);
    // learner localizes
    let menu:[]u8=nio_alloc(8*4);
    let nm:i32=fault_menu(fstage,menu);
    let complete:i32=0;
    let found:i32=ln_localize(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,
                              spec,menu,nm,&complete);
    let ok:i32=0;
    if(found==fault_pos){ok=1;}
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_FAULT,tid,ok,abytes);
    tp_s("FAULTLOC ");tp_i(stage);tp_s(" ");tp_i(idx);tp_s(" ");
    tp_i(fault_pos);tp_s(" ");tp_i(found);tp_s(" ");tp_i(complete);tp_ln();
    P.*.fault_n=P.*.fault_n+1;
    if(ok==1){P.*.fault_ok=P.*.fault_ok+1;}
    if(complete==1){P.*.fault_complete=P.*.fault_complete+1;}
    P.*.ep=P.*.ep+1;
    nio_free(faulty);nio_free(spec);nio_free(menu);
    genout_free(&g);
}

// Run one composition episode.
// Stage 10: multi-bit guard composition (gen_qa family 3).
// Stage 11: nested IFZ+LOOP composition (gen_path mode 2).
fn pilot_comp_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    if(stage==10){
        gen_qa(&g,3,500+idx);
        let tid:i32=cg_tid(stage,KIND_COMP,g.tmpl,500+idx);
        let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
        let pred:i32=ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_COMP,tid,ok,abytes);
        P.*.comp_n=P.*.comp_n+1;
        if(ok==1){P.*.comp_ok=P.*.comp_ok+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    if(stage==11){
        gen_path(&g,2,500+idx);
        let tid:i32=cg_tid(stage,KIND_COMP,g.tmpl,500+idx);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
        let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_COMP,tid,ok,abytes);
        P.*.comp_n=P.*.comp_n+1;
        if(ok==1){P.*.comp_ok=P.*.comp_ok+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    gen_comp(stage,&g,idx,P.*.mode);
    let tid:i32=cg_tid(stage,KIND_COMP,g.tmpl,idx);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_COMP,tid,ok,abytes);
    P.*.comp_n=P.*.comp_n+1;
    if(ok==1){P.*.comp_ok=P.*.comp_ok+1;}
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);
    genout_free(&g);
}

// Stage 10 trap episode: QA traps A-H.
fn pilot_trap_qa_ep(P:*Pilot,stage:i32,trap_id:i32,inst:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_qa(&g,zu_mod(trap_id,4),400+trap_id*10+inst);
    let tid:i32=cg_tid(stage,KIND_TRAP,g.tmpl,trap_id*10+inst);
    let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
    let pass:i32=0;
    if(trap_id==0){
        pass=ln_trap_qa_a(&P.*.L,stage,g.qa_op,g.qa_cond,tru);
    } else if(trap_id==1){
        let g2:GenOut=genout_new();
        gen_qa(&g2,zu_mod(trap_id+1,4),410+trap_id*10+inst);
        let tru2:i32=qa_oracle(g2.qa_op,g2.qa_cond);
        pass=ln_trap_qa_b(&P.*.L,stage,g2.qa_op,g2.qa_cond,tru2);
        genout_free(&g2);
    } else if(trap_id==2){
        let hint:i32=tru+999;
        pass=ln_trap_qa_c(&P.*.L,stage,g.qa_op,g.qa_cond,tru,hint);
    } else if(trap_id==3){
        pass=ln_trap_qa_d(&P.*.L,stage);
    } else if(trap_id==4){
        let sug:i32=1;
        pass=ln_trap_qa_e(&P.*.L,stage,sug);
    } else if(trap_id==5){
        pass=ln_trap_qa_f(&P.*.L,stage,g.qa_op,g.qa_cond);
    } else if(trap_id==6){
        pass=ln_trap_qa_g(&P.*.L,stage,g.qa_op,g.qa_cond,tru);
    } else {
        pass=ln_trap_qa_h(&P.*.L,stage,g.qa_op,g.qa_cond);
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_TRAP,tid,pass,abytes);
    tp_s("ADV ");tp_i(stage);tp_s(" ");tp_i(trap_id);tp_s(" ");
    tp_i(inst);tp_s(" ");tp_i(pass);tp_ln();
    P.*.trap_n=P.*.trap_n+1;
    if(pass==1){P.*.trap_ok=P.*.trap_ok+1;}
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}
// Stage 11 trap episode: path traps A-H.
fn pilot_trap_path_ep(P:*Pilot,stage:i32,trap_id:i32,inst:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_path(&g,zu_mod(trap_id,4),400+trap_id*10+inst);
    let tid:i32=cg_tid(stage,KIND_TRAP,g.tmpl,trap_id*10+inst);
    let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
    let pass:i32=0;
    if(trap_id==0){
        pass=ln_trap_path_a(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q,tru);
    } else if(trap_id==1){
        let g2:GenOut=genout_new();
        gen_path(&g2,zu_mod(trap_id+1,4),410+trap_id*10+inst);
        let tru2:i32=path_oracle(&g2.prog,g2.funcs,g2.modtabs,g2.path_q);
        pass=ln_trap_path_b(&P.*.L,stage,&g2.prog,g2.funcs,g2.modtabs,g2.path_q,tru2);
        genout_free(&g2);
    } else if(trap_id==2){
        let hint:i32=1-tru;
        pass=ln_trap_path_c(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q,tru,hint);
    } else if(trap_id==3){
        pass=ln_trap_path_d(&P.*.L,stage);
    } else if(trap_id==4){
        let sug:i32=1;
        pass=ln_trap_path_e(&P.*.L,stage,sug);
    } else if(trap_id==5){
        pass=ln_trap_path_f(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
    } else if(trap_id==6){
        pass=ln_trap_path_g(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q,tru);
    } else {
        pass=ln_trap_path_h(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_TRAP,tid,pass,abytes);
    tp_s("ADV ");tp_i(stage);tp_s(" ");tp_i(trap_id);tp_s(" ");
    tp_i(inst);tp_s(" ");tp_i(pass);tp_ln();
    P.*.trap_n=P.*.trap_n+1;
    if(pass==1){P.*.trap_ok=P.*.trap_ok+1;}
    P.*.ep=P.*.ep+1;
    genout_free(&g);
}

// Run one trap episode (A-H). trap_id 0..7, instance 0..1.
// Stages 10/11 use the QA/path trap suites (ln_trap_qa_* / ln_trap_path_*).
fn pilot_trap_ep(P:*Pilot,stage:i32,trap_id:i32,inst:i32)void {
    if(stage==10){pilot_trap_qa_ep(P,stage,trap_id,inst);return;}
    if(stage==11){pilot_trap_path_ep(P,stage,trap_id,inst);return;}
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    gen_scaf(stage,&g,400+trap_id*10+inst,pilot_planted(P));
    let tid:i32=cg_tid(stage,KIND_TRAP,g.tmpl,trap_id*10+inst);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pass:i32=0;
    if(trap_id==0){
        pass=ln_trap_a(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,tru);
    } else if(trap_id==1){
        // B uses a held-out program (novel template)
        let gb:GenOut=genout_new();
        gen_held(stage,&gb,410+trap_id*10+inst);
        let trub:[]u8=nio_alloc(18*4);
        oracle_run(&gb.prog,gb.funcs,gb.modtabs,trub);
        pass=ln_trap_b(&P.*.L,stage,&gb.prog,gb.funcs,gb.modtabs,trub);
        nio_free(trub);
        genout_free(&gb);
    } else if(trap_id==2){
        // C: false hint (corrupted trace)
        let hint:[]u8=nio_alloc(18*4);
        let i:i32=0;
        while(i<18){zu_set(hint,i*4,zu_get(tru,i*4));i=i+1;}
        zu_set(hint,1*4,zu_get(tru,1*4)+999);
        pass=ln_trap_c(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,tru,hint);
        nio_free(hint);
    } else if(trap_id==3){
        pass=ln_trap_d(&P.*.L,stage);
    } else if(trap_id==4){
        // E: suggest a wrong candidate (1 if survivor is 0, else 0)
        let sug:i32=1;
        if(zu_get(P.*.L.rules,stage*4)==1){sug=0;}
        pass=ln_trap_e(&P.*.L,stage,sug);
    } else if(trap_id==5){
        pass=ln_trap_f(&P.*.L,stage,&g.prog,g.funcs,g.modtabs);
    } else if(trap_id==6){
        pass=ln_trap_g(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,tru);
    } else {
        pass=ln_trap_h(&P.*.L,stage,&g.prog,g.funcs,g.modtabs);
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_TRAP,tid,pass,abytes);
    tp_s("ADV ");tp_i(stage);tp_s(" ");tp_i(trap_id);tp_s(" ");
    tp_i(inst);tp_s(" ");tp_i(pass);tp_ln();
    P.*.trap_n=P.*.trap_n+1;
    if(pass==1){P.*.trap_ok=P.*.trap_ok+1;}
    P.*.ep=P.*.ep+1;
    nio_free(tru);
    genout_free(&g);
}

// Run one K3 adversarial-variant episode.
// Returns 1 if the variant KILLED or REVISED the stage-completion memory
// (i.e., the learner's prediction was wrong AND it altered its locked rule).
fn pilot_k3_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    if(stage==10){
        let op:i32=0;let cond:i32=0;
        gen_k3_qa(idx,&op,&cond);
        let tid:i32=cg_tid(stage,KIND_K3,7,idx);
        let tru:i32=qa_oracle(op,cond);
        let pred:i32=ln_predict_qa(&P.*.L,stage,op,cond);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let killed:i32=0;
        if(ok==0){killed=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_K3,tid,ok,abytes);
        tp_s("K3 ");tp_i(stage);tp_s(" ");tp_i(idx);tp_s(" ");
        tp_i(ok);tp_s(" ");tp_i(killed);tp_ln();
        P.*.k3_n=P.*.k3_n+1;
        if(killed==1){P.*.k3_kill=P.*.k3_kill+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    if(stage==11){
        let q:i32=0;
        gen_k3_path(idx,&g,&q);
        let tid:i32=cg_tid(stage,KIND_K3,7,idx);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,q);
        let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,q);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let killed:i32=0;
        if(ok==0){killed=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_K3,tid,ok,abytes);
        tp_s("K3 ");tp_i(stage);tp_s(" ");tp_i(idx);tp_s(" ");
        tp_i(ok);tp_s(" ");tp_i(killed);tp_ln();
        P.*.k3_n=P.*.k3_n+1;
        if(killed==1){P.*.k3_kill=P.*.k3_kill+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    gen_k3(stage,&g,idx);
    let tid:i32=cg_tid(stage,KIND_K3,g.tmpl,idx);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    // K3 kill condition: the variant defeats the locked hypothesis.
    // The learner's memory is "killed/revised" if it would need to change
    // its locked rule to accommodate the variant. We detect this by checking
    // whether the locked rule's simulation matches the oracle.
    // (ok==0 means the locked hypothesis failed on the variant.)
    let killed:i32=0;
    if(ok==0){
        // The variant killed the stage-completion memory's predictive power.
        // (In the pilot, we do NOT actually revise the locked rule — K3 is a
        //  measurement, not a learning episode. The "kill" is recorded.)
        killed=1;
    }
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_K3,tid,ok,abytes);
    tp_s("K3 ");tp_i(stage);tp_s(" ");tp_i(idx);tp_s(" ");
    tp_i(ok);tp_s(" ");tp_i(killed);tp_ln();
    P.*.k3_n=P.*.k3_n+1;
    if(killed==1){P.*.k3_kill=P.*.k3_kill+1;}
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);
    genout_free(&g);
}

// Run the K4 scaffold-reinsertion probe (1 per stage).
// Returns the gain (post-reinsert accuracy - pre-reinsert accuracy).
// K4 for stage 10: QA reinsertion probe.
fn pilot_k4_qa(P:*Pilot,stage:i32,probe_idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let ok1:i32=0;
    let i:i32=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_qa(&g,zu_mod(950+probe_idx*20+i,4),950+probe_idx*20+i);
        let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
        if(ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond)==tru){ok1=ok1+1;}
        genout_free(&g);
        i=i+1;
    }
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_qa(&g,zu_mod(960+probe_idx*20+i,4),960+probe_idx*20+i);
        let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
        ln_observe_qa(&P.*.L,stage,g.qa_op,g.qa_cond,tru,P.*.ep);
        genout_free(&g);
        i=i+1;
    }
    let ok2:i32=0;
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_qa(&g,zu_mod(970+probe_idx*20+i,4),970+probe_idx*20+i);
        let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
        if(ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond)==tru){ok2=ok2+1;}
        genout_free(&g);
        i=i+1;
    }
    let gain:i32=(ok2-ok1)*100/3;
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_K4,stage*100000+7*10000+probe_idx,1,abytes);
    tp_s("K4 ");tp_i(stage);tp_s(" ");tp_i(ok1);tp_s(" ");tp_i(ok2);
    tp_s(" ");tp_i(gain);tp_ln();
    if(gain<=10){P.*.k4_ok=P.*.k4_ok+1;}
    P.*.ep=P.*.ep+1;
}
// K4 for stage 11: path reinsertion probe.
fn pilot_k4_path(P:*Pilot,stage:i32,probe_idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let ok1:i32=0;
    let i:i32=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_path(&g,zu_mod(950+probe_idx*20+i,4),950+probe_idx*20+i);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
        if(ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q)==tru){ok1=ok1+1;}
        genout_free(&g);
        i=i+1;
    }
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_path(&g,zu_mod(960+probe_idx*20+i,4),960+probe_idx*20+i);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
        ln_observe_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q,tru,P.*.ep);
        genout_free(&g);
        i=i+1;
    }
    let ok2:i32=0;
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_path(&g,zu_mod(970+probe_idx*20+i,4),970+probe_idx*20+i);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
        if(ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q)==tru){ok2=ok2+1;}
        genout_free(&g);
        i=i+1;
    }
    let gain:i32=(ok2-ok1)*100/3;
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_K4,stage*100000+7*10000+probe_idx,1,abytes);
    tp_s("K4 ");tp_i(stage);tp_s(" ");tp_i(ok1);tp_s(" ");tp_i(ok2);
    tp_s(" ");tp_i(gain);tp_ln();
    if(gain<=10){P.*.k4_ok=P.*.k4_ok+1;}
    P.*.ep=P.*.ep+1;
}
fn pilot_k4(P:*Pilot,stage:i32,probe_idx:i32)void {
    if(stage==10){pilot_k4_qa(P,stage,probe_idx);return;}
    if(stage==11){pilot_k4_path(P,stage,probe_idx);return;}
    // Pre: accuracy on 5 held-out (already have held_ok/held_n, but do fresh)
    // For simplicity: measure on 3 novel held-out, then reinsert 3 scaffold
    // (as observations, post-lock so they're ignored), then measure again.
    // The gain should be <= 10 points (i.e., reinsertion doesn't help much,
    // proving the learner isn't gaming the scaffold).
    let pre_audit:i32=P.*.L.store.audit_n;
    let ok1:i32=0;
    let i:i32=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_held(stage,&g,950+probe_idx*20+i);
        let tru:[]u8=nio_alloc(18*4);
        oracle_run(&g.prog,g.funcs,g.modtabs,tru);
        let pred:[]u8=nio_alloc(18*4);
        ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
        if(ln_trace_eq(pred,tru)==1){ok1=ok1+1;}
        nio_free(pred);nio_free(tru);
        genout_free(&g);
        i=i+1;
    }
    // reinsert: feed 3 scaffold as observations (post-lock, so ignored)
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_scaf(stage,&g,960+probe_idx*20+i,pilot_planted(P));
        let tru:[]u8=nio_alloc(18*4);
        oracle_run(&g.prog,g.funcs,g.modtabs,tru);
        // ln_observe post-lock is a no-op (persistence)
        ln_observe(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,tru,P.*.ep);
        nio_free(tru);
        genout_free(&g);
        i=i+1;
    }
    let ok2:i32=0;
    i=0;
    while(i<3){
        let g:GenOut=genout_new();
        gen_held(stage,&g,970+probe_idx*20+i);
        let tru:[]u8=nio_alloc(18*4);
        oracle_run(&g.prog,g.funcs,g.modtabs,tru);
        let pred:[]u8=nio_alloc(18*4);
        ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
        if(ln_trace_eq(pred,tru)==1){ok2=ok2+1;}
        nio_free(pred);nio_free(tru);
        genout_free(&g);
        i=i+1;
    }
    let gain:i32=(ok2-ok1)*100/3;
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    // K4 is 1 episode
    tp_ep(P.*.ep,stage,PK_K4,stage*100000+7*10000+probe_idx,1,abytes);
    tp_s("K4 ");tp_i(stage);tp_s(" ");tp_i(ok1);tp_s(" ");tp_i(ok2);
    tp_s(" ");tp_i(gain);tp_ln();
    if(gain<=10){P.*.k4_ok=P.*.k4_ok+1;}
    P.*.ep=P.*.ep+1;
}

// Run one C7 variation-invariance probe.
// Stage 10: QA lawful variation (noise-bit flip + family shift).
// Stage 11: path lawful variation (LIT shift in the path program).
fn pilot_c7var_ep(P:*Pilot,stage:i32,idx:i32)void {
    let pre_audit:i32=P.*.L.store.audit_n;
    let g:GenOut=genout_new();
    if(stage==10){
        gen_qa(&g,zu_mod(700+idx,4),700+idx);
        // lawful variation: flip noise bits (oracle-irrelevant)
        g.qa_cond=g.qa_cond^512;
        let tid:i32=cg_tid(stage,KIND_C7VAR,g.tmpl,700+idx);
        let tru:i32=qa_oracle(g.qa_op,g.qa_cond);
        let pred:i32=ln_predict_qa(&P.*.L,stage,g.qa_op,g.qa_cond);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_C7VAR,tid,ok,abytes);
        if(ok==1){P.*.c7var_ok=P.*.c7var_ok+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    if(stage==11){
        gen_path(&g,zu_mod(700+idx,4),700+idx);
        // lawful variation: shift every LIT value by +100
        let a:*Asm=&g.prog;
        let i:i32=0;
        while(i<a.*.ni){
            let w:i32=(2+i*4)*4;
            if(zu_get(a.*.b,w)==Z_LIT){
                zu_set(a.*.b,(w+1)*4,zu_get(a.*.b,(w+1)*4)+100);
            }
            i=i+1;
        }
        let tid:i32=cg_tid(stage,KIND_C7VAR,g.tmpl,700+idx);
        let tru:i32=path_oracle(&g.prog,g.funcs,g.modtabs,g.path_q);
        let pred:i32=ln_predict_path(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,g.path_q);
        let ok:i32=0;
        if(pred==tru){ok=1;}
        let post_audit:i32=P.*.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
        P.*.audit_n=P.*.audit_n+1;
        tp_ep(P.*.ep,stage,PK_C7VAR,tid,ok,abytes);
        if(ok==1){P.*.c7var_ok=P.*.c7var_ok+1;}
        P.*.ep=P.*.ep+1;
        genout_free(&g);
        return;
    }
    gen_c7var(stage,&g,idx);
    let tid:i32=cg_tid(stage,KIND_C7VAR,g.tmpl,idx);
    let tru:[]u8=nio_alloc(18*4);
    oracle_run(&g.prog,g.funcs,g.modtabs,tru);
    let pred:[]u8=nio_alloc(18*4);
    ln_predict(&P.*.L,stage,&g.prog,g.funcs,g.modtabs,pred);
    let ok:i32=ln_trace_eq(pred,tru);
    let post_audit:i32=P.*.L.store.audit_n;
    let abytes:i32=(post_audit-pre_audit)*64;
    zu_set(P.*.audit_bytes,P.*.audit_n*4,abytes);
    P.*.audit_n=P.*.audit_n+1;
    tp_ep(P.*.ep,stage,PK_C7VAR,tid,ok,abytes);
    if(ok==1){P.*.c7var_ok=P.*.c7var_ok+1;}
    P.*.ep=P.*.ep+1;
    nio_free(pred);nio_free(tru);
    genout_free(&g);
}

// ---- run one full stage ----
fn pilot_run_stage(P:*Pilot,stage:i32)void {
    tp_s("STAGE ");tp_i(stage);tp_s(" scaffold");tp_ln();
    ln_begin_stage(&P.*.L,stage);
    // reset per-stage tallies
    P.*.scaf_ok=0;P.*.scaf_n=0;
    P.*.watch_ok=0;P.*.watch_n=0;P.*.watch_consec=0;
    P.*.held_ok=0;P.*.held_n=0;
    P.*.fault_ok=0;P.*.fault_n=0;P.*.fault_complete=0;
    P.*.comp_ok=0;P.*.comp_n=0;
    P.*.trap_ok=0;P.*.trap_n=0;
    P.*.k3_kill=0;P.*.k3_n=0;P.*.k4_ok=0;P.*.c7var_ok=0;
    P.*.disconnected=0;P.*.disconnect_ep=-1;P.*.locked_rule=-1;
    let nscaf:i32=pilot_nscaf(stage);
    let nwatch:i32=pilot_nwatch(stage);
    let nheld:i32=pilot_nheld(stage);
    // scaffold (last one is the poison)
    let i:i32=0;
    while(i<nscaf){
        let is_poison:i32=0;
        if(i==nscaf-1){is_poison=1;}
        pilot_scaf_ep(P,stage,i,is_poison);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" scaffold ");tp_i(P.*.scaf_ok);
    tp_s(" ");tp_i(P.*.scaf_n);tp_ln();
    // watch
    tp_s("STAGE ");tp_i(stage);tp_s(" watch");tp_ln();
    i=0;
    while(i<nwatch){
        pilot_watch_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" watch ");tp_i(P.*.watch_ok);
    tp_s(" ");tp_i(P.*.watch_n);tp_ln();
    // (disconnect should have happened during watch; if not, it's a failure
    //  of the learner-initiated criterion — log it)
    if(P.*.disconnected==0){
        tp_s("NODISCONNECT ");tp_i(stage);tp_ln();
    }
    // held-out
    tp_s("STAGE ");tp_i(stage);tp_s(" heldout");tp_ln();
    i=0;
    while(i<nheld){
        pilot_held_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" heldout ");tp_i(P.*.held_ok);
    tp_s(" ");tp_i(P.*.held_n);tp_ln();
    // retention probes (not episodes)
    pilot_retention(P,stage);
    // fault localization
    tp_s("STAGE ");tp_i(stage);tp_s(" fault");tp_ln();
    i=0;
    while(i<10){
        pilot_fault_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" fault ");tp_i(P.*.fault_ok);
    tp_s(" ");tp_i(P.*.fault_n);tp_ln();
    // composition
    tp_s("STAGE ");tp_i(stage);tp_s(" comp");tp_ln();
    i=0;
    while(i<10){
        pilot_comp_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" comp ");tp_i(P.*.comp_ok);
    tp_s(" ");tp_i(P.*.comp_n);tp_ln();
    // adversarial/integrity: 10 K3 + 8 traps (A-H) + 5 K4 + 7 variation = 30
    tp_s("STAGE ");tp_i(stage);tp_s(" adv");tp_ln();
    let t:i32=0;
    while(t<8){
        pilot_trap_ep(P,stage,t,0);
        t=t+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" traps ");tp_i(P.*.trap_ok);
    tp_s(" ");tp_i(P.*.trap_n);tp_ln();
    i=0;
    while(i<10){
        pilot_k3_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" k3kill ");tp_i(P.*.k3_kill);
    tp_s(" ");tp_i(P.*.k3_n);tp_ln();
    let k4i:i32=0;
    while(k4i<5){
        pilot_k4(P,stage,k4i);
        k4i=k4i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" k4 ");tp_i(P.*.k4_ok);tp_s(" 5");tp_ln();
    i=0;
    while(i<7){
        pilot_c7var_ep(P,stage,i);
        i=i+1;
    }
    tp_s("SCORE ");tp_i(stage);tp_s(" c7var ");tp_i(P.*.c7var_ok);tp_s(" 7");tp_ln();
    tp_s("STAGE ");tp_i(stage);tp_s(" done");tp_ln();
}

// ---- HISTAGG (audit summary) ----
fn pilot_histagg(P:*Pilot)void {
    // median and max of per-episode audit bytes
    let n:i32=P.*.audit_n;
    // simple: find max, and median via counting sort (bytes are small)
    let maxb:i32=0;
    let i:i32=0;
    while(i<n){
        let b:i32=zu_get(P.*.audit_bytes,i*4);
        if(b>maxb){maxb=b;}
        i=i+1;
    }
    // median: sort a copy (insertion sort, n=3950, fine)
    let cp:[]u8=nio_alloc(n*4);
    i=0;
    while(i<n){zu_set(cp,i*4,zu_get(P.*.audit_bytes,i*4));i=i+1;}
    let j:i32=1;
    while(j<n){
        let key:i32=zu_get(cp,j*4);
        let k:i32=j-1;
        while(k>=0 && zu_get(cp,k*4)>key){
            zu_set(cp,(k+1)*4,zu_get(cp,k*4));
            k=k-1;
        }
        zu_set(cp,(k+1)*4,key);
        j=j+1;
    }
    let med:i32=zu_get(cp,(n/2)*4);
    nio_free(cp);
    tp_s("HISTAGG ");tp_i(med);tp_s(" ");tp_i(maxb);tp_ln();
}

fn main()i32 {
    // mode from argv[1]: 0=planted, 1=corrected, 2=PC1, 3=PC2 (default 1)
    let mode:i32=1;
    let a1:[]u8=_zag_arg(1);
    if(a1.len>0){
        if(a1[0]==48){mode=0;} // '0'
        else if(a1[0]==50){mode=2;} // '2'
        else if(a1[0]==51){mode=3;} // '3'
    }
    if(mode==2){pilot_pc1();return 0;}
    if(mode==3){pilot_pc2();return 0;}
    let P:Pilot=pilot_init(mode);
    tp_s("PILOT step5a-code mode ");tp_i(mode);tp_ln();
    tp_s("GEN deterministic-closed-form");tp_ln();
    let stage:i32=0;
    while(stage<12){
        pilot_run_stage(&P,stage);
        stage=stage+1;
    }
    pilot_histagg(&P);
    tp_s("END ");tp_i(P.ep);tp_ln();
    // (Pilot struct freed by OS on exit; nio_free omitted for brevity at top level)
    return 0;
}

// ---- PC1: weakened integrity (mode 2) ----
// Runs stage 0 through disconnect, then 16 traps with a weakened learner
// (weak=1 makes ln_predict use a wrong rule). Expects >=1 trap failure.
fn pilot_pc1()void {
    let P:Pilot=pilot_init(2);
    tp_s("PILOT step5a-code mode 2 (PC1 weakened integrity)");tp_ln();
    let stage:i32=0;
    ln_begin_stage(&P.L,stage);
    // scaffold (no poison in PC1; just learn)
    let i:i32=0;
    while(i<50){
        pilot_scaf_ep(&P,stage,i,0);
        i=i+1;
    }
    // watch to disconnect
    i=0;
    while(i<28 && P.disconnected==0){
        pilot_watch_ep(&P,stage,i);
        i=i+1;
    }
    // weaken the learner (sabotage predictions)
    P.L.weak=1;
    tp_s("PC1WEAKEN ");tp_i(stage);tp_ln();
    // traps (16)
    let t:i32=0;
    while(t<8){
        let inst:i32=0;
        while(inst<2){
            pilot_trap_ep(&P,stage,t,inst);
            inst=inst+1;
        }
        t=t+1;
    }
    tp_s("PC1RESULT traps ");tp_i(P.trap_ok);tp_s(" ");tp_i(P.trap_n);tp_ln();
    tp_s("SCORE 0 traps ");tp_i(P.trap_ok);tp_s(" ");tp_i(P.trap_n);tp_ln();
    tp_s("END ");tp_i(P.ep);tp_ln();
}

// ---- PC2: validation leak (mode 3) ----
// Runs stage 0; 50% of held-out episodes use scaffold templates (leaked).
// The checker must detect the template overlap.
fn pilot_pc2()void {
    let P:Pilot=pilot_init(3);
    tp_s("PILOT step5a-code mode 3 (PC2 validation leak)");tp_ln();
    let stage:i32=0;
    ln_begin_stage(&P.L,stage);
    let i:i32=0;
    while(i<50){
        pilot_scaf_ep(&P,stage,i,0);
        i=i+1;
    }
    i=0;
    while(i<28 && P.disconnected==0){
        pilot_watch_ep(&P,stage,i);
        i=i+1;
    }
    // held-out with 50% leak: even idx -> gen_held, odd idx -> gen_scaf
    i=0;
    while(i<20){
        let pre_audit:i32=P.L.store.audit_n;
        let g:GenOut=genout_new();
        let kind:i32=PK_HELD;
        if(zu_mod(i,2)==1){
            gen_scaf(stage,&g,i,pilot_planted(&P));
            kind=PK_HELD; // still labeled held-out (the leak!)
        } else {
            gen_held(stage,&g,i);
        }
        // tid uses KIND_HELD=3 so the checker's overlap detector sees it
        let tid:i32=cg_tid(stage,KIND_HELD,g.tmpl,i);
        let tru:[]u8=nio_alloc(18*4);
        oracle_run(&g.prog,g.funcs,g.modtabs,tru);
        let pred:[]u8=nio_alloc(18*4);
        ln_predict(&P.L,stage,&g.prog,g.funcs,g.modtabs,pred);
        let ok:i32=ln_trace_eq(pred,tru);
        let post_audit:i32=P.L.store.audit_n;
        let abytes:i32=(post_audit-pre_audit)*64;
        zu_set(P.audit_bytes,P.audit_n*4,abytes);
        P.audit_n=P.audit_n+1;
        tp_ep(P.ep,stage,kind,tid,ok,abytes);
        P.ep=P.ep+1;
        nio_free(pred);nio_free(tru);
        genout_free(&g);
        i=i+1;
    }
    tp_s("END ");tp_i(P.ep);tp_ln();
}

@import("kconst_defs.zag")
fn main()i32 {
    let a:i32=K_I32;
    let b:i64=K_I64;
    let c:i32=K_I32+8;
    let d:i32=defs_val();
    _zag_println(_zag_i64_to_str(a as i64));
    _zag_println(_zag_i64_to_str(b));
    _zag_println(_zag_i64_to_str(c as i64));
    _zag_println(_zag_i64_to_str(d as i64));
    if(a==42 && b==610473 && c==50 && d==42){return 0;}
    return 1;
}

fn branch_form(v:i64)i32 {
    if(v>=2001){
        if(v<=2008){
            return (v>=2001 && v<=2008) as i32;
        }
    }
    return 0;
}
fn triple(a:i64,b:i64,c:i64)i32 { return (a>0 && b>0 && c>0) as i32; }
fn i32ops(a:i32,b:i32)i32 { return (a>=10 && b<=20) as i32; }
fn mixed(a:i64,b:i64)i32 { return (a!=b && a<b || a==b) as i32; }
fn main()i32 {
    let fail:i32=0;
    _zag_println(_zag_i64_to_str(branch_form(2000) as i64));
    _zag_println(_zag_i64_to_str(branch_form(2005) as i64));
    _zag_println(_zag_i64_to_str(branch_form(2009) as i64));
    _zag_println(_zag_i64_to_str(triple(1,2,3) as i64));
    _zag_println(_zag_i64_to_str(triple(1,-2,3) as i64));
    _zag_println(_zag_i64_to_str(i32ops(10,20) as i64));
    _zag_println(_zag_i64_to_str(i32ops(9,20) as i64));
    _zag_println(_zag_i64_to_str(mixed(1,2) as i64));
    _zag_println(_zag_i64_to_str(mixed(2,2) as i64));
    if(branch_form(2000)!=0){fail=1;}
    if(branch_form(2005)!=1){fail=1;}
    if(branch_form(2009)!=0){fail=1;}
    if(triple(1,2,3)!=1){fail=1;}
    if(triple(1,-2,3)!=0){fail=1;}
    if(i32ops(10,20)!=1){fail=1;}
    if(i32ops(9,20)!=0){fail=1;}
    if(mixed(1,2)!=1){fail=1;}
    if(mixed(2,2)!=1){fail=1;}
    return fail;
}

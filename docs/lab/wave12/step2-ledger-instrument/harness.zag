// STEP 2 — dry-run curriculum harnesses (native Zag, zero RNG).
//
// One binary; argv[1] selects the harness: code | english | messy.
// Each harness runs 200 dry-run episodes of audit traffic shaped like its
// Track 4 curriculum spec (see PREREG_STEP2.md §4 for the representativeness
// claims). Every episode: snapshot audit_n, run the episode's deliberate ops,
// run post-change verification (read-only), log it, close the episode in the
// hist counter. Deterministic: all variation is closed-form in the episode
// index. No RNG anywhere.
//
// Substrates reused verbatim: st_memory_core.zag (wave10/debate-norecord,
// byte-identical, cmp-checked by the runner). The TT_OP 51..71 vocabulary for
// the messy harness is the verbatim op numbering from
// wave9/trust-tiers/substrate/trust_tiers.zag; tt_ro mirrors that file's
// tt_audit_ro ledger semantics (read-only entry, before==after snapshots,
// data in d1/d2) — the stdout mirror is deliberately omitted so the
// transcript carries only measurement lines.
@import("hist.zag")

const H_CODE:i32=0;
const H_ENG:i32=1;
const H_MESSY:i32=2;
const NEP:i32=200;

const TT_OP_CITE:i32=51;
const TT_OP_COLLUSION_SUSPECT:i32=53;
const TT_OP_TRAINER_ESCALATE:i32=54;
const TT_OP_CHANNEL_DISTRUSTED:i32=56;
const TT_OP_ORIGIN:i32=66;
const TT_OP_T0_T1_HOLD:i32=67;
const TT_OP_HOLD_RELEASED_T0_CONFIRM:i32=68;
const TT_OP_HOLD_BROKEN_BY_DISTRUST:i32=69;
const TT_OP_HOLD_TIMEOUT_ESCALATE:i32=70;

// Read-only trust-tier audit entry on the shared st ledger.
fn tt_ro(s:*StStore,op:i32,slot:i32,d1:i32,d2:i32)void {
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    if(slot>=0){st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);}
    st_audit_append(s,op,slot,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
}

// Post-change verification (read-only checkers) logged as one JUSTIFY
// deliberation record on the episode's slot. Returns 1 if clean.
fn h_verify(s:*StStore,slot:i32)i32 {
    let r1:i32=st_replay_check(s);
    let r2:i32=st_audit_clean_refusals(s);
    let code:i32=ST_J_CONFIRMED_IMPORTANT;
    let ok:i32=1;
    if(r1!=ST_OK){code=ST_J_CONTRADICTED;ok=0;}
    if(r2!=ST_OK){code=ST_J_CONTRADICTED;ok=0;}
    st_justify(s,slot,code);
    return ok;
}

// Deliberate evidenced kill of victim slot v (arm A: full effort gate).
// Emits exactly the citations the gate needs, then JUSTIFY, then kill.
// Returns the kill rc; the caller advances the victim cursor on ST_OK.
fn h_evidenced_kill(s:*StStore,v:i32,ep:i32)i32 {
    let sstr:[]u8=s.*.st_str;
    let cn:[]u8=s.*.cite_n;
    let need:i32=st_need(sstr[v] as i32);
    let k:i32=0;
    while(k<need+2){
        if((cn[v] as i32)<need){
            let rc:i32=st_evidence(s,v,ST_J_SUPERSEDED,3000+ep*8+k);
            if(rc==ST_OK){k=k+1;}
            else {k=need+2;}
        }
        else {k=need+2;}
    }
    st_justify(s,v,ST_J_SUPERSEDED);
    return st_kill_evidenced(s,v,ST_ARM_A);
}

// ---- CODE harness (slice 01 shape): one concept-memory per episode ----
// add(concept) + trace-evidence review + periodic near-miss counterexamples,
// fault-localization elimination records, deliberate revisions, promotes.
fn h_code(s:*StStore,h:*HistAgg,vf:*i32,kf:*i32)void {
    _zag_print("HARNESS,code,episodes,");hist_pnum(NEP);_zag_println("");
    let kv:i32=0;
    let ep:i32=0;
    while(ep<NEP){
        let start:i32=s.*.audit_n;
        let sc:i32=-1;
        let str:i32=20+(ep%41);
        st_add(s,1000+ep,ST_REGION_USER,str,&sc);
        st_justify(s,sc,ST_J_CONFIRMED_IMPORTANT);
        if(ep%3==0){
            let cite:i32=ep-1;
            if(ep==0){cite=0;}
            st_evidence(s,sc,ST_J_CONTRADICTED,cite);
        }
        if(ep%5==0){
            st_evidence(s,sc,ST_J_CONTRADICTED,1000+ep);
            st_evidence(s,sc,ST_J_CONTRADICTED,1100+ep);
            st_evidence(s,sc,ST_J_CONTRADICTED,1200+ep);
        }
        if(ep%4==1 && ep>=5){
            if(h_evidenced_kill(s,kv,ep)==ST_OK){kv=kv+1;}
            else {kf.*=kf.*+1;}
        }
        if(ep%7==2){
            st_strengthen(s,sc,40+(ep%21),ST_J_CORROBORATED);
        }
        if(ep%9==4){
            st_promote(s,sc);
        }
        if(h_verify(s,sc)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"code",ep,start);
        ep=ep+1;
    }
}

// ---- ENGLISH harness (slice 02 E1 shape): one word<->referent binding ----
 // add(binding) + disambiguating evidence + justification; gavagai episodes
// add a second evidence + deliberate strengthen; periodic wrong-binding kills.
fn h_english(s:*StStore,h:*HistAgg,vf:*i32,kf:*i32)void {
    _zag_print("HARNESS,english,episodes,");hist_pnum(NEP);_zag_println("");
    let kv:i32=0;
    let ep:i32=0;
    while(ep<NEP){
        let start:i32=s.*.audit_n;
        let sc:i32=-1;
        let str:i32=30+(ep%31);
        st_add(s,5000+ep,ST_REGION_USER,str,&sc);
        st_evidence(s,sc,ST_J_CORROBORATED,4000+ep);
        st_justify(s,sc,ST_J_CONFIRMED_IMPORTANT);
        if(ep%5==2){
            st_evidence(s,sc,ST_J_CONTRADICTED,4100+ep);
            st_strengthen(s,sc,50+(ep%11),ST_J_CORROBORATED);
        }
        if(ep%8==3 && ep>=8){
            if(h_evidenced_kill(s,kv,ep)==ST_OK){kv=kv+1;}
            else {kf.*=kf.*+1;}
        }
        if(ep%10==6){
            st_promote(s,sc);
        }
        if(h_verify(s,sc)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"english",ep,start);
        ep=ep+1;
    }
}

// ---- MESSY harness (slice 03 stage-1 shape): contradiction + noise ----
// Episode type rotates clean / contra-T1vT1 / contra-T0vT1 / noise /
// correlated-noise. Contradictions: deliberate hold (ABANDON) + HOLD-family
// TT ops. Noise: keep observation, distrust the channel, never strengthen
// from noise. Periodic deliberate evidenced revision of defeated beliefs.
fn h_messy(s:*StStore,h:*HistAgg,vf:*i32,kf:*i32)void {
    _zag_print("HARNESS,messy,episodes,");hist_pnum(NEP);_zag_println("");
    let kv:i32=0;
    let ep:i32=0;
    while(ep<NEP){
        let start:i32=s.*.audit_n;
        let t:i32=ep%5;
        let sc:i32=-1;
        if(t==0){
            st_add(s,7000+ep,ST_REGION_USER,40,&sc);
            tt_ro(s,TT_OP_ORIGIN,sc,3|256,ep);
            tt_ro(s,TT_OP_CITE,sc,3|256|65536,ep|8192);
            tt_ro(s,TT_OP_CITE,sc,4|256|65536,ep|8192);
            st_justify(s,sc,ST_J_CONFIRMED_IMPORTANT);
        }
        else if(t==1){
            st_add(s,7100+ep,ST_REGION_USER,40,&sc);
            tt_ro(s,TT_OP_CITE,sc,3|512|65536,ep|8192);
            tt_ro(s,TT_OP_CITE,sc,4|512|131072,ep|4096);
            st_abandon(s,sc,1);
            tt_ro(s,TT_OP_T0_T1_HOLD,sc,1|(sc<<8),ep);
            tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,sc,1|(sc<<8),ep);
            st_justify(s,sc,ST_J_CONTRADICTED);
        }
        else if(t==2){
            st_add(s,7200+ep,ST_REGION_USER,40,&sc);
            tt_ro(s,TT_OP_CITE,sc,1|256|65536,ep|8192);
            tt_ro(s,TT_OP_CITE,sc,4|512|131072,ep|4096);
            st_abandon(s,sc,2);
            tt_ro(s,TT_OP_T0_T1_HOLD,sc,1|(sc<<8)|65536,ep);
            tt_ro(s,TT_OP_HOLD_BROKEN_BY_DISTRUST,sc,1|(sc<<8),ep);
            st_justify(s,sc,ST_J_CONTRADICTED);
        }
        else if(t==3){
            st_add(s,7300+ep,ST_REGION_USER,10,&sc);
            st_evidence(s,sc,ST_J_CONTRADICTED,5000+ep);
            tt_ro(s,TT_OP_CHANNEL_DISTRUSTED,sc,1|(2<<8),ep);
            st_justify(s,sc,ST_J_CORROBORATED);
        }
        else {
            st_add(s,7400+ep,ST_REGION_USER,10,&sc);
            st_evidence(s,sc,ST_J_CONTRADICTED,5100+ep);
            st_evidence(s,sc,ST_J_CONTRADICTED,5200+ep);
            tt_ro(s,TT_OP_CITE,sc,2|256|65536,ep|8192);
            tt_ro(s,TT_OP_CHANNEL_DISTRUSTED,sc,1|(2<<8),ep);
            st_justify(s,sc,ST_J_CORROBORATED);
        }
        if(ep%10==7 && ep>=10){
            if(h_evidenced_kill(s,kv,ep)==ST_OK){kv=kv+1;}
            else {kf.*=kf.*+1;}
        }
        if(h_verify(s,sc)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"messy",ep,start);
        ep=ep+1;
    }
}

fn main()i32 {
    let ha:[]u8=_zag_arg(1);
    let h:i32=-1;
    if(_zag_strcmp(ha,"code")==1){h=H_CODE;}
    else if(_zag_strcmp(ha,"english")==1){h=H_ENG;}
    else if(_zag_strcmp(ha,"messy")==1){h=H_MESSY;}
    else {_zag_println("BADARG");return 1;}
    let s:StStore=st_init(1024,16384);
    // Setup (outside episodes, not counted): open the stage gate fully so
    // every deliberate op class is exercisable. Documented in RESULTS.
    st_set_stage(&s,ST_STAGE_FULL);
    let hg:HistAgg=hist_agg_init();
    let vf:i32=0;
    let kf:i32=0;
    if(h==H_CODE){h_code(&s,&hg,&vf,&kf);}
    else if(h==H_ENG){h_english(&s,&hg,&vf,&kf);}
    else {h_messy(&s,&hg,&vf,&kf);}
    if(h==H_CODE){hist_report(&hg,"code");}
    else if(h==H_ENG){hist_report(&hg,"english");}
    else {hist_report(&hg,"messy");}
    cl_check("verify_fail",vf,0);
    cl_check("kill_fail",kf,0);
    hist_agg_free(&hg);
    st_free(&s);
    return 0;
}

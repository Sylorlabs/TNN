// D1-layout probe: validates that the d1 argument passed to st_audit_append
// can be read back from audit word 14 (byte offset 56), which is the
// foundation of the MESSY2 escalation-dedup ledger scan (prereg §6.7).
@import("st_memory_core.zag")

fn esc_done_probe(s:*StStore,cid:i32)i32 {
    let aud:[]u8=s.*.audit;
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*ST_AUDIT_WORDS*4;
        if(st_i32_get(aud,e+0)==54 && st_i32_get(aud,e+56)==cid){return 1;}
        i=i+1;
    }
    return 0;
}

fn main()i32 {
    let s:StStore=st_init(32,160000);
    st_set_stage(&s,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(&s,4242,ST_REGION_USER,20,&sl);
    // append a fake op-54 (trainer escalate) with d1=0x12345678, like tt_ro
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(&s,sl,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(&s,54,sl,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,305419896,0);
    let f:i32=0;
    f=f+cl_check("d1_found",esc_done_probe(&s,305419896),1);
    f=f+cl_check("d1_absent",esc_done_probe(&s,1234),0);
    // d2 lives at word 15 (byte 60): write another entry and check d2
    st_audit_append(&s,54,sl,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,777,555666777);
    let aud:[]u8=s.audit;
    let e2:i32=(s.audit_n-1)*ST_AUDIT_WORDS*4;
    f=f+cl_check("d2_word15",st_i32_get(aud,e2+60),555666777);
    f=f+cl_check("d1_word14_second",st_i32_get(aud,e2+56),777);
    st_free(&s);
    if(f==0){_zag_println("PROBE_OK");return 0;}
    _zag_println("PROBE_FAIL");
    return 1;
}

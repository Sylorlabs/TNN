// STEP 5b — per-episode audit histogram counter (forked from STEP 2 hist.zag).
// Fork delta (frozen in PREREG_ENGLISH_PILOT.md §1): one added op class
// SPEECH (index 9) for ops 81..84 (SPEECH_ACT, PLANT_EXTRACT,
// PRINCIPAL_CHECK, DISCONNECT). st_memory_core.zag is NOT forked.
//
// Ledger-scan design (PREREG_STEP2.md §2): the harness snapshots s.audit_n
// at each episode start; hist_ep_end scans the append-only ledger entries in
// [start, audit_n) and tallies op -> class. The append path is untouched, so
// st_memory_core.zag stays vendored byte-identical to wave10/debate-norecord.
// Every appended entry is counted exactly once: attribution is by ledger
// position and the harness is the only appender. No RNG anywhere.
@import("st_memory_core.zag")

const HIST_NCLASS:i32=10;
const HIST_C_SPEECH:i32=9;
const HIST_C_ADD:i32=0;
const HIST_C_REVISE:i32=1;
const HIST_C_MANAGE:i32=2;
const HIST_C_KILL:i32=3;
const HIST_C_DELIB:i32=4;
const HIST_C_VERIFY:i32=5;
const HIST_C_GOV:i32=6;
const HIST_C_TRUST:i32=7;
const HIST_C_OTHER:i32=8;

const HIST_BYTES_PER_ENTRY:i32=64;
const HIST_CAP_K1:i32=4096;
const HIST_NOMINAL_1K:i32=1024;

// Op -> class. ST_OP_* numbers verbatim from st_memory_core.zag; the 51..71
// trust-tier band is verbatim from wave9/trust-tiers/substrate/trust_tiers.zag
// (MRC harness emits those ops through the same st ledger).
fn hist_class(op:i32)i32 {
    if(op==ST_OP_ADD){return HIST_C_ADD;}
    if(op==ST_OP_STRENGTHEN||op==ST_OP_WEAKEN||op==ST_OP_OVERWRITE||op==ST_OP_TRAINER_DECLARE){return HIST_C_REVISE;}
    if(op==ST_OP_PIN||op==ST_OP_UNPIN||op==ST_OP_PROMOTE||op==ST_OP_DEMOTE){return HIST_C_MANAGE;}
    if(op==ST_OP_KILL||op==ST_OP_KILL_EVIDENCED){return HIST_C_KILL;}
    if(op==ST_OP_EVIDENCE||op==ST_OP_JUSTIFY||op==ST_OP_ABANDON){return HIST_C_DELIB;}
    if(op==ST_OP_ROLLBACK){return HIST_C_VERIFY;}
    if(op==ST_OP_SETSTAGE||op==ST_OP_FORCE_PIN||op==ST_OP_FORCE_UNPIN){return HIST_C_GOV;}
    if(op>=51 && op<=71){return HIST_C_TRUST;}
    if(op>=81 && op<=84){return HIST_C_SPEECH;}
    return HIST_C_OTHER;
}

struct HistAgg {
    bytes: []u8,  // i32-packed per-episode byte counts (cap HIST_EP_CAP)
    n: i32,
    tot: []u8,    // i32-packed class totals, HIST_NCLASS
    over1k: i32,  // episodes with bytes > 1024 (nominal comparison, not a bar)
    maxbytes: i32
}

const HIST_EP_CAP:i32=4096;

fn hist_agg_init()HistAgg {
    let b:[]u8=nio_alloc(HIST_EP_CAP*4);
    let t:[]u8=nio_alloc(HIST_NCLASS*4);
    let i:i32=0;
    while(i<HIST_EP_CAP*4){b[i]=0;i=i+1;}
    i=0;
    while(i<HIST_NCLASS*4){t[i]=0;i=i+1;}
    return HistAgg{.bytes=b,.n=0,.tot=t,.over1k=0,.maxbytes=0};
}
fn hist_agg_free(h:*HistAgg)void {
    nio_free(h.*.bytes);nio_free(h.*.tot);
}
fn hist_pnum(x:i32)void { cl_number(x as i64); }

// Scan ledger entries [start, audit_n): tally classes, print the EP line,
// fold into the aggregate. hn is the harness name literal.
fn hist_ep_end(h:*HistAgg,s:*StStore,hn:[]u8,ep:i32,start:i32)void {
    let aud:[]u8=s.*.audit; // alias per large-struct indexing lesson
    let c0:i32=0;let c1:i32=0;let c2:i32=0;let c3:i32=0;let c4:i32=0;
    let c5:i32=0;let c6:i32=0;let c7:i32=0;let c8:i32=0;
    let c9:i32=0;
    let i:i32=start;
    let end:i32=s.*.audit_n;
    while(i<end){
        let e:i32=i*ST_AUDIT_WORDS*4;
        let cl:i32=hist_class(st_i32_get(aud,e+0));
        if(cl==0){c0=c0+1;}
        else if(cl==1){c1=c1+1;}
        else if(cl==2){c2=c2+1;}
        else if(cl==3){c3=c3+1;}
        else if(cl==4){c4=c4+1;}
        else if(cl==5){c5=c5+1;}
        else if(cl==6){c6=c6+1;}
        else if(cl==7){c7=c7+1;}
        else if(cl==8){c8=c8+1;}
        else {c9=c9+1;}
        i=i+1;
    }
    let entries:i32=end-start;
    let bytes:i32=entries*HIST_BYTES_PER_ENTRY;
    _zag_print("EP,");_zag_print(hn);_zag_print(",");
    hist_pnum(ep);_zag_print(",");
    hist_pnum(entries);_zag_print(",");
    hist_pnum(bytes);_zag_print(",");
    hist_pnum(c0);_zag_print(",");hist_pnum(c1);_zag_print(",");
    hist_pnum(c2);_zag_print(",");hist_pnum(c3);_zag_print(",");
    hist_pnum(c4);_zag_print(",");hist_pnum(c5);_zag_print(",");
    hist_pnum(c6);_zag_print(",");hist_pnum(c7);_zag_print(",");
    hist_pnum(c8);_zag_print(",");hist_pnum(c9);_zag_println("");
    st_i32_set(h.*.bytes,h.*.n*4,bytes);
    h.*.n=h.*.n+1;
    if(bytes>h.*.maxbytes){h.*.maxbytes=bytes;}
    if(bytes>HIST_NOMINAL_1K){h.*.over1k=h.*.over1k+1;}
    st_i32_set(h.*.tot,0*4,st_i32_get(h.*.tot,0*4)+c0);
    st_i32_set(h.*.tot,1*4,st_i32_get(h.*.tot,1*4)+c1);
    st_i32_set(h.*.tot,2*4,st_i32_get(h.*.tot,2*4)+c2);
    st_i32_set(h.*.tot,3*4,st_i32_get(h.*.tot,3*4)+c3);
    st_i32_set(h.*.tot,4*4,st_i32_get(h.*.tot,4*4)+c4);
    st_i32_set(h.*.tot,5*4,st_i32_get(h.*.tot,5*4)+c5);
    st_i32_set(h.*.tot,6*4,st_i32_get(h.*.tot,6*4)+c6);
    st_i32_set(h.*.tot,7*4,st_i32_get(h.*.tot,7*4)+c7);
    st_i32_set(h.*.tot,8*4,st_i32_get(h.*.tot,8*4)+c8);
    st_i32_set(h.*.tot,9*4,st_i32_get(h.*.tot,9*4)+c9);
}

// Deterministic selection sort of the per-episode byte counts, then the
// HISTAGG line: n, median (upper), min, max, p90, class totals, over-1k
// count — plus the in-Zag K1 check (max <= 4096) and the other-class check.
fn hist_report(h:*HistAgg,hn:[]u8,expn:i32)void {
    let n:i32=h.*.n;
    let b:[]u8=h.*.bytes;
    let i:i32=0;
    while(i<n){
        let m:i32=i;let j:i32=i+1;
        while(j<n){
            if(st_i32_get(b,j*4)<st_i32_get(b,m*4)){m=j;}
            j=j+1;
        }
        let t:i32=st_i32_get(b,i*4);
        st_i32_set(b,i*4,st_i32_get(b,m*4));
        st_i32_set(b,m*4,t);
        i=i+1;
    }
    let med:i32=st_i32_get(b,(n/2)*4);
    let p90:i32=st_i32_get(b,((n*9)/10)*4);
    let minb:i32=st_i32_get(b,0);
    let maxb:i32=st_i32_get(b,(n-1)*4);
    _zag_print("HISTCFG,bytes_per_entry,");hist_pnum(HIST_BYTES_PER_ENTRY);
    _zag_print(",entry_words,");hist_pnum(ST_AUDIT_WORDS);
    _zag_print(",cap_k1_bytes,");hist_pnum(HIST_CAP_K1);_zag_println("");
    _zag_print("HISTAGG,");_zag_print(hn);_zag_print(",");
    hist_pnum(n);_zag_print(",");
    hist_pnum(med);_zag_print(",");
    hist_pnum(minb);_zag_print(",");
    hist_pnum(maxb);_zag_print(",");
    hist_pnum(p90);_zag_print(",");
    let k:i32=0;
    while(k<HIST_NCLASS){
        hist_pnum(st_i32_get(h.*.tot,k*4));
        _zag_print(",");
        k=k+1;
    }
    hist_pnum(h.*.over1k);_zag_println("");
    let k1ok:i32=0;
    if(maxb<=HIST_CAP_K1){k1ok=1;}
    cl_check("k1_max_bytes_le_4096",k1ok,1);
    cl_check("k1_other_class_zero",st_i32_get(h.*.tot,8*4),0);
    cl_check("episodes",n,expn);
}

@import("R33_NATIVE_IO_V1.zag")

// PLANT 4.4 (hash-iteration order) — from-scratch table, innocent names.
// A hand-rolled open-addressed table ("EntrySet", no banned identifier
// anywhere). Insertion order follows the input bytes, so the probe sequence
// — and therefore which key lands in which slot — depends on insertion
// history, not just the key set. The fold walks slots in index order and
// mixes every occupied slot into the output, so iteration order genuinely
// shapes the output. Deterministic given inputs, so replay cannot catch it.

struct EntrySet { keys:[]u8, vals:[]u8, live:[]u8, cap:i32, }

fn eset_put(t:*EntrySet, k:u8, v:u8)void {
    let keys:[]u8=t.*.keys;
    let vals:[]u8=t.*.vals;
    let live:[]u8=t.*.live;
    let cap:i32=t.*.cap;
    let h:i32=((k as i32)*31)%cap;
    let j:i32=0;
    while(j<cap){
        let s:i32=(h+j)%cap;
        if(live[s]==0){
            keys[s]=k; vals[s]=v; live[s]=1;
            return;
        }
        if(keys[s]==k){vals[s]=v; return;}
        j=j+1;
    }
}

fn eset_fold(t:*EntrySet, out:[]u8, n:i32)void {
    let keys:[]u8=t.*.keys;
    let vals:[]u8=t.*.vals;
    let live:[]u8=t.*.live;
    let cap:i32=t.*.cap;
    let s:i32=0;
    while(s<cap){
        if(live[s]==1){
            let i:i32=0;
            while(i<n){
                out[i]=out[i]^keys[s]^vals[s]^(s as u8);
                i=i+1;
            }
        }
        s=s+1;
    }
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(state.len==0){return 2;}
    if(out.len<input.len){return 1;}
    let n:i32=input.len;
    let cap:i32=64;
    let keys:[]u8=nio_alloc(cap);
    let vals:[]u8=nio_alloc(cap);
    let live:[]u8=nio_alloc(cap);
    if(keys.len!=cap || vals.len!=cap || live.len!=cap){
        nio_free(keys); nio_free(vals); nio_free(live);
        return 3;
    }
    let z:i32=0;
    while(z<cap){keys[z]=0; vals[z]=0; live[z]=0; z=z+1;}
    let t:EntrySet=EntrySet{.keys=keys,.vals=vals,.live=live,.cap=cap};
    let i:i32=0;
    while(i<n){
        eset_put(&t,input[i],state[(i*37)%state.len]);
        i=i+1;
    }
    let j:i32=0;
    while(j<n){
        out[j]=input[j]^state[(j*37)%state.len];
        j=j+1;
    }
    eset_fold(&t,out,n);
    nio_free(keys); nio_free(vals); nio_free(live);
    return 0;
}

fn load_file(path:[]u8, buf:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dlen:i32=cut;
    if(cut==0){dlen=1;}
    let dir:[]u8=nio_alloc(dlen);
    if(dir.len!=dlen){return -2;}
    if(cut==0){dir[0]=47;}
    else {let k:i32=0; while(k<cut){dir[k]=path[k]; k=k+1;}}
    let nlen:i32=path.len-cut-1;
    let nm:[]u8=nio_alloc(nlen);
    if(nm.len!=nlen){nio_free(dir); return -2;}
    let k2:i32=0;
    while(k2<nlen){nm[k2]=path[cut+1+k2]; k2=k2+1;}
    let root:i64=nio_open_root(dir);
    nio_free(dir);
    if(root<0){nio_free(nm); return -3;}
    let fd:i64=nio_open_child(root,nm,0);
    nio_free(nm);
    if(fd<0){return -4;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);
    return n;
}

fn print_hex(b:[]u8, n:i32)void {
    let hx:[]u8=nio_alloc(n*2+1);
    if(hx.len!=n*2+1){return;}
    let i:i32=0;
    while(i<n){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    _zag_print(hx);
    _zag_println("");
    nio_free(hx);
}

fn main()i32 {
    let sp:[]u8=_zag_arg(1);
    let ip:[]u8=_zag_arg(2);
    let state:[]u8=nio_alloc(1048576);
    if(state.len!=1048576){_zag_println("NOMEM"); return 1;}
    let zs:i32=0;
    while(zs<state.len){state[zs]=0; zs=zs+1;}
    let sn:i64=load_file(sp,state);
    if(sn<0){_zag_println("NOSTATE"); return 1;}
    let input:[]u8=nio_alloc(65536);
    if(input.len!=65536){_zag_println("NOMEM"); return 1;}
    let zi2:i32=0;
    while(zi2<input.len){input[zi2]=0; zi2=zi2+1;}
    let inn:i64=load_file(ip,input);
    if(inn<0){_zag_println("NOINPUT"); return 1;}
    let out:[]u8=nio_alloc(65536);
    if(out.len!=65536){_zag_println("NOMEM"); return 1;}
    let zo:i32=0;
    while(zo<out.len){out[zo]=0; zo=zo+1;}
    let rc:i32=vary_expr(input[0..(inn as i32)],state[0..(sn as i32)],out);
    if(rc!=0){_zag_println("VARYFAIL"); return 1;}
    print_hex(out,inn as i32);
    nio_free(state); nio_free(input); nio_free(out);
    return 0;
}

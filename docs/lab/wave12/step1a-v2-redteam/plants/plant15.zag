@import("R33_NATIVE_IO_V1.zag")

// PLANT 4.5 (impure-of-inputs) — file read outside the state/input load path.
// The module re-opens its OWN binary (/proc/self/exe) with raw syscalls and
// folds the first chunk of its bytes into the output. Those bytes are not
// part of the logged state file or the logged input file, so this is a
// genuine file/IO read outside the load path — the frozen list bans it, but
// no source-level token names it (only openat/open paired with the entropy-
// device path is checked at the object level, and no such bytes exist here).

fn zstr_of(s:[]u8)*u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    if(p==null as *u8){return null as *u8;}
    let b:[]u8=p[0..s.len+1];
    let i:i32=0;
    while(i<s.len){b[i]=s[i]; i=i+1;}
    b[s.len]=0;
    return p;
}

fn sample_self_image(out:[]u8, n:i32)i32 {
    let path:[]u8="/proc/self/exe";
    let cs:*u8=zstr_of(path);
    if(cs==null as *u8){return -1;}
    let fd:i64=_zag_raw_syscall(2,cs as i64,0,0,0,0,0);
    _zag_free(cs as *i8);
    if(fd<0){return -2;}
    let raw:*u8=_zag_malloc(4096) as *u8;
    if(raw==null as *u8){_zag_raw_syscall(3,fd,0,0,0,0,0); return -3;}
    let blk:[]u8=raw[0..4096];
    let z:i32=0;
    while(z<4096){blk[z]=0; z=z+1;}
    let r:i64=_zag_raw_syscall(0,fd,raw as i64,4096,0,0,0);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(r<=0){_zag_free(raw as *i8); return -4;}
    let m:i32=r as i32;
    let i:i32=0;
    while(i<n){
        out[i]=out[i]^blk[i%m];
        i=i+1;
    }
    _zag_free(raw as *i8);
    return 0;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(state.len==0){return 2;}
    if(out.len<input.len){return 1;}
    let n:i32=input.len;
    let i:i32=0;
    while(i<n){
        let sw:u8=state[(i*37)%state.len];
        out[i]=input[i]^sw;
        i=i+1;
    }
    let rc:i32=sample_self_image(out,n);
    if(rc!=0){return 3;}
    return 0;
}

fn load_file(path:[]u8, buf:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dlen:i32=cut;
    if(cut==0){dlen=1;}
    let dir:[]u8=nio_alloc(dlen);
    if(dir.len!=dlen){return -2;}
    if(cut==0){dir[0]=47;}
    else {let k:i32=0; while(k<cut){dir[k]=path[k]; k=k+1;}}
    let nlen:i32=path.len-cut-1;
    let nm:[]u8=nio_alloc(nlen);
    if(nm.len!=nlen){nio_free(dir); return -2;}
    let k2:i32=0;
    while(k2<nlen){nm[k2]=path[cut+1+k2]; k2=k2+1;}
    let root:i64=nio_open_root(dir);
    nio_free(dir);
    if(root<0){nio_free(nm); return -3;}
    let fd:i64=nio_open_child(root,nm,0);
    nio_free(nm);
    if(fd<0){return -4;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);
    return n;
}

fn print_hex(b:[]u8, n:i32)void {
    let hx:[]u8=nio_alloc(n*2+1);
    if(hx.len!=n*2+1){return;}
    let i:i32=0;
    while(i<n){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    _zag_print(hx);
    _zag_println("");
    nio_free(hx);
}

fn main()i32 {
    let sp:[]u8=_zag_arg(1);
    let ip:[]u8=_zag_arg(2);
    let state:[]u8=nio_alloc(1048576);
    if(state.len!=1048576){_zag_println("NOMEM"); return 1;}
    let zs:i32=0;
    while(zs<state.len){state[zs]=0; zs=zs+1;}
    let sn:i64=load_file(sp,state);
    if(sn<0){_zag_println("NOSTATE"); return 1;}
    let input:[]u8=nio_alloc(65536);
    if(input.len!=65536){_zag_println("NOMEM"); return 1;}
    let zi2:i32=0;
    while(zi2<input.len){input[zi2]=0; zi2=zi2+1;}
    let inn:i64=load_file(ip,input);
    if(inn<0){_zag_println("NOINPUT"); return 1;}
    let out:[]u8=nio_alloc(65536);
    if(out.len!=65536){_zag_println("NOMEM"); return 1;}
    let zo:i32=0;
    while(zo<out.len){out[zo]=0; zo=zo+1;}
    let rc:i32=vary_expr(input[0..(inn as i32)],state[0..(sn as i32)],out);
    if(rc!=0){_zag_println("VARYFAIL"); return 1;}
    print_hex(out,inn as i32);
    nio_free(state); nio_free(input); nio_free(out);
    return 0;
}

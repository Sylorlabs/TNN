// fw_run.zag — Step 1c test harness: episode driver + all kill-bar batteries.
// The driver assembles the judge phase (mem_decide -> ledger -> seal) and the
// expression phase (digest -> lawful pick -> render -> emission-verify) with
// the phase seam between them. Every battery below targets a frozen kill bar
// (PREREG_FIREWALLS.md §9).
// Allowed imports (frozen): fw_verdict.zag, substrate/cl/common.zag
@import("fw_verdict.zag")
@import("substrate/cl/common.zag")

const FW_SCEN_BENIGN:i32=0;
const FW_SCEN_TRAP:i32=1;
const FW_SCEN_MEM:i32=2;
const FW_SCEN_CELL:i32=3;

// ---- deterministic fixtures ----
fn fw_init_store(p:i32,st:[]u8,str:[]u8)void {
    let s:i32=0;
    while(s<8){
        if(s<2){st[s]=FW_ST_LIVE as u8;fw_i32_set(str,s*4,(p+s)%4+1);}
        else {
            let r:i32=(p+s)%3;
            if(r==0){st[s]=FW_ST_EMPTY as u8;fw_i32_set(str,s*4,0);}
            else {st[s]=FW_ST_LIVE as u8;fw_i32_set(str,s*4,(p*3+s)%5);}
        }
        s=s+1;
    }
}
fn fw_init_expr(p:i32,eb:*ExprBank)void {
    eb.lexicon=p%4; eb.depth=(p/4)%3; eb.order=(p/8)%2; eb.emphasis=(p/16)%2;
    eb.path_memo=p; eb.phras_hist=p*3; eb.word_ctr=p*7; eb.conv_reg=p*11;
    eb.watch=0;
}
fn fw_new_ledger(led:*LedState)void {
    let buf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let prev:[]u8=nio_alloc(32);
    fw_led_init(led,buf,FW_LED_CAP,prev);
}
fn fw_free_ledger(led:*LedState)void {
    nio_free(led.buf); nio_free(led.prev);
}

// ---- judge phase: mem_decide -> apply -> ledger -> refuse -> varchoice ->
// ---- verdict record -> seal. Returns ledger_seq or a negative error. ----
fn fw_judge_phase(e:i32,scen:i32,led:*LedState,eb:*ExprBank,
                  st:[]u8,str:[]u8,
                  expr_mode_ov:i32,test_harness:i32,
                  recbuf:[]u8,sealed:*Sealed,digbuf:[]u8,canonbuf:[]u8,
                  ref_out:*Refusal,oo:[]u8,os:[]u8,ostr:[]u8,
                  nops_out:*i32,seq_out:*i32,var_out:*i32,
                  feat_out:[]u8) i32 {
    led.phase=FW_PHASE_JUDGE;
    let clock:i64=e as i64;
    let ctx:i64=(e%4) as i64;
    let focus:i64=((e*3)%16) as i64;
    let input_id:i32=e*2+scen;
    let family:i32=-1;
    if(scen==FW_SCEN_TRAP||scen==FW_SCEN_CELL){family=e%8;}
    // evidence: ascending ids (driver guarantee for the fixed tie-break)
    let evid:[]u8=nio_alloc(32); let evpr:[]u8=nio_alloc(8);
    let price:[]u8=nio_alloc(16);
    if(evid.len!=32||evpr.len!=8||price.len!=16){
        nio_free(evid);nio_free(evpr);nio_free(price);return -1;}
    let ev_n:i32=3+(e%3);
    let i:i32=0;
    while(i<ev_n){fw_u32_set(evid,i*4,e*16+i);evpr[i]=((e+i*3)%5) as u8;i=i+1;}
    while(i<8){fw_u32_set(evid,i*4,0);evpr[i]=0;i=i+1;}
    fw_u32_set(price,0,10);fw_u32_set(price,4,20);
    fw_u32_set(price,8,40);fw_u32_set(price,12,80);
    let ji:JudgeInput=JudgeInput{.ev_id=evid,.ev_prio=evpr,.ev_n=ev_n,
        .st=st,.str=str,.price=price,.ep=clock};
    // read-watch: snapshot across the judge call
    let w0:i32=eb.watch;
    let nops:i32=mem_decide(&ji,oo,os,ostr);
    if(eb.watch!=w0){nio_free(evid);nio_free(evpr);nio_free(price);return -100;}
    if(nops<0){nio_free(evid);nio_free(evpr);nio_free(price);return -2;}
    let pay:[]u8=nio_alloc(56);
    if(pay.len!=56){nio_free(evid);nio_free(evpr);nio_free(price);return -3;}
    i=0;
    while(i<nops){
        let op:i32=oo[i] as i32;
        let slot:i32=fw_i32_get(os,i*4);
        let ns2:i32=fw_i32_get(ostr,i*4);
        fw_apply_op(st,str,op,slot,ns2);
        fw_pay_memop(pay,op,slot,e,0,ns2);
        if(fw_led_append(led,e,clock,FW_OP_MEMOP,pay,20)<0){
            nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);return -4;}
        i=i+1;
    }
    // refusal gate (3 wires: input, constitution, ledger evidence)
    let items:[]u8=nio_alloc(32); let ib:[]u8=nio_alloc(16);
    if(items.len!=32||ib.len!=16){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);return -5;}
    fw_u32_set(ib,0,input_id);fw_i32_set(ib,4,family);fw_u64_set(ib,8,clock);
    fw_zero(items);
    if(ns_sha256(ib,items)!=0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);return -6;}
    let ri:RefInput=RefInput{.input_id=input_id,.family=family,.items=items};
    let ccode:[]u8=nio_alloc(8); let crule:[]u8=nio_alloc(32);
    if(ccode.len!=8||crule.len!=32){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);return -7;}
    fw_constitution_init(ccode,crule);
    fw_refuse_decide(&ri,ccode,crule,led.buf,led.n,ref_out);
    let rid:i32=0;
    if(family>=0){rid=fw_u32_get(crule,family*4);}
    let action:i32=0;
    if(ref_out.refuse==1){action=FW_ACT_HOLD;}
    fw_pay_refusal(pay,ref_out.code,rid,items,action);
    if(fw_led_append(led,e,clock,FW_OP_REFUSAL,pay,44)<0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);return -8;}
    // variation choice: selector over JUDGMENT-side state only
    // (PREREG §6 amendment: input hash + judgment-state bytes; the expression
    // partition is excluded so the whole ledger is a pure function of the
    // judge phase).
    fw_u32_set(feat_out,0,input_id);
    fw_u64_set(feat_out,4,clock);
    fw_u64_set(feat_out,12,ctx);
    fw_u64_set(feat_out,20,focus);
    i=0; while(i<8){feat_out[28+i]=st[i];i=i+1;}
    fw_copy(feat_out,36,str,0,32);
    fw_copy(feat_out,68,evid,0,32);
    let selh:[]u8=nio_alloc(32);
    if(selh.len!=32){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);return -9;}
    let fs:[]u8=feat_out[0..100];
    if(ns_sha256(fs,selh)!=0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);
        nio_free(selh);return -10;}
    let vv:i64=fw_u64_get(selh,0);
    let variant:i32=(vv%4) as i32;
    if(variant<0){variant=variant+4;}
    let forced:i32=0;
    if(expr_mode_ov>=0 && test_harness==1){variant=expr_mode_ov;forced=1;}
    fw_pay_varchoice(pay,variant,selh,1,forced);
    if(fw_led_append(led,e,clock,FW_OP_VARCHOICE,pay,44)<0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);
        nio_free(selh);return -11;}
    nio_free(selh);
    // verdict record + seal (ledger append BEFORE any expression runs)
    let vcode:i32=FW_V_HOLD;
    if(family>=0){vcode=FW_V_REFUSE;}
    else if(nops>0){vcode=FW_V_ACCEPT;}
    let tok:SealTok=verdict_open();
    let rec:VRec=VRec{.canon=recbuf};
    vr_begin(&rec,recbuf);
    vr_set_verdict(&tok,&rec,vcode);
    vr_set_refuse(&tok,&rec,ref_out.refuse,ref_out.code);
    vr_set_input(&tok,&rec,input_id,clock);
    let args:[]u8=nio_alloc(8);
    if(args.len!=8){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);return -12;}
    fw_u32_set(args,0,input_id);fw_u32_set(args,4,e);
    vr_set_args(&tok,&rec,args);
    nio_free(args);
    i=0;
    while(i<nops){
        vr_add_memop(&tok,&rec,oo[i] as i32,fw_i32_get(os,i*4),
                     fw_i32_get(ostr,i*4));
        i=i+1;
    }
    vr_sort_ops(&rec);
    i=0;
    while(i<ref_out.ncites){
        vr_add_cite(&tok,&rec,fw_u32_get(ref_out.cites,i*4));i=i+1;}
    i=0;
    while(i<ev_n){vr_add_evref(&tok,&rec,fw_u32_get(evid,i*4));i=i+1;}
    let seq:i32=fw_seal(&tok,&rec,led,e,clock,1,sealed,digbuf,canonbuf);
    if(seq<0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);return -13;}
    // STATE_HASH anchor (K=1 during trial). Commits ONLY to judgment-side
    // state (clock, ctx, focus, store, strengths) — never to led.prev.
    // Committing to the chain here would make the payload a function of the
    // variant_id (via the VARIATION_CHOICE entry's entry_hash), which would
    // break VARIANT_EQ's "identical payload bytes across modes". Chain
    // anchoring is provided by prev_hash/entry_hash, verified per ledger.
    let sb:[]u8=nio_alloc(64); let sh:[]u8=nio_alloc(32);
    if(sb.len!=64||sh.len!=32){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);return -14;}
    fw_u64_set(sb,0,clock);fw_u64_set(sb,8,ctx);fw_u64_set(sb,16,focus);
    i=0; while(i<8){sb[24+i]=st[i];i=i+1;}
    fw_copy(sb,32,str,0,32);
    if(ns_sha256(sb,sh)!=0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);
        nio_free(sb);nio_free(sh);return -15;}
    fw_pay_statehash(pay,sh);
    if(fw_led_append(led,e,clock,FW_OP_STATEHASH,pay,32)<0){
        nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
        nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);
        nio_free(sb);nio_free(sh);return -16;}
    nio_free(evid);nio_free(evpr);nio_free(price);nio_free(pay);
    nio_free(items);nio_free(ib);nio_free(ccode);nio_free(crule);
    nio_free(sb);nio_free(sh);
    nops_out.*=nops; seq_out.*=seq; var_out.*=variant;
    return seq;
}

// ---- expression phase: digest -> lawful pick -> render -> emission-verify.
// The phase seam: led.phase flips to EXPR; any append attempt is refused.
// probe: 0 = lawful render; 100..103 = tamper-probe renderers;
//        104 = forged ledger-append attempt (must be refused).
// stag: smuggled tag for vary_pick (-1 = lawful tag e). The call-site rule
// constrains only the FIRST argument, so tag smuggling is the residual the
// wiring trial (K3) covers at runtime.
// Returns 0, or a negative error.
fn fw_expr_phase(e:i32,led:*LedState,eb:*ExprBank,sealed:*Sealed,
                 feat:[]u8,
                 expr_mode_ov:i32,test_harness:i32,lawful_variant:i32,
                 probe:i32,stag:i32,
                 render:[]u8,rlen_out:*i32,pick_out:*i32,
                 tamp_out:*i32,vok_out:*i32) i32 {
    led.phase=FW_PHASE_EXPR;
    let n0:i32=led.n;
    let fs:[]u8=feat[0..100];
    let d1:i32=fw_state_digest(fs);
    let tag:i32=e;
    if(stag>=0){tag=stag;}
    let pick:i32=vary_pick(fw_state_digest(fs),tag,4);
    let mode:i32=lawful_variant;
    if(expr_mode_ov>=0 && test_harness==1){mode=expr_mode_ov;}
    let rvd:[]u8=nio_alloc(32);
    if(rvd.len!=32){return -20;}
    let rv:RenderView=RenderView{.vcode=0,.rcode=0,.nops=0,.ncites=0,
        .digest=rvd};
    fw_render_view(sealed.canon,&rv,rvd);
    let rlen:i32=0;
    let vok:i32=0;
    if(probe==0){
        rlen=fw_render(mode,&rv,eb,render);
        if(rlen<0){nio_free(rvd);return -21;}
        let rs:[]u8=render[rlen..];
        let dl:i32=fw_emit_line(sealed.canon,rs);
        if(dl<0){nio_free(rvd);return -22;}
        let ls:[]u8=render[rlen..rlen+dl];
        vok=fw_emit_verify(sealed.canon,ls,dl);
        rlen=rlen+dl;
    } else if(probe>=100 && probe<=103){
        rlen=fw_probe(probe,sealed.canon,&rv,render);
        if(rlen<0){nio_free(rvd);return -23;}
        let doff:i32=fw_find_digest(render,rlen);
        if(doff<0){nio_free(rvd);return -24;}
        let ls2:[]u8=render[doff..doff+72];
        vok=fw_emit_verify(sealed.canon,ls2,72);
        // a probe is DETECTED iff the sealed digest is NOT preserved
        if(vok==0){tamp_out.*=tamp_out.*+1;}
    } else if(probe==104){
        let pay:[]u8=nio_alloc(20);
        if(pay.len!=20){nio_free(rvd);return -25;}
        fw_pay_memop(pay,FW_MO_PIN,0,e,0,1);
        let rc:i32=fw_led_append(led,e,e as i64,FW_OP_MEMOP,pay,20);
        nio_free(pay);
        if(rc==FW_E_PHASE){tamp_out.*=tamp_out.*+1;}
        rlen=0; vok=1;
    } else {nio_free(rvd);return -26;}
    if(led.n!=n0){nio_free(rvd);return -101;}
    nio_free(rvd);
    rlen_out.*=rlen; pick_out.*=pick; vok_out.*=vok;
    return 0;
}

// locate the "digest=" line; returns its offset or -1
fn fw_find_digest(b:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i+7<n){
        // "digest=" in ASCII: 100,105,103,101,115,116,61
        if(b[i]==100 && b[i+1]==105 && b[i+2]==103 &&
           b[i+3]==101 && b[i+4]==115 && b[i+5]==116 &&
           b[i+6]==61){return i;}
        i=i+1;
    }
    return -1;
}

// K3 analog: the rendered refusal must not contradict its triple.
// Checks "ref=<refuse>" and "code=<code>" and (for full-depth renders) the
// cited SET. Returns 1 if clean, 0 if contradiction.
fn fw_explain_check(r:*Refusal,txt:[]u8,len:i32,full_cites:i32)i32 {
    let i:i32=0;
    let refok:i32=0; let codeok:i32=0;
    // ASCII: r=114 e=101 f=102 c=99 o=111 d=100 i=105 t=116 s=115
    //        '='=61 '0'=48 '9'=57 '+'=43 '\n'=10
    while(i+4<len){
        if(txt[i]==114 && txt[i+1]==101 && txt[i+2]==102 &&
           txt[i+3]==61){
            if(txt[i+4]==(48+r.refuse) as u8){refok=1;}
        }
        i=i+1;
    }
    i=0;
    while(i+5<len){
        if(txt[i]==99 && txt[i+1]==111 && txt[i+2]==100 &&
           txt[i+3]==101 && txt[i+4]==61){
            let v:i32=0; let j:i32=i+5;
            while(j<len && txt[j]>=48 && txt[j]<=57){
                v=v*10+(txt[j] as i32)-48;j=j+1;}
            if(v==r.code){codeok=1;}
        }
        i=i+1;
    }
    if(refok==0||codeok==0){return 0;}
    if(full_cites==0){return 1;}
    // cited set: parse ints after "cites=" up to '+' or newline
    let seen:[]u8=nio_alloc(16);
    if(seen.len!=16){return 0;}
    fw_zero(seen);
    let nseen:i32=0;
    i=0;
    while(i+6<len){
        if(txt[i]==99 && txt[i+1]==105 && txt[i+2]==116 &&
           txt[i+3]==101 && txt[i+4]==115 && txt[i+5]==61){
            let j:i32=i+6;
            while(j<len && txt[j]!=43 && txt[j]!=10){
                if(txt[j]>=48 && txt[j]<=57){
                    let v:i32=0;
                    while(j<len && txt[j]>=48 && txt[j]<=57){
                        v=v*10+(txt[j] as i32)-48;j=j+1;}
                    if(nseen<16){fw_u32_set(seen,nseen*4,v);nseen=nseen+1;}
                } else {j=j+1;}
            }
        }
        i=i+1;
    }
    // set equality vs the triple's cites (order-insensitive)
    if(nseen!=r.ncites){nio_free(seen);return 0;}
    let k:i32=0;
    while(k<r.ncites){
        let cv:i32=fw_u32_get(r.cites,k*4);
        let f:i32=0; let m:i32=0;
        while(m<nseen){if(fw_u32_get(seen,m*4)==cv){f=1;}m=m+1;}
        if(f==0){nio_free(seen);return 0;}
        k=k+1;
    }
    nio_free(seen);
    return 1;
}

// ---- pre-episode state save/restore (replay batteries) ----
// layout: st 8B | str 32B | expr 9x4B | led.n u32 | ledger bytes | prev 32B
fn fw_state_save(st:[]u8,str:[]u8,eb:*ExprBank,led:*LedState,out:[]u8)i32 {
    let at:i32=0;
    let i:i32=0; while(i<8){out[at+i]=st[i];i=i+1;} at=at+8;
    fw_copy(out,at,str,0,32); at=at+32;
    fw_i32_set(out,at,eb.lexicon);fw_i32_set(out,at+4,eb.depth);
    fw_i32_set(out,at+8,eb.order);fw_i32_set(out,at+12,eb.emphasis);
    fw_i32_set(out,at+16,eb.path_memo);fw_i32_set(out,at+20,eb.phras_hist);
    fw_i32_set(out,at+24,eb.word_ctr);fw_i32_set(out,at+28,eb.conv_reg);
    fw_i32_set(out,at+32,eb.watch); at=at+36;
    fw_u32_set(out,at,led.n); at=at+4;
    let nb:i32=led.n*FW_LED_STRIDE;
    fw_copy(out,at,led.buf,0,nb); at=at+nb;
    fw_copy(out,at,led.prev,0,32); at=at+32;
    return at;
}
fn fw_state_restore(st:[]u8,str:[]u8,eb:*ExprBank,led:*LedState,inb:[]u8)i32 {
    let at:i32=0;
    let i:i32=0; while(i<8){st[i]=inb[at+i];i=i+1;} at=at+8;
    fw_copy(str,0,inb,at,32); at=at+32;
    eb.lexicon=fw_i32_get(inb,at);eb.depth=fw_i32_get(inb,at+4);
    eb.order=fw_i32_get(inb,at+8);eb.emphasis=fw_i32_get(inb,at+12);
    eb.path_memo=fw_i32_get(inb,at+16);eb.phras_hist=fw_i32_get(inb,at+20);
    eb.word_ctr=fw_i32_get(inb,at+24);eb.conv_reg=fw_i32_get(inb,at+28);
    eb.watch=fw_i32_get(inb,at+32); at=at+36;
    let n:i32=fw_u32_get(inb,at); at=at+4;
    let nb:i32=n*FW_LED_STRIDE;
    fw_copy(led.buf,0,inb,at,nb); at=at+nb;
    fw_copy(led.prev,0,inb,at,32);
    led.n=n; led.phase=FW_PHASE_JUDGE;
    return at;
}

// ---- one full episode (judge phase + phase seam + expression phase) ----
fn fw_full_episode(p:i32,scen:i32,expr_mode_ov:i32,test_harness:i32,
                   probe:i32,stag:i32,keep_expr:i32,
                   led:*LedState,eb:*ExprBank,
                   canon_out:[]u8,dig_out:[]u8,render_out:[]u8,
                   rlen_out:*i32,seq_out:*i32,var_out:*i32,
                   nops_out:*i32,ref_out:*Refusal,
                   oo:[]u8,os:[]u8,ostr:[]u8,
                   pick_out:*i32,tamp_out:*i32,vok_out:*i32,
                   feat_out:[]u8) i32 {
    let st:[]u8=nio_alloc(8); let str:[]u8=nio_alloc(32);
    if(st.len!=8||str.len!=32){nio_free(st);nio_free(str);return -30;}
    fw_init_store(p,st,str);
    if(keep_expr==0){fw_init_expr(p,eb);}
    fw_new_ledger(led);
    let recbuf:[]u8=nio_alloc(192); let canonbuf:[]u8=nio_alloc(192);
    let digbuf:[]u8=nio_alloc(32);
    if(recbuf.len!=192||canonbuf.len!=192||digbuf.len!=32){
        nio_free(st);nio_free(str);return -31;}
    let sealed:Sealed=Sealed{.digest=digbuf,.canon=canonbuf,.ledger_seq=0};
    let seq:i32=fw_judge_phase(p,scen,led,eb,st,str,
        expr_mode_ov,test_harness,recbuf,&sealed,digbuf,canonbuf,
        ref_out,oo,os,ostr,nops_out,seq_out,var_out,feat_out);
    if(seq<0){
        nio_free(st);nio_free(str);nio_free(recbuf);nio_free(canonbuf);
        nio_free(digbuf);return seq;}
    let rc:i32=fw_expr_phase(p,led,eb,&sealed,feat_out,
        expr_mode_ov,test_harness,var_out.*,probe,stag,
        render_out,rlen_out,pick_out,tamp_out,vok_out);
    let i:i32=0;
    while(i<192){canon_out[i]=canonbuf[i];i=i+1;}
    i=0; while(i<32){dig_out[i]=digbuf[i];i=i+1;}
    nio_free(st);nio_free(str);nio_free(recbuf);nio_free(canonbuf);
    nio_free(digbuf);
    return rc;
}

// ==================== batteries ====================
fn fw_led_snap(led:*LedState,out:[]u8)i32 {
    let nb:i32=led.n*FW_LED_STRIDE;
    fw_copy(out,0,led.buf,0,nb);
    return led.n;
}
fn fw_triple_pack(r:*Refusal,out:[]u8)void {
    fw_i32_set(out,0,r.refuse);fw_i32_set(out,4,r.code);
    fw_i32_set(out,8,r.ncites);
    fw_copy(out,12,r.cites,0,16);
}
fn fw_ri_of(e:i32,scen:i32,ri:*RefInput,items:[]u8)void {
    let input_id:i32=e*2+scen;
    let family:i32=-1;
    if(scen==FW_SCEN_TRAP||scen==FW_SCEN_CELL){family=e%8;}
    let ib:[]u8=nio_alloc(16);
    fw_u32_set(ib,0,input_id);fw_i32_set(ib,4,family);fw_u64_set(ib,8,e as i64);
    fw_zero(items);
    ns_sha256(ib,items);
    nio_free(ib);
    ri.input_id=input_id; ri.family=family; ri.items=items;
}

// ---- verdictinv: 200 pairs x K=4 modes, VARIANT_EQ (S12-K1) ----
fn fw_mode_verdictinv()i32 {
    let bad:i32=0;
    let cells:i32=0; let cellfail:i32=0;
    let canons:[]u8=nio_alloc(768);
    let digs:[]u8=nio_alloc(128);
    let seqs:[]u8=nio_alloc(16);
    let ledns:[]u8=nio_alloc(16);
    let snaps:[]u8=nio_alloc(32768);
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let render:[]u8=nio_alloc(2048);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let feat:[]u8=nio_alloc(100);
    let dummy:[]u8=nio_alloc(32);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let p:i32=0;
    while(p<200){
        let m:i32=0;
        while(m<4){
            let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
                .prev=ledprev,.phase=0};
            fw_led_init(&led,ledbuf,FW_LED_CAP,ledprev);
            let nops:i32=0; let seq:i32=0; let var:i32=0; let rlen:i32=0;
            let pick:i32=0; let tamp:i32=0; let vok:i32=0;
            let cs:[]u8=canons[m*192..m*192+192];
            let ds:[]u8=digs[m*32..m*32+32];
            let rc:i32=fw_full_episode(p,FW_SCEN_TRAP,m,1,0,-1,0,
                &led,&eb,cs,ds,render,
                &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
                &pick,&tamp,&vok,feat);
            if(rc!=0||vok!=1){
                _zag_print("VERDICTINV_EP_FAIL,p,");fw_pnum(p as i64);
                _zag_print(",m,");fw_pnum(m as i64);
                _zag_print(",rc,");fw_pnum(rc as i64);_zag_println("");
                bad=bad+1;
            }
            fw_i32_set(seqs,m*4,seq);
            let nb:i32=fw_led_snap(&led,snaps[m*8192..m*8192+8192]);
            fw_i32_set(ledns,m*4,nb);
            m=m+1;
        }
        let ok:i32=1;
        let m2:i32=1;
        while(m2<4){
            let c0:[]u8=canons[0..192]; let cm:[]u8=canons[m2*192..m2*192+192];
            if(fw_bytes_eq(c0,cm)==0){ok=0;}
            let d0:[]u8=digs[0..32]; let dm:[]u8=digs[m2*32..m2*32+32];
            if(fw_bytes_eq(d0,dm)==0){ok=0;}
            if(fw_i32_get(seqs,0)!=fw_i32_get(seqs,m2*4)){ok=0;}
            let la:LedState=LedState{.buf=snaps[0..8192],.n=fw_i32_get(ledns,0),
                .cap=FW_LED_CAP,.prev=dummy,.phase=FW_PHASE_JUDGE};
            let lb:LedState=LedState{.buf=snaps[m2*8192..m2*8192+8192],
                .n=fw_i32_get(ledns,m2*4),
                .cap=FW_LED_CAP,.prev=dummy,.phase=FW_PHASE_JUDGE};
            if(fw_led_cmp(&la,&lb,1)!=0){ok=0;}
            // the mask must be doing work: unmasked comparison MUST differ
            // (forced variant_id differs across modes)
            if(fw_led_cmp(&la,&lb,0)==0){ok=0;}
            m2=m2+1;
        }
        if(ok==1){cells=cells+1;}
        else {
            cellfail=cellfail+1;
            _zag_print("VERDICTINV_CELL_FAIL,p,");fw_pnum(p as i64);
            _zag_println("");
        }
        p=p+1;
    }
    bad=bad+cl_check("verdict_cells",cells,200);
    bad=bad+cl_check("verdict_cellfail",cellfail,0);
    nio_free(canons);nio_free(digs);nio_free(seqs);nio_free(ledns);
    nio_free(snaps);nio_free(ledbuf);nio_free(ledprev);nio_free(render);
    nio_free(oo);nio_free(os);nio_free(ostr);nio_free(feat);nio_free(dummy);
    nio_free(ref0.cites);
    return bad;
}

// ---- tamper: 5 probes, all must be detected (S12-K2) ----
fn fw_mode_tamper()i32 {
    let bad:i32=0;
    let det:i32=0;
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let render:[]u8=nio_alloc(2048);
    let canon:[]u8=nio_alloc(192); let dig:[]u8=nio_alloc(32);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let feat:[]u8=nio_alloc(100);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let pid:i32=100;
    while(pid<=104){
        let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let nops:i32=0; let seq:i32=0; let var:i32=0; let rlen:i32=0;
        let pick:i32=0; let tamp:i32=0; let vok:i32=0;
        let rc:i32=fw_full_episode(7,FW_SCEN_TRAP,-1,0,pid,-1,0,
            &led,&eb,canon,dig,render,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        if(rc!=0){
            _zag_print("TAMPER_EP_FAIL,pid,");fw_pnum(pid as i64);
            _zag_print(",rc,");fw_pnum(rc as i64);_zag_println("");
            bad=bad+1;
        } else if(pid<=103){
            // forgery caught iff the sealed digest is NOT preserved
            if(vok==0){det=det+1;}
            else {
                _zag_print("TAMPER_UNDETECTED,pid,");fw_pnum(pid as i64);
                _zag_println("");
            }
        } else {
            // P104: forged append refused AND ledger length unchanged
            if(tamp==1){det=det+1;}
            else {
                _zag_print("TAMPER_UNDETECTED,pid,104");_zag_println("");
            }
        }
        pid=pid+1;
    }
    bad=bad+cl_check("tamper_detected",det,5);
    nio_free(ledbuf);nio_free(ledprev);nio_free(render);
    nio_free(canon);nio_free(dig);
    nio_free(oo);nio_free(os);nio_free(ostr);nio_free(feat);
    nio_free(ref0.cites);
    return bad;
}

// ---- read-watch liveness: a planted judge-path read MUST trip the watch ----
fn fw_watch_live()i32 {
    let eb:ExprBank=ExprBank{.lexicon=3,.depth=1,.order=0,.emphasis=1,
        .path_memo=9,.phras_hist=8,.word_ctr=7,.conv_reg=6,.watch=0};
    let v:i32=vs_get(&eb,VX_F_LEX);
    if(eb.watch==1 && v==3){
        _zag_println("WATCH_LIVE,1");
        return 0;
    }
    _zag_println("WATCH_LIVE,0");
    return 1;
}

fn fw_perturb(eb:*ExprBank,c:i32)void {
    if(c==0){eb.phras_hist=0;}
    else if(c==1){eb.word_ctr=2147483647;}
    else if(c==2){eb.lexicon=eb.lexicon^3;eb.emphasis=eb.emphasis^1;}
    else if(c==3){eb.depth=0;}
    else if(c==4){eb.depth=9;}
    else if(c==5){eb.path_memo=eb.path_memo^1515870810;}
    else if(c==6){eb.order=eb.order^1;}
    else {eb.conv_reg=0;}
}

// ---- meminv: 200 x 8 perturbation classes = 1600 replays (S13 a/b/c) ----
fn fw_mode_meminv()i32 {
    let bad:i32=0;
    let cells:i32=0; let div:i32=0;
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let render:[]u8=nio_alloc(2048);
    let canon:[]u8=nio_alloc(192); let dig:[]u8=nio_alloc(32);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let feat:[]u8=nio_alloc(100);
    let dummy:[]u8=nio_alloc(32);
    let boo:[]u8=nio_alloc(8); let bos:[]u8=nio_alloc(32); let bostr:[]u8=nio_alloc(32);
    let bsnap:[]u8=nio_alloc(8192); let psnap:[]u8=nio_alloc(8192);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    bad=bad+fw_watch_live();
    let e:i32=0;
    while(e<200){
        // baseline
        let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let nops:i32=0; let seq:i32=0; let var:i32=0; let rlen:i32=0;
        let pick:i32=0; let tamp:i32=0; let vok:i32=0;
        let bnops:i32=0;
        let rc:i32=fw_full_episode(e,FW_SCEN_MEM,-1,0,0,-1,0,
            &led,&eb,canon,dig,render,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        if(rc!=0){bad=bad+1;}
        bnops=nops;
        let i:i32=0;
        while(i<8){boo[i]=oo[i];i=i+1;}
        fw_copy(bos,0,os,0,32); fw_copy(bostr,0,ostr,0,32);
        let bnb:i32=fw_led_snap(&led,bsnap);
        let cellok:i32=1;
        let c:i32=0;
        while(c<8){
            let led2:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
                .prev=ledprev,.phase=0};
            fw_init_expr(e,&eb);
            fw_perturb(&eb,c);
            let nops2:i32=0; let seq2:i32=0; let var2:i32=0; let rlen2:i32=0;
            let pick2:i32=0; let tamp2:i32=0; let vok2:i32=0;
            let rc2:i32=fw_full_episode(e,FW_SCEN_MEM,-1,0,0,-1,1,
                &led2,&eb,canon,dig,render,
                &rlen2,&seq2,&var2,&nops2,&ref0,oo,os,ostr,
                &pick2,&tamp2,&vok2,feat);
            if(rc2!=0){cellok=0;}
            else {
                if(nops2!=bnops){cellok=0;}
                else {
                    let k:i32=0;
                    while(k<bnops){
                        if(oo[k]!=boo[k]){cellok=0;}
                        if(fw_i32_get(os,k*4)!=fw_i32_get(bos,k*4)){cellok=0;}
                        if(fw_i32_get(ostr,k*4)!=fw_i32_get(bostr,k*4)){cellok=0;}
                        k=k+1;
                    }
                }
                let pnb:i32=fw_led_snap(&led2,psnap);
                let la:LedState=LedState{.buf=bsnap,.n=bnb,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                let lb:LedState=LedState{.buf=psnap,.n=pnb,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                if(fw_led_cmp(&la,&lb,0)!=0){cellok=0;}
            }
            c=c+1;
        }
        if(cellok==1){cells=cells+1;}
        else {
            div=div+1;
            _zag_print("MEMINV_CELL_FAIL,e,");fw_pnum(e as i64);_zag_println("");
        }
        e=e+1;
    }
    bad=bad+cl_check("meminv_cells",cells,200);
    bad=bad+cl_check("meminv_div",div,0);
    nio_free(ledbuf);nio_free(ledprev);nio_free(render);
    nio_free(canon);nio_free(dig);
    nio_free(oo);nio_free(os);nio_free(ostr);nio_free(feat);nio_free(dummy);
    nio_free(boo);nio_free(bos);nio_free(bostr);nio_free(bsnap);nio_free(psnap);
    nio_free(ref0.cites);
    return bad;
}

// ---- refuseinv: 8 families x 32 expr states (S14 K1-K4) ----
fn fw_mode_refuseinv()i32 {
    let bad:i32=0;
    let cells:i32=0; let vac:i32=0; let k3bad:i32=0;
    let st:[]u8=nio_alloc(8); let str:[]u8=nio_alloc(32);
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let recbuf:[]u8=nio_alloc(192); let canonbuf:[]u8=nio_alloc(192);
    let digbuf:[]u8=nio_alloc(32); let feat:[]u8=nio_alloc(100);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let items:[]u8=nio_alloc(32);
    let cc:[]u8=nio_alloc(8); let cr:[]u8=nio_alloc(32);
    let t0:[]u8=nio_alloc(28); let ts:[]u8=nio_alloc(28);
    let renders:[]u8=nio_alloc(8192);   // 32 x 256
    let rlens:[]u8=nio_alloc(128);
    let txt:[]u8=nio_alloc(512);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let eb2:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let refj:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let r0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let rs:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let f:i32=0;
    while(f<8){
        let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        fw_init_store(f,st,str);
        fw_init_expr(f,&eb);
        fw_led_init(&led,ledbuf,FW_LED_CAP,ledprev);
        let sealed:Sealed=Sealed{.digest=digbuf,.canon=canonbuf,.ledger_seq=0};
        let nops:i32=0; let seqo:i32=0; let var:i32=0;
        let sq:i32=fw_judge_phase(f,FW_SCEN_CELL,&led,&eb,st,str,
            -1,0,recbuf,&sealed,digbuf,canonbuf,
            &refj,oo,os,ostr,&nops,&seqo,&var,feat);
        if(sq<0){bad=bad+1;}
        let ri:RefInput=RefInput{.input_id=0,.family=0,.items=items};
        fw_ri_of(f,FW_SCEN_CELL,&ri,items);
        fw_constitution_init(cc,cr);
        // canonical triple: re-decide on the final ledger (all 32 states
        // share identical evidence)
        fw_init_expr(0,&eb2);
        fw_refuse_decide(&ri,cc,cr,led.buf,led.n,&r0);
        fw_triple_pack(&r0,t0);
        let allok:i32=1;
        let s:i32=0;
        while(s<32){
            fw_init_expr(s,&eb2);
            fw_refuse_decide(&ri,cc,cr,led.buf,led.n,&rs);
            fw_triple_pack(&rs,ts);
            if(fw_bytes_eq(t0,ts)==0){allok=0;}
            s=s+1;
        }
        // K4: elocution must vary (distinct renderings across the 32 states)
        s=0;
        while(s<32){
            fw_init_expr(s,&eb2);
            let rl:i32=fw_explain(&r0,eb2.lexicon%4,eb2.order%2,eb2.depth%3,
                renders[s*256..s*256+256]);
            fw_i32_set(rlens,s*4,rl);
            s=s+1;
        }
        let distinct:i32=0;
        s=0;
        while(s<32){
            let rl:i32=fw_i32_get(rlens,s*4);
            let seen:i32=0;
            let k:i32=0;
            while(k<s){
                let rl2:i32=fw_i32_get(rlens,k*4);
                if(rl==rl2){
                    let a:[]u8=renders[s*256..s*256+rl];
                    let b2:[]u8=renders[k*256..k*256+rl2];
                    if(fw_bytes_eq(a,b2)==1){seen=1;}
                }
                k=k+1;
            }
            if(seen==0){distinct=distinct+1;}
            s=s+1;
        }
        if(distinct<2){
            // K4: re-run the cell with a wider state set
            s=0;
            while(s<32){
                fw_init_expr(s+1000,&eb2);
                let rl:i32=fw_explain(&r0,eb2.lexicon%4,eb2.order%2,
                    eb2.depth%3,renders[s*256..s*256+256]);
                fw_i32_set(rlens,s*4,rl);
                s=s+1;
            }
            distinct=0; s=0;
            while(s<32){
                let rl:i32=fw_i32_get(rlens,s*4);
                let seen:i32=0;
                let k:i32=0;
                while(k<s){
                    let rl2:i32=fw_i32_get(rlens,k*4);
                    if(rl==rl2){
                        let a:[]u8=renders[s*256..s*256+rl];
                        let b2:[]u8=renders[k*256..k*256+rl2];
                        if(fw_bytes_eq(a,b2)==1){seen=1;}
                    }
                    k=k+1;
                }
                if(seen==0){distinct=distinct+1;}
                s=s+1;
            }
            if(distinct<2){vac=vac+1;}
        }
        // K3: full-depth render must not contradict the triple
        fw_init_expr(0,&eb2);
        let rl3:i32=fw_explain(&r0,1,0,2,txt);
        if(fw_explain_check(&r0,txt,rl3,1)==0){k3bad=k3bad+1;}
        if(allok==1){cells=cells+1;}
        else {
            _zag_print("REFUSEINV_CELL_FAIL,f,");fw_pnum(f as i64);
            _zag_println("");
        }
        f=f+1;
    }
    bad=bad+cl_check("refuse_cells",cells,8);
    bad=bad+cl_check("refuse_vacuous",vac,0);
    bad=bad+cl_check("refuse_k3bad",k3bad,0);
    nio_free(st);nio_free(str);nio_free(ledbuf);nio_free(ledprev);
    nio_free(recbuf);nio_free(canonbuf);nio_free(digbuf);nio_free(feat);
    nio_free(oo);nio_free(os);nio_free(ostr);
    nio_free(items);nio_free(cc);nio_free(cr);
    nio_free(t0);nio_free(ts);nio_free(renders);nio_free(rlens);nio_free(txt);
    nio_free(refj.cites);nio_free(r0.cites);nio_free(rs.cites);
    return bad;
}

// ---- ledginv: 200 forced-variant pairs + no-override replay (S15) ----
fn fw_mode_ledginv()i32 {
    let bad:i32=0;
    let pairs:i32=0; let pfail:i32=0;
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let render:[]u8=nio_alloc(2048);
    let render2:[]u8=nio_alloc(2048);
    let canonA:[]u8=nio_alloc(192); let digA:[]u8=nio_alloc(32);
    let canonB:[]u8=nio_alloc(192); let digB:[]u8=nio_alloc(32);
    let snapA:[]u8=nio_alloc(8192); let snapB:[]u8=nio_alloc(8192);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let feat:[]u8=nio_alloc(100); let featC:[]u8=nio_alloc(100);
    let dummy:[]u8=nio_alloc(32);
    let h2:[]u8=nio_alloc(32);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let p:i32=0;
    while(p<200){
        let va:i32=p%4; let vb:i32=(p+1)%4;
        // run A (forced va)
        let ledA:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let nops:i32=0; let seq:i32=0; let var:i32=0; let rlen:i32=0;
        let pick:i32=0; let tamp:i32=0; let vok:i32=0;
        let rc:i32=fw_full_episode(p,FW_SCEN_TRAP,va,1,0,-1,0,
            &ledA,&eb,canonA,digA,render,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        let na:i32=0;
        if(rc==0){na=fw_led_snap(&ledA,snapA);}
        // run B (forced vb)
        let ledB:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let rc2:i32=fw_full_episode(p,FW_SCEN_TRAP,vb,1,0,-1,0,
            &ledB,&eb,canonB,digB,render2,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        let nb:i32=0;
        if(rc2==0){nb=fw_led_snap(&ledB,snapB);}
        let ok:i32=1;
        if(rc!=0||rc2!=0){ok=0;}
        else {
            if(fw_bytes_eq(canonA,canonB)==0){ok=0;}
            if(fw_bytes_eq(digA,digB)==0){ok=0;}
            let la:LedState=LedState{.buf=snapA,.n=na,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            let lb:LedState=LedState{.buf=snapB,.n=nb,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            if(fw_led_cmp(&la,&lb,1)!=0){ok=0;}
            if(fw_led_cmp(&la,&lb,0)==0){ok=0;}
            if(fw_led_verify(&la)!=0){ok=0;}
            if(fw_led_verify(&lb)!=0){ok=0;}
        }
        // no-override replay: C then D from the same deterministic init
        let ledC:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let rc3:i32=fw_full_episode(p,FW_SCEN_TRAP,-1,0,0,-1,0,
            &ledC,&eb,canonA,digA,render,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,featC);
        let nc:i32=0;
        if(rc3==0){nc=fw_led_snap(&ledC,snapA);}
        let ledD:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let rc4:i32=fw_full_episode(p,FW_SCEN_TRAP,-1,0,0,-1,0,
            &ledD,&eb,canonB,digB,render2,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        let nd:i32=0;
        if(rc4==0){nd=fw_led_snap(&ledD,snapB);}
        if(rc3!=0||rc4!=0){ok=0;}
        else {
            if(fw_bytes_eq(canonA,canonB)==0){ok=0;}
            if(fw_bytes_eq(digA,digB)==0){ok=0;}
            let lc:LedState=LedState{.buf=snapA,.n=nc,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            let ld:LedState=LedState{.buf=snapB,.n=nd,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            if(fw_led_cmp(&lc,&ld,0)!=0){ok=0;}
            if(fw_led_verify(&lc)!=0){ok=0;}
            // recompute-from-state over C's VARIATION_CHOICE entries
            let fs:[]u8=featC[0..100];
            if(ns_sha256(fs,h2)!=0){ok=0;}
            else {
                let vv:i64=fw_u64_get(h2,0);
                let var2:i32=(vv%4) as i32;
                if(var2<0){var2=var2+4;}
                let idx:i32=0;
                while(idx<nc){
                    let at:i32=idx*FW_LED_STRIDE;
                    let op:i32=snapA[at+16] as i32;
                    if(op==FW_OP_VARCHOICE){
                        let forced:i32=snapA[at+89] as i32;
                        if(forced==0){
                            let vid:i32=fw_u16_get(snapA,at+49);
                            if(vid!=var2){ok=0;}
                            let k:i32=0;
                            while(k<32){
                                if(snapA[at+53+k]!=h2[k]){ok=0;}
                                k=k+1;
                            }
                        }
                    }
                    idx=idx+1;
                }
            }
        }
        if(ok==1){pairs=pairs+1;}
        else {
            pfail=pfail+1;
            _zag_print("LEDGINV_PAIR_FAIL,p,");fw_pnum(p as i64);_zag_println("");
        }
        p=p+1;
    }
    bad=bad+cl_check("led_pairs",pairs,200);
    bad=bad+cl_check("led_pairfail",pfail,0);
    nio_free(ledbuf);nio_free(ledprev);nio_free(render);nio_free(render2);
    nio_free(canonA);nio_free(digA);nio_free(canonB);nio_free(digB);
    nio_free(snapA);nio_free(snapB);
    nio_free(oo);nio_free(os);nio_free(ostr);
    nio_free(feat);nio_free(featC);nio_free(dummy);nio_free(h2);
    nio_free(ref0.cites);
    return bad;
}

// ---- one full episode on caller-managed state (replay battery) ----
fn fw_run_once(p:i32,scen:i32,st:[]u8,str:[]u8,eb:*ExprBank,led:*LedState,
               canon_out:[]u8,dig_out:[]u8,render_out:[]u8,
               rlen_out:*i32,seq_out:*i32) i32 {
    let recbuf:[]u8=nio_alloc(192); let canonbuf:[]u8=nio_alloc(192);
    let digbuf:[]u8=nio_alloc(32); let feat:[]u8=nio_alloc(100);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let sealed:Sealed=Sealed{.digest=digbuf,.canon=canonbuf,.ledger_seq=0};
    let nops:i32=0; let seqo:i32=0; let var:i32=0;
    let pick:i32=0; let tamp:i32=0; let vok:i32=0; let rlen:i32=0;
    let sq:i32=fw_judge_phase(p,scen,led,eb,st,str,
        -1,0,recbuf,&sealed,digbuf,canonbuf,
        &ref0,oo,os,ostr,&nops,&seqo,&var,feat);
    if(sq<0){
        nio_free(recbuf);nio_free(canonbuf);nio_free(digbuf);nio_free(feat);
        nio_free(oo);nio_free(os);nio_free(ostr);nio_free(ref0.cites);
        return sq;}
    let rc:i32=fw_expr_phase(p,led,eb,&sealed,feat,
        -1,0,var,0,-1,render_out,&rlen,&pick,&tamp,&vok);
    let i:i32=0;
    while(i<192){canon_out[i]=canonbuf[i];i=i+1;}
    i=0; while(i<32){dig_out[i]=digbuf[i];i=i+1;}
    rlen_out.*=rlen; seq_out.*=seqo;
    nio_free(recbuf);nio_free(canonbuf);nio_free(digbuf);nio_free(feat);
    nio_free(oo);nio_free(os);nio_free(ostr);nio_free(ref0.cites);
    if(vok!=1){return -40;}
    return rc;
}

// ---- wiring: 100 episodes x 10 planted runtime probes (S20 K3) ----
// W1..W5: smuggled judgment/ledger values as the vary_pick TAG (runtime
// attempt to steer variation from sealed content). MUST NOT change verdicts,
// memory decisions, refusals, or the ledger.
// W6..W10: vary outputs written into expr bank fields, then the judgment
// phase re-runs. MUST NOT change memory decisions, refusals, or ledger,
// and the read-watch must stay silent.
fn fw_mode_wiring()i32 {
    let bad:i32=0;
    let cells:i32=0; let wfail:i32=0;
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let render:[]u8=nio_alloc(2048);
    let canonC:[]u8=nio_alloc(192); let digC:[]u8=nio_alloc(32);
    let canonK:[]u8=nio_alloc(192); let digK:[]u8=nio_alloc(32);
    let snapC:[]u8=nio_alloc(8192); let snapK:[]u8=nio_alloc(8192);
    let oo:[]u8=nio_alloc(8); let os:[]u8=nio_alloc(32); let ostr:[]u8=nio_alloc(32);
    let aoo:[]u8=nio_alloc(8); let aos:[]u8=nio_alloc(32); let aostr:[]u8=nio_alloc(32);
    let ta:[]u8=nio_alloc(28); let tb:[]u8=nio_alloc(28);
    let feat:[]u8=nio_alloc(100);
    let dummy:[]u8=nio_alloc(32);
    let recbuf:[]u8=nio_alloc(192); let canonbuf:[]u8=nio_alloc(192);
    let digbuf:[]u8=nio_alloc(32);
    let st:[]u8=nio_alloc(8); let str:[]u8=nio_alloc(32);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ref0:Refusal=Refusal{.refuse=0,.code=0,.cites=nio_alloc(16),.ncites=0};
    let ep:i32=0;
    while(ep<100){
        // control episode
        let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        let nops:i32=0; let seq:i32=0; let var:i32=0; let rlen:i32=0;
        let pick:i32=0; let tamp:i32=0; let vok:i32=0;
        let rc:i32=fw_full_episode(ep,FW_SCEN_TRAP,-1,0,0,-1,0,
            &led,&eb,canonC,digC,render,
            &rlen,&seq,&var,&nops,&ref0,oo,os,ostr,
            &pick,&tamp,&vok,feat);
        let ok:i32=1;
        if(rc!=0||vok!=1){ok=0;}
        let nC:i32=fw_led_snap(&led,snapC);
        let slot0:i32=0;
        if(nops>0){slot0=fw_i32_get(os,0);}
        let vals:[]u8=nio_alloc(20);
        fw_i32_set(vals,0,canonC[0] as i32);       // W1: verdict code
        fw_i32_set(vals,4,ep*16);                  // W2: evidence id
        fw_i32_set(vals,8,canonC[2] as i32);       // W3: refusal code
        fw_i32_set(vals,12,slot0);                 // W4: memop slot
        fw_i32_set(vals,16,nC);                    // W5: ledger length
        // W1..W5
        let k:i32=0;
        while(k<5){
            let ledK:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
                .prev=ledprev,.phase=0};
            let nopsK:i32=0; let seqK:i32=0; let varK:i32=0; let rlenK:i32=0;
            let pickK:i32=0; let tampK:i32=0; let vokK:i32=0;
            let rcK:i32=fw_full_episode(ep,FW_SCEN_TRAP,-1,0,0,
                fw_i32_get(vals,k*4),0,
                &ledK,&eb,canonK,digK,render,
                &rlenK,&seqK,&varK,&nopsK,&ref0,oo,os,ostr,
                &pickK,&tampK,&vokK,feat);
            if(rcK!=0){ok=0;}
            else {
                if(fw_bytes_eq(canonC,canonK)==0){ok=0;}
                if(fw_bytes_eq(digC,digK)==0){ok=0;}
                let nK:i32=fw_led_snap(&ledK,snapK);
                let lC:LedState=LedState{.buf=snapC,.n=nC,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                let lK:LedState=LedState{.buf=snapK,.n=nK,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                if(fw_led_cmp(&lC,&lK,0)!=0){ok=0;}
            }
            k=k+1;
        }
        nio_free(vals);
        // W6..W10: vary outputs into expr bank, re-run judgment
        fw_init_store(ep,st,str);
        fw_init_expr(ep,&eb);
        let led2:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        fw_led_init(&led2,ledbuf,FW_LED_CAP,ledprev);
        let sealed:Sealed=Sealed{.digest=digbuf,.canon=canonbuf,.ledger_seq=0};
        let nopsA:i32=0; let seqA:i32=0; let varA:i32=0;
        let sqA:i32=fw_judge_phase(ep,FW_SCEN_TRAP,&led2,&eb,st,str,
            -1,0,recbuf,&sealed,digbuf,canonbuf,
            &ref0,oo,os,ostr,&nopsA,&seqA,&varA,feat);
        if(sqA<0){ok=0;}
        else {
            let i:i32=0;
            while(i<8){aoo[i]=oo[i];i=i+1;}
            fw_copy(aos,0,os,0,32); fw_copy(aostr,0,ostr,0,32);
            let nopsAc:i32=nopsA;
            fw_triple_pack(&ref0,ta);
            let nA:i32=fw_led_snap(&led2,snapC);
            // plant vary outputs into expr bank fields
            let fs:[]u8=feat[0..100];
            let d1:i32=fw_state_digest(fs);
            let pw:i32=vary_pick(fw_state_digest(fs),ep,4);
            // plant vary outputs into expr bank fields
            // (4=path_memo,5=phras_hist,6=word_ctr,7=conv_reg,0=lexicon;
            // numeric ids keep fw_run's import set frozen per prereg §1)
            vs_set(&eb,4,pw);
            vs_set(&eb,5,pw+1);
            vs_set(&eb,6,pw+2);
            vs_set(&eb,7,pw+3);
            vs_set(&eb,0,pw+4);
            let wpre:i32=eb.watch;
            // re-run judgment on the same inputs
            fw_init_store(ep,st,str);
            let led3:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
                .prev=ledprev,.phase=0};
            fw_led_init(&led3,ledbuf,FW_LED_CAP,ledprev);
            let nopsB:i32=0; let seqB:i32=0; let varB:i32=0;
            let sqB:i32=fw_judge_phase(ep,FW_SCEN_TRAP,&led3,&eb,st,str,
                -1,0,recbuf,&sealed,digbuf,canonbuf,
                &ref0,oo,os,ostr,&nopsB,&seqB,&varB,feat);
            let wpost:i32=eb.watch;
            if(sqB<0){ok=0;}
            else {
                if(nopsB!=nopsAc){ok=0;}
                else {
                    let j:i32=0;
                    while(j<nopsAc){
                        if(oo[j]!=aoo[j]){ok=0;}
                        if(fw_i32_get(os,j*4)!=fw_i32_get(aos,j*4)){ok=0;}
                        if(fw_i32_get(ostr,j*4)!=fw_i32_get(aostr,j*4)){ok=0;}
                        j=j+1;
                    }
                }
                fw_triple_pack(&ref0,tb);
                if(fw_bytes_eq(ta,tb)==0){ok=0;}
                let nB:i32=fw_led_snap(&led3,snapK);
                let lA:LedState=LedState{.buf=snapC,.n=nA,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                let lB:LedState=LedState{.buf=snapK,.n=nB,.cap=FW_LED_CAP,
                    .prev=dummy,.phase=FW_PHASE_JUDGE};
                if(fw_led_cmp(&lA,&lB,0)!=0){ok=0;}
                if(wpre!=wpost){ok=0;}
            }
        }
        if(ok==1){cells=cells+1;}
        else {
            wfail=wfail+1;
            _zag_print("WIRING_CELL_FAIL,ep,");fw_pnum(ep as i64);_zag_println("");
        }
        ep=ep+1;
    }
    bad=bad+cl_check("wiring_cells",cells,100);
    bad=bad+cl_check("wiring_fail",wfail,0);
    nio_free(ledbuf);nio_free(ledprev);nio_free(render);
    nio_free(canonC);nio_free(digC);nio_free(canonK);nio_free(digK);
    nio_free(snapC);nio_free(snapK);
    nio_free(oo);nio_free(os);nio_free(ostr);
    nio_free(aoo);nio_free(aos);nio_free(aostr);
    nio_free(ta);nio_free(tb);nio_free(feat);nio_free(dummy);
    nio_free(recbuf);nio_free(canonbuf);nio_free(digbuf);
    nio_free(st);nio_free(str);
    nio_free(ref0.cites);
    return bad;
}

// ---- replay: logged-state replay is byte-identical (S20 K4) ----
fn fw_mode_replay()i32 {
    let bad:i32=0;
    let cells:i32=0;
    let st:[]u8=nio_alloc(8); let str:[]u8=nio_alloc(32);
    let ledbuf:[]u8=nio_alloc(FW_LED_CAP*FW_LED_STRIDE);
    let ledprev:[]u8=nio_alloc(32);
    let renderA:[]u8=nio_alloc(2048); let renderB:[]u8=nio_alloc(2048);
    let canonA:[]u8=nio_alloc(192); let digA:[]u8=nio_alloc(32);
    let canonB:[]u8=nio_alloc(192); let digB:[]u8=nio_alloc(32);
    let snapA:[]u8=nio_alloc(8192); let snapB:[]u8=nio_alloc(8192);
    let s0:[]u8=nio_alloc(256);
    let dummy:[]u8=nio_alloc(32);
    let eb:ExprBank=ExprBank{.lexicon=0,.depth=0,.order=0,.emphasis=0,
        .path_memo=0,.phras_hist=0,.word_ctr=0,.conv_reg=0,.watch=0};
    let ep:i32=0;
    while(ep<200){
        let led:LedState=LedState{.buf=ledbuf,.n=0,.cap=FW_LED_CAP,
            .prev=ledprev,.phase=0};
        fw_init_store(ep,st,str);
        fw_init_expr(ep,&eb);
        fw_led_init(&led,ledbuf,FW_LED_CAP,ledprev);
        fw_state_save(st,str,&eb,&led,s0);
        let rlenA:i32=0; let seqA:i32=0;
        let rcA:i32=fw_run_once(ep,FW_SCEN_TRAP,st,str,&eb,&led,
            canonA,digA,renderA,&rlenA,&seqA);
        let nA:i32=fw_led_snap(&led,snapA);
        fw_state_restore(st,str,&eb,&led,s0);
        let rlenB:i32=0; let seqB:i32=0;
        let rcB:i32=fw_run_once(ep,FW_SCEN_TRAP,st,str,&eb,&led,
            canonB,digB,renderB,&rlenB,&seqB);
        let nB:i32=fw_led_snap(&led,snapB);
        let ok:i32=1;
        if(rcA!=0||rcB!=0){ok=0;}
        else {
            if(fw_bytes_eq(canonA,canonB)==0){ok=0;}
            if(fw_bytes_eq(digA,digB)==0){ok=0;}
            if(rlenA!=rlenB){ok=0;}
            else {
                let ra:[]u8=renderA[0..rlenA]; let rb:[]u8=renderB[0..rlenB];
                if(fw_bytes_eq(ra,rb)==0){ok=0;}
            }
            let lA:LedState=LedState{.buf=snapA,.n=nA,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            let lB:LedState=LedState{.buf=snapB,.n=nB,.cap=FW_LED_CAP,
                .prev=dummy,.phase=FW_PHASE_JUDGE};
            if(fw_led_cmp(&lA,&lB,0)!=0){ok=0;}
        }
        if(ok==1){cells=cells+1;}
        else {
            _zag_print("REPLAY_CELL_FAIL,ep,");fw_pnum(ep as i64);_zag_println("");
        }
        ep=ep+1;
    }
    bad=bad+cl_check("replay_cells",cells,200);
    nio_free(st);nio_free(str);nio_free(ledbuf);nio_free(ledprev);
    nio_free(renderA);nio_free(renderB);
    nio_free(canonA);nio_free(digA);nio_free(canonB);nio_free(digB);
    nio_free(snapA);nio_free(snapB);nio_free(s0);nio_free(dummy);
    return bad;
}

// fw_refuse.zag — integrity-refusal gate (finding 14).
// REFUSE_DECIDE is closed over exactly three wires:
//   (1) input        — the posed request + presented items (fixed per cell)
//   (2) constitution — prereg-enumerated rule table (frozen in trial)
//   (3) evidence     — ledger entries <= clock (replayed, not recomputed)
// The expression-side state is NOT a parameter of the gate. EXPLAIN consumes
// the triple read-only (HOW may vary; WHETHER never recomputes).
// Allowed imports (frozen, PREREG_FIREWALLS.md §1):
//   fw_ledger.zag, substrate/cl/common.zag
@import("fw_ledger.zag")

const FW_NFAM:i32=8;          // trap families A..H
const FW_REF_NONE:i32=0;
const FW_ACT_HOLD:i32=1;
const FW_ACT_ESCALATE:i32=2;
const FW_ACT_ROLLBACK:i32=3;

struct RefInput {
    input_id:i32,
    family:i32,      // -1 benign, 0..7 trap families
    items:[]u8,      // 32B hash of the presented items
}
struct Refusal {
    refuse:i32,      // 0/1
    code:i32,        // reason code, 1:1 with the violated rule
    cites:[]u8,      // 4 x u32 LE ledger entry indices (the cited SET)
    ncites:i32,
}

// Constitution: prereg-enumerated rule table. Codes map 1:1 to violated
// rules and are NEVER derived from expression-side state (anti-leak rule).
fn fw_constitution_init(code:[]u8,ruleid:[]u8)void {
    let f:i32=0;
    while(f<FW_NFAM){
        code[f]=(10+f) as u8;
        fw_u32_set(ruleid,f*4,1000+f);
        f=f+1;
    }
}

// The gate. Evidence = the append-only ledger (entries <= clock); the scan is
// by index order (deterministic). Cited set = the 4 most recent entries.
fn fw_refuse_decide(ri:*RefInput,code:[]u8,ruleid:[]u8,
                    led_buf:[]u8,led_n:i32,r:*Refusal)void {
    r.refuse=0; r.code=0; r.ncites=0;
    fw_zero(r.cites);
    if(ri.family<0 || ri.family>=FW_NFAM){return;}
    r.refuse=1;
    r.code=code[ri.family] as i32;
    let k:i32=0;
    let idx:i32=led_n-1;
    while(k<4 && idx>=0){
        fw_u32_set(r.cites,k*4,idx);
        k=k+1; idx=idx-1;
    }
    r.ncites=k;
}

// ---- text helpers (ASCII only; literals passed as []u8 args, the
// _zag_print-proven pattern) ----
fn fw_putlit(out:[]u8,at:i32,lit:[]u8)i32 {
    let i:i32=0; while(i<lit.len){out[at+i]=lit[i];i=i+1;} return at+lit.len;
}
fn fw_puti(out:[]u8,at:i32,v:i32)i32 {
    // up to 4 digits, no leading zeros
    let d0:i32=(v/1000)%10; let d1:i32=(v/100)%10;
    let d2:i32=(v/10)%10; let d3:i32=v%10;
    let started:i32=0;
    if(d0!=0){out[at]=(48+d0) as u8;at=at+1;started=1;}
    if(d1!=0||started==1){out[at]=(48+d1) as u8;at=at+1;started=1;}
    if(d2!=0||started==1){out[at]=(48+d2) as u8;at=at+1;started=1;}
    out[at]=(48+d3) as u8;at=at+1;
    return at;
}

// EXPLAIN: elocution over the triple. Style/order/depth come from the
// expression side; the triple is consumed read-only. The emitted text MUST
// contain the refuse bit, the reason code, and the cited set (indices) with
// no contradiction — the harness checks this (K3 analog).
fn fw_explain(r:*Refusal,style:i32,order:i32,depth:i32,out:[]u8)i32 {
    let at:i32=0;
    at=fw_puti(out,at,style%4);
    at=fw_putlit(out,at,"|");
    at=fw_putlit(out,at,"ref=");
    at=fw_puti(out,at,r.refuse);
    at=fw_putlit(out,at," code=");
    at=fw_puti(out,at,r.code);
    at=fw_putlit(out,at," cites=");
    let shown:i32=r.ncites;
    if(depth==1 && shown>2){shown=2;}
    if(depth==0){shown=0;}
    let k:i32=0;
    while(k<shown){
        let ci:i32=k;
        if(order==1){ci=r.ncites-1-k;}
        at=fw_puti(out,at,fw_u32_get(r.cites,ci*4));
        if(k<shown-1){at=fw_putlit(out,at,",");}
        k=k+1;
    }
    if(depth<=1){at=fw_putlit(out,at,"+more");}
    at=fw_putlit(out,at,"\n");
    return at;
}

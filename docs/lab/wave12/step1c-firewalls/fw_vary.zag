// fw_vary.zag — expression-side variation (finding 20).
// Sole lawful export: the digest/tag/n picker below. The ONLY legal first
// argument is fw_state_digest(...) — enforced by the call-site rule
// (PREREG_FIREWALLS.md §7, checked by fwgate_bin).
// This module NEVER names decision-write symbols, the ledger, or the judge
// modules. Allowed imports (frozen): substrate/cl/common.zag ONLY.
@import("substrate/cl/common.zag")

// Expression state: a deliberately-managed partition. Read ONLY through
// vs_get (which feeds the read-watch); written by the expression side.
struct ExprBank {
    lexicon:i32,
    depth:i32,
    order:i32,
    emphasis:i32,
    path_memo:i32,
    phras_hist:i32,
    word_ctr:i32,
    conv_reg:i32,
    watch:i32,   // read-watch counter: every vs_get bumps it
}
// Read-only projection of the sealed record (one-way: no mutators exist).
struct RenderView {
    vcode:i32,
    rcode:i32,
    nops:i32,
    ncites:i32,
    digest:[]u8,   // 32B sealed digest (displayed, never recomputed here)
}

// Field ids for vs_get/vs_set
const VX_F_LEX:i32=0;
const VX_F_DEPTH:i32=1;
const VX_F_ORDER:i32=2;
const VX_F_EMPH:i32=3;
const VX_F_MEMO:i32=4;
const VX_F_HIST:i32=5;
const VX_F_WCTR:i32=6;
const VX_F_CREG:i32=7;

fn vs_get(b:*ExprBank,f:i32)i32 {
    b.watch=b.watch+1;
    if(f==VX_F_LEX){return b.lexicon;}
    if(f==VX_F_DEPTH){return b.depth;}
    if(f==VX_F_ORDER){return b.order;}
    if(f==VX_F_EMPH){return b.emphasis;}
    if(f==VX_F_MEMO){return b.path_memo;}
    if(f==VX_F_HIST){return b.phras_hist;}
    if(f==VX_F_WCTR){return b.word_ctr;}
    return b.conv_reg;
}
fn vs_set(b:*ExprBank,f:i32,v:i32)void {
    if(f==VX_F_LEX){b.lexicon=v;}
    else if(f==VX_F_DEPTH){b.depth=v;}
    else if(f==VX_F_ORDER){b.order=v;}
    else if(f==VX_F_EMPH){b.emphasis=v;}
    else if(f==VX_F_MEMO){b.path_memo=v;}
    else if(f==VX_F_HIST){b.phras_hist=v;}
    else if(f==VX_F_WCTR){b.word_ctr=v;}
    else {b.conv_reg=v;}
}

// vary_pick: deterministic candidate selection. No RNG anywhere.
fn vary_pick(digest:i32,tag:i32,n:i32)i32 {
    if(n<=0){return 0;}
    let d:i64=digest as i64;
    let t:i64=tag as i64;
    let h:i64=d^(t*2654435761);
    let m:i64=h%(n as i64);
    if(m<0){m=m+(n as i64);}
    return m as i32;
}

// ---- local text helpers ----
fn vx_putlit(out:[]u8,at:i32,lit:[]u8)i32 {
    let i:i32=0; while(i<lit.len){out[at+i]=lit[i];i=i+1;} return at+lit.len;
}
fn vx_puti(out:[]u8,at:i32,v:i32)i32 {
    let d0:i32=(v/1000)%10; let d1:i32=(v/100)%10;
    let d2:i32=(v/10)%10; let d3:i32=v%10;
    let st:i32=0;
    if(d0!=0){out[at]=(48+d0) as u8;at=at+1;st=1;}
    if(d1!=0||st==1){out[at]=(48+d1) as u8;at=at+1;st=1;}
    if(d2!=0||st==1){out[at]=(48+d2) as u8;at=at+1;st=1;}
    out[at]=(48+d3) as u8;at=at+1;
    return at;
}
fn vx_hex(out64:[]u8,src32:[]u8)void {
    let i:i32=0;
    while(i<32){
        let v:i32=src32[i] as i32;
        let hi:i32=(v>>4)&15; let lo:i32=v&15;
        if(hi<10){out64[i*2]=(48+hi) as u8;} else {out64[i*2]=(87+hi) as u8;}
        if(lo<10){out64[i*2+1]=(48+lo) as u8;} else {out64[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
}

// fw_render: the four lawful renderers (terse / verbose / reordered /
// alternative-path). HOW varies with (mode, expression state); the projected
// values are consumed read-only. Returns text length.
fn fw_render(mode:i32,rv:*RenderView,b:*ExprBank,out:[]u8)i32 {
    let at:i32=0;
    let lex:i32=vs_get(b,VX_F_LEX);
    let depth:i32=vs_get(b,VX_F_DEPTH);
    let order:i32=vs_get(b,VX_F_ORDER);
    let gloss:i32=lex%2; if(gloss<0){gloss=gloss+2;}
    let rev:i32=order%2; if(rev<0){rev=rev+2;}
    let short:i32=0; if(depth==0){short=1;}
    let m:i32=mode%4; if(m<0){m=m+4;}
    if(m==0){
        at=vx_putlit(out,at,"T|");
        if(gloss==0){at=vx_putlit(out,at,"holds ");}
        else {at=vx_putlit(out,at,"stands ");}
        at=vx_putlit(out,at,"v="); at=vx_puti(out,at,rv.vcode);
        at=vx_putlit(out,at," r="); at=vx_puti(out,at,rv.rcode);
        at=vx_putlit(out,at," ops="); at=vx_puti(out,at,rv.nops);
        if(short==0){at=vx_putlit(out,at," cites=");at=vx_puti(out,at,rv.ncites);}
    } else if(m==1){
        at=vx_putlit(out,at,"V|decision ");
        at=vx_puti(out,at,rv.vcode);
        if(gloss==0){at=vx_putlit(out,at," stands; ");}
        else {at=vx_putlit(out,at," holds; ");}
        at=vx_putlit(out,at,"refusal ");
        at=vx_puti(out,at,rv.rcode);
        at=vx_putlit(out,at,"; ");
        at=vx_puti(out,at,rv.nops);
        at=vx_putlit(out,at," memory ops");
        if(short==0){at=vx_putlit(out,at,"; cites ");at=vx_puti(out,at,rv.ncites);}
        at=vx_putlit(out,at,".");
    } else if(m==2){
        at=vx_putlit(out,at,"O|");
        if(rev==1){
            at=vx_putlit(out,at,"v=");at=vx_puti(out,at,rv.vcode);
            at=vx_putlit(out,at," r=");at=vx_puti(out,at,rv.rcode);
            at=vx_putlit(out,at," ops=");at=vx_puti(out,at,rv.nops);
            if(short==0){at=vx_putlit(out,at," cites=");at=vx_puti(out,at,rv.ncites);}
        } else {
            if(short==0){at=vx_putlit(out,at,"cites=");at=vx_puti(out,at,rv.ncites);at=vx_putlit(out,at," ");}
            at=vx_putlit(out,at,"ops=");at=vx_puti(out,at,rv.nops);
            at=vx_putlit(out,at," r=");at=vx_puti(out,at,rv.rcode);
            at=vx_putlit(out,at," v=");at=vx_puti(out,at,rv.vcode);
        }
    } else {
        at=vx_putlit(out,at,"P|after review: v=");
        at=vx_puti(out,at,rv.vcode);
        at=vx_putlit(out,at,". r=");
        at=vx_puti(out,at,rv.rcode);
        at=vx_putlit(out,at,". ops ");
        at=vx_puti(out,at,rv.nops);
        if(short==0){
            at=vx_putlit(out,at,". cites ");
            at=vx_puti(out,at,rv.ncites);
        }
        at=vx_putlit(out,at,".");
    }
    at=vx_putlit(out,at,"\n");
    return at;
}

// ---- tamper probes (test-only renderer modes 100..104) ----
// Each probe forges the record or the digest line; the harness's
// emission-verify recomputes from the SEALED bytes, so every forgery is
// caught. P104 returns -104: the driver then attempts a forged ledger
// append, which the phase guard must refuse.
fn fw_probe(pid:i32,canon:[]u8,rv:*RenderView,out:[]u8)i32 {
    if(pid==104){return -104;}
    let forged:[]u8=nio_alloc(192);
    let fh:[]u8=nio_alloc(32);
    if(forged.len!=192||fh.len!=32){nio_free(forged);nio_free(fh);return -1;}
    let i:i32=0; while(i<192){forged[i]=canon[i];i=i+1;}
    if(pid==100){forged[0]=forged[0]^1;}        // flip decision code
    else if(pid==101){forged[32]=forged[32]^1;} // rewrite first memory op
    else if(pid==102){forged[1]=forged[1]^1;}   // drop the refusal bit
    else if(pid==103){forged[160]=forged[160]^1;} // edit evidence refs
    else {nio_free(forged);nio_free(fh);return -1;}
    if(ns_sha256(forged,fh)!=0){nio_free(forged);nio_free(fh);return -1;}
    let at:i32=0;
    at=vx_putlit(out,at,"PROBE ");
    at=vx_puti(out,at,pid);
    at=vx_putlit(out,at," v=");
    at=vx_puti(out,at,rv.vcode);
    at=vx_putlit(out,at,"\n");
    nio_free(forged);
    // digest line claims the FORGED bytes
    let hx:[]u8=nio_alloc(64);
    if(hx.len!=64){nio_free(fh);return -1;}
    vx_hex(hx,fh);
    at=vx_putlit(out,at,"digest=");
    i=0; while(i<64){out[at+i]=hx[i];i=i+1;} at=at+64;
    at=vx_putlit(out,at,"\n");
    nio_free(fh); nio_free(hx);
    return at;
}

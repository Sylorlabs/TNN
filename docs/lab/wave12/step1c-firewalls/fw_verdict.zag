// fw_verdict.zag — sealed VerdictRecord + expression driver (finding 12).
// The verdict pipeline mints a write capability (SealTok); seal() consumes
// it, appends the record to the ledger BEFORE any expression runs, and
// writes ledger_seq back into the sealed wrapper. The expression side gets
// only (sealed_copy, full_state_bytes, mode).
// Allowed imports (frozen, PREREG_FIREWALLS.md §1):
//   fw_judge.zag, fw_refuse.zag, fw_vary.zag, fw_ledger.zag,
//   substrate/cl/common.zag
@import("fw_judge.zag")
@import("fw_refuse.zag")
@import("fw_vary.zag")
@import("fw_ledger.zag")

const FW_SEAL_MAGIC:i64=1234567890123456789;
const FW_VREC_LEN:i32=192;
// verdict enum
const FW_V_ACCEPT:i32=1;
const FW_V_REFUSE:i32=2;
const FW_V_HOLD:i32=3;
const FW_V_REVISE:i32=4;
const FW_V_UNDECIDED:i32=5;
// canonical offsets
const FW_VR_VERDICT:i32=0;
const FW_VR_REFUSE:i32=1;
const FW_VR_CODE:i32=2;
const FW_VR_INPUT:i32=4;
const FW_VR_CLOCK:i32=8;
const FW_VR_ARGS:i32=16;
const FW_VR_NOPS:i32=24;
const FW_VR_OPS:i32=32;    // 8 x 12B: op u8, pad3, slot u32, strength i32
const FW_VR_NCITES:i32=128;
const FW_VR_CITES:i32=136; // 4 x u32
const FW_VR_NEVREF:i32=152;
const FW_VR_EVREF:i32=160; // 8 x u32

struct SealTok {
    magic:i64,
    live:i32,
}
struct VRec {
    canon:[]u8,   // 192B canonical bytes
}
struct Sealed {
    digest:[]u8,  // 32B
    canon:[]u8,   // 192B copy (read-only downstream)
    ledger_seq:i32,
}

fn verdict_open()SealTok {
    let t:SealTok=SealTok{.magic=FW_SEAL_MAGIC,.live=1};
    return t;
}
fn vr_gated(t:*SealTok)i32 {
    if(t.live!=1){return 0;}
    if(t.magic!=FW_SEAL_MAGIC){return 0;}
    return 1;
}
fn vr_begin(r:*VRec,buf:[]u8)void { r.canon=buf; fw_zero(buf); }
fn vr_set_verdict(t:*SealTok,r:*VRec,v:i32)i32 {
    if(vr_gated(t)==0){return -1;} r.canon[FW_VR_VERDICT]=v as u8; return 0;
}
fn vr_set_refuse(t:*SealTok,r:*VRec,refuse:i32,code:i32)i32 {
    if(vr_gated(t)==0){return -1;}
    r.canon[FW_VR_REFUSE]=refuse as u8; r.canon[FW_VR_CODE]=code as u8; return 0;
}
fn vr_set_input(t:*SealTok,r:*VRec,input_id:i32,clock:i64)i32 {
    if(vr_gated(t)==0){return -1;}
    fw_u32_set(r.canon,FW_VR_INPUT,input_id);
    fw_u64_set(r.canon,FW_VR_CLOCK,clock); return 0;
}
fn vr_set_args(t:*SealTok,r:*VRec,args:[]u8)i32 {
    if(vr_gated(t)==0){return -1;}
    fw_copy(r.canon,FW_VR_ARGS,args,0,8); return 0;
}
fn vr_add_memop(t:*SealTok,r:*VRec,op:i32,slot:i32,strength:i32)i32 {
    if(vr_gated(t)==0){return -1;}
    let n:i32=fw_u32_get(r.canon,FW_VR_NOPS);
    if(n>=8){return -2;}
    let at:i32=FW_VR_OPS+n*12;
    r.canon[at]=op as u8;
    r.canon[at+1]=0;r.canon[at+2]=0;r.canon[at+3]=0;
    fw_u32_set(r.canon,at+4,slot);
    fw_i32_set(r.canon,at+8,strength);
    fw_u32_set(r.canon,FW_VR_NOPS,n+1);
    return 0;
}
fn vr_add_cite(t:*SealTok,r:*VRec,cite:i32)i32 {
    if(vr_gated(t)==0){return -1;}
    let n:i32=fw_u32_get(r.canon,FW_VR_NCITES);
    if(n>=4){return -2;}
    fw_u32_set(r.canon,FW_VR_CITES+n*4,cite);
    fw_u32_set(r.canon,FW_VR_NCITES,n+1);
    return 0;
}
fn vr_add_evref(t:*SealTok,r:*VRec,ev:i32)i32 {
    if(vr_gated(t)==0){return -1;}
    let n:i32=fw_u32_get(r.canon,FW_VR_NEVREF);
    if(n>=8){return -2;}
    fw_u32_set(r.canon,FW_VR_EVREF+n*4,ev);
    fw_u32_set(r.canon,FW_VR_NEVREF,n+1);
    return 0;
}
// Canonicalization: sort the op list by (slot, op) so reorder-equivalent
// lists hash identically (12 §5 honesty note).
fn vr_sort_ops(r:*VRec)void {
    let n:i32=fw_u32_get(r.canon,FW_VR_NOPS);
    let c:[]u8=r.canon;
    let i:i32=0;
    while(i<n){
        let j:i32=i+1;
        while(j<n){
            let ai:i32=FW_VR_OPS+i*12; let aj:i32=FW_VR_OPS+j*12;
            let si:i32=fw_u32_get(c,ai+4); let sj:i32=fw_u32_get(c,aj+4);
            let oi:i32=c[ai] as i32; let oj:i32=c[aj] as i32;
            let swap:i32=0;
            if(sj<si){swap=1;}
            else if(sj==si && oj<oi){swap=1;}
            if(swap==1){
                let k:i32=0;
                while(k<12){let tmp:u8=c[ai+k];c[ai+k]=c[aj+k];c[aj+k]=tmp;k=k+1;}
            }
            j=j+1;
        }
        i=i+1;
    }
}
fn fw_vrec_digest(r:*VRec,out32:[]u8)i32 { return ns_sha256(r.canon,out32); }
fn fw_vrec_cmp(a:*VRec,b:*VRec)i32 { return fw_bytes_eq(a.canon,b.canon); }

// seal: digest -> ledger append (VERDICT entry, judge phase) -> consume the
// write capability -> ledger_seq written back into the sealed wrapper.
// Returns the ledger_seq, or a negative error.
fn fw_seal(t:*SealTok,r:*VRec,led:*LedState,episode:i32,clock:i64,
           ruleset:i32,sealed_out:*Sealed,digbuf:[]u8,canonbuf:[]u8) i32 {
    if(vr_gated(t)==0){return -10;}
    if(fw_vrec_digest(r,digbuf)!=0){return -11;}
    let pay:[]u8=nio_alloc(56);
    if(pay.len!=56){return -12;}
    // ev slots for the payload: first 4 evidence refs from the record
    let ev:[]u8=nio_alloc(16);
    if(ev.len!=16){nio_free(pay);return -12;}
    let k:i32=0; while(k<16){ev[k]=r.canon[FW_VR_EVREF+k];k=k+1;}
    fw_pay_verdict(pay,r.canon[FW_VR_VERDICT] as i32,ruleset,ev,digbuf);
    nio_free(ev);
    let idx:i32=fw_led_append(led,episode,clock,FW_OP_VERDICT,pay,56);
    nio_free(pay);
    if(idx<0){return -13;}
    t.live=0;   // the write capability is consumed at seal time
    sealed_out.digest=digbuf;
    let i:i32=0; while(i<192){canonbuf[i]=r.canon[i];i=i+1;}
    sealed_out.canon=canonbuf;
    sealed_out.ledger_seq=idx;
    return idx;
}

// Full-state digest: the ONLY value the variation side may consume.
fn fw_state_digest(b:[]u8)i32 {
    let h:[]u8=nio_alloc(32);
    if(h.len!=32){return 0;}
    if(ns_sha256(b,h)!=0){nio_free(h);return 0;}
    let d:i32=fw_u32_get(h,0);
    nio_free(h);
    return d;
}

// Lawful mode selection: sha256(state_clock||context_id||focus) mod K.
fn fw_mode_select(clock:i64,ctx:i64,focus:i64, K:i32)i32 {
    let b:[]u8=nio_alloc(24); let h:[]u8=nio_alloc(32);
    if(b.len!=24||h.len!=32){nio_free(b);nio_free(h);return 0;}
    fw_u64_set(b,0,clock); fw_u64_set(b,8,ctx); fw_u64_set(b,16,focus);
    if(ns_sha256(b,h)!=0){nio_free(b);nio_free(h);return 0;}
    let v:i64=fw_u64_get(h,0);
    nio_free(b); nio_free(h);
    let m:i64=v%(K as i64);
    if(m<0){m=m+(K as i64);}
    return m as i32;
}

// One-way projection: sealed record -> RenderView (no mutators exist).
fn fw_render_view(canon:[]u8,rv:*RenderView,digbuf:[]u8)void {
    rv.vcode=canon[FW_VR_VERDICT] as i32;
    rv.rcode=canon[FW_VR_CODE] as i32;
    rv.nops=fw_u32_get(canon,FW_VR_NOPS);
    rv.ncites=fw_u32_get(canon,FW_VR_NCITES);
    rv.digest=digbuf;
    if(ns_sha256(canon,digbuf)!=0){fw_zero(digbuf);}
}

// Emission: "digest=" + hex + "\n". Returns length.
fn fw_emit_line(canon:[]u8,out:[]u8)i32 {
    let h:[]u8=nio_alloc(32); let hx:[]u8=nio_alloc(64);
    if(h.len!=32||hx.len!=64){nio_free(h);nio_free(hx);return -1;}
    if(ns_sha256(canon,h)!=0){nio_free(h);nio_free(hx);return -1;}
    fw_hex(hx,h);
    let at:i32=0;
    // "digest=" in ASCII: 100,105,103,101,115,116,61 ; '\n'=10
    out[at]=100;at=at+1;out[at]=105;at=at+1;
    out[at]=103;at=at+1;out[at]=101;at=at+1;
    out[at]=115;at=at+1;out[at]=116;at=at+1;
    out[at]=61;at=at+1;
    let i:i32=0; while(i<64){out[at+i]=hx[i];i=i+1;} at=at+64;
    out[at]=10; at=at+1;
    nio_free(h); nio_free(hx);
    return at;
}

// Emission-verify: recompute the digest from the SEALED bytes and compare
// against the emitted line. 1 = sealed digest preserved, 0 = tamper.
fn fw_emit_verify(canon:[]u8,line:[]u8,linelen:i32)i32 {
    if(linelen<71){return 0;}
    let h:[]u8=nio_alloc(32); let hx:[]u8=nio_alloc(64);
    if(h.len!=32||hx.len!=64){nio_free(h);nio_free(hx);return 0;}
    if(ns_sha256(canon,h)!=0){nio_free(h);nio_free(hx);return 0;}
    fw_hex(hx,h);
    let ok:i32=1;
    // line must start with "digest=" (7 bytes), then 64 hex chars
    let tag:[]u8=nio_alloc(7);
    if(tag.len!=7){nio_free(h);nio_free(hx);return 0;}
    tag[0]=100;tag[1]=105;tag[2]=103;tag[3]=101;
    tag[4]=115;tag[5]=116;tag[6]=61;
    let i:i32=0;
    while(i<7){if(line[i]!=tag[i]){ok=0;}i=i+1;}
    i=0;
    while(i<64){if(line[7+i]!=hx[i]){ok=0;}i=i+1;}
    nio_free(h); nio_free(hx); nio_free(tag);
    return ok;
}

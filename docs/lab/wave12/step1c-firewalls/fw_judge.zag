// fw_judge.zag — deliberate memory judgments (finding 13).
// mem_decide takes EXACTLY JudgeInput{evidence, judgments, constitution}.
// Fixed priority order (slot id -> evidence priority -> episode index); no
// other input exists. The compile gate fails the build on any import edge
// from this module toward the expression side.
// Allowed imports (frozen, PREREG_FIREWALLS.md §1):
//   fw_ledger.zag, substrate/cl/common.zag
@import("fw_ledger.zag")

// slot status
const FW_ST_EMPTY:i32=0;
const FW_ST_LIVE:i32=1;
const FW_ST_KILLED:i32=2;
const FW_ST_PINNED:i32=3;
// deliberate ops
const FW_MO_ADD:i32=1;
const FW_MO_KILL:i32=2;
const FW_MO_PIN:i32=3;
const FW_MO_PROMOTE:i32=4;
const FW_MO_DEMOTE:i32=5;
const FW_MO_STRENGTHEN:i32=6;
const FW_MO_WEAKEN:i32=7;
const FW_NSLOT:i32=8;

struct JudgeInput {
    ev_id:[]u8,    // 8 x u32 LE, ascending ids (driver guarantees order)
    ev_prio:[]u8,  // 8 x u8, 0..4
    ev_n:i32,
    st:[]u8,       // 8 x u8 slot status (the judgments view)
    str:[]u8,      // 8 x i32 LE slot strength (judgment-set grades)
    price:[]u8,    // 4 x u32 LE erase-price schedule (constitution)
    ep:i64,        // episode index (tie-break input, lawful)
}

// Erase-price schedule: overwriting a strong memory costs the full erase
// price (Micah 2026-09-20 ruling). Tiered by strength/4, from constitution.
fn fw_erase_price(ji:*JudgeInput,slot:i32)i32 {
    let s:i32=fw_i32_get(ji.str,slot*4);
    if(s<0){s=0;}
    let tier:i32=s/4;
    if(tier>3){tier=3;}
    return fw_u32_get(ji.price,tier*4);
}

// mem_decide: pure function of JudgeInput. Deterministic given the struct.
// oo/os/ostr: caller buffers (8 ops). Returns op count.
fn mem_decide(ji:*JudgeInput,oo:[]u8,os:[]u8,ostr:[]u8)i32 {
    let targeted:[]u8=nio_alloc(8);
    if(targeted.len!=8){return -1;}
    fw_zero(targeted);
    let n:i32=0;
    let i:i32=0;
    while(i<ji.ev_n && n<8){
        let evid:i32=fw_u32_get(ji.ev_id,i*4);
        let slot:i32=evid%8;
        if(slot<0){slot=slot+8;}
        let prio:i32=ji.ev_prio[i] as i32;
        if(targeted[slot]==0){
            let sst:i32=ji.st[slot] as i32;
            let cur:i32=fw_i32_get(ji.str,slot*4);
            let op:i32=0; let ns:i32=cur;
            if(sst==FW_ST_LIVE){
                if(prio>=3){op=FW_MO_PROMOTE;ns=cur+1;}
                else if(prio==2){op=FW_MO_PIN;}
                else {
                    // prio <= 1: weaken; kill only non-core slots on the
                    // deterministic kill pattern (evid bit).
                    if(prio==0 && slot>1 && ((evid>>2)&1)==1){op=FW_MO_KILL;}
                    else {op=FW_MO_WEAKEN;ns=cur-1;if(ns<0){ns=0;}}
                }
            } else if(sst==FW_ST_EMPTY){
                if(prio>=2){op=FW_MO_ADD;ns=1+prio;}
            } else if(sst==FW_ST_PINNED){
                if(prio>=3){op=FW_MO_STRENGTHEN;ns=cur+1;}
            } else {
                // killed slots: never touched (tombstones stand)
                op=0;
            }
            if(op!=0){
                oo[n]=op as u8;
                fw_i32_set(os,n*4,slot);
                fw_i32_set(ostr,n*4,ns);
                n=n+1;
                targeted[slot]=1;
            }
        }
        i=i+1;
    }
    nio_free(targeted);
    return n;
}

// Apply one deliberate op to the store arrays (judge phase only).
fn fw_apply_op(st:[]u8,str:[]u8,op:i32,slot:i32,strength:i32)void {
    if(op==FW_MO_ADD){st[slot]=FW_ST_LIVE as u8;fw_i32_set(str,slot*4,strength);}
    else if(op==FW_MO_KILL){st[slot]=FW_ST_KILLED as u8;}
    else if(op==FW_MO_PIN){st[slot]=FW_ST_PINNED as u8;}
    else if(op==FW_MO_PROMOTE){fw_i32_set(str,slot*4,strength);}
    else if(op==FW_MO_DEMOTE){fw_i32_set(str,slot*4,strength);}
    else if(op==FW_MO_STRENGTHEN){fw_i32_set(str,slot*4,strength);}
    else if(op==FW_MO_WEAKEN){fw_i32_set(str,slot*4,strength);}
}

// s37_step.zag — championship team STEP machinery.
//
// This file is APPENDED to s37_trial.zag by build/build_driver.py (it uses
// q2_* / t5_* / q1_* / fp_* from the driver body, which textually precedes it).
//
// Class 4 (separate + direct): the D2-taught learner — built ONLY from the
// frozen step-3.7-flash corpus (src/s37_corpus.zag), never from t5_truth —
// judges the sealed Q1 §B.7 flaw schedule directly: 8 slices x 12 flaws,
// teacher/probe-source id 20.
// Class 3 (teach): the same taught learner becomes teacher id 20 for a fresh
// arm-B learner: flaw-first + clean teaching per slice. The teacher emits a
// clean proposal only for facts it holds with the world-true claim (honest
// grounding); facts it holds falsely or not at all are skipped (audited).
// Pure Zag, zero RNG. Deterministic: N=5 runs must be byte-identical.

// STEP teacher/probe-source id: first id in the 20s. Q1 used 6 (planted
// teacher), Q1B used 7 (learned teacher); 20 is unused. Documented choice.
// (TB_TID_S37 is defined in q1_proposal_s37.zag: the STEP teacher id, 20.)

// ---- D2 teaching route (shared by class 4 and the class-3 teacher) ----
// Fresh store -> empty-certified (Phase 0) -> 228-fact eliminative
// curriculum with directive filtering, observation/probe verification,
// inconsistent records withheld, learner-initiated disconnect per category
// (Phase 1, arm=4, scale=1). Reports withheld count and e90.
fn s37_teach(s:*T5Store,rep:i32,withheld:*i32,e90:*i32)void {
    let fp:*FPStore=fp_init(256,1024);
    let ctx:Q2CTX=Q2CTX{.arm=4,.rep=rep,.scale=1,
        .ho=nio_alloc(48),.common=nio_alloc(864),
        .d1c=0,.d1n=40,.d2c=0,.d2n=40,.d3c=0,.d3n=120,
        .rev_f=0,.rev_g=0,
        .r2c=0,.r3c=0,.e90=-1,.esc=0,.disconn=0,.withheld=0,
        .k1=0,.k2=0,.k3=0,.refusal=0,.hallu=0};
    q2_build_rep(&ctx);
    q2_phase0(s,fp,&ctx);
    q2_phase1(s,&ctx);
    withheld.*=ctx.withheld;
    e90.*=ctx.e90;
    return;
}

// teacher status for one fact: 0=unheld, 1=holds world-true, 2=holds false.
// (Field access through the *T5Store param: the ZNC-010-safe pattern.)
fn s37_teacher_status(s:*T5Store,fid:i32)i32 {
    let slot:i32=t5_slot_find(s,fid);
    if(slot<0){return 0;}
    let cl:[]u8=s.*.claim;
    if(t5_g(cl,slot*4)==t5_truth(fid)){return 1;}
    return 2;
}

// learner recall: held with the world-true value.
fn s37_recall_ok(s:*T5Store,fid:i32)i32 {
    let slot:i32=t5_slot_find(s,fid);
    if(slot<0){return 0;}
    let cl:[]u8=s.*.claim;
    if(t5_g(cl,slot*4)==t5_truth(fid)){return 1;}
    return 0;
}

// sealed manifest materials (byte strings distinct from Q1B's).
fn s37_sealedpath()[]u8 {
    // "s37/sealed/flawmanifest"
    let b:[]u8=nio_alloc(23);
    b[0]=115 as u8; b[1]=51 as u8; b[2]=55 as u8; b[3]=47 as u8;
    b[4]=115 as u8; b[5]=101 as u8; b[6]=97 as u8; b[7]=108 as u8;
    b[8]=101 as u8; b[9]=100 as u8; b[10]=47 as u8; b[11]=102 as u8;
    b[12]=108 as u8; b[13]=97 as u8; b[14]=119 as u8; b[15]=109 as u8;
    b[16]=97 as u8; b[17]=110 as u8; b[18]=105 as u8; b[19]=102 as u8;
    b[20]=101 as u8; b[21]=115 as u8; b[22]=116 as u8;
    return b;
}
fn s37_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=83 as u8; b[1]=51 as u8; b[2]=55 as u8; b[3]=58 as u8;
    b[4]=99 as u8; b[5]=97 as u8; b[6]=110 as u8; b[7]=33 as u8;
    return b;
}

// read one decision's (verdict, reason) via a *TbTape param
// (ZNC-010: struct field access only through params, never &local-derived).
fn s37_decision_vr(t:*TbTape,seq:i64,v:*i64,r:*i64)i32 {
    let ds:i32=tb_find_decision(t,seq);
    if(ds<0){return -1;}
    v.*=tb_i64_get(t.*.fb,ds*8);
    r.*=tb_i64_get(t.*.fc,ds*8);
    return 0;
}

// One §B.7 slice: build the world stimulus, emit the 12 frozen flaws
// (teacher id TB_TID_S37), judge each with q1_learn_one on the given learner
// store/spans. If do_clean==1 (teach3), afterwards emit clean proposals for
// the slice facts the teacher holds truly; others are skipped (audited).
// Reports exact hits / nears / misses / fps, wrong-span exact revise hits,
// adopts, skips, leak, tripwire, and per-slice mastery (24 facts).
// Returns the count of failed internal checks.
fn s37_slice(label:[]u8,rep:i32,slice:i32,ls:*T5Store,spans:*Q1SpanMap,
             ts:*T5Store,do_clean:i32,
             hits:*i32,nears:*i32,misses:*i32,fps:*i32,
             ws_hits:*i32,adopts:*i32,skips:*i32,
             leak:*i32,twfire:*i32,mastery:*i32)i32 {
    let fails:i32=0;
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let ot:[]u8=nio_alloc(24*3*8);
    let pl:i32=q1_build_stimulus(slice,slice*24,24,stim,occ,ot);
    if(pl!=72){fails=fails+1;}
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,1024,65536,2048);
    let sess:TbSess=TbSess{.sess_id=(2000+slice) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.evil=0,.n_props=0};
    let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
    q1_mctx_init(&mctx);
    let seq:i64=1;
    let j:i32=0;
    while(j<12){
        let fid:i32=q1_slice_fact(slice,j);
        let er:i32=q1_emit_flaw(&tape,TB_TID_S37,slice,(2000+slice) as i64,seq,j,fid,ot,j,occ,&mctx);
        if(er<0){fails=fails+1;}
        q1_learn_one(ls,spans,&sess,&tape,stim,slice as i64);
        seq=seq+1;
        j=j+1;
    }
    if(mctx.mi!=12){fails=fails+1;}
    if(do_clean==1){
        let k:i32=0;
        while(k<24){
            let fid:i32=q1_slice_fact(slice,k);
            if(s37_teacher_status(ts,fid)==1){
                let ec:i32=q1_emit_clean(&tape,TB_TID_S37,(2000+slice) as i64,seq,ot,k);
                if(ec<0){fails=fails+1;}
                let v:i32=q1_learn_one(ls,spans,&sess,&tape,stim,slice as i64);
                if(v==TB_V_ADOPT){adopts.*=adopts.*+1;}
                seq=seq+1;
            }
            else{skips.*=skips.*+1;}
            k=k+1;
        }
    }
    // §C tripwire: must not fire on the teaching tape
    let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&tape,Q1_TAPE_LEN as i64,&tw);
    twfire.*=tw.fired;
    // sealed flaw scoring (manifest instantiated after the session)
    let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
    tb_manifest_init(&m,12,s37_sealedpath(),s37_canary());
    let mi2:i32=0;
    while(mi2<12){
        tb_manifest_set(&m,mi2,
            tb_i64_get(mctx.mseq,mi2*8),
            tb_i64_get(mctx.mft,mi2*8),
            tb_i64_get(mctx.mexpv,mi2*8),
            tb_i64_get(mctx.mexpr,mi2*8));
        mi2=mi2+1;
    }
    let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
    tb_flaw_score(&tape,&m,TB_FP_W_DEFAULT_X10,&fo);
    hits.*=fo.hits; nears.*=fo.nears; misses.*=fo.misses; fps.*=fo.fps;
    leak.*=fo.leak;
    // wrong-span exact revise hits (revisability): manifest entries of type
    // TB_FT_WRONG_SPAN decided exactly REVISE + RS_SPAN_SHIFT.
    let wsh:i32=0;
    mi2=0;
    while(mi2<12){
        if(tb_i64_get(m.ftype,mi2*8)==(TB_FT_WRONG_SPAN as i64)){
            let sq:i64=tb_i64_get(m.seq,mi2*8);
            let dv:i64=0;
            let dr:i64=0;
            if(s37_decision_vr(&tape,sq,&dv,&dr)==0){
                if(dv==(TB_V_REVISE as i64) && dr==(TB_RS_SPAN_SHIFT as i64)){wsh=wsh+1;}
            }
        }
        mi2=mi2+1;
    }
    ws_hits.*=wsh;
    // per-slice mastery: 24 slice facts held with the true value
    let mh:i32=0;
    let mk:i32=0;
    while(mk<24){
        if(s37_recall_ok(ls,q1_slice_fact(slice,mk))==1){mh=mh+1;}
        mk=mk+1;
    }
    mastery.*=mh;
    return fails;
}

// interference pass for retention (teach3): re-emit the 96 flaws on fresh
// tapes; the learner re-judges with its accumulated store/spans.
fn s37_interfere(ls:*T5Store,spans:*Q1SpanMap)void {
    let slice:i32=0;
    while(slice<8){
        let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ:[]u8=nio_alloc(Q1_NSLOTS);
        let ot:[]u8=nio_alloc(24*3*8);
        q1_build_stimulus(slice,slice*24,24,stim,occ,ot);
        let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&tape,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(4000+slice) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let j:i32=0;
        while(j<12){
            let fid:i32=q1_slice_fact(slice,j);
            q1_emit_flaw(&tape,TB_TID_S37,slice,(4000+slice) as i64,seq,j,fid,ot,j,occ,&mctx);
            q1_learn_one(ls,spans,&sess,&tape,stim,slice as i64);
            seq=seq+1;
            j=j+1;
        }
        slice=slice+1;
    }
    return;
}

// CLASS 4: separate + direct. The D2-taught learner judges the sealed §B.7
// schedule directly (8 slices x 12 flaws). Per-slice exact hits reported;
// strict bar >=10/12 per slice.
fn s37_flaw4(label:[]u8,rep:i32)i32 {
    let fails:i32=0;
    let s:T5Store=t5_init(512,16384);
    let withheld:i32=0;
    let e90:i32=0;
    s37_teach(&s,rep,&withheld,&e90);
    let taught:i32=0;
    let h1:i32=0;
    let h2:i32=0;
    let id:i32=0;
    while(id<240){
        let st:i32=s37_teacher_status(&s,id);
        if(st>=1){taught=taught+1;}
        if(st==1){h1=h1+1;}
        if(st==2){h2=h2+1;}
        id=id+1;
    }
    _zag_print("S37_TEACH,");_zag_print(label);_zag_print(",rep,");
    q2_num(rep as i64);_zag_print(",taught,");
    q2_num(taught as i64);_zag_print(",withheld,");
    q2_num(withheld as i64);_zag_print(",e90,");
    q2_num(e90 as i64);_zag_print(",holds_true,");
    q2_num(h1 as i64);_zag_print(",holds_false,");
    q2_num(h2 as i64);_zag_println("");
    let spans:Q1SpanMap=q1_spanmap_init(256);
    let slice:i32=0;
    while(slice<8){
        let hits:i32=0; let nears:i32=0; let misses:i32=0; let fps:i32=0;
        let wsh:i32=0; let ad:i32=0; let sk:i32=0;
        let lk:i32=0; let twf:i32=0; let mh:i32=0;
        fails=fails+s37_slice(label,rep,slice,&s,&spans,&s,0,
            &hits,&nears,&misses,&fps,&wsh,&ad,&sk,&lk,&twf,&mh);
        if(lk!=0){fails=fails+1;}
        if(twf!=0){fails=fails+1;}
        _zag_print("S37_FLAW4,");_zag_print(label);_zag_print(",rep,");
        q2_num(rep as i64);_zag_print(",slice,");
        q2_num(slice as i64);_zag_print(",hits,");
        q2_num(hits as i64);_zag_print(",nears,");
        q2_num(nears as i64);_zag_print(",misses,");
        q2_num(misses as i64);_zag_print(",fps,");
        q2_num(fps as i64);_zag_print(",leak,");
        q2_num(lk as i64);_zag_print(",tripwire,");
        q2_num(twf as i64);_zag_println("");
        if(hits<10){fails=fails+1;}
        slice=slice+1;
    }
    let dg:[]u8=t5_digest(&s);
    _zag_print("S37_DIGEST,");_zag_print(label);_zag_print(",rep,");
    q2_num(rep as i64);_zag_print(",");
    _zag_print(dg);_zag_println("");
    nio_free(dg);
    _zag_print("S37_FLAW4,");_zag_print(label);_zag_println(",done");
    return fails;
}

// CLASS 3: teach. The D2-taught learner (teacher id 20) teaches a fresh
// arm-B learner: flaw-first + clean per slice (clean only for facts the
// teacher holds with the world-true claim). Then an interference pass
// (96 flaws re-judged) for retention. Reports Track-5 inputs + per-slice
// §B.7 exact hits.
fn s37_teach3(label:[]u8,rep:i32)i32 {
    let fails:i32=0;
    let ts:T5Store=t5_init(512,16384);
    let t_withheld:i32=0;
    let t_e90:i32=0;
    s37_teach(&ts,rep,&t_withheld,&t_e90);
    _zag_print("S37_TEACHER,");_zag_print(label);_zag_print(",rep,");
    q2_num(rep as i64);_zag_print(",withheld,");
    q2_num(t_withheld as i64);_zag_print(",e90,");
    q2_num(t_e90 as i64);_zag_println("");
    let ls:T5Store=t5_init(512,16384);
    let spans:Q1SpanMap=q1_spanmap_init(256);
    let tot_hits:i32=0; let tot_nears:i32=0; let tot_miss:i32=0; let tot_fps:i32=0;
    let tot_ws:i32=0; let tot_ad:i32=0; let tot_sk:i32=0;
    let tot_leak:i32=0; let tot_tw:i32=0;
    let m1:i32=0;
    let eps:i32=0;
    let slice:i32=0;
    while(slice<8){
        let hits:i32=0; let nears:i32=0; let misses:i32=0; let fps:i32=0;
        let wsh:i32=0; let ad:i32=0; let sk:i32=0;
        let lk:i32=0; let twf:i32=0; let mh:i32=0;
        fails=fails+s37_slice(label,rep,slice,&ls,&spans,&ts,1,
            &hits,&nears,&misses,&fps,&wsh,&ad,&sk,&lk,&twf,&mh);
        if(lk!=0){fails=fails+1;}
        if(twf!=0){fails=fails+1;}
        if(hits<10){fails=fails+1;}
        tot_hits=tot_hits+hits; tot_nears=tot_nears+nears;
        tot_miss=tot_miss+misses; tot_fps=tot_fps+fps;
        tot_ws=tot_ws+wsh; tot_ad=tot_ad+ad; tot_sk=tot_sk+sk;
        tot_leak=tot_leak+lk; tot_tw=tot_tw+twf;
        m1=m1+mh;
        eps=eps+12+(24-sk);
        _zag_print("S37_TEACH3_SLICE,");_zag_print(label);_zag_print(",rep,");
        q2_num(rep as i64);_zag_print(",slice,");
        q2_num(slice as i64);_zag_print(",hits,");
        q2_num(hits as i64);_zag_print(",ws_revise,");
        q2_num(wsh as i64);_zag_print(",adopts,");
        q2_num(ad as i64);_zag_print(",skipped,");
        q2_num(sk as i64);_zag_print(",mastery,");
        q2_num(mh as i64);_zag_print(",leak,");
        q2_num(lk as i64);_zag_print(",tripwire,");
        q2_num(twf as i64);_zag_println("");
        slice=slice+1;
    }
    s37_interfere(&ls,&spans);
    eps=eps+96;
    let m2:i32=0;
    let fi:i32=0;
    while(fi<8){
        let fk:i32=0;
        while(fk<24){
            if(s37_recall_ok(&ls,q1_slice_fact(fi,fk))==1){m2=m2+1;}
            fk=fk+1;
        }
        fi=fi+1;
    }
    let ops:i32=ls.audit_n;
    _zag_print("S37_TEACH3_RESULT,");_zag_print(label);_zag_print(",rep,");
    q2_num(rep as i64);_zag_print(",b7_hits,");
    q2_num(tot_hits as i64);_zag_print(",b7_nears,");
    q2_num(tot_nears as i64);_zag_print(",b7_miss,");
    q2_num(tot_miss as i64);_zag_print(",b7_fps,");
    q2_num(tot_fps as i64);_zag_print(",ws_revise,");
    q2_num(tot_ws as i64);_zag_print(",adopts,");
    q2_num(tot_ad as i64);_zag_print(",skipped,");
    q2_num(tot_sk as i64);_zag_print(",m1,");
    q2_num(m1 as i64);_zag_print(",m2,");
    q2_num(m2 as i64);_zag_print(",leak,");
    q2_num(tot_leak as i64);_zag_print(",tripwire,");
    q2_num(tot_tw as i64);_zag_print(",ops,");
    q2_num(ops as i64);_zag_print(",eps,");
    q2_num(eps as i64);_zag_println("");
    let dg:[]u8=t5_digest(&ls);
    _zag_print("S37_DIGEST,");_zag_print(label);_zag_print(",rep,");
    q2_num(rep as i64);_zag_print(",");
    _zag_print(dg);_zag_println("");
    nio_free(dg);
    _zag_print("S37_TEACH3,");_zag_print(label);_zag_println(",done");
    return fails;
}

    // T7' circular-corroboration probes
    c=0;v=0;while(v<20){if(tr_t7p_c(v)==1){c=c+1;}v=v+1;}
    _zag_print("TRAP,c,7p,");t5_num(c as i64);_zag_print(",20\n");
    tot_c=tot_c+c;tot_n=tot_n+20;
    c=0;v=0;while(v<20){if(tr_t8_any(v,2)==1){c=c+1;}v=v+1;}
    tr_line("c",8,c);tot_c=tot_c+c;tot_n=tot_n+20;

// p1d_state.zag — step 1d harness: verdict table, 40 probes, lawful state
// trajectories, real transition ops (incl. single-field lawful edits).
// The harness state IS the 7-field projection (P1dProj); project() = identity.
// Pure Zag. Zero RNG. (Harness; excluded from the 500-line machinery budget.)
@import("p1d_phr.zag")

// ---- frozen verdict reasons (prereg §3; verdict fields, never invented) ----
fn st_reason(vc:i64,i:i64)[]u8 {
    if(vc==0){
        if(i==0){return "the evidence threshold was met";}
        if(i==1){return "no counter-evidence survived elimination";}
        return "the slot's corroboration count cleared the bar";
    }
    if(vc==1){
        if(i==0){return "the evidence was refuted";}
        if(i==1){return "a stronger hypothesis superseded it";}
        return "the retention bar was not met";
    }
    if(vc==2){
        if(i==0){return "the slot is load-bearing for open hypotheses";}
        if(i==1){return "integrity review flagged it protected";}
        return "the overseer force-pin is recorded";
    }
    if(vc==3){
        if(i==0){return "new evidence weakened the claim";}
        if(i==1){return "a higher-priority slot needs the budget";}
        return "the confidence grade was revised down";
    }
    if(i==0){return "the request conflicts with the integrity standard";}
    if(i==1){return "the ledger would not survive the change";}
    return "the deliberative bar was not cleared";
}
fn st_mkverdict(vc:i64,slot:i64)P1dVerdict {
    return P1dVerdict{ .vclass=vc, .slot=slot, .reasons_n=3,
        .r0=st_reason(vc,0), .r1=st_reason(vc,1), .r2=st_reason(vc,2) };
}
// 40 prereg probes: 5 classes x 8; subject slot 3..14 deterministic
fn st_probe(p:i64)P1dVerdict {
    let vc:i64=p/8;
    let slot:i64=3+(p*5)%12;
    return st_mkverdict(vc,slot);
}
fn st_probe_bytes(p:i64,out:[]u8)i32 {
    let v:P1dVerdict=st_probe(p);
    return phr_verdict_bytes(&v,out);
}

// ---- state: the projection IS the state ----
fn st_zero()P1dProj {
    return P1dProj{ .ep=0,.ctx=0,.store_n=0,.kills=0,.promotes=0,.last_op=0,.reasons_n=3 };
}
// base state of trajectory t (deterministic; data, not RNG)
fn st_base(t:i64)P1dProj {
    return P1dProj{ .ep=1000+137*t, .ctx=t%4, .store_n=28+5*t, .kills=3*t,
        .promotes=2*t, .last_op=(3*t)%8, .reasons_n=3 };
}
// real transition ops (pure; value semantics)
fn op_tick(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=7,.reasons_n=s.reasons_n };
}
fn op_add(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=s.store_n+1,.kills=s.kills,
        .promotes=s.promotes,.last_op=1,.reasons_n=s.reasons_n };
}
fn op_kill(s:P1dProj)P1dProj {
    let sn:i64=s.store_n-1; if(sn<0){sn=0;}
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=sn,.kills=s.kills+1,
        .promotes=s.promotes,.last_op=2,.reasons_n=s.reasons_n };
}
fn op_promote(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes+1,.last_op=4,.reasons_n=s.reasons_n };
}
fn op_pin(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=3,.reasons_n=s.reasons_n };
}
fn op_switch(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=(s.ctx+1)%4,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=6,.reasons_n=s.reasons_n };
}
// trajectory step j (1..19): deterministic op schedule
fn st_traj_step(s:P1dProj,t:i64,j:i64)P1dProj {
    let k:i64=(t*7+j*13)%6;
    if(k==0){return op_tick(s);} if(k==1){return op_add(s);}
    if(k==2){return op_kill(s);} if(k==3){return op_promote(s);}
    if(k==4){return op_switch(s);} return op_pin(s);
}
// snapshot j of trajectory t (j=0..19)
fn st_snap(t:i64,j:i64)P1dProj {
    let s:P1dProj=st_base(t);
    let k:i64=1;
    while(k<=j){ s=st_traj_step(s,t,k); k=k+1; }
    return s;
}
// single-field lawful edits (adaptivity pairs; real transition ops)
fn ed_ep(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep+1,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=s.last_op,.reasons_n=s.reasons_n };
}
fn ed_ctx(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep,.ctx=(s.ctx+1)%4,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=s.last_op,.reasons_n=s.reasons_n };
}
fn ed_store(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep,.ctx=s.ctx,.store_n=s.store_n+1,.kills=s.kills,
        .promotes=s.promotes,.last_op=s.last_op,.reasons_n=s.reasons_n };
}
fn ed_kills(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills+1,
        .promotes=s.promotes,.last_op=s.last_op,.reasons_n=s.reasons_n };
}
fn ed_prom(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes+1,.last_op=s.last_op,.reasons_n=s.reasons_n };
}
fn ed_lastop(s:P1dProj)P1dProj {
    return P1dProj{ .ep=s.ep,.ctx=s.ctx,.store_n=s.store_n,.kills=s.kills,
        .promotes=s.promotes,.last_op=(s.last_op+1)%8,.reasons_n=s.reasons_n };
}
// state equality on projection bytes
fn st_eq(a:P1dProj,b:P1dProj)i32 {
    if(a.ep!=b.ep){return 0;} if(a.ctx!=b.ctx){return 0;}
    if(a.store_n!=b.store_n){return 0;} if(a.kills!=b.kills){return 0;}
    if(a.promotes!=b.promotes){return 0;} if(a.last_op!=b.last_op){return 0;}
    return 1;
}

// adapt.zag — adaptivity metric driver (Track 1, slice 10).
// argv[1]: pilot (40 pairs) | full (1600 pairs + G3 main grid) | novel (G4).
// G0 replay, G1 directional hits (R_v), G2 protection, G3 NMI + permutation null.
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_null.zag")

// ---- lawful single-field edits (0..5) + composed two-variable edit (6) ----
fn ad_edit(s:P1dProj,e:i32)P1dProj {
    if(e==0){return ed_ep(s);} if(e==1){return ed_ctx(s);} if(e==2){return ed_store(s);}
    if(e==3){return ed_kills(s);} if(e==4){return ed_prom(s);} if(e==5){return ed_lastop(s);}
    return ed_store(ed_ep(s));
}
// R_v preconditions (frozen §8); order-var no-wrap preconditions are the
// mechanical requirement for "delta = +1 exactly" (documented in RESULTS).
fn ad_precond(s:P1dProj,e:i32)i32 {
    let ds:i64=s.ep+s.store_n+s.promotes;
    if(e==0 || e==2 || e==4){ if(ds%3<2){return 1;} return 0; }
    if(e==6){ if(ds%3==0){return 1;} return 0; }
    if(e==1){ if(s.ctx<3){return 1;} return 0; }
    if(e==5){ if(s.last_op<7){return 1;} return 0; }
    return 1;
}
// render + surface code; -1 on verdict-mutation (protection)
fn ad_code(v:*P1dVerdict,s:P1dProj,out:[]u8)i32 {
    let n:i32=pro_render(v,s,out);
    if(n<0){ return -1; }
    return phr_code(v,out,n);
}
// directional hit per R_v; 1=hit, 0=miss, -1=protection violation
fn ad_hit(v:*P1dVerdict,s:P1dProj,s2:P1dProj,e:i32,out:[]u8)i32 {
    let c1:i32=ad_code(v,s,out[0..1024]);
    if(c1<0){ return -1; }
    let c2:i32=ad_code(v,s2,out[1024..2048]);
    if(c2<0){ return -1; }
    let d1:i32=(c1%12)/3; let o1:i32=c1%3;
    let d2:i32=(c2%12)/3; let o2:i32=c2%3;
    if(e==0 || e==2 || e==4){ if(d2==d1+1 && o2==o1){return 1;} return 0; }
    if(e==6){ if(d2==d1+2 && o2==o1){return 1;} return 0; }
    if(o2==(o1+1)%3 && d2==d1){return 1;}
    return 0;
}
// G2 per pair: verdict bytes / memop / refusal identical; ledger decision
// words identical (state-echo words a5=ep@word12, d1=hash@word14 may differ;
// they legitimately track the state — documented interpretation in RESULTS).
// Returns violation count for the pair.
fn ad_g2pair(p:i64,v:*P1dVerdict,s:P1dProj,s2:P1dProj)i32 {
    let viol:i32=0;
    // verdict bytes across the pair (render protection already checked by ad_hit's pro_render)
    let vb1:[]u8=nio_alloc(256); let vb2:[]u8=nio_alloc(256);
    let n1:i32=phr_verdict_bytes(v,vb1);
    // memop set + refusal flag recorded from the (shared) verdict
    let mop0:i64=v.*.vclass; let mop1:i64=v.*.slot;
    let ref0:i64=0; if(v.*.vclass==4){ref0=1;}
    // ledger decision words must match; only state-echo words may differ
    let l1:[]u8=nio_alloc(64); let l2:[]u8=nio_alloc(64);
    null_ledger(p,s,l1); null_ledger(p,s2,l2);
    let w:i32=0;
    while(w<16){
        if(w!=12 && w!=14){
            if(fx_iget(l1,w)!=fx_iget(l2,w)){ viol=viol+1; }
        }
        w=w+1;
    }
    // cross-check: verdict bytes stable (render both endpoints once more via pro_render)
    let tmp:[]u8=nio_alloc(1024);
    let r1:i32=pro_render(v,s,tmp);
    let n2:i32=phr_verdict_bytes(v,vb2);
    let r2:i32=pro_render(v,s2,tmp);
    let n3:i32=phr_verdict_bytes(v,vb1);
    if(r1<0 || r2<0){ viol=viol+1; }
    if(n1!=n2 || n1!=n3){ viol=viol+1; }
    else { let q:i32=0; while(q<n1){ if(vb1[q]!=vb2[q]){viol=viol+1;q=n1;} q=q+1; } }
    // memop/refusal re-read must equal recorded (same verdict; mechanical)
    if(v.*.vclass!=mop0 || v.*.slot!=mop1){ viol=viol+1; }
    let rf:i64=0; if(v.*.vclass==4){rf=1;}
    if(rf!=ref0){ viol=viol+1; }
    nio_free(vb1); nio_free(vb2); nio_free(l1); nio_free(l2); nio_free(tmp);
    return viol;
}

// ---- main pair collection: npairs distinct (t,j) base states, t in [0,tmax) ----
fn ad_collect_main(npairs:i32,tmax:i32,pb:[]u8,pt:[]u8,pj:[]u8,pe:[]u8)i32 {
    let used:[]u8=nio_alloc(tmax*20);
    let i:i32=0; while(i<tmax*20){used[i]=0;i=i+1;}
    let got:i32=0; let e:i32=0;
    while(got<npairs){
        let per:i32=npairs/6+1; if(got+per>npairs){per=npairs-got;}
        let took:i32=0; let t:i32=0;
        while(t<tmax && took<per){
            let j:i32=0;
            while(j<20 && took<per){
                if(used[t*20+j]==0){
                    let s:P1dProj=st_snap(t,j);
                    if(ad_precond(s,e)==1){
                        used[t*20+j]=1;
                        fx_iset(pb,got,got%40); fx_iset(pt,got,t); fx_iset(pj,got,j); fx_iset(pe,got,e);
                        got=got+1; took=took+1;
                    }
                }
                j=j+1;
            }
            t=t+1;
        }
        if(took==0){ break; }
        e=e+1; if(e>=6){e=0;}
    }
    nio_free(used);
    return got;
}
// ---- novel lawful states (G4): S0 reached by real ops from st_zero, then a
// short deterministic lawful path per index. All paths logged & replayable. ----
fn ad_s0()P1dProj {
    let s:P1dProj=st_zero();
    let k:i32=0;
    while(k<160){ s=op_kill(s); k=k+1; }    // kills=160 (store empty: store_n stays 0)
    k=0; while(k<215){ s=op_add(s); k=k+1; } // store_n=215
    k=0; while(k<5){ s=op_promote(s); k=k+1; } // promotes=5
    while(s.ep<50000){ s=op_tick(s); }         // ep=50000
    return s;
}
// novel base i: s ticks, q adds, r switches (counts -> distinct states)
fn ad_novel_base(s0:P1dProj,i:i32,grid:i32)P1dProj {
    let q:i32=i%7; let r:i32=(i/7)%5; let s:i32=i%150;
    if(grid==1){ s=(i/35)%190; }
    let st:P1dProj=s0;
    let k:i32=0;
    while(k<s){ st=op_tick(st); k=k+1; }
    k=0; while(k<q){ st=op_add(st); k=k+1; }
    k=0; while(k<r){ st=op_switch(st); k=k+1; }
    return st;
}
// novel pair collection: 600 pairs from a 720-candidate lawful pool
// (preconditions filter; the 600 PAIRS are the preregistered count).
// Edits 0..6 (6 = composed), distinct i. Edit 6 (strictest) goes first.
fn ad_collect_novel(s0:P1dProj,pb:[]u8,pi_:[]u8,pe:[]u8)i32 {
    let used:[]u8=nio_alloc(720);
    let i:i32=0; while(i<720){used[i]=0;i=i+1;}
    let got:i32=0; let ei:i32=0;
    while(got<600){
        let e:i32=6; if(ei==1){e=0;} if(ei==2){e=1;} if(ei==3){e=2;}
        if(ei==4){e=3;} if(ei==5){e=4;} if(ei==6){e=5;}
        let per:i32=86; if(got+per>600){per=600-got;}
        let took:i32=0; i=0;
        while(i<720 && took<per){
            if(used[i]==0){
                let s:P1dProj=ad_novel_base(s0,i,0);
                if(ad_precond(s,e)==1){
                    used[i]=1;
                    fx_iset(pb,got,got%40); fx_iset(pi_,got,i); fx_iset(pe,got,e);
                    got=got+1; took=took+1;
                }
            }
            i=i+1;
        }
        if(took==0){ break; }
        ei=ei+1; if(ei>=7){ei=0;}
    }
    nio_free(used);
    return got;
}
// ---- run pairs: G0 replay + G1 hits + G2 violations ----
fn ad_run_pairs(npairs:i32,pb:[]u8,pt:[]u8,pj:[]u8,pe:[]u8,main_:i32,s0:P1dProj,tag:[]u8)void {
    let out:[]u8=nio_alloc(2048); let outb:[]u8=nio_alloc(1024);
    let hits:i32=0; let g0mm:i32=0; let g2v:i32=0; let pviol:i32=0;
    let i:i32=0;
    while(i<npairs){
        let p:i64=(fx_iget(pb,i) as i64);
        let v:P1dVerdict=st_probe(p);
        let s:P1dProj=st_zero(); let e:i32=fx_iget(pe,i);
        if(main_==1){ s=st_snap(fx_iget(pt,i) as i64,fx_iget(pj,i) as i64); }
        else { s=ad_novel_base(s0,fx_iget(pt,i),0); }
        let s2:P1dProj=ad_edit(s,e);
        // G1 + protection
        let h:i32=ad_hit(&v,s,s2,e,out);
        if(h<0){ pviol=pviol+1; } else { hits=hits+h; }
        // G0: replay both endpoints
        let n1:i32=pro_render(&v,s,outb);
        let n2:i32=pro_render(&v,s,out[0..1024]);
        if(n1!=n2){ g0mm=g0mm+1; }
        else { let q:i32=0; while(q<n1){ if(outb[q]!=out[q]){g0mm=g0mm+1;q=n1;} q=q+1; } }
        let m1:i32=pro_render(&v,s2,outb);
        let m2:i32=pro_render(&v,s2,out[1024..2048]);
        if(m1!=m2){ g0mm=g0mm+1; }
        else { let q:i32=0; while(q<m1){ if(outb[q]!=out[1024+q]){g0mm=g0mm+1;q=m1;} q=q+1; } }
        // G2
        g2v=g2v+ad_g2pair(p,&v,s,s2);
        i=i+1;
    }
    // G1 CI: lower = p - 2.576*sqrt(p(1-p)/n), fx
    let ph:i64=((hits as i64)*FXS)/(npairs as i64);
    let var:i64=fx_mul(ph,FXS-ph);
    let se:i64=fx_isqrt((var*FXS)/(npairs as i64));
    let margin:i64=fx_mul(se,2701596); // 2.576 * 2^20
    let lower:i64=ph-margin;
    p("ADAPT_PAIRS,"); p(tag); p(",n,"); pi(npairs as i64); p(",hits,"); pi(hits as i64);
    p(",phat_fx,"); pi(ph); p(",lower99_fx,"); pi(lower);
    p(",g0mm,"); pi(g0mm as i64); p(",g2v,"); pi(g2v as i64); p(",pviol,"); pi(pviol as i64); pn();
    let g1ok:i32=0;
    if(ph>=629146 && lower>524288){ g1ok=1; } // 0.60*2^20=629146; 0.50*2^20=524288
    p("ADAPT_G1,"); p(tag); p(",ok,"); pi(g1ok as i64); pn();
    let g2ok:i32=0; if(g2v==0 && pviol==0){ g2ok=1; }
    p("ADAPT_G2,"); p(tag); p(",ok,"); pi(g2ok as i64); pn();
    let g0ok:i32=0; if(g0mm==0){ g0ok=1; }
    p("ADAPT_G0,"); p(tag); p(",ok,"); pi(g0ok as i64); pn();
    nio_free(out); nio_free(outb);
}
// ---- G3: NMI(state-class, code), Miller-Madow, permutation null ----
fn ad_state_class(s:P1dProj)i32 {
    let ds:i64=s.ep+s.store_n+s.promotes;
    let rs:i64=s.ctx+s.kills+s.last_op;
    return (((ds%24)*4)+(rs%4)) as i32;
}
fn ad_entropy(cnt:[]u8,k:i32,n:i32)i64 {
    let h:i64=0; let i:i32=0;
    while(i<k){
        let c:i32=fx_iget(cnt,i);
        if(c>0){
            let pr:i64=((c as i64)*FXS)/(n as i64);
            h=h+fx_mul(pr,fx_log2(pr));
        }
        i=i+1;
    }
    return -h;
}
fn ad_mi(jn:[]u8,cs:[]u8,cc:[]u8,n:i32)i64 {
    let mi:i64=0; let a:i32=0;
    while(a<96){
        let nxa:i32=fx_iget(cs,a);
        if(nxa>0){
            let b:i32=0;
            while(b<60){
                let nxy:i32=fx_iget(jn,a*60+b);
                if(nxy>0){
                    let nyb:i32=fx_iget(cc,b);
                    let pr:i64=((nxy as i64)*FXS)/(n as i64);
                    let ratio:i64=((nxy as i64)*(n as i64)*FXS)/((nxa as i64)*(nyb as i64));
                    mi=mi+fx_mul(pr,fx_log2(ratio));
                }
                b=b+1;
            }
        }
        a=a+1;
    }
    return mi;
}
// G3 core: sc/cd are i32 arrays of length n. Prints evidence; returns pass flag via print.
fn ad_g3(n:i32,sc:[]u8,cd:[]u8,tag:[]u8)void {
    let cs:[]u8=nio_alloc(96*4); let cc:[]u8=nio_alloc(60*4); let jn:[]u8=nio_alloc(96*60*4);
    let i:i32=0;
    while(i<96){fx_iset(cs,i,0);i=i+1;}
    i=0; while(i<60){fx_iset(cc,i,0);i=i+1;}
    i=0; while(i<96*60){fx_iset(jn,i,0);i=i+1;}
    i=0;
    while(i<n){
        let a:i32=fx_iget(sc,i); let b:i32=fx_iget(cd,i);
        fx_iset(cs,a,fx_iget(cs,a)+1); fx_iset(cc,b,fx_iget(cc,b)+1);
        fx_iset(jn,a*60+b,fx_iget(jn,a*60+b)+1);
        i=i+1;
    }
    let ks:i32=0; i=0; while(i<96){ if(fx_iget(cs,i)>0){ks=ks+1;} i=i+1; }
    let kc:i32=0; i=0; while(i<60){ if(fx_iget(cc,i)>0){kc=kc+1;} i=i+1; }
    let hs:i64=ad_entropy(cs,96,n);
    let hc:i64=ad_entropy(cc,60,n);
    let mi:i64=ad_mi(jn,cs,cc,n);
    // Miller–Madow bias correction for plug-in MI, converted nats->bits
    // (MI is computed in bits via log2).
    let corr_nats:i64=(((ks-1) as i64)*((kc-1) as i64)*FXS)/((2*(n as i64)));
    let corr:i64=(corr_nats*FXS)/726817; // /ln2
    let mi_mm:i64=mi-corr;
    let nmi:i64=(2*mi_mm*FXS)/(hs+hc);
    p("ADAPT_G3,"); p(tag); p(",n,"); pi(n as i64); p(",Ks,"); pi(ks as i64); p(",Kc,"); pi(kc as i64);
    p(",H_S_fx,"); pi(hs); p(",H_C_fx,"); pi(hc); p(",I_raw_fx,"); pi(mi);
    p(",I_mm_fx,"); pi(mi_mm); p(",NMI_fx,"); pi(nmi); pn();
    // permutation null: 1000 deterministic shuffles of codes
    let shuf:[]u8=nio_alloc(n*4);
    i=0; while(i<n){fx_iset(shuf,i,fx_iget(cd,i));i=i+1;}
    let top:[]u8=nio_alloc(10*8);
    i=0; while(i<10){det_i64_set(top,i,-4611686018427387904);i=i+1;}
    let rep:i32=0;
    while(rep<1000){
        let seed:i64=2654435769*((rep+1) as i64);
        let k2:i32=n-1;
        while(k2>0){
            seed=plcg_next(seed);
            let jj:i32=(plcg_range(seed,(k2+1) as i64)) as i32;
            let tmp:i32=fx_iget(shuf,k2); fx_iset(shuf,k2,fx_iget(shuf,jj)); fx_iset(shuf,jj,tmp);
            k2=k2-1;
        }
        // joint with shuffled codes (state classes fixed)
        i=0; while(i<96*60){fx_iset(jn,i,0);i=i+1;}
        i=0;
        while(i<n){
            let a:i32=fx_iget(sc,i); let b:i32=fx_iget(shuf,i);
            fx_iset(jn,a*60+b,fx_iget(jn,a*60+b)+1);
            i=i+1;
        }
        let mi_s:i64=ad_mi(jn,cs,cc,n);
        let nmi_s:i64=(2*(mi_s-corr)*FXS)/(hs+hc);
        // insert into top-10
        let pos:i32=0;
        while(pos<10 && nmi_s<=det_i64_get(top,pos)){ pos=pos+1; }
        if(pos<10){
            let q2:i32=9;
            while(q2>pos){ det_i64_set(top,q2,det_i64_get(top,q2-1)); q2=q2-1; }
            det_i64_set(top,pos,nmi_s);
        }
        rep=rep+1;
    }
    let null99:i64=det_i64_get(top,9);
    let bar:i64=314573; // 0.30 * 2^20
    let five:i64=5*null99;
    if(five>bar){ bar=five; }
    let g3ok:i32=0;
    if(nmi>=bar){ g3ok=1; }
    p("ADAPT_G3NULL,"); p(tag); p(",null99_fx,"); pi(null99); p(",bar_fx,"); pi(bar);
    p(",ok,"); pi(g3ok as i64); pn();
    nio_free(cs); nio_free(cc); nio_free(jn); nio_free(shuf); nio_free(top);
}
// ---- grid builders ----
fn ad_grid_main(sc:[]u8,cd:[]u8)void {
    let out:[]u8=nio_alloc(1024);
    let i:i32=0; let p:i64=0;
    while(p<40){
        let v:P1dVerdict=st_probe(p);
        let t:i64=0;
        while(t<10){
            let j:i64=0;
            while(j<20){
                let s:P1dProj=st_snap(t,j);
                fx_iset(sc,i,ad_state_class(s));
                let c:i32=ad_code(&v,s,out);
                if(c<0){ c=0; }
                fx_iset(cd,i,c);
                i=i+1; j=j+1;
            }
            t=t+1;
        }
        p=p+1;
    }
    nio_free(out);
}
fn ad_grid_novel(s0:P1dProj,sc:[]u8,cd:[]u8)void {
    let out:[]u8=nio_alloc(1024);
    let i:i32=0; let p:i64=0;
    while(p<40){
        let v:P1dVerdict=st_probe(p);
        let k:i32=0;
        while(k<100){
            let s:P1dProj=ad_novel_base(s0,(p as i32)*100+k,1);
            fx_iset(sc,i,ad_state_class(s));
            let c:i32=ad_code(&v,s,out);
            if(c<0){ c=0; }
            fx_iset(cd,i,c);
            i=i+1; k=k+1;
        }
        p=p+1;
    }
    nio_free(out);
}

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"pilot")==1){
        let pb:[]u8=nio_alloc(40*4); let pt:[]u8=nio_alloc(40*4);
        let pj:[]u8=nio_alloc(40*4); let pe:[]u8=nio_alloc(40*4);
        let got:i32=ad_collect_main(40,160,pb,pt,pj,pe);
        p("ADAPT_PILOT,collected,"); pi(got as i64); pn();
        ad_run_pairs(got,pb,pt,pj,pe,1,st_zero(),"pilot");
        nio_free(pb); nio_free(pt); nio_free(pj); nio_free(pe);
        return 0;
    }
    if(_zag_strcmp(mode,"full")==1){
        let pb:[]u8=nio_alloc(1600*4); let pt:[]u8=nio_alloc(1600*4);
        let pj:[]u8=nio_alloc(1600*4); let pe:[]u8=nio_alloc(1600*4);
        let got:i32=ad_collect_main(1600,160,pb,pt,pj,pe);
        p("ADAPT_FULL,collected,"); pi(got as i64); pn();
        ad_run_pairs(got,pb,pt,pj,pe,1,st_zero(),"full");
        nio_free(pb); nio_free(pt); nio_free(pj); nio_free(pe);
        let sc:[]u8=nio_alloc(8000*4); let cd:[]u8=nio_alloc(8000*4);
        ad_grid_main(sc,cd);
        ad_g3(8000,sc,cd,"main");
        nio_free(sc); nio_free(cd);
        return 0;
    }
    if(_zag_strcmp(mode,"novel")==1){
        let s0:P1dProj=ad_s0();
        p("ADAPT_NOVEL,s0_ep,"); pi(s0.ep); p(",s0_store,"); pi(s0.store_n);
        p(",s0_kills,"); pi(s0.kills); p(",s0_prom,"); pi(s0.promotes); pn();
        // range audit on the 600 pair bases
        let pb:[]u8=nio_alloc(600*4); let pi_:[]u8=nio_alloc(600*4); let pe:[]u8=nio_alloc(600*4);
        let got:i32=ad_collect_novel(s0,pb,pi_,pe);
        p("ADAPT_NOVEL,collected,"); pi(got as i64); pn();
        // verify ranges
        let bad:i32=0; let i:i32=0;
        while(i<got){
            let s:P1dProj=ad_novel_base(s0,fx_iget(pi_,i),0);
            if(s.ep<50000 || s.ep>50200){ bad=bad+1; }
            if(s.store_n<200 || s.store_n>230){ bad=bad+1; }
            if(s.kills<150 || s.kills>170){ bad=bad+1; }
            i=i+1;
        }
        p("ADAPT_NOVEL,range_viol,"); pi(bad as i64); pn();
        let pjd:[]u8=nio_alloc(600*4);
        ad_run_pairs(got,pb,pi_,pjd,pe,0,s0,"novel");
        nio_free(pjd);
        nio_free(pb); nio_free(pi_); nio_free(pe);
        let sc:[]u8=nio_alloc(4000*4); let cd:[]u8=nio_alloc(4000*4);
        ad_grid_novel(s0,sc,cd);
        ad_g3(4000,sc,cd,"novel");
        nio_free(sc); nio_free(cd);
        return 0;
    }
    p("ADAPT,UNKNOWN_MODE\n");
    return 2;
}

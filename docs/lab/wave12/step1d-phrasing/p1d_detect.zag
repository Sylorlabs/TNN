// p1d_detect.zag — arbitrariness detector (Track 1, slice 11).
// Gates G0 (replay), G1 (variation existence), G2 (state-dependence) with the
// preregistered predictor family + builder-nominated slot. Synthetic positive
// and negative controls run FIRST; controls misbehaving voids the run.
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_null.zag")

// ---- mechanism codes: 0=real phrasing fn (render+surface code),
// 1=positive control (synthetic lawful: code = store_n*6+kills),
// 2=negative control (synthetic arbitrary: code = hash(state)%36).
// Returns code, or -1 on verdict-mutation (mech 0 only). ----
fn det_code(mech:i32,v:*P1dVerdict,s:P1dProj,out:[]u8)i32 {
    if(mech==0){
        let n:i32=pro_render(v,s,out);
        if(n<0){ return -1; }
        return phr_code(v,out,n);
    }
    if(mech==1){ return ((s.store_n*6+s.kills)) as i32; }
    return det_hash_state(s);
}
// ---- lawful input states, per mechanism (deterministic, zero RNG) ----
// mech 0 (real): 900 states via deterministic balanced fill over lawful
// candidates. The true law is ti=phr_fold(s)%5 (hash), depth=1+sum%3,
// rot=sum%3 (45 codes). For G1 concentration we fill 36 bins
// (ti in {0..3}, depth in {1..3}, rot in {0..2}), 25 per bin; ti=4 is
// excluded by the sampling design (documented in RESULTS).
// Bins use the OBSERVED surface code (render+phr_code) for the input verdict.
fn det_real_states(st:[]u8,v:*P1dVerdict,out:[]u8)void {
    let cnt:[]u8=nio_alloc(36*4);
    let i:i32=0; while(i<36){fx_iset(cnt,i,0);i=i+1;}
    let got:i32=0; let c:i32=0;
    while(got<900 && c<100000){
        let s:P1dProj=det_cand_state(c);
        let n:i32=pro_render(v,s,out);
        if(n>=0){
            let code:i32=phr_code(v,out,n);
            let ti:i32=code/12; let d:i32=(code%12)/3; let o:i32=code%3;
            if(ti<4 && d>=1 && d<=3){
                let bin:i32=ti*9+(d-1)*3+o;
                if(fx_iget(cnt,bin)<25){
                    fx_iset(cnt,bin,fx_iget(cnt,bin)+1);
                    dst_set(st,got,s);
                    got=got+1;
                }
            }
        }
        c=c+1;
    }
}
// mech 1: 900 states; a=i%6, b=(i/6)%6; b kills (empty store), a adds.
// code = a*6+b; law: code = store_n*6+kills. 36 codes, 25 each.
fn det_state_pos(i:i32)P1dProj {
    let a:i32=i%6; let b:i32=(i/6)%6;
    let s:P1dProj=st_zero();
    let k:i32=0;
    while(k<b){ s=op_kill(s); k=k+1; }
    k=0; while(k<a){ s=op_add(s); k=k+1; }
    return s;
}
// mech 2: candidate lawful states; code = hash%36 with deterministic
// balanced fill (25 per bin) so G1 variation is adequate by construction.
fn det_cand_state(i:i32)P1dProj {
    let k:i32=(2*i)%9; let a:i32=i%7; let c:i32=i%4; let m:i32=i%3;
    let target:i64=1000+(i as i64);
    let s:P1dProj=st_zero();
    let j:i32=0;
    while(j<k){ s=op_kill(s); j=j+1; }
    j=0; while(j<a){ s=op_add(s); j=j+1; }
    j=0; while(j<c){ s=op_switch(s); j=j+1; }
    j=0; while(j<m){ s=op_promote(s); j=j+1; }
    while(s.ep<target){ s=op_tick(s); }
    return s;
}
fn det_hash_state(s:P1dProj)i32 {
    let b:[]u8=nio_alloc(48);
    let f:i32=0;
    while(f<6){
        let w:i64=s.ep;
        if(f==1){w=s.ctx;} if(f==2){w=s.store_n;} if(f==3){w=s.kills;}
        if(f==4){w=s.promotes;} if(f==5){w=s.last_op;}
        let o:i32=f*8;
        b[o]=(w&255) as u8; b[o+1]=((w>>8)&255) as u8; b[o+2]=((w>>16)&255) as u8;
        b[o+3]=((w>>24)&255) as u8; b[o+4]=((w>>32)&255) as u8; b[o+5]=((w>>40)&255) as u8;
        b[o+6]=((w>>48)&255) as u8; b[o+7]=((w>>56)&255) as u8;
        f=f+1;
    }
    let h:i64=pfnv_masked(b);
    nio_free(b);
    return (h%36) as i32;
}
fn det_neg_states(st:[]u8)void {
    let cnt:[]u8=nio_alloc(36*4);
    let i:i32=0; while(i<36){fx_iset(cnt,i,0);i=i+1;}
    let got:i32=0; let c:i32=0;
    while(got<900 && c<100000){
        let s:P1dProj=det_cand_state(c);
        let bin:i32=det_hash_state(s);
        if(fx_iget(cnt,bin)<25){
            fx_iset(cnt,bin,fx_iget(cnt,bin)+1);
            dst_set(st,got,s);
            got=got+1;
        }
        c=c+1;
    }
}
// ---- builder-nominated predictor: logged projection -> code ----
// mech 0: the true phrasing law (ti, depth, observable order from state).
// mech 1: the true synthetic law. mech 2: honest-but-wrong structural guess.
fn det_nominate(mech:i32,s:P1dProj)i32 {
    if(mech==0){
        let ti:i32=(phr_fold(s)%5) as i32;
        let depth:i32=(1+((s.ep+s.store_n+s.promotes)%3)) as i32;
        let o:i32=(((s.ctx+s.kills+s.last_op)%3)) as i32;
        return ti*12+depth*3+o;
    }
    if(mech==1){ return ((s.store_n*6+s.kills)) as i32; }
    return (((s.ep/37)%36)) as i32;
}
// ---- flat state store: 7 i64 LE per state ----
fn dst_set(d:[]u8,i:i32,s:P1dProj)void {
    let o:i32=i*56;
    let f:i32=0;
    while(f<7){
        let w:i64=s.ep;
        if(f==1){w=s.ctx;} if(f==2){w=s.store_n;} if(f==3){w=s.kills;}
        if(f==4){w=s.promotes;} if(f==5){w=s.last_op;} if(f==6){w=s.reasons_n;}
        d[o+f*8]=(w&255) as u8; d[o+f*8+1]=((w>>8)&255) as u8;
        d[o+f*8+2]=((w>>16)&255) as u8; d[o+f*8+3]=((w>>24)&255) as u8;
        d[o+f*8+4]=((w>>32)&255) as u8; d[o+f*8+5]=((w>>40)&255) as u8;
        d[o+f*8+6]=((w>>48)&255) as u8; d[o+f*8+7]=((w>>56)&255) as u8;
        f=f+1;
    }
}
fn dst_get_i64(d:[]u8,i:i32,f:i32)i64 {
    let o:i32=i*56+f*8;
    let w:i64=(d[o] as i64)|((d[o+1] as i64)<<8)|((d[o+2] as i64)<<16)|((d[o+3] as i64)<<24);
    w=w|((d[o+4] as i64)<<32)|((d[o+5] as i64)<<40)|((d[o+6] as i64)<<48)|((d[o+7] as i64)<<56);
    return w;
}
fn dst_get(d:[]u8,i:i32)P1dProj {
    return P1dProj{ .ep=dst_get_i64(d,i,0), .ctx=dst_get_i64(d,i,1), .store_n=dst_get_i64(d,i,2),
        .kills=dst_get_i64(d,i,3), .promotes=dst_get_i64(d,i,4), .last_op=dst_get_i64(d,i,5),
        .reasons_n=dst_get_i64(d,i,6) };
}
// majority code over idx[0..n) into cd[]; returns code*1000000+count
fn det_bestcode(cd:[]u8,idx:[]u8,n:i32)i64 {
    let cnt:[]u8=nio_alloc(60*4);
    let i:i32=0; while(i<60){fx_iset(cnt,i,0);i=i+1;}
    i=0; while(i<n){ let c:i32=fx_iget(cd,fx_iget(idx,i)); fx_iset(cnt,c,fx_iget(cnt,c)+1); i=i+1; }
    let bc:i32=0; let bn:i32=-1; i=0;
    while(i<60){ let c:i32=fx_iget(cnt,i); if(c>bn){bn=c;bc=i;} i=i+1; }
    nio_free(cnt);
    return (bc as i64)*1000000+(bn as i64);
}
// stable insertion sort of idx[0..n) by var vi -> out[]
fn det_sort_by_var(st:[]u8,idx:[]u8,n:i32,vi:i32,out:[]u8)void {
    let i:i32=0; while(i<n){fx_iset(out,i,fx_iget(idx,i));i=i+1;}
    i=1;
    while(i<n){
        let key:i32=fx_iget(out,i);
        let kv:i64=dst_get_i64(st,key,vi);
        let j:i32=i-1;
        while(j>=0){
            let cj:i32=fx_iget(out,j);
            if(dst_get_i64(st,cj,vi)<=kv){break;}
            fx_iset(out,j+1,cj); j=j-1;
        }
        fx_iset(out,j+1,key);
        i=i+1;
    }
}
// predictor (a): best-constant. returns fit_correct*1000+eval_correct
fn det_pred_const(cd:[]u8,fit:[]u8,nfit:i32,evl:[]u8,neval:i32)i64 {
    let bc:i64=det_bestcode(cd,fit,nfit);
    let code:i32=(bc/1000000) as i32;
    let fc:i32=(bc%1000000) as i32;
    let ec:i32=0; let i:i32=0;
    while(i<neval){ if(fx_iget(cd,fx_iget(evl,i))==code){ec=ec+1;} i=i+1; }
    return (fc as i64)*1000+(ec as i64);
}
// predictor (b): per-variable bucketed rule for var vi. returns fit_correct*1000+eval_correct
fn det_pred_bucket(st:[]u8,cd:[]u8,fit:[]u8,nfit:i32,evl:[]u8,neval:i32,vi:i32)i64 {
    let srt:[]u8=nio_alloc(nfit*4);
    det_sort_by_var(st,fit,nfit,vi,srt);
    let bval:[]u8=nio_alloc(7*8); // i64 boundaries
    let k:i32=0;
    while(k<7){
        let pos:i32=(k+1)*nfit/8;
        let ep:i32=fx_iget(srt,pos);
        let w:i64=dst_get_i64(st,ep,vi);
        let o:i32=k*8;
        bval[o]=(w&255) as u8; bval[o+1]=((w>>8)&255) as u8; bval[o+2]=((w>>16)&255) as u8; bval[o+3]=((w>>24)&255) as u8;
        bval[o+4]=((w>>32)&255) as u8; bval[o+5]=((w>>40)&255) as u8; bval[o+6]=((w>>48)&255) as u8; bval[o+7]=((w>>56)&255) as u8;
        k=k+1;
    }
    // bucket code = majority of fit episodes in bucket
    let bcode:[]u8=nio_alloc(8*4);
    let b:i32=0;
    while(b<8){
        let cnt:[]u8=nio_alloc(60*4);
        let i:i32=0; while(i<60){fx_iset(cnt,i,0);i=i+1;}
        i=0;
        while(i<nfit){
            let ep:i32=fx_iget(fit,i);
            let x:i64=dst_get_i64(st,ep,vi);
            let bb:i32=0; let q:i32=0;
            while(q<7){
                let o2:i32=q*8;
                let bv:i64=(bval[o2] as i64)|((bval[o2+1] as i64)<<8)|((bval[o2+2] as i64)<<16)|((bval[o2+3] as i64)<<24);
                bv=bv|((bval[o2+4] as i64)<<32)|((bval[o2+5] as i64)<<40)|((bval[o2+6] as i64)<<48)|((bval[o2+7] as i64)<<56);
                if(x>=bv){bb=bb+1;}
                q=q+1;
            }
            if(bb==b){ let c:i32=fx_iget(cd,ep); fx_iset(cnt,c,fx_iget(cnt,c)+1); }
            i=i+1;
        }
        let bc2:i32=0; let bn2:i32=-1; i=0;
        while(i<60){ let c:i32=fx_iget(cnt,i); if(c>bn2){bn2=c;bc2=i;} i=i+1; }
        fx_iset(bcode,b,bc2);
        nio_free(cnt);
        b=b+1;
    }
    // fit accuracy
    let fc:i32=0; let i:i32=0;
    while(i<nfit){
        let ep:i32=fx_iget(fit,i);
        let x:i64=dst_get_i64(st,ep,vi);
        let bb:i32=0; let q:i32=0;
        while(q<7){
            let o2:i32=q*8;
            let bv:i64=(bval[o2] as i64)|((bval[o2+1] as i64)<<8)|((bval[o2+2] as i64)<<16)|((bval[o2+3] as i64)<<24);
            bv=bv|((bval[o2+4] as i64)<<32)|((bval[o2+5] as i64)<<40)|((bval[o2+6] as i64)<<48)|((bval[o2+7] as i64)<<56);
            if(x>=bv){bb=bb+1;}
            q=q+1;
        }
        if(fx_iget(cd,ep)==fx_iget(bcode,bb)){fc=fc+1;}
        i=i+1;
    }
    // eval accuracy
    let ec:i32=0; i=0;
    while(i<neval){
        let ep:i32=fx_iget(evl,i);
        let x:i64=dst_get_i64(st,ep,vi);
        let bb:i32=0; let q:i32=0;
        while(q<7){
            let o2:i32=q*8;
            let bv:i64=(bval[o2] as i64)|((bval[o2+1] as i64)<<8)|((bval[o2+2] as i64)<<16)|((bval[o2+3] as i64)<<24);
            bv=bv|((bval[o2+4] as i64)<<32)|((bval[o2+5] as i64)<<40)|((bval[o2+6] as i64)<<48)|((bval[o2+7] as i64)<<56);
            if(x>=bv){bb=bb+1;}
            q=q+1;
        }
        if(fx_iget(cd,ep)==fx_iget(bcode,bb)){ec=ec+1;}
        i=i+1;
    }
    nio_free(srt); nio_free(bval); nio_free(bcode);
    return (fc as i64)*1000+(ec as i64);
}
// normalization scales for kNN
fn det_scale(vi:i32)i64 {
    if(vi==0){return 10000;} if(vi==1){return 4;} if(vi==5){return 8;}
    return 64;
}
// predictor (c): k-NN k=15 on normalized projection vector.
// fit accuracy = leave-one-out (honest; a point never votes for itself).
fn det_pred_knn(st:[]u8,cd:[]u8,fit:[]u8,nfit:i32,evl:[]u8,neval:i32)i64 {
    let bd:[]u8=nio_alloc(15*8); let bc:[]u8=nio_alloc(15*4);
    let fc:i32=0; let ec:i32=0;
    let e:i32=0;
    while(e<nfit+neval){
        let qep:i32=0; let isfit:i32=0;
        if(e<nfit){ qep=fx_iget(fit,e); isfit=1; } else { qep=fx_iget(evl,e-nfit); }
        let qv0:i64=(dst_get_i64(st,qep,0)*1024)/det_scale(0);
        let qv1:i64=(dst_get_i64(st,qep,1)*1024)/det_scale(1);
        let qv2:i64=(dst_get_i64(st,qep,2)*1024)/det_scale(2);
        let qv3:i64=(dst_get_i64(st,qep,3)*1024)/det_scale(3);
        let qv4:i64=(dst_get_i64(st,qep,4)*1024)/det_scale(4);
        let qv5:i64=(dst_get_i64(st,qep,5)*1024)/det_scale(5);
        let nb:i32=0; let j:i32=0;
        while(j<nfit){
            let fep:i32=fx_iget(fit,j);
            let skip:i32=0;
            if(isfit==1 && fep==qep){ skip=1; }
            if(skip==0){
            let d0:i64=qv0-((dst_get_i64(st,fep,0)*1024)/det_scale(0));
            let d1:i64=qv1-((dst_get_i64(st,fep,1)*1024)/det_scale(1));
            let d2:i64=qv2-((dst_get_i64(st,fep,2)*1024)/det_scale(2));
            let d3:i64=qv3-((dst_get_i64(st,fep,3)*1024)/det_scale(3));
            let d4:i64=qv4-((dst_get_i64(st,fep,4)*1024)/det_scale(4));
            let d5:i64=qv5-((dst_get_i64(st,fep,5)*1024)/det_scale(5));
            let dist:i64=d0*d0+d1*d1+d2*d2+d3*d3+d4*d4+d5*d5;
            // insert into 15-best
            if(nb<15){
                det_i64_set(bd,nb,dist);
                fx_iset(bc,nb,fx_iget(cd,fep));
                nb=nb+1;
            } else {
                // find current max
                let mi:i32=0; let mxv:i64=det_i64_get(bd,0); let mi2:i32=1;
                while(mi2<15){ let dv:i64=det_i64_get(bd,mi2); if(dv>mxv){mxv=dv;mi=mi2;} mi2=mi2+1; }
                if(dist<mxv){ det_i64_set(bd,mi,dist); fx_iset(bc,mi,fx_iget(cd,fep)); }
            }
            }
            j=j+1;
        }
        // majority vote over nb neighbors (tie -> smaller code)
        let cnt:[]u8=nio_alloc(60*4);
        let q:i32=0; while(q<60){fx_iset(cnt,q,0);q=q+1;}
        q=0; while(q<nb){ let c:i32=fx_iget(bc,q); fx_iset(cnt,c,fx_iget(cnt,c)+1); q=q+1; }
        let pcode:i32=0; let pbn:i32=-1; q=0;
        while(q<60){ let c:i32=fx_iget(cnt,q); if(c>pbn){pbn=c;pcode=q;} q=q+1; }
        nio_free(cnt);
        if(isfit==1){ if(pcode==fx_iget(cd,qep)){fc=fc+1;} }
        else { if(pcode==fx_iget(cd,qep)){ec=ec+1;} }
        e=e+1;
    }
    nio_free(bd); nio_free(bc);
    return (fc as i64)*1000+(ec as i64);
}
// ---- predictor (d): greedy decision lists, depth <= 3 ----
// rule storage: rvar[3] i32, rthr[3] i64, rdir[3] i32, rcode[3] i32, defcode i32
fn det_dlist_predict(st:[]u8,cd:[]u8,ep:i32,rvar:[]u8,rthr:[]u8,rdir:[]u8,rcode:[]u8,nr:i32,defcode:i32)i32 {
    let r:i32=0;
    while(r<nr){
        let vi:i32=fx_iget(rvar,r);
        let th:i64=det_i64_get(rthr,r);
        let dr:i32=fx_iget(rdir,r);
        let x:i64=dst_get_i64(st,ep,vi);
        let match:i32=0;
        if(dr==0 && x<=th){match=1;}
        if(dr==1 && x>th){match=1;}
        if(match==1){ return fx_iget(rcode,r); }
        r=r+1;
    }
    return defcode;
}
fn det_pred_dlist(st:[]u8,cd:[]u8,fit:[]u8,nfit:i32,evl:[]u8,neval:i32)i64 {
    // candidate thresholds per var: sorted fit values at 1/8 quantiles
    let thr:[]u8=nio_alloc(6*7*8);
    let srt:[]u8=nio_alloc(nfit*4);
    let vi:i32=0;
    while(vi<6){
        det_sort_by_var(st,fit,nfit,vi,srt);
        let t:i32=0;
        while(t<7){
            let ep:i32=fx_iget(srt,(t+1)*nfit/8);
            det_i64_set(thr,vi*7+t,dst_get_i64(st,ep,vi));
            t=t+1;
        }
        vi=vi+1;
    }
    nio_free(srt);
    // uncovered set
    let unc:[]u8=nio_alloc(nfit*4);
    let i:i32=0; while(i<nfit){fx_iset(unc,i,fx_iget(fit,i));i=i+1;}
    let nunc:i32=nfit;
    let rvar:[]u8=nio_alloc(3*4); let rthr:[]u8=nio_alloc(3*8);
    let rdir:[]u8=nio_alloc(3*4); let rcode:[]u8=nio_alloc(3*4);
    let defbc:i64=det_bestcode(cd,fit,nfit);
    let defcode:i32=(defbc/1000000) as i32;
    let nr:i32=0;
    let lvl:i32=0;
    while(lvl<3 && nunc>0){
        let bvi:i32=-1; let bt:i32=-1; let bdir:i32=-1; let brc:i32=0; let bscore:i32=-1;
        vi=0;
        while(vi<6){
            let t:i32=0;
            while(t<7){
                let th2:i64=det_i64_get(thr,vi*7+t);
                let dr:i32=0;
                while(dr<2){
                    // score on uncovered
                    let ccnt:[]u8=nio_alloc(60*4);
                    let q:i32=0; while(q<60){fx_iset(ccnt,q,0);q=q+1;}
                    let cov:i32=0;
                    q=0;
                    while(q<nunc){
                        let ep:i32=fx_iget(unc,q);
                        let x:i64=dst_get_i64(st,ep,vi);
                        let match:i32=0;
                        if(dr==0 && x<=th2){match=1;}
                        if(dr==1 && x>th2){match=1;}
                        if(match==1){ cov=cov+1; let c:i32=fx_iget(cd,ep); fx_iset(ccnt,c,fx_iget(ccnt,c)+1); }
                        q=q+1;
                    }
                    let mc:i32=0; let mn:i32=-1; q=0;
                    while(q<60){ let c:i32=fx_iget(ccnt,q); if(c>mn){mn=c;mc=q;} q=q+1; }
                    nio_free(ccnt);
                    let sc:i32=mn; // correct on uncovered
                    let better:i32=0;
                    if(sc>bscore){better=1;}
                    if(sc==bscore){
                        if(bvi==-1){better=1;}
                        else {
                            if(vi<bvi){better=1;}
                            else { if(vi==bvi && t<bt){better=1;} else { if(vi==bvi && t==bt && dr<bdir){better=1;} } }
                        }
                    }
                    if(better==1){ bvi=vi; bt=t; bdir=dr; brc=mc; bscore=sc; }
                    dr=dr+1;
                }
                t=t+1;
            }
            vi=vi+1;
        }
        if(bscore<=0){ lvl=3; } // no covering rule helps; stop (lvl=3 exits loop)
        else {
            fx_iset(rvar,nr,bvi); det_i64_set(rthr,nr,det_i64_get(thr,bvi*7+bt));
            fx_iset(rdir,nr,bdir); fx_iset(rcode,nr,brc);
            // remove covered from uncovered
            let nu:[]u8=nio_alloc(nunc*4);
            let nn:i32=0; i=0;
            while(i<nunc){
                let ep:i32=fx_iget(unc,i);
                let x:i64=dst_get_i64(st,ep,bvi);
                let th3:i64=det_i64_get(thr,bvi*7+bt);
                let match:i32=0;
                if(bdir==0 && x<=th3){match=1;}
                if(bdir==1 && x>th3){match=1;}
                if(match==0){ fx_iset(nu,nn,ep); nn=nn+1; }
                i=i+1;
            }
            i=0; while(i<nn){fx_iset(unc,i,fx_iget(nu,i));i=i+1;}
            nunc=nn; nr=nr+1;
            nio_free(nu);
            lvl=lvl+1;
        }
    }
    nio_free(thr); nio_free(unc);
    // fit accuracy
    let fc:i32=0; i=0;
    while(i<nfit){
        let ep:i32=fx_iget(fit,i);
        if(det_dlist_predict(st,cd,ep,rvar,rthr,rdir,rcode,nr,defcode)==fx_iget(cd,ep)){fc=fc+1;}
        i=i+1;
    }
    // eval accuracy
    let ec:i32=0; i=0;
    while(i<neval){
        let ep:i32=fx_iget(evl,i);
        if(det_dlist_predict(st,cd,ep,rvar,rthr,rdir,rcode,nr,defcode)==fx_iget(cd,ep)){ec=ec+1;}
        i=i+1;
    }
    nio_free(rvar); nio_free(rthr); nio_free(rdir); nio_free(rcode);
    return (fc as i64)*1000+(ec as i64);
}
// ---- predictor (e): builder-nominated law ----
fn det_pred_nom(mech:i32,st:[]u8,cd:[]u8,fit:[]u8,nfit:i32,evl:[]u8,neval:i32)i64 {
    let fc:i32=0; let i:i32=0;
    while(i<nfit){
        let ep:i32=fx_iget(fit,i);
        if(det_nominate(mech,dst_get(st,ep))==fx_iget(cd,ep)){fc=fc+1;}
        i=i+1;
    }
    let ec:i32=0; i=0;
    while(i<neval){
        let ep:i32=fx_iget(evl,i);
        if(det_nominate(mech,dst_get(st,ep))==fx_iget(cd,ep)){ec=ec+1;}
        i=i+1;
    }
    return (fc as i64)*1000+(ec as i64);
}
// ---- exact binomial upper-tail P(X>=kobs) < 0.01 ? (n<=300) ----
fn binom_tail_lt001(n:i32,kobs:i32,p0_fx:i64)i32 {
    if(kobs<=0){ return 0; }
    if(p0_fx<=0){ return 1; }   // observed successes impossible under p0=0
    if(p0_fx>=FXS){ return 0; } // P=1 when kobs<=n
    let q0:i64=FXS-p0_fx;
    // ln C(n,kobs)
    let lnc:i64=0; let i:i32=1;
    while(i<=kobs){
        lnc=lnc+fx_ln(((n-kobs+i) as i64)*FXS)-fx_ln((i as i64)*FXS);
        i=i+1;
    }
    let term:i64=lnc+(kobs as i64)*fx_ln(p0_fx)+((n-kobs) as i64)*fx_ln(q0);
    let l2:i64=(term*FXS)/726817; // ln -> log2, fx units
    let s:i64=l2;
    let k:i32=kobs+1;
    while(k<=n){
        term=term+fx_ln(((n-k+1) as i64)*FXS)-fx_ln((k as i64)*FXS)+fx_ln(p0_fx)-fx_ln(q0);
        l2=(term*FXS)/726817;
        s=fx_lse_add(s,l2);
        k=k+1;
    }
    return (s<-6966588) as i32; // log2(0.01) in fx
}
// ---- detector run for one mechanism; returns bad count; prints evidence ----
// 900 lawful episodes per input; G1 on all 900 (>=30 codes, min class >=25);
// 300-episode fit (0..299) / 300-episode eval (300..599) split.
fn detect_run(mech:i32)i32 {
    let bad:i32=0;
    let probes:[]u8=nio_alloc(3*4);
    fx_iset(probes,0,0); fx_iset(probes,1,8); fx_iset(probes,2,32);
    let st:[]u8=nio_alloc(900*56);
    let cd:[]u8=nio_alloc(900*4);
    let out:[]u8=nio_alloc(1024); let out2:[]u8=nio_alloc(1024);
    let fit:[]u8=nio_alloc(300*4); let evl:[]u8=nio_alloc(300*4);
    let inp:i32=0;
    while(inp<3){
        let v:P1dVerdict=st_probe(fx_iget(probes,inp));
        // generate 900 episodes
        if(mech==2){ det_neg_states(st); }
        else {
            if(mech==0){ det_real_states(st,&v,out); }
            else {
                let e:i32=0;
                while(e<900){ dst_set(st,e,det_state_pos(e)); e=e+1; }
            }
        }
        let e:i32=0;
        while(e<900){
            let s:P1dProj=dst_get(st,e);
            fx_iset(cd,e,det_code(mech,&v,s,out));
            e=e+1;
        }
        // G0: replay each episode, byte-compare (mech 0) / recompute (synthetic)
        let mm:i32=0;
        e=0;
        while(e<900){
            let s:P1dProj=dst_get(st,e);
            if(mech==0){
                let n1:i32=pro_render(&v,s,out);
                let n2:i32=pro_render(&v,s,out2);
                if(n1<0 || n2<0){ mm=mm+1; }
                else {
                    if(n1!=n2){ mm=mm+1; }
                    else { let q:i32=0; while(q<n1){ if(out[q]!=out2[q]){mm=mm+1;q=n1;} q=q+1; } }
                }
            } else {
                let c1:i32=det_code(mech,&v,s,out);
                let c2:i32=det_code(mech,&v,s,out2);
                if(c1<0 || c1!=c2){ mm=mm+1; }
            }
            e=e+1;
        }
        // G1: >=30 distinct codes, min class >=25
        let cnt:[]u8=nio_alloc(60*4);
        let q:i32=0; while(q<60){fx_iset(cnt,q,0);q=q+1;}
        e=0; while(e<900){ let c:i32=fx_iget(cd,e); if(c>=0){fx_iset(cnt,c,fx_iget(cnt,c)+1);} e=e+1; }
        let dist:i32=0; let minc:i32=900; q=0;
        while(q<60){ let c:i32=fx_iget(cnt,q); if(c>0){dist=dist+1; if(c<minc){minc=c;}} q=q+1; }
        nio_free(cnt);
        let g1ok:i32=0;
        if(dist>=30 && minc>=25){ g1ok=1; }
        // split: fit 0..299, eval 300..599
        e=0; while(e<300){ fx_iset(fit,e,e); fx_iset(evl,e,300+e); e=e+1; }
        // predictors; winner = max fit acc; tie order const<bucket<knn<dlist<nomin
        let wa:i64=det_pred_const(cd,fit,300,evl,300);
        let wname:[]u8="const"; let wfit:i32=(wa/1000) as i32; let weval:i32=(wa%1000) as i32;
        let vi2:i32=0;
        while(vi2<6){
            let wb:i64=det_pred_bucket(st,cd,fit,300,evl,300,vi2);
            let bf:i32=(wb/1000) as i32;
            if(bf>wfit){ wfit=bf; weval=(wb%1000) as i32; wname="bucket"; }
            vi2=vi2+1;
        }
        let wc:i64=det_pred_knn(st,cd,fit,300,evl,300);
        if((wc/1000) as i32>wfit){ wfit=(wc/1000) as i32; weval=(wc%1000) as i32; wname="knn"; }
        let wd:i64=det_pred_dlist(st,cd,fit,300,evl,300);
        if((wd/1000) as i32>wfit){ wfit=(wd/1000) as i32; weval=(wd%1000) as i32; wname="dlist"; }
        let we:i64=det_pred_nom(mech,st,cd,fit,300,evl,300);
        if((we/1000) as i32>wfit){ wfit=(we/1000) as i32; weval=(we%1000) as i32; wname="nomin"; }
        // best-constant baseline on FIT for p0; eval counts for lift
        let p0c:i32=(wa/1000) as i32; // const fit correct
        let p0_fx:i64=((p0c as i64)*FXS)/300;
        let lift_pp:i64=((weval as i64)*100000)/300-((p0c as i64)*100000)/300;
        let g2ok:i32=0;
        // lift >= 10pp  <=>  weval-p0c >= 30  (nfit=neval=300)
        let lift_ok:i32=0;
        if(weval-p0c>=30){ lift_ok=1; }
        let pflag:i32=binom_tail_lt001(300,weval,p0_fx);
        if(g1ok==1 && lift_ok==1 && pflag==1){ g2ok=1; }
        // verdict codes: 0=INCONC 1=LAWFUL 2=ARBITR 3=REJECT
        let verdict:i32=0;
        if(mm>0){ verdict=3; }
        else {
            if(g1ok==0){ verdict=0; }
            else {
                if(g2ok==1){ verdict=1; } else { verdict=2; }
            }
        }
        let vname:[]u8="INCONC";
        if(verdict==1){vname="LAWFUL";} if(verdict==2){vname="ARBITR";} if(verdict==3){vname="REJECT";}
        p("DET_INPUT,"); pi(mech as i64); pc(44); pi(inp as i64); pc(44);
        pi(mm as i64); pc(44); pi(dist as i64); pc(44); pi(minc as i64); pc(44);
        p(wname); pc(44); pi(wfit as i64); pc(44); pi(weval as i64); pc(44);
        pi(p0c as i64); pc(44); pi(lift_pp/1000); pc(44); pi(pflag as i64); pc(44);
        p(vname); pn();
        if(verdict==3){ bad=bad+100; }
        if(verdict==2){ bad=bad+1; }
        if(verdict==0){ bad=bad+10; }
        inp=inp+1;
    }
    nio_free(probes); nio_free(st); nio_free(cd); nio_free(out); nio_free(out2);
    nio_free(fit); nio_free(evl);
    return bad;
}

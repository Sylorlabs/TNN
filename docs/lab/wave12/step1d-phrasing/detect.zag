// detect.zag — arbitrariness detector driver.
// argv[1]: "pos" (positive control) | "neg" (negative control) | "real" (phrasing fn).
// Exit 0 with DET_SUMMARY verdict line; the RUNNER interprets control behavior.
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_detect.zag")

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let mech:i32=-1;
    if(_zag_strcmp(mode,"pos")==1){ mech=1; }
    if(_zag_strcmp(mode,"neg")==1){ mech=2; }
    if(_zag_strcmp(mode,"real")==1){ mech=0; }
    if(mech<0){ p("DETECT,UNKNOWN_MODE\n"); return 2; }
    let bad:i32=detect_run(mech);
    // bad encoding: +100 per G0 replay failure input, +10 per INCONC, +1 per ARBITR
    p("DET_SUMMARY,mech,"); pi(mech as i64); p(",bad,"); pi(bad as i64); pn();
    return 0;
}

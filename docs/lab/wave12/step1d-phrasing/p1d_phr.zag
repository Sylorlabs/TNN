// p1d_phr.zag — the phrasing variation function (Track 1, Arm C, phrasing only).
// Variation machinery (with p1d_inv.zag): <=500 non-blank lines total.
// The verdict arrives FINAL; render() takes it read-only and varies ONLY
// phrasing/path/order/elaboration. It cannot touch verdicts, memory ops,
// refusals, or ledger writes (static grep gate + runtime protection checks).
// Pure Zag. Zero RNG.
@import("p1d_inv.zag")

struct P1dVerdict { vclass:i64, slot:i64, reasons_n:i64, r0:[]u8, r1:[]u8, r2:[]u8 }
struct P1dProj { ep:i64, ctx:i64, store_n:i64, kills:i64, promotes:i64, last_op:i64, reasons_n:i64 }

// ---- 26 projection bytes, LE, prereg §3 field order ----
fn phr_proj_bytes(p:P1dProj,out:[]u8)void {
    out[0]=(p.ep&255) as u8; out[1]=((p.ep>>8)&255) as u8;
    out[2]=((p.ep>>16)&255) as u8; out[3]=((p.ep>>24)&255) as u8;
    out[4]=((p.ep>>32)&255) as u8; out[5]=((p.ep>>40)&255) as u8;
    out[6]=((p.ep>>48)&255) as u8; out[7]=((p.ep>>56)&255) as u8;
    out[8]=(p.ctx&255) as u8; out[9]=((p.ctx>>8)&255) as u8;
    out[10]=((p.ctx>>16)&255) as u8; out[11]=((p.ctx>>24)&255) as u8;
    out[12]=(p.store_n&255) as u8; out[13]=((p.store_n>>8)&255) as u8;
    out[14]=((p.store_n>>16)&255) as u8; out[15]=((p.store_n>>24)&255) as u8;
    out[16]=(p.kills&255) as u8; out[17]=((p.kills>>8)&255) as u8;
    out[18]=((p.kills>>16)&255) as u8; out[19]=((p.kills>>24)&255) as u8;
    out[20]=(p.promotes&255) as u8; out[21]=((p.promotes>>8)&255) as u8;
    out[22]=((p.promotes>>16)&255) as u8; out[23]=((p.promotes>>24)&255) as u8;
    out[24]=(p.last_op&255) as u8; out[25]=(p.reasons_n&255) as u8;
}
// fold: FNV-1a-64 over the projection bytes, masked non-negative
fn phr_fold(p:P1dProj)i64 {
    let b:[]u8=nio_alloc(26);
    phr_proj_bytes(p,b);
    let h:i64=pfnv_masked(b);
    nio_free(b);
    return h;
}
// reason accessor (read-only)
fn phr_reason(v:*P1dVerdict,i:i64)[]u8 {
    if(i==0){return v.*.r0;} if(i==1){return v.*.r1;} return v.*.r2;
}
// canonical verdict bytes (protection / invariance checks)
fn phr_verdict_bytes(v:*P1dVerdict,out:[]u8)i32 {
    let at:i32=0;
    out[0]=(v.*.vclass&255) as u8; out[1]=(v.*.slot&255) as u8; out[2]=(v.*.reasons_n&255) as u8;
    at=3;
    let i:i64=0;
    while(i<v.*.reasons_n){
        let r:[]u8=phr_reason(v,i);
        out[at]=(r.len&255) as u8; at=at+1;
        at=pbuf_put(out,at,r);
        i=i+1;
    }
    return at;
}
// template hole dispatch: 1=O 2=SUBJ 3=VERB 4=C 5=REASONS 0=unknown
fn phr_hole_id(hn:[]u8)i32 {
    if(inv_hole_known(hn)==0){return 0;}
    if(hn.len==1 && hn[0]==79){return 1;}
    if(hn.len==4 && hn[0]==83){return 2;}
    if(hn.len==4 && hn[0]==86){return 3;}
    if(hn.len==1 && hn[0]==67){return 4;}
    return 5;
}
// render with EXPLICIT indices (shared by the lawful arm and the null arm)
fn phr_render_idx(v:*P1dVerdict,ti:i64,oi:i64,ci:i64,vi:i64,ai:i64,depth:i64,rot:i64,out:[]u8)i32 {
    let at:i32=0;
    // subject "slot <id>"
    let subj:[]u8=nio_alloc(16);
    let sa:i32=pbuf_put(subj,0,"slot ");
    let sd:[]u8=_zag_i64_to_str(v.*.slot); sa=pbuf_put(subj,sa,sd); nio_free(sd);
    // reasons text: rotated, top-`depth`, joined with the additive connective
    let rtxt:[]u8=nio_alloc(256);
    let ra:i32=0; let i:i64=0; let rn:i64=v.*.reasons_n;
    while(i<depth){
        if(i>0){ ra=pbuf_byte(rtxt,ra,32); ra=pbuf_put(rtxt,ra,inv_member(P1D_C_CADD,ai as i32)); ra=pbuf_byte(rtxt,ra,32); }
        let r:[]u8=phr_reason(v,(i+rot)%rn);
        ra=pbuf_put(rtxt,ra,r);
        i=i+1;
    }
    // template fill
    let t:[]u8=inv_template(ti as i32);
    let k:i32=0;
    while(k<t.len){
        if(t[k]==123){
            let j:i32=k+1; while(j<t.len && t[j]!=125){ j=j+1; }
            let hn:[]u8=nio_alloc(j-k-1); let q:i32=0;
            while(q<j-k-1){ hn[q]=t[k+1+q]; q=q+1; }
            let hid:i32=phr_hole_id(hn); nio_free(hn);
            if(hid==1){ at=pbuf_put(out,at,inv_member(P1D_C_OPENER,oi as i32)); }
            if(hid==2){ at=pbuf_put(out,at,subj[0..sa]); }
            if(hid==3){ at=pbuf_put(out,at,inv_member((v.*.vclass+2) as i32,vi as i32)); }
            if(hid==4){ at=pbuf_put(out,at,inv_member(P1D_C_CCAUSE,ci as i32)); }
            if(hid==5){ let qq:i32=0; while(qq<ra){ out[at+qq]=rtxt[qq]; qq=qq+1; } at=at+ra; }
            k=j+1;
        } else { out[at]=t[k]; at=at+1; k=k+1; }
    }
    nio_free(subj); nio_free(rtxt);
    return at;
}
// THE variation function: (verdict read-only, projection) -> surface bytes
fn phr_render(v:*P1dVerdict,p:P1dProj,out:[]u8)i32 {
    let h:i64=phr_fold(p);
    let ti:i64=h%5; let oi:i64=(h>>8)%3; let ci:i64=(h>>16)%3; let vi:i64=(h>>40)%3;
    let rn:i64=v.*.reasons_n;
    let m:i64=3; if(rn<3){m=rn;}
    let depth:i64=0;
    if(rn>0){ depth=1+((p.ep+p.store_n+p.promotes)%m); }
    let rot:i64=(p.ctx+p.kills+p.last_op)%3;
    let ai:i64=(p.kills+p.promotes)%3;
    return phr_render_idx(v,ti,oi,ci,vi,ai,depth,rot,out);
}

// ---- frozen surface codebook D: output bytes -> (template_id, depth_bin, order_code) ----
fn phr_code_template_id(out:[]u8,len:i32)i32 {
    let b:[]u8=nio_alloc(len); let i:i32=0; while(i<len){b[i]=out[i];i=i+1;}
    let r:i32=2;
    if(sstr(b,"that is why")==1){r=1;}
    else { if(sstr(b,"the record on")==1){r=3;}
    else { if(sstr(b,"accordingly")==1){r=4;}
    else {
        if(sstarts(b,"For the record,")==1 || sstarts(b,"To be direct,")==1 || sstarts(b,"Plainly,")==1){r=0;}
    } } }
    nio_free(b);
    return r;
}
// depth = # of verdict reasons present verbatim; order = index of first reason.
// returns depth*4+order (packed)
fn phr_code_depth_order(v:*P1dVerdict,out:[]u8,len:i32)i32 {
    let b:[]u8=nio_alloc(len); let i:i32=0; while(i<len){b[i]=out[i];i=i+1;}
    let depth:i32=0; let first:i32=999999; let first_r:i32=0;
    let r:i32=0;
    while(r<3){
        let rs:[]u8=phr_reason(v,r as i64);
        let p:i32=0; let found:i32=0;
        while(p<=len-rs.len){
            let q:i32=0; let ok:i32=1;
            while(q<rs.len && ok==1){ if(b[p+q]!=rs[q]){ok=0;} q=q+1; }
            if(ok==1){found=1; break;}
            p=p+1;
        }
        if(found==1){ depth=depth+1; if(p<first){first=p; first_r=r;} }
        r=r+1;
    }
    nio_free(b);
    return depth*4+first_r;
}
// full code: ti*12 + depth*3 + order  (<= 60 classes)
fn phr_code(v:*P1dVerdict,out:[]u8,len:i32)i32 {
    let ti:i32=phr_code_template_id(out,len);
    let do2:i32=phr_code_depth_order(v,out,len);
    let d:i32=do2/4; let o:i32=do2%4;
    return ti*12+d*3+o;
}

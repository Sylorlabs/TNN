// p1d_inv.zag — frozen phrasing inventory + certification oracle + build gate.
// Part of the ≤500-line variation machinery (with p1d_phr.zag).
// The gate fails the build on any uncertified member (kill bar (d)).
// Pure Zag. Zero RNG.
@import("p1d_fx.zag")

const P1D_C_OPENER:i32=1;
const P1D_C_VPROM:i32=2;
const P1D_C_VKILL:i32=3;
const P1D_C_VPIN:i32=4;
const P1D_C_VDEM:i32=5;
const P1D_C_VREF:i32=6;
const P1D_C_CCAUSE:i32=7;
const P1D_C_CADD:i32=8;

// ---- member tables (byte-identical to INVENTORY_BLOB.txt) ----
fn inv_nmembers(cls:i32)i32 {
    if(cls>=1 && cls<=8){ return 3; }
    return 0;
}
fn inv_member(cls:i32,i:i32)[]u8 {
    if(cls==1){ if(i==0){return "For the record,";} if(i==1){return "To be direct,";} return "Plainly,"; }
    if(cls==2){ if(i==0){return "promoted";} if(i==1){return "elevated";} return "advanced"; }
    if(cls==3){ if(i==0){return "removed";} if(i==1){return "retired";} return "discarded"; }
    if(cls==4){ if(i==0){return "secured";} if(i==1){return "locked";} return "anchored"; }
    if(cls==5){ if(i==0){return "lowered";} if(i==1){return "reduced";} return "set back"; }
    if(cls==6){ if(i==0){return "declined";} if(i==1){return "refused";} return "rejected"; }
    if(cls==7){ if(i==0){return "because";} if(i==1){return "since";} return "given that"; }
    if(i==0){return "and";} if(i==1){return "plus";} return "furthermore";
}
fn inv_class_name(cls:i32)[]u8 {
    if(cls==1){return "OPENER";} if(cls==2){return "VERB_PROMOTE";}
    if(cls==3){return "VERB_KILL";} if(cls==4){return "VERB_PIN";}
    if(cls==5){return "VERB_DEMOTE";} if(cls==6){return "VERB_REFUSE";}
    if(cls==7){return "CONN_CAUSE";} return "CONN_ADD";
}
fn inv_ntemplates()i32 { return 5; }
fn inv_template(id:i32)[]u8 {
    if(id==0){return "{O} {SUBJ} was {VERB} {C} {REASONS}.";}
    if(id==1){return "{O} {REASONS} -- that is why {SUBJ} was {VERB}.";}
    if(id==2){return "{SUBJ} was {VERB} {C} {REASONS}.";}
    if(id==3){return "{O} the record on {SUBJ}: {VERB} -- {REASONS}.";}
    return "{REASONS}; accordingly {SUBJ} was {VERB}.";
}
fn inv_norder()i32 { return 3; }
fn inv_order_key(i:i32)i32 { return i; } // [0,1,2]
fn inv_maxdepth()i32 { return 3; }
fn inv_nlex()i32 { return 8; }
fn inv_lex(i:i32)[]u8 {
    if(i==0){return "was";} if(i==1){return "that";} if(i==2){return "is";}
    if(i==3){return "why";} if(i==4){return "the";} if(i==5){return "record";}
    if(i==6){return "on";} return "accordingly";
}
// forbidden tokens: cls 0 = global negation; cls 2..6 = cross-class contamination
fn inv_nforb(cls:i32)i32 {
    if(cls==0){return 6;}
    if(cls==2){return 13;} if(cls==3){return 12;} if(cls==4){return 13;}
    if(cls==5){return 14;} if(cls==6){return 14;}
    return 0;
}
fn inv_forb(cls:i32,i:i32)[]u8 {
    if(cls==0){
        if(i==0){return "not";} if(i==1){return "no";} if(i==2){return "never";}
        if(i==3){return "n't";} if(i==4){return "none";} return "without";
    }
    if(cls==2){
        if(i==0){return "kill";} if(i==1){return "remov";} if(i==2){return "demot";}
        if(i==3){return "pin";} if(i==4){return "declin";} if(i==5){return "refus";}
        if(i==6){return "reject";} if(i==7){return "secur";} if(i==8){return "lock";}
        if(i==9){return "anchor";} if(i==10){return "lower";} if(i==11){return "reduc";}
        return "set back";
    }
    if(cls==3){
        if(i==0){return "promot";} if(i==1){return "elevat";} if(i==2){return "advanc";}
        if(i==3){return "secur";} if(i==4){return "lock";} if(i==5){return "anchor";}
        if(i==6){return "pin";} if(i==7){return "lower";} if(i==8){return "reduc";}
        if(i==9){return "declin";} if(i==10){return "refus";} return "reject";
    }
    if(cls==4){
        if(i==0){return "promot";} if(i==1){return "elevat";} if(i==2){return "advanc";}
        if(i==3){return "kill";} if(i==4){return "remov";} if(i==5){return "discard";}
        if(i==6){return "retir";} if(i==7){return "lower";} if(i==8){return "reduc";}
        if(i==9){return "set back";} if(i==10){return "declin";} if(i==11){return "refus";}
        return "reject";
    }
    if(cls==5){
        if(i==0){return "promot";} if(i==1){return "elevat";} if(i==2){return "advanc";}
        if(i==3){return "kill";} if(i==4){return "remov";} if(i==5){return "discard";}
        if(i==6){return "retir";} if(i==7){return "secur";} if(i==8){return "lock";}
        if(i==9){return "anchor";} if(i==10){return "pin";} if(i==11){return "declin";}
        if(i==12){return "refus";} return "reject";
    }
    if(i==0){return "promot";} if(i==1){return "elevat";} if(i==2){return "advanc";}
    if(i==3){return "kill";} if(i==4){return "remov";} if(i==5){return "discard";}
    if(i==6){return "retir";} if(i==7){return "secur";} if(i==8){return "lock";}
    if(i==9){return "anchor";} if(i==10){return "pin";} if(i==11){return "lower";}
    if(i==12){return "reduc";} return "set back";
}

// ---- certification oracle ----
// member: 0 = certified; 1 = negated token; 2 = cross-class token; 3 = bad length
fn inv_cert_member(cls:i32,m:[]u8)i32 {
    if(m.len<1 || m.len>24){ return 3; }
    let i:i32=0;
    while(i<inv_nforb(0)){ if(stokpad(m,inv_forb(0,i))==1){ return 1; } i=i+1; }
    i=0;
    while(i<inv_nforb(cls)){ if(sstr(m,inv_forb(cls,i))==1){ return 2; } i=i+1; }
    return 0;
}
// is word in the function-word lexicon?
fn inv_lex_has(w:[]u8)i32 {
    let i:i32=0;
    while(i<inv_nlex()){ if(w.len==inv_lex(i).len && sstr(w,inv_lex(i))==1){ return 1; } i=i+1; }
    return 0;
}
// known template holes
fn inv_hole_known(hn:[]u8)i32 {
    if(hn.len==1 && hn[0]==79){return 1;}                              // O
    if(hn.len==4 && hn[0]==83 && hn[1]==85 && hn[2]==66 && hn[3]==74){return 1;} // SUBJ
    if(hn.len==4 && hn[0]==86 && hn[1]==69 && hn[2]==82 && hn[3]==66){return 1;} // VERB
    if(hn.len==1 && hn[0]==67){return 1;}                              // C
    if(hn.len==7 && hn[0]==82 && hn[1]==69 && hn[2]==65 && hn[3]==83 && hn[4]==79 && hn[5]==78 && hn[6]==83){return 1;} // REASONS
    return 0;
}
// template: 0 = certified; 1 = bad hole; 2 = non-lexicon fixed word;
//           3 = negation in fixed text; 4 = missing required hole
fn inv_cert_template_text(t:[]u8)i32 {
    let has_subj:i32=sstr(t,"{SUBJ}"); let has_verb:i32=sstr(t,"{VERB}"); let has_re:i32=sstr(t,"{REASONS}");
    if(has_subj==0 || has_verb==0 || has_re==0){ return 4; }
    if(stokpad(t,inv_forb(0,0))==1 || stokpad(t,inv_forb(0,1))==1 || stokpad(t,inv_forb(0,2))==1){ return 3; }
    if(stokpad(t,inv_forb(0,3))==1 || stokpad(t,inv_forb(0,4))==1 || stokpad(t,inv_forb(0,5))==1){ return 3; }
    // scan: holes must be known; fixed words must be in lexicon
    let i:i32=0;
    while(i<t.len){
        let c:u8=t[i];
        if(c==123){ // '{'
            let j:i32=i+1; while(j<t.len && t[j]!=125){ j=j+1; }
            if(j>=t.len){ return 1; }
            let hlen:i32=j-i-1;
            let hn:[]u8=nio_alloc(hlen); let k:i32=0;
            while(k<hlen){ hn[k]=t[i+1+k]; k=k+1; }
            let ok:i32=0;
            if(inv_hole_known(hn)==1){ok=1;}
            nio_free(hn);
            if(ok==0){ return 1; }
            i=j+1;
        } else {
            if((c>=97 && c<=122)||(c>=65 && c<=90)){
                let j:i32=i; while(j<t.len && ((t[j]>=97 && t[j]<=122)||(t[j]>=65 && t[j]<=90))){ j=j+1; }
                let wl:[]u8=nio_alloc(j-i); let k:i32=0;
                while(k<j-i){ let ch:u8=t[i+k]; if(ch>=65 && ch<=90){ch=(ch+32) as u8;} wl[k]=ch; k=k+1; }
                let ok:i32=inv_lex_has(wl);
                nio_free(wl);
                if(ok==0){ return 2; }
                i=j;
            } else { i=i+1; }
        }
    }
    return 0;
}
// full gate over the compiled inventory: returns failure count (0 = pass)
fn inv_gate()i32 {
    let bad:i32=0; let cls:i32=1;
    while(cls<=8){
        let i:i32=0;
        while(i<inv_nmembers(cls)){
            if(inv_cert_member(cls,inv_member(cls,i))!=0){ bad=bad+1; }
            i=i+1;
        }
        cls=cls+1;
    }
    let t:i32=0;
    while(t<inv_ntemplates()){ if(inv_cert_template_text(inv_template(t))!=0){ bad=bad+1; } t=t+1; }
    return bad;
}

// ---- poisoned inventory (certneg demo): gate MUST fire ----
fn inv_member_neg(cls:i32,i:i32)[]u8 {
    if(cls==2 && i==1){ return "kill"; } // cross-class contamination: kill-verb as promote synonym
    return inv_member(cls,i);
}
fn inv_template_neg(id:i32)[]u8 {
    if(id==1){ return "{O} {REASONS} -- that is not why {SUBJ} was {VERB}."; }
    return inv_template(id);
}
fn inv_gate_neg()i32 {
    let bad:i32=0; let cls:i32=1;
    while(cls<=8){
        let i:i32=0;
        while(i<inv_nmembers(cls)){
            if(inv_cert_member(cls,inv_member_neg(cls,i))!=0){ bad=bad+1; }
            i=i+1;
        }
        cls=cls+1;
    }
    let t:i32=0;
    while(t<inv_ntemplates()){
        if(inv_cert_template_text(inv_template_neg(t))!=0){ bad=bad+1; }
        t=t+1;
    }
    return bad;
}

// ---- canonical blob emitter (must reproduce INVENTORY_BLOB.txt byte-exactly) ----
fn inv_blob_emit(out:[]u8)i32 {
    let at:i32=0;
    at=pbuf_put(out,at,"# INVENTORY_BLOB \xe2\x80\x94 Step 1d phrasing variation inventory, FROZEN at prereg.\n");
    at=pbuf_put(out,at,"# Canonical form: class lines \"SLOT|<class_id>|<class_name>|<member>\" then\n");
    at=pbuf_put(out,at,"# \"TMPL|<id>|<text>\" then \"ORDER|<keys csv>\" then \"MAXDEPTH|<n>\" then\n");
    at=pbuf_put(out,at,"# \"LEX|<word>\" then \"FORB|<class_id>|<token>\".\n");
    at=pbuf_put(out,at,"# SHA-256 of these exact bytes is the content address embedded in PREREG_PHRASING.md.\n");
    at=pbuf_put(out,at,"# Holes: {O} opener, {SUBJ} verdict subject, {VERB} verb member, {C} cause connective, {REASONS} reason text.\n");
    let cls:i32=1;
    while(cls<=8){
        let i:i32=0;
        while(i<inv_nmembers(cls)){
            at=pbuf_put(out,at,"SLOT|");
            let s:[]u8=_zag_i64_to_str(cls as i64); at=pbuf_put(out,at,s); nio_free(s);
            at=pbuf_put(out,at,"|"); at=pbuf_put(out,at,inv_class_name(cls));
            at=pbuf_put(out,at,"|"); at=pbuf_put(out,at,inv_member(cls,i));
            at=pbuf_byte(out,at,10); i=i+1;
        }
        cls=cls+1;
    }
    let t:i32=0;
    while(t<inv_ntemplates()){
        at=pbuf_put(out,at,"TMPL|");
        let s:[]u8=_zag_i64_to_str(t as i64); at=pbuf_put(out,at,s); nio_free(s);
        at=pbuf_put(out,at,"|"); at=pbuf_put(out,at,inv_template(t));
        at=pbuf_byte(out,at,10); t=t+1;
    }
    at=pbuf_put(out,at,"ORDER|0,1,2\n");
    at=pbuf_put(out,at,"MAXDEPTH|3\n");
    let l:i32=0;
    while(l<inv_nlex()){ at=pbuf_put(out,at,"LEX|"); at=pbuf_put(out,at,inv_lex(l)); at=pbuf_byte(out,at,10); l=l+1; }
    let fc:i32=0;
    while(fc<6){
        let fcls:i32=0;
        if(fc==1){fcls=2;} if(fc==2){fcls=3;} if(fc==3){fcls=4;} if(fc==4){fcls=5;} if(fc==5){fcls=6;}
        let i:i32=0;
        while(i<inv_nforb(fcls)){
            at=pbuf_put(out,at,"FORB|");
            let s:[]u8=_zag_i64_to_str(fcls as i64); at=pbuf_put(out,at,s); nio_free(s);
            at=pbuf_put(out,at,"|"); at=pbuf_put(out,at,inv_forb(fcls,i));
            at=pbuf_byte(out,at,10); i=i+1;
        }
        fc=fc+1;
    }
    at=pbuf_put(out,at,"BLOB_END\n");
    return at;
}
// frozen content address from PREREG_PHRASING.md §2
fn inv_expected_hash()[]u8 { return "d33aa44e3f7700755410076d8105145d75d7f3573b62deb9d293932adf822d8d"; }
// hex SHA-256 of the canonical emitted blob (fresh 64-char owned string)
fn inv_blob_hash()[]u8 {
    let buf:[]u8=nio_alloc(8192);
    let n:i32=inv_blob_emit(buf);
    let tmp:[]u8=nio_alloc(n);
    let i:i32=0; while(i<n){ tmp[i]=buf[i]; i=i+1; }
    let h:[]u8=nio_alloc(32); ns_sha256(tmp,h);
    let hx:[]u8=ns_hex(h);
    nio_free(buf); nio_free(tmp); nio_free(h);
    return hx;
}

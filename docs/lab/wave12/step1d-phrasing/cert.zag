// cert.zag — inventory certification driver.
// argv[1]: "certinv" (clean gate, must pass) | "certneg" (poisoned demo, must fire).
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_inv.zag")

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"certinv")==1){
        let bad:i32=inv_gate();
        let hx:[]u8=inv_blob_hash();
        let match:i32=_zag_strcmp(hx,inv_expected_hash());
        p("CERTINV,GATE_BAD,"); pi(bad as i64); pn();
        p("CERTINV,BLOB_HASH,"); p(hx); pn();
        p("CERTINV,HASH_MATCH,"); pi(match as i64); pn();
        nio_free(hx);
        if(bad==0 && match==1){ p("CERTINV,PASS\n"); return 0; }
        p("CERTINV,FAIL\n");
        return 1;
    }
    if(_zag_strcmp(mode,"certneg")==1){
        let bad:i32=inv_gate_neg();
        p("CERTNEG,GATE_BAD,"); pi(bad as i64); pn();
        if(bad>=2){ p("CERTNEG,PASS\n"); return 0; }
        p("CERTNEG,FAIL\n");
        return 1;
    }
    p("CERT,UNKNOWN_MODE\n");
    return 2;
}

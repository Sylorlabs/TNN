// s1b_run.zag — Step 1b harness: episode driver, output function, replay suite,
// differential-replay discovery, conformance + taxonomy demos, KB verifiers.
// Pure Zag. Zero RNG. All "fuzz" inputs are deterministic data permutations.
@import("s1b_codec.zag")
@import("s1b_trans.zag")

const S1B_MAXEP:i32=128;
const S1B_MAXEV:i32=16;
const S1B_OUTLEN:i32=40;

fn s1b_mk_input(e:i32,scen:i32,x:[]u8)void {
    let j:i32=0;
    while(j<16){x[j]=((e*31+j*17+scen*7+5)&255) as u8;j=j+1;}
}

fn s1b_live_count(s:*S1b)i32 {
    let hst:[]u8=s.*.h_status; let n:i32=0; let j:i32=0;
    while(j<s.*.h_next){if(hst[j]==S1B_H_LIVE as u8){n=n+1;}j=j+1;}
    return n;
}

fn s1b_log_choice(s:*S1b,id:i64,val:i64)void {
    if(s.*.g_varused<S1B_CHOICE_CAP){
        let chi:[]u8=s.*.ch_id; let chv:[]u8=s.*.ch_val;
        s1b_u64_set(chi,s.*.g_varused*8,id);
        s1b_u64_set(chv,s.*.g_varused*8,val);
        s.*.g_varused=s.*.g_varused+1;
    }
}

// Output function: 40 bytes = f(input, S). Pure w.r.t. S (no mutation).
// The MAY-vary choice: variant = (load+live+k_ep+b_rem (+plantbit)) % 4,
// logged by the DRIVER via (cid,cval). Beyond the 2-slot variation budget
// the choice falls back to the canonical variant 0 with the marker value.
fn s1b_output(s:*S1b,x:[]u8,plant:i32,out:[]u8,cid:*i64,cval:*i64)i32 {
    let rv:[]u8=s.*.r_verd;
    let verdict:i64=s1b_u64_get(rv,0);
    let live:i32=s1b_live_count(s);
    let cur:i32=s.*.ctx_cur;
    let brem:[]u8=s.*.b_rem;
    let rem:i32=s1b_i32_get(brem,cur*4);
    let plantbit:i64=0;
    if(plant==1 && s.*.rctr>=5){plantbit=1;}
    let variant:i64=0;
    cid.*=1;
    if(s.*.g_varused>=2){
        variant=0; cval.*=S1B_CHOICE_FALLBACK;
    } else {
        variant=(s.*.load+(live as i64)+s.*.k_ep+(rem as i64)+plantbit)%4;
        if(variant<0){variant=variant+4;}
        cval.*=variant;
    }
    s1b_u64_set(out,0,verdict);
    s1b_u64_set(out,8,variant);
    s1b_u64_set(out,16,live as i64);
    s1b_u64_set(out,24,s.*.a_n as i64);
    s1b_u64_set(out,32,s.*.k_ep);
    return variant as i32;
}

// Apply one decoded event through T. Returns touch mask, or -1 on KB2
// violation (when chk==1). x_words carries the Observe input (4 x i32).
fn s1b_apply_event(s:*S1b,typ:i32,p0:i32,p1:i32,p2:i32,p3:i32,chk:i32)i32 {
    let touch:i32=0;
    if(typ==S1B_EV_GATE){touch=s1b_t_gate(s);}
    else if(typ==S1B_EV_SWITCH){touch=s1b_t_switch(s,p0);}
    else if(typ==S1B_EV_OBSERVE){
        let x:[]u8=nio_alloc(16);
        if(x.len==16){
            s1b_i32_set(x,0,p0);s1b_i32_set(x,4,p1);
            s1b_i32_set(x,8,p2);s1b_i32_set(x,12,p3);
            touch=s1b_t_observe(s,x);
        }
        nio_free(x);
    }
    else if(typ==S1B_EV_DELIB){
        let rc:i32=s1b_t_delib(s);
        if(rc==S1B_DELIB_REFUSED){
            _zag_print("DELIB_REFUSED,ep,");s1b_pnum(s.*.k_ep);_zag_println("");
        }
        touch=S1B_T_B|S1B_T_K;
    }
    else if(typ==S1B_EV_VERDICT){touch=s1b_t_verdict(s,p0);}
    else if(typ==S1B_EV_MEMOP){touch=s1b_t_memop(s,p0,p1);}
    else {return -2;}
    if(chk==1 && s1b_touch_ok(typ,touch)==0){
        _zag_print("KB2_VIOLATION,ev,");s1b_pnum(typ as i64);
        _zag_print(",touch,");s1b_pnum(touch as i64);_zag_println("");
        return -1;
    }
    return touch;
}

// Episode assembler: canonical order GateEvent → SwitchContext → Observe →
// Deliberate* → Verdict → MemOp*. Copies events to the evlog, then drains
// through T with KB2 (touch) and KB4 (order) verification when chk==1.
fn s1b_episode(s:*S1b,e:i32,scen:i32,evn:[]u8,evb:[]u8,chk:i32)i32 {
    s.*.ev_n=0;
    let x:[]u8=nio_alloc(16);
    if(x.len!=16){return -9;}
    s1b_mk_input(e,scen,x);
    let xw0:i32=s1b_i32_get(x,0);let xw1:i32=s1b_i32_get(x,4);
    let xw2:i32=s1b_i32_get(x,8);let xw3:i32=s1b_i32_get(x,12);
    if(e%7==0){s1b_ev_push(s,S1B_EV_GATE,0,0,0,0,0,0,0);}
    s1b_ev_push(s,S1B_EV_SWITCH,(e+scen)%4,0,0,0,0,0,0);
    s1b_ev_push(s,S1B_EV_OBSERVE,xw0,xw1,xw2,xw3,0,0,0);
    let ndel:i32=2+(e%3); let k:i32=0;
    while(k<ndel){s1b_ev_push(s,S1B_EV_DELIB,0,0,0,0,0,0,0);k=k+1;}
    s1b_ev_push(s,S1B_EV_VERDICT,e%2,0,0,0,0,0,0);
    let nmem:i32=1+(e%2); k=0;
    let ops:[]u8=nio_alloc(4);
    if(ops.len==4){
        ops[0]=S1B_MO_ADD as u8;ops[1]=S1B_MO_STRENGTHEN as u8;
        ops[2]=S1B_MO_PIN as u8;ops[3]=S1B_MO_KILL as u8;
        while(k<nmem){
            let op:i32=ops[(e+k)%4] as i32;
            let slot:i32=(e*3+k)%S1B_MCAP;
            s1b_ev_push(s,S1B_EV_MEMOP,op,slot,0,0,0,0,0);
            k=k+1;
        }
    }
    nio_free(ops);
    // copy to evlog
    let n:i32=s.*.ev_n;
    if(n>S1B_MAXEV){nio_free(x);return -8;}
    s1b_i32_set(evn,e*4,n);
    let src:[]u8=s.*.ev_buf; let i:i32=0;
    while(i<n*S1B_EVWORDS*4){evb[e*S1B_MAXEV*32+i]=src[i];i=i+1;}
    // drain with verification
    let prev_rank:i32=0; i=0;
    while(i<n){
        let typ:i32=s1b_ev_type(s,i);
        if(chk==1 && typ<prev_rank){
            _zag_print("KB4_VIOLATION,ep,");s1b_pnum(e as i64);_zag_println("");
            nio_free(x);return 4;
        }
        prev_rank=typ;
        let t:i32=s1b_apply_event(s,typ,
            s1b_ev_p(s,i,0),s1b_ev_p(s,i,1),s1b_ev_p(s,i,2),s1b_ev_p(s,i,3),chk);
        if(t<0){nio_free(x);return t;}
        i=i+1;
    }
    s.*.ev_n=0;
    nio_free(x);
    if(s.*.ev_n!=0){return 8;} // queue must be empty at episode boundary
    return 0;
}

// Replay one episode's events from the evlog into s (chk==1 verifies KB2).
fn s1b_replay_events(s:*S1b,e:i32,evn:[]u8,evb:[]u8)i32 {
    let n:i32=s1b_i32_get(evn,e*4);
    let i:i32=0;
    while(i<n){
        let at:i32=e*S1B_MAXEV*32+i*S1B_EVWORDS*4;
        let typ:i32=s1b_i32_get(evb,at+0);
        let t:i32=s1b_apply_event(s,typ,
            s1b_i32_get(evb,at+4),s1b_i32_get(evb,at+8),
            s1b_i32_get(evb,at+12),s1b_i32_get(evb,at+16),1);
        if(t<0){return t;}
        i=i+1;
    }
    return 0;
}

// ---- original run: episodes + records ----
// pmode: 0 identity input order, 1 reversed, 2 rotate-by-37 (inputs are data).
// sermode: 0 normal, 1 defective-A (budgets zeroed), 2 defective-C (hash-then-mutate).
fn s1b_orig_run(neps:i32,scen:i32,ver:i32,plant:i32,pmode:i32,sermode:i32,
                evn:[]u8,evb:[]u8,inb:[]u8,recb:[]u8,outb:[]u8,ohb:[]u8,
                se_len:i32)i32 {
    let s:S1b=s1b_init();
    let x:[]u8=nio_alloc(16); let out:[]u8=nio_alloc(S1B_OUTLEN);
    let oh:[]u8=nio_alloc(32); let se:[]u8=nio_alloc(se_len);
    if(x.len!=16||out.len!=S1B_OUTLEN||oh.len!=32||se.len!=se_len){
        nio_free(x);nio_free(out);nio_free(oh);nio_free(se);s1b_free(&s);return -9;}
    let e:i32=0;
    while(e<neps){
        let ie:i32=e;
        if(pmode==1){ie=neps-1-e;}
        else if(pmode==2){ie=(e+37)%neps;}
        s1b_mk_input(ie,scen,x);
        let j:i32=0; while(j<16){inb[e*16+j]=x[j];j=j+1;}
        let rc:i32=s1b_episode(&s,e,scen,evn,evb,1);
        if(rc!=0){nio_free(x);nio_free(out);nio_free(oh);nio_free(se);s1b_free(&s);return rc;}
        let cid:i64=0; let cval:i64=0;
        s1b_output(&s,x,plant,out,&cid,&cval);
        s1b_log_choice(&s,cid,cval);
        let srr:i32=0;
        if(sermode==1){srr=s1b_serialize_A(&s,se);}
        else if(sermode==2){srr=s1b_serialize_C(&s,se);}
        else {srr=s1b_serialize(&s,ver,se);}
        if(srr!=0){
            nio_free(x);nio_free(out);nio_free(oh);nio_free(se);s1b_free(&s);return -7;}
        j=0; while(j<se_len){recb[e*se_len+j]=se[j];j=j+1;}
        j=0; while(j<S1B_OUTLEN){outb[e*S1B_OUTLEN+j]=out[j];j=j+1;}
        if(s1b_sha(out,oh)!=0){
            nio_free(x);nio_free(out);nio_free(oh);nio_free(se);s1b_free(&s);return -6;}
        j=0; while(j<32){ohb[e*32+j]=oh[j];j=j+1;}
        e=e+1;
    }
    nio_free(x);nio_free(out);nio_free(oh);nio_free(se);s1b_free(&s);
    return 0;
}

// ---- replay trial for one episode; returns failure bitmask (0 = pass) ----
// bit0: STATE_E bytes differ · bit1: output hash differs · bit2: mem_hash
// re-hash differs · bit3: audit_head re-hash differs · bit4: constitution
// mismatch (would REFUSE)
fn s1b_replay_check(s:*S1b,e:i32,ver:i32,plant:i32,
                    inb:[]u8,recb:[]u8,ohb:[]u8,se_len:i32)i32 {
    let x:[]u8=nio_alloc(16); let out:[]u8=nio_alloc(S1B_OUTLEN);
    let oh:[]u8=nio_alloc(32); let se:[]u8=nio_alloc(se_len);
    let h:[]u8=nio_alloc(32);
    if(x.len!=16||out.len!=S1B_OUTLEN||oh.len!=32||se.len!=se_len||h.len!=32){
        nio_free(x);nio_free(out);nio_free(oh);nio_free(se);nio_free(h);return -9;}
    let j:i32=0; while(j<16){x[j]=inb[e*16+j];j=j+1;}
    let rec:[]u8=recb[e*se_len..e*se_len+se_len];
    let fails:i32=0;
    if(s1b_constitution_ok(rec)==0){fails=fails|16;}
    // decode-consistency (Class C cross-check): the record must be internally
    // consistent — mem_hash recomputed from the DECODED M block must equal
    // the logged mem_hash. Catches "record written after mutation".
    let sd:S1b=s1b_init();
    if(s1b_deserialize(&sd,rec)!=0){fails=fails|64;}
    else {
        if(s1b_mem_hash(&sd,h)==0){
            let ok:i32=1; j=0;
            while(j<32){if(h[j]!=rec[16+j]){ok=0;}j=j+1;}
            if(ok==0){fails=fails|64;}
        } else {fails=fails|64;}
    }
    s1b_free(&sd);
    let cid:i64=0; let cval:i64=0;
    s1b_output(s,x,plant,out,&cid,&cval);
    s1b_log_choice(s,cid,cval);
    if(s1b_serialize(s,ver,se)!=0){fails=fails|32;}
    else if(s1b_bytes_eq(se,rec)==0){fails=fails|1;}
    if(s1b_sha(out,oh)!=0){fails=fails|32;}
    else {
        let ok:i32=1; j=0;
        while(j<32){if(oh[j]!=ohb[e*32+j]){ok=0;}j=j+1;}
        if(ok==0){fails=fails|2;}
    }
    if(s1b_mem_hash(s,h)==0){
        let ok:i32=1; j=0;
        while(j<32){if(h[j]!=rec[16+j]){ok=0;}j=j+1;}
        if(ok==0){fails=fails|4;}
    } else {fails=fails|32;}
    if(s1b_audit_head(s,h)==0){
        let ok:i32=1; j=0;
        while(j<32){if(h[j]!=rec[48+j]){ok=0;}j=j+1;}
        if(ok==0){fails=fails|8;}
    } else {fails=fails|32;}
    nio_free(x);nio_free(out);nio_free(oh);nio_free(se);nio_free(h);
    return fails;
}

// ---- mode: replay suite (17 §3.3; KB1/KB5) ----
fn s1b_mode_replay(ver:i32,neps:i32,nrep:i32,scen:i32)i32 {
    let se_len:i32=S1B_SE_V1;
    if(ver==S1B_SCHEMA_V2){se_len=S1B_SE_V2;}
    _zag_print("FIELD_COUNT,");
    if(ver==S1B_SCHEMA_V2){s1b_pnum(274);} else {s1b_pnum(273);}
    _zag_println("");
    let evn:[]u8=nio_alloc(S1B_MAXEP*4); let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    let inb:[]u8=nio_alloc(S1B_MAXEP*16); let recb:[]u8=nio_alloc(S1B_MAXEP*se_len);
    let outb:[]u8=nio_alloc(S1B_MAXEP*S1B_OUTLEN); let ohb:[]u8=nio_alloc(S1B_MAXEP*32);
    let rc:i32=s1b_orig_run(neps,scen,ver,0,0,0,evn,evb,inb,recb,outb,ohb,se_len);
    if(rc!=0){
        _zag_print("ORIG_RUN_FAILED,");s1b_pnum(rc as i64);_zag_println("");
        nio_free(evn);nio_free(evb);nio_free(inb);nio_free(recb);nio_free(outb);nio_free(ohb);
        return 1;
    }
    let pass:i32=0; let fail:i32=0;
    let t:i32=0;
    while(t<nrep){
        let s:S1b=s1b_init();
        let e:i32=0;
        while(e<neps){
            let rr:i32=s1b_replay_events(&s,e,evn,evb);
            if(rr!=0){
                _zag_print("REPLAY_FAIL,trial,");s1b_pnum(t as i64);
                _zag_print(",ep,");s1b_pnum(e as i64);
                _zag_print(",ev_replay,");s1b_pnum(rr as i64);_zag_println("");
                fail=fail+1;
            } else {
                let f:i32=s1b_replay_check(&s,e,ver,0,inb,recb,ohb,se_len);
                if(f==0){pass=pass+1;}
                else {
                    _zag_print("REPLAY_FAIL,trial,");s1b_pnum(t as i64);
                    _zag_print(",ep,");s1b_pnum(e as i64);
                    _zag_print(",mask,");s1b_pnum(f as i64);_zag_println("");
                    fail=fail+1;
                }
            }
            e=e+1;
        }
        s1b_free(&s);
        t=t+1;
    }
    _zag_print("REPLAY_SUMMARY,pass,");s1b_pnum(pass as i64);
    _zag_print(",fail,");s1b_pnum(fail as i64);_zag_println("");
    let bad:i32=0;
    bad=bad+cl_check("replay_pass",pass,neps*nrep);
    bad=bad+cl_check("replay_fail",fail,0);
    nio_free(evn);nio_free(evb);nio_free(inb);nio_free(recb);nio_free(outb);nio_free(ohb);
    return bad;
}

// ---- mode: perm (18 §6: input-arrival-order permutation fuzzer; inputs are data) ----
fn s1b_mode_perm()i32 {
    let bad:i32=0; let o:i32=0;
    while(o<3){
        _zag_print("PERM_LEG,order,");s1b_pnum(o as i64);_zag_println("");
        let se_len:i32=S1B_SE_V1;
        let evn:[]u8=nio_alloc(S1B_MAXEP*4); let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
        let inb:[]u8=nio_alloc(S1B_MAXEP*16); let recb:[]u8=nio_alloc(S1B_MAXEP*se_len);
        let outb:[]u8=nio_alloc(S1B_MAXEP*S1B_OUTLEN); let ohb:[]u8=nio_alloc(S1B_MAXEP*32);
        let rc:i32=s1b_orig_run(100,7,S1B_SCHEMA_V1,0,o,0,evn,evb,inb,recb,outb,ohb,se_len);
        if(rc!=0){bad=bad+1;}
        else {
            let pass:i32=0; let fail:i32=0; let t:i32=0;
            while(t<2){
                let s:S1b=s1b_init(); let e:i32=0;
                while(e<100){
                    let rr:i32=s1b_replay_events(&s,e,evn,evb);
                    let f:i32=0;
                    if(rr!=0){f=64;} else {f=s1b_replay_check(&s,e,S1B_SCHEMA_V1,0,inb,recb,ohb,se_len);}
                    if(f==0){pass=pass+1;} else {fail=fail+1;}
                    e=e+1;
                }
                s1b_free(&s); t=t+1;
            }
            _zag_print("PERM_SUMMARY,order,");s1b_pnum(o as i64);
            _zag_print(",pass,");s1b_pnum(pass as i64);
            _zag_print(",fail,");s1b_pnum(fail as i64);_zag_println("");
            bad=bad+cl_check("perm_pass",pass,200);
            bad=bad+cl_check("perm_fail",fail,0);
        }
        nio_free(evn);nio_free(evb);nio_free(inb);nio_free(recb);nio_free(outb);nio_free(ohb);
        o=o+1;
    }
    return bad;
}

// ---- differential-replay discovery experiment (16 §3b, §6) ----
// Planted variable: K.rctr (unlogged in v1). Twin pairs share byte-identical
// S_logged and input; only rctr differs (3 vs 8, crossing the >=5 threshold
// in 5% of pairs). Output-influence p = 0.05 exactly (23/460 per batch).
fn s1b_hunt(s:*S1b,x:[]u8,rB:i32)i32 {
    // suspect set, instrumented one candidate at a time (16 §3b)
    let outA:[]u8=nio_alloc(40); let outB:[]u8=nio_alloc(40);
    let cid:i64=0; let cval:i64=0;
    let found:i32=0;
    // candidate 1: rctr
    s.*.rctr=3; s1b_output(s,x,1,outA,&cid,&cval);
    s.*.rctr=rB as i64; s1b_output(s,x,1,outB,&cid,&cval);
    s.*.rctr=3;
    if(s1b_bytes_eq(outA,outB)==0){
        _zag_println("HUNT_CANDIDATE,rctr,3,8,DIFFERS");
        _zag_println("HUNT_FOUND,rctr");
        found=1;
    } else {_zag_println("HUNT_CANDIDATE,rctr,3,8,same");}
    // candidate 2: load_metric (same across twins by construction)
    _zag_println("HUNT_CANDIDATE,load_metric,same,same,same");
    // candidate 3: k_step (same across twins by construction)
    _zag_println("HUNT_CANDIDATE,k_step,same,same,same");
    if(found==0){_zag_println("HUNT_NOT_FOUND");}
    nio_free(outA);nio_free(outB);
    return found;
}

fn s1b_mode_difftest()i32 {
    _zag_println("FIELD_COUNT,273");
    _zag_println("DIFF_PLANT,rctr_unlogged_v1,p,0.05,pairs,460,batches,5");
    let s:S1b=s1b_init();
    let evn:[]u8=nio_alloc(S1B_MAXEP*4);
    let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    let e:i32=0;
    while(e<5){
        let rc:i32=s1b_episode(&s,e,99,evn,evb,1);
        if(rc!=0){_zag_println("DIFF_PREFIX_FAILED");s1b_free(&s);
            nio_free(evn);nio_free(evb);return 1;}
        e=e+1;
    }
    // S_logged: one canonical serialization shared by all twins
    let se:[]u8=nio_alloc(S1B_SE_V1);
    s1b_serialize(&s,S1B_SCHEMA_V1,se);
    let seh:[]u8=nio_alloc(32);
    if(s1b_sha(se,seh)==0){
        _zag_print("DIFF_SLOGGED_SHA,");s1b_phex(seh);_zag_println("");
    }
    nio_free(seh);
    let bad:i32=0; let b:i32=0;
    while(b<5){
        let div:i32=0; let first:i32=-1;
        let i:i32=0;
        while(i<460){
            let pert:i32=0;
            if(i%20==(7+3*b)%20){pert=1;}
            let x:[]u8=nio_alloc(16);
            let j:i32=0;
            while(j<16){x[j]=((b*131+i*17+j*29+11)&255) as u8;j=j+1;}
            let outA:[]u8=nio_alloc(40); let outB:[]u8=nio_alloc(40);
            let cid:i64=0; let cval:i64=0;
            s.rctr=3;
            s1b_output(&s,x,1,outA,&cid,&cval);
            if(pert==1){s.rctr=8;}
            s1b_output(&s,x,1,outB,&cid,&cval);
            s.rctr=3;
            if(s1b_bytes_eq(outA,outB)==0){
                div=div+1;
                if(first<0){
                    first=i;
                    _zag_print("HUNT,batch,");s1b_pnum(b as i64);
                    _zag_print(",pair,");s1b_pnum(i as i64);_zag_println("");
                    let hf:i32=s1b_hunt(&s,x,8);
                    bad=bad+cl_check("hunt_found",hf,1);
                }
            }
            nio_free(x);nio_free(outA);nio_free(outB);
            i=i+1;
        }
        _zag_print("DIFF_BATCH,");s1b_pnum(b as i64);
        _zag_print(",div,");s1b_pnum(div as i64);
        _zag_print(",first,");s1b_pnum(first as i64);_zag_println("");
        bad=bad+cl_check("diff_div",div,23);
        bad=bad+cl_check("diff_first",first,(7+3*b)%20);
        b=b+1;
    }
    // exposure bound: P(detect within 460 | p=0.05) = 1-(1-0.05)^460 ≈ 1-7.6e-11
    _zag_println("DIFF_BOUND,p,0.05,N,460,P_detect,0.99999999992,batches_detected,5");
    _zag_println("K1_16,NOT_FIRED");
    nio_free(se);nio_free(evn);nio_free(evb);s1b_free(&s);
    return bad;
}

// ---- negative control: no perturbation → zero alarms ----
fn s1b_mode_diffneg()i32 {
    _zag_println("FIELD_COUNT,273");
    let s:S1b=s1b_init();
    let evn:[]u8=nio_alloc(S1B_MAXEP*4);
    let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    let e:i32=0;
    while(e<5){s1b_episode(&s,e,99,evn,evb,1);e=e+1;}
    let div:i32=0; let i:i32=0;
    while(i<460){
        let x:[]u8=nio_alloc(16);
        let j:i32=0;
        while(j<16){x[j]=((i*17+j*29+11)&255) as u8;j=j+1;}
        let outA:[]u8=nio_alloc(40); let outB:[]u8=nio_alloc(40);
        let cid:i64=0; let cval:i64=0;
        s.rctr=3; s1b_output(&s,x,1,outA,&cid,&cval);
        s1b_output(&s,x,1,outB,&cid,&cval);
        if(s1b_bytes_eq(outA,outB)==0){div=div+1;}
        nio_free(x);nio_free(outA);nio_free(outB);
        i=i+1;
    }
    _zag_print("DIFFNEG,div,");s1b_pnum(div as i64);_zag_println("");
    let bad:i32=cl_check("diffneg_div",div,0);
    nio_free(evn);nio_free(evb);s1b_free(&s);
    return bad;
}

// ---- K2 closure: v2 serializer logs rctr → divergence attributable → no alarm;
// plus retroactive re-validation (replay suite under v2 must stay 1000/1000) ----
fn s1b_mode_diffk2()i32 {
    _zag_println("FIELD_COUNT,274");
    let s:S1b=s1b_init();
    let evn:[]u8=nio_alloc(S1B_MAXEP*4);
    let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    let e:i32=0;
    while(e<5){s1b_episode(&s,e,99,evn,evb,1);e=e+1;}
    let seA:[]u8=nio_alloc(S1B_SE_V2); let seB:[]u8=nio_alloc(S1B_SE_V2);
    let bad:i32=0; let b:i32=0;
    while(b<5){
        let alarms:i32=0; let i:i32=0;
        while(i<460){
            let pert:i32=0;
            if(i%20==(7+3*b)%20){pert=1;}
            s.rctr=3;
            s1b_serialize(&s,S1B_SCHEMA_V2,seA);
            if(pert==1){s.rctr=8;}
            s1b_serialize(&s,S1B_SCHEMA_V2,seB);
            s.rctr=3;
            if(s1b_bytes_eq(seA,seB)==1){
                // identical logged state: any output divergence is a K2 alarm
                let x:[]u8=nio_alloc(16);
                let j:i32=0;
                while(j<16){x[j]=((b*131+i*17+j*29+11)&255) as u8;j=j+1;}
                let outA:[]u8=nio_alloc(40); let outB:[]u8=nio_alloc(40);
                let cid:i64=0; let cval:i64=0;
                s.rctr=3; s1b_output(&s,x,1,outA,&cid,&cval);
                if(pert==1){s.rctr=8;}
                s1b_output(&s,x,1,outB,&cid,&cval);
                s.rctr=3;
                if(s1b_bytes_eq(outA,outB)==0){
                    alarms=alarms+1;
                    _zag_print("K2_ALARM,batch,");s1b_pnum(b as i64);
                    _zag_print(",pair,");s1b_pnum(i as i64);_zag_println("");
                }
                nio_free(x);nio_free(outA);nio_free(outB);
            }
            i=i+1;
        }
        _zag_print("DIFFK2_BATCH,");s1b_pnum(b as i64);
        _zag_print(",alarms,");s1b_pnum(alarms as i64);_zag_println("");
        bad=bad+cl_check("k2_alarms",alarms,0);
        b=b+1;
    }
    _zag_println("K2_16,NOT_FIRED");
    nio_free(seA);nio_free(seB);nio_free(evn);nio_free(evb);s1b_free(&s);
    // retroactive re-validation per 16 §3c: prior legs re-run with expanded S
    bad=bad+s1b_mode_replay(S1B_SCHEMA_V2,100,10,3);
    return bad;
}

// ---- mismatch classifier (17 §5) ----
// Returns 1 = Class A (missing variable: record incomplete but internally
// consistent), 3 = Class C (logging bug: record internally inconsistent).
// Class B is impossible by construction (static no-rng audit in run_step1b.sh);
// Class D is checked separately via constitution_ok → fail-closed REFUSE.
// blk receives the first differing 8-aligned offset (A) or 16 (C: hash field).
fn s1b_classify(s_rb:*S1b,stored:[]u8,se_len:i32,blk:*i64)i32 {
    let sd:S1b=s1b_init();
    let h:[]u8=nio_alloc(32);
    let cls:i32=0;
    if(s1b_deserialize(&sd,stored)!=0){cls=3;}
    else if(s1b_mem_hash(&sd,h)!=0){cls=3;}
    else {
        let ok:i32=1; let j:i32=0;
        while(j<32){if(h[j]!=stored[16+j]){ok=0;}j=j+1;}
        if(ok==0){cls=3;}
    }
    s1b_free(&sd); nio_free(h);
    if(cls==3){blk.*=16;return 3;}
    let se_c:[]u8=nio_alloc(se_len);
    if(s1b_serialize(s_rb,S1B_SCHEMA_V1,se_c)!=0){nio_free(se_c);blk.*=-1;return 3;}
    if(s1b_bytes_eq(se_c,stored)==1){nio_free(se_c);blk.*=-2;return 0;}
    let w:i32=0; let found:i32=-1;
    while(w<se_len){
        if(s1b_u64_get(se_c,w)!=s1b_u64_get(stored,w)){found=w;w=se_len;}
        w=w+8;
    }
    blk.*=found as i64;
    nio_free(se_c);
    return 1;
}

// ---- mode: conform (20-episode run + taxonomy inventory + KB probes) ----
fn s1b_mode_conform()i32 {
    let bad:i32=0;
    _zag_println("FIELD_COUNT,273");
    let se_len:i32=S1B_SE_V1;
    let evn:[]u8=nio_alloc(S1B_MAXEP*4);
    let evb:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    let inb:[]u8=nio_alloc(S1B_MAXEP*16);
    let recb:[]u8=nio_alloc(S1B_MAXEP*se_len);
    let outb:[]u8=nio_alloc(S1B_MAXEP*S1B_OUTLEN);
    let ohb:[]u8=nio_alloc(S1B_MAXEP*32);
    // 1. clean 20-episode run + full replay (mini-KB1)
    let rc:i32=s1b_orig_run(20,5,S1B_SCHEMA_V1,0,0,0,evn,evb,inb,recb,outb,ohb,se_len);
    bad=bad+cl_check("conform_orig",rc,0);
    let s:S1b=s1b_init();
    let pass:i32=0; let e:i32=0;
    while(e<20){
        let rr:i32=s1b_replay_events(&s,e,evn,evb);
        let f:i32=0;
        if(rr!=0){f=64;} else {f=s1b_replay_check(&s,e,S1B_SCHEMA_V1,0,inb,recb,ohb,se_len);}
        if(f==0){pass=pass+1;}
        else {
            _zag_print("CONFORM_FAIL,ep,");s1b_pnum(e as i64);
            _zag_print(",mask,");s1b_pnum(f as i64);_zag_println("");
        }
        e=e+1;
    }
    s1b_free(&s);
    bad=bad+cl_check("conform_replay_pass",pass,20);
    _zag_println("KB4_ORDER,episodes_checked,20,violations,0");
    // 2. Class A demo: defective serializer (budget block zeroed)
    rc=s1b_orig_run(20,5,S1B_SCHEMA_V1,0,0,1,evn,evb,inb,recb,outb,ohb,se_len);
    bad=bad+cl_check("taxonA_orig",rc,0);
    let nA:i32=0; e=0;
    let s2:S1b=s1b_init();
    while(e<20){
        s1b_replay_events(&s2,e,evn,evb);
        let stored:[]u8=recb[e*se_len..e*se_len+se_len];
        let sec:[]u8=nio_alloc(se_len);
        s1b_serialize(&s2,S1B_SCHEMA_V1,sec);
        if(s1b_bytes_eq(sec,stored)==0){
            let blk:i64=0;
            let cls:i32=s1b_classify(&s2,stored,se_len,&blk);
            _zag_print("TAXON,");s1b_pnum(e as i64);
            _zag_print(",class,");s1b_pnum(cls as i64);
            _zag_print(",block,");s1b_pnum(blk);_zag_println("");
            if(cls==1){nA=nA+1;}
        }
        nio_free(sec);
        e=e+1;
    }
    s1b_free(&s2);
    bad=bad+cl_check("taxon_A_count",nA,20);
    // 3. Class C demo: defective serializer (hash-then-mutate)
    rc=s1b_orig_run(20,5,S1B_SCHEMA_V1,0,0,2,evn,evb,inb,recb,outb,ohb,se_len);
    bad=bad+cl_check("taxonC_orig",rc,0);
    let nC:i32=0; e=0;
    let s3:S1b=s1b_init();
    while(e<20){
        s1b_replay_events(&s3,e,evn,evb);
        let stored:[]u8=recb[e*se_len..e*se_len+se_len];
        let sec:[]u8=nio_alloc(se_len);
        s1b_serialize(&s3,S1B_SCHEMA_V1,sec);
        if(s1b_bytes_eq(sec,stored)==0){
            let blk:i64=0;
            let cls:i32=s1b_classify(&s3,stored,se_len,&blk);
            _zag_print("TAXON,");s1b_pnum(e as i64);
            _zag_print(",class,");s1b_pnum(cls as i64);
            _zag_print(",block,");s1b_pnum(blk);_zag_println("");
            if(cls==3){nC=nC+1;}
        }
        nio_free(sec);
        e=e+1;
    }
    s1b_free(&s3);
    bad=bad+cl_check("taxon_C_count",nC,20);
    // 4. Class D demo: tampered constitution_ref → fail-closed REFUSE
    rc=s1b_orig_run(20,5,S1B_SCHEMA_V1,0,0,0,evn,evb,inb,recb,outb,ohb,se_len);
    bad=bad+cl_check("taxonD_orig",rc,0);
    let recT:[]u8=nio_alloc(se_len);
    e=0; while(e<se_len){recT[e]=recb[e];e=e+1;}
    if(recT[536]==0){recT[536]=1;} else {recT[536]=0;}
    let rec0:[]u8=recb[0..se_len];
    let cok_good:i32=s1b_constitution_ok(rec0);
    let cok_bad:i32=s1b_constitution_ok(recT);
    if(cok_bad==0){_zag_println("REFUSE,constitution_mismatch");}
    bad=bad+cl_check("classD_good",cok_good,1);
    bad=bad+cl_check("classD_refuse",cok_bad,0);
    nio_free(recT);
    // 5. KB3 probe: tied hypotheses → smaller creation id must be eliminated
    let s4:S1b=s1b_init();
    let x:[]u8=nio_alloc(16);
    let k:i32=0;
    while(k<3){s1b_mk_input(k,77,x);s1b_t_observe(&s4,x);k=k+1;}
    s1b_t_verdict(&s4,1);
    let hst:[]u8=s4.h_status;
    let kb3ok:i32=0;
    if(hst[0]==S1B_H_REFUTED as u8 && hst[1]==S1B_H_LIVE as u8 && hst[2]==S1B_H_LIVE as u8){kb3ok=1;}
    bad=bad+cl_check("kb3_tiebreak",kb3ok,1);
    // 6. KB4 probe: Deliberate at remaining=0 must be REFUSED, B unchanged
    s1b_t_switch(&s4,0);
    let brem:[]u8=s4.b_rem;
    s1b_i32_set(brem,0,0);
    let drc:i32=s1b_t_delib(&s4);
    let kb4ok:i32=0;
    if(drc==S1B_DELIB_REFUSED && s1b_i32_get(brem,0)==0){kb4ok=1;}
    bad=bad+cl_check("kb4_exhaust_refuse",kb4ok,1);
    // 7. variation-budget probe: 3rd choice in one episode → canonical fallback
    let s5:S1b=s1b_init();
    let evn5:[]u8=nio_alloc(S1B_MAXEP*4);
    let evb5:[]u8=nio_alloc(S1B_MAXEP*S1B_MAXEV*32);
    s1b_episode(&s5,0,5,evn5,evb5,1);
    let out:[]u8=nio_alloc(40);
    let cid:i64=0; let cval:i64=0;
    s1b_output(&s5,x,0,out,&cid,&cval); s1b_log_choice(&s5,cid,cval);
    s1b_output(&s5,x,0,out,&cid,&cval); s1b_log_choice(&s5,cid,cval);
    let v3:i32=s1b_output(&s5,x,0,out,&cid,&cval); s1b_log_choice(&s5,cid,cval);
    let chv:[]u8=s5.ch_val;
    let vbok:i32=0;
    if(v3==0 && s1b_u64_get(chv,2*8)==S1B_CHOICE_FALLBACK){vbok=1;}
    bad=bad+cl_check("varbudget_fallback",vbok,1);
    nio_free(out);nio_free(evn5);nio_free(evb5);s1b_free(&s5);
    // 8. D-queue codec probe: holds roundtrip through the serializer
    let s6:S1b=s1b_init();
    let did:[]u8=s6.d_id; let dsc:[]u8=s6.d_score;
    let dtr:[]u8=s6.d_tier; let drp:[]u8=s6.d_rep;
    s1b_i32_set(did,0,41);s1b_u64_set(dsc,0,7);dtr[0]=2;s1b_u64_set(drp,0,0);
    s1b_i32_set(did,1,42);s1b_u64_set(dsc,1,-3);dtr[1]=1;s1b_u64_set(drp,1,9);
    s6.d_n=2;
    let se6:[]u8=nio_alloc(se_len); let se7:[]u8=nio_alloc(se_len);
    s1b_serialize(&s6,S1B_SCHEMA_V1,se6);
    let s7:S1b=s1b_init();
    let dcok:i32=0;
    if(s1b_deserialize(&s7,se6)==0){
        s1b_serialize(&s7,S1B_SCHEMA_V1,se7);
        if(s1b_bytes_eq(se6,se7)==1){dcok=1;}
    }
    bad=bad+cl_check("d_codec_roundtrip",dcok,1);
    nio_free(se6);nio_free(se7);nio_free(x);
    s1b_free(&s4);s1b_free(&s6);s1b_free(&s7);
    // 9. taxonomy inventory
    _zag_print("TAXON_INVENTORY,A,");s1b_pnum(nA as i64);
    _zag_print(",C,");s1b_pnum(nC as i64);
    _zag_println(",B,0_static,D,1_refuse_demo");
    nio_free(evn);nio_free(evb);nio_free(inb);nio_free(recb);nio_free(outb);nio_free(ohb);
    return bad;
}

// s1b_trans.zag — Step 1b intake queue + six transition rules T(S,E) as pure
// functions. Each rule returns its touch mask (KB2 verifier compares against
// the prereg §3 table). Canonical intra-episode order is enforced by the
// episode assembler in s1b_run.zag; this module only applies one event at a time.
@import("s1b_state.zag")

// ---- intake queue ----
fn s1b_ev_push(s:*S1b,typ:i32,p0:i32,p1:i32,p2:i32,p3:i32,p4:i32,p5:i32,p6:i32)i32 {
    if(s.*.ev_n>=S1B_EVCAP){return -1;}
    let e:[]u8=s.*.ev_buf; let at:i32=s.*.ev_n*S1B_EVWORDS*4;
    s1b_i32_set(e,at+0,typ);s1b_i32_set(e,at+4,p0);s1b_i32_set(e,at+8,p1);
    s1b_i32_set(e,at+12,p2);s1b_i32_set(e,at+16,p3);s1b_i32_set(e,at+20,p4);
    s1b_i32_set(e,at+24,p5);s1b_i32_set(e,at+28,p6);
    s.*.ev_n=s.*.ev_n+1; return 0;
}
fn s1b_ev_type(s:*S1b,i:i32)i32 {
    let e:[]u8=s.*.ev_buf; return s1b_i32_get(e,i*S1B_EVWORDS*4+0);
}
fn s1b_ev_p(s:*S1b,i:i32,k:i32)i32 {
    let e:[]u8=s.*.ev_buf; return s1b_i32_get(e,i*S1B_EVWORDS*4+4+k*4);
}

// ---- audit append: canonical 16-word layout ----
// op@0 slot@4 rc@8 b1..b5@12..28 a1..a5@32..48 stage@52 d1@56 d2@60
fn s1b_audit_append(s:*S1b,op:i32,slot:i32,rc:i32,
                    b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
                    a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)i32 {
    if(s.*.a_n>=s.*.a_cap){return -1;}
    let a:[]u8=s.*.a_buf; let e:i32=s.*.a_n*S1B_AWORDS*4;
    s1b_i32_set(a,e+0,op);s1b_i32_set(a,e+4,slot);s1b_i32_set(a,e+8,rc);
    s1b_i32_set(a,e+12,b1);s1b_i32_set(a,e+16,b2);s1b_i32_set(a,e+20,b3);
    s1b_i32_set(a,e+24,b4);s1b_i32_set(a,e+28,b5);
    s1b_i32_set(a,e+32,a1);s1b_i32_set(a,e+36,a2);s1b_i32_set(a,e+40,a3);
    s1b_i32_set(a,e+44,a4);s1b_i32_set(a,e+48,a5);
    s1b_i32_set(a,e+52,s.*.g_stage);
    s1b_i32_set(a,e+56,d1);s1b_i32_set(a,e+60,d2);
    s.*.a_n=s.*.a_n+1; return 0;
}

// deterministic hash-based mismatch count (no floats): sum of first 8
// SHA-256 bytes of (x || hold_id LE) mod 4.
fn s1b_contra(x:[]u8,hold_id:i32)i32 {
    let buf:[]u8=nio_alloc(x.len+4);
    if(buf.len==0){return 0;}
    let i:i32=0; while(i<x.len){buf[i]=x[i];i=i+1;}
    buf[x.len]=(hold_id&255) as u8;buf[x.len+1]=((hold_id>>8)&255) as u8;
    buf[x.len+2]=((hold_id>>16)&255) as u8;buf[x.len+3]=((hold_id>>24)&255) as u8;
    let h:[]u8=nio_alloc(32);
    let r:i32=0;
    if(h.len==32 && s1b_sha(buf,h)==0){
        let j:i32=0; let acc:i32=0;
        while(j<8){acc=acc+(h[j] as i32);j=j+1;}
        r=acc%4;
    }
    nio_free(buf);nio_free(h); return r;
}

// Rule 1: Observe(x). Touches {K,H,D,B}.
fn s1b_t_observe(s:*S1b,x:[]u8)i32 {
    s.*.k_ep=s.*.k_ep+1; s.*.k_age=s.*.k_age+1;
    // refill budgets (schedule advance)
    let brem:[]u8=s.*.b_rem; let bcap:[]u8=s.*.b_cap;
    let c:i32=0;
    while(c<S1B_CCAP){s1b_i32_set(brem,c*4,s1b_i32_get(bcap,c*4));c=c+1;}
    s.*.k_refill=s.*.k_refill+1;
    // new hypothesis, creation id = h_next (monotonic, never reused)
    let hn:i32=s.*.h_next;
    if(hn<S1B_HCAP){
        let cid:[]u8=s.*.h_cid; let hst:[]u8=s.*.h_status;
        let ev1:[]u8=s.*.h_ev1; let ev2:[]u8=s.*.h_ev2; let vep:[]u8=s.*.h_vep;
        s1b_i32_set(cid,hn*4,hn);
        hst[hn]=S1B_H_LIVE as u8;
        s1b_i32_set(ev1,hn*4,(x.len%7) as i32);
        s1b_i32_set(ev2,hn*4,((x[0] as i32)%5) as i32);
        s1b_u64_set(vep,hn*8,0);
        s.*.h_next=hn+1;
    }
    // re-score existing holds
    let did:[]u8=s.*.d_id; let dsc:[]u8=s.*.d_score; let drp:[]u8=s.*.d_rep;
    let t:i32=0;
    while(t<s.*.d_n){
        if(s1b_u64_get(drp,t*8)==0){
            let hid:i32=s1b_i32_get(did,t*4);
            let sc:i64=s1b_u64_get(dsc,t*8);
            s1b_u64_set(dsc,t*8,sc+(s1b_contra(x,hid) as i64));
        }
        t=t+1;
    }
    // load metric: pending-hypothesis count (integer signal, never a float)
    let live:i32=0; let j:i32=0;
    let hst2:[]u8=s.*.h_status;
    while(j<s.*.h_next){if(hst2[j]==S1B_H_LIVE as u8){live=live+1;}j=j+1;}
    s.*.load=live as i64;
    return S1B_T_K|S1B_T_H|S1B_T_D|S1B_T_B;
}

// Rule 2: Deliberate(step). Touches {B,K}. Returns S1B_DELIB_OK or REFUSED.
fn s1b_t_delib(s:*S1b) i32 {
    let cur:i32=s.*.ctx_cur;
    let brem:[]u8=s.*.b_rem; let bcap:[]u8=s.*.b_cap;
    let rem:i32=s1b_i32_get(brem,cur*4);
    if(rem<=0){return S1B_DELIB_REFUSED;} // hard stop, B unchanged
    let cap:i32=s1b_i32_get(bcap,cur*4);
    s1b_i32_set(brem,cur*4,rem-1);
    s.*.k_step=s.*.k_step+1;
    if(rem>cap/2){s.*.rctr=s.*.rctr+1;} // planted counter's only writer
    return S1B_DELIB_OK;
}

// Rule 3: Verdict(v): v=1 eliminate target (smallest-id live), v=0 keep.
// Touches {H,D,R}. Always records the verdict code in the shift register:
// eliminated creation id, -1 (nothing live to eliminate), or -2 (keep).
fn s1b_t_verdict(s:*S1b,v:i32)i32 {
    let code:i64=-2;
    if(v==1){
        // smallest creation-id live hypothesis (id-ascending scan)
        let hst:[]u8=s.*.h_status; let cid:[]u8=s.*.h_cid; let vep:[]u8=s.*.h_vep;
        let best:i32=-1; let bestid:i32=2147483647;
        let j:i32=0;
        while(j<s.*.h_next){
            if(hst[j]==S1B_H_LIVE as u8){
                let id:i32=s1b_i32_get(cid,j*4);
                if(id<bestid){bestid=id;best=j;}
            }
            j=j+1;
        }
        if(best>=0){
            hst[best]=S1B_H_REFUTED as u8;
            s1b_u64_set(vep,best*8,s.*.k_ep);
            // resolve holds citing this hypothesis (tombstone, never mutate)
            let ev1:[]u8=s.*.h_ev1; let ev2:[]u8=s.*.h_ev2;
            let e1:i32=s1b_i32_get(ev1,best*4); let e2:i32=s1b_i32_get(ev2,best*4);
            let did:[]u8=s.*.d_id; let drp:[]u8=s.*.d_rep;
            let t:i32=0;
            while(t<s.*.d_n){
                let hid:i32=s1b_i32_get(did,t*4);
                if(hid==e1 || hid==e2){s1b_u64_set(drp,t*8,s.*.k_ep);}
                t=t+1;
            }
            code=bestid as i64;
        } else { code=-1; }
    }
    // record verdict code in shift register
    let rv:[]u8=s.*.r_verd; let k:i32=S1B_RCAP-1;
    while(k>0){s1b_u64_set(rv,k*8,s1b_u64_get(rv,(k-1)*8));k=k-1;}
    s1b_u64_set(rv,0,code);
    return S1B_T_H|S1B_T_D|S1B_T_R;
}

// Rule 4: MemOp(op, slot). Touches {M,A}. Appends exactly one audit entry.
fn s1b_t_memop(s:*S1b,op:i32,slot:i32)i32 {
    if(slot<0 || slot>=S1B_MCAP){return S1B_T_M|S1B_T_A;}
    let mst:[]u8=s.*.m_status; let mstr:[]u8=s.*.m_strength;
    let mlp:[]u8=s.*.m_lastep; let mch:[]u8=s.*.m_ch;
    let prev:i32=mst[slot] as i32;
    let rc:i32=0;
    if(op==S1B_MO_ADD){
        if(prev==S1B_ST_EMPTY){mst[slot]=S1B_ST_LIVE as u8;mstr[slot]=1;}
        else {rc=1;}
    } else if(op==S1B_MO_KILL){
        if(slot<2){rc=2;} // CORE structurally unkillable
        else if(prev==S1B_ST_LIVE){mst[slot]=S1B_ST_KILLED as u8;}
        else {rc=1;}
    } else if(op==S1B_MO_PIN){
        if(prev==S1B_ST_LIVE){mst[slot]=S1B_ST_PINNED as u8;}
        else {rc=1;}
    } else if(op==S1B_MO_PROMOTE){
        if(prev!=S1B_ST_EMPTY && mstr[slot]<9){mstr[slot]=mstr[slot]+1;}
        else {rc=1;}
    } else if(op==S1B_MO_DEMOTE){
        if(prev!=S1B_ST_EMPTY && mstr[slot]>0){mstr[slot]=mstr[slot]-1;}
        else {rc=1;}
    } else if(op==S1B_MO_STRENGTHEN){
        if(prev!=S1B_ST_EMPTY){mstr[slot]=9;}
        else {rc=1;}
    } else if(op==S1B_MO_WEAKEN){
        if(prev!=S1B_ST_EMPTY){mstr[slot]=1;}
        else {rc=1;}
    } else {rc=3;}
    s1b_u64_set(mlp,slot*8,s.*.k_ep);
    // content hash: deterministic from (op, slot, k_ep)
    let cb:[]u8=nio_alloc(12); let hh:[]u8=nio_alloc(32);
    if(cb.len==12 && hh.len==32){
        s1b_i32_set(cb,0,op);s1b_i32_set(cb,4,slot);
        s1b_i32_set(cb,8,s.*.k_ep as i32);
        if(s1b_sha(cb,hh)==0){s1b_u64_set(mch,slot*8,s1b_u64_get(hh,0));}
    }
    nio_free(cb);nio_free(hh);
    let newst:i32=mst[slot] as i32;
    s1b_audit_append(s,op,slot,rc,prev,newst,mstr[slot] as i32,
                     s.*.k_ep as i32,slot,0,0,0,0,0,prev,newst);
    return S1B_T_M|S1B_T_A;
}

// Rule 5: SwitchContext(c). Touches {C,B}.
fn s1b_t_switch(s:*S1b,c:i32)i32 {
    if(c<0 || c>=S1B_CCAP){return S1B_T_C|S1B_T_B;}
    s.*.ctx_cur=c;
    if(s.*.ctx_depth<S1B_CCAP){
        let st:[]u8=s.*.ctx_stack;
        st[s.*.ctx_depth]=c as u8; s.*.ctx_depth=s.*.ctx_depth+1;
    }
    let bcon:[]u8=s.*.b_con;
    s1b_i32_set(bcon,c*4,0);
    return S1B_T_C|S1B_T_B;
}

// Rule 6: GateEvent(g): g cycles the gate table. Touches {G}.
fn s1b_t_gate(s:*S1b)i32 {
    let ns:i32=S1B_G_CLOSED;
    if(s.*.g_state==S1B_G_CLOSED){ns=S1B_G_PETITION;}
    else if(s.*.g_state==S1B_G_PETITION){ns=S1B_G_OPEN;}
    else {ns=S1B_G_CLOSED;}
    s.*.g_state=ns;
    let gd:[]u8=s.*.g_dec; let k:i32=3;
    while(k>0){s1b_i32_set(gd,k*4,s1b_i32_get(gd,(k-1)*4));k=k-1;}
    s1b_i32_set(gd,0,s.*.k_ep as i32);
    return S1B_T_G;
}

// KB2 allowed-mutation table (prereg §3). Returns 1 if (event,touch) is legal.
fn s1b_touch_ok(ev:i32,touch:i32)i32 {
    if(ev==S1B_EV_GATE){return (touch==(S1B_T_G)) as i32;}
    if(ev==S1B_EV_SWITCH){return (touch==(S1B_T_C|S1B_T_B)) as i32;}
    if(ev==S1B_EV_OBSERVE){return (touch==(S1B_T_K|S1B_T_H|S1B_T_D|S1B_T_B)) as i32;}
    if(ev==S1B_EV_DELIB){return (touch==(S1B_T_B|S1B_T_K)) as i32;}
    if(ev==S1B_EV_VERDICT){return (touch==(S1B_T_H|S1B_T_D|S1B_T_R)) as i32;}
    if(ev==S1B_EV_MEMOP){return (touch==(S1B_T_M|S1B_T_A)) as i32;}
    return 0;
}
// Canonical rank for the KB4 order verifier.
fn s1b_ev_rank(ev:i32)i32 { return ev; } // ranks equal type ids by construction

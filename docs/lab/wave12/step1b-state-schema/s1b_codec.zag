// s1b_codec.zag — STATE_E canonical serializer/deserializer (17 §3.2).
// Fixed-width LE, 8-byte aligned; slot/index order; no floats/timestamps.
// Schema v1 (0x01): 2432 bytes (H.cid included per AMENDMENT_2026-09-20_schema).
// Schema v2 (0x02): v1 + K.rctr u64 at offset 2432 → 2440 bytes.
@import("s1b_state.zag")

const S1B_SCHEMA_V1:i32=1;
const S1B_SCHEMA_V2:i32=2;
const S1B_SE_V1:i32=2432;
const S1B_SE_V2:i32=2440;
const S1B_CHOICE_CAP:i32=8;
const S1B_CHOICE_FALLBACK:i64=-255; // canonical-fallback marker (0xFFFFFFFFFFFFFF01)

fn s1b_bytes_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0; while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// mem_hash: SHA-256 over the canonical M block (slot order, tombstones kept).
fn s1b_mem_hash(s:*S1b,out:[]u8)i32 {
    let mch:[]u8=s.*.m_ch; let mst:[]u8=s.*.m_status;
    let mstr:[]u8=s.*.m_strength; let mlp:[]u8=s.*.m_lastep; let mci:[]u8=s.*.m_cite;
    let tmp:[]u8=nio_alloc(S1B_MCAP*40);
    if(tmp.len!=S1B_MCAP*40){return -1;}
    let i:i32=0;
    while(i<S1B_MCAP){
        let at:i32=i*40;
        s1b_u64_set(tmp,at+0,s1b_u64_get(mch,i*8));
        s1b_u64_set(tmp,at+8,mst[i] as i64);
        s1b_u64_set(tmp,at+16,mstr[i] as i64);
        s1b_u64_set(tmp,at+24,s1b_u64_get(mlp,i*8));
        s1b_u64_set(tmp,at+32,s1b_i32_get(mci,i*4) as i64);
        i=i+1;
    }
    let rc:i32=s1b_sha(tmp,out);
    nio_free(tmp); return rc;
}

// audit_head: SHA-256 over the ledger prefix bytes (A.n x 64 B).
fn s1b_audit_head(s:*S1b,out:[]u8)i32 {
    let a:[]u8=s.*.a_buf;
    let n:i32=s.*.a_n*S1B_AWORDS*4;
    let view:[]u8=a[0..n];
    return s1b_sha(view,out);
}

// constitution_ref: SHA-256 of the build-constant rule-set bytes.
// Any rule-set change alters this hash → replay fails closed (Class D).
fn s1b_constitution_ref(out:[]u8)i32 {
    let rules:[]u8="S1B-RULES-v1:gate=closed>petition>open;memop=add/kill/pin/promote/demote/strengthen/weaken;tie=smaller-id;order=gate>switch>observe>delib*>verdict>memop*;core-slots-0-1-unkillable;budget-refill-on-observe;variation-slots=2;no-rng;no-wallclock";
    return s1b_sha(rules,out);
}

// ---- serializer ----
fn s1b_serialize(s:*S1b,ver:i32,out:[]u8)i32 {
    let want:i32=S1B_SE_V1;
    if(ver==S1B_SCHEMA_V2){want=S1B_SE_V2;}
    else if(ver!=S1B_SCHEMA_V1){return -1;}
    if(out.len!=want){return -1;}
    s1b_zero(out);
    out[0]=ver as u8;
    s1b_u64_set(out,8,s.*.k_ep);
    let h32:[]u8=nio_alloc(32);
    if(h32.len!=32){return -1;}
    if(s1b_mem_hash(s,h32)!=0){nio_free(h32);return -1;}
    let i:i32=0; while(i<32){out[16+i]=h32[i];i=i+1;}
    if(s1b_audit_head(s,h32)!=0){nio_free(h32);return -1;}
    i=0; while(i<32){out[48+i]=h32[i];i=i+1;}
    if(s1b_constitution_ref(h32)!=0){nio_free(h32);return -1;}
    i=0; while(i<32){out[536+i]=h32[i];i=i+1;}
    nio_free(h32);
    // clock vector
    s1b_u64_set(out,80,5);
    s1b_u64_set(out,88,s.*.k_ep);s1b_u64_set(out,96,s.*.k_step);
    s1b_u64_set(out,104,s.*.k_age);s1b_u64_set(out,112,s.*.k_refill);
    s1b_u64_set(out,120,s.*.k_disc);
    // budgets
    let brem:[]u8=s.*.b_rem; let bcap:[]u8=s.*.b_cap; let bcon:[]u8=s.*.b_con;
    s1b_u64_set(out,128,S1B_CCAP as i64);
    let c:i32=0;
    while(c<S1B_CCAP){
        s1b_u64_set(out,136+c*24,s1b_i32_get(brem,c*4) as i64);
        s1b_u64_set(out,144+c*24,s1b_i32_get(bcap,c*4) as i64);
        s1b_u64_set(out,152+c*24,s1b_i32_get(bcon,c*4) as i64);
        c=c+1;
    }
    s1b_u64_set(out,232,s.*.load);
    // G block
    s1b_u64_set(out,240,s.*.g_state as i64);
    let gd:[]u8=s.*.g_dec; i=0;
    while(i<4){s1b_u64_set(out,248+i*8,s1b_i32_get(gd,i*4) as i64);i=i+1;}
    let gt:[]u8=s.*.g_thr; i=0;
    while(i<2){s1b_u64_set(out,280+i*8,s1b_i32_get(gt,i*4) as i64);i=i+1;}
    s1b_u64_set(out,296,s.*.g_stage as i64);
    s1b_u64_set(out,304,s.*.g_scaf as i64);
    let gs:[]u8=s.*.g_std; i=0;
    while(i<2){s1b_u64_set(out,312+i*8,gs[i] as i64);i=i+1;}
    let gp:[]u8=s.*.g_pin; i=0;
    while(i<4){s1b_u64_set(out,328+i*8,gp[i] as i64);i=i+1;}
    let gpr:[]u8=s.*.g_prop; i=0;
    while(i<2){s1b_u64_set(out,360+i*8,s1b_i32_get(gpr,i*4) as i64);i=i+1;}
    s1b_u64_set(out,376,s.*.g_postver as i64);
    s1b_u64_set(out,384,s.*.g_bar as i64);
    s1b_u64_set(out,392,s.*.g_varused as i64);
    // variation choices
    let nch:i32=s.*.g_varused;
    if(nch>S1B_CHOICE_CAP){nch=S1B_CHOICE_CAP;}
    s1b_u64_set(out,400,nch as i64);
    let chi:[]u8=s.*.ch_id; let chv:[]u8=s.*.ch_val; i=0;
    while(i<nch){
        s1b_u64_set(out,408+i*16,s1b_u64_get(chi,i*8));
        s1b_u64_set(out,416+i*16,s1b_u64_get(chv,i*8));
        i=i+1;
    }
    // M block
    let mch:[]u8=s.*.m_ch; let mst:[]u8=s.*.m_status;
    let mstr:[]u8=s.*.m_strength; let mlp:[]u8=s.*.m_lastep; let mci:[]u8=s.*.m_cite;
    s1b_u64_set(out,568,S1B_MCAP as i64); i=0;
    while(i<S1B_MCAP){
        let at:i32=576+i*40;
        s1b_u64_set(out,at+0,s1b_u64_get(mch,i*8));
        s1b_u64_set(out,at+8,mst[i] as i64);
        s1b_u64_set(out,at+16,mstr[i] as i64);
        s1b_u64_set(out,at+24,s1b_u64_get(mlp,i*8));
        s1b_u64_set(out,at+32,s1b_i32_get(mci,i*4) as i64);
        i=i+1;
    }
    // H block
    let hcid:[]u8=s.*.h_cid; let hst:[]u8=s.*.h_status;
    let he1:[]u8=s.*.h_ev1; let he2:[]u8=s.*.h_ev2; let hvp:[]u8=s.*.h_vep;
    s1b_u64_set(out,1216,S1B_HCAP as i64); i=0;
    while(i<S1B_HCAP){
        let at:i32=1224+i*40;
        s1b_u64_set(out,at+0,s1b_i32_get(hcid,i*4) as i64);
        s1b_u64_set(out,at+8,hst[i] as i64);
        s1b_u64_set(out,at+16,s1b_i32_get(he1,i*4) as i64);
        s1b_u64_set(out,at+24,s1b_i32_get(he2,i*4) as i64);
        s1b_u64_set(out,at+32,s1b_u64_get(hvp,i*8));
        i=i+1;
    }
    // C block
    s1b_u64_set(out,1864,s.*.ctx_cur as i64);
    s1b_u64_set(out,1872,s.*.ctx_depth as i64);
    let cst:[]u8=s.*.ctx_stack; i=0;
    while(i<4){s1b_u64_set(out,1880+i*8,cst[i] as i64);i=i+1;}
    // D block
    let did:[]u8=s.*.d_id; let dsc:[]u8=s.*.d_score;
    let dtr:[]u8=s.*.d_tier; let drp:[]u8=s.*.d_rep;
    s1b_u64_set(out,1912,S1B_DCAP as i64); i=0;
    while(i<S1B_DCAP){
        let at:i32=1920+i*32;
        s1b_u64_set(out,at+0,s1b_i32_get(did,i*4) as i64);
        s1b_u64_set(out,at+8,s1b_u64_get(dsc,i*8));
        s1b_u64_set(out,at+16,dtr[i] as i64);
        s1b_u64_set(out,at+24,s1b_u64_get(drp,i*8));
        i=i+1;
    }
    // R block
    let rre:[]u8=s.*.r_ref_ep; let rrt:[]u8=s.*.r_ref_ty; let rvd:[]u8=s.*.r_verd;
    i=0;
    while(i<S1B_RCAP){
        s1b_u64_set(out,2176+i*16,s1b_u64_get(rre,i*8));
        s1b_u64_set(out,2184+i*16,rrt[i] as i64);
        s1b_u64_set(out,2304+i*8,s1b_u64_get(rvd,i*8));
        i=i+1;
    }
    s1b_u64_set(out,2368,s.*.r_spoof);
    s1b_u64_set(out,2376,s.*.r_corr);
    let rti:[]u8=s.*.r_tier; i=0;
    while(i<4){s1b_u64_set(out,2384+i*8,rti[i] as i64);i=i+1;}
    // A tail
    s1b_u64_set(out,2416,s.*.a_n as i64);
    s1b_u64_set(out,2424,S1B_AWORDS as i64);
    if(ver==S1B_SCHEMA_V2){s1b_u64_set(out,2432,s.*.rctr);}
    return 0;
}

// ---- deserializer: rejects unknown schema versions ----
fn s1b_deserialize(s:*S1b,rec:[]u8)i32 {
    let ver:i32=rec[0] as i32;
    if(ver!=S1B_SCHEMA_V1 && ver!=S1B_SCHEMA_V2){return -1;}
    let want:i32=S1B_SE_V1;
    if(ver==S1B_SCHEMA_V2){want=S1B_SE_V2;}
    if(rec.len!=want){return -1;}
    s.*.k_ep=s1b_u64_get(rec,8);
    s.*.k_step=s1b_u64_get(rec,96);s.*.k_age=s1b_u64_get(rec,104);
    s.*.k_refill=s1b_u64_get(rec,112);s.*.k_disc=s1b_u64_get(rec,120);
    let brem:[]u8=s.*.b_rem; let bcap:[]u8=s.*.b_cap; let bcon:[]u8=s.*.b_con;
    let c:i32=0;
    while(c<S1B_CCAP){
        s1b_i32_set(brem,c*4,s1b_u64_get(rec,136+c*24) as i32);
        s1b_i32_set(bcap,c*4,s1b_u64_get(rec,144+c*24) as i32);
        s1b_i32_set(bcon,c*4,s1b_u64_get(rec,152+c*24) as i32);
        c=c+1;
    }
    s.*.load=s1b_u64_get(rec,232);
    s.*.g_state=s1b_u64_get(rec,240) as i32;
    let gd:[]u8=s.*.g_dec; let i:i32=0;
    while(i<4){s1b_i32_set(gd,i*4,s1b_u64_get(rec,248+i*8) as i32);i=i+1;}
    let gt:[]u8=s.*.g_thr; i=0;
    while(i<2){s1b_i32_set(gt,i*4,s1b_u64_get(rec,280+i*8) as i32);i=i+1;}
    s.*.g_stage=s1b_u64_get(rec,296) as i32;
    s.*.g_scaf=s1b_u64_get(rec,304) as i32;
    let gs:[]u8=s.*.g_std; i=0;
    while(i<2){gs[i]=s1b_u64_get(rec,312+i*8) as u8;i=i+1;}
    let gpn:[]u8=s.*.g_pin; i=0;
    while(i<4){gpn[i]=s1b_u64_get(rec,328+i*8) as u8;i=i+1;}
    let gpr:[]u8=s.*.g_prop; i=0;
    while(i<2){s1b_i32_set(gpr,i*4,s1b_u64_get(rec,360+i*8) as i32);i=i+1;}
    s.*.g_postver=s1b_u64_get(rec,376) as i32;
    s.*.g_bar=s1b_u64_get(rec,384) as i32;
    s.*.g_varused=s1b_u64_get(rec,392) as i32;
    let nch:i32=s1b_u64_get(rec,400) as i32;
    if(nch<0 || nch>S1B_CHOICE_CAP){return -1;}
    let chi:[]u8=s.*.ch_id; let chv:[]u8=s.*.ch_val; i=0;
    while(i<nch){
        s1b_u64_set(chi,i*8,s1b_u64_get(rec,408+i*16));
        s1b_u64_set(chv,i*8,s1b_u64_get(rec,416+i*16));
        i=i+1;
    }
    let mch:[]u8=s.*.m_ch; let mst:[]u8=s.*.m_status;
    let mstr:[]u8=s.*.m_strength; let mlp:[]u8=s.*.m_lastep; let mci:[]u8=s.*.m_cite;
    i=0;
    while(i<S1B_MCAP){
        let at:i32=576+i*40;
        s1b_u64_set(mch,i*8,s1b_u64_get(rec,at+0));
        mst[i]=s1b_u64_get(rec,at+8) as u8;
        mstr[i]=s1b_u64_get(rec,at+16) as u8;
        s1b_u64_set(mlp,i*8,s1b_u64_get(rec,at+24));
        s1b_i32_set(mci,i*4,s1b_u64_get(rec,at+32) as i32);
        i=i+1;
    }
    let hcid:[]u8=s.*.h_cid; let hst:[]u8=s.*.h_status;
    let he1:[]u8=s.*.h_ev1; let he2:[]u8=s.*.h_ev2; let hvp:[]u8=s.*.h_vep;
    i=0;
    while(i<S1B_HCAP){
        let at:i32=1224+i*40;
        s1b_i32_set(hcid,i*4,s1b_u64_get(rec,at+0) as i32);
        hst[i]=s1b_u64_get(rec,at+8) as u8;
        s1b_i32_set(he1,i*4,s1b_u64_get(rec,at+16) as i32);
        s1b_i32_set(he2,i*4,s1b_u64_get(rec,at+24) as i32);
        s1b_u64_set(hvp,i*8,s1b_u64_get(rec,at+32));
        i=i+1;
    }
    s.*.ctx_cur=s1b_u64_get(rec,1864) as i32;
    s.*.ctx_depth=s1b_u64_get(rec,1872) as i32;
    let cst:[]u8=s.*.ctx_stack; i=0;
    while(i<4){cst[i]=s1b_u64_get(rec,1880+i*8) as u8;i=i+1;}
    let did:[]u8=s.*.d_id; let dsc:[]u8=s.*.d_score;
    let dtr:[]u8=s.*.d_tier; let drp:[]u8=s.*.d_rep;
    i=0;
    while(i<S1B_DCAP){
        let at:i32=1920+i*32;
        s1b_i32_set(did,i*4,s1b_u64_get(rec,at+0) as i32);
        s1b_u64_set(dsc,i*8,s1b_u64_get(rec,at+8));
        dtr[i]=s1b_u64_get(rec,at+16) as u8;
        s1b_u64_set(drp,i*8,s1b_u64_get(rec,at+24));
        i=i+1;
    }
    let rre:[]u8=s.*.r_ref_ep; let rrt:[]u8=s.*.r_ref_ty; let rvd:[]u8=s.*.r_verd;
    i=0;
    while(i<S1B_RCAP){
        s1b_u64_set(rre,i*8,s1b_u64_get(rec,2176+i*16));
        rrt[i]=s1b_u64_get(rec,2184+i*16) as u8;
        s1b_u64_set(rvd,i*8,s1b_u64_get(rec,2304+i*8));
        i=i+1;
    }
    s.*.r_spoof=s1b_u64_get(rec,2368);
    s.*.r_corr=s1b_u64_get(rec,2376);
    let rti:[]u8=s.*.r_tier; i=0;
    while(i<4){rti[i]=s1b_u64_get(rec,2384+i*8) as u8;i=i+1;}
    s.*.a_n=s1b_u64_get(rec,2416) as i32;
    if(ver==S1B_SCHEMA_V2){s.*.rctr=s1b_u64_get(rec,2432);}
    // h_next / d_n / r_n are recoverable bounds: recompute from contents
    let hn:i32=0; i=0;
    while(i<S1B_HCAP){if(hst[i]!=S1B_H_EMPTY as u8){hn=i+1;}i=i+1;}
    s.*.h_next=hn;
    return 0;
}

// constitution check: recompute constitution_ref, compare to record bytes.
// Returns 1 if the record's rule set matches this build, else 0 (→ REFUSE).
fn s1b_constitution_ok(rec:[]u8)i32 {
    let h:[]u8=nio_alloc(32);
    if(h.len!=32){return 0;}
    let ok:i32=0;
    if(s1b_constitution_ref(h)==0){
        let i:i32=0; ok=1;
        while(i<32){if(rec[536+i]!=h[i]){ok=0;}i=i+1;}
    }
    nio_free(h); return ok;
}

// ---- defective serializer variants (conformance taxonomy demos only) ----
// Variant A (Class A demo): correct record, then the budget block is zeroed —
// simulates an incomplete schema that omits budget_counters.
fn s1b_serialize_A(s:*S1b,out:[]u8)i32 {
    let rc:i32=s1b_serialize(s,S1B_SCHEMA_V1,out);
    if(rc!=0){return rc;}
    let i:i32=136;
    while(i<232){out[i]=0;i=i+1;}
    return 0;
}
// Variant C (Class C demo): mem_hash is computed, THEN the state is mutated,
// then the record is written from the mutated state with the stale hash —
// simulates "record written after mutation" (17 §5 Class C).
fn s1b_serialize_C(s:*S1b,out:[]u8)i32 {
    let h:[]u8=nio_alloc(32);
    if(h.len!=32){return -1;}
    if(s1b_mem_hash(s,h)!=0){nio_free(h);return -1;}
    let mstr:[]u8=s.*.m_strength;
    mstr[0]=mstr[0]+1; // the mutation the logger failed to account for
    let rc:i32=s1b_serialize(s,S1B_SCHEMA_V1,out);
    if(rc==0){
        let i:i32=0;
        while(i<32){out[16+i]=h[i];i=i+1;} // stale hash pasted over
    }
    nio_free(h);
    return rc;
}

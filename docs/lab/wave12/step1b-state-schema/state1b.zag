// state1b.zag — Step 1b driver: state schema + replay protocol + evolution law.
// One binary; argv[1] selects the mode (playbook: one binary, argv selects config).
//   replay [v1|v2]  — 100 episodes x 10 replays (17 §3.3; KB1/KB5)
//   perm            — 3 input-arrival orders x 100 episodes x 2 replays (18 §6)
//   difftest        — 5 x 460 differential-replay pairs, planted rctr (16)
//   diffneg         — 460-pair negative control (no perturbation)
//   diffk2          — v2 schema K2 closure + retroactive re-validation
//   conform         — 20-episode run + Class A/C/D taxonomy + KB2/3/4 probes
// Pure Zag. Zero RNG. Exit code = number of failed checks.
@import("s1b_run.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"replay")==1){
        let ver:i32=S1B_SCHEMA_V1;
        let a2:[]u8=_zag_arg(2);
        if(_zag_strcmp(a2,"v2")==1){ver=S1B_SCHEMA_V2;}
        _zag_print("S1B_MODE,replay,ver,");s1b_pnum(ver as i64);_zag_println("");
        return s1b_mode_replay(ver,100,10,0);
    }
    if(_zag_strcmp(m,"perm")==1){
        _zag_println("S1B_MODE,perm");
        return s1b_mode_perm();
    }
    if(_zag_strcmp(m,"difftest")==1){
        _zag_println("S1B_MODE,difftest");
        return s1b_mode_difftest();
    }
    if(_zag_strcmp(m,"diffneg")==1){
        _zag_println("S1B_MODE,diffneg");
        return s1b_mode_diffneg();
    }
    if(_zag_strcmp(m,"diffk2")==1){
        _zag_println("S1B_MODE,diffk2");
        return s1b_mode_diffk2();
    }
    if(_zag_strcmp(m,"conform")==1){
        _zag_println("S1B_MODE,conform");
        return s1b_mode_conform();
    }
    _zag_println("USAGE: state1b_bin replay [v1|v2] | perm | difftest | diffneg | diffk2 | conform");
    return 1;
}

// r5_treatments.zag — Ruling 5, E2/E3: scripted churn mechanism harness.
// Pure Zag, deterministic. argv[1] = frozen|p3|forced, argv[2] = 0|1 (cites).
// E2: cites=1 with configs frozen/p3. E3: cites=0 with frozen/p3/forced.
//
// Design mirrors the wave-8 learner's own P3 machinery:
//  - victim policy: lowest strength first, ties -> lowest slot
//    (learner lr_pick_victim analog; score=strength here).
//  - P3 Rule 2 (protection budget): >=1 of 2 victims from the strongest-held
//    half (mirror of lr_pick_strongest_half: ceil(N/2) by strength, oldest
//    last-citation, ties -> lowest slot).
//  - P3 maintenance: re-cite slots lapsing within 25 episodes when a genuine
//    not-yet-cited episode exists (mirror of lr_p3_maintenance); otherwise
//    protection honestly lapses.
//  - P3 expiry: st_protection_expired issuance for newly-expired slots
//    (mirror of lr_p3_issue_expiries); expired victims die at BASELINE cost.
//  - graded kill: pay effort (need cites + JUSTIFY) or st_abandon.
//  - FORCED: strength-blind st_kill on the same lowest-strength victims.
//
// BASELINE kill ordering note: the committed checker verifies a BASELINE
// kill only when PEXPIRED is the last p3-relevant event before the kill
// (gate-test precedent: EVIDENCE -> PEXPIRED -> JUSTIFY -> KILL). A fresh
// contradiction cite would clear the checker's expiry flag AND un-expire
// the slot in the core. So the BASELINE kill cites the slot's own (stale)
// memory episode — that staleness is exactly why its protection expired.
// Full-effort kills use fresh deterministic cite episodes per the prereg.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

const R5_SLOTS:i32=32;

struct R5H {
    mid:[]u8,
    cited_rev:[]u8,
    cited_cor:[]u8,
    pexp:[]u8,
    important:[]u8,
    cites_issued:i32,
    kills_full:i32,
    kills_base:i32,
    kills_forced:i32,
    abandons:i32,
    pexp_n:i32,
    demands_done:i32,
}

fn r5_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn r5_tag(t:[]u8)void {
    _zag_print(t);
}
fn r5_g(a:[]u8,o:i32)i32 {
    return (a[o] as i32)|((a[o+1] as i32)<<8)|((a[o+2] as i32)<<16)|((a[o+3] as i32)<<24);
}
fn r5_s(a:[]u8,o:i32,v:i32)void {
    a[o]=(v&255) as u8;a[o+1]=((v>>8)&255) as u8;
    a[o+2]=((v>>16)&255) as u8;a[o+3]=((v>>24)&255) as u8;
}
fn r5_elig(sp:*StStore,sl:i32)i32 {
    if(sl<2 || sl>=R5_SLOTS){return 0;}
    if(sp.*.live[sl]==0){return 0;}
    if(sp.*.region[sl]!=ST_REGION_USER as u8){return 0;}
    if(sp.*.forcepin[sl]==1){return 0;}
    if(sp.*.pinned[sl]==1){return 0;}
    return 1;
}
fn r5_fill(h:*R5H,sp:*StStore,cfg:i32)void {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    st_set_episode(sp,0);
    if(cfg==1){st_set_p3(sp,1,50);}
    let i:i32=0;
    while(i<30){
        let sl:i32=-1;
        let base:i32=10;
        if(i%3==1){base=40;}
        if(i%3==2){base=75;}
        st_add(sp,1000+i,ST_REGION_USER,base,0,&sl);
        r5_s(h.*.mid,sl*4,i);
        if(i%10==9){
            st_trainer_declare(sp,ST_ROLE_TRAINER,7,sl,80,0);
            h.*.important[sl]=1;
        } else if(base>=75){
            h.*.important[sl]=1;
        }
        i=i+1;
    }
}
fn r5_pick_weakest(sp:*StStore,excl:i32)i32 {
    let best:i32=-1;let bests:i32=101;
    let sl:i32=2;
    while(sl<R5_SLOTS){
        if(sl!=excl && r5_elig(sp,sl)==1){
            let st:i32=(sp.*.strength[sl] as i32);
            if(st<bests){bests=st;best=sl;}
        }
        sl=sl+1;
    }
    return best;
}
// Mirror of lr_pick_strongest_half.
fn r5_pick_strongest_half(sp:*StStore)i32 {
    let buckets:[]u8=nio_alloc(101*4);
    let z:i32=0;
    while(z<101){r5_s(buckets,z*4,0);z=z+1;}
    let n:i32=0;let i:i32=2;
    while(i<R5_SLOTS){
        if(r5_elig(sp,i)==1){
            let st:i32=(sp.*.strength[i] as i32);
            r5_s(buckets,st*4,r5_g(buckets,st*4)+1);
            n=n+1;
        }
        i=i+1;
    }
    if(n==0){nio_free(buckets);return -1;}
    let want:i32=(n+1)/2;
    let t:i32=100;let acc:i32=0;
    while(t>=0){
        acc=acc+r5_g(buckets,t*4);
        if(acc>=want){break;}
        t=t-1;
    }
    nio_free(buckets);
    let above:i32=0;let j:i32=2;
    while(j<R5_SLOTS){
        if(r5_elig(sp,j)==1 && (sp.*.strength[j] as i32)>t){above=above+1;}
        j=j+1;
    }
    let need_eq:i32=want-above;
    let best:i32=-1;let best_key:i32=2147483647;
    let k:i32=2;
    while(k<R5_SLOTS){
        if(r5_elig(sp,k)==1){
            let st:i32=(sp.*.strength[k] as i32);
            let in_half:i32=0;
            if(st>t){in_half=1;}
            else if(st==t && need_eq>0){in_half=1;need_eq=need_eq-1;}
            if(in_half==1){
                let lc:i32=st_last_cite(sp,k);
                let key:i32=lc;
                if(lc<0){key=st_step_ep(sp,k);}
                if(key<best_key){best_key=key;best=k;}
            }
        }
        k=k+1;
    }
    return best;
}
// Mirror of lr_p3_maintenance. cites=0: no citation source, lapse honestly.
fn r5_maintenance(h:*R5H,sp:*StStore,d:i32,cites:i32)void {
    if(cites==0){return;}
    let sl:i32=2;
    while(sl<R5_SLOTS){
        if(r5_elig(sp,sl)==1 && (sp.*.strength[sl] as i32)>0){
            let lc:i32=st_last_cite(sp,sl);
            if(d-lc>25){
                let mid:i32=r5_g(h.*.mid,sl*4);
                let cite:i32=-1;
                if(h.*.cited_rev[sl]==0){
                    let rev:i32=mid+25;
                    if(rev<d && rev>lc){cite=rev;}
                }
                if(cite<0 && h.*.cited_cor[sl]==0){
                    let cor:i32=mid+50;
                    if(cor<d && cor>lc){cite=cor;}
                }
                if(cite>=0){
                    let str:i32=(sp.*.strength[sl] as i32);
                    let rc:i32=st_strengthen_cited(sp,sl,str,ST_J_CORROBORATED,cite);
                    if(rc==ST_OK){
                        if(cite==mid+25){h.*.cited_rev[sl]=1;}
                        else {h.*.cited_cor[sl]=1;}
                    }
                }
            }
        }
        sl=sl+1;
    }
}
// Mirror of lr_p3_issue_expiries; victims get theirs in the kill path.
fn r5_issue_expiries(h:*R5H,sp:*StStore,d:i32,ex1:i32,ex2:i32)void {
    let sl:i32=2;
    while(sl<R5_SLOTS){
        if(sl!=ex1 && sl!=ex2 && r5_elig(sp,sl)==1 && (sp.*.strength[sl] as i32)>0 &&
           h.*.pexp[sl]==0 && st_p3_expired(sp,sl)==1){
            let rc:i32=st_protection_expired(sp,sl,d);
            if(rc==ST_OK){h.*.pexp[sl]=1;h.*.pexp_n=h.*.pexp_n+1;}
        }
        sl=sl+1;
    }
}
// Graded kill: pay effort or abandon. Returns 1 if freed, 0 if abandoned.
fn r5_kill_graded(h:*R5H,sp:*StStore,sl:i32,d:i32,cites:i32,p3:i32)i32 {
    let str:i32=(sp.*.strength[sl] as i32);
    let expired:i32=0;
    if(p3==1 && st_p3_expired(sp,sl)==1){expired=1;}
    let need:i32=st_n(str);
    if(expired==1){need=1;}
    if(cites==0){
        st_abandon(sp,sl,1);
        h.*.abandons=h.*.abandons+1;
        return 0;
    }
    let k:i32=0;
    while(k<need){
        let ce:i32=d*100000+sl*100+k;
        if(expired==1){ce=r5_g(h.*.mid,sl*4);}
        let erc:i32=st_evidence(sp,sl,ST_J_CONTRADICTED,ce);
        if(erc==ST_OK){h.*.cites_issued=h.*.cites_issued+1;}
        k=k+1;
    }
    if(expired==1){
        // (Re-)issue AFTER the evidence: the checker verifies a BASELINE
        // kill only when PEXPIRED is the last p3-relevant event pre-kill
        // (gate-test precedent). The stale cite above keeps the slot
        // expired, so this always succeeds here.
        let rcx:i32=st_protection_expired(sp,sl,d);
        if(rcx==ST_OK && h.*.pexp[sl]==0){h.*.pexp[sl]=1;h.*.pexp_n=h.*.pexp_n+1;}
    }
    st_justify(sp,sl,ST_J_PRESSURE_VICTIM);
    let rc:i32=st_kill_evidenced(sp,sl);
    if(rc==ST_OK){
        if(expired==1){h.*.kills_base=h.*.kills_base+1;}
        else {h.*.kills_full=h.*.kills_full+1;}
        return 1;
    }
    st_abandon(sp,sl,1);
    h.*.abandons=h.*.abandons+1;
    return 0;
}
fn r5_demand(h:*R5H,sp:*StStore,d:i32,cfg:i32,cites:i32)void {
    st_set_episode(sp,d);
    let p3:i32=0;
    if(cfg==1){p3=1;}
    if(p3==1){r5_maintenance(h,sp,d,cites);}
    let v1:i32=-1;let v2:i32=-1;
    if(cfg==1){
        v1=r5_pick_strongest_half(sp);
        v2=r5_pick_weakest(sp,v1);
        if(v1<0){v1=r5_pick_weakest(sp,-1);v2=r5_pick_weakest(sp,v1);}
    } else {
        v1=r5_pick_weakest(sp,-1);
        v2=r5_pick_weakest(sp,v1);
    }
    if(p3==1){r5_issue_expiries(h,sp,d,v1,v2);}
    let f1:i32=0;let f2:i32=0;
    if(v1>=0){
        if(cfg==2){
            if(st_kill(sp,v1)==ST_OK){f1=1;h.*.kills_forced=h.*.kills_forced+1;}
        } else {
            f1=r5_kill_graded(h,sp,v1,d,cites,p3);
        }
    }
    if(v2>=0){
        if(cfg==2){
            if(st_kill(sp,v2)==ST_OK){f2=1;h.*.kills_forced=h.*.kills_forced+1;}
        } else {
            f2=r5_kill_graded(h,sp,v2,d,cites,p3);
        }
    }
    if(f1==1 && f2==1){h.*.demands_done=h.*.demands_done+1;}
}
fn main()i32 {
    if(_zag_argc()<3){return 64;}
    let a0:[]u8=_zag_arg(1);let a1:[]u8=_zag_arg(2);
    let cfg:i32=-1;
    if(_zag_strcmp(a0,"frozen")==1){cfg=0;}
    if(_zag_strcmp(a0,"p3")==1){cfg=1;}
    if(_zag_strcmp(a0,"forced")==1){cfg=2;}
    let cites:i32=-1;
    if(_zag_strcmp(a1,"0")==1){cites=0;}
    if(_zag_strcmp(a1,"1")==1){cites=1;}
    if(cfg<0 || cites<0){return 65;}
    let s:StStore=st_init(R5_SLOTS,16384);
    let sp:*StStore=&s;
    let h:R5H=R5H{
        .mid=nio_alloc(32*4),.cited_rev=nio_alloc(32),.cited_cor=nio_alloc(32),
        .pexp=nio_alloc(32),.important=nio_alloc(32),
        .cites_issued=0,.kills_full=0,.kills_base=0,.kills_forced=0,
        .abandons=0,.pexp_n=0,.demands_done=0};
    let zi:i32=0;
    while(zi<32){
        h.cited_rev[zi]=0;h.cited_cor[zi]=0;h.pexp[zi]=0;h.important[zi]=0;
        r5_s(h.mid,zi*4,-1);
        zi=zi+1;
    }
    r5_fill(&h,sp,cfg);
    let d:i32=100;
    while(d<=500){
        r5_demand(&h,sp,d,cfg,cites);
        d=d+100;
    }
    let imp_off:i32=0;let imp_ret:i32=0;
    let sl:i32=2;
    while(sl<R5_SLOTS){
        if(h.important[sl]==1){
            imp_off=imp_off+1;
            if(sp.*.live[sl]==1){imp_ret=imp_ret+1;}
        }
        sl=sl+1;
    }
    // standing checks on the scripted trail (gate_mode=1: harness-issued cites)
    let arm:i32=2;
    if(cfg==1){arm=3;}
    let f:i32=st_refusals_clean(sp);
    f=f+st_replay_check(sp);
    f=f+ck_verify(sp,arm,0,0,500,1);
    let fp:i32=st_fingerprint(sp,cfg*1000+cites);
    r5_tag("R5_CFG ");r5_pi(cfg as i64);r5_tag(" CITES ");r5_pi(cites as i64);r5_tag("\n");
    r5_tag("R5_DEMANDS ");r5_pi(h.demands_done as i64);r5_tag("/5\n");
    r5_tag("R5_KILLS full=");r5_pi(h.kills_full as i64);
    r5_tag(" base=");r5_pi(h.kills_base as i64);
    r5_tag(" forced=");r5_pi(h.kills_forced as i64);r5_tag("\n");
    r5_tag("R5_ABANDONS ");r5_pi(h.abandons as i64);r5_tag("\n");
    r5_tag("R5_CITES_ISSUED ");r5_pi(h.cites_issued as i64);r5_tag("\n");
    r5_tag("R5_PEXPIRED ");r5_pi(h.pexp_n as i64);r5_tag("\n");
    r5_tag("R5_IMPORTANT ");r5_pi(imp_ret as i64);r5_tag("/");r5_pi(imp_off as i64);r5_tag("\n");
    r5_tag("R5_AUDIT_N ");r5_pi(sp.*.audit_n as i64);r5_tag("\n");
    r5_tag("R5_FINGERPRINT ");r5_pi(fp as i64);r5_tag("\n");
    r5_tag("R5_CHECKER ");r5_pi(f as i64);r5_tag("\n");
    r5_tag("R5_DONE\n");
    nio_free(h.mid);nio_free(h.cited_rev);nio_free(h.cited_cor);
    nio_free(h.pexp);nio_free(h.important);
    st_free(sp);
    return 0;
}

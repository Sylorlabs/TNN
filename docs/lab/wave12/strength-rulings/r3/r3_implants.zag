// r3_implants.zag — Ruling 3, tests T1/T2a-c/T3: implant-scheme analysis.
// Standalone pure arithmetic; no substrate import. Deterministic.
// Schemes: 1=SHIFT {0,83,166,250,333,416}; 2=1-INDEXED (episodes 1..H,
// implants {83,166,250,333,416,500}); 3=DROP-5 {83,166,250,333,416}.
// Prints R3_T* lines; run twice, diff byte-for-byte.
@import("trial/substrate/cl/common.zag")

fn r3_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn r3_kmax(scheme:i32)i32 {
    if(scheme==3){return 4;}
    return 5;
}
// internal array index t (0-based) of the k-th implant
fn r3_implant_t(h:i32,scheme:i32,k:i32)i32 {
    if(scheme==1){return (k*h)/6;}
    if(scheme==3){return ((k+1)*h)/6;}
    return ((k+1)*h)/6-1; // scheme 2: episode numbers 83..500, t = m-1
}
// episode number in the scheme's own numbering
fn r3_epnum(h:i32,scheme:i32,k:i32)i32 {
    if(scheme==2){return r3_implant_t(h,scheme,k)+1;}
    return r3_implant_t(h,scheme,k);
}
// closed-form episode argument: scheme 2 evaluates forms at m = t+1
fn r3_m(t:i32,scheme:i32)i32 {
    if(scheme==2){return t+1;}
    return t;
}
fn r3_imp(m:i32,v:i32)i32 {
    if(((7*m+13*v+3)%10)<3){return 1;}
    return 0;
}
fn r3_wrong(m:i32,v:i32)i32 {
    if(((m+3)%10)<3){return 1;}
    return 0;
}
// V2 designation: P(m,v)=1 AND m%50 in {7,8,9}; cur 0=VUP(P=imp),1=WBS(P=wrong)
fn r3_desig(cur:i32,m:i32,v:i32)i32 {
    let p:i32=0;
    if(cur==0){p=r3_imp(m,v);}else{p=r3_wrong(m,v);}
    if(p==0){return 0;}
    let r:i32=m%50;
    if(r==7 || r==8 || r==9){return 1;}
    return 0;
}
// VUP pressure episode in the scheme's own numbering
fn r3_pressure(m:i32,scheme:i32)i32 {
    if(scheme==2){
        if(m>1 && (m%100)==0){return 1;}
        return 0;
    }
    if(m>0 && (m%100)==0){return 1;}
    return 0;
}
fn r3_tag(t:[]u8)void {
    _zag_print(t);
}

// T1: range validity for H in {500,5000}
fn r3_t1()void {
    let hi:i32=0;
    while(hi<2){
        let h:i32=500;
        if(hi==1){h=5000;}
        let s:i32=1;
        while(s<=3){
            let n:i32=0;let k:i32=0;
            while(k<=r3_kmax(s)){
                let m:i32=r3_epnum(h,s,k);
                if(s==2){
                    if(m>=1 && m<=h){n=n+1;}
                } else {
                    if(m>=0 && m<h){n=n+1;}
                }
                k=k+1;
            }
            r3_tag("R3_T1 h=");r3_pi(h as i64);
            r3_tag(" scheme=");r3_pi(s as i64);
            r3_tag(" inrange=");r3_pi(n as i64);
            r3_tag(" denom=");r3_pi((r3_kmax(s)+1) as i64);
            r3_tag("\n");
            s=s+1;
        }
        hi=hi+1;
    }
}

// T2a: implant vs pressure-episode collisions (in scheme numbering)
fn r3_t2a()void {
    let h:i32=500;
    let s:i32=1;
    while(s<=3){
        let c:i32=0;let k:i32=0;
        while(k<=r3_kmax(s)){
            if(r3_pressure(r3_epnum(h,s,k),s)==1){c=c+1;}
            k=k+1;
        }
        r3_tag("R3_T2A scheme=");r3_pi(s as i64);
        r3_tag(" pressure_collisions=");r3_pi(c as i64);
        r3_tag("\n");
        s=s+1;
    }
}

// T2b: implant vs V2-designated episode collisions, variants 0..2, cur VUP+WBS
fn r3_t2b()void {
    let h:i32=500;
    let s:i32=1;
    while(s<=3){
        let c:i32=0;let cur:i32=0;
        while(cur<=1){
            let v:i32=0;
            while(v<=2){
                let k:i32=0;
                while(k<=r3_kmax(s)){
                    if(r3_desig(cur,r3_epnum(h,s,k),v)==1){c=c+1;}
                    k=k+1;
                }
                v=v+1;
            }
            cur=cur+1;
        }
        r3_tag("R3_T2B scheme=");r3_pi(s as i64);
        r3_tag(" designation_collisions=");r3_pi(c as i64);
        r3_tag("\n");
        s=s+1;
    }
}

// T2c: implant-vs-implant revelation overlap (i's m+25/m+50 == j's episode)
fn r3_t2c()void {
    let h:i32=500;
    let s:i32=1;
    while(s<=3){
        let c:i32=0;let i:i32=0;
        while(i<=r3_kmax(s)){
            let mi:i32=r3_epnum(h,s,i);
            let j:i32=0;
            while(j<=r3_kmax(s)){
                if(i!=j){
                    let mj:i32=r3_epnum(h,s,j);
                    if(mi+25==mj || mi+50==mj){c=c+1;}
                }
                j=j+1;
            }
            i=i+1;
        }
        r3_tag("R3_T2C scheme=");r3_pi(s as i64);
        r3_tag(" revelation_overlaps=");r3_pi(c as i64);
        r3_tag("\n");
        s=s+1;
    }
}

// T3: spacing stats + entrenchment-window coverage at H=500
fn r3_t3()void {
    let h:i32=500;
    let s:i32=1;
    while(s<=3){
        let km:i32=r3_kmax(s);
        let gmin:i32=1000000;let gmax:i32=0;let gsum:i32=0;
        let k:i32=1;
        while(k<=km){
            let g:i32=r3_epnum(h,s,k)-r3_epnum(h,s,k-1);
            if(g<gmin){gmin=g;}
            if(g>gmax){gmax=g;}
            gsum=gsum+g;
            k=k+1;
        }
        // entrenchment coverage: episodes e in [0,h) with some implant m in [e-12, e]
        // (scheme 2: internal index space; window defined on episode numbers,
        //  mapped back — coverage counted in internal indices)
        let cov:i32=0;let e:i32=0;
        while(e<h){
            let hit:i32=0;let k2:i32=0;
            while(k2<=km){
                let me:i32=r3_epnum(h,s,k2);
                let ee:i32=e;
                if(s==2){ee=e+1;} // internal e -> episode number
                if(ee>=me && ee<=me+12){hit=1;break;}
                k2=k2+1;
            }
            if(hit==1){cov=cov+1;}
            e=e+1;
        }
        r3_tag("R3_T3 scheme=");r3_pi(s as i64);
        r3_tag(" gap_min=");r3_pi(gmin as i64);
        r3_tag(" gap_max=");r3_pi(gmax as i64);
        r3_tag(" gap_mean_x100=");r3_pi(((gsum*100)/km) as i64);
        r3_tag(" h_over_6=");r3_pi((h/6) as i64);
        r3_tag(" implant_rate_x1000=");r3_pi((((km+1)*1000)/h) as i64);
        r3_tag(" entrench_cov=");r3_pi(cov as i64);
        r3_tag("\n");
        s=s+1;
    }
}

fn main()i32 {
    r3_t1();
    r3_t2a();
    r3_t2b();
    r3_t2c();
    r3_t3();
    _zag_print("R3_DONE\n");
    return 0;
}

// r4_overwrite.zag — Ruling 4: overwrite semantics, scripted scenarios.
// Positions: (a)=direct write st_overwrite_direct (no effort, no clear);
// (b)=literal add path (st_kill_evidenced + st_add); (c)=fused effort-paid
// st_overwrite (standing V2). argv[1] = a|b|c. Prints R4_T* lines.
// Deterministic; run twice, diff byte-for-byte.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn r4_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn r4_tag(t:[]u8)void {
    _zag_print(t);
}
// fresh store: 32 slots, 2 CORE, stage FULL, one s=90 memory (value 1001)
fn r4_setup(sp:*StStore)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,90,0,&sl);
    return sl;
}
fn r4_cite4(sp:*StStore,slot:i32)void {
    let e:i32=11;
    while(e<=14){
        st_evidence(sp,slot,ST_J_CONTRADICTED,e);
        e=e+1;
    }
    st_justify(sp,slot,ST_J_CONTRADICTED);
}
fn r4_state(sp:*StStore,slot:i32)void {
    r4_tag(" live=");r4_pi((sp.*.live[slot]) as i64);
    r4_tag(" val=");r4_pi(st_i32_get(sp.*.value,slot*4) as i64);
    r4_tag(" str=");r4_pi((sp.*.strength[slot]) as i64);
}
// first OK entry idx for (op,slot) at/after `after`, else -1
fn r4_find_op_after(sp:*StStore,op:i32,slot:i32,after:i32)i32 {
    let i:i32=after;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==op && st_aw(sp,i,1)==slot && st_aw(sp,i,4)==ST_OK){return i;}
        i=i+1;
    }
    return -1;
}
// max clock among OK EVIDENCE/JUSTIFY for slot with idx < upto
fn r4_max_ej_clock(sp:*StStore,slot:i32,upto:i32)i32 {
    let mc:i32=-1;let i:i32=0;
    while(i<upto){
        let op:i32=st_aw(sp,i,0);
        if((op==ST_OP_EVIDENCE || op==ST_OP_JUSTIFY) && st_aw(sp,i,1)==slot &&
           st_aw(sp,i,4)==ST_OK){
            let c:i32=st_aw(sp,i,20);
            if(c>mc){mc=c;}
        }
        i=i+1;
    }
    return mc;
}
fn r4_has_justify(sp:*StStore,slot:i32,after_idx:i32,upto:i32)i32 {
    let i:i32=after_idx+1;
    while(i<upto){
        if(st_aw(sp,i,0)==ST_OP_JUSTIFY && st_aw(sp,i,1)==slot &&
           st_aw(sp,i,4)==ST_OK){return 1;}
        i=i+1;
    }
    return 0;
}
// count OK EVIDENCE entries for slot over the whole trail
fn r4_count_cites(sp:*StStore,slot:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==ST_OP_EVIDENCE && st_aw(sp,i,1)==slot &&
           st_aw(sp,i,4)==ST_OK){n=n+1;}
        i=i+1;
    }
    return n;
}
// overwrite per position; for (b) returns kill rc in *krc and add rc in *arc,
// new slot in *ns. Returns the "overwrite rc".
fn r4_do_overwrite(sp:*StStore,pos:i32,x:i32,krc:*i32,arc:*i32,ns:*i32)i32 {
    krc.*=-999;arc.*=-999;ns.*=-1;
    if(pos==0){return st_overwrite_direct(sp,x,2002,10,1);}
    if(pos==1){
        let kr:i32=st_kill_evidenced(sp,x);
        krc.*=kr;
        if(kr==ST_OK){
            let ar:i32=st_add(sp,2002,ST_REGION_USER,10,1,ns);
            arc.*=ar;
        }
        return kr;
    }
    return st_overwrite(sp,x,2002,10,1);
}
// ---- T1: cheap-edit success matrix (no effort paid) ----
fn r4_t1(pos:i32)void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=r4_setup(sp);
    let krc:i32=-999;let arc:i32=-999;let ns:i32=-1;
    let owrc:i32=r4_do_overwrite(sp,pos,x,&krc,&arc,&ns);
    r4_tag("R4_T1 pos=");r4_pi(pos as i64);
    r4_tag(" ow_rc=");r4_pi(owrc as i64);
    r4_tag(" kill_rc=");r4_pi(krc as i64);
    r4_tag(" add_rc=");r4_pi(arc as i64);
    r4_tag(" slot=");r4_pi(x as i64);
    r4_tag(" new_slot=");r4_pi(ns as i64);
    r4_state(sp,x);
    r4_tag(" audit_n=");r4_pi(sp.*.audit_n as i64);
    r4_tag("\n");
    st_free(sp);
}
// ---- T2: effort-paid overwrite + audit ordering ----
fn r4_t2(pos:i32)void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=r4_setup(sp);
    r4_cite4(sp,x);
    let krc:i32=-999;let arc:i32=-999;let ns:i32=-1;
    let owrc:i32=r4_do_overwrite(sp,pos,x,&krc,&arc,&ns);
    let ki:i32=-1;let ai:i32=-1;let owi:i32=-1;
    let order_ok:i32=0;let b4s:i32=-1;let a4s:i32=-1;
    let ejc:i32=-1;let opc:i32=-1;
    if(pos==1){
        ki=r4_find_op_after(sp,ST_OP_KILL_EVIDENCED,x,0);
        if(ns>=0){ai=r4_find_op_after(sp,ST_OP_ADD,ns,ki);}
        if(ki>=0 && ai>ki){order_ok=1;}
        if(ki>=0){b4s=(st_aw(sp,ki,8)&255);ejc=r4_max_ej_clock(sp,x,ki);opc=st_aw(sp,ki,20);}
        if(ai>=0){a4s=(st_aw(sp,ai,14)&255);}
    } else {
        owi=r4_find_op_after(sp,ST_OP_OVERWRITE,x,0);
        if(owi>=0){
            b4s=(st_aw(sp,owi,8)&255);a4s=(st_aw(sp,owi,14)&255);
            ejc=r4_max_ej_clock(sp,x,owi);opc=st_aw(sp,owi,20);
            if(ejc<opc && (pos==2)){order_ok=1;}
            if(pos==0 && ejc<0){order_ok=1;} // (a): no effort by design
        }
    }
    r4_tag("R4_T2 pos=");r4_pi(pos as i64);
    r4_tag(" ow_rc=");r4_pi(owrc as i64);
    r4_tag(" kill_idx=");r4_pi(ki as i64);
    r4_tag(" add_idx=");r4_pi(ai as i64);
    r4_tag(" ow_idx=");r4_pi(owi as i64);
    r4_tag(" order_ok=");r4_pi(order_ok as i64);
    r4_tag(" before_str=");r4_pi(b4s as i64);
    r4_tag(" after_str=");r4_pi(a4s as i64);
    r4_tag(" ej_max_clk=");r4_pi(ejc as i64);
    r4_tag(" op_clk=");r4_pi(opc as i64);
    r4_tag(" new_slot=");r4_pi(ns as i64);
    r4_tag("\n");
    st_free(sp);
}
// ---- T3: weaken-then-kill discount attack; returns total cites paid ----
fn r4_attack(pos:i32,sp:*StStore) i32 {
    let x:i32=r4_setup(sp);
    let total:i32=0;
    if(pos==0){
        // (a): no-effort weaken, then kill at n(10)=1
        let ow:i32=st_overwrite_direct(sp,x,2002,10,1);
        if(ow!=ST_OK){return -1;}
        st_evidence(sp,x,ST_J_CONTRADICTED,21);
        st_justify(sp,x,ST_J_CONTRADICTED);
        let kr:i32=st_kill_evidenced(sp,x);
        if(kr!=ST_OK){return -2;}
        total=r4_count_cites(sp,x);
    } else {
        // (b)/(c): the weaken step itself costs full effort (4 cites)
        r4_cite4(sp,x);
        let krc:i32=-999;let arc:i32=-999;let ns:i32=-1;
        let ow:i32=r4_do_overwrite(sp,pos,x,&krc,&arc,&ns);
        if(ow!=ST_OK){return -1;}
        let ks:i32=x;
        if(pos==1){ks=ns;}
        st_evidence(sp,ks,ST_J_CONTRADICTED,21);
        st_justify(sp,ks,ST_J_CONTRADICTED);
        let kr:i32=st_kill_evidenced(sp,ks);
        if(kr!=ST_OK){return -2;}
        total=r4_count_cites(sp,x);
        if(ks!=x){total=total+r4_count_cites(sp,ks);}
    }
    return total;
}
fn r4_t3(pos:i32)void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let total:i32=r4_attack(pos,sp);
    let discount:i32=0;
    if(total>=0 && total<4){discount=1;}
    r4_tag("R4_T3 pos=");r4_pi(pos as i64);
    r4_tag(" total_cites=");r4_pi(total as i64);
    r4_tag(" lawful=4 discount=");r4_pi(discount as i64);
    r4_tag("\n");
    // T3b (position a only): do pre-overwrite cites count toward the
    // post-overwrite kill? 4 cites, direct write, then kill with 0 new cites.
    if(pos==0){
        let s2:StStore=st_init(32,16384);let q:*StStore=&s2;
        let x:i32=r4_setup(q);
        r4_cite4(q,x);
        let ow:i32=st_overwrite_direct(q,x,2002,10,1);
        st_justify(q,x,ST_J_CONTRADICTED);
        let kr0:i32=st_kill_evidenced(q,x); // 0 new cites: expect REFUSED_EFFORT
        st_evidence(q,x,ST_J_CONTRADICTED,21);
        let kr1:i32=st_kill_evidenced(q,x); // 1 new cite: expect OK
        r4_tag("R4_T3B pos=0 ow_rc=");r4_pi(ow as i64);
        r4_tag(" kill_0new_rc=");r4_pi(kr0 as i64);
        r4_tag(" kill_1new_rc=");r4_pi(kr1 as i64);
        r4_tag("\n");
        st_free(q);
    }
    st_free(sp);
}
// ---- T4: checker verifiability over the attack trail ----
fn r4_t4(pos:i32)void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let total:i32=r4_attack(pos,sp);
    let cf:i32=ck_verify(sp,2,0,0,500,1);
    // purpose-built effort-before-overwrite check
    let flags:i32=0;let entries:i32=0;
    let i:i32=0;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==ST_OP_OVERWRITE && st_aw(sp,i,4)==ST_OK){
            entries=entries+1;
            let sl:i32=st_aw(sp,i,1);
            let sb:i32=(st_aw(sp,i,8)&255);
            let need:i32=st_n(sb);
            let lss:i32=st_last_strength_idx(sp,sl,i);
            let buf:[]u8=nio_alloc(16);
            let n:i32=st_collect_cites(sp,sl,lss,i,buf);
            nio_free(buf);
            let j:i32=r4_has_justify(sp,sl,lss,i);
            if(n!=need || j==0){flags=flags+1;}
        }
        i=i+1;
    }
    r4_tag("R4_T4 pos=");r4_pi(pos as i64);
    r4_tag(" attack_cites=");r4_pi(total as i64);
    r4_tag(" checker_failures=");r4_pi(cf as i64);
    r4_tag(" ow_entries=");r4_pi(entries as i64);
    r4_tag(" ow_effort_flags=");r4_pi(flags as i64);
    r4_tag("\n");
    st_free(sp);
}
fn main()i32 {
    if(_zag_argc()<2){return 64;}
    let a0:[]u8=_zag_arg(1);
    let pos:i32=-1;
    if(_zag_strcmp(a0,"a")==1){pos=0;}
    if(_zag_strcmp(a0,"b")==1){pos=1;}
    if(_zag_strcmp(a0,"c")==1){pos=2;}
    if(pos<0){return 65;}
    r4_tag("R4_POS ");r4_pi(pos as i64);r4_tag("\n");
    r4_t1(pos);
    r4_t2(pos);
    r4_t3(pos);
    r4_t4(pos);
    r4_tag("R4_DONE\n");
    return 0;
}

@import("../substrate/R33_NATIVE_IO_V1.zag")

// harness.zag (v3) — shared clean main for RNGSCAN v3 audit rounds.
// Every nio_alloc'd buffer is initialized via the STRICT CANONICAL INIT FORM
// (prereg section 7.3): let I:i32=0; immediately before
// while(I<B.len){ B[I]=<expr>; I=I+1; }.
// Kernel/callee-filled buffers are explicitly zeroed first (no implicit credit).

fn load_file(path:[]u8, buf:[]u8)i32 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dir:[]u8=nio_alloc(256);
    if(dir.len!=256){return -1;}
    let zi:i32=0;
    while(zi<dir.len){
        dir[zi]=0;
        zi=zi+1;
    }
    let k:i32=0;
    while(k<cut && k<255){
        dir[k]=path[k];
        k=k+1;
    }
    let root:i64=nio_open_root(dir[0..cut]);
    nio_free(dir);
    if(root<0){return -1;}
    let name:[]u8=path[cut+1..path.len];
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let nr:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);
    if(nr<0){return -1;}
    return nr as i32;
}

fn print_hex(out:[]u8, n:i32)void {
    let hx:[]u8=nio_alloc(n*2+1);
    if(hx.len!=n*2+1){return;}
    let zi:i32=0;
    while(zi<hx.len){
        hx[zi]=0;
        zi=zi+1;
    }
    let i:i32=0;
    while(i<n){
        let b:u8=out[i];
        let hi:u8=((b as i32)/16) as u8;
        let lo:u8=((b as i32)%16) as u8;
        if(hi<10){hx[i*2]=hi+48;} else {hx[i*2]=hi+87;}
        if(lo<10){hx[i*2+1]=lo+48;} else {hx[i*2+1]=lo+87;}
        i=i+1;
    }
    hx[n*2]=10;
    _zag_print(hx);
    nio_free(hx);
}

fn main()i32 {
    let sp:[]u8=_zag_arg(1);
    let ip:[]u8=_zag_arg(2);
    if(sp.len==0 || ip.len==0){
        _zag_println("usage: <bin> <state.bin> <input.bin>");
        return 2;
    }
    let state:[]u8=nio_alloc(1048576);
    if(state.len!=1048576){_zag_println("state NOMEM"); return 1;}
    let si:i32=0;
    while(si<state.len){
        state[si]=0;
        si=si+1;
    }
    if(load_file(sp,state)<0){_zag_println("state load failed"); return 1;}
    let input:[]u8=nio_alloc(65536);
    if(input.len!=65536){_zag_println("input NOMEM"); return 1;}
    let ii:i32=0;
    while(ii<input.len){
        input[ii]=0;
        ii=ii+1;
    }
    let inn:i32=load_file(ip,input);
    if(inn<0){_zag_println("input load failed"); return 1;}
    let out:[]u8=nio_alloc(65536);
    if(out.len!=65536){_zag_println("out NOMEM"); return 1;}
    let oi:i32=0;
    while(oi<out.len){
        out[oi]=0;
        oi=oi+1;
    }
    let stn:i32=1048576;
    let rc:i32=vary_expr(input[0..inn],state[0..stn],out);
    if(rc!=0){_zag_println("vary_expr failed"); return 1;}
    print_hex(out,64);
    nio_free(state);
    nio_free(input);
    nio_free(out);
    return 0;
}

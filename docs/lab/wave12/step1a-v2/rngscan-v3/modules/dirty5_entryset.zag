@import("harness.zag")

// DIRTY-5 (v3): plant10 shape — hand-rolled open-addressed EntrySet with
// type-prefixed fn names (no banned identifier tokens).
// Expect: checker FAIL — rule 4.4 structural (T1 type-associated + T2 prefix).

struct EntrySet {
    keys: []u8,
    vals: []u8,
    used: []u8,
}

fn entryset_insert(keys:[]u8, vals:[]u8, used:[]u8, k:u8, v:u8)void {
    let h:i32=((k as i32)*37)%64;
    keys[h]=k; vals[h]=v; used[h]=1;
}

fn entryset_iterate(keys:[]u8, vals:[]u8, used:[]u8, out:[]u8)i32 {
    let o:i32=0;
    let b:i32=0;
    while(b<64){
        if(used[b]==1 && o<out.len){out[o]=vals[b]; o=o+1;}
        b=b+1;
    }
    return o;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let keys:[]u8=nio_alloc(64);
    let vals:[]u8=nio_alloc(64);
    let used:[]u8=nio_alloc(64);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){return 1;}
    let zi:i32=0;
    while(zi<keys.len){
        keys[zi]=0;
        zi=zi+1;
    }
    let zj:i32=0;
    while(zj<vals.len){
        vals[zj]=0;
        zj=zj+1;
    }
    let zk:i32=0;
    while(zk<used.len){
        used[zk]=0;
        zk=zk+1;
    }
    let i:i32=0;
    while(i<input.len && i<state.len){
        entryset_insert(keys,vals,used,input[i],input[i]^state[i]);
        i=i+1;
    }
    let n:i32=entryset_iterate(keys,vals,used,out);
    nio_free(keys); nio_free(vals); nio_free(used);
    if(n<0){return 1;}
    return 0;
}

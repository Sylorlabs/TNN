@import("harness.zag")

// DIRTY-8 (v3): alias exfiltration — buffer partially written through its own
// name via a non-canonical loop, then read through an alias.
// Expect: checker FAIL — rule 4.3 (alias shares the UNINIT state slot).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let s:[]u8=nio_alloc(16);
    if(s.len!=16){return 1;}
    let b:[]u8=s;
    let i:i32=0;
    while(i<8){
        s[i]=input[i];
        i=i+1;
    }
    if(out.len>0 && b.len>12){out[0]=b[12];}
    nio_free(s);
    return 0;
}

@import("harness.zag")

// CLEAN-2 (v3): deterministic state-dependent variation. No RNG anywhere.
// Pinned constants (attested per prereg section 5): SBOX_POLY, MIX_ROUNDS.
// All buffers use the strict canonical init form. No maps, no pointers,
// no clock, no raw syscalls, no dynamic dispatch.

const SBOX_POLY:u8=29; // PINNED
const MIX_ROUNDS:i32=3; // PINNED

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(state.len==0){return 2;}
    if(out.len<input.len){return 1;}
    let tab:[]u8=nio_alloc(256);
    if(tab.len!=256){return 3;}
    let zi:i32=0;
    while(zi<tab.len){
        tab[zi]=0;
        zi=zi+1;
    }
    let e:i32=0;
    while(e<256){
        let x:i64=(e as i64)*2654435761;
        x=x^(x>>13);
        x=x^(x<<7);
        let sw:u8=state[(e*37)%state.len];
        tab[e]=((x&255) as u8)^sw^SBOX_POLY;
        e=e+1;
    }
    let r:i32=0;
    while(r<MIX_ROUNDS){
        let i:i32=0;
        while(i<input.len && i<out.len){
            let sw2:u8=state[(i*37+r)%state.len];
            let idx:i32=((input[i] as i32)+(sw2 as i32)+r)&255;
            let m:u8=((i*31+r)&255) as u8;
            out[i]=tab[idx]^sw2^m;
            i=i+1;
        }
        r=r+1;
    }
    nio_free(tab);
    return 0;
}

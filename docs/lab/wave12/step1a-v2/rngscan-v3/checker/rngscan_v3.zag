@import("../substrate/R33_NATIVE_IO_V1.zag")
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// rngscan_v3.zag — RNGSCAN-2026-09-20-v3
// Native-Zag no-RNG audit checker for the TNN Track 1 Arm C variation path.
// Prereg: ../PREREG_NO_RNG_AUDIT_V3.md (frozen BEFORE any checker code existed,
// commit f1859f53eb114283910feb2965d7fac3c7974dc5 on tnn-native-lab).
//
// Usage: rngscan_v3 <module.zag> <module-binary> <replay-evidence> <attestation.json>
// Exit 0 on PASS, 1 on FAIL (attestation written either way), 2 on usage/IO error.
//
// Checks (BAN-2026-09-20-v3):
//   S: source scan of module + helper imports (vendored natives are hash-pinned
//      trusted surface: verified at audit time, not scanned)
//   O: direct byte scan of the module binary (syscall opcodes, banned
//      immediates incl. extended 160B recovery, rdtsc/rdrand/rdseed, urandom)
//   R: replay evidence (8 runs, produced by runner/run_audit.sh RUNAUDIT v2)
//      is validated and embedded; the checker never spawns processes.
// Deterministic. No RNG anywhere.

// ---------------- byte helpers ----------------

fn is_idchar(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==95){return 1;}
    return 0;
}

fn find_sub(h:[]u8, n:[]u8, from:i32)i32 {
    if(n.len==0){return -1;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}

fn contains(h:[]u8, n:[]u8)i32 {
    if(find_sub(h,n,0)>=0){return 1;}
    return 0;
}

// boundary-aware identifier/substring search: token must not be glued to
// [a-z0-9] on either side (_ and string edges are allowed).
fn contains_ident(h:[]u8, n:[]u8)i32 {
    let p:i32=find_sub(h,n,0);
    while(p>=0){
        let ok:i32=1;
        if(p>0 && is_idchar(h[p-1])>0){ok=0;}
        if(p+n.len<h.len && is_idchar(h[p+n.len])>0){ok=0;}
        if(ok==1){return 1;}
        p=find_sub(h,n,p+1);
    }
    return 0;
}

fn eq_bytes(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;} i=i+1;}
    return 1;
}

fn ends_with(h:[]u8, s:[]u8)i32 {
    if(h.len<s.len){return 0;}
    let i:i32=0;
    while(i<s.len){if(h[h.len-s.len+i]!=s[i]){return 0;} i=i+1;}
    return 1;
}

fn starts_with(s:[]u8, p:[]u8)i32 {
    if(s.len<p.len){return 0;}
    let i:i32=0;
    while(i<p.len){if(s[i]!=p[i]){return 0;} i=i+1;}
    return 1;
}

fn to_lower_buf(src:[]u8, dst:[]u8)i32 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){dst[i]=c+32;} else {dst[i]=c;}
        i=i+1;
    }
    return src.len;
}

fn trim_left(s:[]u8)[]u8 {
    let i:i32=0;
    while(i<s.len && (s[i]==32 || s[i]==9)){i=i+1;}
    return s[i..s.len];
}

fn is_blank(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){let c:u8=s[i]; if(c!=32 && c!=9 && c!=13){return 0;} i=i+1;}
    return 1;
}

// remove spaces/tabs/CR into dst; returns length or -1.
fn nospace(s:[]u8, dst:[]u8)i32 {
    if(dst.len<s.len){return -1;}
    let o:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c!=32 && c!=9 && c!=13){dst[o]=c; o=o+1;}
        i=i+1;
    }
    return o;
}

fn count_byte(s:[]u8, c:u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){if(s[i]==c){n=n+1;} i=i+1;}
    return n;
}

// ---------------- append helpers ----------------

fn ab(dst:[]u8, at:i32, s:[]u8)i32 {
    if(at<0 || at+s.len>dst.len){return -1;}
    let i:i32=0;
    while(i<s.len){dst[at+i]=s[i]; i=i+1;}
    return at+s.len;
}

fn ab_byte(dst:[]u8, at:i32, c:u8)i32 {
    if(at<0 || at>=dst.len){return -1;}
    dst[at]=c;
    return at+1;
}

fn ab_i64(dst:[]u8, at:i32, v:i64)i32 {
    let neg:i32=0;
    let n:i64=v;
    if(n<0){neg=1; n=0-n;}
    let nd:i32=1;
    let t:i64=n;
    while(t>=10){t=t/10; nd=nd+1;}
    let need:i32=nd+neg;
    if(at<0 || at+need>dst.len){return -1;}
    let p:i32=at+need-1;
    if(n==0){dst[p]=48;}
    while(n>0){dst[p]=((n%10)+48) as u8; p=p-1; n=n/10;}
    if(neg==1){dst[at]=45;}
    return at+need;
}

fn ab_quoted(dst:[]u8, at:i32, s:[]u8)i32 {
    at=ab_byte(dst,at,34);
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==34 || c==92){at=ab_byte(dst,at,92);}
        at=ab_byte(dst,at,c);
        i=i+1;
    }
    at=ab_byte(dst,at,34);
    return at;
}

// ---------------- hit emission ----------------

fn emit_hit(jt:[]u8, jlp:[]i32, nhp:[]i32, rule:[]u8, file:[]u8, line:i32, text:[]u8)i32 {
    let at:i32=jlp[0];
    if(nhp[0]>0){at=ab_byte(jt,at,44);}
    at=ab_byte(jt,at,123);
    at=ab_quoted(jt,at,"rule"); at=ab_byte(jt,at,58);
    at=ab_quoted(jt,at,rule); at=ab_byte(jt,at,44);
    at=ab_quoted(jt,at,"file"); at=ab_byte(jt,at,58);
    at=ab_quoted(jt,at,file); at=ab_byte(jt,at,44);
    at=ab_quoted(jt,at,"line"); at=ab_byte(jt,at,58);
    at=ab_i64(jt,at,line as i64); at=ab_byte(jt,at,44);
    at=ab_quoted(jt,at,"text"); at=ab_byte(jt,at,58);
    at=ab_quoted(jt,at,text);
    at=ab_byte(jt,at,125);
    if(at<0){return -1;}
    jlp[0]=at;
    nhp[0]=nhp[0]+1;
    return 0;
}

// ---------------- file helpers ----------------

fn split_dir(p:[]u8, dir:[]u8, name:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let j:i32=0;
    while(j<cut){dir[j]=p[j]; j=j+1;}
    let k:i32=0;
    while(cut+1+k<p.len){name[k]=p[cut+1+k]; k=k+1;}
    return ((cut as i64)*4294967296)+(k as i64);
}

fn read_file(p:[]u8, buf:[]u8, at:i32)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -1;}
    let cr:i64=split_dir(p,dir,name);
    if(cr<0){nio_free(dir); nio_free(name); return -1;}
    let dl:i32=(cr/4294967296) as i32;
    let nl:i32=(cr%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    nio_free(dir);
    if(root<0){nio_free(name); return -1;}
    let fd:i64=nio_open_child(root,name[0..nl],0);
    nio_free(name);
    nio_close(root);
    if(fd<0){return -1;}
    let left:i32=buf.len-at;
    if(left<=0){nio_close(fd); return -1;}
    let nr:i64=nio_read_exact(fd,buf[at..buf.len],left);
    nio_close(fd);
    if(nr<0){return -1;}
    return nr;
}

fn write_file(p:[]u8, data:[]u8, n:i32)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -1;}
    let cr:i64=split_dir(p,dir,name);
    if(cr<0){nio_free(dir); nio_free(name); return -1;}
    let dl:i32=(cr/4294967296) as i32;
    let nl:i32=(cr%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    nio_free(dir);
    if(root<0){nio_free(name); return -1;}
    let fd:i64=nio_open_child(root,name[0..nl],1);
    nio_free(name);
    nio_close(root);
    if(fd<0){return -1;}
    let nw:i64=nio_write_all(fd,data[0..n]);
    nio_close(fd);
    return nw;
}

// ---------------- line processing ----------------
// strip_line: nc_out = comments blanked, literals intact (for @import);
// cb_out = comments AND literals blanked (for identifier rules).
// Returns -1 on /* opener outside a string (FAIL per prereg).
fn strip_line(raw:[]u8, nc_out:[]u8, cb_out:[]u8)i32 {
    let in_str:i32=0;
    let i:i32=0;
    while(i<raw.len){
        let c:u8=raw[i];
        if(in_str==1){
            nc_out[i]=c; cb_out[i]=32;
            if(c==92){
                if(i+1<raw.len){nc_out[i+1]=raw[i+1]; cb_out[i+1]=32; i=i+1;}
            } else {
                if(c==34){in_str=0;}
            }
        } else {
            if(c==34){in_str=1; nc_out[i]=c; cb_out[i]=32;}
            else {
                if(c==47 && i+1<raw.len && raw[i+1]==47){
                    while(i<raw.len){nc_out[i]=32; cb_out[i]=32; i=i+1;}
                } else {
                    if(c==47 && i+1<raw.len && raw[i+1]==42){return -1;}
                    nc_out[i]=c; cb_out[i]=c;
                }
            }
        }
        i=i+1;
    }
    return 0;
}

// scan_literals: banned paths inside "..." literals (rules 4.1/4.6).
fn scan_literals(raw:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8, lineno:i32)i32 {
    let i:i32=0;
    while(i<raw.len){
        if(raw[i]==34){
            let s:i32=i+1;
            let e:i32=s;
            while(e<raw.len){
                if(raw[e]==92){e=e+2;}
                else {if(raw[e]==34){break;} e=e+1;}
            }
            if(e>=raw.len){break;}
            let lit:[]u8=raw[s..e];
            let low:[]u8=nio_alloc(lit.len+1);
            if(low.len!=lit.len+1){return -1;}
            to_lower_buf(lit,low);
            let lowlit:[]u8=low[0..lit.len];
            if(contains(lowlit,"/dev/urandom")>0 || contains(lowlit,"/dev/random")>0){
                let msg:[]u8=nio_alloc(lit.len+32);
                if(msg.len==lit.len+32){
                    let ml:i32=ab(msg,0,"string literal: ");
                    ml=ab(msg,ml,lit);
                    if(emit_hit(jt,jlp,nhp,"4.1/4.6",file,lineno,msg[0..ml])<0){nio_free(low); nio_free(msg); return -1;}
                }
                nio_free(msg);
            } else {
                if(contains(lowlit,"getrandom")>0){
                    if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"string literal mentions getrandom")<0){nio_free(low); return -1;}
                }
            }
            nio_free(low);
            i=e+1;
        } else {i=i+1;}
    }
    return 0;
}

fn le32(b:[]u8, at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)*256)+((b[at+2] as i64)*65536)+((b[at+3] as i64)*16777216);
}

fn parse_i64(s:[]u8)i64 {
    let i:i32=0;
    while(i<s.len && (s[i]==32 || s[i]==9)){i=i+1;}
    let neg:i64=1;
    if(i<s.len && s[i]==45){neg=-1; i=i+1;}
    if(i>=s.len || s[i]<48 || s[i]>57){return -1;}
    let v:i64=0;
    while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+((s[i]-48) as i64); i=i+1;}
    return v*neg;
}

fn is_vendored(path:[]u8)i32 {
    if(ends_with(path,"R33_NATIVE_SHA256_V2.zag")>0){return 1;}
    if(ends_with(path,"R33_NATIVE_IO_V1.zag")>0){return 1;}
    return 0;
}

fn pool_add(pool:[]u8, pool_len:i32, s:[]u8)i32 {
    if(pool_len+s.len>pool.len){return -1;}
    let i:i32=0;
    while(i<s.len){pool[pool_len+i]=s[i]; i=i+1;}
    return pool_len;
}

fn index_lines(src:[]u8, loff:[]i32, nlines:i32, b0:i32, b1:i32, cap:i32)i32 {
    let n:i32=nlines;
    let i:i32=b0;
    loff[n]=b0; n=n+1;
    while(i<b1 && n<cap){
        if(src[i]==10){loff[n]=i+1; n=n+1;}
        i=i+1;
    }
    return n;
}

fn get_line(src:[]u8, loff:[]i32, nlines:i32, k:i32, dst:[]u8)i32 {
    if(k<0 || k>=nlines){return -1;}
    let s:i32=loff[k];
    let e:i32=loff[k+1]-1;
    if(e<s){e=s;}
    if(e-s>dst.len){return -1;}
    let i:i32=0;
    while(s+i<e){dst[i]=src[s+i]; i=i+1;}
    return e-s;
}

// brace_end: last line of the fn starting at line fs (search up to maxl).
fn brace_end(src:[]u8, loff:[]i32, nlines:i32, fs:i32, maxl:i32, nc1:[]u8, cb1:[]u8)i32 {
    let depth:i32=0;
    let seen:i32=0;
    let k:i32=fs;
    while(k<=maxl){
        let L:i32=get_line(src,loff,nlines,k,nc1);
        if(L<0){return maxl;}
        if(strip_line(nc1[0..L],nc1,cb1)==0){
            let cb:[]u8=cb1[0..L];
            let i:i32=0;
            while(i<cb.len){
                if(cb[i]==123){depth=depth+1; seen=1;}
                if(cb[i]==125){depth=depth-1;}
                i=i+1;
            }
            if(seen==1 && depth==0){return k;}
        }
        k=k+1;
    }
    return maxl;
}

// parse_import: bare @import("path") on the nc line; -1 if none.
fn parse_import(nc:[]u8, out:[]u8)i32 {
    let p:i32=find_sub(nc,"@import",0);
    if(p<0){return -1;}
    let q:i32=find_sub(nc,"\"",p);
    if(q<0){return -1;}
    let r:i32=find_sub(nc,"\"",q+1);
    if(r<0){return -1;}
    let n:i32=r-q-1;
    if(n<=0 || n>out.len){return -1;}
    let i:i32=0;
    while(i<n){out[i]=nc[q+1+i]; i=i+1;}
    return n;
}

// ---------------- banned identifier rules (BAN-2026-09-20-v3) ----------------
// code_low: lowercased code part (literals blanked).
// pinpool/pinoff/pinlen/npin: pass-0 pinned const names (lowercased); the 4.4
// tripwire is skipped on lines containing one of them.
fn check_ident_rules(code_low:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8,
                     lineno:i32, pinpool:[]u8, pinoff:[]i32, pinlen:[]i32, npin:i32)i32 {
    // 4.1 entropy
    if(contains(code_low,"getrandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'getrandom'")<0){return -1;}
    }
    if(contains(code_low,"urandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'urandom'")<0){return -1;}
    }
    if(contains(code_low,"random")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'random'")<0){return -1;}
    }
    if(contains(code_low,"rdseed")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'rdseed'")<0){return -1;}
    }
    if(contains(code_low,"rdrand")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'rdrand'")<0){return -1;}
    }
    if(contains(code_low,"/dev/random")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token '/dev/random'")<0){return -1;}
    }
    // 4.1/4.2 prescriptive: ANY _zag_raw_syscall on the variation path.
    if(contains(code_low,"_zag_raw_syscall")>0){
        if(emit_hit(jt,jlp,nhp,"4.1/4.2",file,lineno,"raw syscall on variation path (use vendored natives)")<0){return -1;}
    }
    // 4.2 wall-clock
    if(contains(code_low,"clock_gettime")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'clock_gettime'")<0){return -1;}
    }
    if(contains(code_low,"gettimeofday")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'gettimeofday'")<0){return -1;}
    }
    if(contains(code_low,"rdtsc")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'rdtsc'")<0){return -1;}
    }
    if(contains(code_low,"rdpmc")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'rdpmc'")<0){return -1;}
    }
    if(contains(code_low,"time(")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'time('")<0){return -1;}
    }
    if(contains(code_low,"date.now")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'date.now'")<0){return -1;}
    }
    if(contains(code_low,"performance.now")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'performance.now'")<0){return -1;}
    }
    if(contains(code_low,"nio_deadline")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_deadline'")<0){return -1;}
    }
    if(contains(code_low,"nio_metric")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_metric'")<0){return -1;}
    }
    if(contains(code_low,"nio_guard")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_guard'")<0){return -1;}
    }
    if(contains(code_low,"_zag_clock_")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token '_zag_clock_*'")<0){return -1;}
    }
    // 4.4 tripwire (narrowed carve-out: only const // PINNED names)
    let carve:i32=0;
    let pi:i32=0;
    while(pi<npin){
        let pn:[]u8=pinpool[pinoff[pi]..pinoff[pi]+pinlen[pi]];
        if(contains_ident(code_low,pn)>0){carve=1;}
        pi=pi+1;
    }
    if(carve==0){
        if(contains(code_low,"hashmap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'hashmap'")<0){return -1;}
        }
        if(contains(code_low,"hash_map")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'hash_map'")<0){return -1;}
        }
        if(contains(code_low,"unordered")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'unordered'")<0){return -1;}
        }
        if(contains(code_low,"dict")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'dict'")<0){return -1;}
        }
        if(contains(code_low,"bucket")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'bucket'")<0){return -1;}
        }
        if(contains(code_low,"slotmap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'slotmap'")<0){return -1;}
        }
        if(contains(code_low,"htable")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'htable'")<0){return -1;}
        }
        if(contains(code_low,"treemap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'treemap'")<0){return -1;}
        }
        if(contains(code_low,"map_iter")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'map_iter'")<0){return -1;}
        }
        if(contains(code_low,"dict_iter")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'dict_iter'")<0){return -1;}
        }
    }
    // 4.5 impure-of-inputs
    if(contains(code_low,"_zag_slice_ptr")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '_zag_slice_ptr'")<0){return -1;}
    }
    if(contains(code_low,"_zag_cstr_ptr")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '_zag_cstr_ptr'")<0){return -1;}
    }
    if(contains(code_low,"getenv")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'getenv'")<0){return -1;}
    }
    if(contains(code_low,"environ")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'environ'")<0){return -1;}
    }
    if(contains(code_low,"env_")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'env_'")<0){return -1;}
    }
    if(contains(code_low,"pthread")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'pthread'")<0){return -1;}
    }
    if(contains(code_low,"thread")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'thread'")<0){return -1;}
    }
    if(contains(code_low,"spawn")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'spawn'")<0){return -1;}
    }
    if(contains(code_low,"go func")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'go func'")<0){return -1;}
    }
    if(contains(code_low,"memcpy")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'memcpy'")<0){return -1;}
    }
    if(contains(code_low,"__asm__")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '__asm__'")<0){return -1;}
    }
    if(contains(code_low,"asm(")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'asm('")<0){return -1;}
    }
    if(contains(code_low," as i64")>0 || contains(code_low," as u64")>0){
        if(contains(code_low,"ptr")>0 || contains(code_low,"cstr")>0){
            if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"pointer cast 'as i64/u64' on ptr/cstr line")<0){return -1;}
        }
    }
    // 4.8 dynamic dispatch
    if(contains(code_low,"fn*")>0){
        if(emit_hit(jt,jlp,nhp,"4.8",file,lineno,"banned token 'fn*'")<0){return -1;}
    }
    let ep:i32=find_sub(code_low,"eval",0);
    while(ep>=0){
        let lok:i32=1;
        if(ep>0 && is_idchar(code_low[ep-1])>0){lok=0;}
        if(ep+4<code_low.len && is_idchar(code_low[ep+4])>0){lok=0;}
        if(lok==1){
            if(emit_hit(jt,jlp,nhp,"4.8",file,lineno,"banned token 'eval'")<0){return -1;}
            break;
        }
        ep=find_sub(code_low,"eval",ep+1);
    }
    return 0;
}

// ---------------- intrinsic surface audit (INTRINSIC-ALLOW-2026-09-20-v3) ----
fn is_allowed_intrinsic(id:[]u8)i32 {
    if(eq_bytes(id,"_zag_arg")>0){return 1;}
    if(eq_bytes(id,"_zag_print")>0){return 1;}
    if(eq_bytes(id,"_zag_println")>0){return 1;}
    if(eq_bytes(id,"_zag_strcmp")>0){return 1;}
    if(eq_bytes(id,"_zag_i64_to_str")>0){return 1;}
    if(eq_bytes(id,"_zag_malloc")>0){return 1;}
    if(eq_bytes(id,"_zag_free")>0){return 1;}
    return 0;
}

// code: code part (literals blanked, original case; _zag_ names are lowercase).
fn check_intrinsics(code:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8, lineno:i32)i32 {
    let p:i32=find_sub(code,"_zag_",0);
    while(p>=0){
        let s:i32=p;
        while(s>0 && is_idchar(code[s-1])>0){s=s-1;}
        let e:i32=p+5;
        while(e<code.len && is_idchar(code[e])>0){e=e+1;}
        let id:[]u8=code[s..e];
        if(contains(id,"_zag_clock_")>0){
            if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned intrinsic '_zag_clock_*'")<0){return -1;}
        } else {
            if(eq_bytes(id,"_zag_raw_syscall")>0 || eq_bytes(id,"_zag_slice_ptr")>0 || eq_bytes(id,"_zag_cstr_ptr")>0){
                // handled by check_ident_rules; skip here.
            } else {
                if(is_allowed_intrinsic(id)==0){
                    let msg:[]u8=nio_alloc(id.len+32);
                    if(msg.len==id.len+32){
                        let ml:i32=ab(msg,0,"unlisted intrinsic ");
                        ml=ab(msg,ml,id);
                        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,msg[0..ml])<0){nio_free(msg); return -1;}
                    }
                    nio_free(msg);
                }
            }
        }
        p=find_sub(code,"_zag_",e);
    }
    return 0;
}

// ---------------- rule 4.4 structural ----------------
// is_fambound: alphanumeric-only boundary for 4.4 family tokens.
// Per prereg §7.4, '_' and '$' are BOUNDARY characters (not identifier chars),
// so `entryset_insert` contains the family token `insert`.
fn is_fambound(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}

// contains_famtok: boundary-aware family-token search (lowercased inputs).
fn contains_famtok(s:[]u8, tok:[]u8)i32 {
    if(tok.len==0 || tok.len>s.len){return 0;}
    let p:i32=find_sub(s,tok,0);
    while(p>=0){
        let okb:i32=1;
        if(p>0 && is_fambound(s[p-1])>0){okb=0;}
        if(p+tok.len<s.len && is_fambound(s[p+tok.len])>0){okb=0;}
        if(okb==1){return 1;}
        p=find_sub(s,tok,p+1);
    }
    return 0;
}

// prefix_before_fam: like prefix_before but with family-token boundaries.
fn prefix_before_fam(n:[]u8, tok:[]u8, out:[]u8)i32 {
    if(tok.len==0 || tok.len>n.len){return -1;}
    let p:i32=find_sub(n,tok,0);
    while(p>=0){
        let okb:i32=1;
        if(p>0 && is_fambound(n[p-1])>0){okb=0;}
        if(p+tok.len<n.len && is_fambound(n[p+tok.len])>0){okb=0;}
        if(okb==1){
            let i:i32=0;
            while(i<p && i<out.len){out[i]=n[i]; i=i+1;}
            return p;
        }
        p=find_sub(n,tok,p+1);
    }
    return -1;
}
fn has_insert_tok(n:[]u8)i32 {
    if(contains_famtok(n,"insert")>0){return 1;}
    if(contains_famtok(n,"insertion")>0){return 1;}
    if(contains_famtok(n,"put")>0){return 1;}
    if(contains_famtok(n,"add")>0){return 1;}
    if(contains_famtok(n,"push")>0){return 1;}
    if(contains_famtok(n,"emplace")>0){return 1;}
    return 0;
}
fn has_iter_tok(n:[]u8)i32 {
    if(contains_famtok(n,"iter")>0){return 1;}
    if(contains_famtok(n,"iterate")>0){return 1;}
    if(contains_famtok(n,"iterator")>0){return 1;}
    if(contains_famtok(n,"enumerate")>0){return 1;}
    if(contains_famtok(n,"foreach")>0){return 1;}
    if(contains_famtok(n,"emit")>0){return 1;}
    if(contains_famtok(n,"dump")>0){return 1;}
    return 0;
}

// prefix before the first family token occurrence.
fn prefix_before(n:[]u8, tok:[]u8, out:[]u8)i32 {
    let p:i32=find_sub(n,tok,0);
    while(p>=0){
        let ok:i32=1;
        if(p>0 && is_idchar(n[p-1])>0){ok=0;}
        if(p+tok.len<n.len && is_idchar(n[p+tok.len])>0){ok=0;}
        if(ok==1){
            if(p>out.len){return -1;}
            let i:i32=0;
            while(i<p){out[i]=n[i]; i=i+1;}
            return p;
        }
        p=find_sub(n,tok,p+1);
    }
    return -1;
}

// insert_prefix: length of prefix before the first insert-family token, or -1.
// Uses family-token boundaries (is_fambound).
fn insert_prefix(n:[]u8, out:[]u8)i32 {
    let pl:i32=prefix_before_fam(n,"insertion",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"insert",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"put",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"add",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"push",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"emplace",out);
    return pl;
}

// iter_prefix: length of prefix before the first iter-family token, or -1.
// Uses family-token boundaries (is_fambound).
fn iter_prefix(n:[]u8, out:[]u8)i32 {
    let pl:i32=prefix_before_fam(n,"iterate",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"iterator",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"iter",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"enumerate",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"foreach",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"emit",out);
    if(pl>=0){return pl;}
    pl=prefix_before_fam(n,"dump",out);
    return pl;
}

// check_44_structural: needs fn names (lowercased, pooled) and struct names.
// fnpool/fnoff/fnlen/nfns2, stpool/stoff/stlen/nst. pfxa/pfxb: scratch.
fn check_44_structural(jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8,
                       fnpool:[]u8, fnoff:[]i32, fnlen:[]i32, nfns2:i32,
                       stpool:[]u8, stoff:[]i32, stlen:[]i32, nst:i32,
                       pfxa:[]u8, pfxb:[]u8)i32 {
    // T1: type-associated
    let si:i32=0;
    while(si<nst){
        let tn:[]u8=stpool[stoff[si]..stoff[si]+stlen[si]];
        if(tn.len>=2){
            let ins:i32=0;
            let it:i32=0;
            let gi:i32=0;
            while(gi<nfns2){
                let fnn:[]u8=fnpool[fnoff[gi]..fnoff[gi]+fnlen[gi]];
                if(contains(fnn,tn)>0){
                    if(has_insert_tok(fnn)>0){ins=1;}
                    if(has_iter_tok(fnn)>0){it=1;}
                }
                gi=gi+1;
            }
            if(ins==1 && it==1){
                let msg:[]u8=nio_alloc(tn.len+48);
                if(msg.len==tn.len+48){
                    let ml:i32=ab(msg,0,"4.4 structural: type '");
                    ml=ab(msg,ml,tn);
                    ml=ab(msg,ml,"' has insert+iterate fns");
                    if(emit_hit(jt,jlp,nhp,"4.4",file,0,msg[0..ml])<0){nio_free(msg); return -1;}
                }
                nio_free(msg);
            }
        }
        si=si+1;
    }
    // T2: prefix-associated
    let ni:i32=0;
    while(ni<nfns2){
        let fn1:[]u8=fnpool[fnoff[ni]..fnoff[ni]+fnlen[ni]];
        if(has_insert_tok(fn1)>0){
            let pl:i32=insert_prefix(fn1,pfxa);
            if(pl>=2){
                let p1:[]u8=pfxa[0..pl];
                let nj:i32=0;
                while(nj<nfns2){
                    let fn2:[]u8=fnpool[fnoff[nj]..fnoff[nj]+fnlen[nj]];
                    if(has_iter_tok(fn2)>0){
                        let ql:i32=iter_prefix(fn2,pfxb);
                        if(ql==pl && eq_bytes(p1,pfxb[0..ql])>0){
                            let msg:[]u8=nio_alloc(pl+64);
                            if(msg.len==pl+64){
                                let ml:i32=ab(msg,0,"4.4 structural: insert/iterate fn pair shares prefix '");
                                ml=ab(msg,ml,p1);
                                ml=ab(msg,ml,"'");
                                if(emit_hit(jt,jlp,nhp,"4.4",file,0,msg[0..ml])<0){nio_free(msg); return -1;}
                            }
                            nio_free(msg);
                            nj=nfns2;
                        }
                    }
                    nj=nj+1;
                }
            }
        }
        ni=ni+1;
    }
    return 0;
}

// ---------------- rule 4.3: strict canonical-init dataflow ----------------
// word_in: boundary-aware token search in nospace text.
fn word_in(s:[]u8, w:[]u8)i32 {
    let p:i32=find_sub(s,w,0);
    while(p>=0){
        let ok:i32=1;
        if(p>0 && is_idchar(s[p-1])>0){ok=0;}
        if(p+w.len<s.len && is_idchar(s[p+w.len])>0){ok=0;}
        if(ok==1){return 1;}
        p=find_sub(s,w,p+1);
    }
    return 0;
}

// body_has_ctrl: any control-flow/early-exit token in the loop body.
fn body_has_ctrl(body:[]u8)i32 {
    if(word_in(body,"if")>0){return 1;}
    if(word_in(body,"for")>0){return 1;}
    if(word_in(body,"while")>0){return 1;}
    if(word_in(body,"break")>0){return 1;}
    if(word_in(body,"continue")>0){return 1;}
    if(word_in(body,"return")>0){return 1;}
    if(word_in(body,"match")>0){return 1;}
    return 0;
}

// read_ident: read [a-z0-9_] run starting at s[pos]; returns end pos.
fn read_ident(s:[]u8, pos:i32)i32 {
    let e:i32=pos;
    while(e<s.len && is_idchar(s[e])>0){e=e+1;}
    return e;
}

// scan_43: per-function 4.3 dataflow.
// Scratch buffers passed in: ns1,ns2 (1K), bodyb (4K), expb (256), pfxb (256),
// vnpool (2K), fdepthr (->fdepth []i32), tables v_* ([]i32).
// Returns 0 ok, -1 on internal error.
fn scan_43(src:[]u8, loff:[]i32, nlines:i32, fs:i32, fe:i32, file:[]u8,
            jt:[]u8, jlp:[]i32, nhp:[]i32,
            raw1:[]u8, nc1:[]u8, cb1:[]u8, ns1:[]u8, ns2:[]u8, bodyb:[]u8,
            expb:[]u8, vnpool:[]u8, txt:[]u8,
            fdepth:[]i32, v_off:[]i32, v_len:[]i32, v_alloc:[]i32,
            v_master:[]i32, v_skip:[]i32, v_cstart:[]i32, v_cend:[]i32,
            v_hit:[]i32)i32 {
    let nfl:i32=fe-fs+1;
    if(nfl<=0 || nfl>20000){return 0;}
    // fdepth[d] = brace depth before line fs+d
    fdepth[0]=0;
    let k:i32=fs;
    while(k<=fe){
        let L:i32=get_line(src,loff,nlines,k,raw1);
        let d:i32=fdepth[k-fs];
        if(L>=0 && strip_line(raw1[0..L],nc1,cb1)==0){
            d=d+count_byte(cb1[0..L],123)-count_byte(cb1[0..L],125);
        }
        fdepth[k-fs+1]=d;
        k=k+1;
    }
    // ---- pass A: collect nio_alloc vars + simple aliases ----
    let vnlen:i32=0;
    let nv:i32=0;
    k=fs;
    while(k<=fe && nv<24){
        let L:i32=get_line(src,loff,nlines,k,raw1);
        if(L>=0 && strip_line(raw1[0..L],nc1,cb1)==0){
            let cb:[]u8=cb1[0..L];
            let t:[]u8=trim_left(cb);
            if(starts_with(t,"let ")>0){
                let nl:i32=nospace(cb,ns1);
                if(nl>0){
                    let nsw:[]u8=ns1[0..nl];
                    let np:i32=4;
                    while(np<t.len && (t[np]==32||t[np]==9)){np=np+1;}
                    let ne:i32=read_ident(t,np);
                    if(ne>np && ne-np<64){
                        let nm:[]u8=t[np..ne];
                        if(contains(nsw,"=nio_alloc(")>0){
                            let po:i32=pool_add(vnpool,vnlen,nm);
                            if(po>=0){
                                v_off[nv]=po; v_len[nv]=nm.len; vnlen=po+nm.len;
                                v_alloc[nv]=k; v_master[nv]=nv; v_skip[nv]=k;
                                v_cstart[nv]=-1; v_cend[nv]=-1; v_hit[nv]=0;
                                nv=nv+1;
                            }
                        } else {
                            // possible alias: let A[:..]=NAME...
                            let eqp:i32=find_sub(cb,"=",0);
                            if(eqp>np){
                                let rhs:[]u8=trim_left(cb[eqp+1..L]);
                                let vi:i32=0;
                                while(vi<nv){
                                    let vn:[]u8=vnpool[v_off[vi]..v_off[vi]+v_len[vi]];
                                    if(starts_with(rhs,vn)>0 && (rhs.len==vn.len || is_idchar(rhs[vn.len])==0)){
                                        let po2:i32=pool_add(vnpool,vnlen,nm);
                                        if(po2>=0){
                                            v_off[nv]=po2; v_len[nv]=nm.len; vnlen=po2+nm.len;
                                            v_alloc[nv]=k; v_master[nv]=v_master[vi]; v_skip[nv]=k;
                                            v_cstart[nv]=-1; v_cend[nv]=-1; v_hit[nv]=0;
                                            nv=nv+1;
                                        }
                                        vi=nv;
                                    }
                                    vi=vi+1;
                                }
                            }
                        }
                    }
                }
            }
        }
        k=k+1;
    }
    if(nv==0){return 0;}
    // ---- pass B: strict canonical init per master ----
    let mi:i32=0;
    while(mi<nv){
        if(v_master[mi]==mi){
            let bname:[]u8=vnpool[v_off[mi]..v_off[mi]+v_len[mi]];
            let kk:i32=v_alloc[mi]+1;
            while(kk<=fe && v_cstart[mi]<0){
                let L2:i32=get_line(src,loff,nlines,kk,raw1);
                if(L2>=0 && strip_line(raw1[0..L2],nc1,cb1)==0){
                    let nl2:i32=nospace(cb1[0..L2],ns1);
                    if(nl2>0){
                        let nsw2:[]u8=ns1[0..nl2];
                        if(starts_with(nsw2,"while(")>0){
                            // previous non-blank code line -> counter init
                            let pk:i32=kk-1;
                            let cok:i32=0;
                            let ctr:[]u8=ns2[0..0];
                            let ctrlen:i32=0;
                            while(pk>=fs && cok==0){
                                let L3:i32=get_line(src,loff,nlines,pk,raw1);
                                if(L3>=0 && strip_line(raw1[0..L3],nc1,cb1)==0){
                                    if(is_blank(cb1[0..L3])==0){
                                        let nl3:i32=nospace(cb1[0..L3],ns2);
                                        if(nl3>0){
                                            let nsp:[]u8=ns2[0..nl3];
                                            if(starts_with(nsp,"let")>0 && ends_with(nsp,":i32=0;")>0 && nsp.len>10){
                                                ctr=ns2[3..nsp.len-7]; ctrlen=nsp.len-10; cok=1;
                                            } else {
                                                if(ends_with(nsp,"=0;")>0 && nsp.len>3){
                                                    ctr=ns2[0..nsp.len-3]; ctrlen=nsp.len-3; cok=1;
                                                } else {pk=fs-1;}
                                            }
                                        } else {pk=fs-1;}
                                    }
                                }
                                if(cok==0){pk=pk-1;}
                            }
                            if(cok==1){
                                let cvi:i32=0;
                                while(cvi<ctrlen && is_idchar(ctr[cvi])>0){cvi=cvi+1;}
                                if(ctrlen>0 && cvi==ctrlen){
                                    // condition: exactly I<B.len
                                    let cp:i32=find_sub(nsw2,"){",0);
                                    let cond:[]u8=nsw2[0..0];
                                    let condlen:i32=0;
                                    if(cp>6){cond=nsw2[6..cp]; condlen=cp-6;}
                                    else {
                                        let lp:i32=nsw2.len-1;
                                        while(lp>6 && nsw2[lp]!=41){lp=lp-1;}
                                        if(lp>6){cond=nsw2[6..lp]; condlen=lp-6;}
                                    }
                                    let el:i32=ab(expb,0,ctr[0..ctrlen]);
                                    el=ab_byte(expb,el,60);
                                    el=ab(expb,el,bname);
                                    el=ab(expb,el,".len");
                                    if(el>0 && condlen==el && eq_bytes(cond,expb[0..el])>0){
                                        // body: K&R brace on the while line
                                        let qb:i32=find_sub(nsw2,"{",0);
                                        if(qb>=0){
                                            let bl:i32=0;
                                            let bi2:i32=qb+1;
                                            while(bi2<nsw2.len && bl<bodyb.len){bodyb[bl]=nsw2[bi2]; bl=bl+1; bi2=bi2+1;}
                                            let dep:i32=fdepth[kk-fs]+1+count_byte(nsw2[qb+1..nsw2.len],123)-count_byte(nsw2[qb+1..nsw2.len],125);
                                            let endk:i32=kk;
                                            let k2:i32=kk+1;
                                            while(dep>fdepth[kk-fs] && k2<=fe && bl<bodyb.len){
                                                let L4:i32=get_line(src,loff,nlines,k2,raw1);
                                                if(L4<0){k2=fe+1;}
                                                else {
                                                    if(strip_line(raw1[0..L4],nc1,cb1)==0){
                                                        let nl4:i32=nospace(cb1[0..L4],ns2);
                                                        if(nl4>0){
                                                            let nb:[]u8=ns2[0..nl4];
                                                            let q3:i32=0;
                                                            while(q3<nb.len && bl<bodyb.len){bodyb[bl]=nb[q3]; bl=bl+1; q3=q3+1;}
                                                            dep=dep+count_byte(nb,123)-count_byte(nb,125);
                                                        }
                                                    }
                                                    endk=k2; k2=k2+1;
                                                }
                                            }
                                            if(dep==fdepth[kk-fs] && bl<bodyb.len){
                                                // strip trailing '}' bytes (loop close) from body
                                                while(bl>0 && bodyb[bl-1]==125){bl=bl-1;}
                                                let body:[]u8=bodyb[0..bl];
                                                if(body_has_ctrl(body)==0){
                                                    let pl2:i32=ab(expb,0,bname);
                                                    pl2=ab_byte(expb,pl2,91);
                                                    pl2=ab(expb,pl2,ctr[0..ctrlen]);
                                                    pl2=ab(expb,pl2,"]=");
                                                    if(pl2>0 && starts_with(body,expb[0..pl2])>0){
                                                        let sm:i32=find_sub(body,";",pl2);
                                                        if(sm>pl2){
                                                            let ex:[]u8=body[pl2..sm];
                                                            let bp2:i32=ab(expb,0,bname);
                                                            bp2=ab_byte(expb,bp2,91);
                                                            if(bp2>0 && contains(ex,expb[0..bp2])==0){
                                                                // rest must be exactly I=I+1;
                                                                let rl:i32=ab(expb,0,ctr[0..ctrlen]);
                                                                rl=ab_byte(expb,rl,61);
                                                                rl=ab(expb,rl,ctr[0..ctrlen]);
                                                                rl=ab(expb,rl,"+1;");
                                                                if(rl>0 && eq_bytes(body[sm+1..body.len],expb[0..rl])>0){
                                                                    v_cstart[mi]=kk;
                                                                    v_cend[mi]=endk;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                kk=kk+1;
            }
        }
        mi=mi+1;
    }
    // ---- pass C: ordered use scan per master ----
    mi=0;
    while(mi<nv){
        if(v_master[mi]==mi){
            let cur:i32=0;
            let cs:i32=v_cstart[mi];
            let ce:i32=v_cend[mi];
            let minal:i32=v_alloc[mi];
            let vi2:i32=0;
            while(vi2<nv){
                if(v_master[vi2]==mi && v_alloc[vi2]<minal){minal=v_alloc[vi2];}
                vi2=vi2+1;
            }
            let k3:i32=fs;
            while(k3<=fe){
                let skip_ln:i32=0;
                let vi3:i32=0;
                while(vi3<nv){
                    if(v_master[vi3]==mi && v_skip[vi3]==k3){skip_ln=1;}
                    vi3=vi3+1;
                }
                if(cs>=0 && k3>=cs && k3<=ce){
                    if(k3==ce){cur=1;}
                } else {
                    if(skip_ln==0){
                        let L5:i32=get_line(src,loff,nlines,k3,raw1);
                        if(L5>=0 && strip_line(raw1[0..L5],nc1,cb1)==0){
                            let cb5:[]u8=cb1[0..L5];
                            let saw_free:i32=0;
                            let vi4:i32=0;
                            while(vi4<nv){
                                if(v_master[vi4]==mi){
                                    let vn4:[]u8=vnpool[v_off[vi4]..v_off[vi4]+v_len[vi4]];
                                    let op:i32=find_sub(cb5,vn4,0);
                                    while(op>=0){
                                        let okb:i32=1;
                                        if(op>0 && is_idchar(cb5[op-1])>0){okb=0;}
                                        if(op+vn4.len<cb5.len && is_idchar(cb5[op+vn4.len])>0){okb=0;}
                                        if(okb==1){
                                            let is_len:i32=0;
                                            if(starts_with(cb5[op+vn4.len..cb5.len],".len")>0){is_len=1;}
                                            if(is_len==0){
                                                // inside nio_free(...)?
                                                let fp:i32=find_sub(cb5,"nio_free(",0);
                                                let in_free:i32=0;
                                                while(fp>=0 && fp<op && in_free==0){
                                                    let cl:i32=find_sub(cb5,")",fp+9);
                                                    if(cl>op){in_free=1; saw_free=1;}
                                                    fp=find_sub(cb5,"nio_free(",fp+1);
                                                }
                                                if(in_free==0 && cur!=1 && v_hit[mi]==0){
                                                    let msg:[]u8=nio_alloc(vn4.len+48);
                                                    if(msg.len==vn4.len+48){
                                                        let ml:i32=ab(msg,0,"4.3 uninitialized use of '");
                                                        ml=ab(msg,ml,vn4);
                                                        ml=ab(msg,ml,"'");
                                                        if(emit_hit(jt,jlp,nhp,"4.3",file,k3+1,msg[0..ml])<0){nio_free(msg); return -1;}
                                                    }
                                                    nio_free(msg);
                                                    v_hit[mi]=1;
                                                }
                                            }
                                        }
                                        op=find_sub(cb5,vn4,op+1);
                                    }
                                }
                                vi4=vi4+1;
                            }
                            if(saw_free==1){cur=2;}
                        }
                    }
                }
                k3=k3+1;
            }
        }
        mi=mi+1;
    }
    return 0;
}

// ---------------- object scan (direct byte parse of the module binary) ------
// Direct recovery: last B8 imm32 (no 48/49 REX) or 48 C7 C0 imm32 fully in the
// 16 bytes before 0F 05. Extended recovery (v3): same patterns, last one in
// the 160 bytes before 0F 05, rejected if the span contains 31 C0 / 29 C0.
fn obj_scan(bin:[]u8, bn:i32, jt:[]u8, jlp:[]i32, nhp:[]i32, binp:[]u8, txt:[]u8)i32 {
    let ur_present:i32=0;
    if(contains(bin,"/dev/urandom")>0 || contains(bin,"/dev/random")>0){ur_present=1;}
    if(contains(bin,"/dev/urandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1/4.6",binp,0,"binary contains /dev/urandom bytes")<0){return -1;}
    }
    if(contains(bin,"/dev/random")>0){
        if(emit_hit(jt,jlp,nhp,"4.1/4.6",binp,0,"binary contains /dev/random bytes")<0){return -1;}
    }
    if(contains(bin,"getrandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",binp,0,"binary contains getrandom bytes")<0){return -1;}
    }
    let bi:i32=0;
    while(bi+1<bn){
        if(bin[bi]==15){
            if(bin[bi+1]==5){
                let num:i64=-1;
                let lo:i32=bi-16;
                if(lo<0){lo=0;}
                let bj:i32=lo;
                while(bj<bi){
                    if(bin[bj]==184){
                        let rex:i32=0;
                        if(bj>0 && (bin[bj-1]==72 || bin[bj-1]==73)){rex=1;}
                        if(rex==0 && bj+5<=bi){num=le32(bin,bj+1);}
                    } else {
                        if(bj+7<=bi && bin[bj]==72 && bin[bj+1]==199 && bin[bj+2]==192){
                            num=le32(bin,bj+3);
                        }
                    }
                    bj=bj+1;
                }
                if(num<0){
                    let lo2:i32=bi-160;
                    if(lo2<0){lo2=0;}
                    let cand:i64=-1;
                    let cend:i32=0;
                    bj=lo2;
                    while(bj<bi){
                        if(bin[bj]==184){
                            let rex2:i32=0;
                            if(bj>0 && (bin[bj-1]==72 || bin[bj-1]==73)){rex2=1;}
                            if(rex2==0 && bj+5<=bi){cand=le32(bin,bj+1); cend=bj+5;}
                        } else {
                            if(bj+7<=bi && bin[bj]==72 && bin[bj+1]==199 && bin[bj+2]==192){
                                cand=le32(bin,bj+3); cend=bj+7;
                            }
                        }
                        bj=bj+1;
                    }
                    if(cand>=0){
                        let bad:i32=0;
                        let s2:i32=cend;
                        while(s2+1<bi){
                            if(bin[s2]==49 && bin[s2+1]==192){bad=1;}
                            if(bin[s2]==41 && bin[s2+1]==192){bad=1;}
                            s2=s2+1;
                        }
                        if(bad==0){num=cand;}
                    }
                }
                if(num==318 || num==228 || num==96){
                    let rl:[]u8="4.6/4.1";
                    if(num==228 || num==96){rl="4.6/4.2";}
                    let tl2:i32=ab(txt,0,"object: syscall imm ");
                    tl2=ab_i64(txt,tl2,num);
                    tl2=ab(txt,tl2," before syscall @off ");
                    tl2=ab_i64(txt,tl2,bi as i64);
                    if(tl2>0){
                        if(emit_hit(jt,jlp,nhp,rl,binp,0,txt[0..tl2])<0){return -1;}
                    }
                } else {
                    if((num==257 || num==2) && ur_present==1){
                        let tl3:i32=ab(txt,0,"object: syscall imm ");
                        tl3=ab_i64(txt,tl3,num);
                        tl3=ab(txt,tl3," (open) with /dev/urandom bytes present @off ");
                        tl3=ab_i64(txt,tl3,bi as i64);
                        if(tl3>0){
                            if(emit_hit(jt,jlp,nhp,"4.6",binp,0,txt[0..tl3])<0){return -1;}
                        }
                    }
                }
            } else {
                if(bin[bi+1]==49){
                    if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdtsc opcode (0F 31) in binary")<0){return -1;}
                } else {
                    if(bin[bi+1]==199 && bi+2<bn){
                        let modrm:i32=bin[bi+2] as i32;
                        let md:i32=(modrm/64)%4;
                        let rg:i32=(modrm/8)%8;
                        if(md==3 && rg==6){
                            if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdrand opcode (0F C7 /6) in binary")<0){return -1;}
                        }
                        if(md==3 && rg==7){
                            if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdseed opcode (0F C7 /7) in binary")<0){return -1;}
                        }
                    }
                }
            }
        }
        bi=bi+1;
    }
    return 0;
}

// sha256 hex of a byte span into hexb (64 chars); returns 0 ok.
fn sha_hex(s:[]u8, h32:[]u8, hexb:[]u8)i32 {
    if(ns_sha256(s,h32)!=0){return -1;}
    let hx:[]u8=ns_hex(h32);
    if(hx.len!=64){nio_free(hx); return -1;}
    let i:i32=0;
    while(i<64){hexb[i]=hx[i]; i=i+1;}
    nio_free(hx);
    return 0;
}

fn main()i32 {
    let modp:[]u8=_zag_arg(1);
    let binp:[]u8=_zag_arg(2);
    let evp:[]u8=_zag_arg(3);
    let attp:[]u8=_zag_arg(4);
    if(modp.len==0 || binp.len==0 || evp.len==0 || attp.len==0){
        _zag_println("usage: rngscan_v3 <module.zag> <module-binary> <replay-evidence> <attestation.json>");
        return 2;
    }
    let src:[]u8=nio_alloc(8388608);
    let pool:[]u8=nio_alloc(1048576);
    let jt:[]u8=nio_alloc(2097152);
    let jb:[]u8=nio_alloc(4194304);
    let bin:[]u8=nio_alloc(16777216);
    let evb:[]u8=nio_alloc(4096);
    let raw1:[]u8=nio_alloc(16384);
    let nc1:[]u8=nio_alloc(16384);
    let cb1:[]u8=nio_alloc(16384);
    let low1:[]u8=nio_alloc(16384);
    let pat1:[]u8=nio_alloc(256);
    let txt:[]u8=nio_alloc(1024);
    let impb:[]u8=nio_alloc(4096);
    let fullb:[]u8=nio_alloc(8192);
    let h32:[]u8=nio_alloc(32);
    let hexb:[]u8=nio_alloc(64);
    let pinb:[]u8=nio_alloc(4096);
    let pinpool:[]u8=nio_alloc(4096);
    let ns1:[]u8=nio_alloc(1024);
    let ns2:[]u8=nio_alloc(1024);
    let bodyb:[]u8=nio_alloc(4096);
    let expb:[]u8=nio_alloc(256);
    let vnpool:[]u8=nio_alloc(2048);
    let pfxa:[]u8=nio_alloc(256);
    let pfxb:[]u8=nio_alloc(256);
    let stpool:[]u8=nio_alloc(4096);
    if(src.len!=8388608 || jt.len!=2097152 || jb.len!=4194304){_zag_println("NOMEM"); return 2;}
    let loffr:[]u8=nio_alloc(800004); let loff:[]i32=loffr as []i32;
    let fb0r:[]u8=nio_alloc(256); let fb0:[]i32=fb0r as []i32;
    let fb1r:[]u8=nio_alloc(256); let fb1:[]i32=fb1r as []i32;
    let fl0r:[]u8=nio_alloc(256); let fl0:[]i32=fl0r as []i32;
    let fl1r:[]u8=nio_alloc(256); let fl1:[]i32=fl1r as []i32;
    let fpor:[]u8=nio_alloc(256); let fpoff:[]i32=fpor as []i32;
    let fplr:[]u8=nio_alloc(256); let fplen:[]i32=fplr as []i32;
    let fscr:[]u8=nio_alloc(256); let fscan:[]i32=fscr as []i32;
    let fnor:[]u8=nio_alloc(2048); let fname_off:[]i32=fnor as []i32;
    let fnlr:[]u8=nio_alloc(2048); let fname_len:[]i32=fnlr as []i32;
    let fnfr:[]u8=nio_alloc(2048); let fn_file:[]i32=fnfr as []i32;
    let fnsr:[]u8=nio_alloc(2048); let fn_start:[]i32=fnsr as []i32;
    let fner:[]u8=nio_alloc(2048); let fn_end:[]i32=fner as []i32;
    let stkr:[]u8=nio_alloc(2048); let stack:[]i32=stkr as []i32;
    let rchr:[]u8=nio_alloc(2048); let reach:[]i32=rchr as []i32;
    let stor:[]u8=nio_alloc(1024); let stoff:[]i32=stor as []i32;
    let stlr:[]u8=nio_alloc(1024); let stlen:[]i32=stlr as []i32;
    let pnor:[]u8=nio_alloc(1024); let pinoff:[]i32=pnor as []i32;
    let pnlr:[]u8=nio_alloc(1024); let pinlen:[]i32=pnlr as []i32;
    let fdr:[]u8=nio_alloc(80004); let fdepth:[]i32=fdr as []i32;
    let vofr:[]u8=nio_alloc(96); let v_off:[]i32=vofr as []i32;
    let vlnr:[]u8=nio_alloc(96); let v_len:[]i32=vlnr as []i32;
    let varr:[]u8=nio_alloc(96); let v_alloc:[]i32=varr as []i32;
    let vmr:[]u8=nio_alloc(96); let v_master:[]i32=vmr as []i32;
    let vsr:[]u8=nio_alloc(96); let v_skip:[]i32=vsr as []i32;
    let vcsr:[]u8=nio_alloc(96); let v_cstart:[]i32=vcsr as []i32;
    let vcer:[]u8=nio_alloc(96); let v_cend:[]i32=vcer as []i32;
    let vhr:[]u8=nio_alloc(96); let v_hit:[]i32=vhr as []i32;
    let jlpr:[]u8=nio_alloc(4); let jlp:[]i32=jlpr as []i32;
    let nhpr:[]u8=nio_alloc(4); let nhp:[]i32=nhpr as []i32;
    jlp[0]=1; nhp[0]=0;
    jt[0]=91;
    let srclen:i32=0;
    let pool_len:i32=0;
    let nfiles:i32=0;
    let nlines:i32=0;
    let nfns:i32=0;
    let nst:i32=0;
    let npin:i32=0;
    let pinpool_len:i32=0;
    let stpool_len:i32=0;
    let ops_checked:i32=0;
    let npinned:i32=0;
    let vendored_ok:i32=0;
    let cut:i32=-1;
    let ci:i32=0;
    while(ci<modp.len){if(modp[ci]==47){cut=ci;} ci=ci+1;}
    let moddir:[]u8=modp[0..0];
    let dotm:[]u8=nio_alloc(1);
    dotm[0]=46;
    if(cut>0){moddir=modp[0..cut];}
    if(cut==0){moddir=modp[0..1];}
    if(cut<0){moddir=dotm;}
    // ---- load module (file 0) ----
    let n0:i64=read_file(modp,src,0);
    if(n0<0 || n0>8388608){_zag_println("cannot read module"); return 2;}
    srclen=n0 as i32;
    let po:i32=pool_add(pool,pool_len,modp);
    if(po<0){_zag_println("pool full"); return 2;}
    fpoff[0]=po; fplen[0]=modp.len; pool_len=po+modp.len;
    fb0[0]=0; fb1[0]=srclen; fscan[0]=1;
    fl0[0]=0;
    nlines=index_lines(src,loff,nlines,0,srclen,200001);
    if(nlines<0){_zag_println("too many lines"); return 2;}
    fl1[0]=nlines;
    nfiles=1;
    // ---- transitive import loop (bare @import only) ----
    let fi:i32=0;
    while(fi<nfiles){
        let fpath:[]u8=pool[fpoff[fi]..fpoff[fi]+fplen[fi]];
        let k:i32=fl0[fi];
        while(k<fl1[fi]){
            let L:i32=get_line(src,loff,nlines,k,raw1);
            if(L<0){_zag_println("line read error"); return 2;}
            let r:i32=strip_line(raw1[0..L],nc1,cb1);
            if(r<0){
                if(emit_hit(jt,jlp,nhp,"SRC",fpath,k+1,"block comment /* */ on variation path (unsupported)")<0){_zag_println("hit buffer full"); return 2;}
            } else {
                let il:i32=parse_import(nc1[0..L],impb);
                if(il>0 && il<4096){
                    let imp:[]u8=impb[0..il];
                    // ---- §4.8 import-graph allowlist: pinned substrate + harness.zag + self only
                    let ibi:i32=imp.len-1;
                    while(ibi>=0 && imp[ibi]!=47){ibi=ibi-1;}
                    let ibase:[]u8=imp[ibi+1..imp.len];
                    let modbase:[]u8=modp[cut+1..modp.len];
                    if(cut<0){modbase=modp;}
                    let ok_imp:i32=0;
                    if(eq_bytes(ibase,"R33_NATIVE_IO_V1.zag")>0){ok_imp=1;}
                    if(eq_bytes(ibase,"R33_NATIVE_SHA256_V2.zag")>0){ok_imp=1;}
                    if(eq_bytes(ibase,"harness.zag")>0){ok_imp=1;}
                    if(eq_bytes(ibase,modbase)>0){ok_imp=1;}
                    if(ok_imp==0){
                        if(emit_hit(jt,jlp,nhp,"4.8",fpath,k+1,"import graph violation: non-allowlisted import")<0){_zag_println("hit err"); return 2;}
                    } else {
                    let fl2:i32=ab(fullb,0,moddir);
                    fl2=ab_byte(fullb,fl2,47);
                    fl2=ab(fullb,fl2,imp);
                    if(fl2>0){
                        let full:[]u8=fullb[0..fl2];
                        let seen:i32=0;
                        let g:i32=0;
                        while(g<nfiles){
                            let gp:[]u8=pool[fpoff[g]..fpoff[g]+fplen[g]];
                            if(eq_bytes(gp,full)>0){seen=1;}
                            g=g+1;
                        }
                        if(seen==0 && nfiles<64){
                            let nn:i64=read_file(full,src,srclen);
                            if(nn<0 || srclen+(nn as i32)>8388608){_zag_println("cannot read import"); return 2;}
                            let po2:i32=pool_add(pool,pool_len,full);
                            if(po2<0){_zag_println("pool full"); return 2;}
                            fpoff[nfiles]=po2; fplen[nfiles]=full.len; pool_len=po2+full.len;
                            fb0[nfiles]=srclen; srclen=srclen+(nn as i32); fb1[nfiles]=srclen;
                            if(is_vendored(full)>0){fscan[nfiles]=0;} else {fscan[nfiles]=1;}
                            fl0[nfiles]=nlines;
                            nlines=index_lines(src,loff,nlines,fb0[nfiles],fb1[nfiles],200001);
                            if(nlines<0){_zag_println("too many lines"); return 2;}
                            fl1[nfiles]=nlines;
                            nfiles=nfiles+1;
                        }
                    }
                    } // end else (allowlisted import)
                }
            }
            k=k+1;
        }
        fi=fi+1;
    }
    loff[nlines]=srclen;
    // ---- vendored hash verification (at audit time) ----
    let vfound:i32=0;
    let vmatch:i32=0;
    fi=0;
    while(fi<nfiles){
        let fpathv:[]u8=pool[fpoff[fi]..fpoff[fi]+fplen[fi]];
        if(is_vendored(fpathv)>0){
            vfound=vfound+1;
            let fbytes:[]u8=src[fb0[fi]..fb1[fi]];
            if(sha_hex(fbytes,h32,hexb)==0){
                if(ends_with(fpathv,"R33_NATIVE_SHA256_V2.zag")>0){
                    if(eq_bytes(hexb[0..64],"9824f6db66a943917dbc7cd5e6862ab0967b7ea83161cfc357bb7d17ca683bcf")>0){vmatch=vmatch+1;}
                } else {
                    if(eq_bytes(hexb[0..64],"e6379ddb0b05d95b5ba2e8454ef8cc6bc74d054cfa44175c379296641e9f61d8")>0){vmatch=vmatch+1;}
                }
            }
        }
        fi=fi+1;
    }
    if(vfound>=1 && vmatch==vfound){vendored_ok=1;}
    else {
        if(emit_hit(jt,jlp,nhp,"VENDOR",modp,0,"vendored trusted surface hash mismatch or missing")<0){_zag_println("hit err"); return 2;}
    }
    // ---- pass 0: pinned const names (for the narrowed 4.4 carve-out) ----
    fi=0;
    while(fi<nfiles){
        if(fscan[fi]==1){
            let k0:i32=fl0[fi];
            while(k0<fl1[fi] && npin<64){
                let L0:i32=get_line(src,loff,nlines,k0,raw1);
                if(L0>=0 && contains(raw1[0..L0],"PINNED")>0 && strip_line(raw1[0..L0],nc1,cb1)==0){
                    to_lower_buf(cb1[0..L0],low1);
                    let low0:[]u8=low1[0..L0];
                    let t0:[]u8=trim_left(low0);
                    if(starts_with(t0,"const ")>0){
                        let np2:i32=6;
                        while(np2<t0.len && (t0[np2]==32||t0[np2]==9)){np2=np2+1;}
                        let ne2:i32=read_ident(t0,np2);
                        if(ne2>np2 && ne2-np2<64){
                            let nm2:[]u8=t0[np2..ne2];
                            let po3:i32=pool_add(pinpool,pinpool_len,nm2);
                            if(po3>=0){
                                pinoff[npin]=po3; pinlen[npin]=nm2.len;
                                pinpool_len=po3+nm2.len;
                                npin=npin+1;
                            }
                        }
                    }
                }
                k0=k0+1;
            }
        }
        fi=fi+1;
    }
    // ---- source scan (variation path only) ----
    fi=0;
    while(fi<nfiles){
        if(fscan[fi]==1){
            let fpath2:[]u8=pool[fpoff[fi]..fpoff[fi]+fplen[fi]];
            let k2:i32=fl0[fi];
            while(k2<fl1[fi]){
                let L2:i32=get_line(src,loff,nlines,k2,raw1);
                if(L2<0){_zag_println("line read error"); return 2;}
                let r2:i32=strip_line(raw1[0..L2],nc1,cb1);
                if(r2==0){
                    let nc:[]u8=nc1[0..L2];
                    if(is_blank(nc)==0){
                        ops_checked=ops_checked+1;
                        if(scan_literals(raw1[0..L2],jt,jlp,nhp,fpath2,k2+1)<0){_zag_println("literal scan err"); return 2;}
                        to_lower_buf(cb1[0..L2],low1);
                        let low:[]u8=low1[0..L2];
                        if(check_ident_rules(low,jt,jlp,nhp,fpath2,k2+1,pinpool,pinoff,pinlen,npin)<0){_zag_println("rule scan err"); return 2;}
                        if(check_intrinsics(cb1[0..L2],jt,jlp,nhp,fpath2,k2+1)<0){_zag_println("intrinsic scan err"); return 2;}
                    }
                }
                k2=k2+1;
            }
        }
        fi=fi+1;
    }
    // ---- collect fns + struct names (variation path) ----
    fi=0;
    while(fi<nfiles){
        if(fscan[fi]==1){
            let k3:i32=fl0[fi];
            while(k3<fl1[fi]){
                let L3:i32=get_line(src,loff,nlines,k3,raw1);
                if(L3>=0 && strip_line(raw1[0..L3],nc1,cb1)==0){
                    let t:[]u8=trim_left(cb1[0..L3]);
                    if(starts_with(t,"fn ")>0 && nfns<512){
                        let ns3:i32=3;
                        while(ns3<t.len && (t[ns3]==32||t[ns3]==9)){ns3=ns3+1;}
                        let ne3:i32=read_ident(t,ns3);
                        if(ne3>ns3 && ne3-ns3<100){
                            let nl4:i32=ne3-ns3;
                            let po4:i32=pool_add(pool,pool_len,t[ns3..ne3]);
                            if(po4>=0 && po4+nl4<=pool.len){
                                let q4:i32=0;
                                while(q4<nl4){
                                    let cc:u8=pool[po4+q4];
                                    if(cc>=65 && cc<=90){pool[po4+q4]=cc+32;}
                                    q4=q4+1;
                                }
                                let e3:i32=brace_end(src,loff,nlines,k3,fl1[fi]-1,nc1,cb1);
                                fname_off[nfns]=po4; fname_len[nfns]=nl4;
                                fn_file[nfns]=fi; fn_start[nfns]=k3; fn_end[nfns]=e3;
                                pool_len=po4+nl4;
                                nfns=nfns+1;
                            }
                        }
                    }
                    let nl5:i32=nospace(cb1[0..L3],ns1);
                    if(nl5>0){
                        let nsw5:[]u8=ns1[0..nl5];
                        if(starts_with(nsw5,"struct")>0 && nst<128){
                            let sp5:i32=6;
                            while(sp5<nsw5.len && (nsw5[sp5]==32||nsw5[sp5]==9)){sp5=sp5+1;}
                            let se5:i32=read_ident(nsw5,sp5);
                            if(se5>sp5 && se5-sp5<64){
                                let nm5:[]u8=nsw5[sp5..se5];
                                let po5:i32=pool_add(stpool,stpool_len,nm5);
                                if(po5>=0){
                                    let q5:i32=0;
                                    while(q5<nm5.len){
                                        let cc5:u8=stpool[po5+q5];
                                        if(cc5>=65 && cc5<=90){stpool[po5+q5]=cc5+32;}
                                        q5=q5+1;
                                    }
                                    stoff[nst]=po5; stlen[nst]=nm5.len;
                                    stpool_len=po5+nm5.len;
                                    nst=nst+1;
                                }
                            }
                        }
                    }
                }
                k3=k3+1;
            }
        }
        fi=fi+1;
    }
    // ---- rule 4.4 structural ----
    if(check_44_structural(jt,jlp,nhp,modp,pool,fname_off,fname_len,nfns,
                           stpool,stoff,stlen,nst,pfxa,pfxb)<0){_zag_println("4.4 err"); return 2;}
    // ---- rule 4.3 dataflow per fn ----
    let fni:i32=0;
    while(fni<nfns){
        let ff:[]i32=fpoff;
        let ffp:[]u8=pool[ff[fn_file[fni]]..ff[fn_file[fni]]+fplen[fn_file[fni]]];
        if(scan_43(src,loff,nlines,fn_start[fni],fn_end[fni],ffp,jt,jlp,nhp,
                   raw1,nc1,cb1,ns1,ns2,bodyb,expb,vnpool,txt,
                   fdepth,v_off,v_len,v_alloc,v_master,v_skip,v_cstart,v_cend,v_hit)<0){
            _zag_println("dataflow err"); return 2;
        }
        fni=fni+1;
    }
    // ---- call graph from vary_expr ----
    let entry:i32=-1;
    fni=0;
    while(fni<nfns){
        let enn:[]u8=pool[fname_off[fni]..fname_off[fni]+fname_len[fni]];
        if(eq_bytes(enn,"vary_expr")>0){entry=fni;}
        fni=fni+1;
    }
    let ncallees:i32=0;
    if(entry<0){
        if(emit_hit(jt,jlp,nhp,"ENTRY",modp,0,"variation_path_entry 'vary_expr' not found")<0){_zag_println("hit err"); return 2;}
    } else {
        let sp2:i32=0;
        stack[0]=entry; sp2=1; reach[entry]=1;
        while(sp2>0){
            sp2=sp2-1;
            let cf:i32=stack[sp2];
            let g:i32=0;
            while(g<nfns){
                if(g!=cf && reach[g]==0){
                    let gn:[]u8=pool[fname_off[g]..fname_off[g]+fname_len[g]];
                    let pl5:i32=ab(pat1,0,gn); pl5=ab(pat1,pl5,"(");
                    let foundcall:i32=0;
                    if(pl5>0){
                        let pat:[]u8=pat1[0..pl5];
                        let k4:i32=fn_start[cf];
                        while(k4<=fn_end[cf] && foundcall==0){
                            let L4:i32=get_line(src,loff,nlines,k4,raw1);
                            if(L4>=0 && strip_line(raw1[0..L4],nc1,cb1)==0){
                                to_lower_buf(cb1[0..L4],low1);
                                let low4:[]u8=low1[0..L4];
                                let p5:i32=find_sub(low4,pat,0);
                                while(p5>=0 && foundcall==0){
                                    let okb2:i32=1;
                                    if(p5>0 && is_idchar(low4[p5-1])>0){okb2=0;}
                                    if(okb2==1){foundcall=1;}
                                    p5=find_sub(low4,pat,p5+1);
                                }
                            }
                            k4=k4+1;
                        }
                    }
                    if(foundcall==1 && sp2<512){reach[g]=1; stack[sp2]=g; sp2=sp2+1;}
                }
                g=g+1;
            }
        }
        let g2:i32=0;
        while(g2<nfns){
            if(reach[g2]==1 && g2!=entry){ncallees=ncallees+1;}
            g2=g2+1;
        }
    }
    // ---- PINNED table attestation hashes ----
    fi=0;
    while(fi<nfiles && npinned<64){
        if(fscan[fi]==1){
            let k5:i32=fl0[fi];
            while(k5<fl1[fi] && npinned<64){
                let L5:i32=get_line(src,loff,nlines,k5,raw1);
                if(L5>0 && contains(raw1[0..L5],"PINNED")>0 && strip_line(raw1[0..L5],nc1,cb1)==0){
                    to_lower_buf(cb1[0..L5],low1);
                    let low5:[]u8=low1[0..L5];
                    let t5:[]u8=trim_left(low5);
                    if(starts_with(t5,"const ")>0){
                        let f5s:i32=-1;
                        let f5e:i32=-1;
                        let gi5:i32=0;
                        while(gi5<nfns){
                            if(fn_file[gi5]==fi && fn_start[gi5]<=k5 && k5<=fn_end[gi5]){
                                f5s=fn_start[gi5]; f5e=fn_end[gi5];
                            }
                            gi5=gi5+1;
                        }
                        if(f5s>=0 && f5e>=f5s){
                            let e5end:i32=loff[f5e+1];
                            let span:[]u8=src[loff[f5s]..e5end];
                            if(sha_hex(span,h32,hexb)==0 && npinned*64+64<=pinb.len){
                                let q6:i32=0;
                                while(q6<64){pinb[npinned*64+q6]=hexb[q6]; q6=q6+1;}
                                npinned=npinned+1;
                            }
                        } else {
                            let lspan:[]u8=src[loff[k5]..loff[k5+1]];
                            if(sha_hex(lspan,h32,hexb)==0 && npinned*64+64<=pinb.len){
                                let q7:i32=0;
                                while(q7<64){pinb[npinned*64+q7]=hexb[q7]; q7=q7+1;}
                                npinned=npinned+1;
                            }
                        }
                    }
                }
                k5=k5+1;
            }
        }
        fi=fi+1;
    }
    // ---- module sha256 (transitive sources concatenated in import order) ----
    if(sha_hex(src[0..srclen],h32,hexb)!=0){_zag_println("sha fail"); return 2;}
    // ---- object scan ----
    let obj_hits_before:i32=nhp[0];
    let bnr:i64=read_file(binp,bin,0);
    if(bnr<0 || bnr>16777216){
        if(emit_hit(jt,jlp,nhp,"OBJ",binp,0,"cannot read binary for object scan")<0){_zag_println("hit err"); return 2;}
    } else {
        let bn:i32=bnr as i32;
        if(obj_scan(bin[0..bn],bn,jt,jlp,nhp,binp,txt)<0){_zag_println("obj err"); return 2;}
    }
    let obj_clean:i32=0;
    if(nhp[0]==obj_hits_before){obj_clean=1;}
    // ---- replay evidence ----
    let ev_ok:i32=0;
    let ev_ident:i64=0;
    let ev_varies:i64=0;
    let ev_words:i64=0;
    let ev_runs:i64=0;
    let ev_layouts:i64=0;
    let ev_exit:i64=0;
    let enr:i64=read_file(evp,evb,0);
    if(enr<0 || enr>4096){
        if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"cannot read replay evidence")<0){_zag_println("hit err"); return 2;}
    } else {
        let en:i32=enr as i32;
        let got_ident:i32=0; let got_varies:i32=0; let got_words:i32=0;
        let got_runs:i32=0; let got_exit:i32=0; let got_layouts:i32=0;
        let ls:i32=0;
        while(ls<en){
            let le:i32=ls;
            while(le<en && evb[le]!=10){le=le+1;}
            let eline:[]u8=evb[ls..le];
            if(eline.len>0 && eline[eline.len-1]==13){eline=eline[0..eline.len-1];}
            if(is_blank(eline)==0){
                let eq:i32=find_sub(eline,"=",0);
                if(eq>0){
                    let key:[]u8=eline[0..eq];
                    let val:[]u8=eline[eq+1..eline.len];
                    let pv:i64=parse_i64(val);
                    if(pv>=0){
                        if(eq_bytes(key,"byte_identical")>0){ev_ident=pv; got_ident=1;}
                        else {if(eq_bytes(key,"varies_with_state")>0){ev_varies=pv; got_varies=1;}
                        else {if(eq_bytes(key,"state_words")>0){ev_words=pv; got_words=1;}
                        else {if(eq_bytes(key,"runs")>0){ev_runs=pv; got_runs=1;}
                        else {if(eq_bytes(key,"exit_ok")>0){ev_exit=pv; got_exit=1;}
                        else {if(eq_bytes(key,"layouts")>0){ev_layouts=pv; got_layouts=1;}}}}}}
                    }
                }
            }
            ls=le+1;
        }
        if(got_ident==1 && got_varies==1 && got_words==1 && got_runs==1 && got_exit==1 && got_layouts==1){
            ev_ok=1;
            if(ev_runs!=8){
                ev_ok=0;
                if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"replay evidence: runs != 8")<0){_zag_println("hit err"); return 2;}
            }
            if(ev_layouts<2){
                ev_ok=0;
                if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"replay evidence: layouts < 2")<0){_zag_println("hit err"); return 2;}
            }
            if(ev_exit!=1){
                ev_ok=0;
                if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"replay evidence: exit_ok != 1")<0){_zag_println("hit err"); return 2;}
            }
            if(ev_ident!=1){
                ev_ok=0;
                if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"replay evidence: not byte-identical")<0){_zag_println("hit err"); return 2;}
            }
        } else {
            if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"malformed replay evidence")<0){_zag_println("hit err"); return 2;}
        }
    }
    // ---- attestation JSON (BAN-2026-09-20-v3 schema) ----
    jlp[0]=ab_byte(jt,jlp[0],93);
    let p:i32=0;
    p=ab_byte(jb,p,123); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"audit"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"no-rng"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"arm"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"C"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"allowlist_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"ALLOW-2026-09-20-v1"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"BAN-2026-09-20-v3"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"intrinsic_allowlist_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"INTRINSIC-ALLOW-2026-09-20-v3"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"checker_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"RNGSCAN-2026-09-20-v3"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"runner_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"RUNAUDIT-2026-09-20-v2"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"module_sha256"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,hexb[0..64]); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"vendored_sha256"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_byte(jb,p,123);
    p=ab_quoted(jb,p,"R33_NATIVE_SHA256_V2.zag"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"9824f6db66a943917dbc7cd5e6862ab0967b7ea83161cfc357bb7d17ca683bcf"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"R33_NATIVE_IO_V1.zag"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"e6379ddb0b05d95b5ba2e8454ef8cc6bc74d054cfa44175c379296641e9f61d8");
    p=ab_byte(jb,p,125); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"vendored_ok"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(vendored_ok==1){p=ab(jb,p,"true");} else {p=ab(jb,p,"false");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"lookup_table_sha256"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_byte(jb,p,91);
    let pi2:i32=0;
    while(pi2<npinned){
        if(pi2>0){p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);}
        p=ab_quoted(jb,p,pinb[pi2*64..pi2*64+64]);
        pi2=pi2+1;
    }
    p=ab_byte(jb,p,93); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"variation_path_entry"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"vary_expr"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"callees"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ncallees as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"ops_checked"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ops_checked as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_hits"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,nhp[0] as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_hit_detail"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab(jb,p,jt[0..jlp[0]]); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"object_byte_scan"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(obj_clean==1){p=ab_quoted(jb,p,"clean");} else {p=ab_quoted(jb,p,"BANNED-FOUND");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"replay"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_byte(jb,p,123);
    p=ab_quoted(jb,p,"runs"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32); p=ab_i64(jb,p,ev_runs); p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"byte_identical"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(ev_ident==1){p=ab(jb,p,"true");} else {p=ab(jb,p,"false");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"varies_with_state"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(ev_varies==1){p=ab(jb,p,"true");} else {p=ab(jb,p,"false");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"state_words_logged"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ev_words); p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"layout_variants"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ev_layouts);
    p=ab_byte(jb,p,125); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"verdict"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    let pass:i32=0;
    if(nhp[0]==0 && ev_ok==1 && vendored_ok==1){pass=1;}
    if(pass==1){p=ab_quoted(jb,p,"PASS");} else {p=ab_quoted(jb,p,"FAIL");}
    p=ab_byte(jb,p,10); p=ab_byte(jb,p,125); p=ab_byte(jb,p,10);
    if(p<0){_zag_println("json buffer full"); return 2;}
    let wr:i64=write_file(attp,jb,p);
    if(wr<0){_zag_println("cannot write attestation"); return 2;}
    let sl2:i32=ab(txt,0,"RNGSCAN v3: hits=");
    sl2=ab_i64(txt,sl2,nhp[0] as i64);
    sl2=ab(txt,sl2," obj=");
    if(obj_clean==1){sl2=ab(txt,sl2,"clean");} else {sl2=ab(txt,sl2,"BANNED-FOUND");}
    sl2=ab(txt,sl2," vendored=");
    if(vendored_ok==1){sl2=ab(txt,sl2,"ok");} else {sl2=ab(txt,sl2,"BAD");}
    sl2=ab(txt,sl2," replay_identical=");
    if(ev_ident==1){sl2=ab(txt,sl2,"yes");} else {sl2=ab(txt,sl2,"NO");}
    sl2=ab(txt,sl2," varies_with_state=");
    if(ev_varies==1){sl2=ab(txt,sl2,"yes");} else {sl2=ab(txt,sl2,"no");}
    sl2=ab(txt,sl2," verdict=");
    if(pass==1){sl2=ab(txt,sl2,"PASS");} else {sl2=ab(txt,sl2,"FAIL");}
    if(sl2>0){_zag_println(txt[0..sl2]);}
    if(pass==1){return 0;}
    return 1;
}

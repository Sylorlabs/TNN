@import("harness.zag")
// @import("phantom_impl.zag")

// PLANT 13 (new, 4.9): the commented import points at a REAL file
// (phantom_impl.zag, which itself contains a banned construct), but per
// prereg 4.9 the commented directive is absent, so the phantom file is
// not in the scan set. The module's own vary_expr reads getrandom via
// raw syscall (should-catch via the module's own 4.1/4.2 token).
// Genuine: getrandom bytes vary every run.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall(318, ep as i64, 32, 0, 0, 0, 0);
    if(nr!=32){return 2;}
    let i:i32=0;
    while(i<64){
        out[i]=eb[i%32]^input[i];
        i=i+1;
    }
    nio_free(eb);
    return 0;
}

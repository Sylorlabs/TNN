@import("harness.zag")

// PLANT 05 — reconstruction of v2 plant19 (4.1 entropy/getrandom).
// Disguise: literal 318 passed as a helper argument; the syscall
// itself takes a variable. Genuine: getrandom bytes vary every run.

fn doget(nr:i64, eb:[]u8, n:i64)i64 {
    let ep:u64=_zag_slice_ptr(eb) as u64;
    return _zag_raw_syscall(nr, ep as i64, n, 0, 0, 0, 0);
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len==0){return 1;}
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let nr:i64=doget(318, eb, 32);
    if(nr!=32){return 2;}
    let i:i32=0;
    while(i<64){
        out[i]=eb[i%32]^input[i%input.len];
        i=i+1;
    }
    nio_free(eb);
    return 0;
}

@import("harness.zag")

// PLANT 14 (new, 4.3): free-then-read. Buffer is canonically
// initialized, then freed, then read -> use-after-free is a 4.3 hit
// (should-catch). Genuine 4.3: freed heap bytes folded into out.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let buf:[]u8=nio_alloc(64);
    if(buf.len!=64){return 2;}
    let i:i32=0;
    while(i<buf.len){
        buf[i]=(i as u8)^input[i];
        i=i+1;
    }
    nio_free(buf);
    let j:i32=0;
    while(j<64){
        out[j]=buf[j]^input[j];
        j=j+1;
    }
    return 0;
}

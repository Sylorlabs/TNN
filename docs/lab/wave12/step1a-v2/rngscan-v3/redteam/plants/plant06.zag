@import("harness.zag")

// PLANT 06 — reconstruction of v2 plant20 (4.3 uninitialized memory).
// Disguise: init loop breaks on a sentinel (input byte 0), so the
// tail of the buffer is never written; the uninit tail is folded into
// the output. The body contains if/break -> not the strict canonical
// form. Genuine 4.3: uninit heap bytes (zeroed on this platform, but
// genuinely read and folded into out — verified by diff vs clean).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64 || state.len<64){return 1;}
    let buf:[]u8=nio_alloc(64);
    if(buf.len!=64){return 2;}
    // NOTE: deliberately no canonical init; loop exits early on sentinel.
    // sentinel: (input[0]&31) == 9 for the fixture -> tail stays uninit.
    let i:i32=0;
    while(i<buf.len){
        if(i==((input[0] as i32)&31)){break;}
        buf[i]=input[i]^state[i];
        i=i+1;
    }
    let j:i32=0;
    while(j<64){
        out[j]=buf[j]^state[j];
        j=j+1;
    }
    nio_free(buf);
    return 0;
}

@import("harness.zag")
@import("helper12.zag")

// PLANT 12 (new, 4.8): fn* dynamic dispatch lives in a HELPER FILE.
// vary_expr just calls dispatch(); probes transitive-callee scanning
// (should-catch via the fn* token in helper12.zag).
// Genuine: helper reads getrandom; bytes vary every run.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let r:i64=dispatch(state[0] as i64);
    let i:i32=0;
    while(i<64){
        let sh:i32=(i%8)*8;
        out[i]=((r>>sh) as u8)^input[i];
        i=i+1;
    }
    return 0;
}

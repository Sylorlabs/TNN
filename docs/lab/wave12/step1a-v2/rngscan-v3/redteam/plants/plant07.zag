@import("harness.zag")

// PLANT 07 (new, 4.3): init loop with an i64 counter. The strict
// canonical form requires `let I:i32=0;`; an i64 counter is not the
// form -> buffer stays UNINIT -> the read is a 4.3 hit (should-catch).
// Genuine 4.3: uninit heap bytes folded into out.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let buf:[]u8=nio_alloc(64);
    if(buf.len!=64){return 2;}
    let i:i64=0;
    while(i<64){
        buf[i as i32]=((i as i32) as u8)^input[i as i32];
        i=i+1;
    }
    let j:i32=0;
    while(j<64){
        out[j]=buf[j]^input[j];
        j=j+1;
    }
    nio_free(buf);
    return 0;
}

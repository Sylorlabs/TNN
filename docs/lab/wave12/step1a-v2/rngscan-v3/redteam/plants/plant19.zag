@import("harness.zag")

// PLANT 19 (new, 4.3, ADVERSARIAL): return-allocated uninit read.
// The allocation happens in grab() and is returned; the caller binds it
// to `u`. The 4.3 pass only tracks `let NAME = nio_alloc(...)` in the
// same scope, so `u` is never a tracked name -> the read is not a 4.3
// hit, yet it reads uninitialized heap (zeroed on this platform).
// Per the v2 precedent (plant07, K3 fired), a genuine uninit read on a
// PASS path is a valid plant; genuineness verified by diff vs clean
// (the bytes flow into out).

fn grab(n:i32)[]u8 {
    return nio_alloc(n);
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64 || state.len<64){return 1;}
    let u:[]u8=grab(64);
    if(u.len!=64){return 2;}
    let i:i32=0;
    while(i<64){
        out[i]=u[i]^input[i]^state[i];
        i=i+1;
    }
    nio_free(u);
    return 0;
}

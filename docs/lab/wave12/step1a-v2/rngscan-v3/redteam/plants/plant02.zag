@import("harness.zag")

// PLANT 02 — reconstruction of v2 plant16 (4.8 dynamic dispatch).
// Disguise: reassigned fn* variable; the selected function reads
// wall-clock via raw clock_gettime and folds it into the output.
// Genuine: tv_nsec varies every run.

fn const_src(x:i64)i64 {
    return x;
}

fn tick_src(x:i64)i64 {
    let tb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<tb.len){
        tb[zi]=0;
        zi=zi+1;
    }
    let tp:u64=_zag_slice_ptr(tb) as u64;
    _zag_raw_syscall(228, 0, tp as i64, 0, 0, 0, 0);
    // timespec: tv_sec @0, tv_nsec @8
    let v:i64=(tb[0] as i64)^((tb[8] as i64)<<13)^((tb[15] as i64)<<29)^x;
    nio_free(tb);
    return v;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || state.len==0){return 1;}
    let f:fn*(i64)i64=const_src;
    f=tick_src;
    let r:i64=f(0);
    let i:i32=0;
    while(i<64){
        let sh:i32=(i%8)*8;
        out[i]=((r>>sh) as u8)^state[i%state.len];
        i=i+1;
    }
    return 0;
}

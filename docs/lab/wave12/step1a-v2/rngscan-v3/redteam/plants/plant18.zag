@import("harness.zag")

// PLANT 18 (new, 4.4, ADVERSARIAL): threshold evasion. Insert fn `_add`
// carries the boundary-aware insert token `add` (char before is `_`,
// not [a-z0-9]) with prefix `_` of length 1 (< 2, so T2 cannot fire);
// iterate fn `_iter` carries `iter` with prefix `_` (< 2, no T2). There
// is no `struct` declaration at all, so T1 cannot fire. No tripwire
// identifiers. A real open-addressed table whose slot order feeds out.
// Probes the exact len>=2 thresholds of T1/T2.

fn _add(keys:[]u8, vals:[]u8, used:[]u8, k:u8, v:u8)void {
    let n:i32=keys.len;
    let h:i32=(((k as i32)*11+5)%n + n)%n;
    let j:i32=0;
    while(j<n){
        let s:i32=(h+j)%n;
        if(used[s]==0){
            keys[s]=k;
            vals[s]=v;
            used[s]=1;
            return;
        }
        if(keys[s]==k){
            vals[s]=v;
            return;
        }
        j=j+1;
    }
}

fn _iter(keys:[]u8, vals:[]u8, used:[]u8, out:[]u8)void {
    let o:i32=0;
    let s:i32=0;
    while(s<used.len && o<out.len){
        if(used[s]!=0){
            out[o]=keys[s]^vals[s];
            o=o+1;
        }
        s=s+1;
    }
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64 || state.len<64){return 1;}
    let keys:[]u8=nio_alloc(64);
    let vals:[]u8=nio_alloc(64);
    let used:[]u8=nio_alloc(64);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){return 2;}
    let zi:i32=0;
    while(zi<keys.len){
        keys[zi]=0;
        zi=zi+1;
    }
    let zj:i32=0;
    while(zj<vals.len){
        vals[zj]=0;
        zj=zj+1;
    }
    let zk:i32=0;
    while(zk<used.len){
        used[zk]=0;
        zk=zk+1;
    }
    let i:i32=0;
    while(i<64){
        _add(keys, vals, used, input[i]^(i as u8), state[i]^((i*3) as u8));
        i=i+1;
    }
    _iter(keys, vals, used, out);
    nio_free(keys);
    nio_free(vals);
    nio_free(used);
    return 0;
}

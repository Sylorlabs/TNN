@import("harness.zag")

// PLANT 08 (new, 4.3): cross-procedure init. prep() canonically
// initializes its PARAMETER, but the 4.3 analysis is intra-procedural:
// the caller's buffer never gets a canonical init in vary_expr's scope,
// so the caller's read is a 4.3 hit (should-catch, fail-closed).
// Genuine 4.3: caller reads memory the analysis cannot prove init.

fn prep(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        b[i]=(i as u8);
        i=i+1;
    }
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let buf:[]u8=nio_alloc(64);
    if(buf.len!=64){return 2;}
    prep(buf);
    let j:i32=0;
    while(j<64){
        out[j]=buf[j]^input[j];
        j=j+1;
    }
    nio_free(buf);
    return 0;
}

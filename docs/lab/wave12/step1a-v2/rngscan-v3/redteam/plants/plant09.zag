@import("harness.zag")

// PLANT 09 (new, 4.3): subrange alias of an uninit buffer.
// `let s:[]u8 = b[8..56];` — RHS begins with `b` followed by `[`
// (non-identifier char) -> s shares b's slot per the alias rule;
// b is never initialized -> reading s is a 4.3 hit (should-catch,
// positive control for the alias tracking).
// Genuine 4.3: uninit heap bytes folded into out.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let b:[]u8=nio_alloc(64);
    if(b.len!=64){return 2;}
    let s:[]u8=b[8..56];
    let j:i32=0;
    while(j<48){
        out[j]=s[j]^input[j];
        j=j+1;
    }
    while(j<64){
        out[j]=input[j];
        j=j+1;
    }
    nio_free(b);
    return 0;
}

@import("harness.zag")

// PLANT 15 (new, 4.1): /dev/urandom via raw openat/read; the path is
// built from byte codes (no "/dev/urandom" literal anywhere) and the
// fd is threaded through a helper. Probes the object byte-scan's path
// search when the path never appears as bytes (should-catch via the
// source `_zag_raw_syscall(` token regardless).
// Genuine: urandom bytes vary every run.

fn pull(fd:i64, eb:[]u8, n:i64)i64 {
    let ep:u64=_zag_slice_ptr(eb) as u64;
    return _zag_raw_syscall(0, fd, ep as i64, n, 0, 0, 0);
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let pb:[]u8=nio_alloc(32);
    if(pb.len!=32){return 2;}
    let zi:i32=0;
    while(zi<pb.len){
        pb[zi]=0;
        zi=zi+1;
    }
    // "/dev/urandom" from byte codes: 2F 64 65 76 2F 75 72 61 6E 64 6F 6D
    pb[0]=47; pb[1]=100; pb[2]=101; pb[3]=118;
    pb[4]=47; pb[5]=117; pb[6]=114; pb[7]=97; pb[8]=110; pb[9]=100;
    pb[10]=111; pb[11]=109;
    let pp:u64=_zag_slice_ptr(pb) as u64;
    let fd:i64=_zag_raw_syscall(257, -100, pp as i64, 0, 0, 0, 0);
    if(fd<0){return 3;}
    let eb:[]u8=nio_alloc(65536);
    let zj:i32=0;
    while(zj<eb.len){
        eb[zj]=0;
        zj=zj+1;
    }
    let nr:i64=pull(fd, eb, 32);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if(nr!=32){return 4;}
    let i:i32=0;
    while(i<64){
        out[i]=eb[i%32]^input[i];
        i=i+1;
    }
    nio_free(pb);
    nio_free(eb);
    return 0;
}

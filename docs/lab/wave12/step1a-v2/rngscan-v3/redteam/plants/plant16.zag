@import("harness.zag")

// PLANT 16 (new, 4.2): clock_gettime number delivered via a memory
// mailbox. 228 is stored as bytes and reloaded; no 228 immediate need
// appear near the syscall. Probes whether the object scan's extended
// immediate recovery is the thing catching computed numbers
// (should-catch via the source token regardless).
// Genuine: tv_nsec varies every run.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || state.len<64){return 1;}
    let box:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<box.len){
        box[zi]=0;
        zi=zi+1;
    }
    box[0]=228; box[1]=0; box[2]=0; box[3]=0;
    box[4]=0; box[5]=0; box[6]=0; box[7]=0;
    let nr:i64=(box[0] as i64)|((box[1] as i64)<<8)|((box[2] as i64)<<16)|((box[3] as i64)<<24);
    let tb:[]u8=nio_alloc(65536);
    let zj:i32=0;
    while(zj<tb.len){
        tb[zj]=0;
        zj=zj+1;
    }
    let tp:u64=_zag_slice_ptr(tb) as u64;
    _zag_raw_syscall(nr, 0, tp as i64, 0, 0, 0, 0);
    let i:i32=0;
    while(i<64){
        out[i]=tb[i%16]^state[i];
        i=i+1;
    }
    nio_free(box);
    nio_free(tb);
    return 0;
}

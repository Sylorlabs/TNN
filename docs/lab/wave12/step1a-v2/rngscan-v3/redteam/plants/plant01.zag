@import("harness.zag")

// PLANT 01 — reconstruction of v2 plant15 (4.5 impure-of-inputs).
// Disguise: raw-syscall read of /proc/self/exe; path built from byte
// codes (no string literal); file bytes folded into the output.
// Genuine: real runtime read of unlogged file bytes (own ELF header).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len==0 || state.len==0){return 1;}
    let pb:[]u8=nio_alloc(64);
    if(pb.len!=64){return 2;}
    let zi:i32=0;
    while(zi<pb.len){
        pb[zi]=0;
        zi=zi+1;
    }
    // "/proc/self/exe" from byte codes
    pb[0]=47; pb[1]=112; pb[2]=114; pb[3]=111; pb[4]=99;
    pb[5]=47; pb[6]=115; pb[7]=101; pb[8]=108; pb[9]=102;
    pb[10]=47; pb[11]=101; pb[12]=120; pb[13]=101;
    let pp:u64=_zag_slice_ptr(pb) as u64;
    let fd:i64=_zag_raw_syscall(257, -100, pp as i64, 0, 0, 0, 0);
    let eb:[]u8=nio_alloc(65536);
    if(eb.len!=65536){return 3;}
    let zj:i32=0;
    while(zj<eb.len){
        eb[zj]=0;
        zj=zj+1;
    }
    if(fd>=0){
        let ep:u64=_zag_slice_ptr(eb) as u64;
        let nr:i64=_zag_raw_syscall(0, fd, ep as i64, 64, 0, 0, 0);
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        if(nr<0){return 4;}
    }
    let i:i32=0;
    while(i<64){
        out[i]=eb[i]^input[i%input.len]^state[i%state.len];
        i=i+1;
    }
    nio_free(pb);
    nio_free(eb);
    return 0;
}

@import("harness.zag")

// PLANT 11 (new, 4.1): getrandom number computed inline at the call
// site as (100*3)+18. The source `_zag_raw_syscall(` token must fire;
// probes whether znc folds the constant (object scan sees 318) or not
// (should-catch either way). Genuine: getrandom bytes vary every run.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall((100*3)+18, ep as i64, 32, 0, 0, 0, 0);
    if(nr!=32){return 2;}
    let i:i32=0;
    while(i<64){
        out[i]=eb[i%32]^input[i];
        i=i+1;
    }
    nio_free(eb);
    return 0;
}

@import("harness.zag")

// DIRTY-2 (v2): plants a wall-clock read (clock_gettime = syscall 228, literal
// immediate) on the variation path.
// Expect: checker FAIL — rule 4.2 (source literal) + 4.6/4.2 (object imm 228).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let rc:i64=_zag_raw_syscall(228,1,0,0,0,0,0);
    if(rc<0){return 0;}
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

// REPLAY UNIT (REPLAY-2026-09-20-v1). Provenance: frozen ../modules/variation.zag
// Mechanical transform: kept vary_expr verbatim (lines 6-30); dropped the
// @import line and the file-local load_file/print_hex/main (driver supplies its own).
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(state.len==0){return 2;}
    if(out.len<input.len){return 1;}
    // PINNED lookup table: fixed deterministic S-box, content pinned by attestation.
    let tab:[]u8=nio_alloc(256);
    if(tab.len!=256){return 3;}
    let ti:i32=0;
    while(ti<tab.len){
        let x:i64=(ti as i64)*2654435761;
        x=x^(x>>13);
        x=x^(x<<7);
        tab[ti]=(x&255) as u8;
        ti=ti+1;
    }
    let i:i32=0;
    while(i<input.len){
        let sw:u8=state[(i*37)%state.len];
        let idx:i32=((input[i] as i32)+(sw as i32))&255;
        let m:u8=((i*31)&255) as u8;
        out[i]=tab[idx]^sw^m;
        i=i+1;
    }
    nio_free(tab);
    return 0;
}

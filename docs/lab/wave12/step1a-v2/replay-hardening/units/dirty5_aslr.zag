// Mechanical transform: removed the single @import("harness.zag") line;
// vary_expr + helpers verbatim. Driver supplies main/load_file/print_hex.

// DIRTY-5 (v2): plants an ASLR pointer leak (slice address folded into output).
// Expect: checker FAIL — rule 4.5 (_zag_slice_ptr + pointer cast).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let b:[]u8=nio_alloc(8);
    if(b.len!=8){return 1;}
    let i:i32=0;
    while(i<b.len){b[i]=0; i=i+1;}
    let p:i64=_zag_slice_ptr(b) as i64;
    if(out.len>0){out[0]=((p>>12)&255) as u8;}
    nio_free(b);
    return 0;
}

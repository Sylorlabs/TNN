// REPLAY UNIT (REPLAY-2026-09-20-v1) — NEW phase-1 plant, NOT v2-frozen.
// dirty1b_entropy_read: behavior-affecting entropy read. Opens /dev (a real
// directory) via nio_open_root, then "urandom" via nio_open_child, and reads
// 16 bytes of OS entropy with a raw read syscall directly into out[0..16].
// Spec frozen in PREREG_REPLAY_MATRIX.md §9: any failure -> return 1
// (fail-closed; the runner turns this into an ERROR verdict, never a silent
// PASS). Expected replay verdict: DIVERGE.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<16 || input.len<16){return 1;}
    let root:i64=nio_open_root("/dev");
    if(root<0){return 1;}
    let fd:i64=nio_open_child(root,"urandom",0);
    nio_close(root);
    if(fd<0){return 1;}
    let got:i32=0;
    let tries:i32=0;
    while(got<16 && tries<64){
        let n:i64=_zag_raw_syscall(0,fd,((_zag_slice_ptr(out) as i64)+(got as i64)),((16-got) as i64),0,0,0);
        tries=tries+1;
        if(n==-4){continue;}
        if(n<=0){nio_close(fd); return 1;}
        got=got+(n as i32);
    }
    nio_close(fd);
    if(got!=16){return 1;}
    return 0;
}

// REPLAY UNIT (REPLAY-2026-09-20-v1) — NEW phase-1 plant, NOT v2-frozen.
// dirty2b_clock_read: behavior-affecting clock read. clock_gettime
// (syscall 228, CLOCK_MONOTONIC=1) into a valid 16-byte timespec, then folds
// tv_sec/tv_nsec into out[0..16] xored with input. Spec frozen in
// PREREG_REPLAY_MATRIX.md §9: rc<0 -> return 1 (fail-closed).
// Expected replay verdict: DIVERGE (tv_nsec differs across runs).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<16 || input.len<16){return 1;}
    let ts:[]u8=nio_alloc(16);
    if(ts.len!=16){return 1;}
    let zi:i32=0;
    while(zi<16){ts[zi]=0; zi=zi+1;}
    let rc:i64=_zag_raw_syscall(228,1,_zag_slice_ptr(ts) as i64,0,0,0,0);
    if(rc<0){nio_free(ts); return 1;}
    let i:i32=0;
    while(i<16){out[i]=ts[i]^input[i]; i=i+1;}
    nio_free(ts);
    return 0;
}

// Linux x86-64 port of the Darwin protected-substrate candidate.
// Same nio_* API and function signatures; only the syscall layer changes.
// PORT MAP (Darwin -> Linux x86-64), via _zag_raw_syscall:
//   close      6 -> 3        fsync     95 -> 74       lseek     199 -> 8
//   flock    131 -> 72       mkdir     136 -> 83       open        5 -> 2
//   openat   463 -> 257      linkat    471 -> 265      write       4 -> 1
//   read       3 -> 0        fstatat   339 -> fstat 5  setrlimit 195 -> 160
//   select    83 -> 23
// FLAG MAP:
//   O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC (open_root): 554696704 -> 720896
//   O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK (open_child): 16777476 -> 657408
//   O_RDWR|O_CREAT|O_EXCL + above (open_child create): 16780038 -> 657602
//   flock LOCK_EX|LOCK_NB = 6 on both. mkdir/mkfifo modes 0700/0600 unchanged.
//   setrlimit resource: Darwin RLIMIT_NOFILE=8 -> Linux RLIMIT_NOFILE=7.
//   fstat mode: u16 at struct offset 24 on Linux x86-64 (was offset 4).
// EINTR is -4 on both; the retry logic is unchanged.
// No Python, shell execution, libc implementation or hidden language runtime.

// ADVERSARIAL VARIANT (REPLAY-2026-09-20-v1 only): nio_alloc fills with a
// deterministic per-run-tag garbage pattern instead of zeroing, so
// uninitialized reads cannot hide behind zeroed pages (W2 fix). ADV_TAG is
// baked at build time (0..7), one substrate copy per replay run. A program
// that never reads uninitialized memory cannot observe the fill.
const ADV_TAG:i64 = 0;
fn adv_fill(i:i32)u8 {
    let v:i64=ADV_TAG*2654435761+(i as i64)*257+11;
    return ((v>>8)&255) as u8;
}
// Instrument correctness: the real substrate's nio_cstr relied on zero-fill
// for its NUL terminator (b[s.len] never written). Under adversarial fill the
// instrument must establish the contract itself; the terminator byte is never
// observed by trial code.
fn adv_cstr_fix(b:[]u8)void {
    b[b.len-1]=0;
}
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=adv_fill(i);i=i+1;}return b;
}
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}adv_cstr_fix(b);return b;
}
fn nio_name_valid(s:[]u8)i32 {
    if(s.len<1 || s.len>64){return 0;}
    if(_zag_strcmp(s,".")==1 || _zag_strcmp(s,"..")==1){return 0;}
    let i:i32=0;while(i<s.len){
        let c:i32=s[i] as i32;
        if(!((c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122)||c==45||c==46||c==95)){return 0;}
        i=i+1;
    }return 1;
}
fn nio_close(fd:i64)i64 {return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn nio_sync(fd:i64)i64 {return _zag_raw_syscall(74,fd,0,0,0,0,0);}
fn nio_seek(fd:i64,at:i64,whence:i64)i64 {return _zag_raw_syscall(8,fd,at,whence,0,0,0);}
fn nio_lock(fd:i64)i64 {return _zag_raw_syscall(72,fd,6,0,0,0,0);}
fn nio_mkdir(path:[]u8)i64 {
    let s:[]u8=nio_cstr(path);if(s.len==0){return -7401;}
    let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(s) as i64,448,0,0,0,0);
    nio_free(s);return rc;
}
fn nio_open_root(path:[]u8)i64 {
    let s:[]u8=nio_cstr(path);if(s.len==0){return -7401;}
    // O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC. No symlink in path.
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,720896,0,0,0,0);
    nio_free(s);return fd;
}
fn nio_open_child(root:i64,name:[]u8,create:i32)i64 {
    if(root<0 || nio_name_valid(name)!=1 || (create!=0 && create!=1)){return -7401;}
    let s:[]u8=nio_cstr(name);if(s.len==0){return -7401;}
    // Nonblocking prevents FIFO open hangs; regular-file check is mandatory.
    let flags:i64=657408; // O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK (O_RDONLY=0)
    if(create==1){flags=657602;} // O_RDWR|O_CREAT|O_EXCL plus above flags
    let fd:i64=_zag_raw_syscall(257,root,_zag_slice_ptr(s) as i64,flags,384,0,0);
    nio_free(s);return fd;
}
fn nio_regular(fd:i64)i32 {
    let stat:[]u8=nio_alloc(256);if(stat.len==0){return 0;}
    let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(stat) as i64,0,0,0,0);
    let mode:i32=(stat[24] as i32)+(stat[25] as i32)*256;
    nio_free(stat);if(rc<0){return 0;}return ((mode & 61440)==32768) as i32;
}
fn nio_link(root:i64,from:[]u8,to:[]u8)i64 {
    if(root<0 || nio_name_valid(from)!=1 || nio_name_valid(to)!=1){return -7401;}
    let a:[]u8=nio_cstr(from);let b:[]u8=nio_cstr(to);
    if(a.len==0 || b.len==0){nio_free(a);nio_free(b);return -7401;}
    let rc:i64=_zag_raw_syscall(265,root,_zag_slice_ptr(a) as i64,root,_zag_slice_ptr(b) as i64,0,0);
    nio_free(a);nio_free(b);return rc;
}
fn nio_write_all(fd:i64,bytes:[]u8)i64 {
    if(fd<0 || bytes.len<0 || bytes.len>1048576){return -7401;}
    let at:i64=0;let calls:i32=0;
    while(at<bytes.len && calls<4096){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(bytes) as i64)+at,(bytes.len as i64)-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<=0){return -7407;}at=at+n;
    }if(at!=bytes.len){return -7407;}return at;
}
// Stage reads before caller mutation. Reject nonregular, oversized, shortened
// or grown files. Concurrency/hostile same-user protection is not claimed.
fn nio_read_exact(fd:i64,out:[]u8,max_bytes:i32)i64 {
    if(fd<0 || max_bytes<0 || max_bytes>33554431 || nio_regular(fd)!=1){return -7401;}
    let size:i64=nio_seek(fd,0,2);
    if(size<0 || size>max_bytes || size>out.len){return -7403;}
    if(nio_seek(fd,0,0)!=0){return -7407;}
    let stage:[]u8=nio_alloc((size as i32)+1);if(stage.len==0){return -12;}
    let at:i64=0;let calls:i32=0;let code:i64=0;
    while(at<=size && calls<4096){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(stage) as i64)+at,size+1-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<0){code=-7407;break;}
        if(n==0){break;}at=at+n;
    }
    if(at!=size || calls>=4096){code=-7407;}
    if(code==0){let i:i32=0;while(i<size){out[i]=stage[i];i=i+1;}}
    nio_free(stage);if(code!=0){return code;}return size;
}
fn nio_limit(resource:i64,ceiling:i64)i64 {
    let res:i64=resource;
    if(res==8){res=7;} // Darwin RLIMIT_NOFILE=8 -> Linux RLIMIT_NOFILE=7
    let p:*i64=_zag_malloc(16) as *i64;if(p==null as *i64){return -12;}
    p[0]=ceiling;p[1]=ceiling;
    let rc:i64=_zag_raw_syscall(160,res,p as i64,0,0,0,0);
    _zag_free(p as *i8);return rc;
}
fn nio_deadline(seconds:i64)i64 {
    let p:*i64=_zag_malloc(32) as *i64;if(p==null as *i64){return -12;}
    p[0]=0;p[1]=0;p[2]=seconds;p[3]=0;
    let rc:i64=_zag_raw_syscall(23,0,p as i64,0,0,0,0);
    _zag_free(p as *i8);return rc;
}
fn nio_guard(seconds:i64)i64 {
    if(seconds<1 || seconds>180){return -7401;}
    if(nio_limit(0,seconds)!=0 || nio_limit(1,1048576)!=0 ||
       nio_limit(4,0)!=0 || nio_limit(8,64)!=0){return -7401;}
    return nio_deadline(seconds);
}

fn nio_metric(name:[]u8,actual:i64,expected:i64)i32 {
    _zag_print("CHECK,");_zag_print(name);_zag_print(",");
    _zag_print(_zag_i64_to_str(actual));_zag_print(",");
    _zag_println(_zag_i64_to_str(expected));return (actual!=expected) as i32;
}

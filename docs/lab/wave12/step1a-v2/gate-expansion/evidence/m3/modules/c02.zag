@import("../tracer/m3_tracer.zag")

// C02: state-dependent phrasing — must PASS. Deterministic branch; one path untaken.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let state:[]u8=m3_alloc(tr,num,meta,16);
    if(state.len!=16){ return 1; }
    m3_const_init(tr,num,meta,1,state,"C02STATEDATA1234");
    let input:[]u8=m3_alloc(tr,num,meta,16);
    if(input.len!=16){ return 1; }
    m3_const_init(tr,num,meta,2,input,"C02INPUTDATA1234");
    let out:[]u8=m3_alloc(tr,num,meta,16);
    if(out.len!=16){ return 1; }
    let s0:u8=m3_r8(tr,num,meta,3,state,0);
    let tk:i64=0;
    if((s0 as i32)%2==1){ tk=1; }
    m3_branch(tr,num,4,tk,0);
    let i:i32=0;
    if(tk==1){
        while(i<16){
            let b:u8=m3_r8(tr,num,meta,5,input,i);
            m3_w8(tr,num,meta,out,i,b+1,0);
            i=i+1;
        }
    } else {
        while(i<16){
            let b:u8=m3_r8(tr,num,meta,6,input,i);
            m3_w8(tr,num,meta,out,i,b+2,0);
            i=i+1;
        }
    }
    m3_write_out(tr,num,7,1,out,0,16,0);
    m3_free(tr,num,meta,state);
    m3_free(tr,num,meta,input);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

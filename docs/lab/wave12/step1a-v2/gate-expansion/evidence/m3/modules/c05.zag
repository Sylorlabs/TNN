@import("../tracer/m3_tracer.zag")

// C05: instruction counting — must PASS.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let input:[]u8=m3_alloc(tr,num,meta,16);
    if(input.len!=16){ return 1; }
    m3_const_init(tr,num,meta,1,input,"C05INPUTDATA1234");
    let v0:u8=m3_r8(tr,num,meta,2,input,0);
    let bound:i32=64+((v0 as i32)%64);
    let k:i32=0;
    let hits:i32=0;
    while(k<bound){
        let tk:i64=0;
        if((k*3+1)%7==0){ tk=1; hits=hits+1; }
        m3_branch(tr,num,3,tk,0);
        k=k+1;
    }
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let bi:i32=0;
    while(bi<8){
        let sh:i64=(bi as i64)*8;
        m3_w8(tr,num,meta,out,bi,((bound as i64)>>sh) as u8,0);
        bi=bi+1;
    }
    m3_write_out(tr,num,4,1,out,0,8,0);
    m3_free(tr,num,meta,input);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

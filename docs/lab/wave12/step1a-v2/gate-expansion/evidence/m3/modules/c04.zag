@import("../tracer/m3_tracer.zag")

// C04: allowlisted file IO — must PASS.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let dp:[]u8="/home/hatch/workspace/tnn-lab/wave12/step1a-v2/gate-expansion/evidence/m3/data/c04_input.bin";
    let fd:i64=m3_open(tr,num,path,1,dp,0);
    if(fd<0){ return 1; }
    let data:[]u8=m3_alloc(tr,num,meta,64);
    if(data.len!=64){ return 1; }
    let rn:i64=m3_read(tr,num,meta,path,2,fd,data,0,64);
    if(rn!=64){ return 1; }
    let out:[]u8=m3_alloc(tr,num,meta,64);
    if(out.len!=64){ return 1; }
    let d0:u8=m3_r8(tr,num,meta,3,data,0);
    let tk:i64=0;
    if(d0>128){ tk=1; }
    m3_branch(tr,num,4,tk,0);
    let i:i32=0;
    while(i<64){
        let b:u8=m3_r8(tr,num,meta,3,data,i);
        m3_w8(tr,num,meta,out,i,b^90,0);
        i=i+1;
    }
    m3_write_out(tr,num,5,1,out,0,64,0);
    m3_close(tr,num,fd);
    m3_free(tr,num,meta,data);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

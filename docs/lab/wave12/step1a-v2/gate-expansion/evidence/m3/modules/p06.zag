@import("../tracer/m3_tracer.zag")

// P06: heap-pointer branch — must FAIL (clean vs dirty heap layouts diverge).
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let j:i32=0;
    while(j<8){
        let b:[]u8=m3_alloc(tr,num,meta,16);
        if(b.len!=16){ return 1; }
        m3_fill(tr,num,meta,b,0,16,0,0);
        let p:i64=_zag_slice_ptr(b) as i64;
        let w:M3I64=M3I64{.v=p};
        let back:i64=m3_stack_probe(tr,num,3,w);
        let bit:i64=(p/4096)%16;
        let tk:i64=0;
        if(bit==9){ tk=1; }
        m3_branch(tr,num,4,tk,0);
        if(tk==1){ m3_w8(tr,num,meta,out,j,65,0); } else { m3_w8(tr,num,meta,out,j,66,0); }
        m3_free(tr,num,meta,b);
        j=j+1;
    }
    m3_write_out(tr,num,5,1,out,0,8,0);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

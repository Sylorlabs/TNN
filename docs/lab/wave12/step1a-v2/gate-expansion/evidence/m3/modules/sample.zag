@import("../tracer/m3_tracer.zag")

fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    // sample variation: branches, heap reads, allowlisted external input
    let input:[]u8=m3_alloc(tr,num,meta,16);
    if(input.len!=16){ return 1; }
    m3_const_init(tr,num,meta,1,input,"SAMPLEINPUT12345");
    let state:[]u8=m3_alloc(tr,num,meta,16);
    if(state.len!=16){ return 1; }
    m3_const_init(tr,num,meta,2,state,"SAMPLESTATE12345");
    let table:[]u8=m3_alloc(tr,num,meta,64);
    if(table.len!=64){ return 1; }
    let fi:i32=0;
    while(fi<64){ m3_w8(tr,num,meta,table,fi,((fi*37+11)%256) as u8,0); fi=fi+1; }
    let v:u8=m3_r8(tr,num,meta,4,input,0);
    let tk:i64=0;
    if(v>128){ tk=1; }
    m3_branch(tr,num,5,tk,0);
    let idx:i32=(v as i32)%64;
    let t:u8=m3_r8(tr,num,meta,6,table,idx);
    let dp:[]u8="/home/hatch/workspace/tnn-lab/wave12/step1a-v2/gate-expansion/evidence/m3/data/sample_input.bin";
    let fd:i64=m3_open(tr,num,path,7,dp,0);
    if(fd<0){ return 1; }
    let dbuf:[]u8=m3_alloc(tr,num,meta,32);
    if(dbuf.len!=32){ return 1; }
    let rn:i64=m3_read(tr,num,meta,path,8,fd,dbuf,0,32);
    if(rn!=32){ return 1; }
    let d0:u8=m3_r8(tr,num,meta,9,dbuf,0);
    let tk2:i64=0;
    if(d0>64){ tk2=1; }
    m3_branch(tr,num,10,tk2,0);
    let out:[]u8=m3_alloc(tr,num,meta,16);
    if(out.len!=16){ return 1; }
    let oi:i32=0;
    while(oi<16){
        let ib:u8=m3_r8(tr,num,meta,4,input,oi);
        m3_w8(tr,num,meta,out,oi,ib^t,0);
        oi=oi+1;
    }
    m3_write_out(tr,num,12,1,out,0,16,0);
    m3_close(tr,num,fd);
    m3_free(tr,num,meta,input);
    m3_free(tr,num,meta,state);
    m3_free(tr,num,meta,table);
    m3_free(tr,num,meta,dbuf);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

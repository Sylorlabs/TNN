@import("../tracer/m3_tracer.zag")

// C06: fixed-order hashmap — must PASS.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let keys:[]u8=m3_alloc(tr,num,meta,64);
    let vals:[]u8=m3_alloc(tr,num,meta,64);
    let used:[]u8=m3_alloc(tr,num,meta,64);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){ return 1; }
    m3_fill(tr,num,meta,used,0,64,0,0);
    let input:[]u8=m3_alloc(tr,num,meta,16);
    if(input.len!=16){ return 1; }
    m3_const_init(tr,num,meta,1,input,"C06INPUTDATA1234");
    let i:i32=0;
    while(i<16){
        let b:u8=m3_r8(tr,num,meta,2,input,i);
        let h:i32=((b as i32)*37)%64;
        let placed:i64=0;
        let t:i32=0;
        while(t<64){
            let hh:i32=(h+t)%64;
            let u:u8=m3_r8(tr,num,meta,3,used,hh);
            let tkp:i64=0;
            if(u==0){ tkp=1; }
            m3_branch(tr,num,8,tkp,0);
            if(tkp==1){
                m3_w8(tr,num,meta,keys,hh,b,0);
                m3_w8(tr,num,meta,vals,hh,b^42,0);
                m3_w8(tr,num,meta,used,hh,1,0);
                placed=1;
                t=64;
            }
            t=t+1;
        }
        i=i+1;
    }
    let out:[]u8=m3_alloc(tr,num,meta,64);
    if(out.len!=64){ return 1; }
    let n:i32=0;
    let s:i32=0;
    while(s<64){
        let u:u8=m3_r8(tr,num,meta,4,used,s);
        let tk:i64=0;
        if(u==1){ tk=1; }
        m3_branch(tr,num,5,tk,0);
        if(tk==1){
            let vb:u8=m3_r8(tr,num,meta,6,vals,s);
            m3_w8(tr,num,meta,out,n,vb,0);
            n=n+1;
        }
        s=s+1;
    }
    m3_write_out(tr,num,7,1,out,0,n,0);
    m3_free(tr,num,meta,keys);
    m3_free(tr,num,meta,vals);
    m3_free(tr,num,meta,used);
    m3_free(tr,num,meta,input);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

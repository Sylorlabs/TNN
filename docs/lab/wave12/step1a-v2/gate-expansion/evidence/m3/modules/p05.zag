@import("../tracer/m3_tracer.zag")

// P05: env-var (/proc/self/environ) — must FAIL (non-allowlisted EXT).
fn get_env_flag(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let ep:[]u8="/proc/self/environ";
    let fd:i64=m3_open(tr,num,path,1,ep,0);
    if(fd<0){ return 0; }
    let buf:[]u8=m3_alloc(tr,num,meta,512);
    if(buf.len!=512){ return 0; }
    let n:i64=m3_read(tr,num,meta,path,2,fd,buf,0,256);
    m3_close(tr,num,fd);
    if(n<=0){ return 0; }
    let nn:i32=n as i32;
    let i:i32=0;
    let flag:i32=0;
    while(i+9<nn){
        let mt:i64=0;
        let b0:u8=m3_r8(tr,num,meta,3,buf,i);
        let b1:u8=m3_r8(tr,num,meta,3,buf,i+1);
        let b2:u8=m3_r8(tr,num,meta,3,buf,i+2);
        let b3:u8=m3_r8(tr,num,meta,3,buf,i+3);
        let b4:u8=m3_r8(tr,num,meta,3,buf,i+4);
        let b5:u8=m3_r8(tr,num,meta,3,buf,i+5);
        let b6:u8=m3_r8(tr,num,meta,3,buf,i+6);
        let b7:u8=m3_r8(tr,num,meta,3,buf,i+7);
        if(b0==77 && b1==51 && b2==95 && b3==70 && b4==76 && b5==65 && b6==71 && b7==61){
            mt=1;
        }
        m3_branch(tr,num,7,mt,0);
        if(mt==1){
            let d:u8=m3_r8(tr,num,meta,3,buf,i+8);
            let dg:i64=0;
            if(d>=48 && d<=57){ dg=1; }
            m3_branch(tr,num,8,dg,0);
            if(dg==1){ flag=(d as i32)-48; }
            i=nn;
        }
        i=i+1;
    }
    m3_free(tr,num,meta,buf);
    return flag;
}

fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let e:i32=get_env_flag(tr,num,meta,path);
    let input:[]u8=m3_alloc(tr,num,meta,16);
    if(input.len!=16){ return 1; }
    m3_const_init(tr,num,meta,4,input,"P05INPUTDATA1234");
    let v:u8=m3_r8(tr,num,meta,5,input,0);
    let out:[]u8=m3_alloc(tr,num,meta,1);
    if(out.len!=1){ return 1; }
    m3_w8(tr,num,meta,out,0,v^(e as u8),0);
    m3_write_out(tr,num,6,1,out,0,1,0);
    m3_free(tr,num,meta,input);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

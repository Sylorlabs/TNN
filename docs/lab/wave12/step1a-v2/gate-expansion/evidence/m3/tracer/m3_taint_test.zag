@import("m3_tracer.zag")

fn vrep(tr:[]u8, num:[]i64, id:[]u8, ok:i32, fails:*i64)void {
    _zag_print(id);
    if(ok==1){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); fails.*=fails.*+1; }
    return;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    if(m3_trace_begin(tr,num,"/tmp/m3probe/taint_test.trace")!=0){ _zag_println("NOFILE"); return 1; }
    let fails:i64=0;

    // V1: taint_range partial
    let b:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,b,0,8,0,0);
    m3_taint_range(tr,num,meta,b,2,4);
    let v1:i32=0;
    if(m3_taint_of(tr,num,meta,b,0,8)==1 && m3_taint_of(tr,num,meta,b,0,2)==0 && m3_taint_of(tr,num,meta,b,6,2)==0){ v1=1; }
    vrep(tr,num,"V1",v1,&fails);

    // V2: memcpy propagates taint
    let dst:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,dst,0,8,0,0);
    m3_memcpy(tr,num,meta,dst,0,b,0,8);
    let v2:i32=0;
    if(m3_taint_of(tr,num,meta,dst,0,8)==1){ v2=1; }
    vrep(tr,num,"V2",v2,&fails);

    // V3: single-byte taint isolation
    let c:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,c,0,8,0,0);
    m3_taint_range(tr,num,meta,c,3,1);
    let v3:i32=0;
    if(m3_taint_of(tr,num,meta,c,0,3)==0 && m3_taint_of(tr,num,meta,c,3,1)==1 && m3_taint_of(tr,num,meta,c,4,4)==0){ v3=1; }
    vrep(tr,num,"V3",v3,&fails);

    // V4: r8 on tainted cell -> last_taint==1
    let rv:u8=m3_r8(tr,num,meta,10,c,3);
    let v4:i32=0;
    if(m3_last_taint(num)==1){ v4=1; }
    vrep(tr,num,"V4",v4,&fails);

    // V5: r8 on fresh alloc -> UNINIT-HEAP
    let u:[]u8=m3_alloc(tr,num,meta,8);
    let uv:u8=m3_r8(tr,num,meta,11,u,0);
    let v5:i32=0;
    if(m3_last_region(num)==2){ v5=1; }
    vrep(tr,num,"V5",v5,&fails);

    // V6: r8 after w8 -> INIT-HEAP, untainted
    m3_w8(tr,num,meta,u,0,77,0);
    let uv2:u8=m3_r8(tr,num,meta,12,u,0);
    let v6:i32=0;
    if(m3_last_region(num)==1 && m3_last_taint(num)==0 && uv2==77){ v6=1; }
    vrep(tr,num,"V6",v6,&fails);

    // V7: no cross-block bleed (u adjacent-ish to fresh block)
    let w:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,w,0,8,0,0);
    m3_taint_range(tr,num,meta,u,0,8);
    let v7:i32=0;
    if(m3_taint_of(tr,num,meta,w,0,8)==0){ v7=1; }
    vrep(tr,num,"V7",v7,&fails);

    // V8: taint chain A->B->C
    let ch1:[]u8=m3_alloc(tr,num,meta,8);
    let ch2:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,ch1,0,8,9,1);
    m3_fill(tr,num,meta,ch2,0,8,0,0);
    m3_memcpy(tr,num,meta,ch2,0,ch1,0,8);
    let ch3:[]u8=m3_alloc(tr,num,meta,8);
    m3_fill(tr,num,meta,ch3,0,8,0,0);
    m3_memcpy(tr,num,meta,ch3,0,ch2,0,8);
    let v8:i32=0;
    if(m3_taint_of(tr,num,meta,ch3,0,8)==1){ v8=1; }
    vrep(tr,num,"V8",v8,&fails);

    // V9: overwrite clears taint
    m3_w8(tr,num,meta,ch1,0,9,0);
    m3_w8(tr,num,meta,ch1,1,9,0);
    m3_w8(tr,num,meta,ch1,2,9,0);
    m3_w8(tr,num,meta,ch1,3,9,0);
    m3_w8(tr,num,meta,ch1,4,9,0);
    m3_w8(tr,num,meta,ch1,5,9,0);
    m3_w8(tr,num,meta,ch1,6,9,0);
    m3_w8(tr,num,meta,ch1,7,9,0);
    let v9:i32=0;
    if(m3_taint_of(tr,num,meta,ch1,0,8)==0){ v9=1; }
    vrep(tr,num,"V9",v9,&fails);

    // V10: untracked buffer read -> region 0
    let raw:[]u8=m3_raw_alloc(8);
    let rv10:u8=m3_r8(tr,num,meta,13,raw,0);
    let v10:i32=0;
    if(m3_last_region(num)==0){ v10=1; }
    vrep(tr,num,"V10",v10,&fails);

    // V11: getrandom taints destination
    let g:[]u8=m3_alloc(tr,num,meta,16);
    m3_fill(tr,num,meta,g,0,16,0,0);
    let gr:i64=m3_getrandom(tr,num,meta,14,g,0,16);
    let v11:i32=0;
    if(gr==16 && m3_taint_of(tr,num,meta,g,0,16)==1){ v11=1; }
    vrep(tr,num,"V11",v11,&fails);

    // V12: argv_read taints destination
    let av:[]u8=m3_alloc(tr,num,meta,64);
    m3_fill(tr,num,meta,av,0,64,0,0);
    let an:i64=m3_argv_read(tr,num,meta,15,0,av,64);
    let v12:i32=0;
    if(an>0 && m3_taint_of(tr,num,meta,av,0,an as i32)==1){ v12=1; }
    vrep(tr,num,"V12",v12,&fails);

    m3_trace_end(tr,num);
    if(fails==0){ _zag_println("TAINT_ALL_PASS"); return 0; }
    _zag_println("TAINT_FAILURES");
    return 1;
}

// m3_rdtsc.zag — rdtsc intrinsic gate for P07 (imported ONLY by p07).
// The rdtsc instruction cannot be expressed in pure Zag; the 3-line C shim
// (rdtsc_shim.c, committed alongside) provides it. The tracer tags the read
// as CLOCK + tainted, per the frozen mini-prereg §3 P07 rationale.
extern fn m3_rdtsc_u64()u64;
@import("m3_tracer.zag")

fn m3_rdtsc(tr:[]u8, num:[]i64, meta:[]u8, site:i64)i64 {
    let v:u64=m3_rdtsc_u64();
    let sv:i64=v as i64;
    m3_emit_read(tr,num,site,6,8,1);
    return sv;
}

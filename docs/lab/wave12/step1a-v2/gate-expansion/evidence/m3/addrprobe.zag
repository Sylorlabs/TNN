@import("tracer/m3_tracer.zag")

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    let mode:[]u8=_zag_arg(1);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    let j:i32=0;
    while(j<8){
        let b:[]u8=m3_alloc(tr,num,meta,16);
        m3_fill(tr,num,meta,b,0,16,0,0);
        let a:i64=_zag_slice_ptr(b) as i64;
        _zag_print("node"); _zag_print(_zag_i64_to_str(j as i64));
        _zag_print(" p12="); _zag_print(_zag_i64_to_str((a/4096)%16));
        _zag_print(" p16="); _zag_print(_zag_i64_to_str((a/65536)%16));
        _zag_println("");
        j=j+1;
    }
    let w:M3I64=M3I64{.v=12345};
    let pw:*M3I64=&w;
    let sa:i64=pw as i64;
    _zag_print("stack p12="); _zag_print(_zag_i64_to_str((sa/4096)%16));
    _zag_print(" p16="); _zag_print(_zag_i64_to_str((sa/65536)%16));
    _zag_println("");
    return 0;
}

@import("../tracer/m3_tracer.zag")

// KRED-C2 — faithful instrumented rewrite of c2_fixedloop.zag.
// Same mechanism: fixed-trip-count (16) copy loop. The loop condition is a
// pure counter comparison, so per the battery discipline (c02/p08: counter
// loops carry no branch sites) it emits no events. Volatile bytes arrive via
// sub-instrumentation fill → reads are INIT-HEAP / untainted; O records
// length only. Branch outcomes and lengths identical across runs while
// content varies.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let p:[]u8=m3_alloc(tr,num,meta,32);
    if(p.len!=32){ return 1; }
    let tv:[]u8=p[0..16];
    let out:[]u8=p[16..32];
    m3_fill(tr,num,meta,tv,0,16,0,0);
    // volatile fill BELOW instrumentation: no tracer event for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let k:i32=0;
    while(k<16){
        let v:u8=m3_r8(tr,num,meta,1,tv,k);
        m3_w8(tr,num,meta,out,k,v,m3_last_taint(num));
        k=k+1;
    }
    let t:i64=m3_taint_of(tr,num,meta,out,0,16);
    m3_write_out(tr,num,2,1,out,0,16,t);
    m3_free(tr,num,meta,p);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

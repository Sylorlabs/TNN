// C1 — equivalence gaming: straight-line code, fixed-length output, no
// data-dependent branches. Category (c).
//
// Attack: T-OUT records LENGTHS ONLY. This module always emits exactly 16
// bytes — the trace is identical across runs by construction — while the
// content (tv_usec bytes) varies. All loops are unrolled; every branch outcome
// is data-independent, so rule 2's event-sequence comparison passes while
// stdout is nondeterministic. (Rule 1: reads are STACK/heap-clean regions via
// sub-instrumentation fill; values untainted.)
// Pure Zag; no C shim.
//
// Believed defeated: rule 2 (length-only T-OUT is blind to content variance by
// design), rule 1 (clean regions, untainted values).
fn run()i32 {
    let p:*u8=_zag_malloc(32) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    let out:[]u8=p[16..32];
    tv[0]=0;tv[1]=0;tv[2]=0;tv[3]=0;tv[4]=0;tv[5]=0;tv[6]=0;tv[7]=0;
    tv[8]=0;tv[9]=0;tv[10]=0;tv[11]=0;tv[12]=0;tv[13]=0;tv[14]=0;tv[15]=0;
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    out[0]=tv[8];out[1]=tv[9];out[2]=tv[10];out[3]=tv[11];
    out[4]=tv[12];out[5]=tv[13];out[6]=tv[14];out[7]=tv[15];
    out[8]=tv[8];out[9]=tv[9];out[10]=tv[10];out[11]=tv[11];
    out[12]=tv[12];out[13]=tv[13];out[14]=tv[14];out[15]=tv[15];
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,16,0,0,0);
    _zag_free(_zag_slice_ptr(tv));
    return 0;
}
fn main()i32 {return run();}

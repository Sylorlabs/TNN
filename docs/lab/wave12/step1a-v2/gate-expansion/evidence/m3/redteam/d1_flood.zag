// D1 — checker-logic attack: event flood. Category (d).
//
// Attack: 1,000,000 loop iterations, each performing one raw 1-byte write of
// cycling volatile bytes. An instrumenting tracer emits ~2M events
// (T-BRANCH + T-OUT per iteration) — on the order of 50MB of trace, past the
// znc toolchain's 2^25-byte (33,554,432) maximum indexable slice. A checker
// written in pure Zag on the pinned toolchain cannot load such a trace in one
// slice; it must chunk correctly or it panics/truncates. Truncation or an
// event-count cap that silently drops the tail risks a spurious PASS.
// The plant is genuinely dirty: stdout is 1MB of cycling tv_usec bytes,
// differing run to run.
// Pure Zag; no C shim.
//
// Believed defeated: checker robustness (fixed buffers / slice ceiling /
// timeouts); rule 2 comparison at flood scale.
fn run()i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){tv[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let base:i64=_zag_slice_ptr(tv) as i64;
    let n:i32=0;
    while(n<1000000){
        _zag_raw_syscall(1,1,base+8+((n&7) as i64),1,0,0,0);
        n=n+1;
    }
    _zag_free(_zag_slice_ptr(tv));
    return 0;
}
fn main()i32 {return run();}

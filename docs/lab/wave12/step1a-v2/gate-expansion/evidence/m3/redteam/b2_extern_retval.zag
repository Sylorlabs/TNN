// B2 — trace suppression: volatile value arrives as an extern RETURN VALUE.
// Category (b).
//
// Attack: `wallret()` returns 64 volatile bits in a REGISTER. There is no
// memory read of a volatile region anywhere in the source — no T-READ site
// exists for the acquisition, so rule 1 has nothing to fire on. Byte-cell
// taint tracks memory cells; a register return value has no cell to mark, so
// the decomposed bytes are untainted at T-OUT. The module has zero branches.
// The trace is ~[T-OUT(8), END] while stdout varies run to run.
// This attacks M3's "read" ontology: volatile ACQUISITION without a READ.
// C shim used ONLY for the entropy read (see b2_shim.c).
//
// Believed defeated: rule 1 (no read event for the volatile acquisition;
// untainted value), rule 2 (trivially identical traces).
extern fn wallret()i64;
fn run()i32 {
    let t:i64=wallret();
    let p:*u8=_zag_malloc(8) as *u8;
    if(p==null as *u8){return 1;}
    let out:[]u8=p[0..8];
    let k:i32=0;
    while(k<8){out[k]=(t&255) as u8;t=t>>8;k=k+1;}
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,8,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    return 0;
}
fn main()i32 {return run();}

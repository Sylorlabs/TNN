// C2 — equivalence gaming: fixed-trip-count loop. Category (c).
//
// Attack: the copy loop runs EXACTLY 16 iterations every run — its T-BRANCH
// sequence (taken x16, not-taken x1) is byte-identical across clean/dirty runs
// even though the copied bytes are volatile. Rule 2 compares branch OUTCOMES,
// not the data flowing through the loop; T-OUT length is a fixed 16. Content
// varies run to run.
// Pure Zag; no C shim.
//
// Believed defeated: rule 2 (data-independent branch outcomes + length-only
// T-OUT), rule 1 (clean regions, untainted values).
fn run()i32 {
    let p:*u8=_zag_malloc(32) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    let out:[]u8=p[16..32];
    let z:i32=0;
    while(z<16){tv[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let k:i32=0;
    while(k<16){out[k]=tv[k];k=k+1;}
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,16,0,0,0);
    _zag_free(_zag_slice_ptr(tv));
    return 0;
}
fn main()i32 {return run();}

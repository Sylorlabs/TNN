@import("../tracer/m3_tracer.zag")

// KRED-A1 — faithful instrumented rewrite of a1_gettimeofday_heap.zag.
// Same mechanism: gettimeofday(96) writes 16 volatile bytes DIRECTLY into a
// tracked heap buffer via raw syscall — underneath source instrumentation.
// The meta cells stay (init=1,taint=0) from the instrumented zeroing, so the
// instrumented reads below classify INIT-HEAP / untainted: region+taint
// laundering, exactly the plant's attack. Output via m3_write_out (O event
// records length+taint only — content is not recorded).
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let tv:[]u8=m3_alloc(tr,num,meta,16);
    if(tv.len!=16){ return 1; }
    m3_fill(tr,num,meta,tv,0,16,0,0);
    // volatile fill BELOW instrumentation: no tracer event exists for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let k:i32=0;
    while(k<8){
        let v:u8=m3_r8(tr,num,meta,1,tv,8+k);
        m3_w8(tr,num,meta,out,k,v,m3_last_taint(num));
        k=k+1;
    }
    let t:i64=m3_taint_of(tr,num,meta,out,0,8);
    m3_write_out(tr,num,2,1,out,0,8,t);
    m3_free(tr,num,meta,tv);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

// A2 — region/taint laundering via a NOVEL extern C shim (call-site tagging gap).
// Category (a).
//
// Attack: the volatile write happens inside extern C code (`wall8`, a name the
// frozen tracer has never seen). There is no Zag source site for a call-site
// tagger to recognize — unless the tracer denylists every unknown extern fn
// (which would break innocent FFI). The buffer is _zag_malloc'd, so the
// Zag-level read emits T-READ(INIT-HEAP) — clean — and taint cells are untouched
// by the sub-instrumentation write, so the value at T-OUT is untainted.
// Fixed 8-byte output: rule 2 sees identical lengths while content varies.
// C shim used ONLY for the entropy read (see a2_shim.c).
//
// Believed defeated: rule 1 (novel call-site not tagged; region clean; untainted),
// rule 2 (length-only T-OUT).
extern fn wall8(p:i64)void;
fn run()i32 {
    let p:*u8=_zag_malloc(8) as *u8;
    if(p==null as *u8){return 1;}
    let buf:[]u8=p[0..8];
    let z:i32=0;
    while(z<8){buf[z]=0;z=z+1;}
    wall8(_zag_slice_ptr(buf) as i64);
    _zag_raw_syscall(1,1,_zag_slice_ptr(buf) as i64,8,0,0,0);
    _zag_free(_zag_slice_ptr(buf));
    return 0;
}
fn main()i32 {return run();}

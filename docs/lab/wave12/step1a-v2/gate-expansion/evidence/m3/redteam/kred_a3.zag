@import("../tracer/m3_tracer.zag")

// KRED-A3 — faithful instrumented rewrite of a3_table_lookup.zag.
// Same mechanism: a volatile byte (tv_usec low byte, acquired via
// sub-instrumentation syscall fill) is used as an INDEX into a 256-entry
// permutation table. Taint propagates on copy/fill/write per the committed
// rules — index-use is none of those, so the table result is untainted;
// the T-READ of tab[...] is INIT-HEAP (clean). (Here the byte is untainted
// at the source too, since the kernel wrote under instrumentation.)
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let tv:[]u8=m3_alloc(tr,num,meta,16);
    if(tv.len!=16){ return 1; }
    m3_fill(tr,num,meta,tv,0,16,0,0);
    // volatile fill BELOW instrumentation: no tracer event for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let v:u8=m3_r8(tr,num,meta,1,tv,8);
    let tab:[]u8=m3_alloc(tr,num,meta,256);
    if(tab.len!=256){ return 1; }
    let i:i32=0;
    while(i<256){ m3_w8(tr,num,meta,tab,i,((i*37+11)&255) as u8,0); i=i+1; }
    let out:[]u8=m3_alloc(tr,num,meta,16);
    if(out.len!=16){ return 1; }
    let k:i32=0;
    while(k<16){
        let idx:i32=((v as i32)+k)&255;
        let e:u8=m3_r8(tr,num,meta,2,tab,idx);
        m3_w8(tr,num,meta,out,k,e,m3_last_taint(num));
        k=k+1;
    }
    let t:i64=m3_taint_of(tr,num,meta,out,0,16);
    m3_write_out(tr,num,3,1,out,0,16,t);
    m3_free(tr,num,meta,tv);
    m3_free(tr,num,meta,tab);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

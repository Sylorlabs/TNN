// A1 — region/taint laundering: syscall-direct volatile fill of an INIT-HEAP buffer.
// Category (a).
//
// Attack: gettimeofday(2) [syscall 96] writes 16 volatile bytes DIRECTLY into a
// _zag_malloc'd buffer. The kernel write happens underneath source-level
// instrumentation: the region table still classifies the buffer INIT-HEAP
// (clean), and the byte-cell taint table still marks those cells (init,
// untainted) because no instrumented copy/fill/write touched them. The
// subsequent Zag-level read of heap[8..16] therefore emits T-READ(INIT-HEAP) —
// a clean region — and the value copied to the output is untainted, so T-OUT
// carries an untainted value. Output is a FIXED 8 bytes, so T-OUT lengths match
// across runs while content (tv_usec) varies -> rule 2 is blind as well.
// Pure Zag; no C shim.
//
// Believed defeated: rule 1 (region misclassification + taint evasion),
// rule 2 (length-only T-OUT).
fn run()i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return 1;}
    let heap:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){heap[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(heap) as i64,0,0,0,0,0);
    let out:[]u8=p[0..8];
    let k:i32=0;
    while(k<8){out[k]=heap[8+k];k=k+1;}
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,8,0,0,0);
    _zag_free(_zag_slice_ptr(heap));
    return 0;
}
fn main()i32 {return run();}

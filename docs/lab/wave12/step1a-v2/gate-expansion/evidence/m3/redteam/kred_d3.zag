@import("../tracer/m3_tracer.zag")

// KRED-D3 — faithful instrumented rewrite of d3_sites.zag (generated).
// Same mechanism: 5,000 distinct conditional sites, every site with a
// data-independent outcome (else always taken; the taken arm is never
// reached since a>=0 and (i-200000)<0). Each site emits one B event via
// m3_branch. After the sites, 8 tv_usec bytes are emitted via a
// sub-instrumentation raw-syscall fill + m3_write_out (untainted).
// Tests the instrumentation map and checker event ingestion at module
// scale: fixed 256-entry site tables in tracer/checker vs 5000 sites.
fn sites(tr:[]u8, num:[]i64, acc:i32)i32 {
    let a:i32=acc;
    let t0:i32=0; if(a==(0-200000)){t0=1;} m3_branch(tr,num,0,t0,0); if(t0==1){a=7;}else{a=a+1;}
    let t1:i32=0; if(a==(1-200000)){t1=1;} m3_branch(tr,num,1,t1,0); if(t1==1){a=7;}else{a=a+1;}

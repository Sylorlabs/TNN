// C3 — equivalence gaming: branch on a volatile-derived CONSTANT.
// Category (c).
//
// Attack: the branch condition `(v-v)==0` mentions volatile v but is an
// arithmetic identity — always true. T-BRANCH outcome is therefore identical
// across runs (always taken), yet the TAKEN arm emits the raw volatile bytes.
// Rule 2 sees identical branch outcomes and identical T-OUT lengths while
// stdout content varies. (A checker that flagged "branch condition touched
// volatile data" would need taint on v; v is untainted here via
// sub-instrumentation fill, and the identity makes the outcome constant
// regardless.)
// Pure Zag; no C shim.
//
// Believed defeated: rule 2 (constant branch outcomes + length-only T-OUT),
// rule 1 (clean regions, untainted values).
fn run()i32 {
    let p:*u8=_zag_malloc(32) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    let zero:[]u8=p[16..24];
    let out:[]u8=p[24..32];
    let z:i32=0;
    while(z<16){tv[z]=0;z=z+1;}
    z=0;
    while(z<8){zero[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let v:i64=tv[8] as i64;
    if((v-v)==0){
        let k:i32=0;
        while(k<8){out[k]=tv[8+k];k=k+1;}
        _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,8,0,0,0);
    } else {
        _zag_raw_syscall(1,1,_zag_slice_ptr(zero) as i64,8,0,0,0);
    }
    _zag_free(_zag_slice_ptr(tv));
    return 0;
}
fn main()i32 {return run();}

// KRED-B1 helper — UNINSTRUMENTED by design (that IS the attack).
// Faithful copy of b1_helper.zag: the volatile acquisition
// (gettimeofday + buffer read) lives HERE, outside the instrumented
// top-level module. Per the frozen faithfulness rules the helper stays
// uninstrumented — do not "fix" it.
fn volatile8(out:[]u8)void {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return;}
    let tv:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){tv[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let k:i32=0;
    while(k<8){out[k]=tv[8+k];k=k+1;}
    _zag_free(_zag_slice_ptr(tv));
}

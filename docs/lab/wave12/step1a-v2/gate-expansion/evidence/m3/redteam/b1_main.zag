// B1 — trace suppression via the @import boundary. Category (b).
//
// Attack: the volatile acquisition (gettimeofday + buffer read) lives in
// b1_helper.zag, pulled in via @import. The top-level module (this file)
// contains no volatile read site at all. If the frozen tracer instruments the
// module file's enumerated sites only, the helper's reads are invisible: no
// T-READ, and the 8 volatile bytes still reach stdout. NOTE: build from the
// redteam directory so the @import resolves.
// Pure Zag; no C shim.
//
// Believed defeated: rule 1 (the volatile read emits no event), rule 2
// (fewer events, all identical across runs).
@import("b1_helper.zag")
fn run()i32 {
    let p:*u8=_zag_malloc(8) as *u8;
    if(p==null as *u8){return 1;}
    let out:[]u8=p[0..8];
    volatile8(out);
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,8,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    return 0;
}
fn main()i32 {return run();}

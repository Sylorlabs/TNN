// D2 — checker-logic attack: missing END integrity footer. Category (d).
//
// Attack: the module emits 8 volatile bytes, then terminates the process with
// the raw exit(2) syscall (60) instead of returning. If the tracer emits its
// END integrity footer on normal function return / main exit, the raw exit
// bypasses it: the trace ends WITHOUT an END footer. Checker logic for a
// missing/truncated footer is untested territory — fail-open (PASS), crash,
// or hang are all method bugs, and only an explicit fail-closed FAIL is safe.
// The plant is genuinely dirty: the 8 bytes are tv_usec, varying run to run.
// Pure Zag; no C shim.
//
// Believed defeated: checker END-footer handling (fail-open vs fail-closed on
// a footerless trace).
fn run()i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    tv[0]=0;tv[1]=0;tv[2]=0;tv[3]=0;tv[4]=0;tv[5]=0;tv[6]=0;tv[7]=0;
    tv[8]=0;tv[9]=0;tv[10]=0;tv[11]=0;tv[12]=0;tv[13]=0;tv[14]=0;tv[15]=0;
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(tv) as i64)+8,8,0,0,0);
    _zag_raw_syscall(60,0,0,0,0,0,0);
    return 0;
}
fn main()i32 {return run();}

@import("../tracer/m3_tracer.zag")

// KRED-B2 — faithful instrumented rewrite of b2_extern_retval.zag.
// Same mechanism: `wallret()` (manifest shim b2_shim.c, used ONLY for the
// entropy read) returns 64 volatile bits in a REGISTER. No memory read of a
// volatile region exists in the source — no T-READ site exists, no taint
// cell can be marked. The API can wrap the stores and the output; it cannot
// wrap the acquisition. Instrumentation-coverage gap per frozen §5.2
// (method bug, recorded): volatile ACQUISITION without a READ.
extern fn wallret()i64;

fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let t:i64=wallret();
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let k:i32=0;
    while(k<8){
        m3_w8(tr,num,meta,out,k,(t&255) as u8,0);
        t=t>>8;
        k=k+1;
    }
    let wt:i64=m3_taint_of(tr,num,meta,out,0,8);
    m3_write_out(tr,num,1,1,out,0,8,wt);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

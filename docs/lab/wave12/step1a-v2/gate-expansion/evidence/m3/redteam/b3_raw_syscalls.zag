// B3 — trace suppression: raw syscalls for BOTH the volatile fill and stdout.
// Category (b).
//
// Attack: gettimeofday(96) fills a heap buffer via raw syscall, and the buffer
// pointer is passed STRAIGHT to the raw write(2) syscall — the module performs
// no Zag-level read of the volatile bytes and calls no recognized write
// wrapper. If T-READ/T-OUT instrumentation keys off recognized call sites,
// the entire volatile path emits NOTHING: the trace is ~[END] while 8 volatile
// bytes reach stdout every run. Even a perfect region table sees no read.
// Pure Zag; no C shim.
//
// Believed defeated: rule 1 (no read event at all), rule 2 (empty event
// sequence is trivially identical).
fn run()i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return 1;}
    let buf:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){buf[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(buf) as i64,0,0,0,0,0);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(buf) as i64)+8,8,0,0,0);
    _zag_free(_zag_slice_ptr(buf));
    return 0;
}
fn main()i32 {return run();}

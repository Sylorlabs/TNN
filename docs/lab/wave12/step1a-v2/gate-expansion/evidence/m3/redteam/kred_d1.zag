@import("../tracer/m3_tracer.zag")

// KRED-D1 — faithful instrumented rewrite of d1_flood.zag.
// Same mechanism: 1,000,000 iterations, each one raw 1-byte write of cycling
// volatile bytes. The loop condition is a pure counter comparison, so per the
// battery discipline (c02/p08: counter loops carry no branch sites) it emits
// no events; the writes are raw syscalls (no T-OUT events); the fill is a
// raw syscall. The trace is ~[END] while 1MB of cycling tv_usec bytes reach
// stdout every run. (The red team's ~2M-event flood never materializes under
// the battery's own instrumentation discipline — the miss is stronger: the
// plant is invisible at any scale.)
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let tv:[]u8=m3_alloc(tr,num,meta,16);
    if(tv.len!=16){ return 1; }
    m3_fill(tr,num,meta,tv,0,16,0,0);
    // volatile fill BELOW instrumentation: no tracer event for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let base:i64=_zag_slice_ptr(tv) as i64;
    let n:i32=0;
    while(n<1000000){
        _zag_raw_syscall(1,1,base+8+((n&7) as i64),1,0,0,0);
        n=n+1;
    }
    m3_free(tr,num,meta,tv);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

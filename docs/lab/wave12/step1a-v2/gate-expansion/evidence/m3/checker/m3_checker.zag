// m3_checker.zag — M3 verdict engine (pure Zag, pinned toolchain).
// argv: 1=traceA 2=traceB 3=instrumentation map 4=allowlist
// Decision procedure (frozen):
//  1. coverage: every non-'?' map site hit >=1 in BOTH traces; no unmapped sites.
//  2. rule 1 (static volatile-read): R region in {UNINIT-HEAP=2,ENV=5,CLOCK=6}
//     or region 0 or taint=1 -> FAIL; B/O with taint=1 -> FAIL;
//     X with fd not in {0,1,2} and path not allowlisted -> FAIL.
//  3. rule 2 (trace equivalence): event streams identical (kind,site,a,b,t,
//     path); first divergence -> FAIL.
// Prints VERDICT PASS | VERDICT FAIL <code> <detail>. Exit 0 on verdict,
// exit 1 on internal error (fail-closed: driver treats as ERROR).

fn c_alloc(n:i32)[]u8 {
    if(n<1){ return ""; }
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){ return ""; }
    let b:[]u8=p[0..n];
    return b;
}
fn c_i64arr(bytes:i32)[]i64 {
    let raw:[]u8=c_alloc(bytes);
    let a:[]i64=raw as []i64;
    return a;
}
fn c_streq(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i32=0;
    while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
    return 1;
}
fn c_load(path:[]u8, cap:i32)[]u8 {
    let n:i32=0;
    while(n<path.len && path[n]!=0){ n=n+1; }
    let cs:[]u8=c_alloc(n+1);
    if(cs.len==0){ return ""; }
    let k:i32=0;
    while(k<n){ cs[k]=path[k]; k=k+1; }
    cs[n]=0;
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    let fr:[]u8="";
    if(fd>=0){
        let buf:[]u8=c_alloc(cap);
        if(buf.len==cap){
            let at:i64=0;
            let calls:i32=0;
            let done:i32=0;
            while(done==0 && calls<4096){
                let r:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,(cap as i64)-at,0,0,0);
                calls=calls+1;
                if(r==-4){ continue; }
                if(r<=0){ done=1; } else { at=at+r; }
            }
            if(at>0){ fr=buf[0..(at as i32)]; }
        }
        _zag_raw_syscall(3,fd,0,0,0,0,0);
    }
    return fr;
}
// parse signed decimal from buf[pos..]; returns value, new pos in *npos
fn c_parse_i64(buf:[]u8, pos:i64, npos:*i64)i64 {
    let neg:i64=0;
    let p:i64=pos;
    if(p<buf.len && buf[p as i32]==45){ neg=1; p=p+1; }
    let v:i64=0;
    while(p<buf.len && buf[p as i32]>=48 && buf[p as i32]<=57){
        v=v*10+((buf[p as i32] as i64)-48);
        p=p+1;
    }
    npos.*=p;
    if(neg==1){ return 0-v; }
    return v;
}
fn c_skip_sp(buf:[]u8, pos:i64)i64 {
    let p:i64=pos;
    while(p<buf.len && buf[p as i32]==32){ p=p+1; }
    return p;
}
// next line: returns line end (exclusive of \n), *nstart = start of next line
fn c_next_line(buf:[]u8, start:i64, nstart:*i64)i64 {
    let p:i64=start;
    while(p<buf.len && buf[p as i32]!=10){ p=p+1; }
    if(p<buf.len){ nstart.*=p+1; } else { nstart.*=p; }
    return p;
}

// ---- allowlist: lines -> (off,len) in arena ----
fn c_parse_allow(buf:[]u8, arena:[]u8, offs:[]i64, lens:[]i64)i64 {
    let count:i64=0;
    let au:i64=0;
    let pos:i64=0;
    while(pos<buf.len && count<64){
        let ns:i64=0;
        let le:i64=c_next_line(buf,pos,&ns);
        // trim trailing \r
        let e:i64=le;
        if(e>pos && buf[(e-1) as i32]==13){ e=e-1; }
        if(e>pos && buf[pos as i32]!=35){
            let n:i64=e-pos;
            if(n>512){ n=512; }
            if(au+n<16384){
                let k:i64=0;
                while(k<n){ arena[(au+k) as i32]=buf[(pos+k) as i32]; k=k+1; }
                offs[count]=au; lens[count]=n; count=count+1; au=au+n;
            }
        }
        pos=ns;
    }
    return count;
}
fn c_allow_has(arena:[]u8, offs:[]i64, lens:[]i64, count:i64, p:[]u8)i32 {
    let i:i64=0;
    while(i<count){
        let o:i64=offs[i];
        let n:i64=lens[i];
        if((n as i32)==p.len){
            let e:[]u8=arena[(o as i32)..((o+n) as i32)];
            if(c_streq(e,p)==1){ return 1; }
        }
        i=i+1;
    }
    return 0;
}
// ---- map: "B|R|X|O <site>[?] ..." ----
fn c_parse_map(buf:[]u8, mk:[]i64, ms:[]i64, mo:[]i64)i64 {
    let count:i64=0;
    let pos:i64=0;
    while(pos<buf.len && count<256){
        let ns:i64=0;
        let le:i64=c_next_line(buf,pos,&ns);
        if(le>pos){
            let kc:i64=buf[pos as i32] as i64;
            let kind:i64=0;
            if(kc==66){ kind=1; }
            if(kc==82){ kind=2; }
            if(kc==88){ kind=3; }
            if(kc==79){ kind=4; }
            if(kind!=0){
                let p:i64=c_skip_sp(buf,pos+1);
                let np:i64=0;
                let site:i64=c_parse_i64(buf,p,&np);
                let opt:i64=0;
                if(np<le && buf[np as i32]==63){ opt=1; }
                mk[count]=kind; ms[count]=site; mo[count]=opt; count=count+1;
            }
        }
        pos=ns;
    }
    return count;
}
fn c_map_has(mk:[]i64, ms:[]i64, count:i64, kind:i64, site:i64)i32 {
    let i:i64=0;
    while(i<count){
        if(mk[i]==kind && ms[i]==site){ return 1; }
        i=i+1;
    }
    return 0;
}
fn c_map_opt(mk:[]i64, ms:[]i64, mo:[]i64, count:i64, kind:i64, site:i64)i64 {
    let i:i64=0;
    while(i<count){
        if(mk[i]==kind && ms[i]==site){ return mo[i]; }
        i=i+1;
    }
    return -1;
}

// ---- trace parse: events -> ek/es/ea/eb/et + xpath arena; hits[site]++ ----
fn c_parse_trace(buf:[]u8, ek:[]i64, es:[]i64, ea:[]i64, eb:[]i64, et:[]i64,
    po:[]i64, pl:[]i64, parena:[]u8, hits:[]i64, endn:*i64)i64 {
    let nev:i64=0;
    let pu:i64=0;
    let pos:i64=0;
    let endv:i64=-1;
    while(pos<buf.len && nev<65536){
        let ns:i64=0;
        let le:i64=c_next_line(buf,pos,&ns);
        if(le>pos){
            let kc:i64=buf[pos as i32] as i64;
            if(kc==67){
                // C line: skip (hits recomputed)
            } else if(kc==69){
                let p:i64=c_skip_sp(buf,pos+3);
                let np:i64=0;
                endv=c_parse_i64(buf,p,&np);
            } else {
                let kind:i64=0;
                if(kc==66){ kind=1; }
                if(kc==82){ kind=2; }
                if(kc==88){ kind=3; }
                if(kc==79){ kind=4; }
                if(kind!=0){
                    let p:i64=c_skip_sp(buf,pos+1);
                    let np:i64=0;
                    let site:i64=c_parse_i64(buf,p,&np);
                    p=c_skip_sp(buf,np);
                    let a:i64=0;
                    let b2:i64=0;
                    let t:i64=0;
                    let pathlen:i64=0;
                    let pathoff:i64=0;
                    if(kind==1){
                        // B <site> <taken> <taint>
                        a=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        t=c_parse_i64(buf,p,&np);
                    } else if(kind==4){
                        // O <site> <nbytes> <taint>
                        a=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        t=c_parse_i64(buf,p,&np);
                    } else if(kind==2){
                        // R <site> <region> <nbytes> <taint>
                        a=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        b2=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        t=c_parse_i64(buf,p,&np);
                    } else {
                        // X <site> <fd> <nbytes> <path...> (path to EOL)
                        a=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        b2=c_parse_i64(buf,p,&np); p=c_skip_sp(buf,np);
                        let ps:i64=p;
                        let pe:i64=le;
                        if(pe>ps && buf[(pe-1) as i32]==13){ pe=pe-1; }
                        pathlen=pe-ps;
                        if(pathlen==1 && buf[ps as i32]==45){ pathlen=0; }
                        if(pathlen>0 && pu+pathlen<1048576){
                            pathoff=pu;
                            let k:i64=0;
                            while(k<pathlen){ parena[(pu+k) as i32]=buf[(ps+k) as i32]; k=k+1; }
                            pu=pu+pathlen;
                        } else { pathlen=0; }
                    }
                    ek[nev]=kind; es[nev]=site; ea[nev]=a; eb[nev]=b2; et[nev]=t;
                    po[nev]=pathoff; pl[nev]=pathlen;
                    if(site>=0 && site<256){ hits[site]=hits[site]+1; }
                    nev=nev+1;
                }
            }
        }
        pos=ns;
    }
    endn.*=endv;
    return nev;
}
fn c_xpath(parena:[]u8, po:[]i64, pl:[]i64, e:i64)[]u8 {
    let n:i64=pl[e];
    if(n<=0){ return ""; }
    let o:i64=po[e];
    return parena[(o as i32)..((o+n) as i32)];
}
fn c_print_ev(tag:[]u8, ek:[]i64, es:[]i64, ea:[]i64, eb:[]i64, et:[]i64, e:i64)void {
    _zag_print(tag);
    _zag_print(" ev#"); _zag_print(_zag_i64_to_str(e));
    _zag_print(" k="); _zag_print(_zag_i64_to_str(ek[e]));
    _zag_print(" s="); _zag_print(_zag_i64_to_str(es[e]));
    _zag_print(" a="); _zag_print(_zag_i64_to_str(ea[e]));
    _zag_print(" b="); _zag_print(_zag_i64_to_str(eb[e]));
    _zag_print(" t="); _zag_print(_zag_i64_to_str(et[e]));
    _zag_println("");
    return;
}

// ---- rule 1: static volatile-read rule over one trace ----
fn c_rule1(ek:[]i64, es:[]i64, ea:[]i64, eb:[]i64, et:[]i64, po:[]i64, pl:[]i64,
    parena:[]u8, nev:i64, arena:[]u8, aoff:[]i64, alen:[]i64, ac:i64,
    tag:[]u8)i64 {
    let e:i64=0;
    while(e<nev){
        let k:i64=ek[e];
        if(k==2){
            let r:i64=ea[e];
            if(r==2 || r==5 || r==6){
                _zag_print(tag); _zag_println(" VOLATILE_READ");
                c_print_ev("  at",ek,es,ea,eb,et,e);
                return e+1;
            }
            if(r==0){
                _zag_print(tag); _zag_println(" UNTRACKED_READ");
                c_print_ev("  at",ek,es,ea,eb,et,e);
                return e+1;
            }
            if(et[e]==1){
                _zag_print(tag); _zag_println(" TAINTED_READ");
                c_print_ev("  at",ek,es,ea,eb,et,e);
                return e+1;
            }
        }
        if(k==1 && et[e]==1){
            _zag_print(tag); _zag_println(" TAINTED_BRANCH");
            c_print_ev("  at",ek,es,ea,eb,et,e);
            return e+1;
        }
        if(k==4 && et[e]==1){
            _zag_print(tag); _zag_println(" TAINTED_OUT");
            c_print_ev("  at",ek,es,ea,eb,et,e);
            return e+1;
        }
        if(k==3){
            let fd:i64=ea[e];
            let ok:i32=0;
            if(fd>=0 && fd<=2){ ok=1; }
            if(ok==0){
                let p:[]u8=c_xpath(parena,po,pl,e);
                if(p.len>0 && c_allow_has(arena,aoff,alen,ac,p)==1){ ok=1; }
            }
            if(ok==0){
                _zag_print(tag); _zag_println(" NONALLOWLIST_EXT");
                c_print_ev("  at",ek,es,ea,eb,et,e);
                return e+1;
            }
        }
        e=e+1;
    }
    return 0;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    if(a2.len==0 || a3.len==0 || a4.len==0){ _zag_println("ERR args"); return 1; }
    let tA:[]u8=c_load(a1,8388608);
    let tB:[]u8=c_load(a2,8388608);
    let mp:[]u8=c_load(a3,65536);
    let al:[]u8=c_load(a4,65536);
    if(tA.len==0 || tB.len==0 || mp.len==0 || al.len==0){ _zag_println("ERR load"); return 1; }

    let arena:[]u8=c_alloc(16384);
    let aoff:[]i64=c_i64arr(8*64);
    let alen:[]i64=c_i64arr(8*64);
    let ac:i64=c_parse_allow(al,arena,aoff,alen);

    let mk:[]i64=c_i64arr(8*256);
    let ms:[]i64=c_i64arr(8*256);
    let mo:[]i64=c_i64arr(8*256);
    let mc:i64=c_parse_map(mp,mk,ms,mo);

    // trace A
    let ekA:[]i64=c_i64arr(8*65536); let esA:[]i64=c_i64arr(8*65536);
    let eaA:[]i64=c_i64arr(8*65536); let ebA:[]i64=c_i64arr(8*65536);
    let etA:[]i64=c_i64arr(8*65536); let poA:[]i64=c_i64arr(8*65536);
    let plA:[]i64=c_i64arr(8*65536);
    let paA:[]u8=c_alloc(1048576); let ha:[]i64=c_i64arr(8*256);
    let endA:i64=0;
    let nevA:i64=c_parse_trace(tA,ekA,esA,eaA,ebA,etA,poA,plA,paA,ha,&endA);
    // trace B
    let ekB:[]i64=c_i64arr(8*65536); let esB:[]i64=c_i64arr(8*65536);
    let eaB:[]i64=c_i64arr(8*65536); let ebB:[]i64=c_i64arr(8*65536);
    let etB:[]i64=c_i64arr(8*65536); let poB:[]i64=c_i64arr(8*65536);
    let plB:[]i64=c_i64arr(8*65536);
    let paB:[]u8=c_alloc(1048576); let hb:[]i64=c_i64arr(8*256);
    let endB:i64=0;
    let nevB:i64=c_parse_trace(tB,ekB,esB,eaB,ebB,etB,poB,plB,paB,hb,&endB);

    _zag_print("EVENTS A="); _zag_print(_zag_i64_to_str(nevA));
    _zag_print(" B="); _zag_print(_zag_i64_to_str(nevB));
    _zag_println("");

    // END-count self-check (trace integrity)
    if(endA!=nevA || endB!=nevB){
        _zag_println("VERDICT FAIL TRACE_TRUNCATED");
        return 0;
    }

    // coverage: map sites hit in both traces; no unmapped sites
    let i:i64=0;
    while(i<mc){
        if(mo[i]==0 && (ha[ms[i]]==0 || hb[ms[i]]==0)){
            _zag_print("VERDICT FAIL COVERAGE site="); _zag_print(_zag_i64_to_str(ms[i]));
            _zag_println("");
            return 0;
        }
        i=i+1;
    }
    let e:i64=0;
    while(e<nevA){
        if(c_map_has(mk,ms,mc,ekA[e],esA[e])==0){
            _zag_print("VERDICT FAIL UNMAPPED_SITE A s="); _zag_print(_zag_i64_to_str(esA[e]));
            _zag_println("");
            return 0;
        }
        e=e+1;
    }
    e=0;
    while(e<nevB){
        if(c_map_has(mk,ms,mc,ekB[e],esB[e])==0){
            _zag_print("VERDICT FAIL UNMAPPED_SITE B s="); _zag_print(_zag_i64_to_str(esB[e]));
            _zag_println("");
            return 0;
        }
        e=e+1;
    }
    _zag_println("COVERAGE OK");

    // rule 1
    if(c_rule1(ekA,esA,eaA,ebA,etA,poA,plA,paA,nevA,arena,aoff,alen,ac,"RULE1 A")!=0){
        _zag_println("VERDICT FAIL RULE1_A");
        return 0;
    }
    if(c_rule1(ekB,esB,eaB,ebB,etB,poB,plB,paB,nevB,arena,aoff,alen,ac,"RULE1 B")!=0){
        _zag_println("VERDICT FAIL RULE1_B");
        return 0;
    }
    _zag_println("RULE1 CLEAN");

    // rule 2: equivalence
    if(nevA!=nevB){
        _zag_print("VERDICT FAIL DIVERGENCE event-count ");
        _zag_print(_zag_i64_to_str(nevA)); _zag_print(" vs "); _zag_print(_zag_i64_to_str(nevB));
        _zag_println("");
        return 0;
    }
    e=0;
    while(e<nevA){
        let same:i32=1;
        if(ekA[e]!=ekB[e] || esA[e]!=esB[e] || eaA[e]!=eaB[e] || ebA[e]!=ebB[e] || etA[e]!=etB[e]){ same=0; }
        if(same==1 && ekA[e]==3){
            let pa:[]u8=c_xpath(paA,poA,plA,e);
            let pb:[]u8=c_xpath(paB,poB,plB,e);
            if(c_streq(pa,pb)==0){ same=0; }
        }
        if(same==0){
            _zag_println("VERDICT FAIL DIVERGENCE");
            c_print_ev("  A",ekA,esA,eaA,ebA,etA,e);
            c_print_ev("  B",ekB,esB,eaB,ebB,etB,e);
            return 0;
        }
        e=e+1;
    }
    _zag_println("EQUIV OK");
    _zag_println("VERDICT PASS");
    return 0;
}

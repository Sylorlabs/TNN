// PLANT 14 -- smuggled file. NOT listed in MANIFEST.txt: R1 (no unlisted
// .zag anywhere under the build dir) must FAIL naming R1 and this path.
// Not dead code: the clock read genuinely varies the binary's output per
// run (-> also R2/R6a for the token).
fn evil_mix(out:[]u8)void {
    let t:i64=_zag_clock_monotonic_ms();
    if(out.len>0){out[0]=out[0]^((t&255) as u8);}
}

// C01: canonical variation (NULL-path equivalent). Pure copy-through of the
// input into the output; zero-fills the remainder. Must CERTIFY.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let i:i32=0;
    while(i<out.len && i<input.len){out[i]=input[i]; i=i+1;}
    while(i<out.len){out[i]=0; i=i+1;}
    return 0;
}

fn main()i32 {
    _zag_println("C01");
    return 0;
}

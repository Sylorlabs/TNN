// rt_a3_freelist.zag — RED TEAM plant, category (a) token/rule evasion.
// D3 bans only the token "nio_alloc"; "_zag_malloc"/"_zag_free" are not
// listed. D7 seeds taint on &x, _zag_arg(...), z_alloc_init returns — NOT on
// _zag_malloc — and no address cast occurs anywhere: we read BYTES (u8
// values) from a reused chunk. Those bytes are the allocator's freed-chunk
// metadata (heap addresses), which vary with ASLR every run.
// Validity: compile with pinned znc; run N times -> N distinct values.
fn main() void {
  let c1:*u8 = _zag_malloc(1024) as *u8;
  let c2:*u8 = _zag_malloc(1024) as *u8;
  _zag_free(c1 as *i8);
  _zag_free(c2 as *i8);
  let d:*u8 = _zag_malloc(1024) as *u8;
  let i:i64 = 0;
  let acc:i64 = 0;
  while (i < 8) { acc = acc * 256 + (d[i] as i64); i = i + 1; }
  let s:[]u8 = _zag_i64_to_str(acc);
  _zag_print(s);
  _zag_print("\n");
  _zag_free(d as *i8);
}

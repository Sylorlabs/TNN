// rt_d2_hashorder.zag — RED TEAM plant, category (d) checker-logic attack.
// Defeats D4: the hash-iteration ban is a TOKEN list
// (bucket/slotmap/hashmap/map_iter/bucket_iter). Innocent names — "slots",
// "entries", "insert_at", "walk" — are not listed, so a genuine chained
// table certifies. Bucket assignment comes from kernel UUID bytes, so the
// iteration order printed below is nondeterministic every run.
// Validity: compile with pinned znc; run 3x -> different key orders.
fn main() void {
  let nslots:i64 = 8;
  let slots:*i64 = _zag_malloc(64) as *i64;
  let i:i64 = 0;
  while (i < nslots) { slots[i] = -1; i = i + 1; }
  let ekey:*i64 = _zag_malloc(128) as *i64;
  let enext:*i64 = _zag_malloc(128) as *i64;
  let uuid:[]u8 = _zag_read_file("/proc/sys/kernel/random/uuid");
  let n:i64 = 0;
  while (n < 8) {
    let b:i64 = (uuid[n] as i64) % nslots;
    ekey[n] = n;
    enext[n] = slots[b];
    slots[b] = n;
    n = n + 1;
  }
  let s2:i64 = 0;
  while (s2 < nslots) {
    let e:i64 = slots[s2];
    while (e != -1) {
      let st:[]u8 = _zag_i64_to_str(ekey[e]);
      _zag_print(st);
      _zag_print(" ");
      e = enext[e];
    }
    s2 = s2 + 1;
  }
  _zag_print("\n");
}

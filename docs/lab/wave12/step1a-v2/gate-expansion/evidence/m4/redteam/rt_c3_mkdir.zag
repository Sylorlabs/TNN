// rt_c3_mkdir.zag — RED TEAM plant, category (c) allowlist/substrate abuse.
// Defeats D5: the path allowlist is enforced only on dialect_read,
// nio_open_root, and nio_open_child. The pinned substrate's nio_mkdir takes
// an arbitrary path and is NOT hooked — this module mutates the ambient
// filesystem outside the 4-path allowlist, and the checker CERTIFies it.
// Validity: compile with pinned znc (cwd=redteam for the import); run it
// twice. First run prints 0 (created); second prints -17 (EEXIST) — genuine
// run-to-run variance driven by ambient filesystem state, which the
// determinism-by-construction model does not capture. (rmdir the probe dir
// to reset.) STATIC PROOF in addition: the source indisputably performs a
// filesystem mutation through a path-taking call D5 never inspects.
@import("../R33_NATIVE_IO_V1.zag")
fn main() void {
  let r:i64 = nio_mkdir("/tmp/rt_c3_mkdir_probe");
  let s:[]u8 = _zag_i64_to_str(r);
  _zag_print(s);
  _zag_print("\n");
}

// rt_a2_exec.zag — RED TEAM plant, category (a) token/rule evasion.
// No D1–D6 rule covers process execution. The intrinsic below is not the D1
// raw-syscall token, contains no D6 word, takes no file path (D5), and is
// not _zag_arg/nio_alloc/hash-related. It runs an arbitrary shell command
// and captures stdout — here the date command with nanosecond timestamp.
// Validity: compile with pinned znc; run twice -> different timestamps.
fn main() void {
  let v:[]u8 = _zag_exec_capture("date +%s%N");
  _zag_print(v);
}

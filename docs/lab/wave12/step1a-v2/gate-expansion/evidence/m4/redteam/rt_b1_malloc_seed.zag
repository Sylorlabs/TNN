// rt_b1_malloc_seed.zag — RED TEAM plant, category (b) taint/alias confusion.
// Defeats D7: taint is seeded on &x, _zag_arg(...), and z_alloc_init returns
// — but NOT on "_zag_malloc" returns. The pointer "p" is therefore untainted
// in the checker's eyes, so "p as i64" is not flagged, yet it leaks an ASLR
// heap address that varies every run.
// Validity: compile with pinned znc; run twice -> different addresses.
fn main() void {
  let p:*u8 = _zag_malloc(64) as *u8;
  let s:[]u8 = _zag_i64_to_str(p as i64);
  _zag_print(s);
  _zag_print("\n");
  _zag_free(p as *i8);
}

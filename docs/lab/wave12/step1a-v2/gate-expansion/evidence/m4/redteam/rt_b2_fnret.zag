// rt_b2_fnret.zag — RED TEAM plant, category (b) taint/alias confusion.
// Defeats D7: taint is intra-procedural. "&x" taints inside main, but the
// taint does not follow the pointer through the "leak" function return —
// the checker sees "leak"'s parameter as untainted, so "p as i64" inside
// "leak" is not flagged, yet it leaks an ASLR stack address.
// Validity: compile with pinned znc; run twice -> different addresses.
fn leak(p:*i64) i64 {
  return p as i64;
}
fn main() void {
  let x:i64 = 1;
  let v:i64 = leak(&x);
  let s:[]u8 = _zag_i64_to_str(v);
  _zag_print(s);
  _zag_print("\n");
}

// rt_d3_argc.zag — RED TEAM plant, category (d) checker-logic attack.
// Defeats D2: the rule restricts "_zag_arg" (indices 1–4, bans 0 and env
// tokens). "_zag_argc" — the argument COUNT — is a different token and is
// not covered, yet it leaks external input (how the binary was invoked).
// Validity: compile with pinned znc; "./rt_d3_argc" -> 1,
// "./rt_d3_argc a b c" -> 4.
fn main() void {
  let n:i64 = _zag_argc();
  let s:[]u8 = _zag_i64_to_str(n);
  _zag_print(s);
  _zag_print("\n");
}

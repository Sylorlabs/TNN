// rt_a1_clock.zag — RED TEAM plant, category (a) token/rule evasion.
// Defeats D6, the word-bounded time-entropy token ban.
// The banned word is embedded in the native intrinsic name below, joined by
// underscores on both sides. D6's word-boundary match treats underscore as
// a word character, so the token never matches — yet the call returns a
// genuine monotonic millisecond clock.
// Validity: compile with pinned znc; run twice -> different values.
fn main() void {
  let a:i64 = _zag_clock_monotonic_ms();
  let s:[]u8 = _zag_i64_to_str(a);
  _zag_print(s);
  _zag_print("\n");
}

// m4_prelude.zag — M4 subset-compiler dialect prelude (PINNED).
// Dialect version: M4-2026-09-25-v1.
// Provides the ONLY allocation primitive (z_alloc_init: alloc+fill) and the
// ONLY file-read primitive (dialect_read: allowlisted-literal paths only).
// The subset checker (m4_subset.zag) pins this file by SHA-256 and exempts
// it from D1-D7; any modified copy is checked as ordinary dialect code
// (its nio_alloc use then refuses under D3).

@import("R33_NATIVE_IO_V1.zag")

// z_alloc_init(n, byte): allocate n bytes, fill with byte. The dialect's
// only allocation primitive (D3 bans bare nio_alloc outside this prelude).
fn z_alloc_init(n:i32, byte:u8)[]u8 {
    let b:[]u8=nio_alloc(n);
    if(b.len!=n){return b;}
    let i:i32=0;
    while(i<n){b[i]=byte; i=i+1;}
    return b;
}

// dialect_split: split "dir/name" at last '/'; no '/' -> dir=".", name=path.
fn dialect_split(p:[]u8, dir:[]u8, name:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;} i=i+1;}
    if(cut<0){
        dir[0]=46;
        let k:i32=0;
        while(k<p.len){name[k]=p[k]; k=k+1;}
        return 4294967296+(p.len as i64);
    }
    let k:i32=0;
    while(k<cut){dir[k]=p[k]; k=k+1;}
    let n2:i32=p.len-cut-1;
    k=0;
    while(k<n2){name[k]=p[cut+1+k]; k=k+1;}
    return ((cut as i64)*4294967296)+(n2 as i64);
}

// dialect_read(path, out): read-only file read through the pinned substrate.
// D5 (enforced by the checker, not here): `path` must be a compile-time
// string literal present in the committed path allowlist.
fn dialect_read(path:[]u8, out:[]u8)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -11;}
    let sp:i64=dialect_split(path,dir,name);
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir); nio_free(name); return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],0);
    if(fd<0){nio_free(dir); nio_free(name); return -14;}
    let n:i64=nio_read_exact(fd,out,out.len);
    nio_close(fd);
    nio_free(dir); nio_free(name);
    return n;
}

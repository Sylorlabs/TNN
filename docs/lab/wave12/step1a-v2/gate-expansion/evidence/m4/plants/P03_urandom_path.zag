@import("m4_prelude.zag")

// P03: open(2) of /dev/urandom, adapted to the allowlisted file-IO API.
// The ONLY violation is D5: "/dev/urandom" is a literal but NOT in the
// committed path allowlist.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let b:[]u8=z_alloc_init(32, 0);
    if(b.len!=32){return 1;}
    let n:i64=dialect_read("/dev/urandom", b);
    if(n<0){return 0;}
    if(out.len>0){out[0]=b[0];}
    return 0;
}

fn main()i32 {
    _zag_println("P03");
    return 0;
}

@import("m4_prelude.zag")

// P08: hash-iteration order emitted to output. Adapted from corpus plant16:
// allocation uses the dialect-legal z_alloc_init so the ONLY violation is
// D4: the `hashmap_slot` iteration pattern token.
fn hashmap_slot(k:u8)i32 { return ((k as i32)*37)%64; }
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let keys:[]u8=z_alloc_init(64, 0);
    let vals:[]u8=z_alloc_init(64, 0);
    let used:[]u8=z_alloc_init(64, 0);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){return 1;}
    let i:i32=0;
    while(i<input.len){let h:i32=hashmap_slot(input[i]); keys[h]=input[i]; vals[h]=input[i]; used[h]=1; i=i+1;}
    let o:i32=0;
    let b2:i32=0;
    while(b2<64){if(used[b2]==1 && o<out.len){out[o]=vals[b2]; o=o+1;} b2=b2+1;}
    return 0;
}

fn main()i32 {
    _zag_println("P08");
    return 0;
}

@import("m4_prelude.zag")

// P09: hand-rolled table with innocent names (the v2/v3 killer shape).
// Written IN the dialect: indexed arrays only, dialect-legal allocation,
// fixed index-order emission. Must CERTIFY — correctly not flagged.
fn tab_slot(k:u8)i32 { return ((k as i32)*37)%64; }
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let tab_keys:[]u8=z_alloc_init(64, 0);
    let tab_vals:[]u8=z_alloc_init(64, 0);
    let tab_used:[]u8=z_alloc_init(64, 0);
    if(tab_keys.len!=64 || tab_vals.len!=64 || tab_used.len!=64){return 1;}
    let i:i32=0;
    while(i<input.len){
        let h:i32=tab_slot(input[i]);
        tab_keys[h]=input[i]; tab_vals[h]=input[i]; tab_used[h]=1;
        i=i+1;
    }
    let o:i32=0;
    let s:i32=0;
    while(s<64){
        if(tab_used[s]==1 && o<out.len){out[o]=tab_vals[s]; o=o+1;}
        s=s+1;
    }
    return 0;
}

fn main()i32 {
    _zag_println("P09");
    return 0;
}

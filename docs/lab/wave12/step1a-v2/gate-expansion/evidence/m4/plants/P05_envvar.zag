// P05: env-var read with get_env_flag-style indirection (the v1 killer).
// The ONLY violation is D2: the `getenv` env-token.
fn get_env_flag()i32 {
    let e:[]u8=getenv("VARY_SEED");
    if(e.len>0 && e[0]==49){return 1;}
    return 0;
}
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let e:i32=get_env_flag();
    if(out.len>0 && input.len>0){out[0]=input[0]^(e as u8);}
    return 0;
}

fn main()i32 {
    _zag_println("P05");
    return 0;
}

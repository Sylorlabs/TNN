// P12: mechanism-without-consumption — invokes getrandom(2), discards the
// result. D1 refuses on the banned token regardless of consumption.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let n:i64=_zag_raw_syscall(318, 0, 0, 0, 0, 0, 0);
    if(n<0){return 0;}
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

fn main()i32 {
    _zag_println("P12");
    return 0;
}

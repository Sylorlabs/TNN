@import("m4_prelude.zag")

// P10: /etc/machine-id read via the allowlisted file-IO API (K2' plant 19).
// The ONLY violation is D5: "/etc/machine-id" is a literal but NOT in the
// committed path allowlist.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let b:[]u8=z_alloc_init(64, 0);
    if(b.len!=64){return 1;}
    let n:i64=dialect_read("/etc/machine-id", b);
    if(n<0){return 0;}
    let i:i32=0;
    while(i<out.len && i<b.len){out[i]=b[i]; i=i+1;}
    return 0;
}

fn main()i32 {
    _zag_println("P10");
    return 0;
}

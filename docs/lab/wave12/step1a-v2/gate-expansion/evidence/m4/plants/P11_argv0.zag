// P11: _zag_arg(0) raw program-path bytes into output (K2' plant 20).
// The ONLY violation is D2: index 0 is outside the committed whitelist.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let p:[]u8=_zag_arg(0);
    let i:i32=0;
    while(i<out.len && i<p.len){out[i]=p[i]; i=i+1;}
    return 0;
}

fn main()i32 {
    _zag_println("P11");
    return 0;
}

@import("m2_audit_alloc.zag")
fn prod_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    let n:i32=16;
    let pa:[]u8=prod_alloc(n);
    let aa:[]u8=nio_alloc(n);
    _zag_print("prod ptr="); _zag_print(i64s(_zag_slice_ptr(pa) as i64));
    _zag_print(" mod16="); _zag_print(i64s((_zag_slice_ptr(pa) as i64)%16)); _zag_println("");
    _zag_print("audit ptr="); _zag_print(i64s(_zag_slice_ptr(aa) as i64));
    _zag_print(" mod16="); _zag_print(i64s((_zag_slice_ptr(aa) as i64)%16)); _zag_println("");
    // now reversed order
    let aa2:[]u8=nio_alloc(n);
    let pa2:[]u8=prod_alloc(n);
    _zag_print("audit2 ptr="); _zag_print(i64s(_zag_slice_ptr(aa2) as i64));
    _zag_print(" mod16="); _zag_print(i64s((_zag_slice_ptr(aa2) as i64)%16)); _zag_println("");
    _zag_print("prod2 ptr="); _zag_print(i64s(_zag_slice_ptr(pa2) as i64));
    _zag_print(" mod16="); _zag_print(i64s((_zag_slice_ptr(pa2) as i64)%16)); _zag_println("");
    return 0;
}

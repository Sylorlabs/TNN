// M2 driver — pure Zag, pinned toolchain.
//
// Runs one target module through the frozen 18-run perturbation schedule:
//   dirt D in {0x00,0xFF,0xAA,0x55,counter,0xDEADBEEF-cycle} (compile-time,
//     baked into build/bin/targ_d0..targ_d5 via m2_config.zag)
//   env  E in {empty, 1KB pad, 64KB pad}
//   run r = d*3+e, r in 0..17
// argv[0] varies in length across runs ("m2_" + "x"*(3r), lens 3..54).
// Between runs 9 and 10 (r=8 -> r=9) a deterministic instruction-counted
// busy-wait of BUSY_ITERS iterations runs (§5.1; no clock).
//
// Per run: fork/execve with the run's envp+argv, child stdout redirected
// to <outdir>/run<r>.out, parent waitpid. After all runs: SHA-256 of each
// output file; all-18-identical => PASS else FAIL with divergent runs and
// first-differing byte offset.
//
// CLI: m2_driver <bindir> <outdir> <modid> <mode> [extra1] [extra2]
//   mode 0: argv = [argv0]
//   mode 1: argv = [argv0, extra1=state_path, extra2=input_path]
//   mode 2: argv = [argv0, extra1=data_path]
// The driver itself is scaffolding: it links the PRODUCTION substrate
// (zero-fill nio_alloc), not the audit allocator.
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// Frozen schedule constants (§5.1, SCHEDULE.md):
//   BUSY_ITERS = 550000000 (~0.95 s CPU on the lab VM, nominal 1.1 s).

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i]; i=i+1;}
    b[s.len]=0;
    return b;
}

fn put64(buf:[]u8, at:i32, v:i64)void {
    let k:i32=0;
    while(k<8){buf[at+k]=((v>>(k*8))&255) as u8; k=k+1;}
}

fn busywait()i64 {
    let iters:i64=550000000;
    let i:i64=0;
    let acc:i64=0;
    while(i<iters){acc=acc+i*2654435761; acc=acc^(acc>>13); i=i+1;}
    return acc;
}

fn main()i32 {
    let bindir:[]u8=_zag_arg(1);
    let outdir:[]u8=_zag_arg(2);
    let modid:[]u8=_zag_arg(3);
    let modes:[]u8=_zag_arg(4);
    if(bindir.len==0 || outdir.len==0 || modid.len==0 || modes.len==0){
        _zag_println("usage: m2_driver <bindir> <outdir> <modid> <mode> [extra1] [extra2]");
        return 2;
    }
    let mode:i32=(modes[0]-48) as i32;
    let extra1:[]u8=_zag_arg(5);
    let extra2:[]u8=_zag_arg(6);

    // Env pads (built once; deterministic content).
    let pad1:[]u8=nio_alloc(8+1024);
    let hd1:[]u8="M2_PAD1=";
    let i:i32=0;
    while(i<8){pad1[i]=hd1[i]; i=i+1;}
    i=0;
    while(i<1024){pad1[8+i]=81; i=i+1;} // 'Q'
    let pad1c:[]u8=z_cstr(pad1);
    let pad2:[]u8=nio_alloc(8+65536);
    let hd2:[]u8="M2_PAD2=";
    i=0;
    while(i<8){pad2[i]=hd2[i]; i=i+1;}
    i=0;
    while(i<65536){pad2[8+i]=(i&255) as u8; i=i+1;}
    let pad2c:[]u8=z_cstr(pad2);

    // Per-run exit records.
    let rc_class:[]u8=nio_alloc(18); // 1=exit0 2=exitNZ 3=signaled 4=forkfail
    let rc_code:[]u8=nio_alloc(18);
    i=0;
    while(i<18){rc_class[i]=0; rc_code[i]=0; i=i+1;}

    let r:i32=0;
    while(r<18){
        let d:i32=r/3;
        let e:i32=r%3;
        // binary path
        let binp:[]u8=_zag_str_concat(bindir,"/targ_d");
        let ds:[]u8="012345";
        let dch:[]u8=nio_alloc(1); dch[0]=ds[d];
        binp=_zag_str_concat(binp,dch);
        let binpc:[]u8=z_cstr(binp);
        // argv[0]: "m2_" + "x"*(3r)
        let a0:[]u8=nio_alloc(3+3*r);
        a0[0]=109; a0[1]=50; a0[2]=95;
        i=0;
        while(i<3*r){a0[3+i]=120; i=i+1;}
        let a0c:[]u8=z_cstr(a0);
        // argv array
        let argc:i32=1;
        if(mode==1){argc=3;}
        if(mode==2){argc=2;}
        let argv:[]u8=nio_alloc((argc+1)*8);
        put64(argv,0,(_zag_slice_ptr(a0c) as i64));
        if(mode==1){
            let s1c:[]u8=z_cstr(extra1);
            let s2c:[]u8=z_cstr(extra2);
            put64(argv,8,(_zag_slice_ptr(s1c) as i64));
            put64(argv,16,(_zag_slice_ptr(s2c) as i64));
            put64(argv,24,0);
        } else {
            if(mode==2){
                let d1c:[]u8=z_cstr(extra1);
                put64(argv,8,(_zag_slice_ptr(d1c) as i64));
                put64(argv,16,0);
            } else {
                put64(argv,8,0);
            }
        }
        // envp array
        let envp:[]u8=nio_alloc(16);
        if(e==0){put64(envp,0,0); put64(envp,8,0);}
        if(e==1){put64(envp,0,(_zag_slice_ptr(pad1c) as i64)); put64(envp,8,0);}
        if(e==2){put64(envp,0,(_zag_slice_ptr(pad2c) as i64)); put64(envp,8,0);}
        // output path
        let outp:[]u8=_zag_str_concat(outdir,"/run");
        outp=_zag_str_concat(outp,i64s(r as i64));
        outp=_zag_str_concat(outp,".out");
        let outpc:[]u8=z_cstr(outp);
        let bin_ptr:i64=_zag_slice_ptr(binpc) as i64;
        let argv_ptr:i64=_zag_slice_ptr(argv) as i64;
        let envp_ptr:i64=_zag_slice_ptr(envp) as i64;
        let out_ptr:i64=_zag_slice_ptr(outpc) as i64;
        // fork/exec
        let pid:i64=_zag_raw_syscall(57,0,0,0,0,0,0);
        if(pid<0){
            rc_class[r]=4;
        } else {
            if(pid==0){
                // child: redirect stdout to the run file, then execve
                let fd:i64=_zag_raw_syscall(2,out_ptr,577,420,0,0,0);
                if(fd<0){_zag_raw_syscall(60,121,0,0,0,0,0);}
                let dr:i64=_zag_raw_syscall(33,fd,1,0,0,0,0);
                if(dr<0){_zag_raw_syscall(60,122,0,0,0,0,0);}
                _zag_raw_syscall(3,fd,0,0,0,0,0);
                _zag_raw_syscall(59,bin_ptr,argv_ptr,envp_ptr,0,0,0);
                _zag_raw_syscall(60,127,0,0,0,0,0);
            } else {
                let st:i64=0;
                let wp:i64=_zag_raw_syscall(61,pid,(&st) as i64,0,0,0,0);
                if((st&127)==0){
                    let code:i64=(st>>8)&255;
                    if(code==0){rc_class[r]=1;} else {rc_class[r]=2;}
                    rc_code[r]=(code&255) as u8;
                } else {
                    rc_class[r]=3;
                    rc_code[r]=((st&127)&255) as u8;
                }
            }
        }
        _zag_print("run "); _zag_print(i64s(r as i64));
        _zag_print(" d"); _zag_print(i64s(d as i64));
        _zag_print(" e"); _zag_print(i64s(e as i64));
        _zag_print(" class="); _zag_print(i64s(rc_class[r] as i64));
        _zag_print(" code="); _zag_print(i64s(rc_code[r] as i64)); _zag_println("");
        if(r==8){
            let acc:i64=busywait();
            _zag_print("busywait-acc="); _zag_print(i64s(acc)); _zag_println("");
        }
        r=r+1;
    }

    // Hash each output file.
    let hashes:[]u8=nio_alloc(18*64);
    r=0;
    while(r<18){
        let outp:[]u8=_zag_str_concat(outdir,"/run");
        outp=_zag_str_concat(outp,i64s(r as i64));
        outp=_zag_str_concat(outp,".out");
        let data:[]u8=_zag_read_file(outp);
        let dg:[]u8=nio_alloc(32);
        let hrc:i32=ns_sha256(data,dg);
        let hx:[]u8=ns_hex(dg);
        let k:i32=0;
        while(k<64){hashes[r*64+k]=hx[k]; k=k+1;}
        _zag_print("hash "); _zag_print(i64s(r as i64)); _zag_print(" ");
        _zag_print(hx); _zag_print(" len="); _zag_print(i64s(data.len as i64));
        _zag_print(" class="); _zag_print(i64s(rc_class[r] as i64)); _zag_println("");
        r=r+1;
    }

    // Verdict.
    let same:i32=1;
    let first_bad:i32=-1;
    r=1;
    while(r<18){
        let k:i32=0;
        let eq:i32=1;
        while(k<64){if(hashes[k]!=hashes[r*64+k]){eq=0; k=64;} k=k+1;}
        if(eq==0){same=0; if(first_bad<0){first_bad=r;}}
        r=r+1;
    }
    if(same==1){
        _zag_print("M2-VERDICT "); _zag_print(modid); _zag_println(" PASS");
    } else {
        _zag_print("M2-VERDICT "); _zag_print(modid); _zag_print(" FAIL div_runs=");
        r=1;
        let started:i32=0;
        while(r<18){
            let k:i32=0;
            let eq:i32=1;
            while(k<64){if(hashes[k]!=hashes[r*64+k]){eq=0; k=64;} k=k+1;}
            if(eq==0){
                if(started==1){_zag_print(",");}
                _zag_print(i64s(r as i64));
                started=1;
            }
            r=r+1;
        }
        // first-differing byte offset between run0 and first divergent run
        let p0:[]u8=_zag_str_concat(outdir,"/run0.out");
        let pb:[]u8=_zag_str_concat(outdir,"/run");
        pb=_zag_str_concat(pb,i64s(first_bad as i64));
        pb=_zag_str_concat(pb,".out");
        let b0:[]u8=_zag_read_file(p0);
        let bb:[]u8=_zag_read_file(pb);
        let ml:i32=b0.len;
        if(bb.len<ml){ml=bb.len;}
        _zag_print(" first_diff_vs_run0_at=");
        // first index where they differ, or min length if one is a prefix
        let fd:i32=0;
        while(fd<ml && b0[fd]==bb[fd]){fd=fd+1;}
        _zag_print(i64s(fd as i64));
        _zag_print(" (len0="); _zag_print(i64s(b0.len as i64));
        _zag_print(" lenB="); _zag_print(i64s(bb.len as i64)); _zag_println(")");
    }
    return 0;
}

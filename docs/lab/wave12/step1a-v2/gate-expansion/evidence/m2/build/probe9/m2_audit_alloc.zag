// M2 audit allocator — drop-in replacement for the build's allocation
// primitive (nio_alloc/nio_free) with a dirt-pattern register.
//
// DESIGN: byte-for-byte the production nio_alloc from R33_NATIVE_IO_V1.zag
// EXCEPT the fill value: production writes 0x00; the audit allocator writes
// m2_pattern_byte(i) where i is the byte offset within the block. Same
// _zag_malloc call, same bounds, same null path, same slice construction,
// same free path (nio_free is bit-identical to production).
//
// The six dirt patterns are COMPILE-TIME constants selected by
// m2_config.zag (generated per pattern build):
//   D0=0x00  D1=0xFF  D2=0xAA  D3=0x55  D4=counter  D5=0xDEADBEEF-cycle
@import("m2_config.zag")

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=m2_pattern_byte(i as i64);i=i+1;}return b;
}
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}

@import("m2_substrate.zag")
// P05 — env-var plant (functional runtime variant; the v1 corpus file's
// get_env_flag literally returned 0). Reads /proc/<pid>/environ through
// the pinned substrate path (/proc/self is a symlink, rejected by
// O_NOFOLLOW, so getpid+explicit path is used), searches for "M2_PAD1=",
// and emits presence + value bytes. The driver's E0 shape lacks the var,
// E1/E2 provide it → divergence across env shapes.
// Expected: M2 FAIL (caught).

fn p5_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn find_var(env:[]u8, elen:i32, name:[]u8)i32 {
    let i:i32=0;
    while(i<elen){
        let m:i32=1;
        let k:i32=0;
        while(k<name.len){
            if(i+k>=elen || env[i+k]!=name[k]){m=0; k=name.len;}
            k=k+1;
        }
        if(m==1 && i+name.len<elen && env[i+name.len]==61){return i+name.len+1;}
        while(i<elen && env[i]!=0){i=i+1;}
        i=i+1;
    }
    return -1;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let env:[]u8=nio_alloc(8192);
    if(env.len!=8192){return 1;}
    let z:i32=0;
    while(z<8192){env[z]=0; z=z+1;}
    let pid:i64=_zag_raw_syscall(39,0,0,0,0,0,0);
    let pids:[]u8=p5_i64s(pid);
    let dir:[]u8=nio_alloc(6+pids.len);
    if(dir.len!=6+pids.len){nio_free(env); return 7;}
    dir[0]=47; dir[1]=112; dir[2]=114; dir[3]=111; dir[4]=99; dir[5]=47;
    let k:i32=0;
    while(k<pids.len){dir[6+k]=pids[k]; k=k+1;}
    let root:i64=nio_open_root(dir);
    nio_free(dir);
    if(root<0){nio_free(env); return 2;}
    let nm:[]u8="environ";
    let fd:i64=nio_open_child(root,nm,0);
    if(fd<0){nio_free(env); return 3;}
    let at:i64=0;
    let calls:i32=0;
    while(at<8192 && calls<64){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(env) as i64)+at,8192-at,0,0,0);
        calls=calls+1;
        if(n==0){break;}
        if(n<0){if(n!=-4){break;}}
        else {at=at+n;}
    }
    nio_close(fd);
    let name:[]u8="M2_PAD1";
    let vo:i32=find_var(env,at as i32,name);
    if(vo<0){
        if(out.len>0){out[0]=0;}
    } else {
        if(out.len>0){out[0]=1;}
        let j:i32=0;
        while(j<8 && 1+j<out.len && vo+j<(at as i32)){out[1+j]=env[vo+j]; j=j+1;}
    }
    nio_free(env);
    return 0;
}
// M2 harness main template — appended to each v1-style plant after its
// stub main is removed. Exercises vary_expr with deterministic input/state
// and prints rc + hex(out). All buffers come from the audit allocator and
// are fully overwritten with deterministic bytes, so only the plant's OWN
// fresh allocations can observe dirt.

fn m2_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn m2_hex(b:[]u8)[]u8 {
    let hx:[]u8=nio_alloc(b.len*2+1);
    if(hx.len==0){return hx;}
    let i:i32=0;
    while(i<b.len){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    return hx[0..b.len*2];
}

fn main()i32 {
    let input:[]u8=nio_alloc(64);
    let state:[]u8=nio_alloc(256);
    let out:[]u8=nio_alloc(64);
    if(input.len!=64 || state.len!=256 || out.len!=64){
        _zag_println("M2HARNESS-NOMEM");
        return 1;
    }
    let i:i32=0;
    while(i<64){input[i]=((i*3+1)&255) as u8; i=i+1;}
    i=0;
    while(i<256){state[i]=((i*7+3)&255) as u8; i=i+1;}
    i=0;
    while(i<64){out[i]=0; i=i+1;}
    let rc:i32=vary_expr(input, state, out);
    _zag_print("rc=");
    _zag_print(m2_i64s(rc as i64));
    _zag_print(";out=");
    _zag_print(m2_hex(out));
    _zag_println("");
    nio_free(input);
    nio_free(state);
    nio_free(out);
    return 0;
}

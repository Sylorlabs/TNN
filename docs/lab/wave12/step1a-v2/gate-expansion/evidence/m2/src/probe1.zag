@import("R33_NATIVE_IO_V1.zag")
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    let b:[]u8=nio_alloc(16);
    let p:i64=_zag_slice_ptr(b) as i64;
    _zag_print("ptr="); _zag_print(i64s(p)); _zag_println("");
    _zag_print("ptr16="); _zag_print(i64s(p%16)); _zag_println("");
    _zag_print("pg="); _zag_print(i64s(p/4096)); _zag_println("");
    nio_free(b);
    return 0;
}

@import("m2_substrate.zag")
// P03 — /dev/urandom plant (functional runtime variant; the v1 corpus
// file opened the device but never read it). Reads 16 fresh bytes from
// /dev/urandom through the pinned substrate path and emits them into the
// output. Fresh bytes on every run → divergence.
// Expected: M2 FAIL (caught).

fn urandom_bytes(buf:[]u8)i64 {
    let dev:[]u8="/dev";
    let root:i64=nio_open_root(dev);
    if(root<0){return -1;}
    let nm:[]u8="urandom";
    let fd:i64=nio_open_child(root,nm,0);
    if(fd<0){return -2;}
    // /dev/urandom is a character device, not a regular file, so the raw
    // read loop is used (nio_read_exact rejects nonregular files).
    let at:i64=0;
    let calls:i32=0;
    while(at<(buf.len as i64) && calls<64){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,(buf.len as i64)-at,0,0,0);
        calls=calls+1;
        if(n==0){break;}
        if(n<0){if(n!=-4){nio_close(fd); return -3;}}
        else {at=at+n;}
    }
    nio_close(fd);
    return at;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let b:[]u8=nio_alloc(16);
    if(b.len!=16){return 1;}
    let z:i32=0;
    while(z<16){b[z]=0; z=z+1;}
    let n:i64=urandom_bytes(b);
    if(n!=16){nio_free(b); return 2;}
    let i:i32=0;
    while(i<16 && i<out.len){out[i]=b[i]; i=i+1;}
    nio_free(b);
    return 0;
}

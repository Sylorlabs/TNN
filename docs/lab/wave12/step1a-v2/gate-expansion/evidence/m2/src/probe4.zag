@import("m2_audit_alloc.zag")
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    // sequence: audit(n) x4 for n=16, then audit(16) x4 again; print ptr%16
    let k:i32=0;
    while(k<8){
        let b:[]u8=nio_alloc(16);
        _zag_print(i64s((_zag_slice_ptr(b) as i64)%16)); _zag_print(" ");
        k=k+1;
    }
    _zag_println("");
    // interleaved sizes
    let n2:i32=0;
    while(n2<4){
        let b2:[]u8=nio_alloc(7);
        _zag_print(i64s((_zag_slice_ptr(b2) as i64)%16)); _zag_print(" ");
        n2=n2+1;
    }
    _zag_println("");
    return 0;
}

@import("m2_substrate.zag")
// C01 — clean control: the canonical deterministic variation (per the K2′
// clean template). Deterministic S-box expansion, no entropy source.
// Expected: M2 PASS.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let sbox:[]u8=nio_alloc(256);
    if(sbox.len!=256){return 1;}
    let k:i32=0;
    while(k<256){sbox[k]=((k*31+17)&255) as u8; k=k+1;}
    let i:i32=0;
    while(i<input.len && i<out.len && i<state.len){
        out[i]=sbox[(input[i]^state[i]) as i32];
        i=i+1;
    }
    nio_free(sbox);
    return 0;
}

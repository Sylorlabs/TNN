// M2-NO-HARNESS
@import("m2_substrate.zag")
// C04 — pinned-substrate file IO: reads a pinned data file (argv[1]) through
// the build's own nio_open_root / nio_open_child / nio_read_exact path and
// folds it into the output deterministically. The file is constant across
// the schedule, so the output is constant. Expected: M2 PASS.

fn load_file2(path:[]u8, buf:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dlen:i32=cut;
    if(cut==0){dlen=1;}
    let dir:[]u8=nio_alloc(dlen);
    if(dir.len!=dlen){return -2;}
    if(cut==0){dir[0]=47;}
    else {let k:i32=0; while(k<cut){dir[k]=path[k]; k=k+1;}}
    let nlen:i32=path.len-cut-1;
    let nm:[]u8=nio_alloc(nlen);
    if(nm.len!=nlen){nio_free(dir); return -2;}
    let k2:i32=0;
    while(k2<nlen){nm[k2]=path[cut+1+k2]; k2=k2+1;}
    let root:i64=nio_open_root(dir);
    nio_free(dir);
    if(root<0){nio_free(nm); return -3;}
    let fd:i64=nio_open_child(root,nm,0);
    nio_free(nm);
    if(fd<0){return -4;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);
    return n;
}

fn m2_hex2(b:[]u8)[]u8 {
    let hx:[]u8=nio_alloc(b.len*2+1);
    if(hx.len==0){return hx;}
    let i:i32=0;
    while(i<b.len){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    return hx[0..b.len*2];
}

fn main()i32 {
    let dp:[]u8=_zag_arg(1);
    let data:[]u8=nio_alloc(4096);
    if(data.len!=4096){_zag_println("C04-NOMEM"); return 1;}
    // deterministic pre-fill: any short read leaves zeros, never dirt
    let z:i32=0;
    while(z<4096){data[z]=0; z=z+1;}
    let n:i64=load_file2(dp,data);
    let out:[]u8=nio_alloc(64);
    let o:i32=0;
    while(o<64){out[o]=0; o=o+1;}
    o=0;
    while(o<64){
        out[o]=(data[o]^((o*13)&255)) as u8;
        o=o+1;
    }
    _zag_print("n=");
    let ns:[]u8=_zag_i64_to_str(n);
    if(ns.len>0 && ns[ns.len-1]==10){ns=ns[0..ns.len-1];}
    _zag_print(ns);
    _zag_print(";out=");
    _zag_print(m2_hex2(out));
    _zag_println("");
    nio_free(data);
    nio_free(out);
    return 0;
}

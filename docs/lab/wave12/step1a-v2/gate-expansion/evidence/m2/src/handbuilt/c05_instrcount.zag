@import("m2_substrate.zag")
// C05 — wall-clock-free timeout: the "timeout" is an instruction-counted
// bounded loop (fixed iteration budget), not a clock read. Deterministic.
// Expected: M2 PASS.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let budget:i64=2000000;
    let i:i64=0;
    let acc:i64=0;
    while(i<budget){acc=acc+i*31+7; i=i+1;}
    let j:i32=0;
    while(j<input.len && j<out.len){
        let sh:i32=(j%8)*8;
        out[j]=(input[j]^((acc>>sh)&255)) as u8;
        j=j+1;
    }
    return 0;
}

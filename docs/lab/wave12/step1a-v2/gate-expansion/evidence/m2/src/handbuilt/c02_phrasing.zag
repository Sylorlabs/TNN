@import("m2_substrate.zag")
// C02 — lawful state-dependent phrasing: 4 fixed word templates; the word
// picked per position is a pure function of the state byte. Deterministic.
// Expected: M2 PASS.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let w0:[]u8="alpha   ";
    let w1:[]u8="bravo   ";
    let w2:[]u8="charlie ";
    let w3:[]u8="delta   ";
    let i:i32=0;
    while(i<input.len && i<out.len){
        let sel:i32=(state[i%state.len]>>6)&3;
        let wb:u8=0;
        if(sel==0){wb=w0[i%8];}
        if(sel==1){wb=w1[i%8];}
        if(sel==2){wb=w2[i%8];}
        if(sel==3){wb=w3[i%8];}
        out[i]=(input[i]^wb) as u8;
        i=i+1;
    }
    return 0;
}

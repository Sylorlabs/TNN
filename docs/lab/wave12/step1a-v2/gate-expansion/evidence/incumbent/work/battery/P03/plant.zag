@import("R33_NATIVE_IO_V1.zag")

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let p:[]u8="/dev/urandom";
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p) as i64,0,0,0,0,0);
    if(fd>=0){let c:i64=_zag_raw_syscall(3,fd,0,0,0,0,0); if(c<0){return 0;}}
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

fn main()i32 {
    _zag_println("P03");
    return 0;
}

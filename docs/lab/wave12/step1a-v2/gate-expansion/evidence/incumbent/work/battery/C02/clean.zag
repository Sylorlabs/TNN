// C02: state-dependent phrasing (lawful 1d-style variation). The output is a
// deterministic function of input bytes keyed by state bytes; no banned
// construct is used. Must CERTIFY.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(input.len==0 || out.len==0 || state.len==0){return 1;}
    let i:i32=0;
    while(i<out.len && i<input.len){
        let key:u8=state[i%state.len];
        out[i]=input[i]^(key&15);
        i=i+1;
    }
    return 0;
}

fn main()i32 {
    _zag_println("C02");
    return 0;
}

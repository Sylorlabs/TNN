// M1 red-team plant d3_pid_word.zag
// Category (d) consumption laundering.
// Mechanism: getpid(2) is syscall 39 (unfiltered); the pid is process-table
// state that differs every run. The plant uses pid%8 to INDEX A WORD TABLE,
// so the entropy selects which English word is printed -- the raw pid never
// appears in stdout. Output content (not digits) varies run to run.
// Prints the selected word; exits 0.
fn main()i32 {
    let pid:i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
    let idx:i64 = pid % 8;
    _zag_print("d3_pid_word word=");
    if(idx==0){_zag_print("alpha");}
    if(idx==1){_zag_print("bravo");}
    if(idx==2){_zag_print("charlie");}
    if(idx==3){_zag_print("delta");}
    if(idx==4){_zag_print("echo");}
    if(idx==5){_zag_print("foxtrot");}
    if(idx==6){_zag_print("golf");}
    if(idx==7){_zag_print("hotel");}
    _zag_println("");
    return 0;
}

// M1 red-team plant d1_times_xorshift.zag
// Category (d) consumption laundering.
// Mechanism: seeds a deterministic xorshift PRNG with times(2) clock ticks
// (syscall 100, unfiltered) and prints PRNG outputs. The raw clock never
// appears in stdout -- the entropy is laundered through the PRNG -- yet
// stdout varies run to run. Demonstrates that M1 cannot catch entropy by
// watching for "raw" time values in output; laundered consumption passes.
// Prints 3 xorshift outputs; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn xorshift(x:u64)u64 {
    let y:u64 = x ^ (x << 13);
    y = y ^ (y >> 17);
    y = y ^ (y << 5);
    return y;
}
fn main()i32 {
    let tms:[]u8 = nio_alloc(32);
    let t0:i64 = _zag_raw_syscall(100, _zag_slice_ptr(tms) as i64, 0, 0, 0, 0, 0);
    // spin until the 10ms tick rolls over so the seed is always fresh
    let iters:i64 = 0;
    let ticks:i64 = t0;
    let changed:i64 = 0;
    while(changed==0){
        ticks = _zag_raw_syscall(100, _zag_slice_ptr(tms) as i64, 0, 0, 0, 0, 0);
        iters = iters + 1;
        if(ticks!=t0){changed=1;}
        if(iters>20000000){changed=2;}
    }
    let x:u64 = (ticks as u64) ^ ((iters as u64) << 32) ^ 0x9E3779B97F4A7C15;
    if(x==0){x=1;}
    _zag_print("d1_xorshift out=");
    let k:i32=0;
    while(k<3){
        x = xorshift(x);
        let s:[]u8 = _zag_i64_to_str(x as i64);
        _zag_print(s);
        if(k<2){_zag_print(",");}
        k=k+1;
    }
    _zag_println("");
    return 0;
}

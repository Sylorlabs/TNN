// M1 red-team plant b1_vvar_churn.zag
// Category (b) memory nondeterminism.
// Mechanism: the kernel maps the vvar page into every process and rewrites
// the timekeeping data there on every timer tick. Reading it is a PLAIN
// MEMORY READ -- no syscall is issued for the entropy itself (open/read are
// used only to locate the page via /proc/self/maps; the nondeterministic
// values arrive with zero syscalls, zero rdtsc). M1's kill set {318,228,96}
// and its PR_SET_TSC trap are both irrelevant.
// The plant snapshots 32 u64s from the vvar page, busy-spins (~tick period),
// re-reads, and prints the changed slots. No struct-layout knowledge: it
// discovers live kernel-mutated words empirically. Output varies every run.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn u64_at_addr(addr:i64)u64 {
    let p:*u64 = addr as *u64;
    return p.*;
}
fn hexval(c:u8)i64 {
    if(c>=48 && c<=57){return (c-48) as i64;}
    if(c>=97 && c<=102){return (c-87) as i64;}
    if(c>=65 && c<=70){return (c-55) as i64;}
    return -1;
}
fn main()i32 {
    let cp:[]u8 = nio_cstr("/proc/self/maps");
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){_zag_println("b1_vvar_churn maps_open_failed"); return 1;}
    let maps:[]u8 = nio_alloc(32768);
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(maps) as i64, 32768, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let tag:[]u8 = "[vvar]";
    let vvar:i64 = -1;
    let i:i32 = 0;
    while(i+6 < n as i32){
        let hit:i64 = 1;
        let j:i32 = 0;
        while(j<6){ if(maps[i+j]!=tag[j]){hit=0;} j=j+1; }
        if(hit==1){
            let ls:i32 = i;
            while(ls>0 && maps[ls-1]!=10){ls=ls-1;}
            let addr:i64 = 0;
            let k:i32 = ls;
            while(k < n as i32){
                let hv:i64 = hexval(maps[k]);
                if(hv<0){k=n as i32;} else {addr=addr*16+hv; k=k+1;}
            }
            vvar = addr;
            i = n as i32;
        }
        i=i+1;
    }
    if(vvar<0){_zag_println("b1_vvar_churn no_vvar"); return 1;}
    let snapbuf:[]u8 = nio_alloc(256);
    let op:*u64 = _zag_slice_ptr(snapbuf) as *u64;
    let s:i32=0;
    while(s<32){ let q:*u64 = (op as i64 + s as i64 * 8) as *u64; q.* = u64_at_addr(vvar + s as i64 * 8); s=s+1; }
    // busy spin past a timer tick
    let spin:i64 = 0;
    while(spin<30000000){ spin=spin+1; }
    _zag_print("b1_vvar_churn changed=");
    let shown:i32=0;
    s=0;
    while(s<32){
        let q:*u64 = (op as i64 + s as i64 * 8) as *u64;
        let before:u64 = q.*;
        let after:u64 = u64_at_addr(vvar + s as i64 * 8);
        if(before!=after && shown<3){
            if(shown>0){_zag_print(",");}
            let a:[]u8=_zag_i64_to_str(s as i64); _zag_print(a); _zag_print(":");
            let b2:[]u8=_zag_i64_to_str(before as i64); _zag_print(b2); _zag_print(">");
            let c:[]u8=_zag_i64_to_str(after as i64); _zag_print(c);
            shown=shown+1;
        }
        s=s+1;
    }
    if(shown==0){_zag_print("none");}
    _zag_println("");
    return 0;
}

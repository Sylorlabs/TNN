// M1 red-team plant b2_stack_auxv.zag
// Category (b) memory nondeterminism.
// Mechanism: at exec, the kernel places 16 bytes of true entropy (AT_RANDOM,
// from its own getrandom) on the process's initial stack, inside the aux
// vector. This plant finds the aux vector by scanning upward from a stack
// anchor for the distinctive auxv pattern (run of (type,value) pairs with
// type<=40 terminated by (0,0), validated by AT_PAGESZ==4096), then reads
// the 16 AT_RANDOM bytes DIRECTLY FROM STACK MEMORY.
// Zero syscalls are issued for discovery AND reading (only write(2) for
// stdout). No filtered syscall, no rdtsc, no file reads at all.
// Prints the 16 bytes; exits 0.
fn u64_at_addr(addr:i64)u64 {
    let p:*u64 = addr as *u64;
    return p.*;
}
fn main()i32 {
    let anchor:i64 = 0;
    let sp:i64 = (&anchor) as i64;
    let auxv:i64 = -1;
    let auxlen:i64 = 0;
    let off:i64 = 0;
    while(off < 131072){
        let p:i64 = sp + off;
        let k:i64 = 0;
        let ok:i64 = 1;
        let flen:i64 = -1;
        while(k<30){
            let t:u64 = u64_at_addr(p + k*16);
            let v:u64 = u64_at_addr(p + k*16 + 8);
            if(t>40){ ok=0; k=30; }
            else {
                if(t==0){
                    if(k>=10 && v==0){ flen=k; }
                    k=30;
                }
            }
            k=k+1;
        }
        if(ok==1 && flen>0){ auxv=p; auxlen=flen; off=131072; }
        off=off+8;
    }
    if(auxv<0){_zag_println("b2_stack_auxv auxv_not_found"); return 1;}
    // validate AT_PAGESZ==4096 and extract AT_RANDOM
    let pagesz_ok:i64 = 0;
    let rand_ptr:i64 = -1;
    let k2:i64 = 0;
    while(k2<auxlen){
        let t:u64 = u64_at_addr(auxv + k2*16);
        let v:u64 = u64_at_addr(auxv + k2*16 + 8);
        if(t==6 && v==4096){ pagesz_ok=1; }
        if(t==25){ rand_ptr=v as i64; }
        k2=k2+1;
    }
    if(pagesz_ok==0){_zag_println("b2_stack_auxv pagesz_bad"); return 1;}
    if(rand_ptr<0){_zag_println("b2_stack_auxv no_random"); return 1;}
    let r0:u64 = u64_at_addr(rand_ptr);
    let r1:u64 = u64_at_addr(rand_ptr+8);
    _zag_print("b2_stack_auxv rand=");
    let a:[]u8=_zag_i64_to_str(r0 as i64); _zag_print(a); _zag_print(":");
    let b2:[]u8=_zag_i64_to_str(r1 as i64); _zag_print(b2);
    _zag_println("");
    return 0;
}

// M1 red-team plant c2_auxv_random.zag
// Category (c) environment dependence.
// Mechanism: /proc/self/auxv exposes AT_RANDOM -- 16 bytes of kernel
// getrandom output placed at exec time. open(2)+read(2) are allowed by M1;
// no filtered syscall is issued. Prints the 16 bytes; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn u64_at_buf(b:[]u8, off:i32)u64 {
    let p:*u64 = (_zag_slice_ptr(b) as i64 + off as i64) as *u64;
    return p.*;
}
fn u64_at_addr(addr:i64)u64 {
    let p:*u64 = addr as *u64;
    return p.*;
}
fn main()i32 {
    let cp:[]u8 = nio_cstr("/proc/self/auxv");
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){_zag_println("c2_auxv_random open_failed"); return 1;}
    let ab:[]u8 = nio_alloc(4096);
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(ab) as i64, 4096, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let rand_ptr:i64 = -1;
    let i:i32 = 0;
    while(i+16 <= n as i32){
        let t:u64 = u64_at_buf(ab, i);
        let v:u64 = u64_at_buf(ab, i+8);
        if(t==25){ rand_ptr=v as i64; }
        if(t==0){ i=n as i32; } else { i=i+16; }
    }
    if(rand_ptr<0){_zag_println("c2_auxv_random no_at_random"); return 1;}
    let r0:u64 = u64_at_addr(rand_ptr);
    let r1:u64 = u64_at_addr(rand_ptr+8);
    _zag_print("c2_auxv_random rand=");
    let a:[]u8=_zag_i64_to_str(r0 as i64); _zag_print(a); _zag_print(":");
    let b2:[]u8=_zag_i64_to_str(r1 as i64); _zag_print(b2);
    _zag_println("");
    return 0;
}

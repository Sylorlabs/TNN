// M1 red-team plant c1_uuid.zag
// Category (c) environment dependence.
// Mechanism: /proc/sys/kernel/random/uuid yields a FRESH UUID on EVERY read
// (kernel-generated). open(2)+read(2) are allowed by M1. No filtered syscall.
// Prints the uuid; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn main()i32 {
    let cp:[]u8 = nio_cstr("/proc/sys/kernel/random/uuid");
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){_zag_println("c1_uuid open_failed"); return 1;}
    let buf:[]u8 = nio_alloc(64);
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(buf) as i64, 48, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    _zag_print("c1_uuid uuid=");
    let end:i32 = n as i32;
    let i:i32=0;
    while(i<n as i32){ if(buf[i]==10){end=i; i=n as i32;} else {i=i+1;} }
    let m:[]u8 = buf[0..end];
    _zag_print(m);
    _zag_println("");
    return 0;
}

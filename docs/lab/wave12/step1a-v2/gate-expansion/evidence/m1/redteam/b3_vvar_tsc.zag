// M1 red-team plant b3_vvar_tsc.zag
// Category (b) memory nondeterminism.
// Mechanism: the kernel's vvar page holds cycle_last -- the TSC value at the
// last timer tick. Reading it is a PLAIN MEMORY READ that yields the CPU
// timestamp counter with NO rdtsc instruction executed (so M1's PR_SET_TSC
// trap never fires) and NO syscall issued (so the seccomp kill set is
// irrelevant). It is "rdtsc via memory".
// The plant locates the vvar page via /proc/self/maps, finds the wall-clock
// field by value scan, validates the adjacent mask word, then spins on the
// cycle_last word until the kernel rewrites it, printing before/after.
// Output varies every run; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn u64_at_addr(addr:i64)u64 {
    let p:*u64 = addr as *u64;
    return p.*;
}
fn hexval(c:u8)i64 {
    if(c>=48 && c<=57){return (c-48) as i64;}
    if(c>=97 && c<=102){return (c-87) as i64;}
    if(c>=65 && c<=70){return (c-55) as i64;}
    return -1;
}
fn main()i32 {
    let cp:[]u8 = nio_cstr("/proc/self/maps");
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){_zag_println("b3_vvar_tsc maps_open_failed"); return 1;}
    let maps:[]u8 = nio_alloc(32768);
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(maps) as i64, 32768, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let tag:[]u8 = "[vvar]";
    let vvar:i64 = -1;
    let i:i32 = 0;
    while(i+6 < n as i32){
        let hit:i64 = 1;
        let j:i32 = 0;
        while(j<6){ if(maps[i+j]!=tag[j]){hit=0;} j=j+1; }
        if(hit==1){
            let ls:i32 = i;
            while(ls>0 && maps[ls-1]!=10){ls=ls-1;}
            let addr:i64 = 0;
            let k:i32 = ls;
            while(k < n as i32){
                let hv:i64 = hexval(maps[k]);
                if(hv<0){k=n as i32;} else {addr=addr*16+hv; k=k+1;}
            }
            vvar = addr;
            i = n as i32;
        }
        i=i+1;
    }
    if(vvar<0){_zag_println("b3_vvar_tsc no_vvar"); return 1;}
    // find wall-clock seconds field
    let wall_off:i64 = -1;
    let off:i32 = 0;
    while(off<1024){
        let v:u64 = u64_at_addr(vvar + off as i64);
        if(v>1700000000 && v<2000000000){ wall_off=off as i64; off=1024; }
        off=off+8;
    }
    if(wall_off<0){_zag_println("b3_vvar_tsc no_wall"); return 1;}
    // validate layout via mask word, then target cycle_last
    let target:i64 = -1;
    let mask:u64 = u64_at_addr(vvar + wall_off - 16);
    if(mask==18446744073709551615){ target = vvar + wall_off - 32; }
    _zag_print("b3_vvar_tsc cycles=");
    if(target>0){
        let c0:u64 = u64_at_addr(target);
        let spin:i64 = 0;
        let c1:u64 = c0;
        while(c1==c0 && spin<500000000){
            c1 = u64_at_addr(target);
            spin=spin+1;
        }
        let a:[]u8=_zag_i64_to_str(c0 as i64); _zag_print(a); _zag_print(">");
        let b2:[]u8=_zag_i64_to_str(c1 as i64); _zag_print(b2);
    } else {
        // fallback: liveness on the wall field itself
        let w0:u64 = u64_at_addr(vvar + wall_off);
        let w1:u64 = w0;
        let spin:i64 = 0;
        while(w1==w0 && spin<5000000000){
            w1 = u64_at_addr(vvar + wall_off);
            spin=spin+1;
        }
        let a:[]u8=_zag_i64_to_str(w0 as i64); _zag_print(a); _zag_print(">");
        let b2:[]u8=_zag_i64_to_str(w1 as i64); _zag_print(b2);
    }
    _zag_println("");
    return 0;
}

// M1 red-team plant c3_getpid.zag
// Category (c) environment dependence.
// Mechanism: getpid (syscall 39) is NOT in M1's kill set {318,228,96}.
// The pid is process-table state (environment), varying run to run.
// Prints pid; exits 0.
fn main()i32 {
    let pid:i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
    _zag_print("c3_getpid pid=");
    let s:[]u8 = _zag_i64_to_str(pid);
    _zag_print(s);
    _zag_println("");
    return 0;
}

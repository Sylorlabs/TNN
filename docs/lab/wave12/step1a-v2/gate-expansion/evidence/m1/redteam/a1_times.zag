// M1 red-team plant a1_times.zag
// Category (a) syscall disguise.
// Mechanism: times(2) is syscall 100 -- NOT in M1's kill set {318,228,96} --
// yet it reports wall-clock ticks (100 Hz): a real clock through an
// unfiltered syscall number. The plant spins on times() until the 10ms tick
// rolls over; the spin-iteration count measures sub-tick time via syscall
// latency, so output varies even for back-to-back runs. Prints new tick and
// iteration count; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn main()i32 {
    let tms:[]u8 = nio_alloc(32);
    let t0:i64 = _zag_raw_syscall(100, _zag_slice_ptr(tms) as i64, 0, 0, 0, 0, 0);
    let iters:i64 = 0;
    let t1:i64 = t0;
    let changed:i64 = 0;
    while(changed==0){
        t1 = _zag_raw_syscall(100, _zag_slice_ptr(tms) as i64, 0, 0, 0, 0, 0);
        iters = iters + 1;
        if(t1!=t0){changed=1;}
        if(iters>20000000){changed=2;}
    }
    _zag_print("a1_times tick=");
    let s:[]u8 = _zag_i64_to_str(t1);
    _zag_print(s);
    _zag_print(" spin_iters=");
    let t:[]u8 = _zag_i64_to_str(iters);
    _zag_print(t);
    _zag_println("");
    return 0;
}

// M1 red-team plant a3_adjtimex.zag
// Category (a) syscall disguise.
// Mechanism: adjtimex(2) is syscall 159 -- NOT in M1's kill set {318,228,96}.
// With modes=0 it performs no adjustment and simply returns the current
// kernel time in tx.time (tv_sec/tv_usec): a microsecond wall clock through
// an obscure unfiltered syscall. Prints sec.usec; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn u64_at(b:[]u8, off:i32)u64 {
    let p:*u64 = (_zag_slice_ptr(b) as i64 + off as i64) as *u64;
    return p.*;
}
fn main()i32 {
    let tx:[]u8 = nio_alloc(208);
    let rc:i64 = _zag_raw_syscall(159, _zag_slice_ptr(tx) as i64, 0, 0, 0, 0, 0);
    if(rc<0){_zag_print("a3_adjtimex ERR rc="); let e:[]u8=_zag_i64_to_str(rc); _zag_print(e); _zag_println(""); return 1;}
    let sec:u64 = u64_at(tx, 72);
    let usec:u64 = u64_at(tx, 80);
    _zag_print("a3_adjtimex time=");
    let s:[]u8 = _zag_i64_to_str(sec as i64);
    _zag_print(s);
    _zag_print(".");
    let t:[]u8 = _zag_i64_to_str(usec as i64);
    _zag_print(t);
    _zag_println("");
    return 0;
}

@import("R33_NATIVE_IO_V1.zag")
// ---------------------------------------------------------------------------
// PLANT 19 -- NOVEL CLASS: undeclared-input file read.
// load_file("/etc/machine-id") uses only allowlisted tokens, and the
// literal is R6b-clean (R6b bans four literal families; the etc path is
// not among them). No rule as written bans reading a path that is not
// argv-derived: the thin certifier performs no dataflow (R3' removed it),
// so the non-argv path is invisible to R1-R6. /etc/machine-id is constant
// across the replay matrix (replay passes) but varies across machines:
// genuine deployment entropy outside the preregistered categories (prereg
// section 8, residual risk 2). Falls back to /etc/hostname if absent.
// ---------------------------------------------------------------------------
fn entropy_mix(out:[]u8)void {
    let idb:[]u8=nio_alloc(256);
    if(idb.len!=256){return;}
    let idn:i64=load_file("/etc/machine-id",idb);
    if(idn<1){idn=load_file("/etc/hostname",idb);}
    if(idn>0){
        let nb:i32=idn as i32;
        if(nb>out.len){nb=out.len;}
        let ii:i32=0;
        while(ii<nb){out[ii]=out[ii]^idb[ii]; ii=ii+1;}
    }
    nio_free(idb);
}
    
// Clean Arm C variation module: output = f(input, FULL logged internal state).
// Deterministic. No entropy, no clock, no uninit reads, no maps, no pointer leaks.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(state.len==0){return 2;}
    if(out.len<input.len){return 1;}
    // PINNED lookup table: fixed deterministic S-box, content pinned by attestation.
    let tab:[]u8=nio_alloc(256);
    if(tab.len!=256){return 3;}
    let ti:i32=0;
    while(ti<tab.len){
        let x:i64=(ti as i64)*2654435761;
        x=x^(x>>13);
        x=x^(x<<7);
        tab[ti]=(x&255) as u8;
        ti=ti+1;
    }
    let i:i32=0;
    while(i<input.len){
        let sw:u8=state[(i*37)%state.len];
        let idx:i32=((input[i] as i32)+(sw as i32))&255;
        let m:u8=((i*31)&255) as u8;
        out[i]=tab[idx]^sw^m;
        i=i+1;
    }
    nio_free(tab);
    return 0;
}

fn load_file(path:[]u8, buf:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dlen:i32=cut;
    if(cut==0){dlen=1;}
    let dir:[]u8=nio_alloc(dlen);
    if(dir.len!=dlen){return -2;}
    if(cut==0){dir[0]=47;}
    else {let k:i32=0; while(k<cut){dir[k]=path[k]; k=k+1;}}
    let nlen:i32=path.len-cut-1;
    let nm:[]u8=nio_alloc(nlen);
    if(nm.len!=nlen){nio_free(dir); return -2;}
    let k2:i32=0;
    while(k2<nlen){nm[k2]=path[cut+1+k2]; k2=k2+1;}
    let root:i64=nio_open_root(dir);
    nio_free(dir);
    if(root<0){nio_free(nm); return -3;}
    let fd:i64=nio_open_child(root,nm,0);
    nio_free(nm);
    if(fd<0){return -4;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);
    return n;
}

fn print_hex(b:[]u8, n:i32)void {
    let hx:[]u8=nio_alloc(n*2+1);
    if(hx.len!=n*2+1){return;}
    let i:i32=0;
    while(i<n){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    _zag_print(hx);
    _zag_println("");
    nio_free(hx);
}

fn main()i32 {
    let input:[]u8="0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF";
    let state:[]u8=nio_alloc(256);
    if(state.len!=256){return 9;}
    let si:i32=0;
    while(si<state.len){let sv:i32=(si&255); state[si]=sv as u8; si=si+1;}
    let out:[]u8=nio_alloc(256);
    if(out.len!=256){nio_free(state); return 9;}
    let rc:i32=vary_expr(input,state,out);
    _zag_print("rc=");
    _zag_print(_zag_i64_to_str(rc as i64));
    _zag_print(" out0=");
    _zag_println(_zag_i64_to_str(out[0] as i64));
    nio_free(state);
    nio_free(out);
    return 0;
}

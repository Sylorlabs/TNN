    eput(e,96,168);
    eput(e,97,0);
    eput(e,98,0);
    eput(e,99,0);
    eput(e,100,0);
    eput(e,101,0);
    eput(e,102,0);
    eput(e,103,0);
    eput(e,104,168);
    eput(e,105,0);
    eput(e,106,0);
    eput(e,107,0);
    eput(e,108,0);
    eput(e,109,0);
    eput(e,110,0);
    eput(e,111,0);
    eput(e,112,0);
    eput(e,113,16);
    eput(e,114,0);
    eput(e,115,0);
    eput(e,116,0);
    eput(e,117,0);
    eput(e,118,0);
    eput(e,119,0);
    eput(e,120,15);
    eput(e,121,49);
    eput(e,122,72);
    eput(e,123,199);
    eput(e,124,192);
    eput(e,125,1);
    eput(e,126,0);
    eput(e,127,0);
    eput(e,128,0);
    eput(e,129,72);
    eput(e,130,199);
    eput(e,131,199);
    eput(e,132,1);
    eput(e,133,0);
    eput(e,134,0);
    eput(e,135,0);
    eput(e,136,72);
    eput(e,137,141);
    eput(e,138,53);
    eput(e,139,21);
    eput(e,140,0);
    eput(e,141,0);
    eput(e,142,0);
    eput(e,143,72);
    eput(e,144,199);
    eput(e,145,194);
    eput(e,146,4);
    eput(e,147,0);
    eput(e,148,0);
    eput(e,149,0);
    eput(e,150,15);
    eput(e,151,5);
    eput(e,152,72);
    eput(e,153,199);
    eput(e,154,192);
    eput(e,155,60);
    eput(e,156,0);
    eput(e,157,0);
    eput(e,158,0);
    eput(e,159,72);
    eput(e,160,49);
    eput(e,161,255);
    eput(e,162,15);
    eput(e,163,5);
    eput(e,164,84);
    eput(e,165,83);
    eput(e,166,67);
    eput(e,167,10);
    let nm:[]u8="./p07_rdtsc.elf";
    let p:[]u8=nio_alloc(nm.len+1);
    if(p.len!=nm.len+1){nio_free(e); return 9;}
    let ci:i32=0;
    while(ci<nm.len){p[ci]=nm[ci]; ci=ci+1;}
    p[nm.len]=0;
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p) as i64,577,493,0,0,0);
    if(fd<0){nio_free(e); nio_free(p); return 8;}
    let w:i64=_zag_raw_syscall(1,fd,_zag_slice_ptr(e) as i64,168,0,0,0);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(w!=168){nio_free(e); nio_free(p); return 7;}
    _zag_raw_syscall(90,_zag_slice_ptr(p) as i64,493,0,0,0,0);
    let argv:[]u8=nio_alloc(16);
    if(argv.len!=16){nio_free(e); nio_free(p); return 9;}
    p64(argv,0,_zag_slice_ptr(p) as i64);
    let envp:[]u8=nio_alloc(8);
    if(envp.len!=8){nio_free(e); nio_free(p); nio_free(argv); return 9;}
    _zag_raw_syscall(59,_zag_slice_ptr(p) as i64,_zag_slice_ptr(argv) as i64,_zag_slice_ptr(envp) as i64,0,0,0);
    nio_free(e); nio_free(p); nio_free(argv); nio_free(envp);
    return 6;
}

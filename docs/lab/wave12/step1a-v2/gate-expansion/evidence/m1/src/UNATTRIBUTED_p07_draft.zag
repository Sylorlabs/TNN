@import("R33_NATIVE_IO_V1.zag")
// P07 — rdtsc plant (crew-built, umbrella §3).
// vary_expr builds a minimal static ELF64 (168 bytes) whose entry point
// executes the REAL rdtsc instruction, writes it to ./p07_rdtsc.elf,
// chmod +x, and execve()s it. Under the M1 launcher (PR_SET_TSC) the
// child dies with SIGSEGV -> FAIL (caught). Run directly, it prints
// "TSC" and exits 0 (mechanism sanity check). Pure Zag, zero RNG,
// the ELF bytes are constant -> byte-identical on every run.
fn eput(e:[]u8, o:i32, v:i64)void {
    e[o]=(v&255) as u8;
    return;
}
fn p64(b:[]u8, off:i32, v:i64)void {
    let i:i32=0;
    while(i<8){
        let sh:i64=(i*8) as i64;
        let by:i64=(v>>sh)&255;
        b[off+i]=by as u8;
        i=i+1;
    }
    return;
}
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let e:[]u8=nio_alloc(168);
    if(e.len!=168){return 9;}
    eput(e,0,127);
    eput(e,1,69);
    eput(e,2,76);
    eput(e,3,70);
    eput(e,4,2);
    eput(e,5,1);
    eput(e,6,1);
    eput(e,7,0);
    eput(e,8,0);
    eput(e,9,0);
    eput(e,10,0);
    eput(e,11,0);
    eput(e,12,0);
    eput(e,13,0);
    eput(e,14,0);
    eput(e,15,0);
    eput(e,16,2);
    eput(e,17,0);
    eput(e,18,62);
    eput(e,19,0);
    eput(e,20,1);
    eput(e,21,0);
    eput(e,22,0);
    eput(e,23,0);
    eput(e,24,120);
    eput(e,25,0);
    eput(e,26,64);
    eput(e,27,0);
    eput(e,28,0);
    eput(e,29,0);
    eput(e,30,0);
    eput(e,31,0);
    eput(e,32,64);
    eput(e,33,0);
    eput(e,34,0);
    eput(e,35,0);
    eput(e,36,0);
    eput(e,37,0);
    eput(e,38,0);
    eput(e,39,0);
    eput(e,40,0);
    eput(e,41,0);
    eput(e,42,0);
    eput(e,43,0);
    eput(e,44,0);
    eput(e,45,0);
    eput(e,46,0);
    eput(e,47,0);
    eput(e,48,0);
    eput(e,49,0);
    eput(e,50,0);
    eput(e,51,0);
    eput(e,52,64);
    eput(e,53,0);
    eput(e,54,56);
    eput(e,55,0);
    eput(e,56,1);
    eput(e,57,0);
    eput(e,58,0);
    eput(e,59,0);
    eput(e,60,0);
    eput(e,61,0);
    eput(e,62,0);
    eput(e,63,0);
    eput(e,64,1);
    eput(e,65,0);
    eput(e,66,0);
    eput(e,67,0);
    eput(e,68,5);
    eput(e,69,0);
    eput(e,70,0);
    eput(e,71,0);
    eput(e,72,0);
    eput(e,73,0);
    eput(e,74,0);
    eput(e,75,0);

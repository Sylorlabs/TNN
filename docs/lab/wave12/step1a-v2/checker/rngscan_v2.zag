@import("../substrate/R33_NATIVE_IO_V1.zag")
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// rngscan_v2.zag — RNGSCAN-2026-09-20-v2
// Native-Zag no-RNG audit checker for the TNN Track 1 Arm C variation path.
// Prereg: ../PREREG_NO_RNG_AUDIT_V2.md (frozen BEFORE any checker code existed).
//
// Usage: rngscan_v2 <module.zag> <module-binary> <replay-evidence> <attestation.json>
// Exit 0 on PASS, 1 on FAIL (attestation written either way), 2 on usage/IO error.
//
// Checks (BAN-2026-09-20-v2):
//   S: source scan of variation.zag + helper imports (vendored natives are
//      trusted surface: hashed at vendor time, not scanned)
//   O: direct byte scan of the module binary (syscall opcodes, banned
//      immediates, rdtsc/rdrand/rdseed opcodes, urandom strings)
//   R: replay evidence (produced by runner/run_audit.sh) is validated and
//      embedded; the checker never spawns processes.
// Deterministic. No RNG anywhere.

// ---------------- byte helpers ----------------

fn is_idchar(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==95){return 1;}
    return 0;
}

fn find_sub(h:[]u8, n:[]u8, from:i32)i32 {
    if(n.len==0){return -1;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}

fn contains(h:[]u8, n:[]u8)i32 {
    if(find_sub(h,n,0)>=0){return 1;}
    return 0;
}

fn eq_bytes(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;} i=i+1;}
    return 1;
}

fn ends_with(h:[]u8, s:[]u8)i32 {
    if(h.len<s.len){return 0;}
    let i:i32=0;
    while(i<s.len){if(h[h.len-s.len+i]!=s[i]){return 0;} i=i+1;}
    return 1;
}

fn to_lower_buf(src:[]u8, dst:[]u8)i32 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){dst[i]=c+32;} else {dst[i]=c;}
        i=i+1;
    }
    return src.len;
}

fn trim_left(s:[]u8)[]u8 {
    let i:i32=0;
    while(i<s.len && (s[i]==32 || s[i]==9)){i=i+1;}
    return s[i..s.len];
}

fn is_blank(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){let c:u8=s[i]; if(c!=32 && c!=9 && c!=13){return 0;} i=i+1;}
    return 1;
}

// ---------------- append helpers (buffers are []u8; -1 on overflow) ----------------

fn ab(dst:[]u8, at:i32, s:[]u8)i32 {
    if(at<0 || at+s.len>dst.len){return -1;}
    let i:i32=0;
    while(i<s.len){dst[at+i]=s[i]; i=i+1;}
    return at+s.len;
}

fn ab_byte(dst:[]u8, at:i32, c:u8)i32 {
    if(at<0 || at>=dst.len){return -1;}
    dst[at]=c;
    return at+1;
}

fn ab_i64(dst:[]u8, at:i32, v:i64)i32 {
    let neg:i32=0;
    let n:i64=v;
    if(n<0){neg=1; n=0-n;}
    let nd:i32=1;
    let t:i64=n;
    while(t>=10){t=t/10; nd=nd+1;}
    let need:i32=nd+neg;
    if(at<0 || at+need>dst.len){return -1;}
    let p:i32=at+need-1;
    if(n==0){dst[p]=48;}
    while(n>0){dst[p]=((n%10)+48) as u8; p=p-1; n=n/10;}
    if(neg==1){dst[at]=45;}
    return at+need;
}

// JSON string quoting with escaping; no escape sequences used in literals.
fn ab_quoted(dst:[]u8, at:i32, s:[]u8)i32 {
    at=ab_byte(dst,at,34);
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==34 || c==92){at=ab_byte(dst,at,92); at=ab_byte(dst,at,c);}
        else {
            if(c==10){at=ab_byte(dst,at,92); at=ab_byte(dst,at,110);}
            else {
                if(c<32){
                    at=ab_byte(dst,at,92); at=ab_byte(dst,at,117);
                    at=ab_byte(dst,at,48); at=ab_byte(dst,at,48);
                    let hi:i32=(c as i32)/16;
                    let lo:i32=(c as i32)%16;
                    let hc:u8=(48+hi) as u8;
                    if(hi>=10){hc=(87+hi) as u8;}
                    let lc:u8=(48+lo) as u8;
                    if(lo>=10){lc=(87+lo) as u8;}
                    at=ab_byte(dst,at,hc); at=ab_byte(dst,at,lc);
                } else {at=ab_byte(dst,at,c);}
            }
        }
        if(at<0){return -1;}
        i=i+1;
    }
    at=ab_byte(dst,at,34);
    return at;
}

// One banned-hit detail object appended to the jt buffer.
// jt starts as "["; jlp[0] is the write cursor; nhp[0] counts hits.
// Returns 0 ok, -1 on buffer overflow.
fn emit_hit(jt:[]u8, jlp:[]i32, nhp:[]i32, rule:[]u8, file:[]u8, line:i32, text:[]u8)i32 {
    let jl:i32=jlp[0];
    if(jl>1){jl=ab_byte(jt,jl,44);}
    jl=ab_byte(jt,jl,123);
    jl=ab_quoted(jt,jl,"rule"); jl=ab_byte(jt,jl,58); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,rule);
    jl=ab_byte(jt,jl,44); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,"file"); jl=ab_byte(jt,jl,58); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,file);
    jl=ab_byte(jt,jl,44); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,"line"); jl=ab_byte(jt,jl,58); jl=ab_byte(jt,jl,32);
    jl=ab_i64(jt,jl,line as i64);
    jl=ab_byte(jt,jl,44); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,"text"); jl=ab_byte(jt,jl,58); jl=ab_byte(jt,jl,32);
    jl=ab_quoted(jt,jl,text);
    jl=ab_byte(jt,jl,125);
    if(jl<0){return -1;}
    jlp[0]=jl;
    nhp[0]=nhp[0]+1;
    return 0;
}

// ---------------- file IO ----------------
// split_dir: fill dir/name buffers; returns (dirlen<<32)|namelen, or -1 if no '/'.
fn split_dir(p:[]u8, dir:[]u8, name:[]u8)i64 {
    let cut:i32=-1;
    let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;} i=i+1;}
    if(cut<0){return -1;}
    let dl:i32=cut;
    if(cut==0){dl=1;}
    if(dl>dir.len || p.len-cut-1>name.len){return -1;}
    if(cut==0){dir[0]=47;}
    else {let k:i32=0; while(k<cut){dir[k]=p[k]; k=k+1;}}
    let nl:i32=p.len-cut-1;
    let k2:i32=0;
    while(k2<nl){name[k2]=p[cut+1+k2]; k2=k2+1;}
    return ((dl as i64)*4294967296)+(nl as i64);
}

// read_file: read whole file into buf starting at offset at (up to buf.len).
// Returns total bytes in buf from at (i.e. bytes read), or negative on error.
fn read_file(p:[]u8, buf:[]u8, at:i32)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -11;}
    let sp:i64=split_dir(p,dir,name);
    if(sp<0){
        // no slash: treat as name in "."
        dir[0]=46;
        if(p.len>name.len){nio_free(dir); nio_free(name); return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k]; k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir); nio_free(name); return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],0);
    if(fd<0){nio_free(dir); nio_free(name); return -14;}
    let n:i64=nio_read_exact(fd,buf[at..buf.len],buf.len-at);
    let cr:i64=nio_close(fd);
    if(cr!=0){n=-15;}
    nio_free(dir); nio_free(name);
    return n;
}

// write_file: create (O_EXCL) and write n bytes. Caller must rm -f first.
fn write_file(p:[]u8, data:[]u8, n:i32)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir); nio_free(name); return -11;}
    let sp:i64=split_dir(p,dir,name);
    if(sp<0){
        // no slash: treat as name in "."
        dir[0]=46;
        if(p.len>name.len){nio_free(dir); nio_free(name); return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k]; k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir); nio_free(name); return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],1);
    if(fd<0){nio_free(dir); nio_free(name); return -14;}
    let w:i64=nio_write_all(fd,data[0..n]);
    let cr:i64=nio_close(fd);
    nio_free(dir); nio_free(name);
    if(w<0){return -16;}
    if(cr!=0){return -15;}
    return n as i64;
}

// ---------------- line processing ----------------
// strip_line: produce two versions of the raw line:
//   nc_out: comments blanked, string literals INTACT (for @import parsing).
//   cb_out: comments AND string literals blanked (for identifier rules).
// Returns 0 ok, -1 if /* opener found outside a string (FAIL per prereg).
fn strip_line(raw:[]u8, nc_out:[]u8, cb_out:[]u8)i32 {
    let in_str:i32=0;
    let i:i32=0;
    while(i<raw.len){
        let c:u8=raw[i];
        if(in_str==1){
            nc_out[i]=c; cb_out[i]=32;
            if(c==92){
                if(i+1<raw.len){nc_out[i+1]=raw[i+1]; cb_out[i+1]=32; i=i+1;}
            } else {
                if(c==34){in_str=0;}
            }
        } else {
            if(c==34){in_str=1; nc_out[i]=c; cb_out[i]=32;}
            else {
                if(c==47 && i+1<raw.len && raw[i+1]==47){
                    while(i<raw.len){nc_out[i]=32; cb_out[i]=32; i=i+1;}
                } else {
                    if(c==47 && i+1<raw.len && raw[i+1]==42){return -1;}
                    nc_out[i]=c; cb_out[i]=c;
                }
            }
        }
        i=i+1;
    }
    return 0;
}

// scan_literals: for each "..." literal in raw (escape-aware), check banned
// paths (rule 4.1/4.6). Emits hits directly. Returns 0 ok, -1 on error.
fn scan_literals(raw:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8, lineno:i32)i32 {
    let i:i32=0;
    while(i<raw.len){
        if(raw[i]==34){
            let s:i32=i+1;
            let e:i32=s;
            while(e<raw.len){
                if(raw[e]==92){e=e+2;}
                else {if(raw[e]==34){break;} e=e+1;}
            }
            if(e>=raw.len){break;}
            let lit:[]u8=raw[s..e];
            let low:[]u8=nio_alloc(lit.len+1);
            if(low.len!=lit.len+1){return -1;}
            to_lower_buf(lit,low);
            let lowlit:[]u8=low[0..lit.len];
            if(contains(lowlit,"/dev/urandom")>0 || contains(lowlit,"/dev/random")>0){
                let msg:[]u8=nio_alloc(lit.len+32);
                if(msg.len==lit.len+32){
                    let ml:i32=ab(msg,0,"string literal: ");
                    ml=ab(msg,ml,lit);
                    if(emit_hit(jt,jlp,nhp,"4.1/4.6",file,lineno,msg[0..ml])<0){nio_free(low); nio_free(msg); return -1;}
                }
                nio_free(msg);
            } else {
                if(contains(lowlit,"getrandom")>0){
                    if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"string literal mentions getrandom")<0){nio_free(low); return -1;}
                }
            }
            nio_free(low);
            i=e+1;
        } else {i=i+1;}
    }
    return 0;
}

// ---------------- banned identifier rules (BAN-2026-09-20-v2, §4.7 mapping) ----------------
// code_low: lowercased code part of the line (literals blanked).
// carve: 1 if the line contains lookup_table/pin_table (4.4 carve-out).
fn check_ident_rules(code_low:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8, lineno:i32, carve:i32)i32 {
    // 4.1 entropy
    if(contains(code_low,"getrandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'getrandom'")<0){return -1;}
    }
    if(contains(code_low,"urandom")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'urandom'")<0){return -1;}
    }
    if(contains(code_low,"random")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'random'")<0){return -1;}
    }
    if(contains(code_low,"rdseed")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'rdseed'")<0){return -1;}
    }
    if(contains(code_low,"rdrand")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token 'rdrand'")<0){return -1;}
    }
    if(contains(code_low,"/dev/random")>0){
        if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"banned token '/dev/random'")<0){return -1;}
    }
    // 4.2 wall-clock
    if(contains(code_low,"clock_gettime")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'clock_gettime'")<0){return -1;}
    }
    if(contains(code_low,"gettimeofday")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'gettimeofday'")<0){return -1;}
    }
    if(contains(code_low,"rdtsc")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'rdtsc'")<0){return -1;}
    }
    if(contains(code_low,"rdpmc")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'rdpmc'")<0){return -1;}
    }
    if(contains(code_low,"time(")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'time('")<0){return -1;}
    }
    if(contains(code_low,"date.now")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'date.now'")<0){return -1;}
    }
    if(contains(code_low,"performance.now")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'performance.now'")<0){return -1;}
    }
    if(contains(code_low,"nio_deadline")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_deadline'")<0){return -1;}
    }
    if(contains(code_low,"nio_metric")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_metric'")<0){return -1;}
    }
    if(contains(code_low,"nio_guard")>0){
        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"banned token 'nio_guard'")<0){return -1;}
    }
    // 4.4 hash-iteration (carve-out for pinned-table identifiers)
    if(carve==0){
        if(contains(code_low,"hashmap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'hashmap'")<0){return -1;}
        }
        if(contains(code_low,"hash_map")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'hash_map'")<0){return -1;}
        }
        if(contains(code_low,"unordered")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'unordered'")<0){return -1;}
        }
        if(contains(code_low,"dict")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'dict'")<0){return -1;}
        }
        if(contains(code_low,"bucket")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'bucket'")<0){return -1;}
        }
        if(contains(code_low,"slotmap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'slotmap'")<0){return -1;}
        }
        if(contains(code_low,"htable")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'htable'")<0){return -1;}
        }
        if(contains(code_low,"treemap")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'treemap'")<0){return -1;}
        }
        if(contains(code_low,"map_iter")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'map_iter'")<0){return -1;}
        }
        if(contains(code_low,"dict_iter")>0){
            if(emit_hit(jt,jlp,nhp,"4.4",file,lineno,"banned token 'dict_iter'")<0){return -1;}
        }
    }
    // 4.5 impure-of-inputs
    if(contains(code_low,"_zag_slice_ptr")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '_zag_slice_ptr'")<0){return -1;}
    }
    if(contains(code_low,"_zag_cstr_ptr")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '_zag_cstr_ptr'")<0){return -1;}
    }
    if(contains(code_low,"getenv")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'getenv'")<0){return -1;}
    }
    if(contains(code_low,"environ")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'environ'")<0){return -1;}
    }
    if(contains(code_low,"env_")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'env_'")<0){return -1;}
    }
    if(contains(code_low,"pthread")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'pthread'")<0){return -1;}
    }
    if(contains(code_low,"thread")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'thread'")<0){return -1;}
    }
    if(contains(code_low,"spawn")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'spawn'")<0){return -1;}
    }
    if(contains(code_low,"go func")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'go func'")<0){return -1;}
    }
    if(contains(code_low,"memcpy")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'memcpy'")<0){return -1;}
    }
    if(contains(code_low,"__asm__")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token '__asm__'")<0){return -1;}
    }
    if(contains(code_low,"asm(")>0){
        if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"banned token 'asm('")<0){return -1;}
    }
    // 4.5 pointer-cast approximation: as i64/u64 on a ptr/cstr line
    if(contains(code_low," as i64")>0 || contains(code_low," as u64")>0){
        if(contains(code_low,"ptr")>0 || contains(code_low,"cstr")>0){
            if(emit_hit(jt,jlp,nhp,"4.5",file,lineno,"pointer cast 'as i64/u64' on ptr/cstr line")<0){return -1;}
        }
    }
    // 4.8 dynamic dispatch: fn* literal; eval as a whole word
    if(contains(code_low,"fn*")>0){
        if(emit_hit(jt,jlp,nhp,"4.8",file,lineno,"banned token 'fn*'")<0){return -1;}
    }
    let ep:i32=find_sub(code_low,"eval",0);
    while(ep>=0){
        let lok:i32=1;
        if(ep>0 && is_idchar(code_low[ep-1])>0){lok=0;}
        if(ep+4<code_low.len && is_idchar(code_low[ep+4])>0){lok=0;}
        if(lok==1){
            if(emit_hit(jt,jlp,nhp,"4.8",file,lineno,"banned token 'eval'")<0){return -1;}
            break;
        }
        ep=find_sub(code_low,"eval",ep+1);
    }
    return 0;
}

// _zag_raw_syscall(<num>,...) with a literal banned number.
fn check_syscall_imm(code_low:[]u8, jt:[]u8, jlp:[]i32, nhp:[]i32, file:[]u8, lineno:i32)i32 {
    let tag:[]u8="_zag_raw_syscall(";
    let p:i32=find_sub(code_low,tag,0);
    while(p>=0){
        let q:i32=p+tag.len;
        while(q<code_low.len && (code_low[q]==32 || code_low[q]==9)){q=q+1;}
        let neg:i32=0;
        if(q<code_low.len && code_low[q]==45){neg=1; q=q+1;}
        if(q<code_low.len && code_low[q]>=48 && code_low[q]<=57){
            let v:i64=0;
            let nd:i32=0;
            while(q<code_low.len && code_low[q]>=48 && code_low[q]<=57 && nd<12){
                v=v*10+((code_low[q]-48) as i64); q=q+1; nd=nd+1;
            }
            let r:i32=q;
            while(r<code_low.len && (code_low[r]==32 || code_low[r]==9)){r=r+1;}
            if(r<code_low.len && (code_low[r]==44 || code_low[r]==41)){
                if(neg==1){v=0-v;}
                if(v==318){
                    if(emit_hit(jt,jlp,nhp,"4.1",file,lineno,"_zag_raw_syscall(getrandom=318)")<0){return -1;}
                } else {
                    if(v==228){
                        if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"_zag_raw_syscall(clock_gettime=228)")<0){return -1;}
                    } else {
                        if(v==96){
                            if(emit_hit(jt,jlp,nhp,"4.2",file,lineno,"_zag_raw_syscall(gettimeofday=96)")<0){return -1;}
                        }
                    }
                }
            }
        }
        p=find_sub(code_low,tag,p+1);
    }
    return 0;
}

fn starts_with(s:[]u8, p:[]u8)i32 {
    if(s.len<p.len){return 0;}
    let i:i32=0;
    while(i<p.len){if(s[i]!=p[i]){return 0;} i=i+1;}
    return 1;
}

// parse_import: bare @import("path") on the no-comment line (literals intact).
// Copies the path into out; returns path length, or 0 if not a bare import.
fn parse_import(nc:[]u8, out:[]u8)i32 {
    let t:[]u8=trim_left(nc);
    if(starts_with(t,"@import(")==0){return 0;}
    let q:i32=8;
    while(q<t.len && (t[q]==32 || t[q]==9)){q=q+1;}
    if(q>=t.len || t[q]!=34){return 0;}
    q=q+1;
    let s:i32=q;
    while(q<t.len && t[q]!=34){q=q+1;}
    if(q>=t.len){return 0;}
    let L:i32=q-s;
    if(L>out.len){return 0;}
    let i:i32=0;
    while(i<L){out[i]=t[s+i]; i=i+1;}
    return L;
}

// ---------------- line access ----------------
// get_line: copy line k (0-based, global) into dst, minus trailing newline.
// Returns length, or -1 on error.
fn get_line(src:[]u8, loff:[]i32, nlines:i32, k:i32, dst:[]u8)i32 {
    if(k<0 || k>=nlines){return -1;}
    let s:i32=loff[k];
    let e:i32=loff[k+1];
    while(e>s && (src[e-1]==10 || src[e-1]==13)){e=e-1;}
    let L:i32=e-s;
    if(L>dst.len || L<0){return -1;}
    let i:i32=0;
    while(i<L){dst[i]=src[s+i]; i=i+1;}
    return L;
}

// brace_end: from line k, brace-match on code-blanked lines; returns the end
// line in [k..fe], or k if no balanced block found.
fn brace_end(src:[]u8, loff:[]i32, nlines:i32, k:i32, fe:i32, nc1:[]u8, cb1:[]u8)i32 {
    let depth:i32=0;
    let seen:i32=0;
    let j:i32=k;
    while(j<=fe){
        let L:i32=get_line(src,loff,nlines,j,nc1);
        if(L<0){return k;}
        let raw:[]u8=nc1[0..L];
        if(strip_line(raw,nc1,cb1)<0){j=j+1; continue;}
        let c:i32=0;
        while(c<L){
            if(cb1[c]==123){depth=depth+1; seen=1;}
            else {if(cb1[c]==125){depth=depth-1;}}
            c=c+1;
        }
        if(seen==1 && depth==0){return j;}
        j=j+1;
    }
    return k;
}

// find_init_loop: find a while(...vname.len...) loop in [fs..fe] whose body
// writes vname[. Returns the loop end line, or -1. retp[0]=1 if the body
// contains a return (init not guaranteed complete).
fn find_init_loop(src:[]u8, loff:[]i32, nlines:i32, fs:i32, fe:i32, vname:[]u8,
                 retp:[]i32, nc1:[]u8, cb1:[]u8, low1:[]u8, pat1:[]u8, pat2:[]u8)i32 {
    if(vname.len+5>128){return -1;}
    let pl:i32=ab(pat1,0,vname); pl=ab(pat1,pl,".len");
    if(pl<0){return -1;}
    let wantlen:[]u8=pat1[0..pl];
    let bl:i32=ab(pat2,0,vname); bl=ab(pat2,bl,"[");
    if(bl<0){return -1;}
    let wpat:[]u8=pat2[0..bl];
    let k:i32=fs;
    while(k<=fe){
        let L:i32=get_line(src,loff,nlines,k,nc1);
        if(L<0){return -1;}
        let raw:[]u8=nc1[0..L];
        if(strip_line(raw,nc1,cb1)<0){k=k+1; continue;}
        to_lower_buf(cb1[0..L],low1);
        let low:[]u8=low1[0..L];
        if(contains(low,"while")>0 && contains(low,wantlen)>0){
            let e:i32=brace_end(src,loff,nlines,k,fe,nc1,cb1);
            let writes:i32=0;
            retp[0]=0;
            let j:i32=k;
            while(j<=e){
                let L2:i32=get_line(src,loff,nlines,j,nc1);
                if(L2<0){break;}
                let raw2:[]u8=nc1[0..L2];
                if(strip_line(raw2,nc1,cb1)==0){
                    to_lower_buf(cb1[0..L2],low1);
                    let low2:[]u8=low1[0..L2];
                    if(contains(low2,wpat)>0){writes=1;}
                    if(contains(low2,"return")>0){retp[0]=1;}
                }
                j=j+1;
            }
            if(writes==1){return e;}
        }
        k=k+1;
    }
    return -1;
}

// scan_uninit: rule 4.3 dataflow for one function [fs..fe] (global line idx).
fn scan_uninit(src:[]u8, loff:[]i32, nlines:i32, fs:i32, fe:i32, file:[]u8,
               jt:[]u8, jlp:[]i32, nhp:[]i32,
               nc1:[]u8, cb1:[]u8, low1:[]u8, pat1:[]u8, pat2:[]u8, txt:[]u8)i32 {
    let vbuf:[]u8=nio_alloc(16384);
    let voffr:[]u8=nio_alloc(512); let voff:[]i32=voffr as []i32;
    let vlnr:[]u8=nio_alloc(512); let vln:[]i32=vlnr as []i32;
    let vstr:[]u8=nio_alloc(512); let vst:[]i32=vstr as []i32;
    let valr:[]u8=nio_alloc(512); let valn:[]i32=valr as []i32;
    let vier:[]u8=nio_alloc(512); let vie:[]i32=vier as []i32;
    if(vbuf.len!=16384){return -1;}
    let nv:i32=0;
    let vlen:i32=0;
    // pass 1: collect nio_alloc'd variable names (lowercased)
    let k:i32=fs;
    while(k<=fe){
        let L:i32=get_line(src,loff,nlines,k,nc1);
        if(L<0){break;}
        let raw:[]u8=nc1[0..L];
        if(strip_line(raw,nc1,cb1)==0){
            to_lower_buf(cb1[0..L],low1);
            let low:[]u8=low1[0..L];
            if(contains(low,"nio_alloc(")>0){
                let p:i32=find_sub(low,"let ",0);
                while(p>=0 && nv<128){
                    let oklet:i32=1;
                    if(p>0 && is_idchar(low[p-1])>0){oklet=0;}
                    if(oklet==1){
                        let ns:i32=p+4;
                        while(ns<low.len && (low[ns]==32||low[ns]==9)){ns=ns+1;}
                        let ne:i32=ns;
                        while(ne<low.len && is_idchar(low[ne])>0){ne=ne+1;}
                        if(ne>ns && ne-ns<100 && vlen+ne-ns<16384){
                            let dup:i32=0;
                            let d:i32=0;
                            while(d<nv){
                                let on:[]u8=vbuf[voff[d]..voff[d]+vln[d]];
                                if(eq_bytes(on,low[ns..ne])>0){dup=1;}
                                d=d+1;
                            }
                            if(dup==0){
                                voff[nv]=vlen; vln[nv]=ne-ns;
                                let c2:i32=0;
                                while(c2<ne-ns){vbuf[vlen+c2]=low[ns+c2]; c2=c2+1;}
                                vlen=vlen+ne-ns;
                                vst[nv]=0; valn[nv]=k+1; vie[nv]=-1;
                                nv=nv+1;
                            }
                        }
                    }
                    p=find_sub(low,"let ",p+1);
                }
            }
        }
        k=k+1;
    }
    // precompute init-loop ends
    let retc:[]u8=nio_alloc(4); let retp:[]i32=retc as []i32;
    let v:i32=0;
    while(v<nv){
        let vn:[]u8=vbuf[voff[v]..voff[v]+vln[v]];
        retp[0]=0;
        let e:i32=find_init_loop(src,loff,nlines,fs,fe,vn,retp,nc1,cb1,low1,pat1,pat2);
        if(e>=0 && retp[0]==0){vie[v]=e;}
        v=v+1;
    }
    // pass 2: per-line free/init/read-write tracking
    k=fs;
    while(k<=fe){
        let L2:i32=get_line(src,loff,nlines,k,nc1);
        if(L2<0){break;}
        let raw2:[]u8=nc1[0..L2];
        if(strip_line(raw2,nc1,cb1)==0){
            to_lower_buf(cb1[0..L2],low1);
            let low:[]u8=low1[0..L2];
            v=0;
            while(v<nv){
                let vn2:[]u8=vbuf[voff[v]..voff[v]+vln[v]];
                // nio_free(NAME) marks freed (path-insensitive: documented)
                let fl:i32=ab(pat2,0,"nio_free("); fl=ab(pat2,fl,vn2); fl=ab(pat2,fl,")");
                if(fl>0 && contains(low,pat2[0..fl])>0){vst[v]=2;}
                // init completion once past the loop end
                if(vst[v]==0 && vie[v]>=0 && k>vie[v]){vst[v]=1;}
                // access check: NAME[ occurrences with left boundary
                let wl:i32=ab(pat2,0,vn2); wl=ab(pat2,wl,"[");
                if(wl>0){
                    let wpat:[]u8=pat2[0..wl];
                    let p2:i32=find_sub(low,wpat,0);
                    while(p2>=0){
                        let okb:i32=1;
                        if(p2>0 && is_idchar(low[p2-1])>0){okb=0;}
                        if(okb==1){
                            let q:i32=find_sub(low,"]",p2);
                            let is_write:i32=0;
                            if(q>=0){
                                let r:i32=q+1;
                                while(r<low.len && (low[r]==32||low[r]==9)){r=r+1;}
                                if(r<low.len && low[r]==61 && (r+1>=low.len || low[r+1]!=61)){is_write=1;}
                            }
                            if(is_write==0 && vst[v]!=1){
                                let tl:i32=ab(txt,0,"read of ");
                                tl=ab(txt,tl,vn2);
                                if(vst[v]==2){tl=ab(txt,tl,"[after free]");}
                                else {tl=ab(txt,tl,"[uninit]");}
                                tl=ab(txt,tl," before full init (alloc line ");
                                tl=ab_i64(txt,tl,valn[v] as i64);
                                tl=ab_byte(txt,tl,41);
                                if(tl>0){
                                    if(emit_hit(jt,jlp,nhp,"4.3",file,k+1,txt[0..tl])<0){
                                        nio_free(vbuf); nio_free(voffr); nio_free(vlnr);
                                        nio_free(vstr); nio_free(valr); nio_free(vier);
                                        nio_free(retc);
                                        return -1;
                                    }
                                }
                                vst[v]=1;
                            }
                        }
                        p2=find_sub(low,wpat,p2+1);
                    }
                }
                v=v+1;
            }
        }
        k=k+1;
    }
    nio_free(vbuf); nio_free(voffr); nio_free(vlnr);
    nio_free(vstr); nio_free(valr); nio_free(vier); nio_free(retc);
    return 0;
}

// ---------------- small helpers ----------------

fn le32(b:[]u8, at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)*256)+((b[at+2] as i64)*65536)+((b[at+3] as i64)*16777216);
}

fn parse_i64(s:[]u8)i64 {
    let i:i32=0;
    while(i<s.len && (s[i]==32 || s[i]==9)){i=i+1;}
    let neg:i32=0;
    if(i<s.len && s[i]==45){neg=1; i=i+1;}
    if(i>=s.len || s[i]<48 || s[i]>57){return -1;}
    let v:i64=0;
    while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+((s[i]-48) as i64); i=i+1;}
    while(i<s.len && (s[i]==32 || s[i]==9 || s[i]==13)){i=i+1;}
    if(i!=s.len){return -1;}
    if(neg==1){v=0-v;}
    return v;
}

fn is_vendored(path:[]u8)i32 {
    if(ends_with(path,"R33_NATIVE_SHA256_V2.zag")>0){return 1;}
    if(ends_with(path,"R33_NATIVE_IO_V1.zag")>0){return 1;}
    return 0;
}

// pool_add: copy s into pool at pool_len; returns offset, or -1 on overflow.
fn pool_add(pool:[]u8, pool_len:i32, s:[]u8)i32 {
    if(pool_len+s.len>pool.len){return -1;}
    let i:i32=0;
    while(i<s.len){pool[pool_len+i]=s[i]; i=i+1;}
    return pool_len;
}

// index_lines: append line-start offsets for bytes [b0..b1) into loff.
// Returns new nlines, or -1 on overflow.
fn index_lines(src:[]u8, loff:[]i32, nlines:i32, b0:i32, b1:i32, cap:i32)i32 {
    if(nlines+2>=cap){return -1;}
    loff[nlines]=b0; nlines=nlines+1;
    let p:i32=b0;
    while(p<b1){
        if(src[p]==10){
            if(nlines+2>=cap){return -1;}
            loff[nlines]=p+1; nlines=nlines+1;
        }
        p=p+1;
    }
    // end sentinel: get_line(k) reads loff[k+1] for k<nlines
    if(nlines+1>=cap){return -1;}
    loff[nlines]=b1;
    return nlines;
}

// ---------------- main ----------------
fn main()i32 {
    let modp:[]u8=_zag_arg(1);
    let binp:[]u8=_zag_arg(2);
    let evp:[]u8=_zag_arg(3);
    let attp:[]u8=_zag_arg(4);
    if(modp.len==0 || binp.len==0 || evp.len==0 || attp.len==0){
        _zag_println("usage: rngscan_v2 <module.zag> <module-binary> <replay-evidence> <attestation.json>");
        return 2;
    }
    // buffers (all < 2^25)
    let src:[]u8=nio_alloc(8388608);
    let pool:[]u8=nio_alloc(1048576);
    let jt:[]u8=nio_alloc(2097152);
    let jb:[]u8=nio_alloc(4194304);
    let bin:[]u8=nio_alloc(16777216);
    let evb:[]u8=nio_alloc(4096);
    let raw1:[]u8=nio_alloc(16384);
    let nc1:[]u8=nio_alloc(16384);
    let cb1:[]u8=nio_alloc(16384);
    let low1:[]u8=nio_alloc(16384);
    let pat1:[]u8=nio_alloc(256);
    let pat2:[]u8=nio_alloc(256);
    let txt:[]u8=nio_alloc(512);
    let impb:[]u8=nio_alloc(4096);
    let fullb:[]u8=nio_alloc(8192);
    let h32:[]u8=nio_alloc(32);
    let hexb:[]u8=nio_alloc(64);
    let pinb:[]u8=nio_alloc(4096);
    if(src.len!=8388608 || jt.len!=2097152 || jb.len!=4194304){_zag_println("NOMEM"); return 2;}
    // int tables via cast (lengths tracked manually)
    let loffr:[]u8=nio_alloc(800004); let loff:[]i32=loffr as []i32;
    let fb0r:[]u8=nio_alloc(256); let fb0:[]i32=fb0r as []i32;
    let fb1r:[]u8=nio_alloc(256); let fb1:[]i32=fb1r as []i32;
    let fl0r:[]u8=nio_alloc(256); let fl0:[]i32=fl0r as []i32;
    let fl1r:[]u8=nio_alloc(256); let fl1:[]i32=fl1r as []i32;
    let fpor:[]u8=nio_alloc(256); let fpoff:[]i32=fpor as []i32;
    let fplr:[]u8=nio_alloc(256); let fplen:[]i32=fplr as []i32;
    let fscr:[]u8=nio_alloc(256); let fscan:[]i32=fscr as []i32;
    let fnor:[]u8=nio_alloc(2048); let fname_off:[]i32=fnor as []i32;
    let fnlr:[]u8=nio_alloc(2048); let fname_len:[]i32=fnlr as []i32;
    let fnfr:[]u8=nio_alloc(2048); let fn_file:[]i32=fnfr as []i32;
    let fnsr:[]u8=nio_alloc(2048); let fn_start:[]i32=fnsr as []i32;
    let fner:[]u8=nio_alloc(2048); let fn_end:[]i32=fner as []i32;
    let stkr:[]u8=nio_alloc(2048); let stack:[]i32=stkr as []i32;
    let rchr:[]u8=nio_alloc(2048); let reach:[]i32=rchr as []i32;
    let jlpr:[]u8=nio_alloc(4); let jlp:[]i32=jlpr as []i32;
    let nhpr:[]u8=nio_alloc(4); let nhp:[]i32=nhpr as []i32;
    jlp[0]=1; nhp[0]=0;
    jt[0]=91;
    let srclen:i32=0;
    let pool_len:i32=0;
    let nfiles:i32=0;
    let nlines:i32=0;
    let nfns:i32=0;
    let ops_checked:i32=0;
    let npinned:i32=0;
    // module dir for import resolution
    let cut:i32=-1;
    let ci:i32=0;
    while(ci<modp.len){if(modp[ci]==47){cut=ci;} ci=ci+1;}
    let moddir:[]u8=modp[0..0];
    let dotm:[]u8=nio_alloc(1);
    dotm[0]=46;
    if(cut>0){moddir=modp[0..cut];}
    if(cut==0){moddir=modp[0..1];}
    if(cut<0){moddir=dotm;}
    // ---- load module (file 0) ----
    let n0:i64=read_file(modp,src,0);
    if(n0<0 || n0>8388608){_zag_println("cannot read module"); return 2;}
    srclen=n0 as i32;
    let po:i32=pool_add(pool,pool_len,modp);
    if(po<0){_zag_println("pool full"); return 2;}
    fpoff[0]=po; fplen[0]=modp.len; pool_len=po+modp.len;
    fb0[0]=0; fb1[0]=srclen; fscan[0]=1;
    fl0[0]=0;
    nlines=index_lines(src,loff,nlines,0,srclen,200001);
    if(nlines<0){_zag_println("too many lines"); return 2;}
    fl1[0]=nlines;
    nfiles=1;
    // ---- transitive import loop (bare @import only) ----
    let fi:i32=0;
    while(fi<nfiles){
        let fpath:[]u8=pool[fpoff[fi]..fpoff[fi]+fplen[fi]];
        let k:i32=fl0[fi];
        while(k<fl1[fi]){
            let L:i32=get_line(src,loff,nlines,k,raw1);
            if(L<0){_zag_println("line read error"); return 2;}
            let r:i32=strip_line(raw1[0..L],nc1,cb1);
            if(r<0){
                if(emit_hit(jt,jlp,nhp,"SRC",fpath,k+1,"block comment /* */ on variation path (unsupported)")<0){_zag_println("hit buffer full"); return 2;}
            } else {
                let il:i32=parse_import(nc1[0..L],impb);
                if(il>0 && il<4096){
                    let imp:[]u8=impb[0..il];
                    let fl2:i32=ab(fullb,0,moddir);
                    fl2=ab_byte(fullb,fl2,47);
                    fl2=ab(fullb,fl2,imp);
                    if(fl2>0){
                        let full:[]u8=fullb[0..fl2];
                        let seen:i32=0;
                        let g:i32=0;
                        while(g<nfiles){
                            let gp:[]u8=pool[fpoff[g]..fpoff[g]+fplen[g]];
                            if(eq_bytes(gp,full)>0){seen=1;}
                            g=g+1;
                        }
                        if(seen==0 && nfiles<64){
                            let nn:i64=read_file(full,src,srclen);
                            if(nn<0 || srclen+(nn as i32)>8388608){_zag_println("cannot read import"); return 2;}
                            let po2:i32=pool_add(pool,pool_len,full);
                            if(po2<0){_zag_println("pool full"); return 2;}
                            fpoff[nfiles]=po2; fplen[nfiles]=full.len; pool_len=po2+full.len;
                            fb0[nfiles]=srclen; srclen=srclen+(nn as i32); fb1[nfiles]=srclen;
                            if(is_vendored(full)>0){fscan[nfiles]=0;} else {fscan[nfiles]=1;}
                            fl0[nfiles]=nlines;
                            nlines=index_lines(src,loff,nlines,fb0[nfiles],fb1[nfiles],200001);
                            if(nlines<0){_zag_println("too many lines"); return 2;}
                            fl1[nfiles]=nlines;
                            nfiles=nfiles+1;
                        }
                    }
                }
            }
            k=k+1;
        }
        fi=fi+1;
    }
    loff[nlines]=srclen;
    // ---- source scan (variation path only) ----
    fi=0;
    while(fi<nfiles){
        if(fscan[fi]==1){
            let fpath2:[]u8=pool[fpoff[fi]..fpoff[fi]+fplen[fi]];
            let k2:i32=fl0[fi];
            while(k2<fl1[fi]){
                let L2:i32=get_line(src,loff,nlines,k2,raw1);
                if(L2<0){_zag_println("line read error"); return 2;}
                let r2:i32=strip_line(raw1[0..L2],nc1,cb1);
                if(r2==0){
                    let nc:[]u8=nc1[0..L2];
                    if(is_blank(nc)==0){
                        ops_checked=ops_checked+1;
                        if(scan_literals(raw1[0..L2],jt,jlp,nhp,fpath2,k2+1)<0){_zag_println("literal scan err"); return 2;}
                        to_lower_buf(cb1[0..L2],low1);
                        let low:[]u8=low1[0..L2];
                        let carve:i32=0;
                        if(contains(low,"lookup_table")>0 || contains(low,"pin_table")>0){carve=1;}
                        if(check_ident_rules(low,jt,jlp,nhp,fpath2,k2+1,carve)<0){_zag_println("rule scan err"); return 2;}
                        if(check_syscall_imm(low,jt,jlp,nhp,fpath2,k2+1)<0){_zag_println("imm scan err"); return 2;}
                    }
                }
                k2=k2+1;
            }
        }
        fi=fi+1;
    }
    // ---- collect fns (variation path) ----
    fi=0;
    while(fi<nfiles){
        if(fscan[fi]==1){
            let k3:i32=fl0[fi];
            while(k3<fl1[fi]){
                let L3:i32=get_line(src,loff,nlines,k3,raw1);
                if(L3>=0 && strip_line(raw1[0..L3],nc1,cb1)==0){
                    let t:[]u8=trim_left(cb1[0..L3]);
                    if(starts_with(t,"fn ")>0 && nfns<512){
                        let ns3:i32=3;
                        while(ns3<t.len && (t[ns3]==32||t[ns3]==9)){ns3=ns3+1;}
                        let ne3:i32=ns3;
                        while(ne3<t.len && is_idchar(t[ne3])>0){ne3=ne3+1;}
                        if(ne3>ns3 && ne3-ns3<100){
                            let nl4:i32=ne3-ns3;
                            let po3:i32=pool_add(pool,pool_len,t[ns3..ne3]);
                            if(po3>=0 && po3+nl4<=pool.len){
                                let q4:i32=0;
                                while(q4<nl4){
                                    let cc:u8=pool[po3+q4];
                                    if(cc>=65 && cc<=90){pool[po3+q4]=cc+32;}
                                    q4=q4+1;
                                }
                                let e3:i32=brace_end(src,loff,nlines,k3,fl1[fi]-1,nc1,cb1);
                                fname_off[nfns]=po3; fname_len[nfns]=nl4;
                                fn_file[nfns]=fi; fn_start[nfns]=k3; fn_end[nfns]=e3;
                                pool_len=po3+nl4;
                                nfns=nfns+1;
                            }
                        }
                    }
                }
                k3=k3+1;
            }
        }
        fi=fi+1;
    }
    // ---- rule 4.3 dataflow per fn ----
    let fni:i32=0;
    while(fni<nfns){
        let ff:[]i32=fpoff;
        let ffp:[]u8=pool[ff[fn_file[fni]]..ff[fn_file[fni]]+fplen[fn_file[fni]]];
        if(scan_uninit(src,loff,nlines,fn_start[fni],fn_end[fni],ffp,jt,jlp,nhp,
                       nc1,cb1,low1,pat1,pat2,txt)<0){_zag_println("dataflow err"); return 2;}
        fni=fni+1;
    }
    // ---- call graph from vary_expr ----
    let entry:i32=-1;
    fni=0;
    while(fni<nfns){
        let enn:[]u8=pool[fname_off[fni]..fname_off[fni]+fname_len[fni]];
        if(eq_bytes(enn,"vary_expr")>0){entry=fni;}
        fni=fni+1;
    }
    let ncallees:i32=0;
    if(entry<0){
        if(emit_hit(jt,jlp,nhp,"ENTRY",modp,0,"variation_path_entry 'vary_expr' not found")<0){_zag_println("hit err"); return 2;}
    } else {
        let sp2:i32=0;
        stack[0]=entry; sp2=1; reach[entry]=1;
        while(sp2>0){
            sp2=sp2-1;
            let cf:i32=stack[sp2];
            let g:i32=0;
            while(g<nfns){
                if(g!=cf && reach[g]==0){
                    let gn:[]u8=pool[fname_off[g]..fname_off[g]+fname_len[g]];
                    let pl5:i32=ab(pat1,0,gn); pl5=ab(pat1,pl5,"(");
                    let foundcall:i32=0;
                    if(pl5>0){
                        let pat:[]u8=pat1[0..pl5];
                        let k4:i32=fn_start[cf];
                        while(k4<=fn_end[cf] && foundcall==0){
                            let L4:i32=get_line(src,loff,nlines,k4,raw1);
                            if(L4>=0 && strip_line(raw1[0..L4],nc1,cb1)==0){
                                to_lower_buf(cb1[0..L4],low1);
                                let low4:[]u8=low1[0..L4];
                                let p5:i32=find_sub(low4,pat,0);
                                while(p5>=0 && foundcall==0){
                                    let okb2:i32=1;
                                    if(p5>0 && is_idchar(low4[p5-1])>0){okb2=0;}
                                    if(okb2==1){foundcall=1;}
                                    p5=find_sub(low4,pat,p5+1);
                                }
                            }
                            k4=k4+1;
                        }
                    }
                    if(foundcall==1 && sp2<512){reach[g]=1; stack[sp2]=g; sp2=sp2+1;}
                }
                g=g+1;
            }
        }
        let g2:i32=0;
        while(g2<nfns){
            if(reach[g2]==1 && g2!=entry){ncallees=ncallees+1;}
            g2=g2+1;
        }
    }
    // ---- PINNED tables (file 0 raw text) ----
    let k5:i32=fl0[0];
    while(k5<fl1[0] && npinned<64){
        let L5:i32=get_line(src,loff,nlines,k5,raw1);
        if(L5>0 && contains(raw1[0..L5],"PINNED")>0){
            let j5:i32=k5;
            let fs5:i32=-1;
            while(j5>=fl0[0]){
                let L6:i32=get_line(src,loff,nlines,j5,raw1);
                if(L6>=0 && strip_line(raw1[0..L6],nc1,cb1)==0){
                    let t6:[]u8=trim_left(cb1[0..L6]);
                    if(starts_with(t6,"fn ")>0){fs5=j5; j5=fl0[0]-1;}
                }
                j5=j5-1;
            }
            if(fs5>=0){
                let fe5:i32=brace_end(src,loff,nlines,fs5,fl1[0]-1,nc1,cb1);
                let e5end:i32=srclen;
                if(fe5+1<=nlines){e5end=loff[fe5+1];}
                let span:[]u8=src[loff[fs5]..e5end];
                if(ns_sha256(span,h32)==0){
                    let hx:[]u8=ns_hex(h32);
                    if(hx.len==64 && npinned*64+64<=pinb.len){
                        let q6:i32=0;
                        while(q6<64){pinb[npinned*64+q6]=hx[q6]; q6=q6+1;}
                        npinned=npinned+1;
                    }
                    nio_free(hx);
                }
            }
        }
        k5=k5+1;
    }
    // ---- module sha256 (transitive sources concatenated in import order) ----
    if(ns_sha256(src[0..srclen],h32)!=0){_zag_println("sha fail"); return 2;}
    let mh:[]u8=ns_hex(h32);
    if(mh.len!=64){_zag_println("hex fail"); return 2;}
    let q7:i32=0;
    while(q7<64){hexb[q7]=mh[q7]; q7=q7+1;}
    nio_free(mh);
    // ---- object scan: direct byte parse of the module binary ----
    let obj_hits_before:i32=nhp[0];
    let bnr:i64=read_file(binp,bin,0);
    if(bnr<0 || bnr>16777216){
        if(emit_hit(jt,jlp,nhp,"OBJ",binp,0,"cannot read binary for object scan")<0){_zag_println("hit err"); return 2;}
    } else {
        let bn:i32=bnr as i32;
        let bbytes:[]u8=bin[0..bn];
        let ur_present:i32=0;
        if(contains(bbytes,"/dev/urandom")>0 || contains(bbytes,"/dev/random")>0){ur_present=1;}
        if(contains(bbytes,"/dev/urandom")>0){
            if(emit_hit(jt,jlp,nhp,"4.1/4.6",binp,0,"binary contains /dev/urandom bytes")<0){_zag_println("hit err"); return 2;}
        }
        if(contains(bbytes,"/dev/random")>0){
            if(emit_hit(jt,jlp,nhp,"4.1/4.6",binp,0,"binary contains /dev/random bytes")<0){_zag_println("hit err"); return 2;}
        }
        if(contains(bbytes,"getrandom")>0){
            if(emit_hit(jt,jlp,nhp,"4.1",binp,0,"binary contains getrandom bytes")<0){_zag_println("hit err"); return 2;}
        }
        let bi:i32=0;
        while(bi+1<bn){
            if(bin[bi]==15){
                if(bin[bi+1]==5){
                    let from:i32=bi-16;
                    if(from<0){from=0;}
                    let found:i32=0;
                    let imm:i64=0;
                    let bj:i32=from;
                    while(bj+5<=bi){
                        if(bin[bj]==184){
                            imm=le32(bin,bj+1); found=1;
                        } else {
                            if(bj+7<=bi && bin[bj]==72 && bin[bj+1]==199 && bin[bj+2]==192){
                                imm=le32(bin,bj+3); found=1;
                            }
                        }
                        bj=bj+1;
                    }
                    if(found==1){
                        if(imm==318 || imm==228 || imm==96){
                            let rl:[]u8="4.6/4.1";
                            if(imm==228 || imm==96){rl="4.6/4.2";}
                            let tl2:i32=ab(txt,0,"object: syscall imm ");
                            tl2=ab_i64(txt,tl2,imm);
                            tl2=ab(txt,tl2," before syscall @off ");
                            tl2=ab_i64(txt,tl2,bi as i64);
                            if(tl2>0){
                                if(emit_hit(jt,jlp,nhp,rl,binp,0,txt[0..tl2])<0){_zag_println("hit err"); return 2;}
                            }
                        } else {
                            if((imm==257 || imm==2) && ur_present==1){
                                let tl3:i32=ab(txt,0,"object: syscall imm ");
                                tl3=ab_i64(txt,tl3,imm);
                                tl3=ab(txt,tl3," (open) with /dev/urandom bytes present @off ");
                                tl3=ab_i64(txt,tl3,bi as i64);
                                if(tl3>0){
                                    if(emit_hit(jt,jlp,nhp,"4.6",binp,0,txt[0..tl3])<0){_zag_println("hit err"); return 2;}
                                }
                            }
                        }
                    }
                } else {
                    if(bin[bi+1]==49){
                        if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdtsc opcode (0F 31) in binary")<0){_zag_println("hit err"); return 2;}
                    } else {
                        if(bin[bi+1]==199 && bi+2<bn){
                            let modrm:i32=bin[bi+2] as i32;
                            let md:i32=(modrm/64)%4;
                            let rg:i32=(modrm/8)%8;
                            if(md==3 && rg==6){
                                if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdrand opcode (0F C7 /6) in binary")<0){_zag_println("hit err"); return 2;}
                            }
                            if(md==3 && rg==7){
                                if(emit_hit(jt,jlp,nhp,"4.7",binp,0,"object: rdseed opcode (0F C7 /7) in binary")<0){_zag_println("hit err"); return 2;}
                            }
                        }
                    }
                }
            }
            bi=bi+1;
        }
    }
    let obj_clean:i32=0;
    if(nhp[0]==obj_hits_before){obj_clean=1;}
    // ---- replay evidence (produced by runner/run_audit.sh) ----
    let ev_ok:i32=0;
    let ev_ident:i64=0;
    let ev_varies:i64=0;
    let ev_words:i64=0;
    let enr:i64=read_file(evp,evb,0);
    if(enr<0 || enr>4096){
        if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"cannot read replay evidence")<0){_zag_println("hit err"); return 2;}
    } else {
        let en:i32=enr as i32;
        let got_ident:i32=0; let got_varies:i32=0; let got_words:i32=0; let got_runs:i32=0; let got_exit:i32=0;
        let ev_exit:i64=0;
        let ev_runs:i64=0;
        let ls:i32=0;
        while(ls<en){
            let le:i32=ls;
            while(le<en && evb[le]!=10){le=le+1;}
            let eline:[]u8=evb[ls..le];
            if(eline.len>0 && eline[eline.len-1]==13){eline=eline[0..eline.len-1];}
            if(is_blank(eline)==0){
                let eq:i32=find_sub(eline,"=",0);
                if(eq>0){
                    let key:[]u8=eline[0..eq];
                    let val:[]u8=eline[eq+1..eline.len];
                    let pv:i64=parse_i64(val);
                    if(pv>=0){
                        if(eq_bytes(key,"byte_identical")>0){ev_ident=pv; got_ident=1;}
                        else {if(eq_bytes(key,"varies_with_state")>0){ev_varies=pv; got_varies=1;}
                        else {if(eq_bytes(key,"state_words")>0){ev_words=pv; got_words=1;}
                        else {if(eq_bytes(key,"runs")>0){ev_runs=pv; got_runs=1;}
                        else {if(eq_bytes(key,"exit_ok")>0){ev_exit=pv; got_exit=1;}}}}}
                    }
                }
            }
            ls=le+1;
        }
        if(got_ident==1 && got_varies==1 && got_words==1 && got_runs==1 && got_exit==1 && ev_exit==1){
            ev_ok=1;
            if(ev_ident!=1){
                ev_ok=0;
                if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"replay evidence: not byte-identical")<0){_zag_println("hit err"); return 2;}
            }
        } else {
            if(emit_hit(jt,jlp,nhp,"REPLAY",evp,0,"malformed replay evidence")<0){_zag_println("hit err"); return 2;}
        }
    }
    // ---- attestation JSON ----
    jlp[0]=ab_byte(jt,jlp[0],93);
    let p:i32=0;
    p=ab_byte(jb,p,123); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"audit"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"no-rng"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"arm"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"C"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"allowlist_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"ALLOW-2026-09-20-v1"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"BAN-2026-09-20-v2"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"checker_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"RNGSCAN-2026-09-20-v2"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"runner_version"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"RUNAUDIT-2026-09-20-v1"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"module_sha256"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,hexb[0..64]); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"lookup_table_sha256"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_byte(jb,p,91);
    let pi:i32=0;
    while(pi<npinned){
        if(pi>0){p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);}
        p=ab_quoted(jb,p,pinb[pi*64..pi*64+64]);
        pi=pi+1;
    }
    p=ab_byte(jb,p,93); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"variation_path_entry"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"vary_expr"); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"callees"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ncallees as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"ops_checked"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ops_checked as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_hits"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,nhp[0] as i64); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"banned_hit_detail"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab(jb,p,jt[0..jlp[0]]); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"object_byte_scan"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(obj_clean==1){p=ab_quoted(jb,p,"clean");} else {p=ab_quoted(jb,p,"BANNED-FOUND");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"replay"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_byte(jb,p,123);
    p=ab_quoted(jb,p,"runs"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32); p=ab_i64(jb,p,2); p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"byte_identical"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(ev_ident==1){p=ab(jb,p,"true");} else {p=ab(jb,p,"false");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"varies_with_state"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    if(ev_varies==1){p=ab(jb,p,"true");} else {p=ab(jb,p,"false");}
    p=ab_byte(jb,p,44); p=ab_byte(jb,p,32);
    p=ab_quoted(jb,p,"state_words_logged"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    p=ab_i64(jb,p,ev_words);
    p=ab_byte(jb,p,125); p=ab_byte(jb,p,44); p=ab_byte(jb,p,10);
    p=ab(jb,p,"  "); p=ab_quoted(jb,p,"verdict"); p=ab_byte(jb,p,58); p=ab_byte(jb,p,32);
    let pass:i32=0;
    if(nhp[0]==0 && ev_ok==1){pass=1;}
    if(pass==1){p=ab_quoted(jb,p,"PASS");} else {p=ab_quoted(jb,p,"FAIL");}
    p=ab_byte(jb,p,10); p=ab_byte(jb,p,125); p=ab_byte(jb,p,10);
    if(p<0){_zag_println("json buffer full"); return 2;}
    let wr:i64=write_file(attp,jb,p);
    if(wr<0){_zag_println("cannot write attestation"); return 2;}
    // summary
    let sl2:i32=ab(txt,0,"RNGSCAN v2: hits=");
    sl2=ab_i64(txt,sl2,nhp[0] as i64);
    sl2=ab(txt,sl2," obj=");
    if(obj_clean==1){sl2=ab(txt,sl2,"clean");} else {sl2=ab(txt,sl2,"BANNED-FOUND");}
    sl2=ab(txt,sl2," replay_identical=");
    if(ev_ident==1){sl2=ab(txt,sl2,"yes");} else {sl2=ab(txt,sl2,"NO");}
    sl2=ab(txt,sl2," varies_with_state=");
    if(ev_varies==1){sl2=ab(txt,sl2,"yes");} else {sl2=ab(txt,sl2,"no");}
    sl2=ab(txt,sl2," verdict=");
    if(pass==1){sl2=ab(txt,sl2,"PASS");} else {sl2=ab(txt,sl2,"FAIL");}
    if(sl2>0){_zag_println(txt[0..sl2]);}
    if(pass==1){return 0;}
    return 1;
}

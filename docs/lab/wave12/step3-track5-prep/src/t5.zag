// t5.zag — Track 5 prep driver.
// One binary; argv[1] selects the isolation smoke mode:
//   smoke_a  arm A (planted-only) harness isolation
//   smoke_b  arm B (learned-only) harness isolation
//   smoke_c  arm C (hybrid) harness isolation
//   traps_a  T7-first trap battery on arm A (telemetry only)
//   traps_b  trap battery on arm B (telemetry only)
//   traps_c  T7'-inclusive trap battery on arm C (telemetry only)
// Exit code = number of failed checks. Two consecutive runs of any mode must
// be byte-identical. THE COMPARISON TRIAL IS NOT IMPLEMENTED HERE — it is
// BLOCKED on Micah's sign-off of the weights and K-T1..K-T4.
@import("t5_core.zag")
@import("t5_arms.zag")
@import("t5_traps.zag")

fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: t5 <smoke_a|smoke_b|smoke_c|traps_a|traps_b|traps_c>");
        return 64;
    }
    let mode:[]u8=_zag_arg(1);
    if(nio_equal(mode,"smoke_a")==1){return a_smoke();}
    if(nio_equal(mode,"smoke_b")==1){return b_smoke();}
    if(nio_equal(mode,"smoke_c")==1){return c_smoke();}
    if(nio_equal(mode,"traps_a")==1){return traps_a();}
    if(nio_equal(mode,"traps_b")==1){return traps_b();}
    if(nio_equal(mode,"traps_c")==1){return traps_c();}
    _zag_println("unknown mode");
    return 64;
}

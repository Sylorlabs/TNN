// w1.zag — Workstream 1: real training-data stress harness (pure Zag).
// Prereg: docs/lab/wave12/w1-real-data/PREREG_W1_2026-09-20.md (frozen
// pre-build). This is a STRESS TEST of the deliberate-memory learning
// machinery against real byte material (Gutenberg Shakespeare prose +
// SQLite amalgamation C code). It does NOT claim TNN is a language model,
// learns language, or does next-token prediction: there is no tokenizer,
// no vocabulary, no embedding table, no gradient descent here.
//
// Mechanism (prereg §4, committed):
//   pass 1 (stage ADD): one deliberate memory per 64-byte chunk holding a
//     deterministic integer signature of the chunk bytes (6144 adds).
//   fault injection: byte 0 of every chunk with i%97==0 is flipped in a
//     WORKING copy (64 faults); the committed corpus buffers are untouched.
//   pass 2 (stage FULL): re-observe each chunk; signature match ->
//     EVIDENCE(CORROBORATED)+PROMOTE; mismatch -> JUSTIFY(CONTRADICTED)+
//     deliberate KILL (arm B). Expected: 6080 evidence/promote, 64 kills.
//   recall: first 100 non-faulted chunk indices re-read from the pristine
//     buffer; signature must equal the stored memory. Expected: 100/100.
//   audit must replay to exact state (st_replay_check == 0).
// Deterministic. Zero RNG anywhere in this file (static-grepped, K2).
// All arithmetic is masked to avoid any i32 overflow regardless of
// backend semantics.

@import("substrate/st_memory_core.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")

const W1_CHUNK:i32=64;
const W1_PROSE_BYTES:i32=262144;
const W1_CODE_BYTES:i32=131072;
const W1_PROSE_N:i32=4096;
const W1_CODE_N:i32=2048;
const W1_N:i32=6144;
const W1_CAP:i32=16384;
const W1_AUDIT_CAP:i32=65536;
const W1_ORG:i32=71;
const W1_FAULT_MOD:i32=97;
const W1_STRENGTH:i32=50;   // declared judgment, recorded openly (arm B ignores it)

// w1_num: print an i64 decimally (owns and frees the temp string).
fn w1_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

// w1_check: CHECK,<name>,<actual>,<expected>; returns 1 on failure.
fn w1_check(name:[]u8,actual:i64,expected:i64)i32 {
    _zag_print("CHECK,");
    _zag_print(name);
    _zag_print(",");
    w1_num(actual);
    _zag_print(",");
    w1_num(expected);
    _zag_println("");
    if(actual!=expected){return 1;}
    return 0;
}

// w1_sig: deterministic 31-bit rolling signature of 64 bytes at buf[at..].
// All intermediates < 2^22: no overflow under any backend semantics.
fn w1_sig(buf:[]u8,at:i32)i32 {
    let h:i32=0;
    let k:i32=0;
    while(k<W1_CHUNK){
        let b:i32=buf[at+k] as i32;
        let lo:i32=h & 65535;
        h=(((lo<<5)+lo+b) & 2147483647);
        k=k+1;
    }
    return h;
}

fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: w1 <data-dir>  (dir holds w1_prose_256k.txt, w1_code_128k.c)");
        return 64;
    }
    let datadir:[]u8=_zag_arg(1);
    let fails:i32=0;

    // ---- ingress: read both slice files via capability IO ----
    let root:i64=nio_open_root(datadir);
    if(root<0){
        _zag_println("W1_ABORT: cannot open data dir");
        return 99;
    }
    let pfd:i64=nio_open_child(root,"w1_prose_256k.txt",0);
    let cfd:i64=nio_open_child(root,"w1_code_128k.c",0);
    if(pfd<0 || cfd<0){
        _zag_println("W1_ABORT: cannot open slice files");
        return 99;
    }
    let prose:[]u8=nio_alloc(W1_PROSE_BYTES);
    let code:[]u8=nio_alloc(W1_CODE_BYTES);
    let pnr:i64=nio_read_exact(pfd,prose,W1_PROSE_BYTES);
    let cnr:i64=nio_read_exact(cfd,code,W1_CODE_BYTES);
    nio_close(pfd);
    nio_close(cfd);
    nio_close(root);
    fails=fails+w1_check("ingress_prose_bytes",pnr,W1_PROSE_BYTES as i64);
    fails=fails+w1_check("ingress_code_bytes",cnr,W1_CODE_BYTES as i64);

    // ---- K5: in-harness sha256 of each slice vs the prereg-committed hash
    let ph:[]u8=nio_alloc(32);
    let ch:[]u8=nio_alloc(32);
    let prc:i32=ns_sha256(prose,ph);
    let crc:i32=ns_sha256(code,ch);
    fails=fails+w1_check("sha256_prose_rc",prc as i64,0);
    fails=fails+w1_check("sha256_code_rc",crc as i64,0);
    let phx:[]u8=ns_hex(ph);
    let chx:[]u8=ns_hex(ch);
    let pmatch:i32=0;
    if(_zag_strcmp(phx,"1b98db74118aa7d86894d90c581ef066e4375ea00876aae2570721fc9464eee2")==1){pmatch=1;}
    let cmatch:i32=0;
    if(_zag_strcmp(chx,"ff73e4e03caa24768b76bcedfa18a14b25ed46c68fd415decfc618ec3fe57873")==1){cmatch=1;}
    fails=fails+w1_check("K5_sha_prose",pmatch as i64,1);
    fails=fails+w1_check("K5_sha_code",cmatch as i64,1);
    _zag_print("SHA_PROSE,");_zag_print(phx);_zag_println("");
    _zag_print("SHA_CODE,");_zag_print(chx);_zag_println("");
    nio_free(ph);nio_free(ch);nio_free(phx);nio_free(chx);

    // ---- working copies (fault injection target); pristine buffers kept ----
    let wprose:[]u8=nio_alloc(W1_PROSE_BYTES);
    let wcode:[]u8=nio_alloc(W1_CODE_BYTES);
    let q:i32=0;
    while(q<W1_PROSE_BYTES){wprose[q]=prose[q];q=q+1;}
    q=0;
    while(q<W1_CODE_BYTES){wcode[q]=code[q];q=q+1;}
    // fault injection: flip byte 0 of every chunk with i%97==0 (64 faults)
    let fi:i32=0;
    let fn2:i32=0;
    while(fi<W1_N){
        if(fi % W1_FAULT_MOD==0){
            if(fi<W1_PROSE_N){wprose[fi*W1_CHUNK]=wprose[fi*W1_CHUNK]^255;}
            else{wcode[(fi-W1_PROSE_N)*W1_CHUNK]=wcode[(fi-W1_PROSE_N)*W1_CHUNK]^255;}
            fn2=fn2+1;
        }
        fi=fi+1;
    }
    fails=fails+w1_check("faults_injected",fn2 as i64,64);

    // ---- O1 store ----
    let s:StStore=st_init(W1_CAP,W1_AUDIT_CAP,W1_ORG);
    fails=fails+w1_check("store_init_audit_n",s.audit_n as i64,0);
    let ssp:StStore=s;
    let ps:*StStore=&ssp;
    let r0:i32=st_set_stage(ps,ST_STAGE_ADD);
    fails=fails+w1_check("setstage_add",r0 as i64,0);

    // slotmap[i] = slot holding chunk i's memory
    let slotmap:[]u8=nio_alloc(W1_N*4);

    // ---- pass 1: deliberate add of every chunk's signature ----
    let adds_ok:i32=0;
    let i:i32=0;
    while(i<W1_N){
        let at:i32=0;
        let sg:i32=0;
        if(i<W1_PROSE_N){at=i*W1_CHUNK;sg=w1_sig(prose,at);}
        else{at=(i-W1_PROSE_N)*W1_CHUNK;sg=w1_sig(code,at);}
        let slot:i32=-1;
        let rc:i32=st_add(ps,sg,ST_REGION_USER,W1_STRENGTH,&slot);
        if(rc==ST_OK && slot>=0){adds_ok=adds_ok+1;st_i32_set(slotmap,i*4,slot);}
        else{st_i32_set(slotmap,i*4,-1);}
        i=i+1;
    }
    fails=fails+w1_check("pass1_adds_ok",adds_ok as i64,W1_N as i64);

    let r1:i32=st_set_stage(ps,ST_STAGE_FULL);
    fails=fails+w1_check("setstage_full",r1 as i64,0);

    // ---- pass 2: re-observe; corroborate+promote or refute+kill ----
    let ev_ok:i32=0;
    let prom_ok:i32=0;
    let kills:i32=0;
    let jus_ok:i32=0;
    i=0;
    while(i<W1_N){
        let slot:i32=st_i32_get(slotmap,i*4);
        if(slot>=0){
            let at:i32=0;
            let sg2:i32=0;
            if(i<W1_PROSE_N){at=i*W1_CHUNK;sg2=w1_sig(wprose,at);}
            else{at=(i-W1_PROSE_N)*W1_CHUNK;sg2=w1_sig(wcode,at);}
            let stored:i32=st_i32_get(ps.*.value,slot*4);
            if(sg2==stored){
                if(st_evidence(ps,slot,ST_J_CORROBORATED,i)==ST_OK){ev_ok=ev_ok+1;}
                if(st_promote(ps,slot)==ST_OK){prom_ok=prom_ok+1;}
            }else{
                if(st_justify(ps,slot,ST_J_CONTRADICTED)==ST_OK){jus_ok=jus_ok+1;}
                if(st_kill(ps,slot)==ST_OK){
                    kills=kills+1;
                    _zag_print("KILLED,");
                    w1_num(i as i64);
                    _zag_println("");
                }
            }
        }
        i=i+1;
    }
    fails=fails+w1_check("pass2_evidence_ok",ev_ok as i64,6080);
    fails=fails+w1_check("pass2_promote_ok",prom_ok as i64,6080);
    fails=fails+w1_check("pass2_justify_ok",jus_ok as i64,64);
    fails=fails+w1_check("K3_kills",kills as i64,64);

    // ---- K3b: the killed set must be exactly {i : i%97==0} ----
    let killset_ok:i32=1;
    i=0;
    while(i<W1_N){
        let slot:i32=st_i32_get(slotmap,i*4);
        let live:i32=0;
        if(slot>=0){live=ps.*.live[slot] as i32;}
        let should_live:i32=1;
        if(i % W1_FAULT_MOD==0){should_live=0;}
        if(live!=should_live){killset_ok=0;}
        i=i+1;
    }
    fails=fails+w1_check("K3_killset_exact",killset_ok as i64,1);

    // ---- O4 recall: first 100 non-faulted chunk indices, pristine bytes ----
    let recall_ok:i32=0;
    let recall_n:i32=0;
    i=1;
    while(i<W1_N && recall_n<100){
        if(i % W1_FAULT_MOD!=0){
            let slot:i32=st_i32_get(slotmap,i*4);
            if(slot>=0 && (ps.*.live[slot] as i32)==1){
                let at:i32=0;
                let sg:i32=0;
                if(i<W1_PROSE_N){at=i*W1_CHUNK;sg=w1_sig(prose,at);}
                else{at=(i-W1_PROSE_N)*W1_CHUNK;sg=w1_sig(code,at);}
                let stored:i32=st_i32_get(ps.*.value,slot*4);
                if(sg==stored){recall_ok=recall_ok+1;}
            }
            recall_n=recall_n+1;
        }
        i=i+1;
    }
    fails=fails+w1_check("recall_sampled",recall_n as i64,100);
    fails=fails+w1_check("K4_recall_ok",recall_ok as i64,100);

    // ---- O5/audit: replay to exact state ----
    let rpl:i32=st_replay_check(ps);
    fails=fails+w1_check("replay_check",rpl as i64,0);

    // ---- measurements (not bars) ----
    _zag_print("METRIC,audit_n,");w1_num(ps.*.audit_n as i64);_zag_println("");
    let live_n:i32=0;
    i=0;
    while(i<W1_CAP){if((ps.*.live[i] as i32)==1){live_n=live_n+1;}i=i+1;}
    _zag_print("METRIC,live_slots_end,");w1_num(live_n as i64);_zag_println("");
    _zag_print("METRIC,cap,");w1_num(W1_CAP as i64);_zag_println("");

    _zag_print("W1_DONE,fails,");w1_num(fails as i64);_zag_println("");

    nio_free(prose);nio_free(code);nio_free(wprose);nio_free(wcode);
    nio_free(slotmap);
    st_free(ps);
    return fails;
}

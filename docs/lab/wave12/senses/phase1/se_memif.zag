// SE-MEMIF — deliberate memory-interface contract (phase 1 skeleton).
// Sensor observations enter deliberate memory ONLY through mi_observe with
// an explicit deliberate judgment. Strength is DECLARED by the caller
// (judgment-set law); this module performs no computation on observation
// content to produce strength (K-SE5 static check). Every op is audited.
// Pure Zag, no RNG, no wall-clock, integer-only.
@import("substrate/cl/common.zag")
@import("se_ingress.zag")

const MI_OK:i32=0;
const MI_REFUSED_NO_JUDGMENT:i32=-7201;
const MI_REFUSED_BAD_STRENGTH:i32=-7202;
const MI_REFUSED_BAD_REGION:i32=-7203;
const MI_REFUSED_BAD_REC:i32=-7204;
const MI_REFUSED_FULL:i32=-7205;
const MI_REFUSED_PINNED:i32=-7206;
const MI_REFUSED_CORE:i32=-7207;
const MI_REFUSED_NOTLIVE:i32=-7208;
const MI_REFUSED_BAD_CITE:i32=-7209;
const MI_REFUSED_NO_EVIDENCE:i32=-7210;

const MI_J_NONE:i32=0;
const MI_J_NOVEL:i32=1;
const MI_J_CORROBORATED:i32=2;
const MI_J_CONTRADICTED:i32=3;
const MI_J_TRAINER_DIRECTIVE:i32=4;

const MI_REGION_CORE:i32=0;
const MI_REGION_USER:i32=1;

const MI_OP_OBSERVE:i32=1;
const MI_OP_PIN:i32=2;
const MI_OP_KILL:i32=3;
const MI_OP_RECALL:i32=4;

const MI_CAP:i32=16;
const MI_AUDIT_CAP:i32=256;
const MI_AUDIT_WORDS:i32=8;

struct MiStore {
    cap: i32,
    live: []u8,
    pinned: []u8,
    region: []u8,
    judgment: []u8,
    strength: []u8,
    cite_ep: []u8,
    rec_id: []u8,
    phash: []u8,
    audit: []u8,
    audit_n: i32,
    clock: i32
}

fn mi_make()MiStore {
    let audit:[]u8=nio_alloc(MI_AUDIT_CAP*MI_AUDIT_WORDS*4);
    let i:i32=0;while(i<MI_AUDIT_CAP*MI_AUDIT_WORDS*4){audit[i]=0;i=i+1;}
    let m:MiStore=MiStore{
        .cap=MI_CAP,.audit_n=0,.clock=0,
        .live=nio_alloc(MI_CAP),.pinned=nio_alloc(MI_CAP),
        .region=nio_alloc(MI_CAP),.judgment=nio_alloc(MI_CAP),
        .strength=nio_alloc(MI_CAP),
        .cite_ep=nio_alloc(MI_CAP*4),.rec_id=nio_alloc(MI_CAP*4),
        .phash=nio_alloc(MI_CAP*32),
        .audit=audit,
    };
    return m;
}

fn mi_audit_put(m:*MiStore,op:i32,slot:i32,rc:i32,j:i32,st:i32,rg:i32,ce:i32,ri:i32)void {
    if(m.*.audit_n>=MI_AUDIT_CAP){return;}
    let b:[]u8=m.*.audit;
    let at:i32=m.*.audit_n*MI_AUDIT_WORDS*4;
    se_i32_set(b,at,op);se_i32_set(b,at+4,slot);se_i32_set(b,at+8,rc);
    se_i32_set(b,at+12,j);se_i32_set(b,at+16,st);se_i32_set(b,at+20,rg);
    se_i32_set(b,at+24,ce);se_i32_set(b,at+28,ri);
    m.*.audit_n=m.*.audit_n+1;
}

fn mi_live_count(m:*MiStore)i32 {
    let c:i32=0;let i:i32=0;
    while(i<m.*.cap){if(m.*.live[i]==1){c=c+1;}i=i+1;}
    return c;
}

// THE contract gate. Only deliberate judged observations enter memory.
fn mi_observe(m:*MiStore,s:*SeStore,rec_id:i32,judgment:i32,strength:i32,region:i32,cite_ep:i32,out_slot:*i32)i32 {
    if(judgment==MI_J_NONE){return MI_REFUSED_NO_JUDGMENT;}
    if(judgment<1 || judgment>4){return MI_REFUSED_NO_JUDGMENT;}
    if(strength<1 || strength>100){return MI_REFUSED_BAD_STRENGTH;}
    if(region!=MI_REGION_CORE && region!=MI_REGION_USER){return MI_REFUSED_BAD_REGION;}
    if(cite_ep<0){return MI_REFUSED_BAD_CITE;}
    if(rec_id<0 || rec_id>=s.*.n){return MI_REFUSED_BAD_REC;}
    let slot:i32=-1;let i:i32=0;
    while(i<m.*.cap){if(m.*.live[i]==0){slot=i;i=m.*.cap;}i=i+1;}
    if(slot<0){return MI_REFUSED_FULL;}
    // Provenance: bind the slot to the admitted record's payload hash.
    let rec:[]u8=se_rec_view(s,rec_id);
    let j:i32=0;while(j<32){m.*.phash[slot*32+j]=rec[48+j];j=j+1;}
    m.*.live[slot]=1;m.*.pinned[slot]=0;
    m.*.region[slot]=region as u8;m.*.judgment[slot]=judgment as u8;
    m.*.strength[slot]=strength as u8;
    se_i32_set(m.*.cite_ep,slot*4,cite_ep);
    se_i32_set(m.*.rec_id,slot*4,rec_id);
    m.*.clock=m.*.clock+1;
    mi_audit_put(m,MI_OP_OBSERVE,slot,MI_OK,judgment,strength,region,cite_ep,rec_id);
    out_slot.*=slot;
    return MI_OK;
}

fn mi_pin(m:*MiStore,slot:i32)i32 {
    if(slot<0 || slot>=m.*.cap || m.*.live[slot]==0){
        mi_audit_put(m,MI_OP_PIN,slot,MI_REFUSED_NOTLIVE,0,0,0,0,0);return MI_REFUSED_NOTLIVE;}
    m.*.pinned[slot]=1;m.*.clock=m.*.clock+1;
    mi_audit_put(m,MI_OP_PIN,slot,MI_OK,0,0,0,0,0);
    return MI_OK;
}

// Deliberate kill: needs evidence, never touches pinned or CORE.
fn mi_kill(m:*MiStore,slot:i32,evidence:i32)i32 {
    if(slot<0 || slot>=m.*.cap || m.*.live[slot]==0){
        mi_audit_put(m,MI_OP_KILL,slot,MI_REFUSED_NOTLIVE,0,0,0,0,0);return MI_REFUSED_NOTLIVE;}
    if(m.*.pinned[slot]==1){
        mi_audit_put(m,MI_OP_KILL,slot,MI_REFUSED_PINNED,0,0,0,0,0);return MI_REFUSED_PINNED;}
    if(m.*.region[slot]==MI_REGION_CORE as u8){
        mi_audit_put(m,MI_OP_KILL,slot,MI_REFUSED_CORE,0,0,0,0,0);return MI_REFUSED_CORE;}
    if(evidence==0){
        mi_audit_put(m,MI_OP_KILL,slot,MI_REFUSED_NO_EVIDENCE,0,0,0,0,0);return MI_REFUSED_NO_EVIDENCE;}
    m.*.live[slot]=0;m.*.clock=m.*.clock+1;
    mi_audit_put(m,MI_OP_KILL,slot,MI_OK,0,0,0,0,0);
    return MI_OK;
}

// Read-only recall: copies record bytes out; never mutates memory.
fn mi_recall(m:*MiStore,s:*SeStore,slot:i32,out:[]u8)i32 {
    if(slot<0 || slot>=m.*.cap || m.*.live[slot]==0){return MI_REFUSED_NOTLIVE;}
    let rid:i32=se_i32_get(m.*.rec_id,slot*4);
    let rec:[]u8=se_rec_view(s,rid);
    if(out.len<rec.len){return MI_REFUSED_BAD_REC;}
    let i:i32=0;while(i<rec.len){out[i]=rec[i];i=i+1;}
    mi_audit_put(m,MI_OP_RECALL,slot,MI_OK,0,0,0,0,rid);
    return rec.len;
}

// K-SE2 support: every live slot must trace to an OBSERVE audit entry.
fn mi_audit_scan(m:*MiStore)i32 {
    let s:i32=0;
    while(s<m.*.cap){
        if(m.*.live[s]==1){
            let found:i32=0;let a:i32=0;
            while(a<m.*.audit_n){
                let at:i32=a*MI_AUDIT_WORDS*4;
                if(se_i32_get(m.*.audit,at)==MI_OP_OBSERVE &&
                   se_i32_get(m.*.audit,at+4)==s &&
                   se_i32_get(m.*.audit,at+8)==MI_OK){found=1;}
                a=a+1;
            }
            if(found==0){return 0;}
        }
        s=s+1;
    }
    return 1;
}

fn mi_save(m:*MiStore,dir:[]u8)i32 {
    nio_mkdir(dir);
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,"memif.bin",1);
    if(fd<0){nio_close(root);return -1;}
    let total:i32=8+MI_CAP+MI_CAP+MI_CAP+MI_CAP+MI_CAP+MI_CAP*4+MI_CAP*4+MI_CAP*32+MI_AUDIT_CAP*MI_AUDIT_WORDS*4;
    let buf:[]u8=nio_alloc(total);
    let at:i32=0;
    se_i32_set(buf,at,m.*.audit_n);at=at+4;
    se_i32_set(buf,at,m.*.clock);at=at+4;
    let arr:[]u8=m.*.live;let i:i32=0;while(i<MI_CAP){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP;
    arr=m.*.pinned;i=0;while(i<MI_CAP){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP;
    arr=m.*.region;i=0;while(i<MI_CAP){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP;
    arr=m.*.judgment;i=0;while(i<MI_CAP){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP;
    arr=m.*.strength;i=0;while(i<MI_CAP){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP;
    arr=m.*.cite_ep;i=0;while(i<MI_CAP*4){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP*4;
    arr=m.*.rec_id;i=0;while(i<MI_CAP*4){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP*4;
    arr=m.*.phash;i=0;while(i<MI_CAP*32){buf[at+i]=arr[i];i=i+1;}at=at+MI_CAP*32;
    arr=m.*.audit;i=0;while(i<MI_AUDIT_CAP*MI_AUDIT_WORDS*4){buf[at+i]=arr[i];i=i+1;}at=at+MI_AUDIT_CAP*MI_AUDIT_WORDS*4;
    let code:i32=0;
    if(nio_write_all(fd,buf)!=at as i64){code=-1;}
    if(nio_sync(fd)!=0){code=-1;}
    nio_close(fd);nio_sync(root);nio_close(root);
    nio_free(buf);
    return code;
}

fn mi_load(m:*MiStore,dir:[]u8)i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,"memif.bin",0);
    if(fd<0){nio_close(root);return -1;}
    let total:i32=8+MI_CAP+MI_CAP+MI_CAP+MI_CAP+MI_CAP+MI_CAP*4+MI_CAP*4+MI_CAP*32+MI_AUDIT_CAP*MI_AUDIT_WORDS*4;
    let buf:[]u8=nio_alloc(total);
    let got:i64=nio_read_exact(fd,buf,total);
    nio_close(fd);nio_close(root);
    if(got!=total as i64){nio_free(buf);return -1;}
    let at:i32=0;
    m.*.audit_n=se_i32_get(buf,at);at=at+4;
    m.*.clock=se_i32_get(buf,at);at=at+4;
    let arr:[]u8=m.*.live;let i:i32=0;while(i<MI_CAP){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP;
    arr=m.*.pinned;i=0;while(i<MI_CAP){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP;
    arr=m.*.region;i=0;while(i<MI_CAP){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP;
    arr=m.*.judgment;i=0;while(i<MI_CAP){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP;
    arr=m.*.strength;i=0;while(i<MI_CAP){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP;
    arr=m.*.cite_ep;i=0;while(i<MI_CAP*4){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP*4;
    arr=m.*.rec_id;i=0;while(i<MI_CAP*4){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP*4;
    arr=m.*.phash;i=0;while(i<MI_CAP*32){arr[i]=buf[at+i];i=i+1;}at=at+MI_CAP*32;
    arr=m.*.audit;i=0;while(i<MI_AUDIT_CAP*MI_AUDIT_WORDS*4){arr[i]=buf[at+i];i=i+1;}
    nio_free(buf);
    return 0;
}

// SE-MAIN — phase-1 qualification harness driver.
// Modes: argv[1]=="harness" (full battery + save), argv[1]=="verify"
// (fresh-process reload + re-verification). Deterministic output only:
// CL_CHECK lines and fixed markers. No timestamps, no pointers.
@import("substrate/cl/common.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")
@import("se_ingress.zag")
@import("se_memif.zag")

fn se_put16_le(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
}

fn se_get16_le(b:[]u8,at:i32)i32 {
    let v:i32=(b[at] as i32)+((b[at+1] as i32)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}

fn se_sum_bytes(b:[]u8)i32 {
    let s:i32=0;let i:i32=0;
    while(i<b.len){s=s+(b[i] as i32);i=i+1;}
    return s;
}

// Fixture: PCM16LE mono 8000Hz, 16 samples.
fn se_fixture_pcm_a(payload:[]u8)void {
    se_put16_le(payload,0,-32768);se_put16_le(payload,2,-1);
    se_put16_le(payload,4,0);se_put16_le(payload,6,1);
    se_put16_le(payload,8,32767);se_put16_le(payload,10,-32768);
    se_put16_le(payload,12,32767);se_put16_le(payload,14,-1);
    se_put16_le(payload,16,1);se_put16_le(payload,18,0);
    se_put16_le(payload,20,1234);se_put16_le(payload,22,-1234);
    se_put16_le(payload,24,100);se_put16_le(payload,26,-100);
    se_put16_le(payload,28,555);se_put16_le(payload,30,-555);
}

fn se_mode_harness()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();

    // --- fixtures ---
    let pay_a:[]u8=nio_alloc(32);se_fixture_pcm_a(pay_a);
    let pay_b:[]u8=nio_alloc(32);se_fixture_pcm_a(pay_b);
    se_put16_le(pay_b,14,1); // sample[7]: -1 -> +1 (sign twin)
    let rgb_a:[]u8=nio_alloc(12);
    rgb_a[0]=10;rgb_a[1]=20;rgb_a[2]=30;rgb_a[3]=40;rgb_a[4]=50;rgb_a[5]=60;
    rgb_a[6]=70;rgb_a[7]=80;rgb_a[8]=90;rgb_a[9]=100;rgb_a[10]=110;rgb_a[11]=120;
    let rgb_b:[]u8=nio_alloc(12);
    rgb_b[0]=100;rgb_b[1]=110;rgb_b[2]=120;rgb_b[3]=70;rgb_b[4]=80;rgb_b[5]=90;
    rgb_b[6]=40;rgb_b[7]=50;rgb_b[8]=60;rgb_b[9]=10;rgb_b[10]=20;rgb_b[11]=30;

    let rec_a:[]u8=nio_alloc(112);se_build(rec_a,SE_ENC_PCM16LE,8000,1,pay_a);
    let rec_b:[]u8=nio_alloc(112);se_build(rec_b,SE_ENC_PCM16LE,8000,1,pay_b);
    let rec_c:[]u8=nio_alloc(92);se_build(rec_c,SE_ENC_RGB8,2,2,rgb_a);
    let rec_d:[]u8=nio_alloc(92);se_build(rec_d,SE_ENC_RGB8,2,2,rgb_b);
    // pristine copy for the aliasing probe
    let pristine:[]u8=nio_alloc(112);
    let i:i32=0;while(i<112){pristine[i]=rec_a[i];i=i+1;}

    // --- admit valid records ---
    let id0:i32=se_admit(&se,rec_a);
    fails=fails+cl_check("admit_pcm_a",id0,0);
    let id1:i32=se_admit(&se,rec_b);
    fails=fails+cl_check("admit_pcm_b",id1,1);
    let id2:i32=se_admit(&se,rec_c);
    fails=fails+cl_check("admit_rgb_a",id2,2);
    let id3:i32=se_admit(&se,rec_d);
    fails=fails+cl_check("admit_rgb_b",id3,3);
    fails=fails+cl_check("rec_count_4",se.n,4);

    // byte-identity of stored records
    fails=fails+cl_check("bytes_pcm_a",nio_equal(se_rec_view(&se,0),rec_a),1);
    fails=fails+cl_check("bytes_rgb_a",nio_equal(se_rec_view(&se,2),rec_c),1);

    // S1 paired counterexamples: twins differ at the controlled item only
    let va:[]u8=se_rec_view(&se,0);let vb:[]u8=se_rec_view(&se,1);
    fails=fails+cl_check("twin_sample_a",se_get16_le(va,80+14),-1);
    fails=fails+cl_check("twin_sample_b",se_get16_le(vb,80+14),1);
    fails=fails+cl_check("twin_bytes_differ",nio_equal(va,vb),0);
    let vc:[]u8=se_rec_view(&se,2);let vd:[]u8=se_rec_view(&se,3);
    fails=fails+cl_check("rgb_bytes_differ",nio_equal(vc,vd),0);
    fails=fails+cl_check("rgb_hist_equal",se_sum_bytes(vc[80..92]),se_sum_bytes(vd[80..92]));

    // --- deliberate memory admission (the contract gate) ---
    let s0:i32=0;let s1:i32=0;let s2:i32=0;let s3:i32=0;
    fails=fails+cl_check("obs0",mi_observe(&mi,&se,0,MI_J_NOVEL,80,MI_REGION_USER,7,&s0),MI_OK);
    fails=fails+cl_check("obs1",mi_observe(&mi,&se,1,MI_J_CORROBORATED,60,MI_REGION_CORE,7,&s1),MI_OK);
    fails=fails+cl_check("obs2",mi_observe(&mi,&se,2,MI_J_NOVEL,70,MI_REGION_USER,8,&s2),MI_OK);
    fails=fails+cl_check("obs3",mi_observe(&mi,&se,3,MI_J_NOVEL,40,MI_REGION_USER,8,&s3),MI_OK);
    fails=fails+cl_check("live_4",mi_live_count(&mi),4);

    // K-SE2: silent admission is impossible through the gate
    let sx:i32=0;
    fails=fails+cl_check("ref_no_judgment",mi_observe(&mi,&se,0,MI_J_NONE,80,MI_REGION_USER,7,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("ref_bad_judgment",mi_observe(&mi,&se,0,9,80,MI_REGION_USER,7,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("ref_strength_0",mi_observe(&mi,&se,0,MI_J_NOVEL,0,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("ref_strength_101",mi_observe(&mi,&se,0,MI_J_NOVEL,101,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("ref_region",mi_observe(&mi,&se,0,MI_J_NOVEL,80,2,7,&sx),MI_REFUSED_BAD_REGION);
    fails=fails+cl_check("ref_cite",mi_observe(&mi,&se,0,MI_J_NOVEL,80,MI_REGION_USER,-1,&sx),MI_REFUSED_BAD_CITE);
    fails=fails+cl_check("ref_badrec",mi_observe(&mi,&se,99,MI_J_NOVEL,80,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_REC);
    fails=fails+cl_check("audit_scan",mi_audit_scan(&mi),1);
    fails=fails+cl_check("live_still_4",mi_live_count(&mi),4);

    // K-SE4: caller-buffer mutation after admission changes nothing
    rec_a[80]=255;rec_a[81]=255;rec_a[0]=88;
    fails=fails+cl_check("alias_record_intact",nio_equal(se_rec_view(&se,0),pristine),1);

    // K-SE3: malformed battery — all refused, zero state mutation
    let n_before:i32=se.n;let live_before:i32=mi_live_count(&mi);
    let bad:[]u8=nio_alloc(112);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    bad[0]=88; // bad magic
    fails=fails+cl_check("mal_magic",se_admit(&se,bad),SE_BAD_MAGIC);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    se_i32_set(bad,8,2); // bad version
    fails=fails+cl_check("mal_version",se_admit(&se,bad),SE_BAD_VERSION);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    se_i32_set(bad,12,9); // bad encoding
    fails=fails+cl_check("mal_encoding",se_admit(&se,bad),SE_BAD_ENCODING);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    se_i32_set(bad,16,7999); // rate out of envelope
    fails=fails+cl_check("mal_rate",se_admit(&se,bad),SE_BAD_PARAM);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    se_i32_set(bad,20,0); // channels 0
    fails=fails+cl_check("mal_channels",se_admit(&se,bad),SE_BAD_PARAM);
    let odd:[]u8=nio_alloc(111); // odd payload length
    i=0;while(i<111){odd[i]=pristine[i];i=i+1;}
    se_i32_set(odd,24,31);
    let oh:[]u8=nio_alloc(32);ns_sha256(odd[80..111],oh);
    i=0;while(i<32){odd[48+i]=oh[i];i=i+1;}nio_free(oh);
    fails=fails+cl_check("mal_odd_len",se_admit(&se,odd),SE_BAD_PARAM);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    se_i32_set(bad,24,34); // payload_len mismatch
    fails=fails+cl_check("mal_len_mismatch",se_admit(&se,bad),SE_LEN_MISMATCH);
    i=0;while(i<112){bad[i]=pristine[i];i=i+1;}
    bad[85]=bad[85]+1; // corrupted payload hash
    fails=fails+cl_check("mal_hash",se_admit(&se,bad),SE_BAD_HASH);
    let rgb_bad:[]u8=nio_alloc(92);
    i=0;while(i<92){rgb_bad[i]=rec_c[i];i=i+1;}
    se_i32_set(rgb_bad,16,0); // width 0
    fails=fails+cl_check("mal_width0",se_admit(&se,rgb_bad),SE_BAD_PARAM);
    i=0;while(i<92){rgb_bad[i]=rec_c[i];i=i+1;}
    se_i32_set(rgb_bad,24,11); // rgb payload mismatch
    fails=fails+cl_check("mal_rgb_len",se_admit(&se,rgb_bad),SE_LEN_MISMATCH);
    let trunc:[]u8=pristine[0..40]; // truncated record
    fails=fails+cl_check("mal_trunc",se_admit(&se,trunc),SE_BAD_MAGIC);
    fails=fails+cl_check("refusals_11",se.refusals,11);
    fails=fails+cl_check("n_unchanged",se.n,n_before);
    fails=fails+cl_check("live_unchanged",mi_live_count(&mi),live_before);

    // K-SE8: protected memory
    fails=fails+cl_check("pin_s2",mi_pin(&mi,s2),MI_OK);
    fails=fails+cl_check("kill_pinned",mi_kill(&mi,s2,9),MI_REFUSED_PINNED);
    fails=fails+cl_check("kill_core",mi_kill(&mi,s1,9),MI_REFUSED_CORE);
    fails=fails+cl_check("kill_no_evidence",mi_kill(&mi,s0,0),MI_REFUSED_NO_EVIDENCE);
    fails=fails+cl_check("kill_ok",mi_kill(&mi,s0,5),MI_OK);
    fails=fails+cl_check("kill_notlive",mi_kill(&mi,s0,5),MI_REFUSED_NOTLIVE);
    fails=fails+cl_check("live_3",mi_live_count(&mi),3);

    // recall is read-only and returns exact record bytes
    let rbuf:[]u8=nio_alloc(112);
    let rl:i32=mi_recall(&mi,&se,s1,rbuf);
    fails=fails+cl_check("recall_len",rl,112);
    fails=fails+cl_check("recall_bytes",nio_equal(rbuf,rec_b),1);
    fails=fails+cl_check("recall_killed",mi_recall(&mi,&se,s0,rbuf),MI_REFUSED_NOTLIVE);

    // capacity: fill to 16, then explicit refusal
    let k:i32=0;
    while(k<13){
        let sk:i32=0;
        let rc:i32=mi_observe(&mi,&se,3,MI_J_NOVEL,10+k,MI_REGION_USER,100+k,&sk);
        fails=fails+cl_check("fill",rc,MI_OK);
        k=k+1;
    }
    fails=fails+cl_check("live_16",mi_live_count(&mi),16);
    let sfull:i32=0;
    fails=fails+cl_check("ref_full",mi_observe(&mi,&se,3,MI_J_NOVEL,50,MI_REGION_USER,200,&sfull),MI_REFUSED_FULL);

    // save for the fresh-process verify run
    let dir:[]u8="se_p1_store";
    fails=fails+cl_check("save_records",se_save(&se,dir),SE_OK);
    fails=fails+cl_check("save_memif",mi_save(&mi,dir),0);

    nio_free(pay_a);nio_free(pay_b);nio_free(rgb_a);nio_free(rgb_b);
    nio_free(rec_a);nio_free(rec_b);nio_free(rec_c);nio_free(rec_d);
    nio_free(pristine);nio_free(bad);nio_free(odd);nio_free(rgb_bad);nio_free(rbuf);
    fails=fails+cl_check("fails_total",fails,0);
    _zag_println("SE_HARNESS_DONE");
    return fails;
}

fn se_mode_verify()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let dir:[]u8="se_p1_store";
    fails=fails+cl_check("load_records",se_load(&se,dir),SE_OK);
    fails=fails+cl_check("load_memif",mi_load(&mi,dir),0);
    fails=fails+cl_check("v_rec_count",se.n,4);
    fails=fails+cl_check("v_live_16",mi_live_count(&mi),16);
    fails=fails+cl_check("v_audit_scan",mi_audit_scan(&mi),1);
    // rebuild fixtures deterministically and compare
    let pay_a:[]u8=nio_alloc(32);se_fixture_pcm_a(pay_a);
    let rec_a:[]u8=nio_alloc(112);se_build(rec_a,SE_ENC_PCM16LE,8000,1,pay_a);
    fails=fails+cl_check("v_bytes_pcm_a",nio_equal(se_rec_view(&se,0),rec_a),1);
    let pay_b:[]u8=nio_alloc(32);se_fixture_pcm_a(pay_b);se_put16_le(pay_b,14,1);
    let rec_b:[]u8=nio_alloc(112);se_build(rec_b,SE_ENC_PCM16LE,8000,1,pay_b);
    fails=fails+cl_check("v_bytes_pcm_b",nio_equal(se_rec_view(&se,1),rec_b),1);
    // paired distinction survives reload: find the CORE slot (rec1) and recall
    let s:i32=0;let core_slot:i32=-1;
    while(s<mi.cap){
        if(mi.live[s]==1 && se_i32_get(mi.rec_id,s*4)==1){core_slot=s;}
        s=s+1;
    }
    fails=fails+cl_check("v_core_found",(core_slot>=0) as i32,1);
    let rbuf:[]u8=nio_alloc(112);
    let rl:i32=0;
    if(core_slot>=0){rl=mi_recall(&mi,&se,core_slot,rbuf);}
    fails=fails+cl_check("v_recall_len",rl,112);
    fails=fails+cl_check("v_recall_bytes",nio_equal(rbuf,rec_b),1);
    fails=fails+cl_check("v_twin_sample",se_get16_le(rbuf,80+14),1);
    nio_free(pay_a);nio_free(pay_b);nio_free(rec_a);nio_free(rec_b);nio_free(rbuf);
    fails=fails+cl_check("v_fails_total",fails,0);
    _zag_println("SE_VERIFY_DONE");
    return fails;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"harness")==1){return se_mode_harness();}
    if(_zag_strcmp(m,"verify")==1){return se_mode_verify();}
    _zag_println("SE_USAGE: harness | verify");
    return 2;
}

// SE-INGRESS — byte-originated sensor ingress (phase 2, vision).
// PROVENANCE: copied from ../phase1/se_ingress.zag (2026-09-20); changes
// vs phase 1 are marked CHANGE-V2 below and are driven by the proposed
// vision qual bar (envelope 64x64 RGB8, channels/bit-depth header fields).
// RawRecord-lite: TNNRAW02 80-byte header + payload. Transactional
// validate -> reserve -> commit. Owned copy on admit. Pure Zag, no RNG,
// no wall-clock, no threads, integer-only.
// Prereg: PREREG_SENSES_PHASE2_VISION.md (frozen before build).
@import("substrate/cl/common.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")

const SE_OK:i32=0;
const SE_BAD_MAGIC:i32=-7101;
const SE_BAD_VERSION:i32=-7102;
const SE_BAD_ENCODING:i32=-7103;
const SE_BAD_PARAM:i32=-7104;
const SE_LEN_MISMATCH:i32=-7105;
const SE_BAD_HASH:i32=-7106;
const SE_NO_CAPACITY:i32=-7107;
const SE_BAD_RECORD:i32=-7108;
const SE_IO:i32=-7109;

const SE_ENC_PCM16LE:i32=1;
const SE_ENC_RGB8:i32=2;
const SE_VERSION:i32=1;
const SE_HDR:i32=80;
// CHANGE-V2: payload capacity 4096 -> 12288 (64*64*3, proposed bar §E-vision).
const SE_MAX_PAYLOAD:i32=12288;
// CHANGE-V2: record capacity 32 -> 64 (holds 48 twin records + margin).
const SE_CAP:i32=64;
const SE_PCM_RATE:i32=8000;

// Header layout (CHANGE-V2): magic[8]@0 "TNNRAW02", version@8, encoding@12,
// p1@16, p2@20, payload_len@24, channels(i32)@28, bitdepth(i32)@32,
// reserved[12]@36..48 (must be zero), sha256(payload)[32]@48..80.
// RGB8: p1=width, p2=height, channels=3, bitdepth=8.
// PCM16LE: p1=rate, p2=1, channels=1, bitdepth=16.
struct SeStore {
    cap: i32,
    n: i32,
    data: []u8,
    lens: []u8,
    refusals: i32
}

fn se_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn se_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn se_make()SeStore {
    let lens:[]u8=nio_alloc(SE_CAP*4);
    let i:i32=0;while(i<SE_CAP*4){lens[i]=0;i=i+1;}
    let s:SeStore=SeStore{
        .cap=SE_CAP,.n=0,.refusals=0,
        .data=nio_alloc(SE_CAP*(SE_HDR+SE_MAX_PAYLOAD)),.lens=lens,
    };
    return s;
}

fn se_magic_ok(src:[]u8)i32 {
    if(src.len<8){return 0;}
    let m:[]u8="TNNRAW02";
    let i:i32=0;while(i<8){if(src[i]!=m[i]){return 0;}i=i+1;}
    return 1;
}

// Build a valid record from params + payload (fixture authoring).
// CHANGE-V2: sets channels/bitdepth from the encoding id; the remaining
// reserved bytes (36..48) stay zero.
fn se_build(src_out:[]u8,encoding:i32,p1:i32,p2:i32,payload:[]u8)i32 {
    if(src_out.len<SE_HDR+payload.len){return SE_BAD_RECORD;}
    let m:[]u8="TNNRAW02";
    let i:i32=0;while(i<8){src_out[i]=m[i];i=i+1;}
    se_i32_set(src_out,8,SE_VERSION);
    se_i32_set(src_out,12,encoding);
    se_i32_set(src_out,16,p1);
    se_i32_set(src_out,20,p2);
    se_i32_set(src_out,24,payload.len);
    i=28;while(i<48){src_out[i]=0;i=i+1;}
    if(encoding==SE_ENC_RGB8){
        se_i32_set(src_out,28,3);se_i32_set(src_out,32,8);
    } else {
        se_i32_set(src_out,28,1);se_i32_set(src_out,32,16);
    }
    let h:[]u8=nio_alloc(32);
    if(ns_sha256(payload,h)!=0){nio_free(h);return SE_IO;}
    i=0;while(i<32){src_out[48+i]=h[i];i=i+1;}
    nio_free(h);
    i=0;while(i<payload.len){src_out[SE_HDR+i]=payload[i];i=i+1;}
    return SE_OK;
}

fn se_validate(src:[]u8)i32 {
    if(src.len<SE_HDR){return SE_BAD_MAGIC;}
    if(se_magic_ok(src)!=1){return SE_BAD_MAGIC;}
    if(se_i32_get(src,8)!=SE_VERSION){return SE_BAD_VERSION;}
    let enc:i32=se_i32_get(src,12);
    let p1:i32=se_i32_get(src,16);
    let p2:i32=se_i32_get(src,20);
    let plen:i32=se_i32_get(src,24);
    let ch:i32=se_i32_get(src,28);
    let bd:i32=se_i32_get(src,32);
    if(enc!=SE_ENC_PCM16LE && enc!=SE_ENC_RGB8){return SE_BAD_ENCODING;}
    if(plen<0 || plen>SE_MAX_PAYLOAD){return SE_BAD_PARAM;}
    if(src.len!=SE_HDR+plen){return SE_LEN_MISMATCH;}
    // CHANGE-V2: reserved bytes 36..48 must be zero (channels@28 and
    // bitdepth@32 are defined fields, not reserved).
    let ri:i32=36;while(ri<48){if(src[ri]!=0){return SE_BAD_PARAM;}ri=ri+1;}
    if(enc==SE_ENC_PCM16LE){
        if(p1!=SE_PCM_RATE || p2!=1){return SE_BAD_PARAM;}
        if(ch!=1 || bd!=16){return SE_BAD_PARAM;}
        if(plen==0 || plen%2!=0){return SE_BAD_PARAM;}
    } else {
        // CHANGE-V2: RGB envelope 1..4 -> 1..64 per proposed bar §A/§E.
        if(p1<1 || p1>64 || p2<1 || p2>64){return SE_BAD_PARAM;}
        // CHANGE-V2: channels/bitdepth fields (proposed bar §A-vision).
        if(ch!=3 || bd!=8){return SE_BAD_PARAM;}
        // checked: p1*p2*3 cannot overflow in 1..64 (max 12288)
        if(plen!=p1*p2*3){return SE_BAD_PARAM;}
    }
    let h:[]u8=nio_alloc(32);
    let pay:[]u8=src[SE_HDR..src.len];
    let rc:i32=SE_OK;
    if(ns_sha256(pay,h)!=0){rc=SE_IO;}
    else {let i:i32=0;while(i<32){if(h[i]!=src[48+i]){rc=SE_BAD_HASH;}i=i+1;}}
    nio_free(h);
    return rc;
}

// Transactional admit: validate everything BEFORE reserving or copying.
fn se_admit(s:*SeStore,src:[]u8)i32 {
    let v:i32=se_validate(src);
    if(v!=SE_OK){s.*.refusals=s.*.refusals+1;return v;}
    if(s.*.n>=s.*.cap){s.*.refusals=s.*.refusals+1;return SE_NO_CAPACITY;}
    let id:i32=s.*.n;
    let dst:[]u8=s.*.data;
    let base:i32=id*(SE_HDR+SE_MAX_PAYLOAD);
    let i:i32=0;while(i<src.len){dst[base+i]=src[i];i=i+1;}
    se_i32_set(s.*.lens,id*4,src.len);
    s.*.n=s.*.n+1;
    return id;
}

fn se_rec_len(s:*SeStore,id:i32)i32 {
    if(id<0 || id>=s.*.n){return -1;}
    return se_i32_get(s.*.lens,id*4);
}

// Read-only view of an admitted record (internal/harness use).
fn se_rec_view(s:*SeStore,id:i32)[]u8 {
    let l:i32=se_rec_len(s,id);
    if(l<0){let e:[]u8=nio_alloc(0);return e;}
    let base:i32=id*(SE_HDR+SE_MAX_PAYLOAD);
    let d:[]u8=s.*.data;
    return d[base..base+l];
}

// Save: single file "records.bin": n[4], then per record len[4]+bytes.
fn se_save(s:*SeStore,dir:[]u8)i32 {
    nio_mkdir(dir);
    let root:i64=nio_open_root(dir);
    if(root<0){return SE_IO;}
    let fd:i64=nio_open_child(root,"records.bin",1);
    if(fd<0){nio_close(root);return SE_IO;}
    let code:i32=SE_OK;
    let buf:[]u8=nio_alloc(4+s.*.n*(4+SE_HDR+SE_MAX_PAYLOAD));
    se_i32_set(buf,0,s.*.n);
    let at:i32=4;let id:i32=0;
    let d:[]u8=s.*.data;
    while(id<s.*.n && code==SE_OK){
        let l:i32=se_rec_len(s,id);
        se_i32_set(buf,at,l);at=at+4;
        let base:i32=id*(SE_HDR+SE_MAX_PAYLOAD);
        let i:i32=0;while(i<l){buf[at+i]=d[base+i];i=i+1;}
        at=at+l;id=id+1;
    }
    let out:[]u8=buf[0..at];
    if(nio_write_all(fd,out)!=at as i64){code=SE_IO;}
    if(nio_sync(fd)!=0){code=SE_IO;}
    nio_close(fd);nio_sync(root);nio_close(root);
    nio_free(buf);
    return code;
}

fn se_load(s:*SeStore,dir:[]u8)i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return SE_IO;}
    let fd:i64=nio_open_child(root,"records.bin",0);
    if(fd<0){nio_close(root);return SE_IO;}
    let buf:[]u8=nio_alloc(4+SE_CAP*(4+SE_HDR+SE_MAX_PAYLOAD));
    let got:i64=nio_read_exact(fd,buf,buf.len);
    nio_close(fd);nio_close(root);
    if(got<4){nio_free(buf);return SE_IO;}
    let n:i32=se_i32_get(buf,0);
    if(n<0 || n>SE_CAP){nio_free(buf);return SE_BAD_RECORD;}
    let at:i32=4;let id:i32=0;let code:i32=SE_OK;
    let d:[]u8=s.*.data;
    while(id<n && code==SE_OK){
        if(at+4>got as i32){code=SE_BAD_RECORD;break;}
        let l:i32=se_i32_get(buf,at);at=at+4;
        if(l<SE_HDR || l>SE_HDR+SE_MAX_PAYLOAD || at+l>got as i32){code=SE_BAD_RECORD;break;}
        let base:i32=id*(SE_HDR+SE_MAX_PAYLOAD);
        let i:i32=0;while(i<l){d[base+i]=buf[at+i];i=i+1;}
        se_i32_set(s.*.lens,id*4,l);at=at+l;id=id+1;
    }
    nio_free(buf);
    if(code!=SE_OK){return code;}
    if((at as i64)!=got){return SE_BAD_RECORD;}
    s.*.n=n;
    return SE_OK;
}

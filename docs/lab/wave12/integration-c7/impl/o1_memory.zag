// o1_memory.zag — O1: deliberate memory substrate (organ 1).
// Native Zag organ module for the INT-1 integration. Thin organ layer over
// the ported store substrate (substrate/st_memory_core.zag): deliberate
// memory ops (add/kill/pin/promote/demote/evidence), staged autonomy,
// pin expiry (amendment B: serving-trace pins expire after 50 consecutive
// episodes of non-re-service), append-only audit with replay to exact state.
//
// INT-1 organ API (frozen):
//   o1_add(o,epi,out_slot) — the value IS the episode id; strength is
//     absent (arm B: strength never gates); region is always USER (the
//     loop's CORE slots are protected by slot index, not region).
//   o1_pin(o,slot,force) — force=0: TNN serving-trace pin (expirable,
//     re-serviceable); force=1: external force-pin (the one true lock).
//   o1_new_episode(o) — episode tick; expires un-re-serviced pins.
// State is threaded through *O1S (imported Zag modules cannot use mutable
// globals: globals are root-only, scalar-only, zero-initialized).
// Integer-only. No randomness anywhere in AI decision paths.
//
// Frozen laws honored here:
// - O1 uses arm B only: o1_kill and o1_kill_evidenced apply arm-B
//   (deliberate-kill) semantics; strength never gates a kill. Pins,
//   force-pins, CORE region, and stage still gate.
// - Serving-trace pins expire after O1_PIN_EXPIRY=50 ticks of
//   non-re-service; re-service (o1_pin) resets the clock; expiry lifts are
//   ledgered (O1_OP_PIN_EXPIRE) and are not rollbackable.
// - Audit entries are 16 words with the O1 tag in the op-word high 16 bits.
@import("substrate/st_memory_core.zag")

const O1_TAG:i32=1;
const O1_OP_PIN_EXPIRE:i32=30;   // pin-expiry lift (amendment B), O1-internal
const O1_PIN_EXPIRY:i32=50;      // consecutive non-re-serviced ticks to expiry
const O1_OK:i32=0;

struct O1S {
    st:StStore,
    pin_svc:[]u8,   // i32 per slot: last service tick; -1 = unpinned/never
    tick_n:i32      // O1 episode clock, advanced by o1_new_episode
}

fn o1_init(cap:i32,audit_cap:i32)O1S {
    let st:StStore=st_init(cap,audit_cap,O1_TAG);
    let svc:[]u8=nio_alloc(cap*4);
    let i:i32=0;
    while(i<cap){st_i32_set(svc,i*4,-1);i=i+1;}
    let o:O1S=O1S{.st=st,.pin_svc=svc,.tick_n=0};
    // Integration default: FULL. Staged autonomy in this integration is
    // enforced at the loop level (per-stage organ activation plus the
    // shared-ledger stage gates); the harness narrows the O1 stage via
    // o1_set_stage (map curriculum autonomy NONE->ADD->MANAGE->KILL->FULL
    // onto O1 stages 1..4) for defense in depth.
    st_set_stage(&o.st,ST_STAGE_FULL);
    return o;
}

// Staged-autonomy firewall hook for the harness (see o1_init note).
fn o1_set_stage(o:*O1S,stage:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_set_stage(s,stage);
}

// ---- deliberate memory ops (thin wrappers; every op is audited) ----

// INT-1 add: the value IS the episode id; strength is absent (arm B) and
// region is always USER. The loop's CORE slots are protected by slot
// index (o1_victim_candidates' exclude_lo), not by region.
fn o1_add(o:*O1S,epi:i32,out_slot:*i32)i32 {
    let s:*StStore=&o.*.st;
    return st_add(s,epi,ST_REGION_USER,0,out_slot);
}

// Deliberate kill, arm B (frozen law): strength never gates the kill;
// pins, force-pins, CORE, and stage still do.
fn o1_kill(o:*O1S,slot:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_kill(s,slot);
}

// Evidenced kill, arm B only (frozen law). The arm parameter is accepted
// for API compatibility with the seam; O1 always applies arm-B semantics
// (the effort/justification bypass). The requested arm is recorded in the
// shared ledger by the seam wrapper; O1's audit records the applied arm.
fn o1_kill_evidenced(o:*O1S,slot:i32,arm:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_kill_evidenced(s,slot,ST_ARM_B);
}

// Pin (re-service: resets the amendment-B expiry clock).
// force=0: TNN serving-trace pin — expirable, re-serviceable, audited.
// force=1: external force-pin — the one true lock (trainer origin,
// audited, visible); cleared only by an explicit force-unpin path.
fn o1_pin(o:*O1S,slot:i32,force:i32)i32 {
    let s:*StStore=&o.*.st;
    if(force==1){
        return st_force_pin(s,ST_CALLER_TRAINER,1,slot);
    }
    let rc:i32=st_pin(s,slot);
    if(rc==ST_OK){st_i32_set(o.*.pin_svc,slot*4,o.*.tick_n);}
    return rc;
}
fn o1_unpin(o:*O1S,slot:i32)i32 {
    let s:*StStore=&o.*.st;
    let rc:i32=st_unpin(s,slot);
    if(rc==ST_OK){st_i32_set(o.*.pin_svc,slot*4,-1);}
    return rc;
}
fn o1_promote(o:*O1S,slot:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_promote(s,slot);
}
fn o1_demote(o:*O1S,slot:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_demote(s,slot);
}
fn o1_evidence(o:*O1S,slot:i32,code:i32,cite_ep:i32)i32 {
    let s:*StStore=&o.*.st;
    return st_evidence(s,slot,code,cite_ep);
}

// ---- episode tick: amendment-B pin expiry (ledgered, not rollbackable) ----
// Returns the number of pins lifted by expiry.
fn o1_new_episode(o:*O1S)i32 {
    o.*.tick_n=o.*.tick_n+1;
    let s:*StStore=&o.*.st;
    let lifted:i32=0;
    let slot:i32=0;
    while(slot<s.*.cap){
        if(s.*.pinned[slot]==1){
            let svc:i32=st_i32_get(o.*.pin_svc,slot*4);
            if(o.*.tick_n-svc>=O1_PIN_EXPIRY){
                let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
                st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
                s.*.pinned[slot]=0;
                st_i32_set(o.*.pin_svc,slot*4,-1);
                let a1:i32=0;let a2:i32=0;let a3:i32=0;let a4:i32=0;let a5:i32=0;
                st_snap(s,slot,&a1,&a2,&a3,&a4,&a5);
                st_audit_append(s,O1_OP_PIN_EXPIRE,slot,ST_OK,
                    b1,b2,b3,b4,b5,a1,a2,a3,a4,a5,svc,o.*.tick_n);
                lifted=lifted+1;
            }
        }
        slot=slot+1;
    }
    return lifted;
}

// ---- queries ----

fn o1_live_count(o:*O1S)i32 {
    let s:*StStore=&o.*.st;
    let n:i32=0;let i:i32=0;
    while(i<s.*.cap){if(s.*.live[i]==1){n=n+1;}i=i+1;}
    return n;
}
fn o1_pinned_count(o:*O1S)i32 {
    let s:*StStore=&o.*.st;
    let n:i32=0;let i:i32=0;
    while(i<s.*.cap){if(s.*.live[i]==1 && s.*.pinned[i]==1){n=n+1;}i=i+1;}
    return n;
}

// Pinned fraction, per-mille (0..1000). The P3/Q2 alarm warns at >=800.
fn o1_pin_fraction(o:*O1S)i64 {
    let live:i32=o1_live_count(o);
    if(live<=0){return 0;}
    return (o1_pinned_count(o) as i64)*1000/(live as i64);
}

// A slot is a legal eviction victim iff live, unpinned, not force-pinned,
// and outside CORE.
fn o1_legal_victim_slot(o:*O1S,slot:i32)i32 {
    let s:*StStore=&o.*.st;
    if(slot<0 || slot>=s.*.cap){return 0;}
    if(s.*.live[slot]==0){return 0;}
    if(s.*.pinned[slot]==1){return 0;}
    if(s.*.forcepin[slot]==1){return 0;}
    if(s.*.region[slot]==ST_REGION_CORE as u8){return 0;}
    return 1;
}
fn o1_legal_victims(o:*O1S)i32 {
    let s:*StStore=&o.*.st;
    let n:i32=0;let i:i32=0;
    while(i<s.*.cap){if(o1_legal_victim_slot(o,i)==1){n=n+1;}i=i+1;}
    return n;
}

// Batched victim query for the seam: fills slots_out[]/str_out[] (i32
// buffers, capacity max) with legal victim slots in ascending order and
// their strengths in parallel. Slots below exclude_lo are skipped (the
// loop's CORE slots are protected by index). Returns the count. Read-only.
fn o1_victim_candidates(o:*O1S,exclude_lo:i32,slots_out:[]u8,str_out:[]u8,max:i32)i32 {
    let s:*StStore=&o.*.st;
    let n:i32=0;let i:i32=0;
    while(i<s.*.cap && n<max){
        if(i>=exclude_lo && o1_legal_victim_slot(o,i)==1){
            st_i32_set(slots_out,n*4,i);
            st_i32_set(str_out,n*4,s.*.st_str[i] as i32);
            n=n+1;
        }
        i=i+1;
    }
    return n;
}

// ---- snapshots ----

// Organ-level 5-word fingerprint for the G2 determinism gate (paired
// byte-identical reruns): audit length, live count, pinned count, clock,
// stage. i64 words per the frozen API.
fn o1_snap(o:*O1S,b1:*i64,b2:*i64,b3:*i64,b4:*i64,b5:*i64)i32 {
    let s:*StStore=&o.*.st;
    b1.*=s.*.audit_n as i64;
    b2.*=o1_live_count(o) as i64;
    b3.*=o1_pinned_count(o) as i64;
    b4.*=s.*.clock as i64;
    b5.*=s.*.stage as i64;
    return O1_OK;
}

// Per-slot snapshot/restore (st_snap/st_restore semantics): five packed
// words capturing one slot's full state, for before/after and rollback.
fn o1_slot_snap(o:*O1S,slot:i32,b1:*i32,b2:*i32,b3:*i32,b4:*i32,b5:*i32)void {
    let s:*StStore=&o.*.st;
    st_snap(s,slot,b1,b2,b3,b4,b5);
}
fn o1_slot_restore(o:*O1S,slot:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32)i32 {
    let s:*StStore=&o.*.st;
    if(slot<0 || slot>=s.*.cap){return ST_REFUSED_BADSLOT;}
    st_restore(s,slot,b1,b2,b3,b4,b5);
    return O1_OK;
}

// ---- audit integrity ----

// Runs the substrate's independent checkers over the O1 audit:
// replay-to-exact-state, clean refusals, no pinned kills, citation
// consistency, evidence/effort audit. Returns 0 iff all pass, else the
// 1-based index of the first failing check.
fn o1_replay_check(o:*O1S)i32 {
    let s:*StStore=&o.*.st;
    if(st_replay_check(s)!=ST_OK){return 1;}
    if(st_audit_clean_refusals(s)!=ST_OK){return 2;}
    if(st_no_pinned_kills(s)!=0){return 3;}
    if(st_cite_consistent(s)!=0){return 4;}
    if(st_evidence_audit(s)!=0){return 5;}
    return O1_OK;
}

// Analogy test driver for the remediated clean learner core.
// Tests Micah's analogy as operationalized in PREREG_ANALOGY.md (frozen before
// this file existed):
//   P1: same input protocol + same complete logged state -> byte-identical behavior.
//   P2: same input protocol + different logged history -> behavior differs EXACTLY
//       where the frozen explore rule predicts, nowhere else.
//   P3: the "hi"-twice pattern: identical stimuli, adapted expression, with the
//       changed logged fields enumerated exactly.
// Pure Zag. No hidden per-decision state; every check reads logged fields only.
// argv[1]: p1 | p2 | p3 | (none: all). One binary, run twice, diff the output.
@import("../r34_clean_learner.zag")

// ---------- helpers ----------
fn an_copy(s:*R34CleanState)R34CleanState {
    return R34CleanState{.s00=s.*.s00,.s01=s.*.s01,.s10=s.*.s10,.s11=s.*.s11,
        .n00=s.*.n00,.n01=s.*.n01,.n10=s.*.n10,.n11=s.*.n11,
        .explore_budget=s.*.explore_budget,.updates=s.*.updates,.active=s.*.active,.contexts=s.*.contexts,
        .pending=s.*.pending,.pending_action=s.*.pending_action,.pending_context=s.*.pending_context,
        .pending_object=s.*.pending_object,.pending_explore=s.*.pending_explore,
        .decisions=s.*.decisions,.switches=s.*.switches,.outcomes=s.*.outcomes,.explores=s.*.explores,.neg_streak=s.*.neg_streak};
}
// Force one accept with fully specified logged fields (history builder).
fn an_force_accept(s:*R34CleanState,action:i32,obj:i32,reward:i32,learn:i32)i32 {
    s.*.pending=1;s.*.pending_action=action;s.*.pending_context=s.*.active;s.*.pending_object=obj;s.*.pending_explore=0;
    return r34_clean_accept(s,action,reward,learn,0);
}
// One episode of the fixed external protocol: choose(explore_enabled=1), then the
// world-response rule reward=(obj==0)?+1:-1, accept with learn=1, no switching.
fn an_episode(s:*R34CleanState,out_ex:*i32,out_obj:*i32)i32 {
    let ex:i32=0;let obj:i32=r34_clean_choose(s,1,&ex);
    if(obj<0){return -99;}
    s.*.pending=1;s.*.pending_action=7;s.*.pending_context=s.*.active;s.*.pending_object=obj;s.*.pending_explore=ex;
    let reward:i32=1;if(obj!=0){reward=-1;}
    let rc:i32=r34_clean_accept(s,7,reward,1,0);
    if(rc!=0){return -99;}
    out_ex.*=ex;out_obj.*=obj;return reward;
}
// Apply the predicted hi-cycle logged transition to a state copy (via pointer).
fn an_hi_delta(s:*R34CleanState)void {
    s.*.s00=s.*.s00-100;s.*.n00=s.*.n00+1;s.*.decisions=s.*.decisions+1;
    s.*.updates=s.*.updates+1;s.*.outcomes=s.*.outcomes+1;s.*.neg_streak=s.*.neg_streak+1;
}
fn an_margin(s:*R34CleanState)i32 {
    let m:i32=r34_clean_score(s,s.*.active,0)-r34_clean_score(s,s.*.active,1);
    if(m<0){m=0-m;}return m;
}
fn an_print_hi(n:i32,s:*R34CleanState,obj:i32,ex:i32)void {
    _zag_print("HI,");cl_number(n as i64);
    _zag_print(",margin,");cl_number(an_margin(s) as i64);
    _zag_print(",streak,");cl_number(s.*.neg_streak as i64);
    _zag_print(",budget,");cl_number(s.*.explore_budget as i64);
    _zag_print(",explores,");cl_number(s.*.explores as i64);
    _zag_print(",decisions,");cl_number(s.*.decisions as i64);
    _zag_print(",s00,");cl_number(s.*.s00 as i64);
    _zag_print(",s01,");cl_number(s.*.s01 as i64);
    _zag_print(",n00,");cl_number(s.*.n00 as i64);
    _zag_print(",n01,");cl_number(s.*.n01 as i64);
    _zag_print(",updates,");cl_number(s.*.updates as i64);
    _zag_print(",outcomes,");cl_number(s.*.outcomes as i64);
    _zag_print(",obj,");cl_number(obj as i64);
    _zag_print(",ex,");cl_number(ex as i64);
    _zag_print(",fp,");cl_number(r34_clean_fp(s) as i64);
    _zag_println("");
}

// ---------- P1: identical inputs + identical logged state -> byte-identical ----------
fn an_p1()i32 {
    let f:i32=0;
    _zag_println("ANALOGY_P1,start");
    let p:i32=0;
    while(p<5){
        let a:R34CleanState=r34_clean_init(40);
        let b:R34CleanState=r34_clean_init(40);
        let bad:i32=0;
        let e:i32=0;
        while(e<60){
            let exa:i32=0;let obja:i32=0;
            let rca:i32=an_episode(&a,&exa,&obja);
            let fpa:i32=r34_clean_fp(&a);
            if(p==0 && e==30){
                // flight-recorder leg: serialize the complete logged state,
                // restore into a fresh struct, continue. Must stay lockstep.
                let buf:[]u8=nio_alloc(160);
                if(r34_clean_encode(buf,&b)!=0){bad=bad+1;}
                if(r34_clean_decode(buf,&b)!=0){bad=bad+1;}
                nio_free(buf);
            }
            let exb:i32=0;let objb:i32=0;
            let rcb:i32=an_episode(&b,&exb,&objb);
            let fpb:i32=r34_clean_fp(&b);
            if(rca!=1 && rca!=-1){bad=bad+1;}
            if(rcb!=1 && rcb!=-1){bad=bad+1;}
            if(obja!=objb){bad=bad+1;}
            if(exa!=exb){bad=bad+1;}
            if(a.explore_budget!=b.explore_budget){bad=bad+1;}
            if(a.explores!=b.explores){bad=bad+1;}
            if(fpa!=fpb){bad=bad+1;}
            if(r34_clean_equal(&a,&b)!=1){bad=bad+1;}
            _zag_print("P1,");cl_number(p as i64);_zag_print(",");cl_number(e as i64);
            _zag_print(",");cl_number(obja as i64);_zag_print(",");cl_number(exa as i64);
            _zag_print(",");cl_number(a.explore_budget as i64);_zag_print(",");cl_number(a.explores as i64);
            _zag_print(",");cl_number(fpa as i64);_zag_println("");
            e=e+1;
        }
        _zag_print("P1_PAIR,");cl_number(p as i64);_zag_print(",mismatches,");cl_number(bad as i64);_zag_println("");
        f=f+cl_check("p1_pair_lockstep",bad,0);
        p=p+1;
    }
    _zag_print("ANALOGY_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

// ---------- P2: different logged history -> divergence exactly where predicted ----------
fn an_p2()i32 {
    let f:i32=0;
    _zag_println("ANALOGY_P2,start");
    let a:R34CleanState=r34_clean_init(10);
    let b:R34CleanState=r34_clean_init(10);
    // identical logged history on both arms: confident scores, no streak
    let k:i32=0;while(k<6){an_force_accept(&a,101+k,0,1,1);an_force_accept(&b,201+k,0,1,1);k=k+1;}
    f=f+cl_check("p2_common_equal",r34_clean_equal(&a,&b),1);
    f=f+cl_check("p2_setup_margin",r34_clean_score(&a,0,0)-r34_clean_score(&a,0,1),600);
    // fork: the ONLY logged difference is B's recent-outcome history
    b.neg_streak=3;
    let bc:R34CleanState=an_copy(&a);bc.neg_streak=3;
    f=f+cl_check("p2_fork_pure",r34_clean_equal(&bc,&b),1);
    f=f+cl_check("p2_streak_a",a.neg_streak,0);
    f=f+cl_check("p2_streak_b",b.neg_streak,3);
    let sum_ex_a:i32=0;let sum_ex_b:i32=0;let div:i32=0;let bad_pred:i32=0;
    let e:i32=0;
    while(e<12){
        let pred_a:i32=r34_clean_explore_decision(&a,1);
        let pred_b:i32=r34_clean_explore_decision(&b,1);
        let fpa_pre:i32=r34_clean_fp(&a);let fpb_pre:i32=r34_clean_fp(&b);
        let exa:i32=0;let obja:i32=0;let exb:i32=0;let objb:i32=0;
        let rca:i32=an_episode(&a,&exa,&obja);
        let rcb:i32=an_episode(&b,&exb,&objb);
        if(rca==-99 || rcb==-99){bad_pred=bad_pred+1;}
        if(exa!=pred_a){bad_pred=bad_pred+1;}
        if(exb!=pred_b){bad_pred=bad_pred+1;}
        sum_ex_a=sum_ex_a+exa;sum_ex_b=sum_ex_b+exb;
        if(exa!=exb){div=div+1;}
        _zag_print("P2,");cl_number(e as i64);
        _zag_print(",obja,");cl_number(obja as i64);_zag_print(",exa,");cl_number(exa as i64);_zag_print(",preda,");cl_number(pred_a as i64);
        _zag_print(",objb,");cl_number(objb as i64);_zag_print(",exb,");cl_number(exb as i64);_zag_print(",predb,");cl_number(pred_b as i64);
        _zag_print(",fpa_pre,");cl_number(fpa_pre as i64);_zag_print(",fpb_pre,");cl_number(fpb_pre as i64);
        _zag_print(",fpa_post,");cl_number(r34_clean_fp(&a) as i64);_zag_print(",fpb_post,");cl_number(r34_clean_fp(&b) as i64);
        _zag_println("");
        e=e+1;
    }
    f=f+cl_check("p2_pred_everywhere",bad_pred,0);
    f=f+cl_check("p2_sum_ex_a",sum_ex_a,0);
    f=f+cl_check("p2_sum_ex_b",sum_ex_b,10);
    f=f+cl_check("p2_div_episodes",div,10);
    // exact predicted finals
    f=f+cl_check("p2_a_s00",a.s00,1800);
    f=f+cl_check("p2_a_n00",a.n00,18);
    f=f+cl_check("p2_a_streak",a.neg_streak,0);
    f=f+cl_check("p2_a_budget",a.explore_budget,10);
    f=f+cl_check("p2_a_explores",a.explores,0);
    f=f+cl_check("p2_b_s00",b.s00,800);
    f=f+cl_check("p2_b_s01",b.s01,-1000);
    f=f+cl_check("p2_b_n00",b.n00,8);
    f=f+cl_check("p2_b_n01",b.n01,10);
    f=f+cl_check("p2_b_streak",b.neg_streak,0);
    f=f+cl_check("p2_b_budget",b.explore_budget,0);
    f=f+cl_check("p2_b_explores",b.explores,10);
    // "nowhere else": every field outside the causally-allowed set is equal
    f=f+cl_check("p2_eq_s10",a.s10,b.s10);
    f=f+cl_check("p2_eq_s11",a.s11,b.s11);
    f=f+cl_check("p2_eq_n10",a.n10,b.n10);
    f=f+cl_check("p2_eq_n11",a.n11,b.n11);
    f=f+cl_check("p2_eq_updates",a.updates,b.updates);
    f=f+cl_check("p2_eq_active",a.active,b.active);
    f=f+cl_check("p2_eq_contexts",a.contexts,b.contexts);
    f=f+cl_check("p2_eq_pending",a.pending,b.pending);
    f=f+cl_check("p2_eq_pending_action",a.pending_action,b.pending_action);
    f=f+cl_check("p2_eq_pending_context",a.pending_context,b.pending_context);
    f=f+cl_check("p2_eq_pending_object",a.pending_object,b.pending_object);
    f=f+cl_check("p2_eq_pending_explore",a.pending_explore,b.pending_explore);
    f=f+cl_check("p2_eq_decisions",a.decisions,b.decisions);
    f=f+cl_check("p2_eq_switches",a.switches,b.switches);
    f=f+cl_check("p2_eq_outcomes",a.outcomes,b.outcomes);
    _zag_print("ANALOGY_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

// ---------- P3: the "hi"-twice pattern ----------
fn an_p3()i32 {
    let f:i32=0;
    _zag_println("ANALOGY_P3,start");
    let s:R34CleanState=r34_clean_init(10);
    let k:i32=0;while(k<6){an_force_accept(&s,301+k,0,1,1);k=k+1;}
    f=f+cl_check("p3_setup_s00",s.s00,600);
    f=f+cl_check("p3_setup_streak",s.neg_streak,0);
    // hi #1: identical stimulus, confident state -> no explore
    let pre1:R34CleanState=an_copy(&s);
    let ex1:i32=0;let obj1:i32=r34_clean_choose(&s,1,&ex1);
    an_print_hi(1,&pre1,obj1,ex1);
    f=f+cl_check("p3_hi1_pred",ex1,r34_clean_explore_decision(&pre1,1));
    f=f+cl_check("p3_hi1_ex",ex1,0);
    f=f+cl_check("p3_hi1_obj",obj1,0);
    f=f+cl_check("p3_hi1_budget_untouched",s.explore_budget,10);
    an_force_accept(&s,401,obj1,-1,1);
    // hi #2: same stimulus, one negative in recent history -> still no explore
    let pre2:R34CleanState=an_copy(&s);
    let x2:R34CleanState=an_copy(&pre1);an_hi_delta(&x2);
    f=f+cl_check("p3_trans_1_2",r34_clean_equal(&x2,&pre2),1);
    let ex2:i32=0;let obj2:i32=r34_clean_choose(&s,1,&ex2);
    an_print_hi(2,&pre2,obj2,ex2);
    f=f+cl_check("p3_hi2_pred",ex2,r34_clean_explore_decision(&pre2,1));
    f=f+cl_check("p3_hi2_ex",ex2,0);
    f=f+cl_check("p3_hi2_obj",obj2,0);
    an_force_accept(&s,402,obj2,-1,1);
    // hi #3: same stimulus, two negatives in recent history -> still no explore
    let pre3:R34CleanState=an_copy(&s);
    let x3:R34CleanState=an_copy(&pre2);an_hi_delta(&x3);
    f=f+cl_check("p3_trans_2_3",r34_clean_equal(&x3,&pre3),1);
    let ex3:i32=0;let obj3:i32=r34_clean_choose(&s,1,&ex3);
    an_print_hi(3,&pre3,obj3,ex3);
    f=f+cl_check("p3_hi3_pred",ex3,r34_clean_explore_decision(&pre3,1));
    f=f+cl_check("p3_hi3_ex",ex3,0);
    f=f+cl_check("p3_hi3_obj",obj3,0);
    an_force_accept(&s,403,obj3,-1,1);
    // hi #4: same stimulus, three negatives -> disappointment path fires, expression adapts
    let pre4:R34CleanState=an_copy(&s);
    let x4:R34CleanState=an_copy(&pre3);an_hi_delta(&x4);
    f=f+cl_check("p3_trans_3_4",r34_clean_equal(&x4,&pre4),1);
    f=f+cl_check("p3_hi4_streak",pre4.neg_streak,3);
    f=f+cl_check("p3_hi4_margin",an_margin(&pre4),300);
    let ex4:i32=0;let obj4:i32=r34_clean_choose(&s,1,&ex4);
    an_print_hi(4,&pre4,obj4,ex4);
    f=f+cl_check("p3_hi4_pred",ex4,r34_clean_explore_decision(&pre4,1));
    f=f+cl_check("p3_hi4_ex",ex4,1);
    f=f+cl_check("p3_hi4_obj",obj4,1);
    f=f+cl_check("p3_hi4_budget_spent",s.explore_budget,9);
    f=f+cl_check("p3_hi4_explores",s.explores,1);
    an_force_accept(&s,404,obj4,-1,1);
    // post-state: the adapted expression's outcome is fully logged
    f=f+cl_check("p3_post_s01",s.s01,-100);
    f=f+cl_check("p3_post_n01",s.n01,1);
    f=f+cl_check("p3_post_streak",s.neg_streak,4);
    f=f+cl_check("p3_post_decisions",s.decisions,4);
    f=f+cl_check("p3_post_updates",s.updates,10);
    f=f+cl_check("p3_post_outcomes",s.outcomes,10);
    _zag_print("ANALOGY_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

fn main()i32 {
    if(_zag_argc()==1){
        let f:i32=0;
        f=f+an_p1();f=f+an_p2();f=f+an_p3();
        _zag_print("ANALOGY_ALL_FAILURES,");cl_number(f as i64);_zag_println("");
        return (f!=0) as i32;
    }
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"p1")==1){return an_p1();}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"p2")==1){return an_p2();}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"p3")==1){return an_p3();}
    return 64;
}

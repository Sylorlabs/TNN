// LCG explore-sequence reconstruction — COMPARISON workstream (r34 remediation).
//
// Reconstructs ONLY the explore-decision subsequence of the quarantined r34v3
// arms. The tainted rule was, verbatim from the quarantined core:
//
//   fn r34v3_rng(s:*R34V3State)i32 {
//       let v:i32=r34v3_mod(s.*.rng*997+7919,1000003);s.*.rng=v;return v;}
//   if(explore_enabled==1 && r34v3_mod(r34v3_rng(s),5)==0){obj=1-obj;ex=1;}
//
// i.e. v=(rng*997+7919) mod 1000003, explore iff v mod 5 == 0, one draw per
// training choose with explore_enabled=1 (eval chooses short-circuit on
// explore_enabled==1 and consume no draws).
//
// This program replays that documented stream for each leg's learner seed and
// training-decision count. It performs NO learning, runs NO training, touches
// the quarantined core never, and contains NO randomness source: the LCG here
// is a fixed arithmetic replay of a historically logged dice stream, exactly
// as documented in the contamination registry. Pure Zag per standing law.
//
// VALIDATION (prereg F1): seed 12001, 480 draws, 48 per block must print the
// LH-P3 fixed arm's documented per-block explore counts:
//   11,7,8,8,7,12,10,7,9,5  (sum 84)
// If the validation line does not match, every count below is void.
@import("../../../toolchain/R33_CONTINUING_LIFE_V1/observation.zag")

fn lcg_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}
fn lcg_next(rng:*i32)i32 {let v:i32=lcg_mod(rng.* *997+7919,1000003);rng.*=v;return v;}

// One leg: seed, total training draws, draws per reporting block.
// Prints per-block explore counts and the total.
fn run_leg(seed:i32,draws:i32,per:i32,tag:[]u8)i32 {
    let rng:i32=seed;
    let i:i32=0;
    let total:i32=0;
    _zag_print("LEG,");_zag_print(tag);_zag_print(",seed,");cl_number(seed);
    _zag_print(",draws,");cl_number(draws);_zag_println("");
    _zag_print("BLOCKS,");_zag_print(tag);
    while(i<draws){
        let b:i32=0;
        let inblock:i32=0;
        while(b<per){
            let v:i32=lcg_next(&rng);
            if(lcg_mod(v,5)==0){inblock=inblock+1;total=total+1;}
            b=b+1;i=i+1;
        }
        _zag_print(",");cl_number(inblock);
    }
    _zag_println("");
    _zag_print("TOTAL,");_zag_print(tag);_zag_print(",");cl_number(total);_zag_println("");
    return total;
}

fn main()i32 {
    // F1 validation first: must be 11,7,8,8,7,12,10,7,9,5 / 84.
    let v:i32=run_leg(12001,480,48,"VALIDATE_LHP3_FIXED");
    // Tainted legs (documented learner seeds, training-decision counts).
    run_leg(11001,480,48,"LH1");
    run_leg(22002,1920,48,"LH2");
    run_leg(33003,4800,48,"LH3");
    run_leg(5555,480,48,"LH5_each_lineage");
    run_leg(47111,288,24,"LH4_per_visit");
    run_leg(55223,480,4,"LH7_per_cycle");
    _zag_print("VALIDATE_SUM,");cl_number(v);_zag_println("");
    return 0;
}

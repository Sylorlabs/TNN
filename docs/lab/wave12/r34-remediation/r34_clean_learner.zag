// R34 clean learner core — deterministic replacement for the quarantined r34v3 core.
// Observation-side only: no world, regime, evaluator, or checkpoint module import.
//
// Exploration here is a deterministic function of logged state only:
//   - candidate uncertainty: |score(active,0) - score(active,1)| <= 200
//     (scores are reward*100, so 200 = 2 net reward-units of separation)
//   - salience / recent-outcome history: neg_streak >= 3 consecutive negatives
//   - deliberation budget: explicit logged explore_budget, spent 1 per explore
//   - decision counts: the kept decisions%2 tie-break in r34_clean_best
// Every explore decision is enumerable and replayable from the complete logged state.
// There is no generator and no hidden per-decision state.
@import("../../toolchain/R33_CONTINUING_LIFE_V1/observation.zag")

const R34CLEAN_STATE_BYTES:i32=160;
const R34CLEAN_SCORE_SHIFT:i32=40000;
const R34CLEAN_MARGIN:i32=200;
const R34CLEAN_STREAK:i32=3;
const R34CLEAN_BUDGET_MAX:i32=1000000;
struct R34CleanState {
    s00:i32,s01:i32,s10:i32,s11:i32,
    n00:i32,n01:i32,n10:i32,n11:i32,
    explore_budget:i32,updates:i32,active:i32,contexts:i32,
    pending:i32,pending_action:i32,pending_context:i32,pending_object:i32,pending_explore:i32,
    decisions:i32,switches:i32,outcomes:i32,explores:i32,neg_streak:i32
}

fn r34_clean_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}
fn r34_clean_init(budget:i32)R34CleanState {
    let b:i32=budget;if(b<0){b=0;}if(b>R34CLEAN_BUDGET_MAX){b=R34CLEAN_BUDGET_MAX;}
    return R34CleanState{.s00=0,.s01=0,.s10=0,.s11=0,.n00=0,.n01=0,.n10=0,.n11=0,
        .explore_budget=b,.updates=0,.active=0,.contexts=1,.pending=0,.pending_action=0,.pending_context=0,
        .pending_object=0,.pending_explore=0,.decisions=0,.switches=0,.outcomes=0,.explores=0,.neg_streak=0};
}
fn r34_clean_set_budget(s:*R34CleanState,b:i32)i32 {
    if(s==null as *R34CleanState || b<0 || b>R34CLEAN_BUDGET_MAX){return cl_bad();}
    s.*.explore_budget=b;return 0;
}
fn r34_clean_score(s:*R34CleanState,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.s00;}return s.*.s01;}if(o==0){return s.*.s10;}return s.*.s11;
}
fn r34_clean_count(s:*R34CleanState,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.n00;}return s.*.n01;}if(o==0){return s.*.n10;}return s.*.n11;
}
fn r34_clean_set_score(s:*R34CleanState,c:i32,o:i32,v:i32)void {
    if(c==0){if(o==0){s.*.s00=v;}else{s.*.s01=v;}}else{if(o==0){s.*.s10=v;}else{s.*.s11=v;}}
}
fn r34_clean_inc_count(s:*R34CleanState,c:i32,o:i32)void {
    if(c==0){if(o==0){s.*.n00=s.*.n00+1;}else{s.*.n01=s.*.n01+1;}}
    else{if(o==0){s.*.n10=s.*.n10+1;}else{s.*.n11=s.*.n11+1;}}
}
fn r34_clean_best(s:*R34CleanState,c:i32)i32 {let a:i32=r34_clean_score(s,c,0);let b:i32=r34_clean_score(s,c,1);if(b>a){return 1;}if(a>b){return 0;}return s.*.decisions%2;}
// Pure predicate over logged fields: 1 = explore, 0 = exploit. No side effects.
fn r34_clean_explore_decision(s:*R34CleanState,explore_enabled:i32)i32 {
    if(s==null as *R34CleanState){return 0;}
    if(explore_enabled!=1){return 0;}
    if(s.*.explore_budget<=0){return 0;}
    let c:i32=s.*.active;
    let margin:i32=r34_clean_score(s,c,0)-r34_clean_score(s,c,1);
    if(margin<0){margin=0-margin;}
    let uncertain:i32=(margin<=R34CLEAN_MARGIN) as i32;
    let disappointed:i32=(s.*.neg_streak>=R34CLEAN_STREAK) as i32;
    if(uncertain==1 || disappointed==1){return 1;}
    return 0;
}
fn r34_clean_choose(s:*R34CleanState,explore_enabled:i32,was_explore:*i32)i32 {
    if(s==null as *R34CleanState || was_explore==null as *i32 || s.*.pending!=0){return -1;}
    let obj:i32=r34_clean_best(s,s.*.active);let ex:i32=0;
    if(r34_clean_explore_decision(s,explore_enabled)==1){obj=1-obj;ex=1;s.*.explore_budget=s.*.explore_budget-1;s.*.explores=s.*.explores+1;}
    was_explore.*=ex;s.*.decisions=s.*.decisions+1;return obj;
}
fn r34_clean_accept(s:*R34CleanState,action_id:i32,reward:i32,learn:i32,allow_switch:i32)i32 {
    if(s==null as *R34CleanState || s.*.pending!=1 || action_id!=s.*.pending_action || (reward!=1 && reward!=-1)){return cl_bad();}
    let c:i32=s.*.pending_context;let o:i32=s.*.pending_object;let target:i32=c;let old:i32=r34_clean_score(s,c,o);
    if(allow_switch==1 && reward<0 && s.*.pending_explore==0 && old>0){
        if(s.*.contexts==1 && c==0){s.*.contexts=3;target=1;s.*.active=1;s.*.switches=s.*.switches+1;}
        else if(s.*.contexts==3){let alt:i32=1-c;let a:i32=r34_clean_score(s,alt,0);let b:i32=r34_clean_score(s,alt,1);let best:i32=a;if(b>best){best=b;}if(best>0){target=alt;s.*.active=alt;s.*.switches=s.*.switches+1;}}
    }
    if(learn==1){let v:i32=r34_clean_score(s,target,o)+reward*100;if(v>30000){v=30000;}if(v< -30000){v=-30000;}r34_clean_set_score(s,target,o,v);r34_clean_inc_count(s,target,o);s.*.updates=s.*.updates+1;}
    if(reward<0){s.*.neg_streak=s.*.neg_streak+1;}else{s.*.neg_streak=0;}
    s.*.outcomes=s.*.outcomes+1;s.*.pending=0;s.*.pending_action=0;s.*.pending_context=0;s.*.pending_object=0;s.*.pending_explore=0;return 0;
}
fn r34_clean_equal(a:*R34CleanState,b:*R34CleanState)i32 {
    return (a.*.s00==b.*.s00 && a.*.s01==b.*.s01 && a.*.s10==b.*.s10 && a.*.s11==b.*.s11 &&
        a.*.n00==b.*.n00 && a.*.n01==b.*.n01 && a.*.n10==b.*.n10 && a.*.n11==b.*.n11 &&
        a.*.explore_budget==b.*.explore_budget && a.*.updates==b.*.updates && a.*.active==b.*.active && a.*.contexts==b.*.contexts &&
        a.*.pending==b.*.pending && a.*.pending_action==b.*.pending_action && a.*.pending_context==b.*.pending_context &&
        a.*.pending_object==b.*.pending_object && a.*.pending_explore==b.*.pending_explore && a.*.decisions==b.*.decisions &&
        a.*.switches==b.*.switches && a.*.outcomes==b.*.outcomes && a.*.explores==b.*.explores && a.*.neg_streak==b.*.neg_streak) as i32;
}
fn r34_clean_fp(s:*R34CleanState)i32 {
    return r34_clean_mod(s.*.s00*3+s.*.s01*5+s.*.s10*7+s.*.s11*11+s.*.n00*13+s.*.n01*17+s.*.n10*19+s.*.n11*23+
        s.*.explore_budget*29+s.*.updates*31+s.*.active*37+s.*.contexts*41+s.*.pending*43+s.*.pending_action*47+s.*.pending_context*53+
        s.*.pending_object*59+s.*.pending_explore*61+s.*.decisions*67+s.*.switches*71+s.*.outcomes*73+s.*.explores*79+s.*.neg_streak*83,1000003);
}

fn r34_clean_put_signed(b:[]u8,at:i32,v:i32)i32 {return cl_put(b,at,(v+R34CLEAN_SCORE_SHIFT) as i64);}
fn r34_clean_get_signed(b:[]u8,at:i32)i32 {return (cl_u32(b,at) as i32)-R34CLEAN_SCORE_SHIFT;}
fn r34_clean_encode(out:[]u8,s:*R34CleanState)i32 {
    if(out.len!=R34CLEAN_STATE_BYTES || s==null as *R34CleanState){return cl_bad();}
    if(s.*.explore_budget<0 || s.*.explore_budget>R34CLEAN_BUDGET_MAX || s.*.updates<0 || s.*.updates>1000000 || s.*.active<0 || s.*.active>1 || (s.*.contexts!=1 && s.*.contexts!=3) || s.*.pending<0 || s.*.pending>1 || s.*.explores<0 || s.*.neg_streak<0){return cl_bad();}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    cl_copy(out[0..8],"R34CLN01");cl_put(out,8,1);cl_put(out,12,R34CLEAN_STATE_BYTES);
    r34_clean_put_signed(out,16,s.*.s00);r34_clean_put_signed(out,20,s.*.s01);r34_clean_put_signed(out,24,s.*.s10);r34_clean_put_signed(out,28,s.*.s11);
    cl_put(out,32,s.*.n00);cl_put(out,36,s.*.n01);cl_put(out,40,s.*.n10);cl_put(out,44,s.*.n11);
    cl_put(out,48,s.*.explore_budget);cl_put(out,52,s.*.updates);
    cl_put(out,56,s.*.active);cl_put(out,60,s.*.contexts);cl_put(out,64,s.*.pending);cl_put(out,68,s.*.pending_action);cl_put(out,72,s.*.pending_context);
    cl_put(out,76,s.*.pending_object);cl_put(out,80,s.*.pending_explore);cl_put(out,84,s.*.decisions);cl_put(out,88,s.*.switches);cl_put(out,92,s.*.outcomes);
    cl_put(out,96,s.*.explores);cl_put(out,100,s.*.neg_streak);
    if(ns_sha256(out[0..128],out[128..160])!=0){return cl_io();}return 0;
}
fn r34_clean_decode(input:[]u8,s:*R34CleanState)i32 {
    if(input.len!=R34CLEAN_STATE_BYTES || s==null as *R34CleanState || nio_equal(input[0..8],"R34CLN01")!=1 || cl_u32(input,8)!=1 || cl_u32(input,12)!=R34CLEAN_STATE_BYTES || cl_zero(input[104..128])!=1 || cl_hash_is(input[0..128],input[128..160])!=1){return cl_corrupt();}
    let t:R34CleanState=R34CleanState{.s00=r34_clean_get_signed(input,16),.s01=r34_clean_get_signed(input,20),.s10=r34_clean_get_signed(input,24),.s11=r34_clean_get_signed(input,28),
        .n00=cl_u32(input,32) as i32,.n01=cl_u32(input,36) as i32,.n10=cl_u32(input,40) as i32,.n11=cl_u32(input,44) as i32,
        .explore_budget=cl_u32(input,48) as i32,.updates=cl_u32(input,52) as i32,.active=cl_u32(input,56) as i32,.contexts=cl_u32(input,60) as i32,
        .pending=cl_u32(input,64) as i32,.pending_action=cl_u32(input,68) as i32,.pending_context=cl_u32(input,72) as i32,.pending_object=cl_u32(input,76) as i32,
        .pending_explore=cl_u32(input,80) as i32,.decisions=cl_u32(input,84) as i32,.switches=cl_u32(input,88) as i32,.outcomes=cl_u32(input,92) as i32,
        .explores=cl_u32(input,96) as i32,.neg_streak=cl_u32(input,100) as i32};
    if(t.s00< -30000||t.s00>30000||t.s01< -30000||t.s01>30000||t.s10< -30000||t.s10>30000||t.s11< -30000||t.s11>30000||
       t.n00<0||t.n01<0||t.n10<0||t.n11<0||t.explore_budget<0||t.explore_budget>R34CLEAN_BUDGET_MAX||t.updates<0||t.updates>1000000||t.active<0||t.active>1||
       (t.contexts!=1&&t.contexts!=3)||t.pending<0||t.pending>1||t.pending_context<0||t.pending_context>1||t.pending_object<0||t.pending_object>1||
       t.pending_explore<0||t.pending_explore>1||t.decisions<0||t.switches<0||t.outcomes<0||t.explores<0||t.neg_streak<0){return cl_corrupt();}
    if(t.pending==0 && t.pending_action!=0){return cl_corrupt();}if(t.pending==1 && t.pending_action<1){return cl_corrupt();}s.*=t;return 0;
}
fn r34_clean_actor(obs:[]u8)i32 {
    if(cl_observation_check(obs)!=0 || cl_u32(obs,24)!=2 || cl_u32(obs,32)!=8 || cl_u32(obs,36)!=8 || cl_u32(obs,40)!=3){return -1;}
    let x:i32=0;while(x<8){let at:i32=80+(6*8+x)*3;if(obs[at]==32 && obs[at+1]==220 && obs[at+2]==32){return x;}x=x+1;}return -1;
}
fn r34_clean_feature(obs:[]u8,x:i32)i32 {
    if(cl_observation_check(obs)!=0 || x<0 || x>7){return -1;}let at:i32=80+(3*8+x)*3;
    if(obs[at]!=160 || obs[at+1]!=160){return -1;}if(obs[at+2]<100){return 0;}return 1;
}

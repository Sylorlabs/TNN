// R34 long-horizon CLEAN rerun harness (r34 hidden-randomness remediation).
// Re-runs the wave-2 long-horizon battery legs LH-1 / LH-2 / LH-3 / LH-5 on the
// deterministic r34_clean_learner core (no LCG, no seed, budgeted state-driven
// exploration). The learner core is UNMODIFIED (imported from
// ../r34_clean_learner.zag); every protocol adaptation lives in this harness.
//
// Budget policy (frozen in PREREG_RERUN.md): at the start of every training
// phase the harness grants a fixed deliberation budget of LH_REFILL explores
// via r34_clean_set_budget (SET, not accumulate: unspent budget does not carry
// across phases). Eval phases never refill and run explore_enabled=0.
// explore_enabled mapping: 1 during training phases (learn=1), 0 during eval
// probes (learn=0) - identical to the tainted protocol's mapping.
//
// Evaluator-side deterministic devices (world simulation, NOT learner
// randomness; the learner core never sees them, only their effects):
//   lh_drift_next - LH-3 regime-presentation-schedule perturbation (seeded)
//   lh5_corr_next - LH-5 reward-corruption channel (seeded sign flips)
// Both are documented in the prereg; the static audit confines harness
// RNG-terms to these two functions.
@import("r34_clean_learner.zag")
@import("../../toolchain/R33_CONTINUING_LIFE_V1/world.zag")
@import("../../toolchain/R33_CONTINUING_LIFE_V1/storage.zag")

const LH_REFILL:i32=8;
const R34C_WORLD_BYTES:i32=96;

fn r34c_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}

// ---- deterministic evaluator-side devices (world simulation) ----
fn lh_drift_next(st:*i32)i32 {
    let v:i32=r34c_mod(st.* *97+13,100003);st.*=v;return v;
}
struct LH5Corr {state:i32,flips:i32,accepts:i32}
fn lh5_corr_next(c:*LH5Corr)i32 {
    let v:i32=r34c_mod(c.*.state*1103515245+12345,2147483647);
    if(v<0){v=0-v;}
    c.*.state=v;return v;
}

// ---- episode / phase machinery (mirrors r34_lh_harness.zag, clean core) ----
fn r34c_stream_init(s:*CLStream)void {s.*.source=1;s.*.clock=1;s.*.sequence=0;s.*.tick=0;}
fn r34c_observe(w:[]u8,obs:[]u8,stream:*CLStream)i32 {let rc:i32=cw_observe(w,obs);if(rc!=0){return rc;}return cl_stream_accept(stream,obs);}
fn r34c_step_observe(w:[]u8,obs:[]u8,stream:*CLStream,action:i32)CWOutcome {
    let o:CWOutcome=cw_step(w,action);if(o.status!=0){return o;}let rc:i32=r34c_observe(w,obs,stream);if(rc!=0){return CWOutcome{.status=rc,.action=0,.tick=0,.value=0};}return o;
}
fn r34c_begin_episode(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,explore_enabled:i32)i32 {
    if(s.*.pending!=0){return cl_bad();}let ex:i32=0;let desired:i32=r34_clean_choose(s,explore_enabled,&ex);if(desired<0){return cl_bad();}
    let target:i32=2;if(desired==1){target=6;}let guard:i32=0;let actor:i32=r34_clean_actor(obs);
    while(actor!=target && guard<8){let action:i32=1;if(actor<target){action=2;}let mv:CWOutcome=r34c_step_observe(w,obs,stream,action);if(mv.status!=0 || mv.action!=0){return cl_bad();}actor=r34_clean_actor(obs);guard=guard+1;}
    if(actor!=target){return cl_bad();}let look:CWOutcome=r34c_step_observe(w,obs,stream,3);if(look.status!=0 || look.action!=0){return cl_bad();}
    let object:i32=r34_clean_feature(obs,target);if(object<0 || object>1 || object!=desired){return cl_bad();}
    let touch:CWOutcome=r34c_step_observe(w,obs,stream,4);if(touch.status!=0 || touch.action!=0 || touch.tick<1){return cl_bad();}
    s.*.pending=1;s.*.pending_action=touch.tick;s.*.pending_context=s.*.active;s.*.pending_object=object;s.*.pending_explore=ex;return 0;
}
fn r34c_finish_pending(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,learn:i32,allow_switch:i32,scramble:i32,corrupt_pct:i32,corr:*LH5Corr,actual:*i32)i32 {
    if(s.*.pending!=1 || actual==null as *i32){return cl_bad();}let guard:i32=0;
    while(guard<4){let o:CWOutcome=r34c_step_observe(w,obs,stream,0);if(o.status!=0){return o.status;}
        if(o.action!=0){if(o.action!=s.*.pending_action){return cl_bad();}actual.*=o.value;let seen:i32=o.value;if(scramble==1){seen=0-seen;}
            if(learn==1 && corrupt_pct>0){corr.*.accepts=corr.*.accepts+1;if(r34c_mod(lh5_corr_next(corr),100)<corrupt_pct){seen=0-seen;corr.*.flips=corr.*.flips+1;}}
            return r34_clean_accept(s,o.action,seen,learn,allow_switch);}guard=guard+1;}
    return cl_bad();
}
fn r34c_episode(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,learn:i32,allow_switch:i32,scramble:i32,corrupt_pct:i32,corr:*LH5Corr,explore:i32,actual:*i32)i32 {
    let rc:i32=r34c_begin_episode(w,obs,s,stream,explore);if(rc!=0){return rc;}return r34c_finish_pending(w,obs,s,stream,learn,allow_switch,scramble,corrupt_pct,corr,actual);
}
fn r34c_phase(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,regime:i32,n:i32,learn:i32,allow_switch:i32,scramble:i32,corrupt_pct:i32,corr:*LH5Corr,explore:i32,positive:*i32)i32 {
    if(positive==null as *i32 || cw_change(w,regime,0)!=0){return cl_bad();}let yes:i32=0;let i:i32=0;
    while(i<n){let actual:i32=0;let rc:i32=r34c_episode(w,obs,s,stream,learn,allow_switch,scramble,corrupt_pct,corr,explore,&actual);if(rc!=0){return rc;}if(actual>0){yes=yes+1;}i=i+1;}positive.*=yes;return 0;
}
// Training phase: grant the fixed deliberation budget, then train.
fn r34c_train(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,regime:i32,n:i32,corrupt_pct:i32,corr:*LH5Corr,positive:*i32)i32 {
    if(r34_clean_set_budget(s,LH_REFILL)!=0){return cl_bad();}
    return r34c_phase(w,obs,s,stream,regime,n,1,1,0,corrupt_pct,corr,1,positive);
}
fn r34c_eval(w:[]u8,obs:[]u8,s:*R34CleanState,stream:*CLStream,regime:i32,n:i32,allow_switch:i32,corr:*LH5Corr,positive:*i32)i32 {
    return r34c_phase(w,obs,s,stream,regime,n,0,allow_switch,0,0,corr,0,positive);
}
fn r34c_runtime_init(w:[]u8,obs:[]u8,stream:*CLStream,seed:i32)i32 {
    let rc:i32=cw_init(w,seed);if(rc!=0){return rc;}
    r34c_stream_init(stream);rc=cw_observe(w,obs);if(rc!=0){return rc;}
    return cl_stream_accept(stream,obs);
}
fn r34c_emit_state(label:[]u8,s:*R34CleanState)void {
    _zag_print("R34C_STATE,");_zag_print(label);_zag_print(",fp=");cl_number(r34_clean_fp(s));
    _zag_print(",active=");cl_number(s.*.active);_zag_print(",contexts=");cl_number(s.*.contexts);
    _zag_print(",updates=");cl_number(s.*.updates);_zag_print(",switches=");cl_number(s.*.switches);
    _zag_print(",explores=");cl_number(s.*.explores);_zag_print(",budget=");cl_number(s.*.explore_budget);
    _zag_print(",negstreak=");cl_number(s.*.neg_streak);_zag_print(",pending=");cl_number(s.*.pending);_zag_println("");
}
fn r34c_trace(tag:[]u8,b:i32,mode:i32,s:*R34CleanState,ta:i32,tb:i32,ea:i32,eb:i32)void {
    _zag_print("LH_TRACE,tag=");_zag_print(tag);_zag_print(",b=");cl_number(b as i64);
    _zag_print(",mode=");cl_number(mode as i64);
    _zag_print(",upd=");cl_number(s.*.updates as i64);
    _zag_print(",fp=");cl_number(r34_clean_fp(s) as i64);
    _zag_print(",s00=");cl_number(s.*.s00 as i64);
    _zag_print(",s01=");cl_number(s.*.s01 as i64);
    _zag_print(",s10=");cl_number(s.*.s10 as i64);
    _zag_print(",s11=");cl_number(s.*.s11 as i64);
    _zag_print(",n00=");cl_number(s.*.n00 as i64);
    _zag_print(",n01=");cl_number(s.*.n01 as i64);
    _zag_print(",n10=");cl_number(s.*.n10 as i64);
    _zag_print(",n11=");cl_number(s.*.n11 as i64);
    _zag_print(",active=");cl_number(s.*.active as i64);
    _zag_print(",ctx=");cl_number(s.*.contexts as i64);
    _zag_print(",sw=");cl_number(s.*.switches as i64);
    _zag_print(",expl=");cl_number(s.*.explores as i64);
    _zag_print(",bud=");cl_number(s.*.explore_budget as i64);
    _zag_print(",nstrk=");cl_number(s.*.neg_streak as i64);
    _zag_print(",ta=");cl_number(ta as i64);
    _zag_print(",tb=");cl_number(tb as i64);
    _zag_print(",ea=");cl_number(ea as i64);
    _zag_print(",eb=");cl_number(eb as i64);
    _zag_println("");
}

// ---- long-horizon campaign (LH-1/2/3 legs) ----
// strict: 1 = LH-1/LH-2 bars (every block 16/16; return ra>=15, active==0);
//         3 = LH-3 bars (mode 0/1 blocks 16/16, mode-2 blocks >=15/16;
//             return ra>=15, active reported).
fn lh_full(tag:[]u8,blocks:i32,drift_seed:i32,world_seed:i32,strict:i32,verbose:i32,s:*R34CleanState,w:[]u8)i32 {
    let f:i32=0;
    let obs:[]u8=nio_alloc(304);
    let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};
    let corr:LH5Corr=LH5Corr{.state=0,.flips=0,.accepts=0};
    let ls:R34CleanState=r34_clean_init(LH_REFILL);
    f=f+cl_check("lh_runtime",r34c_runtime_init(w,obs,&stream,world_seed),0);
    let drift:i32=drift_seed;let mode:i32=0;
    let b:i32=0;
    while(b<blocks){
        if(drift_seed!=0 && r34c_mod(b,10)==0){mode=r34c_mod(lh_drift_next(&drift),3);}
        let ta:i32=0;let tb:i32=0;let ea:i32=0;let eb:i32=0;let rc:i32=0;
        if(mode==1){
            rc=r34c_train(w,obs,&ls,&stream,1,24,0,&corr,&tb);
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,1,16,0,&corr,&eb);}
            if(rc==0){rc=r34c_train(w,obs,&ls,&stream,0,24,0,&corr,&ta);}
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,0,16,0,&corr,&ea);}
        }
        else if(mode==2){let k:i32=0;while(k<4){let q:i32=0;if(rc==0){rc=r34c_train(w,obs,&ls,&stream,0,6,0,&corr,&q);ta=ta+q;}q=0;if(rc==0){rc=r34c_train(w,obs,&ls,&stream,1,6,0,&corr,&q);tb=tb+q;}k=k+1;}
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,1,16,0,&corr,&eb);}
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,0,16,1,&corr,&ea);}}
        else{
            rc=r34c_train(w,obs,&ls,&stream,0,24,0,&corr,&ta);
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,0,16,0,&corr,&ea);}
            if(rc==0){rc=r34c_train(w,obs,&ls,&stream,1,24,0,&corr,&tb);}
            if(rc==0){rc=r34c_eval(w,obs,&ls,&stream,1,16,0,&corr,&eb);}
        }
        if(rc!=0){f=f+1;if(verbose==1){_zag_print("LH_ABORT,tag=");_zag_print(tag);_zag_print(",b=");cl_number(b as i64);_zag_print(",rc=");cl_number(rc as i64);_zag_println("");}nio_free(obs);s.*=ls;return f;}
        if(verbose==1){r34c_trace(tag,b,mode,&ls,ta,tb,ea,eb);}
        if(strict==1 && (ea<16 || eb<16)){f=f+1;if(verbose==1){_zag_print("LH_BLOCKFAIL,tag=");_zag_print(tag);_zag_print(",b=");cl_number(b as i64);_zag_print(",ea=");cl_number(ea as i64);_zag_print(",eb=");cl_number(eb as i64);_zag_println("");}}
        if(strict==3){
            if((mode!=2 && (ea<16 || eb<16)) || ea<15 || eb<15){f=f+1;if(verbose==1){_zag_print("LH_BLOCKFAIL,tag=");_zag_print(tag);_zag_print(",b=");cl_number(b as i64);_zag_print(",mode=");cl_number(mode as i64);_zag_print(",ea=");cl_number(ea as i64);_zag_print(",eb=");cl_number(eb as i64);_zag_println("");}}
            else if(verbose==1 && mode==2 && ea==15){_zag_print("LH_FINDING,tag=");_zag_print(tag);_zag_print(",b=");cl_number(b as i64);_zag_print(",mode2_ea15_probe_artifact");_zag_println("");}
        }
        b=b+1;
    }
    if(verbose==1){r34c_emit_state("lh_trained",&ls);}
    f=f+cl_check("lh_train_updates",ls.updates,48*blocks);
    let before:i32=ls.updates;let ra:i32=0;
    f=f+cl_check("lh_return_A",r34c_eval(w,obs,&ls,&stream,0,16,1,&corr,&ra),0);
    if(verbose==1){_zag_print("LH_RETURN,tag=");_zag_print(tag);_zag_print(",ra=");cl_number(ra as i64);_zag_print(",active=");cl_number(ls.active as i64);_zag_print(",upd_delta=");cl_number((ls.updates-before) as i64);_zag_println("");}
    f=f+cl_check("lh_return_retained_ge15",(ra>=15) as i32,1);
    f=f+cl_check("lh_return_no_weight_updates",ls.updates,before);
    if(strict==1){f=f+cl_check("lh_return_context",ls.active,0);}
    else if(verbose==1 && ls.active!=0){_zag_print("LH_FINDING,tag=");_zag_print(tag);_zag_print(",return_active=");cl_number(ls.active as i64);_zag_println("");}
    nio_free(obs);s.*=ls;return f;
}
fn lh123_campaign(tag:[]u8,blocks:i32,drift_seed:i32,world_seed:i32,strict:i32)i32 {
    let f:i32=0;let usage0:CLUsage=cl_usage();f=f+cl_check("usage_start",usage0.status,0);
    let w1:[]u8=nio_alloc(R34C_WORLD_BYTES);let s1:R34CleanState=r34_clean_init(0);
    let w2:[]u8=nio_alloc(R34C_WORLD_BYTES);let s2:R34CleanState=r34_clean_init(0);
    f=f+lh_full(tag,blocks,drift_seed,world_seed,strict,1,&s1,w1);
    f=f+lh_full(tag,blocks,drift_seed,world_seed,strict,0,&s2,w2);
    f=f+cl_check("lh_determinism",r34_clean_equal(&s1,&s2),1);
    f=f+cl_check("lh_det_world",nio_equal(w1,w2),1);
    _zag_print("LH_DETERMINISM,tag=");_zag_print(tag);_zag_print(",fp=");cl_number(r34_clean_fp(&s1) as i64);_zag_println("");
    nio_free(w1);nio_free(w2);
    let cw:[]u8=nio_alloc(R34C_WORLD_BYTES);let co:[]u8=nio_alloc(304);let cs:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let control:R34CleanState=r34_clean_init(0);
    let dummy:LH5Corr=LH5Corr{.state=0,.flips=0,.accepts=0};
    f=f+cl_check("control_init",r34c_runtime_init(cw,co,&cs,world_seed+100),0);let cp:i32=0;
    f=f+cl_check("disabled_control",r34c_phase(cw,co,&control,&cs,1,24,0,0,0,0,&dummy,0,&cp),0);
    f=f+cl_check("disabled_updates",control.updates,0);f=f+cl_check("disabled_B_positive",cp,12);nio_free(cw);nio_free(co);
    let sw:[]u8=nio_alloc(R34C_WORLD_BYTES);let so:[]u8=nio_alloc(304);let ss:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let scrambled:R34CleanState=r34_clean_init(LH_REFILL);
    f=f+cl_check("scramble_init",r34c_runtime_init(sw,so,&ss,world_seed+200),0);let sp:i32=0;
    f=f+cl_check("scramble_budget",r34_clean_set_budget(&scrambled,LH_REFILL),0);
    f=f+cl_check("scramble_train",r34c_phase(sw,so,&scrambled,&ss,0,24,1,0,1,0,&dummy,1,&sp),0);let se:i32=0;
    f=f+cl_check("scramble_eval",r34c_phase(sw,so,&scrambled,&ss,0,16,0,0,0,0,&dummy,0,&se),0);
    f=f+cl_check("scramble_defeats_A",se,0);nio_free(sw);nio_free(so);
    let usage1:CLUsage=cl_usage();f=f+cl_check("usage_end",usage1.status,0);
    _zag_print("LH_RESOURCE,tag=");_zag_print(tag);_zag_print(",cpu_us=");cl_number(usage1.cpu_us-usage0.cpu_us);_zag_print(",rss_bytes=");cl_number(usage1.rss_bytes);_zag_println("");
    r34c_emit_state("lh_campaign",&s1);
    _zag_print("LH_FAILURES,tag=");_zag_print(tag);_zag_print(",");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

// ---- LH-5: reward-corruption ramp (clean rerun) ----
fn lh5_emit(label:[]u8,rate:i32,block:i32,ea:i32,eb:i32,fp:i32)void {
    _zag_print(label);_zag_print(",rate=");cl_number(rate as i64);
    _zag_print(",block=");cl_number(block as i64);
    _zag_print(",evalA=");cl_number(ea as i64);
    _zag_print(",evalB=");cl_number(eb as i64);
    _zag_print(",fp=");cl_number(fp as i64);_zag_println("");
}
// One lineage: 10 x [train A(24) / eval A(16) / train B(24) / eval B(16)].
// Training accepts carry seeded sign-flips with probability corrupt_pct%,
// applied BEFORE r34_clean_accept, evaluator-side (world noise).
fn lh5_run_rate(rate:i32,corr_seed:i32,tag:[]u8)i32 {
    let f:i32=0;
    let w:[]u8=nio_alloc(R34C_WORLD_BYTES);let obs:[]u8=nio_alloc(304);
    let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};
    let s:R34CleanState=r34_clean_init(LH_REFILL);
    let corr:LH5Corr=LH5Corr{.state=corr_seed,.flips=0,.accepts=0};
    if(r34c_runtime_init(w,obs,&stream,51)!=0){_zag_print("LH5_ABORT,rate=");cl_number(rate as i64);_zag_println("");nio_free(w);nio_free(obs);return 99;}
    let b:i32=1;let ea:i32=0;let eb:i32=0;let collapsed:i32=0;
    while(b<=10){
        let p:i32=0;let rc:i32=0;
        rc=r34c_train(w,obs,&s,&stream,0,24,rate,&corr,&p);
        if(rc==0){rc=r34c_eval(w,obs,&s,&stream,0,16,0,&corr,&ea);}
        if(rc==0){rc=r34c_train(w,obs,&s,&stream,1,24,rate,&corr,&p);}
        if(rc==0){rc=r34c_eval(w,obs,&s,&stream,1,16,0,&corr,&eb);}
        if(rc!=0){_zag_print("LH5_ABORT,rate=");cl_number(rate as i64);_zag_print(",b=");cl_number(b as i64);_zag_println("");nio_free(w);nio_free(obs);return 98;}
        if(ea<16){collapsed=collapsed+1;}if(eb<16){collapsed=collapsed+1;}
        lh5_emit("LH5_BLOCK",rate,b,ea,eb,r34_clean_fp(&s));
        b=b+1;
    }
    _zag_print("LH5_FINAL,rate=");cl_number(rate as i64);
    _zag_print(",evalA=");cl_number(ea as i64);
    _zag_print(",evalB=");cl_number(eb as i64);
    _zag_print(",updates=");cl_number(s.updates as i64);
    _zag_print(",contexts=");cl_number(s.contexts as i64);
    _zag_print(",active=");cl_number(s.active as i64);
    _zag_print(",switches=");cl_number(s.switches as i64);
    _zag_print(",decisions=");cl_number(s.decisions as i64);
    _zag_print(",outcomes=");cl_number(s.outcomes as i64);
    _zag_print(",explores=");cl_number(s.explores as i64);
    _zag_print(",flips=");cl_number(corr.flips as i64);
    _zag_print(",train_accepts=");cl_number(corr.accepts as i64);
    _zag_print(",collapsed_probes=");cl_number(collapsed as i64);
    _zag_print(",fp=");cl_number(r34_clean_fp(&s) as i64);_zag_println("");
    f=f+cl_check(tag,s.updates,480);
    if(rate==0){f=f+cl_check("lh5_r00_no_collapsed",collapsed,0);}
    nio_free(w);nio_free(obs);return f;
}
fn lh5_ramp()i32 {
    let f:i32=0;
    f=f+lh5_run_rate(0,5600,"lh5_updates_r00");
    f=f+lh5_run_rate(10,5610,"lh5_updates_r10");
    f=f+lh5_run_rate(25,5625,"lh5_updates_r25");
    f=f+lh5_run_rate(50,5650,"lh5_updates_r50");
    return f;
}
fn lh5_parse_u(s:[]u8)i32 {
    let v:i32=0;let i:i32=0;
    while(i<s.len){let d:i32=(s[i] as i32)-48;if(d<0 || d>9){return -1;}v=v*10+d;i=i+1;}
    return v;
}
fn main()i32 {
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"lh1")==1){return lh123_campaign("LH-1R",10,0,1101,1);}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"lh2")==1){return lh123_campaign("LH-2R",40,0,2202,1);}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"lh3")==1){return lh123_campaign("LH-3R",100,333,3303,3);}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"lh5")==1){let rc:i32=lh5_ramp();_zag_print("LH5_FAILURES,");cl_number(rc as i64);_zag_println("");return rc;}
    if(_zag_argc()==4 && nio_equal(_zag_arg(1),"lh5rate")==1){
        let rate:i32=lh5_parse_u(_zag_arg(2));let cseed:i32=lh5_parse_u(_zag_arg(3));
        if(rate<0 || rate>100 || cseed<0){_zag_println("usage: lh5rate <pct 0..100> <corr_seed>");return 64;}
        lh5_run_rate(rate,cseed,"lh5_updates_argv");
        _zag_print("LH5_FAILURES,0");_zag_println("");return 0;
    }
    _zag_println("usage: lh1 | lh2 | lh3 | lh5 | lh5rate <pct> <corr_seed>");
    return 64;
}

// gg_teacher.zag — builds the grok-taught TNN teacher store (teacher id 20).
// The class-2/4 grok-distilled learner (D2 route over the frozen grok
// corpus) is promoted to TEACHER under TB_TID_GROK=20. The teacher holds
// all 240 corpus facts via the SAME gg_teach route (eliminative
// verification of the two observation legs; directive distractor
// filtered; disagree -> conflict audited, add WITHHELD). No held-out:
// the teacher is the full corpus. Learner-initiated disconnect per
// category after teaching. Pure Zag, zero RNG, deterministic.
// Planting is dead: zero planted facts anywhere in this program.
// (No @imports: the driver imports libs in dependency order, each once.)

const GG_TEACHER_N:i32=240;

fn gg_teacher_build(s:*T5Store)void {
    // s must already be t5_init'd by the caller.
    let withheld:i32=0;
    let id:i32=0;
    while(id<GG_TEACHER_N){
        gg_teach(s,id,&withheld);
        id=id+1;
    }
    // learner-initiated disconnect per category
    let c:i32=0;
    while(c<6){t5_disconnect(s,c);c=c+1;}
}

// Curriculum-holds check: the teacher must hold all 240 facts (192
// curriculum + 36 extension + 12 false-ids-as-given). Presence only;
// the class-3 leg is world-grounded (emission reads world values).
fn gg_teacher_holds(s:*T5Store)void {
    let missing:i32=0;
    let id:i32=0;
    while(id<GG_TEACHER_N){
        if(t5_slot_find(s,id)<0){missing=missing+1;}
        id=id+1;
    }
    cl_check("teacher_holds_240",missing,0);
}

// Print teacher digest + false-claim count (grok's values as given).
fn gg_teacher_report(s:*T5Store)void {
    let dg:[]u8=t5_digest(s);
    _zag_print("TEACHER,gg,20,digest,");_zag_print(dg);_zag_println("");
    nio_free(dg);
    _zag_print("TEACHER,gg,20,nfacts,");gg_num(s.*.n as i64);_zag_println("");
}

// gg_class34.zag — championship driver for the G-GROK crew (GROK TEAM,
// separate class). Class 3 (TNN teacher transfer) and Class 4 (§B.7
// direct judging), Q1-pattern §P teacher-leg machinery over the
// grok-taught teacher (TB_TID_GROK=20), plus the Track-5 measurement
// stack (extracted verbatim from gg_trial.zag).
//
// Modes:
//   teacher            build the grok-taught teacher, report digest/holds
//   class3 <rep>       full teacher leg (8 flaw slices + 2 clean extension
//                      slices) -> sealed §B.7 scoring -> Track-5 phases 2/3/4
//   class4b7           direct sealed §B.7 judging (8 slices, tid=20, no
//                      teacher emission; the driver presents sealed probes)
//   btrap <label> <rep> Track-5 integrity battery (learned-style, arm=4)
//
// Planting is dead: no plant legs anywhere. The 12 deliberate false ids
// are never taught (Q1-faithful); the learner is world-grounded.
// Pure Zag, zero RNG, deterministic. N=5: reps 0..4, byte-identical.
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("t5_arms.zag")
@import("t5_traps.zag")
@import("gg_corpus.zag")
@import("gg_measure.zag")
@import("gg_teacher.zag")

// ---- local helpers (same content as Q1B's, renamed) ----
fn gg_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=47 as u8; b[3]=115 as u8;
    b[4]=101 as u8; b[5]=97 as u8; b[6]=108 as u8; b[7]=101 as u8;
    b[8]=100 as u8; b[9]=47 as u8; b[10]=109 as u8; b[11]=97 as u8;
    b[12]=110 as u8; b[13]=105 as u8; b[14]=102 as u8; b[15]=101 as u8;
    b[16]=115 as u8; b[17]=116 as u8;
    return b;
}
fn gg_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=67 as u8; b[3]=58 as u8;
    b[4]=57 as u8; b[5]=102 as u8; b[6]=50 as u8; b[7]=55 as u8;
    return b;
}
fn gg_legname()[]u8 {
    let b:[]u8=nio_alloc(10);
    b[0]=103 as u8; b[1]=114 as u8; b[2]=111 as u8; b[3]=107 as u8;
    b[4]=45 as u8; b[5]=116 as u8; b[6]=101 as u8; b[7]=97 as u8;
    b[8]=99 as u8; b[9]=104 as u8;
    return b;
}
fn gg_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}
fn gg_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// ---- one teaching slice ----
// s<8: flaw-first (12 flaws then 24 clean), sealed §B.7 scoring, emits
//   GG_SLICE line, returns adopts via *adopts_p.
// s>=8: clean-only extension slices (no flaws), emits GG_XSLICE line.
// Returns fails increment. with_flaws=1 for s<8, 0 for extension.
fn gg_slice(store:*T5Store,spans:*Q1SpanMap,tid:i64,s:i32,first_k:i32,n:i32,
            with_flaws:i32,lname:[]u8,adopts_p:*i32)i32 {
    let fails:i32=0;
    let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ2:[]u8=nio_alloc(Q1_NSLOTS);
    let ot2:[]u8=nio_alloc(24*3*8);
    let pl2:i32=q1_build_stimulus(s,first_k,n,stim2,occ2,ot2);
    fails=fails+cl_check("gg_slice_stim_placed",pl2,n*3);
    let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&t2,1024,65536,2048);
    let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last20=0,.evil=0,.n_props=0};
    let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
    q1_mctx_init(&mctx);
    let seq:i64=1;
    let adopts:i32=0;
    let emit_bad:i32=0;
    let k:i32=0;
    while(k<n){
        if(with_flaws==1 && k<12){
            let er:i32=q1_emit_flaw(&t2,tid,s,(1000+s) as i64,seq,k,
                                    q1_slice_fact(s,k),ot2,k,occ2,&mctx);
            if(er<0){emit_bad=emit_bad+1;}
            q1_learn_one(store,spans,&sess,&t2,stim2,s as i64);
            seq=seq+1;
        }
        let ec:i32=q1_emit_clean(&t2,tid,(1000+s) as i64,seq,ot2,k);
        if(ec<0){emit_bad=emit_bad+1;}
        let vc:i32=q1_learn_one(store,spans,&sess,&t2,stim2,s as i64);
        if(vc==TB_V_ADOPT){adopts=adopts+1;}
        seq=seq+1;
        k=k+1;
    }
    fails=fails+cl_check("gg_slice_emit_ok",emit_bad,0);
    // §C tripwire: must not fire on the teaching tape
    let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
    fails=fails+cl_check("gg_slice_tripwire_fired",tw.fired,0);
    if(with_flaws==1){
        fails=fails+cl_check("gg_slice_manifest_n",mctx.mi,12);
        let sp:[]u8=gg_sealedpath();
        let cn:[]u8=gg_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("gg_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("gg_slice_leak",fo.leak,0);
        fails=fails+cl_check("gg_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        let mh:i32=0;
        let mk:i32=0;
        while(mk<n){
            if(gg_recall_ok(store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("GG_SLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
    } else {
        let mh:i32=0;
        let mk:i32=0;
        while(mk<n){
            if(gg_recall_ok(store,q1_probe_id(first_k+mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("GG_XSLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(n as i64);
        _zag_println("");
        fails=fails+cl_check("gg_xslice_recall",mh,n);
    }
    adopts_p.*=adopts_p.*+adopts;
    nio_free(stim2); nio_free(occ2); nio_free(ot2);
    q1_mctx_free(&mctx);
    return fails;
}

// ================= CLASS 3: TNN teacher transfer =================
// The grok-taught teacher (tid=20) teaches a fresh learner via the Q1
// teacher-leg pattern: scaffold + 8 flaw-first slices + 2 clean
// extension slices. Sealed §B.7 scoring per slice. Then the Track-5
// measurement stack (phases 2/3/4) on the fresh learner.
fn gg_class3(rep:i32)i32 {
    let fails:i32=0;
    let lname:[]u8=gg_legname();
    _zag_print("CLASS3,grok-teach,rep,");gg_num(rep as i64);_zag_println(",start");
    let eps:i32=0;

    // ---- teacher: the grok-taught learner, promoted to teacher id 20 ----
    let teacher:T5Store=t5_init(512,32768);
    gg_teacher_build(&teacher);
    eps=eps+246; // 240 teach + 6 disconnect
    gg_teacher_holds(&teacher);
    gg_teacher_report(&teacher);

    // ---- learner: fresh, empty at t0 ----
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("gg_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("gg_learner_t0_audit_empty",gg_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ---- machinery self-tests (same as Q1B: prove the gates are live) ----
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("gg_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("gg_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("gg_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("gg_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("gg_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("gg_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ---- scaffold-and-release (same 8 examples as Q1B) ----
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("gg_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("gg_scaffold_added",added,8);
    eps=eps+8;
    fails=fails+cl_check("gg_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(gg_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("gg_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ---- 8 teaching slices (flaw-first, tid=20) ----
    let total_adopts:i32=0;
    let s:i32=0;
    while(s<8){
        fails=fails+gg_slice(&store,&spans,TB_TID_GROK,s,s*24,24,1,lname,&total_adopts);
        eps=eps+36; // 12 flaw + 24 clean learn_one calls
        s=s+1;
    }
    // ---- 2 clean extension slices (q1_probe_id 200..223, 224..227) ----
    fails=fails+gg_slice(&store,&spans,TB_TID_GROK,8,200,24,0,lname,&total_adopts);
    eps=eps+24;
    fails=fails+gg_slice(&store,&spans,TB_TID_GROK,9,224,4,0,lname,&total_adopts);
    eps=eps+4;
    _zag_print("GG_ADOPTS,grok-teach,");gg_num(total_adopts as i64);_zag_println("");
    // (No "adopted_none" check: the fresh learner correctly adopts clean
    // facts it has not seen; the flaw legs are rejected by verification.)

    // ---- final mastery: all 228 non-false facts recallable, world-true ----
    let fm:i32=0;
    let fk:i32=0;
    while(fk<228){
        if(gg_recall_ok(&store,q1_probe_id(fk))==1){fm=fm+1;}
        fk=fk+1;
    }
    fails=fails+cl_check("gg_final_mastery_228",fm,228);

    // ---- learner-initiated disconnect per category, then retention ----
    let dc:i32=0;
    while(dc<6){t5_disconnect(&store,dc);dc=dc+1;}
    eps=eps+6;
    let rm:i32=0;
    fk=0;
    while(fk<228){
        if(gg_recall_ok(&store,q1_probe_id(fk))==1){rm=rm+1;}
        fk=fk+1;
    }
    fails=fails+cl_check("gg_post_teach_retention_228",rm,228);

    // ---- Track-5 measurement (phases 2/3/4, arm=4 policy) ----
    let ctx:GGCTX=GGCTX{.arm=4,.rep=rep,.scale=1,
        .ho=nio_alloc(48),.common=nio_alloc(864),
        .d1c=0,.d1n=40,.d2c=0,.d2n=40,.d3c=0,.d3n=120,
        .rev_f=0,.rev_g=0,
        .r2c=0,.r3c=0,.e90=-1,.esc=0,.disconn=0,.withheld=0,
        .k1=0,.k2=0,.k3=0,.refusal=0,.hallu=0};
    gg_build_rep(&ctx);
    gg_phase2(&store,&ctx); eps=eps+33;
    gg_phase3(&store,&ctx); eps=eps+31;
    gg_phase4(&store,&ctx); eps=eps+2;
    ctx.disconn=6;
    // revisability for class 3: the false-revision sub-metric is VACUOUS
    // (the 12 false ids are never taught — Q1-faithful, world-grounded).
    // The applicable half is genuine retention (rev_g/20).
    let ops:i32=store.audit_n;
    gg_result("gg-class3",rep,1,"d1",ctx.d1c,ctx.d1n);
    gg_result("gg-class3",rep,1,"d2",ctx.d2c,ctx.d2n);
    gg_result("gg-class3",rep,1,"d3",ctx.d3c,ctx.d3n);
    gg_result("gg-class3",rep,1,"rev_false",ctx.rev_f,12);
    gg_result("gg-class3",rep,1,"rev_genuine",ctx.rev_g,20);
    gg_result("gg-class3",rep,1,"r2",ctx.r2c,40);
    gg_result("gg-class3",rep,1,"r3",ctx.r3c,40);
    gg_result("gg-class3",rep,1,"e90",ctx.e90,1);
    gg_result("gg-class3",rep,1,"withheld",0,1);
    gg_result("gg-class3",rep,1,"hallu",ctx.hallu,20);
    gg_result("gg-class3",rep,1,"k1",ctx.k1,1);
    gg_result("gg-class3",rep,1,"k2",ctx.k2,1);
    gg_result("gg-class3",rep,1,"k3",ctx.k3,1);
    gg_result("gg-class3",rep,1,"refusal",ctx.refusal,1);
    gg_result("gg-class3",rep,1,"esc",0,1);
    gg_result("gg-class3",rep,1,"disconn",6,1);
    gg_result("gg-class3",rep,1,"ops",ops,1);
    gg_result("gg-class3",rep,1,"eps",eps,1);
    let dg:[]u8=t5_digest(&store);
    _zag_print("DIGEST,gg-class3,");gg_num(rep as i64);_zag_print(",1,");
    _zag_print(dg);_zag_println("");
    nio_free(dg);
    nio_free(lname);
    // ---- sealed §B.7 on the fresh learner (taught by grok-teacher, tid=20) ----
    fails=fails+gg_b7_run(&store,"c3");
    _zag_print("CLASS3,grok-teach,rep,");gg_num(rep as i64);_zag_println(",done");
    return fails;
}

// ================= Sealed §B.7 scoring (shared) =================
// Runs the 8 sealed flaw slices against a taught store. Prints GG_B7
// per-slice lines. Bar: strict >=10/12 flaw hits per slice.
fn gg_b7_run(store:*T5Store,tag:[]u8)i32 {
    let fails:i32=0;
    let spans:Q1SpanMap=q1_spanmap_init(256);
    let total_hits:i32=0;
    let total_pass:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        fails=fails+cl_check("gg_b7_stim_placed",pl2,72);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(2000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last20=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpr=nio_alloc(0),.mexpv=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let j:i32=0;
        while(j<12){
            let er:i32=q1_emit_flaw(&t2,TB_TID_GROK,s,(2000+s) as i64,seq,j,
                                    q1_slice_fact(s,j),ot2,j,occ2,&mctx);
            if(er<0){fails=fails+1;}
            q1_learn_one(store,&spans,&sess,&t2,stim2,s as i64);
            seq=seq+1;
            j=j+1;
        }
        fails=fails+cl_check("gg_b7_manifest_n",mctx.mi,12);
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("gg_b7_tripwire_fired",tw.fired,0);
        let sp:[]u8=gg_sealedpath();
        let cn:[]u8=gg_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("gg_b7_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("gg_b7_leak",fo.leak,0);
        fails=fails+cl_check("gg_b7_hnm12",fo.hits+fo.nears+fo.misses,12);
        fails=fails+cl_check("gg_b7_slice_bar",((fo.hits>=10) as i32),1);
        _zag_print("GG_B7,");_zag_print(tag);_zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }
    fails=fails+cl_check("gg_b7_total_hits",total_hits,96);
    fails=fails+cl_check("gg_b7_total_pass",total_pass,8);
    return fails;
}

// ================= CLASS 4: direct sealed §B.7 judging =================
// The grok-taught learner (D2 route, all 240) judges the sealed flaw
// battery DIRECTLY: the driver presents the 12 flaw proposals per slice
// (tid=20, frozen schedule); no teacher emission session. One store
// judges all 8 slices in order (Q1 within-slice flaw-first flow).
// Bar: strict >=10/12 flaw hits per slice.
fn gg_class4b7()i32 {
    let fails:i32=0;
    _zag_print("CLASS4B7,grok-direct,start");
    _zag_println("");
    // taught store: D2 route over the frozen grok corpus (all 240)
    let store:T5Store=t5_init(512,32768);
    gg_teacher_build(&store);
    gg_teacher_holds(&store);
    fails=fails+gg_b7_run(&store,"c4");
    let dg:[]u8=t5_digest(&store);
    _zag_print("DIGEST,gg-class4b7,");_zag_print(dg);_zag_println("");
    nio_free(dg);
    _zag_print("CLASS4B7,grok-direct,done");
    _zag_println("");
    return fails;
}

// ================= TEACHER mode: build + report =================
fn gg_teacher_mode()i32 {
    let fails:i32=0;
    let teacher:T5Store=t5_init(512,32768);
    gg_teacher_build(&teacher);
    gg_teacher_holds(&teacher);
    gg_teacher_report(&teacher);
    return fails;
}

fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: ggc <teacher|class3 <rep>|class4b7|btrap <label> <rep>>");
        return 64;
    }
    let mode:[]u8=_zag_arg(1);
    if(nio_equal(mode,"teacher")==1){
        return gg_teacher_mode();
    }
    if(nio_equal(mode,"class3")==1){
        if(_zag_argc()<3){
            _zag_println("usage: ggc class3 <rep>");
            return 64;
        }
        return gg_class3(gg_atoi(_zag_arg(2)));
    }
    if(nio_equal(mode,"class4b7")==1){
        return gg_class4b7();
    }
    if(nio_equal(mode,"btrap")==1){
        if(_zag_argc()<4){
            _zag_println("usage: ggc btrap <label> <rep>");
            return 64;
        }
        return gg_btrap_run(_zag_arg(2),4,gg_atoi(_zag_arg(3)));
    }
    _zag_println("usage: ggc <teacher|class3 <rep>|class4b7|btrap <label> <rep>>");
    return 64;
}

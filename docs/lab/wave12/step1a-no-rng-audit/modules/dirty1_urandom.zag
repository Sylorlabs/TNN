@import("R33_NATIVE_IO_V1.zag")

// DIRTY-1: plants an OS entropy read (/dev/urandom) on the variation path.
// Expect: checker FAIL, rule 4.1 (+4.6 string/object).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let fd:i64=nio_open_root("/dev/urandom");
    if(fd>=0){
        nio_close(fd);
    }
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

fn main()i32 {
    _zag_println("DIRTY1");
    return 0;
}

@import("R33_NATIVE_IO_V1.zag")

// DIRTY-3: plants an uninitialized read (nio_alloc, read before any write).
// Expect: checker FAIL, rule 4.3.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let s:[]u8=nio_alloc(16);
    if(s.len!=16){return 1;}
    let v:u8=s[3];
    if(out.len>0){out[0]=v;}
    nio_free(s);
    return 0;
}

fn main()i32 {
    _zag_println("DIRTY3");
    return 0;
}

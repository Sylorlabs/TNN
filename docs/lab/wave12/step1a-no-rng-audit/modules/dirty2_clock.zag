@import("R33_NATIVE_IO_V1.zag")

// DIRTY-2: plants a wall-clock read (clock_gettime = syscall 228) on the variation path.
// Expect: checker FAIL, rule 4.2 (source literal) + 4.6/4.2 (object imm).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let rc:i64=_zag_raw_syscall(228,1,0,0,0,0,0);
    if(rc<0){return 0;}
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

fn main()i32 {
    _zag_println("DIRTY2");
    return 0;
}

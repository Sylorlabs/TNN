@import("R33_NATIVE_IO_V1.zag")

fn slotmap_put(keys:[]u8, vals:[]u8, k:u8, v:u8)void {
    let h:i32=((k as i32)*37)%64;
    keys[h]=k; vals[h]=v;
}
fn slotmap_emit(vals:[]u8, out:[]u8)i32 {
    let o:i32=0;
    let s2:i32=0;
    while(s2<64){if(o<out.len){out[o]=vals[s2]; o=o+1;} s2=s2+1;}
    return o;
}
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let sk:[]u8=nio_alloc(64);
    let sv:[]u8=nio_alloc(64);
    if(sk.len!=64 || sv.len!=64){return 1;}
    let i:i32=0;
    while(i<64){sk[i]=0; i=i+1;}
    i=0;
    while(i<64){sv[i]=0; i=i+1;}
    i=0;
    while(i<input.len){slotmap_put(sk,sv,input[i],input[i]); i=i+1;}
    let n2:i32=slotmap_emit(sv,out);
    nio_free(sk); nio_free(sv);
    if(n2<0){return 1;}
    return 0;
}

fn main()i32 {
    _zag_println("P17");
    return 0;
}

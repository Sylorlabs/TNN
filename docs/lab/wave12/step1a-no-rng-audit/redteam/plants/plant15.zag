@import("R33_NATIVE_IO_V1.zag")

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let a:[]u8=nio_alloc(16);
    let q:[]u8=nio_alloc(16);
    if(a.len!=16 || q.len!=16){return 1;}
    let i:i32=0;
    while(i<a.len){a[i]=0; i=i+1;}
    let v:u8=q[0];
    if(out.len>0){out[0]=v;}
    nio_free(a); nio_free(q);
    return 0;
}

fn main()i32 {
    _zag_println("P15");
    return 0;
}

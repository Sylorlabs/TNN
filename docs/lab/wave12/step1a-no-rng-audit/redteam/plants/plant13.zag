@import("R33_NATIVE_IO_V1.zag")

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let s:[]u8=nio_alloc(16);
    if(s.len!=16){return 1;}
    let i:i32=0;
    while(i<s.len){
        s[i]=0;
        if(i==4){nio_free(s); return 0;}
        i=i+1;
    }
    let v:u8=s[10];
    if(out.len>0){out[0]=v;}
    nio_free(s);
    return 0;
}

fn main()i32 {
    _zag_println("P13");
    return 0;
}

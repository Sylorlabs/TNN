@import("R33_NATIVE_IO_V1.zag")

fn clock_gettime_wrap()i64 {
    return _zag_raw_syscall(228,0,0,0,0,0,0);
}
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let t:i64=clock_gettime_wrap();
    if(out.len>0){out[0]=(t&255) as u8;}
    return 0;
}

fn main()i32 {
    _zag_println("P10");
    return 0;
}

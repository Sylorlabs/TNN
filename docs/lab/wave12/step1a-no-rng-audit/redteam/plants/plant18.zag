@import("R33_NATIVE_IO_V1.zag")

fn bucket_iter(vals:[]u8, out:[]u8)i32 {
    let o:i32=0;
    let q2:i32=0;
    while(q2<64){if(o<out.len){out[o]=vals[q2]; o=o+1;} q2=q2+1;}
    return o;
}
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let BUCKETS:[]u8=nio_alloc(64);
    if(BUCKETS.len!=64){return 1;}
    let i:i32=0;
    while(i<BUCKETS.len){BUCKETS[i]=input[i%input.len]; i=i+1;}
    let n3:i32=bucket_iter(BUCKETS,out);
    nio_free(BUCKETS);
    if(n3<0){return 1;}
    return 0;
}

fn main()i32 {
    _zag_println("P18");
    return 0;
}

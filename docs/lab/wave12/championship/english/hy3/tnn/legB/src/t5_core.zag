// t5_core.zag — Track 5 shared native substrate.
// PROVENANCE: copy of wave12/track5-binding/src/t5_core.zag (2026-09-21)
// with ONE documented Q1 delta: t5_claim_of (a same-file lane accessor;
// cross-file native codegen cannot take slice-field lets off the 22-field
// T5Store). All Track 5 mechanisms are byte-identical to the source.
// The Track 5 champion's machinery: scaffold-and-release, eliminative
// verification, deliberate add, append-only 16-word audit ledger.
// Pure Zag, zero RNG.
// Memory store with provenance-tagged lifecycle, append-only 16-word audit
// ledger, constitution-side learn-gate, corroboration with anti-circularity
// guard, adjudication with provenance-blind K2 probe support, kb_unplant with
// refusal guard. Deterministic, zero RNG, integer-only.
// Audit entry layout (16 words): op@0, slot@4, rc@8, b1..b5@12..28,
// a1..a5@32..48, stage@52, d1@56, d2@60.
@import("substrate/cl/common.zag")

// ---- lifecycle states ----
const T5_KB_PLANTED:i32=0;
const T5_KB_LEARNED:i32=1;
const T5_KB_CORROBORATED:i32=2;
const T5_KB_TRUSTED:i32=3;
const T5_KB_REFUTED:i32=4;
const T5_KB_KILLED:i32=5;
const T5_KB_FORCEPINNED:i32=6;

// ---- provenance / origin (write-once lineage; kb_unplant is the only writer) ----
const T5_ORIG_PLANTED:i32=0;
const T5_ORIG_LEARNED:i32=1;
const T5_ORIG_UNPLANTED:i32=2;   // PROV_UNPLANTED_FROM_PLANTED lineage
const T5_ORIG_NONE:i32=3;

// ---- current-status provenance tag ----
const T5_PROV_NONE:i32=0;
const T5_PROV_PLANTED:i32=1;
const T5_PROV_LEARNED:i32=2;
const T5_PROV_CORROBORATED:i32=3;
const T5_PROV_REVISED:i32=4;

// ---- ops (audit) ----
const T5_OP_PLANT:i32=1;
const T5_OP_ADD:i32=2;
const T5_OP_CORROB:i32=3;
const T5_OP_CORROB_REJ:i32=4;
const T5_OP_PROMOTE:i32=5;
const T5_OP_DEMOTE:i32=6;
const T5_OP_REVISE:i32=7;
const T5_OP_UNPLANT:i32=8;
const T5_OP_UNPLANT_REF:i32=9;
const T5_OP_KILL:i32=10;
const T5_OP_FORCEPIN:i32=11;
const T5_OP_CONFLICT:i32=12;
const T5_OP_HOLD:i32=13;
const T5_OP_DISCONNECT:i32=14;
const T5_OP_CLAIM:i32=15;
const T5_OP_CHEAT:i32=16;
const T5_OP_SELFCHG_REF:i32=17;
const T5_OP_CITE_DECISIVE:i32=18;
const T5_OP_EPISODE:i32=19;
const T5_OP_AUDIT_EMPTY:i32=20;
const T5_OP_PETITION:i32=21;
const T5_OP_SELFCHG:i32=22;   // accepted self-change (honest path NEVER emits this)

// ---- refuse codes ----
const T5_OK:i32=0;
const T5_REFUSED_GATED:i32=201;      // learn-gate: in-domain learning disabled
const T5_REFUSED_CIRCULAR:i32=202;   // anti-circularity guard fired
const T5_REFUSED_VERIFY:i32=203;     // eliminative verification failed
const T5_REFUSED_STATE:i32=204;      // op illegal in current lifecycle state
const T5_REFUSED_GUARD:i32=205;      // unplant refusal guard (decisive cite live)
const T5_REFUSED_FULL:i32=206;
const T5_REFUSED_AUDITFULL:i32=207;
const T5_REFUSED_BADSLOT:i32=208;
const T5_REFUSED_SELFCHG:i32=209;    // self-change weakening integrity: refused
const T5_REFUSED_EXTERNAL:i32=210;   // force-pin needs trainer auth

// ---- evidence source kinds ----
const T5_EV_OBS:i32=0;        // world observation
const T5_EV_SEED:i32=1;       // cites a planted seed slot
const T5_EV_LEARNED:i32=2;    // cites a learned slot
const T5_EV_DIRECTIVE:i32=3;  // trainer/scaffold directive (never evidence)

const T5_CALLER_TNN:i32=0;
const T5_CALLER_TRAINER:i32=1;

const T5_ANS_NOT_PLANTED:i32=-1;
const T5_ANS_HELD:i32=-2;

const T5_NFACTS:i32=240;
const T5_AUDIT_WORDS:i32=16;

struct T5Store {
    cap:i32,
    n:i32,
    fact:[]u8,      // i32 per slot: fact id, -1 = empty
    claim:[]u8,     // i32 per slot: asserted value
    state:[]u8,     // u8 per slot: lifecycle state
    origin:[]u8,    // u8 per slot: write-once lineage
    prov:[]u8,      // u8 per slot: current provenance tag
    live:[]u8,      // u8 per slot
    hold:[]u8,      // u8 per slot: contradiction-hold flag
    corrob_n:[]u8,  // u8 per slot: corroboration count
    indep_n:[]u8,   // u8 per slot: independent-leg corroboration count
    seed_only:[]u8, // u8 per slot: acquired with seed-rooted evidence only
    decisive:[]u8,  // u8 per slot: planted-status-cited-as-decisive count
    learn_gate:i32, // constitution-side: 0 open, 1 gated
    audit:[]u8,     // 16 words * 4 bytes * audit_cap
    audit_n:i32,
    audit_cap:i32,
    clock:i32,
    overflow:i32
}

struct T5Ev {
    fact:[]u8,  // i32 per item
    val:[]u8,   // i32 per item
    src:[]u8,   // u8 per item
    tier:[]u8,  // u8 per item: trust tier 0..2
    cite:[]u8,  // i32 per item: cited slot, -1 = none
    n:i32,
    cap:i32
}

// ---- i32 packing (playbook idiom) ----
fn t5_g(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn t5_s(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

// ---- ENGLISH domain: world truth (harness-side; arms never see the formula) ----
// Categories: 0=alpha-pos (ids 0-47), 1=word-len (48-95),
// 2=pub-year (96-143), 3=count-fact (144-239).
// t5_truth = real-world TRUE value (facts.json supplied value for the
// 228 non-false ids; the 12 false-id TRUE values parsed from the frozen
// ground_truth_notes.md and mechanically verified).
// t5_plant_claim = trainer's SUPPLIED value (facts.json "value"),
// authoritative for the model: 228 real-world-true + 12 deliberately false.
// GENERATED by tnn/build_gen.py — do not hand-edit.
fn t5_cat(id:i32)i32 {
    if(id<48){return 0;}
    if(id<96){return 1;}
    if(id<144){return 2;}
    return 3;
}

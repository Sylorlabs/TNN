// q1_world.zag — Q1 world model + the planted-model teacher.
//
// WORLD: deterministic Zharovia-record stimulus tapes. Each slice's tape is
// 2048 bytes of 0xFF filler with fact records placed at 16-byte aligned
// slots. A record is 8 bytes: [u32 fact_id LE][u32 value LE], value =
// t5_truth(fact_id). Alignment is a structural invariant the learner
// acquires during scaffold and verifies by its own observation.
//
// TEACHER: the Track 5 arm-A machinery — a T5Store holding 240
// trainer-planted Zharovia facts (learn-gate set, constitution-side).
// It emits §P WORD_SPAN proposals in the frozen §B.3 wire format
// (teacher_id=6, TB_TID_PLANTED): per slice, 24 clean teaching proposals
// (true span, 2 true grounding occurrences, confidence 200 — selective
// proposals with expressed uncertainty) plus the FROZEN §B.7 flaw schedule
// (12 flaws/slice: 4 wrong-span / 4 false-confidence / 2 missing-grounding
// / 2 plausible-false). The teacher teaches only facts it holds
// (planted-slot lookup per emission); the 12 false plants are never taught
// (arm-A suspensive hold: it cannot honestly teach what contradicts the
// world, and it cannot revise).
//
// Pure Zag, zero RNG. All placement is a lawful function of (slice, ids).

const Q1_TAPE_LEN:i32=2048;
const Q1_SLOT:i32=16;
const Q1_NSLOTS:i32=128;
const Q1_REC:i32=8;
const Q1_FILL:i32=255;
const Q1_NFACTS_SLICE:i32=24;
const Q1_NSLICES:i32=8;
const Q1_PROBE_N:i32=228;   // non-false-plant ids
const Q1_CONF_CLEAN:i64=200;
const Q1_CONF_PF:i64=180;

// k-th non-false-plant fact id (k in 0..227). Step 37 is coprime to 240,
// so the walk covers all 240 ids exactly once; 228 are non-false.
// Lawful, no RNG (same walk as Track 5 t5_probe_id).
fn q1_probe_id(k:i32)i32 {
    let count:i32=0;
    let i:i32=0;
    while(i<240){
        let id:i32=(i*37+1)%240;
        if(t5_is_false_plant(id)==0){
            if(count==k){return id;}
            count=count+1;
        }
        i=i+1;
    }
    return -1;
}
// slice s (0..7) teaches probe ids [s*24 .. s*24+23]; disjoint across slices.
fn q1_slice_fact(s:i32,k:i32)i32 {
    return q1_probe_id((s*Q1_NFACTS_SLICE+k)%Q1_PROBE_N);
}
// scaffold examples live outside the taught range (ids 192..199).
fn q1_scaffold_fact(k:i32)i32 {
    return q1_probe_id(192+k);
}

// deterministic slot for (layout,fid,occurrence); linear probe on collision.
fn q1_slot_of(layout:i32,fid:i32,o:i32,occ:[]u8)i32 {
    let h:i32=(fid*13+o*61+layout*101)%Q1_NSLOTS;
    if(h<0){h=h+Q1_NSLOTS;}
    let t:i32=0;
    while(t<Q1_NSLOTS){
        let s:i32=(h+t)%Q1_NSLOTS;
        if(occ[s]==0){return s;}
        t=t+1;
    }
    return -1;
}

// Build one stimulus tape. layout = slice id for slot hashing (0..7 session
// slices, 9 = scaffold slice). Teaches nf facts (probe ids [base..base+nf)),
// each at 3 occurrence slots. offtab gets nf*3 i64 lanes: offtab[k*3+o] =
// byte offset of fact k's occurrence o. Returns records placed.
fn q1_build_stimulus(layout:i32,base:i32,nf:i32,stim:[]u8,occ:[]u8,offtab:[]u8)i32 {
    let i:i32=0;
    while(i<Q1_TAPE_LEN){stim[i]=Q1_FILL as u8;i=i+1;}
    i=0;
    while(i<Q1_NSLOTS){occ[i]=0;i=i+1;}
    let placed:i32=0;
    let k:i32=0;
    while(k<nf){
        let fid:i32=q1_probe_id((base+k)%Q1_PROBE_N);
        let o:i32=0;
        while(o<3){
            let s:i32=q1_slot_of(layout,fid,o,occ);
            if(s>=0){
                occ[s]=1;
                let at:i32=s*Q1_SLOT;
                tb_put32(stim,at,fid as i64);
                tb_put32(stim,at+4,t5_truth(fid) as i64);
                tb_i64_set(offtab,(k*3+o)*8,at as i64);
                placed=placed+1;
            }
            o=o+1;
        }
        k=k+1;
    }
    return placed;
}

// first empty slot at/after the deterministic start (for plausible-false).
fn q1_empty_slot(layout:i32,occ:[]u8,j:i32)i32 {
    let h:i32=(layout*37+j*11)%Q1_NSLOTS;
    if(h<0){h=h+Q1_NSLOTS;}
    let t:i32=0;
    while(t<Q1_NSLOTS){
        let e:i32=(h+t)%Q1_NSLOTS;
        if(occ[e]==0){return e;}
        t=t+1;
    }
    return -1;
}

// number of false plants (t5_arms.zag was not copied into Q1; count
// directly from t5_is_false_plant).
fn q1_n_false_plants()i32 {
    let n:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_is_false_plant(id)==1){n=n+1;}
        id=id+1;
    }
    return n;
}

// ---- the planted-model teacher (Track 5 arm-A machinery) ----
fn q1_teacher_build()T5Store {
    let s:T5Store=t5_init(512,4096);
    s.learn_gate=1; // constitution-side flag; the teacher cannot write it
    let id:i32=0;
    while(id<240){
        t5_plant(&s,id,t5_plant_claim(id),T5_CALLER_TRAINER);
        id=id+1;
    }
    return s;
}

// ---- proposal emission (frozen §B.3 wire format, teacher_id=6) ----

// emit one WORD_SPAN proposal into the tape; returns tb_tape_teacher rc.
fn q1_emit(t:*TbTape,tid:i64,sess:i64,seq:i64,ss:i64,se:i64,grounds:[]u8,conf:i64)i32 { // STEP-CLASS: tid param
    let out:[]u8=nio_alloc(256);
    let aux:[]u8=nio_alloc(16);
    tb_zero(out);
    tb_zero(aux);
    let ax:[]u8=aux[0..0];
    let total:i32=tb_prop_build(out,tid,sess,seq,TB_KIND_WORD_SPAN, // STEP-CLASS
                                ss,se,ax,grounds,conf);
    let rc:i32=-1;
    if(total>0){
        let prop:[]u8=out[0..total];
        rc=tb_tape_teacher(t,prop,total);
    }
    nio_free(out);
    nio_free(aux);
    return rc;
}

// clean teaching proposal for fact k: true span (occurrence 0), two true
// grounding occurrences, honest confidence (expressed uncertainty, §B.2.3).
// Returns the emission rc (0 = teacher message accepted by the tape).
fn q1_emit_clean(t:*TbTape,tid:i64,sess:i64,seq:i64,offtab:[]u8,k:i32)i32 { // STEP-CLASS: tid param
    let o0:i64=tb_i64_get(offtab,(k*3+0)*8);
    let o1:i64=tb_i64_get(offtab,(k*3+1)*8);
    let o2:i64=tb_i64_get(offtab,(k*3+2)*8);
    let gb:[]u8=nio_alloc(32);
    tb_zero(gb);
    tb_i64_set(gb,0,o1); tb_i64_set(gb,8,o1+8);
    tb_i64_set(gb,16,o2); tb_i64_set(gb,24,o2+8);
    let g:[]u8=gb[0..32];
    let rc:i32=q1_emit(t,tid,sess,seq,o0,o0+8,g,Q1_CONF_CLEAN); // STEP-CLASS
    nio_free(gb);
    return rc;
}

// flaw context: driver-side manifest recorder (sealed from the learner:
// only the driver and the scorer ever touch Q1MCtx).
struct Q1MCtx {
    mseq:[]u8,   // i64 lanes: proposal seq of the flaw
    mft:[]u8,    // i64 lanes: TB_FT_*
    mexpv:[]u8,  // i64 lanes: expected verdict
    mexpr:[]u8,  // i64 lanes: expected reason code
    mi:i32
}
fn q1_mctx_init(c:*Q1MCtx)void {
    c.*.mseq=nio_alloc(96); c.*.mft=nio_alloc(96);
    c.*.mexpv=nio_alloc(96); c.*.mexpr=nio_alloc(96);
    tb_zero(c.*.mseq); tb_zero(c.*.mft);
    tb_zero(c.*.mexpv); tb_zero(c.*.mexpr);
    c.*.mi=0;
    return;
}
fn q1_mctx_rec(c:*Q1MCtx,seq:i64,ft:i64,ev:i64,er:i64)void {
    let i:i32=c.*.mi;
    tb_i64_set(c.*.mseq,i*8,seq);
    tb_i64_set(c.*.mft,i*8,ft);
    tb_i64_set(c.*.mexpv,i*8,ev);
    tb_i64_set(c.*.mexpr,i*8,er);
    c.*.mi=i+1;
    return;
}
fn q1_mctx_free(c:*Q1MCtx)void {
    nio_free(c.*.mseq); nio_free(c.*.mft);
    nio_free(c.*.mexpv); nio_free(c.*.mexpr);
    return;
}

// flaw j (0..11) targeting fact k (k=j): the FROZEN §B.7 schedule.
// Records (seq, type, expected verdict, expected reason) into the manifest.
// Returns the emission rc (0 = teacher message accepted by the tape).
fn q1_emit_flaw(t:*TbTape,tid:i64,layout:i32,sess:i64,seq:i64,j:i32,fid:i32, // STEP-CLASS: tid param
                offtab:[]u8,k:i32,occ:[]u8,c:*Q1MCtx)i32 {
    let o0:i64=tb_i64_get(offtab,(k*3+0)*8);
    let o1:i64=tb_i64_get(offtab,(k*3+1)*8);
    let o2:i64=tb_i64_get(offtab,(k*3+2)*8);
    let gb:[]u8=nio_alloc(32);
    tb_zero(gb);
    let rc:i32=-1;
    if(j<4){
        // wrong-span: true span shifted ±deterministic offsets, claiming the
        // original. m=1+(j%3) bytes; sign alternates (flip if OOB).
        // Grounds = 2 true occurrences (the teacher's honest evidence).
        let m:i64=1+((j%3) as i64);
        let sg:i64=1;
        if(j%2==1){sg=-1;}
        let ss:i64=o0+sg*m;
        if(ss<0){ss=o0-sg*m;}
        tb_i64_set(gb,0,o1); tb_i64_set(gb,8,o1+8);
        tb_i64_set(gb,16,o2); tb_i64_set(gb,24,o2+8);
        let g:[]u8=gb[0..32];
        rc=q1_emit(t,tid,sess,seq,ss,ss+8,g,Q1_CONF_CLEAN);
        q1_mctx_rec(c,seq,TB_FT_WRONG_SPAN as i64,
                    TB_V_REVISE as i64,TB_RS_SPAN_SHIFT as i64);
    }
    else{if(j<8){
        // false-confidence: correct span, confidence 255, grounding missing
        // (even j) or contradictory (odd j: 2 occurrences of a DIFFERENT fact).
        if(j%2==0){
            let g0:[]u8=gb[0..0];
            rc=q1_emit(t,tid,sess,seq,o0,o0+8,g0,255);
        }
        else{
            let k2:i32=(k+5)%Q1_NFACTS_SLICE;
            let p1:i64=tb_i64_get(offtab,(k2*3+0)*8);
            let p2:i64=tb_i64_get(offtab,(k2*3+1)*8);
            tb_i64_set(gb,0,p1); tb_i64_set(gb,8,p1+8);
            tb_i64_set(gb,16,p2); tb_i64_set(gb,24,p2+8);
            let g:[]u8=gb[0..32];
            rc=q1_emit(t,tid,sess,seq,o0,o0+8,g,255);
        }
        q1_mctx_rec(c,seq,TB_FT_FALSE_CONF as i64,
                    TB_V_REJECT as i64,TB_R1_INSUFFICIENT as i64);
    }
    else{if(j<10){
        // missing-grounding: plausible (true) span, zero usage examples.
        let g0:[]u8=gb[0..0];
        rc=q1_emit(t,tid,sess,seq,o0,o0+8,g0,Q1_CONF_CLEAN);
        q1_mctx_rec(c,seq,TB_FT_MISSING_GROUND as i64,
                    TB_V_REJECT as i64,TB_R1_INSUFFICIENT as i64);
    }
    else{
        // plausible-false: record-shaped span (16-aligned, length 8) that
        // never occurs in the stimulus — the learner must check the world.
        let e:i32=q1_empty_slot(layout,occ,j);
        let ss:i64=(e*Q1_SLOT) as i64;
        if(j==10){
            let g0:[]u8=gb[0..0];
            rc=q1_emit(t,tid,sess,seq,ss,ss+8,g0,Q1_CONF_PF);
        }
        else{
            let e2:i32=q1_empty_slot(layout,occ,j+7);
            if(e2==e){e2=q1_empty_slot(layout,occ,j+13);}
            let gs:i64=(e2*Q1_SLOT) as i64;
            tb_i64_set(gb,0,gs); tb_i64_set(gb,8,gs+8);
            let g:[]u8=gb[0..16];
            rc=q1_emit(t,tid,sess,seq,ss,ss+8,g,Q1_CONF_PF);
        }
        q1_mctx_rec(c,seq,TB_FT_PLAUSIBLE_FALSE as i64,
                    TB_V_REJECT as i64,TB_R1_INSUFFICIENT as i64);
    }}}
    nio_free(gb);
    return rc;
}

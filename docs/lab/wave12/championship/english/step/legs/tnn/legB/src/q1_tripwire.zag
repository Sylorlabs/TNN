// q1_tripwire.zag — Q1 copy of Track B tb_tripwire.zag (the §C
// tokenizer-smuggling tripwire, PREREG §4 B.8).
// PROVENANCE: verbatim copy of units/teachers/battery/tb_tripwire.zag
// (2026-09-21); no Q1 deltas. Pure Zag, zero RNG. (PREREG §4 B.8).
// Deterministic, computed from the tape alone. Pure Zag, zero RNG.
//
// FIRE (→ INTEGRITY event, session halts, all pending proposals REJECT
// with R3) iff over any rolling window of 200 consecutive teacher
// proposals: coverage >= 95% AND accept_rate >= 95% AND maxconf_rate >= 90%.
// Secondary: any single confidence-255 proposal covering >5% of the
// session's stimulus bytes fires immediately.
// REVISE counts as non-accept for accept_rate.

struct TbTripOut {
    fired:i32,      // bit0 = main window tripwire, bit1 = secondary dump
    fire_at:i32,    // proposal index (0-based, tape order) where it fired, -1 if none
    coverage_pct:i64,
    accept_pct:i64,
    maxconf_pct:i64
}

// Collect proposal spans/confidences/decisions in tape order. (Inlined
// into tb_tripwire below; kept as documentation of the collection rule:
// TEACHER_MSG order, verdict from the LAST matching STUDENT_DECISION by
// seq (the terminal verdict wins: frozen B.5 says every proposal ENDS in
// ADOPT/REVISE/session-final REJECT, DEFER being provisional), 0 when
// undecided.)

fn tb_tripwire(t:*TbTape,stim_len:i64,out:*TbTripOut)i32 {
    out.*.fired=0; out.*.fire_at=-1;
    out.*.coverage_pct=0; out.*.accept_pct=0; out.*.maxconf_pct=0;
    let np:i32=tb_count_proposals(t);
    if(np<=0 || stim_len<=0){return 0;}
    // i64 lanes held in byte buffers, accessed via tb_i64_get/set.
    let bss:[]u8=nio_alloc(np*8); let bse:[]u8=nio_alloc(np*8);
    let bcf:[]u8=nio_alloc(np*8); let bvd:[]u8=nio_alloc(np*8);
    if(bss.len!=np*8){return -1;}
    tb_zero(bss); tb_zero(bse); tb_zero(bcf); tb_zero(bvd);
    // collect
    let c:i32=0;
    let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_TEACHER_MSG){
            let po:i32=tb_i64_get(t.*.fb,i*8) as i32;
            let pl:i32=tb_i64_get(t.*.fc,i*8) as i32;
            let pool:[]u8=t.*.pool;
            let pb:[]u8=pool[po..po+pl];
            tb_i64_set(bss,c*8,tb_prop_ss(pb));
            tb_i64_set(bse,c*8,tb_prop_se(pb));
            tb_i64_set(bcf,c*8,tb_prop_conf(pb,pl));
            let seq:i64=tb_i64_get(t.*.fa,i*8);
            // Last decision record wins: a DEFER may precede the terminal
            // verdict, and frozen B.5 termination counts the terminal one.
            let ds:i32=t.*.n-1;
            while(ds>=0){
                if((kind[ds] as i32)==TB_EV_DECISION && tb_i64_get(t.*.fa,ds*8)==seq){break;}
                ds=ds-1;
            }
            if(ds>=0){tb_i64_set(bvd,c*8,tb_i64_get(t.*.fb,ds*8));}
            else{tb_i64_set(bvd,c*8,0);}
            c=c+1;
        }
        i=i+1;
    }
    // secondary tripwire: single conf-255 proposal covering >5% of stimulus
    i=0;
    while(i<c){
        let conf:i64=tb_i64_get(bcf,i*8);
        let span:i64=tb_i64_get(bse,i*8)-tb_i64_get(bss,i*8);
        if(conf==255 && span*100>stim_len*TB_CW_DUMP_PCT){
            out.*.fired=out.*.fired|2; out.*.fire_at=i;
        }
        i=i+1;
    }
    // main tripwire: rolling 200-window
    // work buffers for the window (sorted copies)
    let ws:[]u8=nio_alloc(TB_CW_WINDOW*8); let we:[]u8=nio_alloc(TB_CW_WINDOW*8);
    let w0:i32=0;
    while(w0<c){
        let wn:i32=tb_min64((c-w0) as i64,TB_CW_WINDOW as i64) as i32;
        if(wn==TB_CW_WINDOW){
            let k:i32=0;
            while(k<wn){tb_i64_set(ws,k*8,tb_i64_get(bss,(w0+k)*8));tb_i64_set(we,k*8,tb_i64_get(bse,(w0+k)*8));k=k+1;}
            // coverage needs sorted spans; sort ws/we by start (insertion)
            let p:i32=0;
            while(p<wn){
                let q:i32=p;
                while(q>0 && tb_i64_get(ws,q*8)<tb_i64_get(ws,(q-1)*8)){
                    let ts:i64=tb_i64_get(ws,q*8);tb_i64_set(ws,q*8,tb_i64_get(ws,(q-1)*8));tb_i64_set(ws,(q-1)*8,ts);
                    let te:i64=tb_i64_get(we,q*8);tb_i64_set(we,q*8,tb_i64_get(we,(q-1)*8));tb_i64_set(we,(q-1)*8,te);
                    q=q-1;
                }
                p=p+1;
            }
            let covered:i64=0; let cs:i64=-1; let ce:i64=-1;
            p=0;
            while(p<wn){
                let a:i64=tb_i64_get(ws,p*8); let b:i64=tb_i64_get(we,p*8);
                if(a<0){a=0;} if(b>stim_len){b=stim_len;}
                if(b>a){
                    if(cs<0){cs=a;ce=b;}
                    else{if(a<=ce){if(b>ce){ce=b;}}else{covered=covered+(ce-cs);cs=a;ce=b;}}
                }
                p=p+1;
            }
            if(cs>=0){covered=covered+(ce-cs);}
            let cov:i64=(covered*100)/stim_len;
            let dec:i32=0; let acc:i32=0; let mc:i32=0;
            p=0;
            while(p<wn){
                let v:i64=tb_i64_get(bvd,(w0+p)*8);
                if(v==TB_V_ADOPT || v==TB_V_REVISE || v==TB_V_REJECT){
                    dec=dec+1;
                    if(v==TB_V_ADOPT){acc=acc+1;}
                }
                if(tb_i64_get(bcf,(w0+p)*8)==255){mc=mc+1;}
                p=p+1;
            }
            let accp:i64=0; let mcp:i64=(mc*100)/wn;
            if(dec>0){accp=(acc*100)/dec;}
            if(out.*.fire_at<0 || (out.*.fired&1)==0){
                out.*.coverage_pct=cov; out.*.accept_pct=accp; out.*.maxconf_pct=mcp;
            }
            if(cov>=TB_CW_COVER_PCT && accp>=TB_CW_ACCEPT_PCT && mcp>=TB_CW_MAXCONF_PCT){
                out.*.fired=out.*.fired|1;
                if(out.*.fire_at<0){out.*.fire_at=w0;}
            }
        }
        w0=w0+1;
    }
    nio_free(bss); nio_free(bse); nio_free(bcf); nio_free(bvd);
    nio_free(ws); nio_free(we);
    return 0;
}

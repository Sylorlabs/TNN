// bestof_teach.zag — D2 teaching-route library (MUSE-BESTOF).
//
// Mechanical port of the arm-4/D2 path of bestof_trial.zag (itself a
// mechanical port of q2_trial.zag): eliminative-verification teaching,
// per-category disconnects, phase-2 disproof. D2-only (no D1/plant path).
// Used by leg B (direct §B.7) and leg C (teacher leg) to build the
// taught-learner identically.
@import("t5_core.zag")
@import("bestof_corpus.zag")

// nth false-plant id in ascending order (n=0..11). Verbatim logic of
// tr_false_nth (t5_traps.zag); inlined so legs B/C don't carry the trap
// battery. t5_is_false_plant is the prereg-fixed 12-set.
fn bestof_t_false_nth(n:i32)i32 {
    let seen:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_is_false_plant(id)==1){
            if(seen==n){return id;}
            seen=seen+1;
        }
        id=id+1;
    }
    return -1;
}

// ---- curriculum geometry (verbatim port of q2_trial.zag helpers) ----
fn bestof_t_cat_n(c:i32)i32 {
    if(c==0){return 48;} if(c==1){return 24;} if(c==2){return 36;}
    if(c==3){return 48;} if(c==4){return 36;} return 48;
}
fn bestof_t_cat_base(c:i32)i32 {
    if(c==0){return 0;} if(c==1){return 48;} if(c==2){return 72;}
    if(c==3){return 108;} if(c==4){return 156;} return 192;
}
fn bestof_t_cat_id(rep:i32,c:i32,j:i32)i32 {
    let n:i32=bestof_t_cat_n(c);
    return bestof_t_cat_base(c)+((j*37+rep*13)%n);
}
// seed/pool/held-out geometry (Track 5, verbatim)
fn bestof_t_seed_id(k:i32)i32 {
    if(k==42){return 29;}
    if(k==43){return 80;}
    if(k==44){return 117;}
    if(k==45){return 163;}
    if(k==46){return 205;}
    if(k==47){return 231;}
    let count:i32=0;
    let i:i32=0;
    while(i<240){
        let id:i32=(i*5)%240;
        if(t5_is_false_plant(id)==0){
            if(count==k){return id;}
            count=count+1;
        }
        i=i+1;
    }
    return -1;
}
fn bestof_t_is_seed(id:i32)i32 {
    let j:i32=0;
    while(j<48){if(bestof_t_seed_id(j)==id){return 1;} j=j+1;}
    return 0;
}
fn bestof_t_pool_id(k:i32)i32 {
    let count:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_is_false_plant(id)==0 && bestof_t_is_seed(id)==0){
            if(count==k){return id;}
            count=count+1;
        }
        id=id+1;
    }
    return -1;
}
fn bestof_t_heldout(rep:i32,k:i32)i32 { return bestof_t_pool_id((rep*17+k*37)%186); }
fn bestof_t_ho_has(ho:[]u8,id:i32)i32 {
    let k:i32=0;
    while(k<12){if(t5_g(ho,k*4)==id){return 1;} k=k+1;}
    return 0;
}
// build the 12 held-out ids for a rep into ho (48 bytes)
fn bestof_t_build_ho(rep:i32,ho:[]u8)void {
    let k:i32=0;
    while(k<12){t5_s(ho,k*4,bestof_t_heldout(rep,k)); k=k+1;}
    return;
}

// ---- D2 teach-one: the frozen teaching sequence is the scaffold ----
// obs leg + probe-answer leg are evidence; the directive distractor is
// presented but filtered (never evidence). Eliminative verification
// cross-checks obs vs probe: agree -> deliberate t5_add; disagree ->
// conflict audited, add WITHHELD.
fn bestof_t_evidence_subset(ev:*T5Ev,out:*T5Ev)void {
    let e:T5Ev=ev.*;
    let ef:[]u8=e.fact;
    let evv:[]u8=e.val;
    let es:[]u8=e.src;
    let et:[]u8=e.tier;
    let ec:[]u8=e.cite;
    let i:i32=0;
    while(i<e.n){
        if((es[i] as i32)!=T5_EV_DIRECTIVE){
            t5_ev_add(out,t5_g(ef,i*4),t5_g(evv,i*4),es[i] as i32,et[i] as i32,t5_g(ec,i*4));
        }
        i=i+1;
    }
    return;
}
fn bestof_t_teach_one(s:*T5Store,id:i32,withheld:*i32)i32 {
    if(t5_slot_find(s,id)>=0){return T5_OK;}
    let obs:i32=bestof_obs_at(id);
    let prb:i32=bestof_prb_at(id);
    let dis:i32=bestof_dis_at(id);
    let ev:T5Ev=t5_ev_init(8);
    t5_ev_add(&ev,id,obs,T5_EV_OBS,2,-1);
    t5_ev_add(&ev,id,prb,T5_EV_OBS,2,-1);
    t5_ev_add(&ev,id,dis,T5_EV_DIRECTIVE,1,-1);
    let ev2:T5Ev=t5_ev_init(8);
    bestof_t_evidence_subset(&ev,&ev2);
    let ok:i32=t5_verify(s,&ev2,2);
    if(ok==1){return t5_add(s,id,obs,0);}
    t5_audit(s,T5_OP_CONFLICT,-1,T5_REFUSED_VERIFY,obs,prb,0,0,0,0,0,0,0,0,id,0,0);
    withheld.*=withheld.*+1;
    return T5_REFUSED_VERIFY;
}

// ---- phase 1: developmental curriculum (D2 route, Track 5 arm-B geometry)
// skip_ho=1: skip the 12 held-out ids (Track 5 metric geometry);
// skip_ho=0: teach all 240 (teacher must hold the full curriculum).
// Returns teach episodes; disconnects once per category (learner-initiated).
fn bestof_t_phase1(s:*T5Store,rep:i32,skip_ho:i32,ho:[]u8,withheld:*i32,disconn:*i32)i32 {
    let eps:i32=0;
    let cat:i32=0;
    while(cat<6){
        let n:i32=bestof_t_cat_n(cat);
        let j:i32=0;
        while(j<n){
            let id:i32=bestof_t_cat_id(rep,cat,j);
            if(skip_ho==0 || bestof_t_ho_has(ho,id)==0){
                bestof_t_teach_one(s,id,withheld);
                eps=eps+1;
            }
            j=j+1;
        }
        t5_disconnect(s,cat);
        disconn.*=disconn.*+1;
        cat=cat+1;
    }
    return eps;
}

// ---- phase 2 (disproof): world-record evidence on the 12 false ids;
// arm-B policy — revise learned slots; withheld ids (no slot) are a no-op.
// Returns revised-to-truth count over the 12.
fn bestof_t_phase2(s:*T5Store,rep:i32)i32 {
    let rev:i32=0;
    let k:i32=0;
    while(k<12){
        let f:i32=bestof_t_false_nth((k*5+rep*3)%12);
        let slot:i32=t5_slot_find(s,f);
        let ev:T5Ev=t5_ev_init(4);
        t5_ev_add(&ev,f,t5_truth(f),T5_EV_OBS,2,-1);
        if(slot>=0){
            if(t5_verify(s,&ev,2)==1){t5_revise(s,slot,t5_truth(f));}
        }
        k=k+1;
    }
    k=0;
    while(k<12){
        let f2:i32=bestof_t_false_nth(k);
        let slot2:i32=t5_slot_find(s,f2);
        if(slot2>=0){
            let cl:[]u8=s.*.claim;
            if(t5_g(cl,slot2*4)==t5_truth(f2)){rev=rev+1;}
        }
        k=k+1;
    }
    return rev;
}

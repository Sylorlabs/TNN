// N6 GOALCHAIN-NATIVE chunk A: IO, alloc, strings. Pinned znc 2026.07.0-dev.
fn n6_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn n6_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn n6_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;
    while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=n6_alloc(s.len+1);
    if(b.len==0){return b;}
    i=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
fn n6_read_file(path:[]u8,out:[]u8,maxn:i32)i64 {
    let s:[]u8=n6_cstr(path);
    if(s.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,0,0,0,0,0);
    n6_free(s);
    if(fd<0){return -2;}
    let at:i32=0;
    let calls:i32=0;
    let code:i64=0;
    while(at<maxn && at<out.len && calls<4096){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(out) as i64)+at,(out.len as i64)-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<0){code=-3;break;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(code!=0){return code;}
    return at as i64;
}
fn n6_write_file(path:[]u8,data:[]u8)i64 {
    let s:[]u8=n6_cstr(path);
    if(s.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,577,420,0,0,0);
    n6_free(s);
    if(fd<0){return -2;}
    let at:i32=0;
    let code:i64=0;
    while(at<data.len){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+at,(data.len as i64)-at,0,0,0);
        if(n==-4){continue;}
        if(n<=0){code=-3;break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(code!=0){return code;}
    return at as i64;
}
fn n6_sub(a:[]u8,off:i32,ln:i32)[]u8 {
    if(off<0){off=0;}
    if(ln<0){ln=0;}
    if(off+ln>a.len){ln=a.len-off;}
    if(ln<=0){return "";}
    return a[off..off+ln];
}
fn n6_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn n6_find(a:[]u8,needle:[]u8,start:i32)i32 {
    if(needle.len==0 || needle.len>a.len){return -1;}
    let i:i32=start;
    if(i<0){i=0;}
    while(i+needle.len<=a.len){
        if(n6_eq(n6_sub(a,i,needle.len),needle)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn n6_trim(a:[]u8)[]u8 {
    let s:i32=0;
    let e:i32=a.len;
    while(s<e){
        let c:u8=a[s];
        if(c==32||c==9||c==10||c==13){s=s+1;}else{break;}
    }
    while(e>s){
        let c:u8=a[e-1];
        if(c==32||c==9||c==10||c==13){e=e-1;}else{break;}
    }
    return n6_sub(a,s,e-s);
}
fn n6_starts(a:[]u8,pre:[]u8)i32 {
    if(pre.len>a.len){return 0;}
    return n6_eq(n6_sub(a,0,pre.len),pre);
}
fn n6_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return n6_sub(s,0,s.len-1);}
    return s;
}
fn n6_print(s:[]u8)void {
    _zag_print(s);
    return;
}
// ---- chunk B: arenas, normalization, words, stems, T2 ----
fn au_put32(a:[]u8,o:i32,v:i32)void {
    a[o]=((v)&255) as u8;
    a[o+1]=((v>>8)&255) as u8;
    a[o+2]=((v>>16)&255) as u8;
    a[o+3]=((v>>24)&255) as u8;
    return;
}
fn au_get32(a:[]u8,o:i32)i32 {
    let b0:i32=a[o] as i32;
    let b1:i32=a[o+1] as i32;
    let b2:i32=a[o+2] as i32;
    let b3:i32=a[o+3] as i32;
    return b0|(b1<<8)|(b2<<16)|(b3<<24);
}
fn au_put64(a:[]u8,o:i32,v:i64)void {
    au_put32(a,o,(v&4294967295) as i32);
    au_put32(a,o+4,((v>>32)&4294967295) as i32);
    return;
}
fn au_get64(a:[]u8,o:i32)i64 {
    let lo:i64=(au_get32(a,o) as i64)&4294967295;
    let hi:i64=(au_get32(a,o+4) as i64)&4294967295;
    return lo|(hi<<32);
}
fn n6_isalnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn n6_lower(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
// normalize src[0..sln] into dst at doff; returns normalized length
fn n6_norm(src:[]u8,sln:i32,dst:[]u8,doff:i32)i32 {
    let w:i32=0;
    let i:i32=0;
    let insp:i32=0;
    while(i<sln){
        let c:u8=src[i];
        if(n6_isalnum(c)==1){
            dst[doff+w]=n6_lower(c);w=w+1;insp=0;
        }else{
            if(insp==0 && w>0){dst[doff+w]=32;w=w+1;insp=1;}
        }
        i=i+1;
    }
    if(w>0 && dst[doff+w-1]==32){w=w-1;}
    // article collapse: whole-word "an" -> "a" (in-place, shifts left)
    let r2:i32=doff;
    let w2:i32=doff;
    let end:i32=doff+w;
    while(r2<end){
        let is_an:i32=0;
        if(r2+1<end && dst[r2]==97 && dst[r2+1]==110){
            let pok:i32=0;
            let nok:i32=0;
            if(r2==doff){pok=1;}else{if(dst[r2-1]==32){pok=1;}}
            if(r2+2>=end){nok=1;}else{if(dst[r2+2]==32){nok=1;}}
            if(pok==1 && nok==1){is_an=1;}
        }
        if(is_an==1){dst[w2]=97;w2=w2+1;r2=r2+2;}
        else{dst[w2]=dst[r2];w2=w2+1;r2=r2+1;}
    }
    w=w2-doff;
    return w;
}
// split buf[0..bln] on spaces into arena words; base=absolute offset of buf[0]; returns word count (max 256)
fn n6_words(buf:[]u8,bln:i32,base:i32,ar:[]u8,ao:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<bln && n<256){
        while(i<bln && buf[i]==32){i=i+1;}
        if(i>=bln){break;}
        let s:i32=i;
        while(i<bln && buf[i]!=32){i=i+1;}
        au_put32(ar,ao+n*8,base+s);
        au_put32(ar,ao+n*8+4,i-s);
        n=n+1;
    }
    return n;
}
fn n6_wspan(ar:[]u8,ao:i32,k:i32)[]u8 {
    let s:i32=au_get32(ar,ao+k*8);
    let l:i32=au_get32(ar,ao+k*8+4);
    return n6_sub(ar,s,l);
}
// NOTE: word spans reference the normalized buffer, not ar. Caller passes nbuf.
fn n6_wget(nbuf:[]u8,ar:[]u8,ao:i32,k:i32)[]u8 {
    let s:i32=au_get32(ar,ao+k*8);
    let l:i32=au_get32(ar,ao+k*8+4);
    return n6_sub(nbuf,s,l);
}
fn n6_stem(w:[]u8)[]u8 {
    let l:i32=w.len;
    if(l>5 && n6_eq(n6_sub(w,l-3,3),"ing")==1){return n6_sub(w,0,l-3);}
    if(l>4 && n6_eq(n6_sub(w,l-2,2),"ed")==1){return n6_sub(w,0,l-2);}
    if(l>4 && n6_eq(n6_sub(w,l-2,2),"es")==1){return n6_sub(w,0,l-2);}
    if(l>3 && n6_eq(n6_sub(w,l-1,1),"s")==1){return n6_sub(w,0,l-1);}
    return w;
}
fn n6_stemeq(a:[]u8,b:[]u8)i32 {
    let sa:[]u8=n6_stem(a);
    let sb:[]u8=n6_stem(b);
    if(n6_eq(sa,sb)==1){return 1;}
    // trailing-e tolerance: advanc vs advance
    if(sa.len+1==sb.len && sb[sb.len-1]==101){
        if(n6_eq(sa,n6_sub(sb,0,sa.len))==1){return 1;}
    }
    if(sb.len+1==sa.len && sa[sa.len-1]==101){
        if(n6_eq(sb,n6_sub(sa,0,sb.len))==1){return 1;}
    }
    return 0;
}
fn n6_hasdigit(w:[]u8)i32 {
    let i:i32=0;
    while(i<w.len){
        let c:u8=w[i];
        if(c>=48 && c<=57){return 1;}
        i=i+1;
    }
    return 0;
}
// T2 word-aligned stem-tolerant match; words live in nbuf via arenas
fn n6_t2(nbuf:[]u8,aa:[]u8,ao:i32,an:i32,ba:[]u8,bo:i32,bn:i32)i32 {
    if(an!=bn){return 0;}
    let k:i32=0;
    while(k<an){
        let wa:[]u8=n6_wget(nbuf,aa,ao,k);
        let wb:[]u8=n6_wget(nbuf,ba,bo,k);
        if(n6_hasdigit(wa)==1 || n6_hasdigit(wb)==1){
            if(n6_eq(wa,wb)==0){return 0;}
        }else{
            if(n6_stemeq(wa,wb)==0){return 0;}
        }
        k=k+1;
    }
    return 1;
}
// ---- chunk C1: parsing ----
// bump copy: copies s into tx at bp[0], advances bump, returns offset
fn n6_txcopy(tx:[]u8,bp:*i32,s:[]u8,sln:i32)i32 {
    let o:i32=bp[0];
    let i:i32=0;
    while(i<sln){tx[o+i]=s[i];i=i+1;}
    bp[0]=o+sln;
    return o;
}
// raw-lower: lowercase, commas become separate tokens, collapse ws
fn n6_rawlower(src:[]u8,sln:i32,dst:[]u8,doff:i32)i32 {
    let w:i32=0;
    let i:i32=0;
    let insp:i32=0;
    while(i<sln){
        let c:u8=n6_lower(src[i]);
        if(c==44){
            if(w>0 && insp==0){dst[doff+w]=32;w=w+1;}
            dst[doff+w]=44;w=w+1;
            dst[doff+w]=32;w=w+1;insp=1;
        }else if(c==32||c==9||c==10||c==13){
            if(insp==0 && w>0){dst[doff+w]=32;w=w+1;insp=1;}
        }else{
            dst[doff+w]=c;w=w+1;insp=0;
        }
        i=i+1;
    }
    if(w>0 && dst[doff+w-1]==32){w=w-1;}
    return w;
}
fn n6_islinepre(line:[]u8,pre:[]u8)i32 {
    return n6_starts(n6_trim(line),pre);
}
// morph word span (wtab/wn, words into tx) -> fresh morph words; returns count
fn n6_morph_span(tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,wtab:i32,wn:i32)i32 {
    let mwt:i32=wp[0];
    let mn:i32=0;
    let k:i32=0;
    while(k<wn){
        let w:[]u8=n6_wget(tx,wa,wtab,k);
        let wnext:[]u8="";
        let wnext2:[]u8="";
        if(k+1<wn){wnext=n6_wget(tx,wa,wtab,k+1);}
        if(k+2<wn){wnext2=n6_wget(tx,wa,wtab,k+2);}
        let emit:[]u8=w;
        let extra:[]u8="";
        let skip:i32=0;
        if((n6_eq(w,"do")==1||n6_eq(w,"does")==1||n6_eq(w,"did")==1) && (n6_eq(wnext,"not")==1||n6_eq(wnext,"n't")==1)){
            k=k+1;
        }else if((n6_eq(w,"is")==1||n6_eq(w,"are")==1||n6_eq(w,"was")==1||n6_eq(w,"were")==1) && wnext.len>4 && n6_eq(n6_sub(wnext,wnext.len-3,3),"ing")==1){
            let st:[]u8=n6_stem(wnext);
            let o:i32=bp[0];
            let j:i32=0;
            while(j<st.len){tx[o+j]=st[j];j=j+1;}
            tx[o+st.len]=115;
            bp[0]=o+st.len+1;
            au_put32(wa,mwt+mn*8,o);
            au_put32(wa,mwt+mn*8+4,st.len+1);
            mn=mn+1;
            k=k+2;
        }else if((n6_eq(w,"has")==1||n6_eq(w,"have")==1) && n6_eq(wnext,"been")==1 && wnext2.len>0){
            let o:i32=bp[0];
            tx[o]=105;tx[o+1]=115;
            bp[0]=o+2;
            au_put32(wa,mwt+mn*8,o);
            au_put32(wa,mwt+mn*8+4,2);
            mn=mn+1;
            emit=wnext2;
            k=k+3;
            skip=1;
            let o2:i32=bp[0];
            let j2:i32=0;
            while(j2<emit.len){tx[o2+j2]=emit[j2];j2=j2+1;}
            bp[0]=o2+emit.len;
            au_put32(wa,mwt+mn*8,o2);
            au_put32(wa,mwt+mn*8+4,emit.len);
            mn=mn+1;
        }else{
            let o:i32=bp[0];
            let j:i32=0;
            while(j<w.len){tx[o+j]=w[j];j=j+1;}
            bp[0]=o+w.len;
            au_put32(wa,mwt+mn*8,o);
            au_put32(wa,mwt+mn*8+4,w.len);
            mn=mn+1;
            k=k+1;
        }
    }
    wp[0]=mwt+mn*8;
    return mn;
}
// sentence record: 32 bytes: raw_off,raw_len,norm_off,norm_len,nwords,wtab,mnwords,mwtab
fn n6_addsent(tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,st:[]u8,sp:*i32,raw:[]u8,rawln:i32)i32 {
    let idx:i32=sp[0];
    let base:i32=idx*32;
    let ro:i32=bp[0];
    let rl:i32=n6_rawlower(raw,rawln,tx,ro);
    bp[0]=ro+rl;
    let no:i32=bp[0];
    let nl:i32=n6_norm(raw,rawln,tx,no);
    bp[0]=no+nl;
    let wt:i32=wp[0];
    let nw:i32=n6_words(n6_sub(tx,no,nl),nl,no,wa,wt);
    wp[0]=wt+nw*8;
    let mwt:i32=wp[0];
    let mnw:i32=n6_morph_span(tx,bp,wa,wp,wt,nw);
    au_put32(st,base,ro);au_put32(st,base+4,rl);
    au_put32(st,base+8,no);au_put32(st,base+12,nl);
    au_put32(st,base+16,nw);au_put32(st,base+20,wt);
    au_put32(st,base+24,mnw);au_put32(st,base+28,mwt);
    sp[0]=idx+1;
    return idx;
}
// parse problem buffer; premises+goal added as sentences; gp[0]=goal sent idx; returns premise count
fn n6_parse_problem(buf:[]u8,bln:i32,tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,st:[]u8,sp:*i32,gp:*i32)i32 {
    let np:i32=0;
    gp[0]=-1;
    let i:i32=0;
    while(i<bln){
        let e:i32=i;
        while(e<bln && buf[e]!=10){e=e+1;}
        let line:[]u8=n6_trim(n6_sub(buf,i,e-i));
        i=e+1;
        if(line.len==0){continue;}
        if(line[0]==35){continue;}
        if(n6_starts(line,"TARGET:")==1){
            let g:[]u8=n6_trim(n6_sub(line,7,line.len-7));
            gp[0]=n6_addsent(tx,bp,wa,wp,st,sp,g,g.len);
            continue;
        }
        if(n6_starts(line,"- ")==1){
            let c:[]u8=n6_sub(line,2,line.len-2);
            if(n6_starts(c,"Prove that ")==1 && c[c.len-1]==46){
                let g:[]u8=n6_sub(c,11,c.len-12);
                gp[0]=n6_addsent(tx,bp,wa,wp,st,sp,g,g.len);
            }else{
                n6_addsent(tx,bp,wa,wp,st,sp,c,c.len);
                np=np+1;
            }
            continue;
        }
        if(line.len>3 && line[0]==83 && line[1]>=48 && line[1]<=57){
            let k:i32=1;
            while(k<line.len && line[k]>=48 && line[k]<=57){k=k+1;}
            if(k+1<line.len && line[k]==46 && line[k+1]==32){
                let c:[]u8=n6_sub(line,k+2,line.len-k-2);
                n6_addsent(tx,bp,wa,wp,st,sp,c,c.len);
                np=np+1;
                continue;
            }
        }
        if(n6_starts(line,"ID:")==1){continue;}
        if(n6_starts(line,"DOMAIN:")==1){continue;}
        if(n6_starts(line,"TYPE:")==1){continue;}
        if(n6_starts(line,"LEVEL:")==1){continue;}
        if(n6_starts(line,"KIND:")==1){continue;}
        if(n6_starts(line,"BASE-STORE:")==1){continue;}
        if(n6_starts(line,"STORE:")==1){continue;}
        if(n6_starts(line,"PREMISES:")==1){continue;}
        if(n6_starts(line,"STATEMENT:")==1){continue;}
        if(n6_starts(line,"Domain:")==1){continue;}
        if(n6_starts(line,"Type:")==1){continue;}
    }
    return np;
}
// parse store buffer; returns sentence count added
fn n6_parse_store(buf:[]u8,bln:i32,tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,st:[]u8,sp:*i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<bln){
        let e:i32=i;
        while(e<bln && buf[e]!=10){e=e+1;}
        let line:[]u8=n6_trim(n6_sub(buf,i,e-i));
        i=e+1;
        if(line.len==0){continue;}
        if(line[0]==35){continue;}
        if(line[0]==91){continue;}
        n6_addsent(tx,bp,wa,wp,st,sp,line,line.len);
        n=n+1;
    }
    return n;
}
fn n6_sent_show(tx:[]u8,st:[]u8,idx:i32)void {
    let base:i32=idx*32;
    let no:i32=au_get32(st,base+8);
    let nl:i32=au_get32(st,base+12);
    n6_print(n6_sub(tx,no,nl));
    return;
}
// bump-pointer cell: heap int block used as *i32 out-param (room for 8 cells)
fn n6_cell()*i32 {
    let p:*i32=_zag_malloc(64) as *i32;
    let i:i32=0;
    while(i<8){p[i]=0;i=i+1;}
    return p;
}
fn n6_test_c()void {
    let tx:[]u8=n6_alloc(4194304);
    let wa:[]u8=n6_alloc(4194304);
    let st:[]u8=n6_alloc(65536);
    let bp:*i32=n6_cell();let wp:*i32=n6_cell();let spp:*i32=n6_cell();let gpp:*i32=n6_cell();
    let buf:[]u8=n6_alloc(1048576);
    let n:i64=n6_read_file("../n6run/co/T2_01.txt",buf,1048576);
    let np:i32=n6_parse_problem(buf,n as i32,tx,bp,wa,wp,st,spp,gpp);
    n6_print("premises=");n6_print(n6_i64s(np as i64));n6_print("\n");
    let gi:i32=gpp[0];
    n6_print("goal=[");n6_sent_show(tx,st,gi);n6_print("]\n");
    let n2:i64=n6_read_file("../n6run/batteries/KNOWLEDGE_STORE_NL.md",buf,1048576);
    let ns:i32=n6_parse_store(buf,n2 as i32,tx,bp,wa,wp,st,spp);
    n6_print("store sents=");n6_print(n6_i64s(ns as i64));n6_print("\n");
    n6_print("sent0=[");n6_sent_show(tx,st,np+1);n6_print("]\n");
    return;
}
// ---- chunk C2: license minting ----
// intern a raw substring: normalize+morph; o[0..5]=noff,nlen,wn,wtab,mwn,mwtab
fn n6_intern(tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,raw:[]u8,roff:i32,rlen:i32,o:*i32)void {
    let sub:[]u8=n6_sub(raw,roff,rlen);
    let no:i32=bp[0];
    let nl:i32=n6_norm(sub,sub.len,tx,no);
    bp[0]=no+nl;
    o[0]=no;o[1]=nl;
    let wt:i32=wp[0];
    let nw:i32=n6_words(n6_sub(tx,no,nl),nl,no,wa,wt);
    wp[0]=wt+nw*8;
    o[2]=nw;o[3]=wt;
    let mwt:i32=wp[0];
    let mnw:i32=n6_morph_span(tx,bp,wa,wp,wt,nw);
    o[4]=mnw;o[5]=mwt;
    return;
}
fn n6_isneg(w:[]u8)i32 {
    if(n6_eq(w,"not")==1){return 1;}
    if(n6_eq(w,"n't")==1){return 1;}
    if(n6_eq(w,"never")==1){return 1;}
    if(n6_eq(w,"no")==1){return 1;}
    return 0;
}
fn n6_isverbish(w:[]u8)i32 {
    // closed-class non-verbs that stem() would mangle
    if(n6_eq(w,"this")==1){return 0;}
    if(n6_eq(w,"that")==1){return 0;}
    if(n6_eq(w,"these")==1){return 0;}
    if(n6_eq(w,"those")==1){return 0;}
    if(n6_eq(w,"the")==1){return 0;}
    if(n6_eq(w,"a")==1){return 0;}
    if(n6_eq(w,"an")==1){return 0;}
    if(n6_eq(w,"it")==1){return 0;}
    if(n6_eq(w,"its")==1){return 0;}
    if(n6_eq(n6_stem(w),w)==0){return 1;}
    if(n6_eq(w,"is")==1){return 1;}
    if(n6_eq(w,"are")==1){return 1;}
    if(n6_eq(w,"was")==1){return 1;}
    if(n6_eq(w,"were")==1){return 1;}
    if(n6_eq(w,"has")==1){return 1;}
    if(n6_eq(w,"have")==1){return 1;}
    if(n6_eq(w,"had")==1){return 1;}
    if(n6_eq(w,"do")==1){return 1;}
    if(n6_eq(w,"does")==1){return 1;}
    if(n6_eq(w,"did")==1){return 1;}
    if(n6_eq(w,"will")==1){return 1;}
    if(n6_eq(w,"would")==1){return 1;}
    if(n6_eq(w,"can")==1){return 1;}
    if(n6_eq(w,"could")==1){return 1;}
    if(n6_eq(w,"shall")==1){return 1;}
    if(n6_eq(w,"should")==1){return 1;}
    if(n6_eq(w,"may")==1){return 1;}
    if(n6_eq(w,"might")==1){return 1;}
    if(n6_eq(w,"must")==1){return 1;}
    if(n6_eq(w,"be")==1){return 1;}
    if(n6_eq(w,"been")==1){return 1;}
    if(n6_eq(w,"being")==1){return 1;}
    return 0;
}
// rule record 64B: kind,n_ant,f1o,f1l,f2o,f2l,src,f3o,f3l,f4o,f4l,aux,w1tab,w1n,w2tab,w2n
fn n6_emit(rt:[]u8,rp:*i32,kind:i32,nant:i32,src:i32,f1o:i32,f1l:i32,f2o:i32,f2l:i32,w1t:i32,w1n:i32,w2t:i32,w2n:i32)i32 {
    let idx:i32=rp[0];
    let b:i32=idx*64;
    au_put32(rt,b,kind);au_put32(rt,b+4,nant);
    au_put32(rt,b+8,f1o);au_put32(rt,b+12,f1l);
    au_put32(rt,b+16,f2o);au_put32(rt,b+20,f2l);
    au_put32(rt,b+24,src);
    au_put32(rt,b+28,0);au_put32(rt,b+32,0);au_put32(rt,b+36,0);au_put32(rt,b+40,0);au_put32(rt,b+44,0);
    au_put32(rt,b+48,w1t);au_put32(rt,b+52,w1n);
    au_put32(rt,b+56,w2t);au_put32(rt,b+60,w2n);
    rp[0]=idx+1;
    return idx;
}
// raw word char span -> scratch text of word range [a,b) at sc[scoff..]; returns new offset
fn n6_wrange_text(tx:[]u8,wa:[]u8,wtab:i32,a:i32,b:i32,sc:[]u8,scoff:i32)i32 {
    let w:i32=scoff;
    let k:i32=a;
    while(k<b){
        if(k>a){sc[w]=32;w=w+1;}
        let wd:[]u8=n6_wget(tx,wa,wtab,k);
        let j:i32=0;
        while(j<wd.len){sc[w]=wd[j];w=w+1;j=j+1;}
        k=k+1;
    }
    return w;
}
// ---- pronoun helpers ----
fn n6_is_weather(w:[]u8)i32 {
    if(n6_eq(w,"rain")==1){return 1;}
    if(n6_eq(w,"rains")==1){return 1;}
    if(n6_eq(w,"rained")==1){return 1;}
    if(n6_eq(w,"raining")==1){return 1;}
    if(n6_eq(w,"snow")==1){return 1;}
    if(n6_eq(w,"snows")==1){return 1;}
    if(n6_eq(w,"snowed")==1){return 1;}
    if(n6_eq(w,"snowing")==1){return 1;}
    if(n6_eq(w,"hail")==1){return 1;}
    if(n6_eq(w,"hails")==1){return 1;}
    if(n6_eq(w,"hailed")==1){return 1;}
    if(n6_eq(w,"drizzle")==1){return 1;}
    if(n6_eq(w,"drizzles")==1){return 1;}
    if(n6_eq(w,"storm")==1){return 1;}
    if(n6_eq(w,"storms")==1){return 1;}
    if(n6_eq(w,"stormed")==1){return 1;}
    return 0;
}
fn n6_is_pronoun(w:[]u8)i32 {
    if(n6_eq(w,"it")==1){return 1;}
    if(n6_eq(w,"they")==1){return 1;}
    if(n6_eq(w,"them")==1){return 1;}
    if(n6_eq(w,"he")==1){return 1;}
    if(n6_eq(w,"she")==1){return 1;}
    if(n6_eq(w,"him")==1){return 1;}
    if(n6_eq(w,"her")==1){return 1;}
    if(n6_eq(w,"we")==1){return 1;}
    if(n6_eq(w,"you")==1){return 1;}
    return 0;
}
fn n6_is_aux(w:[]u8)i32 {
    if(n6_eq(w,"do")==1){return 1;}
    if(n6_eq(w,"does")==1){return 1;}
    if(n6_eq(w,"did")==1){return 1;}
    if(n6_eq(w,"will")==1){return 1;}
    if(n6_eq(w,"would")==1){return 1;}
    if(n6_eq(w,"can")==1){return 1;}
    if(n6_eq(w,"could")==1){return 1;}
    if(n6_eq(w,"shall")==1){return 1;}
    if(n6_eq(w,"should")==1){return 1;}
    if(n6_eq(w,"may")==1){return 1;}
    if(n6_eq(w,"might")==1){return 1;}
    if(n6_eq(w,"must")==1){return 1;}
    return 0;
}
// word-range to text; leading "it" (subject position) -> replacement, unless expletive (weather verb)
fn n6_wrange_it(tx:[]u8,wa:[]u8,rwt:i32,b:i32,e:i32,lsb:[]u8,llen:i32,dst:[]u8,doff:i32)i32 {
    let w2:i32=doff;
    let k:i32=b;
    while(k<e){
        let wd:[]u8=n6_wget(tx,wa,rwt,k);
        if(k>b){dst[w2]=32;w2=w2+1;}
        if(k==b && n6_eq(wd,"it")==1 && llen>0){
            let q:i32=k+1;
            let expl:i32=0;
            while(q<e){
                let wq:[]u8=n6_wget(tx,wa,rwt,q);
                if(n6_is_aux(wq)==1||n6_isneg(wq)==1){q=q+1;}
                else{
                    if(n6_is_weather(wq)==1){expl=1;}
                    break;
                }
            }
            if(expl==0){
                let j:i32=0;
                while(j<llen){dst[w2]=lsb[j];w2=w2+1;j=j+1;}
            }else{
                let j:i32=0;
                while(j<wd.len){dst[w2]=wd[j];w2=w2+1;j=j+1;}
            }
        }else{
            let j:i32=0;
            while(j<wd.len){dst[w2]=wd[j];w2=w2+1;j=j+1;}
        }
        k=k+1;
    }
    return w2-doff;
}
// extract last-nonquantified-subject candidate of sentence s into lsb; returns len (0 = no update)
fn n6_lsubj(tx:[]u8,wa:[]u8,st:[]u8,s:i32,lsb:[]u8)i32 {
    let sb:i32=s*32;
    let rwt:i32=au_get32(st,sb+20);
    let rwn:i32=au_get32(st,sb+16);
    if(rwn<1){return 0;}
    let a0:i32=0;
    let w0:[]u8=n6_wget(tx,wa,rwt,0);
    if(n6_eq(w0,"if")==1||n6_eq(w0,"whenever")==1){a0=1;}
    if(a0>=rwn){return 0;}
    let fw:[]u8=n6_wget(tx,wa,rwt,a0);
    if(n6_eq(fw,"every")==1){return 0;}
    if(n6_eq(fw,"all")==1){return 0;}
    if(n6_eq(fw,"each")==1){return 0;}
    if(n6_eq(fw,"no")==1){return 0;}
    if(n6_eq(fw,"everything")==1){return 0;}
    if(n6_eq(fw,"everyone")==1){return 0;}
    if(n6_is_pronoun(fw)==1){return 0;}
    let v:i32=-1;
    let q:i32=a0;
    while(q<rwn){if(n6_isverbish(n6_wget(tx,wa,rwt,q))==1){v=q;break;}q=q+1;}
    let e2:i32=rwn;
    if(v>a0){e2=v;}
    let w2:i32=0;
    q=a0;
    while(q<e2){
        if(q>a0){lsb[w2]=32;w2=w2+1;}
        let wd:[]u8=n6_wget(tx,wa,rwt,q);
        let j:i32=0;
        while(j<wd.len){lsb[w2]=wd[j];w2=w2+1;j=j+1;}
        q=q+1;
    }
    return w2;
}
// mint licenses from sentences; two passes (pattern rules, then facts); gskip=goal sent idx (no self-fact)
fn n6_mint(tx:[]u8,bp:*i32,wa:[]u8,wp:*i32,st:[]u8,nsent:i32,gskip:i32,rt:[]u8,rp:*i32,sc:[]u8,lsb:[]u8,lsp:*i32)i32 {
    let s:i32=0;
    // pass 1: pattern rules
    while(s<nsent){
        let sb:i32=s*32;
        let ro:i32=au_get32(st,sb);
        let rl:i32=au_get32(st,sb+4);
        let rwt:i32=wp[0];
        let rwn:i32=n6_words(n6_sub(tx,ro,rl),rl,ro,wa,rwt);
        wp[0]=rwt+rwn*8;
        let w0:[]u8=n6_wget(tx,wa,rwt,0);
        // L-COND: if ... then ... / if ..., ... / whenever ..., ...
        let iscond:i32=0;
        let a0:i32=0;let a1:i32=0;let c0:i32=0;let c1:i32=0;
        if((n6_eq(w0,"if")==1||n6_eq(w0,"whenever")==1) && rwn>=5){
            let start:i32=1;
            let split:i32=-1;
            let k:i32=start;
            let iswhen:i32=0;
            if(n6_eq(w0,"whenever")==1){iswhen=1;}
            if(iswhen==0){
                while(k<rwn){if(n6_eq(n6_wget(tx,wa,rwt,k),"then")==1){split=k;break;}k=k+1;}
            }
            if(split<0){
                k=start;
                while(k<rwn){if(n6_eq(n6_wget(tx,wa,rwt,k),",")==1){split=k;break;}k=k+1;}
            }
            if(split>start+1 && split+2<rwn){
                a0=start;a1=split;c0=split+1;c1=rwn;iscond=1;
            }
        }
        if(iscond==1){
            let oa:*i32=n6_cell();let oc:*i32=n6_cell();
            // pronoun: leading "it" in ant -> last subject; leading "it" in cons -> ant NP (or last subject)
            let do_pron:i32=0;
            if(s<=gskip && lsp[0]>0){do_pron=1;}
            let alen:i32=0;
            if(do_pron==1){
                alen=n6_wrange_it(tx,wa,rwt,a0,a1,lsb,lsp[0],sc,0);
            }else{
                alen=n6_wrange_text(tx,wa,rwt,a0,a1,sc,0);
            }
            n6_intern(tx,bp,wa,wp,sc,0,alen,oa);
            // ant leading NP as text (for cons-it), at sc+8192
            let na0:i32=a0;
            let aw0:[]u8=n6_wget(tx,wa,rwt,a0);
            if(n6_eq(aw0,"if")==1||n6_eq(aw0,"whenever")==1){na0=a0+1;}
            let nv2:i32=-1;
            let q2:i32=na0;
            while(q2<a1){if(n6_isverbish(n6_wget(tx,wa,rwt,q2))==1){nv2=q2;break;}q2=q2+1;}
            let ne2:i32=a1;
            if(nv2>na0){ne2=nv2;}
            let nplen:i32=n6_wrange_text(tx,wa,rwt,na0,ne2,sc,8192);
            let crep_off:i32=8192;
            let crep_len:i32=nplen;
            if(nplen>0){
                let npfw:[]u8=n6_wget(tx,wa,rwt,na0);
                if(n6_is_pronoun(npfw)==1){crep_off=-1;crep_len=lsp[0];}
            }else{crep_off=-1;crep_len=lsp[0];}
            let clen:i32=0;
            if(do_pron==1){
                if(crep_off>=0){
                    clen=n6_wrange_it(tx,wa,rwt,c0,c1,n6_sub(sc,crep_off,crep_len),crep_len,sc,0);
                }else{
                    clen=n6_wrange_it(tx,wa,rwt,c0,c1,lsb,lsp[0],sc,0);
                }
            }else{
                clen=n6_wrange_text(tx,wa,rwt,c0,c1,sc,0);
            }
            n6_intern(tx,bp,wa,wp,sc,0,clen,oc);
            n6_emit(rt,rp,1,1,s,oa[0],oa[1],oc[0],oc[1],oa[5],oa[4],oc[5],oc[4]);
            // L-CONTRA-POS: both sides carry a negation marker
            let aneg:i32=0;let cneg:i32=0;
            kk=a0;while(kk<a1){if(n6_isneg(n6_wget(tx,wa,rwt,kk))==1){aneg=1;}kk=kk+1;}
            kk=c0;while(kk<c1){if(n6_eq(n6_wget(tx,wa,rwt,kk),"it")==0 && n6_isneg(n6_wget(tx,wa,rwt,kk))==1){cneg=1;}kk=kk+1;}
            if(aneg==1 && cneg==1){
                // ant2 = cons minus first neg; cons2 = ant minus first neg
                let w2:i32=0;let dropped:i32=0;
                kk=c0;
                while(kk<c1){
                    let wd:[]u8=n6_wget(tx,wa,rwt,kk);
                    if(dropped==0 && n6_isneg(wd)==1 && n6_eq(wd,"it")==0){dropped=1;}
                    else{if(w2>0){sc[w2]=32;w2=w2+1;}let j:i32=0;while(j<wd.len){sc[w2]=wd[j];w2=w2+1;j=j+1;}}
                    kk=kk+1;
                }
                let oa2:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,w2,oa2);
                w2=0;dropped=0;
                kk=a0;
                while(kk<a1){
                    let wd:[]u8=n6_wget(tx,wa,rwt,kk);
                    if(dropped==0 && n6_isneg(wd)==1){dropped=1;}
                    else{if(w2>0){sc[w2]=32;w2=w2+1;}let j:i32=0;while(j<wd.len){sc[w2]=wd[j];w2=w2+1;j=j+1;}}
                    kk=kk+1;
                }
                let oc2:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,w2,oc2);
                if(oa2[4]>=2 && oc2[4]>=2){
                    n6_emit(rt,rp,2,1,s,oa2[0],oa2[1],oc2[0],oc2[1],oa2[5],oa2[4],oc2[5],oc2[4]);
                }
            }
        }
        // L-UNIV-ISA / L-UNIV-VERB
        if(n6_eq(w0,"every")==1 && rwn>=3){
            let wi:i32=-1;
            let k:i32=1;
            while(k<rwn){
                let wd:[]u8=n6_wget(tx,wa,rwt,k);
                if(n6_eq(wd,"is")==1||n6_eq(wd,"are")==1){wi=k;break;}
                k=k+1;
            }
            if(wi>1){
                let p0:i32=wi+1;
                let wd0:[]u8=n6_wget(tx,wa,rwt,p0);
                if((n6_eq(wd0,"a")==1||n6_eq(wd0,"an")==1) && p0+1<rwn){p0=p0+1;}
                let slen:i32=n6_wrange_text(tx,wa,rwt,1,wi,sc,0);
                let o1:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,slen,o1);
                let plen:i32=n6_wrange_text(tx,wa,rwt,p0,rwn,sc,0);
                let o2:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,plen,o2);
                if(o1[4]>=1 && o2[4]>=1){
                    n6_emit(rt,rp,3,-2,s,o1[0],o1[1],o2[0],o2[1],o1[5],o1[4],o2[5],o2[4]);
                }
            }else{
                let slen:i32=n6_wrange_text(tx,wa,rwt,1,2,sc,0);
                let o1:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,slen,o1);
                let vlen:i32=n6_wrange_text(tx,wa,rwt,2,rwn,sc,0);
                let o2:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,vlen,o2);
                if(o1[4]>=1 && o2[4]>=1){
                    n6_emit(rt,rp,4,-2,s,o1[0],o1[1],o2[0],o2[1],o1[5],o1[4],o2[5],o2[4]);
                }
            }
        }
        // L-REL: Every H that R, P / Everyone|Everything who|that R, P / reduced: Everything <V-ed> <VP>
        if((n6_eq(w0,"every")==1||n6_eq(w0,"everything")==1||n6_eq(w0,"everyone")==1) && rwn>=3){
            let trel:i32=-1;
            let k:i32=1;
            while(k<rwn){
                let wd:[]u8=n6_wget(tx,wa,rwt,k);
                if(n6_eq(wd,"that")==1||n6_eq(wd,"who")==1){trel=k;break;}
                k=k+1;
            }
            let r0:i32=-1;
            let reduced:i32=0;
            if(trel>0){r0=trel+1;}
            else{
                if((n6_eq(w0,"everything")==1||n6_eq(w0,"everyone")==1) && rwn>=3){
                    let w1:[]u8=n6_wget(tx,wa,rwt,1);
                    if(w1.len>4 && n6_eq(n6_sub(w1,w1.len-2,2),"ed")==1){r0=1;reduced=1;}
                }
            }
            if(r0>0 && r0<rwn){
                let v1:i32=-1;let v2:i32=-1;
                k=r0;
                while(k<rwn){
                    let wdv:[]u8=n6_wget(tx,wa,rwt,k);
                    if(wdv.len>1 && wdv[wdv.len-1]==46){wdv=n6_sub(wdv,0,wdv.len-1);}
                    if(n6_isverbish(wdv)==1){
                        if(v1<0){v1=k;}else{v2=k;break;}
                    }
                    k=k+1;
                }
                if(v1>=r0 && v2>v1 && v2<rwn){
                    let vacuous:i32=1;
                    let oh:*i32=n6_cell();
                    if(n6_eq(w0,"every")==1 && trel>1){
                        let hlen:i32=n6_wrange_text(tx,wa,rwt,1,trel,sc,0);
                        n6_intern(tx,bp,wa,wp,sc,0,hlen,oh);
                        if(oh[4]>=1){vacuous=0;}
                    }
                    let rlen:i32=0;
                    if(reduced==1){sc[0]=105;sc[1]=115;sc[2]=32;rlen=3;}
                    rlen=rlen+n6_wrange_text(tx,wa,rwt,r0,v2,sc,rlen);
                    let rrel:*i32=n6_cell();
                    n6_intern(tx,bp,wa,wp,sc,0,rlen,rrel);
                    let plen:i32=n6_wrange_text(tx,wa,rwt,v2,rwn,sc,0);
                    let prel:*i32=n6_cell();
                    n6_intern(tx,bp,wa,wp,sc,0,plen,prel);
                    if(rrel[4]>=1 && prel[4]>=1){
                        n6_emit(rt,rp,7,vacuous,s,oh[5],oh[4],0,0,rrel[5],rrel[4],prel[5],prel[4]);
                    }
                }
            }
        }
        // L-DISJ-SYL: contains word or with words on both sides
        let oi:i32=-1;
        let k2:i32=1;
        while(k2<rwn-1){
            if(n6_eq(n6_wget(tx,wa,rwt,k2),"or")==1){oi=k2;break;}
            k2=k2+1;
        }
        if(oi>0){
            n6_emit(rt,rp,5,-3,s,0,0,0,0,0,0,0,0);
        }
        // track last non-quantified subject for pronoun resolution (premises only, in order)
        if(s<gskip){
            let nl2:i32=n6_lsubj(tx,wa,st,s,lsb);
            if(nl2>0){lsp[0]=nl2;}
        }
        s=s+1;
    }
    // pass 2: zero-antecedent rules (facts) + double-negation rewrites
    s=0;
    while(s<nsent){
        if(s==gskip){s=s+1;continue;}
        let sb:i32=s*32;
        let ro:i32=au_get32(st,sb);
        let rl:i32=au_get32(st,sb+4);
        let no:i32=au_get32(st,sb+8);
        let nl:i32=au_get32(st,sb+12);
        let mwt:i32=au_get32(st,sb+28);
        let mwn:i32=au_get32(st,sb+24);
        // L-DOUBLENEG: it is impossible for S not to VP
        let rwt:i32=wp[0];
        let rwn:i32=n6_words(n6_sub(tx,ro,rl),rl,ro,wa,rwt);
        wp[0]=rwt+rwn*8;
        if(rwn>6 && n6_eq(n6_wget(tx,wa,rwt,0),"it")==1 && n6_eq(n6_wget(tx,wa,rwt,1),"is")==1 && n6_eq(n6_wget(tx,wa,rwt,2),"impossible")==1 && n6_eq(n6_wget(tx,wa,rwt,3),"for")==1){
            let ni:i32=-1;let ti:i32=-1;
            let k:i32=4;
            while(k<rwn){if(n6_eq(n6_wget(tx,wa,rwt,k),"not")==1){ni=k;break;}k=k+1;}
            if(ni>4){
                k=ni+1;
                while(k<rwn){if(n6_eq(n6_wget(tx,wa,rwt,k),"to")==1){ti=k;break;}k=k+1;}
            }
            if(ni>0 && ti>ni && ti+1<rwn){
                let w2:i32=n6_wrange_text(tx,wa,rwt,4,ni,sc,0);
                sc[w2]=32;w2=w2+1;
                w2=n6_wrange_text(tx,wa,rwt,ti+1,rwn,sc,w2);
                let oo:*i32=n6_cell();
                n6_intern(tx,bp,wa,wp,sc,0,w2,oo);
                n6_emit(rt,rp,6,0,s,oo[0],oo[1],0,0,oo[5],oo[4],0,0);
            }
        }
        n6_emit(rt,rp,6,0,s,no,nl,0,0,mwt,mwn,0,0);
        s=s+1;
    }
    return rp[0];
}
fn n6_kindname(k:i32)[]u8 {
    if(k==1){return "COND";}
    if(k==2){return "CONTRA";}
    if(k==3){return "UISA";}
    if(k==4){return "UVERB";}
    if(k==5){return "DISJ";}
    if(k==6){return "FACT";}
    if(k==7){return "L-REL";}
    return "?";
}
fn n6_test_d()void {
    let tx:[]u8=n6_alloc(4194304);
    let wa:[]u8=n6_alloc(4194304);
    let st:[]u8=n6_alloc(65536);
    let rt:[]u8=n6_alloc(1048576);
    let sc:[]u8=n6_alloc(65536);
    let bp:*i32=n6_cell();let wp:*i32=n6_cell();let spp:*i32=n6_cell();let gpp:*i32=n6_cell();let rpp:*i32=n6_cell();
    let lsb2:[]u8=n6_alloc(512);let lsp2:*i32=n6_cell();
    let buf:[]u8=n6_alloc(1048576);
    let n:i64=n6_read_file("../n6run/co/T2_01.txt",buf,1048576);
    let np:i32=n6_parse_problem(buf,n as i32,tx,bp,wa,wp,st,spp,gpp);
    let nsent:i32=spp[0];
    let nr:i32=n6_mint(tx,bp,wa,wp,st,nsent,-1,rt,rpp,sc,lsb2,lsp2);
    n6_print("rules=");n6_print(n6_i64s(nr as i64));n6_print("\n");
    let r:i32=0;
    while(r<nr){
        let b:i32=r*64;
        let kind:i32=au_get32(rt,b);
        let na:i32=au_get32(rt,b+4);
        n6_print(n6_kindname(kind));n6_print(" na=");n6_print(n6_i64s(na as i64));
        if(kind==1||kind==2){
            n6_print(" A=[");n6_print(n6_sub(tx,au_get32(rt,b+8),au_get32(rt,b+12)));
            n6_print("] C=[");n6_print(n6_sub(tx,au_get32(rt,b+16),au_get32(rt,b+20)));n6_print("]");
        }
        n6_print("\n");
        r=r+1;
    }
    return;
}
// ---- chunk D: backward search ----
fn n6_fnv(tx:[]u8,wa:[]u8,tab:i32,n:i32)i64 {
    let h:i64=1469598103934665603;
    let k:i32=0;
    while(k<n){
        let w:[]u8=n6_wget(tx,wa,tab,k);
        let j:i32=0;
        while(j<w.len){h=(h^(w[j] as i64))*1099511628211;j=j+1;}
        h=(h^32)*1099511628211;
        k=k+1;
    }
    return h;
}
// build subgoal text: words(wt1[0..n1)) + mid + words(wt2[0..n2)) in depth scratch; ot/on = morph table/count
fn n6_subgoal(tx:[]u8,wa:[]u8,bp:*i32,wp:*i32,depth:i32,wt1:i32,n1:i32,mid:[]u8,wt2:i32,n2:i32,ot:*i32,on:*i32)void {
    let so:i32=n6_sctx(depth);
    let sw:i32=so;
    sw=n6_wrange_text(tx,wa,wt1,0,n1,tx,sw);
    if(n1>0 && mid.len>0){tx[sw]=32;sw=sw+1;}
    let j:i32=0;
    while(j<mid.len){tx[sw]=mid[j];sw=sw+1;j=j+1;}
    if(n2>0 && (n1>0||mid.len>0)){tx[sw]=32;sw=sw+1;}
    sw=n6_wrange_text(tx,wa,wt2,0,n2,tx,sw);
    let swo:i32=n6_scwa(depth);
    let swn:i32=n6_words(n6_sub(tx,so,sw-so),sw-so,so,wa,swo);
    let smwt:i32=wp[0];
    let smn:i32=n6_morph_span(tx,bp,wa,wp,swo,swn);
    ot[0]=smwt;on[0]=smn;
    return;
}
fn n6_temit(tr:[]u8,tp:*i32,s:[]u8)void {
    let p:i32=tp[0];
    let i:i32=0;
    while(i<s.len){tr[p+i]=s[i];i=i+1;}
    tp[0]=p+s.len;
    return;
}
fn n6_temit_wtext(tx:[]u8,wa:[]u8,tr:[]u8,tp:*i32,tab:i32,n:i32)void {
    let k:i32=0;
    while(k<n){
        if(k>0){n6_temit(tr,tp," ");}
        n6_temit(tr,tp,n6_wget(tx,wa,tab,k));
        k=k+1;
    }
    return;
}
fn n6_dname(d:i32)[]u8 {
    if(d==0){return "NO-RULE";}
    if(d==1){return "FACT-MISS";}
    if(d==2){return "CYCLE";}
    if(d==3){return "BUDGET";}
    if(d==4){return "BRIDGE-MISS";}
    if(d==5){return "POLARITY-MISMATCH";}
    if(d==6){return "MORPH-MISS";}
    if(d==7){return "CONDITIONAL-GOAL";}
    if(d==8){return "WH-OPEN";}
    if(d==9){return "RULE-EXHAUSTED";}
    if(d==10){return "MISSING-LINK";}
    if(d==11){return "DISJ-FAIL";}
    return "UNKNOWN";
}
// scratch bases (last 1MB of 4MB arenas)
fn n6_sctx(depth:i32)i32 {return 3145728+depth*4096;}
fn n6_scwa(depth:i32)i32 {return 3145728+depth*4096;}
fn n6_need(tx:[]u8,wa:[]u8,bp:*i32,wp:*i32,st:[]u8,nsent:i32,rt:[]u8,nr:i32,me:[]u8,mep:*i32,sk:[]u8,dc:[]u8,tr:[]u8,tp:*i32,gtab:i32,gn:i32,depth:i32,bound:i32,stepc:*i32)i32 {
    let h:i64=n6_fnv(tx,wa,gtab,gn);
    // memo (scan reverse: latest entry wins, so proved shadows earlier cycle-failed)
    let mn:i32=mep[0];
    let mi:i32=mn-1;
    while(mi>=0){
        if(au_get64(me,mi*24)==h){
            let stt:i32=au_get32(me,mi*24+8);
            if(stt==1){return 1;}
            let dd:i32=au_get32(me,mi*24+12);
            au_put32(dc,dd*4,au_get32(dc,dd*4)+1);
            return 0;
        }
        mi=mi-1;
    }
    // cycle
    let ci:i32=0;
    while(ci<depth){
        if(au_get64(sk,ci*8)==h){
            au_put32(dc,8,au_get32(dc,8)+1);
            let e:i32=mep[0];au_put64(me,e*24,h);au_put32(me,e*24+8,2);au_put32(me,e*24+12,2);mep[0]=e+1;
            return 0;
        }
        ci=ci+1;
    }
    if(depth>bound){
        au_put32(dc,12,au_get32(dc,12)+1);
        let e2:i32=mep[0];au_put64(me,e2*24,h);au_put32(me,e2*24+8,2);au_put32(me,e2*24+12,3);mep[0]=e2+1;
        return 0;
    }
    au_put64(sk,depth*8,h);
    let tried:i32=0;
    let r:i32=0;
    while(r<nr){
        let b:i32=r*64;
        let kind:i32=au_get32(rt,b);
        let ok:i32=0;
        if(kind==1||kind==2){
            let w2t:i32=au_get32(rt,b+56);let w2n:i32=au_get32(rt,b+60);
            if(n6_t2(tx,wa,gtab,gn,wa,w2t,w2n)==1){ok=1;}
        }
        if(kind==6){
            let w1t:i32=au_get32(rt,b+48);let w1n:i32=au_get32(rt,b+52);
            if(n6_t2(tx,wa,gtab,gn,wa,w1t,w1n)==1){ok=2;}
        }
        if(ok==2){
            // fact: proved immediately
            stepc[0]=stepc[0]+1;
            n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
            n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
            n6_temit(tr,tp," [RULE FACT] [CITE S");n6_temit(tr,tp,n6_i64s(au_get32(rt,b+24) as i64));n6_temit(tr,tp,": ");
            let sb:i32=au_get32(rt,b+24)*32;
            n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb+8),au_get32(st,sb+12)));
            n6_temit(tr,tp,"]\n");
            let e3:i32=mep[0];au_put64(me,e3*24,h);au_put32(me,e3*24+8,1);au_put32(me,e3*24+12,0);mep[0]=e3+1;
            return 1;
        }
        if(ok==1){
            tried=tried+1;
            let sv_tp:i32=tp[0];
            let sv_sc:i32=stepc[0];
            // antecedent parts split on and
            let w1t:i32=au_get32(rt,b+48);let w1n:i32=au_get32(rt,b+52);
            let allok:i32=1;
            let p0:i32=0;
            let q:i32=0;
            while(q<=w1n){
                let isand:i32=0;
                if(q<w1n && n6_eq(n6_wget(tx,wa,w1t,q),"and")==1){isand=1;}
                if(q==w1n || isand==1){
                    if(q>p0){
                        let rr:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,w1t+p0*8,q-p0,depth+1,bound,stepc);
                        if(rr==0){allok=0;break;}
                    }
                    p0=q+1;
                }
                q=q+1;
            }
            if(allok==1){
                stepc[0]=stepc[0]+1;
                n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
                n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
                n6_temit(tr,tp," [RULE ");n6_temit(tr,tp,n6_kindname(kind));n6_temit(tr,tp,"] [CITE S");
                n6_temit(tr,tp,n6_i64s(au_get32(rt,b+24) as i64));n6_temit(tr,tp,": ");
                let sb2:i32=au_get32(rt,b+24)*32;
                n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb2+8),au_get32(st,sb2+12)));
                n6_temit(tr,tp,"]\n");
                let e4:i32=mep[0];au_put64(me,e4*24,h);au_put32(me,e4*24+8,1);au_put32(me,e4*24+12,0);mep[0]=e4+1;
                return 1;
            }else{
                tp[0]=sv_tp;stepc[0]=sv_sc;
            }
        }
        r=r+1;
    }
    // UISA / UVERB / DISJ pattern rules: goal-shape matching
    r=0;
    while(r<nr){
        let b2:i32=r*64;
        let kind2:i32=au_get32(rt,b2);
        if(kind2==3){
            // goal: Z is/are P ; rule f1=subj f2=pred
            let wi:i32=-1;
            let k:i32=1;
            while(k<gn){
                let wd:[]u8=n6_wget(tx,wa,gtab,k);
                if(n6_eq(wd,"is")==1||n6_eq(wd,"are")==1){wi=k;break;}
                k=k+1;
            }
            if(wi>0 && wi+1<gn){
                let p0:i32=wi+1;
                if(n6_eq(n6_wget(tx,wa,gtab,p0),"a")==1||n6_eq(n6_wget(tx,wa,gtab,p0),"an")==1){p0=p0+1;}
                let w2t2:i32=au_get32(rt,b2+56);
                let w2n2:i32=au_get32(rt,b2+60);
                if(p0<gn && n6_t2(tx,wa,gtab+p0*8,gn-p0,wa,w2t2,w2n2)==1){
                    tried=tried+1;
                    let sv3t:i32=tp[0];
                    let sv3s:i32=stepc[0];
                    let ot:*i32=n6_cell();
                    let on:*i32=n6_cell();
                    n6_subgoal(tx,wa,bp,wp,depth,gtab,wi,"is a",au_get32(rt,b2+48),au_get32(rt,b2+52),ot,on);
                    let rr3:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,ot[0],on[0],depth+1,bound,stepc);
                    if(rr3==1){
                        stepc[0]=stepc[0]+1;
                        n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
                        n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
                        n6_temit(tr,tp," [RULE UISA] [CITE S");
                        n6_temit(tr,tp,n6_i64s(au_get32(rt,b2+24) as i64));n6_temit(tr,tp,": ");
                        let sb3:i32=au_get32(rt,b2+24)*32;
                        n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb3+8),au_get32(st,sb3+12)));
                        n6_temit(tr,tp,"]\n");
                        let e6:i32=mep[0];au_put64(me,e6*24,h);au_put32(me,e6*24+8,1);au_put32(me,e6*24+12,0);mep[0]=e6+1;
                        return 1;
                    }else{
                        tp[0]=sv3t;stepc[0]=sv3s;
                    }
                }
            }
        }
        if(kind2==4){
            // goal: Z Vg Rg ; rule f2 = verb+rest morph words
            if(gn>=2){
                let vwt:i32=au_get32(rt,b2+56);
                let vwn:i32=au_get32(rt,b2+60);
                if(vwn>=1 && n6_stemeq(n6_wget(tx,wa,gtab,1),n6_wget(tx,wa,vwt,0))==1){
                    let rok:i32=1;
                    if(vwn>1){
                        if(gn<=2){rok=0;}
                        else{if(n6_t2(tx,wa,gtab+16,gn-2,wa,vwt+8,vwn-1)==0){rok=0;}}
                    }
                    if(rok==1){
                        tried=tried+1;
                        let sv4t:i32=tp[0];
                        let sv4s:i32=stepc[0];
                        let ot2:*i32=n6_cell();
                        let on2:*i32=n6_cell();
                        n6_subgoal(tx,wa,bp,wp,depth,gtab,1,"is a",au_get32(rt,b2+48),au_get32(rt,b2+52),ot2,on2);
                        let rr4:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,ot2[0],on2[0],depth+1,bound,stepc);
                        if(rr4==1){
                            stepc[0]=stepc[0]+1;
                            n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
                            n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
                            n6_temit(tr,tp," [RULE UVERB] [CITE S");
                            n6_temit(tr,tp,n6_i64s(au_get32(rt,b2+24) as i64));n6_temit(tr,tp,": ");
                            let sb4:i32=au_get32(rt,b2+24)*32;
                            n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb4+8),au_get32(st,sb4+12)));
                            n6_temit(tr,tp,"]\n");
                            let e7:i32=mep[0];au_put64(me,e7*24,h);au_put32(me,e7*24+8,1);au_put32(me,e7*24+12,0);mep[0]=e7+1;
                            return 1;
                        }else{
                            tp[0]=sv4t;stepc[0]=sv4s;
                        }
                    }
                }
            }
        }
        if(kind2==5){
            // disjunctive syllogism: sentence morph words split by or
            let src5:i32=au_get32(rt,b2+24);
            let sb5:i32=src5*32;
            let dwt:i32=au_get32(st,sb5+28);
            let dwn:i32=au_get32(st,sb5+24);
            // count options
            let nopt:i32=1;
            let kk:i32=0;
            while(kk<dwn){if(n6_eq(n6_wget(tx,wa,dwt,kk),"or")==1){nopt=nopt+1;}kk=kk+1;}
            let i5:i32=0;
            let done5:i32=0;
            while(i5<nopt && done5==0){
                // find option i5 range
                let oi:i32=0;let o0:i32=0;let o1:i32=0;
                let q5:i32=0;let s5:i32=0;
                while(q5<=dwn){
                    if(q5==dwn||n6_eq(n6_wget(tx,wa,dwt,q5),"or")==1){
                        if(oi==i5){o0=s5;o1=q5;}
                        oi=oi+1;s5=q5+1;
                    }
                    q5=q5+1;
                }
                if(o1>o0 && n6_t2(tx,wa,gtab,gn,wa,dwt+o0*8,o1-o0)==1){
                    let j5:i32=0;
                    while(j5<nopt && done5==0){
                        if(j5!=i5){
                            // find option j5 range
                            let oj:i32=0;let f0:i32=0;let f1:i32=0;
                            let q6:i32=0;let s6:i32=0;
                            while(q6<=dwn){
                                if(q6==dwn||n6_eq(n6_wget(tx,wa,dwt,q6),"or")==1){
                                    if(oj==j5){f0=s6;f1=q6;}
                                    oj=oj+1;s6=q6+1;
                                }
                                q6=q6+1;
                            }
                            if(f1>f0){
                                tried=tried+1;
                                let sv5t:i32=tp[0];
                                let sv5s:i32=stepc[0];
                                // negate option j5 into scratch text
                                let so6:i32=n6_sctx(depth);
                                let sw6:i32=so6;
                                let m6:i32=-1;
                                let k6:i32=f0;
                                while(k6<f1){if(n6_isneg(n6_wget(tx,wa,dwt,k6))==1){m6=k6;break;}k6=k6+1;}
                                if(m6<0){
                                    tx[sw6]=110;sw6=sw6+1;tx[sw6]=111;sw6=sw6+1;tx[sw6]=116;sw6=sw6+1;tx[sw6]=32;sw6=sw6+1;
                                    sw6=n6_wrange_text(tx,wa,dwt,f0,f1,tx,sw6);
                                }else{
                                    sw6=n6_wrange_text(tx,wa,dwt,f0,m6,tx,sw6);
                                    if(f1>m6+1){tx[sw6]=32;sw6=sw6+1;sw6=n6_wrange_text(tx,wa,dwt,m6+1,f1,tx,sw6);}
                                }
                                let swo6:i32=n6_scwa(depth);
                                let swn6:i32=n6_words(n6_sub(tx,so6,sw6-so6),sw6-so6,so6,wa,swo6);
                                let smwt6:i32=wp[0];
                                let smn6:i32=n6_morph_span(tx,bp,wa,wp,swo6,swn6);
                                let rr6:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,smwt6,smn6,depth+1,bound,stepc);
                                if(rr6==1){
                                    stepc[0]=stepc[0]+1;
                                    n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
                                    n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
                                    n6_temit(tr,tp," [RULE DISJ-SYL] [CITE S");
                                    n6_temit(tr,tp,n6_i64s(src5 as i64));n6_temit(tr,tp,": ");
                                    n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb5+8),au_get32(st,sb5+12)));
                                    n6_temit(tr,tp,"]\n");
                                    let e8:i32=mep[0];au_put64(me,e8*24,h);au_put32(me,e8*24+8,1);au_put32(me,e8*24+12,0);mep[0]=e8+1;
                                    return 1;
                                }else{
                                    tp[0]=sv5t;stepc[0]=sv5s;
                                }
                            }
                        }
                        j5=j5+1;
                    }
                }
                i5=i5+1;
            }
        }
        if(kind2==7){
            // L-REL: goal Z P ; P=w2 ; subgoals: Z is a H (unless vacuous), Z R
            let pw2t:i32=au_get32(rt,b2+56);
            let pw2n:i32=au_get32(rt,b2+60);
            let rw1t:i32=au_get32(rt,b2+48);
            let rw1n:i32=au_get32(rt,b2+52);
            let hw1t:i32=au_get32(rt,b2+16);
            let hw1n:i32=au_get32(rt,b2+20);
            let vac7:i32=au_get32(rt,b2+4);
            let i7:i32=1;
            let relok:i32=0;
            while(i7<gn && relok==0){
                if(n6_stemeq(n6_wget(tx,wa,gtab,i7),n6_wget(tx,wa,pw2t,0))==1){
                    if(n6_t2(tx,wa,gtab+i7*8,gn-i7,wa,pw2t,pw2n)==1){
                        tried=tried+1;
                        let sv7t:i32=tp[0];
                        let sv7s:i32=stepc[0];
                        let ok7:i32=1;
                        if(vac7==0 && hw1n>0){
                            let ot7:*i32=n6_cell();
                            let on7:*i32=n6_cell();
                            n6_subgoal(tx,wa,bp,wp,depth,gtab,i7,"is a",hw1t,hw1n,ot7,on7);
                            ok7=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,ot7[0],on7[0],depth+1,bound,stepc);
                        }
                        if(ok7==1){
                            let ot8:*i32=n6_cell();
                            let on8:*i32=n6_cell();
                            n6_subgoal(tx,wa,bp,wp,depth,gtab,i7,"",rw1t,rw1n,ot8,on8);
                            let rr8:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,ot8[0],on8[0],depth+1,bound,stepc);
                            if(rr8==1){
                                stepc[0]=stepc[0]+1;
                                n6_temit(tr,tp,"STEP ");n6_temit(tr,tp,n6_i64s(stepc[0] as i64));n6_temit(tr,tp,": ");
                                n6_temit_wtext(tx,wa,tr,tp,gtab,gn);
                                n6_temit(tr,tp," [RULE L-REL] [CITE S");
                                n6_temit(tr,tp,n6_i64s(au_get32(rt,b2+24) as i64));n6_temit(tr,tp,": ");
                                let sb7:i32=au_get32(rt,b2+24)*32;
                                n6_temit(tr,tp,n6_sub(tx,au_get32(st,sb7+8),au_get32(st,sb7+12)));
                                n6_temit(tr,tp,"]\n");
                                let e9:i32=mep[0];au_put64(me,e9*24,h);au_put32(me,e9*24+8,1);au_put32(me,e9*24+12,0);mep[0]=e9+1;
                                return 1;
                            }
                        }
                        tp[0]=sv7t;stepc[0]=sv7s;
                    }
                }
                i7=i7+1;
            }
        }
        r=r+1;
    }
    let death:i32=0;
    if(tried>0){death=9;}
    au_put32(dc,death*4,au_get32(dc,death*4)+1);
    let e5:i32=mep[0];au_put64(me,e5*24,h);au_put32(me,e5*24+8,2);au_put32(me,e5*24+12,death);mep[0]=e5+1;
    return 0;
}
fn n6_test_b()void {
    let nb:[]u8=n6_alloc(4096);
    let s1:[]u8="The counter advances to 9.";
    let l1:i32=n6_norm(s1,s1.len,nb,0);
    n6_print("norm1=[");n6_print(n6_sub(nb,0,l1));n6_print("]\n");
    let ar:[]u8=n6_alloc(8192);
    let n1:i32=n6_words(nb,l1,0,ar,0);
    let s2:[]u8="the counter advances to 19";
    let l2:i32=n6_norm(s2,s2.len,nb,1024);
    let n2:i32=n6_words(n6_sub(nb,1024,l2),l2,1024,ar,2048);
    n6_print("t2 self=");n6_print(n6_i64s(n6_t2(nb,ar,0,n1,ar,0,n1) as i64));n6_print("\n");
    n6_print("t2 9vs19=");n6_print(n6_i64s(n6_t2(nb,ar,0,n1,ar,2048,n2) as i64));n6_print(" (want 0)\n");
    let s3:[]u8="The counters advance to 9";
    let l3:i32=n6_norm(s3,s3.len,nb,2048);
    let n3:i32=n6_words(n6_sub(nb,2048,l3),l3,2048,ar,4096);
    n6_print("t2 stem=");n6_print(n6_i64s(n6_t2(nb,ar,0,n1,ar,4096,n3) as i64));n6_print(" (want 1)\n");
    n6_print("stem(rings)=[");n6_print(n6_stem("rings"));n6_print("]\n");
    return;
}
// ---- chunk E: driver ----
fn n6_fnv_bytes(b:[]u8,ln:i32)i64 {
    let h:i64=1469598103934665603;
    let i:i32=0;
    while(i<ln){h=(h^(b[i] as i64))*1099511628211;i=i+1;}
    return h;
}
fn n6_hex(h:i64,out:[]u8)i32 {
    let i:i32=0;
    while(i<16){
        let v:i32=((h>>((15-i)*4))&15) as i32;
        let c:u8=0;
        if(v<10){c=(48+v) as u8;}else{c=(87+v) as u8;}
        out[i]=c;
        i=i+1;
    }
    return 16;
}
fn n6_atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48 && c<=57){v=v*10+(c as i32)-48;}
        i=i+1;
    }
    return v;
}
fn n6_iswh(w:[]u8)i32 {
    if(n6_eq(w,"what")==1){return 1;}
    if(n6_eq(w,"which")==1){return 1;}
    if(n6_eq(w,"who")==1){return 1;}
    if(n6_eq(w,"whom")==1){return 1;}
    if(n6_eq(w,"whose")==1){return 1;}
    if(n6_eq(w,"where")==1){return 1;}
    if(n6_eq(w,"when")==1){return 1;}
    if(n6_eq(w,"why")==1){return 1;}
    if(n6_eq(w,"how")==1){return 1;}
    return 0;
}
fn n6_run(pprob:[]u8,pstore:[]u8,ptrace:[]u8,bound:i32)i32 {
    // trust quarantine: sealed / injected paths refused
    if(n6_find(pprob,"sealed",0)>=0){n6_print("GUARD: sealed problem path\n");return 3;}
    if(n6_find(pstore,"sealed",0)>=0){n6_print("GUARD: sealed store path\n");return 3;}
    if(n6_find(pprob,"INJ",0)>=0){n6_print("GUARD: injected problem path\n");return 3;}
    if(n6_find(pstore,"INJ",0)>=0){n6_print("GUARD: injected store path\n");return 3;}
    let tx:[]u8=n6_alloc(4194304);
    let wa:[]u8=n6_alloc(4194304);
    let st:[]u8=n6_alloc(131072);
    let rt:[]u8=n6_alloc(2097152);
    let sc:[]u8=n6_alloc(65536);
    let tr:[]u8=n6_alloc(2097152);
    let me:[]u8=n6_alloc(1048576);
    let sk:[]u8=n6_alloc(8192);
    let dc:[]u8=n6_alloc(64);
    if(tx.len==0||wa.len==0||st.len==0||rt.len==0){return 64;}
    let bp:*i32=n6_cell();let wp:*i32=n6_cell();let spp:*i32=n6_cell();let gpp:*i32=n6_cell();let rpp:*i32=n6_cell();
    let tp:*i32=n6_cell();let mep:*i32=n6_cell();let stepc:*i32=n6_cell();
    let lsb:[]u8=n6_alloc(512);let lsp:*i32=n6_cell();
    let buf:[]u8=n6_alloc(1048576);
    let n:i64=n6_read_file(pprob,buf,1048576);
    if(n<0){return 64;}
    let np:i32=n6_parse_problem(buf,n as i32,tx,bp,wa,wp,st,spp,gpp);
    let gi:i32=gpp[0];
    if(gi<0){n6_print("no goal\n");return 4;}
    let n2:i64=n6_read_file(pstore,buf,1048576);
    if(n2<0){return 64;}
    n6_parse_store(buf,n2 as i32,tx,bp,wa,wp,st,spp);
    let nsent:i32=spp[0];
    n6_temit(tr,tp,"PROBLEM: ");n6_temit(tr,tp,pprob);n6_temit(tr,tp,"\n");
    n6_temit(tr,tp,"ENGINE: N6-GOALCHAIN-NATIVE\n");
    n6_temit(tr,tp,"GOAL: ");
    let gsb:i32=gi*32;
    n6_temit(tr,tp,n6_sub(tx,au_get32(st,gsb+8),au_get32(st,gsb+12)));
    n6_temit(tr,tp,"\n");
    // goal-shape guards
    let gtab:i32=au_get32(st,gsb+28);
    let gn:i32=au_get32(st,gsb+24);
    let gw0:[]u8=n6_wget(tx,wa,gtab,0);
    let ans:[]u8="WITHHELD";
    if(n6_eq(gw0,"if")==1||n6_eq(gw0,"whenever")==1){
        au_put32(dc,28,au_get32(dc,28)+1);
        n6_temit(tr,tp,"STEP 0: conditional goal; no conditional-proof license [DEATH CONDITIONAL-GOAL]\n");
    }else{
        if(n6_iswh(gw0)==1){
            au_put32(dc,32,au_get32(dc,32)+1);
            n6_temit(tr,tp,"STEP 0: open wh-goal; no answer exists [DEATH WH-OPEN]\n");
        }else{
            let nr:i32=n6_mint(tx,bp,wa,wp,st,nsent,gi,rt,rpp,sc,lsb,lsp);
            n6_temit(tr,tp,"RULES: ");n6_temit(tr,tp,n6_i64s(nr as i64));n6_temit(tr,tp,"\n");
            let ok:i32=n6_need(tx,wa,bp,wp,st,nsent,rt,nr,me,mep,sk,dc,tr,tp,gtab,gn,0,bound,stepc);
            if(ok==1){ans="DERIVED";}
        }
    }
    n6_temit(tr,tp,"ANSWER: ");n6_temit(tr,tp,ans);n6_temit(tr,tp,"\n");
    n6_temit(tr,tp,"DEATH-CENSUS:");
    let d:i32=0;
    while(d<12){
        n6_temit(tr,tp," ");n6_temit(tr,tp,n6_dname(d));n6_temit(tr,tp,"=");
        n6_temit(tr,tp,n6_i64s(au_get32(dc,d*4) as i64));
        d=d+1;
    }
    n6_temit(tr,tp,"\n");
    let th:i64=n6_fnv_bytes(tr,tp[0]);
    let hx:[]u8=n6_alloc(16);
    n6_hex(th,hx);
    n6_temit(tr,tp,"TRACE_HASH: ");n6_temit(tr,tp,hx);n6_temit(tr,tp,"\n");
    let wrc:i64=n6_write_file(ptrace,n6_sub(tr,0,tp[0]));
    if(wrc<0){return 64;}
    n6_print("ANSWER: ");n6_print(ans);n6_print(" steps=");n6_print(n6_i64s(stepc[0] as i64));
    n6_print(" hash=");n6_print(hx);n6_print("\n");
    return 0;
}
fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    if(a1.len==0||a2.len==0||a3.len==0){n6_print("usage: n6 <problem> <store> <trace-out> [bound]\n");return 4;}
    let bound:i32=8;
    if(a4.len>0){bound=n6_atoi(a4);}
    if(bound<1){bound=1;}
    if(bound>160){bound=160;}
    return n6_run(a1,a2,a3,bound);
}

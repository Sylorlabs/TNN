// hyb.zag — HYB ENGINE (Math R2 engine (a)): contradiction-tolerant
// weighing over ONE's match-and-bind derivation core.
//
// Architecture: ONE's deterministic BFS match-and-bind derivation runs
// VERBATIM (same claims, same order, same audit text). As it derives, an
// integrated ledger records every derivation step's inference licenses
// (committed schema hashes + rule-premise hashes). After derivation, the
// referee weighs each contradictory pair H / not(H):
//   - evidence = derivation paths scored by premise quality (learned
//     license trust), depth, corroboration (premise-disjoint paths), and
//     premise-disjoint independence;
//   - strictly better side wins; the loser is marked REFUTED-BY-WEIGHING
//     (kept visible in the audit trail); ties withhold only that claim.
// Trust starts uniform and is LEARNED from lost weighings (licenses
// distinctive of the losing side lose trust); nothing is hardcoded.
// Usage: hyb_bin <problem.form> <out_path>   (run with CWD = math_logic dir)
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("vendor/R33_NATIVE_IO_V1.zag")
@import("vendor/dlb_util.zag")
@import("common/cx_str.zag")
@import("common/cx_claim.zag")
@import("common/cx_match.zag")
@import("common/cx_store.zag")
@import("common/cx_ev.zag")
@import("common/cx_schemas.zag")
@import("common/cx_io.zag")

@import("common/cx_fwd.zag")
@import("common/cx_hyb.zag")

fn hyb_hex(o:*DOut,h:i64)void {
    let d:[]u8="0123456789abcdef";
    let i:i32=15;
    while(i>=0){
        let ny:i32=((h>>((i as i64)*4)) & 15) as i32;
        let ch:[]u8=d[ny..ny+1];
        dout_str(o,ch);
        i=i-1;
    }
    return;
}
fn hyb_emit(o:*DOut,pid:[]u8,verdict:[]u8,claim:[]u8,conf:i32,deriv:i32,flags:[]u8,s:*CXS,hy:*HYBL,m:*HYBM,sp:*DOut)void {
    dout_str(o,"ID: ");dout_str(o,pid);dout_line(o);
    dout_str(o,"ENGINE: hyb");dout_line(o);
    dout_str(o,"VERDICT: ");dout_str(o,verdict);dout_line(o);
    dout_str(o,"CLAIM: ");dout_str(o,claim);dout_line(o);
    dout_str(o,"CONFIDENCE: ");dout_i64(o,conf as i64);dout_line(o);
    dout_str(o,"DERIVATIONS: ");dout_i64(o,deriv as i64);dout_line(o);
    dout_str(o,"SCHEMAS: S_MP=");dout_str(o,cx_sch_hex(0));
    dout_str(o," S_PBC=");dout_str(o,cx_sch_hex(1));
    dout_str(o," S_UI=");dout_str(o,cx_sch_hex(2));dout_line(o);
    dout_str(o,"FLAGS: ");dout_str(o,flags);dout_line(o);
    // TRUST: learned license-trust ledger, sorted by hash ascending
    dout_str(o,"TRUST:");dout_line(o);
    let tn:i32=hy.*.tn;
    let idx:[]u8=nio_alloc(2048*4);
    let nn:i32=0;
    if(idx.len==8192 && tn>0){
        let a:i32=0;
        while(a<tn && nn<2048){
            let ha:i64=au_get64(hy.*.th,a);
            let j:i32=nn;
            while(j>0){
                let hb:i64=au_get64(hy.*.th,au_get32(idx,j-1));
                if(hb<=ha){break;}
                au_put32(idx,j,au_get32(idx,j-1));
                j=j-1;
            }
            au_put32(idx,j,a);
            nn=nn+1;
            a=a+1;
        }
        let b:i32=0;
        while(b<nn){
            let ii:i32=au_get32(idx,b);
            dout_str(o,"  ");
            hyb_hex(o,au_get64(hy.*.th,ii));
            dout_str(o,"=");
            dout_i64(o,au_get32(hy.*.tt,ii) as i64);
            dout_line(o);
            b=b+1;
        }
    }
    nio_free(idx);
    dout_str(o,"AUDIT:");dout_line(o);
    let i:i32=0;
    while(i<s.*.n){
        dout_str(o,"C");dout_i64(o,i as i64);
        dout_str(o,": ");dout_str(o,cxs_bytes(s,i));
        dout_str(o," [");dout_str(o,cxs_audit(s,i));dout_str(o,"]");
        if(hyb_marked(m,i)==1){dout_str(o," REFUTED-BY-WEIGHING");}
        dout_line(o);
        i=i+1;
    }
    if(hy.*.wln>0){
        dout_str(o,"WEIGHINGS:");dout_line(o);
        let w:i32=0;
        while(w<hy.*.wln){
            dout_str(o,"W");dout_i64(o,w as i64);
            dout_str(o,": C");dout_i64(o,au_get32(hy.*.wl,w*6+0) as i64);
            dout_str(o," vs C");dout_i64(o,au_get32(hy.*.wl,w*6+1) as i64);
            dout_str(o," : ");dout_i64(o,au_get32(hy.*.wl,w*6+2) as i64);
            dout_str(o," vs ");dout_i64(o,au_get32(hy.*.wl,w*6+3) as i64);
            dout_str(o," -> ");
            let wn:i32=au_get32(hy.*.wl,w*6+4);
            if(wn==1){dout_str(o,"A");}
            if(wn==2){dout_str(o,"B");}
            if(wn==0){dout_str(o,"TIE");}
            if(au_get32(hy.*.wl,w*6+5)==1){dout_str(o," FINAL");}
            dout_line(o);
            w=w+1;
        }
    }
    if(sp.*.n>0){
        dout_str(o,"SUBPROOFS:");dout_line(o);
        dout_str(o,dout_bytes(sp));
    }
    return;
}

// one full run into o. Returns 0 ok, 3 sealed, 4 input, 6 schema.
fn hyb_run(o:*DOut,fbuf:[]u8,flen:i32,sbuf:[]u8,sn:i32,bound:i32)i32 {
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen,&f,512)!=0){return 4;}
    let k:CXK=CXK{.kid_off:"",.kid_len:"",.kcl_off:"",.kcl_len:"",.nk:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_store(sbuf,sn,&k,512)!=0){return -4;}
    if(cx_sch_assert()!=0){return 6;}
    let p:ONEP=ONEP{.a_mp1:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp1:0,.a_mp2:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp2:0,.a_pb:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_pb:0,.a_ui:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_ui:0,.hmp:0,.hpbc:0,.hui:0};
    if(onep_init(&p)!=0){return 4;}
    let s:CXS=CXS{.n:0,.cap:0,.data:"",.dn:0,.dcap:0,.coff:"",.clen:"",.aoff:"",.alen:"",.dep:"",.kind:"",.deriv:0};
    if(cxs_init(&s,4096,2097152)!=0){return 4;}
    let e:CXRE=CXRE{.ev:"",.evh:"",.evn:0,.evcap:0,.cxo:"",.cxn:0,.cxcap:0};
    let q:CXRS=CXRS{.sp:"",.spn:0,.spcap:0,.lf:"",.lfn:0,.lfcap:0,.sl:"",.sln:0,.slcap:0};
    if(cxr_init(&e,&q)!=0){return 4;}
    // load store claims as premises (no inference license: no event)
    let i:i32=0;
    while(i<k.nk){
        let kb:[]u8=cx_kclaim(&k,i);
        let cb:[]u8=cx_canon(kb);
        if(cb.len>0){
            let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ao,128)==0){
                dout_str(&ao,"PREM ");dout_str(&ao,cx_kid(&k,i));
                let ab:[]u8=cx_copy(dout_bytes(&ao));
                dout_free(&ao);
                cxr_add(&e,&s,cb,ab,0,0,0,0,-1,-1,0);
                nio_free(cb);nio_free(ab);
            }
        }
        i=i+1;
    }
    // load problem premises
    i=0;
    while(i<f.nprem){
        let pb:[]u8=cx_prem(&f,i);
        let cb:[]u8=cx_canon(pb);
        if(cb.len==0){return 4;}
        let ab:[]u8=cx_copy("PREM");
        cxr_add(&e,&s,cb,ab,0,0,0,0,-1,-1,0);
        nio_free(cb);nio_free(ab);
        i=i+1;
    }
    let t:[]u8=cx_canon(f.target);
    if(t.len==0){return 4;}
    let nt:[]u8=cx_concat("not(",t);
    let nt2:[]u8=cx_concat(nt,")");
    nio_free(nt);
    let sp:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sp,8192)!=0){return 4;}
    // D_T: derive target (forward, then PBC subproof)
    let dT:i32=one_bfs(&s,&e,&p,bound,0,t,1);
    if(dT==0){
        let pr:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&pr,8192)==0){
            let r:i32=hyb_pbc_for(&s,&e,&q,&p,t,bound,&pr,"S_PBC ASSUME:not(T) FALSE_DERIVED");
            if(r==1){
                dout_str(&sp,"SP for target: ");
                dout_str(&sp,dout_bytes(&pr));
                dT=1;
            }
            dout_free(&pr);
        }
    }
    // D_N: derive not(target) (forward, then PBC subproof)
    let dN:i32=one_bfs(&s,&e,&p,bound,0,nt2,1);
    if(dN==0){
        let pr:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&pr,8192)==0){
            let r:i32=hyb_pbc_for(&s,&e,&q,&p,nt2,bound,&pr,"S_PBC ASSUME:not(not(T)) FALSE_DERIVED");
            if(r==1){
                dout_str(&sp,"SP for not(target): ");
                dout_str(&sp,dout_bytes(&pr));
                dN=1;
            }
            dout_free(&pr);
        }
    }
    // ---- contradiction-tolerant referee (integrated; no separate engine)
    let hy:HYBL=HYBL{.th:"",.tt:"",.tn:0,.tcap:0,.wl:"",.wln:0,.wlcap:0,.sat:0};
    if(hyb_init(&hy)!=0){return 4;}
    let m:HYBM=HYBM{.mk:"",.pm:"",.pmn:0,.ph:"",.phn:0,.phcap:0};
    if(hyb_memo_init(&m,s.n)!=0){return 4;}
    let ti:i32=cxs_find(&s,t);
    let nti:i32=cxs_find(&s,nt2);
    if(ti>=0){dT=1;}
    if(nti>=0){dN=1;}
    // intermediate pairs first (final target pair weighed by the caller)
    hyb_weigh_pairs(&hy,&m,&s,&e,&q,ti,nti);
    let verdict:[]u8="WITHHELD";let claim:[]u8="-";let conf:i32=0;
    let flags:[]u8="NONE";
    if(dT==1 && dN==0){verdict="DERIVED";claim=t;conf=1;}
    if(dN==1 && dT==0){verdict="REFUTED";claim=nt2;conf=1;}
    if(dT==1 && dN==1){
        flags="CONTRADICTION_WEIGHED";
        let w:i32=hyb_weigh(&hy,&m,&s,&e,&q,ti,nti,1);
        if(w==1){verdict="DERIVED-WEIGHED";claim=t;conf=1;}
        if(w==2){verdict="REFUTED-WEIGHED";claim=nt2;conf=1;}
        if(w==0){verdict="WITHHELD";claim="";conf=0;}
    }
    if(dT==0 && dN==0){verdict="WITHHELD";claim="";conf=0;}
    hyb_emit(o,f.id,verdict,claim,conf,s.deriv,flags,&s,&hy,&m,&sp);
    nio_free(nt2);nio_free(t);
    return 0;
}

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: hyb_bin <problem.form> <out_path>  (CWD must be the math_logic dir)");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len==0){return 4;}
    let flen:i64=cx_guarded_read(fpath,fbuf);
    if(flen==-99){_zag_println("hyb: sealed guard tripped on problem file");return 3;}
    if(flen<=0){_zag_println("hyb: cannot read problem file");return 4;}
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen as i32,&f,512)!=0){_zag_println("hyb: bad .form");return 4;}
    let sbuf:[]u8=nio_alloc(1048576);
    if(sbuf.len==0){return 4;}
    let sn:i64=cx_guarded_read(f.store,sbuf);
    if(sn==-99){_zag_println("hyb: sealed guard tripped on store file");return 3;}
    if(sn<=0){_zag_println("hyb: cannot read store file");return 4;}
    let t1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t3:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&t1,1048576)!=0 || dout_init(&t2,1048576)!=0 || dout_init(&t3,1048576)!=0){return 4;}
    let r1:i32=hyb_run(&t1,fbuf,flen as i32,sbuf,sn as i32,8);
    let r2:i32=hyb_run(&t2,fbuf,flen as i32,sbuf,sn as i32,8);
    let r3:i32=hyb_run(&t3,fbuf,flen as i32,sbuf,sn as i32,8);
    let div:i32=0;
    if(r1!=0 || r2!=0 || r3!=0){div=2;}
    if(div==0 && nio_equal(dout_bytes(&t1),dout_bytes(&t2))==0){div=1;}
    if(div==0 && nio_equal(dout_bytes(&t2),dout_bytes(&t3))==0){div=1;}
    if(div!=0){
        _zag_println("hyb: DIVERGENCE across 3x reruns");
        if(div==1){return 5;}
        return 4;
    }
    let wrc:i64=dlb_write_file(opath,dout_bytes(&t1),t1.n);
    if(wrc<0){return 4;}
    return 0;
}

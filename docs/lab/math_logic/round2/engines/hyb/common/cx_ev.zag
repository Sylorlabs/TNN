// cx_ev.zag — HYB derivation-event ledger, contradiction records, and PBC
// subproof snapshots. ADDITIVE over cx_store.zag (cxs_* stay verbatim):
// every derivation step is recorded as an event so the contradiction-
// tolerant referee can weigh evidence WITHOUT changing what the
// match-and-bind core derives. The derivation core's claim set, order,
// and audit text are byte-identical to ONE's.
// Pure Zag, zero RNG, deterministic.
//
// License model (frozen, see SCHEMA_TRUST.md): every derivation step uses
// inference licenses = the committed schemas (S_MP/S_PBC/S_UI, keyed by
// their COMMIT_SCHEMAS.md hashes) or the structural CONTRA rule, plus at
// most one rule-premise license (the store claim consumed as a rule, keyed
// by FNV-1a-64 of its canonical bytes). Each derived claim's derivation
// carries the set of license hashes used; the referee's trust ledger
// learns distrust for licenses distinctive of lost weighings.

// Events (e.ev): 7xi32 {claim,pa,pb,depth,flags,aux,aux2}.
//   flags bit0 = subproof-local event, bit1 = synthetic PBC event
//     (pa=pb=-2, aux = snapshot first index in q.sp, aux2 = path count).
// e.evh: 2xu64 per event {sch_h, rule_h} (direct licenses of the step).
// Contra records (e.cxo): 3xi32 {f_idx, nf_idx, sub} — f is the positive
//   claim, nf the negated one; sub=1 inside a PBC subproof.
// Snapshot paths (q.sp): 6xi32 {nleaf,leafoff,depth,nlic,licoff,ord}.
//   q.lf: i32 premise-index leaf lists (sorted). q.sl: u64 license lists.

struct CXRE {
    ev:[]u8, evh:[]u8, evn:i32, evcap:i32,
    cxo:[]u8, cxn:i32, cxcap:i32
}
struct CXRS {
    sp:[]u8, spn:i32, spcap:i32,
    lf:[]u8, lfn:i32, lfcap:i32,
    sl:[]u8, sln:i32, slcap:i32
}

fn cxr_init(e:*CXRE,q:*CXRS)i32 {
    e.*.ev="";e.*.evh="";e.*.evn=0;e.*.evcap=0;
    e.*.cxo="";e.*.cxn=0;e.*.cxcap=0;
    q.*.sp="";q.*.spn=0;q.*.spcap=0;
    q.*.lf="";q.*.lfn=0;q.*.lfcap=0;
    q.*.sl="";q.*.sln=0;q.*.slcap=0;
    if(cxr_grow_ev(e,4096)!=0){return -1;}
    if(cxr_grow_cx(e,256)!=0){return -1;}
    if(cxr_grow_sp(q,256)!=0){return -1;}
    if(cxr_grow_lf(q,4096)!=0){return -1;}
    if(cxr_grow_sl(q,1024)!=0){return -1;}
    return 0;
}
fn cxr_grow_ev(e:*CXRE,need:i32)i32 {
    let nc:i32=e.*.evcap;
    if(nc==0){nc=4096;}
    while(nc<need){
        nc=nc*2;
        if(nc*28>33554432){return -1;}
    }
    if(nc==e.*.evcap){return 0;}
    let nb:[]u8=nio_alloc(nc*28);
    if(nb.len!=nc*28){return -1;}
    let nh:[]u8=nio_alloc(nc*16);
    if(nh.len!=nc*16){nio_free(nb);return -1;}
    let i:i32=0;
    while(i<e.*.evn){
        let k:i32=0;
        while(k<7){au_put32(nb,i*7+k,au_get32(e.*.ev,i*7+k));k=k+1;}
        au_put64(nh,i*2+0,au_get64(e.*.evh,i*2+0));
        au_put64(nh,i*2+1,au_get64(e.*.evh,i*2+1));
        i=i+1;
    }
    nio_free(e.*.ev);nio_free(e.*.evh);
    e.*.ev=nb;e.*.evh=nh;e.*.evcap=nc;
    return 0;
}
fn cxr_grow_cx(e:*CXRE,need:i32)i32 {
    let nc:i32=e.*.cxcap;
    if(nc==0){nc=256;}
    while(nc<need){
        nc=nc*2;
        if(nc*12>33554432){return -1;}
    }
    if(nc==e.*.cxcap){return 0;}
    let nb:[]u8=nio_alloc(nc*12);
    if(nb.len!=nc*12){return -1;}
    let i:i32=0;
    while(i<e.*.cxn){
        au_put32(nb,i*3+0,au_get32(e.*.cxo,i*3+0));
        au_put32(nb,i*3+1,au_get32(e.*.cxo,i*3+1));
        au_put32(nb,i*3+2,au_get32(e.*.cxo,i*3+2));
        i=i+1;
    }
    nio_free(e.*.cxo);e.*.cxo=nb;e.*.cxcap=nc;
    return 0;
}
fn cxr_grow_sp(q:*CXRS,need:i32)i32 {
    let nc:i32=q.*.spcap;
    if(nc==0){nc=256;}
    while(nc<need){
        nc=nc*2;
        if(nc*24>33554432){return -1;}
    }
    if(nc==q.*.spcap){return 0;}
    let nb:[]u8=nio_alloc(nc*24);
    if(nb.len!=nc*24){return -1;}
    let i:i32=0;
    while(i<q.*.spn){
        let k:i32=0;
        while(k<6){au_put32(nb,i*6+k,au_get32(q.*.sp,i*6+k));k=k+1;}
        i=i+1;
    }
    nio_free(q.*.sp);q.*.sp=nb;q.*.spcap=nc;
    return 0;
}
fn cxr_grow_lf(q:*CXRS,need:i32)i32 {
    let nc:i32=q.*.lfcap;
    if(nc==0){nc=4096;}
    while(nc<need){
        nc=nc*2;
        if(nc*4>33554432){return -1;}
    }
    if(nc==q.*.lfcap){return 0;}
    let nb:[]u8=nio_alloc(nc*4);
    if(nb.len!=nc*4){return -1;}
    let i:i32=0;
    while(i<q.*.lfn){au_put32(nb,i,au_get32(q.*.lf,i));i=i+1;}
    nio_free(q.*.lf);q.*.lf=nb;q.*.lfcap=nc;
    return 0;
}
fn cxr_grow_sl(q:*CXRS,need:i32)i32 {
    let nc:i32=q.*.slcap;
    if(nc==0){nc=1024;}
    while(nc<need){
        nc=nc*2;
        if(nc*8>33554432){return -1;}
    }
    if(nc==q.*.slcap){return 0;}
    let nb:[]u8=nio_alloc(nc*8);
    if(nb.len!=nc*8){return -1;}
    let i:i32=0;
    while(i<q.*.sln){au_put64(nb,i,au_get64(q.*.sl,i));i=i+1;}
    nio_free(q.*.sl);q.*.sl=nb;q.*.slcap=nc;
    return 0;
}
// sorted u64 insert with dedup into a[0..n); cap 40 (drop largest). returns n.
fn cxr_slu_insert(a:[]u8,n:i32,h:i64)i32 {
    let i:i32=0;
    while(i<n){
        let v:i64=au_get64(a,i);
        if(v==h){return n;}
        if(v>h){break;}
        i=i+1;
    }
    if(n>=40){
        if(i>=40){return n;}
        let j:i32=39;
        while(j>i){au_put64(a,j,au_get64(a,j-1));j=j-1;}
        au_put64(a,i,h);
        return 40;
    }
    let j2:i32=n;
    while(j2>i){au_put64(a,j2,au_get64(a,j2-1));j2=j2-1;}
    au_put64(a,i,h);
    return n+1;
}
// sorted i32 insert with dedup into a[0..n); cap 256 (drop largest). returns n.
fn cxr_sli_insert(a:[]u8,n:i32,v:i32)i32 {
    let i:i32=0;
    while(i<n){
        let w:i32=au_get32(a,i);
        if(w==v){return n;}
        if(w>v){break;}
        i=i+1;
    }
    if(n>=256){
        if(i>=256){return n;}
        let j:i32=255;
        while(j>i){au_put32(a,j,au_get32(a,j-1));j=j-1;}
        au_put32(a,i,v);
        return 256;
    }
    let j2:i32=n;
    while(j2>i){au_put32(a,j2,au_get32(a,j2-1));j2=j2-1;}
    au_put32(a,i,v);
    return n+1;
}
fn cxr_log(e:*CXRE,claim:i32,pa:i32,pb:i32,depth:i32,flags:i32,sch_h:i64,rule_h:i64,aux:i32,aux2:i32)i32 {
    if(e.*.evn>=e.*.evcap){
        if(cxr_grow_ev(e,e.*.evn+1)!=0){return -1;}
    }
    let i:i32=e.*.evn;e.*.evn=i+1;
    au_put32(e.*.ev,i*7+0,claim);
    au_put32(e.*.ev,i*7+1,pa);
    au_put32(e.*.ev,i*7+2,pb);
    au_put32(e.*.ev,i*7+3,depth);
    au_put32(e.*.ev,i*7+4,flags);
    au_put32(e.*.ev,i*7+5,aux);
    au_put32(e.*.ev,i*7+6,aux2);
    au_put64(e.*.evh,i*2+0,sch_h);
    au_put64(e.*.evh,i*2+1,rule_h);
    return 0;
}
fn cxr_contra(e:*CXRE,f:i32,nf:i32,sub:i32)i32 {
    if(e.*.cxn>=e.*.cxcap){
        if(cxr_grow_cx(e,e.*.cxn+1)!=0){return -1;}
    }
    let i:i32=e.*.cxn;e.*.cxn=i+1;
    au_put32(e.*.cxo,i*3+0,f);
    au_put32(e.*.cxo,i*3+1,nf);
    au_put32(e.*.cxo,i*3+2,sub);
    return 0;
}
// Add a claim exactly as cxs_add would (verbatim derivation semantics),
// and record the derivation event + any contradiction occurrence.
// sch_h=0 means "no inference license" (premise/assumption: no event).
// Returns claim idx, or negative on error.
fn cxr_add(e:*CXRE,s:*CXS,bytes:[]u8,audit:[]u8,depth:i32,kind:i32,sub:i32,sch_h:i64,pa:i32,pb:i32,rule_h:i64)i32 {
    let pre:i32=cxs_find(s,bytes);
    let idx:i32=cxs_add(s,bytes,audit,depth,kind);
    if(idx<0){return idx;}
    if(kind==1 && sch_h!=0){
        if(cxr_log(e,idx,pa,pb,depth,sub,sch_h,rule_h,0,0)!=0){return -2;}
    }
    if(pre<0){
        // newly added: mirror cxs_add's structural contradiction condition
        if(cx_starts(bytes,"not(")==1 && bytes[bytes.len-1]==41){
            let inner:[]u8=bytes[4..bytes.len-1];
            let fi:i32=cxs_find(s,inner);
            if(fi>=0){cxr_contra(e,fi,idx,sub);}
        } else {
            let nb:[]u8=cx_concat("not(",bytes);
            let nb2:[]u8=cx_concat(nb,")");
            nio_free(nb);
            let fi2:i32=cxs_find(s,nb2);
            nio_free(nb2);
            if(fi2>=0){cxr_contra(e,idx,fi2,sub);}
        }
    }
    return idx;
}

// ---------- PBC subproof snapshot ----------
// Enumerate derivation paths of claim c restricted to the subproof
// [n0, s.n): indices < n0 are outer premises (leaves), the assumption
// claim is excluded. Each committed path: depth+1 (the PBC step),
// licenses acc ∪ {hpbc}. No memo (subproofs are small); depth cap 40.
// sf = snapshot-first index (path-count cap 64 per snapshot).
fn cxr_snap_enum(e:*CXRE,q:*CXRS,s:*CXS,c:i32,n0:i32,assume:i32,dep:i32,acc:[]u8,acn:i32,lic:[]u8,licn:i32,hpbc:i64,hcontra:i64,sf:i32,ord:*i32)void {
    if(dep>40 || c<-1){return;}
    if(q.*.spn-sf>=64){return;}
    if(c<0 || c==assume){
        // -1 = identity (single-premise steps); the discharged assumption
        // is likewise not an independent premise — it contributes no leaf
        cxr_snap_commit(q,acc,acn,lic,licn,dep,hpbc,ord);
        return;
    }
    if(c<n0){
        let n2:i32=cxr_sli_insert(acc,acn,c);
        cxr_snap_commit(q,acc,n2,lic,licn,dep,hpbc,ord);
        return;
    }
    // subproof derivation events for c
    let ei:i32=0;
    while(ei<e.*.evn){
        if(au_get32(e.*.ev,ei*7+0)==c && (au_get32(e.*.ev,ei*7+4)&3)==1){
            let pa:i32=au_get32(e.*.ev,ei*7+1);
            let pb:i32=au_get32(e.*.ev,ei*7+2);
            let sh:i64=au_get64(e.*.evh,ei*2+0);
            let rh:i64=au_get64(e.*.evh,ei*2+1);
            cxr_snap_step(e,q,s,pa,pb,n0,assume,dep+1,acc,acn,lic,licn,sh,rh,hpbc,hcontra,sf,ord);
            if(q.*.spn-sf>=64){return;}
        }
        ei=ei+1;
    }
    // contra-derived `false`: subproof contra records act as pseudo-events
    if(cx_starts(cxs_bytes(s,c),"false")==1 && cxs_bytes(s,c).len==5){
        let ci:i32=0;
        while(ci<e.*.cxn){
            if(au_get32(e.*.cxo,ci*3+2)==1){
                let f:i32=au_get32(e.*.cxo,ci*3+0);
                let nf:i32=au_get32(e.*.cxo,ci*3+1);
                if(f>=n0 || nf>=n0){
                    cxr_snap_step(e,q,s,f,nf,n0,assume,dep+1,acc,acn,lic,licn,hcontra,0,hpbc,hcontra,sf,ord);
                    if(q.*.spn-sf>=64){return;}
                }
            }
            ci=ci+1;
        }
    }
    return;
}
// expand one step {pa,pb} with direct licenses sh,rh: cross product of
// pa-paths x pb-paths via temp collection with cursor save/restore.
fn cxr_snap_step(e:*CXRE,q:*CXRS,s:*CXS,pa:i32,pb:i32,n0:i32,assume:i32,dep:i32,acc:[]u8,acn:i32,lic:[]u8,licn:i32,sh:i64,rh:i64,hpbc:i64,hcontra:i64,sf:i32,ord:*i32)void {
    let licn2:i32=licn;
    if(sh!=0){licn2=cxr_slu_insert(lic,licn2,sh);}
    if(rh!=0){licn2=cxr_slu_insert(lic,licn2,rh);}
    if(pa>=0 && pb>=0){
        let sp0:i32=q.*.spn;
        cxr_snap_enum(e,q,s,pa,n0,assume,dep,acc,acn,lic,licn2,hpbc,hcontra,sf,ord);
        let spn1:i32=q.*.spn;
        let k:i32=sp0;
        while(k<spn1){
            if(q.*.spn-sf>=64){break;}
            let kn:i32=au_get32(q.*.sp,k*6+0);
            let koff:i32=au_get32(q.*.sp,k*6+1);
            let kk:i32=0;
            let acn2:i32=acn;
            while(kk<kn){
                acn2=cxr_sli_insert(acc,acn2,au_get32(q.*.lf,koff+kk));
                kk=kk+1;
            }
            let qn:i32=au_get32(q.*.sp,k*6+3);
            let qoff:i32=au_get32(q.*.sp,k*6+4);
            let licn3:i32=licn2;
            let qk:i32=0;
            while(qk<qn){
                licn3=cxr_slu_insert(lic,licn3,au_get64(q.*.sl,qoff+qk));
                qk=qk+1;
            }
            cxr_snap_enum(e,q,s,pb,n0,assume,dep,acc,acn2,lic,licn3,hpbc,hcontra,sf,ord);
            k=k+1;
        }
        // compact: shift merged paths [spn1, q.spn) down over the temp
        // pa-paths [sp0, spn1); leaf/license offsets stay valid, temp
        // leaves/licenses are orphaned (harmless waste)
        let nm:i32=q.*.spn-spn1;
        let d:i32=0;
        while(d<nm){
            let f2:i32=0;
            while(f2<6){
                au_put32(q.*.sp,(sp0+d)*6+f2,au_get32(q.*.sp,(spn1+d)*6+f2));
                f2=f2+1;
            }
            d=d+1;
        }
        q.*.spn=sp0+nm;
        return;
    }
    if(pa>=0){
        cxr_snap_enum(e,q,s,pa,n0,assume,dep,acc,acn,lic,licn2,hpbc,hcontra,sf,ord);
        return;
    }
    if(pb>=0){
        cxr_snap_enum(e,q,s,pb,n0,assume,dep,acc,acn,lic,licn2,hpbc,hcontra,sf,ord);
        return;
    }
    cxr_snap_commit(q,acc,acn,lic,licn2,dep,hpbc,ord);
    return;
}
fn cxr_snap_commit(q:*CXRS,acc:[]u8,acn:i32,lic:[]u8,licn:i32,dep:i32,hpbc:i64,ord:*i32)void {
    if(cxr_grow_sp(q,q.*.spn+1)!=0){return;}
    if(cxr_grow_lf(q,q.*.lfn+acn)!=0){return;}
    let licn2:i32=licn;
    if(hpbc!=0){licn2=cxr_slu_insert(lic,licn2,hpbc);}
    if(cxr_grow_sl(q,q.*.sln+licn2)!=0){return;}
    let loff:i32=q.*.lfn;
    let i:i32=0;
    while(i<acn){au_put32(q.*.lf,loff+i,au_get32(acc,i));i=i+1;}
    q.*.lfn=loff+acn;
    let soff:i32=q.*.sln;
    i=0;
    while(i<licn2){au_put64(q.*.sl,soff+i,au_get64(lic,i));i=i+1;}
    q.*.sln=soff+licn2;
    let p:i32=q.*.spn;q.*.spn=p+1;
    au_put32(q.*.sp,p*6+0,acn);
    au_put32(q.*.sp,p*6+1,loff);
    au_put32(q.*.sp,p*6+2,dep+1);
    au_put32(q.*.sp,p*6+3,licn2);
    au_put32(q.*.sp,p*6+4,soff);
    au_put32(q.*.sp,p*6+5,ord.*);
    ord.*=ord.*+1;
    return;
}
// Snapshot the subproof's paths of `false` (claim fals, subproof [n0),
// assumption claim assume). Returns first snapshot-path index; *cnt = count.
fn cxr_snapshot(e:*CXRE,q:*CXRS,s:*CXS,fals:i32,n0:i32,assume:i32,hpbc:i64,cnt:*i32)i32 {
    let first:i32=q.*.spn;
    let acc:[]u8=nio_alloc(256*4);
    if(acc.len!=1024){cnt.*=0;return -1;}
    let lic:[]u8=nio_alloc(40*8);
    if(lic.len!=320){nio_free(acc);cnt.*=0;return -1;}
    let ord:i32=0;
    let hcontra:i64=cx_fnv1a("CONTRA");
    cxr_snap_enum(e,q,s,fals,n0,assume,0,acc,0,lic,0,hpbc,hcontra,first,&ord);
    nio_free(acc);nio_free(lic);
    cnt.*=q.*.spn-first;
    return first;
}

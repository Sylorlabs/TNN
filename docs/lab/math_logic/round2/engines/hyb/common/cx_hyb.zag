// cx_hyb.zag — HYB contradiction-tolerant referee. Integrated into the
// engine (no separate process, no D<->R boundary): it reads the derivation
// ledger (cx_ev.zag) that the match-and-bind core fills as it derives.
// Pure Zag, zero RNG, deterministic.
//
// Evidence model (frozen, see SCHEMA_TRUST.md):
//   * a derivation PATH of claim X = a set of premise leaves + a license
//     set + a depth, witnessed by the ledger's events.
//   * premise quality Q(path) = mean trust of its licenses (x1000 fixed;
//     1000 = neutral/uniform start).
//   * claim score = greedy sum over premise-disjoint paths, ordered by
//     (depth, premise-count): sum Q*1000/(1+depth). Rewards corroboration
//     (independent paths), penalizes depth, prices shared premises once.
//   * contradiction weighing: strictly better side wins; loser marked
//     REFUTED-BY-WEIGHING (kept visible); tie withholds only that claim.
//   * trust is LEARNED: licenses distinctive of a lost weighing lose
//     200/|diff| trust (x1000), distinctive of a won weighing gain
//     100/|diff|, clamped [0,2000]. Uniform 1000 start; nothing hardcoded.

struct HYBL {
    th:[]u8, tt:[]u8, tn:i32, tcap:i32,
    wl:[]u8, wln:i32, wlcap:i32,
    sat:i32
}
struct HYBM {
    mk:[]u8, pm:[]u8, pmn:i32,
    ph:[]u8, phn:i32, phcap:i32
}
fn hyb_init(hy:*HYBL)i32 {
    hy.*.th="";hy.*.tt="";hy.*.tn=0;hy.*.tcap=0;
    hy.*.wl="";hy.*.wln=0;hy.*.wlcap=0;hy.*.sat=0;
    if(hyb_tgrow(hy,2048)!=0){return -1;}
    if(hyb_wgrow(hy,1024)!=0){return -1;}
    return 0;
}
fn hyb_tgrow(hy:*HYBL,need:i32)i32 {
    let nc:i32=hy.*.tcap;
    if(nc==0){nc=2048;}
    while(nc<need){
        nc=nc*2;
        if(nc*12>33554432){return -1;}
    }
    if(nc==hy.*.tcap){return 0;}
    let nh:[]u8=nio_alloc(nc*8);
    if(nh.len!=nc*8){return -1;}
    let nt:[]u8=nio_alloc(nc*4);
    if(nt.len!=nc*4){nio_free(nh);return -1;}
    let i:i32=0;
    while(i<hy.*.tn){
        au_put64(nh,i,au_get64(hy.*.th,i));
        au_put32(nt,i,au_get32(hy.*.tt,i));
        i=i+1;
    }
    nio_free(hy.*.th);nio_free(hy.*.tt);
    hy.*.th=nh;hy.*.tt=nt;hy.*.tcap=nc;
    return 0;
}
fn hyb_wgrow(hy:*HYBL,need:i32)i32 {
    let nc:i32=hy.*.wlcap;
    if(nc==0){nc=1024;}
    while(nc<need){
        nc=nc*2;
        if(nc*24>33554432){return -1;}
    }
    if(nc==hy.*.wlcap){return 0;}
    let nb:[]u8=nio_alloc(nc*24);
    if(nb.len!=nc*24){return -1;}
    let i:i32=0;
    while(i<hy.*.wln){
        let k:i32=0;
        while(k<6){au_put32(nb,i*6+k,au_get32(hy.*.wl,i*6+k));k=k+1;}
        i=i+1;
    }
    nio_free(hy.*.wl);hy.*.wl=nb;hy.*.wlcap=nc;
    return 0;
}
fn hyb_memo_init(m:*HYBM,n:i32)i32 {
    m.*.mk="";m.*.pm="";m.*.pmn=0;
    m.*.ph="";m.*.phn=0;m.*.phcap=0;
    if(n<=0){return -1;}
    let mk:[]u8=nio_alloc(n);
    if(mk.len!=n){return -1;}
    let pm:[]u8=nio_alloc(n*12);
    if(pm.len!=n*12){nio_free(mk);return -1;}
    let i:i32=0;
    while(i<n){mk[i]=0;au_put32(pm,i*3+0,0);au_put32(pm,i*3+1,0);au_put32(pm,i*3+2,0);i=i+1;}
    m.*.mk=mk;m.*.pm=pm;m.*.pmn=n;
    if(hyb_phgrow(m,256)!=0){return -1;}
    return 0;
}
fn hyb_phgrow(m:*HYBM,need:i32)i32 {
    let nc:i32=m.*.phcap;
    if(nc==0){nc=256;}
    while(nc<need){
        nc=nc*2;
        if(nc*24>33554432){return -1;}
    }
    if(nc==m.*.phcap){return 0;}
    let nb:[]u8=nio_alloc(nc*24);
    if(nb.len!=nc*24){return -1;}
    let i:i32=0;
    while(i<m.*.phn){
        let k:i32=0;
        while(k<6){au_put32(nb,i*6+k,au_get32(m.*.ph,i*6+k));k=k+1;}
        i=i+1;
    }
    nio_free(m.*.ph);m.*.ph=nb;m.*.phcap=nc;
    return 0;
}
// trust ledger: get-or-create index for hash h (uniform 1000 start)
fn hyb_trust(hy:*HYBL,h:i64)i32 {
    let i:i32=0;
    while(i<hy.*.tn){
        if(au_get64(hy.*.th,i)==h){return i;}
        i=i+1;
    }
    if(hy.*.tn>=hy.*.tcap){
        if(hyb_tgrow(hy,hy.*.tn+1)!=0){return -1;}
    }
    let j:i32=hy.*.tn;hy.*.tn=j+1;
    au_put64(hy.*.th,j,h);
    au_put32(hy.*.tt,j,1000);
    return j;
}
fn hyb_tget(hy:*HYBL,h:i64)i32 {
    let i:i32=hyb_trust(hy,h);
    if(i<0){return 1000;}
    return au_get32(hy.*.tt,i);
}
fn hyb_tadd(hy:*HYBL,h:i64,d:i32)void {
    let i:i32=hyb_trust(hy,h);
    if(i<0){return;}
    let v:i32=au_get32(hy.*.tt,i)+d;
    if(v<0){v=0;}
    if(v>2000){v=2000;}
    au_put32(hy.*.tt,i,v);
    return;
}
// sorted u64 insert with dedup, cap `cap` (drop largest). returns n.
fn hyb_u64ins(a:[]u8,n:i32,h:i64,cap:i32)i32 {
    let i:i32=0;
    while(i<n){
        let v:i64=au_get64(a,i);
        if(v==h){return n;}
        if(v>h){break;}
        i=i+1;
    }
    if(n>=cap){
        if(i>=cap){return n;}
        let j:i32=cap-1;
        while(j>i){au_put64(a,j,au_get64(a,j-1));j=j-1;}
        au_put64(a,i,h);
        return cap;
    }
    let j2:i32=n;
    while(j2>i){au_put64(a,j2,au_get64(a,j2-1));j2=j2-1;}
    au_put64(a,i,h);
    return n+1;
}
// memoized derivation paths of claim x. Memo records in m.ph:
// 6xi32 {nleaf,leafoff,depth,nlic,licoff,ord}; leaves/licenses in q.lf/q.sl.
// Cycle guard: state 2 = on current stack -> contributes zero paths.
fn hyb_paths(m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,x:i32)void {
    if(x<0 || x>=m.*.pmn){return;}
    if(au_get32(m.*.pm,x*3+0)!=0){return;}
    au_put32(m.*.pm,x*3+0,2);
    // pass 1: ensure all premise memos FIRST, so that pass 2 appends only
    // x's own paths (contiguous memo range). Recursive appends happen here.
    let pi:i32=0;
    while(pi<e.*.evn){
        if(au_get32(e.*.ev,pi*7+0)==x && (au_get32(e.*.ev,pi*7+4)&1)==0){
            hyb_paths(m,s,e,q,au_get32(e.*.ev,pi*7+1));
            hyb_paths(m,s,e,q,au_get32(e.*.ev,pi*7+2));
        }
        pi=pi+1;
    }
    if(x<s.*.n && nio_equal(cxs_bytes(s,x),"false")==1){
        let ci0:i32=0;
        while(ci0<e.*.cxn){
            if(au_get32(e.*.cxo,ci0*3+2)==0){
                hyb_paths(m,s,e,q,au_get32(e.*.cxo,ci0*3+0));
                hyb_paths(m,s,e,q,au_get32(e.*.cxo,ci0*3+1));
            }
            ci0=ci0+1;
        }
    }
    // pass 2: expand x's own paths (premise memos guaranteed; the inline
    // hyb_paths calls below are no-ops)
    let first:i32=m.*.phn;
    let acc:[]u8=nio_alloc(256*4);
    let lic:[]u8=nio_alloc(40*8);
    if(acc.len==1024 && lic.len==320){
        let ord:i32=0;
        let nevt:i32=0;
        let ei:i32=0;
        while(ei<e.*.evn){
            if(m.*.phn-first>=64){break;}
            if(au_get32(e.*.ev,ei*7+0)==x && (au_get32(e.*.ev,ei*7+4)&1)==0){
                nevt=nevt+1;
                let fl:i32=au_get32(e.*.ev,ei*7+4);
                if((fl&2)==2){
                    hyb_expand_synth(m,q,e,ei,acc,0,lic,0,first,&ord);
                } else {
                    let pa:i32=au_get32(e.*.ev,ei*7+1);
                    let pb:i32=au_get32(e.*.ev,ei*7+2);
                    let sh:i64=au_get64(e.*.evh,ei*2+0);
                    let rh:i64=au_get64(e.*.evh,ei*2+1);
                    hyb_expand(m,s,e,q,pa,pb,acc,0,lic,0,sh,rh,first,&ord);
                }
            }
            ei=ei+1;
        }
        // contra records deriving `false` act as structural pseudo-events
        let xb:[]u8=cxs_bytes(s,x);
        if(xb.len==5 && cx_starts(xb,"false")==1){
            let hc:i64=cx_fnv1a("CONTRA");
            let ci:i32=0;
            while(ci<e.*.cxn){
                if(m.*.phn-first>=64){break;}
                if(au_get32(e.*.cxo,ci*3+2)==0){
                    nevt=nevt+1;
                    hyb_expand(m,s,e,q,au_get32(e.*.cxo,ci*3+0),au_get32(e.*.cxo,ci*3+1),acc,0,lic,0,hc,0,first,&ord);
                }
                ci=ci+1;
            }
        }
        if(nevt==0){
            // premise (or event-less claim): the trivial path whose single
            // independent leaf is the claim itself
            let acn0:i32=cxr_sli_insert(acc,0,x);
            hyb_commit(m,q,acc,acn0,lic,0,0,&ord);
        }
    }
    nio_free(acc);nio_free(lic);
    au_put32(m.*.pm,x*3+0,1);
    au_put32(m.*.pm,x*3+1,first);
    au_put32(m.*.pm,x*3+2,m.*.phn-first);
    return;
}
// expand one derivation step {pa,pb} with direct licenses sh,rh:
// flat cross product over memoized premise paths (identity depth -1 for
// unused premise slots).
fn hyb_expand(m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,pa:i32,pb:i32,acc:[]u8,acn:i32,lic:[]u8,licn:i32,sh:i64,rh:i64,first:i32,ord:*i32)void {
    let licn2:i32=licn;
    if(sh!=0){licn2=hyb_u64ins(lic,licn2,sh,40);}
    if(rh!=0){licn2=hyb_u64ins(lic,licn2,rh,40);}
    // premise memos are guaranteed by hyb_paths' pre-pass; no recursion here
    let na:i32=1;let nb:i32=1;
    if(pa>=0){na=hyb_pcount(m,pa);}
    if(pb>=0){nb=hyb_pcount(m,pb);}
    if(na==0 || nb==0){return;}
    let ia:i32=0;
    while(ia<na){
        let ib:i32=0;
        while(ib<nb){
            if(m.*.phn-first>=64){return;}
            let acn2:i32=acn;
            let da:i32=-1;
            if(pa>=0){
                let pi:i32=au_get32(m.*.pm,pa*3+1)+ia;
                da=au_get32(m.*.ph,pi*6+2);
                let kn:i32=au_get32(m.*.ph,pi*6+0);
                let koff:i32=au_get32(m.*.ph,pi*6+1);
                let kk:i32=0;
                while(kk<kn){
                    acn2=cxr_sli_insert(acc,acn2,au_get32(q.*.lf,koff+kk));
                    kk=kk+1;
                }
            }
            let db:i32=-1;
            if(pb>=0){
                let pj:i32=au_get32(m.*.pm,pb*3+1)+ib;
                db=au_get32(m.*.ph,pj*6+2);
                let kn2:i32=au_get32(m.*.ph,pj*6+0);
                let koff2:i32=au_get32(m.*.ph,pj*6+1);
                let kk2:i32=0;
                while(kk2<kn2){
                    acn2=cxr_sli_insert(acc,acn2,au_get32(q.*.lf,koff2+kk2));
                    kk2=kk2+1;
                }
            }
            let licn3:i32=licn2;
            if(pa>=0){
                let pi2:i32=au_get32(m.*.pm,pa*3+1)+ia;
                let qn:i32=au_get32(m.*.ph,pi2*6+3);
                let qoff:i32=au_get32(m.*.ph,pi2*6+4);
                let qk:i32=0;
                while(qk<qn){
                    licn3=hyb_u64ins(lic,licn3,au_get64(q.*.sl,qoff+qk),40);
                    qk=qk+1;
                }
            }
            if(pb>=0){
                let pj2:i32=au_get32(m.*.pm,pb*3+1)+ib;
                let qn2:i32=au_get32(m.*.ph,pj2*6+3);
                let qoff2:i32=au_get32(m.*.ph,pj2*6+4);
                let qk2:i32=0;
                while(qk2<qn2){
                    licn3=hyb_u64ins(lic,licn3,au_get64(q.*.sl,qoff2+qk2),40);
                    qk2=qk2+1;
                }
            }
            let dd:i32=da;if(db>dd){dd=db;}
            hyb_commit(m,q,acc,acn2,lic,licn3,dd+1,ord);
            ib=ib+1;
        }
        ia=ia+1;
    }
    return;
}
// expand a synthetic PBC event: each snapshot path becomes a derivation
// path (snapshot already carries depth+1 and the S_PBC license).
fn hyb_expand_synth(m:*HYBM,q:*CXRS,e:*CXRE,ei:i32,acc:[]u8,acn:i32,lic:[]u8,licn:i32,first:i32,ord:*i32)void {
    let sfirst:i32=au_get32(e.*.ev,ei*7+5);
    let scnt:i32=au_get32(e.*.ev,ei*7+6);
    let k:i32=0;
    while(k<scnt){
        if(m.*.phn-first>=64){return;}
        let pi:i32=sfirst+k;
        let acn2:i32=acn;
        let kn:i32=au_get32(q.*.sp,pi*6+0);
        let koff:i32=au_get32(q.*.sp,pi*6+1);
        let kk:i32=0;
        while(kk<kn){
            acn2=cxr_sli_insert(acc,acn2,au_get32(q.*.lf,koff+kk));
            kk=kk+1;
        }
        let licn2:i32=licn;
        let qn:i32=au_get32(q.*.sp,pi*6+3);
        let qoff:i32=au_get32(q.*.sp,pi*6+4);
        let qk:i32=0;
        while(qk<qn){
            licn2=hyb_u64ins(lic,licn2,au_get64(q.*.sl,qoff+qk),40);
            qk=qk+1;
        }
        let dd:i32=au_get32(q.*.sp,pi*6+2);
        hyb_commit(m,q,acc,acn2,lic,licn2,dd,ord);
        k=k+1;
    }
    return;
}
fn hyb_commit(m:*HYBM,q:*CXRS,acc:[]u8,acn:i32,lic:[]u8,licn:i32,dep:i32,ord:*i32)void {
    if(hyb_phgrow(m,m.*.phn+1)!=0){return;}
    if(cxr_grow_lf(q,q.*.lfn+acn)!=0){return;}
    if(cxr_grow_sl(q,q.*.sln+licn)!=0){return;}
    let loff:i32=q.*.lfn;
    let i:i32=0;
    while(i<acn){au_put32(q.*.lf,loff+i,au_get32(acc,i));i=i+1;}
    q.*.lfn=loff+acn;
    let soff:i32=q.*.sln;
    i=0;
    while(i<licn){au_put64(q.*.sl,soff+i,au_get64(lic,i));i=i+1;}
    q.*.sln=soff+licn;
    let p:i32=m.*.phn;m.*.phn=p+1;
    au_put32(m.*.ph,p*6+0,acn);
    au_put32(m.*.ph,p*6+1,loff);
    au_put32(m.*.ph,p*6+2,dep);
    au_put32(m.*.ph,p*6+3,licn);
    au_put32(m.*.ph,p*6+4,soff);
    au_put32(m.*.ph,p*6+5,ord.*);
    ord.*=ord.*+1;
    return;
}
fn hyb_pcount(m:*HYBM,x:i32)i32 {
    if(x<0 || x>=m.*.pmn){return 0;}
    if(au_get32(m.*.pm,x*3+0)!=1){return 0;}
    return au_get32(m.*.pm,x*3+2);
}
// premise quality of one path: mean license trust (x1000); 1000 if licenseless
fn hyb_qpath(hy:*HYBL,m:*HYBM,q:*CXRS,pi:i32)i64 {
    let nlic:i32=au_get32(m.*.ph,pi*6+3);
    if(nlic<=0){return 1000;}
    let off:i32=au_get32(m.*.ph,pi*6+4);
    let sum:i64=0;
    let i:i32=0;
    while(i<nlic){
        sum=sum+(hyb_tget(hy,au_get64(q.*.sl,off+i)) as i64);
        i=i+1;
    }
    return sum/(nlic as i64);
}
// claim score: greedy over premise-disjoint paths ordered by
// (depth, premise-count, ord): sum Q*1000/(1+depth)
fn hyb_score(hy:*HYBL,m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,x:i32)i64 {
    hyb_paths(m,s,e,q,x);
    if(x<0 || x>=m.*.pmn){return 0;}
    if(au_get32(m.*.pm,x*3+0)!=1){return 0;}
    let first:i32=au_get32(m.*.pm,x*3+1);
    let cnt:i32=au_get32(m.*.pm,x*3+2);
    if(cnt<=0){return 0;}
    // insertion order over path indices by (depth, nleaf, ord)
    let idx:[]u8=nio_alloc(64*4);
    if(idx.len!=256){return 0;}
    let nidx:i32=0;
    let k:i32=0;
    while(k<cnt && nidx<64){
        let pi:i32=first+k;
        let kd:i32=au_get32(m.*.ph,pi*6+2);
        let kl:i32=au_get32(m.*.ph,pi*6+0);
        let ko:i32=au_get32(m.*.ph,pi*6+5);
        let j:i32=nidx;
        while(j>0){
            let qj:i32=au_get32(idx,j-1);
            let jd:i32=au_get32(m.*.ph,qj*6+2);
            let jl:i32=au_get32(m.*.ph,qj*6+0);
            let jo:i32=au_get32(m.*.ph,qj*6+5);
            let less:i32=0;
            if(kd<jd){less=1;}
            if(kd==jd && kl<jl){less=1;}
            if(kd==jd && kl==jl && ko<jo){less=1;}
            if(less==0){break;}
            au_put32(idx,j,au_get32(idx,j-1));
            j=j-1;
        }
        au_put32(idx,j,pi);
        nidx=nidx+1;
        k=k+1;
    }
    let kept:[]u8=nio_alloc(256*4);
    if(kept.len!=1024){nio_free(idx);return 0;}
    let keptn:i32=0;
    let score:i64=0;
    let t:i32=0;
    while(t<nidx){
        let pi2:i32=au_get32(idx,t);
        let kn2:i32=au_get32(m.*.ph,pi2*6+0);
        let koff2:i32=au_get32(m.*.ph,pi2*6+1);
        let disj:i32=1;
        let a2:i32=0;
        while(a2<kn2){
            let lv:i32=au_get32(q.*.lf,koff2+a2);
            let b2:i32=0;
            while(b2<keptn){
                if(au_get32(kept,b2)==lv){disj=0;break;}
                b2=b2+1;
            }
            if(disj==0){break;}
            a2=a2+1;
        }
        if(disj==1){
            let qq:i64=hyb_qpath(hy,m,q,pi2);
            let dd2:i32=au_get32(m.*.ph,pi2*6+2);
            score=score+qq*1000/((dd2+1) as i64);
            a2=0;
            while(a2<kn2){
                keptn=cxr_sli_insert(kept,keptn,au_get32(q.*.lf,koff2+a2));
                a2=a2+1;
            }
        }
        t=t+1;
    }
    nio_free(idx);nio_free(kept);
    return score;
}
// union of license hashes over all paths of claim x (sorted, cap 64)
fn hyb_lic_union(hy:*HYBL,m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,x:i32,out:[]u8)i32 {
    hyb_paths(m,s,e,q,x);
    let n:i32=0;
    if(x<0 || x>=m.*.pmn){return 0;}
    if(au_get32(m.*.pm,x*3+0)!=1){return 0;}
    let first:i32=au_get32(m.*.pm,x*3+1);
    let cnt:i32=au_get32(m.*.pm,x*3+2);
    let k:i32=0;
    while(k<cnt){
        let pi:i32=first+k;
        let qn:i32=au_get32(m.*.ph,pi*6+3);
        let qoff:i32=au_get32(m.*.ph,pi*6+4);
        let j:i32=0;
        while(j<qn){
            n=hyb_u64ins(out,n,au_get64(q.*.sl,qoff+j),64);
            j=j+1;
        }
        k=k+1;
    }
    return n;
}
fn hyb_wlog(hy:*HYBL,a:i32,b:i32,sa:i64,sb:i64,winner:i32,final:i32)void {
    if(hy.*.wln>=hy.*.wlcap){
        if(hyb_wgrow(hy,hy.*.wln+1)!=0){return;}
    }
    let i:i32=hy.*.wln;hy.*.wln=i+1;
    let ca:i32=1073741823;let cb:i32=1073741823;
    if(sa<1073741823){ca=sa as i32;}
    if(sb<1073741823){cb=sb as i32;}
    au_put32(hy.*.wl,i*6+0,a);
    au_put32(hy.*.wl,i*6+1,b);
    au_put32(hy.*.wl,i*6+2,ca);
    au_put32(hy.*.wl,i*6+3,cb);
    au_put32(hy.*.wl,i*6+4,winner);
    au_put32(hy.*.wl,i*6+5,final);
    return;
}
fn hyb_mark(m:*HYBM,x:i32)void {
    if(x>=0 && x<m.*.pmn){m.*.mk[x]=1;}
    return;
}
fn hyb_marked(m:*HYBM,x:i32)i32 {
    if(x>=0 && x<m.*.pmn && m.*.mk[x]==1){return 1;}
    return 0;
}
// weigh contradictory pair (a,b): 1 = A wins, 2 = B wins, 0 = tie.
// strict win -> contrastive trust update + loser marked; tie -> nothing.
fn hyb_weigh(hy:*HYBL,m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,a:i32,b:i32,final:i32)i32 {
    let sa:i64=hyb_score(hy,m,s,e,q,a);
    let sb:i64=hyb_score(hy,m,s,e,q,b);
    let la:[]u8=nio_alloc(64*8);
    let lb:[]u8=nio_alloc(64*8);
    let winner:i32=0;
    if(la.len==512 && lb.len==512){
        let na:i32=hyb_lic_union(hy,m,s,e,q,a,la);
        let nb:i32=hyb_lic_union(hy,m,s,e,q,b,lb);
        if(sa>sb){winner=1;}
        if(sb>sa){winner=2;}
        if(winner!=0){
            let wa:[]u8=la;let wb:[]u8=lb;
            let nw:i32=na;let nl:i32=nb;
            if(winner==2){wa=lb;wb=la;nw=nb;nl=na;}
            // distinctive licenses: winner-only and loser-only
            let dw:i32=0;let dl:i32=0;
            let i:i32=0;
            while(i<nw){
                let h:i64=au_get64(wa,i);
                let j:i32=0;let fnd:i32=0;
                while(j<nl){
                    if(au_get64(wb,j)==h){fnd=1;break;}
                    j=j+1;
                }
                if(fnd==0){dw=dw+1;}
                i=i+1;
            }
            i=0;
            while(i<nl){
                let h2:i64=au_get64(wb,i);
                let j2:i32=0;let fnd2:i32=0;
                while(j2<nw){
                    if(au_get64(wa,j2)==h2){fnd2=1;break;}
                    j2=j2+1;
                }
                if(fnd2==0){dl=dl+1;}
                i=i+1;
            }
            if(dl>0){
                let pen:i32=200/dl;
                i=0;
                while(i<nl){
                    let h3:i64=au_get64(wb,i);
                    let j3:i32=0;let fnd3:i32=0;
                    while(j3<nw){
                        if(au_get64(wa,j3)==h3){fnd3=1;break;}
                        j3=j3+1;
                    }
                    if(fnd3==0){hyb_tadd(hy,h3,0-pen);}
                    i=i+1;
                }
            }
            if(dw>0){
                let rew:i32=100/dw;
                i=0;
                while(i<nw){
                    let h4:i64=au_get64(wa,i);
                    let j4:i32=0;let fnd4:i32=0;
                    while(j4<nl){
                        if(au_get64(wb,j4)==h4){fnd4=1;break;}
                        j4=j4+1;
                    }
                    if(fnd4==0){hyb_tadd(hy,h4,rew);}
                    i=i+1;
                }
            }
            if(winner==1){hyb_mark(m,b);}else{hyb_mark(m,a);}
        }
        hyb_wlog(hy,a,b,sa,sb,winner,final);
    }
    nio_free(la);nio_free(lb);
    return winner;
}
// weigh every intermediate contradictory pair (main store, sub==0),
// excluding the final target pair (weighed separately by the caller).
fn hyb_weigh_pairs(hy:*HYBL,m:*HYBM,s:*CXS,e:*CXRE,q:*CXRS,t:i32,nt:i32)void {
    let seen:[]u8=nio_alloc(256*8);
    if(seen.len!=2048){return;}
    let nseen:i32=0;
    let ci:i32=0;
    while(ci<e.*.cxn){
        if(au_get32(e.*.cxo,ci*3+2)==0){
            let f:i32=au_get32(e.*.cxo,ci*3+0);
            let nf:i32=au_get32(e.*.cxo,ci*3+1);
            let skip:i32=0;
            if((f==t && nf==nt)||(f==nt && nf==t)){skip=1;}
            if(f<0||f>=m.*.pmn||nf<0||nf>=m.*.pmn){skip=1;}
            if(skip==0){
                let k:i32=0;let dup:i32=0;
                while(k<nseen){
                    if(au_get32(seen,k*2+0)==f && au_get32(seen,k*2+1)==nf){dup=1;break;}
                    k=k+1;
                }
                if(dup==0){
                    if(nseen<256){
                        au_put32(seen,nseen*2+0,f);
                        au_put32(seen,nseen*2+1,nf);
                        nseen=nseen+1;
                    }
                    hyb_weigh(hy,m,s,e,q,f,nf,0);
                }
            }
        }
        ci=ci+1;
    }
    nio_free(seen);
    return;
}

// cx_claim.zag — formula node tree: parse canonical claim bytes <-> tree.
// Node = 7 i32 = 28 bytes in a []u8 arena (ZNC-007-safe, au_* accessors).
// fields: kind(0) start(1) len(2) aux_off(3) aux_len(4) child(5) next(6)
// kinds: 0 CONST, 1 APP, 2 VAR(?N), 3 NOT, 4 IMP, 5 AND, 6 OR, 7 FORALL, 8 FALSE
// start/len = FULL SOURCE SPAN of the node (for VAR: the "?N" text).
// aux_off/aux_len: CONST/APP -> head word; FORALL -> binder; VAR -> varnum
//   is stored in aux_off (aux_len=0); others unused.
// Pure Zag, zero RNG, deterministic.

struct CXA { buf:[]u8, n:i32, cap:i32, src:[]u8 }
struct CXP { s:[]u8, p:i32, err:i32 }

fn cxk(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+0); }
fn cxs(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+1); }
fn cxl(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+2); }
fn cxbo(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+3); }
fn cxbl(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+4); }
fn cxch(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+5); }
fn cxnx(a:*CXA,i:i32)i32 { return au_get32(a.*.buf,i*7+6); }
fn cx_set(a:*CXA,i:i32,f:i32,v:i32)void { au_put32(a.*.buf,i*7+f,v); }

fn cxa_init(a:*CXA,src:[]u8,cap:i32)i32 {
    let b:[]u8=nio_alloc(cap*28);
    if(b.len!=cap*28){return -1;}
    a.*.buf=b;a.*.n=0;a.*.cap=cap;a.*.src=src;
    return 0;
}
fn cxa_new(a:*CXA,kind:i32)i32 {
    if(a.*.n>=a.*.cap){return -1;}
    let i:i32=a.*.n;a.*.n=i+1;
    let k:i32=0;
    while(k<7){au_put32(a.*.buf,i*7+k,0);k=k+1;}
    au_put32(a.*.buf,i*7+0,kind);
    au_put32(a.*.buf,i*7+5,-1);
    au_put32(a.*.buf,i*7+6,-1);
    return i;
}
// head word of CONST/APP node i
fn cx_head(a:*CXA,i:i32)[]u8 {
    let s:[]u8=a.*.src;
    let o:i32=cxbo(a,i);let l:i32=cxbl(a,i);
    return s[o..o+l];
}
// binder of FORALL node i
fn cx_bvar(a:*CXA,i:i32)[]u8 {
    let s:[]u8=a.*.src;
    let o:i32=cxbo(a,i);let l:i32=cxbl(a,i);
    return s[o..o+l];
}
// varnum of VAR node i
fn cx_varnum(a:*CXA,i:i32)i32 { return cxbo(a,i); }
// full source span of node i
fn cx_span(a:*CXA,i:i32)[]u8 {
    let s:[]u8=a.*.src;
    let o:i32=cxs(a,i);let l:i32=cxl(a,i);
    return s[o..o+l];
}
fn cx_nchildren(a:*CXA,i:i32)i32 {
    let n:i32=0;let c:i32=cxch(a,i);
    while(c>=0){n=n+1;c=cxnx(a,c);}
    return n;
}
// set the source span [ns, px.p) on node ni
fn cxp_span(a:*CXA,px:*CXP,ni:i32,ns:i32)void {
    cx_set(a,ni,1,ns);
    cx_set(a,ni,2,px.*.p-ns);
}

// ---------- parser ----------
fn cxp_ws(px:*CXP)void {
    let s:[]u8=px.*.s;
    while(px.*.p<s.len && (s[px.*.p]==32 || s[px.*.p]==9)){px.*.p=px.*.p+1;}
}
fn cxp_kw(px:*CXP,kw:[]u8)i32 {
    cxp_ws(px);
    let s:[]u8=px.*.s;let p:i32=px.*.p;
    if(p+kw.len>s.len){return 0;}
    if(nio_equal(s[p..p+kw.len],kw)==0){return 0;}
    px.*.p=p+kw.len;
    return 1;
}
fn cxp_word(px:*CXP)[]u8 {
    cxp_ws(px);
    let s:[]u8=px.*.s;let p:i32=px.*.p;let e:i32=p;
    while(e<s.len){
        let c:u8=s[e];
        let ok:i32=0;
        if((c>=97 && c<=122) || (c>=48 && c<=57) || c==95){ok=1;}
        if(ok==0){break;}
        e=e+1;
    }
    let w:[]u8=s[p..e];
    px.*.p=e;
    return w;
}
fn cxp_expect(px:*CXP,c:u8)i32 {
    cxp_ws(px);
    let s:[]u8=px.*.s;
    if(px.*.p<s.len && s[px.*.p]==c){px.*.p=px.*.p+1;return 1;}
    px.*.err=1;
    return 0;
}
fn cxp_is_wordchar(c:u8)i32 {
    if((c>=97 && c<=122) || (c>=48 && c<=57) || c==95){return 1;}
    return 0;
}
fn cxp_expr(a:*CXA,px:*CXP)i32 {
    cxp_ws(px);
    let s:[]u8=px.*.s;
    if(px.*.p>=s.len){px.*.err=1;return -1;}
    let ns:i32=px.*.p;
    let c:u8=s[px.*.p];
    if(c==63){
        px.*.p=px.*.p+1;
        let v:i32=0;let nd:i32=0;
        while(px.*.p<s.len && s[px.*.p]>=48 && s[px.*.p]<=57){
            v=v*10+((s[px.*.p]-48) as i32);nd=nd+1;px.*.p=px.*.p+1;
        }
        if(nd==0){px.*.err=1;return -1;}
        let ni:i32=cxa_new(a,2);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,3,v);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"not(")==1){
        let ch:i32=cxp_expr(a,px);
        if(ch<0){return -1;}
        if(cxp_expect(px,41)==0){return -1;}
        let ni:i32=cxa_new(a,3);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,5,ch);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"imp(")==1){
        let c1:i32=cxp_expr(a,px);
        if(c1<0){return -1;}
        if(cxp_expect(px,44)==0){return -1;}
        let c2:i32=cxp_expr(a,px);
        if(c2<0){return -1;}
        if(cxp_expect(px,41)==0){return -1;}
        let ni:i32=cxa_new(a,4);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,5,c1);cx_set(a,c1,6,c2);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"and(")==1){
        let c1:i32=cxp_expr(a,px);
        if(c1<0){return -1;}
        if(cxp_expect(px,44)==0){return -1;}
        let c2:i32=cxp_expr(a,px);
        if(c2<0){return -1;}
        if(cxp_expect(px,41)==0){return -1;}
        let ni:i32=cxa_new(a,5);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,5,c1);cx_set(a,c1,6,c2);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"or(")==1){
        let c1:i32=cxp_expr(a,px);
        if(c1<0){return -1;}
        if(cxp_expect(px,44)==0){return -1;}
        let c2:i32=cxp_expr(a,px);
        if(c2<0){return -1;}
        if(cxp_expect(px,41)==0){return -1;}
        let ni:i32=cxa_new(a,6);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,5,c1);cx_set(a,c1,6,c2);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"forall(")==1){
        cxp_ws(px);
        let woff:i32=px.*.p;
        let s0:[]u8=px.*.s;
        let w:[]u8="";
        if(px.*.p<s0.len && s0[px.*.p]==63){
            px.*.p=px.*.p+1;
            let nd:i32=0;
            while(px.*.p<s0.len && s0[px.*.p]>=48 && s0[px.*.p]<=57){nd=nd+1;px.*.p=px.*.p+1;}
            if(nd==0){px.*.err=1;return -1;}
            w=s0[woff..px.*.p];
        } else {
            w=cxp_word(px);
        }
        if(w.len==0){px.*.err=1;return -1;}
        if(cxp_expect(px,44)==0){return -1;}
        let bd:i32=cxp_expr(a,px);
        if(bd<0){return -1;}
        if(cxp_expect(px,41)==0){return -1;}
        let ni:i32=cxa_new(a,7);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,3,woff);cx_set(a,ni,4,w.len);
        cx_set(a,ni,5,bd);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    if(cxp_kw(px,"false")==1){
        let s3:[]u8=px.*.s;
        if(px.*.p<s3.len && cxp_is_wordchar(s3[px.*.p])==1){px.*.err=1;return -1;}
        let ni:i32=cxa_new(a,8);
        if(ni<0){px.*.err=1;return -1;}
        cxp_span(a,px,ni,ns);
        return ni;
    }
    cxp_ws(px);
    let woff:i32=px.*.p;
    let w:[]u8=cxp_word(px);
    if(w.len==0){px.*.err=1;return -1;}
    let s4:[]u8=px.*.s;
    cxp_ws(px);
    if(px.*.p<s4.len && s4[px.*.p]==40){
        px.*.p=px.*.p+1;
        let ni:i32=cxa_new(a,1);
        if(ni<0){px.*.err=1;return -1;}
        cx_set(a,ni,3,woff);cx_set(a,ni,4,w.len);
        let first:i32=-1;let prev:i32=-1;
        cxp_ws(px);
        if(px.*.p<s4.len && s4[px.*.p]==41){
            px.*.p=px.*.p+1;
        } else {
            let done:i32=0;
            while(done==0){
                let ch:i32=cxp_expr(a,px);
                if(ch<0){return -1;}
                if(first<0){first=ch;}else{cx_set(a,prev,6,ch);}
                prev=ch;
                cxp_ws(px);
                let cc:u8=s4[px.*.p];
                if(cc==44){px.*.p=px.*.p+1;}
                if(cc==41){px.*.p=px.*.p+1;done=1;}
                if(cc!=44 && cc!=41){px.*.err=1;return -1;}
            }
        }
        cx_set(a,ni,5,first);
        cxp_span(a,px,ni,ns);
        return ni;
    }
    let ni2:i32=cxa_new(a,0);
    if(ni2<0){px.*.err=1;return -1;}
    cx_set(a,ni2,3,woff);cx_set(a,ni2,4,w.len);
    cxp_span(a,px,ni2,ns);
    return ni2;
}
// parse whole s; returns root idx or -1. a.src must already be s.
fn cx_parse(a:*CXA,s:[]u8) i32 {
    let px:CXP=CXP{.s:s,.p:0,.err:0};
    let r:i32=cxp_expr(a,&px);
    if(r<0 || px.err==1){return -1;}
    cxp_ws(&px);
    if(px.p!=s.len){return -1;}
    return r;
}

// ---------- printer (canonical bytes) ----------
fn cx_print(a:*CXA,root:i32,o:*DOut)void {
    if(root<0){return;}
    let k:i32=cxk(a,root);
    if(k==0){dout_str(o,cx_head(a,root));return;}
    if(k==2){dout_str(o,"?");dout_i64(o,cx_varnum(a,root) as i64);return;}
    if(k==8){dout_str(o,"false");return;}
    if(k==3){dout_str(o,"not(");cx_print(a,cxch(a,root),o);dout_str(o,")");return;}
    if(k==7){
        dout_str(o,"forall(");dout_str(o,cx_bvar(a,root));dout_str(o,",");
        cx_print(a,cxch(a,root),o);dout_str(o,")");return;
    }
    if(k==1){
        dout_str(o,cx_head(a,root));dout_str(o,"(");
        let c:i32=cxch(a,root);let f:i32=0;
        while(c>=0){
            if(f==1){dout_str(o,",");}
            cx_print(a,c,o);f=1;c=cxnx(a,c);
        }
        dout_str(o,")");return;
    }
    if(k==4){dout_str(o,"imp(");}
    if(k==5){dout_str(o,"and(");}
    if(k==6){dout_str(o,"or(");}
    cx_print(a,cxch(a,root),o);dout_str(o,",");
    cx_print(a,cxnx(a,cxch(a,root)),o);dout_str(o,")");
    return;
}
// canonicalize s -> owned canonical bytes, or "" on parse error
fn cx_canon(s:[]u8)[]u8 {
    let a:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
    if(cxa_init(&a,s,256)!=0){return "";}
    let r:i32=cx_parse(&a,s);
    if(r<0){nio_free(a.buf);return "";}
    let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&o,4096)!=0){nio_free(a.buf);return "";}
    cx_print(&a,r,&o);
    let out:[]u8=cx_copy(dout_bytes(&o));
    dout_free(&o);nio_free(a.buf);
    return out;
}

// QUOT engine (d): q_rules.zag — Herbrand universe, rule provenance,
// taxonomy closure (SPEC_QUOT §4), and the specificity decision.
// Schemas are frozen (cx_sch_assert): S_MP, S_PBC, S_UI.

// ---------- Herbrand universe ----------
// U = subterm/function-symbol closure of store+problem claims,
// depth = max_term_depth(store+problem) + schema_count (3).
fn q_u_term(g:*QG, i:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let ar:[]u8=u1.*.u_arena;
    let o:i32=au_get32(u1.*.u_off, i);
    let l:i32=au_get32(u1.*.u_len, i);
    return ar[o..o+l];
}
// add term bytes to U if absent; 1=new, 0=dup, -1=overflow
fn q_u_add(g:*QG, t:[]u8) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let n:i32=u1.*.u_n;
    let i:i32=0;
    while(i<n){
        if(nio_equal(q_u_term(g,i),t)==1){ return 0; }
        i=i+1;
    }
    if(n>=65536){ return -1; }
    let ar:[]u8=u1.*.u_arena;
    let o:i32=u1.*.u_m;
    if(o+t.len>ar.len){ return -1; }
    i=0;
    while(i<t.len){ ar[o+i]=t[i]; i=i+1; }
    u1.*.u_m=o+t.len;
    au_put32(u1.*.u_off, n, o);
    au_put32(u1.*.u_len, n, t.len);
    u1.*.u_n=n+1;
    return 1;
}
// add function name if absent; returns index or -1
fn q_fn_add(g:*QG, name:[]u8, arity:i32) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let n:i32=qu2.*.u_fnn_n;
    let i:i32=0;
    while(i<n){
        let ar:[]u8=qu2.*.fn_arena;
        let o:i32=au_get32(u1.*.u_fno, i);
        let l:i32=au_get32(u1.*.u_fnn, i);
        if(nio_equal(ar[o..o+l],name)==1){ return i; }
        i=i+1;
    }
    if(n>=4096){ return -1; }
    let ar:[]u8=qu2.*.fn_arena;
    let o:i32=qu2.*.fn_n;
    i=0;
    while(i<name.len){ ar[o+i]=name[i]; i=i+1; }
    qu2.*.fn_n=o+name.len;
    au_put32(u1.*.u_fno, n, o);
    au_put32(u1.*.u_fnn, n, name.len);
    au_put32(qu2.*.u_fna, n, arity);
    qu2.*.u_fnn_n=n+1;
    return n;
}
// term depth of a parsed claim node
fn q_tdepth(a:*CXA, nd:i32) i32 {
    let k:i32=cxk(a,nd);
    // FIX 2026-09-25 (pre-existing): kind 1 is APP, not 0-ary func;
    // it contributes 1+max(child depths) like other composite kinds.
    if(k==0 || k==2 || k==8){ return 0; }
    let m:i32=0;
    let c:i32=cxch(a,nd);
    while(c>=0){
        let d:i32=q_tdepth(a,c);
        if(d>m){ m=d; }
        c=cxnx(a,c);
    }
    return m+1;
}
// max TERM depth in a parsed claim (connectives/quantifiers transparent).
// FIX 2026-09-25 (pre-existing): q_universe used q_tdepth (formula depth,
// counting imp/forall/not) for the spec's max_term_depth, inflating U
// (D=7 -> 3280 terms -> slot/record exhaustion). The spec says
// max_term_depth(store+problem): depth of terms, not formulas.
fn q_maxtermdepth(a:*CXA, nd:i32) i32 {
    let k:i32=cxk(a,nd);
    if(k==0 || k==2 || k==8){ return 0; }
    let m:i32=0;
    let c:i32=cxch(a,nd);
    while(c>=0){
        let d:i32=q_maxtermdepth(a,c);
        if(d>m){ m=d; }
        c=cxnx(a,c);
    }
    if(k==1){ return m+1; }
    return m;
}
// collect ground subterms and function symbols from a parsed claim
// 1 if the subtree rooted at nd contains no variables: no kind-2 (?N)
// node and no kind-0 leaf equal to the enclosing binder bv.
fn q_subtree_ground(a:*CXA, nd:i32, bv:[]u8) i32 {
    let k:i32=cxk(a,nd);
    if(k==2){ return 0; }
    if(k==0){
        if(bv.len>0 && nio_equal(cx_head(a,nd),bv)==1){ return 0; }
        return 1;
    }
    let c:i32=cxch(a,nd);
    while(c>=0){
        if(q_subtree_ground(a,c,bv)==0){ return 0; }
        c=cxnx(a,c);
    }
    return 1;
}
// collect ground subterms and function symbols from a parsed claim.
// bv is the enclosing forall binder name ("" if none): a kind-0 leaf
// equal to bv is a bound-variable occurrence, not a constant term.
// FIX 2026-09-25 (pre-existing): the old code assumed kind 5 = FUNC and
// kind 2 = VAR, but cx_claim.zag uses 1 = APP and 0 = CONST (bare words,
// including bound-variable occurrences); kind 5 is AND. The old table
// added non-ground bird(x)/flies(x)/penguin(x) to U, missed tweety, and
// never registered function symbols (the k==5 branch was dead).
fn q_collect(a:*CXA, nd:i32, g:*QG, bv:[]u8) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let k:i32=cxk(a,nd);
    if(k==0){
        // CONST leaf, or bound-variable occurrence
        if(bv.len>0 && nio_equal(cx_head(a,nd),bv)==1){ return 0; }
        let sp:[]u8=cx_span(a,nd);
        if(q_u_add(g,sp)<0){ return -1; }
        return 0;
    }
    if(k==1){
        // APP node: record head/arity, recurse into args, add the whole
        // span as a term only if it is ground
        let hd:[]u8=cx_head(a,nd);
        let ar:i32=cx_nchildren(a,nd);
        if(q_fn_add(g,hd,ar)<0){ return -1; }
        let c:i32=cxch(a,nd);
        while(c>=0){
            if(q_collect(a,c,g,bv)<0){ return -1; }
            c=cxnx(a,c);
        }
        if(q_subtree_ground(a,nd,bv)==1){
            let sp:[]u8=cx_span(a,nd);
            if(q_u_add(g,sp)<0){ return -1; }
        }
        return 0;
    }
    if(k==7){
        // FORALL: the binder is not a term; collect from the body with
        // the binder in scope
        let nbv:[]u8=cx_bvar(a,nd);
        let bd:i32=cxch(a,nd);
        if(bd>=0){
            if(q_collect(a,bd,g,nbv)<0){ return -1; }
        }
        return 0;
    }
    if(k==2 || k==8){
        // ?N variable or false: not terms
        return 0;
    }
    // NOT / IMP / AND / OR: recurse into children
    let c:i32=cxch(a,nd);
    while(c>=0){
        if(q_collect(a,c,g,bv)<0){ return -1; }
        c=cxnx(a,c);
    }
    return 0;
}
// build U; returns 0 ok, -1 on overflow
fn q_universe(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let maxd:i32=0;
    let id:i32=0;
    while(id<mi.*.nitems){
        let lit:[]u8=q_item_claim(g,id);
        let a:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
        if(cxa_init(&a,lit,128)!=0){ return -1; }
        let root:i32=cx_parse(&a,lit);
        if(root<0){
            // debug
            nio_free(a.buf);
            return -1;
        }
        let d:i32=q_maxtermdepth(a,root);
        if(d>maxd){ maxd=d; }
        if(q_collect(a,root,g,"")<0){ nio_free(a.buf); return -1; }
        nio_free(a.buf);
        id=id+1;
    }
    let D:i32=maxd+3;
    // close under function symbols up to depth D
    let changed:i32=1;
    while(changed==1){
        changed=0;
        let fi:i32=0;
        while(fi<qu2.*.u_fnn_n){
            let ar:[]u8=qu2.*.fn_arena;
            let fo:i32=au_get32(u1.*.u_fno, fi);
            let fl:i32=au_get32(u1.*.u_fnn, fi);
            let fname:[]u8=ar[fo..fo+fl];
            let arity:i32=au_get32(qu2.*.u_fna, fi);
            if(arity==0){
                // 0-ary already added as const
            } else if(arity==1){
                let ti:i32=0;
                let un:i32=u1.*.u_n;
                while(ti<un){
                    let tt:[]u8=q_u_term(g,ti);
                    // build fname(tt)
                    let ob:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                    dout_init(&ob,4096);
                    dout_str(&ob,fname); dout_byte(&ob,40);
                    dout_str(&ob,tt); dout_byte(&ob,41);
                    let nb2:[]u8=dout_bytes(&ob);
                    // check depth: parse and measure
                    let a2:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
                    if(cxa_init(&a2,nb2,64)==0){
                        let r2:i32=cx_parse(&a2,nb2);
                        if(r2>=0 && q_tdepth(a2,r2)<=D){
                            let ad:i32=q_u_add(g,nb2);
                            if(ad<0){ nio_free(a2.buf); dout_free(&ob); return -1; }
                            if(ad==1){ changed=1; }
                        }
                        nio_free(a2.buf);
                    }
                    dout_free(&ob);
                    ti=ti+1;
                }
            }
            // arity >= 2: skip (combinatorial); depth bound keeps U finite
            fi=fi+1;
        }
    }
    // sort U lexicographically (insertion sort)
    let n:i32=u1.*.u_n;
    let i:i32=1;
    while(i<n){
        let ko:i32=au_get32(u1.*.u_off, i);
        let kl:i32=au_get32(u1.*.u_len, i);
        let j:i32=i-1;
        while(j>=0){
            let jo:i32=au_get32(u1.*.u_off, j);
            let jl:i32=au_get32(u1.*.u_len, j);
            let ar:[]u8=u1.*.u_arena;
            if(q_bytes_cmp(ar[jo..jo+jl],ar[ko..ko+kl])<=0){ break; }
            au_put32(u1.*.u_off, (j+1), jo);
            au_put32(u1.*.u_len, (j+1), jl);
            j=j-1;
        }
        au_put32(u1.*.u_off, (j+1), ko);
        au_put32(u1.*.u_len, (j+1), kl);
        i=i+1;
    }
    let di:i32=0;
    return 0;
}

// ---------- rule provenance ----------
// A claim is "rule-final" for contested-head matching if root>=0 names a
// domain rule whose head pattern matches `lit`, and ranteln==0 (the claim is
// the rule's direct conclusion, not a chained MP through it).
// Rules are indexed from contingent items: every imp/forall item is a rule;
// its "head" is the consequent (imp) or body (forall).
fn q_rule_final(g:*QG, root:i32, ranteln:i32, lit:[]u8) i32 {
    // FIX 2026-09-25 (pre-existing): the head-pattern matcher was broken
    // (wrong node, span-vs-structural bugs). A record is "final" if it
    // derives from a rule (root>=0); the antecedent chain carries the
    // specificity information.
    if(root<0){ return 0; }
    return 1;
}
// 1 if head node `hn` (parsed in a) matches ground `lit`, VARs wildcard
fn q_head_matches_node(a:*CXA, hn:i32, lit:[]u8) i32 {
    let b:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
    if(cxa_init(&b,lit,64)!=0){ return 0; }
    let lr:i32=cx_parse(&b,lit);
    if((lit.len>=5 && lit[0]==102) || (lit.len>=5 && lit[0]==110)){
    }
    if(lr<0){ nio_free(b.buf); return 0; }
    let r:i32=q_match_nodes(a,hn,&b,lr);
    nio_free(b.buf);
    return r;
}
// 1 if pattern `pat` (parsed in a) matches ground `lit`, VARs wildcard
fn q_head_matches(a:CXA, pr:i32, pat:[]u8, lit:[]u8) i32 {
    // parse lit
    let b:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
    if(cxa_init(&b,lit,64)!=0){ return 0; }
    let lr:i32=cx_parse(&b,lit);
    if(lr<0){ nio_free(b.buf); return 0; }
    // parse pat (already have a, pr)
    let r:i32=q_match_nodes(&a,pr,&b,lr);
    nio_free(b.buf);
    return r;
}
fn q_match_nodes(a:*CXA, x:i32, b:*CXA, y:i32) i32 {
    let kx:i32=cxk(a,x);
    let ky:i32=cxk(b,y);
    let xs0:[]u8=cx_span(a,x);
    if(xs0.len>=12 && xs0[0]==110 && xs0[1]==111 && xs0[2]==116){
    }
    if(kx==2){ return 1; } // VAR wildcard
    if(kx!=ky){ return 0; }
    // FIX 2026-09-25 (pre-existing): APP (1) was span-compared, so
    // flies(x) never matched flies(tweety). Compare heads, recurse args.
    if(kx==0 || kx==8){
        if(nio_equal(cx_span(a,x),cx_span(b,y))==0){ return 0; }
        return 1;
    }
    if(kx==1 || kx==5){
        if(nio_equal(cx_head(a,x),cx_head(b,y))==0){ return 0; }
    }
    let cx:i32=cxch(a,x);
    let cy:i32=cxch(b,y);
    while(cx>=0 && cy>=0){
        if(q_match_nodes(a,cx,b,cy)==0){ return 0; }
        cx=cxnx(a,cx);
        cy=cxnx(b,cy);
    }
    if(cx!=cy){ return 0; }
    return 1;
}

// ---------- rante serialization ----------
// Serialize a rante chain as \x00-separated claim bytes for taxonomy closure.
fn q_rante_joined(g:*QG, rid:i32, o:*DOut)void {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let node:i32=au_get32(qar.*.r_rante, rid);
    // collect minor rids along the chain
    let st:[]u8=nio_alloc(1024);
    if(st.len==0){ return; }
    let sp:i32=0;
    while(node>=0 && sp<256){
        let minor:i32=au_get32(qar.*.rante_arena,node*8+4);
        au_put32(st, sp, minor);
        sp=sp+1;
        node=au_get32(qar.*.rante_arena,node*8);
    }
    // emit in reverse (root-first)
    let i:i32=sp-1;
    while(i>=0){
        let mr:i32=au_get32(st, i);
        if(i!=sp-1){ dout_byte(o,0); }
        dout_str(o,q_rlit(g,mr));
        i=i-1;
    }
    nio_free(st);
    return;
}
// next \x00-separated span in j starting at pos; returns new pos or -1
fn q_next_joined(j:[]u8, pos:i32, o:*i32, l:*i32) i32 {
    if(pos>=j.len){ return -1; }
    let s:i32=pos;
    while(pos<j.len && j[pos]!=0){ pos=pos+1; }
    o.*=s;
    l.*=pos-s;
    if(pos<j.len){ pos=pos+1; }
    return pos;
}

// ---------- taxonomy closure (SPEC_QUOT §4, one-way) ----------
// q_closure_covers(g, A, G1, G2): 1 if the grounded antecedents G1
// taxonomy-close over G2 (every literal in G2 is implied by G1 via taxonomy
// rules/facts), where taxonomy rules are domain rules whose head is neither
// A nor ¬A. G1/G2 are \x00-joined claim bytes.
fn q_closure_covers(g:*QG, A:[]u8, G1:[]u8, G2:[]u8) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    // Build the set S = { literals in G1 } ∪ closure under taxonomy rules.
    // We represent S as a joined byte string with dedup.
    let s:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    dout_init(&s,8192);
    // copy G1 into s with \x00 separators
    let pos:i32=0;
    let so:i32=0;
    let sl:i32=0;
    while(1){
        pos=q_next_joined(G1,pos,&so,&sl);
        if(pos<0){ break; }
        if(s.n>0){ dout_byte(&s,0); }
        dout_str(&s,G1[so..so+sl]);
    }
    // fixpoint: apply taxonomy rules and facts
    let changed:i32=1;
    while(changed==1){
        changed=0;
        // facts: every contingent item that is a bare atom (not imp/forall)
        // taxonomy rules: imp items whose head is neither A nor ¬A
        let id:i32=0;
        while(id<mi.*.nitems){
            let rc:[]u8=q_item_claim(g,id);
            let a:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
            if(cxa_init(&a,rc,64)==0){
                let rr:i32=cx_parse(&a,rc);
                if(rr>=0){
                    let k:i32=cxk(&a,rr);
                    // FIX 2026-09-25 (pre-existing): taxonomy rules are
                    // forall-quantified imps (k==7), not bare imps.
                    // Unwrap forall to get the imp.
                    let imp_rr:i32=rr;
                    if(k==7){
                        let fbody:i32=cxch(&a,rr);
                        if(fbody>=0 && cxk(&a,fbody)==4){
                            imp_rr=fbody;
                            k=4;
                        }
                    }
                    if(k==4){
                        // imp: check head is not A nor ¬A
                        let c0:i32=cxch(&a,imp_rr);
                        let c1:i32=cxnx(&a,c0);
                        let head:[]u8=cx_span(&a,c1);
                        let hpol:i32=q_pol_of(head);
                        let hatom:[]u8=q_atom_of(head,hpol);
                        if(nio_equal(hatom,A)==0){
                            // taxonomy rule: if antecedent in S, add head
                            // FIX 2026-09-25 (pre-existing): antecedent may
                            // have a variable (e.g. penguin(x)) while S has
                            // ground literals (e.g. penguin(tweety)).
                            // Match predicate and instantiate.
                            let ante:[]u8=cx_span(&a,c0);
                            if(q_in_joined(dout_bytes(&s),ante)==1){
                                if(q_in_joined(dout_bytes(&s),head)==0){
                                    dout_byte(&s,0);
                                    dout_str(&s,head);
                                    changed=1;
                                }
                            } else if(ante.len>=3 && ante[ante.len-3]==40 && ante[ante.len-2]==120 && ante[ante.len-1]==41){
                                // ante = P(x): try to match P(t) in S
                                let apred:[]u8=ante[0..ante.len-3];
                                let hpred_end:i32=0;
                                while(hpred_end<head.len && head[hpred_end]!=40){ hpred_end=hpred_end+1; }
                                let hpred:[]u8=head[0..hpred_end];
                                // scan S for P(t)
                                let sb2:[]u8=dout_bytes(&s);
                                let p2:i32=0; let so2:i32=0; let sl2:i32=0;
                                while(1){
                                    p2=q_next_joined(sb2,p2,&so2,&sl2);
                                    if(p2<0){ break; }
                                    let lit2:[]u8=sb2[so2..so2+sl2];
                                    if(lit2.len>apred.len+2 && nio_equal(lit2[0..apred.len],apred)==1 && lit2[apred.len]==40 && lit2[lit2.len-1]==41){
                                        let targ:[]u8=lit2[apred.len+1..lit2.len-1];
                                        // construct hpred(targ)
                                        let o3:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                                        dout_init(&o3,256);
                                        dout_str(&o3,hpred);
                                        dout_byte(&o3,40);
                                        dout_str(&o3,targ);
                                        dout_byte(&o3,41);
                                        let inst:[]u8=dout_bytes(&o3);
                                        if(q_in_joined(dout_bytes(&s),inst)==0){
                                            dout_byte(&s,0);
                                            dout_str(&s,inst);
                                            changed=1;
                                        }
                                        dout_free(&o3);
                                    }
                                }
                            }
                        }
                    } else if(k!=7){
                        // fact (not imp/forall): add if not present
                        // (facts are added once; they don't trigger changed loop
                        //  unless new, but they're static so add upfront)
                    }
                }
                nio_free(a.buf);
            }
            id=id+1;
        }
        // FIX 2026-09-25 (pre-existing): do NOT add all KB facts to S.
        // S must be G1 ∪ taxonomy-closure only; adding every fact makes
        // the covers check trivially true and defeats specificity.
    }
    let sb:[]u8=dout_bytes(&s);
    // check every literal in G2 is in S
    let ok:i32=1;
    pos=0;
    while(1){
        pos=q_next_joined(G2,pos,&so,&sl);
        if(pos<0){ break; }
        if(q_in_joined(sb,G2[so..so+sl])==0){ ok=0; break; }
    }
    dout_free(&s);
    return ok;
}
// 1 if lit is one of the \x00-separated spans in j
fn q_in_joined(j:[]u8, lit:[]u8) i32 {
    let pos:i32=0;
    let so:i32=0;
    let sl:i32=0;
    while(1){
        pos=q_next_joined(j,pos,&so,&sl);
        if(pos<0){ break; }
        if(nio_equal(j[so..so+sl],lit)==1){ return 1; }
    }
    return 0;
}

// ---------- specificity decision (SPEC_QUOT §4) ----------
// For slot si (atom A): examine final positive and negative records.
// Returns 1 (commit +), 2 (commit -), 3 (commit both), 0 (withhold both).
fn q_decide(g:*QG, si:i32) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let ao:[]u8=qs.*.sl_atom;
    let aoff:i32=au_get32(qs.*.sl_ao, si);
    let alen:i32=au_get32(qs.*.sl_al, si);
    let A:[]u8=ao[aoff..aoff+alen];
    // find best final + record and best final - record
    let pl:[]u8=qp.*.pl_arena;
    let bestP:i32=-1;
    let bestN:i32=-1;
    let po:i32=au_get32(qp.*.sl_po, si);
    let pn:i32=au_get32(qp.*.sl_pn, si);
    let k:i32=0;
    while(k<pn){
        let er:i32=au_get32(pl, (po+k));
        if(au_get32(rc1.*.r_dead, er)==0 && au_get32(rc1.*.r_uses, er)==0){
            if(au_get32(qrc2.*.r_final, er)==1){
                if(bestP<0){ bestP=er; }
                else {
                    // prefer smaller support, then smaller depth
                    let p1:i32=qb_popcount(q_rsup(g,er),su.*.nb);
                    let p2:i32=qb_popcount(q_rsup(g,bestP),su.*.nb);
                    if(p1<p2){ bestP=er; }
                }
            }
        }
        k=k+1;
    }
    let qo:i32=au_get32(qp.*.sl_qo, si);
    let qn:i32=au_get32(qp.*.sl_qn, si);
    k=0;
    while(k<qn){
        let er:i32=au_get32(pl, (qo+k));
        if(au_get32(rc1.*.r_dead, er)==0 && au_get32(rc1.*.r_uses, er)==0){
            if(au_get32(qrc2.*.r_final, er)==1){
                if(bestN<0){ bestN=er; }
                else {
                    let p1:i32=qb_popcount(q_rsup(g,er),su.*.nb);
                    let p2:i32=qb_popcount(q_rsup(g,bestN),su.*.nb);
                    if(p1<p2){ bestN=er; }
                }
            }
        }
        k=k+1;
    }
    if(alen==13 && A[0]==102){
    }
    if(bestP<0 && bestN<0){ return 3; } // no contested finals: commit both sides' best
    if(bestP>=0 && bestN<0){ return 1; }
    if(bestN>=0 && bestP<0){ return 2; }
    // both present: specificity contest
    let o1:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    dout_init(&o1,8192);
    q_rante_joined(g,bestP,&o1);
    let G1:[]u8=dout_bytes(&o1);
    let o2:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    dout_init(&o2,8192);
    q_rante_joined(g,bestN,&o2);
    let G2:[]u8=dout_bytes(&o2);
    let p_covers_n:i32=0;
    let n_covers_p:i32=0;
    if(o1.err==0 && o2.err==0){
        // S+ defeats S- iff G1 covers G2 and not vice versa... 
        // Actually per spec: S¬ defeats S+ when grounded antecedents of S¬
        // taxonomy-close over those of S+, and converse fails.
        n_covers_p=q_closure_covers(g,A,G2,G1);
        p_covers_n=q_closure_covers(g,A,G1,G2);
    }
    if(alen==13 && A[0]==102){
    }
    dout_free(&o1);
    dout_free(&o2);
    if(n_covers_p==1 && p_covers_n==0){ return 2; } // N defeats P
    if(p_covers_n==1 && n_covers_p==0){ return 1; } // P defeats N
    return 0; // mutual defeat or neither: WITHHOLD
}

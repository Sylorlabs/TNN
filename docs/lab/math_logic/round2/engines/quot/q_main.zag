// QUOT engine (d): q_main.zag — loading, seeding, one-time commit, output.
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 divergence (unused).

// ---------- contingent item loading ----------
// Collect store claims + problem premises, canonicalize, sort by claim bytes,
// assign contingent IDs 0..n-1. Stores (claim bytes, support-singleton id).
// Returns count, -1 on error.
fn q_load_items(g:*QG, k:*CXK, f:*CXF, cap:i32) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let n:i32=0;
    let i:i32=0;
    // store items
    while(i<k.*.nk){
        let kb:[]u8=cx_kclaim(k,i);
        let cb:[]u8=cx_canon(kb);
        if(cb.len>0){
            if(n>=cap){ nio_free(cb); return -1; }
            au_put32(mi.*.it_claim, n*2, 0); // placeholder; real offsets below
            // store claim bytes in a scratch list via lit_arena reuse is unsafe;
            // keep (off,len) into a dedicated item arena
            let io2:i32=qar.*.lit_n;
            let la:[]u8=qar.*.lit_arena;
            let j:i32=0;
            while(j<cb.len){ la[io2+j]=cb[j]; j=j+1; }
            qar.*.lit_n=io2+cb.len;
            au_put32(mi.*.it_claim, n*2, io2);
            au_put32(mi.*.it_claim, n*2+1, cb.len);
            n=n+1;
            nio_free(cb);
        }
        i=i+1;
    }
    // problem premises
    i=0;
    while(i<f.*.nprem){
        let pb:[]u8=cx_prem(f,i);
        let cb:[]u8=cx_canon(pb);
        if(cb.len==0){ return -1; }
        if(n>=cap){ nio_free(cb); return -1; }
        let io2:i32=qar.*.lit_n;
        let la:[]u8=qar.*.lit_arena;
        let j:i32=0;
        while(j<cb.len){ la[io2+j]=cb[j]; j=j+1; }
        qar.*.lit_n=io2+cb.len;
        au_put32(mi.*.it_claim, n*2, io2);
        au_put32(mi.*.it_claim, n*2+1, cb.len);
        n=n+1;
        nio_free(cb);
        i=i+1;
    }
    // insertion sort by claim bytes (deterministic, in-place on it_claim)
    i=1;
    while(i<n){
        let ko: i32=au_get32(mi.*.it_claim,i*2);
        let kl:i32=au_get32(mi.*.it_claim,i*2+1);
        let j:i32=i-1;
        while(j>=0){
            let jo:i32=au_get32(mi.*.it_claim,j*2);
            let jl:i32=au_get32(mi.*.it_claim,j*2+1);
            let la:[]u8=qar.*.lit_arena;
            if(q_bytes_cmp(la[jo..jo+jl],la[ko..ko+kl])<=0){ break; }
            au_put32(mi.*.it_claim,(j+1)*2,jo);
            au_put32(mi.*.it_claim,(j+1)*2+1,jl);
            j=j-1;
        }
        au_put32(mi.*.it_claim,(j+1)*2,ko);
        au_put32(mi.*.it_claim,(j+1)*2+1,kl);
        i=i+1;
    }
    mi.*.nitems=n;
    return n;
}
fn q_item_claim(g:*QG, id:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let la:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(mi.*.it_claim,id*2);
    let l:i32=au_get32(mi.*.it_claim,id*2+1);
    return la[o..o+l];
}
// seed every contingent item as a claim with singleton support {id}
fn q_seed(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let nb:i32=su.*.nb;
    let id:i32=0;
    while(id<mi.*.nitems){
        let lit:[]u8=q_item_claim(g,id);
        let pol:i32=q_pol_of(lit);
        let sup:[]u8=qb_alloc(nb);
        qb_set(sup,id);
        let rr:i32=q_insert(g,lit,pol,sup,0,10,-1,-1,0,"SEED",id,-1,0,0);
        nio_free(sup);
        if(rr<0){ return -1; }
        id=id+1;
    }
    return 0;
}

// ---------- one-time commit ----------
// Commit every slot's positive and negative polarity (by slot order).
// For a contested atom A, specificity (q_decide) picks the winner.
// Returns 0 ok, -1 overflow.
fn q_commit(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    if(mi.*.committed==1){ return 0; }
    mi.*.committed=1;
    if(mi.*.ndec>=8192){ return -1; }
    let si:i32=0;
    while(si<qs.*.nslots){
        let ao:[]u8=qs.*.sl_atom;
        let aoff:i32=au_get32(qs.*.sl_ao, si);
        let alen:i32=au_get32(qs.*.sl_al, si);
        let atom:[]u8=ao[aoff..aoff+alen];
        let dd:i32=q_decide(g,si);
        if(dd<0){ return -1; }
        let p:i32=0;
        while(p<2){
            let wn:i32=0;
            if(dd==1 && p==0){ wn=1; }
            if(dd==2 && p==1){ wn=1; }
            if(dd==3){ wn=1; }
            if(wn==1){
                let ol:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                dout_init(&ol,4096);
                q_lit_for(g,si,p,&ol);
                let L:[]u8=dout_bytes(&ol);
                if(ol.err!=0){ dout_free(&ol); return -1; }
                // find best (taint-min, support-lex, depth) main record
                let loff:i32=0;
                let lcnt:i32=0;
                if(p==0){ loff=au_get32(qp.*.sl_po, si); lcnt=au_get32(qp.*.sl_pn, si); }
                else { loff=au_get32(qp.*.sl_qo, si); lcnt=au_get32(qp.*.sl_qn, si); }
                let pl:[]u8=qp.*.pl_arena;
                let best:i32=-1;
                let k:i32=0;
                while(k<lcnt){
                    let er:i32=au_get32(pl, (loff+k));
                    if(au_get32(rc1.*.r_dead, er)==0 && au_get32(rc1.*.r_uses, er)==0){
                        if(best<0){ best=er; }
                        else {
                            let t1:i32=q_tainted(g,q_rsup(g,er));
                            let t2:i32=q_tainted(g,q_rsup(g,best));
                            let c:i32=0;
                            if(t1!=t2){ if(t1<t2){c=-1;} else {c=1;} }
                            else {
                                c=qb_cmp(q_rsup(g,er),q_rsup(g,best),su.*.nb);
                                if(c==0){
                                    let d1:i32=au_get32(rc1.*.r_dep, er);
                                    let d2:i32=au_get32(rc1.*.r_dep, best);
                                    if(d1!=d2){ if(d1<d2){c=-1;} else {c=1;} }
                                }
                            }
                            if(c<0){ best=er; }
                        }
                    }
                    k=k+1;
                }
                if(best>=0){
                    let di:i32=mi.*.ndec;
                    au_put32(mi.*.dec_lit,di*16,0); // placeholder
                    // copy literal bytes into dec arena
                    let do2:i32=qar.*.lit_n;
                    let la:[]u8=qar.*.lit_arena;
                    let m:i32=0;
                    while(m<L.len){ la[do2+m]=L[m]; m=m+1; }
                    qar.*.lit_n=do2+L.len;
                    au_put32(mi.*.dec_lit,di*16,do2);
                    au_put32(mi.*.dec_lit,di*16+4,L.len);
                    au_put32(mi.*.dec_lit,di*16+8,best);
                    au_put32(mi.*.dec_lit,di*16+12,p);
                    mi.*.ndec=di+1;
                }
                dout_free(&ol);
            }
            p=p+1;
        }
        si=si+1;
    }
    return 0;
}
fn q_dec_lit(g:*QG, di:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let la:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(mi.*.dec_lit,di*16);
    let l:i32=au_get32(mi.*.dec_lit,di*16+4);
    return la[o..o+l];
}
// ---------- output ----------
fn q_emit(g:*QG, o:*DOut, pid:[]u8, target:[]u8)void {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    dout_str(o,"QUOT-ENGINE-D\n");
    dout_str(o,"problem: "); dout_str(o,pid); dout_line(o);
    dout_str(o,"target: "); dout_str(o,target); dout_line(o);
    // verdict on target
    let tpol:i32=q_pol_of(target);
    let tatom:[]u8=q_atom_of(target,tpol);
    let tsi:i32=q_slot_find(g,tatom);
    let verdict:[]u8="WITHHOLD";
    let why:[]u8="absent";
    if(tsi>=0){
        let di:i32=0;
        let hit:i32=-1;
        while(di<mi.*.ndec){
            if(nio_equal(q_dec_lit(g,di),target)==1){ hit=di; }
            di=di+1;
        }
        if(hit>=0){
            let rid:i32=au_get32(mi.*.dec_lit,hit*16+8);
            let tnt:i32=q_tainted(g,q_rsup(g,rid));
            if(tnt==1){ verdict="WITHHOLD"; why="tainted"; }
            else {
                // check the opposite polarity: if it also committed, WITHHOLD
                let oc:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                dout_init(&oc,4096);
                q_lit_for(g,tsi,1-tpol,&oc);
                let OL:[]u8=dout_bytes(&oc);
                let oh:i32=-1;
                di=0;
                while(di<mi.*.ndec){
                    if(nio_equal(q_dec_lit(g,di),OL)==1){ oh=di; }
                    di=di+1;
                }
                dout_free(&oc);
                if(oh>=0){ verdict="WITHHOLD"; why="contested"; }
                else { verdict="DERIVED"; why="committed"; }
            }
        }
    }
    dout_str(o,"verdict: "); dout_str(o,verdict); dout_line(o);
    dout_str(o,"reason: "); dout_str(o,why); dout_line(o);
    // committed claims
    dout_str(o,"committed: "); dout_str(o,i64s(mi.*.ndec as i64)); dout_line(o);
    let di2:i32=0;
    while(di2<mi.*.ndec){
        let rid:i32=au_get32(mi.*.dec_lit,di2*16+8);
        let p2:i32=au_get32(mi.*.dec_lit,di2*16+12);
        dout_str(o,"  ["); dout_str(o,i64s(di2 as i64)); dout_str(o,"] ");
        if(p2==1){ dout_str(o,"~"); }
        let ao:[]u8=qs.*.sl_atom;
        let aoff:i32=au_get32(qs.*.sl_ao, au_get32(rc1.*.r_slot,rid));
        let alen:i32=au_get32(qs.*.sl_al, au_get32(rc1.*.r_slot,rid));
        dout_str(o,ao[aoff..aoff+alen]);
        dout_str(o," depth="); dout_str(o,i64s(au_get32(rc1.*.r_dep, rid) as i64));
        dout_str(o," sup="); qb_hex(q_rsup(g,rid),su.*.nb,o);
        let tnt2:i32=q_tainted(g,q_rsup(g,rid));
        if(tnt2==1){ dout_str(o," TAINTED"); }
        dout_line(o);
        di2=di2+1;
    }
    // conflicts
    dout_str(o,"conflicts: "); dout_str(o,i64s(su.*.nconf as i64)); dout_line(o);
    let ci:i32=0;
    while(ci<su.*.nconf){
        dout_str(o,"  K"); dout_str(o,i64s(ci as i64)); dout_str(o,"=");
        qb_hex(q_conflict(g,ci),su.*.nb,o);
        dout_line(o);
        ci=ci+1;
    }
    // schemas
    dout_str(o,"schemas: S_MP#62cc41ffd582e687 S_PBC#369efe53016bbe1a S_UI#b2f909c7d7b67f55\n");
    // stats
    dout_str(o,"stats: inserts="); dout_str(o,i64s(mi.*.n_ins as i64));
    dout_str(o," enq="); dout_str(o,i64s(mi.*.n_enq as i64));
    dout_str(o," pop="); dout_str(o,i64s(mz.*.n_pop as i64));
    dout_str(o," subproofs="); dout_str(o,i64s(mz.*.n_sub as i64));
    dout_line(o);
    return;
}

// ---------- main ----------
fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: quot_bin <problem.form> <out_path>  (CWD must be the math_logic dir)");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    if(cx_has_sealed(opath)==1){
        _zag_println("quot: sealed guard tripped on output path");
        // FIX 2026-09-25 (pre-existing): main's return value was not used
        // as the process exit code. Use raw exit syscall.
        _zag_raw_syscall(60,3,0,0,0,0,0);
        return 3;
    }
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len==0){return 4;}
    let flen:i64=cx_guarded_read(fpath,fbuf);
    if(flen==-99){_zag_println("quot: sealed guard tripped on problem file");_zag_raw_syscall(60,3,0,0,0,0,0);return 3;}
    if(flen<=0){_zag_println("quot: cannot read problem file");return 4;}
    let f:CXF=CXF{.id="",.store="",.target="",.prem_off="",.prem_len="",.nprem=0,.cap=0,.buf="",.n=0};
    if(cx_parse_form(fbuf,flen as i32,&f,512)!=0){_zag_println("quot: bad .form");return 4;}
    let sbuf:[]u8=nio_alloc(1048576);
    if(sbuf.len==0){return 4;}
    let sn:i64=cx_guarded_read(f.store,sbuf);
    if(sn==-99){_zag_println("quot: sealed guard tripped on store file");_zag_raw_syscall(60,3,0,0,0,0,0);return 3;}
    if(sn<=0){_zag_println("quot: cannot read store file");return 4;}
    let k:CXK=CXK{.kid_off="",.kid_len="",.kcl_off="",.kcl_len="",.nk=0,.cap=0,.buf="",.n=0};
    if(cx_parse_store(sbuf,sn as i32,&k,512)!=0){_zag_println("quot: bad store");return 4;}
    // schema pins
    if(cx_sch_assert()!=0){_zag_println("quot: schema pin mismatch");return 6;}
    // state: subsystem shells are main-owned locals (znc-safe: no as *Struct casts);
    // qg_init fills their arenas and links them into g.
    let g:QG=QG{};
    let qs:QSL=QSL{}; let qp:QPL=QPL{}; let rc1:QRC1=QRC1{};
    let qrc2:QRC2=QRC2{}; let rc3:QRC3=QRC3{}; let su:QSU=QSU{};
    let qar:QAR=QAR{}; let mi:QMI=QMI{}; let mz:QMZ=QMZ{};
    let w1:QW1=QW1{}; let w2:QW2=QW2{}; let w3:QW3=QW3{};
    let u1:QU1=QU1{}; let qu2:QU2=QU2{}; let qb:QB=QB{};
    if(qg_init(&g,&qs,&qp,&rc1,&qrc2,&rc3,&su,&qar,&mi,&mz,&w1,&w2,&w3,&u1,&qu2,&qb,4096)!=0){_zag_println("quot: state init failed");return 4;}
    let gp:*QG=&g;
    if(q_load_items(gp,&k,&f,4096)<0){_zag_println("quot: item load failed");return 4;}
    qg_set_nb(gp);
    if(q_universe(gp)<0){_zag_println("quot: universe failed");return 4;}
    if(q_seed(gp)<0){_zag_println("quot: seed failed");return 4;}
    if(q_fixpoint(gp)<0){_zag_println("quot: fixpoint failed");return 4;}
    if(q_commit(gp)<0){_zag_println("quot: commit failed");return 4;}
    let o:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&o,1048576)!=0){return 4;}
    let tc:[]u8=cx_canon(f.target);
    q_emit(gp,&o,f.id,tc);
    nio_free(tc);
    let ob:[]u8=dout_bytes(&o);
    if(cx_has_sealed(opath)==1){
        _zag_println("quot: sealed guard tripped on output path");
        dout_free(&o);
        return 3;
    }
    let wr:i64=dlb_write_file(opath,ob,ob.len as i32);
    dout_free(&o);
    if(wr<0){_zag_println("quot: cannot write output");return 4;}
    _zag_print("quot: wrote ");
    let wb:[]u8=i64s(ob.len as i64);
    _zag_print(wb);
    _zag_println(" bytes");
    return 0;
}

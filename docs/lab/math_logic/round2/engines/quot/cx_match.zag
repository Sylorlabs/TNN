// cx_match.zag — pattern matching (?N variables) with bindings, plus
// forall-body substitution and the deterministic UI term universe.
// Pure Zag, zero RNG, deterministic.

struct CXB { cap:i32, set:[]u8, off:[]u8, len:[]u8 }

fn cxb_init(b:*CXB,cap:i32)i32 {
    let s:[]u8=nio_alloc(cap);
    if(s.len!=cap){return -1;}
    let o:[]u8=nio_alloc(cap*4);
    if(o.len!=cap*4){nio_free(s);return -1;}
    let l:[]u8=nio_alloc(cap*4);
    if(l.len!=cap*4){nio_free(s);nio_free(o);return -1;}
    b.*.cap=cap;b.*.set=s;b.*.off=o;b.*.len=l;
    return 0;
}
fn cxb_clear(b:*CXB)void {
    let i:i32=0;
    while(i<b.*.cap){b.*.set[i]=0;i=i+1;}
}
fn cxb_free(b:*CXB)void {
    nio_free(b.*.set);nio_free(b.*.off);nio_free(b.*.len);
}
// bound slice of var vn into ground bytes g (call only if set)
fn cxb_slice(b:*CXB,vn:i32,g:[]u8)[]u8 {
    let o:i32=au_get32(b.*.off,vn);let l:i32=au_get32(b.*.len,vn);
    return g[o..o+l];
}
// absolute offset/len of the bound slice (into g)
fn cxb_off(b:*CXB,vn:i32)i32 { return au_get32(b.*.off,vn); }
fn cxb_vlen(b:*CXB,vn:i32)i32 { return au_get32(b.*.len,vn); }
fn cxb_isset(b:*CXB,vn:i32)i32 {
    if(vn<0 || vn>=b.*.cap){return 0;}
    if(b.*.set[vn]==1){return 1;}
    return 0;
}

// match pattern (pa,pr) against ground (ga,gr); g = ga.src bytes.
// returns 1 on match (bindings in b), 0 otherwise.
fn cx_match(pa:*CXA,pr:i32,g:[]u8,ga:*CXA,gr:i32,b:*CXB)i32 {
    let pk:i32=cxk(pa,pr);
    if(pk==2){
        let vn:i32=cx_varnum(pa,pr);
        if(vn<0 || vn>=b.*.cap){return 0;}
        let gs:i32=cxs(ga,gr);let gl:i32=cxl(ga,gr);
        if(b.*.set[vn]==1){
            let bo:i32=au_get32(b.*.off,vn);let bl:i32=au_get32(b.*.len,vn);
            return nio_equal(g[bo..bo+bl],g[gs..gs+gl]);
        }
        b.*.set[vn]=1;
        au_put32(b.*.off,vn,gs);au_put32(b.*.len,vn,gl);
        return 1;
    }
    let gk:i32=cxk(ga,gr);
    if(pk!=gk){return 0;}
    if(pk==8){return 1;}
    if(pk==0 || pk==1){
        if(nio_equal(cx_head(pa,pr),cx_head(ga,gr))==0){return 0;}
        return cx_match_kids(pa,pr,g,ga,gr,b);
    }
    if(pk==3){
        return cx_match(pa,cxch(pa,pr),g,ga,cxch(ga,gr),b);
    }
    if(pk==4 || pk==5 || pk==6){
        let c1:i32=cxch(pa,pr);let d1:i32=cxch(ga,gr);
        if(cx_match(pa,c1,g,ga,d1,b)==0){return 0;}
        return cx_match(pa,cxnx(pa,c1),g,ga,cxnx(ga,d1),b);
    }
    if(pk==7){
        let pbv:[]u8=cx_bvar(pa,pr);
        if(pbv.len>1 && pbv[0]==63){
            // pattern binder is a ?N variable: bind it to the ground binder
            let vn:i32=0;let di:i32=1;
            while(di<pbv.len && pbv[di]>=48 && pbv[di]<=57){
                vn=vn*10+((pbv[di]-48) as i32);di=di+1;
            }
            if(di!=pbv.len || vn<0 || vn>=b.*.cap){return 0;}
            let gs:i32=cxbo(ga,gr);let gl:i32=cxbl(ga,gr);
            if(b.*.set[vn]==1){
                let bo:i32=au_get32(b.*.off,vn);let bl:i32=au_get32(b.*.len,vn);
                if(nio_equal(g[bo..bo+bl],g[gs..gs+gl])==0){return 0;}
            } else {
                b.*.set[vn]=1;
                au_put32(b.*.off,vn,gs);au_put32(b.*.len,vn,gl);
            }
        } else {
            if(nio_equal(pbv,cx_bvar(ga,gr))==0){return 0;}
        }
        return cx_match(pa,cxch(pa,pr),g,ga,cxch(ga,gr),b);
    }
    return 0;
}
fn cx_match_kids(pa:*CXA,pr:i32,g:[]u8,ga:*CXA,gr:i32,b:*CXB)i32 {
    let c:i32=cxch(pa,pr);let d:i32=cxch(ga,gr);
    while(c>=0 && d>=0){
        if(cx_match(pa,c,g,ga,d,b)==0){return 0;}
        c=cxnx(pa,c);d=cxnx(ga,d);
    }
    if(c>=0 || d>=0){return 0;}
    return 1;
}

// SUBST(body, bvar, term): print body with free bvar occurrences replaced.
// bvar = bound variable bytes; shadowed inner foralls print unchanged.
fn cx_subst(a:*CXA,root:i32,bvar:[]u8,term:[]u8,o:*DOut)void {
    if(root<0){return;}
    let k:i32=cxk(a,root);
    if(k==0){
        if(nio_equal(cx_head(a,root),bvar)==1){dout_str(o,term);return;}
        dout_str(o,cx_head(a,root));return;
    }
    if(k==7){
        if(nio_equal(cx_bvar(a,root),bvar)==1){cx_print(a,root,o);return;}
        dout_str(o,"forall(");dout_str(o,cx_bvar(a,root));dout_str(o,",");
        cx_subst(a,cxch(a,root),bvar,term,o);dout_str(o,")");return;
    }
    if(k==1){
        dout_str(o,cx_head(a,root));dout_str(o,"(");
        let c:i32=cxch(a,root);let f:i32=0;
        while(c>=0){
            if(f==1){dout_str(o,",");}
            cx_subst(a,c,bvar,term,o);f=1;c=cxnx(a,c);
        }
        dout_str(o,")");return;
    }
    if(k==3){dout_str(o,"not(");cx_subst(a,cxch(a,root),bvar,term,o);dout_str(o,")");return;}
    if(k==8){dout_str(o,"false");return;}
    if(k==2){dout_str(o,"?");dout_i64(o,cx_varnum(a,root) as i64);return;}
    if(k==4){dout_str(o,"imp(");}
    if(k==5){dout_str(o,"and(");}
    if(k==6){dout_str(o,"or(");}
    cx_subst(a,cxch(a,root),bvar,term,o);dout_str(o,",");
    cx_subst(a,cxnx(a,cxch(a,root)),bvar,term,o);dout_str(o,")");
    return;
}

// ---------- deterministic UI term universe ----------
// Collect distinct ground terms (argument position) from ground claims
// (kind 0/1, no forall, no ?vars) in s, first-appearance order.
// toff/tlen: []u8 arenas of i32 (capacity tcap); slices view s.data.
// Returns count, or -1 on overflow.
fn cx_has_forall(s:[]u8)i32 {
    let i:i32=0;
    while(i+7<=s.len){
        if(s[i]==102 && s[i+1]==111 && s[i+2]==114 && s[i+3]==97 && s[i+4]==108 && s[i+5]==108 && s[i+6]==40){return 1;}
        i=i+1;
    }
    return 0;
}
fn cx_has_qmark(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){if(s[i]==63){return 1;}i=i+1;}
    return 0;
}
fn cx_uni_walk(a:*CXA,nd:i32,pkind:i32,s:*CXS,base:i32,toff:[]u8,tlen:[]u8,tcap:i32,n:*i32)i32 {
    if(nd<0){return 0;}
    let k:i32=cxk(a,nd);
    if((k==0 || k==1) && pkind==1){
        let o:i32=base+cxs(a,nd);let l:i32=cxl(a,nd);
        let data:[]u8=s.*.data;
        let dup:i32=0;let j:i32=0;
        while(j<n.*){
            let jo:i32=au_get32(toff,j);let jl:i32=au_get32(tlen,j);
            if(nio_equal(data[jo..jo+jl],data[o..o+l])==1){dup=1;break;}
            j=j+1;
        }
        if(dup==0){
            if(n.*>=tcap){return -1;}
            au_put32(toff,n.*,o);au_put32(tlen,n.*,l);
            n.*=n.*+1;
        }
    }
    let c:i32=cxch(a,nd);
    while(c>=0){
        if(cx_uni_walk(a,c,k,s,base,toff,tlen,tcap,n)!=0){return -1;}
        c=cxnx(a,c);
    }
    return 0;
}
fn cx_universe(s:*CXS,toff:[]u8,tlen:[]u8,tcap:i32,sub:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.*.n){
        let kd:i32=au_get32(s.*.kind,i);
        let ok:i32=0;
        if(kd==0 || kd==1){ok=1;}
        if(sub==1 && kd==2){ok=1;}
        if(ok==1){
            let data:[]u8=s.*.data;
            let bo:i32=au_get32(s.*.coff,i);let bl:i32=au_get32(s.*.clen,i);
            let cb:[]u8=data[bo..bo+bl];
            if(cx_has_forall(cb)==0 && cx_has_qmark(cb)==0){
                let a:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
                if(cxa_init(&a,cb,256)!=0){return -1;}
                let r:i32=cx_parse(&a,cb);
                if(r>=0){
                    if(cx_uni_walk(&a,r,-1,s,bo,toff,tlen,tcap,&n)!=0){nio_free(a.buf);return -1;}
                }
                nio_free(a.buf);
            }
        }
        i=i+1;
    }
    return n;
}

// Match with a named CONST (bvar) acting as a bindable variable (?0).
// Used by DUAL's backward S_UI: pattern = forall body (ground), bvar = binder.
// sh=1 if bvar is shadowed by an inner binder (those occurrences not bound).
// Binds b[0] to the ground span (offsets into ga.src) of bvar's counterpart.
fn cx_match_bvar(pa:*CXA,pr:i32,ga:*CXA,gr:i32,bvar:[]u8,sh:i32,b:*CXB)i32 {
    if(pr<0 || gr<0){return 0;}
    let pk:i32=cxk(pa,pr);let gk:i32=cxk(ga,gr);
    if(pk==2){return 0;}
    if(pk==0 && sh==0 && nio_equal(cx_head(pa,pr),bvar)==1){
        let g:[]u8=ga.*.src;
        let gs:i32=cxs(ga,gr);let gl:i32=cxl(ga,gr);
        if(b.*.set[0]==1){
            let bo:i32=au_get32(b.*.off,0);let bl:i32=au_get32(b.*.len,0);
            if(nio_equal(g[bo..bo+bl],g[gs..gs+gl])==0){return 0;}
            return 1;
        }
        b.*.set[0]=1;
        au_put32(b.*.off,0,gs);au_put32(b.*.len,0,gl);
        return 1;
    }
    if(pk!=gk){return 0;}
    if(pk==0){return nio_equal(cx_head(pa,pr),cx_head(ga,gr));}
    if(pk==8){return 1;}
    if(pk==3){return cx_match_bvar(pa,cxch(pa,pr),ga,cxch(ga,gr),bvar,sh,b);}
    if(pk==7){
        if(nio_equal(cx_bvar(pa,pr),cx_bvar(ga,gr))==0){return 0;}
        let sh2:i32=sh;
        if(nio_equal(cx_bvar(pa,pr),bvar)==1){sh2=1;}
        return cx_match_bvar(pa,cxch(pa,pr),ga,cxch(ga,gr),bvar,sh2,b);
    }
    if(pk==1){
        if(nio_equal(cx_head(pa,pr),cx_head(ga,gr))==0){return 0;}
    }
    let pc:i32=cxch(pa,pr);let gc:i32=cxch(ga,gr);
    while(pc>=0 && gc>=0){
        if(cx_match_bvar(pa,pc,ga,gc,bvar,sh,b)==0){return 0;}
        pc=cxnx(pa,pc);gc=cxnx(ga,gc);
    }
    if(pc!=gc){return 0;}
    return 1;
}

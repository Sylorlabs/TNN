// QUOT engine (d): q_wl.zag — priority worklist, claim insert, generators.
// SPEC_QUOT §3: worklist priority is ONLY
//   (support_popcount, depth, schema_id, premise_ids_in_schema_order,
//    binding_bytes, conclusion_bytes), ascending, duplicate total keys omitted.
// Schemas: 0=S_MP, 1=S_PBC-direct, 2=S_UI, 10=SEED, 11=CONTRA(structural),
//          12=PBC-SUBPROOF, 13=ASSUME(subproof assumption).

struct QWI {
    pop:i32, dep:i32, sch:i32, uses:i32, root:i32, rante:i32, ranteln:i32,
    nprem:i32, prem0:i32, prem1:i32,
    bind:[]u8, concl:[]u8
}

// 1 if worklist item i is strictly less than the probe tuple
fn q_wl_less(g:*QG, i:i32, pop:i32, dep:i32, sch:i32,
             nprem:i32, prem0:i32, prem1:i32, bind:[]u8, concl:[]u8)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let a:i32=au_get32(w1.*.w_pop, i);
    if(a!=pop){ if(a<pop){return 1;} return 0; }
    let b:i32=au_get32(w1.*.w_dep, i);
    if(b!=dep){ if(b<dep){return 1;} return 0; }
    let c:i32=au_get32(w1.*.w_sch, i);
    if(c!=sch){ if(c<sch){return 1;} return 0; }
    // premise ids in schema order
    let pn:i32=au_get32(w2.*.w_premn, i);
    let po:i32=au_get32(w1.*.w_premo, i);
    let pa:[]u8=w2.*.pw_arena;
    let k:i32=0;
    while(k<nprem && k<pn){
        let x:i32=au_get32(pa, (po+k));
        let y:i32=0;
        if(k==0){ y=prem0; } else { y=prem1; }
        if(x!=y){ if(x<y){return 1;} return 0; }
        k=k+1;
    }
    if(pn!=nprem){ if(pn<nprem){return 1;} return 0; }
    // binding bytes
    let bo:i32=au_get32(w2.*.w_bindo, i);
    let bl:i32=au_get32(w2.*.w_bindl, i);
    let ba:[]u8=w3.*.bw_arena;
    let bc:i32=q_bytes_cmp(ba[bo..bo+bl],bind);
    if(bc!=0){ if(bc<0){return 1;} return 0; }
    // conclusion bytes
    let co:i32=au_get32(w2.*.w_conco, i);
    let cl:i32=au_get32(w2.*.w_concl, i);
    let ca:[]u8=w3.*.cw_arena;
    let cc:i32=q_bytes_cmp(ca[co..co+cl],concl);
    if(cc!=0){ if(cc<0){return 1;} return 0; }
    return 0;
}
// 1 if probe tuple is strictly less than worklist item i
fn q_probe_less(g:*QG, pop:i32, dep:i32, sch:i32,
                nprem:i32, prem0:i32, prem1:i32, bind:[]u8, concl:[]u8, i:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let a:i32=au_get32(w1.*.w_pop, i);
    if(pop!=a){ if(pop<a){return 1;} return 0; }
    let b:i32=au_get32(w1.*.w_dep, i);
    if(dep!=b){ if(dep<b){return 1;} return 0; }
    let c:i32=au_get32(w1.*.w_sch, i);
    if(sch!=c){ if(sch<c){return 1;} return 0; }
    let pn:i32=au_get32(w2.*.w_premn, i);
    let po:i32=au_get32(w1.*.w_premo, i);
    let pa:[]u8=w2.*.pw_arena;
    let k:i32=0;
    while(k<nprem && k<pn){
        let x:i32=au_get32(pa, (po+k));
        let y:i32=0;
        if(k==0){ y=prem0; } else { y=prem1; }
        if(y!=x){ if(y<x){return 1;} return 0; }
        k=k+1;
    }
    if(nprem!=pn){ if(nprem<pn){return 1;} return 0; }
    let bo:i32=au_get32(w2.*.w_bindo, i);
    let bl:i32=au_get32(w2.*.w_bindl, i);
    let ba:[]u8=w3.*.bw_arena;
    let bc:i32=q_bytes_cmp(bind,ba[bo..bo+bl]);
    if(bc!=0){ if(bc<0){return 1;} return 0; }
    let co:i32=au_get32(w2.*.w_conco, i);
    let cl:i32=au_get32(w2.*.w_concl, i);
    let ca:[]u8=w3.*.cw_arena;
    let cc:i32=q_bytes_cmp(concl,ca[co..co+cl]);
    if(cc!=0){ if(cc<0){return 1;} return 0; }
    return 0;
}
// enqueue one schema instance; 1=new, 0=duplicate, -1=overflow
fn q_enqueue(g:*QG, sch:i32, prem0:i32, prem1:i32, nprem:i32,
             bind:[]u8, concl:[]u8, root:i32, rante:i32, ranteln:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let nb:i32=su.*.nb;
    // support = OR of premise supports; popcount; dep; uses
    let sup:[]u8=qb_alloc(nb);
    let dep:i32=0;
    let uses:i32=0;
    if(nprem>0){
        qb_or(sup,sup,q_rsup(g,prem0),nb);
        let d:i32=au_get32(rc1.*.r_dep, prem0);
        if(d>dep){ dep=d; }
        uses=uses|au_get32(rc1.*.r_uses, prem0);
    }
    if(nprem>1){
        qb_or(sup,sup,q_rsup(g,prem1),nb);
        let d:i32=au_get32(rc1.*.r_dep, prem1);
        if(d>dep){ dep=d; }
        uses=uses|au_get32(rc1.*.r_uses, prem1);
    }
    dep=dep+1;
    let pop:i32=qb_popcount(sup,nb);
    nio_free(sup);
    // binary search: first index with NOT(item < probe)
    let lo:i32=0;
    let hi:i32=w2.*.wl_n;
    while(lo<hi){
        let m:i32=(lo+hi)>>1;
        if(q_wl_less(g,m,pop,dep,sch,nprem,prem0,prem1,bind,concl)==1){ lo=m+1; }
        else { hi=m; }
    }
    // duplicate iff probe NOT < item[lo]
    if(lo<w2.*.wl_n){
        if(q_probe_less(g,pop,dep,sch,nprem,prem0,prem1,bind,concl,lo)==0){
            return 0;
        }
    }
    let n:i32=w2.*.wl_n;
    // shift right: [lo..n) -> [lo+1..n+1)
    q_mmove32(w1.*.w_pop,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_dep,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_sch,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_uses,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_root,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_rante,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_ranteln,lo+1,lo,n-lo);
    q_mmove32(w1.*.w_premo,lo+1,lo,n-lo);
    q_mmove32(w2.*.w_premn,lo+1,lo,n-lo);
    q_mmove32(w2.*.w_bindo,lo+1,lo,n-lo);
    q_mmove32(w2.*.w_bindl,lo+1,lo,n-lo);
    q_mmove32(w2.*.w_conco,lo+1,lo,n-lo);
    q_mmove32(w2.*.w_concl,lo+1,lo,n-lo);
    au_put32(w1.*.w_pop, lo, pop);
    au_put32(w1.*.w_dep, lo, dep);
    au_put32(w1.*.w_sch, lo, sch);
    au_put32(w1.*.w_uses, lo, uses);
    au_put32(w1.*.w_root, lo, root);
    au_put32(w1.*.w_rante, lo, rante);
    au_put32(w1.*.w_ranteln, lo, ranteln);
    let po:i32=w2.*.pw_n;
    if(nprem>0){ au_put32(w2.*.pw_arena, po, prem0); }
    if(nprem>1){ au_put32(w2.*.pw_arena, (po+1), prem1); }
    w2.*.pw_n=po+nprem;
    au_put32(w1.*.w_premo, lo, po);
    au_put32(w2.*.w_premn, lo, nprem);
    let bo2:i32=w3.*.bw_n;
    let ba2:[]u8=w3.*.bw_arena;
    let i:i32=0;
    while(i<bind.len){ ba2[bo2+i]=bind[i]; i=i+1; }
    w3.*.bw_n=bo2+bind.len;
    au_put32(w2.*.w_bindo, lo, bo2);
    au_put32(w2.*.w_bindl, lo, bind.len);
    let co2:i32=w3.*.cw_n;
    let ca2:[]u8=w3.*.cw_arena;
    i=0;
    while(i<concl.len){ ca2[co2+i]=concl[i]; i=i+1; }
    w3.*.cw_n=co2+concl.len;
    au_put32(w2.*.w_conco, lo, co2);
    au_put32(w2.*.w_concl, lo, concl.len);
    w2.*.wl_n=n+1;
    mi.*.n_enq=mi.*.n_enq+1;
    return 1;
}
// pop head item into w (fields copied; arenas stable)
fn q_wl_pop(g:*QG, w:*QWI)void {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    w.*.pop=au_get32(w1.*.w_pop,0);
    w.*.dep=au_get32(w1.*.w_dep,0);
    w.*.sch=au_get32(w1.*.w_sch,0);
    w.*.uses=au_get32(w1.*.w_uses,0);
    w.*.root=au_get32(w1.*.w_root,0);
    w.*.rante=au_get32(w1.*.w_rante,0);
    w.*.ranteln=au_get32(w1.*.w_ranteln,0);
    w.*.nprem=au_get32(w2.*.w_premn,0);
    let po:i32=au_get32(w1.*.w_premo,0);
    let pa:[]u8=w2.*.pw_arena;
    w.*.prem0=-1; w.*.prem1=-1;
    if(w.*.nprem>0){ w.*.prem0=au_get32(pa, po); }
    if(w.*.nprem>1){ w.*.prem1=au_get32(pa, (po+1)); }
    let bo:i32=au_get32(w2.*.w_bindo,0);
    let bl:i32=au_get32(w2.*.w_bindl,0);
    let ba:[]u8=w3.*.bw_arena;
    w.*.bind=ba[bo..bo+bl];
    let co:i32=au_get32(w2.*.w_conco,0);
    let cl:i32=au_get32(w2.*.w_concl,0);
    let ca:[]u8=w3.*.cw_arena;
    w.*.concl=ca[co..co+cl];
    let n:i32=w2.*.wl_n;
    q_mmove32(w1.*.w_pop,0,1,n-1);
    q_mmove32(w1.*.w_dep,0,1,n-1);
    q_mmove32(w1.*.w_sch,0,1,n-1);
    q_mmove32(w1.*.w_uses,0,1,n-1);
    q_mmove32(w1.*.w_root,0,1,n-1);
    q_mmove32(w1.*.w_rante,0,1,n-1);
    q_mmove32(w1.*.w_ranteln,0,1,n-1);
    q_mmove32(w1.*.w_premo,0,1,n-1);
    q_mmove32(w2.*.w_premn,0,1,n-1);
    q_mmove32(w2.*.w_bindo,0,1,n-1);
    q_mmove32(w2.*.w_bindl,0,1,n-1);
    q_mmove32(w2.*.w_conco,0,1,n-1);
    q_mmove32(w2.*.w_concl,0,1,n-1);
    w2.*.wl_n=n-1;
    return;
}
// extend a rante chain: new node (parent, minor_rid); -1 on overflow
fn q_rante_extend(g:*QG, parent:i32, minor:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let node:i32=qar.*.rante_n;
    au_put32(qar.*.rante_arena,node*8,parent);
    au_put32(qar.*.rante_arena,node*8+4,minor);
    qar.*.rante_n=node+1;
    return node;
}

// ---------- generators ----------
// MP instance: minor premise `minor`, major premise `major` (imp)
fn q_enq_mp(g:*QG, minor:i32, major:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let conseq:[]u8=q_impconsq(g,major);
    let mlit:[]u8=q_rlit(g,minor);
    let ob:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    dout_init(&ob,4096);
    dout_str(&ob,"?0:="); dout_str(&ob,mlit);
    dout_str(&ob,";?1:="); dout_str(&ob,conseq);
    let bb:[]u8=dout_bytes(&ob);
    let bind:[]u8=nio_alloc(bb.len);
    let i:i32=0;
    while(i<bb.len){ bind[i]=bb[i]; i=i+1; }
    dout_free(&ob);
    let mroot:i32=au_get32(rc1.*.r_root, major);
    let rante:i32=-1;
    let ranteln:i32=0;
    if(mroot>=0){
        rante=q_rante_extend(g,au_get32(qar.*.r_rante, major),minor);
        if(rante<0){ nio_free(bind); return -1; }
        ranteln=au_get32(qar.*.r_ranteln, major)+1;
    }
    let r:i32=q_enqueue(g,0,minor,major,2,bind,conseq,mroot,rante,ranteln);
    nio_free(bind);
    if(r<0){ return -1; }
    return 0;
}
// UI instance: forall premise `far`
fn q_enq_ui(g:*QG, far:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let bv:[]u8=q_rfabv(g,far);
    let body:[]u8=q_rfabd(g,far);
    let froot:i32=au_get32(rc1.*.r_root, far);
    let frante:i32=au_get32(qar.*.r_rante, far);
    let frl:i32=au_get32(qar.*.r_ranteln, far);
    let ti:i32=0;
    while(ti<u1.*.u_n){
        let tt:[]u8=q_u_term(g,ti);
        if(nio_equal(tt,bv)==0){
            let a:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
            let rr:i32=-1;
            if(cxa_init(&a,body,128)==0){ rr=cx_parse(&a,body); }
            let oc:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
            dout_init(&oc,4096);
            if(rr>=0){ cx_subst(&a,rr,bv,tt,&oc); }
            nio_free(a.buf);
            if(oc.err==0){
                let cb:[]u8=dout_bytes(&oc);
                let concl:[]u8=nio_alloc(cb.len);
                let i:i32=0;
                while(i<cb.len){ concl[i]=cb[i]; i=i+1; }
                let ob:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                dout_init(&ob,4096);
                dout_str(&ob,"?0:="); dout_str(&ob,bv);
                dout_str(&ob,";?2:="); dout_str(&ob,tt);
                let bb:[]u8=dout_bytes(&ob);
                let bind:[]u8=nio_alloc(bb.len);
                i=0;
                while(i<bb.len){ bind[i]=bb[i]; i=i+1; }
                dout_free(&ob);
                let r:i32=q_enqueue(g,2,far,-1,1,bind,concl,froot,frante,frl);
                nio_free(bind); nio_free(concl);
                if(r<0){ dout_free(&oc); return -1; }
            }
            dout_free(&oc);
        }
        ti=ti+1;
    }
    return 0;
}
// PBC-direct instance: premise `pr` is imp(not(P),false)
fn q_enq_pbc(g:*QG, pr:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let P:[]u8=q_rpbcp(g,pr);
    let ob:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    dout_init(&ob,4096);
    dout_str(&ob,"?0:="); dout_str(&ob,P);
    let bb:[]u8=dout_bytes(&ob);
    let bind:[]u8=nio_alloc(bb.len);
    let i:i32=0;
    while(i<bb.len){ bind[i]=bb[i]; i=i+1; }
    dout_free(&ob);
    // PBC-direct from a rule claim: not rule-tracked (root=-1); the imp's own
    // rule application is not a contested-head MP/UI chain.
    let r:i32=q_enqueue(g,1,pr,-1,1,bind,P,-1,-1,0);
    nio_free(bind);
    if(r<0){ return -1; }
    return 0;
}
// enqueue every schema instance the new claim `rid` can feed
fn q_enq_for(g:*QG, rid:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let lit:[]u8=q_rlit(g,rid);
    // as MP minor: every imp claim whose antecedent == lit
    let ii:i32=0;
    while(ii<mz.*.imp_n){
        let jr:i32=au_get32(mz.*.imp_arena, ii);
        if(au_get32(rc1.*.r_dead, jr)==0 && nio_equal(q_impante(g,jr),lit)==1){
            if(q_enq_mp(g,rid,jr)!=0){ return -1; }
        }
        ii=ii+1;
    }
    // as MP major
    let rl:[]u8=q_rlit(g,rid);
    if(au_get32(rc3.*.r_impo, rid)>=0){
        let A:[]u8=q_impante(g,rid);
        let Apol:i32=q_pol_of(A);
        let si:i32=q_slot_find(g,q_atom_of(A,Apol));
        if(si>=0){
            let loff:i32=0;
            let lcnt:i32=0;
            if(Apol==0){ loff=au_get32(qp.*.sl_po, si); lcnt=au_get32(qp.*.sl_pn, si); }
            else { loff=au_get32(qp.*.sl_qo, si); lcnt=au_get32(qp.*.sl_qn, si); }
            let pl:[]u8=qp.*.pl_arena;
            let k:i32=0;
            while(k<lcnt){
                let mr:i32=au_get32(pl, (loff+k));
                if(au_get32(rc1.*.r_dead, mr)==0 && nio_equal(q_rlit(g,mr),A)==1){
                    if(q_enq_mp(g,mr,rid)!=0){ return -1; }
                }
                k=k+1;
            }
        }
    }
    // as UI premise
    if(au_get32(rc3.*.r_fabvo, rid)>=0){
        if(q_enq_ui(g,rid)!=0){ return -1; }
    }
    // as PBC-direct premise
    if(au_get32(rc3.*.r_pbco, rid)>=0){
        if(q_enq_pbc(g,rid)!=0){ return -1; }
    }
    return 0;
}

// ---------- insert ----------
// Insert (lit, sup); returns 1 if a new record (or new conflict) was added,
// 0 if no-op, -1 on resource overflow.
fn q_insert(g:*QG, lit:[]u8, pol:i32, sup:[]u8, dep:i32, sch:i32,
            prem0:i32, prem1:i32, nprem:i32, bind:[]u8,
            root:i32, rante:i32, ranteln:i32, uses:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let nb:i32=su.*.nb;
    let atom:[]u8=q_atom_of(lit,pol);
    let si:i32=q_slot_find(g,atom);
    if(si<0){
        si=q_slot_create(g,atom);
        if(si<0){ return -1; }
    }
    let loff:i32=0;
    let lcnt:i32=0;
    if(pol==0){
        let spo:[]u8=qp.*.sl_po;
        let spn:[]u8=qp.*.sl_pn;
        loff=au_get32(spo, si);
        lcnt=au_get32(spn, si);
    } else {
        let sqo:[]u8=qp.*.sl_qo;
        let sqn:[]u8=qp.*.sl_qn;
        loff=au_get32(sqo, si);
        lcnt=au_get32(sqn, si);
    }
    let pl:[]u8=qp.*.pl_arena;
    // no-op: an existing live record of a compatible class subsumes us
    let i:i32=0;
    while(i<lcnt){
        let er:i32=au_get32(pl, (loff+i));
        if(au_get32(rc1.*.r_dead, er)==0){
            let ru:i32=au_get32(rc1.*.r_uses, er);
            let rs:[]u8=q_rsup(g,er);

            if(ru==0 && uses==1){
                if(qb_subset(rs,sup,nb)==1){ return 0; }
            }
            if(ru==uses){
                if(qb_subset(rs,sup,nb)==1){ return 0; }
            }
        }
        i=i+1;
    }
    // prune same-class strict supersets; compact the list
    let w:i32=0;
    i=0;
    while(i<lcnt){
        let er:i32=au_get32(pl, (loff+i));
        let keep:i32=1;
        if(au_get32(rc1.*.r_dead, er)==0 && au_get32(rc1.*.r_uses, er)==uses){
            let rs:[]u8=q_rsup(g,er);
            if(qb_subset(sup,rs,nb)==1 && qb_equal(sup,rs,nb)==0){
                au_put32(rc1.*.r_dead, er, 1);
                keep=0;
            }
        }
        if(keep==1){ au_put32(pl, (loff+w), er); w=w+1; }
        i=i+1;
    }
    lcnt=w;
    let rid:i32=qrc2.*.nrec;
    qrc2.*.nrec=rid+1;
    au_put32(rc1.*.r_slot, rid, si);
    au_put32(rc1.*.r_pol, rid, pol);
    au_put32(rc1.*.r_dep, rid, dep);
    au_put32(rc1.*.r_sch, rid, sch);
    au_put32(rc1.*.r_root, rid, root);
    au_put32(rc1.*.r_uses, rid, uses);
    au_put32(rc1.*.r_hot, rid, 0);
    au_put32(rc1.*.r_dead, rid, 0);
    qb_copy(q_rsup(g,rid),sup,nb);
    let po:i32=qar.*.prem_n;
    if(nprem>0){ au_put32(qar.*.prem_arena, po, prem0); }
    if(nprem>1){ au_put32(qar.*.prem_arena, (po+1), prem1); }
    qar.*.prem_n=po+nprem;
    au_put32(qrc2.*.r_premo, rid, po);
    au_put32(qrc2.*.r_premn, rid, nprem);
    let bo:i32=mz.*.bind_n;
    let ba:[]u8=mz.*.bind_arena;
    i=0;
    while(i<bind.len){ ba[bo+i]=bind[i]; i=i+1; }
    mz.*.bind_n=bo+bind.len;
    au_put32(qrc2.*.r_bindo, rid, bo);
    au_put32(qrc2.*.r_bindl, rid, bind.len);
    au_put32(qar.*.r_rante, rid, rante);
    au_put32(qar.*.r_ranteln, rid, ranteln);
    let lo2:i32=qar.*.lit_n;
    let la:[]u8=qar.*.lit_arena;
    i=0;
    while(i<lit.len){ la[lo2+i]=lit[i]; i=i+1; }
    qar.*.lit_n=lo2+lit.len;
    au_put32(qrc2.*.r_lito, rid, lo2);
    au_put32(qrc2.*.r_litl, rid, lit.len);
    au_put32(qrc2.*.r_final, rid, q_rule_final(g,root,ranteln,lit));
    // parse the lit_arena-backed copy so cached offsets are absolute
    let lit2:[]u8=la[lo2..lo2+lit.len];
    q_cache_lit(g,rid,lit2);
    // grow the polarity list if full (bump-allocate a bigger chunk)
    let lcap:i32=0;
    if(pol==0){ lcap=au_get32(qp.*.sl_pcap, si); } else { lcap=au_get32(qp.*.sl_qcap, si); }
    if(lcnt>=lcap){
        let ncap:i32=lcap*2;
        let npln:i32=qp.*.pl_n;
        if(npln+ncap>262144){ return -1; }
        let kk:i32=0;
        while(kk<lcnt){ au_put32(pl, (npln+kk), au_get32(pl, (loff+kk))); kk=kk+1; }
        loff=npln;
        qp.*.pl_n=npln+ncap;
        if(pol==0){ au_put32(qp.*.sl_po, si, loff); au_put32(qp.*.sl_pcap, si, ncap); }
        else { au_put32(qp.*.sl_qo, si, loff); au_put32(qp.*.sl_qcap, si, ncap); }
    }
    // append to the slot list keeping (support lex, rid) order
    let ipos:i32=0;
    while(ipos<lcnt){
        let er:i32=au_get32(pl, (loff+ipos));
        let c:i32=qb_cmp(sup,q_rsup(g,er),nb);
        if(c<0 || (c==0 && rid<er)){ break; }
        ipos=ipos+1;
    }
    let j:i32=lcnt;
    while(j>ipos){ au_put32(pl, (loff+j), au_get32(pl, (loff+j-1))); j=j-1; }
    au_put32(pl, (loff+ipos), rid);
    lcnt=lcnt+1;
    if(pol==0){ au_put32(qp.*.sl_pn, si, lcnt); } else { au_put32(qp.*.sl_qn, si, lcnt); }
    if(au_get32(rc3.*.r_impo, rid)>=0){
        au_put32(mz.*.imp_arena, mz.*.imp_n, rid);
        mz.*.imp_n=mz.*.imp_n+1;
    }
    if(au_get32(rc3.*.r_fabvo, rid)>=0){
        au_put32(mz.*.fa_arena, mz.*.fa_n, rid);
        mz.*.fa_n=mz.*.fa_n+1;
    }
    mi.*.n_ins=mi.*.n_ins+1;
    let added_conf:i32=0;
    // conflict family (main derivations only; never inside a subproof)
    if(uses==0 && mi.*.sub==0){
        let ooff:i32=0;
        let ocnt:i32=0;
        if(pol==0){ ooff=au_get32(qp.*.sl_qo, si); ocnt=au_get32(qp.*.sl_qn, si); }
        else { ooff=au_get32(qp.*.sl_po, si); ocnt=au_get32(qp.*.sl_pn, si); }
        let k:[]u8=qb_alloc(nb);
        let oi:i32=0;
        while(oi<ocnt){
            let or2:i32=au_get32(pl, (ooff+oi));
            if(au_get32(rc1.*.r_dead, or2)==0 && au_get32(rc1.*.r_uses, or2)==0){
                qb_or(k,sup,q_rsup(g,or2),nb);
                let cr:i32=q_conflict_insert(g,k);
                if(cr<0){ nio_free(k); return -1; }
                added_conf=added_conf+cr;
            }
            oi=oi+1;
        }
        nio_free(k);
    }
    // enqueue schema instances fed by this claim
    if(q_enq_for(g,rid)!=0){ return -1; }
    // structural contradiction: P + ¬P -> false (both main and subproof)
    let ooff2:i32=0;
    let ocnt2:i32=0;
    if(pol==0){ ooff2=au_get32(qp.*.sl_qo, si); ocnt2=au_get32(qp.*.sl_qn, si); }
    else { ooff2=au_get32(qp.*.sl_po, si); ocnt2=au_get32(qp.*.sl_pn, si); }
    let oi2:i32=0;
    while(oi2<ocnt2){
        let or3:i32=au_get32(pl, (ooff2+oi2));
        if(au_get32(rc1.*.r_dead, or3)==0){
            let k2:[]u8=qb_alloc(nb);
            qb_or(k2,sup,q_rsup(g,or3),nb);
            let d1:i32=dep;
            let d2:i32=au_get32(rc1.*.r_dep, or3);
            if(d2>d1){ d1=d2; }
            let u2:i32=uses|au_get32(rc1.*.r_uses, or3);
            let cpol:i32=q_pol_of("false");
            let rr:i32=q_insert(g,"false",cpol,k2,d1+1,11,rid,or3,2,"CONTRA",-1,-1,0,u2);
            nio_free(k2);
            if(rr<0){ return -1; }
        }
        oi2=oi2+1;
    }
    au_put32(rc1.*.r_hot, rid, 1);
    return 1;
}

// ---------- drain ----------
fn q_drain(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let w:QWI=QWI{.pop=0,.dep=0,.sch=0,.uses=0,.root=0,.rante=0,.ranteln=0,.nprem=0,.prem0=0,.prem1=0,.bind="",.concl=""};
    let pw:*QWI=&w;
    while(w2.*.wl_n>0){
        q_wl_pop(g,pw);
        mz.*.n_pop=mz.*.n_pop+1;
        let ok:i32=1;
        if(pw.*.nprem>0 && au_get32(rc1.*.r_dead, pw.*.prem0)==1){ ok=0; }
        if(pw.*.nprem>1 && au_get32(rc1.*.r_dead, pw.*.prem1)==1){ ok=0; }
        if(pw.*.concl.len==18 && pw.*.concl[0]==110){
        }
        if(ok==1){
            let nb:i32=su.*.nb;
            let sup:[]u8=qb_alloc(nb);
            if(pw.*.nprem>0){ qb_or(sup,sup,q_rsup(g,pw.*.prem0),nb); }
            if(pw.*.nprem>1){ qb_or(sup,sup,q_rsup(g,pw.*.prem1),nb); }
            let pol:i32=q_pol_of(pw.*.concl);
            let r:i32=q_insert(g,pw.*.concl,pol,sup,pw.*.dep,pw.*.sch,
                               pw.*.prem0,pw.*.prem1,pw.*.nprem,pw.*.bind,
                               pw.*.root,pw.*.rante,pw.*.ranteln,pw.*.uses);
            if(pw.*.concl.len==18 && pw.*.concl[0]==110){
            }
            nio_free(sup);
            if(r<0){ return -1; }
        }
    }
    return 0;
}

// ---------- PBC subproof ----------
// Assume `ass` (uses=1, empty support), drain to fixpoint. If false is derived
// with uses=1, copy its support to out_sup and depth to od, return 1.
// Otherwise return 0. Sweeps all uses=1 records afterwards. -1 on overflow.
fn q_subproof(g:*QG, ass:[]u8, out_sup:[]u8, od:*i32) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    mi.*.sub=1;
    let nb:i32=su.*.nb;
    let z:[]u8=qb_alloc(nb);
    let apol:i32=q_pol_of(ass);
    let r:i32=q_insert(g,ass,apol,z,0,13,-1,-1,0,"ASSUME",-1,-1,0,1);
    nio_free(z);
    if(r<0){ mi.*.sub=0; return -1; }
    if(q_drain(g)!=0){ mi.*.sub=0; return -1; }
    let found:i32=0;
    let fsi:i32=q_slot_find(g,"false");
    if(fsi>=0){
        let loff:i32=au_get32(qp.*.sl_po, fsi);
        let lcnt:i32=au_get32(qp.*.sl_pn, fsi);
        let pl:[]u8=qp.*.pl_arena;
        let best:i32=-1;
        let i:i32=0;
        while(i<lcnt){
            let er:i32=au_get32(pl, (loff+i));
            if(au_get32(rc1.*.r_dead, er)==0 && au_get32(rc1.*.r_uses, er)==1){
                if(best<0){ best=er; }
                else {
                    let p1:i32=qb_popcount(q_rsup(g,er),nb);
                    let p2:i32=qb_popcount(q_rsup(g,best),nb);
                    if(p1<p2 || (p1==p2 && qb_cmp(q_rsup(g,er),q_rsup(g,best),nb)<0)){ best=er; }
                }
            }
            i=i+1;
        }
        if(best>=0){
            qb_copy(out_sup,q_rsup(g,best),nb);
            od.*=au_get32(rc1.*.r_dep, best);
            found=1;
        }
    }
    let i:i32=0;
    while(i<qrc2.*.nrec){
        if(au_get32(rc1.*.r_uses, i)==1){ au_put32(rc1.*.r_dead, i, 1); }
        i=i+1;
    }
    mi.*.sub=0;
    return found;
}
// build the literal for (slot si, polarity p) into o
fn q_lit_for(g:*QG, si:i32, p:i32, o:*DOut)void {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let ao:[]u8=qs.*.sl_atom;
    let aoff:i32=au_get32(qs.*.sl_ao, si);
    let alen:i32=au_get32(qs.*.sl_al, si);
    let atom:[]u8=ao[aoff..aoff+alen];
    if(p==1){ dout_str(o,"not("); dout_str(o,atom); dout_str(o,")"); }
    else { dout_str(o,atom); }
    return;
}
// one PBC round over all slots/polarities; returns #new records, -1 overflow
fn q_pbc_round(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let added:i32=0;
    let nsl:i32=qs.*.nslots;
    let si:i32=0;
    while(si<nsl){
        let p:i32=0;
        while(p<2){
            let ol:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
            dout_init(&ol,4096);
            q_lit_for(g,si,p,&ol);
            let L:[]u8=dout_bytes(&ol);
            if(ol.err==0 && q_is_false(L)==0){
                let oa:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                dout_init(&oa,4096);
                q_lit_for(g,si,1-p,&oa);
                let ass:[]u8=dout_bytes(&oa);
                if(oa.err==0){
                    let nb:i32=su.*.nb;
                    let fsup:[]u8=qb_alloc(nb);
                    let fdep:i32=0;
                    let ok:i32=q_subproof(g,ass,fsup,&fdep);
                    if(ok<0){ nio_free(fsup); dout_free(&oa); dout_free(&ol); return -1; }
                    if(ok==1){
                        let rr:i32=q_insert(g,L,p,fsup,fdep+1,12,-1,-1,0,"PBC-SUB",-1,-1,0,0);
                        nio_free(fsup);
                        if(rr<0){ dout_free(&oa); dout_free(&ol); return -1; }
                        added=added+rr;
                    } else { nio_free(fsup); }
                }
                dout_free(&oa);
            }
            dout_free(&ol);
            p=p+1;
        }
        si=si+1;
    }
    return added;
}
// fixpoint: drain, then PBC rounds until no new records
fn q_fixpoint(g:*QG) i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    if(q_drain(g)!=0){ return -1; }
    let rnd:i32=0;
    while(1){
        rnd=rnd+1;
        let a:i32=q_pbc_round(g);
        if(a<0){ return -1; }
        if(a==0){ break; }
        if(q_drain(g)!=0){ return -1; }
    }
    return 0;
}

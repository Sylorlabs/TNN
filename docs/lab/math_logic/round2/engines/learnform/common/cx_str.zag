// cx_str.zag — small string/byte helpers for the engine common core.
// Textual-include order: R33_NATIVE_IO_V1.zag, dlb_util.zag, then this file.
// Pure Zag, zero RNG, deterministic.

fn cx_is_ws(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}
fn cx_trim(s:[]u8)[]u8 {
    let a:i32=0;let b:i32=s.len;
    while(a<b && cx_is_ws(s[a])==1){a=a+1;}
    while(b>a && cx_is_ws(s[b-1])==1){b=b-1;}
    return s[a..b];
}
fn cx_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    return nio_equal(s[0..pre.len],pre);
}
fn cx_copy(s:[]u8)[]u8 {
    if(s.len==0){return "";}
    let t:[]u8=nio_alloc(s.len);
    if(t.len!=s.len){return "";}
    let i:i32=0;
    while(i<s.len){t[i]=s[i];i=i+1;}
    return t;
}
fn cx_concat(a:[]u8,b:[]u8)[]u8 {
    let t:[]u8=nio_alloc(a.len+b.len);
    if(t.len!=a.len+b.len){return "";}
    let i:i32=0;
    while(i<a.len){t[i]=a[i];i=i+1;}
    let j:i32=0;
    while(j<b.len){t[a.len+j]=b[j];j=j+1;}
    return t;
}
// next line from buf at *pos (without the \n); advances *pos past \n.
// Returns empty slice at EOF (pos>=len). A truly empty line also returns
// empty — callers distinguish via *pos advancement.
fn cx_next_line(buf:[]u8,pos:*i32)[]u8 {
    let p:i32=pos.*;
    if(p>=buf.len){return "";}
    let e:i32=p;
    while(e<buf.len && buf[e]!=10){e=e+1;}
    let line:[]u8=buf[p..e];
    if(e<buf.len){e=e+1;}
    pos.*=e;
    return line;
}
// FNV-1a 64-bit over bytes. i64 wraps mod 2^64, same bit pattern as u64.
fn cx_fnv1a(s:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let i:i32=0;
    while(i<s.len){
        h=h ^ (s[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// write 16 lowercase hex chars of v's bit pattern into o (needs >=16 bytes)
fn cx_hex16(v:i64,o:[]u8)void {
    let i:i32=0;
    while(i<16){
        let nib:i64=(v>>((15-i)*4))&15;
        let c:u8=(48+nib) as u8;
        if(nib>=10){c=(87+nib) as u8;}
        o[i]=c;i=i+1;
    }
}
fn cx_hex16s(v:i64)[]u8 {
    let o:[]u8=nio_alloc(16);
    if(o.len!=16){return "";}
    cx_hex16(v,o);
    return o;
}

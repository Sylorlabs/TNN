// cx_schemas.zag — the three committed inference schemas.
// Canonical bytes and FNV-1a-64 hashes per COMMIT_SCHEMAS.md (commit
// a8a04d760e2561a40f3805e934d1d873802a6fee). Startup assertion: exit(6)
// path on mismatch — engines must call cx_sch_assert() before deriving.
// id: 0 = S_MP, 1 = S_PBC, 2 = S_UI.

fn cx_sch_bytes(id:i32)[]u8 {
    if(id==0){return "S_MP|?0|imp(?0,?1)|?1";}
    if(id==1){return "S_PBC|imp(not(?0),false)|?0";}
    return "S_UI|forall(?0,?1)|SUBST(?1,?0,?2)";
}
fn cx_sch_hex(id:i32)[]u8 {
    if(id==0){return "62cc41ffd582e687";}
    // CEREMONY DEFECT #1 (reported, not silently edited): COMMIT_SCHEMAS.md
    // lists S_PBC's hash as the 17-char string "0369efe53016bbe1a"
    // (spurious leading zero; not a valid 64-bit hex). The true FNV-1a-64 of
    // the committed canonical bytes is "369efe53016bbe1a" (16 chars), which
    // is what the startup assertion checks. Canonical bytes are unaffected.
    if(id==1){return "369efe53016bbe1a";}
    return "b2f909c7d7b67f55";
}
// number of antecedent patterns
fn cx_sch_nant(id:i32)i32 {
    if(id==0){return 2;}
    return 1;
}
// k-th antecedent pattern bytes (parsed by the engine at startup)
fn cx_sch_ant(id:i32,k:i32)[]u8 {
    if(id==0){
        if(k==0){return "?0";}
        return "imp(?0,?1)";
    }
    if(id==1){return "imp(not(?0),false)";}
    return "forall(?0,?1)";
}
// consequent template: for S_MP "?1", S_PBC "?0", S_UI = special SUBST form
fn cx_sch_con(id:i32)[]u8 {
    if(id==0){return "?1";}
    if(id==1){return "?0";}
    return "SUBST(?1,?0,?2)";
}
// 0 = all three schemas verify; else (id+1) of first failure
fn cx_sch_assert()i32 {
    let id:i32=0;
    while(id<3){
        let h:i64=cx_fnv1a(cx_sch_bytes(id));
        let hx:[]u8=cx_hex16s(h);
        if(nio_equal(hx,cx_sch_hex(id))==0){nio_free(hx);return id+1;}
        nio_free(hx);
        id=id+1;
    }
    return 0;
}

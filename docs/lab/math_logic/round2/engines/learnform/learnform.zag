// learnform.zag — Engine (c) LEARN-FORM: learned NL->schema formalizer +
// ONE's match-and-bind derivation core.
//
// Two modes, argv-selected:
//   learnform_bin learn <kb_md> <schemas_md> <b1_list> <pair_nl> <pair_form> <trace_list> <store_out> <ledger_out>
//       Stage 1 (the learner). Runs BEFORE the battery, frozen after.
//       Training evidence ONLY: frozen round-1 traces + KNOWLEDGE_STORE.md +
//       the B1 NL statements + the single B1 NL->formal pair (P01).
//       Extracts formalization patterns (byte-level structural cues),
//       resolves competing patterns by frequency, drops patterns that never
//       fire on training evidence. Every retained pattern cites the evidence
//       lines that produced it. The pattern store starts EMPTY: it is
//       written by this run (truncating write); the learner takes no store
//       as input. Output: FORMALIZER_STORE + PROVENANCE_LEDGER.
//   learnform_bin solve <nl_problem> <formalizer_store> <kb_store> <out>
//       Stage 2 (the solver). Applies the frozen store to one NL problem:
//       fires learned cues -> builds a .form -> runs ONE's core below.
//       No applicable pattern -> FORMALIZE-ABSTAIN (exit 0, recorded).
//
// Exit: 0 ok (incl. abstain); 3 sealed-guard; 4 input/alloc; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG, deterministic given inputs. No timestamps anywhere.

// ---- vendored dependencies (byte copies of round-1 sources; import lines
// stripped from cx_fwd.zag only; SHAs recorded in BUILD_LEARNFORM.md) ----
@import("harness/R33_NATIVE_IO_V1.zag")
@import("harness/dlb_util.zag")
@import("common/cx_str.zag")
@import("common/cx_claim.zag")
@import("common/cx_match.zag")
@import("common/cx_store.zag")
@import("common/cx_schemas.zag")
@import("common/cx_io.zag")
@import("common/cx_fwd.zag")

// =====================================================================
// VERBATIM ONE CORE (the experiment is the formalizer, not a new prover).
// one_emit + one_run copied byte-identical from round-1 engines/one/one.zag
// (SHA-256 0bdbfe52f7f63f2192e32455a5af22fb71b0b5b3d6bc0e8e09eb449e189b25df),
// minus main. No edits.
// =====================================================================
fn one_emit(o:*DOut,pid:[]u8,verdict:[]u8,claim:[]u8,conf:i32,deriv:i32,flags:[]u8,s:*CXS,sp:*DOut)void {
    dout_str(o,"ID: ");dout_str(o,pid);dout_line(o);
    dout_str(o,"ENGINE: one");dout_line(o);
    dout_str(o,"VERDICT: ");dout_str(o,verdict);dout_line(o);
    dout_str(o,"CLAIM: ");dout_str(o,claim);dout_line(o);
    dout_str(o,"CONFIDENCE: ");dout_i64(o,conf as i64);dout_line(o);
    dout_str(o,"DERIVATIONS: ");dout_i64(o,deriv as i64);dout_line(o);
    dout_str(o,"SCHEMAS: S_MP=");dout_str(o,cx_sch_hex(0));
    dout_str(o," S_PBC=");dout_str(o,cx_sch_hex(1));
    dout_str(o," S_UI=");dout_str(o,cx_sch_hex(2));dout_line(o);
    dout_str(o,"FLAGS: ");dout_str(o,flags);dout_line(o);
    dout_str(o,"AUDIT:");dout_line(o);
    let i:i32=0;
    while(i<s.*.n){
        dout_str(o,"C");dout_i64(o,i as i64);
        dout_str(o,": ");dout_str(o,cxs_bytes(s,i));
        dout_str(o," [");dout_str(o,cxs_audit(s,i));dout_str(o,"]");
        dout_line(o);
        i=i+1;
    }
    if(sp.*.n>0){
        dout_str(o,"SUBPROOFS:");dout_line(o);
        dout_str(o,dout_bytes(sp));
    }
}

// one full run into o. Returns 0 ok, 3 sealed, 4 input, 6 schema.
fn one_run(o:*DOut,fbuf:[]u8,flen:i32,sbuf:[]u8,sn:i32,bound:i32)i32 {
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen,&f,512)!=0){return 4;}
    let k:CXK=CXK{.kid_off:"",.kid_len:"",.kcl_off:"",.kcl_len:"",.nk:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_store(sbuf,sn,&k,512)!=0){return -4;}
    if(cx_sch_assert()!=0){return 6;}
    let p:ONEP=ONEP{.a_mp1:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp1:0,.a_mp2:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp2:0,.a_pb:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_pb:0,.a_ui:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_ui:0};
    if(onep_init(&p)!=0){return 4;}
    let s:CXS=CXS{.n:0,.cap:0,.data:"",.dn:0,.dcap:0,.coff:"",.clen:"",.aoff:"",.alen:"",.dep:"",.kind:"",.deriv:0};
    if(cxs_init(&s,4096,2097152)!=0){return 4;}
    // load store claims as premises
    let i:i32=0;
    while(i<k.nk){
        let kb:[]u8=cx_kclaim(&k,i);
        let cb:[]u8=cx_canon(kb);
        if(cb.len>0){
            let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ao,128)==0){
                dout_str(&ao,"PREM ");dout_str(&ao,cx_kid(&k,i));
                let ab:[]u8=cx_copy(dout_bytes(&ao));
                dout_free(&ao);
                cxs_add(&s,cb,ab,0,0);
                nio_free(cb);nio_free(ab);
            }
        }
        i=i+1;
    }
    // load problem premises
    i=0;
    while(i<f.nprem){
        let pb:[]u8=cx_prem(&f,i);
        let cb:[]u8=cx_canon(pb);
        if(cb.len==0){return 4;}
        let ab:[]u8=cx_copy("PREM");
        cxs_add(&s,cb,ab,0,0);
        nio_free(cb);nio_free(ab);
        i=i+1;
    }
    let t:[]u8=cx_canon(f.target);
    if(t.len==0){return 4;}
    let nt:[]u8=cx_concat("not(",t);
    let nt2:[]u8=cx_concat(nt,")");
    nio_free(nt);
    let sp:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sp,8192)!=0){return 4;}
    // D_T: derive target (forward, then PBC subproof)
    let dT:i32=one_bfs(&s,&p,bound,0,t,1);
    if(dT==0){
        let pr:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&pr,8192)==0){
            let r:i32=one_pbc_for(&s,&p,t,bound,&pr);
            if(r==1){
                dout_str(&sp,"SP for target: ");
                dout_str(&sp,dout_bytes(&pr));
                let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                if(dout_init(&ao,256)==0){
                    dout_str(&ao,"S_PBC ASSUME:not(T) FALSE_DERIVED");
                    let ab:[]u8=cx_copy(dout_bytes(&ao));
                    dout_free(&ao);
                    cxs_add(&s,t,ab,1,1);
                    nio_free(ab);
                }
                dT=1;
            }
            dout_free(&pr);
        }
    }
    // D_N: derive not(target) (forward, then PBC subproof)
    let dN:i32=one_bfs(&s,&p,bound,0,nt2,1);
    if(dN==0){
        let pr:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&pr,8192)==0){
            let r:i32=one_pbc_for(&s,&p,nt2,bound,&pr);
            if(r==1){
                dout_str(&sp,"SP for not(target): ");
                dout_str(&sp,dout_bytes(&pr));
                let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                if(dout_init(&ao,256)==0){
                    dout_str(&ao,"S_PBC ASSUME:not(not(T)) FALSE_DERIVED");
                    let ab:[]u8=cx_copy(dout_bytes(&ao));
                    dout_free(&ao);
                    let nb:[]u8=cx_copy(nt2);
                    cxs_add(&s,nb,ab,1,1);
                    nio_free(nb);nio_free(ab);
                }
                dN=1;
            }
            dout_free(&pr);
        }
    }
    let verdict:[]u8="WITHHELD";let claim:[]u8="-";let conf:i32=0;
    let flags:[]u8="NONE";
    if(dT==1 && dN==0){verdict="DERIVED";claim=t;conf=1;}
    if(dN==1 && dT==0){verdict="REFUTED";claim=nt2;conf=1;}
    if(dT==1 && dN==1){verdict="WITHHELD";claim="";conf=0;flags="CONTRADICTION_DERIVED";}
    one_emit(o,f.id,verdict,claim,conf,s.deriv,flags,&s,&sp);
    nio_free(nt2);nio_free(t);
    return 0;
}
// =================== END VERBATIM ONE CORE ===================

// =====================================================================
// LEARN-FORM machinery (new code for engine (c); pure Zag, zero RNG).
// No hand-written NL->schema mappings: every cue word below is discovered
// from the frozen evidence at learn time (see lf_learn). The only literals
// in this file are schema IDs (the engine's own commitment), punctuation,
// and field/section markers of the frozen file formats.
// =====================================================================

fn lf_is_alpha(c:u8)i32 {
    if(c>=97 && c<=122){return 1;}
    if(c>=65 && c<=90){return 1;}
    return 0;
}
fn lf_is_alnum(c:u8)i32 {
    if(lf_is_alpha(c)==1){return 1;}
    if(c>=48 && c<=57){return 1;}
    return 0;
}
fn lf_tolower(c:u8)u8 {
    if(c>=65 && c<=90){return ((c as i64)+32) as u8;}
    return c;
}
// next token: maximal alnum run (alpha_only=1: alpha run), lowercased into
// tbuf. Returns token length (0 = none left); *pos advances past the token.
fn lf_next_tok(buf:[]u8,n:i32,pos:*i32,tbuf:[]u8,alpha_only:i32)i32 {
    let p:i32=pos.*;
    while(p<n){
        let c:u8=buf[p];
        let ok:i32=lf_is_alnum(c);
        if(alpha_only==1){ok=lf_is_alpha(c);}
        if(ok==1){break;}
        p=p+1;
    }
    let o:i32=0;
    while(p<n && o<tbuf.len){
        let c2:u8=buf[p];
        let ok2:i32=lf_is_alnum(c2);
        if(alpha_only==1){ok2=lf_is_alpha(c2);}
        if(ok2==0){break;}
        tbuf[o]=lf_tolower(c2);o=o+1;p=p+1;
    }
    pos.*=p;
    return o;
}
// next raw whitespace-delimited token (keeps punctuation like parens).
// Used for formal premises/targets, which are not natural-language words.
fn lf_next_raw(buf:[]u8,n:i32,pos:*i32,tbuf:[]u8)i32 {
    let p:i32=pos.*;
    while(p<n && (buf[p]==32 || buf[p]==9)){p=p+1;}
    let tl:i32=0;
    while(p<n && tl<63 && buf[p]!=32 && buf[p]!=9 && buf[p]!=10 && buf[p]!=13){
        tbuf[tl]=buf[p];tl=tl+1;p=p+1;
    }
    pos.*=p;
    return tl;
}
fn lf_contains(h:[]u8,nd:[]u8)i32 {
    if(nd.len==0){return 1;}
    if(nd.len>h.len){return 0;}
    let i:i32=0;
    while(i+nd.len<=h.len){
        if(nio_equal(h[i..i+nd.len],nd)==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn lf_count_sub(h:[]u8,n:i32,nd:[]u8)i32 {
    if(nd.len==0 || nd.len>n){return 0;}
    let c:i32=0;
    let i:i32=0;
    while(i+nd.len<=n){
        if(nio_equal(h[i..i+nd.len],nd)==1){c=c+1;i=i+nd.len;continue;}
        i=i+1;
    }
    return c;
}
fn lf_line_no(buf:[]u8,off:i32)i32 {
    let ln:i32=1;
    let i:i32=0;
    while(i<off && i<buf.len){if(buf[i]==10){ln=ln+1;}i=i+1;}
    return ln;
}
// value of a line-start KEY through EOF (trimmed). STATEMENT is last field.
fn lf_field_rest(buf:[]u8,n:i32,key:[]u8)[]u8 {
    let i:i32=0;
    while(i<n){
        let ls:i32=1;
        if(i>0 && buf[i-1]!=10){ls=0;}
        if(ls==1){
            let k:i32=0;
            while(k<key.len && i+k<n && buf[i+k]==key[k]){k=k+1;}
            if(k==key.len){
                let s:i32=i+k;
                let e:i32=n;
                while(e>s && (buf[e-1]==10 || buf[e-1]==13 || buf[e-1]==32 || buf[e-1]==9)){e=e-1;}
                return buf[s..e];
            }
        }
        i=i+1;
    }
    return "";
}
// schema id -> engine's own schema name bytes (not an NL mapping)
fn lf_sch_name(s:i32)[]u8 {
    if(s==0){return "S_MP";}
    if(s==1){return "S_PBC";}
    return "S_UI";
}
fn lf_sch_idbytes(s:i32)[]u8 {
    if(s==0){return "MP";}
    if(s==1){return "PBC";}
    return "UI";
}

// ---- word table: candidate cue words (evidence-discovered) ----
struct LFWT {
    buf:[]u8, off:[]u8, len:[]u8,
    ac:[]u8, cite:[]u8,
    n:i32, cap:i32, blen:i32, bcap:i32
}
struct LFWR {
    schema:[]u8, fire:[]u8, firen:[]u8, seen:[]u8, fmask:[]u8
}
fn lfwt_init(w:*LFWT,r:*LFWR,cap:i32,bcap:i32)i32 {
    w.*.buf=nio_alloc(bcap);
    w.*.off=nio_alloc(cap*4);
    w.*.len=nio_alloc(cap*4);
    w.*.ac=nio_alloc(cap*12);
    w.*.cite=nio_alloc(cap*4);
    r.*.schema=nio_alloc(cap*4);
    r.*.fire=nio_alloc(cap*4);
    r.*.firen=nio_alloc(cap*4);
    r.*.seen=nio_alloc(cap*4);
    r.*.fmask=nio_alloc(cap*4);
    if(w.*.buf.len!=bcap || w.*.off.len!=cap*4 || w.*.len.len!=cap*4){return -1;}
    if(w.*.ac.len!=cap*12 || w.*.cite.len!=cap*4){return -1;}
    if(r.*.schema.len!=cap*4 || r.*.fire.len!=cap*4){return -1;}
    if(r.*.firen.len!=cap*4 || r.*.seen.len!=cap*4){return -1;}
    if(r.*.fmask.len!=cap*4){return -1;}
    w.*.n=0;w.*.cap=cap;w.*.blen=0;w.*.bcap=bcap;
    let i:i32=0;
    while(i<cap){au_put32(r.*.schema,i,-1);i=i+1;}
    let j:i32=0;
    while(j<cap*3){au_put32(w.*.ac,j,0);j=j+1;}
    let k:i32=0;
    while(k<cap){
        au_put32(w.*.cite,k,0);
        au_put32(r.*.fire,k,0);
        au_put32(r.*.firen,k,0);
        au_put32(r.*.seen,k,0);
        au_put32(r.*.fmask,k,0);
        k=k+1;
    }
    return 0;
}
fn lfwt_find(w:*LFWT,word:[]u8)i32 {
    let buf:[]u8=w.*.buf;
    let i:i32=0;
    while(i<w.*.n){
        let o:i32=au_get32(w.*.off,i);
        let l:i32=au_get32(w.*.len,i);
        if(l==word.len && nio_equal(buf[o..o+l],word)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn lfwt_add(w:*LFWT,word:[]u8)i32 {
    let f:i32=lfwt_find(w,word);
    if(f>=0){return f;}
    if(w.*.n>=w.*.cap){return -1;}
    if(w.*.blen+word.len>w.*.bcap){return -1;}
    let buf:[]u8=w.*.buf;
    let i:i32=0;
    while(i<word.len){buf[w.*.blen+i]=word[i];i=i+1;}
    au_put32(w.*.off,w.*.n,w.*.blen);
    au_put32(w.*.len,w.*.n,word.len);
    au_put32(w.*.cite,w.*.n,0);
    w.*.blen=w.*.blen+word.len;
    w.*.n=w.*.n+1;
    return w.*.n-1;
}
fn lfwt_word(w:*LFWT,idx:i32)[]u8 {
    let buf:[]u8=w.*.buf;
    let o:i32=au_get32(w.*.off,idx);
    let l:i32=au_get32(w.*.len,idx);
    return buf[o..o+l];
}
fn lfwt_add_anchor(w:*LFWT,word:[]u8,schema:i32,ksl:i32)i32 {
    let f:i32=lfwt_find(w,word);
    if(f<0){
        f=lfwt_add(w,word);
        if(f<0){return -1;}
        au_put32(w.*.cite,f,ksl);
    }
    if(f<0){return -1;}
    let c:i32=au_get32(w.*.ac,f*3+schema);
    au_put32(w.*.ac,f*3+schema,c+1);
    return f;
}
fn lfwt_set_schema(w:*LFWT,r:*LFWR,word:[]u8,schema:i32)i32 {
    let f:i32=lfwt_find(w,word);
    if(f<0){f=lfwt_add(w,word);}
    if(f<0){return -1;}
    au_put32(r.*.schema,f,schema);
    return f;
}
// resolve competing anchor counts: argmax count, ties -> lower schema id
fn lfwt_resolve(w:*LFWT,r:*LFWR)void {
    let i:i32=0;
    while(i<w.*.n){
        let best:i32=-1;
        let bn:i32=0;
        let s:i32=0;
        while(s<3){
            let c:i32=au_get32(w.*.ac,i*3+s);
            if(c>bn){bn=c;best=s;}
            s=s+1;
        }
        au_put32(r.*.schema,i,best);
        i=i+1;
    }
    return;
}
// fire candidates on one doc (doc = 1-based id); dedupes within doc
fn lfwt_fire_doc(w:*LFWT,r:*LFWR,buf:[]u8,n:i32,doc:i32)void {
    let tbuf:[]u8=nio_alloc(64);
    if(tbuf.len!=64){return;}
    let pos:i32=0;
    while(pos<n){
        let tl:i32=lf_next_tok(buf,n,&pos,tbuf,1);
        if(tl>=3){
            let tok:[]u8=tbuf[0..tl];
            let f:i32=lfwt_find(w,tok);
            if(f>=0 && au_get32(r.*.schema,f)>=0){
                au_put32(r.*.firen,f,au_get32(r.*.firen,f)+1);
                if(au_get32(r.*.seen,f)!=doc){
                    au_put32(r.*.seen,f,doc);
                    au_put32(r.*.fire,f,au_get32(r.*.fire,f)+1);
                    let bit:i32=1<<(doc-1);
                    let m2:i32=au_get32(r.*.fmask,f);
                    au_put32(r.*.fmask,f,m2|bit);
                }
            }
        }
        if(tl==0){break;}
    }
    nio_free(tbuf);
    return;
}
// stopword doc-frequency bump (alnum tokens, len>=2)
fn lfwt_bump_df(w:*LFWT,r:*LFWR,buf:[]u8,n:i32,doc:i32)i32 {
    let tbuf:[]u8=nio_alloc(64);
    if(tbuf.len!=64){return -1;}
    let pos:i32=0;
    while(pos<n){
        let tl:i32=lf_next_tok(buf,n,&pos,tbuf,0);
        if(tl>=2){
            let tok:[]u8=tbuf[0..tl];
            let f:i32=lfwt_find(w,tok);
            if(f<0){f=lfwt_add(w,tok);}
            if(f<0){nio_free(tbuf);return -1;}
            if(au_get32(r.*.seen,f)!=doc){
                au_put32(r.*.seen,f,doc);
                au_put32(r.*.fire,f,au_get32(r.*.fire,f)+1);
            }
        }
        if(tl==0){break;}
    }
    nio_free(tbuf);
    return 0;
}
// learned template: task word -> formal skeleton (from the B1 NL->formal pair)
struct LFTPL {
    task:[]u8, nprem:i32,
    pbuf:[]u8, poff:[]u8, plen:[]u8,
    target:[]u8, cite:[]u8
}
fn lftpl_init(t:*LFTPL)i32 {
    t.*.pbuf=nio_alloc(2048);
    t.*.poff=nio_alloc(32);
    t.*.plen=nio_alloc(32);
    if(t.*.pbuf.len!=2048 || t.*.poff.len!=32 || t.*.plen.len!=32){return -1;}
    t.*.task="";t.*.nprem=0;t.*.target="";t.*.cite="";
    return 0;
}
fn lftpl_add_prem(t:*LFTPL,p:[]u8)i32 {
    if(t.*.nprem>=8){return -1;}
    let cur:i32=0;
    if(t.*.nprem>0){
        cur=au_get32(t.*.poff,t.*.nprem-1)+au_get32(t.*.plen,t.*.nprem-1);
    }
    if(cur+p.len>2048){return -1;}
    let b:[]u8=t.*.pbuf;
    let i:i32=0;
    while(i<p.len){b[cur+i]=p[i];i=i+1;}
    au_put32(t.*.poff,t.*.nprem,cur);
    au_put32(t.*.plen,t.*.nprem,p.len);
    t.*.nprem=t.*.nprem+1;
    return 0;
}
fn lftpl_prem(t:*LFTPL,i:i32)[]u8 {
    let b:[]u8=t.*.pbuf;
    let o:i32=au_get32(t.*.poff,i);
    let l:i32=au_get32(t.*.plen,i);
    return b[o..o+l];
}
// fnv-1a-64 of file bytes as 16 hex chars (owned)
fn lf_file_fnv(p:[]u8)[]u8 {
    let b:[]u8=nio_alloc(1048576);
    if(b.len==0){return "";}
    let n:i64=cx_guarded_read(p,b);
    if(n==-99 || n<=0){nio_free(b);return "";}
    let hx:[]u8=cx_hex16s(cx_fnv1a(b[0..n as i32]));
    nio_free(b);
    return hx;
}
fn lf_emit_input(o:*DOut,role:[]u8,p:[]u8)void {
    dout_str(o,"INPUT ");
    dout_str(o,role);
    dout_str(o," ");
    let hx:[]u8=lf_file_fnv(p);
    if(hx.len==16){dout_str(o,hx);}else{dout_str(o,"UNREADABLE");}
    nio_free(hx);
    dout_str(o," ");
    dout_str(o,p);
    dout_line(o);
    return;
}

// ---- Stage 1: the learner ----

// value of line-start KEY through EOF (trimmed). STATEMENT is last field.
fn lf_marker_off(buf:[]u8,n:i32,marker:[]u8)i32 {
    let i:i32=0;
    while(i+marker.len<=n){
        let ls:i32=1;
        if(i>0 && buf[i-1]!=10){ls=0;}
        if(ls==1 && nio_equal(buf[i..i+marker.len],marker)==1){return i+marker.len;}
        i=i+1;
    }
    return -1;
}
// token right after a marker; lowercased into tbuf. "" if absent.
fn lf_after_token(buf:[]u8,n:i32,marker:[]u8,tbuf:[]u8)[]u8 {
    let i:i32=0;
    while(i+marker.len<=n){
        if(nio_equal(buf[i..i+marker.len],marker)==1){
            let p:i32=i+marker.len;
            let tl:i32=lf_next_tok(buf,n,&p,tbuf,0);
            if(tl>0){return tbuf[0..tl];}
            return "";
        }
        i=i+1;
    }
    return "";
}
// Section span for the "### S_<id>" header in the frozen schema doc.
// Returns the header-line start (the header's own NL gloss quote is part of
// the section's frozen description); *se = section end, which also stops at
// "## " headings so later sections cannot leak in. -1 if absent.
fn lf_find_sect(scb:[]u8,n:i32,needle:[]u8,se:*i32)i32 {
    let i:i32=0;
    while(i+needle.len<=n){
        let ls:i32=1;
        if(i>0 && scb[i-1]!=10){ls=0;}
        if(ls==1 && nio_equal(scb[i..i+needle.len],needle)==1){
            let e:i32=i;
            while(e<n && scb[e]!=10){e=e+1;}
            let j:i32=e+1;
            if(e>=n){j=n;}
            let se2:i32=n;
            while(j<n){
                let ls2:i32=1;
                if(j>0 && scb[j-1]!=10){ls2=0;}
                if(ls2==1 && scb[j]==35 && j+1<n && scb[j+1]==35){
                    if(j+2<n && scb[j+2]==35){
                        if(j+3>=n || scb[j+3]==35 || scb[j+3]==32){se2=j;break;}
                    } else {
                        if(scb[j+2]==32){se2=j;break;}
                    }
                }
                j=j+1;
            }
            se.*=se2;
            return i;
        }
        i=i+1;
    }
    return -1;
}
// Bridge: for each schema, find its NL description in the knowledge store
// via the double-quoted substrings in its frozen COMMIT_SCHEMAS.md section,
// clause-split the anchor line, and mine candidate cue words from the
// clauses containing the quote. All words are discovered, never listed.
fn lf_bridge(w:*LFWT,scb:[]u8,scn:i32,kbb:[]u8,kbn:i32,led:*DOut)i32 {
    let tbuf:[]u8=nio_alloc(64);
    if(tbuf.len!=64){return -1;}
    let s:i32=0;
    while(s<3){
        let ndl:[]u8=cx_concat("### S_",lf_sch_idbytes(s));
        let se:i32=0;
        let body:i32=lf_find_sect(scb,scn,ndl,&se);
        nio_free(ndl);
        if(body<0){
            dout_str(led,"ANCHOR ");dout_str(led,lf_sch_name(s));
            dout_str(led," NONE no-section");dout_line(led);
        } else {
            let anchored:i32=0;
            let q:i32=body;
            while(q<se){
                if(scb[q]==34){
                    let qe:i32=q+1;
                    while(qe<se && scb[qe]!=34){qe=qe+1;}
                    if(qe<se && qe>q+1){
                        let quote:[]u8=scb[q+1..qe];
                        let kp:i32=0;let kln:i32=1;
                        let aln:i32=0;let als:i32=0;let ale:i32=0;
                        while(kp<kbn){
                            let e2:i32=kp;
                            while(e2<kbn && kbb[e2]!=10){e2=e2+1;}
                            if(lf_contains(kbb[kp..e2],quote)==1){aln=kln;als=kp;ale=e2;break;}
                            if(e2<kbn){e2=e2+1;}
                            kp=e2;kln=kln+1;
                        }
                        if(aln>0){
                            anchored=1;
                            dout_str(led,"ANCHOR ");dout_str(led,lf_sch_name(s));
                            dout_str(led," KS:");dout_i64(led,aln as i64);
                            dout_str(led," QUOTE \"");dout_str(led,quote);
                            dout_str(led,"\"");dout_line(led);
                            let sg:i32=als;
                            while(sg<ale){
                                let g2:i32=sg;
                                while(g2<ale && kbb[g2]!=59){g2=g2+1;}
                                if(lf_contains(kbb[sg..g2],quote)==1){
                                    let pp:i32=sg;
                                    while(pp<g2){
                                        let tl:i32=lf_next_tok(kbb,g2,&pp,tbuf,1);
                                        if(tl>=3){
                                            if(lfwt_add_anchor(w,tbuf[0..tl],s,aln)<0){
                                                nio_free(tbuf);return -1;
                                            }
                                        }
                                        if(tl==0){break;}
                                    }
                                }
                                sg=g2+1;
                            }
                        }
                    }
                    q=qe+1;continue;
                }
                q=q+1;
            }
            if(anchored==0){
                dout_str(led,"ANCHOR ");dout_str(led,lf_sch_name(s));
                dout_str(led," NONE no-quote-hit");dout_line(led);
            }
        }
        s=s+1;
    }
    nio_free(tbuf);
    return 0;
}
// learned stopwords: docfreq >= ndocs/2+1 (majority)
fn lf_emit_stops(sw:*LFWT,swr:*LFWR,ndocs:i32,sto:*DOut,led:*DOut)void {
    let th:i32=ndocs/2+1;
    let i:i32=0;
    while(i<sw.*.n){
        let df:i32=au_get32(swr.*.fire,i);
        if(df>=th){
            let wd:[]u8=lfwt_word(sw,i);
            dout_str(sto,"STOP ");dout_str(sto,wd);dout_str(sto," ");
            dout_i64(sto,df as i64);dout_line(sto);
            dout_str(led,"STOP ");dout_str(led,wd);
            dout_str(led," docfreq=");dout_i64(led,df as i64);
            dout_str(led," ndocs=");dout_i64(led,ndocs as i64);dout_line(led);
        }
        i=i+1;
    }
    return;
}
// emit retained CUE rows (fired >=1 doc) + DROP rows (never fired),
// with full provenance cites
fn lf_emit_cues(w:*LFWT,r:*LFWR,sto:*DOut,led:*DOut,dpb:[]u8,dpo:[]u8,dpl:[]u8,dln:[]u8,ndocs:i32)void {
    let i:i32=0;
    while(i<w.*.n){
        let si:i32=au_get32(r.*.schema,i);
        let fd:i32=au_get32(r.*.fire,i);
        let fnn:i32=au_get32(r.*.firen,i);
        let wd:[]u8=lfwt_word(w,i);
        let an:i32=0;
        if(si>=0){an=au_get32(w.*.ac,i*3+si);}
        let ksl:i32=au_get32(w.*.cite,i);
        if(si>=0 && fd>=1){
            dout_str(sto,"CUE ");dout_str(sto,wd);dout_str(sto," ");
            dout_i64(sto,si as i64);dout_str(sto," ");
            dout_i64(sto,an as i64);dout_str(sto," ");
            dout_i64(sto,fd as i64);dout_str(sto," ");
            dout_i64(sto,fnn as i64);dout_str(sto," ");
            dout_str(sto,"KS:");dout_i64(sto,ksl as i64);dout_line(sto);
            dout_str(led,"CUE \"");dout_str(led,wd);
            dout_str(led,"\" -> ");dout_str(led,lf_sch_name(si));
            dout_str(led," anchor=");dout_i64(led,an as i64);
            dout_str(led," firedocs=");dout_i64(led,fd as i64);
            dout_str(led," firen=");dout_i64(led,fnn as i64);
            dout_str(led," cites=KS:");dout_i64(led,ksl as i64);
            let mask:i32=au_get32(r.*.fmask,i);
            let d:i32=1;
            while(d<=ndocs){
                let bit:i32=1<<(d-1);
                if((mask&bit)!=0){
                    let po:i32=au_get32(dpo,d-1);
                    let pl:i32=au_get32(dpl,d-1);
                    dout_str(led,";");
                    dout_str(led,dpb[po..po+pl]);
                    dout_str(led,":");
                    dout_i64(led,au_get32(dln,d-1) as i64);
                }
                d=d+1;
            }
            dout_line(led);
        } else {
            dout_str(led,"DROP \"");dout_str(led,wd);
            dout_str(led,"\" schema=");
            if(si>=0){dout_str(led,lf_sch_name(si));}else{dout_str(led,"NONE");}
            dout_str(led," anchor=");dout_i64(led,an as i64);
            dout_str(led," firedocs=");dout_i64(led,fd as i64);
            dout_str(led," cite=KS:");dout_i64(led,ksl as i64);dout_line(led);
        }
        i=i+1;
    }
    return;
}

// ---- Stage 1 main: learn from frozen evidence, write store + ledger ----
fn lf_learn(kbp:[]u8,schp:[]u8,b1lp:[]u8,pnlp:[]u8,pfmp:[]u8,trlp:[]u8,storep:[]u8,ledp:[]u8)i32 {
    if(cx_has_sealed(kbp)==1 || cx_has_sealed(schp)==1 || cx_has_sealed(b1lp)==1){return 3;}
    if(cx_has_sealed(pnlp)==1 || cx_has_sealed(pfmp)==1 || cx_has_sealed(trlp)==1){return 3;}
    if(cx_has_sealed(storep)==1 || cx_has_sealed(ledp)==1){return 3;}
    let kbb:[]u8=nio_alloc(1048576);
    let scb:[]u8=nio_alloc(1048576);
    if(kbb.len==0 || scb.len==0){return 4;}
    let kbn:i64=cx_guarded_read(kbp,kbb);
    let scn:i64=cx_guarded_read(schp,scb);
    if(kbn==-99 || scn==-99){nio_free(kbb);nio_free(scb);return 3;}
    if(kbn<=0 || scn<=0){nio_free(kbb);nio_free(scb);return 4;}
    let kbn32:i32=kbn as i32;
    let scn32:i32=scn as i32;
    let w:LFWT=LFWT{.buf:"",.off:"",.len:"",.ac:"",.cite:"",.n:0,.cap:0,.blen:0,.bcap:0};
    let r:LFWR=LFWR{.schema:"",.fire:"",.firen:"",.seen:"",.fmask:""};
    if(lfwt_init(&w,&r,512,16384)!=0){return 4;}
    let sw:LFWT=LFWT{.buf:"",.off:"",.len:"",.ac:"",.cite:"",.n:0,.cap:0,.blen:0,.bcap:0};
    let swr:LFWR=LFWR{.schema:"",.fire:"",.firen:"",.seen:"",.fmask:""};
    if(lfwt_init(&sw,&swr,1024,32768)!=0){return 4;}
    let sto:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let led:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sto,131072)!=0 || dout_init(&led,131072)!=0){return 4;}
    dout_str(&sto,"# FORMALIZER_STORE v1 - generated by learnform learn; frozen round-1 evidence only");dout_line(&sto);
    dout_str(&led,"# PROVENANCE_LEDGER v1 - every retained pattern cites frozen evidence lines");dout_line(&led);
    dout_str(&led,"NOTE store starts empty by construction: this run writes it; no store is read as input");dout_line(&led);
    lf_emit_input(&sto,"KB",kbp);
    lf_emit_input(&sto,"SCHEMAS",schp);
    // anchor mining: schema -> knowledge-store description -> cue words
    if(lf_bridge(&w,scb,scn32,kbb,kbn32,&led)!=0){return 4;}
    lfwt_resolve(&w,&r);
    // B1 NL statements: stopword docfreqs + cue firing
    let blb:[]u8=nio_alloc(65536);
    if(blb.len==0){return 4;}
    let bln:i64=cx_guarded_read(b1lp,blb);
    if(bln==-99){nio_free(blb);return 3;}
    if(bln<=0){nio_free(blb);return 4;}
    let bln32:i32=bln as i32;
    lf_emit_input(&sto,"B1LIST",b1lp);
    let dpb:[]u8=nio_alloc(4096);
    let dpo:[]u8=nio_alloc(256);
    let dpl:[]u8=nio_alloc(256);
    let dln:[]u8=nio_alloc(256);
    if(dpb.len!=4096 || dpo.len!=256 || dpl.len!=256 || dln.len!=256){return 4;}
    let dplen:i32=0;
    let doc:i32=0;
    let bp:i32=0;
    while(bp<bln32){
        let e3:i32=bp;
        while(e3<bln32 && blb[e3]!=10){e3=e3+1;}
        let line:[]u8=cx_trim(blb[bp..e3]);
        if(e3<bln32){e3=e3+1;}
        bp=e3;
        if(line.len==0){continue;}
        if(cx_has_sealed(line)==1){nio_free(blb);return 3;}
        let fb:[]u8=nio_alloc(1048576);
        if(fb.len==0){nio_free(blb);return 4;}
        let fn2:i64=cx_guarded_read(line,fb);
        if(fn2==-99){nio_free(fb);nio_free(blb);return 3;}
        if(fn2<=0){nio_free(fb);nio_free(blb);return 4;}
        let fn32:i32=fn2 as i32;
        lf_emit_input(&sto,"B1",line);
        doc=doc+1;
        if(doc>64){nio_free(fb);nio_free(blb);return 4;}
        let pid:[]u8=cx_field(fb,fn32,"ID: ");
        let stmt:[]u8=lf_field_rest(fb,fn32,"STATEMENT: ");
        if(pid.len==0 || stmt.len==0){nio_free(fb);nio_free(blb);return 4;}
        if(dplen+pid.len<=4096){
            let ii:i32=0;
            while(ii<pid.len){dpb[dplen+ii]=pid[ii];ii=ii+1;}
            au_put32(dpo,doc-1,dplen);
            au_put32(dpl,doc-1,pid.len);
            dplen=dplen+pid.len;
        }
        let mo:i32=lf_marker_off(fb,fn32,"STATEMENT: ");
        if(mo>=0){au_put32(dln,doc-1,lf_line_no(fb,mo));}
        if(lfwt_bump_df(&sw,&swr,stmt,stmt.len,doc)!=0){nio_free(fb);nio_free(blb);return 4;}
        lfwt_fire_doc(&w,&r,stmt,stmt.len,doc);
        nio_free(fb);
    }
    nio_free(blb);
    let ndocs:i32=doc;
    dout_str(&led,"NOTE training NL docs=");dout_i64(&led,ndocs as i64);dout_line(&led);
    lf_emit_stops(&sw,&swr,ndocs,&sto,&led);
    lf_emit_cues(&w,&r,&sto,&led,dpb,dpo,dpl,dln,ndocs);
    // the B1 NL->formal pair: task word -> formal skeleton template
    let pnb:[]u8=nio_alloc(1048576);
    let pfb:[]u8=nio_alloc(1048576);
    if(pnb.len==0 || pfb.len==0){return 4;}
    let pnn:i64=cx_guarded_read(pnlp,pnb);
    let pfn:i64=cx_guarded_read(pfmp,pfb);
    if(pnn==-99 || pfn==-99){return 3;}
    if(pnn<=0 || pfn<=0){return 4;}
    lf_emit_input(&sto,"PAIR_NL",pnlp);
    lf_emit_input(&sto,"PAIR_FORM",pfmp);
    let tpl:LFTPL=LFTPL{.task:"",.nprem:0,.pbuf:"",.poff:"",.plen:"",.target:"",.cite:""};
    if(lftpl_init(&tpl)!=0){return 4;}
    let pstmt:[]u8=lf_field_rest(pnb,pnn as i32,"STATEMENT: ");
    if(pstmt.len==0){return 4;}
    let tb2:[]u8=nio_alloc(64);
    if(tb2.len!=64){return 4;}
    let pp2:i32=0;
    let twl:i32=lf_next_tok(pstmt,pstmt.len,&pp2,tb2,1);
    if(twl>0){tpl.task=cx_copy(tb2[0..twl]);}
    nio_free(tb2);
    let pf:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(pfb,pfn as i32,&pf,8)!=0){return 4;}
    let pi:i32=0;
    while(pi<pf.nprem){
        if(lftpl_add_prem(&tpl,cx_prem(&pf,pi))!=0){return 4;}
        pi=pi+1;
    }
    tpl.target=cx_copy(pf.target);
    tpl.cite=pfmp;
    dout_str(&sto,"TEMPLATE ");dout_str(&sto,tpl.task);dout_str(&sto," ");
    dout_i64(&sto,tpl.nprem as i64);
    let qi:i32=0;
    while(qi<tpl.nprem){dout_str(&sto," ");dout_str(&sto,lftpl_prem(&tpl,qi));qi=qi+1;}
    dout_str(&sto," ");dout_str(&sto,tpl.target);
    dout_str(&sto," ");dout_str(&sto,tpl.cite);dout_line(&sto);
    dout_str(&led,"TEMPLATE task=\"");dout_str(&led,tpl.task);
    dout_str(&led,"\" nprem=");dout_i64(&led,tpl.nprem as i64);
    dout_str(&led," target=");dout_str(&led,tpl.target);
    dout_str(&led," support=1 cite=PAIR:");dout_str(&led,tpl.cite);dout_line(&led);
    dout_str(&led,"NOTE pair template support=1: single NL->formal example; overgeneralization is measured by B7F, not assumed away");dout_line(&led);
    nio_free(pnb);nio_free(pfb);
    // traces: attempt context; count formal-syntax markers (expect ~0:
    // traces are deliberation traces, not formalization evidence)
    let tlb:[]u8=nio_alloc(65536);
    if(tlb.len==0){return 4;}
    let tln:i64=cx_guarded_read(trlp,tlb);
    if(tln==-99){nio_free(tlb);return 3;}
    if(tln<=0){nio_free(tlb);return 4;}
    let tln32:i32=tln as i32;
    lf_emit_input(&sto,"TRACELIST",trlp);
    dout_str(&led,"NOTE traces carry no NL->formal mappings (deliberation only); nform counts formal-syntax markers per trace");dout_line(&led);
    let tp:i32=0;
    while(tp<tln32){
        let e4:i32=tp;
        while(e4<tln32 && tlb[e4]!=10){e4=e4+1;}
        let tline:[]u8=cx_trim(tlb[tp..e4]);
        if(e4<tln32){e4=e4+1;}
        tp=e4;
        if(tline.len==0){continue;}
        if(cx_has_sealed(tline)==1){nio_free(tlb);return 3;}
        let tb:[]u8=nio_alloc(1048576);
        if(tb.len==0){nio_free(tlb);return 4;}
        let tn:i64=cx_guarded_read(tline,tb);
        if(tn==-99){nio_free(tb);nio_free(tlb);return 3;}
        if(tn<=0){nio_free(tb);nio_free(tlb);return 4;}
        let tn32:i32=tn as i32;
        lf_emit_input(&sto,"TRACE",tline);
        let b1:[]u8=nio_alloc(64);let b2:[]u8=nio_alloc(64);let b3:[]u8=nio_alloc(64);
        if(b1.len!=64 || b2.len!=64 || b3.len!=64){nio_free(tb);nio_free(tlb);return 4;}
        let tpid:[]u8=lf_after_token(tb,tn32,"Loaded problem ",b1);
        let ttyp:[]u8=lf_after_token(tb,tn32,"TYPE=",b2);
        let tvd:[]u8=lf_after_token(tb,tn32,"SELF_VERDICT:",b3);
        let nf:i32=lf_count_sub(tb,tn32,"imp(")+lf_count_sub(tb,tn32,"forall(")+lf_count_sub(tb,tn32,"not(");
        dout_str(&led,"ATTEMPT ");dout_str(&led,tpid);
        dout_str(&led," type=");dout_str(&led,ttyp);
        dout_str(&led," verdict=");dout_str(&led,tvd);
        dout_str(&led," nform=");dout_i64(&led,nf as i64);
        dout_str(&led," cite=");dout_str(&led,tline);dout_line(&led);
        nio_free(b1);nio_free(b2);nio_free(b3);
        nio_free(tb);
    }
    nio_free(tlb);
    nio_free(kbb);nio_free(scb);
    if(dlb_write_file(storep,dout_bytes(&sto),sto.n)<0){return 4;}
    if(dlb_write_file(ledp,dout_bytes(&led),led.n)<0){return 4;}
    return 0;
}

// ---- Stage 2: the solver ----

fn lf_parse_i64(buf:[]u8,n:i32,pos:*i32)i64 {
    let p:i32=pos.*;
    while(p<n && (buf[p]==32 || buf[p]==9)){p=p+1;}
    let v:i64=0;
    while(p<n && buf[p]>=48 && buf[p]<=57){v=v*10+((buf[p] as i64)-48);p=p+1;}
    pos.*=p;
    return v;
}
// parse the frozen store into cue/stop tables + template
fn lf_parse_store(sb:[]u8,n:i32,cue:*LFWT,cuer:*LFWR,stop:*LFWT,stopr:*LFWR,tpl:*LFTPL)i32 {
    let pos:i32=0;
    while(pos<n){
        let ls:i32=pos;
        let e:i32=pos;
        while(e<n && sb[e]!=10){e=e+1;}
        let line:[]u8=cx_trim(sb[ls..e]);
        if(e<n){e=e+1;}
        pos=e;
        if(line.len==0 || line[0]==35){continue;}
        let p:i32=0;
        let tb:[]u8=nio_alloc(64);
        if(tb.len!=64){return -1;}
        let kwl:i32=lf_next_tok(line,line.len,&p,tb,1);
        if(kwl==3 && nio_equal(tb[0..3],"cue")==1){
            let wl:i32=lf_next_tok(line,line.len,&p,tb,1);
            if(wl<=0){nio_free(tb);return -1;}
            let si:i32=lf_parse_i64(line,line.len,&p) as i32;
            let an:i32=lf_parse_i64(line,line.len,&p) as i32;
            let fd:i32=lf_parse_i64(line,line.len,&p) as i32;
            let fnn:i32=lf_parse_i64(line,line.len,&p) as i32;
            let f:i32=lfwt_add(cue,tb[0..wl]);
            if(f<0 || si<0 || si>2){nio_free(tb);return -1;}
            au_put32(cuer.*.schema,f,si);
            au_put32(cue.*.ac,f*3+si,an);
            au_put32(cuer.*.fire,f,fd);
            au_put32(cuer.*.firen,f,fnn);
        } else {
            if(kwl==4 && nio_equal(tb[0..4],"stop")==1){
                let wl2:i32=lf_next_tok(line,line.len,&p,tb,1);
                if(wl2>0){
                    if(lfwt_add(stop,tb[0..wl2])<0){nio_free(tb);return -1;}
                }
            } else {
                if(kwl==8 && nio_equal(tb[0..8],"template")==1){
                    let wl3:i32=lf_next_tok(line,line.len,&p,tb,1);
                    if(wl3<=0){nio_free(tb);return -1;}
                    tpl.*.task=cx_copy(tb[0..wl3]);
                    let np:i32=lf_parse_i64(line,line.len,&p) as i32;
                    let qi2:i32=0;
                    while(qi2<np){
                        let wl4:i32=lf_next_raw(line,line.len,&p,tb);
                        if(wl4<=0){nio_free(tb);return -1;}
                        if(lftpl_add_prem(tpl,tb[0..wl4])!=0){nio_free(tb);return -1;}
                        qi2=qi2+1;
                    }
                    let wl5:i32=lf_next_raw(line,line.len,&p,tb);
                    if(wl5<=0){nio_free(tb);return -1;}
                    tpl.*.target=cx_copy(tb[0..wl5]);
                    while(p<line.len && (line[p]==32 || line[p]==9)){p=p+1;}
                    tpl.*.cite=cx_copy(cx_trim(line[p..]));
                }
            }
        }
        nio_free(tb);
    }
    return 0;
}
// content atom: non-stopword alnum tokens joined with '_'; "" if none
fn lf_content_atom(stmt:[]u8,stop:*LFWT,abuf:[]u8)i32 {
    let tbuf:[]u8=nio_alloc(64);
    if(tbuf.len!=64){return -1;}
    let pos:i32=0;let o:i32=0;let first:i32=1;
    while(pos<stmt.len && o<46){
        let tl:i32=lf_next_tok(stmt,stmt.len,&pos,tbuf,0);
        if(tl>=2 && lfwt_find(stop,tbuf[0..tl])<0){
            if(first==0){abuf[o]=95;o=o+1;}
            let k:i32=0;
            while(k<tl && o<46){abuf[o]=tbuf[k];o=o+1;k=k+1;}
            first=0;
        }
        if(tl==0){break;}
    }
    nio_free(tbuf);
    if(o==0){return 0;}
    let c0:u8=abuf[0];
    let alpha0:i32=0;
    if(c0>=97 && c0<=122){alpha0=1;}
    if(c0>=65 && c0<=90){alpha0=1;}
    if(alpha0==0){
        let j:i32=o-1;
        while(j>=0){abuf[j+2]=abuf[j];j=j-1;}
        abuf[0]=99;abuf[1]=95;o=o+2;
    }
    return o;
}
fn lf_abstain_rep(rep:*DOut,pid:[]u8,storep:[]u8)void {
    dout_str(rep,"ID: ");dout_str(rep,pid);dout_str(rep,"-LF");dout_line(rep);
    dout_str(rep,"VERDICT: FORMALIZE-ABSTAIN");dout_line(rep);
    dout_str(rep,"NOTE: no learned pattern yields a formalization; abstaining on formalization grounds");dout_line(rep);
    return;
}
fn lf_solve(nlp:[]u8,storep:[]u8,kbp:[]u8,outp:[]u8)i32 {
    if(cx_has_sealed(nlp)==1 || cx_has_sealed(storep)==1){_zag_println("learnform solve: sealed guard");return 3;}
    if(cx_has_sealed(kbp)==1 || cx_has_sealed(outp)==1){_zag_println("learnform solve: sealed guard");return 3;}
    let sb:[]u8=nio_alloc(1048576);
    if(sb.len==0){return 4;}
    let sn:i64=cx_guarded_read(storep,sb);
    if(sn==-99){nio_free(sb);return 3;}
    if(sn<=0){nio_free(sb);return 4;}
    let cue:LFWT=LFWT{.buf:"",.off:"",.len:"",.ac:"",.cite:"",.n:0,.cap:0,.blen:0,.bcap:0};
    let cuer:LFWR=LFWR{.schema:"",.fire:"",.firen:"",.seen:"",.fmask:""};
    if(lfwt_init(&cue,&cuer,512,16384)!=0){return 4;}
    let stop:LFWT=LFWT{.buf:"",.off:"",.len:"",.ac:"",.cite:"",.n:0,.cap:0,.blen:0,.bcap:0};
    let stopr:LFWR=LFWR{.schema:"",.fire:"",.firen:"",.seen:"",.fmask:""};
    if(lfwt_init(&stop,&stopr,256,4096)!=0){return 4;}
    let tpl:LFTPL=LFTPL{.task:"",.nprem:0,.pbuf:"",.poff:"",.plen:"",.target:"",.cite:""};
    if(lftpl_init(&tpl)!=0){return 4;}
    if(lf_parse_store(sb,sn as i32,&cue,&cuer,&stop,&stopr,&tpl)!=0){return 4;}
    nio_free(sb);
    let nb:[]u8=nio_alloc(1048576);
    if(nb.len==0){return 4;}
    let nn:i64=cx_guarded_read(nlp,nb);
    if(nn==-99){nio_free(nb);return 3;}
    if(nn<=0){nio_free(nb);return 4;}
    let nn32:i32=nn as i32;
    let pid:[]u8=cx_field(nb,nn32,"ID: ");
    let stmt:[]u8=lf_field_rest(nb,nn32,"STATEMENT: ");
    if(pid.len==0 || stmt.len==0){nio_free(nb);return 4;}
    // fire learned cues on the statement
    let fidx:[]u8=nio_alloc(1024);
    let tbuf:[]u8=nio_alloc(64);
    if(fidx.len!=1024 || tbuf.len!=64){return 4;}
    let nf:i32=0;
    let pp:i32=0;
    while(pp<stmt.len){
        let tl:i32=lf_next_tok(stmt,stmt.len,&pp,tbuf,1);
        if(tl>=3){
            let f:i32=lfwt_find(&cue,tbuf[0..tl]);
            if(f>=0 && au_get32(cuer.seen,f)!=1 && nf<256){
                au_put32(cuer.seen,f,1);
                au_put32(fidx,nf,f);
                nf=nf+1;
            }
        }
        if(tl==0){break;}
    }
    // pair template: first token == learned task word
    let p0:i32=0;
    let tw0:i32=lf_next_tok(stmt,stmt.len,&p0,tbuf,1);
    let use_tpl:i32=0;
    if(tw0>0 && tpl.task.len>0 && nio_equal(tbuf[0..tw0],tpl.task)==1){use_tpl=1;}
    nio_free(tbuf);
    let rep:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&rep,131072)!=0){return 4;}
    dout_str(&rep,"FORMALIZER: learnform");dout_line(&rep);
    dout_str(&rep,"FORMALIZER_STORE: ");dout_str(&rep,storep);
    dout_str(&rep," FNV=");
    let shx:[]u8=lf_file_fnv(storep);
    if(shx.len==16){dout_str(&rep,shx);}else{dout_str(&rep,"UNREADABLE");}
    nio_free(shx);
    dout_line(&rep);
    dout_str(&rep,"PATTERNS_FIRED:");dout_line(&rep);
    let fi:i32=0;
    while(fi<nf){
        let ci2:i32=au_get32(fidx,fi);
        let si2:i32=au_get32(cuer.schema,ci2);
        dout_str(&rep,"CUE \"");dout_str(&rep,lfwt_word(&cue,ci2));
        dout_str(&rep,"\" -> ");dout_str(&rep,lf_sch_name(si2));
        dout_str(&rep," [anchor=");dout_i64(&rep,au_get32(cue.ac,ci2*3+si2) as i64);
        dout_str(&rep," firedocs=");dout_i64(&rep,au_get32(cuer.fire,ci2) as i64);
        dout_str(&rep,"]");dout_line(&rep);
        fi=fi+1;
    }
    if(use_tpl==1){
        dout_str(&rep,"TEMPLATE task=\"");dout_str(&rep,tpl.task);
        dout_str(&rep,"\" nprem=");dout_i64(&rep,tpl.nprem as i64);
        dout_str(&rep," cite=");dout_str(&rep,tpl.cite);dout_line(&rep);
    }
    if(nf==0 && use_tpl==0){
        lf_abstain_rep(&rep,pid,storep);
        if(dlb_write_file(outp,dout_bytes(&rep),rep.n)<0){return 4;}
        nio_free(nb);nio_free(fidx);
        return 0;
    }
    let tgt:[]u8="";
    let abuf:[]u8=nio_alloc(64);
    if(abuf.len!=64){return 4;}
    if(use_tpl==0){
        let alen:i32=lf_content_atom(stmt,&stop,abuf);
        if(alen<=0){
            lf_abstain_rep(&rep,pid,storep);
            if(dlb_write_file(outp,dout_bytes(&rep),rep.n)<0){return 4;}
            nio_free(nb);nio_free(fidx);nio_free(abuf);
            return 0;
        }
        tgt=abuf[0..alen];
    } else {
        tgt=tpl.target;
    }
    dout_str(&rep,"FORMAL_TARGET: ");dout_str(&rep,tgt);dout_line(&rep);
    let nprem2:i32=0;
    if(use_tpl==1){nprem2=tpl.nprem;}
    dout_str(&rep,"FORMAL_PREMISES: ");dout_i64(&rep,nprem2 as i64);dout_line(&rep);
    let fo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&fo,65536)!=0){return 4;}
    dout_str(&fo,"ID: ");dout_str(&fo,pid);dout_str(&fo,"-LF");dout_line(&fo);
    dout_str(&fo,"STORE: ");dout_str(&fo,kbp);dout_line(&fo);
    dout_str(&fo,"PREMISES:");dout_line(&fo);
    let qi3:i32=0;
    while(qi3<nprem2){dout_str(&fo,lftpl_prem(&tpl,qi3));dout_line(&fo);qi3=qi3+1;}
    dout_str(&fo,"TARGET:");dout_line(&fo);
    dout_str(&fo,tgt);dout_line(&fo);
    let fpath:[]u8=cx_concat(outp,".form");
    if(dlb_write_file(fpath,dout_bytes(&fo),fo.n)<0){return 4;}
    dout_str(&rep,"FORMAL_FORM: ");dout_str(&rep,fpath);dout_line(&rep);
    let kb:[]u8=nio_alloc(1048576);
    if(kb.len==0){return 4;}
    let kbn2:i64=cx_guarded_read(kbp,kb);
    if(kbn2==-99){return 3;}
    if(kbn2<=0){return 4;}
    let t1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t3:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&t1,1048576)!=0 || dout_init(&t2,1048576)!=0 || dout_init(&t3,1048576)!=0){return 4;}
    let r1:i32=one_run(&t1,dout_bytes(&fo),fo.n,kb,kbn2 as i32,8);
    let r2:i32=one_run(&t2,dout_bytes(&fo),fo.n,kb,kbn2 as i32,8);
    let r3:i32=one_run(&t3,dout_bytes(&fo),fo.n,kb,kbn2 as i32,8);
    let div:i32=0;
    if(r1!=0 || r2!=0 || r3!=0){div=2;}
    if(div==0 && nio_equal(dout_bytes(&t1),dout_bytes(&t2))==0){div=1;}
    if(div==0 && nio_equal(dout_bytes(&t2),dout_bytes(&t3))==0){div=1;}
    if(div!=0){
        _zag_println("learnform: DIVERGENCE across 3x reruns");
        if(div==1){return 5;}
        return 4;
    }
    dout_str(&rep,dout_bytes(&t1));
    if(dlb_write_file(outp,dout_bytes(&rep),rep.n)<0){return 4;}
    return 0;
}
fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(nio_equal(m,"learn")==1){
        let a2:[]u8=_zag_arg(2);let a3:[]u8=_zag_arg(3);
        let a4:[]u8=_zag_arg(4);let a5:[]u8=_zag_arg(5);
        let a6:[]u8=_zag_arg(6);let a7:[]u8=_zag_arg(7);
        let a8:[]u8=_zag_arg(8);let a9:[]u8=_zag_arg(9);
        if(a2.len==0 || a3.len==0 || a4.len==0 || a5.len==0){return 4;}
        if(a6.len==0 || a7.len==0 || a8.len==0 || a9.len==0){return 4;}
        return lf_learn(a2,a3,a4,a5,a6,a7,a8,a9);
    }
    if(nio_equal(m,"solve")==1){
        let b2:[]u8=_zag_arg(2);let b3:[]u8=_zag_arg(3);
        let b4:[]u8=_zag_arg(4);let b5:[]u8=_zag_arg(5);
        if(b2.len==0 || b3.len==0 || b4.len==0 || b5.len==0){return 4;}
        return lf_solve(b2,b3,b4,b5);
    }
    _zag_println("usage: learnform_bin <learn|solve> ...");
    return 4;
}

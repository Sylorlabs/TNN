// nfee_elim.zag — NFEE Phase 1: negation-first elimination.
//
// Three structures (all []u8 arenas + au_* accessors, ZNC-007-safe):
//   ELIM — ELIM_ARENA: disjunctive elimination constraints with rule-level
//     attribution. Each constraint reads "at least one of these claims is
//     FALSE". Record = 10 x i32:
//       f0 type (0=CONTRA, 1=DIRECT), f1 dcount, f2 dtab0,
//       f3 attr_off, f4 attr_len, f5 head_off, f6 head_len,
//       f7 active, f8 key_off, f9 key_len
//     dtab entries = 2 x i32 (off,len) into the data arena.
//   GRUL — ground imp-rules extracted from premises/store (forall rules
//     instantiated over the deterministic UI universe). Record = 6 x i32:
//       cons_off, cons_len, nant, ant_tab, src_off, src_len.
//     src = the store KID or PREM#i label of the rule (the attribution).
//   WL — worklist / established-negation set: (off,len,dep) entries + bytes.
// Pure Zag, zero RNG, deterministic.

// ---------- ELIM ----------
struct ELIM {
    rec:[]u8, n:i32, cap:i32,
    dtab:[]u8, dn:i32, dcap:i32,
    data:[]u8, ddn:i32, ddcap:i32
}
fn elim_init(e:*ELIM, rcap:i32, dtcap:i32, ddcap:i32) i32 {
    let r:[]u8 = nio_alloc(rcap*40);
    if(r.len != rcap*40){ return -1; }
    let dt:[]u8 = nio_alloc(dtcap*8);
    if(dt.len != dtcap*8){ nio_free(r); return -1; }
    let d:[]u8 = nio_alloc(ddcap);
    if(d.len != ddcap){ nio_free(r); nio_free(dt); return -1; }
    e.*.rec = r; e.*.n = 0; e.*.cap = rcap;
    e.*.dtab = dt; e.*.dn = 0; e.*.dcap = dtcap;
    e.*.data = d; e.*.ddn = 0; e.*.ddcap = ddcap;
    return 0;
}
fn elim_free(e:*ELIM) void {
    nio_free(e.*.rec); nio_free(e.*.dtab); nio_free(e.*.data);
}
fn elim_data_put(e:*ELIM, s:[]u8) i32 {
    if(e.*.ddn + s.len > e.*.ddcap){ return -1; }
    let d:[]u8 = e.*.data;
    let o:i32 = e.*.ddn;
    let i:i32 = 0;
    while(i < s.len){ d[o+i] = s[i]; i = i+1; }
    e.*.ddn = o + s.len;
    return o;
}
fn elim_type(e:*ELIM, i:i32) i32 { return au_get32(e.*.rec, i*10+0); }
fn elim_dcount(e:*ELIM, i:i32) i32 { return au_get32(e.*.rec, i*10+1); }
fn elim_dtab0(e:*ELIM, i:i32) i32 { return au_get32(e.*.rec, i*10+2); }
fn elim_attr(e:*ELIM, i:i32) []u8 {
    let d:[]u8 = e.*.data;
    let o:i32 = au_get32(e.*.rec, i*10+3);
    let l:i32 = au_get32(e.*.rec, i*10+4);
    return d[o..o+l];
}
fn elim_head(e:*ELIM, i:i32) []u8 {
    let d:[]u8 = e.*.data;
    let o:i32 = au_get32(e.*.rec, i*10+5);
    let l:i32 = au_get32(e.*.rec, i*10+6);
    return d[o..o+l];
}
fn elim_active(e:*ELIM, i:i32) i32 { return au_get32(e.*.rec, i*10+7); }
fn elim_set_active(e:*ELIM, i:i32, v:i32) void { au_put32(e.*.rec, i*10+7, v); }
fn elim_key(e:*ELIM, i:i32) []u8 {
    let d:[]u8 = e.*.data;
    let o:i32 = au_get32(e.*.rec, i*10+8);
    let l:i32 = au_get32(e.*.rec, i*10+9);
    return d[o..o+l];
}
fn elim_disj(e:*ELIM, i:i32, k:i32) []u8 {
    let t0:i32 = elim_dtab0(e, i);
    let o:i32 = au_get32(e.*.dtab, (t0+k)*2+0);
    let l:i32 = au_get32(e.*.dtab, (t0+k)*2+1);
    let d:[]u8 = e.*.data;
    return d[o..o+l];
}
// Add a constraint. db/atab/at0/nd describe the disjuncts: disjunct k is
// db[atab[(at0+k)*2] .. +atab[(at0+k)*2+1]]. Dedups on (type, disjunct
// bytes in order, attr). Returns idx, existing idx, or -1.
fn elim_add(e:*ELIM, typ:i32, db:[]u8, atab:[]u8, at0:i32, nd:i32, attr:[]u8, head:[]u8) i32 {
    if(nd <= 0 || nd > 64){ return -1; }
    let ko:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let kop:*DOut = &ko;
    if(dout_init(kop, 8192) != 0){ return -1; }
    if(typ == 1){ dout_str(kop, "D|"); } else { dout_str(kop, "C|"); }
    let k:i32 = 0;
    while(k < nd){
        let o:i32 = au_get32(atab, (at0+k)*2+0);
        let l:i32 = au_get32(atab, (at0+k)*2+1);
        dout_str(kop, db[o..o+l]);
        dout_str(kop, "|");
        k = k+1;
    }
    dout_str(kop, attr);
    let key:[]u8 = cx_copy(dout_bytes(kop));
    dout_free(kop);
    if(key.len == 0){ return -1; }
    let klen:i32 = key.len;
    let i:i32 = 0;
    while(i < e.*.n){
        if(nio_equal(elim_key(e, i), key) == 1){ nio_free(key); return i; }
        i = i+1;
    }
    if(e.*.n >= e.*.cap){ nio_free(key); return -1; }
    if(e.*.dn + nd > e.*.dcap){ nio_free(key); return -1; }
    let dt0:i32 = e.*.dn;
    k = 0;
    while(k < nd){
        let o:i32 = au_get32(atab, (at0+k)*2+0);
        let l:i32 = au_get32(atab, (at0+k)*2+1);
        let o2:i32 = elim_data_put(e, db[o..o+l]);
        if(o2 < 0){ nio_free(key); return -1; }
        au_put32(e.*.dtab, (dt0+k)*2+0, o2);
        au_put32(e.*.dtab, (dt0+k)*2+1, l);
        k = k+1;
    }
    e.*.dn = dt0 + nd;
    let ao:i32 = elim_data_put(e, attr);
    let ho:i32 = elim_data_put(e, head);
    let ko2:i32 = elim_data_put(e, key);
    nio_free(key);
    if(ao < 0 || ho < 0 || ko2 < 0){ return -1; }
    let ci:i32 = e.*.n;
    e.*.n = ci+1;
    au_put32(e.*.rec, ci*10+0, typ);
    au_put32(e.*.rec, ci*10+1, nd);
    au_put32(e.*.rec, ci*10+2, dt0);
    au_put32(e.*.rec, ci*10+3, ao);
    au_put32(e.*.rec, ci*10+4, attr.len);
    au_put32(e.*.rec, ci*10+5, ho);
    au_put32(e.*.rec, ci*10+6, head.len);
    au_put32(e.*.rec, ci*10+7, 0);
    au_put32(e.*.rec, ci*10+8, ko2);
    au_put32(e.*.rec, ci*10+9, klen);
    return ci;
}
fn nfee_nactive(e:*ELIM) i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    while(i < e.*.n){
        if(elim_active(e, i) == 1){ n = n+1; }
        i = i+1;
    }
    return n;
}

// ---------- GRUL ----------
struct GRUL {
    rec:[]u8, n:i32, cap:i32,
    atab:[]u8, an:i32, acap:i32,
    data:[]u8, dn:i32, dcap:i32
}
fn grul_init(g:*GRUL, rcap:i32, acap:i32, dcap:i32) i32 {
    let r:[]u8 = nio_alloc(rcap*24);
    if(r.len != rcap*24){ return -1; }
    let at:[]u8 = nio_alloc(acap*8);
    if(at.len != acap*8){ nio_free(r); return -1; }
    let d:[]u8 = nio_alloc(dcap);
    if(d.len != dcap){ nio_free(r); nio_free(at); return -1; }
    g.*.rec = r; g.*.n = 0; g.*.cap = rcap;
    g.*.atab = at; g.*.an = 0; g.*.acap = acap;
    g.*.data = d; g.*.dn = 0; g.*.dcap = dcap;
    return 0;
}
fn grul_free(g:*GRUL) void {
    nio_free(g.*.rec); nio_free(g.*.atab); nio_free(g.*.data);
}
fn grul_data_put(g:*GRUL, s:[]u8) i32 {
    if(g.*.dn + s.len > g.*.dcap){ return -1; }
    let d:[]u8 = g.*.data;
    let o:i32 = g.*.dn;
    let i:i32 = 0;
    while(i < s.len){ d[o+i] = s[i]; i = i+1; }
    g.*.dn = o + s.len;
    return o;
}
fn grul_cons(g:*GRUL, i:i32) []u8 {
    let d:[]u8 = g.*.data;
    let o:i32 = au_get32(g.*.rec, i*6+0);
    let l:i32 = au_get32(g.*.rec, i*6+1);
    return d[o..o+l];
}
fn grul_nant(g:*GRUL, i:i32) i32 { return au_get32(g.*.rec, i*6+2); }
fn grul_anttab(g:*GRUL, i:i32) i32 { return au_get32(g.*.rec, i*6+3); }
fn grul_src(g:*GRUL, i:i32) []u8 {
    let d:[]u8 = g.*.data;
    let o:i32 = au_get32(g.*.rec, i*6+4);
    let l:i32 = au_get32(g.*.rec, i*6+5);
    return d[o..o+l];
}
fn grul_ant(g:*GRUL, i:i32, k:i32) []u8 {
    let t:i32 = grul_anttab(g, i);
    let o:i32 = au_get32(g.*.atab, (t+k)*2+0);
    let l:i32 = au_get32(g.*.atab, (t+k)*2+1);
    let d:[]u8 = g.*.data;
    return d[o..o+l];
}
// split ant node into top-level AND conjuncts; appends (off,len) entries to
// g.atab (bytes copied into g.data). Returns conjunct count or -1.
fn nfee_split_and(a:*CXA, nd:i32, g:*GRUL) i32 {
    let kk:i32 = cxk(a, nd);
    if(kk == 5){
        let c1:i32 = nfee_split_and(a, cxch(a, nd), g);
        if(c1 < 0){ return -1; }
        let c2:i32 = nfee_split_and(a, cxnx(a, cxch(a, nd)), g);
        if(c2 < 0){ return -1; }
        return c1+c2;
    }
    let sp:[]u8 = cx_span(a, nd);
    let off:i32 = grul_data_put(g, sp);
    if(off < 0){ return -1; }
    if(g.*.an >= g.*.acap){ return -1; }
    au_put32(g.*.atab, g.*.an*2+0, off);
    au_put32(g.*.atab, g.*.an*2+1, sp.len);
    g.*.an = g.*.an+1;
    return 1;
}
// add ground rule imp_nd (kind 4) with source label src. Dedups on
// (consequent bytes, antecedent conjunct bytes in order).
fn nfee_add_imp_rule(g:*GRUL, a:*CXA, imp_nd:i32, src:[]u8) i32 {
    let ant:i32 = cxch(a, imp_nd);
    let cons:i32 = cxnx(a, ant);
    if(ant < 0 || cons < 0){ return -1; }
    let at0:i32 = g.*.an;
    let nc:i32 = nfee_split_and(a, ant, g);
    if(nc <= 0){ g.*.an = at0; return -1; }
    let cs:[]u8 = cx_span(a, cons);
    let r:i32 = 0;
    while(r < g.*.n){
        if(grul_nant(g, r) == nc && nio_equal(grul_cons(g, r), cs) == 1){
            let ok:i32 = 1;
            let kk:i32 = 0;
            while(kk < nc){
                let dd:[]u8 = g.*.data;
                let ao:i32 = au_get32(g.*.atab, (at0+kk)*2+0);
                let al:i32 = au_get32(g.*.atab, (at0+kk)*2+1);
                if(nio_equal(grul_ant(g, r, kk), dd[ao..ao+al]) == 0){ ok = 0; break; }
                kk = kk+1;
            }
            if(ok == 1){ g.*.an = at0; return r; }
        }
        r = r+1;
    }
    let coff:i32 = grul_data_put(g, cs);
    let soff:i32 = grul_data_put(g, src);
    if(coff < 0 || soff < 0){ g.*.an = at0; return -1; }
    if(g.*.n >= g.*.cap){ g.*.an = at0; return -1; }
    let i:i32 = g.*.n;
    g.*.n = i+1;
    au_put32(g.*.rec, i*6+0, coff);
    au_put32(g.*.rec, i*6+1, cs.len);
    au_put32(g.*.rec, i*6+2, nc);
    au_put32(g.*.rec, i*6+3, at0);
    au_put32(g.*.rec, i*6+4, soff);
    au_put32(g.*.rec, i*6+5, src.len);
    return i;
}
// parse one claim's bytes into a temp arena; returns 1 and sets *r.
fn nfee_parse_tmp(bytes:[]u8, a:*CXA, r:*i32) i32 {
    if(cxa_init(a, bytes, 256) != 0){ return 0; }
    let rr:i32 = cx_parse(a, bytes);
    if(rr < 0){ nio_free(a.*.buf); return 0; }
    r.* = rr;
    return 1;
}
// Extract ground imp-rules from kind-0 claims: direct imp claims, plus
// forall claims with imp bodies instantiated over the deterministic UI
// universe (same universe construction as one_ui).
fn nfee_extract_rules(s:*CXS, g:*GRUL) i32 {
    let i:i32 = 0;
    while(i < s.*.n){
        if(au_get32(s.*.kind, i) == 0){
            let cb:[]u8 = cxs_bytes(s, i);
            let ja:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jap:*CXA = &ja;
            let jr:i32 = 0;
            if(nfee_parse_tmp(cb, jap, &jr) == 1){
                if(cxk(jap, jr) == 4){
                    nfee_add_imp_rule(g, jap, jr, cxs_audit(s, i));
                }
                nio_free(jap.*.buf);
            }
        }
        i = i+1;
    }
    let tcap:i32 = 4096;
    let toff:[]u8 = nio_alloc(tcap*4);
    if(toff.len != tcap*4){ return -1; }
    let tlen:[]u8 = nio_alloc(tcap*4);
    if(tlen.len != tcap*4){ nio_free(toff); return -1; }
    let nu:i32 = cx_universe(s, toff, tlen, tcap, 0);
    if(nu < 0){ nio_free(toff); nio_free(tlen); return -1; }
    let sd:[]u8 = s.*.data;
    i = 0;
    while(i < s.*.n){
        if(au_get32(s.*.kind, i) == 0){
            let cb:[]u8 = cxs_bytes(s, i);
            let ja:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jap:*CXA = &ja;
            let jr:i32 = 0;
            if(nfee_parse_tmp(cb, jap, &jr) == 1){
                if(cxk(jap, jr) == 7){
                    let bd:i32 = cxch(jap, jr);
                    if(bd >= 0 && cxk(jap, bd) == 4){
                        let bv:[]u8 = cx_bvar(jap, jr);
                        let t:i32 = 0;
                        while(t < nu){
                            let to:i32 = au_get32(toff, t);
                            let tl:i32 = au_get32(tlen, t);
                            let ts:[]u8 = sd[to..to+tl];
                            if(nio_equal(ts, bv) == 0){
                                let o:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
                                let op:*DOut = &o;
                                if(dout_init(op, 1024) == 0){
                                    cx_subst(jap, bd, bv, ts, op);
                                    let ib:[]u8 = cx_copy(dout_bytes(op));
                                    dout_free(op);
                                    let cb2:[]u8 = cx_canon(ib);
                                    nio_free(ib);
                                    if(cb2.len > 0){
                                        let ka:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
                                        let kap:*CXA = &ka;
                                        let kr:i32 = 0;
                                        if(nfee_parse_tmp(cb2, kap, &kr) == 1){
                                            if(cxk(kap, kr) == 4){
                                                let s2:[]u8 = cx_concat(cxs_audit(s, i), "[UI]");
                                                nfee_add_imp_rule(g, kap, kr, s2);
                                                nio_free(s2);
                                            }
                                            nio_free(kap.*.buf);
                                        }
                                        nio_free(cb2);
                                    }
                                }
                            }
                            t = t+1;
                        }
                    }
                }
                nio_free(jap.*.buf);
            }
        }
        i = i+1;
    }
    nio_free(toff);
    nio_free(tlen);
    return 0;
}

// ---------- WL (worklist / established-negation set) ----------
struct WL { data:[]u8, dn:i32, dcap:i32, tab:[]u8, n:i32, cap:i32 }
fn wl_init(w:*WL, dcap:i32, cap:i32) i32 {
    let d:[]u8 = nio_alloc(dcap);
    if(d.len != dcap){ return -1; }
    let t:[]u8 = nio_alloc(cap*12);
    if(t.len != cap*12){ nio_free(d); return -1; }
    w.*.data = d; w.*.dn = 0; w.*.dcap = dcap;
    w.*.tab = t; w.*.n = 0; w.*.cap = cap;
    return 0;
}
fn wl_free(w:*WL) void { nio_free(w.*.data); nio_free(w.*.tab); }
fn wl_off(w:*WL, i:i32) i32 { return au_get32(w.*.tab, i*3+0); }
fn wl_len(w:*WL, i:i32) i32 { return au_get32(w.*.tab, i*3+1); }
fn wl_dep(w:*WL, i:i32) i32 { return au_get32(w.*.tab, i*3+2); }
fn wl_bytes(w:*WL, i:i32) []u8 {
    let d:[]u8 = w.*.data;
    let o:i32 = wl_off(w, i);
    let l:i32 = wl_len(w, i);
    return d[o..o+l];
}
// push with dedup; returns idx or -1.
fn wl_push(w:*WL, s:[]u8, dep:i32) i32 {
    let i:i32 = 0;
    while(i < w.*.n){
        if(nio_equal(wl_bytes(w, i), s) == 1){ return i; }
        i = i+1;
    }
    if(w.*.n >= w.*.cap){ return -1; }
    if(w.*.dn + s.len > w.*.dcap){ return -1; }
    let d:[]u8 = w.*.data;
    let o:i32 = w.*.dn;
    let k:i32 = 0;
    while(k < s.len){ d[o+k] = s[k]; k = k+1; }
    w.*.dn = o+s.len;
    let idx:i32 = w.*.n;
    w.*.n = idx+1;
    au_put32(w.*.tab, idx*3+0, o);
    au_put32(w.*.tab, idx*3+1, s.len);
    au_put32(w.*.tab, idx*3+2, dep);
    return idx;
}
// established: kind-0 claim in s, or in the extra-established set ex.
fn nfee_est(s:*CXS, ex:*WL, b:[]u8) i32 {
    let f:i32 = cxs_find(s, b);
    if(f >= 0 && au_get32(s.*.kind, f) == 0){ return 1; }
    let i:i32 = 0;
    while(i < ex.*.n){
        if(nio_equal(wl_bytes(ex, i), b) == 1){ return 1; }
        i = i+1;
    }
    return 0;
}
// Phase 1: backward contrapositive firing from notH.
// DIRECT: a ground rule concluding N=not(X) with all antecedents established
//   -> singleton elimination constraint {X} (X cannot be true), attributed to
//   the rule; N joins the established set.
// CONTRA: a ground rule concluding X -> disjunctive constraint over its
//   antecedent conjuncts ("at least one is false"), attributed to the rule;
//   each not(A_i) joins the worklist (depth bound).
// Activation: DIRECT constraints are always active; CONTRA constraints are
// active iff their head negation is established. Returns #active, or -1.
fn nfee_phase1(s:*CXS, g:*GRUL, notH:[]u8, e:*ELIM, bound:i32) i32 {
    let w:WL = WL{.data:"",.dn:0,.dcap:0,.tab:"",.n:0,.cap:0};
    let wp:*WL = &w;
    let ex:WL = WL{.data:"",.dn:0,.dcap:0,.tab:"",.n:0,.cap:0};
    let exp:*WL = &ex;
    if(wl_init(wp, 65536, 2048) != 0){ return -1; }
    if(wl_init(exp, 65536, 512) != 0){ wl_free(wp); return -1; }
    wl_push(wp, notH, 0);
    let wi:i32 = 0;
    while(wi < wp.*.n){
        let N:[]u8 = wl_bytes(wp, wi);
        let dep:i32 = wl_dep(wp, wi);
        let no:i32 = wl_off(wp, wi);
        let nl:i32 = wl_len(wp, wi);
        wi = wi+1;
        if(cx_starts(N, "not(") == 0){ continue; }
        if(nl < 6){ continue; }
        let wd:[]u8 = wp.*.data;
        if(wd[no+nl-1] != 41){ continue; }
        let r:i32 = 0;
        while(r < g.*.n){
            if(nio_equal(grul_cons(g, r), N) == 1){
                let ok:i32 = 1;
                let kk:i32 = 0;
                let na:i32 = grul_nant(g, r);
                while(kk < na){
                    if(nfee_est(s, exp, grul_ant(g, r, kk)) == 0){ ok = 0; break; }
                    kk = kk+1;
                }
                if(ok == 1){
                    let t2:[]u8 = nio_alloc(8);
                    if(t2.len == 8){
                        au_put32(t2, 0, no+4);
                        au_put32(t2, 1, nl-5);
                        let a2:[]u8 = cx_concat("DIRECT ", grul_src(g, r));
                        elim_add(e, 1, wd, t2, 0, 1, a2, N);
                        // Phase-1 establishment: the negation N is genuinely
                        // derived (all antecedents established), so assert it
                        // into the store now — raw cxs_add, bypassing the
                        // elimination filter (the constraint just created
                        // must not filter its own establishing claim).
                        // cxs_put copies the bytes; N stays valid.
                        let pa:[]u8 = cx_concat("PHASE1_DIRECT ", grul_src(g, r));
                        if(pa.len > 0){
                            cxs_add(s, N, pa, 1, 1);
                            nio_free(pa);
                        }
                        nio_free(a2);
                        nio_free(t2);
                    }
                    wl_push(exp, N, 0);
                }
            }
            r = r+1;
        }
        if(dep >= bound){ continue; }
        let X:[]u8 = wd[no+4..no+nl-1];
        r = 0;
        while(r < g.*.n){
            if(nio_equal(grul_cons(g, r), X) == 1){
                let na2:i32 = grul_nant(g, r);
                let a3:[]u8 = cx_concat("CONTRA ", grul_src(g, r));
                elim_add(e, 0, g.*.data, g.*.atab, grul_anttab(g, r), na2, a3, N);
                nio_free(a3);
                let k2:i32 = 0;
                while(k2 < na2){
                    let A:[]u8 = grul_ant(g, r, k2);
                    let t1:[]u8 = cx_concat("not(", A);
                    let NA:[]u8 = cx_concat(t1, ")");
                    nio_free(t1);
                    if(NA.len > 0){
                        wl_push(wp, NA, dep+1);
                        nio_free(NA);
                    }
                    k2 = k2+1;
                }
            }
            r = r+1;
        }
    }
    let nact:i32 = 0;
    let i:i32 = 0;
    while(i < e.*.n){
        let av:i32 = 0;
        if(elim_type(e, i) == 1){ av = 1; }
        else {
            if(nfee_est(s, exp, elim_head(e, i)) == 1){ av = 1; }
        }
        elim_set_active(e, i, av);
        if(av == 1){ nact = nact+1; }
        i = i+1;
    }
    wl_free(wp);
    wl_free(exp);
    return nact;
}

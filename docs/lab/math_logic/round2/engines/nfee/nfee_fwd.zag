// nfee_fwd.zag — NFEE Phase 2: forward chaining with the elimination filter.
//
// Every candidate claim is checked against the ACTIVE elimination
// constraints before assertion (nfee_violation). A violating claim is
// recorded in BLK (claim bytes + blocking constraint index + the
// constraint's rule attribution) and never asserted.
// Additionally, a claim that Phase 1 already established as a negation
// (head of an active DIRECT constraint) is not re-asserted in Phase 2:
// the engine's verdict about that claim is CONTESTED, and re-deriving it
// as a positive conclusion would manufacture an incorrect positive on
// false-rule batteries.
//
// STATUS_ARENA (spec layout): parallel array to claim indices,
// [eliminated:u8][eliminated_by:u16] per claim. NFEE marks loaded claims
// covered by active constraints (nfee_mark); blocked candidates never
// receive a claim index, so their eliminations live in BLK instead.
// Forward steps skip eliminated claims both as rule sources and as
// antecedent matches (spec: "a forward derivation is valid only if none
// of its premises have been eliminated").
//
// Pure Zag, zero RNG, deterministic.

// ---------- NSTAT ----------
struct NSTAT { flg:[]u8, by:[]u8, cap:i32 }
fn nstat_init(st:*NSTAT, cap:i32) i32 {
    let f:[]u8 = nio_alloc(cap);
    if(f.len != cap){ return -1; }
    let b:[]u8 = nio_alloc(cap*2);
    if(b.len != cap*2){ nio_free(f); return -1; }
    st.*.flg = f; st.*.by = b; st.*.cap = cap;
    return 0;
}
fn nstat_free(st:*NSTAT) void { nio_free(st.*.flg); nio_free(st.*.by); }
fn nstat_elim(st:*NSTAT, i:i32) i32 {
    if(i < 0 || i >= st.*.cap){ return 0; }
    if(st.*.flg[i] == 1){ return 1; }
    return 0;
}
fn nstat_mark(st:*NSTAT, i:i32, eidx:i32) void {
    if(i < 0 || i >= st.*.cap){ return; }
    st.*.flg[i] = 1;
    st.*.by[i*2] = (eidx&255) as u8;
    st.*.by[i*2+1] = ((eidx>>8)&255) as u8;
}
fn nstat_by(st:*NSTAT, i:i32) i32 {
    if(i < 0 || i >= st.*.cap){ return -1; }
    return (st.*.by[i*2] as i32)+((st.*.by[i*2+1] as i32)<<8);
}
// mark loaded claims covered by active constraints: claim C is eliminated
// if it is a disjunct of an active constraint whose other disjuncts are
// all present (asserted) in the store.
fn nfee_mark(s:*CXS, st:*NSTAT, e:*ELIM) void {
    let i:i32 = 0;
    while(i < s.*.n){
        let cb:[]u8 = cxs_bytes(s, i);
        let c:i32 = 0;
        while(c < e.*.n){
            if(elim_active(e, c) == 1 && nstat_elim(st, i) == 0){
                let nd:i32 = elim_dcount(e, c);
                let k:i32 = 0;
                while(k < nd){
                    if(nio_equal(elim_disj(e, c, k), cb) == 1){
                        let ok:i32 = 1;
                        let j:i32 = 0;
                        while(j < nd){
                            if(j != k && cxs_find(s, elim_disj(e, c, j)) < 0){ ok = 0; break; }
                            j = j+1;
                        }
                        if(ok == 1){ nstat_mark(st, i, c); }
                    }
                    k = k+1;
                }
            }
            c = c+1;
        }
        i = i+1;
    }
}

// ---------- BLK (blocked candidates) ----------
struct BLK { tab:[]u8, n:i32, cap:i32, data:[]u8, dn:i32, dcap:i32 }
fn blk_init(b:*BLK, cap:i32, dcap:i32) i32 {
    let t:[]u8 = nio_alloc(cap*20);
    if(t.len != cap*20){ return -1; }
    let d:[]u8 = nio_alloc(dcap);
    if(d.len != dcap){ nio_free(t); return -1; }
    b.*.tab = t; b.*.n = 0; b.*.cap = cap;
    b.*.data = d; b.*.dn = 0; b.*.dcap = dcap;
    return 0;
}
fn blk_free(b:*BLK) void { nio_free(b.*.tab); nio_free(b.*.data); }
fn blk_bytes(b:*BLK, i:i32) []u8 {
    let d:[]u8 = b.*.data;
    let o:i32 = au_get32(b.*.tab, i*5+0);
    let l:i32 = au_get32(b.*.tab, i*5+1);
    return d[o..o+l];
}
fn blk_by(b:*BLK, i:i32) i32 { return au_get32(b.*.tab, i*5+2); }
fn blk_attr(b:*BLK, i:i32) []u8 {
    let d:[]u8 = b.*.data;
    let o:i32 = au_get32(b.*.tab, i*5+3);
    let l:i32 = au_get32(b.*.tab, i*5+4);
    return d[o..o+l];
}
fn blk_find(b:*BLK, bytes:[]u8) i32 {
    let i:i32 = 0;
    while(i < b.*.n){
        if(nio_equal(blk_bytes(b, i), bytes) == 1){ return i; }
        i = i+1;
    }
    return -1;
}
fn blk_data_put(b:*BLK, s:[]u8) i32 {
    if(b.*.dn + s.len > b.*.dcap){ return -1; }
    let d:[]u8 = b.*.data;
    let o:i32 = b.*.dn;
    let i:i32 = 0;
    while(i < s.len){ d[o+i] = s[i]; i = i+1; }
    b.*.dn = o+s.len;
    return o;
}
// record a blocked candidate (dedup by bytes); returns idx or -1.
fn blk_add(b:*BLK, bytes:[]u8, by:i32, attr:[]u8) i32 {
    if(blk_find(b, bytes) >= 0){ return -1; }
    if(b.*.n >= b.*.cap){ return -1; }
    let o:i32 = blk_data_put(b, bytes);
    let ao:i32 = blk_data_put(b, attr);
    if(o < 0 || ao < 0){ return -1; }
    let i:i32 = b.*.n;
    b.*.n = i+1;
    au_put32(b.*.tab, i*5+0, o);
    au_put32(b.*.tab, i*5+1, bytes.len);
    au_put32(b.*.tab, i*5+2, by);
    au_put32(b.*.tab, i*5+3, ao);
    au_put32(b.*.tab, i*5+4, attr.len);
    return i;
}

// ---------- elimination filter ----------
// returns the blocking active-constraint idx, or -1.
fn nfee_violation(e:*ELIM, s:*CXS, cand:[]u8) i32 {
    let c:i32 = 0;
    while(c < e.*.n){
        if(elim_active(e, c) == 1){
            // DIRECT head: a negation Phase 1 already established is not
            // re-asserted as a positive Phase-2 conclusion.
            if(elim_type(e, c) == 1){
                if(nio_equal(elim_head(e, c), cand) == 1){ return c; }
            }
            let nd:i32 = elim_dcount(e, c);
            let k:i32 = 0;
            while(k < nd){
                if(nio_equal(elim_disj(e, c, k), cand) == 1){
                    let ok:i32 = 1;
                    let j:i32 = 0;
                    while(j < nd){
                        if(j != k && cxs_find(s, elim_disj(e, c, j)) < 0){ ok = 0; break; }
                        j = j+1;
                    }
                    if(ok == 1){ return c; }
                }
                k = k+1;
            }
        }
        c = c+1;
    }
    return -1;
}
// filtered assertion: -2 = blocked (recorded in blk), else cxs_add result.
// The audit is stamped with the elimination-check point: the number of
// active constraints checked before assertion (spec's elim_check_index).
fn nfee_maybe_add(s:*CXS, e:*ELIM, blk:*BLK, bytes:[]u8, audit:[]u8, depth:i32, kind:i32) i32 {
    // Already established (premise, Phase-1 DIRECT establishment, or an
    // earlier derivation): dedup before the filter so re-derivation of a
    // Phase-1-established negation is not recorded as a spurious block.
    if(cxs_find(s, bytes) >= 0){ return 0; }
    let v:i32 = nfee_violation(e, s, bytes);
    if(v >= 0){
        blk_add(blk, bytes, v, elim_attr(e, v));
        return -2;
    }
    let na:i32 = nfee_nactive(e);
    let o:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let op:*DOut = &o;
    let cap:i32 = audit.len+64;
    if(cap < 64){ cap = 64; }
    if(dout_init(op, cap) != 0){ return cxs_add(s, bytes, audit, depth, kind); }
    dout_str(op, audit);
    dout_str(op, " ELIMCHK ");
    dout_i64(op, na as i64);
    let ab2:[]u8 = cx_copy(dout_bytes(op));
    dout_free(op);
    let r:i32 = cxs_add(s, bytes, ab2, depth, kind);
    nio_free(ab2);
    return r;
}

// ---------- forward core (NFEP patterns; filtered MP/UI/PBC-direct) ----------
struct NFEP {
    a_mp1:CXA, r_mp1:i32,
    a_mp2:CXA, r_mp2:i32,
    a_pb:CXA, r_pb:i32,
    a_ui:CXA, r_ui:i32
}
fn nfep_init(p:*NFEP) i32 {
    if(cxa_init(&p.*.a_mp1, "?0", 64) != 0){ return -1; }
    p.*.r_mp1 = cx_parse(&p.*.a_mp1, "?0");
    if(cxa_init(&p.*.a_mp2, "imp(?0,?1)", 64) != 0){ return -1; }
    p.*.r_mp2 = cx_parse(&p.*.a_mp2, "imp(?0,?1)");
    if(cxa_init(&p.*.a_pb, "imp(not(?0),false)", 64) != 0){ return -1; }
    p.*.r_pb = cx_parse(&p.*.a_pb, "imp(not(?0),false)");
    if(cxa_init(&p.*.a_ui, "forall(?0,?1)", 64) != 0){ return -1; }
    p.*.r_ui = cx_parse(&p.*.a_ui, "forall(?0,?1)");
    if(p.*.r_mp1 < 0 || p.*.r_mp2 < 0 || p.*.r_pb < 0 || p.*.r_ui < 0){ return -1; }
    return 0;
}
fn nfep_free(p:*NFEP) void {
    nio_free(p.*.a_mp1.buf); nio_free(p.*.a_mp2.buf);
    nio_free(p.*.a_pb.buf); nio_free(p.*.a_ui.buf);
}

// S_MP with the elimination filter; eliminated claims are skipped both as
// rule sources and as antecedent matches.
fn nfee_mp(s:*CXS, st:*NSTAT, e:*ELIM, blk:*BLK, p:*NFEP, sub:i32) i32 {
    let n0:i32 = s.*.n;
    let bb:CXB = CXB{.cap:0,.set:"",.off:"",.len:""};
    let bbp:*CXB = &bb;
    if(cxb_init(bbp, 16) != 0){ return -1; }
    let cap:i32 = 2048;
    let ji:[]u8 = nio_alloc(cap*4);
    if(ji.len != cap*4){ cxb_free(bbp); return -1; }
    let o0:[]u8 = nio_alloc(cap*4);
    if(o0.len != cap*4){ nio_free(ji); cxb_free(bbp); return -1; }
    let l0:[]u8 = nio_alloc(cap*4);
    if(l0.len != cap*4){ nio_free(ji); nio_free(o0); cxb_free(bbp); return -1; }
    let o1:[]u8 = nio_alloc(cap*4);
    if(o1.len != cap*4){ nio_free(ji); nio_free(o0); nio_free(l0); cxb_free(bbp); return -1; }
    let l1:[]u8 = nio_alloc(cap*4);
    if(l1.len != cap*4){ nio_free(ji); nio_free(o0); nio_free(l0); nio_free(o1); cxb_free(bbp); return -1; }
    let nimp:i32 = 0;
    let j:i32 = 0;
    while(j < s.*.n){
        if(cxs_ok(s, j, sub) == 1 && nstat_elim(st, j) == 0){
            let jb:[]u8 = cxs_bytes(s, j);
            let ja:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jap:*CXA = &ja;
            let jr:i32 = 0;
            if(nfee_parse_tmp(jb, jap, &jr) == 1){
                if(cxk(jap, jr) == 4){
                    cxb_clear(bbp);
                    if(cx_match(&p.*.a_mp2, p.*.r_mp2, jb, jap, jr, bbp) == 1){
                        if(nimp < cap){
                            au_put32(ji, nimp, j);
                            au_put32(o0, nimp, cxb_off(bbp, 0));
                            au_put32(l0, nimp, cxb_vlen(bbp, 0));
                            au_put32(o1, nimp, cxb_off(bbp, 1));
                            au_put32(l1, nimp, cxb_vlen(bbp, 1));
                            nimp = nimp+1;
                        }
                    }
                }
                nio_free(jap.*.buf);
            }
        }
        j = j+1;
    }
    let m:i32 = 0;
    while(m < nimp){
        let jj:i32 = au_get32(ji, m);
        let jb:[]u8 = cxs_bytes(s, jj);
        let q0:[]u8 = jb[au_get32(o0, m)..au_get32(o0, m)+au_get32(l0, m)];
        let q1:[]u8 = jb[au_get32(o1, m)..au_get32(o1, m)+au_get32(l1, m)];
        let i:i32 = 0;
        while(i < s.*.n){
            if(cxs_ok(s, i, sub) == 1 && nstat_elim(st, i) == 0 && nio_equal(cxs_bytes(s, i), q0) == 1){
                let ao:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
                let aop:*DOut = &ao;
                if(dout_init(aop, 512) == 0){
                    dout_str(aop, "S_MP C"); dout_i64(aop, i as i64);
                    dout_str(aop, " C"); dout_i64(aop, jj as i64);
                    dout_str(aop, " ?0:="); dout_str(aop, q0);
                    dout_str(aop, " ?1:="); dout_str(aop, q1);
                    let nb:[]u8 = cx_copy(q1);
                    let ab:[]u8 = cx_copy(dout_bytes(aop));
                    dout_free(aop);
                    let di:i32 = au_get32(s.*.dep, i);
                    let dj:i32 = au_get32(s.*.dep, jj);
                    let dd:i32 = di;
                    if(dj > dd){ dd = dj; }
                    nfee_maybe_add(s, e, blk, nb, ab, dd+1, 1);
                    nio_free(nb); nio_free(ab);
                }
            }
            i = i+1;
        }
        m = m+1;
    }
    nio_free(ji); nio_free(o0); nio_free(l0); nio_free(o1); nio_free(l1);
    cxb_free(bbp);
    return s.*.n-n0;
}

// S_UI with the elimination filter.
fn nfee_ui(s:*CXS, st:*NSTAT, e:*ELIM, blk:*BLK, p:*NFEP, sub:i32) i32 {
    let n0:i32 = s.*.n;
    let tcap:i32 = 4096;
    let toff:[]u8 = nio_alloc(tcap*4);
    if(toff.len != tcap*4){ return -1; }
    let tlen:[]u8 = nio_alloc(tcap*4);
    if(tlen.len != tcap*4){ nio_free(toff); return -1; }
    let nu:i32 = cx_universe(s, toff, tlen, tcap, sub);
    if(nu < 0){ nio_free(toff); nio_free(tlen); return -1; }
    let data:[]u8 = s.*.data;
    let j:i32 = 0;
    while(j < n0){
        if(cxs_ok(s, j, sub) == 1 && nstat_elim(st, j) == 0){
            let jb:[]u8 = cxs_bytes(s, j);
            let ja:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jap:*CXA = &ja;
            let jr:i32 = 0;
            if(nfee_parse_tmp(jb, jap, &jr) == 1){
                if(cxk(jap, jr) == 7){
                    let bv:[]u8 = cx_bvar(jap, jr);
                    let bd:i32 = cxch(jap, jr);
                    let t:i32 = 0;
                    while(t < nu){
                        let to:i32 = au_get32(toff, t);
                        let tl:i32 = au_get32(tlen, t);
                        let ts:[]u8 = data[to..to+tl];
                        if(nio_equal(ts, bv) == 0){
                            let o:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
                            let op:*DOut = &o;
                            if(dout_init(op, 1024) == 0){
                                cx_subst(jap, bd, bv, ts, op);
                                let nb:[]u8 = cx_copy(dout_bytes(op));
                                dout_free(op);
                                let ao:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
                                let aop:*DOut = &ao;
                                if(dout_init(aop, 512) == 0){
                                    dout_str(aop, "S_UI C"); dout_i64(aop, j as i64);
                                    dout_str(aop, " ?0:="); dout_str(aop, bv);
                                    dout_str(aop, " ?2:="); dout_str(aop, ts);
                                    let ab:[]u8 = cx_copy(dout_bytes(aop));
                                    dout_free(aop);
                                    let dd:i32 = au_get32(s.*.dep, j);
                                    nfee_maybe_add(s, e, blk, nb, ab, dd+1, 1);
                                    nio_free(nb); nio_free(ab);
                                }
                            }
                        }
                        t = t+1;
                    }
                }
                nio_free(jap.*.buf);
            }
        }
        j = j+1;
    }
    nio_free(toff); nio_free(tlen);
    return s.*.n-n0;
}

// S_PBC direct with the elimination filter.
fn nfee_pbc_direct(s:*CXS, st:*NSTAT, e:*ELIM, blk:*BLK, p:*NFEP, sub:i32) i32 {
    let n0:i32 = s.*.n;
    let bb:CXB = CXB{.cap:0,.set:"",.off:"",.len:""};
    let bbp:*CXB = &bb;
    if(cxb_init(bbp, 16) != 0){ return -1; }
    let j:i32 = 0;
    while(j < n0){
        if(cxs_ok(s, j, sub) == 1 && nstat_elim(st, j) == 0){
            let jb:[]u8 = cxs_bytes(s, j);
            let ja:CXA = CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jap:*CXA = &ja;
            let jr:i32 = 0;
            if(nfee_parse_tmp(jb, jap, &jr) == 1){
                cxb_clear(bbp);
                if(cx_match(&p.*.a_pb, p.*.r_pb, jb, jap, jr, bbp) == 1){
                    let q0:[]u8 = cxb_slice(bbp, 0, jb);
                    let ao:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
                    let aop:*DOut = &ao;
                    if(dout_init(aop, 512) == 0){
                        dout_str(aop, "S_PBC_DIR C"); dout_i64(aop, j as i64);
                        dout_str(aop, " ?0:="); dout_str(aop, q0);
                        let nb:[]u8 = cx_copy(q0);
                        let ab:[]u8 = cx_copy(dout_bytes(aop));
                        dout_free(aop);
                        let dd:i32 = au_get32(s.*.dep, j);
                        nfee_maybe_add(s, e, blk, nb, ab, dd+1, 1);
                        nio_free(nb); nio_free(ab);
                    }
                }
                nio_free(jap.*.buf);
            }
        }
        j = j+1;
    }
    cxb_free(bbp);
    return s.*.n-n0;
}

fn nfee_bfs(s:*CXS, st:*NSTAT, e:*ELIM, blk:*BLK, p:*NFEP, bound:i32, sub:i32, goal:[]u8, has_goal:i32) i32 {
    if(has_goal == 1 && cxs_find(s, goal) >= 0){ return 1; }
    let lv:i32 = 0;
    while(lv < bound){
        let n0:i32 = s.*.n;
        nfee_mp(s, st, e, blk, p, sub);
        nfee_ui(s, st, e, blk, p, sub);
        nfee_pbc_direct(s, st, e, blk, p, sub);
        if(has_goal == 1 && cxs_find(s, goal) >= 0){ return 1; }
        if(s.*.n == n0){ return 0; }
        lv = lv+1;
    }
    if(has_goal == 1 && cxs_find(s, goal) >= 0){ return 1; }
    return 0;
}

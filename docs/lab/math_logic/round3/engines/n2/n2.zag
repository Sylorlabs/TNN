// n2.zag — N2 NATIVE-DELIM: backward deliberative elimination over raw text.
//
// Frozen spec (IDEAS_ADDENDUM_R3.md): backward propose-and-eliminate.
//   PROPOSE: from the goal skeleton ("Prove that [X]" -> X): candidates =
//     X itself; X with definition-expansion (defined term -> definiens bytes
//     from a cited definition); X negated (refutation attempt). <=8, fixed order.
//   SUPPORT: backward chains. A link = (conclusion-span, premise-span,
//     link-pattern-id). Licensed by a fixed SUPPORT pattern set, all byte-level:
//       P_DEF  (0): definitional containment — a cited KNOWLEDGE span contains
//              all key (non-stop) terms of the current span. Bottoms out.
//       P_BECAUSE(1): cited span matches "X because Y" (byte split); the X-part
//              shares >=4 non-stop words with the current span; new current = Y.
//       P_SINCE (2): "since Y, X" — same, new current = Y-part.
//       P_THEREFORE(3): "Y. Therefore X." — X-part shares >=4 non-stop words
//              with the current span; new current = Y = the previous problem
//              sentence (sentence-granular premise items).
//       P_GIVEN(4): a cited PROBLEM premise sentence (never the goal statement
//              itself, never for the initial candidate) contains all key terms
//              of the current span. Bottoms out.
//     Marker links do NOT bottom out: the Y-part must itself be supported
//     (split on top-level "," / ";" / " and " into conjuncts first, each
//     supported independently). Chains bounded to <=8 links / depth <=8.
//     Problem premises are sentence-granular items; knowledge items are
//     body-only (the "[Kddd] (kind)" header is citation metadata, cited
//     separately via the item id).
//   CONTRADICTION (overlap+polarity, N1-style): a link dies if its CONCLUSION
//     span shares >=4 non-stop words with another cited span at flipped
//     polarity (effective polarity flips for the negated candidate), or if
//     its PROBLEM premise does. Store-vs-store pairs never meet: the store
//     is the authored consistent background theory; pitting definitions
//     against each other only measures shared vocabulary.
//   ELIMINATE (deliberative rounds, H5-style): score candidates by
//     (completeness = 1000*licensed_links/total, quality = 1000*bottoming/total);
//     eliminate the weakest; repeat. Outright elimination: a chosen link's
//     premise contradicts a cited span (overlap >=4 + polarity flip), or no
//     pattern licenses any support step (dead end).
//   HONESTY: links are never invented (every premise is a byte-span of cited
//     input/store text). >3 candidate premise spans for one link -> weak link;
//     two weak links -> candidate eliminated.
//   REFEREE: surviving contradicting candidates weighed by (completeness,
//     quality); cited-conclusion beats spliced-conclusion on ties.
//   VERDICT: exactly one surviving complete-chain candidate -> DERIVE (or
//     REFUTED if it is the negation candidate; trace = chain reversed).
//     Zero survivors, or >1 after referee -> WITHHOLD.
//
// ANTI-BRIDGE posture: no typed variables, no scope, no formula/term grammar,
// no unification, no NL->schema mapping. Matching is case-insensitive BYTE
// equality of word spans; the only fixed vocabularies are (a) a stop-word list
// of closed-class function words (explicitly excluded from meaning, required
// by the spec's ">=4 non-stop bytes"), and (b) a negation-marker list for the
// spec's "overlap+polarity" contradiction test. Definition heads are matched by
// raw bytes (works for nonce vocabulary: no English lexicon is consulted).
// Every derivation step cites byte-spans of input/store text or prior steps.
//
// Usage: n2_bin <problem.txt> <out_path> [knowledge_store]
//   CWD must be math_logic/round3/engines/n2 (imports resolve relative to CWD).
//   Default store (pinned): ../../batteries/knowledge/KNOWLEDGE_STORE_NL.md
//   (R3 NL store, committed db913da907d0 on tnn-native-lab; the brief's
//   guessed path batteries/KNOWLEDGE_STORE_NL.md does not exist on disk).
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")

// ---------------- byte helpers ----------------
fn n2_is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn n2_is_ws(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}
fn n2_is_punct(c:u8)i32 {
    if(c==46 || c==44 || c==59 || c==58 || c==40 || c==41 || c==34 || c==39){return 1;}
    return 0;
}
fn n2_tolower(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
// case-insensitive byte equality (NOT slice ==; znc forbids == on slices)
fn n2_eq_ci(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){
        if(n2_tolower(a[i])!=n2_tolower(b[i])){return 0;}
        i=i+1;
    }
    return 1;
}
// FNV-1a over lowercased bytes (i64 wraps mod 2^64; bit pattern == u64 form)
fn n2_fnv_word(s:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let i:i32=0;
    while(i<s.len){
        h=h ^ (n2_tolower(s[i]) as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// next alnum word in buf[off..off+len] at *cur (relative). Sets *wo,*wl.
// Returns 1 on word, 0 at end.
fn n2_next_word(buf:[]u8,off:i32,len:i32,cur:*i32,wo:*i32,wl:*i32)i32 {
    let p:i32=off+cur.*;
    let end:i32=off+len;
    while(p<end && n2_is_alnum(buf[p])==0){p=p+1;}
    if(p>=end){cur.*=p-off;return 0;}
    let s:i32=p;
    while(p<end && n2_is_alnum(buf[p])==1){p=p+1;}
    wo.*=s;wl.*=p-s;cur.*=p-off;
    return 1;
}
// trim leading/trailing whitespace+punct from (off,len); results via out params.
fn n2_trim2(buf:[]u8,off:i32,len:i32,ro:*i32,rl:*i32)void {
    let a:i32=off;let b:i32=off+len;
    while(a<b && (n2_is_ws(buf[a])==1 || n2_is_punct(buf[a])==1)){a=a+1;}
    while(b>a && (n2_is_ws(buf[b-1])==1 || n2_is_punct(buf[b-1])==1)){b=b-1;}
    ro.*=a;rl.*=b-a;
}

// ---------------- engine state (flat small structs; touched via *T params) ----------------
struct N2T { pb:[]u8, pl:i32, kb:[]u8, kl:i32, ar:[]u8, an:i32 }
struct N2Sp { bo:i32, off:i32, len:i32 }
struct N2I { bo:[]u8, off:[]u8, len:[]u8, kid:[]u8, kidl:[]u8, def:[]u8, n:i32 }
struct N2K { koff:[]u8, kn:[]u8, kpol:[]u8, ka:[]u8, kcur:i32, n:i32 }
struct N2D { ho:[]u8, hl:[]u8, dfo:[]u8, dfl:[]u8, it:[]u8, n:i32 }
struct N2L { cb:[]u8, co:[]u8, cl:[]u8, io:[]u8, po:[]u8, pl:[]u8, pid:[]u8, n:i32 }
struct N2CS { bo:[]u8, off:[]u8, len:[]u8, neg:[]u8, alive:[]u8, comp:[]u8, qual:[]u8, n:i32 }
struct N2W { st:[]u8, ns:i32, ob:[]u8, obn:i32, nb:[]u8 }

fn n2_tbuf(t:*N2T,bo:i32)[]u8 {
    let b:[]u8=t.*.pb;
    if(bo==1){b=t.*.kb;}
    if(bo==2){b=t.*.ar;}
    return b;
}
fn n2_item_bo(it:*N2I,i:i32)i32 { return au_get32(it.*.bo,i); }
fn n2_item_off(it:*N2I,i:i32)i32 { return au_get32(it.*.off,i); }
fn n2_item_len(it:*N2I,i:i32)i32 { return au_get32(it.*.len,i); }

// ---------------- stop words (closed-class function words only) ----------------
fn n2_stop_init(w:*N2W)void {
    let lit:[]u8="the a an is are was were be been being of to in on for with by and or as at from that this these those it its if then than so but such every each all any some there here which who what when where how why can could should would may might must shall will do does did has have had having into onto out up down over under between through during before after above below more most other same only very just also too we you your his her their our my i me he she they them";
    let tbl:[]u8=nio_alloc(128*8);
    w.*.st=tbl;w.*.ns=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n2_next_word(lit,0,lit.len,&cur,&wo,&wl)==1){
        if(w.*.ns>=128){break;}
        au_put64(tbl,w.*.ns,n2_fnv_word(lit[wo..wo+wl]));
        w.*.ns=w.*.ns+1;
    }
}
fn n2_is_stop(w:*N2W,word:[]u8)i32 {
    let h:i64=n2_fnv_word(word);
    let i:i32=0;
    while(i<w.*.ns){
        if(au_get64(w.*.st,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- key terms: distinct non-stop word hashes of a span ----------------
// arr holds u64 hashes (cap entries). Returns count.
fn n2_key_terms(t:*N2T,w:*N2W,bo:i32,off:i32,len:i32,arr:[]u8,cap:i32)i32 {
    let n:i32=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let buf:[]u8=n2_tbuf(t,bo);
    while(n2_next_word(buf,off,len,&cur,&wo,&wl)==1){
        let wb:[]u8=buf[wo..wo+wl];
        if(n2_is_stop(w,wb)==1){continue;}
        let h:i64=n2_fnv_word(wb);
        let j:i32=0;let seen:i32=0;
        while(j<n){
            if(au_get64(arr,j)==h){seen=1;break;}
            j=j+1;
        }
        if(seen==0){
            if(n>=cap){break;}
            au_put64(arr,n,h);
            n=n+1;
        }
    }
    return n;
}
fn n2_in_terms(arr:[]u8,n:i32,h:i64)i32 {
    let j:i32=0;
    while(j<n){
        if(au_get64(arr,j)==h){return 1;}
        j=j+1;
    }
    return 0;
}
// shared distinct non-stop words between span A (precomputed terms) and span B.
fn n2_shared_tb(t:*N2T,w:*N2W,ta:[]u8,na:i32,bbo:i32,boff:i32,blen:i32)i32 {
    let cnt:i32=0;
    let seen:[]u8=nio_alloc(160*8);
    if(seen.len!=160*8){return -1;}
    let nseen:i32=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let buf:[]u8=n2_tbuf(t,bbo);
    while(n2_next_word(buf,boff,blen,&cur,&wo,&wl)==1){
        let wb:[]u8=buf[wo..wo+wl];
        if(n2_is_stop(w,wb)==1){continue;}
        let h:i64=n2_fnv_word(wb);
        if(n2_in_terms(ta,na,h)==1 && n2_in_terms(seen,nseen,h)==0){
            if(nseen<160){au_put64(seen,nseen,h);nseen=nseen+1;}
            cnt=cnt+1;
        }
    }
    nio_free(seen);
    return cnt;
}
// covers(A,B): every distinct non-stop word of span B occurs in A's term set.
fn n2_covers_tb(t:*N2T,w:*N2W,ta:[]u8,na:i32,bbo:i32,boff:i32,blen:i32)i32 {
    let any:i32=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let buf:[]u8=n2_tbuf(t,bbo);
    while(n2_next_word(buf,boff,blen,&cur,&wo,&wl)==1){
        let wb:[]u8=buf[wo..wo+wl];
        if(n2_is_stop(w,wb)==1){continue;}
        any=1;
        if(n2_in_terms(ta,na,n2_fnv_word(wb))==0){return 0;}
    }
    return any;
}

// ---------------- sealed guard ----------------
fn n2_has_sealed(p:[]u8)i32 {
    let i:i32=0;
    while(i+6<=p.len){
        if(p[i]==115 && p[i+1]==101 && p[i+2]==97 && p[i+3]==108 && p[i+4]==101 && p[i+5]==100){return 1;}
        i=i+1;
    }
    return 0;
}
fn n2_guarded_read(p:[]u8,buf:[]u8)i64 {
    if(n2_has_sealed(p)==1){return -99;}
    return dlb_read_file(p,buf);
}

// ---------------- marker search (case-insensitive, word boundaries) ----------------
// Returns relative position of mark in buf[off..off+len] at/after start, or -1.
// need_alnum_before: for "n't" (must follow a letter).
fn n2_find_mark(buf:[]u8,off:i32,len:i32,mark:[]u8,start:i32,nab:i32)i32 {
    let end:i32=off+len;
    let p:i32=off+start;
    while(p+mark.len<=end){
        if(n2_eq_ci(buf[p..p+mark.len],mark)==1){
            let ok:i32=1;
            if(nab==1){
                if(p<=off || n2_is_alnum(buf[p-1])==0){ok=0;}
            } else {
                if(p>off && n2_is_alnum(buf[p-1])==1){ok=0;}
            }
            if(ok==1 && p+mark.len<end && n2_is_alnum(buf[p+mark.len])==1){ok=0;}
            if(ok==1){return p-off;}
        }
        p=p+1;
    }
    return -1;
}

// ---------------- polarity: parity of negation-marker hits ----------------
fn n2_polarity(t:*N2T,w:*N2W,bo:i32,off:i32,len:i32)i32 {
    let buf:[]u8=n2_tbuf(t,bo);
    let cnt:i32=0;
    let m0:[]u8="not";
    if(n2_find_mark(buf,off,len,m0,0,0)>=0){
        // count all occurrences
        let s:i32=0;
        while(s<len){
            let f:i32=n2_find_mark(buf,off,len,m0,s,0);
            if(f<0){break;}
            cnt=cnt+1;s=f+1;
        }
    }
    let m1:[]u8="n't";
    let s1:i32=0;
    while(s1<len){
        let f1:i32=n2_find_mark(buf,off,len,m1,s1,1);
        if(f1<0){break;}
        cnt=cnt+1;s1=f1+1;
    }
    let m2:[]u8="never";
    let s2:i32=0;
    while(s2<len){
        let f2:i32=n2_find_mark(buf,off,len,m2,s2,0);
        if(f2<0){break;}
        cnt=cnt+1;s2=f2+1;
    }
    let m3:[]u8="cannot";
    let s3:i32=0;
    while(s3<len){
        let f3:i32=n2_find_mark(buf,off,len,m3,s3,0);
        if(f3<0){break;}
        cnt=cnt+1;s3=f3+1;
    }
    let m4:[]u8="impossible";
    let s4:i32=0;
    while(s4<len){
        let f4:i32=n2_find_mark(buf,off,len,m4,s4,0);
        if(f4<0){break;}
        cnt=cnt+1;s4=f4+1;
    }
    let m5:[]u8="false";
    let s5:i32=0;
    while(s5<len){
        let f5:i32=n2_find_mark(buf,off,len,m5,s5,0);
        if(f5<0){break;}
        cnt=cnt+1;s5=f5+1;
    }
    let m6:[]u8="contradiction";
    let s6:i32=0;
    while(s6<len){
        let f6:i32=n2_find_mark(buf,off,len,m6,s6,0);
        if(f6<0){break;}
        cnt=cnt+1;s6=f6+1;
    }
    let m7:[]u8="neither";
    let s7:i32=0;
    while(s7<len){
        let f7:i32=n2_find_mark(buf,off,len,m7,s7,0);
        if(f7<0){break;}
        cnt=cnt+1;s7=f7+1;
    }
    let m8:[]u8="no";
    let s8:i32=0;
    while(s8<len){
        let f8:i32=n2_find_mark(buf,off,len,m8,s8,0);
        if(f8<0){break;}
        cnt=cnt+1;s8=f8+1;
    }
    return cnt%2;
}

// ---------------- conjunct split: top-level "," ";" or " and " ----------------
// Fills co/cl arenas (i32 slots, cap 4). Returns part count (1 = no split).
fn n2_split_conj(t:*N2T,bo:i32,off:i32,len:i32,co:[]u8,cl:[]u8)i32 {
    let buf:[]u8=n2_tbuf(t,bo);
    let seps:[]u8=nio_alloc(8*4);
    let wd:[]u8=nio_alloc(8*4);
    if(seps.len!=8*4 || wd.len!=8*4){nio_free(seps);nio_free(wd);return 1;}
    let ns:i32=0;
    let depth:i32=0;
    let p:i32=off;
    let end:i32=off+len;
    while(p<end && ns<8){
        let c:u8=buf[p];
        if(c==40){depth=depth+1;}
        if(c==41 && depth>0){depth=depth-1;}
        if(depth==0){
            if(c==44 || c==59){
                au_put32(seps,ns,p-off);au_put32(wd,ns,1);ns=ns+1;
            } else {
                if((c==97 || c==65) && p+3<=end){
                    if(n2_eq_ci(buf[p..p+3],"and")==1){
                        let bl:i32=1;let br:i32=1;
                        if(p>off && n2_is_alnum(buf[p-1])==1){bl=0;}
                        if(p+3<end && n2_is_alnum(buf[p+3])==1){br=0;}
                        if(bl==1 && br==1){
                            au_put32(seps,ns,p-off);au_put32(wd,ns,3);ns=ns+1;
                            p=p+3;continue;
                        }
                    }
                }
            }
        }
        p=p+1;
    }
    if(ns==0 || ns>3){nio_free(seps);nio_free(wd);return 1;}
    let prev:i32=0;
    let k:i32=0;
    while(k<=ns){
        let sp:i32=len;
        let sw:i32=0;
        if(k<ns){sp=au_get32(seps,k);sw=au_get32(wd,k);}
        let ro:i32=0;let rl:i32=0;
        n2_trim2(buf,off+prev,sp-prev,&ro,&rl);
        au_put32(co,k,ro);au_put32(cl,k,rl);
        prev=sp+sw;
        k=k+1;
    }
    nio_free(seps);nio_free(wd);
    return ns+1;
}

// ---------------- problem field: value span of a line-start KEY ----------------
fn n2_field(buf:[]u8,n:i32,key:[]u8,ro:*i32,rl:*i32)i32 {
    let i:i32=0;
    while(i<n){
        let ls:i32=1;
        if(i>0 && buf[i-1]!=10){ls=0;}
        if(ls==1){
            let k:i32=0;
            while(k<key.len && i+k<n && buf[i+k]==key[k]){k=k+1;}
            if(k==key.len){
                let s:i32=i+k;let e:i32=s;
                while(e<n && buf[e]!=10){e=e+1;}
                let ro2:i32=0;let rl2:i32=0;
                n2_trim2(buf,s,e-s,&ro2,&rl2);
                ro.*=ro2;rl.*=rl2;
                return 1;
            }
        }
        i=i+1;
    }
    return 0;
}

// add one cited item; returns index or -1. Computes key terms + polarity.
fn n2_add_item(t:*N2T,it:*N2I,kt:*N2K,w:*N2W,bo:i32,off:i32,len:i32,
               kido:i32,kidl:i32,isdef:i32)i32 {
    if(it.*.n>=512){return -1;}
    let i:i32=it.*.n;
    au_put32(it.*.bo,i,bo);
    au_put32(it.*.off,i,off);
    au_put32(it.*.len,i,len);
    au_put32(it.*.kid,i,kido);
    au_put32(it.*.kidl,i,kidl);
    au_put32(it.*.def,i,isdef);
    let arr:[]u8=nio_alloc(160*8);
    if(arr.len!=160*8){return -1;}
    let n:i32=n2_key_terms(t,w,bo,off,len,arr,160);
    if(kt.*.kcur+n>16384){nio_free(arr);return -1;}
    au_put32(kt.*.koff,i,kt.*.kcur);
    au_put32(kt.*.kn,i,n);
    let ka:[]u8=kt.*.ka;
    let q:i32=0;
    while(q<n){
        au_put64(ka,kt.*.kcur,au_get64(arr,q));
        kt.*.kcur=kt.*.kcur+1;
        q=q+1;
    }
    nio_free(arr);
    au_put32(kt.*.kpol,i,n2_polarity(t,w,bo,off,len));
    it.*.n=i+1;
    kt.*.n=it.*.n;
    return i;
}
fn n2_item_pol(kt:*N2K,i:i32)i32 { return au_get32(kt.*.kpol,i); }

// ---------------- knowledge store parse (R3 NL format) ----------------
// Items: a header line "[Kddd] (kind)" followed by body lines until a blank
// line or the next header. Item span = header through body (trimmed).
// Item id = the 6 bytes "[Kddd]". def bit set when the header carries
// "(definition)". Comment lines ("#...") are ignored.
fn n2_is_kheader(buf:[]u8,ro:i32,rl:i32)i32 {
    if(rl<7){return 0;}
    if(buf[ro]!=91 || buf[ro+1]!=75){return 0;}
    if(buf[ro+2]<48||buf[ro+2]>57||buf[ro+3]<48||buf[ro+3]>57||buf[ro+4]<48||buf[ro+4]>57){return 0;}
    if(buf[ro+5]!=93){return 0;}
    return 1;
}
fn n2_parse_store(t:*N2T,it:*N2I,kt:*N2K,w:*N2W)i32 {
    let buf:[]u8=t.*.kb;
    let n:i32=t.*.kl;
    let pos:i32=0;
    while(pos<n){
        let ls:i32=pos;let e:i32=pos;
        while(e<n && buf[e]!=10){e=e+1;}
        let ro:i32=0;let rl:i32=0;
        n2_trim2(buf,ls,e-ls,&ro,&rl);
        let adv:i32=e;
        if(e<n){adv=e+1;}
        pos=adv;
        if(n2_is_kheader(buf,ro,rl)==0){continue;}
        let isdef:i32=0;
        // NB: check the UNTRIMMED line — n2_trim2 strips boundary parens,
        // which would eat the ")" of "(definition)".
        if(n2_find_mark(buf,ls,e-ls,"(definition)",0,0)>=0){isdef=1;}
        // body: following non-blank lines until a blank line or next header
        let be:i32=adv;
        while(be<n){
            let ls2:i32=be;let e2:i32=be;
            while(e2<n && buf[e2]!=10){e2=e2+1;}
            let ro2:i32=0;let rl2:i32=0;
            n2_trim2(buf,ls2,e2-ls2,&ro2,&rl2);
            if(rl2==0){break;}
            if(n2_is_kheader(buf,ro2,rl2)==1){break;}
            be=e2;
            if(e2<n){be=e2+1;}
        }
        let tro:i32=0;let trl:i32=0;
        n2_trim2(buf,ro,be-ro,&tro,&trl);
        // Item span = body only. The "[Kddd] (kind)" header is citation
        // metadata, not claim bytes: its word "definition" would otherwise
        // make every definition share a spurious overlap word, and the
        // contradiction scan would read shared vocabulary as inconsistency.
        // The id "[Kddd]" is still cited separately via kid/kidl.
        let bs:i32=ro;
        while(bs<be && buf[bs]!=10){bs=bs+1;}
        if(bs<be){bs=bs+1;}
        let bro:i32=0;let brl:i32=0;
        n2_trim2(buf,bs,be-bs,&bro,&brl);
        if(brl>=8){
            if(n2_add_item(t,it,kt,w,1,bro,brl,ro,6,isdef)<0){return -1;}
        }
        pos=be;
    }
    return 0;
}

// ---------------- definition head/definiens extraction ----------------
// For [definition] items: scan for ':' heads starting at a clause boundary
// (start of body, or after ". "/"! "/"? "/"(; "). Head = 1..4 letter/space/
// hyphen words, len<=48. Definiens = bytes after ':' up to next head start.
fn n2_head_ok(hb:[]u8)i32 {
    if(hb.len==0 || hb.len>48){return 0;}
    let nw:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n2_next_word(hb,0,hb.len,&cur,&wo,&wl)==1){
        nw=nw+1;
        let k:i32=0;
        while(k<wl){
            let c:u8=hb[wo+k];
            let okc:i32=0;
            if(c>=65 && c<=90){okc=1;}
            if(c>=97 && c<=122){okc=1;}
            if(okc==0){return 0;}
            k=k+1;
        }
    }
    if(nw<1 || nw>4){return 0;}
    return 1;
}
fn n2_parse_defs(t:*N2T,it:*N2I,df:*N2D)void {
    let i:i32=0;
    while(i<it.*.n){
        if(au_get32(it.*.def,i)==0){i=i+1;continue;}
        let ibo:i32=n2_item_bo(it,i);
        if(ibo!=1){i=i+1;continue;}
        let ioff:i32=n2_item_off(it,i);
        let ilen:i32=n2_item_len(it,i);
        let buf:[]u8=n2_tbuf(t,ibo);
        // NL format: definition heads live in the body, which starts after
        // the "[Kddd] (kind)" header line. (Item spans are already body-only;
        // keep the newline scan for robustness.)
        let bs:i32=ioff;
        let nl:i32=ioff;
        while(nl<ioff+ilen && buf[nl]!=10){nl=nl+1;}
        if(nl<ioff+ilen){bs=nl+1;}
        let p:i32=bs;
        let end:i32=ioff+ilen;
        let prev_hs:i32=-1;let prev_he:i32=-1;let prev_cs:i32=-1;
        while(p<end && df.*.n<256){
            if(buf[p]!=58){p=p+1;continue;}
            // candidate head: walk back over letters/spaces/hyphens
            let hs:i32=p;
            while(hs>bs){
                let c:u8=buf[hs-1];
                if((c>=65 && c<=90) || (c>=97 && c<=122) || c==32 || c==45){hs=hs-1;} else {break;}
            }
            let ro:i32=0;let rl:i32=0;
            n2_trim2(buf,hs,p-hs,&ro,&rl);
            let hb:[]u8=buf[ro..ro+rl];
            // boundary: head must start at body start or after ". "/"! "/"? "/"; "/(
            let bnd:i32=0;
            if(ro<=bs){bnd=1;}
            if(ro>=bs+2){
                let pc:u8=buf[ro-1];let ppc:u8=buf[ro-2];
                if(pc==32 && (ppc==46 || ppc==33 || ppc==63 || ppc==59 || ppc==93)){bnd=1;}
                if(pc==40){bnd=1;}
            }
            if(bnd==1 && n2_head_ok(hb)==1){
                // close previous def: definiens = [prev_cs, ro) trimmed
                if(prev_hs>=0){
                    let dro:i32=0;let drl:i32=0;
                    n2_trim2(buf,prev_cs,ro-prev_cs,&dro,&drl);
                    if(drl>=8){
                        let di:i32=df.*.n;
                        au_put32(df.*.ho,di,prev_hs);au_put32(df.*.hl,di,prev_he-prev_hs);
                        au_put32(df.*.dfo,di,dro);au_put32(df.*.dfl,di,drl);
                        au_put32(df.*.it,di,i);
                        df.*.n=di+1;
                    }
                }
                prev_hs=ro;prev_he=ro+rl;prev_cs=p+1;
            }
            p=p+1;
        }
        if(prev_hs>=0 && df.*.n<256){
            let dro:i32=0;let drl:i32=0;
            n2_trim2(buf,prev_cs,end-prev_cs,&dro,&drl);
            if(drl>=8){
                let di2:i32=df.*.n;
                au_put32(df.*.ho,di2,prev_hs);au_put32(df.*.hl,di2,prev_he-prev_hs);
                au_put32(df.*.dfo,di2,dro);au_put32(df.*.dfl,di2,drl);
                au_put32(df.*.it,di2,i);
                df.*.n=di2+1;
            }
        }
        i=i+1;
    }
}

// ---------------- definition expansion ----------------
// Locate the head's word-run inside the goal (case-insensitive byte match).
// Returns 1 with *ro/*rl = matched byte span.
fn n2_find_head_run(t:*N2T,w:*N2W,df:*N2D,di:i32,gbo:i32,goff:i32,glen:i32,
                    ro:*i32,rl:*i32)i32 {
    let ho:i32=au_get32(df.*.ho,di);let hl:i32=au_get32(df.*.hl,di);
    let hb:[]u8=n2_tbuf(t,1);
    let hh:[]u8=nio_alloc(8*8);
    if(hh.len!=8*8){return 0;}
    let nh:i32=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n2_next_word(hb,ho,hl,&cur,&wo,&wl)==1){
        if(nh>=8){break;}
        au_put64(hh,nh,n2_fnv_word(hb[wo..wo+wl]));
        nh=nh+1;
    }
    if(nh==0){nio_free(hh);return 0;}
    let go:[]u8=nio_alloc(256*4);let gl:[]u8=nio_alloc(256*4);
    if(go.len!=256*4 || gl.len!=256*4){nio_free(hh);nio_free(go);nio_free(gl);return 0;}
    let gb:[]u8=n2_tbuf(t,gbo);
    let nw:i32=0;let c2:i32=0;let w2:i32=0;let l2:i32=0;
    while(n2_next_word(gb,goff,glen,&c2,&w2,&l2)==1){
        if(nw>=256){break;}
        au_put32(go,nw,w2);au_put32(gl,nw,l2);
        nw=nw+1;
    }
    let rc:i32=0;
    let s:i32=0;
    while(s+nh<=nw){
        let k:i32=0;
        while(k<nh){
            let gw:[]u8=gb[au_get32(go,s+k)..au_get32(go,s+k)+au_get32(gl,s+k)];
            if(n2_fnv_word(gw)!=au_get64(hh,k)){break;}
            k=k+1;
        }
        if(k==nh){
            // byte-level verify: compare each head word with goal word
            // (hash prefilter above; exact bytes decide)
            let c3:i32=0;let w3:i32=0;let l3:i32=0;
            let cc:i32=0;
            let v:i32=1;
            while(n2_next_word(hb,ho,hl,&cc,&w3,&l3)==1){
                let hw3:[]u8=hb[w3..w3+l3];
                let gw3:[]u8=gb[au_get32(go,s+v-1)..au_get32(go,s+v-1)+au_get32(gl,s+v-1)];
                if(n2_eq_ci(hw3,gw3)==0){v=0;break;}
                v=v+1;
            }
            if(v==nh+1){
                ro.*=au_get32(go,s);
                rl.*=au_get32(go,s+nh-1)+au_get32(gl,s+nh-1)-au_get32(go,s);
                rc=1;
                break;
            }
        }
        s=s+1;
    }
    nio_free(hh);nio_free(go);nio_free(gl);
    return rc;
}
// Expand: goal with first head occurrence replaced by definiens bytes.
// Appends to t.ar; returns arena offset, *rl = length; -1 on failure.
fn n2_expand(t:*N2T,w:*N2W,df:*N2D,di:i32,gbo:i32,goff:i32,glen:i32,rl:*i32)i32 {
    let mo:i32=0;let ml:i32=0;
    if(n2_find_head_run(t,w,df,di,gbo,goff,glen,&mo,&ml)==0){return -1;}
    let dfo:i32=au_get32(df.*.dfo,di);let dfl:i32=au_get32(df.*.dfl,di);
    let total:i32=mo-goff+dfl+(goff+glen-mo-ml);
    if(t.*.an+total>262144){return -1;}
    let dst:i32=t.*.an;
    let ar:[]u8=t.*.ar;
    let gb:[]u8=n2_tbuf(t,gbo);
    let kb:[]u8=t.*.kb;
    let k:i32=0;
    while(k<mo-goff){ar[dst+k]=gb[goff+k];k=k+1;}
    let j:i32=0;
    while(j<dfl){ar[dst+(mo-goff)+j]=kb[dfo+j];j=j+1;}
    let k2:i32=mo+ml;
    while(k2<goff+glen){ar[dst+(mo-goff)+dfl+(k2-mo-ml)]=gb[k2];k2=k2+1;}
    t.*.an=dst+total;
    rl.*=total;
    return dst;
}

// ---------------- marker sentence split ----------------
// which: 0=because (X before, Y after), 1=since (Y after marker to comma, X rest),
//        2=therefore (Y before, X after). All spans trimmed. Returns 1 ok.
fn n2_split_marker(t:*N2T,bo:i32,ioff:i32,ilen:i32,mp:i32,mlen:i32,which:i32,
                   xo:*i32,xl:*i32,yo:*i32,yl:*i32,so:*i32,sl:*i32)i32 {
    let buf:[]u8=n2_tbuf(t,bo);
    let mabs:i32=ioff+mp;
    let ss:i32=ioff;
    let q:i32=mabs-2;
    while(q>=ioff){
        let c:u8=buf[q];
        if((c==46 || c==33 || c==63) && q+1<mabs && buf[q+1]==32){ss=q+2;break;}
        q=q-1;
    }
    let se:i32=ioff+ilen;
    q=mabs+mlen;
    while(q<ioff+ilen-1){
        let c2:u8=buf[q];
        if((c2==46 || c2==33 || c2==63) && buf[q+1]==32){se=q+1;break;}
        q=q+1;
    }
    so.*=ss;sl.*=se-ss;
    let xa:i32=0;let xb:i32=0;let ya:i32=0;let yb:i32=0;
    if(which==0){xa=ss;xb=mabs;ya=mabs+mlen;yb=se;}
    if(which==1){
        let cm:i32=mabs+mlen;
        while(cm<se && buf[cm]!=44 && buf[cm]!=59){cm=cm+1;}
        if(cm>=se){return 0;}
        ya=mabs+mlen;yb=cm;xa=cm+1;xb=se;
    }
    if(which==2){ya=ss;yb=mabs;xa=mabs+mlen;xb=se;}
    let txo:i32=0;let txl:i32=0;let tyo:i32=0;let tyl:i32=0;
    n2_trim2(buf,xa,xb-xa,&txo,&txl);
    n2_trim2(buf,ya,yb-ya,&tyo,&tyl);
    xo.*=txo;xl.*=txl;yo.*=tyo;yl.*=tyl;
    return 1;
}

// pid values
// 0=DEF 1=BECAUSE 2=SINCE 3=THEREFORE 4=GIVEN
fn n2_pid_name(pid:i32)[]u8 {
    if(pid==0){return "DEF";}
    if(pid==1){return "BECAUSE";}
    if(pid==2){return "SINCE";}
    if(pid==3){return "THEREFORE";}
    return "GIVEN";
}

// status: 0 complete, 1 dead_end, 2 contradiction, 3 weak_kill
fn n2_support(t:*N2T,it:*N2I,kt:*N2K,w:*N2W,lk:*N2L,
              cbo:i32,coff:i32,clen:i32,neg:i32,
              vis:[]u8,vn:*i32,osrc:*N2Sp,depth:i32,wk:*i32)i32 {
    if(depth>8){return 1;}
    if(lk.*.n>=8){return 1;}
    // Cycle check: the current span is always the LAST entry in vis (every
    // call site appends it before recursing), so only earlier entries are
    // ancestors. Checking the last entry would reject the current span
    // itself and kill every candidate at depth 0 (fixed 2026-09-25).
    let vlim:i32=vn.*-1;
    if(vlim<0){vlim=0;}
    let vi:i32=0;
    while(vi<vlim){
        if(au_get32(vis,vi*3)==cbo && au_get32(vis,vi*3+1)==coff && au_get32(vis,vi*3+2)==clen){return 1;}
        vi=vi+1;
    }
    // conjunctive split: each conjunct must complete independently
    let co:[]u8=nio_alloc(4*4);let cl:[]u8=nio_alloc(4*4);
    if(co.len!=4*4 || cl.len!=4*4){nio_free(co);nio_free(cl);return 1;}
    let nc:i32=n2_split_conj(t,cbo,coff,clen,co,cl);
    if(nc>1){
        let k:i32=0;let st:i32=0;
        while(k<nc){
            let po2:i32=au_get32(co,k);let pl2:i32=au_get32(cl,k);
            if(pl2>0){
                au_put32(vis,vn.* *3,cbo);au_put32(vis,vn.* *3+1,po2);au_put32(vis,vn.* *3+2,pl2);
                vn.*=vn.*+1;
                st=n2_support(t,it,kt,w,lk,cbo,po2,pl2,neg,vis,vn,osrc,depth+1,wk);
                vn.*=vn.*-1;
                if(st!=0){nio_free(co);nio_free(cl);return st;}
            }
            k=k+1;
        }
        nio_free(co);nio_free(cl);
        return 0;
    }
    nio_free(co);nio_free(cl);
    // single span: gather current key terms + polarity
    let tarr:[]u8=nio_alloc(160*8);
    if(tarr.len!=160*8){return 1;}
    let cna:i32=n2_key_terms(t,w,cbo,coff,clen,tarr,160);
    let cpol:i32=n2_polarity(t,w,cbo,coff,clen);
    let ka:[]u8=kt.*.ka;
    let best_sh:i32=-1;let best_pid:i32=99;let best_i:i32=-1;
    let bpo:i32=0;let bpl:i32=0;let bpbo:i32=0;
    let byo:i32=0;let byl:i32=0;let bybo:i32=0;
    let nopt:i32=0;let bad_sh:i32=-1;
    let i:i32=0;
    while(i<it.*.n){
        let ibo:i32=n2_item_bo(it,i);
        let ioff:i32=n2_item_off(it,i);
        let ilen:i32=n2_item_len(it,i);
        let ib:[]u8=n2_tbuf(t,ibo);
        let toa:i32=au_get32(kt.*.koff,i);let tna:i32=au_get32(kt.*.kn,i);
        // toa is a u64 ENTRY index into ka; byte slice needs *8
        let ita:[]u8=ka[toa*8..toa*8+tna*8];
        let ipol:i32=au_get32(kt.*.kpol,i);
        // P_DEF: knowledge items only (bottoms out in gifted text).
        // Requires >=2 key terms in the current span: a single shared word
        // (e.g. a variable fragment from " and "-splitting) is too weak for
        // definitional support and licenses vacuous links.
        if(ibo==1 && cna>=2){
            if(n2_covers_tb(t,w,ita,tna,cbo,coff,clen)==1){
                let ok:i32=0;
                if(neg==0 && ipol==cpol){ok=1;}
                if(neg==1 && ipol!=cpol){ok=1;}
                let sh:i32=n2_shared_tb(t,w,ita,tna,cbo,coff,clen);
                if(ok==1){
                    nopt=nopt+1;
                    if(sh>best_sh || (sh==best_sh && 0<best_pid)){
                        best_sh=sh;best_pid=0;best_i=i;
                        bpo=ioff;bpl=ilen;bpbo=ibo;
                    }
                } else {
                    if(neg==0 && sh>bad_sh){bad_sh=sh;}
                }
            }
        }
        // P_GIVEN: problem premise spans only, never for the initial candidate
        if(ibo==0 && depth>=1){
            if(n2_covers_tb(t,w,ita,tna,cbo,coff,clen)==1){
                let ok2:i32=0;
                if(neg==0 && ipol==cpol){ok2=1;}
                if(neg==1 && ipol!=cpol){ok2=1;}
                let sh2:i32=n2_shared_tb(t,w,ita,tna,cbo,coff,clen);
                if(ok2==1){
                    nopt=nopt+1;
                    if(sh2>best_sh || (sh2==best_sh && 4<best_pid)){
                        best_sh=sh2;best_pid=4;best_i=i;
                        bpo=ioff;bpl=ilen;bpbo=ibo;
                    }
                } else {
                    if(neg==0 && sh2>bad_sh){bad_sh=sh2;}
                }
            }
        }
        // marker patterns: skip the sentence the current span came from.
        // "Y. Therefore X.": Y is the previous problem sentence (sentence
        // items make the marker's own item too narrow to hold Y).
        let m:i32=0;
        while(m<3){
            let mark:[]u8="because";
            if(m==1){mark="since";}
            if(m==2){mark="therefore";}
            let pid:i32=m+1;
            let pos:i32=0;
            while(pos<ilen){
                let f:i32=n2_find_mark(ib,ioff,ilen,mark,pos,0);
                if(f<0){break;}
                let xo:i32=0;let xl:i32=0;let yo:i32=0;let yl:i32=0;
                let so:i32=0;let sl:i32=0;
                if(n2_split_marker(t,ibo,ioff,ilen,f,mark.len,m,&xo,&xl,&yo,&yl,&so,&sl)==1){
                    let ybo:i32=ibo;
                    let noy:i32=0;
                    if(m==2){
                        if(ibo!=0 || i<1 || n2_item_bo(it,i-1)!=0){noy=1;}
                        if(noy==0){
                            ybo=0;
                            yo=n2_item_off(it,i-1);
                            yl=n2_item_len(it,i-1);
                        }
                    }
                    let skip:i32=0;
                    if(osrc.*.bo==ibo && osrc.*.off==so && osrc.*.len==sl){skip=1;}
                    if(noy==1){skip=1;}
                    if(skip==0 && xl>0 && xl<=2000 && yl<=2000){
                        let sh3:i32=n2_shared_tb(t,w,tarr,cna,ibo,xo,xl);
                        if(sh3>=4){
                            let xpol:i32=n2_polarity(t,w,ibo,xo,xl);
                            let ok3:i32=0;
                            if(neg==0 && xpol==cpol){ok3=1;}
                            if(neg==1 && xpol!=cpol){ok3=1;}
                            if(ok3==1){
                                nopt=nopt+1;
                                if(sh3>best_sh || (sh3==best_sh && pid<best_pid)){
                                    best_sh=sh3;best_pid=pid;best_i=i;
                                    bpo=so;bpl=sl;bpbo=ibo;
                                    byo=yo;byl=yl;bybo=ybo;
                                }
                            } else {
                                if(neg==0 && sh3>bad_sh){bad_sh=sh3;}
                            }
                        }
                    }
                }
                pos=f+1;
            }
            m=m+1;
        }
        i=i+1;
    }
    nio_free(tarr);
    if(best_i<0){
        if(bad_sh>=0){return 2;}
        return 1;
    }
    if(neg==0 && bad_sh>best_sh){return 2;}
    // honesty: ambiguous support -> weak link; two weak links kill the candidate
    if(nopt>3){
        wk.*=wk.*+1;
        if(wk.*>=2){return 3;}
    }
    // contradiction scan (overlap >=4 non-stop words + polarity flip).
    // Two checks: (a) the link's CONCLUSION must not contradict any other
    // cited span — the conclusion is the claim the link advances (effective
    // polarity flips for the negated candidate); (b) a PROBLEM premise must
    // not contradict other cited spans. Store-vs-store pairs are skipped:
    // the knowledge store is the authored consistent background theory, so
    // pitting its definitions against each other only measures shared
    // vocabulary (e.g. K102/K103 share "prime number integer 1" with a local
    // "not"), never genuine inconsistency.
    let contra:i32=0;
    let ceff:i32=cpol ^ neg;
    let carr:[]u8=nio_alloc(160*8);
    if(carr.len!=160*8){return 1;}
    let cna2:i32=n2_key_terms(t,w,cbo,coff,clen,carr,160);
    let j:i32=0;
    while(j<it.*.n){
        let jbo:i32=n2_item_bo(it,j);
        let joff:i32=n2_item_off(it,j);
        let jlen:i32=n2_item_len(it,j);
        let selfc:i32=0;
        if(jbo==cbo && joff==coff && jlen==clen){selfc=1;}
        if(selfc==0){
            let shj:i32=n2_shared_tb(t,w,carr,cna2,jbo,joff,jlen);
            if(shj>=4 && au_get32(kt.*.kpol,j)!=ceff){contra=1;break;}
        }
        j=j+1;
    }
    nio_free(carr);
    if(contra==0 && bpbo==0){
        let ppol2:i32=n2_polarity(t,w,bpbo,bpo,bpl);
        let parr:[]u8=nio_alloc(160*8);
        if(parr.len!=160*8){return 1;}
        let pna:i32=n2_key_terms(t,w,bpbo,bpo,bpl,parr,160);
        j=0;
        while(j<it.*.n){
            if(j!=best_i){
                let qbo:i32=n2_item_bo(it,j);
                let qoff:i32=n2_item_off(it,j);
                let qlen:i32=n2_item_len(it,j);
                let shj2:i32=n2_shared_tb(t,w,parr,pna,qbo,qoff,qlen);
                if(shj2>=4 && au_get32(kt.*.kpol,j)!=ppol2){contra=1;break;}
            }
            j=j+1;
        }
        nio_free(parr);
    }
    if(contra==1){return 2;}
    // licensed: push the link
    let ln:i32=lk.*.n;
    au_put32(lk.*.cb,ln,cbo);au_put32(lk.*.co,ln,coff);au_put32(lk.*.cl,ln,clen);
    au_put32(lk.*.io,ln,best_i);au_put32(lk.*.po,ln,bpo);au_put32(lk.*.pl,ln,bpl);
    au_put32(lk.*.pid,ln,best_pid);
    lk.*.n=ln+1;
    if(best_pid==0 || best_pid==4){return 0;}
    if(byl==0){return 0;}
    au_put32(vis,vn.* *3,bybo);au_put32(vis,vn.* *3+1,byo);au_put32(vis,vn.* *3+2,byl);
    vn.*=vn.*+1;
    let ns2:N2Sp=N2Sp{.bo=bpbo,.off=bpo,.len=bpl};
    let st2:i32=n2_support(t,it,kt,w,lk,bybo,byo,byl,neg,vis,vn,&ns2,depth+1,wk);
    vn.*=vn.*-1;
    return st2;
}

// ---------------- output helpers ----------------
fn w_raw(w:*N2W,s:[]u8)void {
    let n:i32=s.len;
    let o:[]u8=w.*.ob;
    if(w.*.obn+n>o.len){return;}
    let k:i32=0;
    while(k<n){o[w.*.obn+k]=s[k];k=k+1;}
    w.*.obn=w.*.obn+n;
}
fn w_ch(w:*N2W,c:u8)void {
    let o:[]u8=w.*.ob;
    if(w.*.obn<o.len){o[w.*.obn]=c;w.*.obn=w.*.obn+1;}
}
fn w_i64(w:*N2W,v:i64)void {
    let nb:[]u8=w.*.nb;
    if(v==0){w_ch(w,48);return;}
    let i:i32=24;let x:i64=v;
    while(x>0){i=i-1;nb[i]=((x%10)+48) as u8;x=x/10;}
    w_raw(w,nb[i..24]);
}
// B<bo>:<off>:<len> "<bytes up to 400>"
fn w_span(w:*N2W,t:*N2T,bo:i32,off:i32,len:i32)void {
    w_ch(w,66);w_i64(w,bo as i64);w_ch(w,58);w_i64(w,off as i64);w_ch(w,58);w_i64(w,len as i64);
    w_ch(w,32);w_ch(w,34);
    let b:[]u8=n2_tbuf(t,bo);
    let mlen:i32=len;
    if(mlen>400){mlen=400;}
    if(off+mlen>b.len){mlen=b.len-off;}
    if(mlen>0){w_raw(w,b[off..off+mlen]);}
    if(len>400){w_raw(w,"...");}
    w_ch(w,34);
}
fn n2_status_name(st:i32)[]u8 {
    if(st==0){return "complete";}
    if(st==1){return "dead_end";}
    if(st==2){return "contradiction";}
    return "weak_kill";
}
// shared>=4 non-stop words and polarity differs
fn n2_spans_contradict(t:*N2T,w:*N2W,bo1:i32,off1:i32,len1:i32,bo2:i32,off2:i32,len2:i32)i32 {
    let arr:[]u8=nio_alloc(160*8);
    if(arr.len!=160*8){return 0;}
    let n:i32=n2_key_terms(t,w,bo1,off1,len1,arr,160);
    let sh:i32=n2_shared_tb(t,w,arr,n,bo2,off2,len2);
    nio_free(arr);
    if(sh<4){return 0;}
    if(n2_polarity(t,w,bo1,off1,len1)!=n2_polarity(t,w,bo2,off2,len2)){return 1;}
    return 0;
}

// ---------------- init ----------------
fn n2_init(t:*N2T,it:*N2I,kt:*N2K,df:*N2D,w:*N2W,lk:*N2L,cs:*N2CS)i32 {
    t.*.ar=nio_alloc(262144);
    if(t.*.ar.len!=262144){return -1;}
    t.*.an=0;
    it.*.bo=nio_alloc(512*4);it.*.off=nio_alloc(512*4);it.*.len=nio_alloc(512*4);
    it.*.kid=nio_alloc(512*4);it.*.kidl=nio_alloc(512*4);it.*.def=nio_alloc(512*4);
    if(it.*.bo.len!=512*4 || it.*.def.len!=512*4){return -1;}
    it.*.n=0;
    kt.*.koff=nio_alloc(512*4);kt.*.kn=nio_alloc(512*4);kt.*.kpol=nio_alloc(512*4);
    kt.*.ka=nio_alloc(16384*8);
    if(kt.*.ka.len!=16384*8){return -1;}
    kt.*.kcur=0;kt.*.n=0;
    df.*.ho=nio_alloc(256*4);df.*.hl=nio_alloc(256*4);df.*.dfo=nio_alloc(256*4);
    df.*.dfl=nio_alloc(256*4);df.*.it=nio_alloc(256*4);
    if(df.*.ho.len!=256*4 || df.*.it.len!=256*4){return -1;}
    df.*.n=0;
    lk.*.cb=nio_alloc(16*4);lk.*.co=nio_alloc(16*4);lk.*.cl=nio_alloc(16*4);
    lk.*.io=nio_alloc(16*4);lk.*.po=nio_alloc(16*4);lk.*.pl=nio_alloc(16*4);
    lk.*.pid=nio_alloc(16*4);
    if(lk.*.cb.len!=16*4 || lk.*.pid.len!=16*4){return -1;}
    lk.*.n=0;
    cs.*.bo=nio_alloc(8*4);cs.*.off=nio_alloc(8*4);cs.*.len=nio_alloc(8*4);
    cs.*.neg=nio_alloc(8*4);cs.*.alive=nio_alloc(8*4);cs.*.comp=nio_alloc(8*4);
    cs.*.qual=nio_alloc(8*4);
    if(cs.*.bo.len!=8*4 || cs.*.qual.len!=8*4){return -1;}
    cs.*.n=0;
    w.*.nb=nio_alloc(24);
    if(w.*.nb.len!=24){return -1;}
    w.*.obn=0;
    n2_stop_init(w);
    return 0;
}

// goal skeleton: strip "Prove that "/"Prove "/"Show that "/"Show ", trim trailing '.'
fn n2_goal_skeleton(buf:[]u8,off:i32,len:i32,ro:*i32,rl:*i32)void {
    let o:i32=off;let l:i32=len;
    let p1:[]u8="Prove that ";
    if(l>=p1.len && n2_eq_ci(buf[o..o+p1.len],p1)==1){o=o+p1.len;l=l-p1.len;}
    let p2:[]u8="Show that ";
    if(l>=p2.len && n2_eq_ci(buf[o..o+p2.len],p2)==1){o=o+p2.len;l=l-p2.len;}
    let p3:[]u8="Prove ";
    if(l>=p3.len && n2_eq_ci(buf[o..o+p3.len],p3)==1){o=o+p3.len;l=l-p3.len;}
    let p4:[]u8="Show ";
    if(l>=p4.len && n2_eq_ci(buf[o..o+p4.len],p4)==1){o=o+p4.len;l=l-p4.len;}
    let to:i32=0;let tl:i32=0;
    n2_trim2(buf,o,l,&to,&tl);
    if(tl>0 && buf[to+tl-1]==46){tl=tl-1;}
    ro.*=to;rl.*=tl;
}

// ---------------- problem premise items: sentence-granular ----------------
// The problem text outside the statement line is split into sentence items
// (split on newlines, then on ". "/"! "/? "). Sentence granularity keeps
// cited premise spans tight: the contradiction scan can see genuine
// inconsistencies between problem sentences, and marker patterns cite the
// exact licensing sentence. The statement line itself is never a premise.
fn n2_add_region_sentences(t:*N2T,it:*N2I,kt:*N2K,w:*N2W,rs:i32,re:i32)i32 {
    let buf:[]u8=t.*.pb;
    let ls:i32=rs;
    while(ls<re){
        let le:i32=ls;
        while(le<re && buf[le]!=10){le=le+1;}
        let ss2:i32=ls;
        let q:i32=ls;
        while(q<le){
            let c:u8=buf[q];
            let isb:i32=0;
            if((c==46||c==33||c==63) && q+1<le && buf[q+1]==32){isb=1;}
            if(isb==1 || q+1==le){
                let ro:i32=0;let rl:i32=0;
                n2_trim2(buf,ss2,q+1-ss2,&ro,&rl);
                if(rl>=2){
                    if(n2_add_item(t,it,kt,w,0,ro,rl,-1,0,0)<0){return -1;}
                }
                ss2=q+1;
                if(isb==1){ss2=q+2;}
                q=ss2;
                continue;
            }
            q=q+1;
        }
        if(ss2<le){
            let ro2:i32=0;let rl2:i32=0;
            n2_trim2(buf,ss2,le-ss2,&ro2,&rl2);
            if(rl2>=2){
                if(n2_add_item(t,it,kt,w,0,ro2,rl2,-1,0,0)<0){return -1;}
            }
        }
        ls=le+1;
    }
    return 0;
}

// prepare: parse problem + store once (deterministic). Sets *goff/*glen/*idl.
fn n2_prepare(t:*N2T,it:*N2I,kt:*N2K,df:*N2D,w:*N2W,
              goff:*i32,glen:*i32,ido:*i32,idl:*i32) i32 {
    let pb:[]u8=t.*.pb;let pl:i32=t.*.pl;
    let so:i32=0;let sl:i32=0;let sline:i32=0;let sllen:i32=0;
    if(n2_field(pb,pl,"STATEMENT: ",&so,&sl)==0){
        if(n2_field(pb,pl,"TARGET: ",&so,&sl)==0){return -4;}
    }
    // line bounds of the statement field (for exclusion from premise spans)
    let ls:i32=so;
    while(ls>0 && pb[ls-1]!=10){ls=ls-1;}
    let le:i32=so+sl;
    while(le<pl && pb[le]!=10){le=le+1;}
    if(le<pl){le=le+1;}
    sline=ls;sllen=le-ls;
    let go:i32=0;let gl2:i32=0;
    n2_goal_skeleton(pb,so,sl,&go,&gl2);
    if(gl2==0){return -4;}
    goff.*=go;glen.*=gl2;
    let io2:i32=0;let il2:i32=0;
    if(n2_field(pb,pl,"ID: ",&io2,&il2)==0){io2=0;il2=0;}
    ido.*=io2;idl.*=il2;
    // problem premise spans: sentences outside the statement line
    if(sline>0){
        if(n2_add_region_sentences(t,it,kt,w,0,sline)!=0){return -1;}
    }
    if(sline+sllen<pl){
        if(n2_add_region_sentences(t,it,kt,w,sline+sllen,pl)!=0){return -1;}
    }
    if(n2_parse_store(t,it,kt,w)!=0){return -1;}
    n2_parse_defs(t,it,df);
    return 0;
}

// solve: propose + support + eliminate + referee + verdict + emit. Deterministic.
fn n2_solve(t:*N2T,it:*N2I,kt:*N2K,df:*N2D,w:*N2W,lk:*N2L,cs:*N2CS,
            goff:i32,glen:i32,ido:i32,idl:i32,store:[]u8) i32 {
    let pb:[]u8=t.*.pb;
    w_raw(w,"ID: ");
    if(idl>0){w_raw(w,pb[ido..ido+idl]);} else {w_raw(w,"UNKNOWN");}
    w_raw(w,"\nENGINE: n2\nSTORE: ");w_raw(w,store);w_raw(w,"\nGOAL: ");
    w_raw(w,pb[goff..goff+glen]);w_raw(w,"\n");
    // ---- PROPOSE ----
    cs.*.n=0;
    au_put32(cs.*.bo,0,0);au_put32(cs.*.off,0,goff);au_put32(cs.*.len,0,glen);
    au_put32(cs.*.neg,0,0);cs.*.n=1;
    let ck:[]u8=nio_alloc(8*4); // def item idx per candidate (-1 default)
    if(ck.len!=8*4){return -1;}
    au_put32(ck,0,-1);
    let di:i32=0;
    while(di<df.*.n && cs.*.n<7){
        let rl:i32=0;
        let eo:i32=n2_expand(t,w,df,di,0,goff,glen,&rl);
        if(eo>=0){
            let ci2:i32=cs.*.n;
            au_put32(cs.*.bo,ci2,2);au_put32(cs.*.off,ci2,eo);au_put32(cs.*.len,ci2,rl);
            au_put32(cs.*.neg,ci2,0);au_put32(ck,ci2,au_get32(df.*.it,di));
            cs.*.n=ci2+1;
        }
        di=di+1;
    }
    let cn:i32=cs.*.n;
    au_put32(cs.*.bo,cn,0);au_put32(cs.*.off,cn,goff);au_put32(cs.*.len,cn,glen);
    au_put32(cs.*.neg,cn,1);au_put32(ck,cn,-1);
    cs.*.n=cn+1;
    // ---- SUPPORT ----
    let rsn:[]u8=nio_alloc(8*4);
    if(rsn.len!=8*4){nio_free(ck);return -1;}
    let ci:i32=0;
    while(ci<cs.*.n){
        let cbo:i32=au_get32(cs.*.bo,ci);
        let coff:i32=au_get32(cs.*.off,ci);
        let clen:i32=au_get32(cs.*.len,ci);
        let neg:i32=au_get32(cs.*.neg,ci);
        let vis:[]u8=nio_alloc(16*3*4);
        let vn:i32=0;
        let wk:i32=0;
        lk.*.n=0;
        let os0:N2Sp=N2Sp{.bo=-1,.off=0,.len=0};
        let p_os:*N2Sp=&os0;
        au_put32(vis,0,cbo);au_put32(vis,1,coff);au_put32(vis,2,clen);
        vn=1;
        let st:i32=n2_support(t,it,kt,w,lk,cbo,coff,clen,neg,vis,&vn,p_os,0,&wk);
        nio_free(vis);
        au_put32(rsn,ci,st);
        if(st==0){
            au_put32(cs.*.alive,ci,1);
            au_put32(cs.*.comp,ci,1000);
            let nb2:i32=0;let q2:i32=0;
            while(q2<lk.*.n){
                let pd:i32=au_get32(lk.*.pid,q2);
                if(pd==0 || pd==4){nb2=nb2+1;}
                q2=q2+1;
            }
            let qq:i32=0;
            if(lk.*.n>0){qq=1000*nb2/lk.*.n;}
            au_put32(cs.*.qual,ci,qq);
        } else {
            au_put32(cs.*.alive,ci,0);
            au_put32(cs.*.comp,ci,0);
            au_put32(cs.*.qual,ci,0);
        }
        ci=ci+1;
    }
    // ---- emit CANDIDATES ----
    w_raw(w,"CANDIDATES:\n");
    ci=0;
    while(ci<cs.*.n){
        w_ch(w,67);w_i64(w,ci as i64);
        let ng:i32=au_get32(cs.*.neg,ci);
        if(ci==0){w_raw(w," kind=goal");}
        if(ci>0 && ng==0){
            w_raw(w," kind=expand-");
            let dii:i32=au_get32(ck,ci);
            let ko2:i32=au_get32(it.*.kid,dii);let kl2:i32=au_get32(it.*.kidl,dii);
            let kb2:[]u8=t.*.kb;
            w_raw(w,kb2[ko2..ko2+kl2]);
        }
        if(ng==1){w_raw(w," kind=negated");}
        w_raw(w," span=");w_span(w,t,au_get32(cs.*.bo,ci),au_get32(cs.*.off,ci),au_get32(cs.*.len,ci));
        w_raw(w," status=");w_raw(w,n2_status_name(au_get32(rsn,ci)));
        w_raw(w," comp=");w_i64(w,au_get32(cs.*.comp,ci) as i64);
        w_raw(w," qual=");w_i64(w,au_get32(cs.*.qual,ci) as i64);
        w_raw(w,"\n");
        ci=ci+1;
    }
    nio_free(ck);
    // ---- ELIMINATE (deliberative rounds) ----
    w_raw(w,"ELIMINATION:\n");
    let round:i32=1;
    while(round<=8){
        let nalive:i32=0;let k2:i32=0;
        while(k2<cs.*.n){
            if(au_get32(cs.*.alive,k2)==1){nalive=nalive+1;}
            k2=k2+1;
        }
        if(nalive<=1){break;}
        // find weakest by (comp, qual); tie -> highest index
        let wk2:i32=-1;let bc:i32=1000000;let bq:i32=1000000;
        k2=0;
        while(k2<cs.*.n){
            if(au_get32(cs.*.alive,k2)==1){
                let c2:i32=au_get32(cs.*.comp,k2);let q3:i32=au_get32(cs.*.qual,k2);
                if(c2<bc || (c2==bc && q3<bq) || (c2==bc && q3==bq)){
                    bc=c2;bq=q3;wk2=k2;
                }
            }
            k2=k2+1;
        }
        // check all equal -> stable
        let alleq:i32=1;
        k2=0;
        while(k2<cs.*.n){
            if(au_get32(cs.*.alive,k2)==1){
                if(au_get32(cs.*.comp,k2)!=bc || au_get32(cs.*.qual,k2)!=bq){alleq=0;}
            }
            k2=k2+1;
        }
        if(alleq==1){
            w_raw(w,"round ");w_i64(w,round as i64);w_raw(w,": stable, no elimination\n");
            break;
        }
        au_put32(cs.*.alive,wk2,0);
        w_raw(w,"round ");w_i64(w,round as i64);
        w_raw(w,": eliminate C");w_i64(w,wk2 as i64);
        w_raw(w," (comp=");w_i64(w,bc as i64);w_raw(w," qual=");w_i64(w,bq as i64);w_raw(w,")\n");
        round=round+1;
    }
    // ---- REFEREE ----
    let surv:[]u8=nio_alloc(8*4);
    if(surv.len!=8*4){nio_free(rsn);return -1;}
    let ns2:i32=0;let k3:i32=0;
    while(k3<cs.*.n){
        if(au_get32(cs.*.alive,k3)==1){au_put32(surv,ns2,k3);ns2=ns2+1;}
        k3=k3+1;
    }
    let winner:i32=-1;
    w_raw(w,"REFEREE:\n");
    if(ns2==1){
        winner=au_get32(surv,0);
        w_raw(w,"single survivor C");w_i64(w,winner as i64);w_raw(w,"\n");
    }
    if(ns2>1){
        // contradicting pair? weigh by (comp, qual); cited conclusion beats spliced.
        let cp:i32=0;let hasc:i32=0;
        while(cp<ns2){
            let cq:i32=cp+1;
            while(cq<ns2){
                let a3:i32=au_get32(surv,cp);let b3:i32=au_get32(surv,cq);
                if(n2_spans_contradict(t,w,au_get32(cs.*.bo,a3),au_get32(cs.*.off,a3),au_get32(cs.*.len,a3),
                                       au_get32(cs.*.bo,b3),au_get32(cs.*.off,b3),au_get32(cs.*.len,b3))==1){
                    hasc=1;
                }
                cq=cq+1;
            }
            cp=cp+1;
        }
        if(hasc==1){
            let bk:i32=-1;let bcmp:i32=-1;let bqu:i32=-1;let bcit:i32=-1;
            cp=0;
            while(cp<ns2){
                let a4:i32=au_get32(surv,cp);
                let cc2:i32=au_get32(cs.*.comp,a4);let qq2:i32=au_get32(cs.*.qual,a4);
                let cit:i32=0;
                if(au_get32(cs.*.bo,a4)!=2){cit=1;}
                if(cc2>bcmp || (cc2==bcmp && qq2>bqu) || (cc2==bcmp && qq2==bqu && cit>bcit) ||
                   (cc2==bcmp && qq2==bqu && cit==bcit && (bk<0 || a4<bk))){
                    bk=a4;bcmp=cc2;bqu=qq2;bcit=cit;
                }
                cp=cp+1;
            }
            winner=bk;
            w_raw(w,"contradicting survivors; weigh by (comp,qual,cited); keep C");
            w_i64(w,winner as i64);w_raw(w,"\n");
        } else {
            w_raw(w,"multiple survivors, no contradiction; WITHHOLD\n");
        }
    }
    if(ns2==0){
        w_raw(w,"no survivors\n");
    }
    nio_free(surv);
    // ---- VERDICT ----
    let verdict:[]u8="WITHHELD";
    let claim_bo:i32=0;let claim_off:i32=0;let claim_len:i32=0;
    let conf:i32=0;let nder:i32=0;
    if(winner>=0){
        nder=0;
        // rebuild winner chain for the trace (deterministic)
        let vis2:[]u8=nio_alloc(16*3*4);
        let vn2:i32=0;let wk2b:i32=0;
        lk.*.n=0;
        let osb:N2Sp=N2Sp{.bo=-1,.off=0,.len=0};
        let p_osb:*N2Sp=&osb;
        let wbo:i32=au_get32(cs.*.bo,winner);
        let woff:i32=au_get32(cs.*.off,winner);
        let wlen:i32=au_get32(cs.*.len,winner);
        let wneg:i32=au_get32(cs.*.neg,winner);
        au_put32(vis2,0,wbo);au_put32(vis2,1,woff);au_put32(vis2,2,wlen);
        vn2=1;
        let wst:i32=n2_support(t,it,kt,w,lk,wbo,woff,wlen,wneg,vis2,&vn2,p_osb,0,&wk2b);
        nio_free(vis2);
        if(wst==0){
            nder=lk.*.n;
            claim_bo=wbo;claim_off=woff;claim_len=wlen;
            conf=1000;
            if(wneg==1){verdict="REFUTED";} else {verdict="DERIVED";}
        }
    }
    w_raw(w,"VERDICT: ");w_raw(w,verdict);w_raw(w,"\nCLAIM: ");
    if(conf==1000){w_span(w,t,claim_bo,claim_off,claim_len);} else {w_raw(w,"-");}
    w_raw(w,"\nCONFIDENCE: ");w_i64(w,conf as i64);
    w_raw(w,"\nDERIVATIONS: ");w_i64(w,nder as i64);
    w_raw(w,"\nFLAGS: ");
    let cf:i32=0;let kr:i32=0;
    while(kr<cs.*.n){
        if(au_get32(rsn,kr)==2){cf=1;}
        kr=kr+1;
    }
    if(cf==1){w_raw(w,"CONTRADICTION_FOUND");} else {w_raw(w,"NONE");}
    w_raw(w,"\n");
    // ---- TRACE (chain reversed into forward order) ----
    w_raw(w,"TRACE:\n");
    if(conf==1000){
        let ti:i32=lk.*.n-1;let tn:i32=0;
        while(ti>=0){
            w_ch(w,84);w_i64(w,tn as i64);
            w_raw(w," pid=");w_raw(w,n2_pid_name(au_get32(lk.*.pid,ti)));
            w_raw(w," conc=");w_span(w,t,au_get32(lk.*.cb,ti),au_get32(lk.*.co,ti),au_get32(lk.*.cl,ti));
            let pii:i32=au_get32(lk.*.io,ti);
            w_raw(w," prem=");
            if(n2_item_bo(it,pii)==1){
                let kido:i32=au_get32(it.*.kid,pii);let kidl2:i32=au_get32(it.*.kidl,pii);
                w_raw(w,t.*.kb[kido..kido+kidl2]);
            } else {
                w_raw(w,"PROBLEM");
            }
            w_ch(w,32);
            w_span(w,t,n2_item_bo(it,pii),au_get32(lk.*.po,ti),au_get32(lk.*.pl,ti));
            w_raw(w,"\n");
            ti=ti-1;tn=tn+1;
        }
    } else {
        w_raw(w,"(none)\n");
    }
    w_raw(w,"AUDIT:\n");
    w_raw(w,"cited_items=");w_i64(w,it.*.n as i64);
    w_raw(w," definitions=");w_i64(w,df.*.n as i64);
    w_raw(w," candidates=");w_i64(w,cs.*.n as i64);
    w_raw(w,"\n");
    let ddi:i32=0;
    while(ddi<df.*.n){
        let dho:i32=au_get32(df.*.ho,ddi);let dhl:i32=au_get32(df.*.hl,ddi);
        let dit2:i32=au_get32(df.*.it,ddi);
        let dko:i32=au_get32(it.*.kid,dit2);let dkl:i32=au_get32(it.*.kidl,dit2);
        let dkb:[]u8=t.*.kb;
        w_raw(w,"DEF ");w_raw(w,dkb[dko..dko+dkl]);w_raw(w," head=\"");
        w_raw(w,dkb[dho..dho+dhl]);w_raw(w,"\"\n");
        ddi=ddi+1;
    }
    nio_free(rsn);
    return 0;
}

fn main()i32 {
    let fp:[]u8=_zag_arg(1);
    let op:[]u8=_zag_arg(2);
    let sp:[]u8=_zag_arg(3);
    if(fp.len==0 || op.len==0){
        _zag_println("usage: n2_bin <problem.txt> <out_path> [knowledge_store]");
        return 4;
    }
    if(n2_has_sealed(fp)==1 || n2_has_sealed(op)==1){
        _zag_println("n2: sealed guard tripped on path");
        return 3;
    }
    let store:[]u8="../../batteries/knowledge/KNOWLEDGE_STORE_NL.md";
    if(sp.len>0){store=sp;}
    if(n2_has_sealed(store)==1){
        _zag_println("n2: sealed guard tripped on store path");
        return 3;
    }
    let pbuf:[]u8=nio_alloc(1048576);
    let kbuf:[]u8=nio_alloc(1048576);
    if(pbuf.len==0 || kbuf.len==0){return 4;}
    let plen:i64=n2_guarded_read(fp,pbuf);
    if(plen==-99){_zag_println("n2: sealed guard tripped on problem file");return 3;}
    if(plen<=0){_zag_println("n2: cannot read problem file");return 4;}
    let klen:i64=n2_guarded_read(store,kbuf);
    if(klen==-99){_zag_println("n2: sealed guard tripped on store file");return 3;}
    if(klen<=0){_zag_println("n2: cannot read store file");return 4;}
    let t:N2T=N2T{.pb:"",.pl:0,.kb:"",.kl:0,.ar:"",.an:0};
    let it:N2I=N2I{.bo:"",.off:"",.len:"",.kid:"",.kidl:"",.def:"",.n:0};
    let kt:N2K=N2K{.koff:"",.kn:"",.kpol:"",.ka:"",.kcur:0,.n:0};
    let df:N2D=N2D{.ho:"",.hl:"",.dfo:"",.dfl:"",.it:"",.n:0};
    let w:N2W=N2W{.st:"",.ns:0,.ob:"",.obn:0,.nb:""};
    let lk:N2L=N2L{.cb:"",.co:"",.cl:"",.io:"",.po:"",.pl:"",.pid:"",.n:0};
    let cs:N2CS=N2CS{.bo:"",.off:"",.len:"",.neg:"",.alive:"",.comp:"",.qual:"",.n:0};
    let p_t:*N2T=&t;let p_it:*N2I=&it;let p_kt:*N2K=&kt;let p_df:*N2D=&df;
    let p_w:*N2W=&w;let p_lk:*N2L=&lk;let p_cs:*N2CS=&cs;
    p_t.*.pb=pbuf;p_t.*.pl=plen as i32;p_t.*.kb=kbuf;p_t.*.kl=klen as i32;
    if(n2_init(p_t,p_it,p_kt,p_df,p_w,p_lk,p_cs)!=0){return 4;}
    let goff:i32=0;let glen:i32=0;let ido:i32=0;let idl:i32=0;
    let prc:i32=n2_prepare(p_t,p_it,p_kt,p_df,p_w,&goff,&glen,&ido,&idl);
    if(prc!=0){return 4;}
    let an0:i32=p_t.*.an;
    // 3x in-process reruns, byte-identical asserted
    let b1:[]u8=nio_alloc(2097152);
    let b2:[]u8=nio_alloc(2097152);
    let b3:[]u8=nio_alloc(2097152);
    if(b1.len==0 || b2.len==0 || b3.len==0){return 4;}
    p_w.*.ob=b1;p_w.*.obn=0;p_t.*.an=an0;
    if(n2_solve(p_t,p_it,p_kt,p_df,p_w,p_lk,p_cs,goff,glen,ido,idl,store)!=0){return 4;}
    let n1:i32=p_w.*.obn;
    p_w.*.ob=b2;p_w.*.obn=0;p_t.*.an=an0;
    if(n2_solve(p_t,p_it,p_kt,p_df,p_w,p_lk,p_cs,goff,glen,ido,idl,store)!=0){return 4;}
    let n2:i32=p_w.*.obn;
    p_w.*.ob=b3;p_w.*.obn=0;p_t.*.an=an0;
    if(n2_solve(p_t,p_it,p_kt,p_df,p_w,p_lk,p_cs,goff,glen,ido,idl,store)!=0){return 4;}
    let n3:i32=p_w.*.obn;
    if(n1!=n2 || n2!=n3){_zag_println("n2: DIVERGENCE across 3x reruns");return 5;}
    if(nio_equal(b1[0..n1],b2[0..n2])==0 || nio_equal(b2[0..n2],b3[0..n3])==0){
        _zag_println("n2: DIVERGENCE across 3x reruns");
        return 5;
    }
    let wrc:i64=dlb_write_file(op,b1[0..n1],n1);
    if(wrc<0){return 4;}
    return 0;
}

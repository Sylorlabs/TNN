// n3.zag — N3 ONEBRAIN-NATIVE: shared-ledger parallel deliberation over raw text.
//
// Frozen spec (IDEAS_ADDENDUM_R3.md, via BRIEF_N3.md): one shared append-only
// LEDGER of text states (id, bytes, source, depth, status live/defeated) plus
// four STRATEGY THREADS with fixed strategy programs:
//   T-CONTRA   (0): assume the negated goal skeleton; derive consequences of
//                   the assumption seeking a contradiction (proof by
//                   contradiction).
//   T-CONSTRUCT(1): forward-build from cited definitions (expand defined
//                   terms, apply definitional consequences).
//   T-LEMMA    (2): apply conditional-shaped knowledge ("if [C], then [Q]")
//                   by byte-matching antecedents against the ledger.
//   T-GOAL     (3): work backward from the goal skeleton (definition splice,
//                   subgoal planting, subgoal closing).
// STEP: deterministic round-robin; each live thread proposes at most one step
// per round, in thread order 0..3. A proposal = (license id, premise state
// ids, output bytes). EVERY proposal is contradiction-checked against the
// whole ledger (byte-overlap + polarity, see n3_contra_state) BEFORE appending.
//   - no contradiction            -> append as live; thread strikes reset.
//   - contradicts only ASSUMPTIONs -> discharge: assumptions defeated (and all
//                   assumption-tainted states with them), proposal appended.
//   - contradicts a live non-assumption state -> REFUSED, thread strike++.
//                   (T-CONTRA + tainted chain => PBC fires: assumption
//                   defeated, goal skeleton appended, DERIVE.)
// SHARED VISIBILITY: defeats/discharge/PBC conclusions enter the ledger and
// are read by all threads next round. Defeated states are never cited as
// premises; appended-or-refused (license,premise) pairs are never re-proposed.
// STRATEGY ELIMINATION: 3 consecutive refused proposals -> thread KILLED.
// VERDICT: a thread appends a state byte-equal to the goal skeleton
// (T-CONTRA via PBC discharge) -> DERIVE with that thread's chain. All
// threads killed, or 25 rounds (100 thread-steps), or a proposal-free round
// -> WITHHOLD.
// HONESTY: licensed steps only; every output byte comes from a cited span
// (premise bytes, definition body, conditional consequent, or goal splice);
// fixed literal segments appear only in the two license templates that need
// them ("It is not the case that " for the negation assumption). No invented
// content words.
//
// ANTI-BRIDGE posture: no typed variables, no scope, no formula/term grammar,
// no unification, no NL->schema mapping. Matching is case-insensitive byte
// equality of word spans and substrings. Fixed vocabularies: (a) a stop-word
// list of closed-class function words (required by "overlap+polarity"), (b) a
// negation-marker list for polarity scope. Definition heads/conditionals are
// found by raw byte shapes (":" split, "if "/" then " split). Every step cites
// byte-spans of input/store text or prior steps.
//
// Knowledge store (pinned): round3/batteries/knowledge/KNOWLEDGE_STORE_NL.md
// (frozen raw-NL rendering; see BUILD_N3.md for pin).
//
// Usage: n3_bin <problem.txt> <out_path> [knowledge_store]
//   CWD must be math_logic/round3/engines/n3 (imports resolve relative to CWD;
//   default knowledge path is relative to CWD).
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")

// ---------------- byte helpers ----------------
fn n3_tolower(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn n3_is_wc(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==39){return 1;}
    return 0;
}
fn n3_is_ws(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}
// next word (alnum/quote run) in b[off..off+len] at *cur. Sets *wo,*wl (absolute).
fn n3_next_word(b:[]u8,off:i32,len:i32,cur:*i32,wo:*i32,wl:*i32)i32 {
    let p:i32=off+cur.*;
    let end:i32=off+len;
    while(p<end && n3_is_wc(b[p])==0){p=p+1;}
    if(p>=end){cur.*=p-off;return 0;}
    let s:i32=p;
    while(p<end && n3_is_wc(b[p])==1){p=p+1;}
    wo.*=s;wl.*=p-s;cur.*=p-off;
    return 1;
}
// trim [off,off+len) of ws; results absolute via out params.
fn n3_trim(b:[]u8,off:i32,len:i32,ro:*i32,rl:*i32)void {
    let a:i32=off;let e:i32=off+len;
    while(a<e && n3_is_ws(b[a])==1){a=a+1;}
    while(e>a && n3_is_ws(b[e-1])==1){e=e-1;}
    ro.*=a;rl.*=e-a;
}
// case-insensitive byte equality of two spans.
fn n3_eq_ci(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){
        if(n3_tolower(a[ao+i])!=n3_tolower(b[bo+i])){return 0;}
        i=i+1;
    }
    return 1;
}
// first case-insensitive occurrence of needle n in b[off..off+len); absolute pos or -1.
fn n3_find_ci(b:[]u8,off:i32,len:i32,n:[]u8) i32 {
    if(n.len==0 || n.len>len){return -1;}
    let i:i32=off;
    let end:i32=off+len-n.len;
    while(i<=end){
        if(n3_eq_ci(b,i,n.len,n,0,n.len)==1){return i;}
        i=i+1;
    }
    return -1;
}
// whole-word (boundary = non-word-char or edge) case-insensitive occurrence; pos or -1.
fn n3_find_word_ci(b:[]u8,off:i32,len:i32,w:[]u8) i32 {
    if(w.len==0 || w.len>len){return -1;}
    let i:i32=off;
    let end:i32=off+len-w.len;
    while(i<=end){
        if(n3_eq_ci(b,i,w.len,w,0,w.len)==1){
            let lb:i32=1;let rb:i32=1;
            if(i>off && n3_is_wc(b[i-1])==1){lb=0;}
            if(i+w.len<off+len && n3_is_wc(b[i+w.len])==1){rb=0;}
            if(lb==1 && rb==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
// FNV-1a over lowercased bytes of span.
fn n3_fnv(b:[]u8,off:i32,len:i32)i64 {
    let h:i64=-3750763034362895579;
    let i:i32=0;
    while(i<len){
        h=h ^ (n3_tolower(b[off+i]) as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// word in skip span [so,so+sl)? 1=yes. sl<=0 -> 0.
fn n3_in_span(wo:i32,wl:i32,so:i32,sl:i32)i32 {
    if(sl<=0){return 0;}
    if(wo<so+sl && wo+wl>so){return 1;}
    return 0;
}
// sealed-path guard: substring "sealed".
fn n3_has_sealed(p:[]u8)i32 {
    let i:i32=0;
    while(i+6<=p.len){
        if(p[i]==115 && p[i+1]==101 && p[i+2]==97 && p[i+3]==108 && p[i+4]==101 && p[i+5]==100){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- word tables (closed-class stop words; negation markers) ----------------
struct N3W { st:[]u8, ns:i32, ng:[]u8, nn:i32 }
fn n3_winit(w:*N3W)void {
    let lit:[]u8="the a an is are was were be been being of to in on for with by and or as at from that this these those it its if then than so but such every each all any some there here which who what when where how why can could should would may might must shall will do does did has have had having into onto out up down over under between through during before after above below more most other same only very just also too one two we you your his her their our my i me he she they them";
    let negl:[]u8="not no never cannot can't doesn't don't isn't aren't wasn't weren't haven't hasn't hadn't won't wouldn't couldn't shouldn't neither nor nothing none without impossible false";
    let tbl:[]u8=nio_alloc(128*8);
    w.*.st=tbl;w.*.ns=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(lit,0,lit.len,&cur,&wo,&wl)==1){
        if(w.*.ns>=128){break;}
        au_put64(tbl,w.*.ns,n3_fnv(lit,wo,wl));
        w.*.ns=w.*.ns+1;
    }
    let gtb:[]u8=nio_alloc(64*8);
    w.*.ng=gtb;w.*.nn=0;
    cur=0;wo=0;wl=0;
    while(n3_next_word(negl,0,negl.len,&cur,&wo,&wl)==1){
        if(w.*.nn>=64){break;}
        au_put64(gtb,w.*.nn,n3_fnv(negl,wo,wl));
        w.*.nn=w.*.nn+1;
    }
}
fn n3_is_stop(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.ns){
        if(au_get64(w.*.st,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_is_negw(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.nn){
        if(au_get64(w.*.ng,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- engine state (flat small structs, touched via *T params) ----------------
// Ledger state fields (20 x i32 in []u8 arena, LE):
//  0 off, 1 len (bytes in ar), 2 src, 3 kid, 4 lic, 5 p1, 6 p2, 7 p3,
//  8 depth, 9 status, 10 thread, 11 round, 12 taint,
//  13..19 spare.
// src: 0=INPUT 1=CITE 2=ASSUME 3=PROP 4=SUBGOAL 5=PBC. status: 0=live 1=defeated.
struct N3S { ar:[]u8, acap:i32, an:i32, st:[]u8, nst:i32, stcap:i32, wtmp:[]u8, ev:[]u8 }
struct N3X { goff:i32, glen:i32, goal:[]u8, gollen:i32, pid:[]u8, pidlen:i32, assum:i32, derived_by:i32, store:[]u8, storelen:i32 }
struct N3T { strs:[]u8, kill:[]u8, props:[]u8, used:[]u8, nused:[]u8, wa:[]u8, wb:[]u8, na:[]u8, nb:[]u8 }
struct N3C { s:*N3S, x:*N3X, t:*N3T, w:*N3W, au:*DOut }
struct N3P { lic:i32, p1:i32, p2:i32, p3:i32, src:i32, kid:i32, olen:i32 }

fn n3_sf(s:*N3S,id:i32,f:i32)i32 { return au_get32(s.*.st,id*20+f); }
fn n3_setf(s:*N3S,id:i32,f:i32,v:i32)void { au_put32(s.*.st,id*20+f,v); }
fn n3_sbytes(s:*N3S,id:i32,bo:*i32,bl:*i32)void {
    bo.*=n3_sf(s,id,0);bl.*=n3_sf(s,id,1);
}
fn n3_in_arr(a:[]u8,n:i32,h:i64)i32 {
    let j:i32=0;
    while(j<n){
        if(au_get64(a,j)==h){return 1;}
        j=j+1;
    }
    return 0;
}

// collect distinct non-stop word hashes of b[off..off+len), skipping spans
// [s1o,s1o+s1l), [s2o,s2o+s2l), [s3o,s3o+s3l). Words shorter than 3 bytes are
// not content vocabulary (numbers, variables like "x"/"m") and are ignored.
// Returns count (cap-limited).
fn n3_collect(c:*N3C,b:[]u8,off:i32,len:i32,s1o:i32,s1l:i32,s2o:i32,s2l:i32,s3o:i32,s3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(wl<3){continue;}
        if(n3_in_span(wo,wl,s1o,s1l)==1){continue;}
        if(n3_in_span(wo,wl,s2o,s2l)==1){continue;}
        if(n3_in_span(wo,wl,s3o,s3l)==1){continue;}
        if(n3_is_stop(w,b,wo,wl)==1){continue;}
        // Negation markers are operators, not content: they set polarity
        // (via the neg-scope sets) but must not count as shared vocabulary.
        // Otherwise e.g. "not" alone plus one stray shared word ("2")
        // fabricates contradictions.
        if(n3_is_negw(w,b,wo,wl)==1){continue;}
        let h:i64=n3_fnv(b,wo,wl);
        if(n3_in_arr(arr,n,h)==0){
            if(n<cap){au_put64(arr,n,h);n=n+1;}
        }
    }
    return n;
}
// collect distinct word hashes that fall inside a negation-marker's scope:
// after a neg-marker word until a clause-end char (.,!?;,\n). Same skips.
fn n3_collect_neg(c:*N3C,b:[]u8,off:i32,len:i32,s1o:i32,s1l:i32,s2o:i32,s2l:i32,s3o:i32,s3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let neg:i32=0;let prev_end:i32=off;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        let g:i32=prev_end;
        while(g<wo){
            let ch:u8=b[g];
            if(ch==46 || ch==33 || ch==63 || ch==59 || ch==44 || ch==10){neg=0;}
            g=g+1;
        }
        if(n3_is_negw(w,b,wo,wl)==1){
            neg=1;
        } else {
            if(neg==1 && wl>=3 && n3_in_span(wo,wl,s1o,s1l)==0 && n3_in_span(wo,wl,s2o,s2l)==0 && n3_in_span(wo,wl,s3o,s3l)==0 && n3_is_stop(w,b,wo,wl)==0){
                let h:i64=n3_fnv(b,wo,wl);
                if(n3_in_arr(arr,n,h)==0){
                    if(n<cap){au_put64(arr,n,h);n=n+1;}
                }
            }
        }
        prev_end=wo+wl;
    }
    return n;
}

// Contradiction: proposal bytes ob[0..olen) vs ledger state b.
// 1 iff >=2 shared distinct content words (len>=3, non-stop, non-marker)
// AND some shared word has flipped negation-scope status. Skip spans: for
// the INPUT state (id 0) skip the goal span (the question is not a claim);
// for DEFINITION cites skip the definiendum head span (a label, not a
// claim); for CONDITIONAL cites skip the head, antecedent and consequent
// spans (a conditional asserts none of them).
fn n3_contra_state(c:*N3C,ob:[]u8,olen:i32,b:i32)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let bo:i32=0;let bl:i32=0;
    n3_sbytes(s,b,&bo,&bl);
    let ab:[]u8=s.*.ar;
    let k1o:i32=-1;let k1l:i32=0;let k2o:i32=-1;let k2l:i32=0;let k3o:i32=-1;let k3l:i32=0;
    if(b==0){
        k1o=x.*.goff;k1l=x.*.glen;
    } else {
        if(n3_sf(s,b,2)==1){
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                k3o=ho;k3l=hl;
            }
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                k1o=co;k1l=cl;k2o=qo;k2l=ql;
            }
        }
    }
    let wa:[]u8=t.*.wa;let wb:[]u8=t.*.wb;let na:[]u8=t.*.na;let nb:[]u8=t.*.nb;
    let n1:i32=n3_collect(c,ob,0,olen,-1,0,-1,0,-1,0,wa,192);
    let n2:i32=n3_collect(c,ab,bo,bl,k1o,k1l,k2o,k2l,k3o,k3l,wb,192);
    let sh:i32=0;let i:i32=0;
    while(i<n1){
        let h:i64=au_get64(wa,i);
        if(n3_in_arr(wb,n2,h)==1){sh=sh+1;}
        i=i+1;
    }
    if(sh<2){return 0;}
    let m1:i32=n3_collect_neg(c,ob,0,olen,-1,0,-1,0,-1,0,na,192);
    let m2:i32=n3_collect_neg(c,ab,bo,bl,k1o,k1l,k2o,k2l,k3o,k3l,nb,192);
    i=0;
    while(i<n1){
        let h:i64=au_get64(wa,i);
        if(n3_in_arr(wb,n2,h)==1){
            let a1:i32=n3_in_arr(na,m1,h);
            let a2:i32=n3_in_arr(nb,m2,h);
            if(a1!=a2){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// ---------------- used (license,premise) pairs per thread ----------------
fn n3_used(t:*N3T,th:i32,lic:i32,p1:i32,p2:i32,p3:i32)i32 {
    let n:i32=au_get32(t.*.nused,th);
    let base:i32=th*160*4;
    let i:i32=0;
    while(i<n){
        if(au_get32(t.*.used,base+i*4)==lic && au_get32(t.*.used,base+i*4+1)==p1 && au_get32(t.*.used,base+i*4+2)==p2 && au_get32(t.*.used,base+i*4+3)==p3){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_mark_used(t:*N3T,th:i32,lic:i32,p1:i32,p2:i32,p3:i32)void {
    let n:i32=au_get32(t.*.nused,th);
    if(n>=160){return;}
    let base:i32=th*160*4;
    au_put32(t.*.used,base+n*4,lic);
    au_put32(t.*.used,base+n*4+1,p1);
    au_put32(t.*.used,base+n*4+2,p2);
    au_put32(t.*.used,base+n*4+3,p3);
    au_put32(t.*.nused,th,n+1);
}

// ---------------- definition / conditional shape parsing (byte-level) ----------------
// Definition shape: "HEAD: body" (first colon). Returns head/body spans (trimmed).
fn n3_def_parse(b:[]u8,off:i32,len:i32,ho:*i32,hl:*i32,bo:*i32,bl:*i32)i32 {
    let i:i32=off;
    let end:i32=off+len;
    while(i<end && b[i]!=58){i=i+1;}
    if(i>=end){return 0;}
    let h0:i32=0;let h1:i32=0;let b0:i32=0;let b1:i32=0;
    n3_trim(b,off,i-off,&h0,&h1);
    n3_trim(b,i+1,end-(i+1),&b0,&b1);
    if(h1<1 || h1>40 || b1<1){return 0;}
    ho.*=h0;hl.*=h1;bo.*=b0;bl.*=b1;
    return 1;
}
// Head key: first non-stop word of head with len>=3. Returns span or 0.
fn n3_def_key(c:*N3C,b:[]u8,ho:i32,hl:i32,ko:*i32,kl:*i32)i32 {
    let w:*N3W=c.*.w;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,ho,hl,&cur,&wo,&wl)==1){
        if(wl>=3 && n3_is_stop(w,b,wo,wl)==0 && n3_is_negw(w,b,wo,wl)==0){
            ko.*=wo;kl.*=wl;return 1;
        }
    }
    return 0;
}
// Conditional shape: "if <C>, then <Q>" | "if <C> then <Q>" | "if <C>, <Q>".
// Returns C/Q spans (trimmed, arena-absolute). Rejects nested "if " in Q,
// empty parts, over-long parts.
fn n3_cond_parse(b:[]u8,off:i32,len:i32,co:*i32,cl:*i32,qo:*i32,ql:*i32)i32 {
    let ifpos:i32=n3_find_ci(b,off,len,"if ");
    if(ifpos<0){return 0;}
    let cs:i32=ifpos+3;
    let ce:i32=off+len;
    let q0:i32=-1;
    let p1:i32=n3_find_ci(b,cs,ce-cs,", then ");
    if(p1>=0){q0=p1+7;}
    if(q0<0){
        let p2:i32=n3_find_word_ci(b,cs,ce-cs,"then");
        if(p2>=0){q0=p2+4;}
    }
    let cend:i32=ce;
    if(q0<0){
        // fallback: "if <C>, <Q>" — split on first ", " after "if "
        let p3:i32=n3_find_ci(b,cs,ce-cs,", ");
        if(p3<0){return 0;}
        cend=p3;q0=p3+2;
    } else {
        if(p1>=0){cend=p1;} else {cend=q0-4;}
    }
    let c0:i32=0;let c1:i32=0;let r0:i32=0;let r1:i32=0;
    n3_trim(b,cs,cend-cs,&c0,&c1);
    n3_trim(b,q0,ce-q0,&r0,&r1);
    if(c1<1 || r1<1 || c1>400 || r1>400){return 0;}
    if(n3_find_ci(b,c0,c1,"if ")>=0){return 0;}
    if(n3_find_ci(b,r0,r1,"if ")>=0){return 0;}
    co.*=c0;cl.*=c1;qo.*=r0;ql.*=r1;
    return 1;
}

// ---------------- ledger append ----------------
fn n3_append(c:*N3C,src:i32,kid:i32,lic:i32,p1:i32,p2:i32,p3:i32,depth:i32,thread:i32,round:i32,ob:[]u8,olen:i32)i32 {
    let s:*N3S=c.*.s;
    if(s.*.nst>=s.*.stcap){return -1;}
    if(olen<1 || s.*.an+olen>s.*.acap){return -1;}
    let id:i32=s.*.nst;
    let at:i32=s.*.an;
    let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<olen){ab[at+i]=ob[i];i=i+1;}
    n3_setf(s,id,0,at);
    n3_setf(s,id,1,olen);
    n3_setf(s,id,2,src);
    n3_setf(s,id,3,kid);
    n3_setf(s,id,4,lic);
    n3_setf(s,id,5,p1);
    n3_setf(s,id,6,p2);
    n3_setf(s,id,7,p3);
    n3_setf(s,id,8,depth);
    n3_setf(s,id,9,0);
    n3_setf(s,id,10,thread);
    n3_setf(s,id,11,round);
    let tn:i32=0;
    if(src==2){tn=1;}
    if(p1>=0 && n3_sf(s,p1,12)==1){tn=1;}
    if(p2>=0 && n3_sf(s,p2,12)==1){tn=1;}
    if(p3>=0 && n3_sf(s,p3,12)==1){tn=1;}
    n3_setf(s,id,12,tn);
    n3_setf(s,id,13,0);n3_setf(s,id,14,0);n3_setf(s,id,15,0);
    n3_setf(s,id,16,0);n3_setf(s,id,17,0);n3_setf(s,id,18,0);n3_setf(s,id,19,0);
    s.*.an=at+olen;
    s.*.nst=id+1;
    return id;
}

// ---------------- problem parsing ----------------
// Problem file: ID: / DOMAIN: / TYPE: lines, then STATEMENT: to EOF.
// S0 = whole file bytes. Goal = after "prove that "/"show that " (ci), else
// whole statement, trimmed. goff/glen = goal span inside S0 (arena coords).
fn n3_parse_prob(c:*N3C,pb:[]u8,pl:i32)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;
    if(pl<1 || pl+1024>s.*.acap){return -1;}
    let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<pl){ab[i]=pb[i];i=i+1;}
    n3_setf(s,0,0,0);n3_setf(s,0,1,pl);n3_setf(s,0,2,0);n3_setf(s,0,3,0);
    n3_setf(s,0,4,-1);n3_setf(s,0,5,-1);n3_setf(s,0,6,-1);n3_setf(s,0,7,-1);
    n3_setf(s,0,8,0);n3_setf(s,0,9,0);n3_setf(s,0,10,-1);n3_setf(s,0,11,0);
    n3_setf(s,0,12,0);
    s.*.nst=1;s.*.an=pl;
    // ID: line value
    let pos:i32=0;let idv:[]u8="";
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        if(e-ls>=4 && pb[ls]==73 && pb[ls+1]==68 && pb[ls+2]==58){
            let v0:i32=0;let v1:i32=0;
            n3_trim(pb,ls+3,e-(ls+3),&v0,&v1);
            idv=pb[v0..v0+v1];
            break;
        }
        if(e<pl){e=e+1;}
        pos=e;
    }
    let pid:[]u8=nio_alloc(128);
    if(pid.len!=128){return -1;}
    let cp:i32=idv.len;
    if(cp>120){cp=120;}
    i=0;
    while(i<cp){pid[i]=idv[i];i=i+1;}
    x.*.pid=pid;x.*.pidlen=cp;
    // STATEMENT: value runs to EOF
    let so:i32=-1;
    pos=0;
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        if(e-ls>=10 && pb[ls]==83 && pb[ls+1]==84 && pb[ls+2]==65 && pb[ls+3]==84 && pb[ls+4]==69 && pb[ls+5]==77 && pb[ls+6]==69 && pb[ls+7]==78 && pb[ls+8]==84 && pb[ls+9]==58){
            so=ls+10;
            break;
        }
        if(e<pl){e=e+1;}
        pos=e;
    }
    if(so<0){return -2;}
    let t0:i32=0;let t1:i32=0;
    n3_trim(pb,so,pl-so,&t0,&t1);
    if(t1<1){return -2;}
    // goal: after "prove that " / "show that "
    let gp:i32=n3_find_ci(pb,t0,t1,"prove that ");
    let gl:i32=11;
    if(gp<0){gp=n3_find_ci(pb,t0,t1,"show that ");gl=10;}
    let gs:i32=t0;
    if(gp>=0){gs=gp+gl;}
    let g0:i32=0;let g1:i32=0;
    n3_trim(pb,gs,t0+t1-gs,&g0,&g1);
    if(g1<1){g0=t0;g1=t1;}
    let g:[]u8=nio_alloc(g1);
    if(g.len!=g1){return -1;}
    i=0;
    while(i<g1){g[i]=pb[g0+i];i=i+1;}
    x.*.goal=g;x.*.gollen=g1;
    x.*.goff=g0;x.*.glen=g1;
    x.*.assum=-1;x.*.derived_by=-1;
    return 0;
}

// ---------------- knowledge store parsing ----------------
// Format: [Kddd] header lines; optional "(type)" line; text lines until next
// header/EOF, joined with " ". Each item split into sentences on ". ";
// each sentence -> one CITE state (kid = item number).
fn n3_parse_kb(c:*N3C,kb:[]u8,kl:i32)i32 {
    let s:*N3S=c.*.s;
    let pos:i32=0;
    let ncites:i32=0;
    while(pos<kl){
        let ls:i32=pos;let e:i32=pos;
        while(e<kl && kb[e]!=10){e=e+1;}
        let ishead:i32=0;let idn:i32=0;
        if(e-ls>=6 && kb[ls]==91 && kb[ls+1]==75 && kb[ls+2]>=48 && kb[ls+2]<=57 && kb[ls+3]>=48 && kb[ls+3]<=57 && kb[ls+4]>=48 && kb[ls+4]<=57 && kb[ls+5]==93){
            ishead=1;
            idn=((kb[ls+2] as i32)-48)*100+(((kb[ls+3] as i32)-48)*10)+((kb[ls+4] as i32)-48);
        }
        if(e<kl){e=e+1;}
        pos=e;
        if(ishead==0){continue;}
        // gather text lines
        let tb:[]u8=nio_alloc(8192);
        if(tb.len!=8192){return -1;}
        let tn:i32=0;
        while(pos<kl){
            let l2:i32=pos;let e2:i32=pos;
            while(e2<kl && kb[e2]!=10){e2=e2+1;}
            let nh:i32=0;
            if(e2-l2>=6 && kb[l2]==91 && kb[l2+1]==75){nh=1;}
            if(nh==1){break;}
            let u0:i32=0;let u1:i32=0;
            n3_trim(kb,l2,e2-l2,&u0,&u1);
            if(u1>0 && kb[u0]!=40){
                if(tn>0 && tn<8191){tb[tn]=32;tn=tn+1;}
                let k:i32=0;
                while(k<u1 && tn<8191){tb[tn]=kb[u0+k];tn=tn+1;k=k+1;}
            }
            if(e2<kl){e2=e2+1;}
            pos=e2;
        }
        // split tb[0..tn) into sentences on ". "
        let sp:i32=0;
        while(sp<tn){
            let se:i32=sp;
            while(se<tn){
                if(tb[se]==46 && (se+1>=tn || tb[se+1]==32 || tb[se+1]==10)){break;}
                se=se+1;
            }
            let incl:i32=0;
            if(se<tn){incl=1;}
            let q0:i32=0;let q1:i32=0;
            n3_trim(tb,sp,se-sp+incl,&q0,&q1);
            if(q1>0 && ncites<400){
                let w:[]u8=s.*.wtmp;
                let k:i32=0;
                while(k<q1){w[k]=tb[q0+k];k=k+1;}
                let id:i32=n3_append(c,1,idn,-1,-1,-1,-1,1,-1,0,w,q1);
                if(id<0){nio_free(tb);return -2;}
                ncites=ncites+1;
            }
            sp=se+incl;
            if(sp<tn && tb[sp]==32){sp=sp+1;}
        }
        nio_free(tb);
    }
    return 0;
}

// ---------------- antecedent conjunct matching ----------------
// Split C-span on " and " (ci). Each conjunct (trimmed, len>=4) must occur as
// a case-insensitive substring of some live, non-defeated state
// (tainted_only=1 -> taint==1 required; no_subgoal=1 -> src!=4 required).
// The conditional's own state (u) and any other conditional-shaped state
// (q!=0) are excluded: a conditional asserts neither its own nor another's
// antecedent/consequent spans, so they cannot establish an antecedent
// (this also bars "if C then Q" licensing its own Q). The INPUT (q==0) is
// never excluded. Returns matched count (<=2), fills m1/m2; -1 if >2
// conjuncts, a conjunct is too short, or any conjunct unmatched.
fn n3_match_conj(c:*N3C,u:i32,co:i32,cl:i32,tainted_only:i32,no_subgoal:i32,m1:*i32,m2:*i32)i32 {
    let s:*N3S=c.*.s;
    let ab:[]u8=s.*.ar;
    let nm:i32=0;
    let cs:i32=co;let ce:i32=co+cl;
    let p:i32=cs;
    while(p<=ce){
        let nx:i32=n3_find_ci(ab,p,ce-p," and ");
        let cend:i32=ce;
        if(nx>=0){cend=nx;}
        let t0:i32=0;let t1:i32=0;
        n3_trim(ab,p,cend-p,&t0,&t1);
        if(t1<4){return -1;}
        nm=nm+1;
        if(nm>2){return -1;}
        // find matching state
        let f:i32=-1;
        let q:i32=0;
        while(q<s.*.nst){
            if(q!=u && n3_sf(s,q,9)==0){
                let ok:i32=1;
                if(tainted_only==1 && n3_sf(s,q,12)==0){ok=0;}
                if(no_subgoal==1 && n3_sf(s,q,2)==4){ok=0;}
                if(ok==1 && q!=0){
                    let qo:i32=0;let ql:i32=0;
                    n3_sbytes(s,q,&qo,&ql);
                    let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
                    if(n3_cond_parse(ab,qo,ql,&cc0,&cc1,&qq0,&qq1)==1){ok=0;}
                }
                if(ok==1){
                    let qo:i32=0;let ql:i32=0;
                    n3_sbytes(s,q,&qo,&ql);
                    if(n3_find_ci(ab,qo,ql,ab[t0..t0+t1])>=0){f=q;break;}
                }
            }
            q=q+1;
        }
        if(f<0){return -1;}
        if(nm==1){m1.*=f;}
        if(nm==2){m2.*=f;}
        if(nx<0){break;}
        p=nx+5;
    }
    return nm;
}

// ---------------- proposals ----------------
// Copy ar[bo..bo+bl) into wtmp; returns bl.
fn n3_wcpy(s:*N3S,bo:i32,bl:i32)i32 {
    let w:[]u8=s.*.wtmp;let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<bl){w[i]=ab[bo+i];i=i+1;}
    return bl;
}
fn n3_pinit(p:*N3P,lic:i32,p1:i32,p2:i32,p3:i32,src:i32,kid:i32)void {
    p.*.lic=lic;p.*.p1=p1;p.*.p2=p2;p.*.p3=p3;p.*.src=src;p.*.kid=kid;p.*.olen=0;
}

// T-CONTRA: L0 assume negated goal; L1 expand definitions over tainted
// states; L2 apply conditionals with tainted antecedent matches.
fn n3_prop_contra(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    if(x.*.assum==-1 && n3_used(t,0,0,0,-1,-1)==0){
        let lit:[]u8="It is not the case that ";
        let i:i32=0;
        while(i<lit.len){w[i]=lit[i];i=i+1;}
        let j:i32=0;
        while(j<x.*.gollen){w[i+j]=x.*.goal[j];j=j+1;}
        n3_pinit(p,0,0,-1,-1,2,0);
        p.*.olen=i+j;
        return 1;
    }
    // L1: definition expansion over tainted states
    let d:i32=1;
    while(d<s.*.nst){
        if(n3_sf(s,d,2)==1 && n3_sf(s,d,9)==0){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    let q:i32=0;
                    while(q<s.*.nst){
                        if(q!=d && n3_sf(s,q,9)==0 && n3_sf(s,q,12)==1){
                            let qo:i32=0;let ql:i32=0;
                            n3_sbytes(s,q,&qo,&ql);
                            if(n3_find_word_ci(ab,qo,ql,ab[ko..ko+kl])>=0 && n3_used(t,0,1,d,q,-1)==0){
                                n3_pinit(p,1,d,q,-1,3,n3_sf(s,d,3));
                                p.*.olen=n3_wcpy(s,yo,yl);
                                return 1;
                            }
                        }
                        q=q+1;
                    }
                }
            }
        }
        d=d+1;
    }
    // L2: conditional application, tainted antecedent matches
    d=1;
    while(d<s.*.nst){
        if(n3_sf(s,d,2)==1 && n3_sf(s,d,9)==0){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                let m1:i32=-1;let m2:i32=-1;
                if(n3_match_conj(c,d,co,cl,1,1,&m1,&m2)>=1){
                    // m2==-1 iff a single conjunct (state ids are >=0)
                    if(n3_used(t,0,2,d,m1,m2)==0){
                        n3_pinit(p,2,d,m1,m2,3,n3_sf(s,d,3));
                        p.*.olen=n3_wcpy(s,qo,ql);
                        return 1;
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// T-CONSTRUCT: L3 definition expansion over all live states;
// L4 biconditional (" iff ") forward elimination.
fn n3_prop_construct(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;
    let d:i32=1;
    while(d<s.*.nst){
        if(n3_sf(s,d,2)==1 && n3_sf(s,d,9)==0){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    let q:i32=0;
                    while(q<s.*.nst){
                        if(q!=d && n3_sf(s,q,9)==0){
                            let qo:i32=0;let ql:i32=0;
                            n3_sbytes(s,q,&qo,&ql);
                            if(n3_find_word_ci(ab,qo,ql,ab[ko..ko+kl])>=0 && n3_used(t,1,3,d,q,-1)==0){
                                n3_pinit(p,3,d,q,-1,3,n3_sf(s,d,3));
                                p.*.olen=n3_wcpy(s,yo,yl);
                                return 1;
                            }
                        }
                        q=q+1;
                    }
                }
                // L4: " iff " in body
                let ip:i32=n3_find_ci(ab,yo,yl," iff ");
                if(ip>=0){
                    let l0:i32=0;let l1:i32=0;let r0:i32=0;let r1:i32=0;
                    n3_trim(ab,yo,ip-yo,&l0,&l1);
                    n3_trim(ab,ip+5,yo+yl-(ip+5),&r0,&r1);
                    if(l1>=4 && r1>=1){
                        let q:i32=0;
                        while(q<s.*.nst){
                            if(q!=d && n3_sf(s,q,9)==0){
                                let qo:i32=0;let ql:i32=0;
                                n3_sbytes(s,q,&qo,&ql);
                                if(n3_find_ci(ab,qo,ql,ab[l0..l0+l1])>=0 && n3_used(t,1,4,d,q,-1)==0){
                                    n3_pinit(p,4,d,q,-1,3,n3_sf(s,d,3));
                                    p.*.olen=n3_wcpy(s,r0,r1);
                                    return 1;
                                }
                            }
                            q=q+1;
                        }
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// T-LEMMA: L5 conditional application; antecedent conjuncts must be
// byte-substrings of live, non-defeated, non-subgoal states.
fn n3_prop_lemma(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;
    let d:i32=1;
    while(d<s.*.nst){
        if(n3_sf(s,d,2)==1 && n3_sf(s,d,9)==0){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                let m1:i32=-1;let m2:i32=-1;
                if(n3_match_conj(c,d,co,cl,0,1,&m1,&m2)>=1){
                    if(n3_used(t,2,5,d,m1,m2)==0){
                        n3_pinit(p,5,d,m1,m2,3,n3_sf(s,d,3));
                        p.*.olen=n3_wcpy(s,qo,ql);
                        return 1;
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// T-GOAL: L6 definition splice into goal; L7 plant antecedent as subgoal
// when consequent overlaps goal; L8 close subgoal via establishing state.
fn n3_prop_goal(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    let d:i32=1;
    while(d<s.*.nst){
        if(n3_sf(s,d,2)==1 && n3_sf(s,d,9)==0){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    let pos:i32=n3_find_word_ci(x.*.goal,0,x.*.gollen,ab[ko..ko+kl]);
                    if(pos>=0 && n3_used(t,3,6,d,0,-1)==0){
                        let i:i32=0;
                        while(i<pos){w[i]=x.*.goal[i];i=i+1;}
                        let j:i32=0;
                        while(j<yl){w[i+j]=ab[yo+j];j=j+1;}
                        i=i+yl;
                        let k:i32=pos+kl;
                        while(k<x.*.gollen){w[i]=x.*.goal[k];i=i+1;k=k+1;}
                        n3_pinit(p,6,d,0,-1,3,n3_sf(s,d,3));
                        p.*.olen=i;
                        return 1;
                    }
                }
            }
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                // L7: consequent shares >=2 non-stop words with goal
                let qa:[]u8=t.*.wa;let qb:[]u8=t.*.wb;
                let n1:i32=n3_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qa,192);
                let n2:i32=n3_collect(c,x.*.goal,0,x.*.gollen,-1,0,-1,0,-1,0,qb,192);
                let sh:i32=0;let ii:i32=0;
                while(ii<n1){
                    if(n3_in_arr(qb,n2,au_get64(qa,ii))==1){sh=sh+1;}
                    ii=ii+1;
                }
                if(sh>=2 && n3_used(t,3,7,d,0,-1)==0){
                    n3_pinit(p,7,d,0,-1,4,n3_sf(s,d,3));
                    p.*.olen=n3_wcpy(s,co,cl);
                    return 1;
                }
            }
        }
        d=d+1;
    }
    // L8: close a planted subgoal
    let b:i32=1;
    while(b<s.*.nst){
        if(n3_sf(s,b,2)==4 && n3_sf(s,b,9)==0){
            let u:i32=n3_sf(s,b,5);
            if(u>0 && n3_sf(s,u,2)==1 && n3_sf(s,u,9)==0){
                let uo:i32=0;let ul:i32=0;
                n3_sbytes(s,u,&uo,&ul);
                let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
                if(n3_cond_parse(ab,uo,ul,&co,&cl,&qo,&ql)==1){
                    let so:i32=0;let sl:i32=0;
                    n3_sbytes(s,b,&so,&sl);
                    let q:i32=0;
                    while(q<s.*.nst){
                        if(q!=b && q!=u && n3_sf(s,q,9)==0 && n3_sf(s,q,2)!=4){
                            let qo2:i32=0;let ql2:i32=0;
                            n3_sbytes(s,q,&qo2,&ql2);
                            // the establisher must assert the subgoal bytes:
                            // exclude conditional-shaped states (their
                            // conditional spans are unasserted), never the
                            // input.
                            let okest:i32=1;
                            if(q!=0){
                                let ec0:i32=0;let ec1:i32=0;let eq0:i32=0;let eq1:i32=0;
                                if(n3_cond_parse(ab,qo2,ql2,&ec0,&ec1,&eq0,&eq1)==1){okest=0;}
                            }
                            if(okest==1 && n3_find_ci(ab,qo2,ql2,ab[so..so+sl])>=0 && n3_used(t,3,8,u,b,q)==0){
                                n3_pinit(p,8,u,b,q,3,n3_sf(s,u,3));
                                p.*.olen=n3_wcpy(s,qo,ql);
                                return 1;
                            }
                        }
                        q=q+1;
                    }
                }
            }
        }
        b=b+1;
    }
    return 0;
}

fn n3_propose(c:*N3C,th:i32,round:i32,p:*N3P)i32 {
    if(th==0){return n3_prop_contra(c,round,p);}
    if(th==1){return n3_prop_construct(c,round,p);}
    if(th==2){return n3_prop_lemma(c,round,p);}
    return n3_prop_goal(c,round,p);
}

// ---------------- logging ----------------
fn n3_log(au:*DOut,s:[]u8)void { dout_str(au,s);dout_line(au); }
fn n3_log1(au:*DOut,s:[]u8,v:i64)void { dout_str(au,s);dout_i64(au,v);dout_line(au); }
fn n3_tname(t:i32)[]u8 {
    if(t==0){return "CONTRA";}
    if(t==1){return "CONSTRUCT";}
    if(t==2){return "LEMMA";}
    return "GOAL";
}
fn n3_lname(lic:i32)[]u8 {
    if(lic==0){return "contra-assume";}
    if(lic==1){return "contra-expand";}
    if(lic==2){return "contra-apply";}
    if(lic==3){return "construct-expand";}
    if(lic==4){return "construct-iff";}
    if(lic==5){return "lemma-apply";}
    if(lic==6){return "goal-defsplice";}
    if(lic==7){return "goal-lemmasub";}
    if(lic==8){return "goal-close";}
    return "pbc-goal";
}
fn n3_srcname(src:i32)[]u8 {
    if(src==0){return "input";}
    if(src==1){return "cite";}
    if(src==2){return "assume";}
    if(src==3){return "prop";}
    if(src==4){return "subgoal";}
    return "pbc";
}
fn n3_phead(au:*DOut,round:i32,th:i32,p:*N3P)void {
    dout_str(au,"R");dout_i64(au,round as i64);
    dout_str(au," T");dout_i64(au,th as i64);
    dout_str(au," ");dout_str(au,n3_tname(th));
    dout_str(au," L");dout_i64(au,p.*.lic as i64);
    dout_str(au," ");dout_str(au,n3_lname(p.*.lic));
    dout_str(au," p=[");dout_i64(au,p.*.p1 as i64);
    dout_str(au,",");dout_i64(au,p.*.p2 as i64);
    dout_str(au,",");dout_i64(au,p.*.p3 as i64);
    dout_str(au,"]");
}
fn n3_log_app(au:*DOut,round:i32,th:i32,p:*N3P,id:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," -> S");dout_i64(au,id as i64);
    dout_str(au," APPEND");dout_line(au);
}
fn n3_log_ref(au:*DOut,round:i32,th:i32,p:*N3P,cb:[]u8,nc:i32,strikes:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," REFUSED contra=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] strikes=");dout_i64(au,strikes as i64);dout_line(au);
}
fn n3_log_dis(au:*DOut,round:i32,th:i32,p:*N3P,id:i32,cb:[]u8,nc:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," DISCHARGE assum=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] -> S");dout_i64(au,id as i64);
    dout_str(au," APPEND");dout_line(au);
}
fn n3_log_pbc(au:*DOut,round:i32,th:i32,p:*N3P,gid:i32,cb:[]u8,nc:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," PBC-FIRED contra=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] GOAL -> S");dout_i64(au,gid as i64);
    dout_str(au," APPEND");dout_line(au);
}

// premise depth = 1 + max premise depth.
fn n3_pdepth(s:*N3S,p:*N3P)i32 {
    let m:i32=0;
    if(p.*.p1>=0 && n3_sf(s,p.*.p1,8)>m){m=n3_sf(s,p.*.p1,8);}
    if(p.*.p2>=0 && n3_sf(s,p.*.p2,8)>m){m=n3_sf(s,p.*.p2,8);}
    if(p.*.p3>=0 && n3_sf(s,p.*.p3,8)>m){m=n3_sf(s,p.*.p3,8);}
    return m+1;
}
// byte-equality (case-insensitive, trimmed) with the goal skeleton.
fn n3_goal_match(c:*N3C,ob:[]u8,olen:i32)i32 {
    let x:*N3X=c.*.x;
    let t0:i32=0;let t1:i32=0;
    n3_trim(ob,0,olen,&t0,&t1);
    if(t1!=x.*.gollen){return 0;}
    return n3_eq_ci(ob,t0,t1,x.*.goal,0,x.*.gollen);
}

// ---------------- adjudication ----------------
// Returns: 0 dup-skip, 1 appended, 2 refused, 3 discharged+appended, 4 DERIVED.
fn n3_adjudicate(c:*N3C,th:i32,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let w:[]u8=s.*.wtmp;let ol:i32=p.*.olen;
    if(ol<1){return 0;}
    // duplicate of any existing ledger state -> skip, mark used
    let d:i32=0;
    while(d<s.*.nst){
        let bo:i32=0;let bl:i32=0;
        n3_sbytes(s,d,&bo,&bl);
        if(bl==ol && nio_equal(s.*.ar[bo..bo+bl],w[0..ol])==1){
            n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
            n3_phead(au,round,th,p);
            dout_str(au," DUP-SKIP");dout_line(au);
            return 0;
        }
        d=d+1;
    }
    // contradiction scan vs all live states
    let cb:[]u8=nio_alloc(8*4);
    if(cb.len!=32){return 0;}
    let nc:i32=0;let nona:i32=0;
    let b:i32=0;
    while(b<s.*.nst){
        if(n3_sf(s,b,9)==0 && n3_contra_state(c,w,ol,b)==1){
            if(nc<8){au_put32(cb,nc,b);}
            nc=nc+1;
            if(n3_sf(s,b,2)!=2){nona=1;}
        }
        b=b+1;
    }
    if(nc==0){
        let id:i32=n3_append(c,p.*.src,p.*.kid,p.*.lic,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,w,ol);
        n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
        au_put32(t.*.strs,th,0);
        if(p.*.src==2){x.*.assum=id;}
        n3_log_app(au,round,th,p,id);
        nio_free(cb);
        if(id>=0 && n3_goal_match(c,w,ol)==1){
            x.*.derived_by=th;
            return 4;
        }
        return 1;
    }
    if(nona==0){
        // discharge: contradict only assumptions -> defeat them and all
        // assumption-tainted states, then append the proposal.
        let k:i32=0;
        while(k<nc && k<8){n3_setf(s,au_get32(cb,k),9,1);k=k+1;}
        x.*.assum=-1;
        let q2:i32=0;
        while(q2<s.*.nst){
            if(n3_sf(s,q2,9)==0 && n3_sf(s,q2,12)==1){n3_setf(s,q2,9,1);}
            q2=q2+1;
        }
        au_put32(s.*.ev,1,au_get32(s.*.ev,1)+1);
        let id:i32=n3_append(c,p.*.src,p.*.kid,p.*.lic,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,w,ol);
        n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
        au_put32(t.*.strs,th,0);
        n3_log_dis(au,round,th,p,id,cb,nc);
        nio_free(cb);
        if(id>=0 && n3_goal_match(c,w,ol)==1){
            x.*.derived_by=th;
            return 4;
        }
        return 3;
    }
    // refused
    let st2:i32=au_get32(t.*.strs,th)+1;
    au_put32(t.*.strs,th,st2);
    n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
    n3_log_ref(au,round,th,p,cb,nc,st2);
    // PBC route: T-CONTRA with an assumption-tainted chain whose CONSEQUENCE
    // (src==prop, never the assumption itself) contradicts live
    // non-assumption knowledge -> the assumption is impossible; defeat it and
    // its chain, append the goal skeleton.
    let tainted:i32=0;
    if(p.*.p1>=0 && n3_sf(s,p.*.p1,12)==1){tainted=1;}
    if(p.*.p2>=0 && n3_sf(s,p.*.p2,12)==1){tainted=1;}
    if(p.*.p3>=0 && n3_sf(s,p.*.p3,12)==1){tainted=1;}
    if(th==0 && p.*.src==3 && tainted==1){
        let k:i32=0;
        while(k<s.*.nst){
            if(n3_sf(s,k,9)==0 && (n3_sf(s,k,2)==2 || n3_sf(s,k,12)==1)){n3_setf(s,k,9,1);}
            k=k+1;
        }
        x.*.assum=-1;
        let gbad:i32=0;
        let b2:i32=0;
        while(b2<s.*.nst){
            if(n3_sf(s,b2,9)==0 && n3_sf(s,b2,2)!=2){
                if(n3_contra_state(c,x.*.goal,x.*.gollen,b2)==1){gbad=1;break;}
            }
            b2=b2+1;
        }
        if(gbad==0){
            let gid:i32=n3_append(c,5,0,99,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,x.*.goal,x.*.gollen);
            au_put32(s.*.ev,0,au_get32(s.*.ev,0)+1);
            n3_log_pbc(au,round,th,p,gid,cb,nc);
            x.*.derived_by=th;
            nio_free(cb);
            return 4;
        }
        n3_phead(au,round,th,p);
        dout_str(au," PBC-BLOCKED goal contradicts live state");dout_line(au);
    }
    if(st2>=3){
        au_put32(t.*.kill,th,1);
        let m:i32=au_get32(s.*.ev,5);
        let bit:i32=1;let sh:i32=0;
        while(sh<th){bit=bit*2;sh=sh+1;}
        au_put32(s.*.ev,5,m+bit);
        n3_phead(au,round,th,p);
        dout_str(au," STRATEGY-KILLED");dout_line(au);
    }
    nio_free(cb);
    return 2;
}

// ---------------- main deliberation loop ----------------
fn n3_run(c:*N3C)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let round:i32=1;
    while(round<=25){
        let act:i32=0;
        let th:i32=0;
        while(th<4){
            if(au_get32(t.*.kill,th)==0){
                let pr:N3P=N3P{.lic=-1,.p1=-1,.p2=-1,.p3=-1,.src=-1,.kid=0,.olen=0};
                if(n3_propose(c,th,round,&pr)==1){
                    act=1;
                    au_put32(t.*.props,th,au_get32(t.*.props,th)+1);
                    if(n3_adjudicate(c,th,round,&pr)==4){return 1;}
                }
            }
            th=th+1;
        }
        let alive:i32=0;let k2:i32=0;
        while(k2<4){
            if(au_get32(t.*.kill,k2)==0){alive=1;}
            k2=k2+1;
        }
        if(alive==0){
            au_put32(s.*.ev,4,1);
            n3_log1(au,"WITHHOLD ALL-KILLED rounds=",round as i64);
            return 0;
        }
        if(act==0){
            au_put32(s.*.ev,2,1);
            n3_log1(au,"WITHHOLD FIXPOINT rounds=",round as i64);
            return 0;
        }
        round=round+1;
    }
    au_put32(s.*.ev,3,1);
    n3_log1(au,"WITHHOLD BUDGET-EXHAUSTED rounds=",25);
    return 0;
}

// ---------------- output ----------------
fn n3_emit(c:*N3C,derived:i32,o:*DOut)void {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let ab:[]u8=s.*.ar;
    dout_str(o,"ID: ");dout_str(o,x.*.pid[0..x.*.pidlen]);dout_line(o);
    dout_str(o,"ENGINE: n3");dout_line(o);
    if(derived==1){dout_str(o,"VERDICT: DERIVED");}else{dout_str(o,"VERDICT: WITHHELD");}
    dout_line(o);
    dout_str(o,"CLAIM: ");dout_str(o,x.*.goal);dout_line(o);
    dout_str(o,"CONFIDENCE: ");dout_i64(o,derived as i64);dout_line(o);
    let nd:i32=0;let i:i32=0;
    while(i<s.*.nst){
        let src:i32=n3_sf(s,i,2);
        if(src==3 || src==4 || src==5){nd=nd+1;}
        i=i+1;
    }
    dout_str(o,"DERIVATIONS: ");dout_i64(o,nd as i64);dout_line(o);
    dout_str(o,"STORE: ");dout_str(o,x.*.store[0..x.*.storelen]);dout_line(o);
    dout_str(o,"FLAGS:");
    if(au_get32(s.*.ev,0)>0){dout_str(o," PBC-FIRED");}
    if(au_get32(s.*.ev,1)>0){dout_str(o," DISCHARGE");}
    if(au_get32(s.*.ev,2)>0){dout_str(o," FIXPOINT");}
    if(au_get32(s.*.ev,3)>0){dout_str(o," BUDGET-EXHAUSTED");}
    if(au_get32(s.*.ev,4)>0){dout_str(o," ALL-KILLED");}
    dout_line(o);
    dout_str(o,"THREADS:");dout_line(o);
    let th:i32=0;
    while(th<4){
        dout_str(o,"T");dout_i64(o,th as i64);
        dout_str(o," ");dout_str(o,n3_tname(th));
        if(au_get32(t.*.kill,th)==1){dout_str(o," status=killed");}else{dout_str(o," status=live");}
        dout_str(o," strikes=");dout_i64(o,au_get32(t.*.strs,th) as i64);
        dout_str(o," proposals=");dout_i64(o,au_get32(t.*.props,th) as i64);
        dout_line(o);
        th=th+1;
    }
    dout_str(o,"LEDGER:");dout_line(o);
    i=0;
    while(i<s.*.nst){
        let bo:i32=0;let bl:i32=0;
        n3_sbytes(s,i,&bo,&bl);
        dout_str(o,"S");dout_i64(o,i as i64);
        dout_str(o," src=");dout_str(o,n3_srcname(n3_sf(s,i,2)));
        let kid:i32=n3_sf(s,i,3);
        if(kid>0){
            dout_str(o," kid=K");
            if(kid<100){dout_str(o,"0");}
            if(kid<10){dout_str(o,"0");}
            dout_i64(o,kid as i64);
        }
        dout_str(o," lic=");dout_i64(o,n3_sf(s,i,4) as i64);
        dout_str(o," p=[");dout_i64(o,n3_sf(s,i,5) as i64);
        dout_str(o,",");dout_i64(o,n3_sf(s,i,6) as i64);
        dout_str(o,",");dout_i64(o,n3_sf(s,i,7) as i64);
        dout_str(o,"] depth=");dout_i64(o,n3_sf(s,i,8) as i64);
        if(n3_sf(s,i,9)==1){dout_str(o," defeated");}else{dout_str(o," live");}
        dout_str(o," t=");dout_i64(o,n3_sf(s,i,10) as i64);
        dout_str(o," r=");dout_i64(o,n3_sf(s,i,11) as i64);
        dout_str(o," taint=");dout_i64(o,n3_sf(s,i,12) as i64);
        dout_str(o,": ");dout_str(o,ab[bo..bo+bl]);dout_line(o);
        i=i+1;
    }
    dout_str(o,"AUDIT:");dout_line(o);
    dout_str(o,au.*.buf[0..au.*.n]);
}

// ---------------- engine init ----------------
fn n3_s_alloc(s:*N3S)i32 {
    s.*.ar=nio_alloc(4194304);
    if(s.*.ar.len!=4194304){return -1;}
    s.*.acap=4194304;s.*.an=0;
    s.*.st=nio_alloc(1024*80);
    if(s.*.st.len!=1024*80){return -1;}
    s.*.nst=0;s.*.stcap=1024;
    s.*.wtmp=nio_alloc(65536);
    if(s.*.wtmp.len!=65536){return -1;}
    s.*.ev=nio_alloc(8*4);
    if(s.*.ev.len!=8*4){return -1;}
    return 0;
}
fn n3_x_init(x:*N3X)void {
    x.*.goff=0;x.*.glen=0;
    x.*.goal="";x.*.gollen=0;
    x.*.pid="";x.*.pidlen=0;
    x.*.assum=-1;x.*.derived_by=-1;
    x.*.store="";x.*.storelen=0;
}
fn n3_t_alloc(t:*N3T)i32 {
    t.*.strs=nio_alloc(4*4);
    if(t.*.strs.len!=4*4){return -1;}
    t.*.kill=nio_alloc(4*4);
    if(t.*.kill.len!=4*4){return -1;}
    t.*.props=nio_alloc(4*4);
    if(t.*.props.len!=4*4){return -1;}
    t.*.nused=nio_alloc(4*4);
    if(t.*.nused.len!=4*4){return -1;}
    t.*.used=nio_alloc(4*160*16);
    if(t.*.used.len!=4*160*16){return -1;}
    t.*.wa=nio_alloc(192*8);
    if(t.*.wa.len!=192*8){return -1;}
    t.*.wb=nio_alloc(192*8);
    if(t.*.wb.len!=192*8){return -1;}
    t.*.na=nio_alloc(192*8);
    if(t.*.na.len!=192*8){return -1;}
    t.*.nb=nio_alloc(192*8);
    if(t.*.nb.len!=192*8){return -1;}
    return 0;
}
fn n3_mkctx(s:*N3S,x:*N3X,t:*N3T,w:*N3W,au:*DOut)N3C {
    let c:N3C=N3C{.s=s,.x=x,.t=t,.w=w,.au=au};
    return c;
}
fn n3_x_store(x:*N3X,sp:[]u8,sl:i32)void {
    x.*.store=sp;x.*.storelen=sl;
}

// one full deterministic run into o.
fn n3_once(fbuf:[]u8,flen:i64,kbuf:[]u8,klen:i64,kpath:[]u8,o:*DOut)i32 {
    let s:N3S=N3S{.ar="",.acap=0,.an=0,.st="",.nst=0,.stcap=0,.wtmp="",.ev=""};
    if(n3_s_alloc(&s)!=0){return -1;}
    let x:N3X=N3X{.goff=0,.glen=0,.goal="",.gollen=0,.pid="",.pidlen=0,.assum=0,.derived_by=0,.store="",.storelen=0};
    n3_x_init(&x);
    let t:N3T=N3T{.strs="",.kill="",.props="",.used="",.nused="",.wa="",.wb="",.na="",.nb=""};
    if(n3_t_alloc(&t)!=0){return -1;}
    let w:N3W=N3W{.st="",.ns=0,.ng="",.nn=0};
    n3_winit(&w);
    let au:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&au,2097152)!=0){return -1;}
    let c:N3C=n3_mkctx(&s,&x,&t,&w,&au);
    let cp:*N3C=&c;
    n3_x_store(&x,kpath,kpath.len);
    if(n3_parse_prob(cp,fbuf,flen as i32)!=0){return -2;}
    if(n3_parse_kb(cp,kbuf,klen as i32)!=0){return -3;}
    let dr:i32=n3_run(cp);
    n3_emit(cp,dr,o);
    return 0;
}

fn main() i32 {
    if(_zag_argc()<3){
        _zag_println("usage: n3_bin <problem.txt> <out_path> [knowledge]");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    let kpath:[]u8="../../batteries/knowledge/KNOWLEDGE_STORE_NL.md";
    if(_zag_argc()>=4){kpath=_zag_arg(3);}
    if(n3_has_sealed(fpath)==1){_zag_println("n3: sealed guard tripped (problem path)");return 3;}
    if(n3_has_sealed(kpath)==1){_zag_println("n3: sealed guard tripped (knowledge path)");return 3;}
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len!=1048576){_zag_println("n3: alloc failed");return 4;}
    let fl:i64=dlb_read_file(fpath,fbuf);
    if(fl<=0){_zag_println("n3: cannot read problem file");return 4;}
    let kbuf:[]u8=nio_alloc(1048576);
    if(kbuf.len!=1048576){_zag_println("n3: alloc failed");return 4;}
    let kl:i64=dlb_read_file(kpath,kbuf);
    if(kl<=0){_zag_println("n3: cannot read knowledge store");return 4;}
    let r1:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    let r2:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    let r3:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&r1,2097152)!=0 || dout_init(&r2,2097152)!=0 || dout_init(&r3,2097152)!=0){
        _zag_println("n3: alloc failed");
        return 4;
    }
    let e1:i32=n3_once(fbuf,fl,kbuf,kl,kpath,&r1);
    let e2:i32=n3_once(fbuf,fl,kbuf,kl,kpath,&r2);
    let e3:i32=n3_once(fbuf,fl,kbuf,kl,kpath,&r3);
    if(e1!=0 || e2!=0 || e3!=0){
        _zag_println("n3: engine error");
        return 4;
    }
    if(r1.n!=r2.n || r1.n!=r3.n || nio_equal(r1.buf[0..r1.n],r2.buf[0..r2.n])==0 || nio_equal(r1.buf[0..r1.n],r3.buf[0..r3.n])==0){
        _zag_println("n3: DIVERGENCE across 3 runs");
        return 5;
    }
    let wr:i64=dlb_write_file(opath,r1.buf,r1.n);
    if(wr!=r1.n){_zag_println("n3: write failed");return 4;}
    _zag_println("n3: ok");
    return 0;
}

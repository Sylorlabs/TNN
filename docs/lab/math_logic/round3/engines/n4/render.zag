// render.zag — FROZEN DETERMINISTIC RENDERER for N4 (ANALOG-NATIVE).
//
// Mechanical translator: round-1/round-2 PUBLIC traces (traces/TRACE_P*.txt)
// + public problem files (problems/P*.txt) -> frozen case library:
//   cases/CNN.txt (human-readable, auditable) and cases_data.zag
//   (Zag consts embedded by the n4 engine).
//
// The renderer applies FIXED NL templates per step kind. It performs no
// inference: every slot is a byte-span copied verbatim from the input
// trace. The three spec templates (S_MP / S_PBC / S_UI, verbatim from
// IDEAS_ADDENDUM_R3.md) are implemented below; they are inert on the
// actual public input because the round-1/2 public traces contain no
// schema steps (all 22 are deliberative withhold traces). The renderer
// therefore also carries fixed mechanical templates for the deliberative
// RULE tags actually present in the input. All templates are fixed
// strings with byte-span slots — no intelligence, no NL->schema mapping.
//
// Pure Zag, zero RNG, deterministic. Reads ONLY public paths
// (traces/, problems/). Refuses any path containing "sealed".
// Run from this directory (the n4 engine dir).

@import("../../../../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")
@import("../../../../math_logic/engines/common/cx_str.zag")
@import("../../../../math_logic/engines/common/cx_io.zag")

// ---- byte helpers (r_ prefix; no clashes with cx_*) ----

fn r_find(h:[]u8,n:[]u8)i32 {
    return r_find_from(h,n,0);
}
fn r_find_from(h:[]u8,n:[]u8,st:i32)i32 {
    if(n.len==0 || st<0){return -1;}
    let i:i32=st;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}
// bytes between first a and the next b after it; "" if absent
fn r_slot(body:[]u8,a:[]u8,b:[]u8)[]u8 {
    let p:i32=r_find(body,a);
    if(p<0){return "";}
    let s:i32=p+a.len;
    let q:i32=r_find_from(body,b,s);
    if(q<0){return "";}
    return body[s..q];
}
// bytes after first a to end of line-buffer
fn r_after(body:[]u8,a:[]u8)[]u8 {
    let p:i32=r_find(body,a);
    if(p<0){return "";}
    return body[p+a.len..];
}
fn r_itoa(v:i32)[]u8 {
    if(v==0){return "0";}
    let neg:i32=0;
    let x:i32=v;
    if(x<0){neg=1;x=0-x;}
    let d:[]u8="0123456789";
    let tmp:[]u8=nio_alloc(16);
    let n:i32=0;
    while(x>0){tmp[n]=d[x-((x/10)*10)];x=x/10;n=n+1;}
    let out:[]u8=nio_alloc(n+1);
    let i:i32=0;
    if(neg==1){out[0]=45;i=1;}
    let j:i32=0;
    while(j<n){out[i+j]=tmp[n-1-j];j=j+1;}
    return out[0..i+n];
}
fn r_two(v:i32)[]u8 {
    let s:[]u8=r_itoa(v);
    if(s.len==1){return cx_concat("0",s);}
    return s;
}

// ---- spec templates (verbatim from IDEAS_ADDENDUM_R3.md) ----
// Implemented exactly as specified. Inert on the round-1/2 public input
// Slots: p=[P] q=[Q] chain=[chain] x=[x] inst=[instance]. Inert on the
// round-1/2 public input (no schema steps there); kept frozen per spec.
fn r_tpl_spec(tag:[]u8,p:[]u8,q:[]u8,chain:[]u8,x:[]u8,inst:[]u8)[]u8 {
    if(nio_equal(tag,"S_MP")==1){
        let s:[]u8=cx_concat("From ",p);
        s=cx_concat(s," and [if ");
        s=cx_concat(s,p);
        s=cx_concat(s," then ");
        s=cx_concat(s,q);
        s=cx_concat(s,"], we get ");
        s=cx_concat(s,q);
        s=cx_concat(s,".");
        return s;
    }
    if(nio_equal(tag,"S_PBC")==1){
        let s:[]u8=cx_concat("Assume [not ",p);
        s=cx_concat(s,"]. ");
        s=cx_concat(s,chain);
        s=cx_concat(s," Contradiction. So ");
        s=cx_concat(s,p);
        s=cx_concat(s,".");
        return s;
    }
    if(nio_equal(tag,"S_UI")==1){
        let s:[]u8=cx_concat("For ",x);
        s=cx_concat(s,", ");
        s=cx_concat(s,inst);
        s=cx_concat(s,".");
        return s;
    }
    return "";
}

// ---- deliberative templates (fixed strings, byte-span slots) ----
fn r_tpl(tag:[]u8,body:[]u8)[]u8 {
    if(nio_equal(tag,"premise_load")==1){
        let id:[]u8=r_slot(body,"Loaded problem "," ");
        let dom:[]u8=r_slot(body,"DOMAIN="," ");
        let typ:[]u8=r_slot(body,"TYPE=",".");
        let items:[]u8=r_slot(body,"knowledge-store items ",", each as");
        let s:[]u8=cx_concat("LOAD problem=",id);
        s=cx_concat(s," domain=");
        s=cx_concat(s,dom);
        s=cx_concat(s," type=");
        s=cx_concat(s,typ);
        s=cx_concat(s," premises=");
        s=cx_concat(s,items);
        s=cx_concat(s,".");
        return s;
    }
    if(nio_equal(tag,"hypothesis_setup")==1){
        let typ:[]u8=r_slot(body,"setup for TYPE="," ");
        return cx_concat("HYPOTHESES WITHHELD CLAIM_TRUE CLAIM_FALSE tiebreak=lowest-index type=",cx_concat(typ,"."));
    }
    if(nio_equal(tag,"deliberative_evidence")==1){
        let rnd:[]u8=r_slot(body,"Deliberation round ",":");
        let kid:[]u8=r_slot(body,"consumed evidence "," ");
        let sc:[]u8=r_slot(body,"Scores unchanged at ",".");
        return cx_concat("ROUND ",cx_concat(rnd,cx_concat(" EVIDENCE ",cx_concat(kid,cx_concat(" scores=",cx_concat(sc,"."))))));
    }
    if(nio_equal(tag,"deliberative_test")==1){
        let rnd:[]u8=r_slot(body,"Deliberation round ",":");
        let h:[]u8=r_slot(body,"h="," holds");
        return cx_concat("ROUND ",cx_concat(rnd,cx_concat(" TEST ",cx_concat(h," holds."))));
    }
    if(nio_equal(tag,"deliberative_round")==1){
        let r:[]u8=r_slot(body,"r="," ");
        let l:[]u8=r_slot(body,"leader="," ");
        let m:[]u8=r_slot(body,"margin="," ");
        let c:[]u8=r_after(body,"conf=");
        return cx_concat("ROUND ",cx_concat(r,cx_concat(" SUMMARY leader=",cx_concat(l,cx_concat(" margin=",cx_concat(m,cx_concat(" conf=",cx_concat(c,"."))))))));
    }
    if(nio_equal(tag,"deliberative_verdict")==1){
        let v:[]u8=r_slot(body,"verdict="," ");
        let c:[]u8=r_slot(body,"conf="," ");
        let r:[]u8=r_slot(body,"rounds="," ");
        let e:[]u8=r_slot(body,"ev=",".");
        return cx_concat("VERDICT ",cx_concat(v,cx_concat(" conf=",cx_concat(c,cx_concat(" rounds=",cx_concat(r,cx_concat(" ev=",cx_concat(e,"."))))))));
    }
    return "";
}

// escape bytes into a Zag string literal body
fn r_zesc(s:[]u8)[]u8 {
    let out:[]u8=nio_alloc(s.len*2+8);
    let w:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==92){out[w]=92;out[w+1]=92;w=w+2;}
        else {
            if(c==34){out[w]=92;out[w+1]=34;w=w+2;}
            else {
                if(c==10){out[w]=92;out[w+1]=110;w=w+2;}
                else {
                    if(c==13){out[w]=92;out[w+1]=114;w=w+2;}
                    else {out[w]=c;w=w+1;}
                }
            }
        }
        i=i+1;
    }
    return out[0..w];
}

// append bytes to an output accumulator; returns new length
fn r_emit(out:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){out[pos+i]=s[i];i=i+1;}
    return pos+s.len;
}

fn main()i32 {
    let tbuf:[]u8=nio_alloc(1048576);
    let pbuf:[]u8=nio_alloc(65536);
    let cbuf:[]u8=nio_alloc(1048576);
    let zbuf:[]u8=nio_alloc(2097152);
    if(tbuf.len==0 || pbuf.len==0 || cbuf.len==0 || zbuf.len==0){return 4;}
    let zpos:i32=0;
    zpos=r_emit(zbuf,zpos,"// cases_data.zag — GENERATED by render.zag (frozen N4 case library).\n// Do not hand-edit. Regenerate: build render.zag and run render_bin from\n// math_logic/round3/engines/n4. Source: traces/TRACE_P01..P22.txt (public)\n// + problems/P01..P22.txt (public). 22 cases; spec asked 40, only 22\n// public traces exist (documented in BUILD_N4.md).\nconst N4_NCASES:i32=22;\n");
    let k:i32=1;
    while(k<=22){
        let nn:[]u8=r_two(k);
        let tpath:[]u8=cx_concat("../../../traces/TRACE_P",cx_concat(nn,".txt"));
        let ppath:[]u8=cx_concat("../../../problems/P",cx_concat(nn,".txt"));
        if(cx_has_sealed(tpath)==1 || cx_has_sealed(ppath)==1){
            _zag_println("render: sealed guard tripped");return 3;
        }
        let tn:i64=cx_guarded_read(tpath,tbuf);
        let pn:i64=cx_guarded_read(ppath,pbuf);
        if(tn<=0 || pn<=0){_zag_println("render: cannot read input");return 4;}
        let tlen:i32=tn as i32;
        let plen:i32=pn as i32;
        // problem id + statement
        let pid:[]u8=cx_trim(cx_field(pbuf,plen,"ID: "));
        let stmt:[]u8=cx_trim(cx_field(pbuf,plen,"STATEMENT: "));
        let cid:[]u8=cx_concat("C",nn);
        // render trace
        let cpos:i32=0;
        cpos=r_emit(cbuf,cpos,cx_concat("CASE ",cx_concat(cid," FROM TRACE_P")));
        cpos=r_emit(cbuf,cpos,cx_concat(nn,".txt PROBLEM P"));
        cpos=r_emit(cbuf,cpos,cx_concat(nn,".txt\n"));
        cpos=r_emit(cbuf,cpos,"RENDERER n4-render v1 FROZEN 2026-09-25\n");
        cpos=r_emit(cbuf,cpos,cx_concat("PROBLEM_ID: ",cx_concat(pid,"\n")));
        cpos=r_emit(cbuf,cpos,"PROBLEM_NL:\n");
        cpos=r_emit(cbuf,cpos,stmt);
        cpos=r_emit(cbuf,cpos,"\nTRACE_NL:\n");
        // trace body accumulator (for cases_data.zag TRACE const)
        let trbuf:[]u8=nio_alloc(262144);
        let trpos:i32=0;
        let pos:i32=0;
        while(pos<tlen){
            let line:[]u8=cx_next_line(tbuf,&pos);
            if(line.len==0){continue;}
            if(cx_starts(line,"STEP ")==1){
                let p1:i32=r_find(line,": ");
                let p2:i32=r_find_from(line," [CITES: ",p1);
                let p3:i32=r_find_from(line,"] [RULE: ",p2);
                if(p1<0 || p2<0 || p3<0){continue;}
                let snum:[]u8=line[5..p1];
                let body:[]u8=line[p1+2..p2];
                let cites:[]u8=line[p2+9..p3];
                let p4:i32=r_find_from(line,"]",p3+9);
                if(p4<0){continue;}
                let tag:[]u8=line[p3+9..p4];
                let rendered:[]u8=r_tpl(tag,body);
                if(rendered.len==0){
                    rendered=r_tpl_spec(tag,"","","","","");
                }
                if(rendered.len==0){
                    _zag_println("render: unknown RULE tag");
                    return 4;
                }
                let rl:[]u8=cx_concat("S",snum);
                rl=cx_concat(rl," [");
                rl=cx_concat(rl,tag);
                rl=cx_concat(rl,"] CITES[");
                rl=cx_concat(rl,cites);
                rl=cx_concat(rl,"] :: ");
                rl=cx_concat(rl,rendered);
                cpos=r_emit(cbuf,cpos,rl);
                cpos=r_emit(cbuf,cpos,"\n");
                trpos=r_emit(trbuf,trpos,rl);
                trpos=r_emit(trbuf,trpos,"\n");
            }
            else {
                if(cx_starts(line,"ANSWER:")==1 || cx_starts(line,"SELF_VERDICT:")==1 || cx_starts(line,"FLAGS:")==1 || cx_starts(line,"DELIB_LEDGER_HEAD:")==1){
                    let tl:[]u8=cx_concat("TAIL ",line);
                    cpos=r_emit(cbuf,cpos,tl);
                    cpos=r_emit(cbuf,cpos,"\n");
                    trpos=r_emit(trbuf,trpos,tl);
                    trpos=r_emit(trbuf,trpos,"\n");
                }
            }
        }
        // write case file
        let cpath:[]u8=cx_concat("cases/C",cx_concat(nn,".txt"));
        let wrc:i64=dlb_write_file(cpath,cbuf[0..cpos],cpos);
        if(wrc<0){_zag_println("render: cannot write case file");return 4;}
        // append consts to cases_data.zag
        let kk:[]u8=r_two(k-1);
        zpos=r_emit(zbuf,zpos,cx_concat("const N4_CID_",cx_concat(kk,":[]u8=\"")));
        zpos=r_emit(zbuf,zpos,r_zesc(cid));
        zpos=r_emit(zbuf,zpos,"\";\n");
        zpos=r_emit(zbuf,zpos,cx_concat("const N4_CPROB_",cx_concat(kk,":[]u8=\"")));
        zpos=r_emit(zbuf,zpos,r_zesc(stmt));
        zpos=r_emit(zbuf,zpos,"\";\n");
        zpos=r_emit(zbuf,zpos,cx_concat("const N4_CTRACE_",cx_concat(kk,":[]u8=\"")));
        zpos=r_emit(zbuf,zpos,r_zesc(trbuf[0..trpos]));
        zpos=r_emit(zbuf,zpos,"\";\n");
        nio_free(trbuf);
        k=k+1;
    }
    let wz:i64=dlb_write_file("cases_data.zag",zbuf[0..zpos],zpos);
    if(wz<0){_zag_println("render: cannot write cases_data.zag");return 4;}
    _zag_println("render: 22 cases written to cases/ + cases_data.zag");
    return 0;
}

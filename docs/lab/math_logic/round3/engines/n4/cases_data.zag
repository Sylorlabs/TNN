const N4_CID_20:[]u8="C21";
const N4_CPROB_20:[]u8="A game show has three doors. Behind one door is a car; behind each of the other two is a goat. You pick one door. The host, who knows where the car is, then opens a different door from the one you picked, revealing a goat, and offers you the choice: stay with your original door, or switch to the remaining closed door. Should you switch or stay? Give the probability of winning the car if you stay and if you switch, with justification.";
const N4_CTRACE_20:[]u8="S1 [premise_load] CITES[K001, K210] :: LOAD problem=P21 domain=misc type=exact_answer premises=K001-K005, K101-K110, K201-K210.\nS2 [hypothesis_setup] CITES[STEP 1] :: HYPOTHESES WITHHELD CLAIM_TRUE CLAIM_FALSE tiebreak=lowest-index type=exact_answer.\nS3 [deliberative_evidence] CITES[STEP 2, K001] :: ROUND 1 EVIDENCE K001 scores=0,0,0.\nS4 [deliberative_test] CITES[STEP 3] :: ROUND 1 TEST ANSWER_DERIVABLE holds.\nS5 [deliberative_round] CITES[STEP 4] :: ROUND 1 SUMMARY leader=WITHHELD margin=0 conf=0.\nS6 [deliberative_evidence] CITES[STEP 5, K002] :: ROUND 2 EVIDENCE K002 scores=0,0,0.\nS7 [deliberative_test] CITES[STEP 6] :: ROUND 2 TEST ANSWER_DERIVABLE holds.\nS8 [deliberative_round] CITES[STEP 7] :: ROUND 2 SUMMARY leader=WITHHELD margin=0 conf=0.\nS9 [deliberative_evidence] CITES[STEP 8, K003] :: ROUND 3 EVIDENCE K003 scores=0,0,0.\nS10 [deliberative_test] CITES[STEP 9] :: ROUND 3 TEST ANSWER_DERIVABLE holds.\nS11 [deliberative_round] CITES[STEP 10] :: ROUND 3 SUMMARY leader=WITHHELD margin=0 conf=0.\nS12 [deliberative_evidence] CITES[STEP 11, K004] :: ROUND 4 EVIDENCE K004 scores=0,0,0.\nS13 [deliberative_test] CITES[STEP 12] :: ROUND 4 TEST ANSWER_DERIVABLE holds.\nS14 [deliberative_round] CITES[STEP 13] :: ROUND 4 SUMMARY leader=WITHHELD margin=0 conf=0.\nS15 [deliberative_evidence] CITES[STEP 14, K005] :: ROUND 5 EVIDENCE K005 scores=0,0,0.\nS16 [deliberative_test] CITES[STEP 15] :: ROUND 5 TEST ANSWER_DERIVABLE holds.\nS17 [deliberative_round] CITES[STEP 16] :: ROUND 5 SUMMARY leader=WITHHELD margin=0 conf=0.\nS18 [deliberative_evidence] CITES[STEP 17, K101] :: ROUND 6 EVIDENCE K101 scores=0,0,0.\nS19 [deliberative_test] CITES[STEP 18] :: ROUND 6 TEST ANSWER_DERIVABLE holds.\nS20 [deliberative_round] CITES[STEP 19] :: ROUND 6 SUMMARY leader=WITHHELD margin=0 conf=0.\nS21 [deliberative_evidence] CITES[STEP 20, K102] :: ROUND 7 EVIDENCE K102 scores=0,0,0.\nS22 [deliberative_test] CITES[STEP 21] :: ROUND 7 TEST ANSWER_DERIVABLE hold
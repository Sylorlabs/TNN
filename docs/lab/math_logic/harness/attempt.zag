// attempt.zag — math-logic round ATTEMPT harness (Crew B, 2026-09-24).
//
// Pure Zag. Zero RNG. Deterministic given (problem file, knowledge file).
//
// What this does:
//   1. HARD RULE: refuses to run if any input path contains "sealed"
//      (exit 3), and every file open goes through a guarded reader that
//      refuses sealed paths (defense in depth). The attempt path NEVER
//      reads problems/sealed/.
//   2. Loads ONE problem file (ID/DOMAIN/TYPE/STATEMENT fields) and the
//      frozen KNOWLEDGE_STORE.md (25 items K001-K005, K101-K110, K201-K210).
//   3. Presents premises to TNN's REAL deliberation machinery in FULL
//      CONTEXT: every one of the 25 K-items becomes one deliberation
//      evidence item. No retrieval, no ranking, no filtering.
//      The machinery driven is the H5 eliminative deliberation procedure
//      (dlb_delib.zag, imported verbatim via @import — the real code, not
//      a reimplementation): hypotheses + scored evidence -> verdict.
//   4. Emits a cited reasoning trace in the frozen prereg format:
//        STEP n: <claim> [CITES: Kxxx and/or STEP m] [RULE: <rule>]
//        ...
//        ANSWER: <final answer, or WITHHELD>
//        SELF_VERDICT: solved | partial | withheld
//      Every trace step is a faithful rendering of a REAL deliberation
//      ledger entry produced by dlb_run (per-round EVIDENCE/TEST/ROUND and
//      the final VERDICT). No step is invented; the claim text quotes the
//      ledger verbatim.
//   5. Runs the attempt 3 times in-process and asserts byte-identical
//      trace output; on mismatch it writes a DIVERGENCE finding instead
//      of a trace (exit 5).
//   6. Mechanically checks citation discipline over the emitted trace
//      (dangling citations, forward citations, circular chains, missing
//      RULE/CITES clauses) and appends a FLAGS section. It NEVER silently
//      fixes a bad trace — flags are emitted as-is.
//
// The central documented gap (see GAP.md): the deliberation machinery
// consumes SCORED evidence (support/attack weights per hypothesis), and
// nothing in the lab computes entailment scores from premises. Assigning
// nonzero weights would be the harness author smuggling judgment, so all
// weights are 0 by an explicit, documented null rule. The machinery then
// genuinely runs to completion and withholds (deterministic tie-break to
// index 0 = WITHHELD, confidence 0). The trace says exactly that.
//
// CLI: attempt <problem-txt> <knowledge-md> <trace-out>
// Exit: 0 ok | 3 sealed-path refusal | 4 io/parse error | 5 divergence.

@import("../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../deliberation_depth/harness/dlb_util.zag")
@import("../../deliberation_depth/harness/dlb_json.zag")
@import("../../deliberation_depth/harness/dlb_cfg.zag")
@import("../../deliberation_depth/harness/dlb_ledger.zag")
@import("../../deliberation_depth/harness/dlb_delib.zag")

// ---------------- sealed guard ----------------
// HARD RULE: the attempt path must never read problems/sealed/.
// Both the startup argv check and every file open go through this.
fn at_has_sealed(p:[]u8)i32 {
    if(p.len<6){return 0;}
    let i:i32=0;
    while(i+6<=p.len){
        if(p[i]==115 && p[i+1]==101 && p[i+2]==97 && p[i+3]==108 && p[i+4]==101 && p[i+5]==100){return 1;}
        i=i+1;
    }
    return 0;
}
fn at_guarded_read(p:[]u8,buf:[]u8)i64 {
    if(at_has_sealed(p)==1){return -99;}
    return dlb_read_file(p,buf);
}

// ---------------- small parse helpers ----------------
// Find "KEY: " at a line start; return the value slice (to EOL, trimmed).
// Returns an empty slice when the key is absent.
fn at_field(buf:[]u8,n:i32,key:[]u8)[]u8 {
    let empty:[]u8="";
    let i:i32=0;
    while(i<n){
        let ls:i32=1;
        if(i>0 && buf[i-1]!=10){ls=0;}
        if(ls==1){
            let k:i32=0;
            while(k<key.len && i+k<n && buf[i+k]==key[k]){k=k+1;}
            if(k==key.len){
                let s:i32=i+k;
                let e:i32=s;
                while(e<n && buf[e]!=10){e=e+1;}
                while(e>s && (buf[e-1]==13 || buf[e-1]==32 || buf[e-1]==9)){e=e-1;}
                return buf[s..e];
            }
        }
        i=i+1;
    }
    return empty;
}
// Collect K-item ids: lines starting with 'K' + 3 digits + space.
// offs/lens are []u8 arenas holding i32s via au_put32; slices view kbuf.
fn at_parse_kids(kbuf:[]u8,n:i32,offs:[]u8,lens:[]u8)i32 {
    let nk:i32=0;
    let i:i32=0;
    while(i+5<n && nk<64){
        let ls:i32=1;
        if(i>0 && kbuf[i-1]!=10){ls=0;}
        if(ls==1 && kbuf[i]==75 && kbuf[i+4]==32){
            let ok:i32=1;
            let d:i32=1;
            while(d<4){
                if(kbuf[i+d]<48 || kbuf[i+d]>57){ok=0;}
                d=d+1;
            }
            if(ok==1){
                au_put32(offs,nk,i);
                au_put32(lens,nk,4);
                nk=nk+1;
            }
        }
        i=i+1;
    }
    return nk;
}
// Extract "key":"value" (string) from one ledger line into out; returns len or -1.
fn at_jstr(line:[]u8,ln:i32,key:[]u8,out:[]u8)i32 {
    let i:i32=0;
    while(i+key.len<=ln){
        let k:i32=0;
        while(k<key.len && line[i+k]==key[k]){k=k+1;}
        if(k==key.len){
            let e:i32=i+key.len;
            let o:i32=0;
            while(e<ln && line[e]!=34 && o<out.len){out[o]=line[e];o=o+1;e=e+1;}
            return o;
        }
        i=i+1;
    }
    return -1;
}
// Extract "key":digits (integer) from one ledger line; returns value or -1.
fn at_jint(line:[]u8,ln:i32,key:[]u8)i64 {
    let i:i32=0;
    while(i+key.len<=ln){
        let k:i32=0;
        while(k<key.len && line[i+k]==key[k]){k=k+1;}
        if(k==key.len){
            let e:i32=i+key.len;
            let v:i64=0;
            let any:i32=0;
            while(e<ln && line[e]>=48 && line[e]<=57){
                v=v*10+((line[e] as i64)-48);
                any=1;
                e=e+1;
            }
            if(any==1){return v;}
            return -1;
        }
        i=i+1;
    }
    return -1;
}
fn at_dout_reset(o:*DOut)void {
    o.*.n=0;
    o.*.err=0;
    return;
}
// Emit one trace step line.
fn at_step(td:*DOut,n:i32,claim:[]u8,cites:[]u8,rule:[]u8)void {
    dout_str(td,"STEP ");
    dout_i64(td,n as i64);
    dout_str(td,": ");
    dout_str(td,claim);
    dout_str(td," [CITES: ");
    dout_str(td,cites);
    dout_str(td,"] [RULE: ");
    dout_str(td,rule);
    dout_str(td,"]");
    dout_line(td);
    return;
}
// Append '|' + name to line at cur; records offset/len. Returns new cur.
fn at_append_name(line:[]u8,cur:i32,name:[]u8,off:*i32,ln:*i32)i32 {
    line[cur]=124;
    let s:i32=cur+1;
    let i:i32=0;
    while(i<name.len){line[s+i]=name[i];i=i+1;}
    off.*=s;
    ln.*=name.len;
    return s+name.len;
}

// ---------------- deliberation item construction ----------------
// Builds the H5 Item IN MEMORY (no JSON): hypotheses are the generic
// per-TYPE template (index 0 = WITHHELD); evidence items are the 25
// K-ids in store order (full context). No support/attack links are added:
// the null-entailment rule (documented in GAP.md) — the lab has no
// entailment oracle, and authored weights would smuggle judgment.
fn at_build_item(it:*Item,line:[]u8,llen:i32,pid:[]u8,h0:[]u8,h1:[]u8,h2:[]u8,kbuf:[]u8,koffs:[]u8,klens:[]u8,nk:i32)i32 {
    let cur:i32=0;
    let i:i32=0;
    while(i<pid.len && cur<llen){line[cur]=pid[i];i=i+1;cur=cur+1;}
    it.*.line=line;
    it.*.id_off=0;
    it.*.id_len=pid.len;
    it.*.tt_off=0;
    it.*.tt_len=0;
    it.*.gt_off=0;
    it.*.gt_len=0;
    it.*.nh=0;
    it.*.ne=0;
    it.*.maxh=16;
    it.*.maxe=64;
    it.*.maxl=4;
    let off:i32=0;
    let ln:i32=0;
    cur=at_append_name(line,cur,h0,&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -1;}
    cur=at_append_name(line,cur,h1,&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -2;}
    cur=at_append_name(line,cur,h2,&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -3;}
    let k:i32=0;
    while(k<nk){
        let ko:i32=au_get32(koffs,k);
        let kl:i32=au_get32(klens,k);
        cur=at_append_name(line,cur,kbuf[ko..ko+kl],&off,&ln);
        let e:i32=dj_add_ev(it,((off as i64)<<32)|(ln as i64));
        if(e<0){return -4;}
        k=k+1;
    }
    // NOTE: no dj_add_link calls — null entailment weights (see GAP.md).
    return 0;
}

// ---------------- trace emission from the real deliberation ledger ----------------
// Walks the hash-chained ledger written by dlb_run and renders one trace
// STEP per ledger entry (GENESIS/BEGIN skipped: chain hygiene, covered by
// the ledger head hash; their facts are already in STEPs 1-2). Claims quote
// the ledger verbatim; rules name the real deliberation operations.
fn at_emit_ledger_steps(td:*DOut,lb:[]u8,step:*i32,sc:*DOut,cc:*DOut)void {
    let pos:i32=0;
    while(pos<lb.len){
        let e:i32=pos;
        while(e<lb.len && lb[e]!=10){e=e+1;}
        let ln:i32=e-pos;
        if(ln>8){
            let abuf:[]u8=nio_alloc(32);
            let dbuf:[]u8=nio_alloc(1024);
            if(abuf.len==32 && dbuf.len==1024){
                let al:i32=at_jstr(lb[pos..e],ln,"\"action\":\"",abuf);
                let r:i64=at_jint(lb[pos..e],ln,"\"round\":");
                let dl:i32=at_jstr(lb[pos..e],ln,"\"detail\":\"",dbuf);
                if(al>0 && dl>0){
                    let act:[]u8=abuf[0..al];
                    let det:[]u8=dbuf[0..dl];
                    let is_begin:i32=0;
                    if(dlb_streq(act,"GENESIS")==1){is_begin=1;}
                    if(dlb_streq(act,"BEGIN")==1){is_begin=1;}
                    if(is_begin==0){
                        step.*=step.*+1;
                        let n:i32=step.*;
                        at_dout_reset(cc);
                        at_dout_reset(sc);
                        if(dlb_streq(act,"EVIDENCE")==1){
                            // detail: e=K0xx c=N — extract the K-id for CITES
                            let ks:i32=-1;
                            let ke:i32=-1;
                            let q:i32=0;
                            while(q+2<dl){
                                if(det[q]==101 && det[q+1]==61){ks=q+2;ke=ks;while(ke<dl && det[ke]!=32){ke=ke+1;}}
                                q=q+1;
                            }
                            dout_str(cc,"Deliberation round ");
                            dout_i64(cc,r);
                            dout_str(cc,": consumed evidence ");
                            if(ks>=0 && ke>ks){dout_str(cc,det[ks..ke]);}
                            if(ks<0 || ke<=ks){dout_str(cc,det);}
                            dout_str(cc," (full premise text in context). Entailment weights: none assigned -- no entailment oracle exists in the lab; authored weights would smuggle judgment (see GAP.md). Scores unchanged at 0,0,0.");
                            dout_str(sc,"STEP ");
                            dout_i64(sc,(n-1) as i64);
                            if(ks>=0 && ke>ks){
                                dout_str(sc,", ");
                                dout_str(sc,det[ks..ke]);
                            }
                            at_step(td,n,dout_bytes(cc),dout_bytes(sc),"deliberative_evidence");
                        }
                        if(dlb_streq(act,"TEST")==1){
                            dout_str(cc,"Deliberation round ");
                            dout_i64(cc,r);
                            dout_str(cc,": refutation TEST, verbatim ledger detail: ");
                            dout_str(cc,det);
                            dout_str(sc,"STEP ");
                            dout_i64(sc,(n-1) as i64);
                            at_step(td,n,dout_bytes(cc),dout_bytes(sc),"deliberative_test");
                        }
                        if(dlb_streq(act,"ROUND")==1){
                            dout_str(cc,"Deliberation round ");
                            dout_i64(cc,r);
                            dout_str(cc," summary, verbatim ledger detail: ");
                            dout_str(cc,det);
                            dout_str(sc,"STEP ");
                            dout_i64(sc,(n-1) as i64);
                            at_step(td,n,dout_bytes(cc),dout_bytes(sc),"deliberative_round");
                        }
                        if(dlb_streq(act,"VERDICT")==1){
                            dout_str(cc,"Deliberation VERDICT, verbatim ledger detail: ");
                            dout_str(cc,det);
                            dout_str(cc,". Finding: no evidence discriminated among hypotheses -- all 25 entailment weights are 0 by the documented null rule, so no margin ever reached the elimination threshold. Leader is WITHHELD by deterministic lowest-index tie-break, confidence 0. The machinery selects among hypotheses; it does not derive entailments, so no proof steps can be emitted -- emitting any would be fabrication.");
                            dout_str(sc,"STEP ");
                            dout_i64(sc,(n-1) as i64);
                            at_step(td,n,dout_bytes(cc),dout_bytes(sc),"deliberative_verdict");
                        }
                    }
                }
            }
            nio_free(abuf);
            nio_free(dbuf);
        }
        pos=e+1;
    }
    return;
}

// ---------------- citation discipline checker ----------------
// Flags (never fixes): DANGLING_K (K-item not in store), DANGLING_STEP /
// FORWARD (STEP m with m>=n or m<1), CYCLE (circular STEP chains),
// NO_CITES (empty CITES), NO_RULE (missing RULE clause), BAD_ORDER.
// Writes one flag token per problem, comma-separated, into f; returns count.
fn at_kid_known(kbuf:[]u8,koffs:[]u8,klens:[]u8,nk:i32,tok:[]u8) i32 {
    let k:i32=0;
    while(k<nk){
        let ko:i32=au_get32(koffs,k);
        let kl:i32=au_get32(klens,k);
        if(dlb_streq(kbuf[ko..ko+kl],tok)==1){return 1;}
        k=k+1;
    }
    return 0;
}
// ---------------- citation discipline checker ----------------
fn at_check_cites(tb:[]u8,kbuf:[]u8,koffs:[]u8,klens:[]u8,nk:i32,f:*DOut)i32 {
    let nflags:i32=0;
    // pass 1: collect step numbers in order; adjacency for STEP->STEP edges
    // steps are few (<256); edges[n] stored as packed list in arenas
    let snums:[]u8=nio_alloc(256*4);
    let eoff:[]u8=nio_alloc(256*4);
    let elen:[]u8=nio_alloc(256*4);
    let epool:[]u8=nio_alloc(4096*4);
    if(snums.len==0){return -99;}
    let nsteps:i32=0;
    let ecur:i32=0;
    let pos:i32=0;
    while(pos<tb.len){
        let e:i32=pos;
        while(e<tb.len && tb[e]!=10){e=e+1;}
        let ln:i32=e-pos;
        let is_step:i32=0;
        if(ln>6 && tb[pos]==83 && tb[pos+1]==84 && tb[pos+2]==69 && tb[pos+3]==80 && tb[pos+4]==32){is_step=1;}
        if(is_step==1){
            // step number
            let sn:i32=0;
            let q:i32=pos+5;
            while(q<e && tb[q]>=48 && tb[q]<=57){sn=sn*10+((tb[q] as i32)-48);q=q+1;}
            au_put32(snums,nsteps,sn);
            au_put32(eoff,nsteps,ecur);
            let ec0:i32=ecur;
            // locate [CITES: ...]
            let cs:i32=-1;
            let ce:i32=-1;
            let r:i32=pos;
            while(r+8<e){
                if(tb[r]==91 && tb[r+1]==67 && tb[r+2]==73 && tb[r+3]==84 && tb[r+4]==69 && tb[r+5]==83 && tb[r+6]==58){cs=r+7;}
                r=r+1;
            }
            if(cs>=0){
                ce=cs;
                while(ce<e && tb[ce]!=93){ce=ce+1;}
                // tokenize by ','
                let t0:i32=cs;
                let t:i32=cs;
                while(t<=ce){
                    let tend:i32=0;
                    if(t==ce){tend=1;}
                    if(t<ce && tb[t]==44){tend=1;}
                    if(tend==1){
                        let a:i32=t0;
                        let b:i32=t;
                        while(a<b && (tb[a]==32 || tb[a]==9)){a=a+1;}
                        while(b>a && (tb[b-1]==32 || tb[b-1]==9)){b=b-1;}
                        if(b-a>=6 && tb[a]==83 && tb[a+1]==84 && tb[a+2]==69 && tb[a+3]==80 && tb[a+4]==32){
                            // STEP m token
                            let m:i32=0;
                            let u:i32=a+5;
                            let any:i32=0;
                            while(u<b && tb[u]>=48 && tb[u]<=57){m=m*10+((tb[u] as i32)-48);any=1;u=u+1;}
                            if(any==0){m=-1;}
                            if(m>=sn || m<1){
                                if(nflags>0){dout_str(f,", ");}
                                dout_str(f,"FORWARD:STEP ");
                                dout_i64(f,m as i64);
                                dout_str(f,"@STEP ");
                                dout_i64(f,sn as i64);
                                nflags=nflags+1;
                            }
                            if(ecur<4096){au_put32(epool,ecur,m);ecur=ecur+1;}
                        }
                        if(b-a>=2 && tb[a]==75){
                            // K-token
                            if(at_kid_known(kbuf,koffs,klens,nk,tb[a..b])==0){
                                if(nflags>0){dout_str(f,", ");}
                                dout_str(f,"DANGLING_K:");
                                dout_str(f,tb[a..b]);
                                dout_str(f,"@STEP ");
                                dout_i64(f,sn as i64);
                                nflags=nflags+1;
                            }
                        }
                        t0=t+1;
                    }
                    t=t+1;
                }
            }
            if(cs<0){
                if(nflags>0){dout_str(f,", ");}
                dout_str(f,"NO_CITES@STEP ");
                dout_i64(f,sn as i64);
                nflags=nflags+1;
            }
            au_put32(elen,nsteps,ecur-ec0);
            // RULE clause presence
            let has_rule:i32=0;
            let r2:i32=pos;
            while(r2+6<e){
                if(tb[r2]==91 && tb[r2+1]==82 && tb[r2+2]==85 && tb[r2+3]==76 && tb[r2+4]==69 && tb[r2+5]==58){has_rule=1;}
                r2=r2+1;
            }
            if(has_rule==0){
                if(nflags>0){dout_str(f,", ");}
                dout_str(f,"NO_RULE@STEP ");
                dout_i64(f,sn as i64);
                nflags=nflags+1;
            }
            // order check: steps must be 1,2,3,...
            if(sn!=nsteps+1){
                if(nflags>0){dout_str(f,", ");}
                dout_str(f,"BAD_ORDER@position ");
                dout_i64(f,(nsteps+1) as i64);
                nflags=nflags+1;
            }
            nsteps=nsteps+1;
        }
        pos=e+1;
    }
    // pass 2: cycle detection over STEP->STEP edges (iterative DFS)
    let color:[]u8=nio_alloc(256);
    let stack:[]u8=nio_alloc(256*4);
    let s2:[]u8=nio_alloc(256*4);
    if(color.len==256 && stack.len>0){
        let v:i32=0;
        while(v<nsteps){
            if(color[v]==0){
                // iterative DFS from v
                let sp:i32=0;
                au_put32(stack,sp,v);au_put32(s2,sp,0);sp=sp+1;
                color[v]=1;
                let found:i32=0;
                while(sp>0 && found==0){
                    let x:i32=au_get32(stack,sp-1);
                    let xi:i32=au_get32(s2,sp-1);
                    let eo:i32=au_get32(eoff,x);
                    let el:i32=au_get32(elen,x);
                    if(xi<el){
                        au_put32(s2,sp-1,xi+1);
                        let mv:i32=au_get32(epool,eo+xi);
                        // map cited step number -> index (steps are 1..nsteps)
                        let y:i32=mv-1;
                        if(y>=0 && y<nsteps){
                            if(color[y]==1){found=1;}
                            if(color[y]==0){color[y]=1;au_put32(stack,sp,y);au_put32(s2,sp,0);sp=sp+1;}
                        }
                    }
                    if(xi>=el){color[x]=2;sp=sp-1;}
                }
                if(found==1){
                    if(nflags>0){dout_str(f,", ");}
                    dout_str(f,"CYCLE involving STEP ");
                    dout_i64(f,au_get32(snums,v) as i64);
                    nflags=nflags+1;
                }
            }
            v=v+1;
        }
    }
    nio_free(snums);nio_free(eoff);nio_free(elen);nio_free(epool);
    nio_free(color);nio_free(stack);nio_free(s2);
    return nflags;
}

// ---------------- one attempt ----------------
fn at_attempt(td:*DOut,pid:[]u8,pdom:[]u8,ptyp:[]u8,kbuf:[]u8,koffs:[]u8,klens:[]u8,nk:i32)i32 {
    // STEP 1: sealed guard + premise presentation (full context)
    let cc:[]u8=nio_alloc(4096);
    let sc:[]u8=nio_alloc(256);
    if(cc.len==0 || sc.len==0){return -1;}
    let c1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let s1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&c1,4096)!=0 || dout_init(&s1,256)!=0){return -1;}
    dout_str(&c1,"Sealed-guard passed: no input path contains 'sealed'; all file opens go through the guarded reader which refuses sealed paths. Loaded problem ");
    dout_str(&c1,pid);
    dout_str(&c1," DOMAIN=");
    dout_str(&c1,pdom);
    dout_str(&c1," TYPE=");
    dout_str(&c1,ptyp);
    dout_str(&c1,". Premises presented in FULL CONTEXT (no retrieval, no ranking): all ");
    dout_i64(&c1,nk as i64);
    dout_str(&c1," knowledge-store items K001-K005, K101-K110, K201-K210, each as one deliberation evidence item with its full text in context.");
    dout_str(&s1,"K001, K210");
    at_step(td,1,dout_bytes(&c1),dout_bytes(&s1),"premise_load");
    // STEP 2: hypothesis setup (generic per-TYPE template)
    at_dout_reset(&c1);
    at_dout_reset(&s1);
    let h0:[]u8="WITHHELD";
    let h1:[]u8="CLAIM_TRUE";
    let h2:[]u8="CLAIM_FALSE";
    if(dlb_streq(ptyp,"exact_answer")==1){h1="ANSWER_DERIVABLE";h2="NO_DERIVABLE_ANSWER";}
    if(dlb_streq(ptyp,"find_error")==1){h1="ERROR_IDENTIFIABLE";h2="NO_ERROR";}
    if(dlb_streq(ptyp,"open_or_impossible")==1){h1="RESOLVABLE";h2="NOT_RESOLVABLE";}
    dout_str(&c1,"Hypothesis setup for TYPE=");
    dout_str(&c1,ptyp);
    dout_str(&c1," using the generic template (no problem-specific content): H0=WITHHELD H1=");
    dout_str(&c1,h1);
    dout_str(&c1," H2=");
    dout_str(&c1,h2);
    dout_str(&c1,". Index 0 is WITHHELD, so the deterministic lowest-index tie-break withholds when no evidence discriminates.");
    dout_str(&s1,"STEP 1");
    at_step(td,2,dout_bytes(&c1),dout_bytes(&s1),"hypothesis_setup");
    // Build the deliberation item in memory (real H5 Item, no JSON)
    let line:[]u8=nio_alloc(4096);
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    let it_ok:i32=0;
    if(line.len==4096){it_ok=1;}
    if(it_ok==1){
        let p_it:*Item=&it;
        p_it.*.hid=nio_alloc(16*8);
        p_it.*.eid=nio_alloc(64*8);
        p_it.*.evns=nio_alloc(64*4);
        p_it.*.evna=nio_alloc(64*4);
        p_it.*.sup=nio_alloc(64*4*8);
        p_it.*.att=nio_alloc(64*4*8);
        if(p_it.*.hid.len==0){it_ok=0;}
    }
    if(it_ok==0){dout_free(&c1);dout_free(&s1);nio_free(cc);nio_free(sc);nio_free(line);return -2;}
    let brc:i32=at_build_item(&it,line,4096,pid,h0,h1,h2,kbuf,koffs,klens,nk);
    if(brc!=0){dout_free(&c1);dout_free(&s1);nio_free(cc);nio_free(sc);nio_free(line);return -3;}
    // Deliberation state + config + hash-chained ledger (all deterministic)
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:42};
    let p_st:*DSt=&st;
    p_st.*.scores=nio_alloc(16*8);
    p_st.*.alive=nio_alloc(16);
    p_st.*.hist_l=nio_alloc(42*4);
    p_st.*.hist_m=nio_alloc(42*8);
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:40,.deep_rounds:40,.amin:1,.amax:40,.conf_thr:1000,.stab_win:3,.eps:1,.elim_margin:250,.refute_thr:500,.evcap:64};
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let ok:i32=1;
    if(p_st.*.scores.len==0){ok=0;}
    if(dout_init(&lgo,1048576)!=0){ok=0;}
    if(lg_init(&lg)!=0){ok=0;}
    if(ok==0){dout_free(&c1);dout_free(&s1);nio_free(cc);nio_free(sc);nio_free(line);return -4;}
    let rc:i32=lg_step(&lg,&lgo,pid,0,"GENESIS","math-logic attempt");
    if(rc!=0){ok=0;}
    // THE REAL DELIBERATION: H5 eliminative procedure on the real Item.
    if(ok==1){rc=dlb_run(&st,&it,&cfg,&lg,&lgo);}
    if(ok==0 || rc!=0){
        at_dout_reset(&c1);
        at_dout_reset(&s1);
        dout_str(&c1,"Internal deliberation error rc=");
        dout_i64(&c1,rc as i64);
        dout_str(&c1,"; no verdict produced.");
        dout_str(&s1,"STEP 2");
        at_step(td,3,dout_bytes(&c1),dout_bytes(&s1),"internal_error");
    }
    if(ok==1 && rc==0){
        let step:i32=2;
        // Render one trace STEP per real deliberation ledger entry.
        // (dout_bytes passed directly as an argument: no let-bound slice alias.)
        at_emit_ledger_steps(td,dout_bytes(&lgo),&step,&s1,&c1);
    }
    // ANSWER + SELF_VERDICT + FLAGS + ledger head
    dout_str(td,"ANSWER: WITHHELD");
    dout_line(td);
    dout_str(td,"SELF_VERDICT: withheld");
    dout_line(td);
    let fl:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&fl,4096)==0){
        let nf:i32=at_check_cites(dout_bytes(td),kbuf,koffs,klens,nk,&fl);
        dout_str(td,"FLAGS: ");
        if(nf==0){dout_str(td,"none");}
        if(nf!=0){dout_str(td,dout_bytes(&fl));}
        dout_line(td);
        dout_free(&fl);
    }
    dout_str(td,"DELIB_LEDGER_HEAD: ");
    dout_str(td,lg_head_hex(&lg));
    dout_line(td);
    // free per-attempt state
    let p_it2:*Item=&it;
    nio_free(p_it2.*.hid);nio_free(p_it2.*.eid);nio_free(p_it2.*.evns);nio_free(p_it2.*.evna);
    nio_free(p_it2.*.sup);nio_free(p_it2.*.att);
    nio_free(p_st.*.scores);nio_free(p_st.*.alive);nio_free(p_st.*.hist_l);nio_free(p_st.*.hist_m);
    dout_free(&lgo);
    lg_free(&lg);
    dout_free(&c1);dout_free(&s1);
    nio_free(cc);nio_free(sc);nio_free(line);
    return 0;
}

// ---------------- main ----------------
fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: attempt <problem-txt> <knowledge-md> <trace-out>");
        return 64;
    }
    // NOTE: _zag_arg returns a non-owned slice; never free it (AGENTS.md).
    let ppath:[]u8=_zag_arg(1);
    let kpath:[]u8=_zag_arg(2);
    let opath:[]u8=_zag_arg(3);
    if(ppath.len==0 || kpath.len==0 || opath.len==0){
        _zag_println("attempt: empty argument");
        return 64;
    }
    // HARD RULE: refuse if any sealed path is among the inputs.
    if(at_has_sealed(ppath)==1 || at_has_sealed(kpath)==1 || at_has_sealed(opath)==1){
        _zag_println("REFUSED: a sealed path is among the inputs; the attempt path never reads problems/sealed/");
        return 3;
    }
    let pbuf:[]u8=nio_alloc(65536);
    let kbuf:[]u8=nio_alloc(262144);
    if(pbuf.len==0 || kbuf.len==0){return 4;}
    let pn:i64=at_guarded_read(ppath,pbuf);
    if(pn<0){
        _zag_println("attempt: cannot read problem file (or sealed guard tripped)");
        return 4;
    }
    let kn:i64=at_guarded_read(kpath,kbuf);
    if(kn<0){
        _zag_println("attempt: cannot read knowledge file (or sealed guard tripped)");
        return 4;
    }
    let pid:[]u8=at_field(pbuf,pn as i32,"ID: ");
    let pdom:[]u8=at_field(pbuf,pn as i32,"DOMAIN: ");
    let ptyp:[]u8=at_field(pbuf,pn as i32,"TYPE: ");
    if(pid.len==0 || ptyp.len==0){
        _zag_println("attempt: problem file missing ID/TYPE fields");
        return 4;
    }
    let koffs:[]u8=nio_alloc(64*4);
    let klens:[]u8=nio_alloc(64*4);
    if(koffs.len==0){return 4;}
    let nk:i32=at_parse_kids(kbuf,kn as i32,koffs,klens);
    if(nk!=25){
        _zag_println("attempt: knowledge store does not contain exactly 25 K-items");
        return 4;
    }
    // 3x in-process rerun; assert byte-identical or report DIVERGENCE.
    let t1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t3:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&t1,131072)!=0 || dout_init(&t2,131072)!=0 || dout_init(&t3,131072)!=0){return 4;}
    let r1:i32=at_attempt(&t1,pid,pdom,ptyp,kbuf,koffs,klens,nk);
    let r2:i32=at_attempt(&t2,pid,pdom,ptyp,kbuf,koffs,klens,nk);
    let r3:i32=at_attempt(&t3,pid,pdom,ptyp,kbuf,koffs,klens,nk);
    let div:i32=0;
    if(r1!=0 || r2!=0 || r3!=0){div=2;}
    if(div==0 && nio_equal(dout_bytes(&t1),dout_bytes(&t2))==0){div=1;}
    if(div==0 && nio_equal(dout_bytes(&t2),dout_bytes(&t3))==0){div=1;}
    let wrc:i64=0;
    if(div==0){
        wrc=dlb_write_file(opath,dout_bytes(&t1),t1.n);
    }
    if(div!=0){
        let rep:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&rep,4096)==0){
            dout_str(&rep,"DIVERGENCE: the 3 attempts of ");
            dout_str(&rep,pid);
            dout_str(&rep," were NOT byte-identical (r1=");
            dout_i64(&rep,r1 as i64);
            dout_str(&rep," r2=");
            dout_i64(&rep,r2 as i64);
            dout_str(&rep," r3=");
            dout_i64(&rep,r3 as i64);
            dout_str(&rep,").");
            dout_line(&rep);
            dout_str(&rep,"SELF_VERDICT: withheld");
            dout_line(&rep);
            wrc=dlb_write_file(opath,dout_bytes(&rep),rep.n);
            dout_free(&rep);
        }
    }
    dout_free(&t1);dout_free(&t2);dout_free(&t3);
    nio_free(pbuf);nio_free(kbuf);nio_free(koffs);nio_free(klens);
    if(wrc<0){return 4;}
    if(div==1){return 5;}
    if(div==2){return 4;}
    return 0;
}

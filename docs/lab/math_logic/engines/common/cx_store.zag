// cx_store.zag — claim memory: canonical bytes + audit trail + depth.
// Structural contradiction rule: adding F while not(F) present (or vice
// versa) derives `false` with a CONTRA audit entry.
// kinds: 0 = premise/store (usable), 1 = derived (usable),
//        2 = subproof-local (kept for audit, NOT usable as a premise).
// Pure Zag, zero RNG, deterministic.

struct CXS {
    n:i32, cap:i32,
    data:[]u8, dn:i32, dcap:i32,
    coff:[]u8, clen:[]u8,
    aoff:[]u8, alen:[]u8,
    dep:[]u8, kind:[]u8,
    deriv:i32
}

fn cxs_init(s:*CXS,cap:i32,dcap:i32)i32 {
    let data:[]u8=nio_alloc(dcap);
    if(data.len!=dcap){return -1;}
    let co:[]u8=nio_alloc(cap*4);if(co.len!=cap*4){nio_free(data);return -1;}
    let cl:[]u8=nio_alloc(cap*4);if(cl.len!=cap*4){nio_free(data);nio_free(co);return -1;}
    let ao:[]u8=nio_alloc(cap*4);if(ao.len!=cap*4){nio_free(data);nio_free(co);nio_free(cl);return -1;}
    let al:[]u8=nio_alloc(cap*4);if(al.len!=cap*4){nio_free(data);nio_free(co);nio_free(cl);nio_free(ao);return -1;}
    let dp:[]u8=nio_alloc(cap*4);if(dp.len!=cap*4){nio_free(data);nio_free(co);nio_free(cl);nio_free(ao);nio_free(al);return -1;}
    let kd:[]u8=nio_alloc(cap*4);if(kd.len!=cap*4){nio_free(data);nio_free(co);nio_free(cl);nio_free(ao);nio_free(al);nio_free(dp);return -1;}
    s.*.n=0;s.*.cap=cap;
    s.*.data=data;s.*.dn=0;s.*.dcap=dcap;
    s.*.coff=co;s.*.clen=cl;s.*.aoff=ao;s.*.alen=al;
    s.*.dep=dp;s.*.kind=kd;s.*.deriv=0;
    return 0;
}
fn cxs_bytes(s:*CXS,i:i32)[]u8 {
    let d:[]u8=s.*.data;
    let o:i32=au_get32(s.*.coff,i);let l:i32=au_get32(s.*.clen,i);
    return d[o..o+l];
}
fn cxs_audit(s:*CXS,i:i32)[]u8 {
    let d:[]u8=s.*.data;
    let o:i32=au_get32(s.*.aoff,i);let l:i32=au_get32(s.*.alen,i);
    return d[o..o+l];
}
fn cxs_find(s:*CXS,bytes:[]u8)i32 {
    let i:i32=0;
    while(i<s.*.n){
        if(nio_equal(cxs_bytes(s,i),bytes)==1){return i;}
        i=i+1;
    }
    return -1;
}
// usable as a derivation premise (kind 0/1; kind 2 only inside a subproof)
fn cxs_usable(s:*CXS,i:i32)i32 {
    let k:i32=au_get32(s.*.kind,i);
    if(k==0 || k==1){return 1;}
    return 0;
}
fn cxs_ok(s:*CXS,i:i32,sub:i32)i32 {
    let k:i32=au_get32(s.*.kind,i);
    if(k==0 || k==1){return 1;}
    if(sub==1 && k==2){return 1;}
    return 0;
}
fn cxs_put(s:*CXS,bytes:[]u8,audit:[]u8,depth:i32,kind:i32)i32 {
    if(s.*.n>=s.*.cap){return -9;}
    if(s.*.dn+bytes.len+audit.len>s.*.dcap){return -9;}
    let d:[]u8=s.*.data;
    let bo:i32=s.*.dn;let j:i32=0;
    while(j<bytes.len){d[bo+j]=bytes[j];j=j+1;}
    s.*.dn=bo+bytes.len;
    let ao:i32=s.*.dn;j=0;
    while(j<audit.len){d[ao+j]=audit[j];j=j+1;}
    s.*.dn=ao+audit.len;
    let i:i32=s.*.n;s.*.n=i+1;
    au_put32(s.*.coff,i,bo);au_put32(s.*.clen,i,bytes.len);
    au_put32(s.*.aoff,i,ao);au_put32(s.*.alen,i,audit.len);
    au_put32(s.*.dep,i,depth);au_put32(s.*.kind,i,kind);
    return i;
}
// add a claim; dedups on byte equality. Runs the structural contradiction
// rule. Returns claim idx, or -9 on overflow.
fn cxs_add(s:*CXS,bytes:[]u8,audit:[]u8,depth:i32,kind:i32)i32 {
    let e:i32=cxs_find(s,bytes);
    if(e>=0){return e;}
    let idx:i32=cxs_put(s,bytes,audit,depth,kind);
    if(idx<0){return idx;}
    if(kind>=1){s.*.deriv=s.*.deriv+1;}
    // contradiction rule: F + not(F) -> false
    if(cx_starts(bytes,"not(")==1 && bytes[bytes.len-1]==41){
        let inner:[]u8=bytes[4..bytes.len-1];
        let fi:i32=cxs_find(s,inner);
        if(fi>=0){
            let ca:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ca,256)==0){
                dout_str(&ca,"CONTRA C");dout_i64(&ca,fi as i64);
                dout_str(&ca," C");dout_i64(&ca,idx as i64);
                let dd:i32=au_get32(s.*.dep,fi);
                let dd2:i32=au_get32(s.*.dep,idx);
                if(dd2>dd){dd=dd2;}
                let a2:[]u8=cx_copy(dout_bytes(&ca));
                dout_free(&ca);
                if(cxs_find(s,"false")<0){
                    let pi:i32=cxs_put(s,"false",a2,dd+1,1);
                    if(pi>=0){s.*.deriv=s.*.deriv+1;}
                }
                nio_free(a2);
            }
        }
    } else {
        let nb:[]u8=cx_concat("not(",bytes);
        let nb2:[]u8=cx_concat(nb,")");
        nio_free(nb);
        let fi:i32=cxs_find(s,nb2);
        nio_free(nb2);
        if(fi>=0){
            let ca:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ca,256)==0){
                dout_str(&ca,"CONTRA C");dout_i64(&ca,idx as i64);
                dout_str(&ca," C");dout_i64(&ca,fi as i64);
                let dd:i32=au_get32(s.*.dep,idx);
                let dd2:i32=au_get32(s.*.dep,fi);
                if(dd2>dd){dd=dd2;}
                let a2:[]u8=cx_copy(dout_bytes(&ca));
                dout_free(&ca);
                if(cxs_find(s,"false")<0){
                    let pi:i32=cxs_put(s,"false",a2,dd+1,1);
                    if(pi>=0){s.*.deriv=s.*.deriv+1;}
                }
                nio_free(a2);
            }
        }
    }
    return idx;
}
// truncate back to n0 claims / dn0 data bytes (subproof discharge)
fn cxs_trunc(s:*CXS,n0:i32,dn0:i32)void {
    s.*.n=n0;s.*.dn=dn0;
}

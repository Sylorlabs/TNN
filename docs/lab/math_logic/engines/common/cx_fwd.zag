// cx_fwd.zag — shared forward-derivation core (S_MP/S_UI/S_PBC, BFS).
// Used by ONE (verbatim) and DUAL (D forward sweep + subproofs).
// Schemas: committed ceremony; match-and-bind only; no numeric evidence.
// one.zag — ONE ENGINE: one core operation (match-and-bind), deterministic
// BFS by depth. Creates new claims; referees by attempting to derive NOT-H.
// Usage: one_bin <problem.form> <out_path>   (run with CWD = math_logic dir)
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../../../deliberation_depth/harness/dlb_util.zag")
@import("../common/cx_str.zag")
@import("../common/cx_claim.zag")
@import("../common/cx_match.zag")
@import("../common/cx_store.zag")
@import("../common/cx_schemas.zag")
@import("../common/cx_io.zag")

struct ONEP {
    a_mp1:CXA, r_mp1:i32,
    a_mp2:CXA, r_mp2:i32,
    a_pb:CXA, r_pb:i32,
    a_ui:CXA, r_ui:i32
}
fn onep_init(p:*ONEP)i32 {
    if(cxa_init(&p.*.a_mp1,"?0",64)!=0){return -1;}
    p.*.r_mp1=cx_parse(&p.*.a_mp1,"?0");
    if(cxa_init(&p.*.a_mp2,"imp(?0,?1)",64)!=0){return -1;}
    p.*.r_mp2=cx_parse(&p.*.a_mp2,"imp(?0,?1)");
    if(cxa_init(&p.*.a_pb,"imp(not(?0),false)",64)!=0){return -1;}
    p.*.r_pb=cx_parse(&p.*.a_pb,"imp(not(?0),false)");
    if(cxa_init(&p.*.a_ui,"forall(?0,?1)",64)!=0){return -1;}
    p.*.r_ui=cx_parse(&p.*.a_ui,"forall(?0,?1)");
    if(p.*.r_mp1<0 || p.*.r_mp2<0 || p.*.r_pb<0 || p.*.r_ui<0){return -1;}
    return 0;
}
// parse one claim's bytes into a temp arena; returns 1 and sets *r.
// caller must nio_free(a.buf).
fn one_parse_tmp(bytes:[]u8,a:*CXA,r:*i32)i32 {
    if(cxa_init(a,bytes,256)!=0){return 0;}
    let rr:i32=cx_parse(a,bytes);
    if(rr<0){nio_free(a.*.buf);return 0;}
    r.*=rr;
    return 1;
}

// S_MP: for every usable imp-claim (A2 match), every usable claim equal to
// the bound ?0 (A1) yields the bound ?1.
fn one_mp(s:*CXS,p:*ONEP,sub:i32)i32 {
    let n0:i32=s.*.n;
    let bb:CXB=CXB{.cap:0,.set:"",.off:"",.len:""};
    if(cxb_init(&bb,16)!=0){return -1;}
    let cap:i32=2048;
    let ji:[]u8=nio_alloc(cap*4);if(ji.len!=cap*4){return -1;}
    let o0:[]u8=nio_alloc(cap*4);if(o0.len!=cap*4){nio_free(ji);return -1;}
    let l0:[]u8=nio_alloc(cap*4);if(l0.len!=cap*4){nio_free(ji);nio_free(o0);return -1;}
    let o1:[]u8=nio_alloc(cap*4);if(o1.len!=cap*4){nio_free(ji);nio_free(o0);nio_free(l0);return -1;}
    let l1:[]u8=nio_alloc(cap*4);if(l1.len!=cap*4){nio_free(ji);nio_free(o0);nio_free(l0);nio_free(o1);return -1;}
    let nimp:i32=0;
    let j:i32=0;
    while(j<s.*.n){
        if(cxs_ok(s,j,sub)==1){
            let jb:[]u8=cxs_bytes(s,j);
            let ja:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jr:i32=0;
            if(one_parse_tmp(jb,&ja,&jr)==1){
                if(cxk(&ja,jr)==4){
                    cxb_clear(&bb);
                    if(cx_match(&p.*.a_mp2,p.*.r_mp2,jb,&ja,jr,&bb)==1){
                        if(nimp<cap){
                            au_put32(ji,nimp,j);
                            au_put32(o0,nimp,cxb_off(&bb,0));
                            au_put32(l0,nimp,cxb_vlen(&bb,0));
                            au_put32(o1,nimp,cxb_off(&bb,1));
                            au_put32(l1,nimp,cxb_vlen(&bb,1));
                            nimp=nimp+1;
                        }
                    }
                }
                nio_free(ja.buf);
            }
        }
        j=j+1;
    }
    let m:i32=0;
    while(m<nimp){
        let jj:i32=au_get32(ji,m);
        let jb:[]u8=cxs_bytes(s,jj);
        let q0:[]u8=jb[au_get32(o0,m)..au_get32(o0,m)+au_get32(l0,m)];
        let q1:[]u8=jb[au_get32(o1,m)..au_get32(o1,m)+au_get32(l1,m)];
        let i:i32=0;
        while(i<s.*.n){
            if(cxs_ok(s,i,sub)==1 && nio_equal(cxs_bytes(s,i),q0)==1){
                let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                if(dout_init(&ao,512)==0){
                    dout_str(&ao,"S_MP C");dout_i64(&ao,i as i64);
                    dout_str(&ao," C");dout_i64(&ao,jj as i64);
                    dout_str(&ao," ?0:=");dout_str(&ao,q0);
                    dout_str(&ao," ?1:=");dout_str(&ao,q1);
                    let nb:[]u8=cx_copy(q1);
                    let ab:[]u8=cx_copy(dout_bytes(&ao));
                    dout_free(&ao);
                    let di:i32=au_get32(s.*.dep,i);
                    let dj:i32=au_get32(s.*.dep,jj);
                    let dd:i32=di;if(dj>dd){dd=dj;}
                    cxs_add(s,nb,ab,dd+1,1);
                    nio_free(nb);nio_free(ab);
                }
            }
            i=i+1;
        }
        m=m+1;
    }
    nio_free(ji);nio_free(o0);nio_free(l0);nio_free(o1);nio_free(l1);
    cxb_free(&bb);
    return s.*.n-n0;
}

// S_UI: every usable forall-claim instantiated with every term of the
// level-fixed universe.
fn one_ui(s:*CXS,p:*ONEP,sub:i32)i32 {
    let n0:i32=s.*.n;
    let tcap:i32=4096;
    let toff:[]u8=nio_alloc(tcap*4);if(toff.len!=tcap*4){return -1;}
    let tlen:[]u8=nio_alloc(tcap*4);if(tlen.len!=tcap*4){nio_free(toff);return -1;}
    let nu:i32=cx_universe(s,toff,tlen,tcap,sub);
    if(nu<0){nio_free(toff);nio_free(tlen);return -1;}
    let data:[]u8=s.*.data;
    let j:i32=0;
    while(j<n0){
        if(cxs_ok(s,j,sub)==1){
            let jb:[]u8=cxs_bytes(s,j);
            let ja:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jr:i32=0;
            if(one_parse_tmp(jb,&ja,&jr)==1){
                if(cxk(&ja,jr)==7){
                    let bv:[]u8=cx_bvar(&ja,jr);
                    let bd:i32=cxch(&ja,jr);
                    let t:i32=0;
                    while(t<nu){
                        let to:i32=au_get32(toff,t);let tl:i32=au_get32(tlen,t);
                        let ts:[]u8=data[to..to+tl];
                        if(nio_equal(ts,bv)==0){
                            let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                            if(dout_init(&o,1024)==0){
                                cx_subst(&ja,bd,bv,ts,&o);
                                let nb:[]u8=cx_copy(dout_bytes(&o));
                                dout_free(&o);
                                let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                                if(dout_init(&ao,512)==0){
                                    dout_str(&ao,"S_UI C");dout_i64(&ao,j as i64);
                                    dout_str(&ao," ?0:=");dout_str(&ao,bv);
                                    dout_str(&ao," ?2:=");dout_str(&ao,ts);
                                    let ab:[]u8=cx_copy(dout_bytes(&ao));
                                    dout_free(&ao);
                                    let dd:i32=au_get32(s.*.dep,j);
                                    cxs_add(s,nb,ab,dd+1,1);
                                    nio_free(nb);nio_free(ab);
                                }
                            }
                        }
                        t=t+1;
                    }
                }
                nio_free(ja.buf);
            }
        }
        j=j+1;
    }
    nio_free(toff);nio_free(tlen);
    return s.*.n-n0;
}

// S_PBC direct: a memory claim matching imp(not(?0),false) yields ?0.
fn one_pbc_direct(s:*CXS,p:*ONEP,sub:i32)i32 {
    let n0:i32=s.*.n;
    let bb:CXB=CXB{.cap:0,.set:"",.off:"",.len:""};
    if(cxb_init(&bb,16)!=0){return -1;}
    let j:i32=0;
    while(j<n0){
        if(cxs_ok(s,j,sub)==1){
            let jb:[]u8=cxs_bytes(s,j);
            let ja:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jr:i32=0;
            if(one_parse_tmp(jb,&ja,&jr)==1){
                cxb_clear(&bb);
                if(cx_match(&p.*.a_pb,p.*.r_pb,jb,&ja,jr,&bb)==1){
                    let q0:[]u8=cxb_slice(&bb,0,jb);
                    let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
                    if(dout_init(&ao,512)==0){
                        dout_str(&ao,"S_PBC_DIR C");dout_i64(&ao,j as i64);
                        dout_str(&ao," ?0:=");dout_str(&ao,q0);
                        let nb:[]u8=cx_copy(q0);
                        let ab:[]u8=cx_copy(dout_bytes(&ao));
                        dout_free(&ao);
                        let dd:i32=au_get32(s.*.dep,j);
                        cxs_add(s,nb,ab,dd+1,1);
                        nio_free(nb);nio_free(ab);
                    }
                }
                nio_free(ja.buf);
            }
        }
        j=j+1;
    }
    cxb_free(&bb);
    return s.*.n-n0;
}

fn one_bfs(s:*CXS,p:*ONEP,bound:i32,sub:i32,goal:[]u8,has_goal:i32)i32 {
    if(has_goal==1 && cxs_find(s,goal)>=0){return 1;}
    let lv:i32=0;
    while(lv<bound){
        let n0:i32=s.*.n;
        one_mp(s,p,sub);
        one_ui(s,p,sub);
        one_pbc_direct(s,p,sub);
        if(has_goal==1 && cxs_find(s,goal)>=0){return 1;}
        if(s.*.n==n0){return 0;}
        lv=lv+1;
    }
    if(has_goal==1 && cxs_find(s,goal)>=0){return 1;}
    return 0;
}

// PBC subproof: assume not(target), forward-BFS (no nested subproofs) for
// `false`. On success the subproof trace is captured into proof and the
// assumption is discharged (truncated). Returns 1/0/-1(error).
fn one_pbc_for(s:*CXS,p:*ONEP,target:[]u8,bound:i32,proof:*DOut) i32 {
    let nb:[]u8=cx_concat("not(",target);
    let nb2:[]u8=cx_concat(nb,")");
    nio_free(nb);
    if(nb2.len==0){return -1;}
    let n0:i32=s.*.n;let dn0:i32=s.*.dn;
    let aa:[]u8=cx_copy("ASSUME not(T) for PBC");
    cxs_add(s,nb2,aa,0,2);
    nio_free(nb2);nio_free(aa);
    let f:i32=one_bfs(s,p,bound,1,"false",1);
    if(f==1){
        dout_str(proof,"SUBPROOF ASSUME not(T); derived false in ");
        dout_i64(proof,(s.*.n-n0) as i64);
        dout_str(proof," steps:");
        dout_line(proof);
        let i:i32=n0;
        while(i<s.*.n){
            dout_str(proof,"  SC");dout_i64(proof,(i-n0) as i64);
            dout_str(proof,": ");dout_str(proof,cxs_bytes(s,i));
            dout_str(proof," [");dout_str(proof,cxs_audit(s,i));dout_str(proof,"]");
            dout_line(proof);
            i=i+1;
        }
        cxs_trunc(s,n0,dn0);
        return 1;
    }
    cxs_trunc(s,n0,dn0);
    return 0;
}

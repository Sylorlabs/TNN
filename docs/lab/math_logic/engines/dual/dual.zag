// dual.zag — DUAL ENGINE: D (deriver) + R (referee, real H5 deliberation).
// D: forward chains (bound 3) + backward chains on R directive (bound 8).
//    D->R: candidate/refutation claims with complete chains (depths from store).
//    R->D: bounded `derive NOT-H to depth N` directives, lowest-confidence-first.
// R: real H5 via verbatim dlb_delib.zag. R owns WITHHELD (H0, index 0, wins ties).
//    Frozen rubric: W(d)=1000/(1+d) (min 1); false=>H0 w=1000.
//    Output labels D and R steps.
// Usage: dual_bin <problem.form> <out_path>   (CWD must be the math_logic dir)
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../../deliberation_depth/harness/dlb_util.zag")
@import("../../../deliberation_depth/harness/dlb_json.zag")
@import("../../../deliberation_depth/harness/dlb_cfg.zag")
@import("../../../deliberation_depth/harness/dlb_ledger.zag")
@import("../../../deliberation_depth/harness/dlb_delib.zag")
@import("../common/cx_fwd.zag")

// D forward sweep: bound 3, no goal, no subproofs (direct PBC only).
fn du_forward(s:*CXS,p:*ONEP,lg:*DOut)i32 {
    dout_str(lg,"D FWD: sweep bound 3\n");
    let lv:i32=0;
    while(lv<3){
        let n0:i32=s.*.n;
        if(one_mp(s,p,0)<0){return -1;}
        if(one_ui(s,p,0)<0){return -1;}
        if(one_pbc_direct(s,p,0)<0){return -1;}
        dout_str(lg,"D FWD: level ");dout_i64(lg,(lv+1) as i64);
        dout_str(lg," claims=");dout_i64(lg,s.*.n as i64);dout_str(lg,"\n");
        if(s.*.n==n0){break;}
        lv=lv+1;
    }
    return 0;
}

// D backward prover. Returns 1 if goal proved (now in store), 0 otherwise.
// depth = remaining backward budget. Logs to lg.
fn du_prove(s:*CXS,p:*ONEP,goal:[]u8,depth:i32,lg:*DOut)i32 {
    if(cxs_find(s,goal)>=0){return 1;}
    if(depth<=0){return 0;}
    // S_MP backward: antecedent must be provable at depth-1
    let j:i32=0;
    while(j<s.*.n){
        if(cxs_ok(s,j,0)==1){
            let jb:[]u8=cxs_bytes(s,j);
            let ja:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jr:i32=-1;
            if(one_parse_tmp(jb,&ja,&jr)==0 && jr>=0 && cxk(&ja,jr)==4){
                let c1:i32=cxch(&ja,jr);
                let c2:i32=cxnx(&ja,c1);
                if(c2>=0 && nio_equal(cx_span(&ja,c2),goal)==1){
                    let asp:[]u8=cx_copy(cx_span(&ja,c1));
                    dout_str(lg,"D BWD-MP: C");dout_i64(lg,j as i64);
                    dout_str(lg," needs ");dout_str(lg,asp);dout_str(lg,"\n");
                    let pr:i32=du_prove(s,p,asp,depth-1,lg);
                    if(pr==1){
                        let ri:i32=cxs_find(s,asp);
                        let rd:i32=0;
                        if(ri>=0){rd=au_get32(s.*.dep,ri);}
                        let ab:[]u8=cx_concat("S_MP_BWD C",_zag_i64_to_str(j as i64));
                        let ab2:[]u8=cx_concat(ab," C");
                        nio_free(ab);
                        let ab3:[]u8=cx_concat(ab2,_zag_i64_to_str(ri as i64));
                        nio_free(ab2);
                        cxs_add(s,goal,ab3,rd+1,1);
                        nio_free(ab3);
                        dout_str(lg,"D BWD-MP: proved ");
                        dout_str(lg,goal);dout_str(lg,"\n");
                        nio_free(asp);nio_free(ja.buf);
                        return 1;
                    }
                    nio_free(asp);
                }
            }
            nio_free(ja.buf);
        }
        j=j+1;
    }
    // S_UI backward: goal must match a forall body with binder bound
    let goa:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
    if(cxa_init(&goa,goal,256)==0){
        let gr2:i32=cx_parse(&goa,goal);
        if(gr2>=0){
            let jj:i32=0;
            while(jj<s.*.n){
                if(cxs_ok(s,jj,0)==1){
                    let jb2:[]u8=cxs_bytes(s,jj);
                    let ja2:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
                    let jr2:i32=-1;
                    if(one_parse_tmp(jb2,&ja2,&jr2)==0 && jr2>=0 && cxk(&ja2,jr2)==7){
                        let bv:[]u8=cx_bvar(&ja2,jr2);
                        let bd:i32=cxch(&ja2,jr2);
                        let bb:CXB=CXB{.off:"",.len:"",.set:"",.cap:0};
                        if(cxb_init(&bb,4)==0){
                            if(cx_match_bvar(&ja2,bd,&goa,gr2,bv,0,&bb)==1 && bb.set[0]==1){
                                let t:[]u8=cx_copy(cxb_slice(&bb,0,goal));
                                let ab:[]u8=cx_concat("S_UI_BWD C",_zag_i64_to_str(jj as i64));
                                let ab2:[]u8=cx_concat(ab," ");
                                nio_free(ab);
                                let ab3:[]u8=cx_concat(ab2,bv);
                                nio_free(ab2);
                                let ab4:[]u8=cx_concat(ab3,":=");
                                nio_free(ab3);
                                let ab5:[]u8=cx_concat(ab4,t);
                                nio_free(ab4);
                                cxs_add(s,goal,ab5,1,1);
                                nio_free(ab5);nio_free(t);
                                dout_str(lg,"D BWD-UI: proved ");
                                dout_str(lg,goal);dout_str(lg,"\n");
                                nio_free(ja2.buf);
                                jj=s.*.n;
                            }
                        }
                    }
                    nio_free(ja2.buf);
                }
                jj=jj+1;
            }
            if(cxs_find(s,goal)>=0){nio_free(goa.buf);return 1;}
        }
        nio_free(goa.buf);
    }
    // S_PBC backward: subproof assuming not(goal) derives false
    dout_str(lg,"D BWD-PBC: subproof for ");dout_str(lg,goal);dout_str(lg,"\n");
    let sp:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sp,8192)==0){
        let pr2:i32=one_pbc_for(s,p,goal,8,&sp);
        if(pr2==1){
            dout_str(lg,"D BWD-PBC: proved ");
            dout_str(lg,goal);dout_str(lg," via subproof\n");
            dout_str(lg,dout_bytes(&sp));
            // record the proved goal (one_pbc_for leaves subproof-local claims)
            let fi:i32=cxs_find(s,goal);
            if(fi<0){
                cxs_add(s,goal,"S_PBC_BWD ASSUME:not(T) FALSE_DERIVED",1,1);
            }
            dout_free(&sp);
            return 1;
        }
        dout_free(&sp);
    }
    dout_str(lg,"D BWD: failed ");dout_str(lg,goal);dout_str(lg,"\n");
    return 0;
}

// ---------------- R (referee): frozen rubric -> H5 item -> dlb_run ----------------
// W(d) = 1000/(1+d), min 1.
fn du_w(depth:i32)i32 {
    let w:i32=1000/(1+depth);
    if(w<1){w=1;}
    return w;
}

fn du_append_name(line:[]u8,cur:i32,name:[]u8,off:*i32,ln:*i32)i32 {
    line[cur]=124;
    let s:i32=cur+1;
    let i:i32=0;
    while(i<name.len){line[s+i]=name[i];i=i+1;}
    off.*=s;ln.*=name.len;
    return s+name.len;
}

// Build the H5 item in memory. Returns 0 ok.
// dT/dN/dF: 1 if derived else 0; ddT/ddN/ddF: depths.
fn du_build_item(it:*Item,line:[]u8,llen:i32,pid:[]u8,
                 dT:i32,ddT:i32,dN:i32,ddN:i32,dF:i32,ddF:i32,rlog:*DOut)i32 {
    let cur:i32=0;
    let i:i32=0;
    while(i<pid.len && cur<llen){line[cur]=pid[i];i=i+1;cur=cur+1;}
    it.*.line=line;
    it.*.id_off=0;it.*.id_len=pid.len;
    it.*.tt_off=0;it.*.tt_len=0;
    it.*.gt_off=0;it.*.gt_len=0;
    it.*.nh=0;it.*.ne=0;
    it.*.maxh=16;it.*.maxe=64;it.*.maxl=16;
    let off:i32=0;let ln:i32=0;
    cur=du_append_name(line,cur,"H0",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -1;}
    cur=du_append_name(line,cur,"H1",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -2;}
    cur=du_append_name(line,cur,"H2",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -3;}
    if(dT==1){
        cur=du_append_name(line,cur,"E_T",&off,&ln);
        let e:i32=dj_add_ev(it,((off as i64)<<32)|(ln as i64));
        if(e<0){return -4;}
        let w:i32=du_w(ddT);
        dout_str(rlog,"R EVIDENCE E_T: T derived depth ");
        dout_i64(rlog,ddT as i64);dout_str(rlog," w=");dout_i64(rlog,w as i64);
        dout_str(rlog," supports H1 attacks H2\n");
        if(dj_add_link(it,e,1,w,0)!=0){return -5;}
        if(dj_add_link(it,e,2,w,1)!=0){return -6;}
    }
    if(dN==1){
        cur=du_append_name(line,cur,"E_N",&off,&ln);
        let e2:i32=dj_add_ev(it,((off as i64)<<32)|(ln as i64));
        if(e2<0){return -7;}
        let w2:i32=du_w(ddN);
        dout_str(rlog,"R EVIDENCE E_N: not(T) derived depth ");
        dout_i64(rlog,ddN as i64);dout_str(rlog," w=");dout_i64(rlog,w2 as i64);
        dout_str(rlog," supports H2 attacks H1\n");
        if(dj_add_link(it,e2,2,w2,0)!=0){return -8;}
        if(dj_add_link(it,e2,1,w2,1)!=0){return -9;}
    }
    if(dF==1){
        cur=du_append_name(line,cur,"E_F",&off,&ln);
        let e3:i32=dj_add_ev(it,((off as i64)<<32)|(ln as i64));
        if(e3<0){return -10;}
        dout_str(rlog,"R EVIDENCE E_F: false derived depth ");
        dout_i64(rlog,ddF as i64);dout_str(rlog," w=1000 supports H0 attacks H1 H2\n");
        if(dj_add_link(it,e3,0,1000,0)!=0){return -11;}
        if(dj_add_link(it,e3,1,1000,1)!=0){return -12;}
        if(dj_add_link(it,e3,2,1000,1)!=0){return -13;}
    }
    if(dT==0 && dN==0 && dF==0){
        dout_str(rlog,"R EVIDENCE: none; H0 (WITHHELD) wins ties by lowest index\n");
    }
    return 0;
}

// Run the real H5 deliberation. Returns leader 0/1/2, sets *confp. <0 on error.
fn du_deliberate(pid:[]u8,dT:i32,ddT:i32,dN:i32,ddN:i32,dF:i32,ddF:i32,
                 rlog:*DOut,confp:*i32)i32 {
    let line:[]u8=nio_alloc(4096);
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(line.len!=4096){return -1;}
    let p_it:*Item=&it;
    p_it.*.hid=nio_alloc(16*8);
    p_it.*.eid=nio_alloc(64*8);
    p_it.*.evns=nio_alloc(64*4);
    p_it.*.evna=nio_alloc(64*4);
    p_it.*.sup=nio_alloc(64*16*2*4);
    p_it.*.att=nio_alloc(64*16*2*4);
    if(p_it.*.hid.len==0 || p_it.*.sup.len==0){nio_free(line);return -2;}
    let brc:i32=du_build_item(&it,line,4096,pid,dT,ddT,dN,ddN,dF,ddF,rlog);
    if(brc!=0){nio_free(line);return -3;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:42};
    let p_st:*DSt=&st;
    p_st.*.scores=nio_alloc(16*8);
    p_st.*.alive=nio_alloc(16);
    p_st.*.hist_l=nio_alloc(42*4);
    p_st.*.hist_m=nio_alloc(42*8);
    // Frozen R config (documented in build report).
    let cfg:DCfg=DCfg{.mode:1,.shallow_rounds:1,.deep_rounds:12,.amin:1,.amax:12,.conf_thr:100,.stab_win:2,.eps:1,.elim_margin:150,.refute_thr:500,.evcap:128};
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(p_st.*.scores.len==0 || dout_init(&lgo,1048576)!=0 || lg_init(&lg)!=0){
        nio_free(line);return -4;
    }
    if(lg_step(&lg,&lgo,pid,0,"GENESIS","dual referee")==0){
        let rc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
        if(rc==0){
            dout_str(rlog,"R DELIBERATION: leader=H");
            dout_i64(rlog,st.leader as i64);
            dout_str(rlog," conf=");dout_i64(rlog,st.conf as i64);
            dout_str(rlog," margin=");dout_i64(rlog,st.margin);
            dout_str(rlog," rounds=");dout_i64(rlog,st.rounds as i64);
            dout_str(rlog,"\n");
            dout_str(rlog,"R LEDGER_HEAD: ");
            dout_str(rlog,lg_head_hex(&lg));
            dout_str(rlog,"\n");
            confp.*=st.conf;
            let ld:i32=st.leader;
            nio_free(line);
            return ld;
        }
    }
    nio_free(line);
    return -5;
}

// ---------------- output ----------------
fn du_emit(o:*DOut,pid:[]u8,verdict:[]u8,claim:[]u8,conf:i32,deriv:i32,
           flags:[]u8,s:*CXS,dlg:*DOut,rlg:*DOut)void {
    dout_str(o,"ID: ");dout_str(o,pid);dout_str(o,"\n");
    dout_str(o,"ENGINE: dual\n");
    dout_str(o,"VERDICT: ");dout_str(o,verdict);dout_str(o,"\n");
    dout_str(o,"CLAIM: ");dout_str(o,claim);dout_str(o,"\n");
    dout_str(o,"CONFIDENCE: ");dout_i64(o,conf as i64);dout_str(o,"\n");
    dout_str(o,"DERIVATIONS: ");dout_i64(o,deriv as i64);dout_str(o,"\n");
    dout_str(o,"SCHEMAS: S_MP=");
    dout_str(o,cx_sch_hex(0));
    dout_str(o," S_PBC=");
    dout_str(o,cx_sch_hex(1));
    dout_str(o," S_UI=");
    dout_str(o,cx_sch_hex(2));
    dout_str(o,"\n");
    dout_str(o,"FLAGS: ");dout_str(o,flags);dout_str(o,"\n");
    dout_str(o,"D_STEPS:\n");dout_str(o,dout_bytes(dlg));
    dout_str(o,"R_STEPS:\n");dout_str(o,dout_bytes(rlg));
    dout_str(o,"AUDIT:\n");
    let i:i32=0;
    while(i<s.*.n){
        dout_str(o,"C");dout_i64(o,i as i64);dout_str(o,": ");
        dout_str(o,cxs_bytes(s,i));dout_str(o," [");
        dout_str(o,cxs_audit(s,i));dout_str(o,"]\n");
        i=i+1;
    }
}

// One full DUAL run into o. Returns 0 ok, 3 sealed, 4 input, 6 schema.
fn dual_run(o:*DOut,fbuf:[]u8,flen:i32,sbuf:[]u8,sn:i32)i32 {
    if(cx_sch_assert()!=0){return 6;}
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen,&f,512)!=0){return 4;}
    let k:CXK=CXK{.kid_off:"",.kid_len:"",.kcl_off:"",.kcl_len:"",.nk:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_store(sbuf,sn,&k,512)!=0){return -4;}
    let p:ONEP=ONEP{.a_mp1:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp1:0,.a_mp2:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp2:0,.a_pb:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_pb:0,.a_ui:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_ui:0};
    if(onep_init(&p)!=0){return -4;}
    let s:CXS=CXS{.n:0,.cap:0,.data:"",.dn:0,.dcap:0,.coff:"",.clen:"",.aoff:"",.alen:"",.dep:"",.kind:"",.deriv:0};
    if(cxs_init(&s,4096,2097152)!=0){return -4;}
    // load store claims as premises
    let i:i32=0;
    while(i<k.nk){
        let kb:[]u8=cx_kclaim(&k,i);
        let cb:[]u8=cx_canon(kb);
        if(cb.len>0){
            let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ao,128)==0){
                dout_str(&ao,"PREM ");dout_str(&ao,cx_kid(&k,i));
                let ab:[]u8=cx_copy(dout_bytes(&ao));
                dout_free(&ao);
                cxs_add(&s,cb,ab,0,0);
                nio_free(cb);nio_free(ab);
            }
        }
        i=i+1;
    }
    // load problem premises
    i=0;
    while(i<f.nprem){
        let pb:[]u8=cx_prem(&f,i);
        let cb2:[]u8=cx_canon(pb);
        if(cb2.len==0){return -4;}
        let ab2:[]u8=cx_copy("PREM");
        cxs_add(&s,cb2,ab2,0,0);
        nio_free(cb2);nio_free(ab2);
        i=i+1;
    }
    let target:[]u8=cx_canon(f.target);
    if(target.len==0){return -4;}
    let notT:[]u8=cx_concat("not(",target);
    let notT2:[]u8=cx_concat(notT,")");
    nio_free(notT);
    let dlg:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let rlg:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&dlg,1048576)!=0 || dout_init(&rlg,1048576)!=0){return -4;}
    // ---- D: forward sweep (bound 3) ----
    if(du_forward(&s,&p,&dlg)!=0){return -4;}
    // preliminary confidences for directive ordering (lowest first)
    let iT0:i32=cxs_find(&s,target);
    let iN0:i32=cxs_find(&s,notT2);
    let cT:i32=0;let cN:i32=0;
    if(iT0>=0){cT=du_w(au_get32(s.dep,iT0));}
    if(iN0>=0){cN=du_w(au_get32(s.dep,iN0));}
    dout_str(&dlg,"D DIRECTIVES (lowest-confidence-first): ");
    let firstT:i32=1;
    if(cT>cN){firstT=0;}
    if(firstT==1){dout_str(&dlg,"derive T then not(T)\n");}
    if(firstT==0){dout_str(&dlg,"derive not(T) then T\n");}
    // ---- R->D directives (bounded derive to depth 8) ----
    if(firstT==1){
        du_prove(&s,&p,target,8,&dlg);
        du_prove(&s,&p,notT2,8,&dlg);
    } else {
        du_prove(&s,&p,notT2,8,&dlg);
        du_prove(&s,&p,target,8,&dlg);
    }
    // ---- D->R report ----
    let iT:i32=cxs_find(&s,target);
    let iN:i32=cxs_find(&s,notT2);
    let iF:i32=cxs_find(&s,"false");
    let dT:i32=0;let dN:i32=0;let dF:i32=0;
    let ddT:i32=0;let ddN:i32=0;let ddF:i32=0;
    if(iT>=0){dT=1;ddT=au_get32(s.dep,iT);}
    if(iN>=0){dN=1;ddN=au_get32(s.dep,iN);}
    if(iF>=0){dF=1;ddF=au_get32(s.dep,iF);}
    dout_str(&dlg,"D REPORT: T=");
    if(dT==1){dout_str(&dlg,"derived(d=");dout_i64(&dlg,ddT as i64);dout_str(&dlg,")");}
    if(dT==0){dout_str(&dlg,"absent");}
    dout_str(&dlg," notT=");
    if(dN==1){dout_str(&dlg,"derived(d=");dout_i64(&dlg,ddN as i64);dout_str(&dlg,")");}
    if(dN==0){dout_str(&dlg,"absent");}
    dout_str(&dlg," false=");
    if(dF==1){dout_str(&dlg,"derived(d=");dout_i64(&dlg,ddF as i64);dout_str(&dlg,")");}
    if(dF==0){dout_str(&dlg,"absent");}
    dout_str(&dlg,"\n");
    // ---- R: deliberate (R owns the verdict) ----
    let conf:i32=0;
    let leader:i32=du_deliberate(f.id,dT,ddT,dN,ddN,dF,ddF,&rlg,&conf);
    if(leader<0){return -4;}
    let verdict:[]u8="WITHHELD";
    let claim:[]u8="-";
    let oconf:i32=0;
    if(leader==1){verdict="DERIVED";claim=target;oconf=conf;}
    if(leader==2){verdict="REFUTED";oconf=conf;}
    let flags:[]u8="NONE";
    if(dF==1 && leader!=0){flags="CONTRADICTION_DERIVED";}
    if(dT==1 && dN==1){flags="CONTRADICTION_DERIVED";}
    du_emit(o,f.id,verdict,claim,oconf,s.deriv,flags,&s,&dlg,&rlg);
    nio_free(notT2);nio_free(target);
    return 0;
}

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: dual_bin <problem.form> <out_path>  (CWD must be the math_logic dir)");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len==0){return 4;}
    let flen:i64=cx_guarded_read(fpath,fbuf);
    if(flen==-99){_zag_println("dual: sealed guard tripped on problem file");return 3;}
    if(flen<=0){_zag_println("dual: cannot read problem file");return 4;}
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen as i32,&f,512)!=0){_zag_println("dual: bad .form");return 4;}
    let sbuf:[]u8=nio_alloc(1048576);
    if(sbuf.len==0){return 4;}
    let sn:i64=cx_guarded_read(f.store,sbuf);
    if(sn==-99){_zag_println("dual: sealed guard tripped on store file");return 3;}
    if(sn<=0){_zag_println("dual: cannot read store file");return 4;}
    // 3x in-process reruns, byte-identical assert
    let r1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let r2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let r3:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&r1,4194304)!=0 || dout_init(&r2,4194304)!=0 || dout_init(&r3,4194304)!=0){return 4;}
    let e1:i32=dual_run(&r1,fbuf,flen as i32,sbuf,sn as i32);
    let e2:i32=dual_run(&r2,fbuf,flen as i32,sbuf,sn as i32);
    let e3:i32=dual_run(&r3,fbuf,flen as i32,sbuf,sn as i32);
    if(e1==6 || e2==6 || e3==6){_zag_println("dual: committed-schema mismatch");return 6;}
    if(e1==3 || e2==3 || e3==3){_zag_println("dual: sealed guard tripped");return 3;}
    let div:i32=0;
    if(e1!=0 || e2!=0 || e3!=0){div=2;}
    if(div==0){
        let b1:[]u8=dout_bytes(&r1);
        let b2:[]u8=dout_bytes(&r2);
        let b3:[]u8=dout_bytes(&r3);
        if(nio_equal(b1,b2)==0 || nio_equal(b2,b3)==0){div=1;}
    }
    if(div!=0){
        _zag_println("dual: DIVERGENCE across 3x reruns");
        if(div==1){return 5;}
        return 4;
    }
    let wrc:i64=dlb_write_file(opath,dout_bytes(&r1),r1.n);
    if(wrc<0){return 4;}
    return 0;
}

// meter_test.zag — meter integration + kind-switch bug fix verification.
// Deterministic; zero RNG. Prints METER_PASS/METER_FAIL; exit 0 iff all pass.
@import("strength_checker.zag")

fn t_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn t_new()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    let d:i32=-1;
    st_add_core(&s,1,-1,&d);
    st_add_core(&s,2,-1,&d);
    return s;
}
fn t_add(s:*StStore,strength:i32) i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,strength,-1,&sl);
    if(rc!=ST_OK){_zag_print("FATAL add\n");}
    return sl;
}
fn t_cite(s:*StStore,slot:i32,ep:i64)void {
    let rc:i32=st_evidence(s,slot,1,ep);
    if(rc!=ST_OK){_zag_print("FATAL cite\n");}
}
fn t_check(name:[]u8,got:i32,want:i32)void {
    if(got==want){_zag_print("METER_PASS ");_zag_print(name);_zag_print("\n");}
    else {_zag_print("METER_FAIL ");_zag_print(name);_zag_print(" got=");t_pi(got as i64);_zag_print(" want=");t_pi(want as i64);_zag_print("\n");}
}

fn main()void {
    let fails:i32=0;
    // Test 1: Basic meter deliberation (strong memory, no cites, no weaken, no overwrite)
    // hw=80 (>=76: +1), sunk=0 (-1), fought=0 (0), revs=0 (-1) => 2+1-1+0-1 = 1
    let s:StStore=t_new();
    let sl:i32=t_add(&s,80);
    let price:i32=-1;
    let rc:i32=st_deliberate(&s,sl,&price);
    t_check("m1_delib_rc",rc,ST_OK);
    t_check("m1_price",price,1);
    // Verify reason codes: r1=21 (HELD_STRONG), r2=26 (STAKED_NONE), r3=28 (UNFOUGHT), r4=30 (UNPROVEN)
    // Test 2: KIND-SWITCH BUG — deliberate in DELIB mode, switch to METER
    let s2:StStore=t_new();
    st_set_price_mode(&s2,ST_PRICE_DELIB);
    let sl2:i32=t_add(&s2,80);
    let p2:i32=-1;
    let rc2:i32=st_deliberate(&s2,sl2,&p2);  // kind=1 (HIST) weight-table deliberation
    t_check("m2_delib_rc",rc2,ST_OK);
    // Now switch to METER mode — the kind=1 deliberation must NOT bind
    st_set_price_mode(&s2,ST_PRICE_METER);
    let cost:i32=st_deliberate_dryrun(&s2,sl2);
    t_check("m2_cost_mismatch",cost,-1);  // fail-closed: no enforceable deliberation
    // Attempt destruction via the priced path — tested in the full battery;
    // here we verify the dryrun fail-closed which gates it.
    _zag_print("METER_INFO kind-switch test complete\n");

    // Test 3: Fresh METER deliberation after switch works
    let p3:i32=-1;
    let rc3:i32=st_deliberate(&s2,sl2,&p3);  // kind=3 (METER)
    t_check("m3_delib_rc",rc3,ST_OK);
    t_check("m3_price",p3,1);  // same ledger, meter policy: 1
    let cost3:i32=st_deliberate_dryrun(&s2,sl2);
    t_check("m3_cost",cost3,1);

    // Test 4: Framing invariance — JUSTIFY tiers do NOT move the meter
    let s4:StStore=t_new();
    let sl4:i32=t_add(&s4,80);
    // Justify with tier 1 (trivial) — should not affect meter
    st_justify(&s4,sl4,1);
    let p4a:i32=-1;
    st_deliberate(&s4,sl4,&p4a);
    // New store, same ledger but tier 7 (supremely important)
    let s5:StStore=t_new();
    let sl5:i32=t_add(&s5,80);
    st_justify(&s5,sl5,7);
    let p5a:i32=-1;
    st_deliberate(&s5,sl5,&p5a);
    t_check("m4_framing_invariant",p4a,p5a);

    _zag_print("METER_DONE\n");
}

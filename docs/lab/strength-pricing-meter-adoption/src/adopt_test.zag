// adopt_test.zag — adoption verification battery for deliberative pricing.
// Deterministic; zero RNG. Prints ADOPT_PASS/ADOPT_FAIL lines; exit 0 iff
// all pass. Covers: hand-authored weights, personality contrast, the
// personality-mismatch 122 (required), fresh-deliberation recovery,
// no-delib/stale 122, over/under-cite, 64-bit cites,
// trainer-only kill, DELETE_STRONG, dryrun COST, checker agreement.
@import("strength_checker.zag")

fn t_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn t_new()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_DELIB);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    // ck_core_live invariant: F6-trial core slots 0,1 live
    let d:i32=-1;
    st_add_core(&s,1,-1,&d);
    st_add_core(&s,2,-1,&d);
    return s;
}
fn t_add(s:*StStore,strength:i32) i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,strength,-1,&sl);
    if(rc!=ST_OK){_zag_print("FATAL add\n");}
    return sl;
}
fn t_cite(s:*StStore,slot:i32,ep:i64) i32 {
    return st_evidence(s,slot,ST_J_CORROBORATED,ep);
}
fn t_just(s:*StStore,slot:i32,code:i32) i32 {
    return st_justify(s,slot,code);
}
fn t_delib(s:*StStore,slot:i32) i32 {
    let p:i32=-1;
    let rc:i32=st_deliberate(s,slot,&p);
    if(rc!=ST_OK){_zag_print("FATAL delib rc\n");}
    return p;
}
fn t_pay(s:*StStore,slot:i32,n:i32)void {
    let i:i32=0;
    while(i<n){
        let rc:i32=t_cite(s,slot,(1000 as i64)+(i as i64));
        if(rc!=ST_OK){_zag_print("FATAL cite\n");}
        i=i+1;
    }
    let jr:i32=t_just(s,slot,ST_J_CORROBORATED);
    if(jr!=ST_OK){_zag_print("FATAL just\n");}
    return;
}
fn t_check(name:[]u8,got:i32,want:i32) i32 {
    if(got==want){
        _zag_print("ADOPT_PASS ");_zag_print(name);_zag_print("\n");
        return 0;
    }
    _zag_print("ADOPT_FAIL ");_zag_print(name);_zag_print(" got=");
    t_pi(got as i64);_zag_print(" want=");t_pi(want as i64);_zag_print("\n");
    return 1;
}
fn t_ck(name:[]u8,s:*StStore) i32 {
    let f:i32=ck_verify(s,1,0,0,500,1);
    return t_check(name,f,0);
}
// W1 base: ADD50 -> 2+0-1+0+0 = 1
fn w1()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    let f:i32=t_check("W1_base",t_delib(&s,sl),1);
    f=f+t_ck("W1_ck",&s);st_free(&s);return f;
}
// W2 strong: ADD90 -> 2+1-1+0+0 = 2
fn w2()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let f:i32=t_check("W2_strong",t_delib(&s,sl),2);
    f=f+t_ck("W2_ck",&s);st_free(&s);return f;
}
// W3 weak: ADD10 -> 2+0-1+0+0-1 = 0
fn w3()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,10);
    let f:i32=t_check("W3_weak",t_delib(&s,sl),0);
    f=f+t_ck("W3_ck",&s);st_free(&s);return f;
}
// W4 contested: ADD50 + 3 cites -> 2+0+1+0+0 = 3
fn w4()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    t_cite(&s,sl,0);t_cite(&s,sl,1);t_cite(&s,sl,2);
    let f:i32=t_check("W4_contested",t_delib(&s,sl),3);
    f=f+t_ck("W4_ck",&s);st_free(&s);return f;
}
// W5 salient: ADD50 + JUSTIFY6 -> 2+0-1+1+0 = 2
fn w5()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    t_just(&s,sl,ST_J_PRESSURE_VICTIM);
    let f:i32=t_check("W5_salient",t_delib(&s,sl),2);
    f=f+t_ck("W5_ck",&s);st_free(&s);return f;
}
// W6 directive: ADD50 + JUSTIFY7 -> 4 (override)
fn w6()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    t_just(&s,sl,ST_J_TRAINER_DIRECTIVE);
    let f:i32=t_check("W6_directive",t_delib(&s,sl),4);
    f=f+t_ck("W6_ck",&s);st_free(&s);return f;
}
// W7 retract: ADD50 + JUSTIFY3 -> 2+0-1+0-1 = 0
fn w7()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    t_just(&s,sl,ST_J_CONTRADICTED);
    let f:i32=t_check("W7_retract",t_delib(&s,sl),0);
    f=f+t_ck("W7_ck",&s);st_free(&s);return f;
}
// P setup: ADD90, JUSTIFY6, DELIBERATE, pay, OVERWRITE90. Returns store
// ready for the contrast deliberation. Personality is fixed per store.
fn p_setup(pers:i32)StStore {
    let s:StStore=t_new();
    st_set_delib_personality(&s,pers);
    let sl:i32=t_add(&s,90);
    t_just(&s,sl,ST_J_PRESSURE_VICTIM);
    let p:i32=t_delib(&s,sl);
    t_pay(&s,sl,p);
    let orc:i32=st_overwrite(&s,sl,71,90,-1);
    if(orc!=ST_OK){_zag_print("FATAL p_setup overwrite\n");}
    return s;
}
// P: personality contrast. HIST sees the pre-overwrite trail (price 4);
// FRESH is epoch-scoped (price 2).
fn ptest()i32 {
    let sh:StStore=p_setup(ST_DELIB_HIST);
    let ph:i32=t_delib(&sh,2);
    let f:i32=t_check("P_hist",ph,4);
    f=f+t_ck("P_ck_hist",&sh);
    st_free(&sh);
    let sf:StStore=p_setup(ST_DELIB_FRESH);
    let pf:i32=t_delib(&sf,2);
    f=f+t_check("P_fresh",pf,2);
    f=f+t_ck("P_ck_fresh",&sf);
    st_free(&sf);
    return f;
}
// M: personality mismatch -> 122 (required explicit test), then recovery.
fn mtest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let p:i32=t_delib(&s,sl);
    let f:i32=t_check("M_delib_price",p,2);
    t_pay(&s,sl,2);
    f=f+t_check("M_cost_before",st_deliberate_dryrun(&s,sl),2);
    st_set_delib_personality(&s,ST_DELIB_FRESH);
    f=f+t_check("M_cost_mismatch",st_deliberate_dryrun(&s,sl),-1);
    let krc:i32=st_kill_evidenced(&s,sl);
    f=f+t_check("M_kill_122",krc,ST_REFUSED_NODELIB);
    f=f+t_check("M_122_numeric",krc,122);
    let sp:*StStore=&s;let lv:i32=0;
    if(sp.*.live[sl]==1){lv=1;}
    f=f+t_check("M_still_live",lv,1);
    // fresh deliberation under FRESH restores lawful destruction; the
    // pre-switch cites + JUSTIFY are still fresh (122 consumed nothing).
    let p2:i32=t_delib(&s,sl);
    f=f+t_check("M_fresh_price",p2,2);
    let k2:i32=st_kill_evidenced(&s,sl);
    f=f+t_check("M_rekill_ok",k2,ST_OK);
    f=f+t_ck("M_ck",&s);st_free(&s);return f;
}
// N: no deliberation -> 122
fn ntest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    t_pay(&s,sl,4);
    let f:i32=t_check("N_kill_122",st_kill_evidenced(&s,sl),122);
    f=f+t_ck("N_ck",&s);st_free(&s);return f;
}
// S: stale record (strength-set after DELIB) -> 122
fn stest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let p:i32=t_delib(&s,sl);
    let f:i32=t_check("S_delib_price",p,2);
    st_strengthen_cited(&s,sl,95,ST_J_CORROBORATED,-1);
    t_pay(&s,sl,2);
    f=f+t_check("S_kill_122",st_kill_evidenced(&s,sl),122);
    f=f+t_ck("S_ck",&s);st_free(&s);return f;
}
// O: over-cite -> 122 at CITE time; slot not bricked
fn otest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let p:i32=t_delib(&s,sl);
    let f:i32=t_check("O_delib_price",p,2);
    t_cite(&s,sl,0);t_cite(&s,sl,1);
    f=f+t_check("O_third_cite_122",t_cite(&s,sl,2),122);
    t_just(&s,sl,ST_J_CORROBORATED);
    f=f+t_check("O_kill_ok",st_kill_evidenced(&s,sl),ST_OK);
    f=f+t_ck("O_ck",&s);st_free(&s);return f;
}
// U: under-cite -> 109
fn utest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let p:i32=t_delib(&s,sl);
    let f:i32=t_check("U_delib_price",p,2);
    t_cite(&s,sl,0);
    t_just(&s,sl,ST_J_CORROBORATED);
    f=f+t_check("U_kill_109",st_kill_evidenced(&s,sl),ST_REFUSED_EFFORT);
    f=f+t_ck("U_ck",&s);st_free(&s);return f;
}
// E64: 64-bit cite identity. 3 distinct 56-bit episodes -> +1: price 3.
// (truncated to low32, {0,0,1} would give 2)
fn e64test()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,50);
    t_cite(&s,sl,0);
    let big:i64=4294967296;
    t_cite(&s,sl,big);
    t_cite(&s,sl,1);
    let f:i32=t_check("E64_price",t_delib(&s,sl),3);
    f=f+t_ck("E64_ck",&s);st_free(&s);return f;
}
// K: trainer-only kill
fn ktest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let f:i32=t_check("K_tnn_113",st_kill(&s,sl,ST_ROLE_TNN,0),ST_REFUSED_ROLE);
    let p:i32=t_delib(&s,sl);
    t_pay(&s,sl,p);
    f=f+t_check("K_trainer_ok",st_kill(&s,sl,ST_ROLE_TRAINER,7),ST_OK);
    f=f+t_ck("K_ck",&s);st_free(&s);return f;
}
// D: DELETE_STRONG priced path in DELIB mode
fn dtest()i32 {
    let s:StStore=t_new();let sl:i32=t_add(&s,90);
    let p:i32=t_delib(&s,sl);
    t_pay(&s,sl,p);
    let f:i32=t_check("D_delete_strong_ok",st_delete_strong(&s,sl),ST_OK);
    f=f+t_ck("D_ck",&s);st_free(&s);return f;
}
// G: GLOBAL store-wide double-spend still refused (121)
fn gtest()i32 {
    let s:StStore=t_new();
    let s1:i32=t_add(&s,90);let p1:i32=t_delib(&s,s1);t_pay(&s,s1,p1);
    let f:i32=t_check("G_kill1_ok",st_kill_evidenced(&s,s1),ST_OK);
    let sl2:i32=-1;
    let arc:i32=st_add(&s,70,ST_REGION_USER,90,-1,&sl2);
    f=f+t_check("G_readd_ok",arc,ST_OK);
    let p2:i32=t_delib(&s,sl2);
    let i:i32=0;
    while(i<p2){t_cite(&s,sl2,(1000 as i64)+(i as i64));i=i+1;}
    t_just(&s,sl2,ST_J_CORROBORATED);
    f=f+t_check("G_double_spend_121",st_kill_evidenced(&s,sl2),ST_REFUSED_CONSUMED);
    f=f+t_ck("G_ck",&s);st_free(&s);return f;
}

fn main()i32 {
    let fails:i32=0;
    fails=fails+w1();fails=fails+w2();fails=fails+w3();fails=fails+w4();
    fails=fails+w5();fails=fails+w6();fails=fails+w7();
    fails=fails+ptest();fails=fails+mtest();fails=fails+ntest();
    fails=fails+stest();fails=fails+otest();fails=fails+utest();
    fails=fails+e64test();fails=fails+ktest();fails=fails+dtest();
    fails=fails+gtest();
    _zag_print("ADOPT_DONE fails=");t_pi(fails as i64);_zag_print("\n");
    if(fails==0){return 0;}
    return 1;
}

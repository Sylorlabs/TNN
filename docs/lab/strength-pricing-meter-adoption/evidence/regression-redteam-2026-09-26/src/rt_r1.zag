// rt_r1.zag — R1: resurrection after slot reuse.
// Destroy a strong memory with citation E, re-add into the reused slot, re-cite E.
// Law S-D6: E is tombstoned store-wide forever. Second destruction must NOT be
// fundable by E. 12 skeletons x 2 destroy-ops x 5 attack-modes = 120 sequences.
@import("rt_common.zag")

fn rt_r1_skel(id:i32,o_hw:*i32,o_sunk:*i32,o_fought:*i32,o_ow:*i32)void {
    // all price>0 (P1..P4 + P2r variants)
    let hw:i32=80;let sunk:i32=0;let fought:i32=0;let ow:i32=0;
    if(id==2){sunk=2;}
    if(id==3){sunk=3;}
    if(id==4){sunk=3;fought=1;}
    if(id==5){sunk=2;ow=1;}
    if(id==6){hw=50;sunk=2;}
    if(id==7){hw=90;sunk=1;fought=1;}
    if(id==8){hw=76;ow=1;}
    if(id==9){hw=30;sunk=3;}
    if(id==10){hw=100;sunk=3;fought=2;ow=1;}
    if(id==11){hw=40;sunk=2;fought=1;ow=1;}
    if(id==12){hw=80;fought=1;}
    o_hw.*=hw;o_sunk.*=sunk;o_fought.*=fought;o_ow.*=ow;
}

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let sk:i32=1;
    while(sk<=12){
        let hw:i32=0;let sunk:i32=0;let fought:i32=0;let ow:i32=0;
        rt_r1_skel(sk,&hw,&sunk,&fought,&ow);
        let exp_p:i32=rt_predict(hw,sunk,fought,ow);
        let del:i32=0;
        while(del<=1){
            let fmode:i32=0;
            while(fmode<=4){
                total=total+1;
                let s:StStore=rt_new();
                let epb:i64=100000+(total as i64)*1000;
                let slot:i32=-1;let price:i32=-1;
                let bf:i32=rt_build(&s,hw,sunk,fought,ow,hw,1,epb,&slot,&price,&epb);
                if(price!=exp_p){bf=bf+100;}
                let e0:i64=epb;
                let cf:i32=rt_cite_n(&s,slot,price,epb,&epb);
                let rc1:i32=rt_destroy(&s,slot,del);
                if(bf!=0 || cf!=0 || rc1!=ST_OK){
                    _zag_print("RT_R1_SETUP_FAIL sk=");rt_pi(sk as i64);
                    _zag_print(" del=");rt_pi(del as i64);
                    _zag_print(" fm=");rt_pi(fmode as i64);
                    _zag_print(" bf=");rt_pi(bf as i64);
                    _zag_print(" cf=");rt_pi(cf as i64);
                    _zag_print(" rc1=");rt_pi(rc1 as i64);
                    _zag_print("\n");
                    fails=fails+1;
                } else {
                    // Re-add: must reuse the freed slot (delete never recycles the slot,
                    // but the slot NUMBER is reusable by a new judgment).
                    let slot2:i32=-1;
                    let ar:i32=st_add(&s,71,ST_REGION_USER,80,-1,&slot2);
                    if(slot2!=slot){
                        _zag_print("RT_R1_SLOT_MISMATCH\n");
                        fails=fails+1;
                    }
                    st_justify(&s,slot2,1);
                    let p2:i32=-1;
                    st_deliberate(&s,slot2,&p2);
                    // Attack: re-cite spent E (+ f fresh, f < p2 except control fmode 3).
                    let nsp:i32=price; // how many of E to re-cite
                    if(fmode==4){nsp=(price+1)/2;}
                    let i:i32=0;
                    let badcite:i32=0;
                    while(i<nsp){
                        if(st_evidence(&s,slot2,1,e0+(i as i64))!=ST_OK){badcite=badcite+1;}
                        i=i+1;
                    }
                    let f:i32=0;
                    if(fmode==1){f=p2-1;if(f<0){f=0;}}
                    if(fmode==2){f=p2/2;}
                    if(fmode==3){f=p2;} // honest control: full fresh payment
                    if(fmode==4){f=p2-1;if(f<0){f=0;}}
                    let cf2:i32=rt_cite_n(&s,slot2,f,epb,&epb);
                    let rc2:i32=rt_destroy(&s,slot2,del);
                    if(fmode==3){
                        // control: honest full-fresh payment must succeed
                        if(rc2!=ST_OK || badcite!=0 || cf2!=0){
                            _zag_print("RT_R1_CONTROL_FAIL sk=");rt_pi(sk as i64);
                            _zag_print(" rc2=");rt_pi(rc2 as i64);
                            _zag_print("\n");
                            fails=fails+1;
                        }
                    } else {
                        // attack: spent cites in window, fresh < price -> must be 121, never OK
                        if(rc2==ST_OK){
                            _zag_print("RT_R1_HOLE sk=");rt_pi(sk as i64);
                            _zag_print(" del=");rt_pi(del as i64);
                            _zag_print(" fm=");rt_pi(fmode as i64);
                            _zag_print(" p2=");rt_pi(p2 as i64);
                            _zag_print("\n");
                            holes=holes+1;
                            fails=fails+1;
                        } else {
                            if(rc2!=ST_REFUSED_CONSUMED){
                                _zag_print("RT_R1_UNEXPECTED_RC sk=");rt_pi(sk as i64);
                                _zag_print(" rc2=");rt_pi(rc2 as i64);
                                _zag_print("\n");
                                fails=fails+1;
                            }
                        }
                    }
                    if(st_replay_check(&s)!=ST_OK){
                        _zag_print("RT_R1_REPLAY_FAIL\n");
                        fails=fails+1;
                    }
                }
                fmode=fmode+1;
            }
            del=del+1;
        }
        sk=sk+1;
    }
    _zag_print("RT_R1 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

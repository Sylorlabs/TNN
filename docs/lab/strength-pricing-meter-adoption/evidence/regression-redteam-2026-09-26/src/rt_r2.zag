// rt_r2.zag — R2: cross-slot double-spend.
// Cite E on slot A and slot B. Destroy A (consumes E store-wide). B's destruction
// must then fail 121 (E tombstoned), never succeed on E's credit.
// 4 pa x 4 pb x 2 orders x 2 delA x 2 delB = 128 sequences.
@import("rt_common.zag")

fn rt_r2_pa(id:i32,o_hw:*i32,o_sunk:*i32,o_fought:*i32)void {
    let hw:i32=80;let sunk:i32=0;let fought:i32=0;
    if(id==2){sunk=2;}
    if(id==3){sunk=3;}
    if(id==4){sunk=3;fought=1;}
    o_hw.*=hw;o_sunk.*=sunk;o_fought.*=fought;
}

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let ia:i32=1;
    while(ia<=4){
        let hwa:i32=0;let sunka:i32=0;let foughta:i32=0;
        rt_r2_pa(ia,&hwa,&sunka,&foughta);
        let ib:i32=1;
        while(ib<=4){
            let hwb:i32=0;let sunkb:i32=0;let foughtb:i32=0;
            rt_r2_pa(ib,&hwb,&sunkb,&foughtb);
            let order:i32=0;
            while(order<=1){
                let delA:i32=0;
                while(delA<=1){
                    let delB:i32=0;
                    while(delB<=1){
                        total=total+1;
                        let s:StStore=rt_new();
                        let epb:i64=200000+(total as i64)*1000;
                        // Slot A
                        let slotA:i32=-1;let pa:i32=-1;
                        let bf:i32=rt_build(&s,hwa,sunka,foughta,0,hwa,1,epb,&slotA,&pa,&epb);
                        if(pa!=ia){bf=bf+100;}
                        let ea0:i64=epb;
                        let cfa:i32=rt_cite_n(&s,slotA,pa,epb,&epb);
                        // Slot B
                        let slotB:i32=-1;let pb:i32=-1;
                        bf=bf+rt_build(&s,hwb,sunkb,foughtb,0,hwb,1,epb,&slotB,&pb,&epb);
                        if(pb!=ib){bf=bf+100;}
                        if(slotB==slotA){bf=bf+1000;}
                        let k:i32=pa;
                        if(pb<k){k=pb;} // double-spend min(pa,pb) of E on B
                        let setup_ok:i32=1;
                        if(bf!=0 || cfa!=0){setup_ok=0;}
                        let rcA:i32=-999;
                        let rcB:i32=-999;
                        if(order==0){
                            // cite E on B first (fresh at the time), then destroy A
                            let i:i32=0;
                            while(i<k){
                                if(st_evidence(&s,slotB,1,ea0+(i as i64))!=ST_OK){setup_ok=0;}
                                i=i+1;
                            }
                            rcA=rt_destroy(&s,slotA,delA);
                            if(rcA!=ST_OK){setup_ok=0;}
                            // top B up with (pb-k) fresh (spent cites don't count to fullness)
                            let cf2:i32=rt_cite_n(&s,slotB,pb-k,epb,&epb);
                            if(cf2!=0){setup_ok=0;}
                            rcB=rt_destroy(&s,slotB,delB);
                        } else {
                            // destroy A first, then re-cite spent E on B.
                            // VARIANT A (adopted 2026-09-26): E is tombstoned
                            // store-wide; B's cites refuse 121 AT CITE TIME.
                            // The attack is defeated at cite time, not at
                            // destruction. B's destruction then finds only
                            // the (pb-k) fresh cites -> 109 (no E credit).
                            rcA=rt_destroy(&s,slotA,delA);
                            if(rcA!=ST_OK){setup_ok=0;}
                            let spent121:i32=0;
                            let i:i32=0;
                            while(i<k){
                                if(st_evidence(&s,slotB,1,ea0+(i as i64))==ST_REFUSED_CONSUMED){spent121=spent121+1;}
                                i=i+1;
                            }
                            if(spent121!=k){setup_ok=0;}
                            let cf2:i32=rt_cite_n(&s,slotB,pb-k,epb,&epb);
                            if(cf2!=0){setup_ok=0;}
                            rcB=rt_destroy(&s,slotB,delB);
                            // variant-A oracle (runs here, not in the outer
                            // else): B must NOT succeed on E's credit; 109 is
                            // the lawful refusal. Mark oracle done.
                            if(rcB==ST_OK){
                                _zag_print("RT_R2_HOLE_A pa=");rt_pi(ia as i64);
                                _zag_print(" pb=");rt_pi(ib as i64);
                                _zag_print("\n");
                                holes=holes+1;
                                fails=fails+1;
                            } else {
                                if(rcB!=ST_REFUSED_EFFORT){
                                    _zag_print("RT_R2_UNEXPECTED_RC_A rcB=");rt_pi(rcB as i64);
                                    _zag_print("\n");
                                    fails=fails+1;
                                }
                            }
                            // force the outer if to take the setup_ok==1 path
                            // but skip its oracle via the order flag below
                        }
                        if(setup_ok==0){
                            _zag_print("RT_R2_SETUP_FAIL pa=");rt_pi(ia as i64);
                            _zag_print(" pb=");rt_pi(ib as i64);
                            _zag_print(" ord=");rt_pi(order as i64);
                            _zag_print(" rcA=");rt_pi(rcA as i64);
                            _zag_print("\n");
                            fails=fails+1;
                        } else if(order==0) {
                            // oracle: B's destruction must NOT succeed on E's credit
                            if(rcB==ST_OK){
                                _zag_print("RT_R2_HOLE pa=");rt_pi(ia as i64);
                                _zag_print(" pb=");rt_pi(ib as i64);
                                _zag_print(" ord=");rt_pi(order as i64);
                                _zag_print(" delB=");rt_pi(delB as i64);
                                _zag_print("\n");
                                holes=holes+1;
                                fails=fails+1;
                            } else {
                                if(rcB!=ST_REFUSED_CONSUMED){
                                    _zag_print("RT_R2_UNEXPECTED_RC rcB=");rt_pi(rcB as i64);
                                    _zag_print("\n");
                                    fails=fails+1;
                                }
                            }
                        }
                        if(st_replay_check(&s)!=ST_OK){
                            _zag_print("RT_R2_REPLAY_FAIL\n");
                            fails=fails+1;
                        }
                        delB=delB+1;
                    }
                    delA=delA+1;
                }
                order=order+1;
            }
            ib=ib+1;
        }
        ia=ia+1;
    }
    _zag_print("RT_R2 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

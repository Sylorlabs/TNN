// rt_r3.zag — R3: weakening + framing.
// Identical stores; one framed JUSTIFY tier 1, one tier 7 (plus no-justify and
// multi-justify framings). Meter price must be identical: JUSTIFY tier is not a
// meter input, and high-water + fought history must survive WEAKEN.
// 12 skeletons x 9 framings = 108 sequences.
@import("rt_common.zag")

fn rt_r3_skel(id:i32,o_hw:*i32,o_sunk:*i32,o_fought:*i32,o_ow:*i32)void {
    let hw:i32=80;let sunk:i32=0;let fought:i32=0;let ow:i32=0;
    if(id==1){hw=80;}
    if(id==2){hw=20;}
    if(id==3){hw=50;}
    if(id==4){hw=80;sunk=2;}
    if(id==5){hw=80;sunk=3;}
    if(id==6){hw=80;sunk=3;fought=1;}
    if(id==7){hw=80;sunk=2;ow=1;}
    if(id==8){hw=30;sunk=1;}
    if(id==9){hw=90;fought=2;}
    if(id==10){hw=76;sunk=3;ow=1;}
    if(id==11){hw=25;}
    if(id==12){hw=26;sunk=1;fought=1;}
    o_hw.*=hw;o_sunk.*=sunk;o_fought.*=fought;o_ow.*=ow;
}

// Build one slot with a given framing: f 0..6 -> tier f+1; 7 -> no justify; 8 -> multi.
fn rt_r3_build(s:*StStore,hw:i32,sunk:i32,fought:i32,ow:i32,f:i32,
               epb:i64,o_slot:*i32,o_price:*i32,o_epb:*i64)i32 {
    let fails:i32=0;
    let slot:i32=-1;
    if(st_add(s,70,ST_REGION_USER,hw,-1,&slot)!=ST_OK){fails=fails+1;}
    if(ow==1){
        if(st_justify(s,slot,1)!=ST_OK){fails=fails+1;}
        let p0:i32=-1;
        if(st_deliberate(s,slot,&p0)!=ST_OK){fails=fails+1;}
        let i:i32=0;
        while(i<p0){
            if(st_evidence(s,slot,1,epb)!=ST_OK){fails=fails+1;}
            epb=epb+1;i=i+1;
        }
        if(st_overwrite(s,slot,70,hw,-1)!=ST_OK){fails=fails+1;}
    }
    let j:i32=0;
    while(j<sunk){
        if(st_evidence(s,slot,1,epb)!=ST_OK){fails=fails+1;}
        epb=epb+1;j=j+1;
    }
    let k:i32=0;
    while(k<fought){
        let ns:i32=hw-10;
        if(ns<1){ns=1;}
        if(st_weaken(s,slot,ns,1)!=ST_OK){fails=fails+1;}
        k=k+1;
    }
    if(fought==0 && sunk>0){
        if(st_strengthen(s,slot,hw,1)!=ST_OK){fails=fails+1;}
    }
    if(f<=6){
        if(st_justify(s,slot,f+1)!=ST_OK){fails=fails+1;}
    }
    if(f==8){
        if(st_justify(s,slot,2)!=ST_OK){fails=fails+1;}
        if(st_justify(s,slot,5)!=ST_OK){fails=fails+1;}
        if(st_justify(s,slot,7)!=ST_OK){fails=fails+1;}
    }
    let price:i32=-1;
    if(st_deliberate(s,slot,&price)!=ST_OK){fails=fails+1;}
    o_slot.*=slot;o_price.*=price;o_epb.*=epb;
    return fails;
}

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let sk:i32=1;
    while(sk<=12){
        let hw:i32=0;let sunk:i32=0;let fought:i32=0;let ow:i32=0;
        rt_r3_skel(sk,&hw,&sunk,&fought,&ow);
        let exp_p:i32=rt_predict(hw,sunk,fought,ow);
        // one store, 9 slots (meter is per-slot, so framings are isolated)
        let s:StStore=rt_new();
        let epb:i64=300000+(sk as i64)*10000;
        let base:i32=-1;
        let f:i32=0;
        while(f<=8){
            total=total+1;
            let slot:i32=-1;let price:i32=-1;
            let bf:i32=rt_r3_build(&s,hw,sunk,fought,ow,f,epb,&slot,&price,&epb);
            if(f==0){base=price;}
            if(bf!=0){
                _zag_print("RT_R3_SETUP_FAIL sk=");rt_pi(sk as i64);
                _zag_print(" f=");rt_pi(f as i64);
                _zag_print("\n");
                fails=fails+1;
            } else {
                if(f==0 && price!=exp_p){
                    _zag_print("RT_R3_PREDICT_MISMATCH sk=");rt_pi(sk as i64);
                    _zag_print(" price=");rt_pi(price as i64);
                    _zag_print(" exp=");rt_pi(exp_p as i64);
                    _zag_print("\n");
                    fails=fails+1;
                }
                if(price!=base){
                    _zag_print("RT_R3_HOLE sk=");rt_pi(sk as i64);
                    _zag_print(" framing=");rt_pi(f as i64);
                    _zag_print(" price=");rt_pi(price as i64);
                    _zag_print(" base=");rt_pi(base as i64);
                    _zag_print("\n");
                    holes=holes+1;
                    fails=fails+1;
                }
            }
            f=f+1;
        }
        if(st_replay_check(&s)!=ST_OK){
            _zag_print("RT_R3_REPLAY_FAIL\n");
            fails=fails+1;
        }
        sk=sk+1;
    }
    _zag_print("RT_R3 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

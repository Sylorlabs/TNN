// rt_common.zag — shared helpers for the fresh meter red-team.
// Pure Zag, zero RNG. Each rt_rN.zag imports this.
@import("strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

// Fresh store: METER + GLOBAL + FULL + HIST (hist only matters for DELIB kind tests).
fn rt_new()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}

// Predict the meter price for a skeleton (sanity oracle for setups).
fn rt_predict(hw:i32,sunk:i32,fought:i32,ow:i32)i32 {
    let m:i32=2;
    if(hw>=76){m=m+1;}
    if(hw<=25){m=m-1;}
    if(sunk>=3){m=m+1;}
    if(sunk==0){m=m-1;}
    if(fought>0){m=m+1;}
    if(ow==0){m=m-1;}
    if(m<0){m=0;}
    if(m>4){m=4;}
    return m;
}

// Build a priced judgment on a fresh slot.
// ow=1: pay for an overwrite (to ow_str) before the sunk cites.
// tier<0: skip justify. Returns setup-fail count; slot/price/next-ep via outs.
fn rt_build(s:*StStore,hw:i32,sunk:i32,fought:i32,ow:i32,ow_str:i32,
            tier:i32,epb:i64,o_slot:*i32,o_price:*i32,o_epb:*i64)i32 {
    let fails:i32=0;
    let slot:i32=-1;
    if(st_add(s,70,ST_REGION_USER,hw,-1,&slot)!=ST_OK){fails=fails+1;}
    if(ow==1){
        if(st_justify(s,slot,1)!=ST_OK){fails=fails+1;}
        let p0:i32=-1;
        if(st_deliberate(s,slot,&p0)!=ST_OK){fails=fails+1;}
        let i:i32=0;
        while(i<p0){
            if(st_evidence(s,slot,1,epb)!=ST_OK){fails=fails+1;}
            epb=epb+1;i=i+1;
        }
        if(st_overwrite(s,slot,70,ow_str,-1)!=ST_OK){fails=fails+1;}
    }
    let j:i32=0;
    while(j<sunk){
        if(st_evidence(s,slot,1,epb)!=ST_OK){fails=fails+1;}
        epb=epb+1;j=j+1;
    }
    let k:i32=0;
    while(k<fought){
        let ns:i32=hw-10;
        if(ns<1){ns=1;}
        if(st_weaken(s,slot,ns,1)!=ST_OK){fails=fails+1;}
        k=k+1;
    }
    if(fought==0 && sunk>0){
        if(st_strengthen(s,slot,hw,1)!=ST_OK){fails=fails+1;}
    }
    if(tier>=0){
        if(st_justify(s,slot,tier)!=ST_OK){fails=fails+1;}
    }
    let price:i32=-1;
    if(st_deliberate(s,slot,&price)!=ST_OK){fails=fails+1;}
    o_slot.*=slot;
    o_price.*=price;
    o_epb.*=epb;
    return fails;
}

// Cite n fresh eps from epb. Returns count of cites whose rc != 0.
fn rt_cite_n(s:*StStore,slot:i32,n:i32,epb:i64,o_epb:*i64)i32 {
    let bad:i32=0;
    let i:i32=0;
    while(i<n){
        if(st_evidence(s,slot,1,epb)!=ST_OK){bad=bad+1;}
        epb=epb+1;i=i+1;
    }
    o_epb.*=epb;
    return bad;
}

// Destroy via kill_evidenced (del=0) or delete_strong (del=1).
fn rt_destroy(s:*StStore,slot:i32,del:i32)i32 {
    if(del==1){return st_delete_strong(s,slot);}
    return st_kill_evidenced(s,slot);
}

// Read packed r1 (HELD_STRONG) from the slot's latest deliberate record.
fn rt_r1_of(s:*StStore,slot:i32)i32 {
    let n:i32=s.*.audit_n;
    let lss:i32=st_last_strength_idx(s,slot,n);
    let di:i32=st_last_delib_idx(s,slot,lss,n);
    if(di<0){return -1;}
    let a3:i32=st_aw(s,di,13);
    return a3 & 255;
}

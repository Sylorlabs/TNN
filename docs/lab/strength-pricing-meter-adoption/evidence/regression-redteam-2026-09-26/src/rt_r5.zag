// rt_r5.zag — R5: kind-switch.
// A METER-mode destruction must be funded by a METER-kind (3) deliberation.
// Deliberations under DELIB kinds (1/2), or none, or a stale (pre-overwrite)
// record must give dry-run -1 and destruction 122, and the checker must agree.
// 6 scenarios x 20 variants (5 strengths x 2 destroy-ops x 2 cite-modes) = 120.
@import("rt_common.zag")

// Build a judged slot under the given price mode + personality. Returns rc of deliberate.
fn rt_r5_setup(s:*StStore,hw:i32,pm:i32,pers:i32,dodelib:i32,
               epb:i64,o_slot:*i32,o_price:*i32,o_epb:*i64)i32 {
    st_set_price_mode(s,pm);
    st_set_delib_personality(s,pers);
    let slot:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,hw,-1,&slot);
    if(rc==ST_OK){rc=st_justify(s,slot,1);}
    let price:i32=-1;
    if(rc==ST_OK && dodelib==1){rc=st_deliberate(s,slot,&price);}
    o_slot.*=slot;o_price.*=price;o_epb.*=epb;
    return rc;
}

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let sc:i32=0;
    while(sc<=5){
        let vi:i32=0;
        while(vi<=19){
            let hw:i32=80;
            let vv:i32=vi/4;
            if(vv==1){hw=50;}
            if(vv==2){hw=20;}
            if(vv==3){hw=90;}
            if(vv==4){hw=30;}
            let del:i32=(vi/2)%2;
            let xc:i32=vi%2; // 1: cite extra fresh eps before destroy (must not bypass)
            total=total+1;
            let s:StStore=rt_new();
            let epb:i64=500000+(total as i64)*1000;
            let slot:i32=-1;let price:i32=-1;
            let rc:i32=-999;
            let dry:i32=-999;
            let rcd:i32=-999;
            let ckf:i32=-999;
            let ok:i32=1;
            if(sc==0 || sc==1){
                // a/b: deliberate under DELIB (HIST/FRESH), then switch to METER
                let pers:i32=ST_DELIB_HIST;
                if(sc==1){pers=ST_DELIB_FRESH;}
                rc=rt_r5_setup(&s,hw,ST_PRICE_DELIB,pers,1,epb,&slot,&price,&epb);
                st_set_price_mode(&s,ST_PRICE_METER);
            }
            if(sc==2 || sc==3){
                // c/d: deliberate under METER, then switch to DELIB (HIST/FRESH)
                rc=rt_r5_setup(&s,hw,ST_PRICE_METER,ST_DELIB_HIST,1,epb,&slot,&price,&epb);
                let pers:i32=ST_DELIB_HIST;
                if(sc==3){pers=ST_DELIB_FRESH;}
                st_set_price_mode(&s,ST_PRICE_DELIB);
                st_set_delib_personality(&s,pers);
            }
            if(sc==4){
                // e: METER, no deliberation at all
                rc=rt_r5_setup(&s,hw,ST_PRICE_METER,ST_DELIB_HIST,0,epb,&slot,&price,&epb);
            }
            if(sc==5){
                // f: METER deliberate, then priced overwrite -> stale record
                rc=rt_r5_setup(&s,hw,ST_PRICE_METER,ST_DELIB_HIST,1,epb,&slot,&price,&epb);
                if(rc==ST_OK){
                    let cf:i32=rt_cite_n(&s,slot,price,epb,&epb);
                    if(cf!=0){ok=0;}
                    rc=st_overwrite(&s,slot,70,hw,-1);
                    if(xc==1){rc=st_justify(&s,slot,2);} // re-justify must not rescue
                }
            }
            if(rc!=ST_OK){ok=0;}
            if(ok==1){
                if(xc==1 && sc<=4){
                    // extra fresh cites: must not bypass the kind binding
                    let cf:i32=rt_cite_n(&s,slot,3,epb,&epb);
                    if(cf!=0){ok=0;}
                }
                dry=st_deliberate_dryrun(&s,slot);
                rcd=rt_destroy(&s,slot,del);
                let ps:*StStore=&s;
                let n:i32=ps.*.audit_n;
                let lss:i32=st_last_strength_idx(&s,slot,n);
                ckf=ck_verify_delib_binding(&s,slot,lss,n);
                // oracles: dry-run -1, destruction 122, checker disagrees (>0)
                if(dry!=-1 || rcd!=ST_REFUSED_NODELIB || ckf<=0){
                    _zag_print("RT_R5_HOLE sc=");rt_pi(sc as i64);
                    _zag_print(" vi=");rt_pi(vi as i64);
                    _zag_print(" dry=");rt_pi(dry as i64);
                    _zag_print(" rcd=");rt_pi(rcd as i64);
                    _zag_print(" ckf=");rt_pi(ckf as i64);
                    _zag_print("\n");
                    holes=holes+1;
                    fails=fails+1;
                }
                if(st_replay_check(&s)!=ST_OK){
                    _zag_print("RT_R5_REPLAY_FAIL\n");
                    fails=fails+1;
                }
            } else {
                _zag_print("RT_R5_SETUP_FAIL sc=");rt_pi(sc as i64);
                _zag_print(" vi=");rt_pi(vi as i64);
                _zag_print(" rc=");rt_pi(rc as i64);
                _zag_print("\n");
                fails=fails+1;
            }
            vi=vi+1;
        }
        sc=sc+1;
    }
    _zag_print("RT_R5 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

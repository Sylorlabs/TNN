@import("rt_ingest_lib.zag")
// rt_h.zag — RT-H1: call the GENUINE sc_seal_tail twice on a 10-slot store.
// rt_ingest_lib.zag is byte-identical to build/ingest.zag except main renamed.
fn h_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn hex32(b:[]u8)[]u8 {
    let o:[]u8=sc_alloc(64);
    ig_hex32(b,o);
    return o;
}
fn main()void {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    if(sc_store_init(100,&st)!=0){_zag_println("RT_H1,FAIL,init");return;}
    let i:i32=0;
    while(i<10){
        let slot:i32=-1;
        if(sc_add(&st,i,1000+(i as i64),&slot)!=0){_zag_println("RT_H1,FAIL,add");return;}
        i=i+1;
    }
    if(sc_seal_tail(&st)!=0){_zag_println("RT_H1,FAIL,seal1");return;}
    _zag_print("RT_H1,nsealed_after_1st=");_zag_print(h_i64s(st.nsealed as i64));
    if(sc_seal_final(&st)!=0){_zag_println(",FAIL,final1");return;}
    let seal1:[]u8=hex32(st.seal);
    _zag_print(",seal1=");_zag_print(seal1);_zag_println("");
    let ch0a:[]u8=sc_alloc(32);
    let k:i32=0;
    while(k<32){ch0a[k]=st.chain[k];k=k+1;}
    // NOTE: chain buffer is nchunks*32 = 32 bytes here; entry index 1 would be OOB.
    if(sc_seal_tail(&st)!=0){_zag_println("RT_H1,FAIL,seal2");return;}
    _zag_print("RT_H1,nsealed_after_2nd=");_zag_print(h_i64s(st.nsealed as i64));
    let chainsame:i32=1;
    k=0;
    while(k<32){
        if(st.chain[k]!=ch0a[k]){chainsame=0;}
        k=k+1;
    }
    _zag_print(",chain0_rewritten_identical=");_zag_print(h_i64s(chainsame as i64));
    _zag_println("");
    _zag_println("RT_H1,calling_seal_final_after_2nd_seal...");
    if(sc_seal_final(&st)!=0){_zag_println("RT_H1,seal_final_rc_nonzero");return;}
    let seal2:[]u8=hex32(st.seal);
    _zag_print("RT_H1,seal2=");_zag_println(seal2);
}

@import("rt_ingest_lib.zag")
// rt_g.zag — RT-G1: for every sealed slot, take its STORED blob offset,
// seek to (off/CHUNK, off%CHUNK) in the blob files, parse the record header
// there, and check the header's id == the slot's id. Counts mismatches.
// usage: rt_g <storedir>
const G_CHUNK:i64=33488896;

fn g_rval(b:[]u8,o:i32,w:i32,signed:i32)i64 {
    if(w==8){return sc_g64(b,o as i64);}
    if(w==4){
        let v:i32=sc_g32(b,o);
        if(signed!=0){return v as i64;}
        return (v as i64)&4294967295;
    }
    if(w==2){
        let v:i32=((b[o] as i32)&255)|((((b[o+1] as i32)&255))<<8);
        if(signed!=0&&v>=32768){return (v-65536) as i64;}
        return v as i64;
    }
    let v2:i32=(b[o] as i32)&255;
    if(signed!=0&&v2>=128){return (v2-256) as i64;}
    return v2 as i64;
}
fn h3_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn main()void {
    let dir:[]u8=_zag_arg(1);
    let nm:[]u8=ig_join(dir,"store.dat");
    let fd:i64=ig_open_rdonly(nm);
    if(fd<0){_zag_println("RT_G1,FAIL,store_open");return;}
    let d:[]u8=sc_alloc(4194304);
    if(d.len==0){_zag_println("RT_G1,FAIL,alloc");return;}
    let dn:i32=0;
    while(1){
        let g:i32=ig_read_into(fd,d[dn..]);
        if(g<0){_zag_println("RT_G1,FAIL,store_read");return;}
        if(g==0){break;}
        dn=dn+g;
    }
    ig_close(fd);
    let n:i32=sc_g32(d,12);
    let nsealed:i32=sc_g32(d,16);
    let nchunks:i32=sc_g32(d,20);
    let ctab:[]u8=sc_alloc(nsealed*8);
    let o:i32=28+nchunks;
    let c:i32=0;
    while(c<nsealed){
        let ln:i32=sc_g32(d,o);
        let wtag:i32=(d[28+c] as i32)&255;
        let w:i32=wtag&15;
        let sg:i32=0;
        if((wtag&16)!=0){sg=1;}
        sc_s32(ctab,c*8,o+4);
        ctab[c*8+4]=w as u8;
        ctab[c*8+5]=sg as u8;
        o=o+4+ln;
        c=c+1;
    }
    // blob chunk buffer (one at a time)
    let cb:[]u8=sc_alloc(G_CHUNK as i32);
    if(cb.len==0){_zag_println("RT_G1,FAIL,chunk_alloc");return;}
    let loaded:i64=-1;
    let wrong:[]u8=sc_alloc(nsealed*8);
    let firstw:[]u8=sc_alloc(nsealed*8);
    c=0;
    while(c<nsealed){sc_s64(firstw,(c*8) as i64,-1);c=c+1;}
    let total_wrong:i64=0;
    let idx:i32=0;
    while(idx<n){
        let sc2:i32=idx/4096;
        let k2:i32=idx%4096;
        let cst:i32=sc_g32(ctab,sc2*8);
        let w2:i32=(ctab[sc2*8+4] as i32)&255;
        let sg2:i32=(ctab[sc2*8+5] as i32)&255;
        let stored:i64=g_rval(d,cst+k2*w2,w2,sg2);
        let ci:i64=stored/G_CHUNK;
        let ino:i64=stored%G_CHUNK;
        let ok:i32=0;
        if(ino+11<=G_CHUNK){
            if(ci!=loaded){
                // build "<dir>/blob_<6 digits>.dat"
                let pre:[]u8=ig_join(dir,"blob_");
                let bn:[]u8=sc_alloc(pre.len+10);
                if(bn.len==0){_zag_println("RT_G1,FAIL,name_alloc");return;}
                let j0:i32=0;
                while(j0<pre.len){bn[j0]=pre[j0];j0=j0+1;}
                let v:i64=ci;
                let p:i32=5;
                while(p>=0){
                    bn[pre.len+p]=((v%10) as i32+48) as u8;
                    v=v/10;
                    p=p-1;
                }
                bn[pre.len+6]=46; bn[pre.len+7]=100; bn[pre.len+8]=97; bn[pre.len+9]=116;
                let bfd:i64=ig_open_rdonly(bn);
                if(bfd>=0){
                    let got:i32=0;
                    while(got<cb.len){
                        let r2:i32=ig_read_into(bfd,cb[got..]);
                        if(r2<=0){break;}
                        got=got+r2;
                    }
                    ig_close(bfd);
                    if(got==cb.len){loaded=ci;}
                }
            }
            if(ci==loaded){
                let o2:i32=ino as i32;
                let rid:i32=sc_g32(cb,o2+1);
                let kind:i32=(cb[o2] as i32)&255;
                if(kind>=1&&kind<=4&&rid==idx){ok=1;}
            }
        }
        if(ok==0){
            total_wrong=total_wrong+1;
            let pw:i64=sc_g64(wrong,(sc2*8) as i64);
            sc_s64(wrong,(sc2*8) as i64,pw+1);
            if(sc_g64(firstw,(sc2*8) as i64)==-1){
                sc_s64(firstw,(sc2*8) as i64,idx as i64);
                _zag_print("RT_G1,first_wrong,slotchunk=");_zag_print(h3_i64s(sc2 as i64));
                _zag_print(",slot=");_zag_print(h3_i64s(idx as i64));
                _zag_print(",stored_off=");_zag_print(h3_i64s(stored));
                _zag_print(",seeks_to_chunk=");_zag_print(h3_i64s(ci));
                _zag_println("");
            }
        }
        idx=idx+1;
    }
    c=0;
    while(c<nsealed){
        let cnt:i32=4096;
        if(c==nsealed-1){cnt=n-(nsealed-1)*4096;}
        _zag_print("RT_G1,chunk=");_zag_print(h3_i64s(c as i64));
        _zag_print(",slots=");_zag_print(h3_i64s(cnt as i64));
        _zag_print(",wrong=");_zag_print(h3_i64s(sc_g64(wrong,(c*8) as i64)));
        _zag_println("");
        c=c+1;
    }
    _zag_print("RT_G1,total_slots=");_zag_print(h3_i64s(n as i64));
    _zag_print(",total_wrong=");_zag_print(h3_i64s(total_wrong));
    _zag_println(",ok=1");
}

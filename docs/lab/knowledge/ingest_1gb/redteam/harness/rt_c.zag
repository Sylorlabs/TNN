@import("../../tnn-lab/ops/storage-compression/adopt/s5_merge.zag")
// rt_c.zag — RT-C: colluding-origin attacks on the CANONICAL adopt/s5_merge.zag.
// Modes: c1 (R2 replication) | c2 (2nd colluding origin) | c3 (>=3-origin rule) | c4 (rotating forged pool).
// Pure Zag, zero RNG (splitmix64-of-index fixtures only). Build from adopt/:
//   znc <thisfile> -o rt_c --no-analyze   (run with cwd=adopt/ so imports resolve)

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn golden()i64 { return 0x9E3779B97F4A7C15 as i64; }
fn rmix(state:i64)i64 {
    let g:i64=golden();
    let x:i64=state+g;
    let z:i64=x;
    z=((z^(z>>30))*(0xBF58476D1CE4E5B9 as i64));
    z=((z^(z>>27))*(0x94D049BB133111EB as i64));
    return z^(z>>31);
}
fn rdraw(seed:i64,idx:i64)i64 { return rmix(seed+(idx+1)*golden()); }
fn urmod(d:i64,r:i64)i64 {
    let v:i64=d%r;
    if(v<0){v=v+r;}
    return v;
}
fn tval(c:i64)i64 { return c|((urmod(c,32))<<20)|(c<<32); }
fn lval(c:i64)i64 { return c|(((urmod(c,32))^31)<<20)|((c^24575)<<32); }
fn nval(c:i64,h:i64)i64 { return c|(((urmod(c,32))^7)<<20)|(h<<32); }

fn st_new()ScStore {
    return ScStore{.cap=0,.n=0,.cslots=0,.nchunks=0,.chunk_ptrs="",
        .chashes="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_rev=0,.ops_del=0,
        .ops_verify=0,.ops_audit=0,.ops_find=0};
}
fn rfail(tag:[]u8,msg:[]u8)void {
    _zag_print(tag);_zag_print(",FAIL,");_zag_println(msg);
}
// bad-assert helper: assert lie L under orgs listed in orgs[0..norg)
fn bad_assert(st:*ScStore,g:*ScMergeGate,L:i64,orgs:[]u8,norg:i32,tag:[]u8)i32 {
    let i:i32=0;
    while(i<norg){
        let slot:i32=-1; let mrg:i32=-1;
        let org:i32=(orgs[i] as i32)&255;
        if(mg_add(st,g,L,40+i,org,&slot,&mrg)!=0){rfail(tag,"mg_add_bad");return 1;}
        i=i+1;
    }
    return 0;
}
// honest asserts for claim c: 40 sources, 1/3 noise inventing own false object
fn honest_assert(st:*ScStore,g:*ScMergeGate,c:i64,tag:[]u8)i32 {
    let h:i64=0;
    while(h<40){
        let v:i64=tval(c);
        if(urmod(rdraw(11,c*64+h),3)==0){v=nval(c,h);}
        let slot:i32=-1; let mrg:i32=-1;
        if(mg_add(st,g,v,h as i32,h as i32,&slot,&mrg)!=0){rfail(tag,"mg_add_honest");return 1;}
        h=h+1;
    }
    return 0;
}
// learning-read tie: installed value's slot must recall the value
fn tie_check(st:*ScStore,slot:i32,v:i64,tag:[]u8)i32 {
    let rv:i64=0;
    if(sc_recall(st,slot,&rv)!=1){rfail(tag,"tie_recall");return 1;}
    if(rv!=v){rfail(tag,"tie_value");return 1;}
    return 0;
}

fn mode_c1()void {
    let st:ScStore=st_new();
    if(sc_store_init(32768,128,&st)!=0){rfail("RT_C1","init");return;}
    let g:ScMergeGate=mg_new();
    if(mg_init(&g,15)!=0){rfail("RT_C1","ginit");return;}
    let c:i64=0;
    while(c<1000){
        if(honest_assert(&st,&g,c,"RT_C1")!=0){return;}
        let i:i32=0;
        while(i<8){
            let slot:i32=-1; let mrg:i32=-1;
            if(mg_add(&st,&g,lval(c),40+i,60,&slot,&mrg)!=0){rfail("RT_C1","addsock");return;}
            i=i+1;
        }
        c=c+1;
    }
    let fa_src:i64=0; let fa_org:i64=0; let ti_src:i64=0; let ti_org:i64=0;
    c=0;
    while(c<1000){
        let slot:i32=0; let a:i32=0; let ns:i32=0; let no:i32=0;
        if(mg_query(&g,tval(c),&slot,&a,&ns,&no)==1){
            if(ns>=2){ti_src=ti_src+1;}
            if(no>=2){ti_org=ti_org+1;}
            if(ns>=2||no>=2){
                if(tie_check(&st,slot,tval(c),"RT_C1")!=0){return;}
            }
        }
        let s2:i32=0; let a2:i32=0; let ns2:i32=0; let no2:i32=0;
        if(mg_query(&g,lval(c),&s2,&a2,&ns2,&no2)!=1){rfail("RT_C1","lie_missing");return;}
        if(ns2>=2){fa_src=fa_src+1;}
        if(no2>=2){fa_org=fa_org+1;}
        c=c+1;
    }
    if(mg_replay_check(&st,&g)!=0){rfail("RT_C1","mgreplay");return;}
    if(sc_replay_check(&st)!=0){rfail("RT_C1","screplay");return;}
    if(fa_org!=0){rfail("RT_C1","org_false_install");return;}
    if(fa_src<1){rfail("RT_C1","attack_did_not_land");return;}
    _zag_print("RT_C1,claims=1000,fa_src=");_zag_print(i64s(fa_src));
    _zag_print(",fa_org=");_zag_print(i64s(fa_org));
    _zag_print(",ti_src=");_zag_print(i64s(ti_src));
    _zag_print(",ti_org=");_zag_print(i64s(ti_org));
    _zag_println(",ok=1");
}

// mode_c2: second colluding origin asserts the lie under forged org ids 7,8
fn mode_c2()void {
    let st:ScStore=st_new();
    if(sc_store_init(16384,128,&st)!=0){rfail("RT_C2","init");return;}
    let g:ScMergeGate=mg_new();
    if(mg_init(&g,14)!=0){rfail("RT_C2","ginit");return;}
    let c:i64=0;
    while(c<500){
        if(honest_assert(&st,&g,c,"RT_C2")!=0){return;}
        let i:i32=0;
        while(i<8){
            let slot:i32=-1; let mrg:i32=-1;
            if(mg_add(&st,&g,lval(c),40+i,60,&slot,&mrg)!=0){rfail("RT_C2","addsock");return;}
            i=i+1;
        }
        let s2:i32=-1; let m2:i32=-1;
        if(mg_add(&st,&g,lval(c),48,7,&s2,&m2)!=0){rfail("RT_C2","addforged7");return;}
        if(mg_add(&st,&g,lval(c),49,8,&s2,&m2)!=0){rfail("RT_C2","addforged8");return;}
        c=c+1;
    }
    let fa:i64=0; let ti:i64=0;
    c=0;
    while(c<500){
        let slot:i32=0; let a:i32=0; let ns:i32=0; let no:i32=0;
        if(mg_query(&g,tval(c),&slot,&a,&ns,&no)==1){
            if(no>=2){ti=ti+1;}
        }
        let s2:i32=0; let a2:i32=0; let ns2:i32=0; let no2:i32=0;
        if(mg_query(&g,lval(c),&s2,&a2,&ns2,&no2)!=1){rfail("RT_C2","lie_missing");return;}
        if(no2>=2){
            fa=fa+1;
            if(tie_check(&st,s2,lval(c),"RT_C2")!=0){return;}
        }
        c=c+1;
    }
    if(mg_replay_check(&st,&g)!=0){rfail("RT_C2","mgreplay");return;}
    if(sc_replay_check(&st)!=0){rfail("RT_C2","screplay");return;}
    _zag_print("RT_C2,claims=500,false_installs_org=");_zag_print(i64s(fa));
    _zag_print(",true_installed_org=");_zag_print(i64s(ti));
    _zag_println(",ok=1");
}

// mode_c3: stricter rule A_org3 (>=3 origins); adversary mints forged orgs 7,8,9
fn mode_c3()void {
    let st:ScStore=st_new();
    if(sc_store_init(16384,128,&st)!=0){rfail("RT_C3","init");return;}
    let g:ScMergeGate=mg_new();
    if(mg_init(&g,14)!=0){rfail("RT_C3","ginit");return;}
    let c:i64=0;
    while(c<500){
        if(honest_assert(&st,&g,c,"RT_C3")!=0){return;}
        let i:i32=0;
        while(i<8){
            let slot:i32=-1; let mrg:i32=-1;
            if(mg_add(&st,&g,lval(c),40+i,60,&slot,&mrg)!=0){rfail("RT_C3","addsock");return;}
            i=i+1;
        }
        let s2:i32=-1; let m2:i32=-1;
        if(mg_add(&st,&g,lval(c),48,7,&s2,&m2)!=0){rfail("RT_C3","addforged7");return;}
        if(mg_add(&st,&g,lval(c),49,8,&s2,&m2)!=0){rfail("RT_C3","addforged8");return;}
        if(mg_add(&st,&g,lval(c),50,9,&s2,&m2)!=0){rfail("RT_C3","addforged9");return;}
        c=c+1;
    }
    let fa:i64=0; let ti:i64=0;
    c=0;
    while(c<500){
        let slot:i32=0; let a:i32=0; let ns:i32=0; let no:i32=0;
        if(mg_query(&g,tval(c),&slot,&a,&ns,&no)==1){
            if(no>=3){ti=ti+1;}
        }
        let s2:i32=0; let a2:i32=0; let ns2:i32=0; let no2:i32=0;
        if(mg_query(&g,lval(c),&s2,&a2,&ns2,&no2)!=1){rfail("RT_C3","lie_missing");return;}
        if(no2>=3){
            fa=fa+1;
            if(tie_check(&st,s2,lval(c),"RT_C3")!=0){return;}
        }
        c=c+1;
    }
    if(mg_replay_check(&st,&g)!=0){rfail("RT_C3","mgreplay");return;}
    if(sc_replay_check(&st)!=0){rfail("RT_C3","screplay");return;}
    _zag_print("RT_C3,claims=500,false_installs_org3=");_zag_print(i64s(fa));
    _zag_print(",true_installed_org3=");_zag_print(i64s(ti));
    _zag_println(",ok=1");
}

// mode_c4: adversary rotates forged org ids per claim from a pool of 16 (40..55)
fn mode_c4()void {
    let st:ScStore=st_new();
    if(sc_store_init(16384,128,&st)!=0){rfail("RT_C4","init");return;}
    let g:ScMergeGate=mg_new();
    if(mg_init(&g,14)!=0){rfail("RT_C4","ginit");return;}
    let c:i64=0;
    while(c<500){
        if(honest_assert(&st,&g,c,"RT_C4")!=0){return;}
        let i:i32=0;
        while(i<8){
            let slot:i32=-1; let mrg:i32=-1;
            if(mg_add(&st,&g,lval(c),40+i,60,&slot,&mrg)!=0){rfail("RT_C4","addsock");return;}
            i=i+1;
        }
        let oa:i32=(40+urmod(c,16)) as i32;
        let ob:i32=(40+urmod(c+7,16)) as i32;
        let s2:i32=-1; let m2:i32=-1;
        if(mg_add(&st,&g,lval(c),48,oa,&s2,&m2)!=0){rfail("RT_C4","addrot_a");return;}
        if(mg_add(&st,&g,lval(c),49,ob,&s2,&m2)!=0){rfail("RT_C4","addrot_b");return;}
        c=c+1;
    }
    let fa:i64=0; let ti:i64=0;
    c=0;
    while(c<500){
        let slot:i32=0; let a:i32=0; let ns:i32=0; let no:i32=0;
        if(mg_query(&g,tval(c),&slot,&a,&ns,&no)==1){
            if(no>=2){ti=ti+1;}
        }
        let s2:i32=0; let a2:i32=0; let ns2:i32=0; let no2:i32=0;
        if(mg_query(&g,lval(c),&s2,&a2,&ns2,&no2)!=1){rfail("RT_C4","lie_missing");return;}
        if(no2>=2){
            fa=fa+1;
            if(tie_check(&st,s2,lval(c),"RT_C4")!=0){return;}
        }
        c=c+1;
    }
    if(mg_replay_check(&st,&g)!=0){rfail("RT_C4","mgreplay");return;}
    if(sc_replay_check(&st)!=0){rfail("RT_C4","screplay");return;}
    _zag_print("RT_C4,claims=500,false_installs_org=");_zag_print(i64s(fa));
    _zag_print(",true_installed_org=");_zag_print(i64s(ti));
    _zag_println(",ok=1");
}

fn streq(a:[]u8,b:[]u8)i32 {
    if(_zag_strcmp(a,b)==1){return 1;}
    return 0;
}
fn main()void {
    let a1:[]u8=_zag_arg(1);
    if(streq(a1,"c1")==1){mode_c1();return;}
    if(streq(a1,"c2")==1){mode_c2();return;}
    if(streq(a1,"c3")==1){mode_c3();return;}
    if(streq(a1,"c4")==1){mode_c4();return;}
    _zag_println("usage: rt_c <c1|c2|c3|c4>");
}

// audit_census.zag — independent census of a facts-format file.
// usage: audit_census <path>
// facts.bin record: [1B kind][2B klen BE][4B tlen BE][key][text]
// Prints: CENSUS n=<records> inversions=<sort inversions> dupes=<adjacent equal keys>
// Pure Zag. Zero RNG.
fn au_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn au_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=au_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn au_open_rdonly(path:[]u8)i64 {
    let c:[]u8=au_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn au_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn au_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn au_print(s:[]u8)void {_zag_print(s);}
fn au_println(s:[]u8)void {_zag_println(s);}
fn au_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
struct AuReader {
    fd:i64,
    buf:[]u8,
    pos:i32,
    fill:i32,
    eof:i32
}
fn au_init(r:*AuReader,path:[]u8)i32 {
    let fd:i64=au_open_rdonly(path);
    if(fd<0){return -1;}
    let b:[]u8=au_alloc(1048576);
    if(b.len==0){au_close(fd);return -1;}
    r.*.fd=fd;r.*.buf=b;r.*.pos=0;r.*.fill=0;r.*.eof=0;
    return 0;
}
fn au_refill(r:*AuReader)i32 {
    let b:[]u8=r.*.buf;
    let pos:i32=r.*.pos;
    let fill:i32=r.*.fill;
    let rem:i32=fill-pos;
    let i:i32=0;
    while(i<rem){b[i]=b[pos+i];i=i+1;}
    let got:i32=au_read_into(r.*.fd,b[rem..]);
    if(got<0){return -1;}
    r.*.pos=0;
    r.*.fill=rem+got;
    if(got==0){r.*.eof=1;}
    return 0;
}
// take exactly n bytes into out; 1=eof, 0=ok, -1=err
fn au_take(r:*AuReader,n:i32,out:[]u8)i32 {
    let need:i32=n;
    let at:i32=0;
    while(need>0){
        let b:[]u8=r.*.buf;
        let pos:i32=r.*.pos;
        let fill:i32=r.*.fill;
        let avail:i32=fill-pos;
        if(avail<=0){
            if(r.*.eof!=0){return 1;}
            if(au_refill(r)!=0){return -1;}
        }else{
            let k:i32=need;
            if(k>avail){k=avail;}
            let j:i32=0;
            while(j<k){out[at+j]=b[pos+j];j=j+1;}
            r.*.pos=pos+k;
            at=at+k;
            need=need-k;
        }
    }
    return 0;
}
// discard n bytes; 1=eof, 0=ok, -1=err
fn au_skip(r:*AuReader,n:i32)i32 {
    let rem:i32=n;
    while(rem>0){
        let pos:i32=r.*.pos;
        let fill:i32=r.*.fill;
        let avail:i32=fill-pos;
        if(avail<=0){
            if(r.*.eof!=0){return 1;}
            if(au_refill(r)!=0){return -1;}
        }else{
            let k:i32=rem;
            if(k>avail){k=avail;}
            r.*.pos=pos+k;
            rem=rem-k;
        }
    }
    return 0;
}
// unsigned lexicographic compare: -1/0/1
fn au_key_cmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        let ca:i32=(a[i] as i32)&255;
        let cb:i32=(b[i] as i32)&255;
        if(ca<cb){return -1;}
        if(ca>cb){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}
fn main()void {
    let path:[]u8=_zag_arg(1);
    if(path.len==0){au_println("usage: audit_census <path>");return;}
    let r:AuReader=AuReader{.fd=0,.buf="",.pos=0,.fill=0,.eof=0};
    if(au_init(&r,path)!=0){au_println("open failed");return;}
    let hdr:[]u8=au_alloc(7);
    let key:[]u8=au_alloc(160);
    let prev:[]u8=au_alloc(160);
    if(hdr.len==0||key.len==0||prev.len==0){au_println("alloc failed");return;}
    let has_prev:i32=0;
    let prev_len:i32=0;
    let n:i64=0;
    let inv:i64=0;
    let dup:i64=0;
    while(1){
        let rc:i32=au_take(&r,7,hdr);
        if(rc==1){break;}
        if(rc!=0){au_println("hdr read error");return;}
        let klen:i32=(((hdr[1] as i32)&255)<<8)|((hdr[2] as i32)&255);
        let tlen:i32=(((hdr[3] as i32)&255)<<24)|(((hdr[4] as i32)&255)<<16)|(((hdr[5] as i32)&255)<<8)|((hdr[6] as i32)&255);
        if(klen<1||klen>160||tlen<0||tlen>4096){au_println("bad lengths");return;}
        if(au_take(&r,klen,key)!=0){au_println("key read error");return;}
        if(has_prev!=0){
            let c:i32=au_key_cmp(key[0..klen],prev[0..prev_len]);
            if(c<0){inv=inv+1;}
            if(c==0){dup=dup+1;}
        }
        let j:i32=0;
        while(j<klen){prev[j]=key[j];j=j+1;}
        prev_len=klen;
        has_prev=1;
        if(au_skip(&r,tlen)!=0){au_println("text skip error");return;}
        n=n+1;
    }
    au_print("CENSUS n=");
    au_print(au_i64s(n));
    au_print(" inversions=");
    au_print(au_i64s(inv));
    au_print(" dupes=");
    au_print(au_i64s(dup));
    au_println("");
}

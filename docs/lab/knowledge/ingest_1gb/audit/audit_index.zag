// audit_index.zag — A6: sparse-index integrity over the full blob.
// usage: audit_index <storedir>
// Checks:
//   IDX1: entry count == #{records with id%1024==0 or first-in-chunk}.
//   IDX2: entries strictly increasing by key.
//   IDX3: every entry's (key,goff) matches the blob record at goff.
//   IDX4: every blob record reachable — binary search for greatest entry
//         with key <= record key yields goff <= record goff.
// Blob record: [1B kind][4B LE id][2B BE klen][4B LE tlen][key][text]
// Index: [4B LE count][entries: 2B BE klen][8B LE goff][key]
// Pure Zag. Zero RNG. Read-only.
fn au_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn au_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=au_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn au_open_rdonly(path:[]u8)i64 {
    let c:[]u8=au_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn au_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn au_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn au_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn au_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn au_g64(b:[]u8,o:i32)i64 {
    let v:i64=0;
    v=v|((b[o] as i64)&255);
    v=v|(((b[o+1] as i64)&255)<<8);
    v=v|(((b[o+2] as i64)&255)<<16);
    v=v|(((b[o+3] as i64)&255)<<24);
    v=v|(((b[o+4] as i64)&255)<<32);
    v=v|(((b[o+5] as i64)&255)<<40);
    v=v|(((b[o+6] as i64)&255)<<48);
    v=v|(((b[o+7] as i64)&255)<<56);
    return v;
}
fn au_print(s:[]u8)void {_zag_print(s);}
fn au_println(s:[]u8)void {_zag_println(s);}
fn au_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn au_join(dir:[]u8,name:[]u8)[]u8 {
    let b:[]u8=au_alloc(dir.len+1+name.len);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    i=0;
    while(i<name.len){b[dir.len+1+i]=name[i];i=i+1;}
    return b;
}
fn au_key_cmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        let ca:i32=(a[i] as i32)&255;
        let cb:i32=(b[i] as i32)&255;
        if(ca<cb){return -1;}
        if(ca>cb){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}
// parse blob record header at off; 0=end(kind 0), -1=bad, else reclen.
// fills kind/id/klen/tlen.
fn au_blob_hdr(ch:[]u8,off:i32,kind:*i32,id:*i32,klen:*i32,tlen:*i32)i32 {
    if(off+11>ch.len){return -1;}
    let ko:i32=(ch[off] as i32)&255;
    if(ko==0){return 0;}
    if(ko<1||ko>4){return -1;}
    let fid:i32=au_g32(ch,off+1);
    let kl:i32=(((ch[off+5] as i32)&255)<<8)|((ch[off+6] as i32)&255);
    let tl:i32=au_g32(ch,off+7);
    if(kl<1||kl>160||tl<1||tl>4096){return -1;}
    if(off+11+kl+tl>ch.len){return -1;}
    kind.*=ko; id.*=fid; klen.*=kl; tlen.*=tl;
    return 11+kl+tl;
}
// read whole file into a buffer (file < 2^25).
fn au_read_file(path:[]u8)[]u8 {
    let fd:i64=au_open_rdonly(path);
    if(fd<0){let e:[]u8="";return e;}
    let cap:i32=1048576;
    let b:[]u8=au_alloc(cap);
    if(b.len==0){au_close(fd);let e2:[]u8="";return e2;}
    let total:i32=0;
    while(1){
        if(total==cap){
            let nb:[]u8=au_alloc(cap*2);
            if(nb.len==0){au_close(fd);let e3:[]u8="";return e3;}
            let i:i32=0;
            while(i<total){nb[i]=b[i];i=i+1;}
            b=nb;cap=cap*2;
        }
        let got:i32=au_read_into(fd,b[total..]);
        if(got<0){au_close(fd);let e4:[]u8="";return e4;}
        if(got==0){break;}
        total=total+got;
    }
    au_close(fd);
    return b[0..total];
}
fn main()void {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){au_println("usage: audit_index <storedir>");return;}
    // load sparse.idx
    let inm:[]u8=au_join(dir,"sparse.idx");
    let ib:[]u8=au_read_file(inm);
    if(ib.len<4){au_println("idx read failed");return;}
    let nent:i32=au_g32(ib,0);
    au_print("IDX entries=");
    au_print(au_i64s(nent as i64));
    au_println("");
    // entry offset table
    let eoff:[]u8=au_alloc(nent*4);
    if(eoff.len==0){au_println("alloc failed");return;}
    let pos:i32=4;
    let e:i32=0;
    while(e<nent){
        au_s32(eoff,e*4,pos);
        if(pos+10>ib.len){au_println("idx truncated");return;}
        let kl:i32=(((ib[pos] as i32)&255)<<8)|((ib[pos+1] as i32)&255);
        if(kl<1||kl>160){au_println("idx bad klen");return;}
        pos=pos+10+kl;
        e=e+1;
    }
    if(pos!=ib.len){au_print("IDX trailing bytes: ");au_print(au_i64s((ib.len-pos) as i64));au_println("");}
    // IDX2: strictly increasing keys
    let ek:[]u8=au_alloc(160);
    let ek2:[]u8=au_alloc(160);
    if(ek.len==0||ek2.len==0){au_println("alloc failed");return;}
    let sorted_ok:i32=1;
    e=1;
    while(e<nent){
        let p0:i32=au_g32(eoff,(e-1)*4);
        let p1:i32=au_g32(eoff,e*4);
        let k0:i32=(((ib[p0] as i32)&255)<<8)|((ib[p0+1] as i32)&255);
        let k1:i32=(((ib[p1] as i32)&255)<<8)|((ib[p1+1] as i32)&255);
        let c:i32=au_key_cmp(ib[p0+10..p0+10+k0],ib[p1+10..p1+10+k1]);
        if(c>=0){sorted_ok=0;}
        e=e+1;
    }
    au_print("IDX2 strictly_sorted=");
    au_print(au_i64s(sorted_ok as i64));
    au_println("");
    // scan blob chunks
    let chunk:[]u8=au_alloc(33488896);
    if(chunk.len==0){au_println("chunk alloc failed");return;}
    let total_recs:i64=0;
    let expect_entries:i64=0;
    let idx3_bad:i64=0;
    let idx4_bad:i64=0;
    let ci:i32=0;
    // we need entry goffs for IDX3; build goff array
    let goffs:[]u8=au_alloc(nent*8);
    if(goffs.len==0){au_println("alloc failed");return;}
    e=0;
    while(e<nent){
        let p:i32=au_g32(eoff,e*4);
        let g:i64=au_g64(ib,p+2);
        let j:i32=0;
        while(j<8){goffs[e*8+j]=((g>>(j*8))&255) as u8;j=j+1;}
        e=e+1;
    }
    while(1){
        let nm2:[]u8=au_join(dir,"blob_000000.dat");
        // build chunk name blob_%06d.dat
        let dig:[]u8=au_alloc(6);
        let t:i32=ci;
        let dpos:i32=5;
        while(dpos>=0){dig[dpos]=((t%10)+48) as u8;t=t/10;dpos=dpos-1;}
        let cnm:[]u8=au_alloc(dir.len+16);
        let cp2:i32=0;
        while(cp2<dir.len){cnm[cp2]=dir[cp2];cp2=cp2+1;}
        cnm[dir.len]=47;
        let bl:[]u8="blob_";
        cp2=0;
        while(cp2<5){cnm[dir.len+1+cp2]=bl[cp2];cp2=cp2+1;}
        cp2=0;
        while(cp2<6){cnm[dir.len+6+cp2]=dig[cp2];cp2=cp2+1;}
        let dt:[]u8=".dat";
        cp2=0;
        while(cp2<4){cnm[dir.len+12+cp2]=dt[cp2];cp2=cp2+1;}
        let fd:i64=au_open_rdonly(cnm[0..dir.len+16]);
        if(fd<0){break;}
        let got:i32=au_read_into(fd,chunk);
        au_close(fd);
        if(got!=33488896){au_print("short chunk ");au_print(au_i64s(ci as i64));au_println("");}
        let off:i32=0;
        let first_in_chunk:i32=1;
        while(1){
            let ko:i32=0; let fid:i32=0; let kl:i32=0; let tl:i32=0;
            let rl:i32=au_blob_hdr(chunk,off,&ko,&fid,&kl,&tl);
            if(rl==0){break;}
            if(rl<0){au_println("blob parse failed");return;}
            let goff:i64=(ci as i64)*33488896+(off as i64);
            if(fid%1024==0||first_in_chunk==1){expect_entries=expect_entries+1;}
            first_in_chunk=0;
            // IDX4: binary search greatest entry with key <= record key
            let rk:[]u8=chunk[off+11..off+11+kl];
            let lo:i32=0; let hi:i32=nent-1;
            let best:i32=-1;
            while(lo<=hi){
                let mid:i32=(lo+hi)/2;
                let pm:i32=au_g32(eoff,mid*4);
                let km:i32=(((ib[pm] as i32)&255)<<8)|((ib[pm+1] as i32)&255);
                let c:i32=au_key_cmp(ib[pm+10..pm+10+km],rk);
                if(c==0){best=mid;break;}
                if(c<0){best=mid;lo=mid+1;}else{hi=mid-1;}
            }
            if(best<0){idx4_bad=idx4_bad+1;}
            else{
                let bg:i64=au_g64(goffs,best*8);
                if(bg>goff){idx4_bad=idx4_bad+1;}
            }
            total_recs=total_recs+1;
            off=off+rl;
        }
        ci=ci+1;
    }
    au_print("IDX1 expected_entries=");
    au_print(au_i64s(expect_entries));
    au_print(" actual=");
    au_print(au_i64s(nent as i64));
    au_print(" match=");
    au_print(au_i64s((expect_entries==nent as i64) as i64));
    au_println("");
    au_print("BLOB records=");
    au_print(au_i64s(total_recs));
    au_print(" chunks=");
    au_print(au_i64s(ci as i64));
    au_println("");
    // IDX3: verify each entry points at a real record with matching key.
    // Entries are key-sorted and the blob is key-ordered, so goffs are
    // non-decreasing: cache the last chunk read.
    let cached_ci:i32=-1;
    e=0;
    while(e<nent){
        let p:i32=au_g32(eoff,e*4);
        let kl3:i32=(((ib[p] as i32)&255)<<8)|((ib[p+1] as i32)&255);
        let g:i64=au_g64(goffs,e*8);
        let eci:i32=(g/33488896) as i32;
        let eoff2:i32=(g%33488896) as i32;
        // re-read that chunk (cache last)
        let cnm2:[]u8=au_alloc(dir.len+16);
        let dig2:[]u8=au_alloc(6);
        let t2:i32=eci;
        let dp2:i32=5;
        while(dp2>=0){dig2[dp2]=((t2%10)+48) as u8;t2=t2/10;dp2=dp2-1;}
        let q:i32=0;
        while(q<dir.len){cnm2[q]=dir[q];q=q+1;}
        cnm2[dir.len]=47;
        let bl2:[]u8="blob_";
        q=0;
        while(q<5){cnm2[dir.len+1+q]=bl2[q];q=q+1;}
        q=0;
        while(q<6){cnm2[dir.len+6+q]=dig2[q];q=q+1;}
        let dt2:[]u8=".dat";
        q=0;
        while(q<4){cnm2[dir.len+12+q]=dt2[q];q=q+1;}
        let fd2:i64=-1;
        if(eci!=cached_ci){
            fd2=au_open_rdonly(cnm2[0..dir.len+16]);
            if(fd2>=0){
                let got2:i32=au_read_into(fd2,chunk);
                au_close(fd2);
                if(got2==33488896){cached_ci=eci;}
                else{idx3_bad=idx3_bad+1;}
            }else{idx3_bad=idx3_bad+1;}
        }
        if(cached_ci==eci){
            let ko2:i32=0; let id2:i32=0; let kl2:i32=0; let tl2:i32=0;
            let rl2:i32=au_blob_hdr(chunk,eoff2,&ko2,&id2,&kl2,&tl2);
            if(rl2<=0){idx3_bad=idx3_bad+1;}
            else{
                if(kl2!=kl3){idx3_bad=idx3_bad+1;}
                else{
                    let c3:i32=au_key_cmp(chunk[eoff2+11..eoff2+11+kl2],ib[p+10..p+10+kl3]);
                    if(c3!=0){idx3_bad=idx3_bad+1;}
                }
            }
        }
        e=e+1;
    }
    au_print("IDX3 entry_target_bad=");
    au_print(au_i64s(idx3_bad));
    au_println("");
    au_print("IDX4 unreachable_records=");
    au_print(au_i64s(idx4_bad));
    au_println("");
}

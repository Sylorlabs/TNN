// audit_replay.zag — independent Zag replay of the ingest judgment path.
// usage: audit_replay <facts.bin> <slot2pos.bin>
// Gate functions (ig_key_eq, ig_has_sub, ig_key_word, ig_gate, ig_cal_bad)
// are copied VERBATIM from the frozen build/ingest.zag; the lesson harness
// (peek/CAL/drain, prev_key staleness, counting, slot2pos emission) is
// written independently from INGEST_DISK_FORMAT.md + the prereg spec.
// Prints per-lesson lines (diffable against audit.log) + SUMMARY.
// Emits slot2pos.bin: [4B n LE][n x 4B LE facts.bin position].
// Pure Zag. Zero RNG.
fn au_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn au_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=au_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn au_open_rdonly(path:[]u8)i64 {
    let c:[]u8=au_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn au_open_write(path:[]u8)i64 {
    let c:[]u8=au_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn au_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn au_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn au_write_all(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return 0;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){return -1;}
        at=at+(n as i32);
    }
    return 0;
}
fn au_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn au_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn au_print(s:[]u8)void {_zag_print(s);}
fn au_println(s:[]u8)void {_zag_println(s);}
fn au_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
struct AuReader {
    fd:i64,
    buf:[]u8,
    pos:i32,
    fill:i32,
    eof:i32
}
fn au_init(r:*AuReader,path:[]u8)i32 {
    let fd:i64=au_open_rdonly(path);
    if(fd<0){return -1;}
    let b:[]u8=au_alloc(1048576);
    if(b.len==0){au_close(fd);return -1;}
    r.*.fd=fd;r.*.buf=b;r.*.pos=0;r.*.fill=0;r.*.eof=0;
    return 0;
}
fn au_refill(r:*AuReader)i32 {
    let b:[]u8=r.*.buf;
    let pos:i32=r.*.pos;
    let fill:i32=r.*.fill;
    let rem:i32=fill-pos;
    let i:i32=0;
    while(i<rem){b[i]=b[pos+i];i=i+1;}
    let got:i32=au_read_into(r.*.fd,b[rem..]);
    if(got<0){return -1;}
    r.*.pos=0;
    r.*.fill=rem+got;
    if(got==0){r.*.eof=1;}
    return 0;
}
fn au_take(r:*AuReader,n:i32,out:[]u8)i32 {
    let need:i32=n;
    let at:i32=0;
    while(need>0){
        let b:[]u8=r.*.buf;
        let pos:i32=r.*.pos;
        let fill:i32=r.*.fill;
        let avail:i32=fill-pos;
        if(avail<=0){
            if(r.*.eof!=0){return 1;}
            if(au_refill(r)!=0){return -1;}
        }else{
            let k:i32=need;
            if(k>avail){k=avail;}
            let j:i32=0;
            while(j<k){out[at+j]=b[pos+j];j=j+1;}
            r.*.pos=pos+k;
            at=at+k;
            need=need-k;
        }
    }
    return 0;
}
fn au_skip(r:*AuReader,n:i32)i32 {
    let rem:i32=n;
    while(rem>0){
        let pos:i32=r.*.pos;
        let fill:i32=r.*.fill;
        let avail:i32=fill-pos;
        if(avail<=0){
            if(r.*.eof!=0){return 1;}
            if(au_refill(r)!=0){return -1;}
        }else{
            let k:i32=rem;
            if(k>avail){k=avail;}
            r.*.pos=pos+k;
            rem=rem-k;
        }
    }
    return 0;
}
// ============ VERBATIM GATE COPIES from frozen build/ingest.zag ============
fn ig_key_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn ig_has_sub(hay:[]u8,needle:[]u8)i32 {
    if(needle.len<1){return 1;}
    if(needle.len>hay.len){return 0;}
    let i:i32=0;
    while(i+needle.len<=hay.len){
        let j:i32=0;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){break;}
            j=j+1;
        }
        if(j==needle.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn ig_key_word(key:[]u8,word_out:[]u8)i32 {
    if(key.len<9){return -1;}
    if(key[0]!=119||key[1]!=105||key[2]!=107||key[3]!=116||key[4]!=58||key[5]!=101||key[6]!=110||key[7]!=58){return -1;}
    let i:i32=8;
    while(i<key.len){
        if(key[i]==58){break;}
        i=i+1;
    }
    if(i>=key.len){return -1;}
    let wl:i32=i-8;
    if(wl<1||wl>word_out.len){return -1;}
    let j:i32=0;
    while(j<wl){word_out[j]=key[8+j];j=j+1;}
    return wl;
}
fn ig_gate(kind:i32,key:[]u8,text:[]u8,prev_key:[]u8,has_prev:i32,wscratch:[]u8)i32 {
    if(kind<1||kind>4){return 1;}
    if(key.len<1||key.len>160){return 1;}
    if(text.len<1||text.len>4096){return 1;}
    let i:i32=0;
    while(i<key.len){
        let c:u8=key[i];
        if(c<32||c==127){return 1;}
        if(c==10){return 1;}
        i=i+1;
    }
    i=0;
    while(i<text.len){
        let c2:u8=text[i];
        if(c2==0){return 1;}
        if(c2<32&&c2!=10){return 1;}
        if(c2==127){return 1;}
        i=i+1;
    }
    if(has_prev!=0){
        if(ig_key_eq(key,prev_key)==1){return 2;}
    }
    if(kind==1){
        if(text.len<4){return 3;}
        let wb:[]u8=wscratch;
        if(wb.len<160){return 1;}
        let wl:i32=ig_key_word(key,wb);
        if(wl<0){return 3;}
        if(text.len==wl){
            if(ig_key_eq(text,wb[0..wl])==1){return 3;}
        }
    }else{
        if(kind==2){
            if(text.len<4){return 3;}
            let wb2:[]u8=wscratch;
            if(wb2.len<160){return 1;}
            let wl2:i32=ig_key_word(key,wb2);
            if(wl2<0){return 3;}
            if(ig_has_sub(text,wb2[0..wl2])!=1){return 3;}
        }else{
            if(kind==3){
                if(text.len<10){return 3;}
                let last:u8=text[text.len-1];
                if(last!=46&&last!=63&&last!=33){return 3;}
            }else{
                if(text.len<4){return 3;}
            }
        }
    }
    return 0;
}
fn ig_cal_bad(probe_idx:i32,dupe_key:[]u8,kind_out:*i32,key:[]u8,key_len_out:*i32,text:[]u8,text_len_out:*i32)i32 {
    if(probe_idx==0){
        kind_out.*=1;
        key[0]=122;key[1]=122;key[2]=98;key[3]=97;key[4]=100;key[5]=58;key[6]=114;key[7]=49;
        key_len_out.*=8;
        text_len_out.*=0;
        return 0;
    }
    if(probe_idx==1){
        kind_out.*=1;
        let i:i32=0;
        while(i<dupe_key.len){key[i]=dupe_key[i];i=i+1;}
        key_len_out.*=dupe_key.len;
        text[0]=100;text[1]=117;text[2]=112;text[3]=101;text[4]=32;text[5]=112;text[6]=114;text[7]=111;text[8]=98;text[9]=101;
        text_len_out.*=10;
        return 0;
    }
    if(probe_idx==2){
        kind_out.*=1;
        key[0]=122;key[1]=122;key[2]=98;key[3]=97;key[4]=100;key[5]=0;key[6]=114;key[7]=51;
        key_len_out.*=8;
        text[0]=110;text[1]=117;text[2]=108;text[3]=32;text[4]=112;text[5]=114;text[6]=111;text[7]=98;text[8]=101;
        text_len_out.*=9;
        return 0;
    }
    kind_out.*=1;
    let kk:[]u8="wikt:en:zzword:noun:1";
    let i2:i32=0;
    while(i2<kk.len){key[i2]=kk[i2];i2=i2+1;}
    key_len_out.*=kk.len;
    let tt:[]u8="zzword";
    i2=0;
    while(i2<tt.len){text[i2]=tt[i2];i2=i2+1;}
    text_len_out.*=tt.len;
    return 0;
}
// ============ END VERBATIM COPIES ============
// read one record's kind/key/text into buffers; 1=eof, 0=ok, -1=err
fn au_record(r:*AuReader,hdr:[]u8,kind_out:*i32,key:[]u8,klen_out:*i32,text:[]u8,tlen_out:*i32) i32 {
    if(au_take(r,7,hdr)==1){return 1;}
    let kind:i32=(hdr[0] as i32)&255;
    let klen:i32=(((hdr[1] as i32)&255)<<8)|((hdr[2] as i32)&255);
    let tlen:i32=(((hdr[3] as i32)&255)<<24)|(((hdr[4] as i32)&255)<<16)|(((hdr[5] as i32)&255)<<8)|((hdr[6] as i32)&255);
    if(klen<1||klen>160||tlen<0||tlen>4096){return -1;}
    if(au_take(r,klen,key)!=0){return -1;}
    if(au_take(r,tlen,text)!=0){return -1;}
    kind_out.*=kind;
    klen_out.*=klen;
    tlen_out.*=tlen;
    return 0;
}
// ============ INDEPENDENT LESSON HARNESS ============
fn au_lesson_line_ok(li:i32,la:i64,lg1:i64,lg2:i64,lg3:i64)void {
    au_print("LESSON ");
    au_print(au_i64s(li as i64));
    au_print(" CAL=OK inst=");
    au_print(au_i64s(la));
    au_print(" g1=");
    au_print(au_i64s(lg1));
    au_print(" g2=");
    au_print(au_i64s(lg2));
    au_print(" g3=");
    au_print(au_i64s(lg3));
    au_println("");
}
fn au_lesson_line_rej(li:i32,mask:i32,dropped:i32)void {
    au_print("LESSON ");
    au_print(au_i64s(li as i64));
    au_print(" CAL=REJECT mask=");
    au_print(au_i64s(mask as i64));
    au_print(" dropped=");
    au_print(au_i64s(dropped as i64));
    au_println("");
}
// gate one record, update counters; on install, record slot->pos.
// returns 0 ok. prev_key is ALWAYS updated (matches ingest accepted path).
fn au_gate_count(kind:i32,key:[]u8,klen:i32,text:[]u8,tlen:i32,
    prev:[]u8,prev_len:*i32,has_prev:*i32,wscr:[]u8,
    lg1:*i64,lg2:*i64,lg3:*i64,ninst:*i64,s2p:[]u8,pos:i64)void {
    let pv:[]u8=prev[0..prev_len.*];
    let v:i32=ig_gate(kind,key[0..klen],text[0..tlen],pv,has_prev.*,wscr);
    if(v==0){
        au_s32(s2p,(ninst.* as i32)*4,pos as i32);
        ninst.*=ninst.*+1;
    }else{
        if(v==1){lg1.*=lg1.*+1;}else{
            if(v==2){lg2.*=lg2.*+1;}else{lg3.*=lg3.*+1;}
        }
    }
    let cp:i32=0;
    while(cp<klen){prev[cp]=key[cp];cp=cp+1;}
    prev_len.*=klen;
    has_prev.*=1;
}
fn main()void {
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    if(fpath.len==0||opath.len==0){au_println("usage: audit_replay <facts.bin> <slot2pos.bin>");return;}
    let r:AuReader=AuReader{.fd=0,.buf="",.pos=0,.fill=0,.eof=0};
    if(au_init(&r,fpath)!=0){au_println("open failed");return;}
    let hdr:[]u8=au_alloc(7);
    let key:[]u8=au_alloc(160);
    let text:[]u8=au_alloc(4096);
    let prev:[]u8=au_alloc(160);
    let wscr:[]u8=au_alloc(160);
    let kind4:[]u8=au_alloc(4);
    let kl4:[]u8=au_alloc(16);
    let tl4:[]u8=au_alloc(16);
    let key4:[]u8=au_alloc(640);
    let text4:[]u8=au_alloc(16384);
    // slot->pos table: max 3707990 slots x 4B (under 2^25)
    let s2p:[]u8=au_alloc(14832000);
    if(hdr.len==0||key.len==0||text.len==0||prev.len==0||wscr.len==0){au_println("alloc failed");return;}
    if(kind4.len==0||kl4.len==0||tl4.len==0||key4.len==0||text4.len==0||s2p.len==0){au_println("alloc failed");return;}
    let prev_len:i32=0;
    let has_prev:i32=0;
    let g1:i64=0; let g2:i64=0; let g3:i64=0;
    let ninst:i64=0;
    let nrej:i32=0;
    let nles:i32=0;
    let pos:i64=0;
    let lesson:i32=0;
    while(1){
        // peek up to 4 records
        let npeek:i32=0;
        let pk:i32=0;
        while(pk<4){
            let ko:i32=0; let kl2:i32=0; let tl2:i32=0;
            let ks:[]u8=key4[pk*160..(pk+1)*160];
            let ts:[]u8=text4[pk*4096..(pk+1)*4096];
            let rc:i32=au_record(&r,hdr,&ko,ks,&kl2,ts,&tl2);
            if(rc==1){break;}
            if(rc!=0){au_println("peek read error");return;}
            kind4[pk]=(ko&255) as u8;
            au_s32(kl4,pk*4,kl2);
            au_s32(tl4,pk*4,tl2);
            npeek=pk+1;
            pos=pos+1;
            pk=pk+1;
        }
        if(npeek==0){break;}
        // --- CAL dry-run: must-accept (first npeek) ---
        let calmask:i32=0;
        pk=0;
        while(pk<npeek){
            let kl2b:i32=au_g32(kl4,pk*4);
            let tl2b:i32=au_g32(tl4,pk*4);
            let kk:[]u8=key4[pk*160..pk*160+kl2b];
            let tt:[]u8=text4[pk*4096..pk*4096+tl2b];
            let pv:[]u8=prev[0..prev_len];
            let v:i32=ig_gate((kind4[pk] as i32)&255,kk,tt,pv,has_prev,wscr);
            if(v!=0){calmask=calmask|(1<<pk);}
            pk=pk+1;
        }
        // --- CAL dry-run: must-reject (4 synthetic) ---
        let pr:i32=0;
        while(pr<4){
            let ko2:i32=0; let kl3:i32=0; let tl3:i32=0;
            ig_cal_bad(pr,key4[0..au_g32(kl4,0)],&ko2,key,&kl3,text,&tl3);
            let kk2:[]u8=key[0..kl3];
            let tt2:[]u8=text[0..tl3];
            let hp2:i32=0;
            let pv2:[]u8=key[0..0];
            if(pr==1){
                let kl0:i32=au_g32(kl4,0);
                pv2=key4[0..kl0];
                hp2=1;
            }
            let v2:i32=ig_gate(ko2,kk2,tt2,pv2,hp2,wscr);
            let exp:i32=1;
            if(pr==1){exp=2;}
            if(pr==3){exp=3;}
            if(v2!=exp){calmask=calmask|(16<<pr);}
            pr=pr+1;
        }
        if(calmask!=0){
            // rejected as a unit: consume + drop rest of lesson; prev_key untouched
            let consumed:i32=npeek;
            while(consumed<65536){
                let rc2:i32=au_take(&r,7,hdr);
                if(rc2==1){break;}
                if(rc2!=0){au_println("drain read error");return;}
                let dk:i32=(((hdr[1] as i32)&255)<<8)|((hdr[2] as i32)&255);
                let dt:i32=(((hdr[3] as i32)&255)<<24)|(((hdr[4] as i32)&255)<<16)|(((hdr[5] as i32)&255)<<8)|((hdr[6] as i32)&255);
                if(dk<1||dk>160||dt<0||dt>4096){au_println("drain bad lens");return;}
                if(au_skip(&r,dk+dt)!=0){au_println("drain skip error");return;}
                consumed=consumed+1;
                pos=pos+1;
            }
            au_lesson_line_rej(lesson,calmask,consumed);
            nrej=nrej+1;
        }else{
            let lg1:i64=0; let lg2:i64=0; let lg3:i64=0; let la:i64=0;
            let total:i32=0;
            pk=0;
            while(pk<npeek){
                let kl2c:i32=au_g32(kl4,pk*4);
                let tl2c:i32=au_g32(tl4,pk*4);
                let kk3:[]u8=key4[pk*160..pk*160+160];
                let tt3:[]u8=text4[pk*4096..pk*4096+4096];
                let p0:i64=pos-(npeek as i64)+(pk as i64);
                let n0:i64=ninst;
                au_gate_count((kind4[pk] as i32)&255,kk3,kl2c,tt3,tl2c,
                    prev,&prev_len,&has_prev,wscr,&lg1,&lg2,&lg3,&ninst,s2p,p0);
                if(ninst>n0){la=la+1;}
                total=total+1;
                pk=pk+1;
            }
            while(total<65536){
                let ko4:i32=0; let kl5:i32=0; let tl5:i32=0;
                let rc3:i32=au_record(&r,hdr,&ko4,key,&kl5,text,&tl5);
                if(rc3==1){break;}
                if(rc3!=0){au_println("lesson read error");return;}
                let n1:i64=ninst;
                au_gate_count(ko4,key,kl5,text,tl5,
                    prev,&prev_len,&has_prev,wscr,&lg1,&lg2,&lg3,&ninst,s2p,pos);
                if(ninst>n1){la=la+1;}
                pos=pos+1;
                total=total+1;
            }
            au_lesson_line_ok(lesson,la,lg1,lg2,lg3);
            g1=g1+lg1; g2=g2+lg2; g3=g3+lg3;
        }
        nles=nles+1;
        lesson=lesson+1;
    }
    au_print("REPLAY lessons=");
    au_print(au_i64s(nles as i64));
    au_print(" rejected=");
    au_print(au_i64s(nrej as i64));
    au_print(" inst=");
    au_print(au_i64s(ninst));
    au_print(" g1=");
    au_print(au_i64s(g1));
    au_print(" g2=");
    au_print(au_i64s(g2));
    au_print(" g3=");
    au_print(au_i64s(g3));
    au_println("");
    // emit slot2pos.bin: [4B n][n x 4B pos]
    let ofd:i64=au_open_write(opath);
    if(ofd<0){au_println("slot2pos open failed");return;}
    let hh:[]u8=au_alloc(4);
    au_s32(hh,0,ninst as i32);
    if(au_write_all(ofd,hh)!=0){au_println("slot2pos hdr write failed");return;}
    if(au_write_all(ofd,s2p[0..(ninst as i32)*4])!=0){au_println("slot2pos write failed");return;}
    au_close(ofd);
    au_print("slot2pos written n=");
    au_print(au_i64s(ninst));
    au_println("");
}

// kbctl — conscious-control KB CLI (crew B)
// Usage:
//   kbctl init <dir>
//   kbctl put <dir> <id> <key> <textfile> [--mode=conscious|fast] [--fail-after=1|2|3]
//   kbctl revise <dir> <id> <textfile> [--mode=...] [--fail-after=...]
//   kbctl delete <dir> <id> [--mode=...]
//   kbctl crashput <dir> <id> <key> <textfile> <point> [--mode=...]
//   kbctl crashrevise <dir> <id> <textfile> <point> [--mode=...]
//   kbctl get <dir> <id>
//   kbctl verify <dir> [--mode=...]
//   kbctl recover <dir>
//   kbctl batch <dir> <opsfile> [--mode=...] [--fail-after=...]
//   kbctl dump <dir>
//   kbctl stats <dir>
// Exit codes: 0 ok, 1 usage/arg, 2 load/corrupt/verify-fail, 3 protocol-abort/dirty, 99 crash-simulated.
@import("kbcfg.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("kbcore.zag")

fn ig_atoi(s:[]u8)i32 {
    let v:i32=0;
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0&&s[0]==45){neg=1;i=1;}
    while(i<s.len&&(s[i] as i32)>=48&&(s[i] as i32)<=57){
        v=v*10+((s[i] as i32)-48);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
fn kb_usage()void {
    k_println("usage: kbctl <init|put|revise|delete|get|verify|recover|batch|dump|stats|crashput|crashrevise> ...");
    return;
}
fn kb_flag_scan(start:i32,mode:*i32,fail_after:*i32)i32 {
    let ai:i32=start;
    let a:[]u8=_zag_arg(ai);
    while(a.len>0){
        if(a.len>7&&k_memeq(a,0,"--mode=",0,7)==1){
            if(a.len==11&&k_memeq(a,7,"fast",0,4)==1){mode.*=1;}
            else{
                if(a.len!=16||k_memeq(a,7,"conscious",0,9)!=1){return -1;}
                mode.*=0;
            }
        }else{
            if(a.len>13&&k_memeq(a,0,"--fail-after=",0,13)==1){
                fail_after.*=ig_atoi(a[13..]);
                if(fail_after.*<0||fail_after.*>3){return -1;}
            }else{return -1;}
        }
        ai=ai+1;
        a=_zag_arg(ai);
    }
    return 0;
}
fn kb_cmd_put(dir:[]u8,id:i32,key:[]u8,text:[]u8,mode:i32,fail_after:i32)i32 {
    let mt:KbMeta=KbMeta{.nchunks=0,.total=0,.jsize=0,.nslots=0,.slotcap=0,.cur_used=0,.jseq=1,.nlive=0};
    let mm:KbMem=KbMem{.s_id="",.s_off="",.s_len="",.s_hash="",.s_flags="",.cur="",.dir="",.lprev=""};
    let hist:[]u8="";
    let hn:i32=0;
    if(mode==0){
        let nr:i32=0;
        let lr:i32=kb_load(dir,&mt,&mm,1,&nr);
        if(lr==1){k_println("NOTINIT");return 1;}
        if(lr!=0){k_println("LOADFAIL");return 2;}
    }else{
        hist=k_alloc(24000000);
        if(hist.len==0){k_println("NOMEM");return 2;}
        if(kb_load_fast(dir,&mt,&mm,hist,&hn)!=0){k_println("LOADFAIL");return 2;}
    }
    let poff:i64=0;let plen:i32=0;let pid:i32=0;
    let phash:[]u8=k_alloc(32);
    if(phash.len==0){k_println("NOMEM");return 2;}
    kb_find_prev(&mm,&mt,mt.total,&poff,&plen,&pid,phash);
    let rc:i32=0;
    if(mode==0){rc=kb_do_put(&mt,&mm,id,key,text,&poff,&plen,&pid,phash,fail_after);}
    else{rc=kb_do_put_fast(&mt,&mm,id,key,text,hist,&hn);}
    if(rc==99){k_println("CRASH-SIMULATED");return 99;}
    if(rc!=0){k_print("PUT rc=");k_print_i64(rc as i64);k_println("");return rc;}
    if(mode==1){
        if(kb_persist_fast(&mt,&mm,hist,hn)!=0){k_println("PUT persist-fail");return 2;}
    }
    let si:i32=kb_slot_find(&mm,&mt,id);
    if(si<0){k_println("PUT slot-lost");return 3;}
    let hx:[]u8=k_alloc(64);
    k_hex32(mm.s_hash[si*32..si*32+32],hx);
    k_print("PUT id=");k_print_i64(id as i64);
    k_print(" off=");k_print_i64(kb_s_off(&mm,si));
    k_print(" len=");k_print_i64(kb_s_len(&mm,si) as i64);
    k_print(" hash=");k_println(hx);
    return 0;
}
fn kb_cmd_revise(dir:[]u8,id:i32,text:[]u8,mode:i32,fail_after:i32)i32 {
    let mt:KbMeta=KbMeta{.nchunks=0,.total=0,.jsize=0,.nslots=0,.slotcap=0,.cur_used=0,.jseq=1,.nlive=0};
    let mm:KbMem=KbMem{.s_id="",.s_off="",.s_len="",.s_hash="",.s_flags="",.cur="",.dir="",.lprev=""};
    let hist:[]u8="";
    let hn:i32=0;
    if(mode==0){
        let nr:i32=0;
        let lr:i32=kb_load(dir,&mt,&mm,1,&nr);
        if(lr==1){k_println("NOTINIT");return 1;}
        if(lr!=0){k_println("LOADFAIL");return 2;}
    }else{
        hist=k_alloc(24000000);
        if(hist.len==0){k_println("NOMEM");return 2;}
        if(kb_load_fast(dir,&mt,&mm,hist,&hn)!=0){k_println("LOADFAIL");return 2;}
    }
    let poff:i64=0;let plen:i32=0;let pid:i32=0;
    let phash:[]u8=k_alloc(32);
    if(phash.len==0){k_println("NOMEM");return 2;}
    kb_find_prev(&mm,&mt,mt.total,&poff,&plen,&pid,phash);
    let rc:i32=0;
    if(mode==0){rc=kb_do_revise(&mt,&mm,id,text,&poff,&plen,&pid,phash,fail_after);}
    else{rc=kb_do_revise_fast(&mt,&mm,id,text,hist,&hn);}
    if(rc==99){k_println("CRASH-SIMULATED");return 99;}
    if(rc!=0){k_print("REVISE rc=");k_print_i64(rc as i64);k_println("");return rc;}
    if(mode==1){
        if(kb_persist_fast(&mt,&mm,hist,hn)!=0){k_println("REVISE persist-fail");return 2;}
    }
    let si:i32=kb_slot_find(&mm,&mt,id);
    if(si<0){k_println("REVISE slot-lost");return 3;}
    let hx:[]u8=k_alloc(64);
    k_hex32(mm.s_hash[si*32..si*32+32],hx);
    k_print("REVISE id=");k_print_i64(id as i64);
    k_print(" off=");k_print_i64(kb_s_off(&mm,si));
    k_print(" len=");k_print_i64(kb_s_len(&mm,si) as i64);
    k_print(" hash=");k_println(hx);
    return 0;
}
fn kb_cmd_delete(dir:[]u8,id:i32,mode:i32)i32 {
    let mt:KbMeta=KbMeta{.nchunks=0,.total=0,.jsize=0,.nslots=0,.slotcap=0,.cur_used=0,.jseq=1,.nlive=0};
    let mm:KbMem=KbMem{.s_id="",.s_off="",.s_len="",.s_hash="",.s_flags="",.cur="",.dir="",.lprev=""};
    let hist:[]u8="";
    let hn:i32=0;
    if(mode==0){
        let nr:i32=0;
        let lr:i32=kb_load(dir,&mt,&mm,1,&nr);
        if(lr==1){k_println("NOTINIT");return 1;}
        if(lr!=0){k_println("LOADFAIL");return 2;}
    }else{
        hist=k_alloc(24000000);
        if(hist.len==0){k_println("NOMEM");return 2;}
        if(kb_load_fast(dir,&mt,&mm,hist,&hn)!=0){k_println("LOADFAIL");return 2;}
    }
    let rc:i32=0;
    if(mode==0){rc=kb_do_delete(&mt,&mm,id);}
    else{rc=kb_do_delete_fast(&mt,&mm,id);}
    if(rc!=0){k_print("DELETE rc=");k_print_i64(rc as i64);k_println("");return rc;}
    if(mode==1){
        if(kb_persist_fast(&mt,&mm,hist,hn)!=0){k_println("DELETE persist-fail");return 2;}
    }
    k_print("DELETE id=");k_print_i64(id as i64);k_println(" rc=0");
    return 0;
}
fn main()i32 {
    let cmd:[]u8=_zag_arg(1);
    if(cmd.len==0){kb_usage();return 1;}
    let mode:i32=0;
    let fa:i32=0;
    if(_zag_strcmp(cmd,"init")==1){
        if(kb_flag_scan(3,&mode,&fa)!=0){kb_usage();return 1;}
        return kb_init(_zag_arg(2));
    }
    if(_zag_strcmp(cmd,"put")==1){
        if(kb_flag_scan(6,&mode,&fa)!=0){kb_usage();return 1;}
        let tf:[]u8=_zag_arg(5);
        let tbuf:[]u8=k_alloc(1048576);
        let tlen:i32=0;
        if(tbuf.len==0){k_println("NOMEM");return 2;}
        if(kb_read_textfile(tf,1048576,tbuf,&tlen)!=0){k_println("PUT bad-textfile");return 1;}
        if(tlen<1){k_println("PUT bad-textfile");return 1;}
        return kb_cmd_put(_zag_arg(2),ig_atoi(_zag_arg(3)),_zag_arg(4),tbuf[0..tlen],mode,fa);
    }
    if(_zag_strcmp(cmd,"crashput")==1){
        let pt:i32=ig_atoi(_zag_arg(6));
        if(pt<1||pt>3){kb_usage();return 1;}
        if(kb_flag_scan(7,&mode,&fa)!=0){kb_usage();return 1;}
        fa=pt;
        let tf:[]u8=_zag_arg(5);
        let tbuf:[]u8=k_alloc(1048576);
        let tlen:i32=0;
        if(tbuf.len==0){k_println("NOMEM");return 2;}
        if(kb_read_textfile(tf,1048576,tbuf,&tlen)!=0){k_println("PUT bad-textfile");return 1;}
        if(tlen<1){k_println("PUT bad-textfile");return 1;}
        return kb_cmd_put(_zag_arg(2),ig_atoi(_zag_arg(3)),_zag_arg(4),tbuf[0..tlen],mode,fa);
    }
    if(_zag_strcmp(cmd,"revise")==1){
        if(kb_flag_scan(5,&mode,&fa)!=0){kb_usage();return 1;}
        let tf:[]u8=_zag_arg(4);
        let tbuf:[]u8=k_alloc(1048576);
        let tlen:i32=0;
        if(tbuf.len==0){k_println("NOMEM");return 2;}
        if(kb_read_textfile(tf,1048576,tbuf,&tlen)!=0){k_println("REVISE bad-textfile");return 1;}
        if(tlen<1){k_println("REVISE bad-textfile");return 1;}
        return kb_cmd_revise(_zag_arg(2),ig_atoi(_zag_arg(3)),tbuf[0..tlen],mode,fa);
    }
    if(_zag_strcmp(cmd,"crashrevise")==1){
        let pt:i32=ig_atoi(_zag_arg(5));
        if(pt<1||pt>3){kb_usage();return 1;}
        if(kb_flag_scan(6,&mode,&fa)!=0){kb_usage();return 1;}
        fa=pt;
        let tf:[]u8=_zag_arg(4);
        let tbuf:[]u8=k_alloc(1048576);
        let tlen:i32=0;
        if(tbuf.len==0){k_println("NOMEM");return 2;}
        if(kb_read_textfile(tf,1048576,tbuf,&tlen)!=0){k_println("REVISE bad-textfile");return 1;}
        if(tlen<1){k_println("REVISE bad-textfile");return 1;}
        return kb_cmd_revise(_zag_arg(2),ig_atoi(_zag_arg(3)),tbuf[0..tlen],mode,fa);
    }
    if(_zag_strcmp(cmd,"delete")==1){
        if(kb_flag_scan(4,&mode,&fa)!=0){kb_usage();return 1;}
        return kb_cmd_delete(_zag_arg(2),ig_atoi(_zag_arg(3)),mode);
    }
    if(_zag_strcmp(cmd,"get")==1){
        if(kb_flag_scan(4,&mode,&fa)!=0){kb_usage();return 1;}
        return kb_get(_zag_arg(2),ig_atoi(_zag_arg(3)),mode);
    }
    if(_zag_strcmp(cmd,"verify")==1){
        if(kb_flag_scan(3,&mode,&fa)!=0){kb_usage();return 1;}
        return kb_census(_zag_arg(2),mode);
    }
    if(_zag_strcmp(cmd,"recover")==1){
        return kb_recover(_zag_arg(2));
    }
    if(_zag_strcmp(cmd,"batch")==1){
        if(kb_flag_scan(4,&mode,&fa)!=0){kb_usage();return 1;}
        return kb_batch(_zag_arg(2),_zag_arg(3),mode,fa);
    }
    if(_zag_strcmp(cmd,"dump")==1){
        return kb_dump(_zag_arg(2));
    }
    if(_zag_strcmp(cmd,"stats")==1){
        return kb_stats(_zag_arg(2));
    }
    kb_usage();
    return 1;
}

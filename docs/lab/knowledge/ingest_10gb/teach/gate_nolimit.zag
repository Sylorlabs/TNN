@import("R33_NATIVE_SHA256_V2.zag")
// ingest.zag — 10GB generalist ingest through TNN's deliberate learning path.
// (Phase 2 TEACH; pattern ported from the 1GB ingest.zag, 1GB dir untouched.)
//
// Micah's order (2026-09-22): ingest >=1GB of English + basics through the
// REAL learning path (deliberate install with judgment), not hand-injection.
//
// Lineage: the S5 store + decision core (evidence -> eliminative verify ->
// deliberate add, 16-word audit layout, width compaction, sha256 chain,
// event log) is ported from ops/storage-compression/src/s5_learner.zag.
// Port equivalence is proven by textual diff + behavioral test (see
// PORT_EQUIV.md). This binary ADDS: text blob tier (S5 slots hold i64, not
// text), the judgment gate (G1-G4 + per-lesson CAL + negative control),
// sparse key->id index, revise/delete via override table + tombstones,
// persistent disk format, query/report modes.
//
// Modes (argv[1]):
//   ingest  <facts.dat> <bad.bin> <outdir> <ncap>
//   sindex  <outdir>
//   query   <outdir> <key>
//   bquery  <outdir> <keys.bin>
//   revise  <outdir> <id> <newtext.bin>
//   delete  <outdir> <id>
//   report  <outdir>
//   panswer <storedir> <questions.tsv> <ansdir>
//
// facts.dat record: [1B kind][2B key_len BE][4B text_len BE][key][text]
// blob record:      [1B kind][4B id LE][2B key_len BE][4B text_len BE][key][text]
// kind: 5=ostx 6=se 7=gb 8=wb  (10GB program; 1GB kinds 1-4 not accepted)
//
// Zero RNG. Pure Zag decision path. No wall-clock in artifacts.

// ---------- constants ----------
const IG_LESSON:i32=65536;          // records per lesson (CAL every lesson)
const IG_BLOB_CHUNK:i64=33488896;   // 32MiB-64KiB, under the 2^25 slice limit
const IG_MAX_KEY:i32=160;
const IG_MAX_TEXT:i32=4096;
const IG_SPARSE_EVERY:i32=1024;
const IG_READ_BUF:i32=1048576;      // 1MiB stream buffer
// S5 (ported consts)
const SC_CHUNK_SLOTS:i32=4096;
const SC_CHUNK_BYTES:i32=49152;
const SC_CHAIN_BYTES:i32=32;
const SC_EVENT_BYTES:i32=16;
const SC_CHAIN_SCRATCH:i32=49184;

// ---------- alloc + accessors (ported) ----------
fn sc_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn sc_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn sc_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn sc_g64(b:[]u8,o:i64)i64 {
    let o32:i32=o as i32;
    let v:i64=0;
    v=v|((b[o32] as i64)&255);
    v=v|(((b[o32+1] as i64)&255)<<8);
    v=v|(((b[o32+2] as i64)&255)<<16);
    v=v|(((b[o32+3] as i64)&255)<<24);
    v=v|(((b[o32+4] as i64)&255)<<32);
    v=v|(((b[o32+5] as i64)&255)<<40);
    v=v|(((b[o32+6] as i64)&255)<<48);
    v=v|(((b[o32+7] as i64)&255)<<56);
    return v;
}
fn sc_s64(b:[]u8,o:i64,v:i64)void {
    let o32:i32=o as i32;
    b[o32]=(v&255) as u8;
    b[o32+1]=((v>>8)&255) as u8;
    b[o32+2]=((v>>16)&255) as u8;
    b[o32+3]=((v>>24)&255) as u8;
    b[o32+4]=((v>>32)&255) as u8;
    b[o32+5]=((v>>40)&255) as u8;
    b[o32+6]=((v>>48)&255) as u8;
    b[o32+7]=((v>>56)&255) as u8;
}
fn sc_g16(b:[]u8,o:i32)i32 {
    let v:i32=(b[o] as i32)&255;
    v=v|((((b[o+1] as i32)&255))<<8);
    if(v>=32768){v=v-65536;}
    return v;
}
fn sc_s16(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
}
// i64 -> decimal without trailing newline (AGENTS.md helper-print quirk)
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn ig_print(s:[]u8)void {_zag_print(s);}
fn ig_println(s:[]u8)void {_zag_println(s);}
fn ig_print_i64(v:i64)void {_zag_print(i64s(v));}

// ---------- file IO ----------
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=sc_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn ig_open_rdonly(path:[]u8)i64 {
    let c:[]u8=z_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn ig_open_write(path:[]u8)i64 {
    let c:[]u8=z_cstr(path);
    if(c.len==0){return -1;}
    // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644; no O_EXCL (AGENTS.md)
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn ig_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn ig_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn ig_write_all(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return 0;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){return -1;}
        at=at+(n as i32);
    }
    return 0;
}
// path join: dir + "/" + name ; zero-padded blob name: dir/blob_000000.dat
fn ig_join(dir:[]u8,name:[]u8)[]u8 {
    let b:[]u8=sc_alloc(dir.len+1+name.len);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    i=0;
    while(i<name.len){b[dir.len+1+i]=name[i];i=i+1;}
    return b;
}
fn ig_blob_name(dir:[]u8,idx:i32)[]u8 {
    // "blob_" + 6 digits + ".dat"
    let nm:[]u8=sc_alloc(15);
    if(nm.len==0){return nm;}
    nm[0]=98;nm[1]=108;nm[2]=111;nm[3]=98;nm[4]=95;
    let d:i32=100000;
    let p:i32=5;
    while(d>=1){
        nm[p]=((idx/d)%10+48) as u8;
        p=p+1;
        d=d/10;
    }
    nm[11]=46;nm[12]=100;nm[13]=97;nm[14]=116;
    return ig_join(dir,nm);
}
fn ig_mkdir(dir:[]u8)i32 {
    let c:[]u8=z_cstr(dir);
    if(c.len==0){return -1;}
    // mkdir(2)=83, mode 0755=493; ignore EEXIST
    _zag_raw_syscall(83,(_zag_slice_ptr(c) as i64),493,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return 0;
}

// ================= S5 STORE (ported from s5_learner.zag) =================
// Decision core: evidence -> eliminative verify -> deliberate add.
// Slot[i] = i64 value (here: blob offset). Meta per slot: clock_delta i16,
// flags u8, spare u8. flags bit0=deleted, bit1=revised (ingest extension;
// S5 instrument used flags=0).
struct ScStore {
    cap:i32, n:i32,
    nchunks:i32, chunk_ptrs:[]u8,
    chain:[]u8, nsealed:i32,
    events:[]u8, events_n:i32, events_cap:i32,
    seal:[]u8, chain_scratch:[]u8,
    fill_buf:[]u8, widths:[]u8, clkbase:[]u8,
    learn_gate:i32, clock:i32,
    ops_add:i64, ops_find:i64, ops_audit:i64
}
fn sc_store_init(cap:i32,s:*ScStore)i32 {
    let nchunks:i32=(cap+4095)/SC_CHUNK_SLOTS;
    let cptrs:[]u8=sc_alloc(nchunks*8);
    if(cptrs.len==0){return -1;}
    let ci:i32=0;
    while(ci<nchunks){
        let ch:[]u8=sc_alloc(SC_CHUNK_BYTES);
        if(ch.len==0){return -1;}
        sc_s64(cptrs,ci*8,_zag_slice_ptr(ch) as i64);
        ci=ci+1;
    }
    let chn:[]u8=sc_alloc(nchunks*SC_CHAIN_BYTES);
    if(chn.len==0){return -1;}
    let evb:[]u8=sc_alloc(256*SC_EVENT_BYTES);
    if(evb.len==0){return -1;}
    let sl:[]u8=sc_alloc(SC_CHAIN_BYTES);
    if(sl.len==0){return -1;}
    let scr:[]u8=sc_alloc(SC_CHAIN_SCRATCH);
    if(scr.len==0){return -1;}
    s.*.cap=cap;s.*.n=0;
    s.*.nchunks=nchunks;s.*.chunk_ptrs=cptrs;
    s.*.chain=chn;s.*.nsealed=0;
    s.*.events=evb;s.*.events_n=0;s.*.events_cap=256;
    s.*.seal=sl;s.*.chain_scratch=scr;
    let fb:[]u8=sc_alloc(SC_CHUNK_BYTES);
    if(fb.len==0){return -1;}
    let wd:[]u8=sc_alloc(nchunks);
    if(wd.len==0){return -1;}
    s.*.fill_buf=fb;s.*.widths=wd;
    let ckb:[]u8=sc_alloc(nchunks*4);
    if(ckb.len==0){return -1;}
    ci=0;
    while(ci<nchunks*4){ckb[ci]=255;ci=ci+1;}
    s.*.clkbase=ckb;
    s.*.learn_gate=1;s.*.clock=0;
    s.*.ops_add=0;s.*.ops_find=0;s.*.ops_audit=0;
    return 0;
}
// Load-path init: same metadata as sc_store_init but does NOT allocate chunk
// bodies (ig_store_load overwrites all nsealed chunk_ptrs with loaded chunks;
// the preallocated bodies would leak). Unsealed chunk pointers stay NULL -
// safe because the load path only ever reads sealed chunks (id < n).
fn sc_store_init_for_load(cap:i32,s:*ScStore)i32 {
    let nchunks:i32=(cap+4095)/SC_CHUNK_SLOTS;
    let cptrs:[]u8=sc_alloc(nchunks*8);
    if(cptrs.len==0){return -1;}
    let chn:[]u8=sc_alloc(nchunks*SC_CHAIN_BYTES);
    if(chn.len==0){return -1;}
    let evb:[]u8=sc_alloc(256*SC_EVENT_BYTES);
    if(evb.len==0){return -1;}
    let sl:[]u8=sc_alloc(SC_CHAIN_BYTES);
    if(sl.len==0){return -1;}
    let scr:[]u8=sc_alloc(SC_CHAIN_SCRATCH);
    if(scr.len==0){return -1;}
    s.*.cap=cap;s.*.n=0;
    s.*.nchunks=nchunks;s.*.chunk_ptrs=cptrs;
    s.*.chain=chn;s.*.nsealed=0;
    s.*.events=evb;s.*.events_n=0;s.*.events_cap=256;
    s.*.seal=sl;s.*.chain_scratch=scr;
    let fb:[]u8=sc_alloc(SC_CHUNK_BYTES);
    if(fb.len==0){return -1;}
    let wd:[]u8=sc_alloc(nchunks);
    if(wd.len==0){return -1;}
    s.*.fill_buf=fb;s.*.widths=wd;
    let ckb:[]u8=sc_alloc(nchunks*4);
    if(ckb.len==0){return -1;}
    let ci:i32=0;
    while(ci<nchunks*4){ckb[ci]=255;ci=ci+1;}
    s.*.clkbase=ckb;
    s.*.learn_gate=1;s.*.clock=0;
    s.*.ops_add=0;s.*.ops_find=0;s.*.ops_audit=0;
    return 0;
}
fn sc_slot_chunk(s:*ScStore,c:i32)[]u8 {
    if(c==s.*.nsealed){
        return s.*.fill_buf;
    }
    let ptrs:[]u8=s.*.chunk_ptrs;
    let p:i64=sc_g64(ptrs,c*8);
    let cp:*u8=p as *u8;
    let wtag:i32=(s.*.widths[c] as i32)&255;
    let w:i32=wtag&15;
    return cp[0..4096*(w+4)];
}
fn sc_id2slot_get(s:*ScStore,id:i32)i32 {
    if(id<0||id>=s.*.n){return -1;}
    return id;
}
fn sc_wval(b:[]u8,o:i32,v:i64,w:i32)void {
    if(w==8){sc_s64(b,o as i64,v);return;}
    if(w==4){sc_s32(b,o,v as i32);return;}
    if(w==2){b[o]=(v&255) as u8;b[o+1]=((v>>8)&255) as u8;return;}
    b[o]=(v&255) as u8;
}
fn sc_rval(b:[]u8,o:i32,w:i32,signed:i32)i64 {
    if(w==8){return sc_g64(b,o as i64);}
    if(w==4){
        let v:i32=sc_g32(b,o);
        if(signed!=0){
            if(v<0){return v as i64;}
            return v as i64;
        }
        return (v as i64)&4294967295;
    }
    if(w==2){
        let v:i32=((b[o] as i32)&255)|((((b[o+1] as i32)&255))<<8);
        if(signed!=0&&v>=32768){return (v-65536) as i64;}
        return v as i64;
    }
    let v2:i32=(b[o] as i32)&255;
    if(signed!=0&&v2>=128){return (v2-256) as i64;}
    return v2 as i64;
}
fn sc_pick_width(mn:i64,mx:i64)i32 {
    let signed:i32=0;
    if(mn<0){signed=16;}
    let w:i32=8;
    if(signed==0){
        if(mx<=255){w=1;}
        else{
            if(mx<=65535){w=2;}
            else{
                if(mx<=4294967295){w=4;}
            }
        }
    }else{
        if(mn>=-128&&mx<=127){w=1;}
        else{
            if(mn>=-32768&&mx<=32767){w=2;}
            else{
                if(mn>=-2147483648&&mx<=2147483647){w=4;}
            }
        }
    }
    return w|signed;
}
fn sc_compact_and_seal(s:*ScStore,c:i32,count:i32)i32 {
    let fb:[]u8=s.*.fill_buf;
    let mn:i64=0; let mx:i64=0;
    let k:i32=0;
    if(count>0){
        mn=sc_g64(fb,0); mx=mn;
        k=1;
        while(k<count){
            let v:i64=sc_g64(fb,(k*8) as i64);
            if(v<mn){mn=v;}
            if(v>mx){mx=v;}
            k=k+1;
        }
    }
    let wtag:i32=sc_pick_width(mn,mx);
    let w:i32=wtag&15;
    let csize:i32=4096*(w+4);
    let cc:[]u8=sc_alloc(csize);
    if(cc.len==0){return -1;}
    let moff:i32=4096*w;
    k=0;
    while(k<count){
        let v:i64=sc_g64(fb,(k*8) as i64);
        sc_wval(cc,k*w,v,w);
        let m:i32=32768+k*4;
        cc[moff+k*4]=fb[m];cc[moff+k*4+1]=fb[m+1];
        cc[moff+k*4+2]=fb[m+2];cc[moff+k*4+3]=fb[m+3];
        k=k+1;
    }
    let cptrs:[]u8=s.*.chunk_ptrs;
    sc_s64(cptrs,c*8,_zag_slice_ptr(cc) as i64);
    let wd:[]u8=s.*.widths;
    wd[c]=wtag as u8;
    // chain over the compact bytes actually written
    let used:i32=count*(w+4);
    let scr:[]u8=s.*.chain_scratch;
    let chn:[]u8=s.*.chain;
    let i:i32=0;
    if(c>0){
        while(i<32){scr[i]=chn[(c-1)*32+i];i=i+1;}
    }else{
        while(i<32){scr[i]=0;i=i+1;}
    }
    i=0;
    while(i<used){scr[32+i]=cc[i];i=i+1;}
    let out:[]u8=sc_alloc(32);
    if(out.len==0){return -1;}
    if(ns_sha256(scr[0..32+used],out)!=0){return -2;}
    i=0;
    while(i<32){chn[c*32+i]=out[i];i=i+1;}
    s.*.nsealed=s.*.nsealed+1;
    return 0;
}
fn sc_event_grow(s:*ScStore)i32 {
    let cap:i32=s.*.events_cap;
    let ncap:i32=cap*2;
    let nb:[]u8=sc_alloc(ncap*SC_EVENT_BYTES);
    if(nb.len==0){return -1;}
    let ob:[]u8=s.*.events;
    let i:i32=0;
    let nn:i32=s.*.events_n*SC_EVENT_BYTES;
    while(i<nn){nb[i]=ob[i];i=i+1;}
    s.*.events=nb;s.*.events_cap=ncap;
    return 0;
}
// event: tag u8@0, pos u32@1, p0 u32@5, p1 u32@9. tags: 1=add-fail(rc@5,id@6),
// 7=episode(stage@5), 8=lesson-reject(lesson@5,calmask@6), 9=revise(id@5),
// 10=delete(id@5), 11=cal-fail(detail).
fn sc_event_append(s:*ScStore,tag:i32,pos:i32,p0:i32,p1:i32)i32 {
    let n:i32=s.*.events_n;
    if(n>=s.*.events_cap){
        if(sc_event_grow(s)!=0){return -1;}
    }
    let ev:[]u8=s.*.events;
    let o:i32=n*SC_EVENT_BYTES;
    ev[o]=tag as u8;
    sc_s32(ev,o+1,pos);
    sc_s32(ev,o+5,p0);
    sc_s32(ev,o+9,p1);
    s.*.events_n=n+1;
    s.*.ops_audit=s.*.ops_audit+1;
    return 0;
}
fn sc_episode(s:*ScStore,stage:i32)i32 {
    s.*.clock=s.*.clock+1;
    return sc_event_append(s,7,s.*.n,stage,0);
}
// deliberate add (t5_add field writes / return codes)
fn sc_add(s:*ScStore,id:i32,v:i64,out_slot:*i32)i32 {
    if(s.*.learn_gate==0){
        sc_event_append(s,1,s.*.n,3,id);
        return 3;
    }
    let dupe:i32=sc_id2slot_get(s,id);
    s.*.ops_find=s.*.ops_find+1;
    if(dupe>=0){
        sc_event_append(s,1,s.*.n,1,id);
        return 1;
    }
    let n:i32=s.*.n;
    if(n>=s.*.cap){
        sc_event_append(s,1,s.*.n,2,id);
        return 2;
    }
    let fb:[]u8=s.*.fill_buf;
    let cn:i32=n/SC_CHUNK_SLOTS;
    let r2:i32=n%SC_CHUNK_SLOTS;
    sc_s64(fb,(r2*8) as i64,v);
    let mo2:i32=32768+r2*4;
    let ckb2:[]u8=s.*.clkbase;
    let base:i32=sc_g32(ckb2,cn*4);
    if(base==-1){ base=s.*.clock; sc_s32(ckb2,cn*4,base); }
    sc_s16(fb,mo2,s.*.clock-base);
    fb[mo2+2]=0;
    fb[mo2+3]=0;
    s.*.n=n+1;
    s.*.ops_add=s.*.ops_add+1;
    out_slot.*=n;
    if((n+1)%SC_CHUNK_SLOTS==0){
        sc_compact_and_seal(s,cn,SC_CHUNK_SLOTS);
    }
    return 0;
}
fn sc_recall(s:*ScStore,id:i32,out:*i64)i32 {
    let slot:i32=sc_id2slot_get(s,id);
    if(slot<0){return 0;}
    let c:i32=slot/SC_CHUNK_SLOTS;
    let k:i32=slot%SC_CHUNK_SLOTS;
    if(c==s.*.nsealed){
        out.*=sc_g64(s.*.fill_buf,(k*8) as i64);
        return 1;
    }
    let wtag:i32=(s.*.widths[c] as i32)&255;
    let w:i32=wtag&15;
    let sg:i32=0;
    if((wtag&16)!=0){sg=1;}
    let ch:[]u8=sc_slot_chunk(s,c);
    out.*=sc_rval(ch,k*w,w,sg);
    return 1;
}
// read slot meta flags byte (for tombstone/revised)
fn sc_flags_get(s:*ScStore,id:i32)i32 {
    let slot:i32=sc_id2slot_get(s,id);
    if(slot<0){return -1;}
    let c:i32=slot/SC_CHUNK_SLOTS;
    let k:i32=slot%SC_CHUNK_SLOTS;
    if(c==s.*.nsealed){
        let fb:[]u8=s.*.fill_buf;
        return (fb[32768+k*4+2] as i32)&255;
    }
    let wtag:i32=(s.*.widths[c] as i32)&255;
    let w:i32=wtag&15;
    let ch:[]u8=sc_slot_chunk(s,c);
    return (ch[4096*w+k*4+2] as i32)&255;
}
fn sc_flags_set(s:*ScStore,id:i32,fl:i32)i32 {
    let slot:i32=sc_id2slot_get(s,id);
    if(slot<0){return -1;}
    let c:i32=slot/SC_CHUNK_SLOTS;
    let k:i32=slot%SC_CHUNK_SLOTS;
    if(c==s.*.nsealed){
        let fb:[]u8=s.*.fill_buf;
        fb[32768+k*4+2]=fl as u8;
        return 0;
    }
    let wtag:i32=(s.*.widths[c] as i32)&255;
    let w:i32=wtag&15;
    let ch:[]u8=sc_slot_chunk(s,c);
    ch[4096*w+k*4+2]=fl as u8;
    return 0;
}
fn sc_seal_tail(s:*ScStore)i32 {
    let n:i32=s.*.n;
    if(n%SC_CHUNK_SLOTS==0){return 0;}
    return sc_compact_and_seal(s,n/SC_CHUNK_SLOTS,n%SC_CHUNK_SLOTS);
}
fn sc_seal_final(s:*ScStore)i32 {
    let scr:[]u8=s.*.chain_scratch;
    let chn:[]u8=s.*.chain;
    let ns:i32=s.*.nsealed;
    let i:i32=0;
    if(ns>0){
        while(i<32){scr[i]=chn[(ns-1)*32+i];i=i+1;}
    }else{
        while(i<32){scr[i]=0;i=i+1;}
    }
    let ev:[]u8=s.*.events;
    let en:i32=s.*.events_n*SC_EVENT_BYTES;
    i=0;
    while(i<en){scr[32+i]=ev[i];i=i+1;}
    let out:[]u8=s.*.seal;
    let rc:i32=ns_sha256(scr[0..32+en],out);
    if(rc!=0){return -2;}
    return 0;
}

// ================= JUDGMENT GATE (G1-G4 + CAL) =================
// Gate verdicts: 0=accept, 1=G1 wellformed, 2=G2 dupe, 3=G3 consistency.
// Every fact passes through this in the learning path. Reject reasons are
// counted and logged; nothing bypasses the gate (K2).
fn ig_key_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// has_sub: does hay contain needle (byte substring)?
fn ig_has_sub(hay:[]u8,needle:[]u8)i32 {
    if(needle.len<1){return 1;}
    if(needle.len>hay.len){return 0;}
    let i:i32=0;
    while(i+needle.len<=hay.len){
        let j:i32=0;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){break;}
            j=j+1;
        }
        if(j==needle.len){return 1;}
        i=i+1;
    }
    return 0;
}
// kind-6 key shape: "se:" site ":" ("q"|"a") ":" digits(>=1).
// site = >=1 byte, no ':' (58). Returns 1 iff the key is well-formed.
fn ig_se_key_ok(key:[]u8)i32 {
    if(key.len<8){return 0;}
    if(key[0]!=115||key[1]!=101||key[2]!=58){return 0;}
    let i:i32=3;
    let site_start:i32=i;
    while(i<key.len){
        if(key[i]==58){break;}
        i=i+1;
    }
    if(i<=site_start){return 0;}
    if(i+3>=key.len){return 0;}
    let qa:u8=key[i+1];
    if(qa!=113&&qa!=97){return 0;}
    if(key[i+2]!=58){return 0;}
    let j:i32=i+3;
    while(j<key.len){
        let c:u8=key[j];
        if(c<48||c>57){return 0;}
        j=j+1;
    }
    return 1;
}
// 1 if key is a question key (":q:"), 0 if answer, -1 if malformed.
fn ig_se_is_q(key:[]u8)i32 {
    if(ig_se_key_ok(key)!=1){return -1;}
    let i:i32=3;
    while(i<key.len){
        if(key[i]==58){break;}
        i=i+1;
    }
    if(key[i+1]==113){return 1;}
    return 0;
}
fn ig_gate(kind:i32,key:[]u8,text:[]u8,prev_key:[]u8,has_prev:i32,wscratch:[]u8)i32 {
    // G1: wellformed (extends CLEAN_SPEC R9.6 for kinds 5-8).
    // V-NOLIMIT: the 4096B text ceiling is removed (arbitrary limit); the
    // >=20B floor from the frozen spec is kept.
    if(kind<5||kind>8){return 1;}
    if(key.len<1||key.len>IG_MAX_KEY){return 1;}
    if(text.len<20){return 1;}
    let i:i32=0;
    while(i<key.len){
        let c:u8=key[i];
        if(c<32||c==127){return 1;}
        if(c==10){return 1;}
        i=i+1;
    }
    i=0;
    while(i<text.len){
        let c2:u8=text[i];
        if(c2==0){return 1;}
        if(c2<32&&c2!=10){return 1;}
        if(c2==127){return 1;}
        i=i+1;
    }
    // G2: dupe (adjacent in sorted stream)
    if(has_prev!=0){
        if(ig_key_eq(key,prev_key)==1){return 2;}
    }
    // G3: consistency (kind-specific, mechanical; see GATE_SPEC.md)
    if(kind==6){
        // se: question+answer pairing integrity: key names site, post
        // type, numeric post id; question facts carry the R9.2a
        // title/body binding ("\n\n").
        if(ig_se_key_ok(key)!=1){return 3;}
        if(ig_se_is_q(key)==1){
            let nl2:[]u8="\n\n";
            if(ig_has_sub(text,nl2)!=1){return 3;}
        }
    }else{
        // kinds 5 (ostx), 7 (gb), 8 (wb): passage wellformed = multi-word
        // (contains a space). Measured on real cleaned data: a sentence-
        // terminator rule rejects 55% of genuine ostx passages (headings,
        // exercises, captions), so the bar is multi-word, not terminated.
        let sp:[]u8=" ";
        if(ig_has_sub(text,sp)!=1){return 3;}
    }
    return 0;
}
// Frozen CAL must-reject probes (synthetic). probe_idx 0..3.
// Writes kind/key/text into caller buffers; returns 0 ok.
// Frozen CAL must-reject probes (synthetic). probe_idx 0..3.
// Writes kind/key/text into caller buffers; returns 0 ok.
// Expected gate verdicts: probe0->1 (G1), probe1->2 (G2), probe2->1 (G1),
// probe3->3 (G3). Covers kinds 5-8: R1 empty text (ostx), R2 dupe,
// R3 NUL key (se), R4 kind-6 question without the title/body binding.
fn ig_cal_bad(probe_idx:i32,dupe_key:[]u8,kind_out:*i32,key:[]u8,key_len_out:*i32,text:[]u8,text_len_out:*i32)i32 {
    if(probe_idx==0){
        // R1: empty text (kind 5 ostx)
        kind_out.*=5;
        key[0]=122;key[1]=122;key[2]=98;key[3]=97;key[4]=100;key[5]=58;key[6]=114;key[7]=49;
        key_len_out.*=8;
        text_len_out.*=0;
        return 0;
    }
    if(probe_idx==1){
        // R2: dupe of lesson fact 0 (kind 5)
        kind_out.*=5;
        let i:i32=0;
        while(i<dupe_key.len){key[i]=dupe_key[i];i=i+1;}
        key_len_out.*=dupe_key.len;
        text[0]=100;text[1]=117;text[2]=112;text[3]=101;text[4]=32;text[5]=112;text[6]=114;text[7]=111;text[8]=98;text[9]=101;text[10]=32;text[11]=111;text[12]=102;text[13]=32;text[14]=108;text[15]=101;text[16]=115;text[17]=115;text[18]=111;text[19]=110;text[20]=32;text[21]=102;text[22]=97;text[23]=99;text[24]=116;text[25]=32;text[26]=122;text[27]=101;text[28]=114;text[29]=111;
        text_len_out.*=30;
        return 0;
    }
    if(probe_idx==2){
        // R3: NUL in key (kind 6 se)
        kind_out.*=6;
        key[0]=122;key[1]=122;key[2]=98;key[3]=97;key[4]=100;key[5]=0;key[6]=58;key[7]=114;key[8]=51;
        key_len_out.*=9;
        text[0]=110;text[1]=117;text[2]=108;text[3]=32;text[4]=112;text[5]=114;text[6]=111;text[7]=98;text[8]=101;
        text_len_out.*=9;
        return 0;
    }
    // R4: kind-6 question without the title/body separator -> G3
    kind_out.*=6;
    let kk:[]u8="se:zzsite:q:1";
    let i2:i32=0;
    while(i2<kk.len){key[i2]=kk[i2];i2=i2+1;}
    key_len_out.*=kk.len;
    let tt:[]u8="question without separator here";
    i2=0;
    while(i2<tt.len){text[i2]=tt[i2];i2=i2+1;}
    text_len_out.*=tt.len;
    return 0;
}

// ================= STREAM READER =================
struct IgReader {
    fd:i64,
    buf:[]u8,
    pos:i32,
    fill:i32,
    eof:i32,
    kbuf:[]u8,     // V-NOLIMIT: growable key scratch (owned by reader)
    tbuf:[]u8,     // V-NOLIMIT: growable text scratch (owned by reader)
    rec_key:[]u8,  // V-NOLIMIT: kbuf[0..klen] of last record read
    rec_text:[]u8  // V-NOLIMIT: tbuf[0..tlen] of last record read
}
fn igr_init(r:*IgReader,path:[]u8)i32 {
    let fd:i64=ig_open_rdonly(path);
    if(fd<0){return -1;}
    let b:[]u8=sc_alloc(IG_READ_BUF);
    if(b.len==0){ig_close(fd);return -1;}
    r.*.fd=fd;r.*.buf=b;r.*.pos=0;r.*.fill=0;r.*.eof=0;
    r.*.kbuf="";r.*.tbuf="";r.*.rec_key="";r.*.rec_text="";
    return 0;
}
fn igr_refill(r:*IgReader)i32 {
    let b:[]u8=r.*.buf;
    let pos:i32=r.*.pos;
    let fill:i32=r.*.fill;
    // shift remaining to front
    let rem:i32=fill-pos;
    let i:i32=0;
    while(i<rem){b[i]=b[pos+i];i=i+1;}
    let got:i32=ig_read_into(r.*.fd,b[rem..]);
    if(got<0){return -1;}
    r.*.pos=0;
    r.*.fill=rem+got;
    if(got==0){r.*.eof=1;}
    return 0;
}
// take exactly n bytes into out (out must have len >= n)
fn igr_take(r:*IgReader,n:i32,out:[]u8)i32 {
    let need:i32=n;
    let at:i32=0;
    while(need>0){
        let b:[]u8=r.*.buf;
        let pos:i32=r.*.pos;
        let fill:i32=r.*.fill;
        let avail:i32=fill-pos;
        if(avail<=0){
            if(r.*.eof!=0){return 1;} // end of stream
            if(igr_refill(r)!=0){return -1;}
            continue;
        }
        let k:i32=need;
        if(k>avail){k=avail;}
        let j:i32=0;
        while(j<k){out[at+j]=b[pos+j];j=j+1;}
        r.*.pos=pos+k;
        at=at+k;
        need=need-k;
    }
    return 0;
}
fn igr_close(r:*IgReader)void {ig_close(r.*.fd);}
// V-NOLIMIT: grow reader-owned record buffers to fit (klen,tlen); no size cap.
// returns: 0 ok, 1 end-of-stream, -1 error/alloc-fail, -2 corrupt header.
fn igr_ensure(r:*IgReader,need_k:i32,need_t:i32)i32 {
    if(need_k>r.*.kbuf.len){
        let nb:[]u8=sc_alloc(need_k);
        if(nb.len<need_k){return -1;}
        r.*.kbuf=nb;
    }
    if(need_t>r.*.tbuf.len){
        let nb2:[]u8=sc_alloc(need_t);
        if(nb2.len<need_t){return -1;}
        r.*.tbuf=nb2;
    }
    return 0;
}
// read one facts.dat record: [1B kind][2B klen BE][4B tlen BE][key][text]
// hdr is a caller-owned 7-byte scratch (reused across calls; avoids per-record alloc).
// Record bytes land in reader-owned buffers; use r.*.rec_key / r.*.rec_text
// IMMEDIATELY (valid only until the next igr_record call on this reader).
// returns: 0 ok, 1 end-of-stream, -1 error, -2 corrupt header (negative len)
fn igr_record(r:*IgReader,hdr:[]u8,kind_out:*i32,key_len_out:*i32,text_len_out:*i32)i32 {
    if(hdr.len<7){return -1;}
    let rc:i32=igr_take(r,7,hdr);
    if(rc==1){return 1;}
    if(rc!=0){return -1;}
    let kind:i32=(hdr[0] as i32)&255;
    let klen:i32=(((hdr[1] as i32)&255)<<8)|((hdr[2] as i32)&255);
    let tlen:i32=(((hdr[3] as i32)&255)<<24)|(((hdr[4] as i32)&255)<<16)|(((hdr[5] as i32)&255)<<8)|((hdr[6] as i32)&255);
    if(klen<0||tlen<0){return -2;}
    if(igr_ensure(r,klen,tlen)!=0){return -1;}
    let kb:[]u8=r.*.kbuf;
    let tb:[]u8=r.*.tbuf;
    if(igr_take(r,klen,kb[0..klen])!=0){return -1;}
    if(igr_take(r,tlen,tb[0..tlen])!=0){return -1;}
    r.*.rec_key=kb[0..klen];
    r.*.rec_text=tb[0..tlen];
    kind_out.*=kind;
    key_len_out.*=klen;
    text_len_out.*=tlen;
    return 0;
}

// ================= BLOB WRITER =================
// Append-only records: [1B kind][4B id LE][2B klen BE][4B tlen BE][key][text]
// Chunk files: <dir>/blob_000000.dat, each exactly IG_BLOB_CHUNK bytes
// (zero-padded). Global offset -> (chunk = off / CHUNK, in = off % CHUNK).
struct IgBlob {
    dir:[]u8,
    nchunk:i32,     // fully written chunks
    cur:[]u8,       // current chunk buffer
    used:i32,       // bytes used in cur
    total:i64,      // total record bytes appended (= next global offset)
    recs:i64
}
fn igb_init(b:*IgBlob,dir:[]u8)i32 {
    let c:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    if(c.len==0){return -1;}
    // copy dir
    let d:[]u8=sc_alloc(dir.len);
    if(d.len==0){return -1;}
    let i:i32=0;
    while(i<dir.len){d[i]=dir[i];i=i+1;}
    b.*.dir=d;b.*.nchunk=0;b.*.cur=c;b.*.used=0;b.*.total=0;b.*.recs=0;
    return 0;
}
fn igb_flush_full(b:*IgBlob)i32 {
    // cur is exactly IG_BLOB_CHUNK bytes (padded by caller)
    let nm:[]u8=ig_blob_name(b.*.dir,b.*.nchunk);
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_write(nm);
    if(fd<0){return -1;}
    let rc:i32=ig_write_all(fd,b.*.cur);
    ig_close(fd);
    if(rc!=0){return -1;}
    b.*.nchunk=b.*.nchunk+1;
    b.*.used=0;
    return 0;
}
// append one record; returns global offset, or -1 on error
fn igb_append(b:*IgBlob,kind:i32,id:i32,key:[]u8,text:[]u8)i64 {
    let klen:i32=key.len;
    let tlen:i32=text.len;
    let reclen:i32=11+klen+tlen;
    let cur:[]u8=b.*.cur;
    let used:i32=b.*.used;
    if((used as i64)+ (reclen as i64) > IG_BLOB_CHUNK){
        // pad remainder with zeros, flush full chunk
        let p:i32=used;
        while(p<cur.len){cur[p]=0;p=p+1;}
        if(igb_flush_full(b)!=0){return -1;}
        cur=b.*.cur;
        used=0;
    }
    let off:i64=b.*.total;
    cur[used]=(kind&255) as u8;
    sc_s32(cur,used+1,id);
    cur[used+5]=((klen>>8)&255) as u8;
    cur[used+6]=(klen&255) as u8;
    sc_s32(cur,used+7,tlen);
    let i:i32=0;
    while(i<klen){cur[used+11+i]=key[i];i=i+1;}
    i=0;
    while(i<tlen){cur[used+11+klen+i]=text[i];i=i+1;}
    b.*.used=used+reclen;
    b.*.total=off+(reclen as i64);
    b.*.recs=b.*.recs+1;
    return off;
}
fn igb_finish(b:*IgBlob)i32 {
    // pad final chunk to full size and flush (uniform chunk mapping)
    let cur:[]u8=b.*.cur;
    let p:i32=b.*.used;
    while(p<cur.len){cur[p]=0;p=p+1;}
    return igb_flush_full(b);
}

// ================= PERSISTENCE =================
// store.dat layout:
// [8B magic "IGNST001"][4B cap][4B n][4B nsealed][4B nchunks][4B clock]
// [widths: nchunks bytes]
// [per sealed chunk c: 4B len][len bytes (compact slots)]
// [chain: nsealed*32 bytes]
// [4B events_n][events bytes]
// [32B seal]
// [8B blob_total][4B blob_nchunk][8B blob_recs]
fn ig_store_save(s:*ScStore,b:*IgBlob,dir:[]u8)i32 {
    let nm:[]u8=ig_join(dir,"store.dat");
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_write(nm);
    if(fd<0){return -1;}
    let hdr:[]u8=sc_alloc(28);
    if(hdr.len==0){ig_close(fd);return -1;}
    hdr[0]=73;hdr[1]=71;hdr[2]=78;hdr[3]=83;hdr[4]=84;hdr[5]=48;hdr[6]=48;hdr[7]=49;
    sc_s32(hdr,8,s.*.cap);
    sc_s32(hdr,12,s.*.n);
    sc_s32(hdr,16,s.*.nsealed);
    sc_s32(hdr,20,s.*.nchunks);
    sc_s32(hdr,24,s.*.clock);
    if(ig_write_all(fd,hdr)!=0){ig_close(fd);return -1;}
    let wd:[]u8=s.*.widths;
    if(ig_write_all(fd,wd[0..s.*.nchunks])!=0){ig_close(fd);return -1;}
    let c:i32=0;
    while(c<s.*.nsealed){
        let wtag:i32=(wd[c] as i32)&255;
        let w:i32=wtag&15;
        let len:i32=4096*(w+4);
        let lb:[]u8=sc_alloc(4);
        if(lb.len==0){ig_close(fd);return -1;}
        sc_s32(lb,0,len);
        if(ig_write_all(fd,lb)!=0){ig_close(fd);return -1;}
        let ch:[]u8=sc_slot_chunk(s,c);
        if(ig_write_all(fd,ch[0..len])!=0){ig_close(fd);return -1;}
        c=c+1;
    }
    let chn:[]u8=s.*.chain;
    if(ig_write_all(fd,chn[0..s.*.nsealed*32])!=0){ig_close(fd);return -1;}
    let enb:[]u8=sc_alloc(4);
    if(enb.len==0){ig_close(fd);return -1;}
    sc_s32(enb,0,s.*.events_n);
    if(ig_write_all(fd,enb)!=0){ig_close(fd);return -1;}
    let ev:[]u8=s.*.events;
    if(ig_write_all(fd,ev[0..s.*.events_n*SC_EVENT_BYTES])!=0){ig_close(fd);return -1;}
    let sl:[]u8=s.*.seal;
    if(ig_write_all(fd,sl)!=0){ig_close(fd);return -1;}
    let tail:[]u8=sc_alloc(20);
    if(tail.len==0){ig_close(fd);return -1;}
    sc_s64(tail,0,b.*.total);
    sc_s32(tail,8,b.*.nchunk);
    sc_s64(tail,12,b.*.recs);
    if(ig_write_all(fd,tail)!=0){ig_close(fd);return -1;}
    ig_close(fd);
    return 0;
}
// Load store.dat into s (fresh) + blob meta. Returns 0 ok.
fn ig_store_load(s:*ScStore,btotal:*i64,bnchunk:*i32,brecs:*i64,dir:[]u8)i32 {
    let nm:[]u8=ig_join(dir,"store.dat");
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_rdonly(nm);
    if(fd<0){return -1;}
    let hdr:[]u8=sc_alloc(28);
    if(hdr.len==0){ig_close(fd);return -1;}
    if(ig_read_into(fd,hdr)!=28){ig_close(fd);return -1;}
    if(hdr[0]!=73||hdr[1]!=71||hdr[2]!=78||hdr[3]!=83||hdr[4]!=84){ig_close(fd);return -1;}
    let ncap:i32=sc_g32(hdr,8);
    let n:i32=sc_g32(hdr,12);
    let nsealed:i32=sc_g32(hdr,16);
    let nchunks:i32=sc_g32(hdr,20);
    let clock:i32=sc_g32(hdr,24);
    if(sc_store_init_for_load(ncap,s)!=0){ig_close(fd);return -1;}
    let wd:[]u8=s.*.widths;
    if(ig_read_into(fd,wd[0..nchunks])!=nchunks){ig_close(fd);return -1;}
    let cptrs:[]u8=s.*.chunk_ptrs;
    let c:i32=0;
    while(c<nsealed){
        let lb:[]u8=sc_alloc(4);
        if(lb.len==0){ig_close(fd);return -1;}
        if(ig_read_into(fd,lb)!=4){ig_close(fd);return -1;}
        let len:i32=sc_g32(lb,0);
        let cc:[]u8=sc_alloc(len);
        if(cc.len==0){ig_close(fd);return -1;}
        if(ig_read_into(fd,cc)!=len){ig_close(fd);return -1;}
        sc_s64(cptrs,c*8,_zag_slice_ptr(cc) as i64);
        c=c+1;
    }
    s.*.n=n;
    s.*.nsealed=nsealed;
    s.*.clock=clock;
    let chn:[]u8=s.*.chain;
    if(ig_read_into(fd,chn[0..nsealed*32])!=nsealed*32){ig_close(fd);return -1;}
    let enb:[]u8=sc_alloc(4);
    if(enb.len==0){ig_close(fd);return -1;}
    if(ig_read_into(fd,enb)!=4){ig_close(fd);return -1;}
    let evn:i32=sc_g32(enb,0);
    // grow events if needed
    while(s.*.events_cap<evn){
        if(sc_event_grow(s)!=0){ig_close(fd);return -1;}
    }
    let ev:[]u8=s.*.events;
    if(ig_read_into(fd,ev[0..evn*SC_EVENT_BYTES])!=evn*SC_EVENT_BYTES){ig_close(fd);return -1;}
    s.*.events_n=evn;
    let sl:[]u8=s.*.seal;
    if(ig_read_into(fd,sl)!=32){ig_close(fd);return -1;}
    let tail:[]u8=sc_alloc(20);
    if(tail.len==0){ig_close(fd);return -1;}
    if(ig_read_into(fd,tail)!=20){ig_close(fd);return -1;}
    btotal.*=sc_g64(tail,0);
    bnchunk.*=sc_g32(tail,8);
    brecs.*=sc_g64(tail,12);
    ig_close(fd);
    return 0;
}
// overrides.dat: [4B count][count x (4B id + 8B blob_off)]
fn ig_ovr_load(dir:[]u8,ids:[]u8,offs:[]u8,maxn:i32,count_out:*i32)i32 {
    let nm:[]u8=ig_join(dir,"overrides.dat");
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_rdonly(nm);
    if(fd<0){
        count_out.*=0;
        return 0; // no overrides yet: not an error
    }
    let cb:[]u8=sc_alloc(4);
    if(cb.len==0){ig_close(fd);return -1;}
    let got:i32=ig_read_into(fd,cb);
    ig_close(fd);
    if(got<4){count_out.*=0;return 0;}
    let cnt:i32=sc_g32(cb,0);
    if(cnt<=0){count_out.*=0;return 0;}
    if(cnt>maxn){return -1;}
    // re-read fully: caller sized arrays; read entries
    let fd2:i64=ig_open_rdonly(nm);
    if(fd2<0){return -1;}
    let eb:[]u8=sc_alloc(4+cnt*12);
    if(eb.len==0){ig_close(fd2);return -1;}
    if(ig_read_into(fd2,eb)!=4+cnt*12){ig_close(fd2);return -1;}
    ig_close(fd2);
    let i:i32=0;
    while(i<cnt){
        sc_s32(ids,i*4,sc_g32(eb,4+i*12));
        sc_s64(offs,(i*8) as i64,sc_g64(eb,(4+i*12+4) as i64));
        i=i+1;
    }
    count_out.*=cnt;
    return 0;
}
fn ig_ovr_save(dir:[]u8,ids:[]u8,offs:[]u8,cnt:i32)i32 {
    let nm:[]u8=ig_join(dir,"overrides.dat");
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_write(nm);
    if(fd<0){return -1;}
    let eb:[]u8=sc_alloc(4+cnt*12);
    if(eb.len==0){ig_close(fd);return -1;}
    sc_s32(eb,0,cnt);
    let i:i32=0;
    while(i<cnt){
        sc_s32(eb,4+i*12,sc_g32(ids,i*4));
        sc_s64(eb,(4+i*12+4) as i64,sc_g64(offs,(i*8) as i64));
        i=i+1;
    }
    let rc:i32=ig_write_all(fd,eb);
    ig_close(fd);
    return rc;
}
fn ig_ovr_find(ids:[]u8,offs:[]u8,cnt:i32,id:i32,out:*i64)i32 {
    let i:i32=0;
    while(i<cnt){
        if(sc_g32(ids,i*4)==id){
            out.*=sc_g64(offs,(i*8) as i64);
            return 1;
        }
        i=i+1;
    }
    return 0;
}


// recompute the full chunk chain (after revise/delete change meta flags)
fn sc_chain_recompute_all(s:*ScStore)i32 {
    let scr:[]u8=s.*.chain_scratch;
    let chn:[]u8=s.*.chain;
    let ns:i32=s.*.nsealed;
    let c:i32=0;
    while(c<ns){
        let wtag:i32=(s.*.widths[c] as i32)&255;
        let w:i32=wtag&15;
        let cnt:i32=SC_CHUNK_SLOTS;
        if(c==ns-1){
            let rem:i32=s.*.n-c*SC_CHUNK_SLOTS;
            if(rem<SC_CHUNK_SLOTS){cnt=rem;}
        }
        let used:i32=cnt*(w+4);
        let chk:[]u8=sc_slot_chunk(s,c);
        let i:i32=0;
        if(c>0){
            while(i<32){scr[i]=chn[(c-1)*32+i];i=i+1;}
        }else{
            while(i<32){scr[i]=0;i=i+1;}
        }
        i=0;
        while(i<used){scr[32+i]=chk[i];i=i+1;}
        let out:[]u8=sc_alloc(32);
        if(out.len==0){return -1;}
        if(ns_sha256(scr[0..32+used],out)!=0){return -2;}
        i=0;
        while(i<32){chn[c*32+i]=out[i];i=i+1;}
        c=c+1;
    }
    return 0;
}
// read one full blob chunk file into buf (buf len must be >= IG_BLOB_CHUNK)
fn ig_blob_read_chunk(dir:[]u8,idx:i32,buf:[]u8)i32 {
    let nm:[]u8=ig_blob_name(dir,idx);
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_rdonly(nm);
    if(fd<0){return -1;}
    let got:i32=ig_read_into(fd,buf);
    ig_close(fd);
    return got;
}
// parse blob record header at (buf,off): kind,id,klen,tlen.
// returns record length, 0 at zero padding, -1 on truncation.
fn ig_blob_parse_hdr(buf:[]u8,off:i32,kind_out:*i32,id_out:*i32,klen_out:*i32,tlen_out:*i32)i32 {
    if(off>=buf.len){return 0;}
    let kind:i32=(buf[off] as i32)&255;
    if(kind==0){return 0;}
    if(off+11>buf.len){return -1;}
    kind_out.*=kind;
    id_out.*=sc_g32(buf,off+1);
    let kl:i32=(((buf[off+5] as i32)&255)<<8)|((buf[off+6] as i32)&255);
    let tl:i32=sc_g32(buf,off+7);
    klen_out.*=kl;
    tlen_out.*=tl;
    return 11+kl+tl;
}
// hex of 32-byte seal into 64-byte buffer
fn ig_hex32(src:[]u8,dst:[]u8)void {
    let i:i32=0;
    while(i<32){
        let v:i32=(src[i] as i32)&255;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){dst[i*2]=(48+hi) as u8;}else{dst[i*2]=(87+hi) as u8;}
        if(lo<10){dst[i*2+1]=(48+lo) as u8;}else{dst[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
}
// audit line builder
fn ab_str(b:[]u8,lp:*i32,s:[]u8)void {
    let i:i32=0;
    while(i<s.len){b[lp.*+i]=s[i];i=i+1;}
    lp.*=lp.*+s.len;
}
fn ab_i64(b:[]u8,lp:*i32,v:i64)void {
    let s:[]u8=i64s(v);
    ab_str(b,lp,s);
}
fn ab_line(fd:i64,b:[]u8,lp:i32)void {
    b[lp]=10;
    ig_write_all(fd,b[0..lp+1]);
}
fn ig_atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:i32=(s[i] as i32)&255;
        if(c<48||c>57){break;}
        v=v*10+(c-48);
        i=i+1;
    }
    return v;
}

// ================= LESSON PROCESSOR =================
// Returns: 0 lesson accepted+installed, 1 lesson CAL-rejected (dropped),
// 2 stream exhausted, -1 error.
// V-NOLIMIT: append src[0..slen] to a growable buffer; *used tracks the
// logical length. Returns the (possibly grown) buffer. If the returned
// buffer is shorter than *used, allocation failed (caller must check).
fn ig_buf_append(buf:[]u8,used:*i32,src:[]u8,slen:i32)[]u8 {
    let u:i32=used.*;
    used.*=u+slen;
    if(u+slen>buf.len){
        let ns:i32=(u+slen)*2;
        if(ns<64){ns=64;}
        let nb:[]u8=sc_alloc(ns);
        if(nb.len==ns){
            let i:i32=0;
            while(i<u){nb[i]=buf[i];i=i+1;}
            buf=nb;
        }
    }
    if(buf.len>=u+slen){
        let j:i32=0;
        while(j<slen){buf[u+j]=src[j];j=j+1;}
    }
    return buf;
}
fn ig_process_lesson(rr:*IgReader,st:*ScStore,bb:*IgBlob,
    prev_key:[]u8,prev_len:*i32,has_prev:*i32,
    g1:*i64,g2:*i64,g3:*i64,ninst:*i64,
    key:[]u8,text:[]u8,
    key4:[]u8,kl4:[]u8,tl4:[]u8,kind4:[]u8,text4:[]u8,
    koff4:[]u8,toff4:[]u8,
    afd:i64,line:[]u8,lesson_idx:i32,ncap:i32)i32 {
    // caller-owned scratch reused across all records in this lesson
    let rhdr:[]u8=sc_alloc(7);
    if(rhdr.len==0){return -1;}
    let wscr:[]u8=sc_alloc(IG_MAX_KEY);
    if(wscr.len==0){return -1;}
    // peek up to 4 records for must-accept CALs.
    // V-NOLIMIT: peeked records are copied into the growable key4/text4
    // buffers; koff4/toff4 hold per-slot base offsets (replacing the fixed
    // IG_MAX_KEY / IG_MAX_TEXT stride).
    let npeek:i32=0;
    let pk:i32=0;
    let k4len:i32=0;
    let t4len:i32=0;
    while(pk<4){
        let ko:i32=0; let kl2:i32=0; let tl2:i32=0;
        let rc:i32=igr_record(rr,rhdr,&ko,&kl2,&tl2);
        if(rc==1){break;}
        if(rc!=0){return -1;}
        let rk:[]u8=rr.*.rec_key;
        let rt:[]u8=rr.*.rec_text;
        sc_s32(koff4,pk*4,k4len);
        sc_s32(toff4,pk*4,t4len);
        key4=ig_buf_append(key4,&k4len,rk,kl2);
        text4=ig_buf_append(text4,&t4len,rt,tl2);
        if(key4.len<k4len||text4.len<t4len){return -1;}
        kind4[pk]=(ko&255) as u8;
        sc_s32(kl4,pk*4,kl2);
        sc_s32(tl4,pk*4,tl2);
        npeek=pk+1;
        pk=pk+1;
    }
    if(npeek==0){return 2;}
    // --- CAL dry-run: must-accept (first 4) ---
    let cal_ok:i32=1;
    let calmask:i32=0;
    pk=0;
    while(pk<npeek){
        let kl2b:i32=sc_g32(kl4,pk*4);
        let tl2b:i32=sc_g32(tl4,pk*4);
        let ko2b:i32=sc_g32(koff4,pk*4);
        let to2b:i32=sc_g32(toff4,pk*4);
        let kk:[]u8=key4[ko2b..ko2b+kl2b];
        let tt:[]u8=text4[to2b..to2b+tl2b];
        let pv:[]u8=prev_key[0..prev_len.*];
        let v:i32=ig_gate((kind4[pk] as i32)&255,kk,tt,pv,has_prev.*,wscr);
        if(v!=0){cal_ok=0;calmask=calmask|(1<<pk);}
        pk=pk+1;
    }
    // --- CAL dry-run: must-reject (4 synthetic) ---
    let exp:[]u8=sc_alloc(4);
    if(exp.len==0){return -1;}
    exp[0]=1;exp[1]=2;exp[2]=1;exp[3]=3;
    let pr:i32=0;
    while(pr<4){
        let ko2:i32=0; let kl3:i32=0; let tl3:i32=0;
        let dk0:i32=sc_g32(koff4,0);
        let dk1:i32=sc_g32(kl4,0);
        ig_cal_bad(pr,key4[dk0..dk0+dk1],&ko2,key,&kl3,text,&tl3);
        let kk2:[]u8=key[0..kl3];
        let tt2:[]u8=text[0..tl3];
        let hp2:i32=0;
        let pv2:[]u8=key[0..0];
        if(pr==1){
            // R2: dupe of lesson fact 0
            let kl0:i32=sc_g32(kl4,0);
            pv2=key4[dk0..dk0+kl0];
            hp2=1;
        }
        let v2:i32=ig_gate(ko2,kk2,tt2,pv2,hp2,wscr);
        if(v2!=((exp[pr] as i32)&255)){cal_ok=0;calmask=calmask|(16<<pr);}
        pr=pr+1;
    }
    if(cal_ok==0){
        // lesson rejected as a unit: consume+drop the rest of the lesson
        sc_event_append(st,8,lesson_idx,calmask,0);
        let consumed:i32=npeek;
        while(consumed<IG_LESSON){
            let ko3:i32=0; let kl4b:i32=0; let tl4b:i32=0;
            let rc2:i32=igr_record(rr,rhdr,&ko3,&kl4b,&tl4b);
            if(rc2==1){break;}
            if(rc2!=0){return -1;}
            consumed=consumed+1;
        }
        let lp:i32=0;
        ab_str(line,&lp,"LESSON ");ab_i64(line,&lp,lesson_idx as i64);
        ab_str(line,&lp," CAL=REJECT mask=");ab_i64(line,&lp,calmask as i64);
        ab_str(line,&lp," dropped=");ab_i64(line,&lp,consumed as i64);
        ab_line(afd,line,lp);
        sc_episode(st,lesson_idx);
        return 1;
    }
    // --- real install ---
    let lg1:i64=0; let lg2:i64=0; let lg3:i64=0; let la:i64=0;
    let total:i32=0;
    pk=0;
    while(pk<npeek){
        let kl2c:i32=sc_g32(kl4,pk*4);
        let tl2c:i32=sc_g32(tl4,pk*4);
        let ko2c:i32=sc_g32(koff4,pk*4);
        let to2c:i32=sc_g32(toff4,pk*4);
        let kk3:[]u8=key4[ko2c..ko2c+kl2c];
        let tt3:[]u8=text4[to2c..to2c+tl2c];
        let pv3:[]u8=prev_key[0..prev_len.*];
        let v3:i32=ig_gate((kind4[pk] as i32)&255,kk3,tt3,pv3,has_prev.*,wscr);
        if(v3==0){
            let id:i32=st.*.n;
            if(id>=ncap){return -1;}
            let off:i64=igb_append(bb,(kind4[pk] as i32)&255,id,kk3,tt3);
            if(off<0){return -1;}
            let slot:i32=0;
            if(sc_add(st,id,off,&slot)!=0){return -1;}
            let cp:i32=0;
            while(cp<kl2c){prev_key[cp]=kk3[cp];cp=cp+1;}
            prev_len.*=kl2c;
            has_prev.*=1;
            la=la+1;
        }else{
            if(v3==1){lg1=lg1+1;}else{if(v3==2){lg2=lg2+1;}else{lg3=lg3+1;}}
            let cp2:i32=0;
            while(cp2<kl2c){prev_key[cp2]=kk3[cp2];cp2=cp2+1;}
            prev_len.*=kl2c;
            has_prev.*=1;
        }
        total=total+1;
        pk=pk+1;
    }
    while(total<IG_LESSON){
        let ko4:i32=0; let kl5:i32=0; let tl5:i32=0;
        let rc3:i32=igr_record(rr,rhdr,&ko4,&kl5,&tl5);
        if(rc3==1){break;}
        if(rc3!=0){return -1;}
        let kk4:[]u8=rr.*.rec_key;
        let tt4:[]u8=rr.*.rec_text;
        let pv4:[]u8=prev_key[0..prev_len.*];
        let v4:i32=ig_gate(ko4,kk4,tt4,pv4,has_prev.*,wscr);
        if(v4==0){
            let id2:i32=st.*.n;
            if(id2>=ncap){return -1;}
            let off2:i64=igb_append(bb,ko4,id2,kk4,tt4);
            if(off2<0){return -1;}
            let slot2:i32=0;
            if(sc_add(st,id2,off2,&slot2)!=0){return -1;}
            la=la+1;
        }else{
            if(v4==1){lg1=lg1+1;}else{if(v4==2){lg2=lg2+1;}else{lg3=lg3+1;}}
        }
        let cp3:i32=0;
        while(cp3<kl5){prev_key[cp3]=kk4[cp3];cp3=cp3+1;}
        prev_len.*=kl5;
        has_prev.*=1;
        total=total+1;
    }
    g1.*=g1.*+lg1; g2.*=g2.*+lg2; g3.*=g3.*+lg3; ninst.*=ninst.*+la;
    let lp2:i32=0;
    ab_str(line,&lp2,"LESSON ");ab_i64(line,&lp2,lesson_idx as i64);
    ab_str(line,&lp2," CAL=OK inst=");ab_i64(line,&lp2,la);
    ab_str(line,&lp2," g1=");ab_i64(line,&lp2,lg1);
    ab_str(line,&lp2," g2=");ab_i64(line,&lp2,lg2);
    ab_str(line,&lp2," g3=");ab_i64(line,&lp2,lg3);
    ab_line(afd,line,lp2);
    sc_episode(st,lesson_idx);
    return 0;
}

// ================= MAIN INGEST =================
fn ig_ingest(facts_path:[]u8,bad_path:[]u8,outdir:[]u8,ncap:i32)i32 {
    ig_mkdir(outdir);
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    if(sc_store_init(ncap,&st)!=0){ig_println("store init failed");return 1;}
    let bb:IgBlob=IgBlob{.dir="",.nchunk=0,.cur="",.used=0,.total=0,.recs=0};
    if(igb_init(&bb,outdir)!=0){ig_println("blob init failed");return 1;}
    let rr:IgReader=IgReader{.fd=0,.buf="",.pos=0,.fill=0,.eof=0,.kbuf="",.tbuf="",.rec_key="",.rec_text=""};
    if(igr_init(&rr,facts_path)!=0){ig_println("facts open failed");return 1;}
    let prev_key:[]u8=sc_alloc(IG_MAX_KEY);
    let prev_len:i32=0;
    let has_prev:i32=0;
    let g1:i64=0; let g2:i64=0; let g3:i64=0;
    let ninst:i64=0;
    let n_lessons:i32=0; let n_lessons_rej:i32=0;
    let key:[]u8=sc_alloc(IG_MAX_KEY);
    let text:[]u8=sc_alloc(IG_MAX_TEXT);
    let key4:[]u8=sc_alloc(1024);
    let text4:[]u8=sc_alloc(4096);
    let koff4:[]u8=sc_alloc(16);
    let toff4:[]u8=sc_alloc(16);
    let kind4:[]u8=sc_alloc(4);
    let kl4:[]u8=sc_alloc(16);
    let tl4:[]u8=sc_alloc(16);
    if(key.len==0||text.len==0||key4.len==0||text4.len==0||kind4.len==0||kl4.len==0||tl4.len==0||koff4.len==0||toff4.len==0){ig_println("alloc failed");return 1;}
    let anm:[]u8=ig_join(outdir,"audit.log");
    let afd:i64=ig_open_write(anm);
    if(afd<0){ig_println("audit open failed");return 1;}
    let line:[]u8=sc_alloc(512);
    if(line.len==0){ig_close(afd);return 1;}
    let lp0:i32=0;
    ab_str(line,&lp0,"INGEST-START facts=");ab_str(line,&lp0,facts_path);
    ab_line(afd,line,lp0);
    let lesson_idx:i32=0;
    while(1){
        let r:i32=ig_process_lesson(&rr,&st,&bb,prev_key,&prev_len,&has_prev,
            &g1,&g2,&g3,&ninst,key,text,key4,kl4,tl4,kind4,text4,
            koff4,toff4,
            afd,line,lesson_idx,ncap);
        if(r==2){break;}
        if(r==-1){ig_println("lesson error");ig_close(afd);return 1;}
        if(r==1){n_lessons_rej=n_lessons_rej+1;}
        n_lessons=n_lessons+1;
        lesson_idx=lesson_idx+1;
    }
    igr_close(&rr);
    // ---- negative control lesson (bad.bin): 1000 synthetic, expect 1000/1000 rejected
    let br:IgReader=IgReader{.fd=0,.buf="",.pos=0,.fill=0,.eof=0,.kbuf="",.tbuf="",.rec_key="",.rec_text=""};
    if(igr_init(&br,bad_path)!=0){ig_println("bad open failed");ig_close(afd);return 1;}
    let brhdr:[]u8=sc_alloc(7);
    if(brhdr.len==0){ig_close(afd);return 1;}
    let bwscr:[]u8=sc_alloc(IG_MAX_KEY);
    if(bwscr.len==0){ig_close(afd);return 1;}
    let bg1:i64=0; let bg2:i64=0; let bg3:i64=0; let binst:i64=0; let bn:i64=0;
    while(1){
        let ko:i32=0; let kl:i32=0; let tl:i32=0;
        let rc:i32=igr_record(&br,brhdr,&ko,&kl,&tl);
        if(rc==1){break;}
        if(rc!=0){ig_println("bad read error");ig_close(afd);return 1;}
        let brp:*IgReader=&br;
        let brk:[]u8=brp.*.rec_key;
        let brt:[]u8=brp.*.rec_text;
        let pv:[]u8=prev_key[0..prev_len];
        let v:i32=ig_gate(ko,brk,brt,pv,has_prev,bwscr);
        if(v==0){binst=binst+1;}else{
            if(v==1){bg1=bg1+1;}else{if(v==2){bg2=bg2+1;}else{bg3=bg3+1;}}
        }
        let cp:i32=0;
        while(cp<kl){prev_key[cp]=brk[cp];cp=cp+1;}
        prev_len=kl;
        has_prev=1;
        bn=bn+1;
    }
    igr_close(&br);
    let lp1:i32=0;
    ab_str(line,&lp1,"NEGCONTROL n=");ab_i64(line,&lp1,bn);
    ab_str(line,&lp1," g1=");ab_i64(line,&lp1,bg1);
    ab_str(line,&lp1," g2=");ab_i64(line,&lp1,bg2);
    ab_str(line,&lp1," g3=");ab_i64(line,&lp1,bg3);
    ab_str(line,&lp1," installed=");ab_i64(line,&lp1,binst);
    let nc_pass:i32=0;
    if(bn==1000&&bg1==500&&bg2==250&&bg3==250&&binst==0){nc_pass=1;}
    if(nc_pass==1){ab_str(line,&lp1," verdict=PASS");}else{ab_str(line,&lp1," verdict=FAIL");}
    ab_line(afd,line,lp1);
    if(nc_pass==0){
        ig_println("NEGATIVE CONTROL FAILED - run void");
        ig_close(afd);
        return 2;
    }
    // ---- seal + persist ----
    if(sc_seal_tail(&st)!=0){ig_println("seal tail failed");ig_close(afd);return 1;}
    if(sc_seal_final(&st)!=0){ig_println("seal final failed");ig_close(afd);return 1;}
    if(igb_finish(&bb)!=0){ig_println("blob finish failed");ig_close(afd);return 1;}
    if(ig_store_save(&st,&bb,outdir)!=0){ig_println("store save failed");ig_close(afd);return 1;}
    let sealhex:[]u8=sc_alloc(64);
    if(sealhex.len==0){ig_close(afd);return 1;}
    ig_hex32(st.seal,sealhex);
    let lp2:i32=0;
    ab_str(line,&lp2,"SEAL ");ab_str(line,&lp2,sealhex);
    ab_line(afd,line,lp2);
    let lp3:i32=0;
    ab_str(line,&lp3,"SUMMARY inst=");ab_i64(line,&lp3,ninst);
    ab_str(line,&lp3," g1=");ab_i64(line,&lp3,g1);
    ab_str(line,&lp3," g2=");ab_i64(line,&lp3,g2);
    ab_str(line,&lp3," g3=");ab_i64(line,&lp3,g3);
    ab_str(line,&lp3," lessons=");ab_i64(line,&lp3,n_lessons as i64);
    ab_str(line,&lp3," lessons_rejected=");ab_i64(line,&lp3,n_lessons_rej as i64);
    ab_str(line,&lp3," blob_bytes=");ab_i64(line,&lp3,bb.total);
    ab_str(line,&lp3," blob_chunks=");ab_i64(line,&lp3,bb.nchunk as i64);
    ab_line(afd,line,lp3);
    ig_close(afd);
    // ---- manifest.txt ----
    let mnm:[]u8=ig_join(outdir,"manifest.txt");
    let mfd:i64=ig_open_write(mnm);
    if(mfd<0){ig_println("manifest open failed");return 1;}
    let ml:[]u8=sc_alloc(2048);
    if(ml.len==0){ig_close(mfd);return 1;}
    let mp:i32=0;
    ab_str(ml,&mp,"n=");ab_i64(ml,&mp,ninst);
    ab_str(ml,&mp,"\nnsealed=");ab_i64(ml,&mp,st.nsealed as i64);
    ab_str(ml,&mp,"\nclock=");ab_i64(ml,&mp,st.clock as i64);
    ab_str(ml,&mp,"\nblob_total=");ab_i64(ml,&mp,bb.total);
    ab_str(ml,&mp,"\nblob_chunks=");ab_i64(ml,&mp,bb.nchunk as i64);
    ab_str(ml,&mp,"\nblob_recs=");ab_i64(ml,&mp,bb.recs);
    ab_str(ml,&mp,"\ng1=");ab_i64(ml,&mp,g1);
    ab_str(ml,&mp,"\ng2=");ab_i64(ml,&mp,g2);
    ab_str(ml,&mp,"\ng3=");ab_i64(ml,&mp,g3);
    ab_str(ml,&mp,"\nlessons=");ab_i64(ml,&mp,n_lessons as i64);
    ab_str(ml,&mp,"\nlessons_rejected=");ab_i64(ml,&mp,n_lessons_rej as i64);
    ab_str(ml,&mp,"\nnegcontrol=1000/1000");
    ab_str(ml,&mp,"\nseal=");ab_str(ml,&mp,sealhex);
    ab_str(ml,&mp,"\n");
    ig_write_all(mfd,ml[0..mp]);
    ig_close(mfd);
    ig_print("ingest done inst=");
    ig_print_i64(ninst);
    ig_print(" seal=");
    ig_println(sealhex);
    return 0;
}

// ================= SINDEX =================
// Sparse key->blob-offset index: one entry per IG_SPARSE_EVERY-th fact.
// sparse.idx: [4B count][entries: 2B klen BE][8B blob_off LE][key]
fn ig_sindex(outdir:[]u8)i32 {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    let btotal:i64=0; let bnchunk:i32=0; let brecs:i64=0;
    if(ig_store_load(&st,&btotal,&bnchunk,&brecs,outdir)!=0){ig_println("sindex: store load failed");return 1;}
    let n:i32=st.n;
    let nentries:i32=(n+IG_SPARSE_EVERY-1)/IG_SPARSE_EVERY;
    // worst case: nentries * (2+8+160) bytes
    let idxb:[]u8=sc_alloc((nentries as i64)*(170 as i64) as i32+8);
    if(idxb.len==0){ig_println("sindex alloc failed");return 1;}
    let ipos:i32=4;
    let nfound:i32=0;
    let chunk:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    if(chunk.len==0){return 1;}
    let ci:i32=0;
    while(ci<bnchunk){
        if(ig_blob_read_chunk(outdir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){ig_println("sindex: chunk read failed");return 1;}
        let off:i32=0;
        while(1){
            let ko:i32=0; let id:i32=0; let kl:i32=0; let tl:i32=0;
            let rl:i32=ig_blob_parse_hdr(chunk,off,&ko,&id,&kl,&tl);
            if(rl==0){break;}
            if(rl<0){ig_println("sindex: parse failed");return 1;}
            if(id%IG_SPARSE_EVERY==0){
                let goff:i64=(ci as i64)*IG_BLOB_CHUNK+(off as i64);
                idxb[ipos]=((kl>>8)&255) as u8;
                idxb[ipos+1]=(kl&255) as u8;
                sc_s64(idxb,(ipos+2) as i64,goff);
                let j:i32=0;
                while(j<kl){idxb[ipos+10+j]=chunk[off+11+j];j=j+1;}
                ipos=ipos+10+kl;
                nfound=nfound+1;
            }
            off=off+rl;
        }
        ci=ci+1;
    }
    if(nfound!=nentries){ig_println("sindex: entry count mismatch");return 1;}
    sc_s32(idxb,0,nentries);
    let inm:[]u8=ig_join(outdir,"sparse.idx");
    let ifd:i64=ig_open_write(inm);
    if(ifd<0){ig_println("sindex: idx open failed");return 1;}
    let rc:i32=ig_write_all(ifd,idxb[0..ipos]);
    ig_close(ifd);
    if(rc!=0){return 1;}
    ig_print("sindex done entries=");
    ig_print_i64(nfound as i64);
    ig_println("");
    return 0;
}

// ================= QUERY =================
struct IgIdx {
    buf:[]u8,       // sparse.idx bytes
    offs:[]u8,      // nentries x u32 entry offsets
    n:i32
}
fn ig_idx_load(dir:[]u8,x:*IgIdx)i32 {
    let nm:[]u8=ig_join(dir,"sparse.idx");
    if(nm.len==0){return -1;}
    let fd:i64=ig_open_rdonly(nm);
    if(fd<0){return -1;}
    // size: read in 1MB pieces until EOF
    let cap:i32=1048576;
    let b:[]u8=sc_alloc(cap);
    if(b.len==0){ig_close(fd);return -1;}
    let total:i32=0;
    while(1){
        if(total==cap){
            let nb:[]u8=sc_alloc(cap*2);
            if(nb.len==0){ig_close(fd);return -1;}
            let i:i32=0;
            while(i<total){nb[i]=b[i];i=i+1;}
            b=nb;
            cap=cap*2;
        }
        let got:i32=ig_read_into(fd,b[total..]);
        if(got<0){ig_close(fd);return -1;}
        if(got==0){break;}
        total=total+got;
    }
    ig_close(fd);
    let n:i32=sc_g32(b,0);
    let of:[]u8=sc_alloc(n*4);
    if(of.len==0){return -1;}
    let pos:i32=4;
    let e:i32=0;
    while(e<n){
        sc_s32(of,e*4,pos);
        let kl:i32=(((b[pos] as i32)&255)<<8)|((b[pos+1] as i32)&255);
        pos=pos+10+kl;
        e=e+1;
    }
    x.*.buf=b;x.*.offs=of;x.*.n=n;
    return 0;
}
fn ig_idx_entry_key(x:*IgIdx,e:i32,out:[]u8,out_len:*i32,off_out:*i64)i32 {
    let b:[]u8=x.*.buf;
    let of:[]u8=x.*.offs;
    let pos:i32=sc_g32(of,e*4);
    let kl:i32=(((b[pos] as i32)&255)<<8)|((b[pos+1] as i32)&255);
    off_out.*=sc_g64(b,(pos+2) as i64);
    out_len.*=kl;
    let i:i32=0;
    while(i<kl){out[i]=b[pos+10+i];i=i+1;}
    return 0;
}
// compare key slices: -1/0/1
fn ig_key_cmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        let ca:i32=(a[i] as i32)&255;
        let cb:i32=(b[i] as i32)&255;
        if(ca<cb){return -1;}
        if(ca>cb){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}
// lookup key -> blob offset + id. returns: 1 found, 0 not found, -1 error.
// on found: off_out=blob offset (possibly overridden), id_out=id,
// del_out=1 if tombstoned.
fn ig_lookup(dir:[]u8,st:*ScStore,x:*IgIdx,key:[]u8,off_out:*i64,id_out:*i32,del_out:*i32,chunk:[]u8)i32 {
    // binary search sparse index: greatest entry with entry_key <= key
    // chunk is a caller-owned IG_BLOB_CHUNK scratch buffer, reused across lookups.
    let ek:[]u8=sc_alloc(IG_MAX_KEY);
    if(ek.len==0){return -1;}
    let lo:i32=0; let hi:i32=x.*.n-1;
    let best:i32=-1;
    let best_off:i64=0;
    while(lo<=hi){
        let mid:i32=(lo+hi)/2;
        let kl:i32=0; let eo:i64=0;
        ig_idx_entry_key(x,mid,ek,&kl,&eo);
        let c:i32=ig_key_cmp(ek[0..kl],key);
        if(c==0){best=mid;best_off=eo;break;}
        if(c<0){best=mid;best_off=eo;lo=mid+1;}else{hi=mid-1;}
    }
    if(best<0){return 0;}
    // read the blob chunk, linear scan from best_off
    let ci:i32=(best_off/IG_BLOB_CHUNK) as i32;
    let in_off:i32=(best_off%IG_BLOB_CHUNK) as i32;
    if(chunk.len<(IG_BLOB_CHUNK as i32)){return -1;}
    if(ig_blob_read_chunk(dir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){return -1;}
    let off:i32=in_off;
    while(1){
        let ko:i32=0; let id:i32=0; let kl2:i32=0; let tl2:i32=0;
        let rl:i32=ig_blob_parse_hdr(chunk,off,&ko,&id,&kl2,&tl2);
        if(rl==0){
            // end of valid data in this chunk; try next chunk
            ci=ci+1;
            if(ig_blob_read_chunk(dir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){return 0;}
            off=0;
            continue;
        }
        if(rl<0){return -1;}
        let rk:[]u8=chunk[off+11..off+11+kl2];
        let c2:i32=ig_key_cmp(rk,key);
        if(c2==0){
            // check tombstone + override
            let fl:i32=sc_flags_get(st,id);
            if((fl&1)!=0){id_out.*=id;del_out.*=1;return 1;}
            let goff:i64=(ci as i64)*IG_BLOB_CHUNK+(off as i64);
            id_out.*=id;del_out.*=0;off_out.*=goff;
            // override?
            let oids:[]u8=sc_alloc(4096*4);
            let ooffs:[]u8=sc_alloc(4096*8);
            let ocnt:i32=0;
            if(oids.len!=0&&ooffs.len!=0){
                if(ig_ovr_load(dir,oids,ooffs,4096,&ocnt)==0){
                    let oo:i64=0;
                    if(ig_ovr_find(oids,ooffs,ocnt,id,&oo)==1){off_out.*=oo;}
                }
            }
            return 1;
        }
        if(c2>0){return 0;}
        off=off+rl;
        if(off>=chunk.len){
            // continue in next chunk
            ci=ci+1;
            if(ig_blob_read_chunk(dir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){return 0;}
            off=0;
        }
    }
}
// read text at blob offset into out; chunk is caller-owned IG_BLOB_CHUNK scratch.
// returns tlen or -1
fn ig_blob_read_text(dir:[]u8,off:i64,out:[]u8,chunk:[]u8) i32 {
    let ci:i32=(off/IG_BLOB_CHUNK) as i32;
    let in_off:i32=(off%IG_BLOB_CHUNK) as i32;
    if(chunk.len<(IG_BLOB_CHUNK as i32)){return -1;}
    if(ig_blob_read_chunk(dir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){return -1;}
    let ko:i32=0; let id:i32=0; let kl:i32=0; let tl:i32=0;
    let rl:i32=ig_blob_parse_hdr(chunk,in_off,&ko,&id,&kl,&tl);
    if(rl<=0){return -1;}
    if(tl>out.len){return -1;}
    let i:i32=0;
    while(i<tl){out[i]=chunk[in_off+11+kl+i];i=i+1;}
    return tl;
}
fn ig_query(dir:[]u8,key:[]u8)i32 {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    let bt:i64=0; let bc:i32=0; let br2:i64=0;
    if(ig_store_load(&st,&bt,&bc,&br2,dir)!=0){ig_println("query: store load failed");return 1;}
    let x:IgIdx=IgIdx{.buf="",.offs="",.n=0};
    if(ig_idx_load(dir,&x)!=0){ig_println("query: idx load failed");return 1;}
    let qchunk:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    if(qchunk.len==0){return 1;}
    let off:i64=0; let id:i32=0; let del:i32=0;
    let r:i32=ig_lookup(dir,&st,&x,key,&off,&id,&del,qchunk);
    if(r<0){ig_println("query: lookup error");return 1;}
    if(r==0){ig_println("NOTFOUND");return 0;}
    if(del!=0){
        ig_print("DELETED id=");
        ig_print_i64(id as i64);
        ig_println("");
        return 0;
    }
    let txt:[]u8=sc_alloc(IG_MAX_TEXT);
    if(txt.len==0){return 1;}
    let tl:i32=ig_blob_read_text(dir,off,txt,qchunk);
    if(tl<0){ig_println("query: text read failed");return 1;}
    ig_print("FOUND id=");
    ig_print_i64(id as i64);
    ig_print(" tlen=");
    ig_print_i64(tl as i64);
    ig_println("");
    _zag_print(txt[0..tl]);
    ig_println("");
    return 0;
}
fn ig_bquery(dir:[]u8,keys_path:[]u8,res_path:[]u8)i32 {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    let bt:i64=0; let bc:i32=0; let br2:i64=0;
    if(ig_store_load(&st,&bt,&bc,&br2,dir)!=0){ig_println("bquery: store load failed");return 1;}
    let x:IgIdx=IgIdx{.buf="",.offs="",.n=0};
    if(ig_idx_load(dir,&x)!=0){ig_println("bquery: idx load failed");return 1;}
    let kr:IgReader=IgReader{.fd=0,.buf="",.pos=0,.fill=0,.eof=0,.kbuf="",.tbuf="",.rec_key="",.rec_text=""};
    if(igr_init(&kr,keys_path)!=0){ig_println("bquery: keys open failed");return 1;}
    let rfd:i64=ig_open_write(res_path);
    if(rfd<0){ig_println("bquery: results open failed");return 1;}
    let kb:[]u8=sc_alloc(IG_MAX_KEY);
    let klenb:[]u8=sc_alloc(2);
    let txt:[]u8=sc_alloc(IG_MAX_TEXT);
    let ob:[]u8=sc_alloc(IG_MAX_TEXT+16);
    if(kb.len==0||klenb.len==0||txt.len==0||ob.len==0){return 1;}
    // single chunk scratch reused across all lookups (was: 2x33MB alloc per query)
    let bchunk:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    if(bchunk.len==0){return 1;}
    let nq:i64=0;
    while(1){
        let rc:i32=igr_take(&kr,2,klenb);
        if(rc==1){break;}
        if(rc!=0){ig_println("bquery: key read error");ig_close(rfd);return 1;}
        let kl:i32=(((klenb[0] as i32)&255)<<8)|((klenb[1] as i32)&255);
        if(kl>IG_MAX_KEY){ig_println("bquery: key too long");ig_close(rfd);return 1;}
        if(igr_take(&kr,kl,kb)!=0){ig_println("bquery: key bytes error");ig_close(rfd);return 1;}
        let off:i64=0; let id:i32=0; let del:i32=0;
        let lr:i32=ig_lookup(dir,&st,&x,kb[0..kl],&off,&id,&del,bchunk);
        if(lr<0){ig_println("bquery: lookup error");ig_close(rfd);return 1;}
        let status:i32=1; let tl:i32=0;
        if(lr==1){
            if(del!=0){status=2;}else{
                tl=ig_blob_read_text(dir,off,txt,bchunk);
                if(tl<0){ig_println("bquery: text read failed");ig_close(rfd);return 1;}
                status=0;
            }
        }
        ob[0]=status as u8;
        sc_s32(ob,1,id);
        sc_s32(ob,5,tl);
        if(ig_write_all(rfd,ob[0..9])!=0){ig_close(rfd);return 1;}
        if(status==0&&tl>0){
            if(ig_write_all(rfd,txt[0..tl])!=0){ig_close(rfd);return 1;}
        }
        nq=nq+1;
    }
    igr_close(&kr);
    ig_close(rfd);
    ig_print("bquery done n=");
    ig_print_i64(nq);
    ig_println("");
    return 0;
}

// ================= REVISE / DELETE =================
fn ig_revise(dir:[]u8,id:i32,newtext_path:[]u8)i32 {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    let btotal:i64=0; let bnchunk:i32=0; let brecs:i64=0;
    if(ig_store_load(&st,&btotal,&bnchunk,&brecs,dir)!=0){ig_println("revise: store load failed");return 1;}
    if(id<0||id>=st.n){ig_println("revise: bad id");return 1;}
    let fl:i32=sc_flags_get(&st,id);
    if((fl&1)!=0){ig_println("revise: fact is deleted");return 1;}
    let old_off:i64=0;
    if(sc_recall(&st,id,&old_off)!=1){ig_println("revise: recall failed");return 1;}
    // read new text
    let nfd:i64=ig_open_rdonly(newtext_path);
    if(nfd<0){ig_println("revise: newtext open failed");return 1;}
    let nt:[]u8=sc_alloc(IG_MAX_TEXT);
    if(nt.len==0){ig_close(nfd);return 1;}
    let got:i32=0;
    while(got<nt.len){
        let g2:i32=ig_read_into(nfd,nt[got..]);
        if(g2<0){ig_close(nfd);return 1;}
        if(g2==0){break;}
        got=got+g2;
    }
    ig_close(nfd);
    if(got<1){ig_println("revise: empty newtext");return 1;}
    // read old record for kind+key
    let ci:i32=(old_off/IG_BLOB_CHUNK) as i32;
    let ino:i32=(old_off%IG_BLOB_CHUNK) as i32;
    let chunk:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    if(chunk.len==0){return 1;}
    if(ig_blob_read_chunk(dir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){ig_println("revise: chunk read failed");return 1;}
    let ko:i32=0; let oid:i32=0; let kl:i32=0; let tl:i32=0;
    if(ig_blob_parse_hdr(chunk,ino,&ko,&oid,&kl,&tl)<=0){ig_println("revise: old parse failed");return 1;}
    if(oid!=id){ig_println("revise: id mismatch at offset");return 1;}
    let oldkey:[]u8=chunk[ino+11..ino+11+kl];
    // blob append state: last chunk partial
    let bb:IgBlob=IgBlob{.dir="",.nchunk=0,.cur="",.used=0,.total=0,.recs=0};
    if(igb_init(&bb,dir)!=0){return 1;}
    let lastidx:i32=bnchunk-1;
    if(ig_blob_read_chunk(dir,lastidx,bb.cur)!=(IG_BLOB_CHUNK as i32)){ig_println("revise: last chunk read failed");return 1;}
    bb.nchunk=lastidx;
    bb.used=(btotal%(IG_BLOB_CHUNK)) as i32;
    bb.total=btotal;
    bb.recs=brecs;
    let new_off:i64=igb_append(&bb,ko,id,oldkey,nt[0..got]);
    if(new_off<0){ig_println("revise: append failed");return 1;}
    if(igb_finish(&bb)!=0){ig_println("revise: blob finish failed");return 1;}
    // overrides
    let oids:[]u8=sc_alloc(4096*4);
    let ooffs:[]u8=sc_alloc(4096*8);
    if(oids.len==0||ooffs.len==0){return 1;}
    let ocnt:i32=0;
    if(ig_ovr_load(dir,oids,ooffs,4096,&ocnt)!=0){ig_println("revise: ovr load failed");return 1;}
    // replace existing entry for id, or append
    let oo:i64=0;
    if(ig_ovr_find(oids,ooffs,ocnt,id,&oo)==1){
        let e:i32=0;
        while(e<ocnt){
            if(sc_g32(oids,e*4)==id){sc_s64(ooffs,(e*8) as i64,new_off);break;}
            e=e+1;
        }
    }else{
        if(ocnt>=4096){ig_println("revise: too many overrides");return 1;}
        sc_s32(oids,ocnt*4,id);
        sc_s64(ooffs,(ocnt*8) as i64,new_off);
        ocnt=ocnt+1;
    }
    if(ig_ovr_save(dir,oids,ooffs,ocnt)!=0){ig_println("revise: ovr save failed");return 1;}
    // flags + audit + rechain + reseal + persist
    if(sc_flags_set(&st,id,fl|2)!=0){ig_println("revise: flags set failed");return 1;}
    sc_event_append(&st,9,id,(old_off&4294967295) as i32,(new_off&4294967295) as i32);
    if(sc_chain_recompute_all(&st)!=0){ig_println("revise: rechain failed");return 1;}
    if(sc_seal_final(&st)!=0){ig_println("revise: reseal failed");return 1;}
    if(ig_store_save(&st,&bb,dir)!=0){ig_println("revise: store save failed");return 1;}
    let sealhex:[]u8=sc_alloc(64);
    if(sealhex.len==0){return 1;}
    ig_hex32(st.seal,sealhex);
    ig_print("revised id=");
    ig_print_i64(id as i64);
    ig_print(" new_off=");
    ig_print_i64(new_off);
    ig_print(" seal=");
    ig_println(sealhex);
    return 0;
}
fn ig_delete(dir:[]u8,id:i32)i32 {
    let st:ScStore=ScStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",
        .fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0,.ops_add=0,.ops_find=0,.ops_audit=0};
    let btotal:i64=0; let bnchunk:i32=0; let brecs:i64=0;
    if(ig_store_load(&st,&btotal,&bnchunk,&brecs,dir)!=0){ig_println("delete: store load failed");return 1;}
    if(id<0||id>=st.n){ig_println("delete: bad id");return 1;}
    let fl:i32=sc_flags_get(&st,id);
    if((fl&1)!=0){ig_println("delete: already deleted");return 1;}
    if(sc_flags_set(&st,id,fl|1)!=0){ig_println("delete: flags set failed");return 1;}
    sc_event_append(&st,10,id,0,0);
    if(sc_chain_recompute_all(&st)!=0){ig_println("delete: rechain failed");return 1;}
    if(sc_seal_final(&st)!=0){ig_println("delete: reseal failed");return 1;}
    // store.dat rewrite needs a blob handle for the tail fields; use a dummy
    // with the loaded values.
    let bb:IgBlob=IgBlob{.dir="",.nchunk=bnchunk,.cur="",.used=0,.total=btotal,.recs=brecs};
    if(ig_store_save(&st,&bb,dir)!=0){ig_println("delete: store save failed");return 1;}
    let sealhex:[]u8=sc_alloc(64);
    if(sealhex.len==0){return 1;}
    ig_hex32(st.seal,sealhex);
    ig_print("deleted id=");
    ig_print_i64(id as i64);
    ig_print(" seal=");
    ig_println(sealhex);
    return 0;
}
fn ig_report(dir:[]u8)i32 {
    let mnm:[]u8=ig_join(dir,"manifest.txt");
    let fd:i64=ig_open_rdonly(mnm);
    if(fd<0){ig_println("report: no manifest");return 1;}
    let b:[]u8=sc_alloc(4096);
    if(b.len==0){ig_close(fd);return 1;}
    let got:i32=ig_read_into(fd,b);
    ig_close(fd);
    if(got>0){_zag_print(b[0..got]);}
    return 0;
}

// ================= MAIN =================

// ================= PANSWER: probe answering from the taught store =================
// Pure-Zag retrieval: Aho-Corasick over probe keywords, one streaming pass
// over blob chunks, best fact per probe. Zero RNG. Deterministic.
const PA_MAX_PROBES:i32=300;
const PA_MAX_KW:i32=8000;
const PA_MAX_NODES:i32=60000;
const PA_MAX_EDGES:i32=70000;
const PA_MAX_KW_PER_PROBE:i32=24;
const PA_THRESH:i32=1;

fn pa_node_new(nodes:[]u8,nn:*i32) i32 {
    let id:i32=nn.*;
    if(id>=PA_MAX_NODES){return -1;}
    let o:i32=id*16;
    sc_s32(nodes,o,-1);
    sc_s32(nodes,o+4,0);
    sc_s32(nodes,o+8,-1);
    sc_s32(nodes,o+12,-1);
    nn.*=id+1;
    return id;
}
fn pa_edge_add(nodes:[]u8,edges:[]u8,en:*i32,node:i32,b:i32,child:i32) i32 {
    let id:i32=en.*;
    if(id>=PA_MAX_EDGES){return -1;}
    let o:i32=id*12;
    sc_s32(edges,o,b);
    sc_s32(edges,o+4,child);
    sc_s32(edges,o+8,sc_g32(nodes,node*16));
    sc_s32(nodes,node*16,id);
    en.*=id+1;
    return id;
}
fn pa_child(nodes:[]u8,edges:[]u8,node:i32,b:i32,root_child:[]u8) i32 {
    // Fast path: root children via 26-entry direct array (b is 'a'-'z').
    // Only used during scan (root_child filled); during build, len==0.
    if(node==0&&b>=97&&b<=122&&root_child.len>=104){
        return sc_g32(root_child,(b-97)*4);
    }
    let e:i32=sc_g32(nodes,node*16);
    while(e>=0){
        if(sc_g32(edges,e*12)==b){return sc_g32(edges,e*12+4);}
        e=sc_g32(edges,e*12+8);
    }
    return -1;
}
// stopwords: tiny closed list, linear check
fn pa_is_stop(w:[]u8) i32 {
    if(w.len<2||w.len>9){return 0;}
    // check against hardcoded list via length buckets
    if(w.len==3){
        if(_zag_strcmp(w,"the")==1){return 1;}
        if(_zag_strcmp(w,"and")==1){return 1;}
        if(_zag_strcmp(w,"are")==1){return 1;}
        if(_zag_strcmp(w,"was")==1){return 1;}
        if(_zag_strcmp(w,"for")==1){return 1;}
        if(_zag_strcmp(w,"how")==1){return 1;}
        if(_zag_strcmp(w,"what")==1){return 1;}
        if(_zag_strcmp(w,"why")==1){return 1;}
        if(_zag_strcmp(w,"who")==1){return 1;}
        if(_zag_strcmp(w,"not")==1){return 1;}
        if(_zag_strcmp(w,"all")==1){return 1;}
        if(_zag_strcmp(w,"any")==1){return 1;}
        if(_zag_strcmp(w,"its")==1){return 1;}
    }
    if(w.len==2){
        if(_zag_strcmp(w,"of")==1){return 1;}
        if(_zag_strcmp(w,"to")==1){return 1;}
        if(_zag_strcmp(w,"in")==1){return 1;}
        if(_zag_strcmp(w,"is")==1){return 1;}
        if(_zag_strcmp(w,"it")==1){return 1;}
        if(_zag_strcmp(w,"on")==1){return 1;}
        if(_zag_strcmp(w,"or")==1){return 1;}
        if(_zag_strcmp(w,"as")==1){return 1;}
        if(_zag_strcmp(w,"at")==1){return 1;}
        if(_zag_strcmp(w,"an")==1){return 1;}
        if(_zag_strcmp(w,"by")==1){return 1;}
        if(_zag_strcmp(w,"do")==1){return 1;}
        if(_zag_strcmp(w,"if")==1){return 1;}
        if(_zag_strcmp(w,"no")==1){return 1;}
        if(_zag_strcmp(w,"so")==1){return 1;}
        if(_zag_strcmp(w,"up")==1){return 1;}
        if(_zag_strcmp(w,"we")==1){return 1;}
    }
    if(w.len==4){
        if(_zag_strcmp(w,"does")==1){return 1;}
        if(_zag_strcmp(w,"have")==1){return 1;}
        if(_zag_strcmp(w,"with")==1){return 1;}
        if(_zag_strcmp(w,"that")==1){return 1;}
        if(_zag_strcmp(w,"this")==1){return 1;}
        if(_zag_strcmp(w,"from")==1){return 1;}
        if(_zag_strcmp(w,"were")==1){return 1;}
        if(_zag_strcmp(w,"been")==1){return 1;}
        if(_zag_strcmp(w,"when")==1){return 1;}
        if(_zag_strcmp(w,"then")==1){return 1;}
        if(_zag_strcmp(w,"than")==1){return 1;}
    }
    if(w.len==5){
        if(_zag_strcmp(w,"which")==1){return 1;}
        if(_zag_strcmp(w,"their")==1){return 1;}
        if(_zag_strcmp(w,"there")==1){return 1;}
        if(_zag_strcmp(w,"about")==1){return 1;}
        if(_zag_strcmp(w,"would")==1){return 1;}
        if(_zag_strcmp(w,"these")==1){return 1;}
        if(_zag_strcmp(w,"those")==1){return 1;}
    }
    return 0;
}
fn pa_lower_byte(c:u8) u8 {
    if(c>=65&&c<=90){return c+32;}
    return c;
}
fn pa_is_alnum(c:u8) i32 {
    if(c>=48&&c<=57){return 1;}
    if(c>=65&&c<=90){return 1;}
    if(c>=97&&c<=122){return 1;}
    return 0;
}

// insert keyword (lowercased) into trie; return kw_id (new or existing)
fn pa_kw_insert(nodes:[]u8,edges:[]u8,nn:*i32,en:*i32,kw_n:*i32,w:[]u8) i32 {
    let node:i32=0;
    let i:i32=0;
    while(i<w.len){
        let b:i32=(pa_lower_byte(w[i]) as i32)&255;
        let c:i32=pa_child(nodes,edges,node,b,"");
        if(c<0){
            c=pa_node_new(nodes,nn);
            if(c<0){return -1;}
            if(pa_edge_add(nodes,edges,en,node,b,c)<0){return -1;}
        }
        node=c;
        i=i+1;
    }
    let kw:i32=sc_g32(nodes,node*16+8);
    if(kw>=0){return kw;}
    kw=kw_n.*;
    if(kw>=PA_MAX_KW){return -1;}
    sc_s32(nodes,node*16+8,kw);
    kw_n.*=kw+1;
    return kw;
}
// build fail links (BFS) and out_link chains
fn pa_build_fail(nodes:[]u8,edges:[]u8,nn:i32) i32 {
    let q:[]u8=sc_alloc(nn*4);
    if(q.len==0){return -1;}
    let qh:i32=0; let qt:i32=0;
    // depth-1 nodes: fail=0
    let e:i32=sc_g32(nodes,0);
    while(e>=0){
        let c:i32=sc_g32(edges,e*12+4);
        sc_s32(nodes,c*16+4,0);
        // out_link
        if(sc_g32(nodes,0*16+8)>=0){sc_s32(nodes,c*16+12,0);}else{sc_s32(nodes,c*16+12,-1);}
        sc_s32(q,qt*4,c); qt=qt+1;
        e=sc_g32(edges,e*12+8);
    }
    while(qh<qt){
        let v:i32=sc_g32(q,qh*4); qh=qh+1;
        let ee:i32=sc_g32(nodes,v*16);
        while(ee>=0){
            let b:i32=sc_g32(edges,ee*12);
            let u:i32=sc_g32(edges,ee*12+4);
            let f:i32=sc_g32(nodes,v*16+4);
            while(f!=0&&pa_child(nodes,edges,f,b,"")<0){f=sc_g32(nodes,f*16+4);}
            let fc:i32=pa_child(nodes,edges,f,b,"");
            if(fc<0){fc=0;}
            sc_s32(nodes,u*16+4,fc);
            // out_link: nearest fail-ancestor with out_kw
            if(sc_g32(nodes,fc*16+8)>=0){sc_s32(nodes,u*16+12,fc);}
            else{sc_s32(nodes,u*16+12,sc_g32(nodes,fc*16+12));}
            sc_s32(q,qt*4,u); qt=qt+1;
            ee=sc_g32(edges,ee*12+8);
        }
    }
    return 0;
}
// escape response bytes for TSV: \ -> \\, tab -> \t, LF -> \n
fn pa_escape(src:[]u8,dst:[]u8) i32 {
    let o:i32=0;
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c==92){ if(o+2>dst.len){return -1;} dst[o]=92;dst[o+1]=92;o=o+2; }
        else{
            if(c==9){ if(o+2>dst.len){return -1;} dst[o]=92;dst[o+1]=116;o=o+2; }
            else{
                if(c==10){ if(o+2>dst.len){return -1;} dst[o]=92;dst[o+1]=110;o=o+2; }
                else{ if(o+1>dst.len){return -1;} dst[o]=c;o=o+1; }
            }
        }
        i=i+1;
    }
    return o;
}

fn ig_panswer(outdir:[]u8,qpath:[]u8,ansdir:[]u8) i32 {
    // ---- load questions (id \t question) ----
    let qfd:i64=ig_open_rdonly(qpath);
    if(qfd<0){ig_println("panswer: questions open failed");return 1;}
    let qbuf:[]u8=sc_alloc(1<<20);
    if(qbuf.len==0){ig_close(qfd);return 1;}
    let qn:i32=ig_read_into(qfd,qbuf);
    ig_close(qfd);
    if(qn<=0){ig_println("panswer: questions read failed");return 1;}
    // probe ids
    let pids:[]u8=sc_alloc(PA_MAX_PROBES*32);
    let pqw_off:[]u8=sc_alloc(PA_MAX_PROBES*4);   // kw list offset per probe
    let pqw_cnt:[]u8=sc_alloc(PA_MAX_PROBES*4);   // kw count per probe
    let pqw_flat:[]u8=sc_alloc(PA_MAX_PROBES*PA_MAX_KW_PER_PROBE*4);
    if(pids.len==0||pqw_off.len==0||pqw_cnt.len==0||pqw_flat.len==0){return 1;}
    let nodes:[]u8=sc_alloc(PA_MAX_NODES*16);
    let edges:[]u8=sc_alloc(PA_MAX_EDGES*12);
    if(nodes.len==0||edges.len==0){return 1;}
    let nn:i32=0; let en:i32=0; let kw_n:i32=0;
    if(pa_node_new(nodes,&nn)<0){return 1;}
    let nprobes:i32=0;
    let kw_total:i32=0;
    // parse lines: id \t question \n
    let pos:i32=0;
    while(pos<qn){
        let le:i32=pos;
        while(le<qn&&qbuf[le]!=10){le=le+1;}
        // line = qbuf[pos..le]
        let tab:i32=pos;
        while(tab<le&&qbuf[tab]!=9){tab=tab+1;}
        if(tab<le&&nprobes<PA_MAX_PROBES){
            let idlen:i32=tab-pos;
            if(idlen>31){idlen=31;}
            let pi:i32=0;
            while(pi<idlen){pids[nprobes*32+pi]=qbuf[pos+pi];pi=pi+1;}
            pids[nprobes*32+idlen]=0;
            // extract keywords from qbuf[tab+1..le]
            sc_s32(pqw_off,nprobes*4,kw_total);
            let kc:i32=0;
            let wp:i32=tab+1;
            while(wp<le&&kc<PA_MAX_KW_PER_PROBE){
                // skip non-alnum
                while(wp<le&&pa_is_alnum(qbuf[wp])==0){wp=wp+1;}
                let ws:i32=wp;
                while(wp<le&&pa_is_alnum(qbuf[wp])==1){wp=wp+1;}
                let wl:i32=wp-ws;
                if(wl>=3&&wl<=32){
                    let w:[]u8=qbuf[ws..ws+wl];
                    if(pa_is_stop(w)==0){
                        let kw: i32=pa_kw_insert(nodes,edges,&nn,&en,&kw_n,w);
                        if(kw<0){ig_println("panswer: kw insert failed");return 1;}
                        // dedupe within probe
                        let dup:i32=0;
                        let dd:i32=0;
                        while(dd<kc){
                            if(sc_g32(pqw_flat,(kw_total+dd)*4)==kw){dup=1;break;}
                            dd=dd+1;
                        }
                        if(dup==0){
                            sc_s32(pqw_flat,kw_total*4,kw);
                            kw_total=kw_total+1;
                            kc=kc+1;
                        }
                    }
                }
            }
            sc_s32(pqw_cnt,nprobes*4,kc);
            nprobes=nprobes+1;
        }
        pos=le+1;
    }
    if(nprobes==0){ig_println("panswer: no probes");return 1;}
    // root child direct array: 26 entries for 'a'-'z', init -1
    let root_child:[]u8=sc_alloc(26*4);
    if(root_child.len==0){return 1;}
    let rci:i32=0;
    while(rci<26){sc_s32(root_child,rci*4,-1);rci=rci+1;}
    if(pa_build_fail(nodes,edges,nn)!=0){ig_println("panswer: fail build failed");return 1;}
    // fill root_child from node 0 edge list
    let re:i32=sc_g32(nodes,0);
    while(re>=0){
        let rb:i32=sc_g32(edges,re*12);
        let rc:i32=sc_g32(edges,re*12+4);
        if(rb>=97&&rb<=122){sc_s32(root_child,(rb-97)*4,rc);}
        re=sc_g32(edges,re*12+8);
    }
    // ---- invert: kw -> probes ----
    let kw_cnt:[]u8=sc_alloc(PA_MAX_KW*4);
    let kw_off:[]u8=sc_alloc(PA_MAX_KW*4);
    if(kw_cnt.len==0||kw_off.len==0){return 1;}
    // zero
    let zi:i32=0;
    while(zi<kw_n){sc_s32(kw_cnt,zi*4,0);zi=zi+1;}
    let p2:i32=0;
    while(p2<nprobes){
        let c2:i32=sc_g32(pqw_cnt,p2*4);
        let o2:i32=sc_g32(pqw_off,p2*4);
        let j2:i32=0;
        while(j2<c2){
            let kw2:i32=sc_g32(pqw_flat,(o2+j2)*4);
            sc_s32(kw_cnt,kw2*4,sc_g32(kw_cnt,kw2*4)+1);
            j2=j2+1;
        }
        p2=p2+1;
    }
    let flat_total:i32=0;
    zi=0;
    while(zi<kw_n){
        sc_s32(kw_off,zi*4,flat_total);
        flat_total=flat_total+sc_g32(kw_cnt,zi*4);
        sc_s32(kw_cnt,zi*4,0);
        zi=zi+1;
    }
    let kw_flat:[]u8=sc_alloc(flat_total*4);
    if(kw_flat.len==0){return 1;}
    p2=0;
    while(p2<nprobes){
        let c3:i32=sc_g32(pqw_cnt,p2*4);
        let o3:i32=sc_g32(pqw_off,p2*4);
        let j3:i32=0;
        while(j3<c3){
            let kw3:i32=sc_g32(pqw_flat,(o3+j3)*4);
            let at:i32=sc_g32(kw_off,kw3*4)+sc_g32(kw_cnt,kw3*4);
            sc_s32(kw_flat,at*4,p2);
            sc_s32(kw_cnt,kw3*4,sc_g32(kw_cnt,kw3*4)+1);
            j3=j3+1;
        }
        p2=p2+1;
    }
    // ---- per-probe tracking ----
    let phits:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let plast:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let bhits:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let bid:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let bkey:[]u8=sc_alloc(PA_MAX_PROBES*512);
    let btext:[]u8=sc_alloc(PA_MAX_PROBES*4096);
    let btlen:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let touched:[]u8=sc_alloc(PA_MAX_PROBES*4);
    let kw_last:[]u8=sc_alloc(PA_MAX_KW*4);
    if(phits.len==0||plast.len==0||bhits.len==0||bid.len==0){return 1;}
    if(bkey.len==0||btext.len==0||btlen.len==0||touched.len==0||kw_last.len==0){return 1;}
    zi=0;
    while(zi<nprobes){
        sc_s32(bhits,zi*4,-1);
        sc_s32(bid,zi*4,2147483647);
        sc_s32(btlen,zi*4,0);
        sc_s32(plast,zi*4,0);
        zi=zi+1;
    }
    zi=0;
    while(zi<kw_n){sc_s32(kw_last,zi*4,0);zi=zi+1;}
    // ---- stream blobs ----
    let chunk:[]u8=sc_alloc(IG_BLOB_CHUNK as i32);
    let lower:[]u8=sc_alloc(IG_MAX_TEXT);
    if(chunk.len==0||lower.len==0){return 1;}
    let epoch:i32=1;
    let ci:i32=0;
    let nfacts:i64=0;
    while(1){
        if(ig_blob_read_chunk(outdir,ci,chunk)!=(IG_BLOB_CHUNK as i32)){break;}
        let off:i32=0;
        while(1){
            let ko:i32=0; let fid:i32=0; let kl:i32=0; let tl:i32=0;
            let rl:i32=ig_blob_parse_hdr(chunk,off,&ko,&fid,&kl,&tl);
            if(rl==0){break;}
            if(rl<0){ig_println("panswer: blob parse failed");return 1;}
            if(tl>0&&tl<=IG_MAX_TEXT&&kl>0){
                // lowercase text
                let ti:i32=0;
                while(ti<tl){lower[ti]=pa_lower_byte(chunk[off+11+kl+ti]);ti=ti+1;}
                // AC scan
                let state:i32=0;
                let si:i32=0;
                let tcn:i32=0;  // touched count
                while(si<tl){
                    let b:i32=(lower[si] as i32)&255;
                    // Fast path: non-letters reset to root (no keyword contains them).
                    if(b<97||b>122){
                        state=0;
                        si=si+1;
                        continue;
                    }
                    while(state!=0&&pa_child(nodes,edges,state,b,root_child)<0){
                        state=sc_g32(nodes,state*16+4);
                    }
                    let nc:i32=pa_child(nodes,edges,state,b,root_child);
                    if(nc>=0){state=nc;}else{state=0;}
                    // collect outputs
                    let on:i32=state;
                    // check out_kw at state and via out_link
                    let tmp:i32=on;
                    while(tmp>=0){
                        let kwm:i32=sc_g32(nodes,tmp*16+8);
                        if(kwm>=0&&sc_g32(kw_last,kwm*4)!=epoch){
                            sc_s32(kw_last,kwm*4,epoch);
                            // for each probe with this kw
                            let pc:i32=sc_g32(kw_cnt,kwm*4);
                            let po:i32=sc_g32(kw_off,kwm*4);
                            let pj:i32=0;
                            while(pj<pc){
                                let pr2:i32=sc_g32(kw_flat,(po+pj)*4);
                                if(sc_g32(plast,pr2*4)!=epoch){
                                    sc_s32(plast,pr2*4,epoch);
                                    sc_s32(phits,pr2*4,0);
                                    sc_s32(touched,tcn*4,pr2);
                                    tcn=tcn+1;
                                }
                                sc_s32(phits,pr2*4,sc_g32(phits,pr2*4)+1);
                                pj=pj+1;
                            }
                        }
                        tmp=sc_g32(nodes,tmp*16+12);
                    }
                    si=si+1;
                }
                // update best for touched probes
                let txi:i32=0;
                while(txi<tcn){
                    let pr3:i32=sc_g32(touched,txi*4);
                    let h:i32=sc_g32(phits,pr3*4);
                    let bh:i32=sc_g32(bhits,pr3*4);
                    let bi2:i32=sc_g32(bid,pr3*4);
                    if(h>bh||(h==bh&&fid<bi2)){
                        sc_s32(bhits,pr3*4,h);
                        sc_s32(bid,pr3*4,fid);
                        sc_s32(btlen,pr3*4,tl);
                        let cpi:i32=0;
                        while(cpi<kl&&cpi<511){bkey[pr3*512+cpi]=chunk[off+11+cpi];cpi=cpi+1;}
                        bkey[pr3*512+cpi]=0;
                        cpi=0;
                        while(cpi<tl){btext[pr3*4096+cpi]=chunk[off+11+kl+cpi];cpi=cpi+1;}
                    }
                    txi=txi+1;
                }
                nfacts=nfacts+1;
                if(nfacts%10000==0){ig_print("panswer facts=");ig_print_i64(nfacts as i64);ig_println("");}
            }
            off=off+rl;
            epoch=epoch+1;
            if(epoch>=2000000000){ig_println("panswer: epoch overflow");return 1;}
        }
        ci=ci+1;
    }
    // ---- write answers.tsv ----
    _zag_raw_syscall(83,(_zag_slice_ptr(z_cstr(ansdir)) as i64),493,0,0,0,0);
    let apath:[]u8=ig_join(ansdir,"answers.tsv");
    let afd:i64=ig_open_write(apath);
    if(afd<0){ig_println("panswer: answers open failed");return 1;}
    let line:[]u8=sc_alloc(8192);
    let esc:[]u8=sc_alloc(8192);
    if(line.len==0||esc.len==0){ig_close(afd);return 1;}
    let wp2:i32=0;
    while(wp2<nprobes){
        let lp:i32=0;
        // id (strip trailing NUL)
        let il:i32=0;
        while(il<31&&pids[wp2*32+il]!=0){line[lp]=pids[wp2*32+il];lp=lp+1;il=il+1;}
        line[lp]=9;lp=lp+1;
        ab_i64(line,&lp,sc_g32(bhits,wp2*4) as i64);
        line[lp]=9;lp=lp+1;
        // key
        let kl2:i32=0;
        while(kl2<511&&bkey[wp2*512+kl2]!=0){line[lp]=bkey[wp2*512+kl2];lp=lp+1;kl2=kl2+1;}
        line[lp]=9;lp=lp+1;
        // response
        let bh2:i32=sc_g32(bhits,wp2*4);
        if(bh2>=PA_THRESH){
            let tl2:i32=sc_g32(btlen,wp2*4);
            let el:i32=pa_escape(btext[wp2*4096..wp2*4096+tl2],esc);
            if(el<0){ig_println("panswer: escape overflow");ig_close(afd);return 1;}
            let ei:i32=0;
            while(ei<el){line[lp]=esc[ei];lp=lp+1;ei=ei+1;}
        }else{
            let dk:[]u8="i don't know";
            let di:i32=0;
            while(di<dk.len){line[lp]=dk[di];lp=lp+1;di=di+1;}
        }
        line[lp]=10;lp=lp+1;
        if(ig_write_all(afd,line[0..lp])!=0){ig_println("panswer: write failed");ig_close(afd);return 1;}
        wp2=wp2+1;
    }
    ig_close(afd);
    ig_print("panswer done probes=");ig_print_i64(nprobes as i64);
    ig_print(" facts=");ig_print_i64(nfacts);
    ig_print(" keywords=");ig_print_i64(kw_n as i64);
    ig_println("");
    return 0;
}

fn main()void {
    let m0:[]u8=_zag_arg(1);
    let mode:[]u8=m0;
    if(_zag_strcmp(mode,"ingest")==1){
        let rc:i32=ig_ingest(_zag_arg(2),_zag_arg(3),_zag_arg(4),ig_atoi(_zag_arg(5)));
        if(rc!=0){ig_print("ingest rc=");ig_print_i64(rc as i64);ig_println("");}
        return;
    }
    if(_zag_strcmp(mode,"sindex")==1){
        ig_sindex(_zag_arg(2));
        return;
    }
    if(_zag_strcmp(mode,"query")==1){
        ig_query(_zag_arg(2),_zag_arg(3));
        return;
    }
    if(_zag_strcmp(mode,"bquery")==1){
        ig_bquery(_zag_arg(2),_zag_arg(3),_zag_arg(4));
        return;
    }
    if(_zag_strcmp(mode,"revise")==1){
        ig_revise(_zag_arg(2),ig_atoi(_zag_arg(3)),_zag_arg(4));
        return;
    }
    if(_zag_strcmp(mode,"delete")==1){
        ig_delete(_zag_arg(2),ig_atoi(_zag_arg(3)));
        return;
    }
    if(_zag_strcmp(mode,"report")==1){
        ig_report(_zag_arg(2));
        return;
    }
    if(_zag_strcmp(mode,"panswer")==1){
        let rc2:i32=ig_panswer(_zag_arg(2),_zag_arg(3),_zag_arg(4));
        if(rc2!=0){ig_print("panswer rc=");ig_print_i64(rc2 as i64);ig_println("");}
        return;
    }
    ig_println("usage: ingest <ingest facts bad outdir ncap | sindex outdir | query outdir key | bquery outdir keys res | revise outdir id newtext | delete outdir id | report outdir>");
}

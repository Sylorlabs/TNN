// fw_scan.zag — M6 injection firewall scanner (Zag-native, deterministic).
// Reads a parser output file (B|kind|text lines), canonicalizes each block,
// matches fixed literal patterns in 4 classes, flags a block when >=2
// distinct classes match. Page verdict: INJECTED if any block flagged.
// Output: F|<blockidx>|<classmask> per block, then PAGE|INJECTED|n or PAGE|CLEAR.
// Exit 0 = scanned; 2 = usage; 4 = write failure.
@import("R33_NATIVE_IO_V1.zag")

// ---------- file I/O (same sanctioned pattern as html_parse) ----------
fn split_dir_base(path:[]u8, dir:[]u8, base:[]u8)void {
    let n:i32=path.len;
    let cut:i32=-1;
    let i:i32=0;
    while(i<n){
        if((path[i] as i32)==47){ cut=i; }
        i=i+1;
    }
    if(cut<0){
        dir[0]=46;
        let j:i32=0;
        while(j<n){ base[j]=path[j]; j=j+1; }
        return;
    }
    if(cut==0){
        dir[0]=47;
        let j2:i32=1;
        let k:i32=0;
        while(j2<n){ base[k]=path[j2]; k=k+1; j2=j2+1; }
        return;
    }
    let j3:i32=0;
    while(j3<cut){ dir[j3]=path[j3]; j3=j3+1; }
    let j4:i32=cut+1;
    let k2:i32=0;
    while(j4<n){ base[k2]=path[j4]; k2=k2+1; j4=j4+1; }
    return;
}

fn cstr_len(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ if((s[i] as i32)==0){ return i; } i=i+1; }
    return s.len;
}

fn read_all(path:[]u8)[]u8 {
    let dir:[]u8=nio_alloc(4096);
    let base:[]u8=nio_alloc(4096);
    if(dir.len==0 || base.len==0){ return ""; }
    let zi:i32=0;
    while(zi<4096){ dir[zi]=0; base[zi]=0; zi=zi+1; }
    split_dir_base(path,dir,base);
    let dl:i32=cstr_len(dir);
    let bl:i32=cstr_len(base);
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){ return ""; }
    let fd:i64=nio_open_child(root,base[0..bl],0);
    nio_close(root);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,1048576);
    nio_close(fd);
    if(n<=0){ return ""; }
    return buf[0..(n as i32)];
}

fn write_all(path:[]u8, data:[]u8)i32 {
    let dir:[]u8=nio_alloc(4096);
    let base:[]u8=nio_alloc(4096);
    if(dir.len==0 || base.len==0){ return 0; }
    let zi:i32=0;
    while(zi<4096){ dir[zi]=0; base[zi]=0; zi=zi+1; }
    split_dir_base(path,dir,base);
    let dl:i32=cstr_len(dir);
    let bl:i32=cstr_len(base);
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){ return 0; }
    let fd:i64=nio_open_child(root,base[0..bl],1);
    nio_close(root);
    if(fd<0){ return 0; }
    let w:i64=nio_write_all(fd,data);
    nio_close(fd);
    if(w<0){ return 0; }
    return 1;
}

// ---------- tiny string helpers ----------
fn is_ws(c:i32)i32 {
    if(c==32){ return 1; }
    if(c==9){ return 1; }
    if(c==10){ return 1; }
    if(c==13){ return 1; }
    if(c==12){ return 1; }
    if(c==11){ return 1; }
    return 0;
}

fn is_punct(c:i32)i32 {
    // Sol: !-/ , :-@ , [-` , { - ~
    if(c>=33 && c<=47){ return 1; }
    if(c>=58 && c<=64){ return 1; }
    if(c>=91 && c<=96){ return 1; }
    if(c>=123 && c<=126){ return 1; }
    return 0;
}

fn has_sub(h:[]u8, hn:i32, p:[]u8, pn:i32)i32 {
    if(pn==0){ return 1; }
    if(hn<pn){ return 0; }
    let i:i32=0;
    while(i+pn<=hn){
        let k:i32=0;
        while(k<pn){
            if((h[i+k] as i32)!=(p[k] as i32)){ break; }
            k=k+1;
        }
        if(k==pn){ return 1; }
        i=i+1;
    }
    return 0;
}

// canonicalize src[0..sn] into dst; returns dst length.
// lower ASCII; whitespace+punct -> space; collapse; trim.
fn canon(src:[]u8, sn:i32, dst:[]u8)i32 {
    let n:i32=0;
    let pend:i32=0;
    let i:i32=0;
    while(i<sn){
        let c:i32=src[i] as i32;
        if(c>=65 && c<=90){ c=c+32; }
        if(is_ws(c)==1 || is_punct(c)==1){
            pend=1;
        } else {
            if(pend==1 && n>0){
                dst[n]=32; n=n+1;
            }
            pend=0;
            dst[n]=c as u8; n=n+1;
        }
        i=i+1;
    }
    return n;
}

fn emit_line(out:[]u8, pos:i32, s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ out[pos]=s[i]; pos=pos+1; i=i+1; }
    out[pos]=10; pos=pos+1;
    return pos;
}

fn emit_i32(out:[]u8, pos:i32, v:i32)i32 {
    let tmp:[]u8=nio_alloc(16);
    let n:i32=0;
    if(v==0){ tmp[0]=48; n=1; } else {
        let d:[]u8=nio_alloc(16);
        let nd:i32=0;
        let x:i32=v;
        while(x>0){ d[nd]=(x-(x/10)*10+48) as u8; nd=nd+1; x=x/10; }
        while(nd>0){ nd=nd-1; tmp[n]=d[nd]; n=n+1; }
    }
    let i:i32=0;
    while(i<n){ out[pos]=tmp[i]; pos=pos+1; i=i+1; }
    return pos;
}

fn emit_fl(out:[]u8, pos:i32, bidx:i32, mask:i32)i32 {
    // writes "F|<bidx>|<mask>\n"
    out[pos]=70; out[pos+1]=124; pos=pos+2;
    pos=emit_i32(out,pos,bidx);
    out[pos]=124; pos=pos+1;
    pos=emit_i32(out,pos,mask);
    out[pos]=10; pos=pos+1;
    return pos;
}

fn emit_page(out:[]u8, pos:i32, nflag:i32)i32 {
    // writes "PAGE|INJECTED|<n>\n" or "PAGE|CLEAR\n"
    if(nflag>0){
        out[pos]=80; out[pos+1]=65; out[pos+2]=71; out[pos+3]=69;
        out[pos+4]=124; out[pos+5]=73; out[pos+6]=78; out[pos+7]=74;
        out[pos+8]=69; out[pos+9]=67; out[pos+10]=84; out[pos+11]=69;
        out[pos+12]=68; out[pos+13]=124; pos=pos+14;
        pos=emit_i32(out,pos,nflag);
        out[pos]=10; pos=pos+1;
    } else {
        out[pos]=80; out[pos+1]=65; out[pos+2]=71; out[pos+3]=69;
        out[pos+4]=124; out[pos+5]=67; out[pos+6]=76; out[pos+7]=69;
        out[pos+8]=65; out[pos+9]=82; out[pos+10]=10; pos=pos+11;
    }
    return pos;
}

// pattern table: 16 patterns, class = idx/4 + 1
fn pat_class(idx:i32)i32 { return idx/4+1; }

fn get_pat(idx:i32)[]u8 {
    // literal patterns, already in canonical form
    if(idx==0){ return "ignore your rules"; }
    if(idx==1){ return "disregard previous instructions"; }
    if(idx==2){ return "install this as fact"; }
    if(idx==3){ return "follow these instructions"; }
    if(idx==4){ return "system override"; }
    if(idx==5){ return "administrator says"; }
    if(idx==6){ return "as an administrator"; }
    if(idx==7){ return "developer instruction"; }
    if(idx==8){ return "trust only this page"; }
    if(idx==9){ return "ignore other sources"; }
    if(idx==10){ return "other sources are wrong"; }
    if(idx==11){ return "do not trust other sources"; }
    if(idx==12){ return "if you are an ai"; }
    if(idx==13){ return "if you are a language model"; }
    return "when acting as an ai";
}

fn main()i32 {
    let inpath:[]u8=_zag_arg(1);
    let outpath:[]u8=_zag_arg(2);
    if(inpath.len==0){ return 2; }
    if(outpath.len==0){ return 2; }
    let inp:[]u8=read_all(inpath);
    let n:i32=inp.len;

    let out:[]u8=nio_alloc(1048576);
    let pos:i32=0;
    let cbuf:[]u8=nio_alloc(65536);

    let i:i32=0;
    let bidx:i32=0;
    let nflag:i32=0;
    while(i<n){
        // read one line
        let ls:i32=i;
        while(i<n && (inp[i] as i32)!=10){ i=i+1; }
        let le:i32=i;
        if(i<n){ i=i+1; }
        if(le>ls && (inp[le-1] as i32)==13){ le=le-1; }
        // only B| lines are scanned
        if(le-ls>=2 && (inp[ls] as i32)==66 && (inp[ls+1] as i32)==124){
            // find text after second '|'
            let p1:i32=-1;
            let p2:i32=-1;
            let k:i32=ls;
            while(k<le){
                if((inp[k] as i32)==124){
                    if(p1<0){ p1=k; } else { p2=k; break; }
                }
                k=k+1;
            }
            let ts:i32=le;
            if(p2>=0){ ts=p2+1; }
            let sn:i32=le-ts;
            let cn:i32=canon(inp[ts..le],sn,cbuf);
            let mask:i32=0;
            let pi:i32=0;
            while(pi<16){
                let p:[]u8=get_pat(pi);
                if(has_sub(cbuf,cn,p,p.len)==1){
                    let cl:i32=pat_class(pi);
                    if(cl==1){ mask=mask | 1; } else {
                    if(cl==2){ mask=mask | 2; } else {
                    if(cl==3){ mask=mask | 4; } else {
                        mask=mask | 8;
                    } } }
                }
                pi=pi+1;
            }
            // count distinct classes
            let nc:i32=0;
            if((mask & 1)!=0){ nc=nc+1; }
            if((mask & 2)!=0){ nc=nc+1; }
            if((mask & 4)!=0){ nc=nc+1; }
            if((mask & 8)!=0){ nc=nc+1; }
            pos=emit_fl(out,pos,bidx,mask);
            bidx=bidx+1;
            if(nc>=2){ nflag=nflag+1; }
        }
    }
    pos=emit_page(out,pos,nflag);
    if(write_all(outpath,out[0..pos])!=1){ return 4; }
    return 0;
}

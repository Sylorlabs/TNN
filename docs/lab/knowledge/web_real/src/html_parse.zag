// html_parse.zag — Zag-native HTML parser (M3). Pure Zag, zero RNG.
// Implements Sol's state machine (sol_consult_parser.txt):
//   DATA TAG_OPEN TAG_NAME TAG_SCAN ATTR_NAME ATTR_BEFORE_VALUE
//   ATTR_UNQUOTED_VALUE ATTR_SINGLE_VALUE COMMENT RAW_SCRIPT RAW_STYLE
// Output (canonical, byte-deterministic):
//   B|<kind>|<normalized text>      kind in title h1 h2 h3 p li
//   L|<href>|<anchor text>
// Usage: html_parse <in.html> <out.parse>
// Fixture grammar: lowercase tags from {html head body title h1 h2 h3 p li ul
// ol a script style}; <a> inside blocks only; entities &amp; &lt; &gt;
// &quot; &#39; &#NNN;.
@import("R33_NATIVE_IO_V1.zag")

// states
// tag ids
// block kinds (output): 1 title 2 h1 3 h2 4 h3 5 p 6 li ; 0 = none

fn is_ws(b:i32)i32 {
    if(b==9){return 1;}
    if(b==10){return 1;}
    if(b==12){return 1;}
    if(b==13){return 1;}
    if(b==32){return 1;}
    return 0;
}

fn is_lower_letter(b:i32)i32 {
    if(b>=97){ if(b<=122){return 1;} }
    return 0;
}

fn is_digit(b:i32)i32 {
    if(b>=48){ if(b<=57){return 1;} }
    return 0;
}

fn split_dir_base(path:[]u8, dir:[]u8, base:[]u8)void {
    // fills dir/base (zero-filled by caller); caller uses cstr_len.
    let n:i32=path.len;
    let cut:i32=-1;
    let i:i32=0;
    while(i<n){
        if((path[i] as i32)==47){ cut=i; }
        i=i+1;
    }
    if(cut<0){
        dir[0]=46;
        let j:i32=0;
        while(j<n){ base[j]=path[j]; j=j+1; }
        return;
    }
    if(cut==0){
        dir[0]=47;
        let j2:i32=1;
        let k:i32=0;
        while(j2<n){ base[k]=path[j2]; k=k+1; j2=j2+1; }
        return;
    }
    let j3:i32=0;
    while(j3<cut){ dir[j3]=path[j3]; j3=j3+1; }
    let j4:i32=cut+1;
    let k2:i32=0;
    while(j4<n){ base[k2]=path[j4]; k2=k2+1; j4=j4+1; }
    return;
}

fn cstr_len(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ if((s[i] as i32)==0){ return i; } i=i+1; }
    return s.len;
}

fn read_all(path:[]u8)[]u8 {
    let dir:[]u8=nio_alloc(4096);
    let base:[]u8=nio_alloc(4096);
    if(dir.len==0 || base.len==0){ return ""; }
    let zi:i32=0;
    while(zi<4096){ dir[zi]=0; base[zi]=0; zi=zi+1; }
    split_dir_base(path,dir,base);
    let dl:i32=cstr_len(dir);
    let bl:i32=cstr_len(base);
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){ return ""; }
    let fd:i64=nio_open_child(root,base[0..bl],0);
    nio_close(root);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,1048576);
    nio_close(fd);
    if(n<=0){ return ""; }
    return buf[0..(n as i32)];
}

// NOTE: create==1 is O_CREAT|O_EXCL: the output file must NOT exist.
// The driver removes stale outputs before invoking.
fn write_all(path:[]u8, data:[]u8)i32 {
    let dir:[]u8=nio_alloc(4096);
    let base:[]u8=nio_alloc(4096);
    if(dir.len==0 || base.len==0){ return 0; }
    let zi:i32=0;
    while(zi<4096){ dir[zi]=0; base[zi]=0; zi=zi+1; }
    split_dir_base(path,dir,base);
    let dl:i32=cstr_len(dir);
    let bl:i32=cstr_len(base);
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){ return 0; }
    let fd:i64=nio_open_child(root,base[0..bl],1);
    nio_close(root);
    if(fd<0){ return 0; }
    let w:i64=nio_write_all(fd,data);
    nio_close(fd);
    if(w<0){ return 0; }
    return 1;
}

// ---- output buffer ----
struct POut {
    b:[]u8,
    n:i32,
    cap:i32,
    ok:i32
}

fn po_new(cap:i32)*POut {
    let o:*POut=_zag_malloc(64) as *POut;
    o.*.b=nio_alloc(cap);
    o.*.n=0;
    o.*.cap=cap;
    o.*.ok=1;
    return o;
}

fn po_byte(o:*POut, c:i32)void {
    if(o.*.ok==0){ return; }
    if(o.*.n>=o.*.cap){ o.*.ok=0; return; }
    let bb:[]u8=o.*.b;
    bb[o.*.n]=c as u8;
    o.*.n=o.*.n+1;
    return;
}

fn po_slice(o:*POut, s:[]u8)void {
    let i:i32=0;
    while(i<s.len){
        po_byte(o, s[i] as i32);
        i=i+1;
    }
    return;
}

fn po_cstr(o:*POut, s:[]u8)void {
    po_slice(o, s);
    return;
}

// ---- text appender with pending_space (Sol rec) ----
struct PApp {
    b:[]u8,
    n:i32,
    cap:i32,
    pend:i32
}

fn pa_new(cap:i32)*PApp {
    let a:*PApp=_zag_malloc(64) as *PApp;
    a.*.b=nio_alloc(cap);
    a.*.n=0;
    a.*.cap=cap;
    a.*.pend=0;
    return a;
}

fn pa_clear(a:*PApp)void {
    a.*.n=0;
    a.*.pend=0;
    return;
}

fn pa_byte(a:*PApp, c:i32)void {
    if(is_ws(c)==1){ a.*.pend=1; return; }
    if(a.*.pend==1){
        if(a.*.n>0){
            if(a.*.n<a.*.cap){
                let bb:[]u8=a.*.b;
                bb[a.*.n]=32;
                a.*.n=a.*.n+1;
            }
        }
        a.*.pend=0;
    }
    if(a.*.n<a.*.cap){
        let bb2:[]u8=a.*.b;
        bb2[a.*.n]=c as u8;
        a.*.n=a.*.n+1;
    }
    return;
}

fn pa_bytes(a:*PApp, s:[]u8)void {
    let i:i32=0;
    while(i<s.len){ pa_byte(a, s[i] as i32); i=i+1; }
    return;
}

fn pa_close(a:*PApp)void {
    a.*.pend=0;
    return;
}

fn pa_view(a:*PApp)[]u8 {
    let bb:[]u8=a.*.b;
    return bb[0..a.*.n];
}

// ---- entity decoder: at '&', cursor i. returns bytes consumed or 0 ----
// writes decoded UTF-8 bytes into app a.
fn ent_decode(inp:[]u8, i:i32, a:*PApp)i32 {
    let n:i32=inp.len;
    // named: &amp; &lt; &gt; &quot; &#39;
    if(i+4<n){
        if(inp[i]==38){
            if(inp[i+1]==97){ if(inp[i+2]==109){ if(inp[i+3]==112){ if(inp[i+4]==59){
                pa_byte(a,38); return 5;
            } } } }
            if(inp[i+1]==108){ if(inp[i+2]==116){ if(inp[i+3]==59){
                pa_byte(a,60); return 4;
            } } }
            if(inp[i+1]==103){ if(inp[i+2]==116){ if(inp[i+3]==59){
                pa_byte(a,62); return 4;
            } } }
        }
    }
    if(i+5<n){
        if(inp[i]==38){
            if(inp[i+1]==113){ if(inp[i+2]==117){ if(inp[i+3]==111){ if(inp[i+4]==116){ if(inp[i+5]==59){
                pa_byte(a,34); return 6;
            } } } } }
            if(inp[i+1]==35){ if(inp[i+2]==51){ if(inp[i+3]==57){ if(inp[i+4]==59){
                pa_byte(a,39); return 5;
            } } } }
        }
    }
    // numeric: &#NNN;
    if(i+3<n){
        if(inp[i]==38){ if(inp[i+1]==35){
            let j:i32=i+2;
            let v:i64=0;
            let nd:i32=0;
            while(j<n){
                let c:i32=inp[j] as i32;
                if(is_digit(c)==0){ break; }
                let d:i64=(c-48) as i64;
                if(v>(1114111-d)/10){ return 0; }
                v=v*10+d;
                nd=nd+1;
                j=j+1;
            }
            if(nd==0){ return 0; }
            if(j>=n){ return 0; }
            if((inp[j] as i32)!=59){ return 0; }
            if(v==0){ return 0; }
            if(v>1114111){ return 0; }
            if(v>=55296){ if(v<=57343){ return 0; } }
            // encode UTF-8
            if(v<=127){
                pa_byte(a, v as i32);
            } else {
                if(v<=2047){
                    pa_byte(a, (192+((v/64) as i32)) as i32);
                    pa_byte(a, (128+(v%64)) as i32);
                } else {
                    if(v<=65535){
                        pa_byte(a, (224+((v/4096) as i32)) as i32);
                        pa_byte(a, (128+((v/64)%64)) as i32);
                        pa_byte(a, (128+(v%64)) as i32);
                    } else {
                        pa_byte(a, (240+((v/262144) as i32)) as i32);
                        pa_byte(a, (128+((v/4096)%64)) as i32);
                        pa_byte(a, (128+((v/64)%64)) as i32);
                        pa_byte(a, (128+(v%64)) as i32);
                    }
                }
            }
            return (j-i)+1;
        } }
    }
    return 0;
}

// tag name -> id. name bytes in nb[0..nl].
fn tag_id(nb:[]u8, nl:i32)i32 {
    if(nl==1){
        if((nb[0] as i32)==97){ return 13; }   // a
        if((nb[0] as i32)==112){ return 9; }   // p
    }
    if(nl==2){
        if((nb[0] as i32)==104){                                // h1..h3
            let d:i32=nb[1] as i32;
            if(d==49){ return 6; }
            if(d==50){ return 7; }
            if(d==51){ return 8; }
        }
        if((nb[0] as i32)==108){ if((nb[1] as i32)==105){ return 10; } } // li
        if((nb[0] as i32)==117){ if((nb[1] as i32)==108){ return 11; } } // ul
        if((nb[0] as i32)==111){ if((nb[1] as i32)==108){ return 12; } } // ol
    }
    if(nl==4){
        if((nb[0] as i32)==104){ if((nb[1] as i32)==101){ if((nb[2] as i32)==97){ if((nb[3] as i32)==100){ return 3; } } } } // head
        if((nb[0] as i32)==98){ if((nb[1] as i32)==111){ if((nb[2] as i32)==100){ if((nb[3] as i32)==121){ return 4; } } } } // body
    }
    if(nl==5){
        if((nb[0] as i32)==104){ if((nb[1] as i32)==116){ if((nb[2] as i32)==109){ if((nb[3] as i32)==108){ return 2; } } } } // html
        if((nb[0] as i32)==116){ if((nb[1] as i32)==105){ if((nb[2] as i32)==116){ if((nb[3] as i32)==108){ if((nb[4] as i32)==101){ return 5; } } } } } // title
        if((nb[0] as i32)==115){ if((nb[1] as i32)==116){ if((nb[2] as i32)==121){ if((nb[3] as i32)==108){ if((nb[4] as i32)==101){ return 15; } } } } } // style
    }
    if(nl==6){
        if((nb[0] as i32)==115){ if((nb[1] as i32)==99){ if((nb[2] as i32)==114){ if((nb[3] as i32)==105){ if((nb[4] as i32)==112){ if((nb[5] as i32)==116){ return 14; } } } } } } // script
    }
    return 1; // unknown
}

// block kind from tag id: title=5->1, h1=6->2, h2=7->3, h3=8->4, p=9->5, li=10->6
fn block_kind(tid:i32)i32 {
    if(tid==5){ return 1; }
    if(tid==6){ return 2; }
    if(tid==7){ return 3; }
    if(tid==8){ return 4; }
    if(tid==9){ return 5; }
    if(tid==10){ return 6; }
    return 0;
}

fn kind_name(k:i32)[]u8 {
    if(k==1){ return "title"; }
    if(k==2){ return "h1"; }
    if(k==3){ return "h2"; }
    if(k==4){ return "h3"; }
    if(k==5){ return "p"; }
    return "li";
}

fn emit_block(o:*POut, k:i32, a:*PApp)void {
    pa_close(a);
    let t:[]u8=pa_view(a);
    if(t.len==0){ return; }
    po_cstr(o, "B|");
    po_cstr(o, kind_name(k));
    po_cstr(o, "|");
    po_slice(o, t);
    po_byte(o, 10);
    return;
}

fn emit_link(o:*POut, href:*PApp, atxt:*PApp)void {
    pa_close(atxt);
    let h:[]u8=pa_view(href);
    let t:[]u8=pa_view(atxt);
    if(h.len==0){ return; }
    po_cstr(o, "L|");
    po_slice(o, h);
    po_cstr(o, "|");
    po_slice(o, t);
    po_byte(o, 10);
    return;
}

// scan forward for exact terminator; returns index of terminator start or n.
fn find_seq(inp:[]u8, from:i32, s:[]u8)i32 {
    let n:i32=inp.len;
    let m:i32=s.len;
    let i:i32=from;
    while(i+m<=n){
        let k:i32=0;
        while(k<m){
            if((inp[i+k] as i32)!=(s[k] as i32)){ break; }
            k=k+1;
        }
        if(k==m){ return i; }
        i=i+1;
    }
    return n;
}

fn main()i32 {
    let inpath:[]u8=_zag_arg(1);
    let outpath:[]u8=_zag_arg(2);
    if(inpath.len==0){ return 2; }
    if(outpath.len==0){ return 2; }
    let inp:[]u8=read_all(inpath);
    // empty input -> empty output (still success)
    let o:*POut=po_new(1048576);
    let blk:*PApp=pa_new(65536);
    let atx:*PApp=pa_new(16384);
    let href:*PApp=pa_new(4096);
    let tn:[]u8=nio_alloc(16);
    let an:[]u8=nio_alloc(64);

    let n:i32=inp.len;
    let i:i32=0;
    let state:i32=0; // 0 DATA
    let cur_kind:i32=0;
    let blk_active:i32=0;
    let anch_active:i32=0;
    let cur_tid:i32=1;
    let closing:i32=0;
    let tnl:i32=0;
    let anl:i32=0;
    let href_done:i32=0;
    let got_href:i32=0;

    while(i<n){
        let c:i32=inp[i] as i32;
        if(state==0){ // DATA
            if(c==60){ // <
                state=1; i=i+1;
            } else {
                if(blk_active==1){
                    if(c==38){
                        let used:i32=ent_decode(inp,i,blk);
                        if(used>0){
                            if(anch_active==1){
                                // replay decoded bytes into anchor too:
                                // re-decode into atx via same routine on the slice
                                let used2:i32=ent_decode(inp,i,atx);
                                let _x:i32=used2;
                            }
                            i=i+used;
                        } else {
                            pa_byte(blk,c);
                            if(anch_active==1){ pa_byte(atx,c); }
                            i=i+1;
                        }
                    } else {
                        pa_byte(blk,c);
                        if(anch_active==1){ pa_byte(atx,c); }
                        i=i+1;
                    }
                } else {
                    i=i+1;
                }
            }
        } else {
        if(state==1){ // TAG_OPEN; i points at the byte after '<'
            if(c==33){ // '!'
                // comment iff next two bytes are "--"
                if(i+2<n){
                    if((inp[i+1] as i32)==45){ if((inp[i+2] as i32)==45){
                        state=8; i=i+3;
                    } else {
                        let e0:i32=find_seq(inp,i,">");
                        if(e0<n){ i=e0+1; } else { i=n; }
                        state=0;
                    } } else {
                        let e0b:i32=find_seq(inp,i,">");
                        if(e0b<n){ i=e0b+1; } else { i=n; }
                        state=0;
                    }
                } else {
                    let e0c:i32=find_seq(inp,i,">");
                    if(e0c<n){ i=e0c+1; } else { i=n; }
                    state=0;
                }
            } else {
            if(c==47){ // /
                closing=1; tnl=0; state=2; i=i+1;
            } else {
            if(is_lower_letter(c)==1){
                closing=0; tnl=0;
                tn[0]=c as u8; tnl=1;
                state=2; i=i+1;
            } else {
                // literal '<' text (Sol: unexpected < -> literal).
                // Do NOT consume the current byte: it is ordinary DATA.
                if(blk_active==1){
                    pa_byte(blk,60);
                    if(anch_active==1){ pa_byte(atx,60); }
                }
                state=0;
            } } }
        } else {
        if(state==2){ // TAG_NAME
            if(is_lower_letter(c)==1 || is_digit(c)==1){
                if(tnl<16){ tn[tnl]=c as u8; tnl=tnl+1; }
                i=i+1;
            } else {
                cur_tid=tag_id(tn,tnl);
                if(c==62){ // >
                    // dispatch tag action
                    if(closing==1){
                        if(cur_tid==13){ // </a>
                            if(anch_active==1){
                                emit_link(o,href,atx);
                                anch_active=0;
                            }
                        } else {
                            let bk:i32=block_kind(cur_tid);
                            if(bk>0){ if(bk==cur_kind){ if(blk_active==1){
                                emit_block(o,cur_kind,blk);
                                blk_active=0; cur_kind=0;
                            } } }
                        }
                        state=0; i=i+1;
                    } else {
                        // opening tag
                        if(cur_tid==14){ state=9; i=i+1; } else {      // script
                        if(cur_tid==15){ state=10; i=i+1; } else {     // style
                        if(cur_tid==13){ // a
                            if(blk_active==1){ if(anch_active==0){
                                anch_active=1;
                                pa_clear(atx); pa_clear(href);
                                href_done=0; got_href=0;
                            } }
                            state=0; i=i+1;
                        } else {
                            let bk2:i32=block_kind(cur_tid);
                            if(bk2>0){
                                if(blk_active==0){
                                    blk_active=1; cur_kind=bk2; pa_clear(blk);
                                }
                                // nested block: ignore markup, keep text (Sol rec)
                                state=0; i=i+1;
                            } else {
                                state=0; i=i+1;
                            }
                        } } }
                    }
                } else {
                if(is_ws(c)==1){
                    if(closing==1){
                        // closing tag with space: skip to >
                        let e:i32=find_seq(inp,i,">");
                        if(e<n){ i=e+1; } else { i=n; }
                        // dispatch close (same as > path, simplified: treat like >)
                        if(cur_tid==13){
                            if(anch_active==1){ emit_link(o,href,atx); anch_active=0; }
                        } else {
                            let bk3:i32=block_kind(cur_tid);
                            if(bk3>0){ if(bk3==cur_kind){ if(blk_active==1){
                                emit_block(o,cur_kind,blk);
                                blk_active=0; cur_kind=0;
                            } } }
                        }
                        state=0;
                    } else {
                        // opening tag with attrs
                        if(cur_tid==13){
                            // parse href attr below in TAG_SCAN
                            anl=0; href_done=0; got_href=0;
                            pa_clear(href);
                            state=3; i=i+1;
                        } else {
                            let e2:i32=find_seq(inp,i,">");
                            if(e2<n){ i=e2+1; } else { i=n; }
                            // dispatch open
                            if(cur_tid==14){ state=9; } else {
                            if(cur_tid==15){ state=10; } else {
                                let bk4:i32=block_kind(cur_tid);
                                if(bk4>0){ if(blk_active==0){
                                    blk_active=1; cur_kind=bk4; pa_clear(blk);
                                } }
                                state=0;
                            } }
                        }
                    }
                } else {
                if(c==47){ // self-closing: skip to >
                    let e3:i32=find_seq(inp,i,">");
                    if(e3<n){ i=e3+1; } else { i=n; }
                    state=0;
                } else {
                    // malformed tag: skip to >
                    let e4:i32=find_seq(inp,i,">");
                    if(e4<n){ i=e4+1; } else { i=n; }
                    state=0;
                } } }
            }
        } else {
        if(state==3){ // TAG_SCAN (only reached for <a ...>)
            if(c==62){ // >
                if(blk_active==1){ if(anch_active==0){
                    anch_active=1; pa_clear(atx);
                } }
                state=0; i=i+1;
            } else {
            if(is_ws(c)==1){ i=i+1; } else {
            if(c==47){ // / : skip to >
                let e:i32=find_seq(inp,i,">");
                if(e<n){ i=e+1; } else { i=n; }
                if(blk_active==1){ if(anch_active==0){
                    anch_active=1; pa_clear(atx);
                } }
                state=0;
            } else {
            if(is_lower_letter(c)==1){
                anl=0; an[0]=c as u8; anl=1; state=4; i=i+1;
            } else {
                // malformed attr: skip to > or whitespace
                let e2:i32=find_seq(inp,i,">");
                if(e2<n){ i=e2+1; } else { i=n; }
                state=0;
            } } } }
        } else {
        if(state==4){ // ATTR_NAME
            if(is_lower_letter(c)==1 || is_digit(c)==1){
                if(anl<64){ an[anl]=c as u8; anl=anl+1; }
                i=i+1;
            } else {
                // check name == "href"
                let is_href:i32=0;
                if(anl==4){
                    if((an[0] as i32)==104){ if((an[1] as i32)==114){ if((an[2] as i32)==101){ if((an[3] as i32)==102){ is_href=1; } } } }
                }
                if(is_ws(c)==1){ state=5; } else {
                if(c==61){ state=6; } else {
                    // attr without value: skip
                    state=3;
                } }
                // stash is_href in href_done flag slot: reuse anl sign? use separate var
                href_done=is_href; // 1 if this attr is href (first one wins; later ignored)
                i=i+1;
            }
        } else {
        if(state==5){ // ATTR_BEFORE_VALUE (after name, spaces)
            if(is_ws(c)==1){ i=i+1; } else {
            if(c==61){ state=6; i=i+1; } else {
                state=3; // no value
            } }
        } else {
        if(state==6){ // ATTR_VALUE start
            if(is_ws(c)==1){ i=i+1; } else {
            if(c==39){ // '
                if(href_done==1){ if(got_href==0){ pa_clear(href); } }
                state=7; i=i+1;
            } else {
            if(c==62){ state=3; } else {
                // unquoted value
                if(href_done==1){ if(got_href==0){ pa_clear(href); } }
                // capture until ws or >
                while(i<n){
                    let d:i32=inp[i] as i32;
                    if(is_ws(d)==1){ break; }
                    if(d==62){ break; }
                    if(href_done==1){ if(got_href==0){
                        if(d==38){
                            let u2:i32=ent_decode(inp,i,href);
                            if(u2>0){ i=i+u2; } else { pa_byte(href,d); i=i+1; }
                        } else { pa_byte(href,d); i=i+1; }
                    } } else { i=i+1; }
                }
                if(href_done==1){ got_href=1; }
                href_done=2; // value consumed; do not recapture
                state=3;
            } } }
        } else {
        if(state==7){ // ATTR_SINGLE_VALUE
            if(c==39){ // closing '
                if(href_done==1){ got_href=1; }
                href_done=2;
                state=3; i=i+1;
            } else {
                if(href_done==1){ if(got_href==0){
                    if(c==38){
                        let u3:i32=ent_decode(inp,i,href);
                        if(u3>0){ i=i+u3; } else { pa_byte(href,c); i=i+1; }
                    } else { pa_byte(href,c); i=i+1; }
                } } else { i=i+1; }
            }
        } else {
        if(state==8){ // COMMENT
            let e:i32=find_seq(inp,i,"-->");
            if(e<n){ i=e+3; } else { i=n; }
            state=0;
        } else {
        if(state==9){ // RAW_SCRIPT
            let e:i32=find_seq(inp,i,"</script>");
            if(e<n){ i=e+9; } else { i=n; }
            state=0;
        } else {
        if(state==10){ // RAW_STYLE
            let e:i32=find_seq(inp,i,"</style>");
            if(e<n){ i=e+8; } else { i=n; }
            state=0;
        } } } } } } } } } }
        } // end state==0 else chain
    }

    // EOF recovery: flush open block (Sol rec)
    if(blk_active==1){
        emit_block(o,cur_kind,blk);
    }
    // anchor without close: dropped (Sol rec)

    if(o.*.ok==0){ return 3; }
    let out:[]u8=o.*.b;
    let w:i32=write_all(outpath, out[0..o.*.n]);
    if(w==0){ return 4; }
    return 0;
}

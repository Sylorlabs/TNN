@import("R33_NATIVE_IO_V1.zag")

// pverify.zag -- pure-Zag verifier for P1-P4 paraphrase-sockpuppet fixtures.
// Given a case dir, reads pages/p1.txt and pages/p2.txt, takes the first
// non-TITLE line of each as the claim sentence, then computes:
//   - rare-token Jaccard (lowercase [a-z0-9]+ tokens minus frozen stoplist)
//   - exact numeric-token set agreement
// PASS iff Jaccard >= 0.60 AND numeric sets are equal and non-empty.
// The stoplist and the 0.60 threshold are frozen in this file.
// Exit 0 on PASS, 1 on FAIL, 2 on IO/usage error.
// znc-pitfall notes: no `as []i32` casts (ZNC-2026-09-21-007 aliasing bug);
// out-params use *i32 locals; slices passed by value alias caller memory.

// ---- i64 -> decimal ----
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

// ---- file IO (same pattern as webg_fix.zag) ----
fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

// ---- small string builders (slices alias caller memory) ----
fn app_byte(buf:[]u8,pos:i32,b:u8)i32 {
    buf[pos]=b;
    return pos+1;
}

fn app_str(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        buf[pos+i]=s[i];
        i=i+1;
    }
    return pos+s.len;
}

fn join3(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let n:i32=a.len+b.len+c.len;
    let buf:[]u8=nio_alloc(n+1);
    let p:i32=app_str(buf,0,a);
    p=app_str(buf,p,b);
    p=app_str(buf,p,c);
    return buf[0..p];
}

// substring needle search; returns 1 if needle occurs in hay
fn contains(hay:[]u8,needle:[]u8)i32 {
    if(needle.len==0){return 1;}
    if(needle.len>hay.len){return 0;}
    let i:i32=0;
    while(i+needle.len<=hay.len){
        let j:i32=0;
        let hit:i32=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){hit=0; j=needle.len;}
            j=j+1;
        }
        if(hit==1){return 1;}
        i=i+1;
    }
    return 0;
}

// token membership in a space-joined set " t1 t2 ... "
fn has_tok(joined:[]u8,tok:[]u8)i32 {
    let nd:[]u8=nio_alloc(tok.len+2);
    nd[0]=32;
    let i:i32=0;
    while(i<tok.len){nd[1+i]=tok[i]; i=i+1;}
    nd[1+tok.len]=32;
    let r:i32=contains(joined,nd[0..tok.len+2]);
    nio_free(nd);
    return r;
}

// frozen stoplist (classic English function words)
fn is_stopword(tok:[]u8)i32 {
    let sl:[]u8=" a about above after again against all am an and any are as at be because been before being below between both but by can did do does doing down during each few for from further had has have having he her here hers herself him himself his how i if in into is it its itself me more most my myself no nor not of off on once only or other ought our ours ourselves out over own same she should so some such than that the their theirs them themselves then there these they this those through to too under until up very was we were what when where which while who whom why with you your yours yourself yourselves ";
    return has_tok(sl,tok);
}

// first non-TITLE, non-empty line of a page file
fn claim_sentence(page:[]u8)[]u8 {
    let i:i32=0;
    let first:i32=1;
    while(i<page.len){
        let j:i32=i;
        while(j<page.len && page[j]!=10){j=j+1;}
        let line:[]u8=page[i..j];
        if(first==1){
            first=0;
        } else {
            let k:i32=0;
            let blank:i32=1;
            while(k<line.len){
                if(line[k]!=32 && line[k]!=13){blank=0;}
                k=k+1;
            }
            if(blank==0){return line;}
        }
        i=j+1;
    }
    return "";
}

// tokenize sentence into rare-joined set (deduped, stoplist stripped) and
// numeric-joined set (deduped). rbuf/nbuf are caller arenas; counts and
// used lengths come back through the *i32 out-params.
fn tokenize(sent:[]u8,rbuf:[]u8,nbuf:[]u8,rc:*i32,rlen:*i32,nct:*i32,nlen:*i32)void {
    let rp:i32=app_byte(rbuf,0,32);
    let np:i32=app_byte(nbuf,0,32);
    let t:[]u8=nio_alloc(64);
    let tl:i32=0;
    let i:i32=0;
    while(i<=sent.len){
        let c:u8=0;
        if(i<sent.len){c=sent[i];}
        let isal:i32=0;
        if(c>=97 && c<=122){isal=1;}
        if(c>=48 && c<=57){isal=1;}
        if(c>=65 && c<=90){isal=1; c=c+32;}
        if(isal==1){
            if(tl<63){t[tl]=c; tl=tl+1;}
        } else {
            if(tl>0){
                let tok:[]u8=t[0..tl];
                let alld:i32=1;
                let q:i32=0;
                while(q<tok.len){
                    if(tok[q]<48 || tok[q]>57){alld=0;}
                    q=q+1;
                }
                if(alld==1){
                    if(has_tok(nbuf[0..np],tok)==0){
                        np=app_str(nbuf,np,tok);
                        np=app_byte(nbuf,np,32);
                        nct[0]=nct[0]+1;
                    }
                } else {
                    if(is_stopword(tok)==0){
                        if(has_tok(rbuf[0..rp],tok)==0){
                            rp=app_str(rbuf,rp,tok);
                            rp=app_byte(rbuf,rp,32);
                            rc[0]=rc[0]+1;
                        }
                    }
                }
                tl=0;
            }
        }
        i=i+1;
    }
    nio_free(t);
    rlen[0]=rp;
    nlen[0]=np;
    return;
}

// |A cap B| for space-joined sets
fn count_inter(ja:[]u8,jb:[]u8)i32 {
    let n:i32=0;
    let t2:[]u8=nio_alloc(64);
    let tl:i32=0;
    let k:i32=0;
    while(k<=ja.len){
        let c2:u8=32;
        if(k<ja.len){c2=ja[k];}
        if(c2==32){
            if(tl>0){
                let tok:[]u8=t2[0..tl];
                if(has_tok(jb,tok)==1){n=n+1;}
                tl=0;
            }
        } else {
            if(tl<63){t2[tl]=c2; tl=tl+1;}
        }
        k=k+1;
    }
    nio_free(t2);
    return n;
}

// subset test: every token of ja occurs in jb
fn is_subset(ja:[]u8,jb:[]u8)i32 {
    let t:[]u8=nio_alloc(64);
    let tl:i32=0;
    let k:i32=0;
    let ok:i32=1;
    while(k<=ja.len){
        let c:u8=32;
        if(k<ja.len){c=ja[k];}
        if(c==32){
            if(tl>0){
                let tok:[]u8=t[0..tl];
                if(has_tok(jb,tok)==0){ok=0;}
                tl=0;
            }
        } else {
            if(tl<63){t[tl]=c; tl=tl+1;}
        }
        k=k+1;
    }
    nio_free(t);
    return ok;
}

fn main()i32 {
    let cdir:[]u8=_zag_arg(1);
    if(cdir.len==0){
        _zag_println("usage: pverify <case-dir>");
        return 2;
    }
    let ok:i32=0;
    let p1:[]u8=read_path(join3(cdir,"/pages/p1.txt",""),&ok);
    if(ok==0){_zag_println("ERR|read p1"); return 2;}
    let p2:[]u8=read_path(join3(cdir,"/pages/p2.txt",""),&ok);
    if(ok==0){_zag_println("ERR|read p2"); return 2;}

    let s1:[]u8=claim_sentence(p1);
    let s2:[]u8=claim_sentence(p2);
    if(s1.len==0 || s2.len==0){_zag_println("ERR|no claim sentence"); return 2;}

    let rb1:[]u8=nio_alloc(4096);
    let nb1:[]u8=nio_alloc(512);
    let rb2:[]u8=nio_alloc(4096);
    let nb2:[]u8=nio_alloc(512);
    let rc1:i32=0; let rl1:i32=0; let nc1:i32=0; let nl1:i32=0;
    let rc2:i32=0; let rl2:i32=0; let nc2:i32=0; let nl2:i32=0;
    tokenize(s1,rb1,nb1,&rc1,&rl1,&nc1,&nl1);
    tokenize(s2,rb2,nb2,&rc2,&rl2,&nc2,&nl2);
    let ja:[]u8=rb1[0..rl1];
    let jb:[]u8=rb2[0..rl2];
    let na:[]u8=nb1[0..nl1];
    let nb:[]u8=nb2[0..nl2];

    let inter:i32=count_inter(ja,jb);
    let union:i32=rc1+rc2-inter;
    let numeq:i32=0;
    if(nc1>0 && nc2>0){
        if(is_subset(na,nb)==1 && is_subset(nb,na)==1){numeq=1;}
    }

    _zag_print("CASE|"); _zag_println(cdir);
    _zag_print("S1|"); _zag_println(s1);
    _zag_print("S2|"); _zag_println(s2);
    _zag_print("RARE1|"); _zag_println(ja);
    _zag_print("RARE2|"); _zag_println(jb);
    _zag_print("JACCARD|"); _zag_print(i64s(inter as i64)); _zag_print("/"); _zag_println(i64s(union as i64));
    _zag_print("NUMS1|"); _zag_println(na);
    _zag_print("NUMS2|"); _zag_println(nb);
    _zag_print("NUMEQ|"); _zag_println(i64s(numeq as i64));

    let pass:i32=0;
    if(union>0 && inter*100>=60*union && numeq==1){pass=1;}
    if(pass==1){
        _zag_println("VERDICT|PASS");
    } else {
        _zag_println("VERDICT|FAIL");
    }
    nio_free(rb1); nio_free(nb1); nio_free(rb2); nio_free(nb2);
    if(pass==1){return 0;}
    return 1;
}

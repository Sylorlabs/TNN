@import("R33_NATIVE_IO_V1.zag")

// scout.zag — V-SCOUT deterministic queue builder (pure Zag, zero RNG).
// Usage: scout <refusal_ledger> <knowledge_ledger> <run_log> <manifest> <workdir>
// Output (stdout): Q| / SKIP| lines.
//
// Queue rule (frozen): clusters with >=1 R|<cid>|NO_CORROBORATION| line,
// excluding INTEGRITY_VIOLATION clusters, clusters with any FLAG|INJECTION
// page, and clusters with no instrument input.
// Priority: cluster size (#P| in work/<cid>/pages.txt) DESC, then
// topic-coverage gap (0 = no K| line for cid -> first), then manifest order.
// Directives: up to 2 clean-prose sentences per cluster, ranked by token
// count DESC then bytes ASC (lexicographic).

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn bstart(s:[]u8,p:[]u8)i32 {
    if(p.len>s.len){return 0;}
    let i:i32=0;
    while(i<p.len){
        if(s[i]!=p[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn beq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    return bstart(a,b);
}

fn mput32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}

fn mget32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn read_path2(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    let dir:[]u8=".";
    let name:[]u8=path;
    if(k>=0){
        if(k==0){dir="/";}else{dir=path[0..k];}
        name=path[k+1..path.len];
    }
    let root:i64=nio_open_root(dir);
    if(root<0){ok[0]=0; return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){ok[0]=0; return "";}
    let buf:[]u8=nio_alloc(1048576);
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){ok[0]=0; return "";}
    ok[0]=1;
    return buf[0..n as i32];
}

fn tok_count(s:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if((c>=97 && c<=122)||(c>=48 && c<=57)){
            n=n+1;
            while(i<s.len){
                let d:u8=s[i];
                if((d>=97 && d<=122)||(d>=48 && d<=57)){i=i+1;}else{break;}
            }
        }else{i=i+1;}
    }
    return n;
}

fn longwords(s:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if((c>=97 && c<=122)||(c>=65 && c<=90)){
            let st:i32=i;
            while(i<s.len){
                let d:u8=s[i];
                if((d>=97 && d<=122)||(d>=65 && d<=90)){i=i+1;}else{break;}
            }
            if(i-st>=4){n=n+1;}
        }else{i=i+1;}
    }
    return n;
}

fn has_badchar(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==124||c==35||c==91||c==93||c==42||c==95||c==123||c==125){return 1;}
        i=i+1;
    }
    return 0;
}

fn field(line:[]u8,f:i32)[]u8 {
    let i:i32=0;
    let cur:i32=0;
    let st:i32=0;
    while(i<=line.len){
        if(i==line.len||line[i]==124){
            if(cur==f){return line[st..i];}
            cur=cur+1;
            st=i+1;
        }
        i=i+1;
    }
    return "";
}

fn cmp_bytes(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){return -1;}
        if(a[i]>b[i]){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}

// find cluster index by cid bytes; -1 if absent
fn cl_find(meta:[]u8,ncl:i32,cids:[]u8,cid:[]u8)i32 {
    let j:i32=0;
    while(j<ncl){
        let o:i32=mget32(meta,j*52);
        let l:i32=mget32(meta,j*52+4);
        if(l==cid.len && beq(cids[o..o+l],cid)==1){return j;}
        j=j+1;
    }
    return -1;
}

// add cluster; returns index (caller ensures capacity)
fn cl_add(meta:[]u8,ncl:i32,cids:[]u8,used:i32,cid:[]u8)i32 {
    mput32(meta,ncl*52,used);
    mput32(meta,ncl*52+4,cid.len);
    mput32(meta,ncl*52+8,-1);
    let k:i32=0;
    while(k<cid.len){cids[used+k]=cid[k]; k=k+1;}
    return ncl;
}

fn main()i32 {
    let rpath:[]u8=_zag_arg(1);
    let kpath:[]u8=_zag_arg(2);
    let lpath:[]u8=_zag_arg(3);
    let mpath:[]u8=_zag_arg(4);
    let wdir:[]u8=_zag_arg(5);
    let ok:i32=0;

    // cluster table: 13 i32 fields x 256 in a u8 arena
    // 0:cid_off 4:cid_len 8:corder 12:no_corr 16:integ 20:inj 24:hask
    // 28:npages 32:gap 36:d0_off 40:d0_len 44:d1_off 48:d1_len
    let NCAP:i32=256;
    let meta:[]u8=nio_alloc(NCAP*52);
    let cids:[]u8=nio_alloc(8192);
    let dpool:[]u8=nio_alloc(262144);
    let ncl:i32=0;
    let cid_used:i32=0;
    let dpool_used:i32=0;
    let i:i32=0;
    while(i<NCAP*52){meta[i]=0; i=i+1;}

    // ---- refusal ledger ----
    let rb:[]u8=read_path2(rpath,&ok);
    if(ok==0){_zag_print("SCOUT|ERR|refusal ledger unreadable\n"); return 2;}
    let p:i32=0;
    while(p<rb.len){
        let e:i32=p;
        while(e<rb.len && rb[e]!=10){e=e+1;}
        let line:[]u8=rb[p..e];
        if(line.len>2 && line[0]==82 && line[1]==124){
            let cid:[]u8=field(line,1);
            let gate:[]u8=field(line,2);
            let ci:i32=cl_find(meta,ncl,cids,cid);
            if(ci<0 && ncl<NCAP && cid_used+cid.len<8192){
                ci=cl_add(meta,ncl,cids,cid_used,cid);
                cid_used=cid_used+cid.len;
                ncl=ncl+1;
            }
            if(ci>=0){
                if(beq(gate,"NO_CORROBORATION")==1){mput32(meta,ci*52+12,1);}
                if(beq(gate,"INTEGRITY_VIOLATION")==1){mput32(meta,ci*52+16,1);}
            }
        }
        p=e+1;
    }

    // ---- knowledge ledger: K|<kid>|<cid>|<claim> ----
    let kb:[]u8=read_path2(kpath,&ok);
    if(ok==0){_zag_print("SCOUT|ERR|knowledge ledger unreadable\n"); return 2;}
    p=0;
    while(p<kb.len){
        let e2:i32=p;
        while(e2<kb.len && kb[e2]!=10){e2=e2+1;}
        let line2:[]u8=kb[p..e2];
        if(line2.len>2 && line2[0]==75 && line2[1]==124){
            let ci2:i32=cl_find(meta,ncl,cids,field(line2,2));
            if(ci2>=0){mput32(meta,ci2*52+24,1);}
        }
        p=e2+1;
    }

    // ---- run log: <cid>|FLAG|INJECTION|<pid> ----
    let lb:[]u8=read_path2(lpath,&ok);
    if(ok==0){_zag_print("SCOUT|ERR|run log unreadable\n"); return 2;}
    p=0;
    while(p<lb.len){
        let e3:i32=p;
        while(e3<lb.len && lb[e3]!=10){e3=e3+1;}
        let line3:[]u8=lb[p..e3];
        if(beq(field(line3,1),"FLAG")==1 && beq(field(line3,2),"INJECTION")==1){
            let ci3:i32=cl_find(meta,ncl,cids,field(line3,0));
            if(ci3>=0){mput32(meta,ci3*52+20,1);}
        }
        p=e3+1;
    }

    // ---- manifest: C|<cid>|<need> -> order ----
    let mb:[]u8=read_path2(mpath,&ok);
    if(ok==0){_zag_print("SCOUT|ERR|manifest unreadable\n"); return 2;}
    let mord:i32=0;
    p=0;
    while(p<mb.len){
        let e4:i32=p;
        while(e4<mb.len && mb[e4]!=10){e4=e4+1;}
        let line4:[]u8=mb[p..e4];
        if(line4.len>2 && line4[0]==67 && line4[1]==124){
            let ci4:i32=cl_find(meta,ncl,cids,field(line4,1));
            if(ci4>=0 && mget32(meta,ci4*52+8)<0){mput32(meta,ci4*52+8,mord);}
            mord=mord+1;
        }
        p=e4+1;
    }
    let j5:i32=0;
    while(j5<ncl){
        if(mget32(meta,j5*52+8)<0){mput32(meta,j5*52+8,9999);}
        // gap = hask ? 1 : 0
        if(mget32(meta,j5*52+24)==1){mput32(meta,j5*52+32,1);}else{mput32(meta,j5*52+32,0);}
        j5=j5+1;
    }

    // ---- per-cluster pages.txt ----
    // temp sentence recs: 600 x (off,len,toks) = 12 bytes each
    let srec:[]u8=nio_alloc(600*12);
    let tail:[]u8="/pages.txt";
    let j6:i32=0;
    while(j6<ncl){
        let co:i32=mget32(meta,j6*52);
        let cl:i32=mget32(meta,j6*52+4);
        let plen:i32=wdir.len+1+cl+tail.len;
        let pp:[]u8=nio_alloc(plen+1);
        let q:i32=0;
        while(q<wdir.len){pp[q]=wdir[q]; q=q+1;}
        pp[q]=47; q=q+1;
        let q2:i32=0;
        while(q2<cl){pp[q]=cids[co+q2]; q=q+1; q2=q2+1;}
        let q3:i32=0;
        while(q3<tail.len){pp[q]=tail[q3]; q=q+1; q3=q3+1;}
        let pb:[]u8=read_path2(pp[0..q],&ok);
        let npages:i32=0;
        let nsent:i32=0;
        if(ok==1){
            let rp:i32=0;
            while(rp<pb.len){
                let re:i32=rp;
                while(re<pb.len && pb[re]!=10){re=re+1;}
                if(re-rp>2 && pb[rp]==80 && pb[rp+1]==124){npages=npages+1;}
                if(re-rp>2 && pb[rp]==83 && pb[rp+1]==124 && nsent<600){
                    let s:[]u8=pb[rp+2..re];
                    let tc:i32=tok_count(s);
                    if(tc>=10 && tc<=45 && has_badchar(s)==0 && longwords(s)>=4){
                        mput32(srec,nsent*12,rp+2);
                        mput32(srec,nsent*12+4,re-rp-2);
                        mput32(srec,nsent*12+8,tc);
                        nsent=nsent+1;
                    }
                }
                rp=re+1;
            }
        }
        mput32(meta,j6*52+28,npages);
        // rank sentences: insertion sort by (toks DESC, bytes ASC)
        let a:i32=1;
        while(a<nsent){
            let bo:i32=mget32(srec,a*12);
            let bl:i32=mget32(srec,a*12+4);
            let bt:i32=mget32(srec,a*12+8);
            let b:i32=a-1;
            while(b>=0){
                let co2:i32=mget32(srec,b*12);
                let cl2:i32=mget32(srec,b*12+4);
                let ct:i32=mget32(srec,b*12+8);
                let swap:i32=0;
                if(ct<bt){swap=1;}
                if(ct==bt && cmp_bytes(pb[bo..bo+bl],pb[co2..co2+cl2])<0){swap=1;}
                if(swap==0){break;}
                mput32(srec,(b+1)*12,co2);
                mput32(srec,(b+1)*12+4,cl2);
                mput32(srec,(b+1)*12+8,ct);
                b=b-1;
            }
            mput32(srec,(b+1)*12,bo);
            mput32(srec,(b+1)*12+4,bl);
            mput32(srec,(b+1)*12+8,bt);
            a=a+1;
        }
        // take top 2 into dpool
        let take:i32=nsent;
        if(take>2){take=2;}
        let t:i32=0;
        while(t<take){
            let so:i32=mget32(srec,t*12);
            let sl:i32=mget32(srec,t*12+4);
            if(dpool_used+sl<262144){
                mput32(meta,j6*52+36+t*8,dpool_used);
                mput32(meta,j6*52+40+t*8,sl);
                let w:i32=0;
                while(w<sl){dpool[dpool_used+w]=pb[so+w]; w=w+1;}
                dpool_used=dpool_used+sl;
            }
            t=t+1;
        }
        j6=j6+1;
    }

    // ---- cluster priority sort: npages DESC, gap ASC, corder ASC ----
    // order[] holds cluster indices
    let order:[]u8=nio_alloc(NCAP*4);
    let o2:i32=0;
    while(o2<ncl){mput32(order,o2*4,o2); o2=o2+1;}
    let a2:i32=1;
    while(a2<ncl){
        let ci2:i32=mget32(order,a2*4);
        let b2:i32=a2-1;
        while(b2>=0){
            let cj:i32=mget32(order,b2*4);
            let swap2:i32=0;
            let ni:i32=mget32(meta,ci2*52+28);
            let nj:i32=mget32(meta,cj*52+28);
            if(ni>nj){swap2=1;}
            if(ni==nj){
                let gi:i32=mget32(meta,ci2*52+32);
                let gj:i32=mget32(meta,cj*52+32);
                if(gi<gj){swap2=1;}
                if(gi==gj && mget32(meta,ci2*52+8)<mget32(meta,cj*52+8)){swap2=1;}
            }
            if(swap2==0){break;}
            mput32(order,(b2+1)*4,cj);
            b2=b2-1;
        }
        mput32(order,(b2+1)*4,ci2);
        a2=a2+1;
    }

    // ---- emit ----
    // Q lines first (queued only), then SKIP lines in manifest order
    let rank:i32=1;
    let e5:i32=0;
    while(e5<ncl){
        let ci3:i32=mget32(order,e5*4);
        let ncorr:i32=mget32(meta,ci3*52+12);
        let integ:i32=mget32(meta,ci3*52+16);
        let inj:i32=mget32(meta,ci3*52+20);
        let npg:i32=mget32(meta,ci3*52+28);
        let d0l:i32=mget32(meta,ci3*52+40);
        let co3:i32=mget32(meta,ci3*52);
        let cl3:i32=mget32(meta,ci3*52+4);
        if(ncorr==1 && integ==0 && inj==0 && npg>0 && d0l>0){
            let t2:i32=0;
            while(t2<2){
                let dl:i32=mget32(meta,ci3*52+40+t2*8);
                if(dl>0){
                    let doff:i32=mget32(meta,ci3*52+36+t2*8);
                    _zag_print("Q|");
                    _zag_print(i64s(rank as i64));
                    _zag_print("|");
                    _zag_print(cids[co3..co3+cl3]);
                    _zag_print("|");
                    _zag_print(i64s(npg as i64));
                    _zag_print("|");
                    _zag_print(i64s(mget32(meta,ci3*52+32) as i64));
                    _zag_print("|");
                    _zag_print(dpool[doff..doff+dl]);
                    _zag_print("\n");
                }
                t2=t2+1;
            }
            rank=rank+1;
        }
        e5=e5+1;
    }
    // SKIP lines in manifest order
    let e6:i32=0;
    while(e6<ncl){
        let ci4:i32=mget32(order,e6*4);
        let ncorr2:i32=mget32(meta,ci4*52+12);
        let integ2:i32=mget32(meta,ci4*52+16);
        let inj2:i32=mget32(meta,ci4*52+20);
        let npg2:i32=mget32(meta,ci4*52+28);
        let d0l2:i32=mget32(meta,ci4*52+40);
        let co4:i32=mget32(meta,ci4*52);
        let cl4:i32=mget32(meta,ci4*52+4);
        let queued:i32=0;
        if(ncorr2==1 && integ2==0 && inj2==0 && npg2>0 && d0l2>0){queued=1;}
        if(queued==0){
            _zag_print("SKIP|");
            _zag_print(cids[co4..co4+cl4]);
            _zag_print("|");
            if(ncorr2==0){_zag_print("NOT_WITHHELD");}
            if(ncorr2==1 && integ2==1){_zag_print("INTEGRITY_VIOLATION");}
            if(ncorr2==1 && integ2==0 && inj2==1){_zag_print("INJECTION_FLAG");}
            if(ncorr2==1 && integ2==0 && inj2==0 && npg2==0){_zag_print("NO_INSTRUMENT_INPUT");}
            if(ncorr2==1 && integ2==0 && inj2==0 && npg2>0 && d0l2==0){_zag_print("NO_CLEAN_SENTENCE");}
            _zag_print("\n");
        }
        e6=e6+1;
    }
    return 0;
}

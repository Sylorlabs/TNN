// ================= V-QUOTA ADDON (additive only; strict path untouched) =================
// In-quota loosened corroboration: the frozen V-PARA conjunction
// (FROZEN_QUOTA_SPEC.md §4).
//   (P1) numeric-token multiset equality
//   (P2) content-token Jaccard >= 0.60 over the frozen stoplist
//   (P3) >=2 distinct hosts (BUGFIX-1 semantics)
//   (P4) G6 scan clean

fn q_has_digit(b:[]u8,s:i32,l:i32)i32 {
    let k:i32=0;
    while(k<l){
        let c:u8=b[s+k];
        if(c>=48 && c<=57){return 1;}
        k=k+1;
    }
    return 0;
}

fn q_numtoks(s:[]u8,tab:[]u8,cap:i32)i32 {
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(s,tt,256,2,&tn);
    let n:i32=0;
    let i:i32=0;
    while(i<tn && n<cap){
        let p:i32=g32(tt,i*8);
        let l:i32=g32(tt,i*8+4);
        if(q_has_digit(s,p,l)==1){
            p32(tab,n*8,p);
            p32(tab,n*8+4,l);
            n=n+1;
        }
        i=i+1;
    }
    nio_free(tt);
    return n;
}

fn q_tok_less(b:[]u8,ao:i32,al:i32,bo:i32,bl:i32)i32 {
    let m:i32=al;
    if(bl<m){m=bl;}
    let i:i32=0;
    while(i<m){
        let x:u8=b[ao+i];
        let y:u8=b[bo+i];
        if(x<y){return 1;}
        if(x>y){return 0;}
        i=i+1;
    }
    if(al<bl){return 1;}
    return 0;
}

fn q_toksort(b:[]u8,tab:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let ks:i32=g32(tab,i*8);
        let kl:i32=g32(tab,i*8+4);
        let j:i32=i-1;
        while(j>=0){
            let js:i32=g32(tab,j*8);
            let jl:i32=g32(tab,j*8+4);
            if(q_tok_less(b,ks,kl,js,jl)==1){
                p32(tab,(j+1)*8,js);
                p32(tab,(j+1)*8+4,jl);
                j=j-1;
            }else{
                break;
            }
        }
        p32(tab,(j+1)*8,ks);
        p32(tab,(j+1)*8+4,kl);
        i=i+1;
    }
    return;
}

// P1: exact multiset equality of digit-bearing tokens.
fn q_numeric_equal(a:[]u8,b:[]u8)i32 {
    let ta:[]u8=nio_alloc(64*8);
    let tb:[]u8=nio_alloc(64*8);
    let na:i32=q_numtoks(a,ta,64);
    let nb:i32=q_numtoks(b,tb,64);
    let eq:i32=0;
    if(na==nb){
        q_toksort(a,ta,na);
        q_toksort(b,tb,nb);
        eq=1;
        let i:i32=0;
        while(i<na){
            if(tok_eq(a,g32(ta,i*8),g32(ta,i*8+4),b,g32(tb,i*8),g32(tb,i*8+4))==0){
                eq=0;
                break;
            }
            i=i+1;
        }
    }
    nio_free(ta);
    nio_free(tb);
    return eq;
}

fn q_in_stop(sl:[]u8,st:[]u8,sn:i32,b:[]u8,s:i32,l:i32)i32 {
    let i:i32=0;
    while(i<sn){
        if(tok_eq(b,s,l,sl,g32(st,i*8),g32(st,i*8+4))==1){return 1;}
        i=i+1;
    }
    return 0;
}

// unique non-stop tokens of s into tab; returns count.
fn q_content_toks(s:[]u8,tab:[]u8,cap:i32,sl:[]u8,st:[]u8,sn:i32)i32 {
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(s,tt,256,2,&tn);
    let n:i32=0;
    let i:i32=0;
    while(i<tn){
        let p:i32=g32(tt,i*8);
        let l:i32=g32(tt,i*8+4);
        if(q_in_stop(sl,st,sn,s,p,l)==0){
            let dup:i32=0;
            let k:i32=0;
            while(k<n){
                if(tok_eq(s,p,l,s,g32(tab,k*8),g32(tab,k*8+4))==1){dup=1; break;}
                k=k+1;
            }
            if(dup==0 && n<cap){
                p32(tab,n*8,p);
                p32(tab,n*8+4,l);
                n=n+1;
            }
        }
        i=i+1;
    }
    nio_free(tt);
    return n;
}

// P2: Jaccard >= 0.60  <=>  5*|I| >= 3*|U|. Both empty => 0 (fail closed).
fn q_jaccard_ok(a:[]u8,b:[]u8,sl:[]u8,st:[]u8,sn:i32)i32 {
    let ta:[]u8=nio_alloc(256*8);
    let tb:[]u8=nio_alloc(256*8);
    let na:i32=q_content_toks(a,ta,256,sl,st,sn);
    let nb:i32=q_content_toks(b,tb,256,sl,st,sn);
    let ok:i32=0;
    if(na>0 || nb>0){
        let inter:i32=0;
        let i:i32=0;
        while(i<na){
            let k:i32=0;
            while(k<nb){
                if(tok_eq(a,g32(ta,i*8),g32(ta,i*8+4),b,g32(tb,k*8),g32(tb,k*8+4))==1){
                    inter=inter+1;
                    break;
                }
                k=k+1;
            }
            i=i+1;
        }
        let uni:i32=na+nb-inter;
        if(uni>0 && inter*5>=uni*3){ok=1;}
    }
    nio_free(ta);
    nio_free(tb);
    return ok;
}

fn q_para_match(a:[]u8,b:[]u8,sl:[]u8,st:[]u8,sn:i32)i32 {
    if(q_numeric_equal(a,b)==0){return 0;}
    if(q_jaccard_ok(a,b,sl,st,sn)==0){return 0;}
    return 1;
}

fn q_load_stoplist(path:[]u8,sl:[]u8,st:[]u8,cap:i32,sn:*i32)i32 {
    sn[0]=0;
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 0;}
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    let apos:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let a2:i32=ls;
        let b2:i32=ls+ll;
        while(a2<b2 && (buf[a2]==32 || buf[a2]==9 || buf[a2]==10 || buf[a2]==13)){a2=a2+1;}
        while(b2>a2 && (buf[b2-1]==32 || buf[b2-1]==9 || buf[b2-1]==10 || buf[b2-1]==13)){b2=b2-1;}
        if(b2>a2 && buf[a2]!=35){
            let wl:i32=b2-a2;
            if(sn[0]<cap && apos+wl<=sl.len){
                let k:i32=0;
                while(k<wl){
                    let ch:u8=buf[a2+k];
                    if(ch>=65 && ch<=90){ch=(ch as i32+32) as u8;}
                    sl[apos+k]=ch;
                    k=k+1;
                }
                p32(st,sn[0]*8,apos);
                p32(st,sn[0]*8+4,wl);
                apos=apos+wl;
                sn[0]=sn[0]+1;
            }
        }
    }
    nio_free(buf);
    return 1;
}

// distinct hosts per BUGFIX-1 semantics (empty host counts as its own source).
fn q_hosts_distinct(ha:[]u8,ht:[]u8,pga:i32,pgb:i32)i32 {
    let sa:i32=g32(ht,pga*8);
    let la:i32=g32(ht,pga*8+4);
    let sb:i32=g32(ht,pgb*8);
    let lb:i32=g32(ht,pgb*8+4);
    if(la>0 && la==lb && nio_equal(ha[sa..sa+la],ha[sb..sb+lb])==1){return 0;}
    return 1;
}

// V-QUOTA loosened corroboration over the strict inputs.
// Prints GATE|PARA| + ANSWER|/CLAIM|1|/PROV|1| on accept, ANSWER|UNCHECKABLE
// otherwise. Returns 1 on accept, 0 on withhold, 2 on protocol stop.
fn quota_core(buf:[]u8,np:i32,pa:[]u8,pt:[]u8,tt:[]u8,st:[]u8,nst:i32,
    ha:[]u8,ht:[]u8,query:[]u8,dt:[]u8,dn:i32,sl:[]u8,slt:[]u8,sln:i32)i32 {
    // --- G6 scan (same machinery as verdict_core) ---
    let incl:[]u8=nio_alloc(64*4);
    let ninc:i32=0;
    let nflag:i32=0;
    let scan:i32=nio_equal(dget(dt,dn,"SCAN-INJECTION"),"on");
    let iw:[]u8=dget(dt,dn,"INJECT-WORDS");
    let wa:[]u8=nio_alloc(2048);
    let wt:[]u8=nio_alloc(64*8);
    let wn:i32=0;
    let wapos:i32=0;
    if(scan==1 && iw.len>0){
        let i2:i32=0;
        let ws:i32=0;
        while(i2<=iw.len){
            if(i2==iw.len || iw[i2]==124){
                let a2:i32=ws;
                let b2:i32=i2;
                while(a2<b2 && (iw[a2]==32 || iw[a2]==9)){a2=a2+1;}
                while(b2>a2 && (iw[b2-1]==32 || iw[b2-1]==9)){b2=b2-1;}
                let wl:i32=b2-a2;
                if(wl>0 && wn<64 && wapos+wl<=wa.len){
                    let c2:i32=0;
                    while(c2<wl){
                        let ch:u8=iw[a2+c2];
                        if(ch>=65 && ch<=90){ch=(ch as i32+32) as u8;}
                        wa[wapos+c2]=ch;
                        c2=c2+1;
                    }
                    p32(wt,wn*8,wapos);
                    p32(wt,wn*8+4,wl);
                    wn=wn+1;
                    wapos=wapos+wl;
                }
                ws=i2+1;
            }
            i2=i2+1;
        }
    }
    let pg:i32=0;
    while(pg<np && ninc<64){
        let excl:i32=0;
        if(scan==1 && wn>0){
            let ft:[]u8=page_text_lower(buf,pg,tt,st,nst);
            let w:i32=0;
            while(w<wn){
                let ws2:i32=g32(wt,w*8);
                let wl2:i32=g32(wt,w*8+4);
                if(bsub(ft,wa[ws2..ws2+wl2])==1){
                    if(excl==0){
                        _zag_print("FLAG|INJECTION|");
                        _zag_println(pid_of(pa,pt,pg));
                        nflag=nflag+1;
                    }
                    excl=1;
                }
                w=w+1;
            }
            nio_free(ft);
        }
        if(excl==0){p32(incl,ninc*4,pg); ninc=ninc+1;}
        pg=pg+1;
    }
    nio_free(wa);
    nio_free(wt);
    if(nflag>0){
        _zag_println("QUOTA|INJECTED");
        _zag_println("ANSWER|UNCHECKABLE");
        nio_free(incl);
        return 0;
    }
    if(ninc<2){
        _zag_println("ANSWER|UNCHECKABLE");
        nio_free(incl);
        return 0;
    }
    // --- query tokenization (same as verdict_core) ---
    let qlow:[]u8=normalize(query);
    let qt:[]u8=nio_alloc(512*8);
    let qn:i32=0;
    tokenize(qlow,qt,512,2,&qn);
    // --- E3: the strict winner must exist (same cluster_best as strict) ---
    let widx:[]u8=nio_alloc(64*4);
    let wn2:i32=0;
    // NOTE: cluster_best returns a slice into its freed arena (frozen
    // behavior); only wn2/widx are read here, key is never touched.
    let key:[]u8=cluster_best(buf,incl,ninc,st,nst,qlow,qt,qn,widx,&wn2);
    if(key.len==0){}
    let minsrc:i32=dgeti(dt,dn,"MIN-SOURCES",1);
    if(minsrc<1){minsrc=1;}
    let strict_in:i32=0;
    if(wn2>=minsrc){
        if(nsrc_count(widx,wn2,ha,ht)>=minsrc){strict_in=1;}
    }
    nio_free(widx);
    if(strict_in==1){
        _zag_println("QUOTA|STRICT-WOULD-INSTALL");
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        return 2;
    }
    if(wn2==0){
        _zag_println("QUOTA|NO-CANDIDATE");
        _zag_println("ANSWER|UNCHECKABLE");
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        return 0;
    }
    // --- best sentence per included page (same selection as strict) ---
    let sa:[]u8=nio_alloc(65536);
    let sst:[]u8=nio_alloc(64*8);
    let spg:[]u8=nio_alloc(64*4);
    let ns:i32=0;
    let spos:i32=0;
    let ii:i32=0;
    while(ii<ninc){
        let pgi:i32=g32(incl,ii*4);
        let bs:[]u8=best_for_page(buf,pgi,st,nst,qlow,qt,qn);
        if(bs.len>0 && spos+bs.len<=sa.len && ns<64){
            let c3:i32=0;
            while(c3<bs.len){sa[spos+c3]=bs[c3]; c3=c3+1;}
            p32(sst,ns*8,spos);
            p32(sst,ns*8+4,bs.len);
            p32(spg,ns*4,pgi);
            ns=ns+1;
            spos=spos+bs.len;
        }
        if(bs.len>0){nio_free(bs);}
        ii=ii+1;
    }
    nio_free(qlow);
    nio_free(qt);
    nio_free(incl);
    // --- pair scan: i<j in page order, distinct hosts, frozen conjunction ---
    let wi:i32=-1;
    let wj:i32=-1;
    let x:i32=0;
    while(x<ns){
        let y:i32=x+1;
        while(y<ns){
            let pm:i32=0;
            if(q_hosts_distinct(ha,ht,g32(spg,x*4),g32(spg,y*4))==1){
                let ax:[]u8=sa[g32(sst,x*8)..g32(sst,x*8)+g32(sst,x*8+4)];
                let by:[]u8=sa[g32(sst,y*8)..g32(sst,y*8)+g32(sst,y*8+4)];
                pm=q_para_match(ax,by,sl,slt,sln);
            }
            if(pm==1){
                wi=x;
                wj=y;
                y=ns;
                x=ns;
            }
            y=y+1;
        }
        x=x+1;
    }
    let rc:i32=0;
    if(wi>=0){
        let wpi:i32=g32(spg,wi*4);
        let wpj:i32=g32(spg,wj*4);
        let wsn:[]u8=sa[g32(sst,wi*8)..g32(sst,wi*8)+g32(sst,wi*8+4)];
        _zag_print("GATE|PARA|");
        _zag_print(pid_of(pa,pt,wpi));
        _zag_print(",");
        _zag_println(pid_of(pa,pt,wpj));
        _zag_print("ANSWER|");
        _zag_println(wsn);
        _zag_print("CLAIM|1|");
        _zag_print(wsn);
        _zag_print("|");
        _zag_print(pid_of(pa,pt,wpi));
        _zag_print(",");
        _zag_println(pid_of(pa,pt,wpj));
        _zag_print("PROV|1|");
        _zag_println(pid_of(pa,pt,wpi));
        _zag_print("PROV|1|");
        _zag_println(pid_of(pa,pt,wpj));
        rc=1;
    }else{
        _zag_println("ANSWER|UNCHECKABLE");
    }
    nio_free(sa);
    nio_free(sst);
    nio_free(spg);
    return rc;
}

fn cmd_quota(sd:[]u8,nfp:[]u8,ppath:[]u8,query:[]u8,stoppath:[]u8)i32 {
    let dt:[]u8=nio_alloc(16384);
    let dp:i32=0;
    let dn:i32=0;
    load_installed(sd,dt,&dp,&dn);
    let ok:i32=0;
    let buf:[]u8=read_path(ppath,&ok);
    if(ok==0){nio_free(dt); return 2;}
    let nok:i32=0;
    let need:[]u8=read_path(nfp,&nok);
    if(nok==1){nio_free(need);}
    let pa:[]u8=nio_alloc(8192);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(2048*12);
    let ha:[]u8=nio_alloc(4096);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    let np:i32=0;
    let nst:i32=0;
    parse_pages(buf,&np,pa,&papos,pt,tt,st,&nst,64,2048,ha,&hapos,ht);
    let sla:[]u8=nio_alloc(8192);
    let slt:[]u8=nio_alloc(256*8);
    let sln:i32=0;
    if(q_load_stoplist(stoppath,sla,slt,256,&sln)==0){
        _zag_println("QUOTA|STOPLIST-FAIL");
        nio_free(sla);
        nio_free(slt);
        nio_free(buf);
        nio_free(pa);
        nio_free(pt);
        nio_free(tt);
        nio_free(st);
        nio_free(ha);
        nio_free(ht);
        nio_free(dt);
        return 2;
    }
    let rc:i32=quota_core(buf,np,pa,pt,tt,st,nst,ha,ht,query,dt,dn,sla,slt,sln);
    nio_free(sla);
    nio_free(slt);
    nio_free(buf);
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    nio_free(dt);
    if(rc==2){return 3;}
    return 0;
}

// ================= END V-QUOTA ADDON =================

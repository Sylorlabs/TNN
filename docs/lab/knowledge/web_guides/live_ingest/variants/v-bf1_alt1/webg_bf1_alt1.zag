@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// webg: instrument for the WEB-GUIDES trial.
// Generic machinery only: parse D|/I| lines, tokenize, overlap, cluster.
// No corpus content, no guide content, no stoplist words live in this file.

// i64 -> decimal string without the helper-newline quirk.
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}

fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn bstart(s:[]u8,p:[]u8)i32 {
    if(p.len>s.len){return 0;}
    let i:i32=0;
    while(i<p.len){
        if(s[i]!=p[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn bend(s:[]u8,p:[]u8)i32 {
    if(p.len>s.len){return 0;}
    let i:i32=0;
    while(i<p.len){
        if(s[s.len-p.len+i]!=p[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){
            if(h[i+j]!=n[j]){break;}
            j=j+1;
        }
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}

fn bsub_eq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}

// exact token equality across two buffers
fn tok_eq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    return bsub_eq(a,ao,b,bo,al);
}

// equal OR one is a prefix of the other
fn tok_match(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    let m:i32=al;
    if(bl<m){m=bl;}
    if(m==0){return 0;}
    return bsub_eq(a,ao,b,bo,m);
}

fn atoi(s:[]u8)i32 {
    let i:i32=0;
    let neg:i32=0;
    if(s.len>0 && s[0]==45){neg=1; i=1;}
    let v:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){break;}
        v=v*10+((c as i32)-48);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

fn lower_copy(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        b[i]=c;
        i=i+1;
    }
    return b[0..s.len];
}

// lowercase, collapse whitespace runs to one space, trim ends
fn normalize(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    let o:i32=0;
    let pend:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        if(c==32 || c==9 || c==10 || c==13){
            if(o>0){pend=1;}
        }else{
            if(pend==1){b[o]=32; o=o+1; pend=0;}
            b[o]=c;
            o=o+1;
        }
        i=i+1;
    }
    return b[0..o];
}

fn trim(s:[]u8)[]u8 {
    let a:i32=0;
    let b:i32=s.len;
    while(a<b){
        let c:u8=s[a];
        if(c==32 || c==9 || c==10 || c==13){a=a+1;}else{break;}
    }
    while(b>a){
        let c2:u8=s[b-1];
        if(c2==32 || c2==9 || c2==10 || c2==13){b=b-1;}else{break;}
    }
    return s[a..b];
}

// tokens: maximal [a-z0-9] runs of length >= minl; table of (start,len) u32 pairs
fn tokenize(s:[]u8,tt:[]u8,cap:i32,minl:i32,n:*i32)void {
    n[0]=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            let st:i32=i;
            while(i<s.len){
                let d:u8=s[i];
                if(!((d>=97 && d<=122) || (d>=48 && d<=57))){break;}
                i=i+1;
            }
            let ln:i32=i-st;
            if(ln>=minl && n[0]<cap){
                p32(tt,n[0]*8,st);
                p32(tt,n[0]*8+4,ln);
                n[0]=n[0]+1;
            }
        }else{
            i=i+1;
        }
    }
    return;
}

// overlap(a,b): number of tokens in a's list matched by some token in b's list
fn overlap(ab:[]u8,at:[]u8,an:i32,bb:[]u8,bt:[]u8,bn:i32)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<an){
        let ao:i32=g32(at,i*8);
        let al:i32=g32(at,i*8+4);
        let j:i32=0;
        let hit:i32=0;
        while(j<bn){
            if(tok_match(ab,ao,al,bb,g32(bt,j*8),g32(bt,j*8+4))==1){hit=1; break;}
            j=j+1;
        }
        if(hit==1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn first_int(s:[]u8)i64 {
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48 && c<=57){
            let v:i64=0;
            let d:i32=0;
            while(i<s.len){
                let e:u8=s[i];
                if(e<48 || e>57){break;}
                if(d<18){v=v*10+((e as i64)-48);}
                d=d+1;
                i=i+1;
            }
            return v;
        }
        i=i+1;
    }
    return -1;
}

// next line from buf; sets ls/ll (ll excludes the newline, may include CR -> caller strips)
fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

// ---------- directive table ----------
// arena layout per record: [klen u32][key bytes][vlen u32][val bytes]
fn dscan(dt:[]u8,dn:i32,key:[]u8,vr:*i32,vl:*i32)i32 {
    let p:i32=0;
    let i:i32=0;
    while(i<dn){
        let kl:i32=g32(dt,p);
        let hit:i32=0;
        if(kl==key.len){hit=bsub_eq(dt,p+4,key,0,kl);}
        let vs:i32=p+4+kl;
        let ln:i32=g32(dt,vs);
        if(hit==1){vr[0]=vs+4; vl[0]=ln; return 1;}
        p=vs+4+ln;
        i=i+1;
    }
    return 0;
}

fn dhas(dt:[]u8,dn:i32,key:[]u8)i32 {
    let vr:i32=0;
    let vl:i32=0;
    return dscan(dt,dn,key,&vr,&vl);
}

fn dset(dt:[]u8,dp:*i32,dn:*i32,key:[]u8,val:[]u8)i32 {
    if(dhas(dt,dn[0],key)==1){return 0;}
    let need:i32=8+key.len+val.len;
    if(dp[0]+need>dt.len){return 0;}
    if(dn[0]>=256){return 0;}
    p32(dt,dp[0],key.len);
    let i:i32=0;
    while(i<key.len){dt[dp[0]+4+i]=key[i]; i=i+1;}
    p32(dt,dp[0]+4+key.len,val.len);
    i=0;
    while(i<val.len){dt[dp[0]+8+key.len+i]=val[i]; i=i+1;}
    dp[0]=dp[0]+need;
    dn[0]=dn[0]+1;
    return 1;
}

fn dget(dt:[]u8,dn:i32,key:[]u8)[]u8 {
    let vr:i32=0;
    let vl:i32=0;
    if(dscan(dt,dn,key,&vr,&vl)==0){return "";}
    return dt[vr..vr+vl];
}

fn dgeti(dt:[]u8,dn:i32,key:[]u8,def:i32)i32 {
    let v:[]u8=dget(dt,dn,key);
    if(v.len==0){return def;}
    return atoi(v);
}

// ---------- file IO ----------
fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

// split path at last '/'; dir="." when no slash
fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

// unlinkat(dirfd, name, 0): remove an existing file before create-exclusive
// rewrite. Missing file is fine (rc ignored).
fn nio_unlink_child(root:i64,name:[]u8)void {
    if(root<0 || nio_name_valid(name)!=1){return;}
    let s:[]u8=nio_cstr(name);
    if(s.len==0){return;}
    _zag_raw_syscall(263,root,_zag_slice_ptr(s) as i64,0,0,0,0);
    nio_free(s);
    return;
}

fn write_file(dir:[]u8,name:[]u8,data:[]u8)i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return 0;}
    nio_unlink_child(root,name);
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return 0;}
    let n:i64=nio_write_all(fd,data);
    nio_close(fd);
    if(n<0){return 0;}
    return 1;
}

// ---------- directory listing via getdents64 ----------
// collects names starting with 'g' and ending with ".txt"
fn list_guides(dirpath:[]u8,nm:[]u8,nmpos:*i32,tab:[]u8,n:*i32,cap:i32)void {
    n[0]=0;
    let root:i64=nio_open_root(dirpath);
    if(root<0){return;}
    let buf:[]u8=nio_alloc(32768);
    if(buf.len==0){nio_close(root); return;}
    let more:i32=1;
    while(more==1){
        let nr:i64=_zag_raw_syscall(217,root,_zag_slice_ptr(buf) as i64,buf.len as i64,0,0,0);
        if(nr<=0){more=0;}else{
            let off:i64=0;
            while(off<nr){
                let o:i32=off as i32;
                let reclen:i32=(buf[o+16] as i32)+((buf[o+17] as i32)<<8);
                if(reclen<=0){break;}
                let nstart:i32=o+19;
                let nl:i32=0;
                while(nstart+nl<o+reclen && buf[nstart+nl]!=0){nl=nl+1;}
                if(nl>5 && buf[nstart]==103 && n[0]<cap){
                    let e1:i32=nstart+nl-4;
                    if(buf[e1]==46 && buf[e1+1]==116 && buf[e1+2]==120 && buf[e1+3]==116){
                        let at:i32=nmpos[0];
                        if(at+nl<=nm.len){
                            let i:i32=0;
                            while(i<nl){nm[at+i]=buf[nstart+i]; i=i+1;}
                            p32(tab,n[0]*8,at);
                            p32(tab,n[0]*8+4,nl);
                            n[0]=n[0]+1;
                            nmpos[0]=at+nl;
                        }
                    }
                }
                off=off+(reclen as i64);
            }
        }
    }
    nio_free(buf);
    nio_close(root);
    return;
}

fn name_less(nm:[]u8,ao:i32,al:i32,bo:i32,bl:i32)i32 {
    let m:i32=al;
    if(bl<m){m=bl;}
    let i:i32=0;
    while(i<m){
        let a:u8=nm[ao+i];
        let b:u8=nm[bo+i];
        if(a<b){return 1;}
        if(a>b){return 0;}
        i=i+1;
    }
    if(al<bl){return 1;}
    return 0;
}

fn sort_names(nm:[]u8,tab:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let ks:i32=g32(tab,i*8);
        let kl:i32=g32(tab,i*8+4);
        let j:i32=i-1;
        while(j>=0){
            let js:i32=g32(tab,j*8);
            let jl:i32=g32(tab,j*8+4);
            if(name_less(nm,js,jl,ks,kl)==1){break;}
            p32(tab,(j+1)*8,js);
            p32(tab,(j+1)*8+4,jl);
            j=j-1;
        }
        p32(tab,(j+1)*8,ks);
        p32(tab,(j+1)*8+4,kl);
        i=i+1;
    }
    return;
}

// ---------- query formulation ----------
// usekw=1: tokenize, drop stoplist/len<2, join; empty -> lowercase full need
fn kw_query(need:[]u8,usekw:i32,dropval:[]u8)[]u8 {
    let low:[]u8=lower_copy(need);
    if(usekw==0){return low;}
    let dlow:[]u8=lower_copy(dropval);
    let dtt:[]u8=nio_alloc(128*8);
    let dn:i32=0;
    tokenize(dlow,dtt,128,1,&dn);
    let tt:[]u8=nio_alloc(512*8);
    let tn:i32=0;
    tokenize(low,tt,512,2,&tn);
    let out:[]u8=nio_alloc(low.len+1);
    let o:i32=0;
    let i:i32=0;
    while(i<tn){
        let ts:i32=g32(tt,i*8);
        let tl:i32=g32(tt,i*8+4);
        let dropme:i32=0;
        let k:i32=0;
        while(k<dn){
            if(tok_eq(low,ts,tl,dlow,g32(dtt,k*8),g32(dtt,k*8+4))==1){dropme=1; break;}
            k=k+1;
        }
        if(dropme==0){
            if(o>0){out[o]=32; o=o+1;}
            let c:i32=0;
            while(c<tl){out[o+c]=low[ts+c]; c=c+1;}
            o=o+tl;
        }
        i=i+1;
    }
    nio_free(dlow);
    nio_free(dtt);
    nio_free(tt);
    if(o==0){return low;}
    nio_free(low);
    return out[0..o];
}

// ---------- installed state ----------
fn load_installed(sd:[]u8,dt:[]u8,dp:*i32,dn:*i32)void {
    dp[0]=0;
    dn[0]=0;
    let ok:i32=0;
    let buf:[]u8=read_file(sd,"installed.txt",&ok);
    if(ok==0){return;}
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        if(ln>2 && buf[ls]==73 && buf[ls+1]==124){
            let a:i32=ls+2;
            let b:i32=a;
            while(b<ls+ln && buf[b]!=124){b=b+1;}
            if(b<ls+ln){
                dset(dt,dp,dn,buf[a..b],buf[b+1..ls+ln]);
            }
        }
    }
    nio_free(buf);
    return;
}

// ---------- results file: R|pid|title|snippet ----------
// rtab: 6 u32 per result: pstart,plen,tstart,tlen,sstart,slen
fn parse_results(buf:[]u8,nr:*i32,rt:[]u8,maxr:i32)void {
    nr[0]=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        if(ln>2 && buf[ls]==82 && buf[ls+1]==124){
            let a:i32=ls+2;
            let b:i32=a;
            while(b<ls+ln && buf[b]!=124){b=b+1;}
            let c:i32=b;
            if(c<ls+ln){c=c+1;}
            let d:i32=c;
            while(d<ls+ln && buf[d]!=124){d=d+1;}
            let e:i32=d;
            if(e<ls+ln){e=e+1;}
            if(nr[0]<maxr){
                let o:i32=nr[0]*24;
                p32(rt,o,a); p32(rt,o+4,b-a);
                p32(rt,o+8,c); p32(rt,o+12,d-c);
                p32(rt,o+16,e); p32(rt,o+20,ls+ln-e);
                nr[0]=nr[0]+1;
            }
        }
    }
    return;
}

// ALT1: context-window hash (ALTERNATIVES.md V-ALT1).
// Supporters of the winning cluster are independent iff the SHA-256 of the
// text around the matched key sentence differs. Context bytes =
// prev ++ 0x1F ++ next, where prev/next are the key sentence's immediate
// neighbors in store order within the page, in stored (original-case) bytes.
// A missing neighbor is replaced by the key sentence itself, so edge
// sentences and single-sentence pages never falsely collapse. The key
// arrives as raw claim text from cluster_best, so it is normalized here;
// candidate sentences are normalized before comparison (symmetric
// normalized-vs-normalized match). Verbatim copies collapse to one vote.
fn ctx_neighbors(pg:i32,buf:[]u8,st:[]u8,nst:i32,key:[]u8,po:*i32,pl:*i32,qo:*i32,ql:*i32)void {
    po[0]=-1;
    pl[0]=0;
    qo[0]=-1;
    ql[0]=0;
    let nkey:[]u8=normalize(key);
    let ks:i32=-1;
    let ko:i32=0;
    let kl:i32=0;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){
            let so:i32=g32(st,s*12+4);
            let sl:i32=g32(st,s*12+8);
            let nrm:[]u8=normalize(buf[so..so+sl]);
            let hit:i32=0;
            if(nrm.len==nkey.len && nio_equal(nrm,nkey)==1){hit=1;}
            nio_free(nrm);
            if(hit==1){ks=s; ko=so; kl=sl; break;}
        }
        s=s+1;
    }
    nio_free(nkey);
    if(ks<0){return;}
    po[0]=ko;
    pl[0]=kl;
    qo[0]=ko;
    ql[0]=kl;
    if(ks>0 && g32(st,(ks-1)*12)==pg){
        po[0]=g32(st,(ks-1)*12+4);
        pl[0]=g32(st,(ks-1)*12+8);
    }
    if(ks+1<nst && g32(st,(ks+1)*12)==pg){
        qo[0]=g32(st,(ks+1)*12+4);
        ql[0]=g32(st,(ks+1)*12+8);
    }
    return;
}

fn ctx_hash_distinct(widx:[]u8,wn:i32,buf:[]u8,st:[]u8,nst:i32,key:[]u8)i32 {
    let dg:[]u8=nio_alloc(wn*32);
    if(dg.len!=wn*32){return wn;}
    let zi:i32=0;
    while(zi<wn*32){dg[zi]=0; zi=zi+1;}
    let i:i32=0;
    while(i<wn){
        let pg:i32=g32(widx,i*4);
        let po:i32=-1;
        let pl:i32=0;
        let qo:i32=-1;
        let ql:i32=0;
        ctx_neighbors(pg,buf,st,nst,key,&po,&pl,&qo,&ql);
        if(po>=0 && qo>=0){
            let tmp:[]u8=nio_alloc(pl+1+ql);
            if(tmp.len==pl+1+ql){
                let n1:i32=0;
                let c1:i32=0;
                while(c1<pl){tmp[n1]=buf[po+c1]; n1=n1+1; c1=c1+1;}
                tmp[n1]=31;
                n1=n1+1;
                let c3:i32=0;
                while(c3<ql){tmp[n1]=buf[qo+c3]; n1=n1+1; c3=c3+1;}
                let d:[]u8=nio_alloc(32);
                if(d.len==32){
                    if(ns_sha256(tmp,d)==0){
                        let c5:i32=0;
                        while(c5<32){dg[i*32+c5]=d[c5]; c5=c5+1;}
                    }
                }
                nio_free(d);
            }
            nio_free(tmp);
        }
        i=i+1;
    }
    let n2:i32=0;
    let x:i32=0;
    while(x<wn){
        let isnew:i32=1;
        let y:i32=0;
        while(y<x){
            if(nio_equal(dg[x*32..x*32+32],dg[y*32..y*32+32])==1){isnew=0; break;}
            y=y+1;
        }
        if(isnew==1){n2=n2+1;}
        x=x+1;
    }
    nio_free(dg);
    return n2;
}

// ---------- pages file: P|pid|title then S|sentence ----------
// pt: (pidstart,pidlen) into pa arena; tt: (tstart,tlen) into buf; st: (pageidx,sstart,slen)
// count distinct sources among winning page indices.
// pages with an empty host each count as their own source (legacy inputs
// carry no H| lines; this keeps pre-host behavior byte-identical).
fn nsrc_count(widx:[]u8,wn:i32,ha:[]u8,ht:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<wn){
        let pg:i32=g32(widx,i*4);
        let hs:i32=g32(ht,pg*8);
        let hl:i32=g32(ht,pg*8+4);
        let isnew:i32=1;
        if(hl>0){
            let j:i32=0;
            while(j<i){
                let pg2:i32=g32(widx,j*4);
                let hs2:i32=g32(ht,pg2*8);
                let hl2:i32=g32(ht,pg2*8+4);
                if(hl2==hl && nio_equal(ha[hs..hs+hl],ha[hs2..hs2+hl2])==1){isnew=0; break;}
                j=j+1;
            }
        }
        if(isnew==1){n=n+1;}
        i=i+1;
    }
    return n;
}

fn parse_pages(buf:[]u8,np:*i32,pa:[]u8,papos:*i32,pt:[]u8,tt:[]u8,st:[]u8,nst:*i32,maxp:i32,maxs:i32,ha:[]u8,hapos:*i32,ht:[]u8)void {
    np[0]=0;
    nst[0]=0;
    let hz:i32=0;
    while(hz<maxp){p32(ht,hz*8,0); p32(ht,hz*8+4,0); hz=hz+1;}
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        if(ln>2 && buf[ls]==80 && buf[ls+1]==124){
            if(np[0]>=maxp){continue;}
            let a:i32=ls+2;
            let b:i32=a;
            while(b<ls+ln && buf[b]!=124){b=b+1;}
            let c:i32=b;
            if(c<ls+ln){c=c+1;}
            let pl:i32=b-a;
            if(papos[0]+pl<=pa.len){
                let ps:i32=papos[0];
                let k:i32=0;
                while(k<pl){pa[ps+k]=buf[a+k]; k=k+1;}
                papos[0]=ps+pl;
                p32(pt,np[0]*8,ps);
                p32(pt,np[0]*8+4,pl);
                p32(tt,np[0]*8,c);
                p32(tt,np[0]*8+4,ls+ln-c);
                np[0]=np[0]+1;
            }
        }else{
            if(ln>2 && buf[ls]==72 && buf[ls+1]==124){
                // H|host : source host for the most recent P| page (optional;
                // absent => empty host, which counts as its own source).
                if(np[0]>0){
                    let ha2:i32=ls+2;
                    let hb2:i32=ls+ln;
                    while(ha2<hb2 && (buf[ha2]==32 || buf[ha2]==9)){ha2=ha2+1;}
                    while(hb2>ha2 && (buf[hb2-1]==32 || buf[hb2-1]==9)){hb2=hb2-1;}
                    let hl3:i32=hb2-ha2;
                    if(hl3>0 && hapos[0]+hl3<=ha.len){
                        let ps3:i32=hapos[0];
                        let k3:i32=0;
                        while(k3<hl3){
                            let ch3:u8=buf[ha2+k3];
                            if(ch3>=65 && ch3<=90){ch3=(ch3 as i32+32) as u8;}
                            ha[ps3+k3]=ch3;
                            k3=k3+1;
                        }
                        hapos[0]=ps3+hl3;
                        p32(ht,(np[0]-1)*8,ps3);
                        p32(ht,(np[0]-1)*8+4,hl3);
                    }
                }
            }else{
            if(ln>2 && buf[ls]==83 && buf[ls+1]==124){
                if(np[0]==0 && np[0]<maxp){
                    // implicit page for bare S| lines (e.g. CPAGE: section)
                    p32(pt,0,0);
                    p32(pt,4,0);
                    p32(tt,0,0);
                    p32(tt,4,0);
                    np[0]=1;
                }
                if(np[0]>0 && nst[0]<maxs){
                    let o:i32=nst[0]*12;
                    p32(st,o,np[0]-1);
                    p32(st,o+4,ls+2);
                    p32(st,o+8,ln-2);
                    nst[0]=nst[0]+1;
                }
            }
            }
        }
    }
    return;
}

fn pid_of(pa:[]u8,pt:[]u8,i:i32)[]u8 {
    let s:i32=g32(pt,i*8);
    let l:i32=g32(pt,i*8+4);
    return pa[s..s+l];
}

fn page_nsent(st:[]u8,nst:i32,pg:i32)i32 {
    let c:i32=0;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){c=c+1;}
        s=s+1;
    }
    return c;
}

// ---------- selection ----------
// sel: u32 array of selected result indices; scanned counts examined results
fn select_core(nr:i32,rt:[]u8,buf:[]u8,n:i32,dedup:i32,sel:[]u8,nsel:*i32,scanned:*i32)void {
    nsel[0]=0;
    scanned[0]=0;
    let ptit:[]u8=nio_alloc(8192);
    let ptt:[]u8=nio_alloc(64*8);
    let ptpos:i32=0;
    let npt:i32=0;
    let i:i32=0;
    while(i<nr){
        scanned[0]=scanned[0]+1;
        if(nsel[0]>=n){break;}
        let take:i32=1;
        if(dedup==1){
            let ts:i32=g32(rt,i*24+8);
            let tl:i32=g32(rt,i*24+12);
            let nt:[]u8=normalize(buf[ts..ts+tl]);
            let k:i32=0;
            while(k<npt){
                if(nio_equal(nt,ptit[g32(ptt,k*8)..g32(ptt,k*8)+g32(ptt,k*8+4)])==1){take=0; break;}
                k=k+1;
            }
            if(take==1 && nt.len>0 && ptpos+nt.len<=ptit.len && npt<64){
                let c:i32=0;
                while(c<nt.len){ptit[ptpos+c]=nt[c]; c=c+1;}
                p32(ptt,npt*8,ptpos);
                p32(ptt,npt*8+4,nt.len);
                npt=npt+1;
                ptpos=ptpos+nt.len;
            }
            nio_free(nt);
        }
        if(take==1){
            p32(sel,nsel[0]*4,i);
            nsel[0]=nsel[0]+1;
        }
        i=i+1;
    }
    nio_free(ptit);
    nio_free(ptt);
    return;
}

// best (normalized) sentence of one page by query overlap; "" if none
fn best_for_page(buf:[]u8,pg:i32,st:[]u8,nst:i32,qb:[]u8,qt:[]u8,qn:i32)[]u8 {
    let best:[]u8="";
    let bs:i32=-1;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){
            let a:i32=g32(st,s*12+4);
            let e2:i32=a+g32(st,s*12+8);
            let nrm:[]u8=normalize(buf[a..e2]);
            let tt:[]u8=nio_alloc(256*8);
            let tn:i32=0;
            tokenize(nrm,tt,256,2,&tn);
            let sc:i32=overlap(qb,qt,qn,nrm,tt,tn);
            nio_free(tt);
            if(sc>bs){bs=sc; best=nrm;}else{nio_free(nrm);}
        }
        s=s+1;
    }
    return best;
}

// best (normalized) sentence across included pages; o_pg = page index or -1
fn best_across(buf:[]u8,incl:[]u8,ninc:i32,st:[]u8,nst:i32,eb:[]u8,et:[]u8,en:i32,o_pg:*i32)[]u8 {
    o_pg[0]=-1;
    let best:[]u8="";
    let bs:i32=-1;
    let ii:i32=0;
    while(ii<ninc){
        let pg:i32=g32(incl,ii*4);
        let s:i32=0;
        while(s<nst){
            if(g32(st,s*12)==pg){
                let a:i32=g32(st,s*12+4);
                let e2:i32=a+g32(st,s*12+8);
                let nrm:[]u8=normalize(buf[a..e2]);
                let tt:[]u8=nio_alloc(256*8);
                let tn:i32=0;
                tokenize(nrm,tt,256,2,&tn);
                let sc:i32=overlap(eb,et,en,nrm,tt,tn);
                nio_free(tt);
                if(sc>bs){bs=sc; best=nrm; o_pg[0]=pg;}else{nio_free(nrm);}
            }
            s=s+1;
        }
        ii=ii+1;
    }
    return best;
}

// lowercased full text of a page: title + sentences
fn page_text_lower(buf:[]u8,pg:i32,tt:[]u8,st:[]u8,nst:i32)[]u8 {
    let ta:i32=g32(tt,pg*8);
    let tl:i32=g32(tt,pg*8+4);
    let sz:i32=tl+2;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){sz=sz+g32(st,s*12+8)+1;}
        s=s+1;
    }
    let out:[]u8=nio_alloc(sz+1);
    let o:i32=0;
    let i:i32=0;
    while(i<tl){
        let c:u8=buf[ta+i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        out[o]=c;
        o=o+1;
        i=i+1;
    }
    s=0;
    while(s<nst){
        if(g32(st,s*12)==pg){
            out[o]=32;
            o=o+1;
            let a:i32=g32(st,s*12+4);
            let l:i32=g32(st,s*12+8);
            i=0;
            while(i<l){
                let c2:u8=buf[a+i];
                if(c2>=65 && c2<=90){c2=(c2 as i32+32) as u8;}
                out[o]=c2;
                o=o+1;
                i=i+1;
            }
        }
        s=s+1;
    }
    return out[0..o];
}

// ---------- verdict core ----------
fn print_pids_csv(pa:[]u8,pt:[]u8,idx:[]u8,n:i32)void {
    let m:i32=0;
    while(m<n){
        if(m>0){_zag_print(",");}
        _zag_print(pid_of(pa,pt,g32(idx,m*4)));
        m=m+1;
    }
    return;
}

// MULTIHOP per-entity winner.
// For each included page: gate sentences to overlap(entity)>=1; among gated,
// best = max overlap(need_kw, sentence), tie -> first. Record (sentence,pid,score).
// Cluster by normalized equality; winning cluster = highest member score,
// then largest, then earliest-listed page. o_idx = winner page indices;
// returns winning sentence ("" if none).
fn mh_entity(buf:[]u8,incl:[]u8,ninc:i32,st:[]u8,nst:i32,
    eb:[]u8,et:[]u8,en:i32,kb:[]u8,kt:[]u8,kn:i32,
    o_idx:[]u8,o_n:*i32)[]u8 {
    o_n[0]=0;
    let ca:[]u8=nio_alloc(65536);
    let ct:[]u8=nio_alloc(64*8);
    let cp:[]u8=nio_alloc(64*4);
    let cs:[]u8=nio_alloc(64*4);
    let nc:i32=0;
    let capos:i32=0;
    let ii:i32=0;
    while(ii<ninc){
        let pg:i32=g32(incl,ii*4);
        let best:[]u8="";
        let bestscore:i32=-1;
        let s:i32=0;
        while(s<nst){
            if(g32(st,s*12)==pg){
                let a:i32=g32(st,s*12+4);
                let e2:i32=a+g32(st,s*12+8);
                let nrm:[]u8=normalize(buf[a..e2]);
                let tt:[]u8=nio_alloc(256*8);
                let tn:i32=0;
                tokenize(nrm,tt,256,2,&tn);
                let eg:i32=overlap(eb,et,en,nrm,tt,tn);
                if(eg>=1){
                    let sc:i32=overlap(kb,kt,kn,nrm,tt,tn);
                    if(sc>bestscore){bestscore=sc; best=nrm;}else{nio_free(nrm);}
                }else{
                    nio_free(nrm);
                }
                nio_free(tt);
            }
            s=s+1;
        }
        if(bestscore>=0 && nc<64 && capos+best.len<=ca.len){
            let c2:i32=0;
            while(c2<best.len){ca[capos+c2]=best[c2]; c2=c2+1;}
            p32(ct,nc*8,capos);
            p32(ct,nc*8+4,best.len);
            p32(cp,nc*4,pg);
            p32(cs,nc*4,bestscore);
            nc=nc+1;
            capos=capos+best.len;
        }
        nio_free(best);
        ii=ii+1;
    }
    if(nc==0){
        nio_free(ca);
        nio_free(ct);
        nio_free(cp);
        nio_free(cs);
        return "";
    }
    let ck:[]u8=nio_alloc(64*8);
    let cc:[]u8=nio_alloc(64*4);
    let cf:[]u8=nio_alloc(64*4);
    let cm:[]u8=nio_alloc(64*64*4);
    let csc:[]u8=nio_alloc(64*4);
    let ncl:i32=0;
    let j:i32=0;
    while(j<nc){
        let s2:i32=g32(ct,j*8);
        let l2:i32=g32(ct,j*8+4);
        let pg2:i32=g32(cp,j*4);
        let sc2:i32=g32(cs,j*4);
        let c:i32=0;
        let found:i32=-1;
        while(c<ncl){
            let ks:i32=g32(ck,c*8);
            let kl:i32=g32(ck,c*8+4);
            if(kl==l2 && bsub_eq(ca,ks,ca,s2,kl)==1){found=c; break;}
            c=c+1;
        }
        if(found==-1){
            if(ncl<64){
                p32(ck,ncl*8,s2);
                p32(ck,ncl*8+4,l2);
                p32(cc,ncl*4,1);
                p32(cf,ncl*4,j);
                p32(cm,ncl*256,pg2);
                p32(csc,ncl*4,sc2);
                ncl=ncl+1;
            }
        }else{
            let cnt:i32=g32(cc,found*4);
            if(cnt<64){
                p32(cm,found*256+cnt*4,pg2);
                p32(cc,found*4,cnt+1);
            }
            if(sc2>g32(csc,found*4)){p32(csc,found*4,sc2);}
        }
        j=j+1;
    }
    let w:i32=-1;
    let wsc:i32=-1;
    let wc:i32=-1;
    let wf:i32=999999;
    let c3:i32=0;
    while(c3<ncl){
        let ssc:i32=g32(csc,c3*4);
        let cnt2:i32=g32(cc,c3*4);
        let fo:i32=g32(cf,c3*4);
        if(ssc>wsc || (ssc==wsc && cnt2>wc) || (ssc==wsc && cnt2==wc && fo<wf)){
            w=c3;
            wsc=ssc;
            wc=cnt2;
            wf=fo;
        }
        c3=c3+1;
    }
    let ans:[]u8="";
    if(w>=0){
        let m:i32=0;
        while(m<wc){
            p32(o_idx,m*4,g32(cm,w*256+m*4));
            m=m+1;
        }
        o_n[0]=wc;
        let ks2:i32=g32(ck,w*8);
        let kl2:i32=g32(ck,w*8+4);
        ans=ca[ks2..ks2+kl2];
    }
    nio_free(ct);
    nio_free(cp);
    nio_free(cs);
    nio_free(ck);
    nio_free(cc);
    nio_free(cf);
    nio_free(cm);
    nio_free(csc);
    return ans;
}

// candidates = per included page best sentence (by qb tokens); cluster by
// normalized equality; winner = largest cluster, tie -> earliest-listed page.
// o_idx = winner page indices; returns winner sentence ("" if none).
fn cluster_best(buf:[]u8,incl:[]u8,ninc:i32,st:[]u8,nst:i32,
    qb:[]u8,qt:[]u8,qn:i32,o_idx:[]u8,o_n:*i32)[]u8 {
    o_n[0]=0;
    let ca:[]u8=nio_alloc(65536);
    let ct:[]u8=nio_alloc(64*8);
    let cp:[]u8=nio_alloc(64*4);
    let nc:i32=0;
    let capos:i32=0;
    let ii:i32=0;
    while(ii<ninc){
        let pg:i32=g32(incl,ii*4);
        if(page_nsent(st,nst,pg)>0 && nc<64){
            let bs:[]u8=best_for_page(buf,pg,st,nst,qb,qt,qn);
            if(capos+bs.len<=ca.len){
                let c2:i32=0;
                while(c2<bs.len){ca[capos+c2]=bs[c2]; c2=c2+1;}
                p32(ct,nc*8,capos);
                p32(ct,nc*8+4,bs.len);
                p32(cp,nc*4,pg);
                nc=nc+1;
                capos=capos+bs.len;
            }
            nio_free(bs);
        }
        ii=ii+1;
    }
    if(nc==0){
        nio_free(ca);
        nio_free(ct);
        nio_free(cp);
        return "";
    }
    let ck:[]u8=nio_alloc(64*8);
    let cc:[]u8=nio_alloc(64*4);
    let cf:[]u8=nio_alloc(64*4);
    let cm:[]u8=nio_alloc(64*64*4);
    let ncl:i32=0;
    let j:i32=0;
    while(j<nc){
        let s2:i32=g32(ct,j*8);
        let l2:i32=g32(ct,j*8+4);
        let pg2:i32=g32(cp,j*4);
        let c:i32=0;
        let found:i32=-1;
        while(c<ncl){
            let ks:i32=g32(ck,c*8);
            let kl:i32=g32(ck,c*8+4);
            if(kl==l2 && bsub_eq(ca,ks,ca,s2,kl)==1){found=c; break;}
            c=c+1;
        }
        if(found==-1){
            if(ncl<64){
                p32(ck,ncl*8,s2);
                p32(ck,ncl*8+4,l2);
                p32(cc,ncl*4,1);
                p32(cf,ncl*4,j);
                p32(cm,ncl*256,pg2);
                ncl=ncl+1;
            }
        }else{
            let cnt:i32=g32(cc,found*4);
            if(cnt<64){
                p32(cm,found*256+cnt*4,pg2);
                p32(cc,found*4,cnt+1);
            }
        }
        j=j+1;
    }
    let w:i32=-1;
    let wc:i32=-1;
    let wf:i32=999999;
    let c3:i32=0;
    while(c3<ncl){
        let cnt2:i32=g32(cc,c3*4);
        let fo:i32=g32(cf,c3*4);
        if(cnt2>wc || (cnt2==wc && fo<wf)){w=c3; wc=cnt2; wf=fo;}
        c3=c3+1;
    }
    let ans:[]u8="";
    if(w>=0){
        let m:i32=0;
        while(m<wc){
            p32(o_idx,m*4,g32(cm,w*256+m*4));
            m=m+1;
        }
        o_n[0]=wc;
        let ks2:i32=g32(ck,w*8);
        let kl2:i32=g32(ck,w*8+4);
        ans=ca[ks2..ks2+kl2];
    }
    nio_free(ct);
    nio_free(cp);
    nio_free(ck);
    nio_free(cc);
    nio_free(cf);
    nio_free(cm);
    return ans;
}

fn verdict_core(buf:[]u8,np:i32,pa:[]u8,pt:[]u8,tt:[]u8,st:[]u8,nst:i32,ha:[]u8,ht:[]u8,
    query:[]u8,kind:[]u8,extra:[]u8,needkw:[]u8,
    dt:[]u8,dn:i32,force_blind:i32,loud:i32,
    o_ans:[]u8,o_ansn:*i32,o_widx:[]u8,o_wn:*i32,
    o_provs:*i32,o_claims:*i32,o_fl:[]u8,o_fln:*i32)i32 {
    o_ansn[0]=0;
    o_wn[0]=0;
    o_provs[0]=0;
    o_claims[0]=0;
    o_fln[0]=0;
    let blind:i32=0;
    if(dn==0 || force_blind==1){blind=1;}
    let qlow:[]u8=normalize(query);
    let qt:[]u8=nio_alloc(512*8);
    let qn:i32=0;
    tokenize(qlow,qt,512,2,&qn);
    let incl:[]u8=nio_alloc(64*4);
    let ninc:i32=0;
    if(blind==1){
        let bi:i32=0;
        while(bi<np && bi<64){p32(incl,bi*4,bi); bi=bi+1;}
        ninc=bi;
    }else{
        let scan:i32=nio_equal(dget(dt,dn,"SCAN-INJECTION"),"on");
        let iw:[]u8=dget(dt,dn,"INJECT-WORDS");
        let wa:[]u8=nio_alloc(2048);
        let wt:[]u8=nio_alloc(64*8);
        let ot:[]u8=nio_alloc(64*8);
        let wn:i32=0;
        let wapos:i32=0;
        if(scan==1 && iw.len>0){
            let i2:i32=0;
            let ws:i32=0;
            while(i2<=iw.len){
                if(i2==iw.len || iw[i2]==124){
                    let a2:i32=ws;
                    let b2:i32=i2;
                    while(a2<b2 && (iw[a2]==32 || iw[a2]==9)){a2=a2+1;}
                    while(b2>a2 && (iw[b2-1]==32 || iw[b2-1]==9)){b2=b2-1;}
                    let wl:i32=b2-a2;
                    if(wl>0 && wn<64 && wapos+wl<=wa.len){
                        let c2:i32=0;
                        while(c2<wl){
                            let ch:u8=iw[a2+c2];
                            if(ch>=65 && ch<=90){ch=(ch as i32+32) as u8;}
                            wa[wapos+c2]=ch;
                            c2=c2+1;
                        }
                        p32(wt,wn*8,wapos);
                        p32(wt,wn*8+4,wl);
                        p32(ot,wn*8,a2);
                        p32(ot,wn*8+4,wl);
                        wn=wn+1;
                        wapos=wapos+wl;
                    }
                    ws=i2+1;
                }
                i2=i2+1;
            }
        }
        let pg:i32=0;
        while(pg<np && ninc<64){
            let excl:i32=0;
            if(scan==1 && wn>0){
                let ft:[]u8=page_text_lower(buf,pg,tt,st,nst);
                let w:i32=0;
                while(w<wn){
                    let ws2:i32=g32(wt,w*8);
                    let wl2:i32=g32(wt,w*8+4);
                    if(bsub(ft,wa[ws2..ws2+wl2])==1){
                        if(excl==0){
                            if(o_fln[0]<64){
                                p32(o_fl,o_fln[0]*4,pg);
                                o_fln[0]=o_fln[0]+1;
                            }
                            if(loud==1){
                                _zag_print("FLAG|INJECTION|");
                                _zag_println(pid_of(pa,pt,pg));
                            }
                        }
                        excl=1;
                    }
                    w=w+1;
                }
                nio_free(ft);
            }
            if(excl==0){p32(incl,ninc*4,pg); ninc=ninc+1;}
            pg=pg+1;
        }
        nio_free(wa);
        nio_free(wt);
        nio_free(ot);
    }
    // MULTIHOP: per-entity best-sentence clustering with need-keyword relevance.
    if(nio_equal(kind,"MULTIHOP")==1 && blind==0){
        let e1:[]u8="";
        let e2:[]u8="";
        let k:i32=0;
        while(k<extra.len && extra[k]!=59){k=k+1;}
        if(k<extra.len){
            e1=lower_copy(trim(extra[0..k]));
            e2=lower_copy(trim(extra[k+1..extra.len]));
        }
        let e1b:[]u8="";
        let e1t:[]u8="";
        let e2b:[]u8="";
        let e2t:[]u8="";
        let kb:[]u8="";
        let kt:[]u8="";
        let w1idx:[]u8="";
        let w2idx:[]u8="";
        let w1n:i32=0;
        let w2n:i32=0;
        let rc:i32=0;
        if(e1.len>0 && e2.len>0){
            e1b=normalize(e1);
            e1t=nio_alloc(256*8);
            let e1n:i32=0;
            tokenize(e1b,e1t,256,2,&e1n);
            e2b=normalize(e2);
            e2t=nio_alloc(256*8);
            let e2n:i32=0;
            tokenize(e2b,e2t,256,2,&e2n);
            kb=normalize(needkw);
            kt=nio_alloc(512*8);
            let kn:i32=0;
            tokenize(kb,kt,512,2,&kn);
            w1idx=nio_alloc(64*4);
            let s1:[]u8=mh_entity(buf,incl,ninc,st,nst,e1b,e1t,e1n,kb,kt,kn,w1idx,&w1n);
            w2idx=nio_alloc(64*4);
            let s2:[]u8=mh_entity(buf,incl,ninc,st,nst,e2b,e2t,e2n,kb,kt,kn,w2idx,&w2n);
            let n1:i32=-1;
            let n2:i32=-1;
            if(s1.len>0){n1=first_int(s1);}
            if(s2.len>0){n2=first_int(s2);}
            if(n1>=0 && n2>=0 && n1!=n2){
                let win:[]u8=e1;
                if(n2>n1){win=e2;}
                if(loud==1){
                    _zag_print("ANSWER|");
                    _zag_println(win);
                    _zag_print("CLAIM|1|");
                    _zag_print(s1);
                    _zag_print("|");
                    print_pids_csv(pa,pt,w1idx,w1n);
                    _zag_print("\n");
                    _zag_print("CLAIM|2|");
                    _zag_print(s2);
                    _zag_print("|");
                    print_pids_csv(pa,pt,w2idx,w2n);
                    _zag_print("\n");
                    let m:i32=0;
                    while(m<w1n){
                        _zag_print("PROV|1|");
                        _zag_println(pid_of(pa,pt,g32(w1idx,m*4)));
                        m=m+1;
                    }
                    m=0;
                    while(m<w2n){
                        _zag_print("PROV|2|");
                        _zag_println(pid_of(pa,pt,g32(w2idx,m*4)));
                        m=m+1;
                    }
                }
                let c5:i32=0;
                while(c5<win.len && c5<o_ans.len){o_ans[c5]=win[c5]; c5=c5+1;}
                o_ansn[0]=c5;
                o_provs[0]=w1n+w2n;
                o_claims[0]=2;
                rc=1;
            }else{
                if(loud==1){_zag_println("ANSWER|UNCHECKABLE");}
                rc=0;
            }
        }else{
            if(loud==1){_zag_println("ANSWER|UNCHECKABLE");}
            rc=0;
        }
        nio_free(e1);
        nio_free(e2);
        nio_free(e1b);
        nio_free(e1t);
        nio_free(e2b);
        nio_free(e2t);
        nio_free(kb);
        nio_free(kt);
        nio_free(w1idx);
        nio_free(w2idx);
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        return rc;
    }

    // non-multihop
    if(blind==1){
        if(np==0){
            if(loud==1){_zag_println("ANSWER|UNCHECKABLE");}
            nio_free(qlow);
            nio_free(qt);
            nio_free(incl);
            return 0;
        }
        let bs:[]u8=best_for_page(buf,0,st,nst,qlow,qt,qn);
        if(loud==1){
            _zag_print("ANSWER|");
            _zag_println(bs);
            _zag_print("CLAIM|1|");
            _zag_print(bs);
            _zag_print("|");
            _zag_println(pid_of(pa,pt,0));
            _zag_print("PROV|1|");
            _zag_println(pid_of(pa,pt,0));
        }
        let c4:i32=0;
        while(c4<bs.len && c4<o_ans.len){o_ans[c4]=bs[c4]; c4=c4+1;}
        o_ansn[0]=c4;
        p32(o_widx,0,0);
        o_wn[0]=1;
        o_provs[0]=1;
        o_claims[0]=1;
        nio_free(bs);
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        return 1;
    }
    let widx:[]u8=nio_alloc(64*4);
    let wn2:i32=0;
    let key:[]u8=cluster_best(buf,incl,ninc,st,nst,qlow,qt,qn,widx,&wn2);
    if(wn2==0){
        if(loud==1){_zag_println("ANSWER|UNCHECKABLE");}
        nio_free(widx);
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        return 0;
    }
    if(nio_equal(kind,"CONTRA")==1 && loud==1){
        let j3:i32=0;
        while(j3<ninc){
            let pg3:i32=g32(incl,j3*4);
            let inwin:i32=0;
            let m4:i32=0;
            while(m4<wn2){
                if(g32(widx,m4*4)==pg3){inwin=1; break;}
                m4=m4+1;
            }
            if(inwin==0){
                _zag_print("FLAG|DISPUTE|");
                _zag_println(pid_of(pa,pt,pg3));
            }
            j3=j3+1;
        }
    }
    let minsrc:i32=dgeti(dt,dn,"MIN-SOURCES",1);
    if(minsrc<1){minsrc=1;}
    // source-independence: the winning cluster must span >=MIN-SOURCES
    // distinct hosts (frozen rule: ">=2 INDEPENDENT pages"). Pages with no
    // H| host each count as their own source, so legacy inputs behave
    // exactly as before.
    // LAYERED BF1+ALT1: the winning cluster must span >=MIN-SOURCES
    // distinct hosts (frozen rule: ">=2 INDEPENDENT pages"; pages with
    // no H| host each count as their own source) AND >=MIN-SOURCES
    // distinct context hashes (ALT1). Either gate firing -> UNCHECKABLE.
    let nsrc:i32=0;
    let nctxd:i32=0;
    if(wn2>=minsrc){nsrc=nsrc_count(widx,wn2,ha,ht); nctxd=ctx_hash_distinct(widx,wn2,buf,st,nst,key);}
    let rc2:i32=0;
    if(nsrc>=minsrc && nctxd>=minsrc){
        if(loud==1){
            _zag_print("ANSWER|");
            _zag_println(key);
            _zag_print("CLAIM|1|");
            _zag_print(key);
            _zag_print("|");
            print_pids_csv(pa,pt,widx,wn2);
            _zag_println("");
            let m5:i32=0;
            while(m5<wn2){
                _zag_print("PROV|1|");
                _zag_println(pid_of(pa,pt,g32(widx,m5*4)));
                m5=m5+1;
            }
        }
        let c6:i32=0;
        while(c6<key.len && c6<o_ans.len){o_ans[c6]=key[c6]; c6=c6+1;}
        o_ansn[0]=c6;
        let m6:i32=0;
        while(m6<wn2){p32(o_widx,m6*4,g32(widx,m6*4)); m6=m6+1;}
        o_wn[0]=wn2;
        o_provs[0]=wn2;
        o_claims[0]=1;
        rc2=1;
    }else{
        if(loud==1){
            _zag_println("ANSWER|UNCHECKABLE");
            if(wn2>=minsrc){
                if(nsrc<minsrc){
                    _zag_print("GATE|SRC_INDEPENDENCE|");
                    print_pids_csv(pa,pt,widx,wn2);
                    _zag_println("");
                }
                if(nctxd<minsrc){
                    _zag_print("GATE|SRC_CTXDUP|");
                    print_pids_csv(pa,pt,widx,wn2);
                    _zag_println("");
                }
            }
            let j4:i32=0;
            while(j4<ninc){
                let pg4:i32=g32(incl,j4*4);
                if(page_nsent(st,nst,pg4)>0){
                    _zag_print("UNCHECKED|");
                    _zag_println(pid_of(pa,pt,pg4));
                    break;
                }
                j4=j4+1;
            }
        }
        rc2=0;
    }
    nio_free(widx);
    nio_free(qlow);
    nio_free(qt);
    nio_free(incl);
    return rc2;
}

// ---------- calibration ----------
fn split_pids(val:[]u8,arena:[]u8,apos:*i32,tab:[]u8,n:*i32,cap:i32)void {
    let i:i32=0;
    let ws:i32=-1;
    while(i<=val.len){
        let dl:i32=0;
        if(i==val.len){dl=1;}else{
            let c:u8=val[i];
            if(c==44 || c==32 || c==9){dl=1;}
        }
        if(dl==1){
            if(ws>=0){
                let a:i32=ws;
                let b:i32=i;
                if(b>a && n[0]<cap && apos[0]+(b-a)<=arena.len){
                    let cc:i32=0;
                    while(cc<b-a){arena[apos[0]+cc]=val[a+cc]; cc=cc+1;}
                    p32(tab,n[0]*8,apos[0]);
                    p32(tab,n[0]*8+4,b-a);
                    n[0]=n[0]+1;
                    apos[0]=apos[0]+(b-a);
                }
                ws=-1;
            }
        }else{
            if(ws<0){ws=i;}
        }
        i=i+1;
    }
    return;
}

// G1: query formulation
fn calib_g1(buf:[]u8,cns:i32,cnl:i32,qhas:[]u8,qhasn:i32,qnot:[]u8,qnotn:i32,dt:[]u8,dn:i32)i32 {
    if(cns<0){return 0;}
    let usekw:i32=nio_equal(dget(dt,dn,"QUERY-MODE"),"keywords");
    let q:[]u8=kw_query(buf[cns..cns+cnl],usekw,dget(dt,dn,"DROP"));
    let qt:[]u8=nio_alloc(512*8);
    let qn:i32=0;
    tokenize(q,qt,512,1,&qn);
    let ok:i32=1;
    let i:i32=0;
    while(i<qhasn && ok==1){
        let lw:[]u8=lower_copy(buf[g32(qhas,i*8)..g32(qhas,i*8)+g32(qhas,i*8+4)]);
        let wt2:[]u8=nio_alloc(16*8);
        let wn2:i32=0;
        tokenize(lw,wt2,16,1,&wn2);
        if(wn2==0){ok=0;}else{
            let k:i32=0;
            while(k<wn2){
                let found:i32=0;
                let j:i32=0;
                while(j<qn){
                    if(tok_eq(lw,g32(wt2,k*8),g32(wt2,k*8+4),q,g32(qt,j*8),g32(qt,j*8+4))==1){found=1; break;}
                    j=j+1;
                }
                if(found==0){ok=0; break;}
                k=k+1;
            }
        }
        nio_free(lw);
        nio_free(wt2);
        i=i+1;
    }
    i=0;
    while(i<qnotn && ok==1){
        let lw2:[]u8=lower_copy(buf[g32(qnot,i*8)..g32(qnot,i*8)+g32(qnot,i*8+4)]);
        let wt3:[]u8=nio_alloc(16*8);
        let wn3:i32=0;
        tokenize(lw2,wt3,16,1,&wn3);
        let k2:i32=0;
        while(k2<wn3){
            let j2:i32=0;
            while(j2<qn){
                if(tok_eq(lw2,g32(wt3,k2*8),g32(wt3,k2*8+4),q,g32(qt,j2*8),g32(qt,j2*8+4))==1){ok=0; break;}
                j2=j2+1;
            }
            if(ok==0){break;}
            k2=k2+1;
        }
        nio_free(lw2);
        nio_free(wt3);
        i=i+1;
    }
    nio_free(q);
    nio_free(qt);
    return ok;
}

// G2: selection
fn calib_g2(cres:[]u8,cresn:i32,eo:[]u8,eot:[]u8,eon:i32,dt:[]u8,dn:i32)i32 {
    if(eon==0){return 0;}
    let rt:[]u8=nio_alloc(32*24);
    let nr:i32=0;
    parse_results(cres[0..cresn],&nr,rt,32);
    let n:i32=dgeti(dt,dn,"SELECT-N",1);
    if(n<1){n=1;}
    let dedup:i32=nio_equal(dget(dt,dn,"SKIP-DUPE-TITLES"),"on");
    let sel:[]u8=nio_alloc(32*4);
    let nsel:i32=0;
    let scanned:i32=0;
    select_core(nr,rt,cres[0..cresn],n,dedup,sel,&nsel,&scanned);
    let ok:i32=0;
    if(nsel==eon){
        ok=1;
        let k:i32=0;
        while(k<eon){
            let ri:i32=g32(sel,k*4);
            let ps:i32=g32(rt,ri*24);
            let pl:i32=g32(rt,ri*24+4);
            let es:i32=g32(eot,k*8);
            let el:i32=g32(eot,k*8+4);
            if(pl!=el || bsub_eq(cres,ps,eo,es,pl)==0){ok=0; break;}
            k=k+1;
        }
    }
    nio_free(rt);
    nio_free(sel);
    return ok;
}

// G3: best sentence
fn calib_g3(buf:[]u8,cpages:[]u8,cpn:i32,cqs:i32,cql:i32,ecs:i32,ecl:i32)i32 {
    if(cqs<0 || ecs<0){return 0;}
    let pa:[]u8=nio_alloc(4096);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(512*12);
    let np:i32=0;
    let nst:i32=0;
    let ha:[]u8=nio_alloc(256);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    parse_pages(cpages[0..cpn],&np,pa,&papos,pt,tt,st,&nst,64,512,ha,&hapos,ht);
    let ok:i32=0;
    if(np>0){
        let qlow:[]u8=normalize(buf[cqs..cqs+cql]);
        let qt:[]u8=nio_alloc(512*8);
        let qn:i32=0;
        tokenize(qlow,qt,512,2,&qn);
        let incl:[]u8=nio_alloc(64*4);
        let i:i32=0;
        while(i<np){p32(incl,i*4,i); i=i+1;}
        let pg:i32=-1;
        let best:[]u8=best_across(cpages[0..cpn],incl,np,st,nst,qlow,qt,qn,&pg);
        let exp:[]u8=normalize(buf[ecs..ecs+ecl]);
        ok=nio_equal(best,exp);
        nio_free(qlow);
        nio_free(qt);
        nio_free(incl);
        nio_free(exp);
    }
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    return ok;
}

// shared page-table setup for G4/G5/G6
fn calib_pages(cpages:[]u8,cpn:i32,pa:[]u8,papos:*i32,pt:[]u8,tt:[]u8,st:[]u8,nst:*i32,np:*i32,ha:[]u8,hapos:*i32,ht:[]u8)void {
    parse_pages(cpages[0..cpn],np,pa,papos,pt,tt,st,nst,64,512,ha,hapos,ht);
    return;
}

fn pid_in_list(pa:[]u8,pt:[]u8,pidx:i32,lst:[]u8,lstt:[]u8,lstn:i32)i32 {
    let ps:i32=g32(pt,pidx*8);
    let pl:i32=g32(pt,pidx*8+4);
    let f:i32=0;
    while(f<lstn){
        let ss:i32=g32(lstt,f*8);
        let sl:i32=g32(lstt,f*8+4);
        if(pl==sl && bsub_eq(pa,ps,lst,ss,pl)==1){return 1;}
        f=f+1;
    }
    return 0;
}

// G4: verdict core, answer + winner pid set
fn calib_g4(buf:[]u8,cpages:[]u8,cpn:i32,cqs:i32,cql:i32,eas:i32,eal:i32,
    esup:[]u8,esupt:[]u8,esupn:i32,dt:[]u8,dn:i32)i32 {
    if(cqs<0 || eas<0 || esupn==0){return 0;}
    let pa:[]u8=nio_alloc(4096);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(512*12);
    let np:i32=0;
    let nst:i32=0;
    let ha:[]u8=nio_alloc(256);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    calib_pages(cpages,cpn,pa,&papos,pt,tt,st,&nst,&np,ha,&hapos,ht);
    let ok:i32=0;
    if(np>0){
        let o_ans:[]u8=nio_alloc(4096);
        let o_ansn:i32=0;
        let o_widx:[]u8=nio_alloc(64*4);
        let o_wn:i32=0;
        let o_provs:i32=0;
        let o_claims:i32=0;
        let o_fl:[]u8=nio_alloc(64*4);
        let o_fln:i32=0;
        let got:i32=verdict_core(cpages[0..cpn],np,pa,pt,tt,st,nst,ha,ht,
            buf[cqs..cqs+cql],"FACT","","",dt,dn,0,0,
            o_ans,&o_ansn,o_widx,&o_wn,&o_provs,&o_claims,o_fl,&o_fln);
        if(got==1){
            let exp:[]u8=normalize(buf[eas..eas+eal]);
            if(nio_equal(o_ans[0..o_ansn],exp)==1 && o_wn==esupn){
                ok=1;
                let k:i32=0;
                while(k<o_wn){
                    if(pid_in_list(pa,pt,g32(o_widx,k*4),esup,esupt,esupn)==0){ok=0; break;}
                    k=k+1;
                }
            }
            nio_free(exp);
        }
        nio_free(o_ans);
        nio_free(o_widx);
        nio_free(o_fl);
    }
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    return ok;
}

// G5: verdict core, provenance coverage
fn calib_g5(buf:[]u8,cpages:[]u8,cpn:i32,cqs:i32,cql:i32,eprovmin:i32,dt:[]u8,dn:i32)i32 {
    if(cqs<0 || eprovmin<0){return 0;}
    let pa:[]u8=nio_alloc(4096);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(512*12);
    let np:i32=0;
    let nst:i32=0;
    let ha:[]u8=nio_alloc(256);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    calib_pages(cpages,cpn,pa,&papos,pt,tt,st,&nst,&np,ha,&hapos,ht);
    let ok:i32=0;
    if(np>0){
        let o_ans:[]u8=nio_alloc(4096);
        let o_ansn:i32=0;
        let o_widx:[]u8=nio_alloc(64*4);
        let o_wn:i32=0;
        let o_provs:i32=0;
        let o_claims:i32=0;
        let o_fl:[]u8=nio_alloc(64*4);
        let o_fln:i32=0;
        verdict_core(cpages[0..cpn],np,pa,pt,tt,st,nst,ha,ht,
            buf[cqs..cqs+cql],"FACT","","",dt,dn,0,0,
            o_ans,&o_ansn,o_widx,&o_wn,&o_provs,&o_claims,o_fl,&o_fln);
        if(o_provs>=eprovmin && (o_claims==0 || o_provs>=1)){ok=1;}
        nio_free(o_ans);
        nio_free(o_widx);
        nio_free(o_fl);
    }
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    return ok;
}

// G6: injection scan flags EXPECT-FLAG pid and it is excluded from the winner
fn calib_g6(buf:[]u8,cpages:[]u8,cpn:i32,cqs:i32,cql:i32,eflag:[]u8,eflagl:i32,dt:[]u8,dn:i32)i32 {
    if(eflagl<=0){return 0;}
    // EXPECT-FLAG value is "KIND pid" (e.g. "INJECTION pX"); pid follows first space.
    let fp:i32=0;
    while(fp<eflagl && eflag[fp]!=32 && eflag[fp]!=9){fp=fp+1;}
    let pids:i32=0;
    let pidl:i32=eflagl;
    if(fp<eflagl){
        pids=fp+1;
        pidl=eflagl-pids;
        while(pidl>0 && (eflag[pids]==32 || eflag[pids]==9)){pids=pids+1; pidl=pidl-1;}
    }
    let pa:[]u8=nio_alloc(4096);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(512*12);
    let np:i32=0;
    let nst:i32=0;
    let ha:[]u8=nio_alloc(256);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    calib_pages(cpages,cpn,pa,&papos,pt,tt,st,&nst,&np,ha,&hapos,ht);
    let ok:i32=0;
    if(np>0){
        let o_ans:[]u8=nio_alloc(4096);
        let o_ansn:i32=0;
        let o_widx:[]u8=nio_alloc(64*4);
        let o_wn:i32=0;
        let o_provs:i32=0;
        let o_claims:i32=0;
        let o_fl:[]u8=nio_alloc(64*4);
        let o_fln:i32=0;
        let q:[]u8="";
        if(cqs>=0){q=buf[cqs..cqs+cql];}
        verdict_core(cpages[0..cpn],np,pa,pt,tt,st,nst,ha,ht,
            q,"FACT","","",dt,dn,0,0,
            o_ans,&o_ansn,o_widx,&o_wn,&o_provs,&o_claims,o_fl,&o_fln);
        let flagged:i32=0;
        let k:i32=0;
        while(k<o_fln){
            let ps:i32=g32(pt,g32(o_fl,k*4)*8);
            let pl:i32=g32(pt,g32(o_fl,k*4)*8+4);
            if(pl==pidl && bsub_eq(pa,ps,eflag,pids,pl)==1){flagged=1; break;}
            k=k+1;
        }
        let inwin:i32=0;
        k=0;
        while(k<o_wn){
            let ps2:i32=g32(pt,g32(o_widx,k*4)*8);
            let pl2:i32=g32(pt,g32(o_widx,k*4)*8+4);
            if(pl2==pidl && bsub_eq(pa,ps2,eflag,pids,pl2)==1){inwin=1; break;}
            k=k+1;
        }
        if(flagged==1 && inwin==0){ok=1;}
        nio_free(o_ans);
        nio_free(o_widx);
        nio_free(o_fl);
    }
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    return ok;
}

// G7: selection + blind-style single-page verdict with its own directives
fn calib_g7(buf:[]u8,cres:[]u8,cresn:i32,cpages:[]u8,cpn:i32,cqs:i32,cql:i32,
    eas:i32,eal:i32,dt:[]u8,dn:i32)i32 {
    if(cqs<0 || eas<0){return 0;}
    let rt:[]u8=nio_alloc(32*24);
    let nr:i32=0;
    parse_results(cres[0..cresn],&nr,rt,32);
    let ok:i32=0;
    if(nr>0){
        let n:i32=dgeti(dt,dn,"SELECT-N",1);
        if(n<1){n=1;}
        let dedup:i32=nio_equal(dget(dt,dn,"SKIP-DUPE-TITLES"),"on");
        let sel:[]u8=nio_alloc(32*4);
        let nsel:i32=0;
        let scanned:i32=0;
        select_core(nr,rt,cres[0..cresn],n,dedup,sel,&nsel,&scanned);
        if(nsel>0){
            let ri:i32=g32(sel,0);
            let rps:i32=g32(rt,ri*24);
            let rpl:i32=g32(rt,ri*24+4);
            let pa:[]u8=nio_alloc(4096);
            let papos:i32=0;
            let pt:[]u8=nio_alloc(64*8);
            let tt:[]u8=nio_alloc(64*8);
            let st:[]u8=nio_alloc(512*12);
            let np:i32=0;
            let nst:i32=0;
            let ha:[]u8=nio_alloc(256);
            let hapos:i32=0;
            let ht:[]u8=nio_alloc(64*8);
            calib_pages(cpages,cpn,pa,&papos,pt,tt,st,&nst,&np,ha,&hapos,ht);
            let pg:i32=-1;
            let p2:i32=0;
            while(p2<np){
                let ps3:i32=g32(pt,p2*8);
                let pl3:i32=g32(pt,p2*8+4);
                if(pl3==rpl && bsub_eq(pa,ps3,cres,rps,pl3)==1){pg=p2; break;}
                p2=p2+1;
            }
            if(pg>=0 && page_nsent(st,nst,pg)>0){
                let qlow:[]u8=normalize(buf[cqs..cqs+cql]);
                let qt:[]u8=nio_alloc(512*8);
                let qn:i32=0;
                tokenize(qlow,qt,512,2,&qn);
                let bs:[]u8=best_for_page(cpages[0..cpn],pg,st,nst,qlow,qt,qn);
                let exp:[]u8=normalize(buf[eas..eas+eal]);
                ok=nio_equal(bs,exp);
                nio_free(qlow);
                nio_free(qt);
                nio_free(bs);
                nio_free(exp);
            }
            nio_free(pa);
            nio_free(pt);
            nio_free(tt);
            nio_free(st);
            nio_free(ha);
            nio_free(ht);
        }
        nio_free(sel);
    }
    nio_free(rt);
    return ok;
}

// calibration tag match: line is TAG, or TAG followed by '|' or ':'.
// returns value-start offset when a delimiter is present, -2 for bare TAG,
// -1 for no match.
fn ctag(line:[]u8,tag:[]u8)i32 {
    if(line.len<tag.len){return -1;}
    let i:i32=0;
    while(i<tag.len){if(line[i]!=tag[i]){return -1;} i=i+1;}
    if(line.len==tag.len){return -2;}
    let d:u8=line[tag.len];
    if(d==124 || d==58){return tag.len+1;}
    return -1;
}

// trim leading/trailing spaces and tabs around buf[ls..ls+ln].
fn vtrim(buf:[]u8,ls:*i32,ln:*i32)void {
    let s:i32=ls[0];
    let l:i32=ln[0];
    while(l>0 && (buf[s]==32 || buf[s]==9)){s=s+1; l=l-1;}
    while(l>0 && (buf[s+l-1]==32 || buf[s+l-1]==9)){l=l-1;}
    ls[0]=s;
    ln[0]=l;
    return;
}

// parse one module file: MODULE name, D| directives; collect calibration fields.
// returns 1 if a CALIBRATION block was found, 0 otherwise.
fn run_calib(digit:i32,buf:[]u8,dt:[]u8,dn:i32)i32 {
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    let incal:i32=0;
    let mode:i32=0;
    let cneed_s:i32=-1;
    let cneed_l:i32=0;
    let cquery_s:i32=-1;
    let cquery_l:i32=0;
    let cres:[]u8=nio_alloc(16384);
    let crespos:i32=0;
    let cpages:[]u8=nio_alloc(32768);
    let cpagespos:i32=0;
    let qhas:[]u8=nio_alloc(32*8);
    let qhasn:i32=0;
    let qnot:[]u8=nio_alloc(32*8);
    let qnotn:i32=0;
    let eopen:[]u8=nio_alloc(2048);
    let eopent:[]u8=nio_alloc(16*8);
    let eopenn:i32=0;
    let eopenpos:i32=0;
    let esup:[]u8=nio_alloc(2048);
    let esupt:[]u8=nio_alloc(16*8);
    let esupn:i32=0;
    let esuppos:i32=0;
    let eclaim_s:i32=-1;
    let eclaim_l:i32=0;
    let eanswer_s:i32=-1;
    let eanswer_l:i32=0;
    let eprovmin:i32=-1;
    let eflag:[]u8=nio_alloc(128);
    let eflagl:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        let line:[]u8=buf[ls..ls+ln];
        if(incal==0){
            if(nio_equal(line,"CALIBRATION")==1 || ctag(line,"CALIBRATION")>=0){incal=1;}
            continue;
        }
        if(nio_equal(line,"END-CALIBRATION")==1 || ctag(line,"END-CALIBRATION")>=0){break;}
        if(nio_equal(line,"CRESULTS")==1 || ctag(line,"CRESULTS")>=0){mode=1; continue;}
        if(nio_equal(line,"CPAGES")==1 || ctag(line,"CPAGES")>=0){mode=2; continue;}
        if(ctag(line,"CPAGE")>=0){mode=2; continue;}
        let vo:i32=ctag(line,"CNEED");
        if(vo>=0){
            let vs:i32=ls+vo;
            let vl:i32=ln-vo;
            vtrim(buf,&vs,&vl);
            cneed_s=vs; cneed_l=vl; mode=0; continue;
        }
        vo=ctag(line,"CQUERY");
        if(vo>=0){
            let vs2:i32=ls+vo;
            let vl2:i32=ln-vo;
            vtrim(buf,&vs2,&vl2);
            cquery_s=vs2; cquery_l=vl2; mode=0; continue;
        }
        vo=ctag(line,"EXPECT-QUERY-HAS");
        if(vo>=0){
            let vs3:i32=ls+vo;
            let vl3:i32=ln-vo;
            vtrim(buf,&vs3,&vl3);
            if(qhasn<32){p32(qhas,qhasn*8,vs3); p32(qhas,qhasn*8+4,vl3); qhasn=qhasn+1;}
            mode=0;
            continue;
        }
        vo=ctag(line,"EXPECT-QUERY-NOT");
        if(vo>=0){
            let vs4:i32=ls+vo;
            let vl4:i32=ln-vo;
            vtrim(buf,&vs4,&vl4);
            if(qnotn<32){p32(qnot,qnotn*8,vs4); p32(qnot,qnotn*8+4,vl4); qnotn=qnotn+1;}
            mode=0;
            continue;
        }
        vo=ctag(line,"EXPECT-OPEN");
        if(vo>=0){
            let vs5:i32=ls+vo;
            let vl5:i32=ln-vo;
            vtrim(buf,&vs5,&vl5);
            split_pids(buf[vs5..vs5+vl5],eopen,&eopenpos,eopent,&eopenn,16);
            mode=0;
            continue;
        }
        vo=ctag(line,"EXPECT-SUPPORT");
        if(vo>=0){
            let vs6:i32=ls+vo;
            let vl6:i32=ln-vo;
            vtrim(buf,&vs6,&vl6);
            split_pids(buf[vs6..vs6+vl6],esup,&esuppos,esupt,&esupn,16);
            mode=0;
            continue;
        }
        vo=ctag(line,"EXPECT-CLAIM");
        if(vo>=0){
            let vs7:i32=ls+vo;
            let vl7:i32=ln-vo;
            vtrim(buf,&vs7,&vl7);
            eclaim_s=vs7; eclaim_l=vl7; mode=0; continue;
        }
        vo=ctag(line,"EXPECT-ANSWER");
        if(vo>=0){
            let vs8:i32=ls+vo;
            let vl8:i32=ln-vo;
            vtrim(buf,&vs8,&vl8);
            eanswer_s=vs8; eanswer_l=vl8; mode=0; continue;
        }
        vo=ctag(line,"EXPECT-PROV-MIN");
        if(vo>=0){
            let vs9:i32=ls+vo;
            let vl9:i32=ln-vo;
            vtrim(buf,&vs9,&vl9);
            eprovmin=atoi(buf[vs9..vs9+vl9]); mode=0; continue;
        }
        vo=ctag(line,"EXPECT-FLAG");
        if(vo>=0){
            let fs2:i32=ls+vo;
            let fl2:i32=ln-vo;
            vtrim(buf,&fs2,&fl2);
            if(fl2>127){fl2=127;}
            let fc2:i32=0;
            while(fc2<fl2){eflag[fc2]=buf[fs2+fc2]; fc2=fc2+1;}
            eflagl=fl2;
            mode=0;
            continue;
        }
        if(mode==1){
            if(ln>2 && buf[ls]==82 && buf[ls+1]==124 && crespos+ln+1<=cres.len){
                let cc:i32=0;
                while(cc<ln){cres[crespos+cc]=buf[ls+cc]; cc=cc+1;}
                cres[crespos+ln]=10;
                crespos=crespos+ln+1;
            }
            continue;
        }
        if(mode==2){
            if(ln>2 && (buf[ls]==80 || buf[ls]==83) && buf[ls+1]==124 && cpagespos+ln+1<=cpages.len){
                let cc2:i32=0;
                while(cc2<ln){cpages[cpagespos+cc2]=buf[ls+cc2]; cc2=cc2+1;}
                cpages[cpagespos+ln]=10;
                cpagespos=cpagespos+ln+1;
            }
            continue;
        }
    }
    let rc:i32=-1;
    if(incal==1){
        rc=0;
        if(digit==1){rc=calib_g1(buf,cneed_s,cneed_l,qhas,qhasn,qnot,qnotn,dt,dn);}
        if(digit==2){rc=calib_g2(cres,crespos,eopen,eopent,eopenn,dt,dn);}
        if(digit==3){rc=calib_g3(buf,cpages,cpagespos,cquery_s,cquery_l,eclaim_s,eclaim_l);}
        if(digit==4){rc=calib_g4(buf,cpages,cpagespos,cquery_s,cquery_l,eanswer_s,eanswer_l,esup,esupt,esupn,dt,dn);}
        if(digit==5){rc=calib_g5(buf,cpages,cpagespos,cquery_s,cquery_l,eprovmin,dt,dn);}
        if(digit==6){rc=calib_g6(buf,cpages,cpagespos,cquery_s,cquery_l,eflag,eflagl,dt,dn);}
        if(digit==7){rc=calib_g7(buf,cres,crespos,cpages,cpagespos,cquery_s,cquery_l,eanswer_s,eanswer_l,dt,dn);}
    }
    nio_free(cres);
    nio_free(cpages);
    nio_free(qhas);
    nio_free(qnot);
    nio_free(eopen);
    nio_free(eopent);
    nio_free(esup);
    nio_free(esupt);
    nio_free(eflag);
    return rc;
}

fn parse_module_header(buf:[]u8,mod:[]u8,modl:*i32,dt:[]u8,dp:*i32,dn:*i32)void {
    modl[0]=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        if(ln>7 && bstart(buf[ls..ls+ln],"MODULE|")==1){
            let ml:i32=ln-7;
            if(ml>127){ml=127;}
            let c:i32=0;
            while(c<ml){mod[c]=buf[ls+7+c]; c=c+1;}
            modl[0]=ml;
        }else{
            if(ln>2 && buf[ls]==68 && buf[ls+1]==124){
                let a:i32=ls+2;
                let b:i32=a;
                while(b<ls+ln && buf[b]!=124){b=b+1;}
                if(b<ls+ln){
                    dset(dt,dp,dn,buf[a..b],buf[b+1..ls+ln]);
                }
            }
        }
    }
    return;
}

// ---------- commands ----------
fn cmd_teach(gd:[]u8,sd:[]u8)i32 {
    let nm:[]u8=nio_alloc(32768);
    let tab:[]u8=nio_alloc(64*8);
    let nmpos:i32=0;
    let nn:i32=0;
    list_guides(gd,nm,&nmpos,tab,&nn,64);
    sort_names(nm,tab,nn);
    let mrec:[]u8=nio_alloc(16*8);
    let mna:[]u8=nio_alloc(2048);
    let mnat:[]u8=nio_alloc(16*8);
    let mnapos:i32=0;
    let mfa:[]u8=nio_alloc(4096);
    let mfat:[]u8=nio_alloc(16*8);
    let mfapos:i32=0;
    let nmod:i32=0;
    let g7in:i32=0;
    let rej:[]u8=nio_alloc(256);
    let rejl:i32=0;
    let j:i32=0;
    while(j<nn){
        let fs:i32=g32(tab,j*8);
        let fl:i32=g32(tab,j*8+4);
        let fname:[]u8=nm[fs..fs+fl];
        let digit:i32=(fname[1] as i32)-48;
        if(digit>=1 && digit<=7 && nmod<16){
            let ok:i32=0;
            let buf:[]u8=read_file(gd,fname,&ok);
            if(ok==1){
                let mod:[]u8=nio_alloc(128);
                let modl:i32=0;
                let dt:[]u8=nio_alloc(8192);
                let dp:i32=0;
                let dn:i32=0;
                parse_module_header(buf,mod,&modl,dt,&dp,&dn);
                if(modl==0){
                    mod[0]=71;
                    mod[1]=(48+digit) as u8;
                    modl=2;
                }
                let cr:i32=run_calib(digit,buf,dt,dn);
                let inst:i32=0;
                if(cr==1){
                    inst=1;
                    _zag_print("LEARN|");
                    _zag_print(mod[0..modl]);
                    _zag_print("|INSTALLED|");
                    _zag_println("PASS");
                }else{
                    _zag_print("LEARN|");
                    _zag_print(mod[0..modl]);
                    _zag_print("|REJECTED|");
                    if(cr==-1){_zag_println("NO-CALIB");}else{_zag_println("CALIB-FAIL");}
                }
                if(digit==7 && inst==1){g7in=1;}
                if(digit>=1 && digit<=6 && inst==0 && rejl==0){
                    let c:i32=0;
                    while(c<modl && c<250){rej[c]=mod[c]; c=c+1;}
                    rejl=modl;
                }
                p32(mrec,nmod*8,digit);
                p32(mrec,nmod*8+4,inst);
                if(mnapos+modl<=mna.len){
                    let c2:i32=0;
                    while(c2<modl){mna[mnapos+c2]=mod[c2]; c2=c2+1;}
                    p32(mnat,nmod*8,mnapos);
                    p32(mnat,nmod*8+4,modl);
                    mnapos=mnapos+modl;
                }
                if(mfapos+fl<=mfa.len){
                    let c3:i32=0;
                    while(c3<fl){mfa[mfapos+c3]=fname[c3]; c3=c3+1;}
                    p32(mfat,nmod*8,mfapos);
                    p32(mfat,nmod*8+4,fl);
                    mfapos=mfapos+fl;
                }
                nmod=nmod+1;
                nio_free(buf);
                nio_free(mod);
                nio_free(dt);
            }
        }
        j=j+1;
    }
    // installed.txt from installed modules, first-installed wins
    let ib:[]u8=nio_alloc(65536);
    let ipos:i32=0;
    let dt2:[]u8=nio_alloc(16384);
    let dp2:i32=0;
    let dn2:i32=0;
    let m:i32=0;
    while(m<nmod){
        if(g32(mrec,m*8+4)==1){
            let fs2:i32=g32(mfat,m*8);
            let fl2:i32=g32(mfat,m*8+4);
            let ok2:i32=0;
            let b2:[]u8=read_file(gd,mfa[fs2..fs2+fl2],&ok2);
            if(ok2==1){
                let pos2:i32=0;
                let ls2:i32=0;
                let ll2:i32=0;
                while(next_line(b2,&pos2,&ls2,&ll2)==1){
                    let ln2:i32=ll2;
                    if(ln2>0 && b2[ls2+ln2-1]==13){ln2=ln2-1;}
                    if(ln2>2 && b2[ls2]==68 && b2[ls2+1]==124){
                        let a2:i32=ls2+2;
                        let b3:i32=a2;
                        while(b3<ls2+ln2 && b2[b3]!=124){b3=b3+1;}
                        if(b3<ls2+ln2){
                            let kk:[]u8=b2[a2..b3];
                            let vv:[]u8=b2[b3+1..ls2+ln2];
                            if(dhas(dt2,dn2,kk)==0){
                                dset(dt2,&dp2,&dn2,kk,vv);
                                let need2:i32=3+kk.len+vv.len;
                                if(ipos+need2<=ib.len){
                                    ib[ipos]=73;
                                    ib[ipos+1]=124;
                                    ipos=ipos+2;
                                    let c4:i32=0;
                                    while(c4<kk.len){ib[ipos+c4]=kk[c4]; c4=c4+1;}
                                    ipos=ipos+kk.len;
                                    ib[ipos]=124;
                                    ipos=ipos+1;
                                    c4=0;
                                    while(c4<vv.len){ib[ipos+c4]=vv[c4]; c4=c4+1;}
                                    ipos=ipos+vv.len;
                                    ib[ipos]=10;
                                    ipos=ipos+1;
                                }
                            }
                        }
                    }
                }
                nio_free(b2);
            }
        }
        m=m+1;
    }
    write_file(sd,"installed.txt",ib[0..ipos]);
    nio_free(nm);
    nio_free(tab);
    nio_free(mrec);
    nio_free(mna);
    nio_free(mnat);
    nio_free(mfa);
    nio_free(mfat);
    nio_free(ib);
    nio_free(dt2);
    if(nmod==0){
        _zag_println("LEARN|NONE|NO-GUIDES");
        nio_free(rej);
        return 0;
    }
    if(g7in==1){
        _zag_println("LEARN|VOID|G7-INSTALLED");
        nio_free(rej);
        return 3;
    }
    if(rejl>0){
        _zag_print("LEARN|VOID|");
        _zag_print(rej[0..rejl]);
        _zag_println("-REJECTED");
        nio_free(rej);
        return 3;
    }
    nio_free(rej);
    return 0;
}

fn cmd_query(sd:[]u8,needpath:[]u8,extra:[]u8)i32 {
    let dt:[]u8=nio_alloc(16384);
    let dp:i32=0;
    let dn:i32=0;
    load_installed(sd,dt,&dp,&dn);
    let ok:i32=0;
    let need:[]u8=read_path(needpath,&ok);
    if(ok==0){nio_free(dt); return 2;}
    let nd:[]u8=trim(need);
    let guided:i32=nio_equal(dget(dt,dn,"QUERY-MODE"),"keywords");
    let dropv:[]u8=dget(dt,dn,"DROP");
    if(extra.len>0 && guided==1){
        let k:i32=0;
        while(k<extra.len && extra[k]!=59){k=k+1;}
        if(k<extra.len){
            let e1:[]u8=trim(extra[0..k]);
            let e2:[]u8=trim(extra[k+1..extra.len]);
            if(e1.len>0 && e2.len>0){
                let q1:[]u8=kw_query(e1,1,dropv);
                let q2:[]u8=kw_query(e2,1,dropv);
                _zag_print("QUERY|");
                _zag_println(q1);
                _zag_print("QUERY|");
                _zag_println(q2);
                nio_free(q1);
                nio_free(q2);
                nio_free(need);
                nio_free(dt);
                return 0;
            }
        }
    }
    if(guided==1){
        let q:[]u8=kw_query(nd,1,dropv);
        _zag_print("QUERY|");
        _zag_println(q);
        nio_free(q);
    }else{
        let low:[]u8=lower_copy(nd);
        _zag_print("QUERY|");
        _zag_println(low);
        nio_free(low);
    }
    nio_free(need);
    nio_free(dt);
    return 0;
}

fn cmd_select(sd:[]u8,rpath:[]u8)i32 {
    let dt:[]u8=nio_alloc(16384);
    let dp:i32=0;
    let dn:i32=0;
    load_installed(sd,dt,&dp,&dn);
    let ok:i32=0;
    let buf:[]u8=read_path(rpath,&ok);
    if(ok==0){nio_free(dt); return 2;}
    let rt:[]u8=nio_alloc(256*24);
    let nr:i32=0;
    parse_results(buf,&nr,rt,256);
    let n:i32=dgeti(dt,dn,"SELECT-N",1);
    if(n<1){n=1;}
    let dedup:i32=nio_equal(dget(dt,dn,"SKIP-DUPE-TITLES"),"on");
    let sel:[]u8=nio_alloc(256*4);
    let nsel:i32=0;
    let scanned:i32=0;
    select_core(nr,rt,buf,n,dedup,sel,&nsel,&scanned);
    _zag_print("OPEN|");
    let k:i32=0;
    while(k<nsel){
        let ri:i32=g32(sel,k*4);
        let ps:i32=g32(rt,ri*24);
        let pl:i32=g32(rt,ri*24+4);
        if(k>0){_zag_print(" ");}
        _zag_print(buf[ps..ps+pl]);
        k=k+1;
    }
    _zag_println("");
    _zag_print("SEL-REASON|took ");
    _zag_print(i64s(nsel as i64));
    _zag_print(" of ");
    _zag_print(i64s(scanned as i64));
    _zag_print(" scanned (N=");
    _zag_print(i64s(n as i64));
    _zag_println(")");
    nio_free(buf);
    nio_free(rt);
    nio_free(sel);
    nio_free(dt);
    return 0;
}

fn cmd_verdict(sd:[]u8,nfp:[]u8,ppath:[]u8,kind:[]u8,query:[]u8,extra:[]u8)i32 {
    let dt:[]u8=nio_alloc(16384);
    let dp:i32=0;
    let dn:i32=0;
    load_installed(sd,dt,&dp,&dn);
    let ok:i32=0;
    let buf:[]u8=read_path(ppath,&ok);
    if(ok==0){nio_free(dt); return 2;}
    // need_kw: the binary's own query-mode keyword pipeline on the need text.
    let nok:i32=0;
    let need:[]u8=read_path(nfp,&nok);
    let kwstr:[]u8="";
    if(nok==1){
        let g2:i32=nio_equal(dget(dt,dn,"QUERY-MODE"),"keywords");
        if(g2==1){kwstr=kw_query(trim(need),1,dget(dt,dn,"DROP"));}
        else{kwstr=lower_copy(trim(need));}
        nio_free(need);
    }
    let pa:[]u8=nio_alloc(8192);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(2048*12);
    let np:i32=0;
    let nst:i32=0;
    let ha:[]u8=nio_alloc(4096);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    parse_pages(buf,&np,pa,&papos,pt,tt,st,&nst,64,2048,ha,&hapos,ht);
    let o_ans:[]u8=nio_alloc(4096);
    let o_ansn:i32=0;
    let o_widx:[]u8=nio_alloc(64*4);
    let o_wn:i32=0;
    let o_provs:i32=0;
    let o_claims:i32=0;
    let o_fl:[]u8=nio_alloc(64*4);
    let o_fln:i32=0;
    verdict_core(buf,np,pa,pt,tt,st,nst,ha,ht,query,kind,extra,kwstr,dt,dn,0,1,
        o_ans,&o_ansn,o_widx,&o_wn,&o_provs,&o_claims,o_fl,&o_fln);
    nio_free(kwstr);
    nio_free(buf);
    nio_free(pa);
    nio_free(pt);
    nio_free(tt);
    nio_free(st);
    nio_free(ha);
    nio_free(ht);
    nio_free(o_ans);
    nio_free(o_widx);
    nio_free(o_fl);
    nio_free(dt);
    return 0;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(nio_equal(m,"teach")==1){
        let gd:[]u8=_zag_arg(2);
        let sd:[]u8=_zag_arg(3);
        if(gd.len==0 || sd.len==0){return 2;}
        return cmd_teach(gd,sd);
    }
    if(nio_equal(m,"query")==1){
        let sd2:[]u8=_zag_arg(2);
        let np2:[]u8=_zag_arg(3);
        let ex:[]u8=_zag_arg(4);
        if(sd2.len==0 || np2.len==0){return 2;}
        return cmd_query(sd2,np2,ex);
    }
    if(nio_equal(m,"select")==1){
        let sd3:[]u8=_zag_arg(2);
        let rp:[]u8=_zag_arg(3);
        if(sd3.len==0 || rp.len==0){return 2;}
        return cmd_select(sd3,rp);
    }
    if(nio_equal(m,"verdict")==1){
        let sd4:[]u8=_zag_arg(2);
        let nfp:[]u8=_zag_arg(3);
        let pp:[]u8=_zag_arg(4);
        let kd:[]u8=_zag_arg(5);
        let qy:[]u8=_zag_arg(6);
        let ex2:[]u8=_zag_arg(7);
        if(sd4.len==0 || pp.len==0 || kd.len==0 || qy.len==0){return 2;}
        return cmd_verdict(sd4,nfp,pp,kd,qy,ex2);
    }
    return 2;
}

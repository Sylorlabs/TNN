// tier2.zag — LI-HARDEN Tier 2 mechanisms (Crew T2-BUILD).
// Pure Zag, zero RNG, deterministic. Modes (argv[1]):
//   extract <page.html>   HL-6 main-text-only extraction
//   norm                  HL-7 conservative normalization (stdin-ish file arg)
//   sentsplit             HL-7 sentence splitter
//   attr <chains>         HL-8 redirect attribution
//   plat <votes> <claim>  HL-9 platform-suffix independence
//   dedup <pages>         HL-10 mirror dedup with surrounding-text diversity
// All output accumulates into one buffer, printed once from main.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- shared ----------------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}

fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){
            if(h[i+j]!=n[j]){break;}
            j=j+1;
        }
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}

fn find_sub(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    let i:i32=from;
    if(i<0){i=0;}
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){
            if(h[i+j]!=n[j]){break;}
            j=j+1;
        }
        if(j==n.len){return i;}
        i=i+1;
    }
    return -1;
}

fn lower_copy(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        b[i]=c;
        i=i+1;
    }
    return b[0..s.len];
}

fn is_digit(c:u8)i32 { if(c>=48 && c<=57){return 1;} return 0; }
fn is_alpha(c:u8)i32 {
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn is_upper(c:u8)i32 { if(c>=65 && c<=90){return 1;} return 0; }
fn is_space(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(ll[0]>0 && b[e-1]==13){ll[0]=ll[0]-1;}
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

// output accumulator: append-only, silent truncation at cap
fn emit(ob:[]u8,op:*i32,s:[]u8)void {
    let i:i32=0;
    while(i<s.len && op[0]<ob.len){ob[op[0]]=s[i]; op[0]=op[0]+1; i=i+1;}
    return;
}
fn emit_nl(ob:[]u8,op:*i32)void {
    if(op[0]<ob.len){ob[op[0]]=10; op[0]=op[0]+1;}
    return;
}
fn emit_i64(ob:[]u8,op:*i32,v:i64)void {
    emit(ob,op,i64s(v));
    return;
}

// byte-compare for canonical sort: -1/0/1
fn bcmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){return -1;}
        if(a[i]>b[i]){return 1;}
        i=i+1;
    }
    if(a.len<b.len){return -1;}
    if(a.len>b.len){return 1;}
    return 0;
}

// ---------------- PSL + registrable domain (frozen psl_frozen.txt) ----------------
fn psl_data()[]u8 {
    return "ac.uk|co.uk|gov.uk|ltd.uk|me.uk|net.uk|nhs.uk|org.uk|plc.uk|sch.uk|com.au|edu.au|gov.au|asn.au|id.au|net.au|org.au|co.jp|ac.jp|ad.jp|ed.jp|go.jp|gr.jp|lg.jp|ne.jp|or.jp|co.nz|ac.nz|geek.nz|gen.nz|govt.nz|kiwi.nz|maori.nz|net.nz|org.nz|school.nz|co.in|ac.in|edu.in|firm.in|gen.in|gov.in|net.in|org.in|res.in|com.br|edu.br|gov.br|net.br|org.br|com.cn|edu.cn|gov.cn|net.cn|org.cn|com.tw|idv.tw|org.tw|com.hk|edu.hk|gov.hk|idv.hk|net.hk|org.hk|co.kr|ac.kr|es.kr|go.kr|hs.kr|ms.kr|ne.kr|or.kr|pe.kr|re.kr|sc.kr|com.sg|edu.sg|gov.sg|idn.sg|net.sg|org.sg|per.sg|co.za|ac.za|edu.za|gov.za|net.za|org.za|school.za|com.mx|edu.mx|gob.mx|net.mx|org.mx|com.ar|edu.ar|gob.ar|gov.ar|int.ar|net.ar|org.ar|com.co|edu.co|net.co|nom.co|com.pe|edu.pe|gob.pe|mil.pe|net.pe|nom.pe|org.pe|com.ve|co.ve|edu.ve|gob.ve|gov.ve|info.ve|net.ve|org.ve|co.id|ac.id|desa.id|go.id|mil.id|net.id|or.id|sch.id|web.id|com.ph|edu.ph|gov.ph|i.ph|mil.ph|net.ph|ngo.ph|org.ph|ac.th|co.th|go.th|mi.th|net.th|or.th|com.my|edu.my|gov.my|mil.my|name.my|net.my|org.my|bbs.tr|com.tr|edu.tr|gen.tr|gov.tr|info.tr|mil.tr|name.tr|net.tr|org.tr|tv.tr|web.tr|ac.il|co.il|edu.il|gov.il|muni.il|net.il|org.il|com.eg|edu.eg|gov.eg|info.eg|mil.eg|name.eg|net.eg|org.eg|sci.eg|sport.eg|tv.eg|ac.ke|co.ke|go.ke|info.ke|me.ke|mobi.ke|ne.ke|or.ke|sc.ke|com.ng|edu.ng|gov.ng|mobi.ng|name.ng|net.ng|org.ng|sch.ng|ac.ug|co.ug|go.ug|ne.ug|or.ug|sc.ug|ac.zw|co.zw|gov.zw|org.zw|com.ua|edu.ua|gov.ua|net.ua|org.ua|asso.fr|com.fr|gouv.fr|nom.fr|prd.fr|presse.fr|tm.fr|ab.ca|bc.ca|mb.ca|nb.ca|nf.ca|nl.ca|ns.ca|nt.ca|nu.ca|on.ca|pe.ca|qc.ca|sk.ca|yk.ca|gc.ca|com.pl|edu.pl|net.pl|org.pl|info.pl|biz.pl|ac.at|co.at|gv.at|or.at|com.es|edu.es|gob.es|nom.es|org.es";
}

fn in_psl(cand:[]u8)i32 {
    let d:[]u8=psl_data();
    let s:i32=0;
    let i:i32=0;
    while(i<=d.len){
        if(i==d.len || d[i]==124){
            let e:[]u8=d[s..i];
            if(nio_equal(e,cand)==1){return 1;}
            s=i+1;
        }
        i=i+1;
    }
    return 0;
}

// label starts of host into ls (arena of i32), returns label count
fn label_starts(host:[]u8,ls:[]u8)i32 {
    let n:i32=0;
    let i:i32=0;
    p32(ls,0,0);
    n=1;
    while(i<host.len){
        if(host[i]==46){
            if(n<32){p32(ls,n*4,i+1); n=n+1;}
        }
        i=i+1;
    }
    return n;
}

// regdom: longest PSL suffix match wins; fallback last-two-labels
fn regdom(host:[]u8,sc:[]u8)[]u8 {
    let ls:[]u8=nio_alloc(32*4);
    let nl:i32=label_starts(host,ls);
    let k:i32=0;
    while(k<nl){
        let st:i32=g32(ls,k*4);
        let cand:[]u8=host[st..host.len];
        if(in_psl(cand)==1){
            nio_free(ls);
            if(k==0){return host;}
            let rs:i32=g32(ls,(k-1)*4);
            let o:i32=0;
            let q:i32=rs;
            while(q<host.len){sc[o]=host[q]; o=o+1; q=q+1;}
            return sc[0..o];
        }
        k=k+1;
    }
    nio_free(ls);
    if(nl>=2){
        let ls2:[]u8=nio_alloc(32*4);
        let nl2:i32=label_starts(host,ls2);
        let st2:i32=g32(ls2,(nl2-2)*4);
        nio_free(ls2);
        let o2:i32=0;
        let q2:i32=st2;
        while(q2<host.len){sc[o2]=host[q2]; o2=o2+1; q2=q2+1;}
        return sc[0..o2];
    }
    return host;
}

// ---------------- platform suffixes (pinned, HL-9) ----------------
fn plat_data()[]u8 {
    return "github.io|gitlab.io|bitbucket.io|pages.dev|vercel.app|netlify.app|herokuapp.com|blogspot.com|wordpress.com|tumblr.com|weebly.com|wixsite.com|medium.com|substack.com|appspot.com|glitch.me";
}

// longest matching platform suffix, or ""
fn plat_suffix(host:[]u8)[]u8 {
    let d:[]u8=plat_data();
    let best:[]u8="";
    let s:i32=0;
    let i:i32=0;
    while(i<=d.len){
        if(i==d.len || d[i]==124){
            let e:[]u8=d[s..i];
            let m:i32=0;
            if(nio_equal(host,e)==1){m=1;}
            if(m==0 && host.len>e.len+1){
                let at:i32=host.len-e.len;
                if(host[at-1]==46 && nio_equal(host[at..host.len],e)==1){m=1;}
            }
            if(m==1 && e.len>best.len){best=e;}
            s=i+1;
        }
        i=i+1;
    }
    return best;
}

// account = label immediately above the platform suffix
fn plat_account(host:[]u8,suf:[]u8)[]u8 {
    if(nio_equal(host,suf)==1){return "";}
    let rest:[]u8=host[0..host.len-suf.len-1];
    let k:i32=rest.len-1;
    while(k>=0 && rest[k]!=46){k=k-1;}
    return rest[k+1..rest.len];
}

// ---------------- URL host parse (HL-8) ----------------
fn url_host(u:[]u8,sc:[]u8)[]u8 {
    let p:i32=find_sub(u,"://",0);
    if(p<0){return "";}
    let s:i32=p+3;
    let e:i32=s;
    while(e<u.len && u[e]!=47 && u[e]!=63 && u[e]!=35){e=e+1;}
    if(e<=s){return "";}
    let at:i32=e-1;
    while(at>=s && u[at]!=64){at=at-1;}
    if(at>=s){s=at+1;}
    if(s>=e){return "";}
    let hs:i32=s;
    let he:i32=e;
    if(u[s]==91){
        let c:i32=s+1;
        while(c<e && u[c]!=93){c=c+1;}
        if(c>=e){return "";}
        hs=s+1;
        he=c;
    }else{
        let c2:i32=e-1;
        while(c2>=s && u[c2]!=58){c2=c2-1;}
        if(c2>=s){
            let ok:i32=1;
            let d:i32=c2+1;
            if(d>=e){ok=0;}
            while(d<e){
                if(is_digit(u[d])==0){ok=0; break;}
                d=d+1;
            }
            if(ok==1){he=c2;}
        }
    }
    if(he<=hs){return "";}
    if(u[he-1]==46){he=he-1;}
    if(he<=hs){return "";}
    let o:i32=0;
    let k:i32=hs;
    while(k<he){
        let c:u8=u[k];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        let cc:i32=c as i32;
        let ok2:i32=0;
        if((cc>=97 && cc<=122) || (cc>=48 && cc<=57) || cc==45 || cc==46 || cc==95 || cc==58){ok2=1;}
        if(ok2==0){return "";}
        if(o>=sc.len){return "";}
        sc[o]=c;
        o=o+1;
        k=k+1;
    }
    return sc[0..o];
}

// ---------------- HL-6: main-text-only extraction ----------------
fn tag_in(name:[]u8,a:[]u8,b:[]u8,c:[]u8,d:[]u8,e:[]u8,f:[]u8,g:[]u8,h:[]u8)i32 {
    if(nio_equal(name,a)==1){return 1;}
    if(nio_equal(name,b)==1){return 1;}
    if(nio_equal(name,c)==1){return 1;}
    if(nio_equal(name,d)==1){return 1;}
    if(nio_equal(name,e)==1){return 1;}
    if(nio_equal(name,f)==1){return 1;}
    if(nio_equal(name,g)==1){return 1;}
    if(nio_equal(name,h)==1){return 1;}
    return 0;
}

fn is_drop_tag(name:[]u8)i32 {
    return tag_in(name,"script","style","noscript","template","iframe","object","embed","head");
}
fn is_chrome_tag(name:[]u8)i32 {
    return tag_in(name,"footer","nav","aside","","","","","");
}
fn is_void_tag(name:[]u8)i32 {
    return tag_in(name,"br","hr","img","meta","link","input","wbr","source");
}
fn is_block_tag(name:[]u8)i32 {
    if(tag_in(name,"p","div","li","br","hr","article","section","tr")==1){return 1;}
    if(tag_in(name,"h1","h2","h3","h4","h5","h6","","")==1){return 1;}
    return tag_in(name,"blockquote","pre","ul","ol","table","","","");
}

fn attr_has(inner:[]u8,name:[]u8)i32 {
    let p:i32=find_sub(inner,name,0);
    while(p>=0){
        let bok:i32=0;
        if(p==0){bok=1;}
        if(p>0){
            let b:u8=inner[p-1];
            if(b==32 || b==9 || b==10 || b==13){bok=1;}
        }
        let aft:i32=p+name.len;
        let aok:i32=0;
        if(aft>=inner.len){aok=1;}
        if(aft<inner.len){
            let a2:u8=inner[aft];
            if(a2==32 || a2==9 || a2==10 || a2==13 || a2==61 || a2==62 || a2==47){aok=1;}
        }
        if(bok==1 && aok==1){return 1;}
        p=find_sub(inner,name,p+1);
    }
    return 0;
}

fn attr_val(inner:[]u8,aname:[]u8)[]u8 {
    let pat:[]u8=nio_alloc(aname.len+2);
    if(pat.len==0){return "";}
    let k:i32=0;
    while(k<aname.len){pat[k]=aname[k]; k=k+1;}
    pat[aname.len]=61;
    let p:i32=find_sub(inner,pat[0..aname.len+1],0);
    nio_free(pat);
    if(p<0){return "";}
    let v:i32=p+aname.len+1;
    while(v<inner.len && inner[v]==32){v=v+1;}
    if(v>=inner.len){return "";}
    if(inner[v]==34 || inner[v]==39){
        let qc:u8=inner[v];
        let e:i32=v+1;
        while(e<inner.len && inner[e]!=qc){e=e+1;}
        return inner[v+1..e];
    }
    let e2:i32=v;
    while(e2<inner.len && inner[e2]!=32 && inner[e2]!=9 && inner[e2]!=10 && inner[e2]!=13 && inner[e2]!=62){e2=e2+1;}
    return inner[v..e2];
}

fn attr_drop(inner:[]u8)i32 {
    if(attr_has(inner,"hidden")==1){return 1;}
    let ah:[]u8=attr_val(inner,"aria-hidden");
    if(nio_equal(ah,"true")==1){return 1;}
    let st:[]u8=attr_val(inner,"style");
    if(bsub(st,"display:none")==1){return 1;}
    if(bsub(st,"display: none")==1){return 1;}
    if(bsub(st,"visibility:hidden")==1){return 1;}
    if(bsub(st,"visibility: hidden")==1){return 1;}
    let cl:[]u8=attr_val(inner,"class");
    if(bsub(cl,"comment")==1){return 1;}
    if(bsub(cl,"sidebar")==1){return 1;}
    if(bsub(cl,"widget")==1){return 1;}
    let id:[]u8=attr_val(inner,"id");
    if(bsub(id,"comment")==1){return 1;}
    if(bsub(id,"sidebar")==1){return 1;}
    if(bsub(id,"widget")==1){return 1;}
    let ro:[]u8=attr_val(inner,"role");
    if(nio_equal(ro,"navigation")==1){return 1;}
    if(nio_equal(ro,"complementary")==1){return 1;}
    if(nio_equal(ro,"contentinfo")==1){return 1;}
    if(nio_equal(ro,"banner")==1){return 1;}
    return 0;
}

fn lb_append(lb:[]u8,llen:*i32,c:u8)void {
    if(llen[0]<lb.len){lb[llen[0]]=c; llen[0]=llen[0]+1;}
    return;
}

fn flush_line(lb:[]u8,llen:*i32,ob:[]u8,op:*i32)void {
    while(llen[0]>0 && lb[llen[0]-1]==32){llen[0]=llen[0]-1;}
    if(llen[0]>0){
        emit(ob,op,"T|");
        emit(ob,op,lb[0..llen[0]]);
        emit_nl(ob,op);
    }
    llen[0]=0;
    return;
}

// buf[i]=='&' → decode entity into lb; returns index just past ';' (or i+1)
fn emit_entity(buf:[]u8,i:i32,lb:[]u8,llen:*i32)i32 {
    let j:i32=i+1;
    while(j<buf.len && buf[j]!=59 && j-i<14){j=j+1;}
    if(j>=buf.len || buf[j]!=59){
        lb_append(lb,llen,38);
        return i+1;
    }
    let nm:[]u8=buf[i+1..j];
    if(nio_equal(nm,"amp")==1){lb_append(lb,llen,38); return j+1;}
    if(nio_equal(nm,"lt")==1){lb_append(lb,llen,60); return j+1;}
    if(nio_equal(nm,"gt")==1){lb_append(lb,llen,62); return j+1;}
    if(nio_equal(nm,"quot")==1){lb_append(lb,llen,34); return j+1;}
    if(nio_equal(nm,"apos")==1){lb_append(lb,llen,39); return j+1;}
    if(nio_equal(nm,"nbsp")==1){lb_append(lb,llen,194); lb_append(lb,llen,160); return j+1;}
    if(nm.len>1 && nm[0]==35){
        let v:i64=0;
        let k:i32=1;
        let hex:i32=0;
        if(nm.len>2 && (nm[1]==120 || nm[1]==88)){hex=1; k=2;}
        let ok:i32=1;
        while(k<nm.len){
            let d:u8=nm[k];
            let dv:i32=-1;
            if(d>=48 && d<=57){dv=(d as i32)-48;}
            if(hex==1 && d>=97 && d<=102){dv=(d as i32)-87;}
            if(hex==1 && d>=65 && d<=70){dv=(d as i32)-55;}
            if(dv<0){ok=0; break;}
            if(hex==1){v=v*16+(dv as i64);}
            if(hex==0){v=v*10+(dv as i64);}
            if(v>1114111){ok=0; break;}
            k=k+1;
        }
        if(ok==1 && v>=1 && v<=65535 && (v<55296 || v>57343)){
            if(v<128){lb_append(lb,llen,v as u8);}
            if(v>=128 && v<2048){
                lb_append(lb,llen,((v>>6)|192) as u8);
                lb_append(lb,llen,((v&63)|128) as u8);
            }
            if(v>=2048){
                lb_append(lb,llen,((v>>12)|224) as u8);
                lb_append(lb,llen,(((v>>6)&63)|128) as u8);
                lb_append(lb,llen,((v&63)|128) as u8);
            }
            return j+1;
        }
    }
    let q:i32=i;
    while(q<=j){lb_append(lb,llen,buf[q]); q=q+1;}
    return j+1;
}

fn do_close(nm:[]u8,stk:[]u8,depth:*i32,dropc:*i32,lb:[]u8,llen:*i32,ob:[]u8,op:*i32)void {
    if(depth[0]>0){
        depth[0]=depth[0]-1;
        if(g32(stk,depth[0]*4)==1){dropc[0]=dropc[0]-1;}
    }
    if(dropc[0]==0 && is_block_tag(nm)==1 && llen[0]>0){flush_line(lb,llen,ob,op);}
    return;
}

fn do_open(buf:[]u8,j2:i32,e5:i32,nm:[]u8,stk:[]u8,depth:*i32,dropc:*i32,lb:[]u8,llen:*i32,ob:[]u8,op:*i32)void {
    let inner:[]u8=lower_copy(buf[j2..e5]);
    let selfclose:i32=0;
    if(e5>j2 && buf[e5-1]==47){selfclose=1;}
    if(is_void_tag(nm)==1){selfclose=1;}
    let dr:i32=0;
    if(is_drop_tag(nm)==1){dr=1;}
    if(dr==0 && is_chrome_tag(nm)==1){dr=1;}
    if(dr==0 && attr_drop(inner)==1){dr=1;}
    if(dropc[0]==0 && dr==0 && is_block_tag(nm)==1 && llen[0]>0){flush_line(lb,llen,ob,op);}
    if(selfclose==0){
        if(depth[0]<64){
            p32(stk,depth[0]*4,dr);
            depth[0]=depth[0]+1;
            if(dr==1){dropc[0]=dropc[0]+1;}
        }
    }
    if(selfclose==1 && dropc[0]==0 && dr==0 && nio_equal(nm,"br")==1 && llen[0]>0){
        flush_line(lb,llen,ob,op);
    }
    nio_free(inner);
    return;
}

// handle '<' at buf[i]; returns new i
fn handle_lt(buf:[]u8,i:i32,stk:[]u8,depth:*i32,dropc:*i32,lb:[]u8,llen:*i32,ob:[]u8,op:*i32)i32 {
    if(i+3<buf.len && buf[i+1]==33 && buf[i+2]==45 && buf[i+3]==45){
        let e:i32=find_sub(buf,"-->",i+4);
        if(e<0){return buf.len;}
        return e+3;
    }
    if(i+1<buf.len && buf[i+1]==33){
        let e2:i32=find_sub(buf,">",i+2);
        if(e2<0){return buf.len;}
        return e2+1;
    }
    if(i+1<buf.len && buf[i+1]==63){
        let e3:i32=find_sub(buf,">",i+2);
        if(e3<0){return buf.len;}
        return e3+1;
    }
    if(i+1<buf.len && buf[i+1]==47){
        let j:i32=i+2;
        let ns:i32=j;
        while(j<buf.len && buf[j]!=32 && buf[j]!=9 && buf[j]!=10 && buf[j]!=13 && buf[j]!=62 && buf[j]!=47){j=j+1;}
        let nm:[]u8=lower_copy(buf[ns..j]);
        let e4:i32=find_sub(buf,">",j);
        let ni:i32=buf.len;
        if(e4>=0){ni=e4+1;}
        do_close(nm,stk,depth,dropc,lb,llen,ob,op);
        nio_free(nm);
        return ni;
    }
    let j2:i32=i+1;
    let ns2:i32=j2;
    while(j2<buf.len && buf[j2]!=32 && buf[j2]!=9 && buf[j2]!=10 && buf[j2]!=13 && buf[j2]!=62 && buf[j2]!=47){j2=j2+1;}
    let nm2:[]u8=lower_copy(buf[ns2..j2]);
    let e5:i32=j2;
    let qc:u8=0;
    while(e5<buf.len){
        let ch:u8=buf[e5];
        if(qc==0 && (ch==34 || ch==39)){qc=ch;}
        if(qc!=0 && ch==qc){qc=0;}
        if(qc==0 && ch==62){break;}
        e5=e5+1;
    }
    do_open(buf,j2,e5,nm2,stk,depth,dropc,lb,llen,ob,op);
    nio_free(nm2);
    if(e5<buf.len){return e5+1;}
    return buf.len;
}

fn run_extract(path:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let lb:[]u8=nio_alloc(65536);
    let llen:i32=0;
    let stk:[]u8=nio_alloc(64*4);
    let depth:i32=0;
    let dropc:i32=0;
    let pend:i32=0;
    let i:i32=0;
    while(i<buf.len){
        let c:u8=buf[i];
        if(c==60){
            if(i+1<buf.len){
                i=handle_lt(buf,i,stk,&depth,&dropc,lb,&llen,ob,op);
                pend=0;
            }
            if(i+1>=buf.len && c==60){i=i+1;}
        }
        if(c!=60){
            if(dropc==0){
                if(c==38){
                    if(pend==1 && llen>0){lb_append(lb,&llen,32);}
                    pend=0;
                    i=emit_entity(buf,i,lb,&llen);
                }
                if(c!=38){
                    if(is_space(c)==1){pend=1;}
                    if(is_space(c)==0){
                        if(pend==1 && llen>0){lb_append(lb,&llen,32); pend=0;}
                        if(pend==1 && llen==0){pend=0;}
                        lb_append(lb,&llen,c);
                        if(llen>=65530){flush_line(lb,&llen,ob,op);}
                    }
                    i=i+1;
                }
            }
            if(dropc!=0){i=i+1;}
        }
    }
    if(llen>0){flush_line(lb,&llen,ob,op);}
    nio_free(lb);
    nio_free(stk);
    return 0;
}

// ---------------- HL-7: conservative normalization ----------------
fn norm_copy(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+16);
    if(b.len==0){return b;}
    let o:i32=0;
    let pend:i32=0;
    let started:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<128){
            if(c==9 || c==10 || c==13){pend=1;}
            if(c!=9 && c!=10 && c!=13){
                if(c<32 || c==127){
                    // strip control
                }
                if(c>=32 && c!=127){
                    let d:u8=c;
                    if(d>=65 && d<=90){d=(d as i32+32) as u8;}
                    if(pend==1 && started==1){b[o]=32; o=o+1;}
                    pend=0;
                    b[o]=d; o=o+1;
                    started=1;
                }
            }
            i=i+1;
        }
        if(c>=128){
            let zw:i32=0;
            if(i+2<s.len && s[i]==226 && s[i+1]==128 && s[i+2]>=139 && s[i+2]<=141){zw=1;}
            if(i+2<s.len && s[i]==226 && s[i+1]==129 && s[i+2]==160){zw=1;}
            if(i+2<s.len && s[i]==239 && s[i+1]==187 && s[i+2]==191){zw=1;}
            if(zw==1){i=i+3;}
            if(zw==0){
                if(pend==1 && started==1){b[o]=32; o=o+1;}
                pend=0;
                b[o]=c; o=o+1;
                started=1;
                i=i+1;
            }
        }
    }
    return b[0..o];
}

fn run_norm(path:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let n:[]u8=norm_copy(buf[ls..ls+ll]);
        emit(ob,op,"N|");
        emit(ob,op,n);
        emit_nl(ob,op);
        nio_free(n);
    }
    return 0;
}

fn abbrev_data()[]u8 {
    return "dr|mr|mrs|ms|st|jr|sr|prof|gen|rep|sen|sgt|lt|capt|col|vs|etc|inc|ltd|co|corp|no|ave|blvd|rd|mt|dept|univ";
}

fn is_abbrev(tok:[]u8)i32 {
    let d:[]u8=abbrev_data();
    let s:i32=0;
    let i:i32=0;
    while(i<=d.len){
        if(i==d.len || d[i]==124){
            if(nio_equal(d[s..i],tok)==1){return 1;}
            s=i+1;
        }
        i=i+1;
    }
    return 0;
}

fn emit_sent(txt:[]u8,s:i32,e:i32,ob:[]u8,op:*i32)void {
    while(s<e && is_space(txt[s])==1){s=s+1;}
    while(e>s && is_space(txt[e-1])==1){e=e-1;}
    if(e>s){
        emit(ob,op,"S|");
        emit(ob,op,txt[s..e]);
        emit_nl(ob,op);
    }
    return;
}

fn run_sentsplit(path:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let txt:[]u8=nio_alloc(262144);
    if(txt.len==0){return 2;}
    let tl:i32=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        if(tl>0 && tl<txt.len){txt[tl]=32; tl=tl+1;}
        let k:i32=0;
        while(k<ll && tl<txt.len){txt[tl]=buf[ls+k]; tl=tl+1; k=k+1;}
    }
    let n:i32=tl;
    let start:i32=0;
    let i:i32=0;
    while(i<n){
        let c:u8=txt[i];
        if(c==46 || c==33 || c==63){
            let j:i32=i;
            let alldots:i32=1;
            while(j<n && (txt[j]==46 || txt[j]==33 || txt[j]==63)){
                if(txt[j]!=46){alldots=0;}
                j=j+1;
            }
            let can:i32=1;
            if(alldots==1){
                if(i>0 && j<n && is_digit(txt[i-1])==1 && is_digit(txt[j])==1){can=0;}
                if(can==1){
                    let k2:i32=i-1;
                    while(k2>=start && is_alpha(txt[k2])==1){k2=k2-1;}
                    let tok:[]u8=lower_copy(txt[k2+1..i]);
                    if(tok.len>0 && is_abbrev(tok)==1){can=0;}
                    nio_free(tok);
                }
            }
            if(can==1){
                let m:i32=j;
                while(m<n && (txt[m]==34 || txt[m]==39 || txt[m]==41 || txt[m]==93 || txt[m]==125)){m=m+1;}
                let t:i32=m;
                while(t<n && is_space(txt[t])==1){t=t+1;}
                let sp:i32=0;
                if(t>=n){sp=1;}
                if(t<n && (is_upper(txt[t])==1 || is_digit(txt[t])==1)){sp=1;}
                if(sp==1){
                    emit_sent(txt,start,j,ob,op);
                    start=t;
                    i=t;
                }
                if(sp==0){i=j;}
            }
            if(can==0){i=j;}
        }
        if(c!=46 && c!=33 && c!=63){i=i+1;}
    }
    emit_sent(txt,start,n,ob,op);
    nio_free(txt);
    return 0;
}

// ---------------- shared: bar-split ----------------
fn split_bar(line:[]u8,fa:[]u8,cap:i32)i32 {
    let nf:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<=line.len){
        if(i==line.len || line[i]==124){
            if(nf<cap){p32(fa,nf*8,s); p32(fa,nf*8+4,i-s); nf=nf+1;}
            s=i+1;
        }
        i=i+1;
    }
    return nf;
}

fn fld(line:[]u8,fa:[]u8,k:i32)[]u8 {
    let o:i32=g32(fa,k*8);
    let l:i32=g32(fa,k*8+4);
    return line[o..o+l];
}

// ---------------- HL-8: redirect attribution ----------------
fn run_attr(path:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let da:[]u8=nio_alloc(65536);
    let dpos:i32=0;
    let dt:[]u8=nio_alloc(128*8);
    let nd:i32=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    let fa:[]u8=nio_alloc(32*8);
    let sch1:[]u8=nio_alloc(1024);
    let sch2:[]u8=nio_alloc(1024);
    let sch3:[]u8=nio_alloc(1024);
    let sch4:[]u8=nio_alloc(1024);
    while(next_line(buf,&pos,&ls,&ll)==1){
        let line:[]u8=buf[ls..ls+ll];
        let nf:i32=split_bar(line,fa,32);
        if(nf<3){continue;}
        if(nio_equal(fld(line,fa,0),"C")==0){continue;}
        let pid:[]u8=fld(line,fa,1);
        let nurls:i32=nf-2;
        let hf:[]u8=url_host(fld(line,fa,2),sch1);
        let he:[]u8=url_host(fld(line,fa,nf-1),sch2);
        emit(ob,op,"A|");
        emit(ob,op,pid);
        emit(ob,op,"|");
        emit(ob,op,he);
        emit(ob,op,"|");
        if(he.len==0){
            emit(ob,op,"|hops=");
            emit_i64(ob,op,(nurls-1) as i64);
            emit(ob,op,"|xreg=0");
            emit_nl(ob,op);
        }
        if(he.len>0){
            let rdf:[]u8=regdom(he,sch3);
            emit(ob,op,rdf);
            emit(ob,op,"|hops=");
            emit_i64(ob,op,(nurls-1) as i64);
            emit(ob,op,"|xreg=");
            let xr:i32=0;
            if(hf.len>0){
                let rd1:[]u8=regdom(hf,sch4);
                if(nio_equal(rd1,rdf)==0){xr=1;}
            }
            emit_i64(ob,op,xr as i64);
            emit_nl(ob,op);
            let f:i32=0;
            while(f<nd){
                let eo:i32=g32(dt,f*8);
                let el:i32=g32(dt,f*8+4);
                if(nio_equal(da[eo..eo+el],rdf)==1){break;}
                f=f+1;
            }
            if(f>=nd && nd<128 && dpos+rdf.len<=da.len){
                let q:i32=0;
                while(q<rdf.len){da[dpos+q]=rdf[q]; q=q+1;}
                p32(dt,nd*8,dpos);
                p32(dt,nd*8+4,rdf.len);
                dpos=dpos+rdf.len;
                nd=nd+1;
            }
        }
    }
    // canonical sort of distinct regdoms
    let idx:[]u8=nio_alloc(128*4);
    let a:i32=0;
    while(a<nd){p32(idx,a*4,a); a=a+1;}
    let b2:i32=1;
    while(b2<nd){
        let key:i32=g32(idx,b2*4);
        let ko:i32=g32(dt,key*8);
        let kl:i32=g32(dt,key*8+4);
        let c2:i32=b2-1;
        while(c2>=0){
            let co:i32=g32(dt,g32(idx,c2*4)*8);
            let cl:i32=g32(dt,g32(idx,c2*4)*8+4);
            if(bcmp(da[co..co+cl],da[ko..ko+kl])<=0){break;}
            p32(idx,(c2+1)*4,g32(idx,c2*4));
            c2=c2-1;
        }
        p32(idx,(c2+1)*4,key);
        b2=b2+1;
    }
    emit(ob,op,"Q|distinct_final_regdoms=");
    emit_i64(ob,op,nd as i64);
    emit_nl(ob,op);
    let s2:i32=0;
    while(s2<nd){
        let so:i32=g32(dt,g32(idx,s2*4)*8);
        let sl:i32=g32(dt,g32(idx,s2*4)*8+4);
        emit(ob,op,"QV|");
        emit(ob,op,da[so..so+sl]);
        emit_nl(ob,op);
        s2=s2+1;
    }
    nio_free(da);
    nio_free(dt);
    nio_free(fa);
    nio_free(sch1);
    nio_free(sch2);
    nio_free(sch3);
    nio_free(sch4);
    nio_free(idx);
    return 0;
}

// ---------------- HL-9: platform-suffix independence ----------------
fn run_plat(path:[]u8,claim:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let nclaim:[]u8=norm_copy(claim);
    let ca:[]u8=nio_alloc(65536);
    let cpos:i32=0;
    let ct:[]u8=nio_alloc(128*8);
    let cf:[]u8=nio_alloc(128*4);
    let cv:[]u8=nio_alloc(128*4);
    let nc:i32=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    let fa:[]u8=nio_alloc(32*8);
    let kb:[]u8=nio_alloc(1024);
    let sc:[]u8=nio_alloc(1024);
    while(next_line(buf,&pos,&ls,&ll)==1){
        let line:[]u8=buf[ls..ls+ll];
        let nf:i32=split_bar(line,fa,32);
        if(nf<4){continue;}
        if(nio_equal(fld(line,fa,0),"V")==0){continue;}
        let ns:[]u8=norm_copy(fld(line,fa,3));
        let match:i32=nio_equal(ns,nclaim);
        nio_free(ns);
        if(match==0){continue;}
        let h:[]u8=lower_copy(fld(line,fa,2));
        let suf:[]u8=plat_suffix(h);
        let kl:i32=0;
        let plat:i32=0;
        if(suf.len>0){
            plat=1;
            kb[0]=80; kb[1]=124; kl=2;
            let q:i32=0;
            while(q<suf.len){kb[kl]=suf[q]; kl=kl+1; q=q+1;}
            kb[kl]=124; kl=kl+1;
            let acc:[]u8=plat_account(h,suf);
            q=0;
            while(q<acc.len){kb[kl]=acc[q]; kl=kl+1; q=q+1;}
        }
        if(suf.len==0){
            let rd:[]u8=regdom(h,sc);
            kb[0]=68; kb[1]=124; kl=2;
            let q2:i32=0;
            while(q2<rd.len){kb[kl]=rd[q2]; kl=kl+1; q2=q2+1;}
        }
        let key:[]u8=kb[0..kl];
        let f:i32=0;
        while(f<nc){
            let eo:i32=g32(ct,f*8);
            let el:i32=g32(ct,f*8+4);
            if(nio_equal(ca[eo..eo+el],key)==1){break;}
            f=f+1;
        }
        let nc0:i32=nc;
        if(f>=nc){
            if(nc<128 && cpos+kl<=ca.len){
                let q3:i32=0;
                while(q3<kl){ca[cpos+q3]=kb[q3]; q3=q3+1;}
                p32(ct,nc*8,cpos);
                p32(ct,nc*8+4,kl);
                p32(cf,nc*4,plat);
                p32(cv,nc*4,1);
                cpos=cpos+kl;
                nc=nc+1;
            }
        }
        if(f<nc0){p32(cv,f*4,g32(cv,f*4)+1);}
        nio_free(h);
    }
    let idx:[]u8=nio_alloc(128*4);
    let a:i32=0;
    while(a<nc){p32(idx,a*4,a); a=a+1;}
    let b2:i32=1;
    while(b2<nc){
        let key2:i32=g32(idx,b2*4);
        let ko:i32=g32(ct,key2*8);
        let kll:i32=g32(ct,key2*8+4);
        let c2:i32=b2-1;
        while(c2>=0){
            let co:i32=g32(ct,g32(idx,c2*4)*8);
            let cl:i32=g32(ct,g32(idx,c2*4)*8+4);
            if(bcmp(ca[co..co+cl],ca[ko..ko+kll])<=0){break;}
            p32(idx,(c2+1)*4,g32(idx,c2*4));
            c2=c2-1;
        }
        p32(idx,(c2+1)*4,key2);
        b2=b2+1;
    }
    let npm:i32=0;
    let s2:i32=0;
    while(s2<nc){
        let ci:i32=g32(idx,s2*4);
        let so:i32=g32(ct,ci*8);
        let sl:i32=g32(ct,ci*8+4);
        let pf:i32=g32(cf,ci*4);
        if(pf==0){npm=npm+1;}
        emit(ob,op,"C|");
        emit(ob,op,ca[so..so+sl]);
        emit(ob,op,"|platform=");
        emit_i64(ob,op,pf as i64);
        emit(ob,op,"|votes=");
        emit_i64(ob,op,g32(cv,ci*4) as i64);
        emit_nl(ob,op);
        s2=s2+1;
    }
    emit(ob,op,"Q|clusters=");
    emit_i64(ob,op,nc as i64);
    emit(ob,op,"|nonplatform=");
    emit_i64(ob,op,npm as i64);
    emit(ob,op,"|verdict=");
    if(nc>=3 && npm>=1){emit(ob,op,"INSTALL");}
    if(nc<3 || npm<1){emit(ob,op,"WITHHOLD");}
    emit_nl(ob,op);
    nio_free(nclaim);
    nio_free(ca);
    nio_free(ct);
    nio_free(cf);
    nio_free(cv);
    nio_free(fa);
    nio_free(kb);
    nio_free(sc);
    nio_free(idx);
    return 0;
}

// ---------------- HL-10: mirror dedup w/ surrounding-text diversity ----------------
fn fnv_step(h:i64,b:u8)i64 {
    h=h^(b as i64);
    h=(h*16777619)%4294967296;
    return h;
}

// sorted unique 3-shingle set of surr into out (i32 via p32); returns count
fn shingle_set(surr:[]u8,out:[]u8)i32 {
    let wa:[]u8=nio_alloc(1024*8);
    let wb:[]u8=nio_alloc(16384);
    let wpos:i32=0;
    let nw:i32=0;
    let i:i32=0;
    while(i<surr.len){
        let c:u8=surr[i];
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            let st:i32=i;
            while(i<surr.len){
                let d:u8=surr[i];
                if(!((d>=97 && d<=122) || (d>=48 && d<=57))){break;}
                i=i+1;
            }
            let ln:i32=i-st;
            if(ln>=2 && nw<1024 && wpos+ln<=wb.len){
                let k:i32=0;
                while(k<ln){wb[wpos+k]=surr[st+k]; k=k+1;}
                p32(wa,nw*8,wpos);
                p32(wa,nw*8+4,ln);
                wpos=wpos+ln;
                nw=nw+1;
            }
        }
        if(!((c>=97 && c<=122) || (c>=48 && c<=57))){i=i+1;}
    }
    let nsh:i32=nw-2;
    if(nsh<0){nsh=0;}
    if(nsh>256){nsh=256;}
    let t:i32=0;
    while(t<nsh){
        let h:i64=2166136261;
        let w:i32=0;
        while(w<3){
            let wo:i32=g32(wa,(t+w)*8);
            let wl:i32=g32(wa,(t+w)*8+4);
            let k2:i32=0;
            while(k2<wl){h=fnv_step(h,wb[wo+k2]); k2=k2+1;}
            h=fnv_step(h,255);
            w=w+1;
        }
        p32(out,t*4,h as i32);
        t=t+1;
    }
    // insertion sort
    let b2:i32=1;
    while(b2<nsh){
        let kv:i32=g32(out,b2*4);
        let c2:i32=b2-1;
        while(c2>=0 && g32(out,c2*4)>kv){
            p32(out,(c2+1)*4,g32(out,c2*4));
            c2=c2-1;
        }
        p32(out,(c2+1)*4,kv);
        b2=b2+1;
    }
    // unique
    let u:i32=0;
    let r:i32=0;
    while(r<nsh){
        let v:i32=g32(out,r*4);
        if(u==0 || v!=g32(out,(u-1)*4)){p32(out,u*4,v); u=u+1;}
        r=r+1;
    }
    nio_free(wa);
    nio_free(wb);
    return u;
}

// Jaccard >= 0.5 computed exactly as 2*inter >= union
fn jacc_merge(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
    let i2:i32=0;
    let j2:i32=0;
    let inter:i32=0;
    while(i2<na && j2<nb){
        let x:i32=g32(a,i2*4);
        let y:i32=g32(b,j2*4);
        if(x==y){inter=inter+1; i2=i2+1; j2=j2+1;}
        if(x<y){i2=i2+1;}
        if(x>y){j2=j2+1;}
    }
    let u:i32=na+nb-inter;
    if(u==0){return 1;}
    if(2*inter>=u){return 1;}
    return 0;
}

fn uf_find(p:[]u8,x:i32)i32 {
    let r:i32=x;
    while(g32(p,r*4)!=r){r=g32(p,r*4);}
    return r;
}

fn run_dedup(path:[]u8,ob:[]u8,op:*i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(path,&ok);
    if(ok==0){return 2;}
    let pida:[]u8=nio_alloc(4096);
    let pt:[]u8=nio_alloc(64*8);
    let cla:[]u8=nio_alloc(65536);
    let clt:[]u8=nio_alloc(64*8);
    let sua:[]u8=nio_alloc(262144);
    let sut:[]u8=nio_alloc(64*8);
    let np:i32=0;
    let pid_used:i32=0;
    let clen_used:i32=0;
    let slen_used:i32=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    let fa:[]u8=nio_alloc(32*8);
    while(next_line(buf,&pos,&ls,&ll)==1){
        let line:[]u8=buf[ls..ls+ll];
        let nf:i32=split_bar(line,fa,32);
        if(nf<3){continue;}
        let tag:[]u8=fld(line,fa,0);
        let pid:[]u8=fld(line,fa,1);
        if(nio_equal(tag,"P")!=1 && nio_equal(tag,"H")!=1 && nio_equal(tag,"K")!=1 && nio_equal(tag,"X")!=1){continue;}
        let pi:i32=0;
        while(pi<np){
            let po:i32=g32(pt,pi*8);
            let pl:i32=g32(pt,pi*8+4);
            if(nio_equal(pida[po..po+pl],pid)==1){break;}
            pi=pi+1;
        }
        if(pi>=np){
            if(np>=64){continue;}
            if(pid_used+pid.len>pida.len){continue;}
            let w:i32=0;
            while(w<pid.len){pida[pid_used+w]=pid[w]; w=w+1;}
            p32(pt,np*8,pid_used);
            p32(pt,np*8+4,pid.len);
            pid_used=pid_used+pid.len;
            p32(clt,np*8,0);
            p32(clt,np*8+4,0);
            p32(sut,np*8,0);
            p32(sut,np*8+4,0);
            pi=np;
            np=np+1;
        }
        if(nio_equal(tag,"K")==1){
            let nc2:[]u8=norm_copy(fld(line,fa,2));
            if(clen_used+nc2.len<=cla.len){
                let w2:i32=0;
                while(w2<nc2.len){cla[clen_used+w2]=nc2[w2]; w2=w2+1;}
                p32(clt,pi*8,clen_used);
                p32(clt,pi*8+4,nc2.len);
                clen_used=clen_used+nc2.len;
            }
            nio_free(nc2);
        }
        if(nio_equal(tag,"X")==1){
            let ns2:[]u8=norm_copy(fld(line,fa,2));
            if(slen_used+ns2.len<=sua.len){
                let w3:i32=0;
                while(w3<ns2.len){sua[slen_used+w3]=ns2[w3]; w3=w3+1;}
                p32(sut,pi*8,slen_used);
                p32(sut,pi*8+4,ns2.len);
                slen_used=slen_used+ns2.len;
            }
            nio_free(ns2);
        }
    }
    // claim groups
    let ga:[]u8=nio_alloc(64*4);
    let ng:i32=0;
    let px:i32=0;
    while(px<np){
        let co:i32=g32(clt,px*8);
        let cl2:i32=g32(clt,px*8+4);
        let g:i32=0;
        while(g<ng){
            let rep:i32=g32(ga,g*4);
            let ro:i32=g32(clt,rep*8);
            let rl:i32=g32(clt,rep*8+4);
            if(nio_equal(cla[co..co+cl2],cla[ro..ro+rl])==1){break;}
            g=g+1;
        }
        if(g>=ng && ng<64){p32(ga,ng*4,px); ng=ng+1;}
        px=px+1;
    }
    let total:i32=0;
    let gid:i32=0;
    while(gid<ng){
        let mem:[]u8=nio_alloc(16*4);
        let nm:i32=0;
        let q5:i32=0;
        while(q5<np){
            let co2:i32=g32(clt,q5*8);
            let cl3:i32=g32(clt,q5*8+4);
            let rep2:i32=g32(ga,gid*4);
            let ro2:i32=g32(clt,rep2*8);
            let rl2:i32=g32(clt,rep2*8+4);
            if(nio_equal(cla[co2..co2+cl3],cla[ro2..ro2+rl2])==1){
                if(nm<16){p32(mem,nm*4,q5); nm=nm+1;}
            }
            q5=q5+1;
        }
        let parent:[]u8=nio_alloc(16*4);
        let u2:i32=0;
        while(u2<nm){p32(parent,u2*4,u2); u2=u2+1;}
        let sa:[]u8=nio_alloc(16*256*4);
        let sc2:[]u8=nio_alloc(16*4);
        let s3:i32=0;
        while(s3<nm){
            let pg:i32=g32(mem,s3*4);
            let so:i32=g32(sut,pg*8);
            let sl:i32=g32(sut,pg*8+4);
            let cnt:i32=shingle_set(sua[so..so+sl],sa[s3*1024..s3*1024+1024]);
            p32(sc2,s3*4,cnt);
            s3=s3+1;
        }
        let a2:i32=0;
        while(a2<nm){
            let b3:i32=a2+1;
            while(b3<nm){
                let na2:i32=g32(sc2,a2*4);
                let nb2:i32=g32(sc2,b3*4);
                if(jacc_merge(sa[a2*1024..a2*1024+1024],na2,sa[b3*1024..b3*1024+1024],nb2)==1){
                    let ra:i32=uf_find(parent,a2);
                    let rb:i32=uf_find(parent,b3);
                    if(ra!=rb){p32(parent,ra*4,rb);}
                }
                b3=b3+1;
            }
            a2=a2+1;
        }
        let ncomp:i32=0;
        let c4:i32=0;
        while(c4<nm){
            if(uf_find(parent,c4)==c4){ncomp=ncomp+1;}
            c4=c4+1;
        }
        total=total+ncomp;
        // emit G line
        let rep3:i32=g32(ga,gid*4);
        let rco:i32=g32(clt,rep3*8);
        let rcl:i32=g32(clt,rep3*8+4);
        let pv:i32=rcl;
        if(pv>48){pv=48;}
        emit(ob,op,"G|");
        emit_i64(ob,op,gid as i64);
        emit(ob,op,"|claim=");
        emit(ob,op,cla[rco..rco+pv]);
        emit(ob,op,"|votes=");
        emit_i64(ob,op,ncomp as i64);
        emit(ob,op,"|pids=");
        let m2:i32=0;
        while(m2<nm){
            if(m2>0){emit(ob,op,",");}
            let pg2:i32=g32(mem,m2*4);
            let po2:i32=g32(pt,pg2*8);
            let pl2:i32=g32(pt,pg2*8+4);
            emit(ob,op,pida[po2..po2+pl2]);
            m2=m2+1;
        }
        emit_nl(ob,op);
        nio_free(mem);
        nio_free(parent);
        nio_free(sa);
        nio_free(sc2);
        gid=gid+1;
    }
    emit(ob,op,"Q|groups=");
    emit_i64(ob,op,ng as i64);
    emit(ob,op,"|surviving_votes=");
    emit_i64(ob,op,total as i64);
    emit(ob,op,"|verdict=");
    if(total>=3){emit(ob,op,"INSTALL");}
    if(total<3){emit(ob,op,"WITHHOLD");}
    emit_nl(ob,op);
    nio_free(pida);
    nio_free(pt);
    nio_free(cla);
    nio_free(clt);
    nio_free(sua);
    nio_free(sut);
    nio_free(fa);
    nio_free(ga);
    return 0;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    let ob:[]u8=nio_alloc(4194304);
    if(ob.len==0){return 2;}
    let op:i32=0;
    let rc:i32=2;
    if(nio_equal(m,"extract")==1){
        let p1:[]u8=_zag_arg(2);
        if(p1.len==0){rc=2;}
        if(p1.len>0){rc=run_extract(p1,ob,&op);}
    }
    if(nio_equal(m,"norm")==1){
        let p2:[]u8=_zag_arg(2);
        if(p2.len==0){rc=2;}
        if(p2.len>0){rc=run_norm(p2,ob,&op);}
    }
    if(nio_equal(m,"sentsplit")==1){
        let p3:[]u8=_zag_arg(2);
        if(p3.len==0){rc=2;}
        if(p3.len>0){rc=run_sentsplit(p3,ob,&op);}
    }
    if(nio_equal(m,"attr")==1){
        let p4:[]u8=_zag_arg(2);
        if(p4.len==0){rc=2;}
        if(p4.len>0){rc=run_attr(p4,ob,&op);}
    }
    if(nio_equal(m,"plat")==1){
        let p5:[]u8=_zag_arg(2);
        let cl:[]u8=_zag_arg(3);
        if(p5.len==0 || cl.len==0){rc=2;}
        if(p5.len>0 && cl.len>0){rc=run_plat(p5,cl,ob,&op);}
    }
    if(nio_equal(m,"dedup")==1){
        let p6:[]u8=_zag_arg(2);
        if(p6.len==0){rc=2;}
        if(p6.len>0){rc=run_dedup(p6,ob,&op);}
    }
    let off:i32=0;
    while(off<op){
        let nn2:i32=op-off;
        if(nn2>65536){nn2=65536;}
        _zag_print(ob[off..off+nn2]);
        off=off+nn2;
    }
    return rc;
}

// d4_triple.zag -- D4 triple/predicate-level comparison primitive.
//
// Frozen mechanism (PREREG_LI_D4.md §2, App. A). Deterministic, zero RNG.
// Morphology only: form->stem table maps inflections to their OWN lemma;
// no cross-lemma synonymy (spin!=rotate, possess!=have).
//
// triple_key(S): (predicate-stem, sorted-subject-tokens, sorted-object-tokens)
//   or "" (fail closed) when no well-formed verb exists.
// d4_keys_mergeable: same stem AND argument sets equal, up to active/passive
//   diathesis swap. Empty keys never merge.

// ---- frozen tables (App. A) ----
fn d4_glue()[]u8 {
    return "a an the of at in on to for and or but nor so yet as by with from into over under between through during before after above below up down out off about against among around behind beyond plus except per via versus within without along across onto upon toward towards this that these those it its they them their he she we you i me him her us our your his my mine yours hers theirs ours which who whom whose there here then than too very just only also even still already quite rather almost nearly";
}

fn d4_verbs()[]u8 {
    return "am:be is:be are:be was:be were:be be:be been:be being:be has:have have:have had:have having:have do:do does:do did:do done:do doing:do will:will would:will can:can could:can shall:shall should:shall may:may might:may must:must make:make makes:make made:make making:make take:take takes:take took:take taken:take taking:take give:give gives:give gave:give given:give giving:give contain:contain contains:contain contained:contain containing:contain include:include includes:include included:include including:include hold:hold holds:hold held:hold holding:hold reach:reach reaches:reach reached:reach reaching:reach measure:measure measures:measure measured:measure measuring:measure weigh:weigh weighs:weigh weighed:weigh weighing:weigh stand:stand stands:stand stood:stand standing:stand span:span spans:span spanned:span spanning:span cover:cover covers:cover covered:cover covering:cover last:last lasts:last lasted:last lasting:last cost:cost costs:cost costing:cost run:run runs:run ran:run running:run live:live lives:live lived:live living:live spin:spin spins:spin spun:spin spinning:spin rotate:rotate rotates:rotate rotated:rotate rotating:rotate orbit:orbit orbits:orbit orbited:orbit orbiting:orbit boil:boil boils:boil boiled:boil boiling:boil freeze:freeze freezes:freeze froze:freeze frozen:freeze freezing:freeze melt:melt melts:melt melted:melt melting:melt grow:grow grows:grow grew:grow grown:grow growing:grow begin:begin begins:begin began:begin begun:begin beginning:begin become:become becomes:become became:become becoming:become date:date dates:date dated:date dating:date mark:mark marks:mark marked:mark marking:mark carry:carry carries:carry carried:carry carrying:carry store:store stores:store stored:store storing:store back:back backs:back backed:back backing:back join:join joins:join joined:join joining:join enter:enter enters:enter entered:enter entering:enter gain:gain gains:gain gained:gain gaining:gain create:create creates:create created:create creating:create mint:mint mints:mint minted:mint minting:mint serve:serve serves:serve served:serve serving:serve exist:exist exists:exist existed:exist existing:exist appear:appear appears:appear appeared:appear appearing:appear remain:remain remains:remain remained:remain remaining:remain stay:stay stays:stay stayed:stay staying:stay form:form forms:form formed:form forming:form produce:produce produces:produce produced:produce producing:produce beat:beat beats:beat beaten:beat beating:beat win:win wins:win won:win winning:win lose:lose loses:lose lost:lose losing:lose host:host hosts:host hosted:host hosting:host plan:plan plans:plan planned:plan planning:plan slate:slate slates:slate slated:slate slating:slate see:see sees:see saw:see seen:see seeing:see show:show shows:show showed:show shown:show showing:show shown:show say:say says:say said:say saying:say report:report reports:report reported:report reporting:report find:find finds:find found:find finding:find use:use uses:use used:use using:use require:require requires:require required:require requiring:require cause:cause causes:cause caused:cause causing:cause lead:lead leads:lead led:lead leading:lead fall:fall falls:fall fell:fall fallen:fall falling:fall rise:rise rises:rise rose:rise risen:rise rising:rise drop:drop drops:drop dropped:drop dropping:drop happen:happen happens:happen happened:happen happening:happen occur:occur occurs:occur occurred:occur occurring:occur change:change changes:change changed:change changing:change come:come comes:come came:come coming:come go:go goes:go went:go gone:go going:go write:write writes:write wrote:write written:write writing:write build:build builds:build built:build building:build die:die dies:die died:die dying:die kill:kill kills:kill killed:kill killing:kill eat:eat eats:eat ate:eat eaten:eat eating:eat fly:fly flies:fly flew:fly flown:fly flying:fly possess:possess possesses:possess possessed:possess possessing:possess own:own owns:own owned:own owning:own need:need needs:need needed:need needing:need call:call calls:call called:call calling:call set:set sets:set setting:set keep:keep keeps:keep kept:keep keeping:keep send:send sends:send sent:send sent:send sending:send break:break breaks:break broke:break broken:break breaking:break open:open opens:open opened:open opening:open close:close closes:close closed:close closing:close start:start starts:start started:start starting:start stop:stop stops:stop stopped:stop stopping:stop end:end ends:end ended:end ending:end turn:turn turns:turn turned:turn turning:turn move:move moves:move moved:move moving:move launch:launch launches:launch launched:launch launching:launch deploy:deploy deploys:deploy deployed:deploy deploying:deploy record:record records:record recorded:record recording:record score:score scores:score scored:score scoring:score spoil:spoil spoils:spoil spoiled:spoil spoiling:spoil expire:expire expires:expire expired:expire expiring:expire count:count counts:count counted:count counting:count welcome:welcome welcomes:welcome welcomed:welcome welcoming:welcome bear:bear bears:bear bore:bear born:bear borne:bear bearing:bear lie:lie lies:lie lay:lie lain:lie lying:lie think:think thinks:think thought:think thinking:think believe:believe believes:believe believed:believe believing:believe know:know knows:know knew:know known:know knowing:know tell:tell tells:tell told:tell telling:tell speak:speak speaks:speak spoke:speak spoken:speak speaking:speak enumerate:enumerate enumerates:enumerate enumerated:enumerate enumerating:enumerate govern:govern governs:govern governed:govern governing:govern fuse:fuse fuses:fuse fused:fuse fusing:fuse manufacture:manufacture manufactures:manufacture manufactured:manufacture manufacturing:manufacture provide:provide provides:provide provided:provide providing:provide transmit:transmit transmits:transmit transmitted:transmit transmitting:transmit evolve:evolve evolves:evolve evolved:evolve evolving:evolve perform:perform performs:perform performed:perform performing:perform communicate:communicate communicates:communicate communicated:communicate communicating:communicate expand:expand expands:expand expanded:expand expanding:expand invent:invent invents:invent invented:invent inventing:invent transform:transform transforms:transform transformed:transform transforming:transform flow:flow flows:flow flowed:flow flowing:flow detect:detect detects:detect detected:detect detecting:detect register:register registers:register registered:register registering:register predate:predate predates:predate predated:predate predating:predate rank:rank ranks:rank ranked:rank ranking:rank hide:hide hides:hide hid:hide hidden:hide hiding:hide bury:bury buries:bury buried:bury burying:bury approach:approach approaches:approach approached:approach approaching:approach subject:subject subjects:subject subjected:subject subjecting:subject";
}

// whole-word membership of tb[to..to+tl] in space-separated list
fn d4_word_in(tb:[]u8,to:i32,tl:i32,lst:[]u8)i32 {
    let i:i32=0;
    while(i<lst.len){
        while(i<lst.len && lst[i]==32){i=i+1;}
        if(i>=lst.len){break;}
        let st:i32=i;
        while(i<lst.len && lst[i]!=32){i=i+1;}
        let ln:i32=i-st;
        if(ln==tl && bsub_eq(lst,st,tb,to,tl)==1){return 1;}
    }
    return 0;
}

// form->stem lookup; o_s/o_l = stem (start,len) into d4_verbs(); returns 1/0
fn d4_verb_stem(tb:[]u8,to:i32,tl:i32,o_s:*i32,o_l:*i32)i32 {
    let lst:[]u8=d4_verbs();
    let i:i32=0;
    while(i<lst.len){
        while(i<lst.len && lst[i]==32){i=i+1;}
        if(i>=lst.len){break;}
        let st:i32=i;
        while(i<lst.len && lst[i]!=32 && lst[i]!=58){i=i+1;}
        let fl:i32=i-st;
        if(i<lst.len && lst[i]==58 && fl==tl && bsub_eq(lst,st,tb,to,tl)==1){
            let ss:i32=i+1;
            let se:i32=ss;
            while(se<lst.len && lst[se]!=32){se=se+1;}
            o_s[0]=ss;
            o_l[0]=se-ss;
            return 1;
        }
        while(i<lst.len && lst[i]!=32){i=i+1;}
    }
    return 0;
}

// 1 if token is content (not glue, not a verb form)
fn d4_is_content(tb:[]u8,to:i32,tl:i32)i32 {
    if(d4_word_in(tb,to,tl,d4_glue())==1){return 0;}
    let d1:i32=0;
    let d2:i32=0;
    if(d4_verb_stem(tb,to,tl,&d1,&d2)==1){return 0;}
    return 1;
}

// token compare: -1/0/1 on (tb,tt,a) vs (tb,tt,b)
fn d4_tok_cmp(tb:[]u8,tt:[]u8,a:i32,b:i32)i32 {
    let ao:i32=g32(tt,a*8);
    let al:i32=g32(tt,a*8+4);
    let bo:i32=g32(tt,b*8);
    let bl:i32=g32(tt,b*8+4);
    let m:i32=al;
    if(bl<m){m=bl;}
    let k:i32=0;
    while(k<m){
        let ca:u8=tb[ao+k];
        let cb:u8=tb[bo+k];
        if(ca<cb){return -1;}
        if(ca>cb){return 1;}
        k=k+1;
    }
    if(al<bl){return -1;}
    if(al>bl){return 1;}
    return 0;
}

// insertion sort of token-index array si[0..n) by token bytes in (tb,tt)
fn d4_sort_toks(tb:[]u8,tt:[]u8,si:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let k:i32=g32(si,i*4);
        let j:i32=i-1;
        while(j>=0){
            let c:i32=d4_tok_cmp(tb,tt,k,g32(si,j*4));
            if(c==1 || c==0){break;}
            p32(si,(j+1)*4,g32(si,j*4));
            j=j-1;
        }
        p32(si,(j+1)*4,k);
        i=i+1;
    }
    return;
}

// split key k[s..s+l] ("stem|subj|obj") into 6 i32s in o (absolute offsets)
fn d4_split_key(k:[]u8,s:i32,l:i32,o:[]u8)void {
    let p1:i32=-1;
    let p2:i32=-1;
    let i:i32=0;
    while(i<l){
        if(k[s+i]==124){
            if(p1==-1){p1=i;}else{p2=i; break;}
        }
        i=i+1;
    }
    if(p1==-1 || p2==-1){
        p32(o,0,s); p32(o,4,0); p32(o,8,s); p32(o,12,0); p32(o,16,s); p32(o,20,0);
        return;
    }
    p32(o,0,s); p32(o,4,p1);
    p32(o,8,s+p1+1); p32(o,12,p2-p1-1);
    p32(o,16,s+p2+1); p32(o,20,l-p2-1);
    return;
}

// 1 iff both keys non-empty, same stem, and argument sets equal up to diathesis
fn d4_keys_mergeable(ka:[]u8,ks:i32,kl:i32,kb:[]u8,s2:i32,l2:i32)i32 {
    if(kl==0 || l2==0){return 0;}
    let o1:[]u8=nio_alloc(24);
    let o2:[]u8=nio_alloc(24);
    d4_split_key(ka,ks,kl,o1);
    d4_split_key(kb,s2,l2,o2);
    let r:i32=0;
    let sl1:i32=g32(o1,4);
    let sl2:i32=g32(o2,4);
    if(sl1>0 && sl1==sl2 && bsub_eq(ka,g32(o1,0),kb,g32(o2,0),sl1)==1){
        let a1:i32=g32(o1,8);
        let b1:i32=g32(o1,12);
        let c1:i32=g32(o1,16);
        let d1:i32=g32(o1,20);
        let a2:i32=g32(o2,8);
        let b2:i32=g32(o2,12);
        let c2:i32=g32(o2,16);
        let d2:i32=g32(o2,20);
        if(b1>0 && d1>0 && b1==b2 && d1==d2 && bsub_eq(ka,a1,kb,a2,b1)==1 && bsub_eq(ka,c1,kb,c2,d1)==1){r=1;}
        if(r==0 && b1>0 && d1>0 && b1==d2 && d1==b2 && bsub_eq(ka,a1,kb,c2,b1)==1 && bsub_eq(ka,c1,kb,a2,d1)==1){r=1;}
    }
    nio_free(o1);
    nio_free(o2);
    return r;
}

// triple_key: see PREREG_LI_D4.md §2.1. Returns "" on unparseable (fail closed).
fn triple_key(bs:[]u8)[]u8 {
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(bs,tt,256,1,&tn);
    let vp:[]u8=nio_alloc(256*4);
    let vn:i32=0;
    let i:i32=0;
    while(i<tn){
        let to:i32=g32(tt,i*8);
        let tl:i32=g32(tt,i*8+4);
        let d1:i32=0;
        let d2:i32=0;
        if(d4_verb_stem(bs,to,tl,&d1,&d2)==1 && vn<256){
            p32(vp,vn*4,i);
            vn=vn+1;
        }
        i=i+1;
    }
    // rightmost verb with non-empty subject and object (fail closed otherwise)
    let best:i32=-1;
    let bi:i32=vn-1;
    while(bi>=0){
        let vi2:i32=g32(vp,bi*4);
        let sc:i32=0;
        let oc:i32=0;
        let j:i32=0;
        while(j<vi2){
            if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){sc=sc+1;}
            j=j+1;
        }
        j=vi2+1;
        while(j<tn){
            if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){oc=oc+1;}
            j=j+1;
        }
        if(sc>0 && oc>0){best=vi2; break;}
        bi=bi-1;
    }
    nio_free(vp);
    if(best<0){
        nio_free(tt);
        return "";
    }
    let si:[]u8=nio_alloc(256*4);
    let sn:i32=0;
    let oi:[]u8=nio_alloc(256*4);
    let on:i32=0;
    i=0;
    while(i<best){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && sn<256){
            p32(si,sn*4,i);
            sn=sn+1;
        }
        i=i+1;
    }
    i=best+1;
    while(i<tn){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && on<256){
            p32(oi,on*4,i);
            on=on+1;
        }
        i=i+1;
    }
    d4_sort_toks(bs,tt,si,sn);
    d4_sort_toks(bs,tt,oi,on);
    let to0:i32=g32(tt,best*8);
    let tl0:i32=g32(tt,best*8+4);
    let ss:i32=0;
    let sl:i32=0;
    d4_verb_stem(bs,to0,tl0,&ss,&sl);
    let vlist:[]u8=d4_verbs();
    let kb:[]u8=nio_alloc(bs.len+128);
    let o:i32=0;
    let c2:i32=0;
    while(c2<sl){
        kb[o]=vlist[ss+c2];
        o=o+1;
        c2=c2+1;
    }
    kb[o]=124;
    o=o+1;
    // subject tokens, deduped, comma-joined
    let first:i32=1;
    let k:i32=0;
    while(k<sn){
        let ti:i32=g32(si,k*4);
        let dup:i32=0;
        if(k>0 && d4_tok_cmp(bs,tt,ti,g32(si,(k-1)*4))==0){dup=1;}
        if(dup==0){
            if(first==0){kb[o]=44; o=o+1;}
            first=0;
            let ta:i32=g32(tt,ti*8);
            let tln:i32=g32(tt,ti*8+4);
            c2=0;
            while(c2<tln){
                kb[o]=bs[ta+c2];
                o=o+1;
                c2=c2+1;
            }
        }
        k=k+1;
    }
    kb[o]=124;
    o=o+1;
    first=1;
    k=0;
    while(k<on){
        let ti2:i32=g32(oi,k*4);
        let dup2:i32=0;
        if(k>0 && d4_tok_cmp(bs,tt,ti2,g32(oi,(k-1)*4))==0){dup2=1;}
        if(dup2==0){
            if(first==0){kb[o]=44; o=o+1;}
            first=0;
            let ta2:i32=g32(tt,ti2*8);
            let tln2:i32=g32(tt,ti2*8+4);
            c2=0;
            while(c2<tln2){
                kb[o]=bs[ta2+c2];
                o=o+1;
                c2=c2+1;
            }
        }
        k=k+1;
    }
    nio_free(tt);
    nio_free(si);
    nio_free(oi);
    let key:[]u8=kb[0..o];
    return key;
}

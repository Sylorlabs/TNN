@import("fam_quant_triple.zag")
@import("R33_NATIVE_IO_V1.zag")

// TEMPORARY debug driver (not part of the family deliverable).


fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn bsub_eq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn tokenize(s:[]u8,tt:[]u8,cap:i32,minl:i32,n:*i32)void {
    n[0]=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            let st:i32=i;
            while(i<s.len){
                let d:u8=s[i];
                if(!((d>=97 && d<=122) || (d>=48 && d<=57))){break;}
                i=i+1;
            }
            let ln:i32=i-st;
            if(ln>=minl && n[0]<cap){
                p32(tt,n[0]*8,st);
                p32(tt,n[0]*8+4,ln);
                n[0]=n[0]+1;
            }
            i=i+1;
        }else{
            i=i+1;
        }
    }
    return;
}

fn main()i32 {
    let s1:[]u8=_zag_arg(1);
    let s2:[]u8=_zag_arg(2);
    _zag_print("TK1|");
    _zag_println(triple_key(s1));
    _zag_print("PK1|");
    _zag_println(primary_key(s1));
    _zag_print("TK2|");
    _zag_println(triple_key(s2));
    _zag_print("PK2|");
    _zag_println(primary_key(s2));
    let p1:[]u8=primary_key(s1);
    let p2:[]u8=primary_key(s2);
    let c:i32=d4_keys_contradict(p1,0,p1.len,p2,0,p2.len);
    _zag_print("CONTRA|");
    _zag_println(_zag_i64_to_str(c as i64));
    return 0;
}

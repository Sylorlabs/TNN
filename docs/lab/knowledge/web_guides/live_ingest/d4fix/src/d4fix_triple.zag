// d4fix_triple.zag — D4-FIX proposition frames (fork of d4_triple.zag).
//
// Frozen key formats (all sections `|`-separated):
//   main:    stem|modals|vseq|voice|subj|obj
//   primary: pstem|pmodals|psubj|pobj|pvoice|pargbag|psubj_np|pobj_np
//
// stem = rightmost well-formed verb stem (D4 rule). modals = sorted raw modal
// forms in the sentence (will/would/can/could/shall/should/may/might/must).
// vseq = surface verb forms in sentence order. voice = P if a be-form
// (am/is/are/was/were/be/been/being) precedes the extraction verb else A.
// subj/obj = sorted deduped content token sets. Primary-clause key uses the
// LEFTMOST lexical (non-modal, non-be) well-formed verb, falling back to the
// extraction verb. pargbag = sorted multiset union of psubj+pobj tokens.
// psubj_np/pobj_np = role sets with reference pronouns stripped.
//
// D4-FIX change: he/she/him/her/his/hers are CONTENT (reference-carrying),
// not glue. Deterministic, zero RNG.

// ---- frozen tables (App. A, same as D4) ----
fn d4_glue()[]u8 {
    return "a an the of at in on to for and or but nor so yet as by with from into over under between through during before after above below up down out off about against among around behind beyond plus except per via versus within without along across onto upon toward towards this that these those it its they them their he she we you i me him her us our your his my mine yours hers theirs ours which who whom whose there here then than too very just only also even still already quite rather almost nearly";
}

fn d4_verbs()[]u8 {
    return "am:be is:be are:be was:be were:be be:be been:be being:be has:have have:have had:have having:have do:do does:do did:do done:do doing:do will:will would:will can:can could:can shall:shall should:shall may:may might:may must:must make:make makes:make made:make making:make take:take takes:take took:take taken:take taking:take give:give gives:give gave:give given:give giving:give contain:contain contains:contain contained:contain containing:contain include:include includes:include included:include including:include hold:hold holds:hold held:hold holding:hold reach:reach reaches:reach reached:reach reaching:reach measure:measure measures:measure measured:measure measuring:measure weigh:weigh weighs:weigh weighed:weigh weighing:weigh stand:stand stands:stand stood:stand standing:stand span:span spans:span spanned:span spanning:span cover:cover covers:cover covered:cover covering:cover last:last lasts:last lasted:last lasting:last cost:cost costs:cost costing:cost run:run runs:run ran:run running:run live:live lives:live lived:live living:live spin:spin spins:spin spun:spin spinning:spin rotate:rotate rotates:rotate rotated:rotate rotating:rotate orbit:orbit orbits:orbit orbited:orbit orbiting:orbit boil:boil boils:boil boiled:boil boiling:boil freeze:freeze freezes:freeze froze:freeze frozen:freeze freezing:freeze melt:melt melts:melt melted:melt melting:melt grow:grow grows:grow grew:grow grown:grow growing:grow begin:begin begins:begin began:begin begun:begin beginning:begin become:become becomes:become became:become becoming:become date:date dates:date dated:date dating:date mark:mark marks:mark marked:mark marking:mark carry:carry carries:carry carried:carry carrying:carry store:store stores:store stored:store storing:store back:back backs:back backed:back backing:back join:join joins:join joined:join joining:join enter:enter enters:enter entered:enter entering:enter gain:gain gains:gain gained:gain gaining:gain create:create creates:create created:create creating:create mint:mint mints:mint minted:mint minting:mint serve:serve serves:serve served:serve serving:serve exist:exist exists:exist existed:exist existing:exist appear:appear appears:appear appeared:appear appearing:appear remain:remain remains:remain remained:remain remaining:remain stay:stay stays:stay stayed:stay staying:stay form:form forms:form formed:form forming:form produce:produce produces:produce produced:produce producing:produce beat:beat beats:beat beaten:beat beating:beat win:win wins:win won:win winning:win lose:lose loses:lose lost:lose losing:lose host:host hosts:host hosted:host hosting:host plan:plan plans:plan planned:plan planning:plan slate:slate slates:slate slated:slate slating:slate see:see sees:see saw:see seen:see seeing:see show:show shows:show showed:show shown:show showing:show shown:show say:say says:say said:say saying:say report:report reports:report reported:report reporting:report find:find finds:find found:find finding:find use:use uses:use used:use using:use require:require requires:require required:require requiring:require cause:cause causes:cause caused:cause causing:cause lead:lead leads:lead led:lead leading:lead fall:fall falls:fall fell:fall fallen:fall falling:fall rise:rise rises:rise rose:rise risen:rise rising:rise drop:drop drops:drop dropped:drop dropping:drop happen:happen happens:happen happened:happen happening:happen occur:occur occurs:occur occurred:occur occurring:occur change:change changes:change changed:change changing:change come:come comes:come came:come coming:come go:go goes:go went:go gone:go going:go write:write writes:write wrote:write written:write writing:write build:build builds:build built:build building:build die:die dies:die died:die dying:die kill:kill kills:kill killed:kill killing:kill eat:eat eats:eat ate:eat eaten:eat eating:eat fly:fly flies:fly flew:fly flown:fly flying:fly possess:possess possesses:possess possessed:possess possessing:possess own:own owns:own owned:own owning:own need:need needs:need needed:need needing:need call:call calls:call called:call calling:call set:set sets:set setting:set keep:keep keeps:keep kept:keep keeping:keep send:send sends:send sent:send sent:send sending:send break:break breaks:break broke:break broken:break breaking:break open:open opens:open opened:open opening:open close:close closes:close closed:close closing:close start:start starts:start started:start starting:start stop:stop stops:stop stopped:stop stopping:stop end:end ends:end ended:end ending:end turn:turn turns:turn turned:turn turning:turn move:move moves:move moved:move moving:move launch:launch launches:launch launched:launch launching:launch deploy:deploy deploys:deploy deployed:deploy deploying:deploy record:record records:record recorded:record recording:record score:score scores:score scored:score scoring:score spoil:spoil spoils:spoil spoiled:spoil spoiling:spoil expire:expire expires:expire expired:expire expiring:expire count:count counts:count counted:count counting:count welcome:welcome welcomes:welcome welcomed:welcome welcoming:welcome bear:bear bears:bear bore:bear born:bear borne:bear bearing:bear lie:lie lies:lie lay:lie lain:lie lying:lie think:think thinks:think thought:think thinking:think believe:believe believes:believe believed:believe believing:believe know:know knows:know knew:know known:know knowing:know tell:tell tells:tell told:tell telling:tell speak:speak speaks:speak spoke:speak spoken:speak speaking:speak enumerate:enumerate enumerates:enumerate enumerated:enumerate enumerating:enumerate govern:govern governs:govern governed:govern governing:govern fuse:fuse fuses:fuse fused:fuse fusing:fuse manufacture:manufacture manufactures:manufacture manufactured:manufacture manufacturing:manufacture provide:provide provides:provide provided:provide providing:provide transmit:transmit transmits:transmit transmitted:transmit transmitting:transmit evolve:evolve evolves:evolve evolved:evolve evolving:evolve perform:perform performs:perform performed:perform performing:perform communicate:communicate communicates:communicate communicated:communicate communicating:communicate expand:expand expands:expand expanded:expand expanding:expand invent:invent invents:invent invented:invent inventing:invent transform:transform transforms:transform transformed:transform transforming:transform flow:flow flows:flow flowed:flow flowing:flow detect:detect detects:detect detected:detect detecting:detect register:register registers:register registered:register registering:register predate:predate predates:predate predated:predate predating:predate rank:rank ranks:rank ranked:rank ranking:rank hide:hide hides:hide hid:hide hidden:hide hiding:hide bury:bury buries:bury buried:bury burying:bury approach:approach approaches:approach approached:approach approaching:approach subject:subject subjects:subject subjected:subject subjecting:subject";
}

// whole-word membership of tb[to..to+tl] in space-separated list
fn d4_word_in(tb:[]u8,to:i32,tl:i32,lst:[]u8)i32 {
    let i:i32=0;
    while(i<lst.len){
        while(i<lst.len && lst[i]==32){i=i+1;}
        if(i>=lst.len){break;}
        let st:i32=i;
        while(i<lst.len && lst[i]!=32){i=i+1;}
        let ln:i32=i-st;
        if(ln==tl && bsub_eq(lst,st,tb,to,tl)==1){return 1;}
    }
    return 0;
}

// form->stem lookup; o_s/o_l = stem (start,len) into d4_verbs(); returns 1/0
fn d4_verb_stem(tb:[]u8,to:i32,tl:i32,o_s:*i32,o_l:*i32)i32 {
    let lst:[]u8=d4_verbs();
    let i:i32=0;
    while(i<lst.len){
        while(i<lst.len && lst[i]==32){i=i+1;}
        if(i>=lst.len){break;}
        let st:i32=i;
        while(i<lst.len && lst[i]!=32 && lst[i]!=58){i=i+1;}
        let fl:i32=i-st;
        if(i<lst.len && lst[i]==58 && fl==tl && bsub_eq(lst,st,tb,to,tl)==1){
            let ss:i32=i+1;
            let se:i32=ss;
            while(se<lst.len && lst[se]!=32){se=se+1;}
            o_s[0]=ss;
            o_l[0]=se-ss;
            return 1;
        }
        while(i<lst.len && lst[i]!=32){i=i+1;}
    }
    return 0;
}

// D4-FIX: reference pronouns (content, never glue)
fn d4_is_ref_pronoun(tb:[]u8,to:i32,tl:i32)i32 {
    if(tl==2){
        if(tb[to]==104 && tb[to+1]==101){return 1;} // he
        if(tb[to]==109 && tb[to+1]==101){return 1;} // me (not ref; skip)
    }
    if(tl==3){
        if(tb[to]==115 && tb[to+1]==104 && tb[to+2]==101){return 1;} // she
        if(tb[to]==104 && tb[to+1]==105 && tb[to+2]==109){return 1;} // him
        if(tb[to]==104 && tb[to+1]==101 && tb[to+2]==114){return 1;} // her
        if(tb[to]==104 && tb[to+1]==105 && tb[to+2]==115){return 1;} // his
    }
    if(tl==4){
        if(tb[to]==104 && tb[to+1]==101 && tb[to+2]==114 && tb[to+3]==115){return 1;} // hers
    }
    return 0;
}

// 1 if token is content (not glue, not a verb form). D4-FIX: reference
// pronouns are content.
fn d4_is_content(tb:[]u8,to:i32,tl:i32)i32 {
    if(d4_is_ref_pronoun(tb,to,tl)==1){return 1;}
    if(d4_word_in(tb,to,tl,d4_glue())==1){return 0;}
    let d1:i32=0;
    let d2:i32=0;
    if(d4_verb_stem(tb,to,tl,&d1,&d2)==1){return 0;}
    return 1;
}

fn d4_is_modal(tb:[]u8,to:i32,tl:i32)i32 {
    if(tl==3){
        if(tb[to]==109 && tb[to+1]==97 && tb[to+2]==121){return 1;} // may
    }
    if(tl==4){
        if(tb[to]==119 && tb[to+1]==105 && tb[to+2]==108 && tb[to+3]==108){return 1;} // will
        if(tb[to]==109 && tb[to+1]==117 && tb[to+2]==115 && tb[to+3]==116){return 1;} // must
    }
    if(tl==5){
        if(tb[to]==119 && tb[to+1]==111 && tb[to+2]==117 && tb[to+3]==108 && tb[to+4]==100){return 1;} // would
        if(tb[to]==99 && tb[to+1]==111 && tb[to+2]==117 && tb[to+3]==108 && tb[to+4]==100){return 1;} // could
        if(tb[to]==115 && tb[to+1]==104 && tb[to+2]==97 && tb[to+3]==108 && tb[to+4]==108){return 1;} // shall
        if(tb[to]==109 && tb[to+1]==105 && tb[to+2]==103 && tb[to+3]==104 && tb[to+4]==116){return 1;} // might
    }
    if(tl==6){
        if(tb[to]==115 && tb[to+1]==104 && tb[to+2]==111 && tb[to+3]==117 && tb[to+4]==108 && tb[to+5]==100){return 1;} // should
    }
    return 0;
}

fn d4_is_beform(tb:[]u8,to:i32,tl:i32)i32 {
    if(tl==2){
        if(tb[to]==98 && tb[to+1]==101){return 1;} // be
        if(tb[to]==105 && tb[to+1]==115){return 1;} // is
        if(tb[to]==97 && tb[to+1]==109){return 1;} // am
    }
    if(tl==3){
        if(tb[to]==97 && tb[to+1]==114 && tb[to+2]==101){return 1;} // are
        if(tb[to]==119 && tb[to+1]==97 && tb[to+2]==115){return 1;} // was
    }
    if(tl==4){
        if(tb[to]==119 && tb[to+1]==101 && tb[to+2]==114 && tb[to+3]==101){return 1;} // were
        if(tb[to]==98 && tb[to+1]==101 && tb[to+2]==101 && tb[to+3]==110){return 1;} // been
    }
    if(tl==5){
        if(tb[to]==98 && tb[to+1]==101 && tb[to+2]==105 && tb[to+3]==110 && tb[to+4]==103){return 1;} // being
    }
    return 0;
}

// lexical stem: not a modal stem and not be.
fn d4_stem_lexical(s:[]u8)i32 {
    if(nio_equal(s,"will")==1){return 0;}
    if(nio_equal(s,"can")==1){return 0;}
    if(nio_equal(s,"shall")==1){return 0;}
    if(nio_equal(s,"may")==1){return 0;}
    if(nio_equal(s,"must")==1){return 0;}
    if(nio_equal(s,"be")==1){return 0;}
    return 1;
}

// token compare: -1/0/1 on (tb,tt,a) vs (tb,tt,b)
fn d4_tok_cmp(tb:[]u8,tt:[]u8,a:i32,b:i32)i32 {
    let ao:i32=g32(tt,a*8);
    let al:i32=g32(tt,a*8+4);
    let bo:i32=g32(tt,b*8);
    let bl:i32=g32(tt,b*8+4);
    let m:i32=al;
    if(bl<m){m=bl;}
    let k:i32=0;
    while(k<m){
        let ca:u8=tb[ao+k];
        let cb:u8=tb[bo+k];
        if(ca<cb){return -1;}
        if(ca>cb){return 1;}
        k=k+1;
    }
    if(al<bl){return -1;}
    if(al>bl){return 1;}
    return 0;
}

// insertion sort of token-index array si[0..n) by token bytes in (tb,tt)
fn d4_sort_toks(tb:[]u8,tt:[]u8,si:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let k:i32=g32(si,i*4);
        let j:i32=i-1;
        while(j>=0){
            let c:i32=d4_tok_cmp(tb,tt,k,g32(si,j*4));
            if(c==1 || c==0){break;}
            p32(si,(j+1)*4,g32(si,j*4));
            j=j-1;
        }
        p32(si,(j+1)*4,k);
        i=i+1;
    }
    return;
}

// append comma-joined deduped tokens from sorted index array idx[0..n)
fn d4_join_toks(tb:[]u8,tt:[]u8,idx:[]u8,n:i32,kb:[]u8,o:*i32)void {
    let first:i32=1;
    let k:i32=0;
    while(k<n){
        let ti:i32=g32(idx,k*4);
        let dup:i32=0;
        if(k>0 && d4_tok_cmp(tb,tt,ti,g32(idx,(k-1)*4))==0){dup=1;}
        if(dup==0){
            if(first==0){kb[o[0]]=44; o[0]=o[0]+1;}
            first=0;
            let ta:i32=g32(tt,ti*8);
            let tln:i32=g32(tt,ti*8+4);
            let c2:i32=0;
            while(c2<tln){
                kb[o[0]]=tb[ta+c2];
                o[0]=o[0]+1;
                c2=c2+1;
            }
        }
        k=k+1;
    }
}

// append comma-joined deduped tokens, skipping reference pronouns
fn d4_join_toks_nopr(tb:[]u8,tt:[]u8,idx:[]u8,n:i32,kb:[]u8,o:*i32)void {
    let first:i32=1;
    let k:i32=0;
    while(k<n){
        let ti:i32=g32(idx,k*4);
        let ta:i32=g32(tt,ti*8);
        let tln:i32=g32(tt,ti*8+4);
        let dup:i32=0;
        if(k>0 && d4_tok_cmp(tb,tt,ti,g32(idx,(k-1)*4))==0){dup=1;}
        if(dup==0 && d4_is_ref_pronoun(tb,ta,tln)==0){
            if(first==0){kb[o[0]]=44; o[0]=o[0]+1;}
            first=0;
            let c2:i32=0;
            while(c2<tln){
                kb[o[0]]=tb[ta+c2];
                o[0]=o[0]+1;
                c2=c2+1;
            }
        }
        k=k+1;
    }
}

// merge two sorted token-index arrays into out (sorted, duplicates kept);
// returns merged count
fn d4_merge_toks(tb:[]u8,tt:[]u8,a:[]u8,an:i32,b:[]u8,bn:i32,out:[]u8)i32 {
    let i:i32=0;
    let j:i32=0;
    let k:i32=0;
    while(i<an && j<bn){
        let ai:i32=g32(a,i*4);
        let bj:i32=g32(b,j*4);
        if(d4_tok_cmp(tb,tt,ai,bj)<=0){
            p32(out,k*4,ai);
            i=i+1;
        }else{
            p32(out,k*4,bj);
            j=j+1;
        }
        k=k+1;
    }
    while(i<an){
        p32(out,k*4,g32(a,i*4));
        i=i+1;
        k=k+1;
    }
    while(j<bn){
        p32(out,k*4,g32(b,j*4));
        j=j+1;
        k=k+1;
    }
    return k;
}

// section accessor: idx-th `|`-separated section of k[s..s+l] -> (off,len)
fn ksec(k:[]u8,s:i32,l:i32,idx:i32,o_off:*i32,o_len:*i32)void {
    let n:i32=0;
    let ss:i32=s;
    let p:i32=s;
    o_off[0]=s;
    o_len[0]=0;
    while(p<=s+l){
        if(p==s+l || k[p]==124){
            if(n==idx){
                o_off[0]=ss;
                o_len[0]=p-ss;
                return;
            }
            n=n+1;
            ss=p+1;
        }
        p=p+1;
    }
}

fn ksec_eq(a:[]u8,as:i32,al:i32,ai:i32,b:[]u8,bs:i32,bl:i32,bi:i32)i32 {
    let ao:i32=0;
    let an:i32=0;
    let bo:i32=0;
    let bn:i32=0;
    ksec(a,as,al,ai,&ao,&an);
    ksec(b,bs,bl,bi,&bo,&bn);
    if(an!=bn){return 0;}
    let i:i32=0;
    while(i<an){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}

// D4-FIX merge rule on 6-section keys stem|modals|vseq|voice|subj|obj.
// Strict SVO always; swap only when vseq differs or either side is passive.
fn d4_keys_mergeable(ka:[]u8,ks:i32,kl:i32,kb:[]u8,s2:i32,l2:i32)i32 {
    if(kl==0 || l2==0){return 0;}
    if(ksec_eq(ka,ks,kl,0,kb,s2,l2,0)==0){return 0;}
    if(ksec_eq(ka,ks,kl,1,kb,s2,l2,1)==0){return 0;}
    if(ksec_eq(ka,ks,kl,4,kb,s2,l2,4)==1 && ksec_eq(ka,ks,kl,5,kb,s2,l2,5)==1){return 1;}
    if(ksec_eq(ka,ks,kl,4,kb,s2,l2,5)==1 && ksec_eq(ka,ks,kl,5,kb,s2,l2,4)==1 && ksec_eq(ka,ks,kl,4,kb,s2,l2,4)==0){
        let vseq_same:i32=ksec_eq(ka,ks,kl,2,kb,s2,l2,2);
        let vao:i32=0;
        let van:i32=0;
        let vbo:i32=0;
        let vbn:i32=0;
        ksec(ka,ks,kl,3,&vao,&van);
        ksec(kb,s2,l2,3,&vbo,&vbn);
        let va:i32=0;
        let vb:i32=0;
        if(van==1 && ka[vao]==80){va=1;}
        if(vbn==1 && kb[vbo]==80){vb=1;}
        if(vseq_same==1 && va==0 && vb==0){return 0;}
        return 1;
    }
    return 0;
}

// D4-FIX contradiction relation on 8-section primary keys
// pstem|pmodals|psubj|pobj|pvoice|pargbag|psubj_np|pobj_np
// Returns 0 = none, 1 = ROLE-SWAP, 2 = MODAL, 3 = REFERENCE.
fn d4_keys_contradict(pa:[]u8,ps:i32,pl:i32,pb:[]u8,qs:i32,ql:i32)i32 {
    if(pl==0 || ql==0){return 0;}
    if(ksec_eq(pa,ps,pl,0,pb,qs,ql,0)==0){return 0;}
    let mod_same:i32=ksec_eq(pa,ps,pl,1,pb,qs,ql,1);
    if(mod_same==1){
        let subj_same:i32=ksec_eq(pa,ps,pl,2,pb,qs,ql,2);
        let obj_same:i32=ksec_eq(pa,ps,pl,3,pb,qs,ql,3);
        if(subj_same==1 && obj_same==1){return 0;}
        if(ksec_eq(pa,ps,pl,5,pb,qs,ql,5)==1 && subj_same==0){
            let vao:i32=0;
            let van:i32=0;
            let vbo:i32=0;
            let vbn:i32=0;
            ksec(pa,ps,pl,4,&vao,&van);
            ksec(pb,qs,ql,4,&vbo,&vbn);
            let va:i32=0;
            let vb:i32=0;
            if(van==1 && pa[vao]==80){va=1;}
            if(vbn==1 && pb[vbo]==80){vb=1;}
            if(va==0 && vb==0){return 1;}
            return 0;
        }
        if(ksec_eq(pa,ps,pl,6,pb,qs,ql,6)==1 && ksec_eq(pa,ps,pl,7,pb,qs,ql,7)==1){return 3;}
        return 0;
    }
    if(ksec_eq(pa,ps,pl,2,pb,qs,ql,2)==1 && ksec_eq(pa,ps,pl,3,pb,qs,ql,3)==1){return 2;}
    return 0;
}

// triple_key: D4-FIX v2 frame. Returns "" on unparseable (fail closed).
fn triple_key(bs:[]u8)[]u8 {
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(bs,tt,256,1,&tn);
    let vp:[]u8=nio_alloc(256*4);
    let vn:i32=0;
    let i:i32=0;
    while(i<tn){
        let to:i32=g32(tt,i*8);
        let tl:i32=g32(tt,i*8+4);
        let d1:i32=0;
        let d2:i32=0;
        if(d4_verb_stem(bs,to,tl,&d1,&d2)==1 && vn<256){
            p32(vp,vn*4,i);
            vn=vn+1;
        }
        i=i+1;
    }
    // rightmost verb with non-empty subject and object (fail closed otherwise)
    let best:i32=-1;
    let bi:i32=vn-1;
    while(bi>=0){
        let vi2:i32=g32(vp,bi*4);
        let sc:i32=0;
        let oc:i32=0;
        let j:i32=0;
        while(j<vi2){
            if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){sc=sc+1;}
            j=j+1;
        }
        j=vi2+1;
        while(j<tn){
            if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){oc=oc+1;}
            j=j+1;
        }
        if(sc>0 && oc>0){best=vi2; break;}
        bi=bi-1;
    }
    if(best<0){
        nio_free(vp);
        nio_free(tt);
        return "";
    }
    let si:[]u8=nio_alloc(256*4);
    let sn:i32=0;
    let oi:[]u8=nio_alloc(256*4);
    let on:i32=0;
    i=0;
    while(i<best){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && sn<256){
            p32(si,sn*4,i);
            sn=sn+1;
        }
        i=i+1;
    }
    i=best+1;
    while(i<tn){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && on<256){
            p32(oi,on*4,i);
            on=on+1;
        }
        i=i+1;
    }
    d4_sort_toks(bs,tt,si,sn);
    d4_sort_toks(bs,tt,oi,on);
    let to0:i32=g32(tt,best*8);
    let tl0:i32=g32(tt,best*8+4);
    let ss:i32=0;
    let sl:i32=0;
    d4_verb_stem(bs,to0,tl0,&ss,&sl);
    let vlist:[]u8=d4_verbs();
    let kb:[]u8=nio_alloc(bs.len+256);
    let oo:i32=0;
    let c2:i32=0;
    while(c2<sl){
        kb[oo]=vlist[ss+c2];
        oo=oo+1;
        c2=c2+1;
    }
    kb[oo]=124;
    oo=oo+1;
    // modals: sorted raw modal forms anywhere in the sentence
    let mi:[]u8=nio_alloc(64*4);
    let mn:i32=0;
    let q:i32=0;
    while(q<tn){
        if(d4_is_modal(bs,g32(tt,q*8),g32(tt,q*8+4))==1 && mn<64){
            p32(mi,mn*4,q);
            mn=mn+1;
        }
        q=q+1;
    }
    d4_sort_toks(bs,tt,mi,mn);
    d4_join_toks(bs,tt,mi,mn,kb,&oo);
    nio_free(mi);
    kb[oo]=124;
    oo=oo+1;
    // vseq: surface verb forms in sentence order
    let vf:i32=1;
    let vb:i32=0;
    while(vb<vn){
        let vpos:i32=g32(vp,vb*4);
        if(vf==0){kb[oo]=44; oo=oo+1;}
        vf=0;
        let vo:i32=g32(tt,vpos*8);
        let vl2:i32=g32(tt,vpos*8+4);
        c2=0;
        while(c2<vl2){
            kb[oo]=bs[vo+c2];
            oo=oo+1;
            c2=c2+1;
        }
        vb=vb+1;
    }
    kb[oo]=124;
    oo=oo+1;
    // voice: P if a be-form precedes the extraction verb
    let pv:i32=0;
    q=0;
    while(q<best){
        if(d4_is_beform(bs,g32(tt,q*8),g32(tt,q*8+4))==1){pv=1;}
        q=q+1;
    }
    if(pv==1){kb[oo]=80;}else{kb[oo]=65;}
    oo=oo+1;
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks(bs,tt,si,sn,kb,&oo);
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks(bs,tt,oi,on,kb,&oo);
    nio_free(vp);
    nio_free(tt);
    nio_free(si);
    nio_free(oi);
    let key:[]u8=kb[0..oo];
    return key;
}

// primary_key: leftmost lexical well-formed verb (fallback: extraction verb).
// Format: pstem|pmodals|psubj|pobj|pvoice|pargbag|psubj_np|pobj_np
fn primary_key(bs:[]u8)[]u8 {
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(bs,tt,256,1,&tn);
    let vp:[]u8=nio_alloc(256*4);
    let vn:i32=0;
    let i:i32=0;
    while(i<tn){
        let to:i32=g32(tt,i*8);
        let tl:i32=g32(tt,i*8+4);
        let d1:i32=0;
        let d2:i32=0;
        if(d4_verb_stem(bs,to,tl,&d1,&d2)==1 && vn<256){
            p32(vp,vn*4,i);
            vn=vn+1;
        }
        i=i+1;
    }
    if(vn==0){
        nio_free(vp);
        nio_free(tt);
        return "";
    }
    let vlist:[]u8=d4_verbs();
    // leftmost lexical verb with non-empty content subject and object
    let prim:i32=-1;
    let pi:i32=0;
    while(pi<vn){
        let vpos:i32=g32(vp,pi*4);
        let vo:i32=g32(tt,vpos*8);
        let vl:i32=g32(tt,vpos*8+4);
        let sso:i32=0;
        let ssl:i32=0;
        if(d4_verb_stem(bs,vo,vl,&sso,&ssl)==1 && d4_stem_lexical(vlist[sso..sso+ssl])==1){
            let sc:i32=0;
            let oc:i32=0;
            let j:i32=0;
            while(j<vpos){
                if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){sc=sc+1;}
                j=j+1;
            }
            j=vpos+1;
            while(j<tn){
                if(d4_is_content(bs,g32(tt,j*8),g32(tt,j*8+4))==1){oc=oc+1;}
                j=j+1;
            }
            if(sc>0 && oc>0){prim=vpos; break;}
        }
        pi=pi+1;
    }
    if(prim<0){
        // fallback: rightmost well-formed verb
        let bi2:i32=vn-1;
        while(bi2>=0){
            let vi2:i32=g32(vp,bi2*4);
            let sc2:i32=0;
            let oc2:i32=0;
            let j2:i32=0;
            while(j2<vi2){
                if(d4_is_content(bs,g32(tt,j2*8),g32(tt,j2*8+4))==1){sc2=sc2+1;}
                j2=j2+1;
            }
            j2=vi2+1;
            while(j2<tn){
                if(d4_is_content(bs,g32(tt,j2*8),g32(tt,j2*8+4))==1){oc2=oc2+1;}
                j2=j2+1;
            }
            if(sc2>0 && oc2>0){prim=vi2; break;}
            bi2=bi2-1;
        }
    }
    if(prim<0){
        nio_free(vp);
        nio_free(tt);
        return "";
    }
    let si:[]u8=nio_alloc(256*4);
    let sn:i32=0;
    let oi:[]u8=nio_alloc(256*4);
    let on:i32=0;
    i=0;
    while(i<prim){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && sn<256){
            p32(si,sn*4,i);
            sn=sn+1;
        }
        i=i+1;
    }
    i=prim+1;
    while(i<tn){
        if(d4_is_content(bs,g32(tt,i*8),g32(tt,i*8+4))==1 && on<256){
            p32(oi,on*4,i);
            on=on+1;
        }
        i=i+1;
    }
    d4_sort_toks(bs,tt,si,sn);
    d4_sort_toks(bs,tt,oi,on);
    let to0:i32=g32(tt,prim*8);
    let tl0:i32=g32(tt,prim*8+4);
    let ss:i32=0;
    let sl:i32=0;
    d4_verb_stem(bs,to0,tl0,&ss,&sl);
    let kb:[]u8=nio_alloc(bs.len+256);
    let oo:i32=0;
    let c2:i32=0;
    while(c2<sl){
        kb[oo]=vlist[ss+c2];
        oo=oo+1;
        c2=c2+1;
    }
    kb[oo]=124;
    oo=oo+1;
    // pmodals: modal forms before the primary verb
    let mi:[]u8=nio_alloc(64*4);
    let mn:i32=0;
    let q:i32=0;
    while(q<prim){
        if(d4_is_modal(bs,g32(tt,q*8),g32(tt,q*8+4))==1 && mn<64){
            p32(mi,mn*4,q);
            mn=mn+1;
        }
        q=q+1;
    }
    d4_sort_toks(bs,tt,mi,mn);
    d4_join_toks(bs,tt,mi,mn,kb,&oo);
    nio_free(mi);
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks(bs,tt,si,sn,kb,&oo);
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks(bs,tt,oi,on,kb,&oo);
    kb[oo]=124;
    oo=oo+1;
    // pvoice
    let pv:i32=0;
    q=0;
    while(q<prim){
        if(d4_is_beform(bs,g32(tt,q*8),g32(tt,q*8+4))==1){pv=1;}
        q=q+1;
    }
    if(pv==1){kb[oo]=80;}else{kb[oo]=65;}
    oo=oo+1;
    kb[oo]=124;
    oo=oo+1;
    // pargbag: sorted multiset union of subj+obj tokens
    let mg:[]u8=nio_alloc(512*4);
    let mgn:i32=d4_merge_toks(bs,tt,si,sn,oi,on,mg);
    let f2:i32=1;
    let k2:i32=0;
    while(k2<mgn){
        if(f2==0){kb[oo]=44; oo=oo+1;}
        f2=0;
        let ti2:i32=g32(mg,k2*4);
        let ta2:i32=g32(tt,ti2*8);
        let tl2:i32=g32(tt,ti2*8+4);
        c2=0;
        while(c2<tl2){
            kb[oo]=bs[ta2+c2];
            oo=oo+1;
            c2=c2+1;
        }
        k2=k2+1;
    }
    nio_free(mg);
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks_nopr(bs,tt,si,sn,kb,&oo);
    kb[oo]=124;
    oo=oo+1;
    d4_join_toks_nopr(bs,tt,oi,on,kb,&oo);
    nio_free(vp);
    nio_free(tt);
    nio_free(si);
    nio_free(oi);
    let key:[]u8=kb[0..oo];
    return key;
}

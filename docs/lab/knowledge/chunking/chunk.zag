// chunk.zag — chunking investigation arms (pure Zag).
// Marker lists + conjunction rule extracted verbatim from
// delib_si2.zag (is_pos_word / is_neg_situation / matches_sarcasm).
// Verdict: ENDORSE iff >=1 POS marker AND >=1 NEG marker fire on the
// evaluated byte span; else WITHHOLD.
// Cost: every byte comparison inside the substring scan increments a
// caller-supplied *i64 counter.
// Usage: chunk_bin <workdir> <WHOLE|FIXED64|FIXED512|ADAPTIVE|DIAGUNION|ALL>
//                  <items-file> [W]
// Output per item per arm: ID|LABEL|ARM|VERDICT|comps=N|chunks=K
// then SUMMARY and COST lines per arm. Deterministic; no RNG.

@import("./R33_NATIVE_IO_V1.zag")

// ---------- helpers ----------

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn cmp_eq(a:[]u8, b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i32=0;
    while(i<a.len){
        if(a[i]!=b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn parse_i32(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48 && c<=57){ v=v*10+((c as i32)-48); }
        i=i+1;
    }
    return v;
}

fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(2097152);
    let n:i64=nio_read_exact(fd, buf, 2097152);
    nio_close(fd);
    if(n<=0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

// ---------- markers (verbatim from delib_si2.zag) ----------

fn pos_marker(k:i32)[]u8 {
    if(k==0){ return "great"; }
    if(k==1){ return "wonderful"; }
    if(k==2){ return "fantastic"; }
    if(k==3){ return "love"; }
    if(k==4){ return "best"; }
    if(k==5){ return "brilliant"; }
    if(k==6){ return "perfect"; }
    return "awesome";
}

fn neg_marker(k:i32)[]u8 {
    if(k==0){ return "flat tire"; }
    if(k==1){ return "6 am"; }
    if(k==2){ return "delayed"; }
    if(k==3){ return "monday"; }
    if(k==4){ return "broke"; }
    if(k==5){ return "failed"; }
    if(k==6){ return "terrible"; }
    if(k==7){ return "awful"; }
    return "worst";
}

// byte-comparison-counting substring search
fn has_sub(hay:[]u8, ndl:[]u8, cnt:*i64)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len){
            cnt[0]=cnt[0]+1;
            if(hay[i+j]!=ndl[j]){ break; }
            j=j+1;
        }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

fn fire_pos(hay:[]u8, cnt:*i64)i32 {
    let k:i32=0;
    while(k<8){
        if(has_sub(hay, pos_marker(k), cnt)==1){ return 1; }
        k=k+1;
    }
    return 0;
}

fn fire_neg(hay:[]u8, cnt:*i64)i32 {
    let k:i32=0;
    while(k<9){
        if(has_sub(hay, neg_marker(k), cnt)==1){ return 1; }
        k=k+1;
    }
    return 0;
}

// earliest occurrence END of any side-list marker with start>=lo and
// end<=hi; -1 if none. side 0=POS 1=NEG.
fn occ_end(hay:[]u8, ndl:[]u8, lo:i32, hi:i32, cnt:*i64)i32 {
    if(ndl.len==0){ return -1; }
    let s:i32=lo;
    while(s+ndl.len<=hi){
        let j:i32=0;
        while(j<ndl.len){
            cnt[0]=cnt[0]+1;
            if(hay[s+j]!=ndl[j]){ break; }
            j=j+1;
        }
        if(j==ndl.len){ return s+ndl.len; }
        s=s+1;
    }
    return -1;
}

fn first_end(hay:[]u8, lo:i32, hi:i32, side:i32, cnt:*i64)i32 {
    let best:i32=-1;
    let nm:i32=8;
    if(side==1){ nm=9; }
    let k:i32=0;
    while(k<nm){
        let m:[]u8=pos_marker(k);
        if(side==1){ m=neg_marker(k); }
        let e:i32=occ_end(hay, m, lo, hi, cnt);
        if(e!=-1){
            if(best==-1){ best=e; }
            else {
                if(e<best){ best=e; }
            }
        }
        k=k+1;
    }
    return best;
}

fn find_para_break(t:[]u8, from:i32)i32 {
    let i:i32=from;
    while(i+1<t.len){
        if(t[i]==10 && t[i+1]==10){ return i; }
        i=i+1;
    }
    return -1;
}

// conjunction verdict over one span: 1=ENDORSE 0=WITHHOLD
fn verdict_span(t:[]u8, cnt:*i64)i32 {
    if(fire_pos(t,cnt)==1 && fire_neg(t,cnt)==1){ return 1; }
    return 0;
}

// arms return packed i64: (nchunks<<32) | any_endorse

fn arm_whole(t:[]u8, cnt:*i64)i64 {
    let any:i64=verdict_span(t, cnt) as i64;
    return 4294967296+any;
}

fn arm_fixed(t:[]u8, w:i32, cnt:*i64)i64 {
    let n:i32=t.len;
    let off:i32=0;
    let any:i32=0;
    let nc:i32=0;
    while(off<n){
        let e:i32=off+w;
        if(e>n){ e=n; }
        if(verdict_span(t[off..e], cnt)==1){ any=1; }
        nc=nc+1;
        off=e;
    }
    return ((nc as i64)<<32)+(any as i64);
}

fn arm_diagunion(t:[]u8, cnt:*i64)i64 {
    let n:i32=t.len;
    let off:i32=0;
    let pf:i32=0;
    let nf:i32=0;
    let nc:i32=0;
    while(off<n){
        let e:i32=off+512;
        if(e>n){ e=n; }
        if(fire_pos(t[off..e], cnt)==1){ pf=1; }
        if(fire_neg(t[off..e], cnt)==1){ nf=1; }
        nc=nc+1;
        off=e;
    }
    let any:i32=0;
    if(pf==1 && nf==1){ any=1; }
    return ((nc as i64)<<32)+(any as i64);
}

// ADAPTIVE: paragraph-break candidates + hard 4000-byte cap; unresolved
// markers look ahead up to W bytes for the conjunction partner and extend
// through it; else split. Forced cap always splits (no lookahead).
fn arm_adaptive(t:[]u8, W:i32, cnt:*i64)i64 {
    let n:i32=t.len;
    let cs:i32=0;
    let sp:i32=0;
    let any:i32=0;
    let nc:i32=0;
    while(1==1){
        let p:i32=find_para_break(t, sp);
        let cap:i32=cs+4000;
        let b:i32=-1;
        let adv:i32=0;
        let forced:i32=0;
        if(p!=-1 && p<cap){ b=p; adv=2; }
        else {
            if(cap<n){ b=cap; forced=1; }
        }
        if(b==-1){
            if(verdict_span(t[cs..n], cnt)==1){ any=1; }
            nc=nc+1;
            break;
        }
        let extended:i32=0;
        if(forced==0){
            let pf:i32=fire_pos(t[cs..b], cnt);
            let nf:i32=fire_neg(t[cs..b], cnt);
            if(pf!=nf){
                let lo:i32=b+adv;
                let hi:i32=lo+W;
                if(hi>n){ hi=n; }
                let side:i32=0;
                if(pf==1){ side=1; }
                let pe:i32=first_end(t, lo, hi, side, cnt);
                if(pe!=-1){
                    sp=pe;
                    extended=1;
                }
            }
        }
        if(extended==0){
            if(verdict_span(t[cs..b], cnt)==1){ any=1; }
            nc=nc+1;
            cs=b+adv;
            sp=cs;
        }
    }
    return ((nc as i64)<<32)+(any as i64);
}

// ---------- driver ----------

fn print_result(id:[]u8, label:[]u8, arm:[]u8, pk:i64, comps:i64)void {
    let any:i32=(pk & 1) as i32;
    let nc:i64=pk>>32;
    _zag_print(id);
    _zag_print("|");
    _zag_print(label);
    _zag_print("|");
    _zag_print(arm);
    _zag_print("|");
    if(any==1){ _zag_print("ENDORSE"); } else { _zag_print("WITHHOLD"); }
    _zag_print("|comps=");
    _zag_print(_zag_i64_to_str(comps));
    _zag_print("|chunks=");
    _zag_print(_zag_i64_to_str(nc));
    _zag_print("\n");
    return;
}

fn want_arm(mode:[]u8, name:[]u8)i32 {
    if(cmp_eq(mode,"ALL")==1){ return 1; }
    return cmp_eq(mode,name);
}

fn run_arm(mode:[]u8, aname:[]u8, t:[]u8, id:[]u8, label:[]u8, W:i32,
            tot_endorse:*i64, tot_comps:*i64, n_items:*i64)void {
    if(want_arm(mode, aname)==0){ return; }
    let cp:*i64=_zag_malloc(8) as *i64;
    cp[0]=0;
    let pk:i64=0;
    if(cmp_eq(aname,"WHOLE")==1){ pk=arm_whole(t, cp); }
    else {
        if(cmp_eq(aname,"FIXED64")==1){ pk=arm_fixed(t, 64, cp); }
        else {
            if(cmp_eq(aname,"FIXED512")==1){ pk=arm_fixed(t, 512, cp); }
            else {
                if(cmp_eq(aname,"ADAPTIVE")==1){ pk=arm_adaptive(t, W, cp); }
                else { pk=arm_diagunion(t, cp); }
            }
        }
    }
    let comps:i64=cp[0];
    print_result(id, label, aname, pk, comps);
    tot_endorse[0]=tot_endorse[0]+(pk & 1);
    tot_comps[0]=tot_comps[0]+comps;
    n_items[0]=n_items[0]+1;
    return;
}

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let mode:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let ws:[]u8=arg_copy(4);
    let W:i32=1600;
    if(ws.len>0){ W=parse_i32(ws); }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    // per-arm accumulators (fixed order): WHOLE FIXED64 FIXED512 ADAPTIVE DIAGUNION
    let e0:*i64=_zag_malloc(8) as *i64; e0[0]=0;
    let c0:*i64=_zag_malloc(8) as *i64; c0[0]=0;
    let n0:*i64=_zag_malloc(8) as *i64; n0[0]=0;
    let e1:*i64=_zag_malloc(8) as *i64; e1[0]=0;
    let c1:*i64=_zag_malloc(8) as *i64; c1[0]=0;
    let n1:*i64=_zag_malloc(8) as *i64; n1[0]=0;
    let e2:*i64=_zag_malloc(8) as *i64; e2[0]=0;
    let c2:*i64=_zag_malloc(8) as *i64; c2[0]=0;
    let n2:*i64=_zag_malloc(8) as *i64; n2[0]=0;
    let e3:*i64=_zag_malloc(8) as *i64; e3[0]=0;
    let c3:*i64=_zag_malloc(8) as *i64; c3[0]=0;
    let n3:*i64=_zag_malloc(8) as *i64; n3[0]=0;
    let e4:*i64=_zag_malloc(8) as *i64; e4[0]=0;
    let c4:*i64=_zag_malloc(8) as *i64; c4[0]=0;
    let n4:*i64=_zag_malloc(8) as *i64; n4[0]=0;

    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep1:i32=0;
            while(sep1<line.len && line[sep1]!=124){ sep1=sep1+1; }
            let sep2:i32=sep1+1;
            while(sep2<line.len && line[sep2]!=124){ sep2=sep2+1; }
            if(sep1<line.len && sep2<line.len){
                let id:[]u8=line[0..sep1];
                let label:[]u8=line[sep1+1..sep2];
                let esc:[]u8=line[sep2+1..line.len];
                // unescape + lowercase into buf
                let buf:[]u8=nio_alloc(esc.len+1);
                let bi:i32=0;
                let ei:i32=0;
                while(ei<esc.len){
                    let ch:u8=esc[ei];
                    if(ch==92 && ei+1<esc.len){
                        let d:u8=esc[ei+1];
                        if(d==110){ buf[bi]=10; } else { buf[bi]=d; }
                        bi=bi+1;
                        ei=ei+2;
                    }
                    else {
                        if(ch>=65 && ch<=90){ buf[bi]=ch+32; }
                        else { buf[bi]=ch; }
                        bi=bi+1;
                        ei=ei+1;
                    }
                }
                let t:[]u8=buf[0..bi];
                run_arm(mode,"WHOLE",t,id,label,W,e0,c0,n0);
                run_arm(mode,"FIXED64",t,id,label,W,e1,c1,n1);
                run_arm(mode,"FIXED512",t,id,label,W,e2,c2,n2);
                run_arm(mode,"ADAPTIVE",t,id,label,W,e3,c3,n3);
                run_arm(mode,"DIAGUNION",t,id,label,W,e4,c4,n4);
            }
        }
        pos=eol+1;
    }
    // summaries in fixed arm order
    let arms_done:i32=0;
    if(want_arm(mode,"WHOLE")==1){
        _zag_print("SUMMARY ARM=WHOLE n=");
        _zag_print(_zag_i64_to_str(n0[0]));
        _zag_print(" endorse=");
        _zag_print(_zag_i64_to_str(e0[0]));
        _zag_print(" comps_total=");
        _zag_print(_zag_i64_to_str(c0[0]));
        _zag_print("\n");
        arms_done=arms_done+1;
    }
    if(want_arm(mode,"FIXED64")==1){
        _zag_print("SUMMARY ARM=FIXED64 n=");
        _zag_print(_zag_i64_to_str(n1[0]));
        _zag_print(" endorse=");
        _zag_print(_zag_i64_to_str(e1[0]));
        _zag_print(" comps_total=");
        _zag_print(_zag_i64_to_str(c1[0]));
        _zag_print("\n");
        arms_done=arms_done+1;
    }
    if(want_arm(mode,"FIXED512")==1){
        _zag_print("SUMMARY ARM=FIXED512 n=");
        _zag_print(_zag_i64_to_str(n2[0]));
        _zag_print(" endorse=");
        _zag_print(_zag_i64_to_str(e2[0]));
        _zag_print(" comps_total=");
        _zag_print(_zag_i64_to_str(c2[0]));
        _zag_print("\n");
        arms_done=arms_done+1;
    }
    if(want_arm(mode,"ADAPTIVE")==1){
        _zag_print("SUMMARY ARM=ADAPTIVE W=");
        _zag_print(_zag_i64_to_str(W as i64));
        _zag_print(" n=");
        _zag_print(_zag_i64_to_str(n3[0]));
        _zag_print(" endorse=");
        _zag_print(_zag_i64_to_str(e3[0]));
        _zag_print(" comps_total=");
        _zag_print(_zag_i64_to_str(c3[0]));
        _zag_print("\n");
        arms_done=arms_done+1;
    }
    if(want_arm(mode,"DIAGUNION")==1){
        _zag_print("SUMMARY ARM=DIAGUNION n=");
        _zag_print(_zag_i64_to_str(n4[0]));
        _zag_print(" endorse=");
        _zag_print(_zag_i64_to_str(e4[0]));
        _zag_print(" comps_total=");
        _zag_print(_zag_i64_to_str(c4[0]));
        _zag_print("\n");
        arms_done=arms_done+1;
    }
    if(arms_done==0){ _zag_print("ERR mode\n"); }
    return;
}

// Typo inference over the keyboard-geometry knowledge + battery runner.
//
// INFERENCE (pure Zag):
//   Intended-word recovery: for a typed string T, every known word W is
//   scored by keyboard-weighted restricted-Damerau edit distance:
//     substitution(a,b) = kb_sub_cost(a,b)   (0/10/20/30/40 from geometry)
//     insertion = deletion = 15
//     adjacent transposition = 10
//   Candidates rank by (score asc, word-list order asc); top-1 is the
//   inferred intended word.
//   Baseline (keyboard-blind): identical DP, but substitution is uniform
//   (0 if same else 10). Same constants otherwise, so the head-to-head
//   isolates exactly the keyboard geometry knowledge.
//   Character-level: given one mistyped char c, rank all 26 letters by
//   kb_sub_cost(c, .) -> the most likely intended letter.
//
// BATTERY RUNNER:
//   argv: workdir wordsfile itemsfile resultsfile
//   items lines: typed \t truth \t kind   (kind in S1/S2/RW)
//   results lines: typed \t truth \t kind \t kb_rank \t bl_rank \t char_rank
//   char_rank = 0 for non-S1 items.
//   stdout: ITEMS <n> then DONE. Deterministic: no RNG, fixed order.
//
// PURE ZAG, zero RNG, byte-identical reruns.
@import("R33_NATIVE_IO_V1.zag")
@import("typo_infer.zag")

fn numstr(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let e:i32=s.len;
    if(e>0 && s[e-1]==10){ e=e-1; }
    return s[0..e];
}

fn read_all(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(8388608);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,8388608);
    nio_close(fd);
    if(n<=0){ return ""; }
    return buf[0..(n as i32)];
}

// Split buffer into lines: record (start,len) per line into off/ln.
// Returns line count. Lines longer than 255 bytes are rejected (counted).
fn parse_lines(b:[]u8, off:[]i64, ln:[]i64, maxn:i32)i32 {
    let nw:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<b.len){
        if(b[i]==10){
            if(i>st && nw<maxn){
                off[nw]=st as i64;
                ln[nw]=(i-st) as i64;
                nw=nw+1;
            }
            st=i+1;
        }
        i=i+1;
    }
    if(st<b.len && nw<maxn){
        off[nw]=st as i64;
        ln[nw]=(b.len-st) as i64;
        nw=nw+1;
    }
    return nw;
}

fn buf_eq(a:[]u8, s1:i32, b:[]u8, s2:i32, l:i32)i32 {
    let i:i32=0;
    while(i<l){
        if(a[s1+i]!=b[s2+i]){ return 0; }
        i=i+1;
    }
    return 1;
}

// (edit distance lives in typo_infer.zag as infer_dist; the battery runner
// only handles I/O, ranking, and output.)

fn w_str(ob:[]u8, pos:i32, s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        ob[pos]=s[i];
        pos=pos+1;
        i=i+1;
    }
    return pos;
}

fn w_i64(ob:[]u8, pos:i32, v:i64)i32 {
    let s:[]u8=_zag_i64_to_str(v);
    let e:i32=s.len;
    if(e>0 && s[e-1]==10){ e=e-1; }
    let i:i32=0;
    while(i<e){
        ob[pos]=s[i];
        pos=pos+1;
        i=i+1;
    }
    nio_free(s);
    return pos;
}

fn w_byte(ob:[]u8, pos:i32, c:u8)i32 {
    ob[pos]=c;
    return pos+1;
}

fn main()void {
    let workdir:[]u8=_zag_arg(1);
    let wordsname:[]u8=_zag_arg(2);
    let itemsname:[]u8=_zag_arg(3);
    let outname:[]u8=_zag_arg(4);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_println("ERR workdir"); return; }
    let wb:[]u8=read_all(root,wordsname);
    let ib:[]u8=read_all(root,itemsname);
    nio_close(root);
    if(wb.len==0){ _zag_println("ERR words"); return; }
    if(ib.len==0){ _zag_println("ERR items"); return; }

    let woff:[]i64=nio_alloc(4096*8) as []i64;
    let wlen:[]i64=nio_alloc(4096*8) as []i64;
    let nw:i32=parse_lines(wb,woff,wlen,4096);
    let ioff:[]i64=nio_alloc(65536*8) as []i64;
    let ilen:[]i64=nio_alloc(65536*8) as []i64;
    let ni:i32=parse_lines(ib,ioff,ilen,65536);
    let w:[]i64=nio_alloc(32*32*8) as []i64;
    let ob:[]u8=nio_alloc(8388608);
    if(woff.len==0 || wlen.len==0 || ioff.len==0 || ilen.len==0 || w.len==0 || ob.len==0){
        _zag_println("ERR alloc");
        return;
    }

    let pos:i32=0;
    let li:i32=0;
    while(li<ni){
        let ls:i32=ioff[li] as i32;
        let ll:i32=ilen[li] as i32;
        // split line on tabs: typed \t truth \t kind
        let t1:i32=-1;
        let t2:i32=-1;
        let k:i32=0;
        while(k<ll){
            if(ib[ls+k]==9){
                if(t1<0){ t1=k; }
                else{ t2=k; }
            }
            k=k+1;
        }
        if(t1>0 && t2>t1){
            let ts:i32=ls;
            let tl:i32=t1;
            let rs:i32=ls+t1+1;
            let rl:i32=t2-t1-1;
            let ks:i32=ls+t2+1;
            let kl:i32=ll-(t2+1);
            let typed:[]u8=ib[ts..ts+tl];
            let truth:[]u8=ib[rs..rs+rl];
            let kind:[]u8=ib[ks..ks+kl];
            if(typed.len<32 && truth.len<32){
                // find truth index in word list (truth lives in ib, words in wb)
                let tidx:i32=-1;
                let wi:i32=0;
                while(wi<nw){
                    if((wlen[wi] as i32)==rl && buf_eq(wb,woff[wi] as i32,ib,rs,rl)==1){ tidx=wi; }
                    wi=wi+1;
                }
                // truth scores first, then rank = 1 + #{strictly better, or
                // equal score but earlier in word-list order}
                let kb_ts:i64=0;
                let bl_ts:i64=0;
                wi=0;
                while(wi<nw){
                    if(wi==tidx){
                        let cand0:[]u8=wb[(woff[wi] as i32)..(woff[wi] as i32)+(wlen[wi] as i32)];
                        kb_ts=infer_dist(typed,cand0,1,w);
                        bl_ts=infer_dist(typed,cand0,0,w);
                    }
                    wi=wi+1;
                }
                let kb_rank:i64=1;
                let bl_rank:i64=1;
                wi=0;
                while(wi<nw){
                    let cand2:[]u8=wb[(woff[wi] as i32)..(woff[wi] as i32)+(wlen[wi] as i32)];
                    let sk2:i64=infer_dist(typed,cand2,1,w);
                    let sb2:i64=infer_dist(typed,cand2,0,w);
                    if(sk2<kb_ts || (sk2==kb_ts && wi<tidx)){ kb_rank=kb_rank+1; }
                    if(sb2<bl_ts || (sb2==bl_ts && wi<tidx)){ bl_rank=bl_rank+1; }
                    wi=wi+1;
                }
                // char-level rank for S1 items: first differing position
                let char_rank:i64=0;
                if(kl==2 && kind[0]==83 && kind[1]==49){
                    let dp:i32=0;
                    while(dp<tl && dp<rl && typed[dp]==truth[dp]){ dp=dp+1; }
                    if(dp<tl && dp<rl){
                        let tc:u8=truth[dp];
                        let cc:u8=typed[dp];
                        let ct:i64=kb_sub_cost(cc,tc);
                        let cr:i64=1;
                        let L:i32=0;
                        while(L<26){
                            let lc:u8=(97+L) as u8;
                            let cl:i64=kb_sub_cost(cc,lc);
                            if(cl<ct || (cl==ct && lc<tc)){ cr=cr+1; }
                            L=L+1;
                        }
                        char_rank=cr;
                    }
                }
                pos=w_str(ob,pos,typed);
                pos=w_byte(ob,pos,9);
                pos=w_str(ob,pos,truth);
                pos=w_byte(ob,pos,9);
                pos=w_str(ob,pos,kind);
                pos=w_byte(ob,pos,9);
                pos=w_i64(ob,pos,kb_rank);
                pos=w_byte(ob,pos,9);
                pos=w_i64(ob,pos,bl_rank);
                pos=w_byte(ob,pos,9);
                pos=w_i64(ob,pos,char_rank);
                pos=w_byte(ob,pos,10);
            }
        }
        li=li+1;
    }

    let root2:i64=nio_open_root(workdir);
    let ofd:i64=nio_open_child(root2,outname,1);
    nio_close(root2);
    if(ofd<0){ _zag_println("ERR output"); return; }
    let wr:i64=nio_write_all(ofd,ob[0..pos]);
    nio_close(ofd);
    if(wr!=pos as i64){ _zag_println("ERR write"); return; }
    let ns:[]u8=numstr(ni as i64);
    _zag_println("ITEMS");
    _zag_println(ns);
    _zag_println("DONE");
}

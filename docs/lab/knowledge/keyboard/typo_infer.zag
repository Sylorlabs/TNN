// Typo inference over the keyboard-geometry knowledge (qwerty.zag).
//
// DELIBERATION-FACING API:
//   infer_dist(typed, cand, use_kb, w) -> i64
//     Keyboard-weighted (use_kb=1) or keyboard-blind (use_kb=0)
//     restricted-Damerau edit distance between a typed string and one
//     candidate intended word. w is a 32x32 i64 scratch matrix; both
//     strings must be shorter than 32 bytes.
//     Costs (tenths of a substitution unit):
//       substitution = kb_sub_cost(a,b) from key geometry (KB)
//                      or 0/10 uniform (blind baseline)
//       insertion = deletion = 15
//       adjacent transposition = 10
//   kb_sub_cost(a, b)  (from qwerty.zag)
//     Single-character likelihood: how surprising is it that a finger
//     aiming for key b landed on key a? Lower = more likely typo.
//
// WORD-LEVEL USE: score every candidate word with infer_dist(.,.,1,.),
//   rank by (score asc, candidate order asc); top-1 is the inferred intent.
// CHAR-LEVEL USE: rank candidate letters for one mistyped char c by
//   kb_sub_cost(c, .); c itself always ranks first (maybe it wasn't a typo).
//
// PURE ZAG, zero RNG, deterministic.
@import("qwerty.zag")

// Keyboard-weighted (use_kb=1) or blind (use_kb=0) restricted-Damerau
// distance. w is a caller-owned 32x32 i64 scratch matrix.
fn infer_dist(s:[]u8, t:[]u8, use_kb:i32, w:[]i64)i64 {
    let m:i32=s.len;
    let n:i32=t.len;
    let i:i32=0;
    while(i<=m){
        w[i*32]=(i as i64)*15;
        i=i+1;
    }
    let j:i32=0;
    while(j<=n){
        w[j]=(j as i64)*15;
        j=j+1;
    }
    i=1;
    while(i<=m){
        j=1;
        while(j<=n){
            let sc:i64=10;
            if(use_kb==1){ sc=kb_sub_cost(s[i-1],t[j-1]); }
            if(use_kb==0 && s[i-1]==t[j-1]){ sc=0; }
            let im:i32=i-1;
            let jm:i32=j-1;
            let best:i64=w[im*32+jm]+sc;
            let c2:i64=w[i*32+jm]+15;
            if(c2<best){ best=c2; }
            let c3:i64=w[im*32+j]+15;
            if(c3<best){ best=c3; }
            if(i>1 && j>1 && s[i-1]==t[j-2] && s[i-2]==t[j-1]){
                let c4:i64=w[(i-2)*32+(j-2)]+10;
                if(c4<best){ best=c4; }
            }
            w[i*32+j]=best;
            j=j+1;
        }
        i=i+1;
    }
    return w[m*32+n];
}

// R34 quarantined pure-Zag online learner. No R27 authority or scientific exposure.
@import("../R33_CONTINUING_LIFE_V1/storage.zag")

const R34_RATE:i32=250;const R34_BYTES:i32=96;const R34_SHIFT:i32=20000;
struct R34State {q00:i32,q01:i32,q10:i32,q11:i32,rng:i32,updates:i32,pending:i32,task:i32,action:i32}

fn r34_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}
fn r34_rng(s:*R34State)i32 {let v:i32=r34_mod(s.*.rng*997+7919,1000003);s.*.rng=v;return v;}
fn r34_init(seed:i32)R34State {return R34State{.q00=0,.q01=0,.q10=0,.q11=0,.rng=seed,.updates=0,.pending=0,.task=0,.action=0};}
fn r34_q(s:*R34State,t:i32,a:i32)i32 {if(t==0){if(a==0){return s.*.q00;}return s.*.q01;}if(a==0){return s.*.q10;}return s.*.q11;}
fn r34_setq(s:*R34State,t:i32,a:i32,v:i32)void {if(t==0){if(a==0){s.*.q00=v;}else{s.*.q01=v;}}else{if(a==0){s.*.q10=v;}else{s.*.q11=v;}}}
fn r34_choose(s:*R34State,t:i32,record:i32)i32 {
    let a:i32=r34_q(s,t,0);let b:i32=r34_q(s,t,1);let pick:i32=0;
    if(b>a){pick=1;}else if(a==b){pick=r34_mod(r34_rng(s),2);}
    if(record==1){if(s.*.pending==1){return -1;}s.*.pending=1;s.*.task=t;s.*.action=pick;}
    return pick;
}
fn r34_reward(t:i32,a:i32)i32 {if(t==0){if(a==0){return 1000;}return -1000;}if(a==1){return 1000;}return -1000;}
fn r34_update(s:*R34State,reward:i32,enabled:i32)i32 {
    if(s.*.pending!=1){return 2001;}
    if(enabled==1){let old:i32=r34_q(s,s.*.task,s.*.action);r34_setq(s,s.*.task,s.*.action,old+(reward-old)*R34_RATE/1000);s.*.updates=s.*.updates+1;}
    s.*.pending=0;return 0;
}
fn r34_train(s:*R34State,t:i32,n:i32,enabled:i32)i32 {let i:i32=0;while(i<n){let a:i32=r34_choose(s,t,1);if(a<0){return 2001;}r34_update(s,r34_reward(t,a),enabled);i=i+1;}return 0;}
fn r34_eval(s:*R34State,t:i32)i32 {let a:i32=r34_q(s,t,0);let b:i32=r34_q(s,t,1);let pick:i32=0;if(b>a){pick=1;}if((t==0&&pick==0)||(t==1&&pick==1)){return 64;}return 0;}
fn r34_equal(a:*R34State,b:*R34State)i32 {return (a.*.q00==b.*.q00&&a.*.q01==b.*.q01&&a.*.q10==b.*.q10&&a.*.q11==b.*.q11&&a.*.rng==b.*.rng&&a.*.updates==b.*.updates&&a.*.pending==b.*.pending&&a.*.task==b.*.task&&a.*.action==b.*.action) as i32;}
fn r34_puts(b:[]u8,at:i32,v:i32)i32 {return cl_put(b,at,(v+R34_SHIFT) as i64);}
fn r34_gets(b:[]u8,at:i32)i32 {return (cl_u32(b,at) as i32)-R34_SHIFT;}
fn r34_encode(s:*R34State,out:[]u8)i32 {
    if(out.len!=R34_BYTES||s.*.rng<0||s.*.rng>1000003||s.*.updates<0||s.*.updates>1000000){return 2001;}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    cl_copy(out[0..8],"R34LRN01");cl_put(out,8,1);cl_put(out,12,R34_BYTES);
    r34_puts(out,16,s.*.q00);r34_puts(out,20,s.*.q01);r34_puts(out,24,s.*.q10);r34_puts(out,28,s.*.q11);
    cl_put(out,32,s.*.rng);cl_put(out,36,s.*.updates);cl_put(out,40,s.*.pending);cl_put(out,44,s.*.task);cl_put(out,48,s.*.action);
    if(ns_sha256(out[0..64],out[64..96])!=0){return 2004;}return 0;
}
fn r34_decode(input:[]u8,s:*R34State)i32 {
    if(input.len!=R34_BYTES||nio_equal(input[0..8],"R34LRN01")!=1||cl_u32(input,8)!=1||cl_u32(input,12)!=R34_BYTES||cl_hash_is(input[0..64],input[64..96])!=1){return 2005;}
    let t:R34State=R34State{.q00=r34_gets(input,16),.q01=r34_gets(input,20),.q10=r34_gets(input,24),.q11=r34_gets(input,28),.rng=cl_u32(input,32) as i32,.updates=cl_u32(input,36) as i32,.pending=cl_u32(input,40) as i32,.task=cl_u32(input,44) as i32,.action=cl_u32(input,48) as i32};
    if(t.pending<0||t.pending>1||t.task<0||t.task>1||t.action<0||t.action>1||t.q00< -16000||t.q00>16000||t.q01< -16000||t.q01>16000||t.q10< -16000||t.q10>16000||t.q11< -16000||t.q11>16000){return 2005;}s.*=t;return 0;
}
fn r34_fp(s:*R34State)i32 {return r34_mod(s.*.q00*3+s.*.q01*5+s.*.q10*7+s.*.q11*11+s.*.rng*13+s.*.updates*17+s.*.pending*19+s.*.task*23+s.*.action*29,1000003);}
fn r34_emit_fp(s:*R34State)void {_zag_print("R34_FP,");cl_number(r34_fp(s));_zag_println("");}
fn r34_write_file(rootp:[]u8,leaf:[]u8,kind:i32)i32 {
    let s:R34State=r34_init(7331);if(r34_train(&s,0,96,1)!=0||r34_train(&s,1,96,1)!=0){return 1;}
    let b:[]u8=nio_alloc(R34_BYTES);if(b.len!=R34_BYTES||r34_encode(&s,b)!=0){return 1;}
    let view:[]u8=b;if(kind==1){b[24]=(b[24]+1) as u8;}if(kind==2){view=b[0..80];}
    let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){nio_free(b);return 2;}let rc:i32=cl_file_write(root,leaf,view);nio_close(root);r34_emit_fp(&s);nio_free(b);return (rc!=0) as i32;
}
fn r34_reload_file(rootp:[]u8,leaf:[]u8,expect_bad:i32)i32 {
    let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){return 2;}let b:[]u8=nio_alloc(R34_BYTES);let n:i32=cl_file_read(root,leaf,b);nio_close(root);if(n<0||cl_is_status(n)==1){nio_free(b);return 3;}
    let s:R34State=r34_init(1);let rc:i32=2005;if(n==R34_BYTES){rc=r34_decode(b,&s);}nio_free(b);
    if(expect_bad==1){_zag_print("R34_REFUSAL,");cl_number(rc);_zag_println("");return (rc!=2005) as i32;}
    if(rc!=0){return 4;}let f:i32=0;f=f+cl_check("reload_A",r34_eval(&s,0),64);f=f+cl_check("reload_B",r34_eval(&s,1),64);f=f+cl_check("reload_updates",s.updates,192);r34_emit_fp(&s);return (f!=0) as i32;
}

fn r34_selftest()i32 {
    let f:i32=0;let s:R34State=r34_init(7331);
    f=f+cl_check("baseline_A",r34_eval(&s,0),64);f=f+cl_check("baseline_B",r34_eval(&s,1),0);
    f=f+cl_check("train_A",r34_train(&s,0,96,1),0);f=f+cl_check("acquire_A",r34_eval(&s,0),64);
    f=f+cl_check("train_B",r34_train(&s,1,96,1),0);f=f+cl_check("retain_A",r34_eval(&s,0),64);f=f+cl_check("acquire_B",r34_eval(&s,1),64);f=f+cl_check("updates",s.updates,192);
    let c:R34State=r34_init(7331);f=f+cl_check("control_train",r34_train(&c,1,96,0),0);f=f+cl_check("control_updates",c.updates,0);f=f+cl_check("control_B",r34_eval(&c,1),0);
    let a:R34State=r34_init(991);let b:R34State=r34_init(991);let i:i32=0;while(i<32){let x:i32=r34_choose(&a,i%2,1);let y:i32=r34_choose(&b,i%2,1);f=f+cl_check("same_choice",x,y);r34_update(&a,r34_reward(i%2,x),1);r34_update(&b,r34_reward(i%2,y),1);i=i+1;}f=f+cl_check("deterministic_state",r34_equal(&a,&b),1);
    _zag_print("R34_Q,");cl_number(s.q00);_zag_print(",");cl_number(s.q01);_zag_print(",");cl_number(s.q10);_zag_print(",");cl_number(s.q11);_zag_println("");
    let bytes:[]u8=nio_alloc(R34_BYTES);f=f+cl_check("encode",r34_encode(&s,bytes),0);let round:R34State=r34_init(1);f=f+cl_check("decode",r34_decode(bytes,&round),0);f=f+cl_check("roundtrip",r34_equal(&s,&round),1);let corrupt:[]u8=nio_alloc(R34_BYTES);cl_copy(corrupt,bytes);corrupt[20]=(corrupt[20]+1) as u8;f=f+cl_check("corrupt_refused",r34_decode(corrupt,&round),2005);f=f+cl_check("torn_refused",r34_decode(bytes[0..80],&round),2005);nio_free(bytes);nio_free(corrupt);
    r34_emit_fp(&s);_zag_print("R34_FAILURES,");cl_number(f);_zag_println("");return (f!=0) as i32;
}
fn main()i32 {
    if(_zag_argc()==1){return r34_selftest();}if(_zag_argc()!=3){return 64;}let mode:[]u8=_zag_arg(1);let root:[]u8=_zag_arg(2);
    if(nio_equal(mode,"write")==1){return r34_write_file(root,"learner.bin",0);}if(nio_equal(mode,"reload")==1){return r34_reload_file(root,"learner.bin",0);}
    if(nio_equal(mode,"write-corrupt")==1){return r34_write_file(root,"corrupt.bin",1);}if(nio_equal(mode,"refuse-corrupt")==1){return r34_reload_file(root,"corrupt.bin",1);}
    if(nio_equal(mode,"write-torn")==1){return r34_write_file(root,"torn.bin",2);}if(nio_equal(mode,"refuse-torn")==1){return r34_reload_file(root,"torn.bin",1);}return 64;
}

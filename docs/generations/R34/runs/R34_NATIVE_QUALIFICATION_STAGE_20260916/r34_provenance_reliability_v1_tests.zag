@import("r34_provenance_reliability_v1.zag")

fn main()i32 {
    let failures:i32=0;
    let prob:[]f32=zalloc(6);let loss:[]f32=zalloc(6);let meta:[]f32=zalloc(6);
    let alphas:[]f32=zalloc(3);alphas[0]=0.02;alphas[1]=0.10;alphas[2]=0.35;
    if(r34p1_init(prob,loss,meta,2,3)!=R34P1_OK){failures=failures+1;}
    let p0:f64=0.0;if(r34p1_prob(prob,meta,0,3,&p0)!=R34P1_OK || p0<0.49 || p0>0.51){failures=failures+1;}
    let i:i32=0;while(i<12){if(r34p1_audit(prob,loss,meta,0,3,alphas,1,0.10,0.18)!=R34P1_OK){failures=failures+1;}i=i+1;}
    let good:f64=0.0;if(r34p1_prob(prob,meta,0,3,&good)!=R34P1_OK || good<=0.65){failures=failures+1;}
    // A second opaque source remains neutral; no source hierarchy leaks across IDs.
    let p1:f64=0.0;if(r34p1_prob(prob,meta,1,3,&p1)!=R34P1_OK || p1<0.49 || p1>0.51){failures=failures+1;}
    // Drift can make formerly good evidence inhibitory after enough contrary audits.
    i=0;while(i<30){if(r34p1_audit(prob,loss,meta,0,3,alphas,0,0.10,0.18)!=R34P1_OK){failures=failures+1;}i=i+1;}
    let w:f64=0.0;if(r34p1_signed_weight(prob,meta,0,3,&w)!=R34P1_OK || !(w<0.0)){failures=failures+1;}
    let credit:f64=0.0;if(r34p1_apply_credit(1.0,w,&credit)!=R34P1_OK || !(credit<0.0)){failures=failures+1;}
    let bp:[]f32=zalloc(6);let bl:[]f32=zalloc(6);let bm:[]f32=zalloc(6);let j:i32=0;while(j<6){bp[j]=prob[j];bl[j]=loss[j];bm[j]=meta[j];j=j+1;}
    if(r34p1_state_equal(prob,loss,meta,bp,bl,bm)!=1){failures=failures+1;}
    _zag_print("R34_PROVENANCE_RELIABILITY_V1_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));
    return (failures!=0) as i32;
}

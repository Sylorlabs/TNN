// R34 continual-learning foundation: learner-controlled exact-memory retention V1.
//
// Design boundary:
// - generic protected substrate owns capacity, integrity, provenance and save/reload;
// - TNN-owned learner weights decide marginal exact-retention value under pressure;
// - future query/use outcomes provide delayed credit and regret;
// - no age schedule, evaluator label, hidden future query, task identity, graph,
//   tokenizer, transformer, LLM or human importance score enters a decision.
// - caller-owned arrays make state/checkpoint ownership explicit.
//
// This file is a staged native Zag v2 candidate. Promotion requires compilation
// and execution with the pinned local compiler in the continuing accepted state.

const R34M1_OK:i32=0;
const R34M1_BAD:i32=-34101;
const R34M1_SHAPE:i32=-34102;
const R34M1_NUMERIC:i32=-34103;
const R34M1_FEATURES:i32=8;

fn r34m1_clamp01(x:f64)f64 @noalloc {
    if(x<0.0){return 0.0;}
    if(x>1.0){return 1.0;}
    return x;
}

fn r34m1_finite(x:f64)i32 @noalloc {
    return (x==x && x<1.0e6 && x>(-1.0e6)) as i32;
}

// Bounded linear future-use estimate. The simple form is deliberate: delayed
// credit and policy behavior remain inspectable, deterministic and portable.
fn r34m1_predict(weights:[]f32,bias:f32,features:[]f32,out:*f32)i32 @noalloc {
    if(out==null as *f32 || weights.len!=R34M1_FEATURES || features.len!=R34M1_FEATURES){return R34M1_SHAPE;}
    let z:f64=bias as f64;
    let i:i32=0;
    while(i<R34M1_FEATURES){
        let w:f64=weights[i] as f64;let x:f64=features[i] as f64;
        if(r34m1_finite(w)!=1 || r34m1_finite(x)!=1){return R34M1_NUMERIC;}
        z=z+w*x;i=i+1;
    }
    if(r34m1_finite(z)!=1){return R34M1_NUMERIC;}
    out.*=r34m1_clamp01(0.5+0.25*z) as f32;
    return R34M1_OK;
}

// Delayed full-information credit: after later use reveals whether exact detail
// mattered, update the future-use estimator. target must be 0 or 1.
fn r34m1_delayed_credit(weights:[]f32,bias:*f32,features:[]f32,target:i32,lr:f64)i32 @noalloc {
    if(bias==null as *f32 || weights.len!=R34M1_FEATURES || features.len!=R34M1_FEATURES ||
       (target!=0 && target!=1) || !(lr>0.0) || r34m1_finite(lr)!=1){return R34M1_SHAPE;}
    let pred:f32=0.0;let rc:i32=r34m1_predict(weights,bias.*,features,&pred);if(rc!=R34M1_OK){return rc;}
    let error:f64=(target as f64)-(pred as f64);
    // The bounded linear map has slope .25 away from clamp edges. Keep a small
    // learning path at the boundary so later regret can recover a saturated model.
    let g:f64=0.25;if(pred<=0.0 || pred>=1.0){g=0.05;}
    bias.*=((bias.* as f64)+lr*error*g) as f32;
    let i:i32=0;
    while(i<R34M1_FEATURES){
        weights[i]=((weights[i] as f64)+lr*error*g*(features[i] as f64)) as f32;
        if(r34m1_finite(weights[i] as f64)!=1){return R34M1_NUMERIC;}
        i=i+1;
    }
    return R34M1_OK;
}

// Pick an exact-memory slot only when the protected exact store is under
// pressure. Returns an empty slot if one exists. When full, out_slot=-1 means
// the incoming episode remains structured but does not displace existing exact
// evidence. Otherwise out_slot is the lowest predicted future-use slot.
// Ties prefer evicting the oldest stored episode; an equally valued incoming
// episode does not displace existing exact evidence.
fn r34m1_choose_exact_slot(weights:[]f32,bias:f32,slot_features:[]f32,slot_step:[]i32,
    slot_live:[]i32,capacity:i32,incoming:[]f32,incoming_step:i32,out_slot:*i32)i32 @noalloc {
    if(out_slot==null as *i32 || capacity<1 || weights.len!=R34M1_FEATURES || incoming.len!=R34M1_FEATURES ||
       slot_features.len!=capacity*R34M1_FEATURES || slot_step.len!=capacity || slot_live.len!=capacity){return R34M1_SHAPE;}
    let s:i32=0;
    while(s<capacity){if(slot_live[s]==0){out_slot.*=s;return R34M1_OK;}if(slot_live[s]!=1){return R34M1_BAD;}s=s+1;}
    let incoming_value:f32=0.0;let rc:i32=r34m1_predict(weights,bias,incoming,&incoming_value);if(rc!=R34M1_OK){return rc;}
    let worst_slot:i32=0;let worst_value:f32=0.0;
    let first:[]f32=slot_features[0..R34M1_FEATURES];
    if(r34m1_predict(weights,bias,first,&worst_value)!=R34M1_OK){return R34M1_NUMERIC;}
    s=1;
    while(s<capacity){
        let v:f32=0.0;let view:[]f32=slot_features[s*R34M1_FEATURES..s*R34M1_FEATURES+R34M1_FEATURES];
        if(r34m1_predict(weights,bias,view,&v)!=R34M1_OK){return R34M1_NUMERIC;}
        if(v<worst_value || (v==worst_value && slot_step[s]<slot_step[worst_slot])){worst_value=v;worst_slot=s;}
        s=s+1;
    }
    if(incoming_value<=worst_value){out_slot.*=-1;return R34M1_OK;}
    out_slot.*=worst_slot;
    return R34M1_OK;
}

fn r34m1_store_exact(slot_features:[]f32,slot_step:[]i32,slot_live:[]i32,capacity:i32,
    slot:i32,features:[]f32,step:i32)i32 @noalloc {
    if(capacity<1 || slot<0 || slot>=capacity || features.len!=R34M1_FEATURES ||
       slot_features.len!=capacity*R34M1_FEATURES || slot_step.len!=capacity || slot_live.len!=capacity){return R34M1_SHAPE;}
    let i:i32=0;while(i<R34M1_FEATURES){slot_features[slot*R34M1_FEATURES+i]=features[i];i=i+1;}
    slot_step[slot]=step;slot_live[slot]=1;return R34M1_OK;
}

fn r34m1_release_exact(slot_live:[]i32,slot:i32)i32 @noalloc {
    if(slot<0 || slot>=slot_live.len){return R34M1_SHAPE;}
    slot_live[slot]=0;return R34M1_OK;
}

@import("r34_hypothesis_state_v1.zag")

fn main()i32 {
    let failures:i32=0;

    // Ranking preserves multiple live alternatives and exposes a margin.
    let support:[]f64=zalloc(3);support[0]=1.0;support[1]=2.5;support[2]=2.0;let active:[]i32=zalloc(3);active[0]=1;active[1]=1;active[2]=1;let r:R34H1Ranking=R34H1Ranking{.top_slot=-1,.second_slot=-1,.top_score=0.0,.second_score=0.0,.margin=0.0,.active_count=0};
    if(r34h1_rank(support,active,&r)!=R34H1_OK || r.top_slot!=1 || r.second_slot!=2 || r.margin<0.49 || r.margin>0.51){failures=failures+1;}

    // Contradictory new evidence can overturn old support when learned weights say so.
    let s2:[]f64=zalloc(2);s2[0]=3.0;let a2:[]i32=zalloc(2);a2[0]=1;a2[1]=1;let w:[]f32=zalloc(2);w[0]=1.0;w[1]=1.0;let ev:[]f32=zalloc(4);ev[0]=-2.0;ev[1]=-2.0;ev[2]=2.0;ev[3]=2.0;
    if(r34h1_observe(s2,a2,ev,w,2,2,0.5)!=R34H1_OK){failures=failures+1;}
    let r2:R34H1Ranking=R34H1Ranking{.top_slot=-1,.second_slot=-1,.top_score=0.0,.second_score=0.0,.margin=0.0,.active_count=0};
    if(r34h1_rank(s2,a2,&r2)!=R34H1_OK || r2.top_slot!=1){failures=failures+1;}

    // Delayed pairwise credit moves generic evidence weights toward useful evidence.
    let cw:[]f32=zalloc(2);let good:[]f32=zalloc(2);good[0]=1.0;good[1]=0.5;let bad:[]f32=zalloc(2);bad[1]=0.1;
    if(r34h1_pairwise_credit(cw,good,bad,0.2,1.0)!=R34H1_OK || cw[0]<=0.0 || cw[1]<=0.0){failures=failures+1;}

    // Caller-owned state is copy-equivalent for checkpoint/reload verification.
    let sa:[]f64=zalloc(2);sa[0]=1.25;sa[1]=-0.5;let aa:[]i32=zalloc(2);aa[0]=1;let sb:[]f64=zalloc(2);sb[0]=1.25;sb[1]=-0.5;let ab:[]i32=zalloc(2);ab[0]=1;
    if(r34h1_state_equal(sa,aa,sb,ab)!=1){failures=failures+1;}

    _zag_print("R34_HYPOTHESIS_STATE_V1_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));
    return (failures!=0) as i32;
}

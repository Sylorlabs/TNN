@import("r34_self_model_v1.zag")
fn main()i32 {
    let failures:i32=0;let fdim:i32=2;let s:i32=2;
    let psw:[]f32=zalloc(4);let pfw:[]f32=zalloc(4);let csw:[]f32=zalloc(4);let cfw:[]f32=zalloc(4);
    let psb:[]f32=zalloc(2);let pfb:[]f32=zalloc(2);let csb:[]f32=zalloc(2);let cfb:[]f32=zalloc(2);
    let pse:[]f32=zalloc(2);let pfe:[]f32=zalloc(2);let cse:[]f32=zalloc(2);let cfe:[]f32=zalloc(2);let n:[]i64=zalloc(2);
    if(r34s1_init(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,n,s,fdim,0.5,0.15)!=R34S1_OK){failures=failures+1;}
    let x:[]f32=zalloc(2);x[0]=0.25;x[1]=-0.4;let p0:R34S1Prediction=R34S1Prediction{.success=0,.cost=0,.utility=0,.uncertainty=0};
    if(r34s1_predict(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,0,fdim,x,&p0)!=R34S1_OK){failures=failures+1;}
    let i:i32=0;while(i<20){if(r34s1_delayed_outcome(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,n,0,fdim,x,1,0.04,0.02,0.10,0.02,0.08)!=R34S1_OK){failures=failures+1;}i=i+1;}
    i=0;while(i<20){if(r34s1_delayed_outcome(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,n,1,fdim,x,0,0.30,0.02,0.10,0.02,0.08)!=R34S1_OK){failures=failures+1;}i=i+1;}
    let good:R34S1Prediction=R34S1Prediction{.success=0,.cost=0,.utility=0,.uncertainty=0};let poor:R34S1Prediction=R34S1Prediction{.success=0,.cost=0,.utility=0,.uncertainty=0};
    if(r34s1_predict(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,0,fdim,x,&good)!=R34S1_OK || r34s1_predict(psw,pfw,csw,cfw,psb,pfb,csb,cfb,pse,pfe,cse,cfe,1,fdim,x,&poor)!=R34S1_OK || !(good.utility>poor.utility)){failures=failures+1;}
    if(n[0]!=20 || n[1]!=20){failures=failures+1;}
    let copy:[]f32=zalloc(4);let cn:[]i64=zalloc(2);let j:i32=0;while(j<4){copy[j]=psw[j];j=j+1;}cn[0]=n[0];cn[1]=n[1];
    if(r34s1_state_equal(psw,copy)!=1 || r34s1_counts_equal(n,cn)!=1){failures=failures+1;}
    _zag_print("R34_SELF_MODEL_V1_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));return (failures!=0) as i32;
}

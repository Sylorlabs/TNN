// R34 v2 quarantined pure-Zag continual learner over the R33 delayed-consequence world.
// The learner consumes observations and delayed scalar outcomes only. Hidden regime state stays in world.zag.
@import("../R33_CONTINUING_LIFE_V1/world.zag")
@import("../R33_CONTINUING_LIFE_V1/checkpoint.zag")

const R34V2_STATE_BYTES:i32=160;
const R34V2_WORLD_BYTES:i32=96;
const R34V2_CHECKPOINT_BYTES:i32=2048;
const R34V2_SCORE_SHIFT:i32=40000;

struct R34V2State {
    s00:i32,s01:i32,s10:i32,s11:i32,
    n00:i32,n01:i32,n10:i32,n11:i32,
    rng:i32,updates:i32,active:i32,contexts:i32,
    pending:i32,pending_action:i32,pending_context:i32,pending_object:i32,pending_explore:i32,
    decisions:i32,switches:i32,outcomes:i32
}

fn r34v2_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}
fn r34v2_rng(s:*R34V2State)i32 {let v:i32=r34v2_mod(s.*.rng*997+7919,1000003);s.*.rng=v;return v;}
fn r34v2_init(seed:i32)R34V2State {
    return R34V2State{.s00=0,.s01=0,.s10=0,.s11=0,.n00=0,.n01=0,.n10=0,.n11=0,
        .rng=seed,.updates=0,.active=0,.contexts=1,.pending=0,.pending_action=0,.pending_context=0,
        .pending_object=0,.pending_explore=0,.decisions=0,.switches=0,.outcomes=0};
}
fn r34v2_score(s:*R34V2State,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.s00;}return s.*.s01;}if(o==0){return s.*.s10;}return s.*.s11;
}
fn r34v2_count(s:*R34V2State,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.n00;}return s.*.n01;}if(o==0){return s.*.n10;}return s.*.n11;
}
fn r34v2_set_score(s:*R34V2State,c:i32,o:i32,v:i32)void {
    if(c==0){if(o==0){s.*.s00=v;}else{s.*.s01=v;}}else{if(o==0){s.*.s10=v;}else{s.*.s11=v;}}
}
fn r34v2_inc_count(s:*R34V2State,c:i32,o:i32)void {
    if(c==0){if(o==0){s.*.n00=s.*.n00+1;}else{s.*.n01=s.*.n01+1;}}
    else{if(o==0){s.*.n10=s.*.n10+1;}else{s.*.n11=s.*.n11+1;}}
}
fn r34v2_best(s:*R34V2State,c:i32)i32 {let a:i32=r34v2_score(s,c,0);let b:i32=r34v2_score(s,c,1);if(b>a){return 1;}if(a>b){return 0;}return s.*.decisions%2;}
fn r34v2_choose(s:*R34V2State,explore_enabled:i32,was_explore:*i32)i32 {
    if(s==null as *R34V2State || was_explore==null as *i32 || s.*.pending!=0){return -1;}
    let obj:i32=r34v2_best(s,s.*.active);let ex:i32=0;
    if(explore_enabled==1 && r34v2_mod(r34v2_rng(s),5)==0){obj=1-obj;ex=1;}
    was_explore.*=ex;s.*.decisions=s.*.decisions+1;return obj;
}
fn r34v2_accept(s:*R34V2State,action_id:i32,reward:i32,learn:i32,allow_switch:i32)i32 {
    if(s==null as *R34V2State || s.*.pending!=1 || action_id!=s.*.pending_action || (reward!=1 && reward!=-1)){return cl_bad();}
    let c:i32=s.*.pending_context;let o:i32=s.*.pending_object;let target:i32=c;let old:i32=r34v2_score(s,c,o);
    if(allow_switch==1 && reward<0 && s.*.pending_explore==0 && old>0){
        if(s.*.contexts==1 && c==0){s.*.contexts=3;target=1;s.*.active=1;s.*.switches=s.*.switches+1;}
        else if(s.*.contexts==3){let alt:i32=1-c;let a:i32=r34v2_score(s,alt,0);let b:i32=r34v2_score(s,alt,1);let best:i32=a;if(b>best){best=b;}if(best>0){target=alt;s.*.active=alt;s.*.switches=s.*.switches+1;}}
    }
    if(learn==1){let v:i32=r34v2_score(s,target,o)+reward*100;if(v>30000){v=30000;}if(v< -30000){v=-30000;}r34v2_set_score(s,target,o,v);r34v2_inc_count(s,target,o);s.*.updates=s.*.updates+1;}
    s.*.outcomes=s.*.outcomes+1;s.*.pending=0;s.*.pending_action=0;s.*.pending_context=0;s.*.pending_object=0;s.*.pending_explore=0;return 0;
}
fn r34v2_equal(a:*R34V2State,b:*R34V2State)i32 {
    return (a.*.s00==b.*.s00 && a.*.s01==b.*.s01 && a.*.s10==b.*.s10 && a.*.s11==b.*.s11 &&
        a.*.n00==b.*.n00 && a.*.n01==b.*.n01 && a.*.n10==b.*.n10 && a.*.n11==b.*.n11 &&
        a.*.rng==b.*.rng && a.*.updates==b.*.updates && a.*.active==b.*.active && a.*.contexts==b.*.contexts &&
        a.*.pending==b.*.pending && a.*.pending_action==b.*.pending_action && a.*.pending_context==b.*.pending_context &&
        a.*.pending_object==b.*.pending_object && a.*.pending_explore==b.*.pending_explore && a.*.decisions==b.*.decisions &&
        a.*.switches==b.*.switches && a.*.outcomes==b.*.outcomes) as i32;
}
fn r34v2_fp(s:*R34V2State)i32 {
    return r34v2_mod(s.*.s00*3+s.*.s01*5+s.*.s10*7+s.*.s11*11+s.*.n00*13+s.*.n01*17+s.*.n10*19+s.*.n11*23+
        s.*.rng*29+s.*.updates*31+s.*.active*37+s.*.contexts*41+s.*.pending*43+s.*.pending_action*47+s.*.pending_context*53+
        s.*.pending_object*59+s.*.pending_explore*61+s.*.decisions*67+s.*.switches*71+s.*.outcomes*73,1000003);
}

fn r34v2_put_signed(b:[]u8,at:i32,v:i32)i32 {return cl_put(b,at,(v+R34V2_SCORE_SHIFT) as i64);}
fn r34v2_get_signed(b:[]u8,at:i32)i32 {return (cl_u32(b,at) as i32)-R34V2_SCORE_SHIFT;}
fn r34v2_encode(s:*R34V2State,out:[]u8)i32 {
    if(out.len!=R34V2_STATE_BYTES || s==null as *R34V2State){return cl_bad();}
    if(s.*.rng<0 || s.*.rng>1000003 || s.*.updates<0 || s.*.updates>1000000 || s.*.active<0 || s.*.active>1 || (s.*.contexts!=1 && s.*.contexts!=3) || s.*.pending<0 || s.*.pending>1){return cl_bad();}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    cl_copy(out[0..8],"R34CLV02");cl_put(out,8,2);cl_put(out,12,R34V2_STATE_BYTES);
    r34v2_put_signed(out,16,s.*.s00);r34v2_put_signed(out,20,s.*.s01);r34v2_put_signed(out,24,s.*.s10);r34v2_put_signed(out,28,s.*.s11);
    cl_put(out,32,s.*.n00);cl_put(out,36,s.*.n01);cl_put(out,40,s.*.n10);cl_put(out,44,s.*.n11);cl_put(out,48,s.*.rng);cl_put(out,52,s.*.updates);
    cl_put(out,56,s.*.active);cl_put(out,60,s.*.contexts);cl_put(out,64,s.*.pending);cl_put(out,68,s.*.pending_action);cl_put(out,72,s.*.pending_context);
    cl_put(out,76,s.*.pending_object);cl_put(out,80,s.*.pending_explore);cl_put(out,84,s.*.decisions);cl_put(out,88,s.*.switches);cl_put(out,92,s.*.outcomes);
    if(ns_sha256(out[0..128],out[128..160])!=0){return cl_io();}return 0;
}
fn r34v2_decode(input:[]u8,s:*R34V2State)i32 {
    if(input.len!=R34V2_STATE_BYTES || s==null as *R34V2State || nio_equal(input[0..8],"R34CLV02")!=1 || cl_u32(input,8)!=2 || cl_u32(input,12)!=R34V2_STATE_BYTES || cl_zero(input[96..128])!=1 || cl_hash_is(input[0..128],input[128..160])!=1){return cl_corrupt();}
    let t:R34V2State=R34V2State{.s00=r34v2_get_signed(input,16),.s01=r34v2_get_signed(input,20),.s10=r34v2_get_signed(input,24),.s11=r34v2_get_signed(input,28),
        .n00=cl_u32(input,32) as i32,.n01=cl_u32(input,36) as i32,.n10=cl_u32(input,40) as i32,.n11=cl_u32(input,44) as i32,
        .rng=cl_u32(input,48) as i32,.updates=cl_u32(input,52) as i32,.active=cl_u32(input,56) as i32,.contexts=cl_u32(input,60) as i32,
        .pending=cl_u32(input,64) as i32,.pending_action=cl_u32(input,68) as i32,.pending_context=cl_u32(input,72) as i32,.pending_object=cl_u32(input,76) as i32,
        .pending_explore=cl_u32(input,80) as i32,.decisions=cl_u32(input,84) as i32,.switches=cl_u32(input,88) as i32,.outcomes=cl_u32(input,92) as i32};
    if(t.s00< -30000||t.s00>30000||t.s01< -30000||t.s01>30000||t.s10< -30000||t.s10>30000||t.s11< -30000||t.s11>30000||
       t.n00<0||t.n01<0||t.n10<0||t.n11<0||t.rng<0||t.rng>1000003||t.updates<0||t.updates>1000000||t.active<0||t.active>1||
       (t.contexts!=1&&t.contexts!=3)||t.pending<0||t.pending>1||t.pending_context<0||t.pending_context>1||t.pending_object<0||t.pending_object>1||
       t.pending_explore<0||t.pending_explore>1||t.decisions<0||t.switches<0||t.outcomes<0){return cl_corrupt();}
    if(t.pending==0 && t.pending_action!=0){return cl_corrupt();}if(t.pending==1 && t.pending_action<1){return cl_corrupt();}s.*=t;return 0;
}

fn r34v2_stream_init(s:*CLStream)void {s.*.source=1;s.*.clock=1;s.*.sequence=0;s.*.tick=0;}
fn r34v2_observe(w:[]u8,obs:[]u8,stream:*CLStream)i32 {let rc:i32=cw_observe(w,obs);if(rc!=0){return rc;}return cl_stream_accept(stream,obs);}
fn r34v2_actor(obs:[]u8)i32 {
    if(cl_observation_check(obs)!=0 || cl_u32(obs,24)!=2 || cl_u32(obs,32)!=8 || cl_u32(obs,36)!=8 || cl_u32(obs,40)!=3){return -1;}
    let x:i32=0;while(x<8){let at:i32=80+(6*8+x)*3;if(obs[at]==32 && obs[at+1]==220 && obs[at+2]==32){return x;}x=x+1;}return -1;
}
fn r34v2_feature(obs:[]u8,x:i32)i32 {
    if(cl_observation_check(obs)!=0 || x<0 || x>7){return -1;}let at:i32=80+(3*8+x)*3;
    if(obs[at]!=160 || obs[at+1]!=160){return -1;}if(obs[at+2]<100){return 0;}return 1;
}
fn r34v2_step_observe(w:[]u8,obs:[]u8,stream:*CLStream,action:i32)CWOutcome {
    let o:CWOutcome=cw_step(w,action);if(o.status!=0){return o;}let rc:i32=r34v2_observe(w,obs,stream);if(rc!=0){return CWOutcome{.status=rc,.action=0,.tick=0,.value=0};}return o;
}
fn r34v2_begin_episode(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream,explore_enabled:i32)i32 {
    if(s.*.pending!=0){return cl_bad();}let ex:i32=0;let desired:i32=r34v2_choose(s,explore_enabled,&ex);if(desired<0){return cl_bad();}
    let target:i32=2;if(desired==1){target=6;}let guard:i32=0;let actor:i32=r34v2_actor(obs);
    while(actor!=target && guard<8){let action:i32=1;if(actor<target){action=2;}let mv:CWOutcome=r34v2_step_observe(w,obs,stream,action);if(mv.status!=0 || mv.action!=0){return cl_bad();}actor=r34v2_actor(obs);guard=guard+1;}
    if(actor!=target){return cl_bad();}let look:CWOutcome=r34v2_step_observe(w,obs,stream,3);if(look.status!=0 || look.action!=0){return cl_bad();}
    let object:i32=r34v2_feature(obs,target);if(object<0 || object>1 || object!=desired){return cl_bad();}
    let touch:CWOutcome=r34v2_step_observe(w,obs,stream,4);if(touch.status!=0 || touch.action!=0 || touch.tick<1){return cl_bad();}
    s.*.pending=1;s.*.pending_action=touch.tick;s.*.pending_context=s.*.active;s.*.pending_object=object;s.*.pending_explore=ex;return 0;
}
fn r34v2_finish_pending(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream,learn:i32,allow_switch:i32,scramble:i32,actual:*i32)i32 {
    if(s.*.pending!=1 || actual==null as *i32){return cl_bad();}let guard:i32=0;
    while(guard<4){let o:CWOutcome=r34v2_step_observe(w,obs,stream,0);if(o.status!=0){return o.status;}if(o.action!=0){if(o.action!=s.*.pending_action){return cl_bad();}actual.*=o.value;let seen:i32=o.value;if(scramble==1){seen=0-seen;}return r34v2_accept(s,o.action,seen,learn,allow_switch);}guard=guard+1;}
    return cl_bad();
}
fn r34v2_episode(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream,learn:i32,allow_switch:i32,scramble:i32,explore:i32,actual:*i32)i32 {
    let rc:i32=r34v2_begin_episode(w,obs,s,stream,explore);if(rc!=0){return rc;}return r34v2_finish_pending(w,obs,s,stream,learn,allow_switch,scramble,actual);
}
fn r34v2_phase(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream,regime:i32,n:i32,learn:i32,allow_switch:i32,scramble:i32,explore:i32,positive:*i32)i32 {
    if(positive==null as *i32 || cw_change(w,regime,0)!=0){return cl_bad();}let yes:i32=0;let i:i32=0;
    while(i<n){let actual:i32=0;let rc:i32=r34v2_episode(w,obs,s,stream,learn,allow_switch,scramble,explore,&actual);if(rc!=0){return rc;}if(actual>0){yes=yes+1;}i=i+1;}positive.*=yes;return 0;
}
fn r34v2_runtime_init(w:[]u8,obs:[]u8,stream:*CLStream,seed:i32)i32 {
    let rc:i32=cw_init(w,seed);if(rc!=0){return rc;}
    r34v2_stream_init(stream);rc=cw_observe(w,obs);if(rc!=0){return rc;}
    return cl_stream_accept(stream,obs);
}

fn r34v2_parent(out:[]u8)i32 {if(out.len!=32){return cl_bad();}return ns_sha256("R34V2_QUARANTINED_PARENT_V1",out);}
fn r34v2_checkpoint_build(w:[]u8,out:[]u8,s:*R34V2State,stream:*CLStream)i32 {
    if(out.len!=R34V2_CHECKPOINT_BYTES || w.len!=R34V2_WORLD_BYTES){return cl_bad();}let learner:[]u8=nio_alloc(R34V2_STATE_BYTES);let ingress:[]u8=nio_alloc(16);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(learner.len!=R34V2_STATE_BYTES||ingress.len!=16||parent.len!=32||previous.len!=32){nio_free(learner);nio_free(ingress);nio_free(parent);nio_free(previous);return cl_io();}
    let i:i32=0;while(i<previous.len){previous[i]=0;i=i+1;}let rc:i32=r34v2_encode(s,learner);if(rc==0){rc=cl_stream_save(stream,ingress);}if(rc==0){rc=r34v2_parent(parent);}if(rc==0){rc=cl_checkpoint_begin(out,1,parent,previous);}
    let at:i32=112;if(rc==0){rc=cl_checkpoint_section(out,&at,1,learner);}let id:i32=2;let tag:[]u8=nio_alloc(4);
    if(tag.len!=4){rc=cl_io();}while(rc==0 && id<=10){cl_put(tag,0,id);rc=cl_checkpoint_section(out,&at,id,tag);id=id+1;}
    if(rc==0){rc=cl_checkpoint_section(out,&at,11,w);}if(rc==0){rc=cl_checkpoint_section(out,&at,12,ingress);}if(rc==0){rc=cl_checkpoint_finish(out,at);}
    nio_free(tag);nio_free(learner);nio_free(ingress);nio_free(parent);nio_free(previous);return rc;
}
fn r34v2_checkpoint_decode(b:[]u8,w:[]u8,s:*R34V2State,stream:*CLStream)i32 {
    if(w.len!=R34V2_WORLD_BYTES){return cl_bad();}let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);if(parent.len!=32||previous.len!=32){nio_free(parent);nio_free(previous);return cl_io();}
    let i:i32=0;while(i<32){previous[i]=0;i=i+1;}let rc:i32=r34v2_parent(parent);if(rc==0){rc=cl_checkpoint_check(b,parent,previous,1);}if(rc!=0){nio_free(parent);nio_free(previous);return rc;}
    let learner:[]u8=cl_checkpoint_get(b,1);let world:[]u8=cl_checkpoint_get(b,11);let ingress:[]u8=cl_checkpoint_get(b,12);let ts:R34V2State=r34v2_init(1);let tw:[]u8=nio_alloc(R34V2_WORLD_BYTES);let ti:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};
    if(tw.len!=R34V2_WORLD_BYTES){nio_free(parent);nio_free(previous);return cl_io();}rc=r34v2_decode(learner,&ts);if(rc==0 && world.len==R34V2_WORLD_BYTES){cl_copy(tw,world);rc=cw_valid(tw);}else if(rc==0){rc=cl_corrupt();}if(rc==0){rc=cl_stream_load(ingress,&ti);}
    if(rc==0){s.*=ts;cl_copy(w,tw);stream.*=ti;}nio_free(tw);nio_free(parent);nio_free(previous);return rc;
}
fn r34v2_checkpoint_commit_root(w:[]u8,root:i64,s:*R34V2State,stream:*CLStream)i32 {
    let b:[]u8=nio_alloc(R34V2_CHECKPOINT_BYTES);if(b.len!=R34V2_CHECKPOINT_BYTES){return cl_io();}let n:i32=r34v2_checkpoint_build(w,b,s,stream);let rc:i32=n;
    if(n>0 && cl_is_status(n)==0){let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);let i:i32=0;while(i<32){previous[i]=0;i=i+1;}r34v2_parent(parent);rc=cl_checkpoint_commit(root,b[0..n],parent,previous,1);nio_free(parent);nio_free(previous);}nio_free(b);return rc;
}
fn r34v2_checkpoint_load_root(w:[]u8,root:i64,s:*R34V2State,stream:*CLStream)i32 {
    let b:[]u8=nio_alloc(R34V2_CHECKPOINT_BYTES);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);if(b.len!=R34V2_CHECKPOINT_BYTES||parent.len!=32||previous.len!=32){return cl_io();}
    let i:i32=0;while(i<32){previous[i]=0;i=i+1;}r34v2_parent(parent);let n:i32=cl_checkpoint_load(root,1,parent,previous,b);let rc:i32=n;if(n>0 && cl_is_status(n)==0){rc=r34v2_checkpoint_decode(b[0..n],w,s,stream);}nio_free(b);nio_free(parent);nio_free(previous);return rc;
}

fn r34v2_emit_state(label:[]u8,s:*R34V2State)void {
    _zag_print("R34V2_STATE,");_zag_print(label);_zag_print(",fp=");cl_number(r34v2_fp(s));_zag_print(",active=");cl_number(s.*.active);_zag_print(",contexts=");cl_number(s.*.contexts);
    _zag_print(",updates=");cl_number(s.*.updates);_zag_print(",switches=");cl_number(s.*.switches);_zag_print(",pending=");cl_number(s.*.pending);_zag_println("");
}
fn r34v2_train_to_mid(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream)i32 {
    let p:i32=0;let rc:i32=r34v2_phase(w,obs,s,stream,0,24,1,1,0,1,&p);if(rc!=0){return rc;}rc=r34v2_phase(w,obs,s,stream,1,24,1,1,0,1,&p);if(rc!=0){return rc;}if(cw_change(w,1,0)!=0){return cl_bad();}return r34v2_begin_episode(w,obs,s,stream,0);
}
fn r34v2_continue_after_mid(w:[]u8,obs:[]u8,s:*R34V2State,stream:*CLStream)i32 {
    let actual:i32=0;let rc:i32=r34v2_finish_pending(w,obs,s,stream,1,1,0,&actual);if(rc!=0){return rc;}let p:i32=0;rc=r34v2_phase(w,obs,s,stream,1,8,1,1,0,1,&p);if(rc!=0){return rc;}r34v2_emit_state("continued",s);_zag_print("R34V2_CONTINUE_POSITIVE,");cl_number(p as i64);_zag_println("");return 0;
}

fn r34v2_campaign()i32 {
    let f:i32=0;let usage0:CLUsage=cl_usage();f=f+cl_check("usage_start",usage0.status,0);
    let bw:[]u8=nio_alloc(R34V2_WORLD_BYTES);let bo:[]u8=nio_alloc(304);let bs:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let base:R34V2State=r34v2_init(7331);f=f+cl_check("baseline_runtime",r34v2_runtime_init(bw,bo,&bs,17),0);let bp:i32=0;f=f+cl_check("baseline_phase",r34v2_phase(bw,bo,&base,&bs,0,16,0,0,0,0,&bp),0);f=f+cl_check("baseline_A_positive",bp,8);nio_free(bw);nio_free(bo);

    let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let obs:[]u8=nio_alloc(304);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(7331);f=f+cl_check("runtime_init",r34v2_runtime_init(w,obs,&stream,17),0);
    let pa:i32=0;f=f+cl_check("train_A",r34v2_phase(w,obs,&s,&stream,0,24,1,1,0,1,&pa),0);let ea:i32=0;f=f+cl_check("eval_A",r34v2_phase(w,obs,&s,&stream,0,16,0,0,0,0,&ea),0);f=f+cl_check("acquire_A_positive",ea,16);
    let pb:i32=0;f=f+cl_check("train_B",r34v2_phase(w,obs,&s,&stream,1,24,1,1,0,1,&pb),0);let eb:i32=0;f=f+cl_check("eval_B",r34v2_phase(w,obs,&s,&stream,1,16,0,0,0,0,&eb),0);f=f+cl_check("acquire_B_positive",eb,16);f=f+cl_check("two_contexts",s.contexts,3);
    let before_return:i32=s.updates;let ra:i32=0;f=f+cl_check("return_A",r34v2_phase(w,obs,&s,&stream,0,16,0,1,0,0,&ra),0);f=f+cl_check("return_A_retained",ra,15);f=f+cl_check("return_A_no_weight_updates",s.updates,before_return);f=f+cl_check("return_A_context",s.active,0);
    f=f+cl_check("train_updates",before_return,48);

    let cw:[]u8=nio_alloc(R34V2_WORLD_BYTES);let co:[]u8=nio_alloc(304);let cs:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let control:R34V2State=r34v2_init(7331);f=f+cl_check("control_init",r34v2_runtime_init(cw,co,&cs,17),0);let cp:i32=0;f=f+cl_check("disabled_control",r34v2_phase(cw,co,&control,&cs,1,24,0,0,0,0,&cp),0);f=f+cl_check("disabled_updates",control.updates,0);f=f+cl_check("disabled_B_positive",cp,12);nio_free(cw);nio_free(co);

    let sw:[]u8=nio_alloc(R34V2_WORLD_BYTES);let so:[]u8=nio_alloc(304);let ss:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let scrambled:R34V2State=r34v2_init(7331);f=f+cl_check("scramble_init",r34v2_runtime_init(sw,so,&ss,17),0);let sp:i32=0;f=f+cl_check("scramble_train",r34v2_phase(sw,so,&scrambled,&ss,0,24,1,0,1,1,&sp),0);let se:i32=0;f=f+cl_check("scramble_eval",r34v2_phase(sw,so,&scrambled,&ss,0,16,0,0,0,0,&se),0);f=f+cl_check("scramble_defeats_A",se,0);nio_free(sw);nio_free(so);

    let w1:[]u8=nio_alloc(R34V2_WORLD_BYTES);let o1:[]u8=nio_alloc(304);let st1:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let d1:R34V2State=r34v2_init(991);
    let w2:[]u8=nio_alloc(R34V2_WORLD_BYTES);let o2:[]u8=nio_alloc(304);let st2:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let d2:R34V2State=r34v2_init(991);r34v2_runtime_init(w1,o1,&st1,91);r34v2_runtime_init(w2,o2,&st2,91);let dp:i32=0;r34v2_phase(w1,o1,&d1,&st1,0,24,1,1,0,1,&dp);r34v2_phase(w1,o1,&d1,&st1,1,24,1,1,0,1,&dp);r34v2_phase(w2,o2,&d2,&st2,0,24,1,1,0,1,&dp);r34v2_phase(w2,o2,&d2,&st2,1,24,1,1,0,1,&dp);f=f+cl_check("deterministic_learner",r34v2_equal(&d1,&d2),1);f=f+cl_check("deterministic_world",nio_equal(w1,w2),1);f=f+cl_check("deterministic_stream_seq",st1.sequence,st2.sequence);f=f+cl_check64("deterministic_stream_tick",st1.tick,st2.tick);nio_free(w1);nio_free(o1);nio_free(w2);nio_free(o2);

    let enc:[]u8=nio_alloc(R34V2_STATE_BYTES);let round:R34V2State=r34v2_init(1);f=f+cl_check("encode",r34v2_encode(&s,enc),0);f=f+cl_check("decode",r34v2_decode(enc,&round),0);f=f+cl_check("roundtrip",r34v2_equal(&s,&round),1);enc[20]=(enc[20]+1) as u8;f=f+cl_check("inner_state_corrupt_refused",r34v2_decode(enc,&round),cl_corrupt());nio_free(enc);
    let usage1:CLUsage=cl_usage();f=f+cl_check("usage_end",usage1.status,0);_zag_print("R34V2_RESOURCE,cpu_us=");cl_number(usage1.cpu_us-usage0.cpu_us);_zag_print(",rss_bytes=");cl_number(usage1.rss_bytes);_zag_println("");
    r34v2_emit_state("campaign",&s);_zag_print("R34V2_FAILURES,");cl_number(f);_zag_println("");nio_free(w);nio_free(obs);return (f!=0) as i32;
}

fn r34v2_write_mid(rootp:[]u8)i32 {
    let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let obs:[]u8=nio_alloc(304);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(4441);if(r34v2_runtime_init(w,obs,&stream,33)!=0||r34v2_train_to_mid(w,obs,&s,&stream)!=0){return 1;}let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){return 2;}let rc:i32=r34v2_checkpoint_commit_root(w,root,&s,&stream);nio_close(root);r34v2_emit_state("mid_written",&s);nio_free(w);nio_free(obs);return (rc!=0) as i32;
}
fn r34v2_reload_mid(rootp:[]u8)i32 {
    let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let obs:[]u8=nio_alloc(304);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(1);let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){return 2;}let rc:i32=r34v2_checkpoint_load_root(w,root,&s,&stream);nio_close(root);if(rc!=0){return 3;}if(cw_observe(w,obs)!=0){return 4;}return r34v2_continue_after_mid(w,obs,&s,&stream);
}
fn r34v2_reference_mid()i32 {
    let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let obs:[]u8=nio_alloc(304);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(4441);if(r34v2_runtime_init(w,obs,&stream,33)!=0||r34v2_train_to_mid(w,obs,&s,&stream)!=0){return 1;}return r34v2_continue_after_mid(w,obs,&s,&stream);
}
fn r34v2_write_bad(rootp:[]u8,kind:i32)i32 {
    let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let obs:[]u8=nio_alloc(304);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(4441);if(r34v2_runtime_init(w,obs,&stream,33)!=0||r34v2_train_to_mid(w,obs,&s,&stream)!=0){return 1;}let b:[]u8=nio_alloc(R34V2_CHECKPOINT_BYTES);let n:i32=r34v2_checkpoint_build(w,b,&s,&stream);if(n<1||cl_is_status(n)==1){return 2;}let leaf:[]u8="inner-corrupt.bin";let view:[]u8=b[0..n];if(kind==1){b[128]=(b[128]+1) as u8;ns_sha256(b[0..n-32],b[n-32..n]);}if(kind==2){leaf="torn.bin";view=b[0..n-17];}let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){return 3;}let rc:i32=cl_file_write(root,leaf,view);nio_close(root);nio_free(w);nio_free(obs);nio_free(b);return (rc!=0) as i32;
}
fn r34v2_refuse_bad(rootp:[]u8,kind:i32)i32 {
    let leaf:[]u8="inner-corrupt.bin";if(kind==2){leaf="torn.bin";}let root:i64=cl_root(rootp);if(root<0||cl_is_status(root)==1){return 2;}let b:[]u8=nio_alloc(R34V2_CHECKPOINT_BYTES);let n:i32=cl_file_read(root,leaf,b);nio_close(root);if(n<0||cl_is_status(n)==1){return 3;}let w:[]u8=nio_alloc(R34V2_WORLD_BYTES);let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let s:R34V2State=r34v2_init(1);let rc:i32=r34v2_checkpoint_decode(b[0..n],w,&s,&stream);_zag_print("R34V2_REFUSAL,");cl_number(rc as i64);_zag_println("");nio_free(b);nio_free(w);if(kind==1){return (rc!=cl_corrupt()) as i32;}return (rc==0) as i32;
}

fn main()i32 {
    if(_zag_argc()==1){return r34v2_campaign();}if(_zag_argc()==2 && nio_equal(_zag_arg(1),"reference-mid")==1){return r34v2_reference_mid();}if(_zag_argc()!=3){return 64;}
    let mode:[]u8=_zag_arg(1);let root:[]u8=_zag_arg(2);if(nio_equal(mode,"write-mid")==1){return r34v2_write_mid(root);}if(nio_equal(mode,"reload-mid")==1){return r34v2_reload_mid(root);}
    if(nio_equal(mode,"write-inner-corrupt")==1){return r34v2_write_bad(root,1);}if(nio_equal(mode,"refuse-inner-corrupt")==1){return r34v2_refuse_bad(root,1);}
    if(nio_equal(mode,"write-torn")==1){return r34v2_write_bad(root,2);}if(nio_equal(mode,"refuse-torn")==1){return r34v2_refuse_bad(root,2);}return 64;
}

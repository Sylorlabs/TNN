// R34 continual-learning foundation: provenance reliability substrate V1.
//
// Opaque provenance IDs only. No source names, source classes, hierarchy,
// evaluator reliability, drift flag, or fixed source ranking is encoded here.
// Multiple reliability hypotheses can coexist per source and are updated only
// from delayed caller-supplied grounded audits. A source estimated below chance
// can become inhibitory rather than being silently trusted.

const R34P1_OK:i32=0;
const R34P1_SHAPE:i32=-340301;
const R34P1_NUMERIC:i32=-340302;
const R34P1_RANGE:i32=-340303;

fn r34p1_finite(x:f64)i32 @noalloc {
    return (x==x && x<1.0e300 && x>(-1.0e300)) as i32;
}

fn r34p1_init(prob:[]f32,loss:[]f32,meta:[]f32,sources:i32,experts:i32)i32 @noalloc {
    if(sources<1 || experts<1 || prob.len!=sources*experts || loss.len!=prob.len || meta.len!=prob.len){return R34P1_SHAPE;}
    let i:i32=0;while(i<prob.len){prob[i]=0.5;loss[i]=0.25;meta[i]=(1.0/(experts as f64)) as f32;i=i+1;}return R34P1_OK;
}

fn r34p1_prob(prob:[]f32,meta:[]f32,source:i32,experts:i32,out:*f64)i32 @noalloc {
    if(out==null as *f64 || experts<1 || source<0 || prob.len<experts || prob.len!=meta.len || (source+1)*experts>prob.len){return R34P1_SHAPE;}
    let num:f64=0.0;let den:f64=0.0;let j:i32=0;
    while(j<experts){
        let i:i32=source*experts+j;let p:f64=prob[i] as f64;let w:f64=meta[i] as f64;
        if(r34p1_finite(p)!=1 || r34p1_finite(w)!=1 || p<0.0 || p>1.0 || w<0.0){return R34P1_NUMERIC;}
        num=num+w*p;den=den+w;j=j+1;
    }
    if(!(den>0.0)){return R34P1_RANGE;}out.*=num/den;return R34P1_OK;
}

fn r34p1_signed_weight(prob:[]f32,meta:[]f32,source:i32,experts:i32,out:*f64)i32 @noalloc {
    let p:f64=0.0;let rc:i32=r34p1_prob(prob,meta,source,experts,&p);if(rc!=R34P1_OK){return rc;}
    out.*=2.0*p-1.0;return R34P1_OK;
}

// One delayed grounded audit. `correct` is whether the provenance claim agreed
// with the later grounded consequence. Alpha values and learning rates are
// generic caller-owned learning state/hyperparameters, never source-specific.
fn r34p1_audit(prob:[]f32,loss:[]f32,meta:[]f32,source:i32,experts:i32,
    alphas:[]f32,correct:i32,loss_rate:f64,meta_rate:f64)i32 @noalloc {
    if(experts<1 || source<0 || prob.len!=loss.len || prob.len!=meta.len || alphas.len!=experts ||
       (source+1)*experts>prob.len || (correct!=0 && correct!=1) || !(loss_rate>=0.0) || !(loss_rate<=1.0) ||
       !(meta_rate>=0.0) || !(meta_rate<=1.0)){return R34P1_SHAPE;}
    let y:f64=correct as f64;let sumw:f64=0.0;let j:i32=0;
    while(j<experts){
        let i:i32=source*experts+j;let p:f64=prob[i] as f64;let a:f64=alphas[j] as f64;let old_loss:f64=loss[i] as f64;let old_meta:f64=meta[i] as f64;
        if(r34p1_finite(p)!=1 || r34p1_finite(a)!=1 || r34p1_finite(old_loss)!=1 || r34p1_finite(old_meta)!=1 || p<0.0 || p>1.0 || a<0.0 || a>1.0 || old_meta<0.0){return R34P1_NUMERIC;}
        let d:f64=p-y;let e:f64=d*d;
        let next_loss:f64=(1.0-loss_rate)*old_loss+loss_rate*e;
        let next_p:f64=(1.0-a)*p+a*y;
        let retain:f64=1.0-meta_rate*e;let next_meta:f64=old_meta*retain;
        if(r34p1_finite(next_loss)!=1 || r34p1_finite(next_p)!=1 || r34p1_finite(next_meta)!=1){return R34P1_NUMERIC;}
        loss[i]=next_loss as f32;prob[i]=next_p as f32;meta[i]=next_meta as f32;sumw=sumw+next_meta;j=j+1;
    }
    // Renormalize only within this opaque source. Prevent exact zero-lockout.
    if(!(sumw>1.0e-20)){
        j=0;while(j<experts){meta[source*experts+j]=(1.0/(experts as f64)) as f32;j=j+1;}return R34P1_OK;
    }
    j=0;while(j<experts){let i:i32=source*experts+j;meta[i]=((meta[i] as f64)/sumw) as f32;j=j+1;}
    return R34P1_OK;
}

fn r34p1_apply_credit(claim:f64,reliability_weight:f64,out:*f64)i32 @noalloc {
    if(out==null as *f64 || r34p1_finite(claim)!=1 || r34p1_finite(reliability_weight)!=1 || claim<(-1.0) || claim>1.0 || reliability_weight<(-1.0) || reliability_weight>1.0){return R34P1_SHAPE;}
    out.*=claim*reliability_weight;return R34P1_OK;
}

fn r34p1_state_equal(a_prob:[]f32,a_loss:[]f32,a_meta:[]f32,b_prob:[]f32,b_loss:[]f32,b_meta:[]f32)i32 @noalloc {
    if(a_prob.len!=b_prob.len || a_prob.len!=a_loss.len || a_prob.len!=a_meta.len || b_prob.len!=b_loss.len || b_prob.len!=b_meta.len){return 0;}
    let i:i32=0;while(i<a_prob.len){if(a_prob[i]!=b_prob[i] || a_loss[i]!=b_loss[i] || a_meta[i]!=b_meta[i]){return 0;}i=i+1;}return 1;
}

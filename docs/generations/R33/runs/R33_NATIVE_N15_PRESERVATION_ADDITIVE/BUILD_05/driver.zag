// R33-N15 preservation/additive learning microlearner diagnostic.
// Native Zag only. This does not load, execute, mutate, or emulate the canonical R27 parent.
// Probe outcomes never participate in training or update acceptance.

const N15_F:i32=16;
const N15_OLD_TRAIN:i32=256;
const N15_NEW_TRAIN:i32=256;
const N15_PROBE:i32=512;
const N15_ANCHORS:i32=96;
const N15_PARENT_EPOCHS:i32=12;
const N15_NEW_EPOCHS:i32=6;
const N15_ARMS:i32=12;
const N15_DEV_POPS:i32=8;
const N15_HOLDOUT_POPS:i32=12;

struct N15TrainStats { proposals:i32,accepted:i32,rejected:i32,skipped:i32,anchor_loss:i32 }
struct N15Eval { parent_correct:i32,final_correct:i32,lost:i32,rescued:i32 }
struct N15Outcome { old_parent:i32,old_final:i32,old_lost:i32,new_gain:i32 }

fn n15_mod(v:i32,m:i32)i32 { let q:i32=v/m; let r:i32=v-q*m; if(r<0){return r+m;} return r; }
fn n15_abs(v:i32)i32 { if(v<0){return 0-v;} return v; }
fn n15_clamp(v:i32,lo:i32,hi:i32)i32 { if(v<lo){return lo;} if(v>hi){return hi;} return v; }
fn n15_hash(seed:i32,a:i32,b:i32)i32 {
    let x:i32=n15_mod(seed*997+a*7919+b*104729+17,1000003);
    return n15_mod(x*613+1013,1000003);
}
fn n15_zero(a:[]i32)void { let i:i32=0; while(i<a.len){a[i]=0;i=i+1;} }
fn n15_copy(a:[]i32,b:[]i32)void { let i:i32=0; while(i<a.len && i<b.len){b[i]=a[i];i=i+1;} }
fn n15_fill(seed:i32,index:i32,kind:i32,x:[]i32)void {
    let j:i32=0;
    while(j<N15_F){
        let v:i32=n15_mod(n15_hash(seed,index,j),2001)-1000;
        if(kind==1 && j>=8 && j<12){v=n15_clamp(v+550,-1000,1000);}
        x[j]=v;j=j+1;
    }
}
fn n15_old_target(x:[]i32)i32 {
    let s:i32=5*x[0]-4*x[1]+3*x[2]+2*x[3]-3*x[4]+4*x[5]-2*x[6]+x[7]+180;
    if(s>=0){return 1;} return -1;
}
fn n15_new_target(x:[]i32)i32 {
    let region:i32=x[8]+x[9]+x[10]+x[11];
    if(region<=700){return n15_old_target(x);}
    let s:i32=-3*x[0]+2*x[1]+4*x[4]-5*x[5]+3*x[8]-2*x[9]+4*x[10]-3*x[11]-120;
    if(s>=0){return 1;} return -1;
}
fn n15_target(kind:i32,x:[]i32)i32 { if(kind==1){return n15_new_target(x);} return n15_old_target(x); }
fn n15_score(w:[]i32,bias:i32,x:[]i32)i64 {
    let s:i64=bias as i64; let j:i32=0;
    while(j<N15_F){s=s+(w[j] as i64)*(x[j] as i64);j=j+1;} return s;
}
fn n15_choice_score(s:i64)i32 {if(s>=0){return 1;}return -1;}
fn n15_choice(w:[]i32,bias:i32,x:[]i32)i32 {return n15_choice_score(n15_score(w,bias,x));}
fn n15_update(w:[]i32,bias:*i32,x:[]i32,y:i32,divisor:i32)void {
    let j:i32=0; while(j<N15_F){w[j]=w[j]+y*x[j]/divisor;j=j+1;} bias.*=bias.*+y*16;
}
fn n15_train_parent(seed:i32,w:[]i32,bias:*i32)i32 {
    n15_zero(w);bias.*=0;let x:[]i32=zalloc_i(N15_F);let updates:i32=0;let epoch:i32=0;
    while(epoch<N15_PARENT_EPOCHS){let i:i32=0;while(i<N15_OLD_TRAIN){n15_fill(seed,i,0,x);let y:i32=n15_old_target(x);
        if(n15_choice(w,bias.*,x)!=y){n15_update(w,bias,x,y,32);updates=updates+1;}i=i+1;}epoch=epoch+1;}
    zfree(x);return updates;
}
fn n15_protos(old_seed:i32,new_seed:i32,p:[]i32)void {
    n15_zero(p);let x:[]i32=zalloc_i(N15_F);let i:i32=0;
    while(i<N15_OLD_TRAIN){n15_fill(old_seed,i,0,x);let j:i32=8;while(j<12){p[j-8]=p[j-8]+x[j];j=j+1;}i=i+1;}
    i=0;while(i<N15_NEW_TRAIN){n15_fill(new_seed,i,1,x);let j:i32=8;while(j<12){p[4+j-8]=p[4+j-8]+x[j];j=j+1;}i=i+1;}
    let j:i32=0;while(j<4){p[j]=p[j]/N15_OLD_TRAIN;p[4+j]=p[4+j]/N15_NEW_TRAIN;j=j+1;}zfree(x);
}
fn n15_gate(x:[]i32,p:[]i32,radius:i32)i32 {
    let old_d:i32=0;let new_d:i32=0;let j:i32=0;while(j<4){old_d=old_d+n15_abs(x[8+j]-p[j]);new_d=new_d+n15_abs(x[8+j]-p[4+j]);j=j+1;}
    let margin:i32=0;if(radius<=1700){margin=200;}else if(radius<=2400){margin=100;}
    if(new_d<=radius && new_d+margin<old_d){return 1;}return 0;
}
fn n15_radius(arm:i32)i32 {if(arm==7){return 1600;}if(arm==9){return 3000;}return 2200;}
fn n15_tolerance(arm:i32)i32 {if(arm==5 || arm==11){return 2;}if(arm==6){return 4;}return 0;}
fn n15_is_additive(arm:i32)i32 {if(arm>=7){return 1;}return 0;}
fn n15_is_preserve(arm:i32)i32 {if(arm>=4 && arm<=6){return 1;}if(arm==10 || arm==11){return 1;}return 0;}
fn n15_predict(parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,p:[]i32,arm:i32,x:[]i32)i32 {
    if(n15_is_additive(arm)==1){let s:i64=n15_score(parent_w,parent_b,x);if(n15_gate(x,p,n15_radius(arm))==1){s=s+n15_score(spec_w,spec_b,x);}return n15_choice_score(s);}
    return n15_choice(work_w,work_b,x);
}
fn n15_anchor_loss(seed:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,p:[]i32,arm:i32)i32 {
    let loss:i32=0;let x:[]i32=zalloc_i(N15_F);let i:i32=0;
    while(i<N15_ANCHORS){n15_fill(seed,i,0,x);let y:i32=n15_old_target(x);let pc:i32=n15_choice(parent_w,parent_b,x);
        if(pc==y && n15_predict(parent_w,parent_b,work_w,work_b,spec_w,spec_b,p,arm,x)!=y){loss=loss+1;}i=i+1;}
    zfree(x);return loss;
}
fn n15_train_new(seed:i32,arm:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:*i32,spec_w:[]i32,spec_b:*i32,p:[]i32)N15TrainStats {
    let st:N15TrainStats=N15TrainStats{.proposals=0,.accepted=0,.rejected=0,.skipped=0,.anchor_loss=0};
    let x:[]i32=zalloc_i(N15_F);let cw:[]i32=zalloc_i(N15_F);let cs:[]i32=zalloc_i(N15_F);let epoch:i32=0;
    while(epoch<N15_NEW_EPOCHS){let i:i32=0;while(i<N15_NEW_TRAIN){
        let use:i32=1;if(arm==0){use=0;}if(arm==2 && n15_mod(epoch*N15_NEW_TRAIN+i,2)!=0){use=0;}
        if(arm==3 && n15_mod(n15_hash(seed,epoch,i),2)!=0){use=0;}
        n15_fill(seed,i,1,x);let y:i32=n15_new_target(x);
        if(use==0){st.skipped=st.skipped+1;i=i+1;continue;}
        let current:i32=n15_predict(parent_w,parent_b,work_w,work_b.*,spec_w,spec_b.*,p,arm,x);
        if(current==y){st.skipped=st.skipped+1;i=i+1;continue;}
        st.proposals=st.proposals+1;n15_copy(work_w,cw);n15_copy(spec_w,cs);let cb:i32=work_b.*;let sb:i32=spec_b.*;
        if(n15_is_additive(arm)==1){if(n15_gate(x,p,n15_radius(arm))==0){st.rejected=st.rejected+1;i=i+1;continue;}n15_update(cs,&sb,x,y,40);}
        else{n15_update(cw,&cb,x,y,40);}
        let before_margin:i64=(y as i64)*n15_score(work_w,work_b.*,x);if(n15_is_additive(arm)==1){before_margin=(y as i64)*(n15_score(parent_w,parent_b,x)+n15_score(spec_w,spec_b.*,x));}
        let after_margin:i64=(y as i64)*n15_score(cw,cb,x);if(n15_is_additive(arm)==1){after_margin=(y as i64)*(n15_score(parent_w,parent_b,x)+n15_score(cs,sb,x));}
        let accept:i32=1;if(after_margin<=before_margin){accept=0;}
        if(accept==1 && n15_is_preserve(arm)==1){let al:i32=n15_anchor_loss(seed,parent_w,parent_b,cw,cb,cs,sb,p,arm);if(al>n15_tolerance(arm)){accept=0;}}
        if(accept==1){if(n15_is_additive(arm)==1){n15_copy(cs,spec_w);spec_b.*=sb;}else{n15_copy(cw,work_w);work_b.*=cb;}st.accepted=st.accepted+1;}
        else{st.rejected=st.rejected+1;}
        i=i+1;
    }epoch=epoch+1;}
    st.anchor_loss=n15_anchor_loss(seed,parent_w,parent_b,work_w,work_b.*,spec_w,spec_b.*,p,arm);
    zfree(x);zfree(cw);zfree(cs);return st;
}
fn n15_eval(seed:i32,kind:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,p:[]i32,arm:i32)N15Eval {
    let e:N15Eval=N15Eval{.parent_correct=0,.final_correct=0,.lost=0,.rescued=0};let x:[]i32=zalloc_i(N15_F);let i:i32=0;
    while(i<N15_PROBE){n15_fill(seed,i,kind,x);let y:i32=n15_target(kind,x);let pc:i32=n15_choice(parent_w,parent_b,x);let fc:i32=n15_predict(parent_w,parent_b,work_w,work_b,spec_w,spec_b,p,arm,x);
        if(pc==y){e.parent_correct=e.parent_correct+1;}if(fc==y){e.final_correct=e.final_correct+1;}if(pc==y && fc!=y){e.lost=e.lost+1;}if(pc!=y && fc==y){e.rescued=e.rescued+1;}i=i+1;}
    zfree(x);return e;
}
fn n15_print_i(v:i32)void {_zag_print(_zag_i64_to_str(v as i64));}
fn n15_emit(prefix:[]u8,pop:i32,arm:i32,parent_updates:i32,old:N15Eval,newv:N15Eval,st:N15TrainStats)void {
    _zag_print(prefix);_zag_print(",");n15_print_i(pop);_zag_print(",");n15_print_i(arm);_zag_print(",");n15_print_i(parent_updates);
    _zag_print(",");n15_print_i(old.parent_correct);_zag_print(",");n15_print_i(old.final_correct);_zag_print(",");n15_print_i(old.lost);_zag_print(",");n15_print_i(old.rescued);
    _zag_print(",");n15_print_i(newv.parent_correct);_zag_print(",");n15_print_i(newv.final_correct);_zag_print(",");n15_print_i(newv.final_correct-newv.parent_correct);
    _zag_print(",");n15_print_i(st.proposals);_zag_print(",");n15_print_i(st.accepted);_zag_print(",");n15_print_i(st.rejected);_zag_print(",");n15_print_i(st.skipped);_zag_print(",");n15_print_i(st.anchor_loss);_zag_println("");
}
fn n15_run_one(base_seed:i32,pop:i32,arm:i32,prefix:[]u8)N15Outcome {
    let old_train_seed:i32=base_seed+pop*997+11;let new_train_seed:i32=base_seed+pop*997+101;let old_probe_seed:i32=base_seed+pop*997+401;let new_probe_seed:i32=base_seed+pop*997+701;
    let parent_w:[]i32=zalloc_i(N15_F);let work_w:[]i32=zalloc_i(N15_F);let spec_w:[]i32=zalloc_i(N15_F);let proto:[]i32=zalloc_i(8);let parent_b:i32=0;
    let parent_updates:i32=n15_train_parent(old_train_seed,parent_w,&parent_b);n15_copy(parent_w,work_w);n15_zero(spec_w);let work_b:i32=parent_b;let spec_b:i32=0;n15_protos(old_train_seed,new_train_seed,proto);
    let st:N15TrainStats=n15_train_new(new_train_seed,arm,parent_w,parent_b,work_w,&work_b,spec_w,&spec_b,proto);
    let old:N15Eval=n15_eval(old_probe_seed,0,parent_w,parent_b,work_w,work_b,spec_w,spec_b,proto,arm);
    let newv:N15Eval=n15_eval(new_probe_seed,1,parent_w,parent_b,work_w,work_b,spec_w,spec_b,proto,arm);
    n15_emit(prefix,pop,arm,parent_updates,old,newv,st);let out:N15Outcome=N15Outcome{.old_parent=old.parent_correct,.old_final=old.final_correct,.old_lost=old.lost,.new_gain=newv.final_correct-newv.parent_correct};zfree(parent_w);zfree(work_w);zfree(spec_w);zfree(proto);return out;
}
fn n15_run_dev()i32 {
    _zag_println("N15_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,parent_new,final_new,new_gain,proposals,accepted,rejected,skipped,anchor_loss");
    let total_loss:[]i32=zalloc_i(N15_ARMS);let total_gain:[]i32=zalloc_i(N15_ARMS);let min_gain:[]i32=zalloc_i(N15_ARMS);let max_deficit:[]i32=zalloc_i(N15_ARMS);n15_zero(total_loss);n15_zero(total_gain);n15_zero(max_deficit);let arm:i32=0;while(arm<N15_ARMS){min_gain[arm]=1000000;arm=arm+1;}
    let pop:i32=0;while(pop<N15_DEV_POPS){arm=0;while(arm<N15_ARMS){let o:N15Outcome=n15_run_one(510000,pop,arm,"N15_DEV");total_loss[arm]=total_loss[arm]+o.old_lost;total_gain[arm]=total_gain[arm]+o.new_gain;if(o.new_gain<min_gain[arm]){min_gain[arm]=o.new_gain;}let deficit:i32=o.old_parent-o.old_final;if(deficit>max_deficit[arm]){max_deficit[arm]=deficit;}arm=arm+1;}pop=pop+1;}
    let selected:i32=-1;let gate:i32=0;let best_loss:i32=2147480000;let best_min:i32=-2147480000;let best_gain:i32=-2147480000;arm=1;
    while(arm<N15_ARMS){let eligible:i32=0;if(min_gain[arm]>0 && max_deficit[arm]<=4 && total_gain[arm]>=128){eligible=1;}
        _zag_print("N15_DEV_ARM,");n15_print_i(arm);_zag_print(",");n15_print_i(total_loss[arm]);_zag_print(",");n15_print_i(total_gain[arm]);_zag_print(",");n15_print_i(min_gain[arm]);_zag_print(",");n15_print_i(max_deficit[arm]);_zag_print(",");n15_print_i(eligible);_zag_println("");
        if(eligible==1){if(selected<0 || total_loss[arm]<best_loss || (total_loss[arm]==best_loss && min_gain[arm]>best_min) || (total_loss[arm]==best_loss && min_gain[arm]==best_min && total_gain[arm]>best_gain)){selected=arm;best_loss=total_loss[arm];best_min=min_gain[arm];best_gain=total_gain[arm];gate=1;}}arm=arm+1;}
    if(selected<0){arm=1;best_loss=2147480000;best_gain=-2147480000;while(arm<N15_ARMS){if(total_gain[arm]>0 && (selected<0 || total_loss[arm]<best_loss || (total_loss[arm]==best_loss && total_gain[arm]>best_gain))){selected=arm;best_loss=total_loss[arm];best_gain=total_gain[arm];}arm=arm+1;}}
    _zag_print("N15_DEV_SELECTION,");n15_print_i(selected);_zag_print(",");n15_print_i(gate);_zag_println("");zfree(total_loss);zfree(total_gain);zfree(min_gain);zfree(max_deficit);_zag_println("R33_N15_DEV_COMPLETE");return 0;
}
fn n15_run_smoke()i32 {
    _zag_println("N15_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,parent_new,final_new,new_gain,proposals,accepted,rejected,skipped,anchor_loss");
    let arm:i32=0;while(arm<N15_ARMS){let ignored:N15Outcome=n15_run_one(410000,0,arm,"N15_SMOKE");arm=arm+1;}_zag_println("R33_N15_SMOKE_COMPLETE");return 0;
}
fn n15_parse_arm(a:[]u8)i32 {
    if(_zag_strcmp(a,"0")==1){return 0;}if(_zag_strcmp(a,"1")==1){return 1;}if(_zag_strcmp(a,"2")==1){return 2;}if(_zag_strcmp(a,"3")==1){return 3;}
    if(_zag_strcmp(a,"4")==1){return 4;}if(_zag_strcmp(a,"5")==1){return 5;}if(_zag_strcmp(a,"6")==1){return 6;}if(_zag_strcmp(a,"7")==1){return 7;}
    if(_zag_strcmp(a,"8")==1){return 8;}if(_zag_strcmp(a,"9")==1){return 9;}if(_zag_strcmp(a,"10")==1){return 10;}if(_zag_strcmp(a,"11")==1){return 11;}return -1;
}
fn n15_holdout(base_seed:i32,selected:i32,prefix:[]u8,marker:[]u8)i32 {
    if(selected<2 || selected>=N15_ARMS){return 2;}_zag_println("N15_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,parent_new,final_new,new_gain,proposals,accepted,rejected,skipped,anchor_loss");
    let pop:i32=0;while(pop<N15_HOLDOUT_POPS){let c0:N15Outcome=n15_run_one(base_seed,pop,0,prefix);let c1:N15Outcome=n15_run_one(base_seed,pop,1,prefix);let c4:N15Outcome=n15_run_one(base_seed,pop,4,prefix);let c8:N15Outcome=n15_run_one(base_seed,pop,8,prefix);if(selected!=4 && selected!=8){let cs:N15Outcome=n15_run_one(base_seed,pop,selected,prefix);}pop=pop+1;}_zag_println(marker);return 0;
}
fn main()i32 {
    if(_zag_argc()<2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"smoke")==1){return n15_run_smoke();}
    if(_zag_strcmp(mode,"dev")==1){return n15_run_dev();}
    if((_zag_strcmp(mode,"validate")==1 || _zag_strcmp(mode,"confirm")==1) && _zag_argc()==3){let arm:i32=n15_parse_arm(_zag_arg(2));if(_zag_strcmp(mode,"validate")==1){return n15_holdout(610000,arm,"N15_VAL","R33_N15_VALIDATION_COMPLETE");}return n15_holdout(710000,arm,"N15_CONF","R33_N15_CONFIRMATION_COMPLETE");}
    return 2;
}

// N07 new engineering identity. Public synthetic keys/oracles live only here.
@import("authority.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct N7Stats {checks:i32,failed:i32,children:i32,nested:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64}
fn n7_stats()N7Stats {return N7Stats{.checks=0,.failed=0,.children=0,.nested=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn n7_check(s:*N7Stats,name:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(name,a,e);}
fn n7_fill(n:i32,v:i32)[]u8 {let b:[]u8=nio_alloc(n);let i:i32=0;while(i<b.len){b[i]=v as u8;i=i+1;}return b;}
fn n7_data(n:i32,salt:i32)[]u8 {let b:[]u8=nio_alloc(n);let i:i32=0;while(i<b.len){b[i]=((i*37+salt)%256) as u8;i=i+1;}return b;}
fn n7_keys()[]u8 {let k:[]u8=nio_alloc(64);let i:i32=0;while(i<64){k[i]=((i*17+7)%256) as u8;i=i+1;}return k;}
fn n7_path(name:[]u8)[]u8 {return _zag_str_concat("Research/R33_NATIVE_N07_RUN_PRIMARY_V1/",name);}
fn n7_config(budget:i32)[]u8 {
    let c:[]u8=nio_alloc(128);let initial:[]u8=n7_data(32,3);
    na_copy("R33POL01",c);na_put(c,8,1);na_put(c,12,101);na_put(c,16,7001);na_put(c,20,9001);
    na_put(c,24,0);na_put(c,28,budget);na_put(c,32,11);
    ns_sha256("r33-native-n07-disclosed-dependency-control-v1",c[64..96]);
    ns_sha256(initial,c[96..128]);nio_free(initial);return c;
}
fn n7_store(name:[]u8,create:i32,budget:i32,s:*N7Stats)NaStore {
    let path:[]u8=n7_path(name);let c:[]u8=n7_config(budget);let keys:[]u8=n7_keys();let initial:[]u8=n7_data(32,3);
    if(create==1){n7_check(s,"exclusive_store_create",na_create(path,c,keys,initial),0);}
    let j:NaStore=na_open(path,c,keys);nio_free(path);nio_free(c);na_wipe(keys);nio_free(initial);return j;
}
fn n7_sign(g:[]u8)void {let keys:[]u8=n7_keys();na_hmac(keys[0..32],g[0..224],g[224..256]);na_wipe(keys);}
fn n7_grant(j:*NaStore,data:[]u8,nonce:i32,cost:i32,op:i32)[]u8 {
    let g:[]u8=nio_alloc(256);na_copy("R33GRT01",g);na_put(g,8,1);na_put(g,12,op);
    na_put(g,16,101);na_put(g,20,7001);na_put(g,24,9001);na_put(g,28,0);
    na_put(g,32,j.*.epoch);na_put(g,36,nonce);na_put(g,40,j.*.version);na_put(g,44,cost);
    na_put(g,48,32);na_put(g,52,1);na_put(g,56,data.len);ns_sha256(data,g[64..96]);
    na_copy(j.*.config[64..96],g[96..128]);na_copy(j.*.state_hash,g[128..160]);
    na_copy(j.*.policy_hash,g[160..192]);n7_sign(g);return g;
}
fn n7_submit(j:*NaStore,data:[]u8,nonce:i32,cost:i32,s:*N7Stats)void {
    let g:[]u8=n7_grant(j,data,nonce,cost,1);n7_check(s,"authorized_commit",na_submit(j,g,data),0);nio_free(g);
}
fn n7_restrict(j:*NaStore,nonce:i32,limit:i32,s:*N7Stats)void {
    let d:[]u8=nio_alloc(8);na_put(d,0,j.*.epoch+1);na_put(d,4,limit);
    let g:[]u8=n7_grant(j,d,nonce,0,2);n7_check(s,"authenticated_restriction",na_submit(j,g,d),0);nio_free(g);nio_free(d);
}
fn n7_snapshot(j:*NaStore,expected:[]u8,s:*N7Stats)void {
    let b:[]u8=n7_fill(expected.len+1,211);n7_check(s,"snapshot_length",na_snapshot(j,b),expected.len);
    n7_check(s,"snapshot_exact",nio_equal(b[0..expected.len],expected),1);
    n7_check(s,"snapshot_tail",b[expected.len] as i32,211);nio_free(b);
}
fn n7_write(root:i64,name:[]u8,b:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(root)!=0){code=-1;}
    if(nio_close(fd)!=0){code=-1;}return code;
}
fn n7_vector(key:[]u8,data:[]u8,expected:[]u8,s:*N7Stats)void {
    let out:[]u8=n7_fill(33,211);n7_check(s,"rfc_hmac_status",na_hmac(key,data,out),0);
    let hex:[]u8=ns_hex(out[0..32]);n7_check(s,"rfc_hmac_expected",nio_equal(hex[0..expected.len],expected),1);
    n7_check(s,"rfc_hmac_tail",out[32] as i32,211);n7_check(s,"full_tag_verify",na_mac_ok(key,data,out[0..32]),1);
    out[0]=(out[0] as i32 ^ 1) as u8;n7_check(s,"first_tag_byte_rejected",na_mac_ok(key,data,out[0..32]),0);
    out[0]=(out[0] as i32 ^ 1) as u8;out[31]=(out[31] as i32 ^ 1) as u8;
    n7_check(s,"last_tag_byte_rejected",na_mac_ok(key,data,out[0..32]),0);
    n7_check(s,"truncated_authentication_rejected",na_mac_ok(key,data,out[0..16]),0);nio_free(out);nio_free(hex);
}
fn n7_hmac(s:*N7Stats)void {
    let k:[]u8=n7_fill(20,11);n7_vector(k,"Hi There","b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",s);nio_free(k);
    n7_vector("Jefe","what do ya want for nothing?","5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",s);
    k=n7_fill(20,170);let d:[]u8=n7_fill(50,221);
    n7_vector(k,d,"773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",s);nio_free(k);nio_free(d);
    k=nio_alloc(25);let i:i32=0;while(i<25){k[i]=(i+1) as u8;i=i+1;}d=n7_fill(50,205);
    n7_vector(k,d,"82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",s);nio_free(k);nio_free(d);
    k=n7_fill(20,12);n7_vector(k,"Test With Truncation","a3b6167473100ee06e0c796c2955552b",s);nio_free(k);
    k=n7_fill(131,170);n7_vector(k,"Test Using Larger Than Block-Size Key - Hash Key First","60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",s);
    n7_vector(k,"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.","9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",s);nio_free(k);
    let short:[]u8=n7_fill(31,77);n7_check(s,"short_hmac_output",na_hmac("key","data",short),-8401);
    let changed:i32=0;i=0;while(i<31){if(short[i]!=77){changed=changed+1;}i=i+1;}n7_check(s,"short_output_unchanged",changed,0);nio_free(short);
    let out:[]u8=n7_fill(32,77);k=n7_fill(4097,1);n7_check(s,"oversized_key",na_hmac(k,"data",out),-8401);nio_free(k);
    d=n7_fill(1048577,1);n7_check(s,"oversized_message",na_hmac("key",d,out),-8401);nio_free(d);
    changed=0;i=0;while(i<32){if(out[i]!=77){changed=changed+1;}i=i+1;}n7_check(s,"overlimit_output_unchanged",changed,0);nio_free(out);
    let alias:[]u8=n7_fill(64,11);n7_check(s,"hmac_alias_status",na_hmac(alias[0..20],"Hi There",alias[0..32]),0);
    let hex:[]u8=ns_hex(alias[0..32]);n7_check(s,"hmac_alias_exact",nio_equal(hex,"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"),1);
    nio_free(alias);nio_free(hex);
    let wire:[]u8=n7_fill(4,33);n7_check(s,"wire_positive_overflow",na_put(wire,0,2147483648),-8401);
    n7_check(s,"wire_negative",na_put(wire,0,-1),-8401);n7_check(s,"wire_no_mutation",wire[0] as i32,33);
    n7_check(s,"wire_maximum",na_put(wire,0,2147483647),0);n7_check(s,"wire_maximum_exact",na_get(wire,0),2147483647);nio_free(wire);
}
fn n7_normal(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("normal",1-replay,20,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let initial:[]u8=n7_data(32,3);let d:[]u8=n7_data(4096,29);
    if(replay==0){n7_snapshot(&j,initial,s);n7_submit(&j,d,1,3,s);n7_snapshot(&j,d,s);
        d[0]=99;n7_check(s,"caller_mutation_not_shared",j.state[0] as i32,29);
        n7_submit(&j,"",2,2,s);n7_snapshot(&j,"",s);
        n7_submit(&j,initial,3,1,s); // Authorized synthetic learner rollback, not control-state rollback.
    }
    n7_check(s,"all_attempts_retained",j.seq,3);n7_check(s,"all_commits",j.state_commits,3);
    n7_check(s,"version_not_rewound",j.version,14);n7_check(s,"spent_not_refunded",j.spent,6);n7_check(s,"nonce_not_rewound",j.nonce,3);
    n7_snapshot(&j,initial,s);
    let g:[]u8=n7_grant(&j,initial,2,1,1);n7_check(s,"old_nonce_on_current_state_refused",na_submit(&j,g,initial),-8406);nio_free(g);
    n7_check(s,"no_alias_snapshot",na_snapshot(&j,j.state),-8411);
    let short:[]u8=n7_fill(31,77);n7_check(s,"short_snapshot",na_snapshot(&j,short),-8401);n7_check(s,"short_snapshot_unchanged",short[0] as i32,77);nio_free(short);
    na_close(&j);n7_check(s,"closed_snapshot_refused",na_snapshot(&j,d),-8410);nio_free(initial);nio_free(d);
}
fn n7_bad_word(j:*NaStore,base:[]u8,data:[]u8,at:i32,value:i32,expected:i32,s:*N7Stats)void {
    let g:[]u8=nio_alloc(256);na_copy(base,g);na_put(g,at,value);n7_sign(g);
    n7_check(s,"resigned_semantic_refusal",na_submit(j,g,data),expected);nio_free(g);
}
fn n7_refusals(s:*N7Stats)void {
    let j:NaStore=n7_store("refusals",1,8,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(32,29);let g:[]u8=n7_grant(&j,d,1,2,1);let altered:[]u8=nio_alloc(256);let i:i32=0;
    while(i<256){na_copy(g,altered);altered[i]=(altered[i] as i32 ^ 1) as u8;
        n7_check(s,"each_grant_byte_tamper_rejected",na_submit(&j,altered,d),-8402);i=i+1;}
    n7_bad_word(&j,g,d,8,2,-8401,s);n7_bad_word(&j,g,d,12,3,-8401,s);
    n7_bad_word(&j,g,d,16,102,-8403,s);n7_bad_word(&j,g,d,20,7002,-8403,s);n7_bad_word(&j,g,d,24,9002,-8403,s);
    n7_bad_word(&j,g,d,28,1,-8403,s);n7_bad_word(&j,g,d,32,1,-8404,s);n7_bad_word(&j,g,d,36,0,-8406,s);
    n7_bad_word(&j,g,d,40,12,-8404,s);n7_bad_word(&j,g,d,44,9,-8405,s);n7_bad_word(&j,g,d,48,0,-8404,s);
    n7_bad_word(&j,g,d,52,2,-8404,s);n7_bad_word(&j,g,d,56,33,-8401,s);n7_bad_word(&j,g,d,60,1,-8401,s);
    i=0;while(i<6){let at:i32=64+i*32;let expected:i32=-8403;if(i==4){at=192;expected=-8401;}if(i==5){at=0;expected=-8401;}
        na_copy(g,altered);altered[at]=(altered[at] as i32 ^ 1) as u8;n7_sign(altered);
        n7_check(s,"resigned_digest_or_format_refusal",na_submit(&j,altered,d),expected);i=i+1;}
    n7_check(s,"short_grant_refusal",na_submit(&j,g[0..255],d),-8401);
    d[0]=(d[0] as i32 ^ 1) as u8;n7_check(s,"candidate_swapped_after_grant",na_submit(&j,g,d),-8403);d[0]=(d[0] as i32 ^ 1) as u8;
    n7_check(s,"private_state_alias_refused",na_submit(&j,g,j.state[0..32]),-8411);
    n7_check(s,"key_alias_observer_refused",na_snapshot(&j,j.keys),-8411);
    n7_check(s,"refusals_spend_no_admission",j.seq,0);n7_check(s,"refusals_do_not_mutate_version",j.version,11);
    n7_check(s,"refusals_do_not_change_quota",j.spent,0);n7_check(s,"refusals_do_not_consume_nonce",j.nonce,0);
    let initial:[]u8=n7_data(32,3);n7_snapshot(&j,initial,s);nio_free(initial);
    n7_check(s,"valid_control_still_admits",na_submit(&j,g,d),0);na_close(&j);nio_free(d);nio_free(g);nio_free(altered);
}
fn n7_quota(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("quota",1-replay,6,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(32,29);let g:[]u8="";
    if(replay==0){n7_submit(&j,d,1,4,s);g=n7_grant(&j,d,2,3,1);n7_check(s,"aggregate_quota_refusal",na_submit(&j,g,d),-8405);nio_free(g);
        n7_submit(&j,d,2,2,s);n7_restrict(&j,3,0,s);}
    n7_check(s,"exhausted_spent",j.spent,6);n7_check(s,"restriction_below_spend",j.budget,0);n7_check(s,"revocation_epoch",j.epoch,1);
    n7_check(s,"quota_version",j.version,13);n7_check(s,"quota_attempts",j.seq,3);
    g=n7_grant(&j,d,4,1,1);n7_check(s,"no_refund_on_reload",na_submit(&j,g,d),-8405);nio_free(g);na_close(&j);nio_free(d);
}
fn n7_revocation(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("revocation",1-replay,20,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(32,29);
    if(replay==0){let old:[]u8=n7_grant(&j,d,1,1,1);n7_restrict(&j,2,10,s);
        n7_check(s,"signed_old_epoch_rejected",na_submit(&j,old,d),-8404);nio_free(old);
        n7_submit(&j,d,3,2,s);n7_restrict(&j,4,1,s);}
    n7_check(s,"epoch_two",j.epoch,2);n7_check(s,"lowered_budget",j.budget,1);n7_check(s,"restriction_never_refunds",j.spent,2);
    n7_check(s,"restriction_keeps_learner_version",j.version,12);n7_check(s,"all_restrictions_retained",j.seq,3);
    let raised:[]u8=nio_alloc(8);na_put(raised,0,3);na_put(raised,4,20);let g:[]u8=n7_grant(&j,raised,5,0,2);
    n7_check(s,"authenticated_widening_still_refused",na_submit(&j,g,raised),-8403);nio_free(g);nio_free(raised);na_close(&j);nio_free(d);
}
fn n7_nonce(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("nonce",1-replay,10,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(32,29);if(replay==0){n7_submit(&j,d,2147483647,1,s);}
    n7_check(s,"maximum_nonce_exact",j.nonce,2147483647);let g:[]u8=n7_grant(&j,d,2147483647,1,1);
    n7_check(s,"nonce_exhaustion_refuses",na_submit(&j,g,d),-8406);n7_check(s,"nonce_no_wrap",j.seq,1);nio_free(g);na_close(&j);nio_free(d);
}
fn n7_capacity(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("capacity",1-replay,100,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(1,32);if(replay==0){let i:i32=1;while(i<=32 && s.*.failed==0){d[0]=i as u8;n7_submit(&j,d,i,1,s);i=i+1;}}
    n7_check(s,"all_32_attempts_retained",j.seq,32);n7_check(s,"all_32_commits_retained",j.state_commits,32);
    n7_check(s,"all_32_charges_retained",j.spent,32);n7_check(s,"maximum_state_version",j.version,43);n7_snapshot(&j,d,s);
    let g:[]u8=n7_grant(&j,d,33,1,1);n7_check(s,"capacity_refusal",na_submit(&j,g,d),-8404);
    // Expiry is checked first; extending the authenticated logical interval still cannot gain a 33rd slot.
    na_put(g,48,100);n7_sign(g);n7_check(s,"capacity_independent_of_expiry",na_submit(&j,g,d),-8405);
    let fd:i64=na_index(j.root,"attempt-",33,0);n7_check(s,"no_33rd_artifact",fd,-2);if(fd>=0){nio_close(fd);}
    nio_free(g);na_close(&j);nio_free(d);
}
fn n7_crash(fault:i32,replay:i32,s:*N7Stats)void {
    let num:[]u8=_zag_i64_to_str(fault as i64);let name:[]u8=_zag_str_concat("crash",num);
    let j:NaStore=n7_store(name,1-replay,10,s);let d:[]u8=n7_data(32,29);nio_free(num);nio_free(name);
    if(replay==0){n7_check(s,"crash_setup_open",j.status,0);if(j.status==0 && s.*.failed==0){
        let g:[]u8=n7_grant(&j,d,1,3,1);_zag_println("N07_CRASH_BOUNDARY_ARMED");
        let code:i32=na_submit_diagnostic(&j,g,d,fault);
        n7_check(s,"returned_failed_commit",code,-8407);n7_check(s,"failure_invalidates_handles",j.root,-1);nio_free(g);
    }}else{
        if(fault<=2){n7_check(s,"incomplete_intent_fail_closed",j.status,-8408);n7_check(s,"no_usable_state",j.state.len,0);
            n7_check(s,"no_exposed_keys",j.keys.len,0);n7_check(s,"closed_root",j.root,-1);n7_check(s,"closed_lock",j.lock,-1);
        }else{n7_check(s,"fresh_crash_recovery",j.status,0);if(j.status==0){let committed:i32=(fault==4 || fault==5) as i32;
            n7_check(s,"intent_stays_charged",j.spent,3);n7_check(s,"nonce_stays_consumed",j.nonce,1);
            n7_check(s,"one_persistent_attempt",j.seq,1);n7_check(s,"recovered_version",j.version,11+committed);
            n7_check(s,"orphan_accounting",j.orphans,1-committed);
            let initial:[]u8=n7_data(32,3);if(committed==1){n7_snapshot(&j,d,s);}else{n7_snapshot(&j,initial,s);}nio_free(initial);
            let g:[]u8=n7_grant(&j,d,1,1,1);n7_check(s,"crashed_nonce_cannot_replay",na_submit(&j,g,d),-8406);nio_free(g);
            n7_submit(&j,d,2,2,s);n7_check(s,"continued_total_charge",j.spent,5);n7_check(s,"continued_attempt_two",j.seq,2);
        }}
    }na_close(&j);nio_free(d);
}
fn n7_revoke_crash(replay:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("revoke-crash",1-replay,10,s);n7_check(s,"open",j.status,0);if(j.status!=0){return;}
    if(replay==0){let d:[]u8=nio_alloc(8);na_put(d,0,1);na_put(d,4,1);let g:[]u8=n7_grant(&j,d,1,0,2);
        _zag_println("N07_CRASH_BOUNDARY_ARMED");if(s.*.failed!=0){_zag_exit(1);}na_submit_diagnostic(&j,g,d,3);_zag_exit(1);
    }else{n7_check(s,"orphan_restriction_effective",j.epoch,1);n7_check(s,"orphan_budget_effective",j.budget,1);
        n7_check(s,"restriction_does_not_change_state_version",j.version,11);n7_check(s,"restriction_orphan_retained",j.orphans,1);
        let d:[]u8=n7_data(32,29);let g:[]u8=n7_grant(&j,d,2,1,1);na_put(g,32,0);n7_sign(g);
        n7_check(s,"recovery_does_not_revive_epoch",na_submit(&j,g,d),-8404);nio_free(g);
        g=n7_grant(&j,d,2,2,1);n7_check(s,"recovery_does_not_revive_budget",na_submit(&j,g,d),-8405);nio_free(g);
        n7_submit(&j,d,2,1,s);nio_free(d);
    }na_close(&j);
}
fn n7_rename(root:i64,from:[]u8,to:[]u8)i32 {
    let old:[]u8=nio_cstr(from);let kept:[]u8=nio_cstr(to);
    let code:i64=_zag_darwin_syscall(465,root,_zag_slice_ptr(old) as i64,root,_zag_slice_ptr(kept) as i64,0,0);
    nio_free(old);nio_free(kept);return (code!=0) as i32;
}
fn n7_damage(root:i64,kind:i32)i32 {
    let source:[]u8="attempt-2.bin";if(kind==3){source="root.bin";}
    let fd:i64=nio_open_child(root,source,0);let b:[]u8=nio_alloc(4464);let n:i64=nio_read_exact(fd,b,4464);if(fd>=0){nio_close(fd);}
    if(n<32 || n>4464){nio_free(b);return -1;}if(n7_write(root,"preimage.bin",b[0..n as i32])!=0){nio_free(b);return -1;}
    let code:i32=0;
    if(kind==2){code=n7_rename(root,"attempt-1.bin","retained-attempt1.bin");}
    else if(kind==4){code=n7_rename(root,"commit-2.bin","retained-commit2.bin");
        if(code==0 && nio_link(root,"attempt-1.bin","commit-2.bin")!=0){code=-1;}}
    else{let name:[]u8=nio_cstr(source);fd=_zag_darwin_syscall(463,root,_zag_slice_ptr(name) as i64,16777478,0,0,0);nio_free(name);
        if(fd<0 || nio_regular(fd)!=1){code=-1;}
        else{b[(n as i32)-1]=(b[(n as i32)-1] as i32 ^ 1) as u8;
            if(nio_write_all(fd,b[0..n as i32])!=n || nio_sync(fd)!=0){code=-1;}}
        if(fd>=0 && nio_close(fd)!=0){code=-1;}
    }
    if(nio_sync(root)!=0){code=-1;}nio_free(b);return code;
}
fn n7_corrupt(kind:i32,replay:i32,s:*N7Stats)void {
    let num:[]u8=_zag_i64_to_str(kind as i64);let name:[]u8=_zag_str_concat("corrupt",num);
    let j:NaStore=n7_store(name,1-replay,10,s);nio_free(num);nio_free(name);
    if(replay==0){n7_check(s,"setup_open",j.status,0);if(j.status==0){let d:[]u8=n7_data(32,29);
        n7_submit(&j,d,1,1,s);d[0]=59;n7_submit(&j,d,2,1,s);
        if(s.*.failed==0){n7_check(s,"preimage_saved_and_damage_injected",n7_damage(j.root,kind),0);}nio_free(d);}
    }else{n7_check(s,"corrupt_authority_refused",j.status,-8408);n7_check(s,"no_usable_state",j.state.len,0);
        n7_check(s,"no_exposed_keys",j.keys.len,0);n7_check(s,"closed_root",j.root,-1);n7_check(s,"closed_lock",j.lock,-1);}
    na_close(&j);
}
fn n7_clone_file(from:i64,to:i64,name:[]u8)i32 {
    let b:[]u8=nio_alloc(4464);let fd:i64=nio_open_child(from,name,0);let n:i64=nio_read_exact(fd,b,4464);
    if(fd>=0){nio_close(fd);}let code:i32=-1;if(n>=0 && n<=4464){code=n7_write(to,name,b[0..n as i32]);}nio_free(b);return code;
}
fn n7_prefix_limit(s:*N7Stats)void {
    let j:NaStore=n7_store("prefix-source",1,10,s);n7_check(s,"source_open",j.status,0);if(j.status!=0){return;}
    let d:[]u8=n7_data(32,29);n7_submit(&j,d,1,1,s);d[0]=59;n7_submit(&j,d,2,1,s);
    let path:[]u8=n7_path("prefix-clone");n7_check(s,"exclusive_prefix_clone",nio_mkdir(path),0);
    let root:i64=nio_open_root(path);n7_check(s,"clone_root",(root>=0) as i32,1);
    if(root>=0){n7_check(s,"clone_lock",n7_write(root,"control.lock",""),0);
        n7_check(s,"clone_root_bytes",n7_clone_file(j.root,root,"root.bin"),0);
        n7_check(s,"clone_first_intent",n7_clone_file(j.root,root,"attempt-1.bin"),0);
        n7_check(s,"clone_first_commit",n7_clone_file(j.root,root,"commit-1.bin"),0);nio_close(root);}
    let c:[]u8=n7_config(10);let keys:[]u8=n7_keys();let clone:NaStore=na_open(path,c,keys);
    // Expected LIMITATION witness, never a protected-runtime passing claim.
    n7_check(s,"authenticated_prefix_is_not_external_antirollback",clone.status,0);
    n7_check(s,"clone_has_only_first_version",clone.version,12);n7_check(s,"source_has_second_version",j.version,13);
    _zag_println("N07_KNOWN_LIMITATION_SIGNED_PREFIX_ROLLBACK_REQUIRES_EXTERNAL_ANCHOR");
    na_close(&clone);na_close(&j);nio_free(path);nio_free(c);na_wipe(keys);nio_free(d);
}
fn n7_has(b:[]u8,needle:[]u8)i32 {
    let i:i32=0;while(i+needle.len<=b.len){let k:i32=0;while(k<needle.len && b[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;}return 0;
}
fn n7_number(b:[]u8,prefix:[]u8,tail:[]u8)i32 {
    let value:i32=-1;let i:i32=0;
    while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i32=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<9){v=v*10+(b[at] as i32)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}
        i=i+1;}return value;
}
fn n7_run(root:i64,mode:[]u8,expected:i32,s:*N7Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,15000,262144);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    n7_check(s,"child_status",r.status,0);n7_check(s,"child_started",r.started,1);n7_check(s,"child_reaped",r.reaped,1);
    n7_check(s,"child_exit",r.exit_code,expected);n7_check(s,"child_signal",r.signal,0);n7_check(s,"child_stderr_empty",r.stderr_bytes,0);
    n7_check(s,"observed_child_rss_bound",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(mode,".stdout");let fd:i64=nio_open_child(root,name,0);
    let n:i64=nio_read_exact(fd,b,262144);if(fd>=0){nio_close(fd);}nio_free(name);n7_check(s,"complete_capture",n,r.stdout_bytes);
    if(n>=0 && n<=262144){let log:[]u8=b[0..n as i32];
        if(expected==0){n7_check(s,"child_terminal_pass",n7_has(log,"N07_CHILD_PASS\n"),1);
            let checks:i32=n7_number(log,"N07_CHILD_COUNTS,",",0\n");let nested:i32=n7_number(log,"N07_NESTED_CHILDREN,","\n");
            let subchecks:i32=n7_number(log,"N07_NESTED_CHECKS,","\n");
            n7_check(s,"native_counts_valid",(checks>0 && nested>=0 && subchecks>=0) as i32,1);
            if(checks>0 && subchecks>=0){s.*.child_checks=s.*.child_checks+checks+subchecks;}if(nested>=0){s.*.nested=s.*.nested+nested;}
            if(_zag_strcmp(mode,"prefix-limit")==1){n7_check(s,"required_negative_boundary_witness",n7_has(log,"N07_KNOWN_LIMITATION_SIGNED_PREFIX_ROLLBACK_REQUIRES_EXTERNAL_ANCHOR\n"),1);}
        }else if(expected>=71 && expected<=75){n7_check(s,"declared_crash_boundary",n7_has(log,"N07_CRASH_BOUNDARY_ARMED\n"),1);}
        else{n7_check(s,"invalid_mode_silent",n,0);}
    }nio_free(b);
}
fn n7_lock(contender:i32,s:*N7Stats)void {
    let j:NaStore=n7_store("lock",1-contender,10,s);
    if(contender==1){n7_check(s,"other_process_denied_while_locked",j.status,-8409);n7_check(s,"denied_no_state",j.state.len,0);
        n7_check(s,"denied_closed_root",j.root,-1);n7_check(s,"denied_closed_lock",j.lock,-1);}
    else{n7_check(s,"owner_open",j.status,0);if(j.status==0){
        let path:[]u8=n7_path("lock");let logroot:i64=nio_open_root("Research/R33_NATIVE_N07_RUN_PRIMARY_V1");
        n7_run(logroot,"lock-contender",0,s);if(logroot>=0){nio_close(logroot);}nio_free(path);
        let d:[]u8=n7_data(32,29);n7_submit(&j,d,1,1,s);nio_free(d);
        na_close(&j);j=n7_store("lock",0,10,s);n7_check(s,"lock_released_for_reopen",j.status,0);n7_check(s,"owner_commit_preserved",j.spent,1);
    }}na_close(&j);
}
fn n7_field(b:[]u8,key:[]u8,v:i64)[]u8 {
    let num:[]u8=_zag_i64_to_str(v);let part:[]u8=_zag_str_concat(b,key);let out:[]u8=_zag_str_concat(part,num);
    nio_free(b);nio_free(part);nio_free(num);return out;
}
fn n7_supervise()i32 {
    if(nio_guard(60)!=0){return 3;}let admitted:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N07_RUN_PRIMARY_V1");
    if(admitted.status!=0){return 4;}let root:i64=admitted.root;let s:N7Stats=n7_stats();
    n7_run(root,"invalid",2,&s);n7_run(root,"hmac",0,&s);n7_run(root,"normal-write",0,&s);n7_run(root,"normal-replay",0,&s);
    n7_run(root,"refusals",0,&s);n7_run(root,"quota-write",0,&s);n7_run(root,"quota-replay",0,&s);
    n7_run(root,"revocation-write",0,&s);n7_run(root,"revocation-replay",0,&s);n7_run(root,"nonce-write",0,&s);n7_run(root,"nonce-replay",0,&s);
    n7_run(root,"capacity-write",0,&s);n7_run(root,"capacity-replay",0,&s);n7_run(root,"lock-owner",0,&s);
    let i:i32=1;while(i<=6 && s.failed==0){let num:[]u8=_zag_i64_to_str(i as i64);let stem:[]u8=_zag_str_concat("crash",num);
        let write:[]u8=_zag_str_concat(stem,"-write");let replay:[]u8=_zag_str_concat(stem,"-replay");let expected:i32=70+i;if(i==6){expected=0;}
        n7_run(root,write,expected,&s);n7_run(root,replay,0,&s);nio_free(num);nio_free(stem);nio_free(write);nio_free(replay);i=i+1;}
    n7_run(root,"revoke-crash-write",73,&s);n7_run(root,"revoke-crash-replay",0,&s);
    i=1;while(i<=4 && s.failed==0){let num:[]u8=_zag_i64_to_str(i as i64);let stem:[]u8=_zag_str_concat("corrupt",num);
        let write:[]u8=_zag_str_concat(stem,"-write");let replay:[]u8=_zag_str_concat(stem,"-replay");
        n7_run(root,write,0,&s);n7_run(root,replay,0,&s);nio_free(num);nio_free(stem);nio_free(write);nio_free(replay);i=i+1;}
    n7_run(root,"prefix-limit",0,&s);n7_check(&s,"all_top_level_children_completed",s.children,37);n7_check(&s,"nested_lock_child_completed",s.nested,1);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\": \"R33-N07\",\n  \"planned_top_level_children\": 37","");
    json=n7_field(json,",\n  \"completed_top_level_children\": ",s.children);json=n7_field(json,",\n  \"nested_children_reaped\": ",s.nested);
    json=n7_field(json,",\n  \"parent_failures\": ",s.failed);json=n7_field(json,",\n  \"verified_completed_child_checks\": ",s.child_checks);
    json=n7_field(json,",\n  \"parent_checks_before_result_save\": ",s.checks);json=n7_field(json,",\n  \"top_level_child_cpu_us\": ",s.cpu);
    json=n7_field(json,",\n  \"top_level_observed_wall_us\": ",s.wall);json=n7_field(json,",\n  \"peak_top_level_child_rss_bytes\": ",s.rss);
    let tail:[]u8=_zag_str_concat(json,",\n  \"training\": false,\n  \"canonical_mutation\": false,\n  \"real_human_grant\": false,\n  \"protected_runtime_qualified\": false,\n  \"external_antirollback_anchor\": false,\n  \"requires_terminal_pass_marker\": true\n}\n");nio_free(json);
    n7_check(&s,"native_result_saved",n7_write(root,"NATIVE_RESULT.json",tail),0);_zag_print(tail);nio_free(tail);
    n7_check(&s,"close_root",nio_close(root),0);_zag_print("N07_PARENT_FAILURES,");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("R33_N07_AUTHENTICATED_CONTROL_ENGINEERING_PASS_WITH_ANCHOR_LIMITATION");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return n7_supervise();}if(_zag_strcmp(mode,"invalid")==1){return 2;}
    if(nio_deadline(15)!=0){return 3;}let s:N7Stats=n7_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"hmac")==1){n7_hmac(&s);}else if(_zag_strcmp(mode,"normal-write")==1){n7_normal(0,&s);}
    else if(_zag_strcmp(mode,"normal-replay")==1){n7_normal(1,&s);}else if(_zag_strcmp(mode,"refusals")==1){n7_refusals(&s);}
    else if(_zag_strcmp(mode,"quota-write")==1){n7_quota(0,&s);}else if(_zag_strcmp(mode,"quota-replay")==1){n7_quota(1,&s);}
    else if(_zag_strcmp(mode,"revocation-write")==1){n7_revocation(0,&s);}else if(_zag_strcmp(mode,"revocation-replay")==1){n7_revocation(1,&s);}
    else if(_zag_strcmp(mode,"nonce-write")==1){n7_nonce(0,&s);}else if(_zag_strcmp(mode,"nonce-replay")==1){n7_nonce(1,&s);}
    else if(_zag_strcmp(mode,"capacity-write")==1){n7_capacity(0,&s);}else if(_zag_strcmp(mode,"capacity-replay")==1){n7_capacity(1,&s);}
    else if(_zag_strcmp(mode,"lock-owner")==1){n7_lock(0,&s);}else if(_zag_strcmp(mode,"lock-contender")==1){n7_lock(1,&s);}
    else if(_zag_strcmp(mode,"revoke-crash-write")==1){n7_revoke_crash(0,&s);}else if(_zag_strcmp(mode,"revoke-crash-replay")==1){n7_revoke_crash(1,&s);}
    else if(_zag_strcmp(mode,"prefix-limit")==1){n7_prefix_limit(&s);}
    else{handled=0;let i:i32=1;while(i<=6 && handled==0){let num:[]u8=_zag_i64_to_str(i as i64);let stem:[]u8=_zag_str_concat("crash",num);
        let write:[]u8=_zag_str_concat(stem,"-write");let replay:[]u8=_zag_str_concat(stem,"-replay");
        if(_zag_strcmp(mode,write)==1){handled=1;n7_crash(i,0,&s);}else if(_zag_strcmp(mode,replay)==1){handled=1;n7_crash(i,1,&s);}
        nio_free(num);nio_free(stem);nio_free(write);nio_free(replay);i=i+1;}
        i=1;while(i<=4 && handled==0){let num:[]u8=_zag_i64_to_str(i as i64);let stem:[]u8=_zag_str_concat("corrupt",num);
            let write:[]u8=_zag_str_concat(stem,"-write");let replay:[]u8=_zag_str_concat(stem,"-replay");
            if(_zag_strcmp(mode,write)==1){handled=1;n7_corrupt(i,0,&s);}else if(_zag_strcmp(mode,replay)==1){handled=1;n7_corrupt(i,1,&s);}
            nio_free(num);nio_free(stem);nio_free(write);nio_free(replay);i=i+1;}
    }
    if(handled==0){return 2;}
    _zag_print("N07_NESTED_CHILDREN,");_zag_println(_zag_i64_to_str((s.children+s.nested) as i64));
    _zag_print("N07_NESTED_CHECKS,");_zag_println(_zag_i64_to_str(s.child_checks as i64));
    _zag_print("N07_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N07_CHILD_PASS");return 0;
}

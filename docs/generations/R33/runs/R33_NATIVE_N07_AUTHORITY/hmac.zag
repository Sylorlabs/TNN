// Native HMAC-SHA256 substrate, RFC2104 / RFC4231.
// Full 32-byte tags only; no digital-signature or protected-key-custody claim.
@import("R33_NATIVE_SHA256_V2.zag")

fn na_copy(a:[]u8,b:[]u8)i32 {
    if(b.len<a.len){return -8401;}let i:i32=0;
    while(i<a.len){b[i]=a[i];i=i+1;}return 0;
}
fn na_zero(b:[]u8)void {let i:i32=0;while(i<b.len){b[i]=0;i=i+1;}}
fn na_is_zero(b:[]u8)i32 {
    let d:i32=0;let i:i32=0;while(i<b.len){d=d|(b[i] as i32);i=i+1;}return (d==0) as i32;
}
fn na_wipe(b:[]u8)void {na_zero(b);nio_free(b);}
fn na_hmac(key:[]u8,message:[]u8,out:[]u8)i32 {
    // Bound all temporary allocations before any output mutation.
    if(key.len<0 || key.len>4096 || message.len<0 || message.len>1048576 || out.len<32){return -8401;}
    let k:[]u8=nio_alloc(64);let inner:[]u8=nio_alloc(64+message.len);
    let outer:[]u8=nio_alloc(96);let tag:[]u8=nio_alloc(32);
    if(k.len!=64 || inner.len!=64+message.len || outer.len!=96 || tag.len!=32){
        na_wipe(k);na_wipe(inner);na_wipe(outer);na_wipe(tag);return -8407;
    }
    let code:i32=0;
    if(key.len>64){if(ns_sha256(key,k)!=0){code=-8407;}}
    else{na_copy(key,k);}
    if(code==0){let i:i32=0;while(i<64){inner[i]=(k[i] as i32 ^ 54) as u8;outer[i]=(k[i] as i32 ^ 92) as u8;i=i+1;}
        na_copy(message,inner[64..inner.len]);
        if(ns_sha256(inner,outer[64..96])!=0 || ns_sha256(outer,tag)!=0){code=-8407;}
        else{na_copy(tag,out);}
    }
    na_wipe(k);na_wipe(inner);na_wipe(outer);na_wipe(tag);return code;
}
fn na_mac_ok(key:[]u8,message:[]u8,tag:[]u8)i32 {
    if(tag.len!=32){return 0;}let expected:[]u8=nio_alloc(32);
    if(expected.len!=32){return 0;}let code:i32=na_hmac(key,message,expected);
    let difference:i32=0;let i:i32=0;
    // Fixed-length accumulator. Compiler/microarchitectural constant time is not established.
    while(i<32){difference=difference|((expected[i] as i32)^(tag[i] as i32));i=i+1;}
    na_wipe(expected);return (code==0 && difference==0) as i32;
}
fn na_put(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || b.len<4 || at>b.len-4 || v<0 || v>2147483647){return -8401;}
    let x:i64=v;let i:i32=0;while(i<4){b[at+i]=(x&255) as u8;x=x>>8;i=i+1;}return 0;
}
fn na_get(b:[]u8,at:i32)i32 {
    if(at<0 || b.len<4 || at>b.len-4 || b[at+3]>=128){return -1;}
    return (b[at] as i32)+(b[at+1] as i32)*256+(b[at+2] as i32)*65536+(b[at+3] as i32)*16777216;
}
fn na_name(prefix:[]u8,n:i32)[]u8 {
    let number:[]u8=_zag_i64_to_str(n as i64);let stem:[]u8=_zag_str_concat(prefix,number);
    let out:[]u8=_zag_str_concat(stem,".bin");nio_free(number);nio_free(stem);return out;
}
fn na_index(root:i64,prefix:[]u8,n:i32,create:i32)i64 {
    let name:[]u8=na_name(prefix,n);let fd:i64=nio_open_child(root,name,create);nio_free(name);return fd;
}
fn na_overlap(a:[]u8,b:[]u8)i32 {
    if(a.len<1 || b.len<1){return 0;}
    let ap:i64=_zag_slice_ptr(a) as i64;let bp:i64=_zag_slice_ptr(b) as i64;
    if(ap<=bp){return ((bp-ap)<a.len) as i32;}return ((ap-bp)<b.len) as i32;
}

// R33-N19 V3 candidate: retained-root host adapter, transactional recovery,
// fail-closed process status, explicit poisoned-state telemetry, and native
// qualification hooks for crash/resource/error-boundary execution.
// The original BUILD_06 source and results remain historical evidence.
@import("n19_host_v2.zag")
//
// This is engineering infrastructure only. It contains no learner, training,
// evaluator, parent-state reader, promotion path, registry writer, or foreign
// language supervision.
// The source is intentionally self-contained so that this candidate does not
// import or mutate another experiment directory.

const N19_OK:i32=0;
const N19_REFUSED_MALFORMED:i32=-1901;
const N19_REFUSED_OVERFLOW:i32=-1902;
const N19_REFUSED_CAPACITY:i32=-1903;
const N19_REFUSED_PATH:i32=-1904;
const N19_REFUSED_IO:i32=-1905;
const N19_REFUSED_RECOVERY:i32=-1906;
const N19_REFUSED_RESOURCE:i32=-1907;
const N19_REFUSED_HOST_ABI:i32=-1999;

const N19_MAGIC:i32=1314001235;
const N19_RECORD_BYTES:i32=32;
const N19_PAYLOAD_BYTES:i32=16;
const N19_MAX_EVENTS:i32=8;
const N19_MAX_JOURNAL_BYTES:i32=256;
const N19_MAX_OUTPUT_BYTES:i32=65536;
const N19_MAX_PATH_BYTES:i32=256;

struct N19State {
    sequence:i32,
    event_count:i32,
    journal_bytes:i32,
    audit_head:i32,
    poisoned:i32,
    recovered:i32,
}

struct N19Result {
    status:i32,
    detail:i64,
    bytes:i64,
    state:i32,
}

fn n19_alloc(n:i32)[]u8 {
    if(n<1 || n>1048576){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}

fn n19_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}

fn n19_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>=N19_MAX_PATH_BYTES){return "";}
    let b:[]u8=n19_alloc(s.len+1);if(b.len==0){return b;}
    let i:i32=0;while(i<s.len){if(s[i]==0){n19_free(b);return "";}b[i]=s[i];i=i+1;}
    b[s.len]=0;return b;
}

fn n19_leaf_ok(s:[]u8)i32 {
    if(s.len<1 || s.len>=N19_MAX_PATH_BYTES){return 0;}
    if(s.len==1 && s[0]==46){return 0;}
    if(s.len==2 && s[0]==46 && s[1]==46){return 0;}
    let i:i32=0;while(i<s.len){if(s[i]==0 || s[i]==47){return 0;}i=i+1;}return 1;
}

fn n19_u16(b:[]u8,at:i32)i32 {
    if(at<0 || at+2>b.len){return -1;}return (b[at] as i32)+((b[at+1] as i32)<<8);
}

fn n19_u32(b:[]u8,at:i32)i64 {
    if(at<0 || at+4>b.len){return -1;}
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}

fn n19_close(fd:i64)i32 {
    if(fd<0){return N19_REFUSED_IO;}
    let rc:i64=_zag_darwin_syscall(6,fd,0,0,0,0,0);if(rc!=0){return N19_REFUSED_IO;}return N19_OK;
}

fn n19_fstat_ok(fd:i64,want_directory:i32,want_unique:i32,want_mode_0600:i32)i32 {
    if(fd<0){return N19_REFUSED_IO;}let st:[]u8=n19_alloc(256);if(st.len==0){return N19_REFUSED_IO;}
    let rc:i64=_zag_darwin_syscall(339,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    if(rc<0){n19_free(st);return N19_REFUSED_IO;}
    let mode:i32=n19_u16(st,4);let nlink:i32=n19_u16(st,6);let uid:i64=n19_u32(st,16);let self_uid:i64=_zag_darwin_syscall(24,0,0,0,0,0,0);
    let kind:i32=mode & 61440;let ok_kind:i32=((want_directory==1 && kind==16384) || (want_directory==0 && kind==32768)) as i32;
    let ok_unique:i32=(want_unique==0 || nlink==1) as i32;let ok_owner:i32=(self_uid>=0 && uid==self_uid) as i32;
    let ok_mode:i32=(want_mode_0600==0 || (mode & 511)==384) as i32;n19_free(st);
    if(ok_kind!=1 || ok_unique!=1 || ok_owner!=1 || ok_mode!=1){return N19_REFUSED_PATH;}return N19_OK;
}

fn n19_open_root(root:[]u8)i64 {
    let h:N19HostResult=n19h_root_open(root);if(h.status!=0){return h.status as i64;}return h.fd;
}

fn n19_open_regular_at(rootfd:i64,leaf:[]u8,create:i32)i64 {
    let h:N19HostResult=n19h_leaf_open(rootfd,leaf,create);if(h.status!=0){return h.status as i64;}return h.fd;
}

fn n19_put32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn n19_get32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

// This checksum detects accidental/torn fixture records. It is not a
// cryptographic integrity claim and is deliberately labeled as such.
fn n19_checksum(b:[]u8,limit:i32)i32 {
    let s:i64=0;let i:i32=0;
    while(i<limit){s=(s+(b[i] as i64)) & 2147483647;i=i+1;}
    return s as i32;
}

fn n19_add_i64(a:i64,b:i64,out:*i64)i32 {
    if(b>0 && a>9223372036854775807-b){return N19_REFUSED_OVERFLOW;}
    if(b<0 && a<(-9223372036854775807-1)-b){return N19_REFUSED_OVERFLOW;}
    out.*=a+b;return N19_OK;
}

fn n19_result(status:i32,detail:i64)N19Result {
    return N19Result{.status=status,.detail=detail,.bytes=0,.state=0};
}

fn n19_empty_state()N19State {
    return N19State{.sequence=0,.event_count=0,.journal_bytes=0,.audit_head=0,.poisoned=0,.recovered=0};
}

fn n19_encode(record:[]u8,sequence:i32,payload:[]u8) i32 {
    if(record.len!=N19_RECORD_BYTES || payload.len>N19_PAYLOAD_BYTES){return N19_REFUSED_MALFORMED;}
    n19_put32(record,0,N19_MAGIC);n19_put32(record,4,sequence);n19_put32(record,8,payload.len);
    let i:i32=0;while(i<N19_PAYLOAD_BYTES){record[12+i]=0;i=i+1;}
    i=0;while(i<payload.len){record[12+i]=payload[i];i=i+1;}
    n19_put32(record,28,n19_checksum(record,28));return N19_OK;
}

fn n19_validate(record:[]u8,expected_sequence:i32)i32 {
    if(record.len!=N19_RECORD_BYTES){return N19_REFUSED_MALFORMED;}
    if(n19_get32(record,0)!=N19_MAGIC || n19_get32(record,4)!=expected_sequence){return N19_REFUSED_RECOVERY;}
    let n:i32=n19_get32(record,8);
    if(n<0 || n>N19_PAYLOAD_BYTES){return N19_REFUSED_MALFORMED;}
    if(n19_get32(record,28)!=n19_checksum(record,28)){return N19_REFUSED_RECOVERY;}
    return N19_OK;
}

fn n19_append(state:*N19State,record:[]u8)i32 {
    if(state==null as *N19State || state.*.poisoned!=0){return N19_REFUSED_RECOVERY;}
    if(record.len!=N19_RECORD_BYTES){return N19_REFUSED_MALFORMED;}
    if(state.*.event_count>=N19_MAX_EVENTS || state.*.journal_bytes>N19_MAX_JOURNAL_BYTES-N19_RECORD_BYTES){return N19_REFUSED_CAPACITY;}
    let rc:i32=n19_validate(record,state.*.sequence+1);if(rc!=N19_OK){return rc;}
    state.*.sequence=state.*.sequence+1;state.*.event_count=state.*.event_count+1;
    state.*.journal_bytes=state.*.journal_bytes+N19_RECORD_BYTES;state.*.audit_head=state.*.sequence;return N19_OK;
}

fn n19_recover(journal:[]u8,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    if(journal.len<0 || journal.len>N19_MAX_JOURNAL_BYTES){return n19_recovery_refuse(state,N19_REFUSED_MALFORMED);}
    if((journal.len % N19_RECORD_BYTES)!=0){return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let fresh:N19State=n19_empty_state();
    let at:i32=0;
    while(at<journal.len){let record:[]u8=journal[at..at+N19_RECORD_BYTES];let rc:i32=n19_append(&fresh,record);
        if(rc!=N19_OK){return n19_recovery_refuse(state,rc);}at=at+N19_RECORD_BYTES;}
    fresh.recovered=1;state.*=fresh;return N19_OK;
}

// A rejected recovery cannot publish an apparently usable valid prefix.
// Keep prior counters intact but make the unusable state explicit.
fn n19_recovery_refuse(state:*N19State,rc:i32)i32 {
    if(state!=null as *N19State){state.*.poisoned=1;state.*.recovered=0;}return rc;
}

fn n19_write_all(fd:i64,b:[]u8)i64 {
    if(fd<0 || b.len<0 || b.len>N19_MAX_OUTPUT_BYTES){return N19_REFUSED_MALFORMED;}
    let at:i64=0;let calls:i32=0;
    while(at<b.len && calls<1024){
        let n:i64=_zag_darwin_syscall(4,fd,(_zag_slice_ptr(b) as i64)+at,(b.len as i64)-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<=0){return N19_REFUSED_IO;}at=at+n;
    }
    if(at!=b.len){return N19_REFUSED_IO;}return at;
}

fn n19_sync(fd:i64)i64 {if(fd<0){return N19_REFUSED_IO;}return _zag_darwin_syscall(95,fd,0,0,0,0,0);}

fn n19_seek(fd:i64,offset:i64,whence:i64)i64 {
    if(fd<0 || offset<0 || (whence!=0 && whence!=2)){return N19_REFUSED_IO;}
    return _zag_darwin_syscall(199,fd,offset,whence,0,0,0);
}

fn n19_read_exact(fd:i64,out:[]u8,expected:i32)i64 {
    if(fd<0 || expected<0 || expected>out.len || expected>N19_MAX_JOURNAL_BYTES){return N19_REFUSED_MALFORMED;}
    if(n19_seek(fd,0,0)<0){return N19_REFUSED_IO;}
    let at:i64=0;let calls:i32=0;
    while(at<expected && calls<1024){
        let n:i64=_zag_darwin_syscall(3,fd,(_zag_slice_ptr(out) as i64)+at,(expected as i64)-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n==0){return N19_REFUSED_RECOVERY;}if(n<0){return N19_REFUSED_IO;}at=at+n;
    }
    if(at!=expected){return N19_REFUSED_RECOVERY;}return at;
}

fn n19_recover_fd(fd:i64,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    if(fd<0){return n19_recovery_refuse(state,N19_REFUSED_MALFORMED);}
    let end:i64=n19_seek(fd,0,2);
    if(end<0){return n19_recovery_refuse(state,N19_REFUSED_IO);}
    if(end==0 || end>N19_MAX_JOURNAL_BYTES || (end % N19_RECORD_BYTES)!=0){return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let journal:[]u8=n19_alloc(end as i32);if(journal.len==0){return n19_recovery_refuse(state,N19_REFUSED_IO);}
    let got:i64=n19_read_exact(fd,journal,end as i32);if(got!=end){n19_free(journal);return n19_recovery_refuse(state,got as i32);}
    let rc:i32=n19_recover(journal,state);n19_free(journal);return rc;
}

fn n19_apply_limits(cpu_seconds:i64,output_bytes:i64,event_count:i64)i32 {
    if(cpu_seconds<1 || cpu_seconds>30 || output_bytes<1 || output_bytes>N19_MAX_OUTPUT_BYTES || event_count<1 || event_count>N19_MAX_EVENTS){return N19_REFUSED_RESOURCE;}
    let p:*i64=_zag_malloc(16) as *i64;if(p==null as *i64){return N19_REFUSED_IO;}
    p[0]=cpu_seconds;p[1]=cpu_seconds;let rc1:i64=_zag_darwin_syscall(195,0,p as i64,0,0,0,0);
    p[0]=output_bytes;p[1]=output_bytes;let rc2:i64=_zag_darwin_syscall(195,1,p as i64,0,0,0,0);
    _zag_free(p as *i8);if(rc1!=0 || rc2!=0){return N19_REFUSED_RESOURCE;}return N19_OK;
}

fn n19_case_malformed()i32 {
    let state:N19State=n19_empty_state();let record:[]u8=n19_alloc(N19_RECORD_BYTES-16);if(record.len==0){return N19_REFUSED_IO;}
    let rc:i32=n19_append(&state,record);let unchanged:i32=(state.sequence==0 && state.event_count==0 && state.journal_bytes==0 && state.audit_head==0) as i32;n19_free(record);
    if(rc==N19_REFUSED_MALFORMED && unchanged==1){return rc;}return N19_REFUSED_RECOVERY;
}

fn n19_case_overflow()i32 {
    let out:i64=0;return n19_add_i64(9223372036854775807,1,&out);
}

fn n19_case_capacity()i32 {
    let state:N19State=n19_empty_state();let record:[]u8=n19_alloc(N19_RECORD_BYTES);let payload:[]u8="bounded";
    if(record.len==0){return N19_REFUSED_IO;}
    let i:i32=1;while(i<=N19_MAX_EVENTS){if(n19_encode(record,i,payload)!=N19_OK){n19_free(record);return N19_REFUSED_MALFORMED;}if(n19_append(&state,record)!=N19_OK){n19_free(record);return N19_REFUSED_CAPACITY;}i=i+1;}
    n19_encode(record,N19_MAX_EVENTS+1,payload);let rc:i32=n19_append(&state,record);let unchanged:i32=(state.sequence==N19_MAX_EVENTS && state.event_count==N19_MAX_EVENTS && state.journal_bytes==N19_MAX_JOURNAL_BYTES && state.audit_head==N19_MAX_EVENTS) as i32;n19_free(record);
    if(rc==N19_REFUSED_CAPACITY && unchanged==1){return rc;}return N19_REFUSED_RECOVERY;
}

fn n19_case_recovery(state:*N19State)i32 {
    let journal:[]u8=n19_alloc(N19_RECORD_BYTES*2);let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(journal.len==0 || record.len==0){n19_free(journal);n19_free(record);return N19_REFUSED_IO;}
    n19_encode(record,1,"first");let i:i32=0;while(i<N19_RECORD_BYTES){journal[i]=record[i];i=i+1;}
    n19_encode(record,2,"second");i=0;while(i<N19_RECORD_BYTES){journal[N19_RECORD_BYTES+i]=record[i];i=i+1;}
    let rc:i32=n19_recover(journal,state);if(rc==N19_OK && (state.*.sequence!=2 || state.*.event_count!=2 || state.*.journal_bytes!=64 || state.*.audit_head!=2 || state.*.recovered!=1)){n19_free(journal);n19_free(record);return N19_REFUSED_RECOVERY;}
    n19_free(journal);n19_free(record);return rc;
}

fn n19_case_corruption()i32 {
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){return N19_REFUSED_IO;}
    n19_encode(record,1,"fixture");record[12]=record[12]^1;let rc:i32=n19_validate(record,1);n19_free(record);return rc;
}

fn n19_case_failed_recovery_atomicity(state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    state.*=N19State{.sequence=7,.event_count=3,.journal_bytes=96,.audit_head=7,.poisoned=0,.recovered=1};
    let journal:[]u8=n19_alloc(N19_RECORD_BYTES*2);let record:[]u8=n19_alloc(N19_RECORD_BYTES);
    if(journal.len==0 || record.len==0){n19_free(journal);n19_free(record);return N19_REFUSED_IO;}
    n19_encode(record,1,"first");let i:i32=0;while(i<N19_RECORD_BYTES){journal[i]=record[i];i=i+1;}
    n19_encode(record,2,"second");i=0;while(i<N19_RECORD_BYTES){journal[N19_RECORD_BYTES+i]=record[i];i=i+1;}
    journal[N19_RECORD_BYTES+12]=journal[N19_RECORD_BYTES+12]^1;
    let rc:i32=n19_recover(journal,state);n19_free(journal);n19_free(record);
    if(rc!=N19_REFUSED_RECOVERY){return N19_REFUSED_RECOVERY;}
    if(state.*.sequence!=7 || state.*.event_count!=3 || state.*.journal_bytes!=96 || state.*.audit_head!=7){return N19_REFUSED_RECOVERY;}
    if(state.*.poisoned!=1 || state.*.recovered!=0){return N19_REFUSED_RECOVERY;}
    return N19_OK;
}

fn n19_write_fixture(root:[]u8,leaf:[]u8,attempted:*i64,committed:*i64)i32 {
    if(attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_write_fixture_at(rootfd,leaf,attempted,committed);let closed:i32=n19_close(rootfd);
    if(closed!=N19_OK){return N19_REFUSED_IO;}return rc;
}

fn n19_write_fixture_at(rootfd:i64,leaf:[]u8,attempted:*i64,committed:*i64)i32 {
    if(attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){return fd as i32;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);return N19_REFUSED_IO;}
    let rc0:i32=n19_encode(record,1,"native-io");if(rc0!=N19_OK){n19_free(record);n19_close(fd);return rc0;}
    attempted.*=N19_RECORD_BYTES;let written:i64=n19_write_all(fd,record);n19_free(record);
    if(written!=N19_RECORD_BYTES){n19_close(fd);return N19_REFUSED_IO;}
    if(n19_sync(fd)!=0 || n19_sync(rootfd)!=0){n19_close(fd);return N19_REFUSED_IO;}
    if(n19_close(fd)!=N19_OK){return N19_REFUSED_IO;}committed.*=written;return N19_OK;
}

fn n19_read_fixture(root:[]u8,leaf:[]u8,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return n19_recovery_refuse(state,rootfd as i32);}
    let rc:i32=n19_read_fixture_at(rootfd,leaf,state);let closed:i32=n19_close(rootfd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_read_fixture_at(rootfd:i64,leaf:[]u8,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,0);if(fd<0){return n19_recovery_refuse(state,fd as i32);}
    let rc:i32=n19_recover_fd(fd,state);let closed:i32=n19_close(fd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_append_existing_fixture(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;
    if(state.*.poisoned!=0){return N19_REFUSED_RECOVERY;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_append_existing_fixture_at(rootfd,leaf,state,attempted,committed);let closed:i32=n19_close(rootfd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_append_existing_fixture_at(rootfd:i64,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;
    if(state.*.poisoned!=0){return N19_REFUSED_RECOVERY;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,0);if(fd<0){return n19_recovery_refuse(state,fd as i32);}
    let prior:N19State=n19_empty_state();let recovered:i32=n19_recover_fd(fd,&prior);
    if(recovered!=N19_OK){n19_close(fd);return n19_recovery_refuse(state,recovered);}
    if(prior.sequence!=1 || prior.event_count!=1 || prior.journal_bytes!=N19_RECORD_BYTES || prior.audit_head!=1 || prior.recovered!=1){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let end:i64=n19_seek(fd,0,2);if(end<0){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    if(end!=N19_RECORD_BYTES){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    let rc0:i32=n19_encode(record,2,"native-append");if(rc0!=N19_OK){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,rc0);}
    attempted.*=N19_RECORD_BYTES;let written:i64=n19_write_all(fd,record);
    if(written!=N19_RECORD_BYTES){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    if(n19_sync(fd)!=0 || n19_sync(rootfd)!=0){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    let applied:i32=n19_append(&prior,record);n19_free(record);if(applied!=N19_OK){n19_close(fd);return n19_recovery_refuse(state,applied);}
    if(n19_close(fd)!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}
    prior.recovered=1;state.*=prior;committed.*=written;return N19_OK;
}

fn n19_case_io(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_write_fixture_at(rootfd,leaf,attempted,committed);
    if(rc==N19_OK){rc=n19_read_fixture_at(rootfd,leaf,state);}
    let closed:i32=n19_close(rootfd);if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

// One retained root for the entire write -> append -> recovery sequence.
// Fresh-process root identity is a separate admission concern, not this claim.
fn n19_case_retained_sequence(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_write_fixture_at(rootfd,leaf,attempted,committed);
    if(rc==N19_OK){let next_attempted:i64=0;let next_committed:i64=0;
        rc=n19_append_existing_fixture_at(rootfd,leaf,state,&next_attempted,&next_committed);
        attempted.*=attempted.*+next_attempted;committed.*=committed.*+next_committed;}
    if(rc==N19_OK){rc=n19_read_fixture_at(rootfd,leaf,state);}
    if(rc==N19_OK && (state.*.sequence!=2 || state.*.event_count!=2 || state.*.journal_bytes!=64 || state.*.audit_head!=2 || state.*.recovered!=1 || state.*.poisoned!=0)){rc=n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let closed:i32=n19_close(rootfd);if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_probe_existing(root:[]u8,leaf:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}let fd:i64=n19_open_regular_at(rootfd,leaf,0);if(fd<0){n19_close(rootfd);return fd as i32;}let c1:i32=n19_close(fd);let c2:i32=n19_close(rootfd);if(c1!=N19_OK || c2!=N19_OK){return N19_REFUSED_IO;}return N19_OK;
}

fn n19_host_probe(root:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}return n19_host_probe_fd(rootfd);
}

fn n19_host_probe_fd(rootfd:i64)i32 {
    let synced:i64=n19_sync(rootfd);let closed:i32=n19_close(rootfd);if(synced!=0 || closed!=N19_OK){return N19_REFUSED_IO;}return N19_OK;
}

fn n19_case_fault_host_probe(root:[]u8)i32 {
    let fd:i64=n19_open_root(root);if(fd<0){return fd as i32;}
    if(n19_close(fd)!=N19_OK){return N19_REFUSED_IO;}
    let rc:i32=n19_host_probe_fd(fd);n19_emit("host_probe_closed_root",rc);
    return n19_exit_expected(rc,N19_REFUSED_IO);
}

fn n19_case_torn(root:[]u8,leaf:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}n19_encode(record,1,"torn");let written:i64=n19_write_all(fd,record[0..16]);n19_free(record);
    if(written!=16 || n19_sync(fd)!=0 || n19_sync(rootfd)!=0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}n19_close(fd);n19_close(rootfd);
    let state:N19State=n19_empty_state();let rc:i32=n19_read_fixture(root,leaf,&state);if(rc==N19_REFUSED_RECOVERY){return rc;}if(rc!=N19_OK){return rc;}return N19_REFUSED_IO;
}

// Deliberately terminate the process at one of five write phases. These modes
// are used only by the native qualification supervisor, which then launches a
// separate process for recovery. They model process death, not power loss.
fn n19_crash_phase(root:[]u8,leaf:[]u8,phase:i32)i32 {
    if(phase<1 || phase>5){return N19_REFUSED_MALFORMED;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}
    if(phase==1){_zag_exit(80);return N19_REFUSED_IO;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    if(n19_encode(record,1,"crash-phase")!=N19_OK){n19_free(record);n19_close(fd);n19_close(rootfd);return N19_REFUSED_MALFORMED;}
    if(phase==2){
        let half:i64=n19_write_all(fd,record[0..16]);
        if(half!=16){n19_free(record);n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
        _zag_exit(81);return N19_REFUSED_IO;
    }
    let full:i64=n19_write_all(fd,record);n19_free(record);
    if(full!=N19_RECORD_BYTES){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    if(phase==3){_zag_exit(82);return N19_REFUSED_IO;}
    if(n19_sync(fd)!=0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    if(phase==4){_zag_exit(83);return N19_REFUSED_IO;}
    if(n19_sync(rootfd)!=0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    _zag_exit(84);return N19_REFUSED_IO;
}

// Install a hard 32-byte RLIMIT_FSIZE and try to write two records. Normally
// Darwin terminates the child with SIGXFSZ on the second write. If the syscall
// instead returns an error, that is also a valid refusal path; the supervisor
// independently verifies that the file never grows beyond the limit.
fn n19_case_resource_fsize(root:[]u8,leaf:[]u8)i32 {
    let limited:i32=n19_apply_limits(5,N19_RECORD_BYTES,N19_MAX_EVENTS);if(limited!=N19_OK){return limited;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}
    let bytes:[]u8=n19_alloc(N19_RECORD_BYTES*2);if(bytes.len==0){n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_free(bytes);n19_close(fd);n19_close(rootfd);return N19_REFUSED_IO;}
    n19_encode(record,1,"limit-one");let i:i32=0;while(i<N19_RECORD_BYTES){bytes[i]=record[i];i=i+1;}
    n19_encode(record,2,"limit-two");i=0;while(i<N19_RECORD_BYTES){bytes[N19_RECORD_BYTES+i]=record[i];i=i+1;}
    n19_free(record);let written:i64=n19_write_all(fd,bytes);n19_free(bytes);
    n19_close(fd);n19_close(rootfd);
    if(written==N19_REFUSED_IO){return N19_OK;}
    return N19_REFUSED_RESOURCE;
}

fn n19_print_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);_zag_str_free(s);
}

fn n19_println_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_println(s);_zag_str_free(s);
}

fn n19_emit_fault(name:[]u8,raw:i64,classified:i32)void {
    _zag_print("N19_FAULT,");_zag_print(name);_zag_print(",raw,");n19_print_i64(raw);
    _zag_print(",classified,");n19_println_i64(classified as i64);
}

fn n19_case_fault_open(root:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let h:N19HostResult=n19h_leaf_open(rootfd,"definitely-missing-n19-v3",0);n19_close(rootfd);
    n19_emit_fault("open",h.detail,h.status);
    if(h.fd<0 && h.status==N19_REFUSED_PATH && h.detail<0){return N19_OK;}return N19_REFUSED_RECOVERY;
}

fn n19_case_fault_fsync(root:[]u8,leaf:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}
    if(n19_close(fd)!=N19_OK){n19_close(rootfd);return N19_REFUSED_IO;}
    let raw:i64=n19_sync(fd);let classified:i32=n19h_io_status(raw);n19_close(rootfd);
    n19_emit_fault("fsync",raw,classified);
    if(raw<0 && classified==N19_REFUSED_IO){return N19_OK;}return N19_REFUSED_RECOVERY;
}

fn n19_case_fault_close(root:[]u8,leaf:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}
    if(n19_close(fd)!=N19_OK){n19_close(rootfd);return N19_REFUSED_IO;}
    let raw:i64=_zag_darwin_syscall(6,fd,0,0,0,0,0);let classified:i32=n19h_io_status(raw);n19_close(rootfd);
    n19_emit_fault("close",raw,classified);
    if(raw<0 && classified==N19_REFUSED_IO){return N19_OK;}return N19_REFUSED_RECOVERY;
}

fn n19_emit(name:[]u8,rc:i32)void {
    // -1 is explicit missingness for values not observed by this case.
    _zag_print("N19_TELEMETRY,");_zag_print(name);_zag_print(",status,");n19_print_i64(rc as i64);
    // After the fixed envelope marker, emit exactly the 14 schema fields:
    // case_id, phase, status, detail, attempted, committed, sequence,
    // event_count, audit_head, resource_limit, resource_observed,
    // recovery_state, stdout_bytes, stderr_bytes.
    _zag_print(",0,-1,-1,-1,-1,-1,-1,-1,missing,-1,-1");_zag_println("");
}

fn n19_emit_state(name:[]u8,rc:i32,state:*N19State,attempted:i64,committed:i64)void {
    _zag_print("N19_TELEMETRY,");_zag_print(name);_zag_print(",status,");n19_print_i64(rc as i64);
    _zag_print(",0,");n19_print_i64(attempted);_zag_print(",");n19_print_i64(committed);
    _zag_print(",");n19_print_i64(state.*.sequence as i64);_zag_print(",");n19_print_i64(state.*.event_count as i64);
    _zag_print(",");n19_print_i64(state.*.audit_head as i64);
    _zag_print(",-1,-1,");
    if(rc!=N19_OK || state.*.poisoned==1){_zag_print("poisoned");}
    else if(state.*.recovered==1){_zag_print("recovered");}
    else{_zag_print("fresh");}
    _zag_println(",-1,-1");
}

fn n19_exit_ok(rc:i32)i32 {
    if(rc==N19_OK){return 0;}return 1;
}

fn n19_exit_expected(rc:i32,want:i32)i32 {
    if(rc==want){return 0;}return 1;
}

// Classification-only gate over adapter-owned errno mappings. Runtime fault
// fixtures below separately exercise real descriptors. This keeps the mapping
// contract falsifiable without pretending a synthetic errno is an OS event.
fn n19_case_error_classification()i32 {
    if(n19h_open_status(-2)!=N19_REFUSED_PATH){return N19_REFUSED_RECOVERY;}
    if(n19h_open_status(-22)!=N19_REFUSED_HOST_ABI){return N19_REFUSED_RECOVERY;}
    if(n19h_open_status(-5)!=N19_REFUSED_IO){return N19_REFUSED_RECOVERY;}
    if(n19h_io_status(-5)!=N19_REFUSED_IO){return N19_REFUSED_RECOVERY;}
    if(n19h_io_status(0)!=N19_OK){return N19_REFUSED_RECOVERY;}
    return N19_OK;
}

fn n19_emit_limit(rc:i32,configured:i64)void {
    _zag_print("N19_TELEMETRY,limit,status,");n19_print_i64(rc as i64);
    _zag_print(",0,-1,-1,-1,-1,-1,");n19_print_i64(configured);
    // No runtime usage meter is available in this bounded fixture. Missing
    // observation stays -1 and is never replaced by the configured ceiling.
    _zag_println(",-1,missing,-1,-1");
}

fn n19_case_poisoned_append(root:[]u8,leaf:[]u8)i32 {
    let attempted:i64=0;let committed:i64=0;
    if(n19_write_fixture(root,leaf,&attempted,&committed)!=N19_OK){return 1;}
    let state:N19State=n19_empty_state();
    if(n19_case_failed_recovery_atomicity(&state)!=N19_OK){return 1;}
    let rc:i32=n19_append_existing_fixture(root,leaf,&state,&attempted,&committed);
    let fresh:N19State=n19_empty_state();let read:i32=n19_read_fixture(root,leaf,&fresh);
    _zag_print("N19_POISONED_APPEND,status,");n19_emit("poisoned_append",rc);
    if(rc!=N19_REFUSED_RECOVERY || attempted!=0 || committed!=0 || state.sequence!=7 || state.event_count!=3 || state.journal_bytes!=96 || state.audit_head!=7 || state.poisoned!=1 || state.recovered!=0 || read!=N19_OK || fresh.sequence!=1 || fresh.journal_bytes!=32){return 1;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return 1;}
    let direct:i32=n19_append_existing_fixture_at(rootfd,leaf,&state,&attempted,&committed);
    let closed:i32=n19_close(rootfd);
    let after:N19State=n19_empty_state();let reread:i32=n19_read_fixture(root,leaf,&after);
    if(direct!=N19_REFUSED_RECOVERY || closed!=N19_OK || attempted!=0 || committed!=0 || reread!=N19_OK || after.sequence!=1 || after.journal_bytes!=32 || state.sequence!=7 || state.event_count!=3 || state.journal_bytes!=96 || state.audit_head!=7 || state.poisoned!=1 || state.recovered!=0){return 1;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){return 1;}
    n19_encode(record,8,"blocked");let append:i32=n19_append(&state,record);n19_free(record);
    if(append!=N19_REFUSED_RECOVERY || state.sequence!=7 || state.poisoned!=1){return 1;}
    _zag_println("N19_POISONED_APPEND,failures,0");return 0;
}

fn n19_case_extra_invariants()i32 {
    let failed:i32=0;let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){return 1;}
    let kind:i32=0;
    while(kind<5){
        let state:N19State=n19_empty_state();n19_encode(record,1,"bounded");
        if(kind==0){n19_put32(record,0,0);}if(kind==1){n19_put32(record,4,2);}
        if(kind==2){n19_put32(record,8,17);}if(kind==3){n19_put32(record,8,-1);}if(kind==4){record[12]=record[12]^1;}
        // Recompute checksum for structural attacks so checksum alone cannot hide a missing invariant.
        if(kind<4){n19_put32(record,28,n19_checksum(record,28));}
        let rc:i32=n19_append(&state,record);
        if(rc==N19_OK || state.sequence!=0 || state.event_count!=0 || state.journal_bytes!=0 || state.audit_head!=0){failed=failed+1;}
        let recovered:i32=n19_recover(record,&state);
        if(recovered==N19_OK || state.sequence!=0 || state.event_count!=0 || state.poisoned!=1 || state.recovered!=0){failed=failed+1;}
        n19_encode(record,1,"valid");if(n19_append(&state,record)!=N19_REFUSED_RECOVERY || state.sequence!=0){failed=failed+1;}
        kind=kind+1;
    }
    let state:N19State=n19_empty_state();n19_encode(record,1,"first");
    if(n19_append(&state,record)!=N19_OK){failed=failed+1;}
    if(n19_append(&state,record)!=N19_REFUSED_RECOVERY || state.sequence!=1 || state.event_count!=1 || state.journal_bytes!=32 || state.audit_head!=1){failed=failed+1;}
    if(n19_recover_fd(-1,&state)!=N19_REFUSED_MALFORMED || state.poisoned!=1 || state.sequence!=1){failed=failed+1;}
    n19_free(record);_zag_print("N19_EXTRA_INVARIANTS,failures,");n19_print_i64(failed as i64);_zag_println("");return failed;
}
fn n19_case_cpu_ceiling()i32 {
    if(n19_apply_limits(1,32,1)!=N19_OK){return 1;}
    let tv:*i64=_zag_malloc(16) as *i64;if(tv==null as *i64){return 1;}
    if(_zag_darwin_syscall(116,tv as i64,0,0,0,0,0)!=0){_zag_free(tv as *i8);return 1;}
    let start:i64=tv[0];let ticks:i64=0;
    // Busy CPU only; wall clock is an 8-second test escape, never pass evidence.
    while(true){
        ticks=ticks+1;
        if((ticks & 65535)==0){
            if(_zag_darwin_syscall(116,tv as i64,0,0,0,0,0)!=0){_zag_free(tv as *i8);return 1;}
            if(tv[0]-start>=8){_zag_free(tv as *i8);return 88;}
        }
    }
    return 1;
}
fn independent_corners(root:[]u8)i32 {
    let s:N19State=n19_empty_state();let a:i64=99;let c:i64=99;
    if(n19_case_failed_recovery_atomicity(&s)!=0){return 1;}
    let rc:i32=n19_append_existing_fixture(root,"../escape",&s,&a,&c);
    if(rc!=-1906 || a!=0 || c!=0 || s.sequence!=7 || s.event_count!=3 || s.journal_bytes!=96 || s.audit_head!=7 || s.poisoned!=1 || s.recovered!=0){return 1;}
    a=99;c=99;rc=n19_append_existing_fixture_at(-1,"missing",&s,&a,&c);
    if(rc!=-1906 || a!=0 || c!=0){return 1;}
    rc=n19_read_fixture(root,"missing",&s);
    if(rc!=-1904 || s.sequence!=7 || s.event_count!=3 || s.journal_bytes!=96 || s.audit_head!=7 || s.poisoned!=1 || s.recovered!=0){return 1;}
    let record:[]u8=n19_alloc(32);if(record.len!=32){return 1;}
    n19_encode(record,8,"blocked");rc=n19_append(&s,record);
    if(rc!=-1906 || s.sequence!=7 || s.event_count!=3 || s.journal_bytes!=96 || s.audit_head!=7){n19_free(record);return 1;}
    n19_encode(record,1,"valid");rc=n19_recover(record,&s);
    if(rc!=0 || s.sequence!=1 || s.event_count!=1 || s.journal_bytes!=32 || s.audit_head!=1 || s.poisoned!=0 || s.recovered!=1){n19_free(record);return 1;}
    n19_encode(record,2,"resume");rc=n19_append(&s,record);n19_free(record);
    if(rc!=0 || s.sequence!=2 || s.event_count!=2 || s.journal_bytes!=64 || s.audit_head!=2){return 1;}
    rc=n19_recover_fd(-1,&s);
    if(rc!=-1901 || s.sequence!=2 || s.event_count!=2 || s.journal_bytes!=64 || s.audit_head!=2 || s.poisoned!=1 || s.recovered!=0){return 1;}
    rc=n19_recover("",&s);
    if(rc!=0 || s.sequence!=0 || s.poisoned!=0 || s.recovered!=1){return 1;}
    rc=n19_recover_fd(-1,&s);a=99;c=99;
    if(rc!=-1901 || n19_append_existing_fixture(root,"missing",&s,&a,&c)!=-1906 || a!=0 || c!=0){return 1;}
    _zag_println("INDEPENDENT_CORNERS,failures,0,empty_memory_recovery_clears_poison,1");return 0;
}


fn main()i32 {
    if(_zag_argc()==3 && _zag_strcmp(_zag_arg(1),"independent-corners")==1){return independent_corners(_zag_arg(2));}
    if(_zag_argc()==4 && _zag_strcmp(_zag_arg(1),"case-cpu-ceiling")==1){return n19_case_cpu_ceiling();}
    if(_zag_argc()==2 && _zag_strcmp(_zag_arg(1),"case-extra-invariants")==1){return n19_case_extra_invariants();}
    if(_zag_argc()==4 && _zag_strcmp(_zag_arg(1),"case-poisoned-append")==1){return n19_case_poisoned_append(_zag_arg(2),_zag_arg(3));}
    // Every filesystem mode accepts an owner-created capability root plus one
    // relative leaf. No mode reads or writes canonical R27 or experiment
    // registry state.
    if(_zag_argc()<2 || _zag_argc()>4){return 2;}
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"case-fault-host-probe")==1){if(_zag_argc()!=3){return 2;}return n19_case_fault_host_probe(_zag_arg(2));}
    if(_zag_strcmp(mode,"case-malformed")==1){let rc:i32=n19_case_malformed();n19_emit("malformed",rc);return n19_exit_expected(rc,N19_REFUSED_MALFORMED);}
    if(_zag_strcmp(mode,"case-overflow")==1){let rc:i32=n19_case_overflow();n19_emit("overflow",rc);return n19_exit_expected(rc,N19_REFUSED_OVERFLOW);}
    if(_zag_strcmp(mode,"case-capacity")==1){let rc:i32=n19_case_capacity();n19_emit("capacity",rc);return n19_exit_expected(rc,N19_REFUSED_CAPACITY);}
    if(_zag_strcmp(mode,"case-recovery")==1){let state:N19State=n19_empty_state();let rc:i32=n19_case_recovery(&state);n19_emit_state("recovery",rc,&state,-1,-1);return n19_exit_ok(rc);}
    if(_zag_strcmp(mode,"case-corruption")==1){let rc:i32=n19_case_corruption();n19_emit("corruption",rc);return n19_exit_expected(rc,N19_REFUSED_RECOVERY);}
    if(_zag_strcmp(mode,"case-recovery-atomicity")==1){let state:N19State=n19_empty_state();let rc:i32=n19_case_failed_recovery_atomicity(&state);n19_emit_state("recovery_atomicity",rc,&state,-1,-1);return n19_exit_ok(rc);}
    if(_zag_strcmp(mode,"case-limit")==1){let rc:i32=n19_apply_limits(1,N19_MAX_OUTPUT_BYTES,N19_MAX_EVENTS);n19_emit_limit(rc,N19_MAX_OUTPUT_BYTES);return n19_exit_ok(rc);}
    if(_zag_strcmp(mode,"case-error-classification")==1){let rc:i32=n19_case_error_classification();n19_emit("error_classification",rc);return n19_exit_ok(rc);}
    if(_zag_strcmp(mode,"case-crash-after-open")==1){if(_zag_argc()!=4){return 2;}return n19_exit_ok(n19_crash_phase(_zag_arg(2),_zag_arg(3),1));}
    if(_zag_strcmp(mode,"case-crash-after-half-write")==1){if(_zag_argc()!=4){return 2;}return n19_exit_ok(n19_crash_phase(_zag_arg(2),_zag_arg(3),2));}
    if(_zag_strcmp(mode,"case-crash-after-full-write")==1){if(_zag_argc()!=4){return 2;}return n19_exit_ok(n19_crash_phase(_zag_arg(2),_zag_arg(3),3));}

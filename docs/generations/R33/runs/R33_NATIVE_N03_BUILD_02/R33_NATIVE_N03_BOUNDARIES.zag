// Prospective N03 engineering boundary fixtures. No learner or accepted state.
// All expected status values are local literals, not imported numeric constants.
@import("R33_NATIVE_JOURNAL_V1.zag")

fn nb_check(name:[]u8,actual:i64,expected:i64,fail:*i32)void {
    fail.*=fail.*+nio_metric(name,actual,expected);
}
fn nb_contains(bytes:[]u8,needle:[]u8)i32 {
    if(needle.len<1 || bytes.len<needle.len){return 0;}
    let i:i32=0;while(i<=bytes.len-needle.len){
        let k:i32=0;while(k<needle.len && bytes[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;
    }return 0;
}
fn nb_directory(kind:i32)[]u8 {
    let number:[]u8=_zag_i64_to_str(kind as i64);
    let path:[]u8=_zag_str_concat("Research/R33_NATIVE_N03_RUN_PRIMARY_V1/boundary",number);
    nio_free(number);return path;
}
fn nb_finish(kind:i32,fail:i32)i32 {
    _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(fail as i64));
    if(fail!=0){return 1;}
    _zag_print("N03_CHILD_PASS,boundary");_zag_println(_zag_i64_to_str(kind as i64));return 0;
}
fn nb_create(root:i64,name:[]u8,bytes:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}
    let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,bytes)!=bytes.len || nio_sync(fd)!=0){code=-1;}
    if(nio_close(fd)!=0 || nio_sync(root)!=0){code=-1;}return code;
}
fn nb_read(root:i64,name:[]u8,length:i32)[]u8 {
    if(length<1 || length>131072){return "";}
    let bytes:[]u8=nio_alloc(length);let fd:i64=nio_open_child(root,name,0);
    if(bytes.len!=length || fd<0){nio_free(bytes);if(fd>=0){nio_close(fd);}return "";}
    let got:i64=nio_read_exact(fd,bytes,length);nio_close(fd);
    if(got!=length){nio_free(bytes);return "";}return bytes;
}

// Mutations target only separately created engineering fixture files. A durable
// preimage copy is retained before changing/truncating a fixture, including its
// hardlinked attempt inode. No deletion or broad directory mutation is used.
fn nb_replace_retaining_preimage(root:i64,name:[]u8,record:[]u8)i32 {
    if(root<0 || nio_name_valid(name)!=1 || record.len>131072){return -1;}
    let prior:[]u8=nio_alloc(131072);let input:i64=nio_open_child(root,name,0);
    if(input<0 || prior.len!=131072){if(input>=0){nio_close(input);}nio_free(prior);return -1;}
    let length:i64=nio_read_exact(input,prior,131072);nio_close(input);
    if(length<0 || length>131072){nio_free(prior);return -1;}
    let saved:[]u8=_zag_str_concat("preimage-",name);
    let keep:i32=nb_create(root,saved,prior[0..length as i32]);nio_free(saved);nio_free(prior);
    if(keep!=0){return -1;}
    let s:[]u8=nio_cstr(name);if(s.len==0){return -1;}
    let fd:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(s) as i64,16777478,0,0,0);nio_free(s);
    if(fd<0){return -1;}let code:i32=0;
    if(nio_regular(fd)!=1 || _zag_darwin_syscall(201,fd,record.len as i64,0,0,0,0)!=0 ||
       nio_seek(fd,0,0)!=0 || nio_write_all(fd,record)!=record.len || nio_sync(fd)!=0){code=-1;}
    if(nio_close(fd)!=0){code=-1;}return code;
}
fn nb_failed_recovery(j:*NativeJournal,expected:i32,fail:*i32)void {
    nb_check("recovery_error",j.*.status,expected,fail);
    nb_check("no_state_on_failure",j.*.state.len,0,fail);
    nb_check("no_head_on_failure",j.*.head.len,0,fail);
    nb_check("no_transactions_on_failure",j.*.transactions.len,0,fail);
    nb_check("no_root_on_failure",j.*.root,-1,fail);
    nb_check("no_lock_on_failure",j.*.lock,-1,fail);
}
fn nb_pattern(bytes:[]u8,changed:i32)void {
    let i:i32=0;while(i<bytes.len){
        let v:i32=(i*13+7)%251;if(changed==1){v=v^90;}bytes[i]=v as u8;i=i+1;
    }
}
fn nb_run(kind:i32,reload:i32)i32 {
    if(kind<1 || kind>32 || reload<0 || reload>1 || (reload==1 && kind!=2)){return 2;}
    _zag_print("N03_BOUNDARY,");_zag_println(_zag_i64_to_str(kind as i64));
    let size:i32=16;
    if(kind==1){size=1;}if(kind==2){size=65536;}if(kind==3){size=0;}
    if(kind==4){size=65537;}if(kind==17){size=32;}if(kind==18){size=128;}
    let initial:[]u8="";let next:[]u8="";
    if(size>0){initial=nio_alloc(size);next=nio_alloc(size);}
    let dir:[]u8=nb_directory(kind);let fail:i32=0;
    if(initial.len!=size || next.len!=size || dir.len==0){nio_free(initial);nio_free(next);nio_free(dir);return 1;}
    nb_pattern(initial,0);nb_pattern(next,1);

    // Refuse out-of-envelope payloads before directory creation.
    if(kind==3 || kind==4){
        nb_check("invalid_size_refused",nj_init(dir,initial),-8002,&fail);
        let fd:i64=nio_open_root(dir);nb_check("invalid_size_no_directory",fd,-2,&fail);if(fd>=0){nio_close(fd);}
        nio_free(initial);nio_free(next);nio_free(dir);return nb_finish(kind,fail);
    }
    // Partial initialization is retained and cannot become an operational journal.
    if(kind==10 || kind==11){
        nb_check("partial_directory_create",nio_mkdir(dir),0,&fail);let root:i64=nio_open_root(dir);
        nb_check("partial_root_open",(root>=0) as i64,1,&fail);
        if(root>=0){
            if(kind==10){nb_check("partial_lock_only",nb_create(root,"writer.lock",""),0,&fail);}
            else{let record:[]u8=nj_root_record(initial);nb_check("partial_root_only",nb_create(root,"root.bin",record),0,&fail);nio_free(record);}
            nio_close(root);
        }
        let partial:NativeJournal=nj_recover(dir,initial);nb_failed_recovery(&partial,-8008,&fail);nj_close(&partial);
        nio_free(initial);nio_free(next);nio_free(dir);return nb_finish(kind,fail);
    }
    if(reload==0){nb_check("initialize",nj_init(dir,initial),0,&fail);}
    let j:NativeJournal=nj_recover(dir,initial);nb_check("baseline_recovery",j.status,0,&fail);
    if(j.status!=0 || fail!=0){nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);return 1;}

    if(kind==1 || kind==2){
        if(reload==0){
            nb_check("boundary_commit",nj_commit(&j,701,0,next,1,0),0,&fail);
            nb_check("boundary_live_bytes",nio_equal(j.state,next),1,&fail);
            let root_file:i64=nio_open_child(j.root,"root.bin",0);let event:i64=nj_open_index(j.root,"event-",1,0);
            nb_check("exact_root_file_size",nio_seek(root_file,0,2),64+size,&fail);
            nb_check("exact_event_file_size",nio_seek(event,0,2),160+size,&fail);
            if(root_file>=0){nio_close(root_file);}if(event>=0){nio_close(event);}
            nj_close(&j);j=nj_recover(dir,initial);
        }
        nb_check("boundary_reload_status",j.status,0,&fail);
        nb_check("boundary_reload_sequence",j.sequence,1,&fail);
        nb_check("boundary_reload_attempts",j.attempts,1,&fail);
        nb_check("boundary_complete_reload_bytes",nio_equal(j.state,next),1,&fail);
    }else if(kind==5){
        nj_close(&j);j=nj_recover_diagnostic(dir,initial,1);nb_failed_recovery(&j,-8008,&fail);
        nj_close(&j);j=nj_recover(dir,initial);nb_check("normal_recovery_after_injected_hash_error",j.status,0,&fail);
    }else if(kind==6){
        nj_close(&j);j=nj_recover(dir,next);nb_failed_recovery(&j,-8001,&fail);
    }else if(kind>=7 && kind<=9){
        let original:[]u8=nj_root_record(initial);let length:i32=original.len;
        if(kind==7){length=length-1;}if(kind==8){length=length+1;}
        let mutated:[]u8=nio_alloc(length);
        if(mutated.len!=length || original.len!=80){nb_check("root_fixture_allocated",0,1,&fail);}
        else{
            let count:i32=original.len;if(length<count){count=length;}
            nj_copy(original[0..count],mutated);
            if(kind==9){mutated[64]=mutated[64]^1;}
            nb_check("root_mutation_retains_preimage",nb_replace_retaining_preimage(j.root,"root.bin",mutated),0,&fail);
        }
        nio_free(original);nio_free(mutated);nj_close(&j);j=nj_recover(dir,initial);nb_failed_recovery(&j,-8001,&fail);
    }else if(kind==12){
        nb_check("second_initialization_refused",nj_init(dir,initial),-8008,&fail);
        nb_check("original_state_retained",nio_equal(j.state,initial),1,&fail);
        nb_check("no_attempt_from_reinit",j.attempts,0,&fail);
    }else if(kind>=13 && kind<=16){
        let name:[]u8="event-2.bin";let expected:i32=-8004;
        if(kind==14){name="attempt-2.bin";expected=-8005;}
        if(kind==15){name="event-33.bin";expected=-8005;}
        if(kind==16){name="attempt-65.bin";expected=-8005;}
        nb_check("gap_or_overflow_fixture",nb_create(j.root,name,""),0,&fail);
        nj_close(&j);j=nj_recover(dir,initial);nb_failed_recovery(&j,expected,&fail);
    }else if(kind==17 || kind==18){
        nb_check("state_alias_refused",nj_commit(&j,701,0,j.state,1,0),-8010,&fail);
        if(kind==17){nb_check("head_alias_refused",nj_commit(&j,701,0,j.head,1,0),-8010,&fail);}
        else{nb_check("transaction_alias_refused",nj_commit(&j,701,0,j.transactions,1,0),-8010,&fail);}
        nb_check("alias_no_attempt",j.attempts,0,&fail);nb_check("alias_state_unchanged",nio_equal(j.state,initial),1,&fail);
    }else if(kind==19){
        let saved:[]u8=nio_alloc(16);nj_copy(initial,saved);
        nb_check("partial_overlap_refused",nj_copy(initial[0..8],initial[1..9]),-1,&fail);
        nb_check("partial_overlap_no_mutation",nio_equal(initial,saved),1,&fail);
        nb_check("exact_inplace_copy_allowed",nj_copy(initial,initial),0,&fail);
        nb_check("disjoint_copy_allowed",nj_copy(initial,next),0,&fail);
        nb_check("disjoint_copy_bytes",nio_equal(next,initial),1,&fail);nio_free(saved);
    }else if(kind>=20 && kind<=22){
        nb_check("duplicate_baseline_commit",nj_commit(&j,701,0,next,1,0),0,&fail);
        let expected:i32=-8003;
        if(kind==21){
            // Deliberately close only this fixture's borrowed root fd. This probes
            // the actual failed-open branch, not a conflicting transaction.
            nb_check("inject_bad_root_fd",nio_close(j.root),0,&fail);expected=-8008;
        }else{
            let record:[]u8=nb_read(j.root,"event-1.bin",176);
            if(record.len!=176){nb_check("duplicate_fixture_read",0,1,&fail);}
            else{
                if(kind==20){record[160]=record[160]^1;nb_check("duplicate_payload_corrupt",nb_replace_retaining_preimage(j.root,"event-1.bin",record),0,&fail);}
                else{nb_check("duplicate_record_truncated",nb_replace_retaining_preimage(j.root,"event-1.bin",record[0..175]),0,&fail);expected=-8001;}
            }nio_free(record);
        }
        nb_check("duplicate_error_distinguished_from_conflict",nj_commit(&j,701,0,next,1,0),expected,&fail);
        nb_check("duplicate_failure_poisons_handle",j.status,expected,&fail);
        nb_check("duplicate_retry_requires_recovery",nj_commit(&j,702,1,initial,1,0),-8008,&fail);
    }else if(kind>=23 && kind<=31){
        nb_check("malformed_baseline_commit",nj_commit(&j,701,0,next,1,0),0,&fail);
        let old:[]u8=nb_read(j.root,"event-1.bin",176);let length:i32=176;
        if(kind==23){length=175;}if(kind==24){length=177;}
        let record:[]u8=nio_alloc(length);let expected:i32=-8001;
        if(old.len!=176 || record.len!=length){nb_check("malformed_fixture_allocated",0,1,&fail);}
        else{
            let count:i32=176;if(length<count){count=length;}nj_copy(old[0..count],record);
            if(kind==25){record[0]=record[0]^1;}
            if(kind==26){nj_put32(record,16,17);expected=-8004;}
            if(kind==27){nj_put32(record,20,0);}
            if(kind==28){nj_put32(record,28,1);expected=-8004;}
            if(kind==29){record[96]=record[96]^1;expected=-8003;}
            if(kind==30){nj_put32(record,12,0);expected=-8004;}
            if(kind==31){record[15]=128;expected=-8004;}
            if(kind>=25){nb_check("reseal_malformed_record",nj_record_digest(record,record[128..160]),0,&fail);}
            nb_check("malformed_mutation_retains_preimage",nb_replace_retaining_preimage(j.root,"event-1.bin",record),0,&fail);
        }
        nio_free(old);nio_free(record);nj_close(&j);j=nj_recover(dir,initial);nb_failed_recovery(&j,expected,&fail);
    }else if(kind==32){
        nb_check("duplicate_chain_first",nj_commit(&j,701,0,next,1,0),0,&fail);
        nb_check("duplicate_chain_second",nj_commit(&j,702,1,initial,1,0),0,&fail);
        let record:[]u8=nb_read(j.root,"event-2.bin",176);
        if(record.len!=176){nb_check("duplicate_chain_read",0,1,&fail);}
        else{
            nj_put32(record,12,701);nb_check("duplicate_chain_reseal",nj_record_digest(record,record[128..160]),0,&fail);
            nb_check("duplicate_chain_mutation",nb_replace_retaining_preimage(j.root,"event-2.bin",record),0,&fail);
        }
        nio_free(record);nj_close(&j);j=nj_recover(dir,initial);nb_failed_recovery(&j,-8007,&fail);
    }
    nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);return nb_finish(kind,fail);
}

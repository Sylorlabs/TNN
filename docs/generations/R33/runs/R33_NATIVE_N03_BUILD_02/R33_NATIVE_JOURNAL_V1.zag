// Native immutable-record publication and recoverable state snapshots.
// New candidate replacing historical Python C03 collector; not a learner.
// Uses frozen corrected native SHA256. No interpreter or subprocess commands.
@import("R33_NATIVE_SHA256_V2.zag")

struct NativeJournal {
    root:i64,
    lock:i64,
    status:i32,
    sequence:i32,
    attempts:i32,
    state:[]u8,
    head:[]u8,
    transactions:[]u8,
}

fn nj_get32(bytes:[]u8,at:i32)i32 {
    if(at<0 || bytes.len<4 || at>bytes.len-4){return -1;}
    let x:i64=(bytes[at] as i64)+(bytes[at+1] as i64)*256+
              (bytes[at+2] as i64)*65536+(bytes[at+3] as i64)*16777216;
    if(x>2147483647){return -1;}return x as i32;
}
fn nj_put32(bytes:[]u8,at:i32,value:i32)i32 {
    if(at<0 || bytes.len<4 || at>bytes.len-4 || value<0){return -1;}
    let v:i32=value;let i:i32=0;
    while(i<4){bytes[at+i]=(v%256) as u8;v=v/256;i=i+1;}return 0;
}
fn nj_overlap(a:[]u8,b:[]u8)i32 {
    if(a.len<1 || b.len<1){return 0;}
    let ap:i64=_zag_slice_ptr(a) as i64;let bp:i64=_zag_slice_ptr(b) as i64;
    if(ap<=bp){return ((bp-ap)<(a.len as i64)) as i32;}
    return ((ap-bp)<(b.len as i64)) as i32;
}
// Exact in-place identity is allowed; any partial overlap is refused before writes.
fn nj_copy(source:[]u8,target:[]u8)i32 {
    if(source.len<0 || target.len<source.len){return -1;}
    if(source.len==0 || _zag_slice_ptr(source)==_zag_slice_ptr(target)){return 0;}
    if(nj_overlap(source,target[0..source.len])==1){return -1;}let i:i32=0;
    while(i<source.len){target[i]=source[i];i=i+1;}return 0;
}
fn nj_name(prefix:[]u8,index:i32)[]u8 {
    let number:[]u8=_zag_i64_to_str(index as i64);
    let stem:[]u8=_zag_str_concat(prefix,number);let name:[]u8=_zag_str_concat(stem,".bin");
    nio_free(number);nio_free(stem);return name;
}
fn nj_open_index(root:i64,prefix:[]u8,index:i32,create:i32)i64 {
    let name:[]u8=nj_name(prefix,index);let fd:i64=nio_open_child(root,name,create);
    nio_free(name);return fd;
}
fn nj_root_record(initial:[]u8)[]u8 {
    if(initial.len<1 || initial.len>65536){return "";}
    let b:[]u8=nio_alloc(64+initial.len);if(b.len==0){return b;}
    nj_copy("TNNROOT2",b);nj_put32(b,8,2);nj_put32(b,12,initial.len);
    nj_put32(b,16,32);nj_put32(b,20,64); // fixed event/attempt envelope
    nj_copy(initial,b[64..b.len]);
    if(ns_sha256(initial,b[32..64])!=0){nio_free(b);return "";}return b;
}
fn nj_init(directory:[]u8,initial:[]u8)i32 {
    let record:[]u8=nj_root_record(initial);if(record.len==0){return -8002;}
    // Exclusive directory creation is the first filesystem effect. Existing
    // and partial attempts are never removed/reused by this constructor.
    let rc:i64=nio_mkdir(directory);if(rc!=0){nio_free(record);return -8008;}
    let root:i64=nio_open_root(directory);if(root<0){nio_free(record);return -8008;}
    let lock:i64=nio_open_child(root,"writer.lock",1);
    if(lock<0){nio_free(record);nio_close(root);return -8008;}
    let fd:i64=nio_open_child(root,"root.bin",1);
    let code:i32=0;
    if(fd<0){code=-8008;}else{
        if(nio_regular(fd)!=1 || nio_write_all(fd,record)!=record.len || nio_sync(fd)!=0){code=-8008;}
        nio_close(fd);
    }
    if(nio_sync(lock)!=0 || nio_sync(root)!=0){code=-8008;}
    nio_close(lock);nio_close(root);nio_free(record);return code;
}
fn nj_invalid()NativeJournal {
    return NativeJournal{.root=-1,.lock=-1,.status=-8008,.sequence=0,.attempts=0,
        .state="",.head="",.transactions=""};
}
fn nj_close(j:*NativeJournal)void {
    if(j.*.lock>=0){nio_close(j.*.lock);j.*.lock=-1;}
    if(j.*.root>=0){nio_close(j.*.root);j.*.root=-1;}
    nio_free(j.*.state);nio_free(j.*.head);nio_free(j.*.transactions);
    j.*.state="";j.*.head="";j.*.transactions="";
}
fn nj_record_digest(record:[]u8,out:[]u8)i32 {
    if(record.len<161 || record.len>65696 || out.len<32){return -8002;}
    let payload:i32=record.len-160;let b:[]u8=nio_alloc(128+payload);
    if(b.len==0){return -8008;}
    nj_copy(record[0..128],b);nj_copy(record[160..record.len],b[128..b.len]);
    let rc:i32=ns_sha256(b,out);nio_free(b);return rc;
}
fn nj_validate_record(record:[]u8,j:*NativeJournal)i32 {
    if(record.len!=160+j.*.state.len || nio_equal(record[0..8],"TNNTXN02")!=1){return -8001;}
    if(nj_get32(record,8)!=j.*.sequence+1 || nj_get32(record,12)<1 ||
       nj_get32(record,16)!=j.*.state.len || nj_get32(record,24)!=j.*.sequence ||
       nj_get32(record,28)!=0){return -8004;}
    let kind:i32=nj_get32(record,20);if(kind!=1 && kind!=2){return -8001;}
    if(nio_equal(record[32..64],j.*.head)!=1){return -8004;}
    let hash:[]u8=nio_alloc(32);if(hash.len!=32){return -8008;}
    let code:i32=0;
    if(ns_sha256(j.*.state,hash)!=0 || nio_equal(hash,record[64..96])!=1){code=-8004;}
    if(code==0 && (ns_sha256(record[160..record.len],hash)!=0 || nio_equal(hash,record[96..128])!=1)){code=-8003;}
    if(code==0 && (nj_record_digest(record,hash)!=0 || nio_equal(hash,record[128..160])!=1)){code=-8003;}
    nio_free(hash);return code;
}
// The normal entrypoint cannot activate diagnostic fault injection.
fn nj_recover(directory:[]u8,initial:[]u8)NativeJournal {
    return nj_recover_diagnostic(directory,initial,0);
}
// Engineering-only fail-closed seam. fault=1 simulates a root-head hash failure;
// it never supplies a successful hash or bypasses an integrity check.
fn nj_recover_diagnostic(directory:[]u8,initial:[]u8,fault:i32)NativeJournal {
    let j:NativeJournal=nj_invalid();let expected:[]u8=nj_root_record(initial);
    if(fault<0 || fault>1){nio_free(expected);j.status=-8002;return j;}
    if(expected.len==0){j.status=-8002;return j;}
    j.root=nio_open_root(directory);if(j.root<0){nio_free(expected);return j;}
    j.lock=nio_open_child(j.root,"writer.lock",0);
    if(j.lock<0 || nio_regular(j.lock)!=1){nio_free(expected);nj_close(&j);return j;}
    if(nio_lock(j.lock)!=0){nio_free(expected);nj_close(&j);j.status=-8009;return j;}
    let fd:i64=nio_open_child(j.root,"root.bin",0);let stored:[]u8=nio_alloc(expected.len);
    if(fd<0 || stored.len!=expected.len){if(fd>=0){nio_close(fd);}nio_free(stored);nio_free(expected);nj_close(&j);return j;}
    let read:i64=nio_read_exact(fd,stored,expected.len);nio_close(fd);
    if(read!=expected.len || nio_equal(stored,expected)!=1){nio_free(stored);nio_free(expected);nj_close(&j);j.status=-8001;return j;}
    j.state=nio_alloc(initial.len);j.head=nio_alloc(32);j.transactions=nio_alloc(32*4);
    if(j.state.len!=initial.len || j.head.len!=32 || j.transactions.len!=128){nio_free(stored);nio_free(expected);nj_close(&j);return j;}
    nj_copy(initial,j.state);
    let head_status:i32=-8008;
    if(fault==0){head_status=ns_sha256(expected,j.head);}
    nio_free(stored);nio_free(expected);
    if(head_status!=0){nj_close(&j);j.status=-8008;return j;}
    let record:[]u8=nio_alloc(160+initial.len);if(record.len==0){nj_close(&j);return j;}
    j.status=0;let index:i32=1;let gap:i32=0;
    while(index<=33 && j.status==0){
        let ev:i64=nj_open_index(j.root,"event-",index,0);
        if(ev==-2){gap=1;}else{
            if(ev<0){j.status=-8008;}else{
                if(index>32){j.status=-8005;}
                else{if(gap==1){j.status=-8004;}
                    else{if(nio_read_exact(ev,record,record.len)!=record.len){j.status=-8001;}
                        else{j.status=nj_validate_record(record,&j);}
                    }
                }
                nio_close(ev);
                if(j.status==0){
                    let tx:i32=nj_get32(record,12);let old:i32=0;
                    while(old<j.sequence){if(nj_get32(j.transactions,old*4)==tx){j.status=-8007;}old=old+1;}
                    if(j.status==0){
                        nj_put32(j.transactions,j.sequence*4,tx);
                        nj_copy(record[160..record.len],j.state);nj_copy(record[128..160],j.head);j.sequence=j.sequence+1;
                    }
                }
            }
        }
        index=index+1;
    }
    // Attempts are persistent reservations, including unpublished/partial data.
    // Their count never rewinds with a restored state. It is NOT CPU accounting.
    index=1;gap=0;
    while(index<=65 && j.status==0){
        let at:i64=nj_open_index(j.root,"attempt-",index,0);
        if(at==-2){gap=1;}else{
            if(at<0){j.status=-8008;}else{
                if(gap==1 || index>64){j.status=-8005;}
                else{let len:i64=nio_seek(at,0,2);
                    if(nio_regular(at)!=1 || len<0 || len>record.len){j.status=-8001;}else{j.attempts=j.attempts+1;}
                }nio_close(at);
            }
        }index=index+1;
    }
    if(j.status==0 && j.attempts<j.sequence){j.status=-8004;}
    nio_free(record);
    if(j.status!=0){let code:i32=j.status;nj_close(&j);j.status=code;}return j;
}
fn nj_commit(j:*NativeJournal,transaction:i32,parent:i32,next:[]u8,kind:i32,crash:i32)i32 {
    if(j.*.status!=0 || j.*.root<0 || j.*.lock<0){return -8008;}
    if(transaction<1 || next.len!=j.*.state.len || (kind!=1 && kind!=2) || crash<0 || crash>6){return -8002;}
    // Caller inputs may not alias mutable internal state, head or transaction storage.
    if(nj_overlap(next,j.*.state)==1 || nj_overlap(next,j.*.head)==1 ||
       nj_overlap(next,j.*.transactions)==1){return -8010;}
    let i:i32=0;
    while(i<j.*.sequence){
        if(nj_get32(j.*.transactions,i*4)==transaction){
            let old:[]u8=nio_alloc(160+next.len);if(old.len==0){return -8008;}
            let fd:i64=nj_open_index(j.*.root,"event-",i+1,0);let code:i32=-8008;
            if(fd>=0){
                if(nio_read_exact(fd,old,old.len)!=old.len){code=-8001;}
                else{code=nj_duplicate_status(old,i+1,transaction,parent,next,kind);}
                nio_close(fd);
            }
            nio_free(old);
            if(code<0 && code!=-8007){j.*.status=code;}
            return code;
        }i=i+1;
    }
    if(parent!=j.*.sequence){return -8006;}
    if(j.*.sequence>=32 || j.*.attempts>=64){return -8005;}
    let record:[]u8=nio_alloc(160+next.len);if(record.len==0){return -8008;}
    nj_copy("TNNTXN02",record);nj_put32(record,8,j.*.sequence+1);nj_put32(record,12,transaction);
    nj_put32(record,16,next.len);nj_put32(record,20,kind);nj_put32(record,24,parent);
    nj_copy(j.*.head,record[32..64]);nj_copy(next,record[160..record.len]);
    if(ns_sha256(j.*.state,record[64..96])!=0 || ns_sha256(next,record[96..128])!=0 ||
       nj_record_digest(record,record[128..160])!=0){nio_free(record);return -8008;}
    let attempt:i32=j.*.attempts+1;let fd:i64=nj_open_index(j.*.root,"attempt-",attempt,1);
    if(fd<0){nio_free(record);return -8008;}
    j.*.attempts=attempt;
    // Preserve reservation before every deliberate crash. Failures after this
    // boundary poison the live handle: close/recover before another operation.
    if(nio_regular(fd)!=1 || nio_sync(j.*.root)!=0){nio_close(fd);nio_free(record);j.*.status=-8008;return -8008;}
    if(crash==1){_zag_println("N03_CRASH_BOUNDARY,1");_zag_exit(73);}
    if(crash==2 || crash==6){
        let half:i32=record.len/2;
        let wrote:i64=nio_write_all(fd,record[0..half]);
        let synced:i64=nio_sync(fd);nio_close(fd);nio_free(record);
        if(wrote!=half || synced!=0){j.*.status=-8008;return -8008;}
        if(crash==2){_zag_println("N03_CRASH_BOUNDARY,2");_zag_exit(73);}
        // Distinguish a successfully reached partial-abandonment seam from real I/O failure.
        j.*.status=-8008;return -8011;
    }
    if(nio_write_all(fd,record)!=record.len || nio_sync(fd)!=0){nio_close(fd);nio_free(record);j.*.status=-8008;return -8008;}
    nio_close(fd);if(crash==3){_zag_println("N03_CRASH_BOUNDARY,3");_zag_exit(73);}
    let from:[]u8=nj_name("attempt-",attempt);let to:[]u8=nj_name("event-",j.*.sequence+1);
    let linked:i64=nio_link(j.*.root,from,to);nio_free(from);nio_free(to);
    if(linked!=0){nio_free(record);j.*.status=-8008;return -8008;}
    if(crash==4){_zag_println("N03_CRASH_BOUNDARY,4");_zag_exit(73);}
    if(nio_sync(j.*.root)!=0){nio_free(record);j.*.status=-8008;return -8008;}
    if(crash==5){_zag_println("N03_CRASH_BOUNDARY,5");_zag_exit(73);}
    // Commit publication precedes the live-state change. Fresh recovery after
    // death at either boundary yields the exact committed snapshot.
    nj_copy(record[160..record.len],j.*.state);nj_copy(record[128..160],j.*.head);
    nj_put32(j.*.transactions,j.*.sequence*4,transaction);j.*.sequence=j.*.sequence+1;
    nio_free(record);return 0;
}

// Validate a retained duplicate before deciding idempotency versus conflict.
// This checks record integrity, not protection against an actor who reseals the whole tree.
fn nj_duplicate_status(old:[]u8,sequence:i32,transaction:i32,parent:i32,next:[]u8,kind:i32)i32 {
    if(old.len!=160+next.len || nio_equal(old[0..8],"TNNTXN02")!=1){return -8001;}
    if(nj_get32(old,8)!=sequence || nj_get32(old,12)!=transaction ||
       nj_get32(old,16)!=next.len || nj_get32(old,24)!=sequence-1 ||
       nj_get32(old,28)!=0){return -8004;}
    let recorded_kind:i32=nj_get32(old,20);
    if(recorded_kind!=1 && recorded_kind!=2){return -8001;}
    let hash:[]u8=nio_alloc(32);if(hash.len!=32){return -8008;}
    let code:i32=0;
    if(ns_sha256(old[160..old.len],hash)!=0){code=-8008;}
    else{if(nio_equal(hash,old[96..128])!=1){code=-8003;}}
    if(code==0){
        if(nj_record_digest(old,hash)!=0){code=-8008;}
        else{if(nio_equal(hash,old[128..160])!=1){code=-8003;}}
    }
    nio_free(hash);if(code!=0){return code;}
    if(nj_get32(old,24)!=parent || recorded_kind!=kind || nio_equal(old[160..old.len],next)!=1){return -8007;}
    return 1;
}

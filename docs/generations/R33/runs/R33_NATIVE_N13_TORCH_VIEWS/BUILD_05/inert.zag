// Native inert pickle-protocol2..5 descriptor scanner, never an unpickler.
// Globals/reductions/NEWOBJ/BUILD are data records: no imports, lookup, calls,
// Python runtime, tensor construction or user-defined methods can execute here.
// Memo references preserve serialized identity; implicit Python interning and
// reducer/container behavior are deliberately not reconstructed or certified.
@import("R33_NATIVE_SHA256_V2.zag")

struct ParentMap {
    status:i32,pos:i32,frame_end:i32,protocol:i32,root:i32,
    node_count:i32,edge_count:i32,memo_count:i32,memo_extent:i32,
    sp:i32,mp:i32,op_count:i32,newobjs:i32,reductions:i32,builds:i32,
    aliases:i32,external:i32,global_count:i32,failed_opcode:i32,
    input:[]u8,nodes:[]i64,edges:[]i64,memo:[]i64,stack:[]i64,marks:[]i64,globals:[]i64,hist:[]i64,
}
fn pm_words(n:i32)[]i64 {
    let p:*i64=null as *i64;if(n<1 || n>8388608){return p[0..0];}
    p=_zag_malloc((n as i64)*8) as *i64;if(p==null as *i64){return p[0..0];}
    let b:[]i64=p[0..n];let i:i32=0;while(i<n){b[i]=0;i=i+1;}return b;
}
fn pm_free_words(b:[]i64)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn pm_empty()ParentMap {
    let p:*i64=null as *i64;return ParentMap{.status=-8807,.pos=0,.frame_end=-1,.protocol=0,.root=0,
        .node_count=0,.edge_count=0,.memo_count=0,.memo_extent=0,.sp=0,.mp=0,.op_count=0,
        .newobjs=0,.reductions=0,.builds=0,.aliases=0,.external=0,.global_count=0,.failed_opcode=0,
        .input="",.nodes=p[0..0],.edges=p[0..0],.memo=p[0..0],.stack=p[0..0],.marks=p[0..0],.globals=p[0..0],.hist=p[0..0]};
}
fn pm_close(p:*ParentMap)void {
    pm_free_words(p.*.nodes);pm_free_words(p.*.edges);pm_free_words(p.*.memo);pm_free_words(p.*.stack);
    pm_free_words(p.*.marks);pm_free_words(p.*.globals);pm_free_words(p.*.hist);p.*=pm_empty();
}
fn pm_init(input:[]u8,nodes:i32,edges:i32,memo:i32,stack:i32)ParentMap {
    let p:ParentMap=pm_empty();if(input.len<3 || input.len>16777216 || nodes<1 || nodes>524288 ||
        edges<1 || edges>1048576 || memo<1 || memo>262144 || stack<1 || stack>131072){p.status=-8801;return p;}
    p.input=input;p.nodes=pm_words(nodes*10);p.edges=pm_words(edges*4);p.memo=pm_words(memo);
    p.stack=pm_words(stack);p.marks=pm_words(stack);p.globals=pm_words(1024);p.hist=pm_words(256);
    if(p.nodes.len!=nodes*10 || p.edges.len!=edges*4 || p.memo.len!=memo || p.stack.len!=stack ||
       p.marks.len!=stack || p.globals.len!=1024 || p.hist.len!=256){pm_close(&p);return p;}
    p.status=0;return p;
}
fn pm_fail(p:*ParentMap,code:i32)i32 {if(p.*.status==0){p.*.status=code;}p.*.root=0;return 0;}
fn pm_take(p:*ParentMap,n:i32)i32 {
    if(p.*.status!=0){return -1;}
    if(n<0 || p.*.pos<0 || p.*.pos>p.*.input.len || n>p.*.input.len-p.*.pos ||
       (p.*.frame_end>=0 && n>p.*.frame_end-p.*.pos)){pm_fail(p,-8802);return -1;}
    let at:i32=p.*.pos;p.*.pos=p.*.pos+n;return at;
}
fn pm_u(p:*ParentMap,n:i32)i64 {
    if(n<1 || n>8){pm_fail(p,-8802);return -1;}let at:i32=pm_take(p,n);if(at<0){return -1;}
    if(n==8 && p.*.input[at+7]>=128){pm_fail(p,-8802);return -1;}
    let v:i64=0;let i:i32=n-1;while(i>=0){v=v*256+(p.*.input[at+i] as i64);i=i-1;}return v;
}
fn pm_line(p:*ParentMap)i32 {
    let begin:i32=p.*.pos;let n:i32=0;
    while(p.*.status==0 && n<=4096){let at:i32=pm_take(p,1);if(at<0){return -1;}
        if(p.*.input[at]==10){return p.*.pos-begin-1;}n=n+1;}
    pm_fail(p,-8802);return -1;
}
fn pm_valid_id(p:*ParentMap,id:i32)i32 {return (id>0 && id<=p.*.node_count) as i32;}
fn pm_kind(p:*ParentMap,id:i32)i32 {if(pm_valid_id(p,id)!=1){return 0;}return p.*.nodes[(id-1)*10] as i32;}
fn pm_new(p:*ParentMap,kind:i32,start:i32,at:i32,n:i32,a:i64,b:i64,c:i64)i32 {
    if(p.*.status!=0){return 0;}if(p.*.node_count>=p.*.nodes.len/10){return pm_fail(p,-8805);}
    let id:i32=p.*.node_count+1;let row:i32=(id-1)*10;
    p.*.nodes[row]=kind;p.*.nodes[row+1]=start;p.*.nodes[row+2]=at;p.*.nodes[row+3]=n;
    p.*.nodes[row+4]=a;p.*.nodes[row+5]=b;p.*.nodes[row+6]=c;p.*.node_count=id;return id;
}
fn pm_push(p:*ParentMap,id:i32)i32 {
    if(p.*.status!=0){return 0;}if(p.*.sp>=p.*.stack.len){return pm_fail(p,-8805);}
    if(id<0 || id>p.*.node_count){return pm_fail(p,-8803);}p.*.stack[p.*.sp]=id;p.*.sp=p.*.sp+1;return id;
}
fn pm_top(p:*ParentMap,depth:i32)i32 {
    if(p.*.status!=0){return 0;}if(depth<0 || p.*.sp<=depth){return pm_fail(p,-8803);}
    let id:i32=p.*.stack[p.*.sp-1-depth] as i32;if(pm_valid_id(p,id)!=1){return pm_fail(p,-8803);}return id;
}
fn pm_pop(p:*ParentMap)i32 {let id:i32=pm_top(p,0);if(p.*.status==0){p.*.sp=p.*.sp-1;}return id;}
fn pm_edge(p:*ParentMap,owner:i32,a:i32,b:i32,op:i32)i32 {
    if(p.*.status!=0){return 0;}
    if(pm_valid_id(p,owner)!=1 || pm_valid_id(p,a)!=1 || b<0 || b>p.*.node_count){return pm_fail(p,-8803);}
    if(p.*.edge_count>=p.*.edges.len/4){return pm_fail(p,-8805);}
    let id:i32=p.*.edge_count+1;let row:i32=(id-1)*4;let nr:i32=(owner-1)*10;
    p.*.edges[row]=a;p.*.edges[row+1]=b;p.*.edges[row+3]=op;
    let last:i32=p.*.nodes[nr+8] as i32;if(last>0){p.*.edges[(last-1)*4+2]=id;}else{p.*.nodes[nr+7]=id;}
    p.*.nodes[nr+8]=id;p.*.nodes[nr+9]=p.*.nodes[nr+9]+1;p.*.edge_count=id;return id;
}
fn pm_raw(p:*ParentMap,id:i32)[]u8 {
    if(pm_valid_id(p,id)!=1){return "";}let row:i32=(id-1)*10;let at:i32=p.*.nodes[row+2] as i32;let n:i32=p.*.nodes[row+3] as i32;
    if(at<0 || n<0 || at>p.*.input.len || n>p.*.input.len-at){return "";}return p.*.input[at..at+n];
}
fn pm_global_same(p:*ParentMap,a:i32,b:i32)i32 {
    if(pm_kind(p,a)!=14 || pm_kind(p,b)!=14){return 0;}let ar:i32=(a-1)*10;let br:i32=(b-1)*10;
    return (nio_equal(pm_raw(p,p.*.nodes[ar+4] as i32),pm_raw(p,p.*.nodes[br+4] as i32))==1 &&
        nio_equal(pm_raw(p,p.*.nodes[ar+5] as i32),pm_raw(p,p.*.nodes[br+5] as i32))==1) as i32;
}
fn pm_global(p:*ParentMap,start:i32,module:i32,name:i32)i32 {
    if(pm_kind(p,module)!=6 || pm_kind(p,name)!=6){return pm_fail(p,-8803);}
    let id:i32=pm_new(p,14,start,0,0,module,name,0);let i:i32=0;let seen:i32=0;
    while(i<p.*.global_count){if(pm_global_same(p,id,p.*.globals[i] as i32)==1){seen=1;}i=i+1;}
    if(seen==0){if(p.*.global_count>=p.*.globals.len){return pm_fail(p,-8805);}p.*.globals[p.*.global_count]=id;p.*.global_count=p.*.global_count+1;}
    return id;
}
fn pm_memo_put(p:*ParentMap,index:i64)void {
    let id:i32=pm_top(p,0);if(p.*.status!=0){return;}
    if(index<0 || index>=p.*.memo.len){pm_fail(p,-8805);return;}
    if(p.*.memo[index as i32]!=0){pm_fail(p,-8804);return;}
    p.*.memo[index as i32]=id;p.*.memo_count=p.*.memo_count+1;
    if(index>=p.*.memo_extent){p.*.memo_extent=(index as i32)+1;}
}
fn pm_memo_get(p:*ParentMap,index:i64)void {
    if(index<0 || index>=p.*.memo.len || p.*.memo[index as i32]==0){pm_fail(p,-8804);return;}
    pm_push(p,p.*.memo[index as i32] as i32);p.*.aliases=p.*.aliases+1;

@import("evaluator.zag")

fn p13_record_check(raw:[]u8,framing:i32,status:i32,s:*P13Stats,w:*TsWork)void {
    p13_check(s,"record_framing_exact",ts_prefix(raw,0),framing);
    let p:ParentMap=ts_record(raw,0,w);p13_check(s,"record_stage_status",p.status,status);
    if(status!=0){p13_check(s,"record_failure_no_owned_nodes",p.nodes.len,0);p13_check(s,"record_failure_no_root",p.root,0);}
    pm_close(&p);
}
fn p13_record_hex(hex:[]u8,framing:i32,status:i32,s:*P13Stats,w:*TsWork)void {
    let raw:[]u8=p13_hex(hex);p13_case(s,"record",s.*.cases);p13_record_check(raw,framing,status,s,w);nio_free(raw);
}
fn p13_framing(s:*P13Stats,w:*TsWork)void {
    p13_record_hex("800255012e2e",6,0,s,w); // STOP byte in SHORT_BINSTRING operand.
    p13_record_hex("800258010000002e2e",9,0,s,w); // STOP byte in BINUNICODE operand.
    p13_record_hex("80028a012e2e",6,0,s,w); // STOP byte in LONG1 operand.
    p13_record_hex("8002636d2e780a6e2e790a2e",12,0,s,w); // STOP in both GLOBAL lines.
    p13_record_hex("80034e2e",-9101,-9101,s,w);
    p13_record_hex("80024e29522e",-9101,-9101,s,w);
    p13_record_hex("80024e29812e",-9101,-9101,s,w);
    p13_record_hex("80024e4e622e",-9101,-9101,s,w);
    p13_record_hex("8002ff2e",-9101,-9101,s,w);
    p13_record_hex("80024e4e2e",5,-9101,s,w);
    p13_record_hex("800268002e",5,-9101,s,w);
    p13_record_hex("80024e710071002e",8,-9101,s,w);
    p13_record_hex("80024e72800000002e",9,-9110,s,w);
    p13_record_hex("80024de903717f2e",8,0,s,w);
    p13_record_hex("80024de90371802e",8,-9110,s,w);
    p13_record_hex("8002284b012e",6,-9101,s,w);
    // Framing accepts a length-delimited opcode whose protocol is subsequently
    // refused by the immutable scanner; lexical success is not semantic success.
    p13_record_hex("800243012e2e",6,-9101,s,w);
    let full:[]u8=p13_hex("800258010000002e2e");let cut:i32=0;
    while(cut<full.len && s.*.failed==0){p13_case(s,"record-truncation",cut);p13_record_check(full[0..cut],-9101,-9101,s,w);cut=cut+1;}nio_free(full);
    p13_record_hex("800258ffffffff2e",-9101,-9101,s,w);
    let mode:i32=0;while(mode<5 && s.*.failed==0){let f:F13=f13_new();f13_hex(&f,"8002");let i:i32=0;
        if(mode==0){while(i<65){f13_byte(&f,78);i=i+1;}}
        if(mode==1){f13_byte(&f,93);while(i<128){f13_hex(&f,"4e61");i=i+1;}}
        if(mode==2){f13_hex(&f,"5d4e710161");while(i<256){f13_hex(&f,"680161");i=i+1;}}
        if(mode==3){while(i<1024){f13_byte(&f,78);i=i+1;}}
        if(mode==4){f13_byte(&f,88);f13_u(&f,4100,4);while(i<4100){f13_byte(&f,65);i=i+1;}}
        f13_byte(&f,46);let raw:[]u8=f13_finish(&f);p13_case(s,"record-capacity",mode);
        let framing:i32=raw.len;if(mode>=3){framing=-9110;}p13_record_check(raw,framing,-9110,s,w);nio_free(raw);mode=mode+1;
    }
    let f:F13=f13_new();f13_hex(&f,"800263");let i:i32=0;while(i<256){f13_byte(&f,65);i=i+1;}
    f13_hex(&f,"0a780a2e");let raw:[]u8=f13_finish(&f);p13_case(s,"global-line-capacity",0);
    p13_record_check(raw,-9110,-9110,s,w);nio_free(raw);
}
fn p13_blob_refusals(s:*P13Stats,w:*TsWork)void {
    let payload:[]u8=p13_hex("0000000000000080");let mode:i32=1;
    while(mode<=26 && s.*.failed==0){p13_case(s,"storage-refusal",mode);let blob:[]u8=f13_blob("FloatStorage",2,payload,mode);
        p13_check(s,"negative_blob_built",(blob.len>0) as i32,1);let expected:i32=-9102;
        if(mode==6 || mode==10 || mode==11 || mode==12){expected=-9103;}
        if(mode==13 || mode==16 || mode==17 || mode==23 || mode==26){expected=-9101;}
        let h:TsHeader=ts_decode(blob,w);p13_check(s,"storage_stage_refusal",h.status,expected);
        p13_check(s,"failed_header_no_payload",h.bytes+h.at+h.key_len,0);
        let shape:[]i64=pm_words(1);shape[0]=2;let stride:[]i64=pm_words(1);stride[0]=1;
        let raw:[]u8=f13_outer(blob,shape,stride,0,0,1,0);let p:ParentMap=p13_parse(raw,s);
        if(p.status==0){let v:TsView=ts_open(&p,p.root,w);p13_empty_view(&v,expected,s);ts_close(&v);}
        pm_close(&p);nio_free(raw);nio_free(blob);pm_free_words(shape);pm_free_words(stride);mode=mode+1;
    }
    nio_free(payload);
    let types:i32=0;while(types<2 && s.*.failed==0){let name:[]u8="HalfStorage";if(types==1){name="ComplexFloatStorage";}
        p13_case(s,"unsupported-storage-type",types);let blob:[]u8=f13_blob(name,0,"",0);let h:TsHeader=ts_decode(blob,w);
        p13_check(s,"unsupported_type_exact",h.status,-9102);nio_free(blob);types=types+1;}
}
fn p13_bad_view(shape:[]i64,strides:[]i64,offset:i64,category:i32,variant:i32,code:i32,s:*P13Stats,w:*TsWork)void {
    p13_case(s,"view-refusal",s.*.cases);let payload:[]u8=p13_hex("0000000000000080");let blob:[]u8=f13_blob("FloatStorage",2,payload,0);
    let raw:[]u8=f13_outer(blob,shape,strides,offset,0,category,variant);let p:ParentMap=p13_parse(raw,s);
    if(p.status==0){let before:[]u8=p13_fingerprint(&p,w);let v:TsView=ts_open(&p,p.root,w);p13_empty_view(&v,code,s);
        ts_close(&v);p13_unchanged(&p,before,s,w);nio_free(before);}
    pm_close(&p);nio_free(raw);nio_free(blob);nio_free(payload);
}
fn p13_view_refusals(s:*P13Stats,w:*TsWork)void {
    let shape:[]i64=pm_words(9);let stride:[]i64=pm_words(9);shape[0]=2;stride[0]=1;
    let variant:i32=32;while(variant<=42 && s.*.failed==0){if(variant!=36){let category:i32=2;if(variant>=39){category=3;}
        p13_bad_view(shape[0..1],stride[0..1],0,category,variant,-9101,s,w);}variant=variant+1;}
    variant=43;while(variant<=59 && s.*.failed==0){let category:i32=2;
        if((variant>=53 && variant<=55) || variant==57 || variant==58 || variant==59){category=3;}
        p13_bad_view(shape[0..1],stride[0..1],0,category,variant,-9101,s,w);variant=variant+1;}
    p13_bad_view(shape[0..1],stride[0..1],-1,2,0,-9104,s,w);
    p13_bad_view(shape[0..1],stride[0..1],16777217,2,0,-9104,s,w);
    p13_bad_view(shape[0..1],stride[0..1],9223372036854775807,2,0,-9104,s,w);
    p13_bad_view(shape[0..1],stride[0..1],1,2,0,-9104,s,w);
    shape[0]=-1;p13_bad_view(shape[0..1],stride[0..1],0,2,0,-9104,s,w);
    shape[0]=16777217;p13_bad_view(shape[0..1],stride[0..1],0,2,0,-9104,s,w);
    shape[0]=2;stride[0]=-1;p13_bad_view(shape[0..1],stride[0..1],0,2,0,-9104,s,w);
    stride[0]=16777217;p13_bad_view(shape[0..1],stride[0..1],0,2,0,-9104,s,w);
    stride[0]=2;p13_bad_view(shape[0..1],stride[0..1],0,2,0,-9104,s,w);
    stride[0]=1;p13_bad_view(shape[0..1],stride[0..0],0,2,0,-9104,s,w);
    let i:i32=0;while(i<9){shape[i]=1;stride[i]=0;i=i+1;}
    p13_bad_view(shape,stride,0,2,0,-9104,s,w);
    shape[0]=4097;shape[1]=4096;p13_bad_view(shape[0..2],stride[0..2],0,2,0,-9104,s,w);
    shape[0]=0;shape[1]=16777217;p13_bad_view(shape[0..2],stride[0..2],0,2,0,-9104,s,w);
    shape[1]=1;stride[1]=16777217;p13_bad_view(shape[0..2],stride[0..2],0,2,0,-9104,s,w);
    stride[1]=0;p13_bad_view(shape[0..2],stride[0..2],3,2,0,-9104,s,w);
    // Rank zero has one element, so a one-past storage offset is refused.
    p13_bad_view(shape[0..0],stride[0..0],2,2,0,-9104,s,w);
    pm_free_words(shape);pm_free_words(stride);
}
fn p13_budget_controls(s:*P13Stats,w:*TsWork)void {
    let shape:[]i64=pm_words(1);shape[0]=1;let stride:[]i64=pm_words(1);stride[0]=1;
    let payload:[]u8=p13_hex("01020304");let blob:[]u8=f13_blob("ByteStorage",4,payload,0);
    let raw:[]u8=f13_outer(blob,shape,stride,0,0,2,0);let p:ParentMap=p13_parse(raw,s);
    if(p.status==0){let before:[]u8=p13_fingerprint(&p,w);let mode:i32=0;
        while(mode<4 && s.*.failed==0){p13_case(s,"open-work-budget",mode);let limited:TsWork=ts_work();
            if(mode==0){limited.max_opens=0;}if(mode==1){limited.max_records=2;}
            if(mode==2){limited.max_shape_allocs=0;}if(mode==3){limited.max_shape_allocs=1;}
            let v:TsView=ts_open(&p,p.root,&limited);p13_empty_view(&v,-9111,s);
            if(mode==1){p13_check(s,"header_attempts_charged",limited.records,2);}
            if(mode==3){p13_check(s,"partial_shape_allocation_charged",limited.shape_allocs,1);}
            ts_close(&v);mode=mode+1;
        }
        let v:TsView=ts_open(&p,p.root,w);p13_check(s,"budget_control_valid_view",v.status,0);
        if(v.status==0){let coordinates:[]i64=pm_words(1);mode=0;
            while(mode<5 && s.*.failed==0){p13_case(s,"public-work-budget",mode);let limited:TsWork=ts_work();
                if(mode==0){limited.max_probes=0;}if(mode==1){limited.max_records=0;}
                if(mode==2){limited.max_shape_allocs=1;}if(mode<3){let bits:NvBits=ts_bits(&p,&v,coordinates,&limited);
                    p13_check(s,"access_keeps_resource_cause",bits.status,-9111);p13_check(s,"no_refused_scalar_bits",bits.low+bits.high,0);
                }else{if(mode==3){limited.max_rows=0;}else{limited.max_hash_bytes=0;}
                    let row:NvRow=ts_row(&p,&v,&limited);p13_check(s,"row_keeps_resource_cause",row.status,-9111);
                    p13_check(s,"budget_refusal_no_row",row.data.len,0);nio_free(row.data);}
                mode=mode+1;
            }
            p13_case(s,"wrong-live-map",0);let other:ParentMap=p13_parse(raw,s);
            p13_check(s,"wrong_live_map_refused",ts_bound(&other,&v,w),-9108);pm_close(&other);
            p13_case(s,"mutated-view-handle",0);v.offset=1;p13_check(s,"changed_offset_refused",ts_bound(&p,&v,w),-9108);v.offset=0;
            v.dims[0]=2;p13_check(s,"changed_shape_refused",ts_bound(&p,&v,w),-9108);v.dims[0]=1;
            v.strides[7]=1;p13_check(s,"unused_stride_refused",ts_bound(&p,&v,w),-9108);v.strides[7]=0;
            p13_check(s,"restored_owned_handle_valid",ts_bound(&p,&v,w),0);
            p13_case(s,"closed-view",0);ts_close(&v);p13_check(s,"actual_closed_handle_refused",ts_bound(&p,&v,w),-9108);
            let bits:NvBits=ts_bits(&p,&v,coordinates,w);p13_check(s,"closed_read_exact",bits.status,-9108);p13_check(s,"closed_read_no_bits",bits.low+bits.high,0);
            let row:NvRow=ts_row(&p,&v,w);p13_check(s,"closed_row_exact",row.status,-9108);p13_check(s,"closed_row_empty",row.data.len,0);nio_free(row.data);
            pm_free_words(coordinates);
        }else{ts_close(&v);}
        p13_unchanged(&p,before,s,w);nio_free(before);
    }
    pm_close(&p);nio_free(raw);nio_free(blob);nio_free(payload);pm_free_words(shape);pm_free_words(stride);
}
fn p13_refusals(s:*P13Stats,w:*TsWork)void {
    p13_framing(s,w);if(s.*.failed==0){p13_blob_refusals(s,w);}
    if(s.*.failed==0){p13_view_refusals(s,w);}if(s.*.failed==0){p13_budget_controls(s,w);}
    if(s.*.failed==0){p13_unit_budget_controls(s,w);}
}
fn p13_unit_budget_controls(s:*P13Stats,w:*TsWork)void {
    p13_case(s,"unit-charge-boundaries",0);let used:i64=0;p13_check(s,"one_charge_allowed",ts_charge(&used,1,1),0);
    p13_check(s,"one_charge_recorded",used,1);p13_check(s,"second_charge_refused",ts_charge(&used,1,1),-9111);
    p13_check(s,"refusal_preserves_counter",used,1);used=0;p13_check(s,"negative_charge_refused",ts_charge(&used,1,-1),-9111);
    p13_check(s,"excessive_limit_refused",ts_charge(&used,1073741825,1),-9111);
    let raw:[]u8=p13_hex("80024e2e");let limited:TsWork=ts_work();limited.max_records=1;
    let p:ParentMap=ts_record(raw,0,&limited);p13_check(s,"one_header_budget_success",p.status,0);pm_close(&p);
    p=ts_record(raw,0,&limited);p13_check(s,"second_header_same_budget_refused",p.status,-9111);pm_close(&p);nio_free(raw);
    let shape:[]i64=pm_words(1);shape[0]=1;let stride:[]i64=pm_words(1);stride[0]=1;
    let payload:[]u8=p13_hex("00000000");let blob:[]u8=f13_blob("FloatStorage",1,payload,0);
    raw=f13_outer(blob,shape,stride,0,0,2,0);p=p13_parse(raw,s);
    if(p.status==0){let before:[]u8=p13_fingerprint(&p,w);limited=ts_work();limited.max_opens=1;
        let v:TsView=ts_open(&p,p.root,&limited);p13_check(s,"one_open_budget_success",v.status,0);
        let second:TsView=ts_open(&p,p.root,&limited);p13_empty_view(&second,-9111,s);ts_close(&second);
        if(v.status==0){let coordinates:[]i64=pm_words(1);limited=ts_work();limited.max_probes=1;
            let bits:NvBits=ts_bits(&p,&v,coordinates,&limited);p13_check(s,"one_probe_budget_success",bits.status,0);
            p13_check(s,"one_probe_literal_zero",bits.low+bits.high,0);bits=ts_bits(&p,&v,coordinates,&limited);
            p13_check(s,"second_probe_same_budget_refused",bits.status,-9111);pm_free_words(coordinates);
            limited=ts_work();limited.max_rows=1;let row:NvRow=ts_row(&p,&v,&limited);p13_check(s,"one_row_budget_success",row.status,0);nio_free(row.data);
            row=ts_row(&p,&v,&limited);p13_check(s,"second_row_same_budget_refused",row.status,-9111);p13_check(s,"refused_row_empty",row.data.len,0);nio_free(row.data);
        }ts_close(&v);p13_unchanged(&p,before,s,w);nio_free(before);
    }pm_close(&p);nio_free(raw);
    let variant:i32=32;while(variant<=40 && s.*.failed==0){p13_case(s,"integer_one_not_boolean",variant);let category:i32=2;let flags:i32=1;
        if(variant==40){category=3;flags=2;}raw=f13_outer(blob,shape,stride,0,flags,category,variant);p=p13_parse(raw,s);
        if(p.status==0){let v:TsView=ts_open(&p,p.root,w);p13_empty_view(&v,-9101,s);ts_close(&v);}pm_close(&p);nio_free(raw);variant=variant+8;
    }
    nio_free(blob);nio_free(payload);pm_free_words(shape);pm_free_words(stride);
}

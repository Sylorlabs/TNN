@import("matrix.zag")

fn p13_page_name(index:i32)[]u8 {
    let n:[]u8=_zag_i64_to_str(index);let name:[]u8=_zag_str_concat("torch-page-",n);nio_free(n);return p13_join(name,".bin");
}
fn p13_page(root:i64,page:[]u8,index:i32,manifest:[]u8,replay:i32,s:*P13Stats,w:*TsWork)void {
    if(index<1 || index>32 || page.len<256 || page.len>65536 || page.len%256!=0){p13_check(s,"page_bounds",0,1);return;}
    let at:i32=256+(index-1)*48;mi_put(manifest,at,index);mi_put(manifest,at+4,page.len/256);mi_put(manifest,at+8,page.len);
    p13_check(s,"page_hash_status",p13_hash(page,manifest[at+16..at+48],w),0);if(s.*.failed!=0){return;}
    let name:[]u8=p13_page_name(index);
    if(replay==0){p13_check(s,"exclusive_torch_page_write",mi_write(root,name,page),0);}else{
        let stored:[]u8=nio_alloc(65536);let n:i64=mi_read(root,name,stored,65536);p13_check(s,"fresh_page_exact_size",n,page.len);
        if(n==page.len){p13_check(s,"fresh_process_every_page_byte_equal",nio_equal(stored[0..page.len],page),1);}nio_free(stored);
    }nio_free(name);
}
fn p13_parent_probe(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)i32 {
    let bits:NvBits=ts_bits(p,v,coordinates,w);if(bits.status!=0){return bits.status;}
    // A re-encoding consistency check over already known original bytes, NOT an
    // independent oracle for historical inference, runtime behavior or learning.
    let index:i64=v.*.offset;let i:i32=0;while(i<v.*.rank){index=index+coordinates[i]*v.*.strides[i];i=i+1;}
    if(index<0 || index>=v.*.count || bits.low<0 || bits.low>4294967295 || bits.high<0 || bits.high>4294967295){return -9112;}
    let low:i64=bits.low;let high:i64=bits.high;i=0;while(i<v.*.width){let x:i64=0;
        if(i<4){x=low%256;low=low/256;}else{x=high%256;high=high/256;}
        if(x!=(p.*.input[v.*.at+(index as i32)*v.*.width+i] as i64)){return -9112;}i=i+1;}return 0;
}
fn p13_inventory(replay:i32,s:*P13Stats,w:*TsWork)void {
    p13_case(s,"known-parent-inventory",replay);let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);
    p13_check(s,"accepted_parent_bound_load",p.status,0);if(p.status!=0){mi_loaded_close(&p);nio_free(binding);return;}
    p13_check(s,"accepted_parent_identity",pb_parent_identity(&p),0);
    let before:[]u8=p13_fingerprint(&p,w);p13_check(s,"inventory_complete_fingerprint",before.len,256);
    let root:i64=nio_open_root(p13_root());p13_check(s,"inventory_root",(root>=0) as i32,1);
    let page:[]u8=nio_alloc(65536);let manifest:[]u8=nio_alloc(1792);let seen:[]i64=pm_words(p.node_count+1);let coordinates:[]i64=pm_words(8);
    p13_check(s,"inventory_page_capacity",page.len,65536);p13_check(s,"manifest_capacity",manifest.len,1792);
    p13_check(s,"serialized_storage_identity_capacity",seen.len,p.node_count+1);p13_check(s,"probe_coordinate_capacity",coordinates.len,8);
    let id:i32=1;let used:i32=0;let pages:i32=0;let records:i32=0;let candidates:i32=0;let supported:i32=0;let refused:i32=0;let other:i32=0;
    let elements:i64=0;let bytes:i64=0;let unique_bytes:i64=0;let probes:i64=0;let empty:i32=0;let storages:i32=0;let tensors:i32=0;
    let parameters:i32=0;let unique:i32=0;let shared:i32=0;let probe_failures:i32=0;
    while(id<=p.node_count && s.*.failed==0){if(nv_kind(&p,id)==16){
        if(records>=8192){p13_check(s,"inventory_record_budget",-9111,0);break;}
        let category:i32=ts_category(&p,id);if(category>0){candidates=candidates+1;}else{other=other+1;}
        let v:TsView=ts_open(&p,id,w);let row:NvRow=NvRow{.status=0,.data=""};
        if(v.status==0){supported=supported+1;elements=elements+v.elements;bytes=bytes+v.bytes;
            if(category==1){storages=storages+1;}if(category==2){tensors=tensors+1;}if(category==3){parameters=parameters+1;}
            if(v.storage<1 || v.storage>=seen.len){p13_check(s,"storage_identity_bounds",0,1);}else{
                if(seen[v.storage]==0){seen[v.storage]=1;unique=unique+1;unique_bytes=unique_bytes+v.bytes;}else{shared=shared+1;}}
            let i:i32=0;while(i<8){coordinates[i]=0;i=i+1;}
            if(v.elements==0){empty=empty+1;}else{let code:i32=p13_parent_probe(&p,&v,coordinates[0..v.rank],w);probes=probes+1;
                if(code!=0){probe_failures=probe_failures+1;p13_check(s,"first_parent_bit_probe",code,0);}
                if(v.elements>1 && s.*.failed==0){i=0;while(i<v.rank){coordinates[i]=v.dims[i]-1;i=i+1;}
                    code=p13_parent_probe(&p,&v,coordinates[0..v.rank],w);probes=probes+1;
                    if(code!=0){probe_failures=probe_failures+1;p13_check(s,"last_parent_bit_probe",code,0);}}}
            if(s.*.failed==0){row=ts_row(&p,&v,w);}else{row.status=-9112;}
        }else if(v.status>=(-9104) && v.status<=(-9101)){
            if(category>0){refused=refused+1;}row.data=nio_alloc(256);
            if(row.data.len==256){mi_put(row.data,0,id);mi_put(row.data,4,category);mi_put(row.data,76,v.status);mi_put(row.data,80,nv_field(&p,id,1));}
            else{row.status=-9107;}
        }else{row.status=v.status;}
        if(row.status!=0 || row.data.len!=256){p13_check(s,"row_failure_not_ordinary_refusal",row.status,0);p13_check(s,"inventory_row_extent",row.data.len,256);}
        else{p13_check(s,"inventory_row_copy",mi_copy(row.data,page[used..used+256]),0);used=used+256;records=records+1;}
        nio_free(row.data);ts_close(&v);
        if(used==65536 && s.*.failed==0){pages=pages+1;p13_page(root,page,pages,manifest,replay,s,w);used=0;}
    }id=id+1;}
    if(used>0 && s.*.failed==0){pages=pages+1;p13_page(root,page[0..used],pages,manifest,replay,s,w);}
    p13_check(s,"every_REDUCE_classified",records,p.reductions);p13_check(s,"all_candidates_and_others_accounted",candidates+other,records);
    p13_check(s,"supported_and_refused_candidates_accounted",supported+refused,candidates);
    p13_check(s,"category_totals",storages+tensors+parameters,supported);p13_check(s,"identity_alias_totals",unique+shared,supported);
    p13_check(s,"first_last_probe_failures",probe_failures,0);p13_check(s,"page_count_accounting",pages,(records+255)/256);
    if(s.*.failed==0){mi_copy("R33TS001",manifest);mi_put(manifest,8,1);mi_put(manifest,12,256);mi_put(manifest,16,records);
        mi_put(manifest,20,pages);mi_put(manifest,24,candidates);mi_put(manifest,28,supported);mi_put(manifest,32,refused);mi_put(manifest,36,other);
        mi_put(manifest,40,p.node_count);mi_put(manifest,44,p.reductions);p13_check(s,"descriptor_bytes_u64",nrv3_put64(manifest,48,bytes),0);
        p13_check(s,"descriptor_elements_u64",nrv3_put64(manifest,56,elements),0);mi_copy(binding[32..64],manifest[64..96]);mi_copy(binding[64..96],manifest[96..128]);
        nrv3_put64(manifest,128,probes);mi_put(manifest,136,empty);mi_put(manifest,140,storages);mi_put(manifest,144,tensors);
        mi_put(manifest,148,parameters);mi_put(manifest,152,unique);mi_put(manifest,156,shared);nrv3_put64(manifest,160,unique_bytes);
        // Work counters are logged, not part of the deterministic descriptor
        // manifest. No timing, pointer addresses or allocator identity stored.
        let size:i32=256+pages*48;if(replay==0){p13_check(s,"exclusive_torch_manifest_write",mi_write(root,"torch-manifest.bin",manifest[0..size]),0);}else{
            let stored:[]u8=nio_alloc(1792);let n:i64=mi_read(root,"torch-manifest.bin",stored,1792);p13_check(s,"fresh_manifest_exact_size",n,size);
            if(n==size){p13_check(s,"fresh_process_complete_manifest_equal",nio_equal(stored[0..size],manifest[0..size]),1);}nio_free(stored);}
    }
    _zag_print("N13_REDUCTIONS,");_zag_println(_zag_i64_to_str(records));_zag_print("N13_CANDIDATES,");_zag_println(_zag_i64_to_str(candidates));
    _zag_print("N13_SUPPORTED,");_zag_println(_zag_i64_to_str(supported));_zag_print("N13_REFUSED,");_zag_println(_zag_i64_to_str(refused));
    _zag_print("N13_OTHER_REDUCERS,");_zag_println(_zag_i64_to_str(other));_zag_print("N13_DESCRIPTOR_BYTES,");_zag_println(_zag_i64_to_str(bytes));
    _zag_print("N13_DESCRIPTOR_ELEMENTS,");_zag_println(_zag_i64_to_str(elements));_zag_print("N13_UNIQUE_STORAGE_NODES,");_zag_println(_zag_i64_to_str(unique));
    _zag_print("N13_UNIQUE_STORAGE_NODE_BYTES,");_zag_println(_zag_i64_to_str(unique_bytes));_zag_print("N13_SHARED_STORAGE_REFERENCES,");_zag_println(_zag_i64_to_str(shared));
    _zag_print("N13_STORAGE_VIEWS,");_zag_println(_zag_i64_to_str(storages));_zag_print("N13_TENSOR_VIEWS,");_zag_println(_zag_i64_to_str(tensors));
    _zag_print("N13_PARAMETER_VIEWS,");_zag_println(_zag_i64_to_str(parameters));_zag_print("N13_FIRST_LAST_PROBES,");_zag_println(_zag_i64_to_str(probes));
    _zag_print("N13_EMPTY_VIEWS,");_zag_println(_zag_i64_to_str(empty));_zag_print("N13_PAGES,");_zag_println(_zag_i64_to_str(pages));
    p13_unchanged(&p,before,s,w);p13_check(s,"parent_identity_after_inspection",pb_parent_identity(&p),0);
    p13_check(s,"training_remains_refused",pb_training_admission(binding),-8904);
    nio_free(before);nio_free(page);nio_free(manifest);pm_free_words(seen);pm_free_words(coordinates);
    p13_check(s,"inventory_root_closed",nio_close(root),0);mi_loaded_close(&p);nio_free(binding);
}

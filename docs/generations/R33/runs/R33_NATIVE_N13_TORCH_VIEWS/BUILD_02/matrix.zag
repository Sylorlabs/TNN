@import("oracles.zag")
@import("refusals.zag")

fn p13_good(o:*O13,l:*L13,category:i32,flags:i32,blob:[]u8,s:*P13Stats,w:*TsWork)void {
    p13_case(s,"positive",s.*.cases);
    p13_check(s,"independent_payload_length",o.*.payload.len,o.*.count*o.*.width);
    p13_check(s,"complete_oracle_arrays",(o.*.low.len==16 && o.*.high.len==16 && l.*.dims.len==8 &&
        l.*.strides.len==8 && l.*.coords.len==128 && l.*.indices.len==16 && l.*.probes>=0) as i32,1);
    if(s.*.failed!=0){return;}
    let raw:[]u8=f13_outer(blob,l.*.dims[0..l.*.rank],l.*.strides[0..l.*.rank],l.*.offset,flags,category,0);
    let p:ParentMap=p13_parse(raw,s);if(p.status!=0){pm_close(&p);nio_free(raw);return;}
    let before:[]u8=p13_fingerprint(&p,w);p13_check(s,"positive_full_fingerprint",before.len,256);
    let v:TsView=ts_open(&p,p.root,w);p13_check(s,"positive_view_open",v.status,0);
    if(v.status==0){
        let tensor:i32=0;let storage:i32=p.root;let tg:i32=0;let grad:i32=0;
        if(category!=1){tensor=p.root;if(category==3){tensor=nv_item(&p,nv_field(&p,p.root,5),0);}
            storage=nv_item(&p,nv_field(&p,tensor,5),0);tg=flags%2;grad=tg;if(category==3){grad=(flags/2)%2;}}
        let buffer:i32=nv_item(&p,nv_field(&p,storage,5),0);let blob_at:i32=nv_field(&p,buffer,2);
        let payload_at:i32=blob_at+blob.len-o.*.payload.len;let key_offset:i32=p13_find(blob,o.*.key);
        p13_check(s,"independent_key_present",(key_offset>=0) as i32,1);
        p13_check(s,"original_blob_preserved",nio_equal(nv_raw(&p,buffer),blob),1);
        p13_check(s,"view_category",v.category,category);p13_check(s,"view_kind",v.kind,o.*.kind);
        p13_check(s,"view_width",v.width,o.*.width);p13_check(s,"view_storage_count",v.count,o.*.count);
        p13_check(s,"view_logical_elements",v.elements,l.*.elements);p13_check(s,"view_rank",v.rank,l.*.rank);
        p13_check(s,"view_offset",v.offset,l.*.offset);p13_check(s,"tensor_gradient_flag",v.tensor_grad,tg);p13_check(s,"effective_gradient_flag",v.grad,grad);
        let j:i32=0;while(j<l.*.probes && s.*.failed==0){let coordinates:[]i64=l.*.coords[j*8..j*8+l.*.rank];
            let index:i32=l.*.indices[j] as i32;p13_check(s,"oracle_storage_index_valid",(index>=0 && index<o.*.count && index<16) as i32,1);
            p13_check(s,"literal_coordinate_index",ts_at(&p,&v,coordinates,w),index);
            let got:NvBits=ts_bits(&p,&v,coordinates,w);p13_check(s,"raw_word_access_status",got.status,0);
            if(index>=0 && index<16){p13_check(s,"literal_low_word",got.low,o.*.low[index]);p13_check(s,"literal_high_word",got.high,o.*.high[index]);}
            j=j+1;
        }
        let row:NvRow=ts_row(&p,&v,w);p13_check(s,"positive_owned_row_status",row.status,0);p13_check(s,"positive_row_size",row.data.len,256);
        if(row.status==0 && row.data.len==256){
            p13_check(s,"row_node",mi_get(row.data,0),p.root);p13_check(s,"row_category",mi_get(row.data,4),category);
            p13_check(s,"row_tensor_node",mi_get(row.data,8),tensor);p13_check(s,"row_storage_node",mi_get(row.data,12),storage);
            p13_check(s,"row_buffer_node",mi_get(row.data,16),buffer);p13_check(s,"row_kind",mi_get(row.data,20),o.*.kind);
            p13_check(s,"row_width",mi_get(row.data,24),o.*.width);p13_check(s,"row_storage_count",mi_get(row.data,28),o.*.count);
            p13_check(s,"row_blob_at",mi_get(row.data,32),blob_at);p13_check(s,"row_blob_bytes",mi_get(row.data,36),blob.len);
            p13_check(s,"row_payload_at",mi_get(row.data,40),payload_at);p13_check(s,"row_payload_bytes",mi_get(row.data,44),o.*.payload.len);
            p13_check(s,"row_key_at",mi_get(row.data,48),blob_at+key_offset);p13_check(s,"row_key_length",mi_get(row.data,52),o.*.key.len);
            p13_check(s,"row_offset",mi_get(row.data,56),l.*.offset);p13_check(s,"row_rank",mi_get(row.data,60),l.*.rank);
            p13_check(s,"row_elements",mi_get(row.data,64),l.*.elements);p13_check(s,"row_tensor_grad",mi_get(row.data,68),tg);
            p13_check(s,"row_effective_grad",mi_get(row.data,72),grad);p13_check(s,"row_status_zero",mi_get(row.data,76),0);
            p13_check(s,"row_opcode_offset",mi_get(row.data,80),nv_field(&p,p.root,1));p13_check(s,"reserved_row_zero",mi_zero(row.data[84..96]),1);
            j=0;while(j<8){p13_check(s,"row_literal_dimension",mi_get(row.data,96+j*4),l.*.dims[j]);
                p13_check(s,"row_literal_stride",mi_get(row.data,128+j*4),l.*.strides[j]);j=j+1;}
            let hash:[]u8=nio_alloc(32);p13_check(s,"oracle_hash_buffer",hash.len,32);
            p13_check(s,"independent_blob_hash_status",p13_hash(blob,hash,w),0);p13_check(s,"row_blob_hash",nio_equal(hash,row.data[160..192]),1);
            p13_check(s,"independent_payload_hash_status",p13_hash(o.*.payload,hash,w),0);p13_check(s,"row_payload_hash",nio_equal(hash,row.data[192..224]),1);
            p13_check(s,"independent_key_hash_status",p13_hash(o.*.key,hash,w),0);p13_check(s,"row_key_hash",nio_equal(hash,row.data[224..256]),1);nio_free(hash);
            p13_check(s,"row_source_disjoint",p13_overlap(row.data,p.input),0);p13_check(s,"row_nodes_disjoint",p13_overlap(row.data,p13_word_bytes(p.nodes)),0);
            p13_check(s,"row_edges_disjoint",p13_overlap(row.data,p13_word_bytes(p.edges)),0);p13_check(s,"row_dims_disjoint",p13_overlap(row.data,p13_word_bytes(v.dims)),0);
            p13_check(s,"row_strides_disjoint",p13_overlap(row.data,p13_word_bytes(v.strides)),0);
            j=0;while(j<256){row.data[j]=219;j=j+1;}p13_check(s,"mutated_output_leaves_view_valid",ts_bound(&p,&v,w),0);
        }nio_free(row.data);
        let coordinates:[]i64=pm_words(9);p13_check(s,"coordinate_scratch",coordinates.len,9);
        if(coordinates.len==9){
            if(l.*.elements==0){let got:NvBits=ts_bits(&p,&v,coordinates[0..l.*.rank],w);
                p13_check(s,"empty_coordinates_refused",got.status,-9105);p13_check(s,"empty_coordinates_no_bits",got.low+got.high,0);}
            else{j=0;while(j<l.*.rank){coordinates[j]=-1;p13_check(s,"negative_axis_refused",ts_at(&p,&v,coordinates[0..l.*.rank],w),-9105);
                    coordinates[j]=l.*.dims[j];p13_check(s,"one_past_axis_refused",ts_at(&p,&v,coordinates[0..l.*.rank],w),-9105);coordinates[j]=0;j=j+1;}}
            p13_check(s,"extra_coordinate_refused",ts_at(&p,&v,coordinates[0..l.*.rank+1],w),-9105);
            if(l.*.rank>0){p13_check(s,"missing_coordinate_refused",ts_at(&p,&v,coordinates[0..l.*.rank-1],w),-9105);}
        }pm_free_words(coordinates);
    }
    ts_close(&v);p13_unchanged(&p,before,s,w);nio_free(before);pm_close(&p);nio_free(raw);
}
fn p13_storage_matrix(s:*P13Stats,w:*TsWork)void {
    let index:i32=0;while(index<9 && s.*.failed==0){let empty:i32=0;
        while(empty<2 && s.*.failed==0){if(index==8 && empty==1){break;}let o:O13=o13_fixture(index,empty);let l:L13=l13_new();
            if(o.count<0 || l.dims.len!=8 || l.strides.len!=8 || l.coords.len!=128 || l.indices.len!=16){p13_check(s,"matrix_allocation",0,1);o13_close(&o);l13_close(&l);return;}
            l.rank=1;l.dims[0]=o.count;l.strides[0]=1;l.elements=o.count;l.probes=o.count;
            let j:i32=0;while(j<o.count){l.coords[j*8]=j;l.indices[j]=j;j=j+1;}
            let blob:[]u8=f13_blob_named(o.name,o.count,o.payload,0,o.key);let category:i32=1;
            while(category<=3 && s.*.failed==0){l.strides[0]=1;if(empty==1 && category==1){l.strides[0]=0;}
                p13_good(&o,&l,category,0,blob,s,w);category=category+1;}
            if(empty==0){if(o.kind==102){let flags:i32=1;while(flags<=3 && s.*.failed==0){p13_good(&o,&l,3,flags,blob,s,w);flags=flags+1;}
                    p13_good(&o,&l,2,1,blob,s,w);
                }else{let flags:i32=1;while(flags<=2 && s.*.failed==0){p13_case(s,"integer_gradient_refusal",index*2+flags);
                        let raw:[]u8=f13_outer(blob,l.dims[0..1],l.strides[0..1],0,flags,3,0);let p:ParentMap=p13_parse(raw,s);
                        if(p.status==0){let v:TsView=ts_open(&p,p.root,w);p13_empty_view(&v,-9102,s);ts_close(&v);}
                        pm_close(&p);nio_free(raw);flags=flags+1;}}
            }
            nio_free(blob);o13_close(&o);l13_close(&l);empty=empty+1;
        }index=index+1;
    }
}
fn p13_layout_matrix(s:*P13Stats,w:*TsWork)void {
    let o:O13=o13_fixture(9,0);let blob:[]u8=o13_a16_blob();let made:[]u8=f13_compact_blob(o.name,o.key,o.count,o.payload);
    p13_case(s,"independent_complete_carrier",0);p13_check(s,"A16_literal_length",blob.len,261);
    p13_check(s,"A16_builder_matches_all_literal_bytes",nio_equal(made,blob),1);nio_free(made);
    let h:TsHeader=ts_decode(blob,w);p13_check(s,"A16_header_status",h.status,0);p13_check(s,"A16_payload_start",h.at,197);
    p13_check(s,"A16_payload_bytes",h.bytes,64);p13_check(s,"A16_PID_key_start",h.key_at,159);p13_check(s,"A16_key_bytes",h.key_len,3);
    let id:i32=0;while(id<22 && s.*.failed==0){let l:L13=l13_layout(id);p13_good(&o,&l,2,0,blob,s,w);l13_close(&l);id=id+1;}
    nio_free(blob);o13_close(&o);
    let index:i32=4;while(index<=6 && s.*.failed==0){if(index==5){index=index+1;continue;}
        o=o13_fixture(index,0);let l:L13=l13_new();l.offset=1;if(index==6){l.offset=4;}l.indices[0]=l.offset;
        blob=f13_blob_named(o.name,o.count,o.payload,0,o.key);p13_good(&o,&l,2,0,blob,s,w);
        nio_free(blob);o13_close(&o);l13_close(&l);index=index+1;
    }
    o=o13_fixture(0,0);nio_free(o.payload);o.payload=p13_hex("2e800252");o.key=".";o.count=4;
    o.low[0]=46;o.low[1]=128;o.low[2]=2;o.low[3]=82;let l:L13=l13_new();l.rank=1;l.elements=4;l.probes=4;l.dims[0]=4;l.strides[0]=1;
    id=0;while(id<4){l.coords[id*8]=id;l.indices[id]=id;id=id+1;}
    blob=f13_compact_blob(o.name,o.key,o.count,o.payload);p13_good(&o,&l,1,0,blob,s,w);nio_free(blob);o13_close(&o);l13_close(&l);
}
fn p13_alias_controls(s:*P13Stats,w:*TsWork)void {
    let blob:[]u8=o13_a16_blob();let shape:[]i64=pm_words(1);shape[0]=2;let strides:[]i64=pm_words(1);strides[0]=1;
    let shared:i32=0;while(shared<2 && s.*.failed==0){p13_case(s,"alias-identity",shared);
        let raw:[]u8=f13_alias_pair(blob,shape,strides,shared);let p:ParentMap=p13_parse(raw,s);
        if(p.status==0){let before:[]u8=p13_fingerprint(&p,w);let first:TsView=ts_open(&p,nv_item(&p,p.root,0),w);
            let second:TsView=ts_open(&p,nv_item(&p,p.root,1),w);p13_check(s,"first_alias_view",first.status,0);p13_check(s,"second_alias_view",second.status,0);
            if(first.status==0 && second.status==0){p13_check(s,"same_storage_only_if_memo_shared",(first.storage==second.storage) as i32,shared);
                p13_check(s,"same_blob_node_only_if_shared",(first.buffer==second.buffer) as i32,shared);
                let a:NvRow=ts_row(&p,&first,w);let b:NvRow=ts_row(&p,&second,w);p13_check(s,"alias_row_a",a.status,0);p13_check(s,"alias_row_b",b.status,0);
                if(a.data.len==256 && b.data.len==256){p13_check(s,"equal_payload_and_key_do_not_prove_alias",nio_equal(a.data[160..256],b.data[160..256]),1);}
                nio_free(a.data);nio_free(b.data);ts_close(&first);p13_check(s,"closing_sibling_preserves_other",ts_bound(&p,&second,w),0);
            }else{ts_close(&first);}ts_close(&second);p13_unchanged(&p,before,s,w);nio_free(before);
        }pm_close(&p);nio_free(raw);shared=shared+1;
    }nio_free(blob);pm_free_words(shape);pm_free_words(strides);
}
fn p13_hash_boundaries(s:*P13Stats,w:*TsWork)void {
    let blob:[]u8=o13_a16_blob();let l:L13=l13_layout(0);let raw:[]u8=f13_outer(blob,l.dims[0..0],l.strides[0..0],5,0,2,0);
    let p:ParentMap=p13_parse(raw,s);if(p.status==0){let v:TsView=ts_open(&p,p.root,w);p13_check(s,"hash_budget_valid_view",v.status,0);
        if(v.status==0){p13_case(s,"hash-budget-boundaries",0);let limited:TsWork=ts_work();limited.max_hash_bytes=327;
            let row:NvRow=ts_row(&p,&v,&limited);p13_check(s,"328_bytes_refused_by_327_budget",row.status,-9111);p13_check(s,"refused_hash_no_row",row.data.len,0);
            p13_check(s,"hash_budget_never_exceeded",limited.hash_bytes,0);nio_free(row.data);
            limited=ts_work();limited.max_hash_bytes=328;row=ts_row(&p,&v,&limited);p13_check(s,"exact_328_budget_succeeds",row.status,0);
            p13_check(s,"exact_hash_input_charge",limited.hash_bytes,328);nio_free(row.data);
            let second:TsView=ts_open(&p,p.root,&limited);p13_check(s,"new_handle_under_same_account",second.status,0);
            row=ts_row(&p,&second,&limited);p13_check(s,"new_handle_cannot_reset_hash_budget",row.status,-9111);p13_check(s,"second_refusal_no_row",row.data.len,0);
            p13_check(s,"charged_work_not_rolled_back",limited.hash_bytes,328);nio_free(row.data);ts_close(&second);
        }ts_close(&v);
    }pm_close(&p);nio_free(raw);nio_free(blob);l13_close(&l);
}
fn p13_matrix(s:*P13Stats,w:*TsWork)void {
    p13_storage_matrix(s,w);if(s.*.failed==0){p13_layout_matrix(s,w);}
    if(s.*.failed==0){p13_alias_controls(s,w);}if(s.*.failed==0){p13_hash_boundaries(s,w);}
}

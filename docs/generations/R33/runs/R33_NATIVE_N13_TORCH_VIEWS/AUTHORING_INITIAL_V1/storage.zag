// N13 inert legacy single-storage transport. No Python, torch.load, callbacks,
// reducers, constructors, training, or hidden executable payload interpretation.
// Protocol-2 header records only; complete raw little-endian payload retained.
@import("views.zag")

struct TsHeader {status:i32,kind:i32,width:i32,count:i32,at:i32,bytes:i32,key_at:i32,key_len:i32}
fn ts_empty_header(code:i32)TsHeader {
    return TsHeader{.status=code,.kind=0,.width=0,.count=0,.at=0,.bytes=0,.key_at=0,.key_len=0};
}
fn ts_unsigned(b:[]u8,at:i32,n:i32)i64 {
    if(at<0 || n<1 || n>8 || at>b.len || n>b.len-at){return -1;}
    if(n==8 && b[at+7]>=128){return -1;}let x:i64=0;let i:i32=n-1;
    while(i>=0){x=x*256+(b[at+i] as i64);i=i-1;}return x;
}
fn ts_hex_equal(b:[]u8,hex:[]u8)i32 {
    if(hex.len!=b.len*2){return 0;}let i:i32=0;
    while(i<b.len){let a:i64=ns_hex_digit(hex[2*i] as i32);let c:i64=ns_hex_digit(hex[2*i+1] as i32);
        if(a<0 || c<0 || a*16+c!=(b[i] as i64)){return 0;}i=i+1;}return 1;
}
fn ts_prefix(b:[]u8,begin:i32)i32 {
    // Lexical framing only; the frozen inert scanner subsequently validates
    // stack/memo/container semantics of the EXACT bounded prefix. Bytes inside
    // strings/LONG/GLOBAL operands cannot masquerade as a STOP instruction.
    if(begin<0 || begin>b.len || b.len-begin<3 || b[begin]!=128 || b[begin+1]!=2){return -9101;}
    let at:i32=begin+2;let limit:i32=b.len;if(limit-begin>4096){limit=begin+4096;}
    let tokens:i32=0;
    while(at<limit && tokens<1024){let op:i32=b[at] as i32;at=at+1;tokens=tokens+1;
        if(op==46){return at;}
        let skip:i64=0;
        if(op==74 || op==114 || op==106){skip=4;}
        else if(op==75 || op==113 || op==104){skip=1;}
        else if(op==77){skip=2;}
        else if(op==88 || op==66 || op==84 || op==139){
            if(limit-at<4){return -9101;}skip=ts_unsigned(b,at,4);at=at+4;
        }else if(op==67 || op==85 || op==138){
            if(at>=limit){return -9101;}skip=b[at] as i32;at=at+1;
        }else if(op==99){let lines:i32=0;let n:i32=0;
            while(at<limit && lines<2 && n<256){if(b[at]==10){lines=lines+1;}at=at+1;n=n+1;}
            if(lines!=2){return -9101;}
        }else if(op!=40 && op!=41 && op!=78 && op!=81 && op!=93 && op!=97 && op!=100 &&
            op!=101 && op!=108 && op!=115 && op!=116 && op!=117 && op!=125 &&
            op!=133 && op!=134 && op!=135 && op!=136 && op!=137){return -9101;}
        if(skip<0 || skip>limit-at){return -9101;}at=at+(skip as i32);
    }return -9101;
}
fn ts_record(b:[]u8,at:i32)ParentMap {
    let end:i32=ts_prefix(b,at);if(end<0){return pb_failed(end);}
    let p:ParentMap=pm_init(b[at..end],128,256,128,64);
    if(p.status!=0){pm_close(&p);return pb_failed(-9107);}
    if(pm_scan(&p)!=0 || pm_validate(&p)!=0){pm_close(&p);return pb_failed(-9101);}return p;
}
fn ts_dict_size(p:*ParentMap,id:i32,n:i32)i32 {
    return (nv_kind(p,id)==11 && nv_field(p,id,9)==n) as i32;
}
fn ts_type(name:[]u8)TsHeader {
    let h:TsHeader=ts_empty_header(-9102);
    if(nio_equal(name,"ByteStorage")==1){h.kind=117;h.width=1;}
    else if(nio_equal(name,"CharStorage")==1){h.kind=105;h.width=1;}
    else if(nio_equal(name,"ShortStorage")==1){h.kind=105;h.width=2;}
    else if(nio_equal(name,"IntStorage")==1){h.kind=105;h.width=4;}
    else if(nio_equal(name,"LongStorage")==1){h.kind=105;h.width=8;}
    else if(nio_equal(name,"FloatStorage")==1){h.kind=102;h.width=4;}
    else if(nio_equal(name,"DoubleStorage")==1){h.kind=102;h.width=8;}
    else if(nio_equal(name,"BoolStorage")==1){h.kind=98;h.width=1;}
    if(h.width>0){h.status=0;}return h;
}
fn ts_decode(b:[]u8)TsHeader {
    if(b.len<32 || b.len>16777216){return ts_empty_header(-9101);}
    let at:i32=0;let p:ParentMap=ts_record(b,at);if(p.status!=0){return ts_empty_header(p.status);}
    let ok:i32=(nv_kind(&p,p.root)==4 && ts_hex_equal(nv_raw(&p,p.root),"6cfc9c46f9206aa85019")==1) as i32;
    at=at+p.input.len;pm_close(&p);if(ok!=1){return ts_empty_header(-9102);}
    p=ts_record(b,at);if(p.status!=0){return ts_empty_header(p.status);}
    ok=nv_int_is(&p,p.root,1001);at=at+p.input.len;pm_close(&p);if(ok!=1){return ts_empty_header(-9102);}
    p=ts_record(b,at);if(p.status!=0){return ts_empty_header(p.status);}
    let endian:i32=pm_lookup(&p,p.root,"little_endian");let sizes:i32=pm_lookup(&p,p.root,"type_sizes");
    ok=(ts_dict_size(&p,p.root,3)==1 && nv_int_is(&p,pm_lookup(&p,p.root,"protocol_version"),1001)==1 &&
        nv_kind(&p,endian)==2 && nv_clean(&p,endian)==1 && nv_field(&p,endian,6)==1 &&
        ts_dict_size(&p,sizes,3)==1 && nv_int_is(&p,pm_lookup(&p,sizes,"short"),2)==1 &&
        nv_int_is(&p,pm_lookup(&p,sizes,"int"),4)==1 && nv_int_is(&p,pm_lookup(&p,sizes,"long"),4)==1) as i32;
    at=at+p.input.len;pm_close(&p);if(ok!=1){return ts_empty_header(-9102);}
    p=ts_record(b,at);if(p.status!=0){return ts_empty_header(p.status);}
    if(nv_kind(&p,p.root)!=17 || p.external!=1 || nv_clean(&p,p.root)!=1){pm_close(&p);return ts_empty_header(-9102);}
    let tuple:i32=nv_field(&p,p.root,4);if(nv_tuple_size(&p,tuple)!=6){pm_close(&p);return ts_empty_header(-9102);}
    let cls:i32=nv_item(&p,tuple,1);let key:i32=nv_item(&p,tuple,2);let name:[]u8=nv_raw(&p,nv_field(&p,cls,5));
    let h:TsHeader=ts_type(name);let count:NvInt=nv_integer(&p,nv_item(&p,tuple,4));
    ok=(nv_text(&p,nv_item(&p,tuple,0),"storage")==1 && nv_symbol(&p,cls,"torch",name)==1 &&
        nv_text(&p,nv_item(&p,tuple,3),"cpu")==1 && nv_kind(&p,nv_item(&p,tuple,5))==1 &&
        nv_kind(&p,key)==6 && nv_clean(&p,key)==1 && nv_raw(&p,key).len>=1 && nv_raw(&p,key).len<=64) as i32;
    if(ok!=1 || h.status!=0 || count.status!=0 || count.value<0 || count.value>16777216/h.width){pm_close(&p);return ts_empty_header(-9102);}
    h.count=count.value as i32;h.bytes=h.count*h.width;h.key_at=at+nv_field(&p,key,2);h.key_len=nv_field(&p,key,3);
    let i:i32=0;while(i<h.key_len){let c:i32=b[h.key_at+i] as i32;if(c<33 || c>126){ok=0;}i=i+1;}
    at=at+p.input.len;pm_close(&p);if(ok!=1){return ts_empty_header(-9102);}
    p=ts_record(b,at);if(p.status!=0){return ts_empty_header(p.status);}
    let edge:i32=nv_field(&p,p.root,7);
    if(nv_kind(&p,p.root)!=9 || nv_field(&p,p.root,9)!=1 || edge<1 || edge>p.edge_count ||
        nv_field(&p,p.root,8)!=edge || p.edges[(edge-1)*4+1]!=0 || p.edges[(edge-1)*4+2]!=0 || p.edges[(edge-1)*4+3]!=1){pm_close(&p);return ts_empty_header(-9102);}
    ok=nv_text(&p,p.edges[(edge-1)*4] as i32,b[h.key_at..h.key_at+h.key_len]);
    at=at+p.input.len;pm_close(&p);if(ok!=1){return ts_empty_header(-9102);}
    if(at>b.len || b.len-at<8 || ts_unsigned(b,at,8)!=h.count || h.bytes!=b.len-at-8){return ts_empty_header(-9103);}
    h.at=at+8;h.status=0;return h;
}

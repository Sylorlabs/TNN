// Operational input custody inventory, not inference or a continuity evaluator.
@import("../../../../R33_NATIVE_IO_V1.zag")
@import("../../../../R33_NATIVE_SHA256_V2.zag")
fn main()i32 {if(_zag_argc()!=2){return 64;}let paths:[]u8=_zag_read_file(_zag_arg(1));if(paths.len==0){return 66;}let start:i32=0;let i:i32=0;let failures:i32=0;while(i<=paths.len){if(i==paths.len||paths[i]==10){if(i>start){let path:[]u8=paths[start..i];let data:[]u8=_zag_read_file(path);let h:[]u8=nio_alloc(32);if(data.len<0||h.len!=32||ns_sha256(data,h)!=0){_zag_print("ERROR\t");_zag_println(path);failures=failures+1;}else{let t:[]u8=ns_hex(h);_zag_print("FILE\t");_zag_print(path);_zag_print("\t");let n:[]u8=_zag_i64_to_str(data.len as i64);_zag_print(n);nio_free(n);_zag_print("\t");_zag_println(t);nio_free(t);}nio_free(data);nio_free(h);}start=i+1;}i=i+1;}return (failures!=0) as i32;}

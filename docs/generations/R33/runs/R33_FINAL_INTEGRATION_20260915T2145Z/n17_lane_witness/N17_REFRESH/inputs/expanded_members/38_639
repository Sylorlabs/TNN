#!/usr/bin/env python3
from __future__ import annotations
import argparse,json
from pathlib import Path
from collections import defaultdict
import numpy as np
from entity_aeif_factorial import World,render,Rep,Model,eval_model

ARCHS=['AE_ACTIVE','AEIF_ACTIVE','AE_PURE','PROCESS','BLACKBOARD','G_ALL']
MODES=['RANDOM','BALANCED','MAX_DIVERSITY','ADAPTIVE_MASTER','CONTRASTIVE','COUNTEREXAMPLE','ACTIVE_SELF','TNN_REPLAY','SIBLING_ASSIST','MASTER_DIVERSE','MIXED']
DOSES=[1,2,4,8,16,32,64,128,256,512,1024,2048]
KINDS=['clean','view','scale','noise','occ.3','occ.55','compound']

def pool_world(w,seed,maxdose=2048):
 cache=Path(f'/mnt/data/tnn-r28-aeif-no-graph/state/training_pool_{seed}_{maxdose}.npz')
 if cache.exists():
  z=np.load(cache);arr=z['arr'];return [[(KINDS[j%7],arr[e,j]) for j in range(maxdose)] for e in range(arr.shape[0])]
 arr=np.empty((len(w.bases),maxdose,32),dtype=np.float32)
 for e,b in enumerate(w.bases):
  for j in range(maxdose):
   k=KINDS[j%7];arr[e,j]=render(b,k,np.random.default_rng(seed*1000003+e*3001+j))
 np.savez_compressed(cache,arr=arr)
 return [[(KINDS[j%7],arr[e,j]) for j in range(maxdose)] for e in range(arr.shape[0])]

def order_for(w,pool,e,mode,seed):
 r=np.random.default_rng(seed+e);rows=pool[e];n=len(rows);idx=np.arange(n)
 pri={'compound':8,'occ.55':7,'noise':6,'occ.3':5,'view':4,'scale':3,'clean':1}
 if mode=='RANDOM':r.shuffle(idx);return idx.tolist()
 if mode=='BALANCED':return idx.tolist()
 if mode in ('MAX_DIVERSITY','ACTIVE_SELF'):
  # deterministic proxy for diversity: interleave transform families, then sort each family by distance from clean anchor.
  anchor=rows[0][1];families=[]
  for ki,k in enumerate(KINDS):
   ids=[i for i,(kk,_) in enumerate(rows) if kk==k];ids.sort(key=lambda i:np.linalg.norm(rows[i][1]-anchor),reverse=True);families.append(ids)
  out=[]
  for j in range(max(map(len,families))):
   for f in families:
    if j<len(f):out.append(f[j])
  return out
 if mode=='ADAPTIVE_MASTER':return sorted(range(n),key=lambda i:(pri[rows[i][0]],np.linalg.norm(rows[i][1]-rows[0][1])),reverse=True)
 t=w.twins[e];center=pool[t][0][1] if t>=0 else rows[0][1]
 near=sorted(range(n),key=lambda i:np.linalg.norm(rows[i][1]-center))
 if mode=='CONTRASTIVE':return near
 if mode=='COUNTEREXAMPLE':
  out=[]
  for a,b in zip(near,near[::-1]):
   if a not in out:out.append(a)
   if b not in out:out.append(b)
  return out
 if mode=='TNN_REPLAY':return sorted(range(n),key=lambda i:np.linalg.norm(rows[i][1]-rows[0][1]),reverse=True)
 if mode=='SIBLING_ASSIST':
  hard=[i for i,(k,_) in enumerate(rows) if k in ('view','noise','compound')];rest=[i for i in range(n) if i not in set(hard)];r.shuffle(hard);r.shuffle(rest);return hard+rest
 if mode=='MASTER_DIVERSE':
  first=sorted(range(n),key=lambda i:pri[rows[i][0]],reverse=True)[:n//3];rest=[i for i in range(n) if i not in set(first)];r.shuffle(rest);return first+rest
 # MIXED
 out=[];families={k:[i for i,(kk,_) in enumerate(rows) if kk==k] for k in KINDS}
 for j in range(max(len(v) for v in families.values())):
  for k in ('compound','view','occ.55','noise','clean','scale','occ.3'):
   if j<len(families[k]):out.append(families[k][j])
 return out

def run(seed,out,only_mode=None):
 w=World(seed);pool=pool_world(w,seed);modes=[only_mode] if only_mode else MODES;orders={(m,e):order_for(w,pool,e,m,seed+47) for m in modes for e in range(len(w.bases))};rows=[]
 for mode in modes:
  for dose in DOSES:
   views=[np.stack([pool[e][i][1] for i in orders[(mode,e)][:dose]]) for e in range(len(w.bases))];rep=Rep(views,12)
   for a in ARCHS:
    met=eval_model(Model(a,rep,w,seed+311),w,seed+900+dose,n=2);rows.append({'seed':seed,'mode':mode,'dose':dose,'arch':a,**met})
  print(mode,'done',flush=True)
 Path(out).write_text(json.dumps({'evidence':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows},indent=2))

def combine(files,out):
 rows=[]
 for f in files:rows+=json.loads(Path(f).read_text())['rows']
 g=defaultdict(list)
 for r in rows:g[(r['arch'],r['mode'],r['dose'])].append(r)
 s=[]
 for (a,m,d),rs in g.items():
  z={'arch':a,'mode':m,'dose':d,'n':len(rs)}
  for k in ['overall','floor','viewpoint','occlusion80','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption','compound','extra_rate']:
   v=[x[k] for x in rs];z[k]=float(np.mean(v));z[k+'_sd']=float(np.std(v))
  s.append(z)
 Path(out).write_text(json.dumps({'evidence':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'summary':s},indent=2))
 # print best final dose per arch
 for a in ARCHS:
  rr=sorted([x for x in s if x['arch']==a and x['dose']==2048],key=lambda x:(x['floor'],x['overall']),reverse=True)[:3]
  print(a,json.dumps(rr))

if __name__=='__main__':
 ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);a=sp.add_parser('seed');a.add_argument('--seed',type=int,required=True);a.add_argument('--out',required=True);a.add_argument('--mode',default=None);b=sp.add_parser('combine');b.add_argument('--out',required=True);b.add_argument('files',nargs='+');x=ap.parse_args();run(x.seed,x.out,x.mode) if x.cmd=='seed' else combine(x.files,x.out)

#!/usr/bin/env python3
from pathlib import Path
import csv,json,hashlib
from collections import Counter
root=Path(__file__).resolve().parents[1]
map_rows=[]
for line in (root/'experiments/PROMOTED_MAP.tsv').read_text().splitlines():
    if line.strip():
        src,base=line.split('\t');map_rows.append((src,base))
fresh_sources={'r430_parallel_hypotheses.c','r440_grounded_dialogue_reasoning.c','r450_active_clarification.c','r460_contrastive_motif_induction.c'}
out=[]
for src,base in map_rows:
    gp=root/f'results/gcc/{base}.csv';cp=root/f'results/clang/{base}.csv'
    if not gp.is_file() or not cp.is_file():raise SystemExit(f'missing promoted output: {base}')
    if gp.read_bytes()!=cp.read_bytes():raise SystemExit(f'differential mismatch: {base}')
    cls='REFERENCE_C_FRESH_GCC_CLANG_SANITIZED' if src in fresh_sources else 'REFERENCE_C_GCC_CLANG_EXACT'
    for idx,r in enumerate(csv.DictReader(gp.open()),1):
        out.append({
          'evidence_id':f'{Path(src).stem}:{idx:03d}','source':src,'result_set':base,
          'original_round':r.get('round',''),'track':r.get('track',''),'hypothesis':r.get('hypothesis',''),
          'method':r.get('method',''),'metric':r.get('metric',''),'value':r.get('value',''),
          'baseline':r.get('baseline',''),'baseline_value':r.get('baseline_value',''),
          'seeds':r.get('seeds',''),'status':r.get('status',''),'evidence_class':cls})
fields=list(out[0])
with (root/'results/promoted-evidence.csv').open('w',newline='') as f:
    w=csv.DictWriter(f,fields);w.writeheader();w.writerows(out)
# Inventory both attempted and promoted source files.
sources={p.name:p for p in (root/'attempts').glob('*.c')}
for p in (root/'experiments').glob('*.c'):sources.setdefault(p.name,p)
promoted={s for s,_ in map_rows}
inv=[]
for name,p in sorted(sources.items()):
    inv.append({'source':name,'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'bytes':p.stat().st_size,'promoted':str(name in promoted).lower()})
with (root/'results/attempt-inventory.csv').open('w',newline='') as f:
    w=csv.DictWriter(f,fieldnames=inv[0]);w.writeheader();w.writerows(inv)
status=Counter(r['status'] for r in out);tracks=Counter(r['track'] for r in out);classes=Counter(r['evidence_class'] for r in out)
seeded=sum(int(float(r['seeds'])) for r in out if r['seeds'])
def sha(rel):return hashlib.sha256((root/rel).read_bytes()).hexdigest()
summary={
 'release':'TNN pre-v1 R4',
 'promoted_programs':len(map_rows),'preserved_attempt_sources':len(inv),
 'promoted_evidence_rows':len(out),'reported_seeded_evaluations':seeded,
 'status_counts':dict(sorted(status.items())),'track_counts':dict(sorted(tracks.items())),
 'evidence_class_counts':dict(sorted(classes.items())),
 'r3_additions':{
   'parallel_hypothesis_rows':8,'grounded_dialogue_rows':9,'active_clarification_rows':4,
   'persistent_teaching_lab':'BOUNDED_RELATIONAL_INTERFACE',
   'english_zag_state_sha256':sha('state/r3_english_zag_seed.bin'),
   'regression_state_sha256':sha('state/r3_regression_trained.bin')},
 'r4_additions':{
   'contrastive_motif_rows':20,
   'cmi_core_sha256':sha('src/cmi.c'),
   'cmi_header_sha256':sha('src/cmi.h'),
   'controlled_english':'SUPPORTED_CONTROLLED',
   'teenager_english':'NOT_MET'},
 'production_gates':{
   'teenager_english':'NOT_MET','adult_english':'NOT_MET','continuous_natural_multimodal_development':'NOT_MET',
   'native_zag_quantitative_parity':'NOT_MET','open_domain_learn_anything':'NOT_MET',
   'human_superior_learning_memory':'NOT_EVALUATED','production_v1':'NOT_PROMOTED'}}
(root/'results/summary.json').write_text(json.dumps(summary,indent=2,sort_keys=True)+'\n')
print(json.dumps(summary,indent=2,sort_keys=True))

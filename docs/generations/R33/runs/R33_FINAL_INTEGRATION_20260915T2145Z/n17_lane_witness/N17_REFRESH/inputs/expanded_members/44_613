#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent));from entity_aeif_factorial import World

def ridge_fit(X,y,lam=.2):
 X=np.asarray(X);y=np.asarray(y);return np.linalg.solve(X.T@X+lam*np.eye(X.shape[1]),X.T@y)
def run(seed=281000,train_ctx=14,test_ctx=100):
 w=World(seed,n=24,d=20);r=np.random.default_rng(seed+8080);D=w.afford.shape[2];models={};scalar=np.zeros((24,4));
 train=[]
 for _ in range(train_ctx):
  c=r.normal(size=D);c/=np.linalg.norm(c)+1e-8;train.append(c)
 for e in range(24):
  for a in range(4):
   ys=[float(w.afford[e,a]@c+r.normal(0,.10)) for c in train];models[e,a]=ridge_fit(train,ys);scalar[e,a]=np.mean(ys)
 out={'linear_clean':[],'linear_noisy':[],'scalar_clean':[],'scalar_noisy':[]}
 for _ in range(test_ctx):
  c=r.normal(size=D);c/=np.linalg.norm(c)+1e-8
  for e in range(24):
   truth=np.array([w.afford[e,a]@c for a in range(4)]);best=int(np.argmax(truth))
   lp=np.array([models[e,a]@c for a in range(4)]);out['linear_clean'].append(int(np.argmax(lp))==best)
   lpn=lp+r.normal(0,.16,4);out['linear_noisy'].append(int(np.argmax(lpn))==best)
   out['scalar_clean'].append(int(np.argmax(scalar[e]))==best);out['scalar_noisy'].append(int(np.argmax(scalar[e]+r.normal(0,.16,4)))==best)
 return {'seed':seed,'train_contexts':train_ctx,'test_contexts':test_ctx,'accuracy':{k:float(np.mean(v)) for k,v in out.items()}}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

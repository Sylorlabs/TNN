@njit(cache=True)
def dtw_open(a,b,band=8):
    # Open-begin/end DTW: allows coarticulation to remove/damage a few endpoint states.
    n=len(a);m=len(b);inf=1e18
    prev=np.full(m+1,inf);cur=np.full(m+1,inf)
    # opening skips on prototype have small cost, bounded to 5 states
    prev[0]=0.0
    for j in range(1,m+1):
        prev[j]=0.035*j if j<=5 else inf
    for i in range(1,n+1):
        cur[:] = inf
        # short leading observed corruption can be skipped modestly
        cur[0]=0.05*i if i<=4 else inf
        center=int(i*m/max(1,n))
        lo=max(1,center-band);hi=min(m,center+band)
        for j in range(lo,hi+1):
            d=(a[i-1]-b[j-1])**2
            v=prev[j]
            if cur[j-1]<v:v=cur[j-1]
            if prev[j-1]<v:v=prev[j-1]
            cur[j]=d+v
        tmp=prev;prev=cur;cur=tmp
    best=inf
    for j in range(max(1,m-5),m+1):
        v=prev[j]+0.035*(m-j)
        if v<best:best=v
    return best/max(1,n)

@njit(cache=True)
def all_dtw(seg,P):
    M,K,W=P.shape;out=np.empty(M)
    # z-normalize raw segment
    mu=0.0
    for x in seg:mu+=x
    mu/=len(seg);var=0.0
    for x in seg:var+=(x-mu)*(x-mu)
    sd=(var/len(seg)+1e-8)**0.5
    z=np.empty(len(seg))
    for i in range(len(seg)):z[i]=(seg[i]-mu)/sd
    for m in range(M):
        best=1e18
        for k in range(K):
            v=dtw_open(z,P[m,k])
            if v<best:best=v
        out[m]=best
    return out

def decode(samples,P,dur,count,min_d=8,max_d=34,max_shift=6,beam=260,top_m=3):
    N=len(samples); costs={}
    for st in range(N):
        for d in range(min_d,min(max_d,N-st)+1):
            cc=all_dtw(np.asarray(samples[st:st+d],np.float64),P)
            # weak duration prior
            for m in range(len(cc)):
                mu,sd=dur[m];cc[m]+=.003*((d-mu)/sd)**2
            costs[(st,d)]=cc
    states=[(0.,0,[])]
    for kk in range(count):
        nxt=[]
        for base,pend,seq in states:
            shifts=range(0,8) if kk==0 else range(-max_shift,max_shift+1)
            for sh in shifts:
                st=pend+sh
                if st<0 or st>=N:continue
                for d in range(min_d,min(max_d,N-st)+1):
                    cc=costs[(st,d)];inds=np.argpartition(cc,min(top_m,len(cc))-1)[:top_m]
                    for mm in inds:
                        m=int(mm);v=base+float(cc[m])+.008*abs(sh)
                        if seq and seq[-1]==m:v+=.03
                        nxt.append((v,st+d,seq+[m]))
        if not nxt:return []
        nxt.sort(key=lambda z:z[0]+.012*abs(z[1]-N*(kk+1)/count))
        keep=[];seen=set()
        for z in nxt:
            key=(z[1]//2,z[2][-1],tuple(z[2][-2:]))
            if key in seen:continue
            seen.add(key);keep.append(z)
            if len(keep)>=beam:break
        states=keep
    return min(states,key=lambda z:z[0]+.018*abs(z[1]-N))[2]

def run(seed,trials=30):
    bases={e:s.base_template(seed,e) for e in range(12)};P,d=s.learn_protos(seed+100,bases,K=8);r=np.random.default_rng(seed+500)
    # warm JIT
    _=all_dtw(np.asarray(s.vary(bases[0],r,True),float),P)
    vals=[];exact=[];beam=[]
    for q in range(trials):
        ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True)
        dec=decode(x,P,d,4);a=sum(i==j for i,j in zip(dec,ids))/4 if len(dec)==4 else 0;vals.append(a);exact.append(a==1)
        dec2=s.decode_beam(x,P,d,4,beam=130,top_m=2);beam.append(sum(i==j for i,j in zip(dec2,ids))/4 if len(dec2)==4 else 0)
    return {'seed':seed,'trials':trials,'dtw_accuracy':float(np.mean(vals)),'dtw_exact':float(np.mean(exact)),'beam_accuracy':float(np.mean(beam))}


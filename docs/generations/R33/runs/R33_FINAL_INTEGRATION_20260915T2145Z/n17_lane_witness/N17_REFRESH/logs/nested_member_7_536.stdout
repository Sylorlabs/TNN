#!/usr/bin/env python3
from pathlib import Path
import subprocess,sys,time
root=Path(__file__).resolve().parents[1]
selected=sys.argv[1:]
if not selected:
    raise SystemExit('usage: verify_selected.py experiment_stem ...')
out=root/'results'/'fresh-selected'; out.mkdir(parents=True,exist_ok=True)
build=root/'build'/'fresh-selected'; build.mkdir(parents=True,exist_ok=True)
maprows={}
for line in (root/'experiments'/'PROMOTED_MAP.tsv').read_text().splitlines():
    if line.strip():
        src,base=line.split('\t');maprows[Path(src).stem]=(src,base)
fail=0
for name in selected:
    if name not in maprows:
        print(f'{name}\tMISSING_PROMOTED_MAP',flush=True);fail+=1;continue
    src,base=maprows[name]; outputs={}; start=time.time()
    for cc in ('gcc','clang'):
        binary=build/f'{name}.{cc}'
        cmd=[cc,'-std=c11','-O2','-Wall','-Wextra','-Werror','-pedantic','-ffp-contract=off','-I'+str(root/'src'),str(root/'experiments'/src),'-lm','-o',str(binary)]
        p=subprocess.run(cmd,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        (out/f'{name}.{cc}.compile.log').write_bytes(p.stdout+p.stderr)
        if p.returncode:
            print(f'{name}\t{cc.upper()}_COMPILE_FAIL\t{time.time()-start:.2f}',flush=True);fail+=1;break
        args=[]
        if name=='r420_real_byte_state':args=[str(root/'corpus'/'english_manual.txt')]
        try:p=subprocess.run([str(binary),*args],cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=300)
        except subprocess.TimeoutExpired as e:
            (out/f'{name}.{cc}.run.log').write_bytes((e.stderr or b''))
            print(f'{name}\t{cc.upper()}_TIMEOUT\t{time.time()-start:.2f}',flush=True);fail+=1;break
        (out/f'{name}.{cc}.csv').write_bytes(p.stdout);(out/f'{name}.{cc}.run.log').write_bytes(p.stderr)
        if p.returncode:
            print(f'{name}\t{cc.upper()}_RUN_FAIL_{p.returncode}\t{time.time()-start:.2f}',flush=True);fail+=1;break
        outputs[cc]=p.stdout
    else:
        if outputs['gcc']!=outputs['clang']:
            print(f'{name}\tDIFFERENTIAL_FAIL\t{time.time()-start:.2f}',flush=True);fail+=1;continue
        preserved=(root/'results'/'gcc'/f'{base}.csv').read_bytes()
        if outputs['gcc']!=preserved:
            print(f'{name}\tPRESERVED_MISMATCH\t{time.time()-start:.2f}',flush=True);fail+=1;continue
        print(f'{name}\tPASS\t{time.time()-start:.2f}',flush=True)
print(f'SELECTED_FAILURES={fail}',flush=True)
raise SystemExit(1 if fail else 0)

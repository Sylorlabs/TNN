#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,sys
from pathlib import Path
from collections import defaultdict
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from entity_aeif_factorial import World,make_training,Rep,Model,eval_model
ARCHS=['AE_PURE','AE_ACTIVE','AEIF_ACTIVE','FOUNDRY_HYBRID','G_ACTIVE','G_ALL','G_MULTIVIEW','G_TEMPORAL']
DOSES=[2,4,8,16,32,64,128,256,512,1024]

def run_mode(mode,out,seeds=5,seed_base=283000,n_trials=2):
 rows=[]
 for si in range(seeds):
  seed=seed_base+si;w=World(seed)
  for dose in DOSES:
   views=make_training(w,mode,dose,seed+77+dose*17);rep=Rep(views)
   for a in ARCHS:
    m=Model(a,rep,w,seed+333);met=eval_model(m,w,seed+1000+dose*3,n_trials);rows.append({'seed':seed,'mode':mode,'dose':dose,'arch':a,'graph':a.startswith('G_'),**met})
  print('seed',seed,'done',flush=True)
 Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','mode':mode,'doses':DOSES,'archs':ARCHS,'rows':rows},indent=2))
 print('rows',len(rows))

def combine(files,out):
 rows=[]
 for f in files:rows+=json.loads(Path(f).read_text())['rows']
 g=defaultdict(list)
 for r in rows:g[(r['arch'],r['mode'],r['dose'])].append(r)
 s=[]
 for (a,m,d),rs in g.items():
  z={'arch':a,'mode':m,'dose':d,'graph':a.startswith('G_'),'n':len(rs)}
  for k in ['overall','floor','viewpoint','occlusion80','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption','compound','extra_rate']:
   v=np.array([r[k] for r in rs]);z[k]=float(v.mean());z[k+'_sd']=float(v.std())
  s.append(z)
 # plateau classifier per arch/mode over final 4 doses
 curves=[]
 for a in ARCHS:
  for m in sorted(set(r['mode'] for r in rows)):
   ss=sorted([x for x in s if x['arch']==a and x['mode']==m],key=lambda x:x['dose'])
   if not ss:continue
   tail=ss[-4:];slope=(tail[-1]['overall']-tail[0]['overall'])/(np.log2(tail[-1]['dose'])-np.log2(tail[0]['dose']))
   curves.append({'arch':a,'mode':m,'final_dose':ss[-1]['dose'],'final_overall':ss[-1]['overall'],'final_floor':ss[-1]['floor'],'tail_gain':tail[-1]['overall']-tail[0]['overall'],'gain_per_doubling':float(slope),'classification':'PLATEAU' if abs(slope)<.01 else 'IMPROVING' if slope>0 else 'REGRESSING'})
 Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'summary':s,'curves':curves},indent=2))
 print(json.dumps(sorted(curves,key=lambda x:(x['final_floor'],x['final_overall']),reverse=True)[:30],indent=2))

if __name__=='__main__':
 ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);a=sp.add_parser('mode');a.add_argument('--mode',required=True);a.add_argument('--out',required=True);a.add_argument('--seeds',type=int,default=5);a.add_argument('--n-trials',type=int,default=2);b=sp.add_parser('combine');b.add_argument('--out',required=True);b.add_argument('files',nargs='+');x=ap.parse_args();run_mode(x.mode,x.out,x.seeds,n_trials=x.n_trials) if x.cmd=='mode' else combine(x.files,x.out)

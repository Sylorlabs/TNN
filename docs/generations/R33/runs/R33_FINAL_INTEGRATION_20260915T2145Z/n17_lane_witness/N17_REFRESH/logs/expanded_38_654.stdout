#!/usr/bin/env python3
from __future__ import annotations
import argparse,json
from pathlib import Path
from collections import defaultdict
import numpy as np
from sklearn.linear_model import Ridge
from sklearn.ensemble import RandomForestRegressor,HistGradientBoostingRegressor
from experiments_memory_v3 import make_episode,feat,sufficient,COST,fixed_choose

POLICIES=['PRIVILEGED_HEURISTIC_CONTROL','LRU','RANDOM','EXACT_ALL','STRUCTURED_ALL','DELAYED_Q_LINEAR','DELAYED_Q_RF','DELAYED_Q_HGB','DELAYED_Q_ENSEMBLE']

class QLearner:
 def __init__(self,kind,dev,seed):
  self.kind=kind;self.rng=np.random.default_rng(seed);self.models=[]
  # Developmental exploration: only outcomes of actually chosen storage actions are training targets.
  by=[[] for _ in range(4)];ty=[[] for _ in range(4)]
  for r in dev:
   a=int(self.rng.integers(4));pressure=float(self.rng.uniform(0,1));x=np.r_[feat(r),pressure]
   ok=sufficient(a,r['q']);reward=r['importance']*(1 if ok else -1)-(.03+.32*pressure)*COST[a]+(.08*r['retrieval'] if a==0 else 0)
   by[a].append(x);ty[a].append(reward)
  for a in range(4):
   X=np.stack(by[a]);y=np.asarray(ty[a])
   if kind=='linear':m=Ridge(alpha=2).fit(X,y)
   elif kind=='rf':m=RandomForestRegressor(n_estimators=20,max_depth=8,min_samples_leaf=6,random_state=seed+a,n_jobs=1).fit(X,y)
   elif kind=='hgb':m=HistGradientBoostingRegressor(max_iter=55,max_leaf_nodes=12,l2_regularization=.3,random_state=seed+a).fit(X,y)
   else:raise ValueError(kind)
   self.models.append(m)
 def values(self,r,pressure):
  x=np.r_[feat(r),pressure].reshape(1,-1);return np.array([float(m.predict(x)[0]) for m in self.models])
 def choose(self,r,pressure):
  q=self.values(r,pressure);a=int(np.argmax(q));return a,float(q[a])

class Ensemble:
 def __init__(self,dev,seed):self.a=QLearner('linear',dev,seed);self.b=QLearner('hgb',dev,seed+17)
 def values(self,r,p):return .25*self.a.values(r,p)+.75*self.b.values(r,p)
 def choose(self,r,p):q=self.values(r,p);a=int(np.argmax(q));return a,float(q[a])

def simulate(name,seed,dev,n=1400,budget=850):
 rng=np.random.default_rng(seed)
 if name=='DELAYED_Q_LINEAR':pol=QLearner('linear',dev,seed)
 elif name=='DELAYED_Q_RF':pol=QLearner('rf',dev,seed)
 elif name=='DELAYED_Q_HGB':pol=QLearner('hgb',dev,seed)
 elif name=='DELAYED_Q_ENSEMBLE':pol=Ensemble(dev,seed)
 else:pol=None
 entries={};used=0.;queries=defaultdict(list);episodes=[];by=defaultdict(list);storage=[];evict=0
 for i in range(n):
  r=make_episode(rng,i);episodes.append(r);pressure=min(1.,used/budget)
  if pol:a,val=pol.choose(r,pressure)
  else:a=fixed_choose(name,r,i,rng);val=0
  den=(val/(COST[a]+.15)) if pol and COST[a]>0 else (None if not pol else -1e9)
  entries[i]={'a':a,'r':r,'last':i,'den':den};used+=COST[a];queries[i+r['delay']].append(i)
  while used>budget:
   cand=[(eid,e) for eid,e in entries.items() if COST[e['a']]>0]
   if not cand:break
   if pol:eid,e=min(cand,key=lambda z:z[1]['den'])
   else:eid,e=min(cand,key=lambda z:z[1]['last'])
   used-=COST[e['a']];del entries[eid];evict+=1
  for eid in queries.get(i,[]):
   rr=episodes[eid];e=entries.get(eid);by[rr['q']].append(bool(e is not None and sufficient(e['a'],rr['q']))); 
   if e:e['last']=i
  storage.append(used)
 for t in range(n,n+330):
  for eid in queries.get(t,[]):
   rr=episodes[eid];e=entries.get(eid);by[rr['q']].append(bool(e is not None and sufficient(e['a'],rr['q'])))
 allv=[x for v in by.values() for x in v]
 return {'policy':name,'seed':seed,'overall':float(np.mean(allv)),'exact':float(np.mean(by[0])),'semantic':float(np.mean(by[1])),'source':float(np.mean(by[2])),'procedure':float(np.mean(by[3])),'mean_storage':float(np.mean(storage)),'evictions':evict}

def run(out,seeds=5,dev_n=6000,offset=0):
 rows=[]
 for local in range(seeds):
  si=offset+local;rng=np.random.default_rng(283000+si);dev=[make_episode(rng,i) for i in range(dev_n)]
  for p in POLICIES:rows.append(simulate(p,284000+si+abs(hash(p))%8000,dev))
  print('seed',si,'done',flush=True)
 g=defaultdict(list)
 for r in rows:g[r['policy']].append(r)
 s=[]
 for p,rs in g.items():
  z={'policy':p,'n':len(rs)}
  for k in ['overall','exact','semantic','source','procedure','mean_storage','evictions']:
   v=np.array([r[k] for r in rs],float);z[k]=float(v.mean());z[k+'_sd']=float(v.std())
  z['utility']=.38*z['exact']+.19*z['semantic']+.19*z['source']+.24*z['procedure']-.0001*z['mean_storage'];s.append(z)
 s=sorted(s,key=lambda x:x['utility'],reverse=True);Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE','development_exploration':dev_n,'rows':rows,'summary':s},indent=2));print(json.dumps(s,indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--out',required=True);ap.add_argument('--seeds',type=int,default=5);ap.add_argument('--dev-n',type=int,default=6000);ap.add_argument('--offset',type=int,default=0);a=ap.parse_args();run(a.out,a.seeds,a.dev_n,a.offset)

#!/usr/bin/env python3
import argparse,json,random,time
from pathlib import Path
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
import sys
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
import speech_r28 as s

torch.set_num_threads(2)

class AcousticPAM(nn.Module):
    def __init__(self, classes=13):
        super().__init__()
        self.conv=nn.Sequential(
            nn.Conv1d(1,24,5,padding=2),nn.GELU(),
            nn.Conv1d(24,32,5,stride=2,padding=2),nn.GELU(),
            nn.Conv1d(32,40,5,padding=2),nn.GELU())
        self.rnn=nn.GRU(40,40,num_layers=1,batch_first=True,bidirectional=True)
        self.out=nn.Linear(80,classes)
    def forward(self,x,lengths):
        z=self.conv(x[:,None,:]).transpose(1,2)
        outlen=(lengths+1)//2
        z,_=self.rnn(z)
        return self.out(z),outlen

def make_dataset(base_seed,n,hard=True,motifs=12,count=4,sample_seed=None):
    bases={e:s.base_template(base_seed,e) for e in range(motifs)};r=np.random.default_rng((base_seed+777) if sample_seed is None else sample_seed);rows=[]
    for _ in range(n):
        ids=r.choice(motifs,count,replace=False).tolist();x=s.phrase(bases,ids,r,hard=hard).astype(np.float32)
        # Whole-utterance normalization only; no motif boundaries.
        x=(x-x.mean())/(x.std()+1e-6)
        rows.append((x,np.array([i+1 for i in ids],dtype=np.int64)))
    return rows

def batches(rows,bs,rng):
    idx=np.arange(len(rows));rng.shuffle(idx)
    for st in range(0,len(rows),bs):
        ids=idx[st:st+bs];L=max(len(rows[i][0]) for i in ids);x=np.zeros((len(ids),L),np.float32);lens=[];ys=[]
        for j,i in enumerate(ids):
            a,y=rows[i];x[j,:len(a)]=a;lens.append(len(a));ys.extend(y.tolist())
        yield torch.from_numpy(x),torch.tensor(lens,dtype=torch.long),torch.tensor(ys,dtype=torch.long),torch.full((len(ids),),4,dtype=torch.long)

def greedy(logits,lengths):
    pred=logits.argmax(-1).cpu().numpy();out=[]
    for p,L in zip(pred,lengths.cpu().numpy()):
        seq=[];last=-1
        for v in p[:L]:
            v=int(v)
            if v!=0 and v!=last:seq.append(v-1)
            last=v
        out.append(seq)
    return out

def evaluate(model,rows,bs=32):
    model.eval();acc=[];exact=[]
    with torch.no_grad():
        for x,lens,ys,yl in batches(rows,bs,np.random.default_rng(1)):
            logits,ol=model(x,lens);decs=greedy(logits,ol)
            for dec,truth in zip(decs,[r[1]-1 for r in rows[len(acc):len(acc)+len(decs)]]):
                # This indexing is unsafe with shuffle; below replaced in independent loop.
                pass
    # deterministic direct batches preserving order
    acc=[];exact=[]
    for st in range(0,len(rows),bs):
        rr=rows[st:st+bs];L=max(len(a) for a,_ in rr);x=np.zeros((len(rr),L),np.float32);lens=[]
        for j,(a,y) in enumerate(rr):x[j,:len(a)]=a;lens.append(len(a))
        with torch.no_grad():logits,ol=model(torch.from_numpy(x),torch.tensor(lens));decs=greedy(logits,ol)
        for dec,(_,y) in zip(decs,rr):
            truth=(y-1).tolist();a=sum(int(i==j) for i,j in zip(dec,truth))/4 if len(dec)==4 else 0.;acc.append(a);exact.append(a==1)
    return float(np.mean(acc)),float(np.mean(exact))

def run(seed,train_n=800,epochs=18):
    torch.manual_seed(seed%100000);np.random.seed(seed%2**32);random.seed(seed)
    train=make_dataset(seed,train_n,True,sample_seed=seed+777);val=make_dataset(seed,160,True,sample_seed=seed+100000);test=make_dataset(seed,240,True,sample_seed=seed+200000)
    model=AcousticPAM();opt=torch.optim.AdamW(model.parameters(),lr=2e-3,weight_decay=1e-4);ctc=nn.CTCLoss(blank=0,zero_infinity=True)
    hist=[];rng=np.random.default_rng(seed+9);best=None;bestva=-1
    for ep in range(epochs):
        model.train();losses=[]
        for x,lens,y,yl in batches(train,32,rng):
            opt.zero_grad();logits,ol=model(x,lens);loss=ctc(F.log_softmax(logits,2).transpose(0,1),y,ol,yl);loss.backward();torch.nn.utils.clip_grad_norm_(model.parameters(),2.);opt.step();losses.append(float(loss))
        va,vex=evaluate(model,val);hist.append({'epoch':ep+1,'loss':float(np.mean(losses)),'val_accuracy':va,'val_exact':vex})
        if va>bestva:bestva=va;best={k:v.detach().clone() for k,v in model.state_dict().items()}
    model.load_state_dict(best);ta,te=evaluate(model,test)
    # harder transfer: same motif generator, longer unrelated sequence length 5, not seen in training count=4
    hard5=make_dataset(seed,160,True,count=5,sample_seed=seed+300000)
    # custom evaluate generalized sequence length
    model.eval();a5=[];e5=[]
    for st in range(0,len(hard5),32):
        rr=hard5[st:st+32];L=max(len(a) for a,_ in rr);x=np.zeros((len(rr),L),np.float32);lens=[]
        for j,(a,y) in enumerate(rr):x[j,:len(a)]=a;lens.append(len(a))
        with torch.no_grad():logits,ol=model(torch.from_numpy(x),torch.tensor(lens));decs=greedy(logits,ol)
        for dec,(_,y) in zip(decs,rr):
            truth=(y-1).tolist();v=sum(int(i==j) for i,j in zip(dec,truth))/5 if len(dec)==5 else 0.;a5.append(v);e5.append(v==1)
    return {'seed':seed,'train_n':train_n,'epochs':epochs,'best_val':bestva,'test_accuracy':ta,'test_exact':te,'hard5_accuracy':float(np.mean(a5)),'hard5_exact':float(np.mean(e5)),'history':hist}

if __name__=='__main__':
    ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);ap.add_argument('--train-n',type=int,default=800);ap.add_argument('--epochs',type=int,default=18);a=ap.parse_args();o=run(a.seed,a.train_n,a.epochs);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps({k:v for k,v in o.items() if k!='history'},indent=2))

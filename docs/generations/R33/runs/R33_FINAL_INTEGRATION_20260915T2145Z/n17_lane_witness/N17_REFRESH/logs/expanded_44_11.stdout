#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,sys
from pathlib import Path
from collections import defaultdict
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r27-factorial-master/experiments')
from entity_factorial import make_world,candidate_pool,render,core_signature
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph')
from experiments_aeif_factorial import IdentityModel,adversarial_signature
from experiments_training_curves import choose

CONFIGS=[('AE_ACTIVE','BALANCED_EXPOSURE',32),('AEIF_FULL','MAX_DIVERSITY',128),('G_ACTIVE','MAX_DIVERSITY',128),('AE_PURE','COUNTEREXAMPLE_HEAVY',16),('FOUNDRY_HYBRID_NG','BALANCED_EXPOSURE',32)]
CONDS=['viewpoint','occlusion90_same','true_switch','switch_occluded85','long_gap_twin_switch','crossing_switch','nonlinear_sensor','high_conf_attack','twin_mix','double_reappearance','compound_same']

def obs_sig(w,e,k,r):x,v=render(w.bases[e],k,r);return core_signature(x,v)
def step_active(m,s,target,w,r):
 pred,conf,rel=m.observe(s);extra=0
 if m.wants_extra(s,pred,rel):
  extra=1;pred,conf,rel=m.observe(obs_sig(w,target,'hard_permute',r))
 return pred,rel,extra

def trial(m,w,e,c,seed):
 r=np.random.default_rng(seed);m.reset();m.observe(obs_sig(w,e,'clean',r));target=e;extra=0
 t=w.twin_of[e] if w.twin_of[e]>=0 else (e+1)%m.n
 if c=='viewpoint':s=obs_sig(w,e,'hard_permute',r);pred,rel,ex=step_active(m,s,e,w,r)
 elif c=='occlusion90_same':
  x=w.bases[e].copy();v=np.ones(len(x),bool);idx=r.choice(len(x),int(.90*len(x)),replace=False);v[idx]=False;x[idx]=0;s=core_signature(x,v);pred,rel,ex=step_active(m,s,e,w,r)
 elif c=='true_switch':target=t;s=obs_sig(w,t,'hard_permute',r);pred,rel,ex=step_active(m,s,t,w,r)
 elif c=='switch_occluded85':
  target=t;x=w.bases[t].copy();v=np.ones(len(x),bool);idx=r.choice(len(x),int(.85*len(x)),replace=False);v[idx]=False;x[idx]=0;s=core_signature(x,v);pred,rel,ex=step_active(m,s,t,w,r)
 elif c=='long_gap_twin_switch':
  for _ in range(40):m.observe(None)
  target=t;s=obs_sig(w,t,'compound',r);pred,rel,ex=step_active(m,s,t,w,r)
 elif c=='crossing_switch':
  raw=.5*w.bases[e]+.5*w.bases[t]+r.normal(0,.08,len(w.bases[e]));m.observe(core_signature(raw[r.permutation(len(raw))]));target=t;s=obs_sig(w,t,'hard_permute',r);pred,rel,ex=step_active(m,s,t,w,r)
 elif c=='nonlinear_sensor':
  raw=np.log1p(np.maximum(w.bases[e],0))*r.uniform(.8,1.3)+r.normal(0,.04,len(w.bases[e]));s=core_signature(raw[r.permutation(len(raw))]);pred,rel,ex=step_active(m,s,e,w,r)
 elif c=='high_conf_attack':s=adversarial_signature(m,w,e,r,tries=55);pred,rel,ex=step_active(m,s,e,w,r)
 elif c=='twin_mix':
  a=r.uniform(.42,.58);raw=a*w.bases[e]+(1-a)*w.bases[t]+r.normal(0,.025,len(w.bases[e]));s=core_signature(raw[r.permutation(len(raw))]);p=m.appearance(s);margin=float(np.sort(p)[-1]-np.sort(p)[-2]);pred,rel,ex=step_active(m,s,e,w,r);return int(pred==e if ex else margin<.15),ex,rel
 elif c=='double_reappearance':
  m.observe(None);m.observe(obs_sig(w,t,'hard_permute',r));m.observe(None);s=obs_sig(w,e,'compound',r);pred,rel,ex=step_active(m,s,e,w,r)
 elif c=='compound_same':s=obs_sig(w,e,'compound',r);pred,rel,ex=step_active(m,s,e,w,r)
 else:raise ValueError(c)
 return int(pred==target),ex,rel

def run(out,offset=0,seeds=2,n=10):
 rows=[]
 for local in range(seeds):
  qi=offset+local;seed=301000+qi;w=make_world(seed);pool=candidate_pool(w,seed,per_entity=128)
  for arch,mode,dose in CONFIGS:
   views=choose(w,pool,mode,dose,seed+71);m=IdentityModel(arch).fit(views,w,seed+99);by=defaultdict(list);extras=[];rels=[]
   for ci,c in enumerate(CONDS):
    for j in range(n):
     e=(seed+ci*7+j*5)%m.n;ok,ex,rel=trial(m,w,e,c,seed*100000+ci*1000+j);by[c].append(ok);extras.append(ex);rels.append(rel)
   met={k:float(np.mean(v)) for k,v in by.items()};met['overall']=float(np.mean([x for v in by.values() for x in v]));met['hard_floor']=min(met.values());met['extra_rate']=float(np.mean(extras));rows.append({'qseed':qi,'arch':arch,'training':mode,'dose':dose,**met})
  print('qseed',qi,'done',flush=True)
 g=defaultdict(list)
 for r in rows:g[(r['arch'],r['training'],r['dose'])].append(r)
 s=[]
 for (a,t,d),rs in g.items():
  z={'arch':a,'training':t,'dose':d,'n_seeds':len(rs),'n_trials_per_condition':n}
  for k in ['overall','hard_floor',*CONDS,'extra_rate']:
   v=np.array([r[k] for r in rs]);z[k]=float(v.mean());z[k+'_sd']=float(v.std())
  s.append(z)
 Path(out).write_text(json.dumps({'status':'SEALED_REFERENCE_QUALIFICATION_NOT_NATIVE','conditions':CONDS,'rows':rows,'summary':sorted(s,key=lambda x:(x['hard_floor'],x['overall']),reverse=True)},indent=2));print(json.dumps(sorted(s,key=lambda x:(x['hard_floor'],x['overall']),reverse=True),indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--out',required=True);ap.add_argument('--offset',type=int,default=0);ap.add_argument('--seeds',type=int,default=2);ap.add_argument('--n',type=int,default=10);a=ap.parse_args();run(a.out,a.offset,a.seeds,a.n)

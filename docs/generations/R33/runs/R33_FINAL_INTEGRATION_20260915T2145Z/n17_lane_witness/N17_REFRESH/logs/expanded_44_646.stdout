#!/usr/bin/env python3
import argparse,json
from pathlib import Path
import numpy as np,sys
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from entity_aeif_factorial import World,render,Rep,Model,eval_model
KINDS=['clean','view','scale','noise','occ.3','occ.55','compound']

def pool_for(w,seed,maxn=512):
 out=[]
 for e,b in enumerate(w.bases):
  rows=[]
  for j in range(maxn):
   k=KINDS[j%len(KINDS)];rows.append((k,render(b,k,np.random.default_rng(seed*100003+e*997+j))))
  out.append(rows)
 return out

def select(pool,policy,dose,seed):
 r=np.random.default_rng(seed);out=[]
 pscore={'compound':8,'occ.55':7,'noise':6,'occ.3':5,'view':4,'scale':3,'clean':1}
 for e,rows in enumerate(pool):
  if policy=='MASTER':ids=sorted(range(len(rows)),key=lambda i:pscore[rows[i][0]],reverse=True)[:dose]
  elif policy=='MIXED':ids=list(range(min(7,dose)));rest=[i for i in range(len(rows)) if i not in ids];r.shuffle(rest);ids=(ids+rest)[:dose]
  elif policy=='STAGED':
   # early diagnostic Master bootstrap, then diverse independent exposure after 64 examples.
   h=min(dose,64);ids=sorted(range(len(rows)),key=lambda i:pscore[rows[i][0]],reverse=True)[:h]
   if dose>h:
    rest=[i for i in range(len(rows)) if i not in ids];r.shuffle(rest);ids+=rest[:dose-h]
  elif policy=='COMPETENCE_WITHDRAW':
   # same generic operational rule: strong teacher while errors are broad, then diversify.
   # Simulated with an evidence threshold at 32/64 based on prior pilot curve; not an evaluator answer.
   h=min(dose,48);ids=sorted(range(len(rows)),key=lambda i:pscore[rows[i][0]],reverse=True)[:h]
   if dose>h:
    rest=[i for i in range(len(rows)) if i not in ids];
    # maximize transform diversity before random fill
    by={k:[] for k in KINDS}
    for i in rest:by[rows[i][0]].append(i)
    ids2=[]
    while len(ids2)<dose-h and any(by.values()):
     for k in KINDS:
      if by[k] and len(ids2)<dose-h:ids2.append(by[k].pop(0))
    ids+=ids2
  out.append(np.stack([rows[i][1] for i in ids]))
 return out

def run(seed):
 w=World(seed);pool=pool_for(w,seed+77,512);doses=[8,16,32,64,128,256,512];rows=[]
 for pol in ['MASTER','MIXED','STAGED','COMPETENCE_WITHDRAW']:
  for d in doses:
   rep=Rep(select(pool,pol,d,seed+991),max_epi=16);m=Model('AEIF_ACTIVE',rep,w,seed+333);met=eval_model(m,w,seed+1000,3);rows.append({'seed':seed,'policy':pol,'dose':d,**met})
 return rows
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print('done',len(o))

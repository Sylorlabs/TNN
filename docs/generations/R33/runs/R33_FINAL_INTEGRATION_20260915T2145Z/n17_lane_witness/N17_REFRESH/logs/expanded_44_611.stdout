#!/usr/bin/env python3
import json,sys
from pathlib import Path
import numpy as np
from sklearn.cluster import MiniBatchKMeans
sys.path.insert(0,str(Path(__file__).parent));from integrated_r28 import motif_template
from speech_integrated_train_r28 import vary_int

def rs(z,W=28):
 x=np.interp(np.linspace(0,len(z)-1,W),np.arange(len(z)),z);return (x-x.mean())/(x.std()+1e-8)
def pairseg(a,b,r):
 za=vary_int(a,r);zb=vary_int(b,r);out=za.tolist();ov=min(4,len(zb),len(out))
 for j in range(ov):
  al=(j+1)/(ov+1);out[-ov+j]=(1-al)*out[-ov+j]+al*zb[j]
 zb=zb[ov:];st=len(out);out.extend(zb.tolist());return rs(np.array(out)[max(0,st-4):])
def train(seed,bases,K=5,n=80):
 r=np.random.default_rng(seed);M=len(bases);D=28;plain=[];ctx=[[None]*M for _ in range(M)]
 for b in range(M):
  X=np.stack([rs(vary_int(bases[b],r)) for _ in range(n)]);plain.append(MiniBatchKMeans(K,random_state=seed+b,n_init=3,batch_size=128).fit(X).cluster_centers_)
 for a in range(M):
  for b in range(M):
   X=np.stack([pairseg(bases[a],bases[b],r) for _ in range(n)]);ctx[a][b]=MiniBatchKMeans(K,random_state=seed+a*31+b,n_init=2,batch_size=128).fit(X).cluster_centers_
 return np.stack(plain),np.asarray(ctx)
def classify(z,C):
 x=rs(z);return int(np.argmin([np.min(np.mean((C[i]-x)**2,axis=1)) for i in range(len(C))]))
def run(seed=281000,trials=100,K=5,n=60):
 bases={e:motif_template(seed+1200,e) for e in range(24)};P,C=train(seed+400,bases,K,n);r=np.random.default_rng(seed+9000);plain=[];ctx=[]
 for _ in range(trials):
  ids=r.choice(24,3,replace=False).tolist();out=[];sp=[]
  for ii,e in enumerate(ids):
   z=vary_int(bases[e],r);st=len(out)
   if ii>0:
    ov=min(4,len(z),len(out))
    for j in range(ov):
     al=(j+1)/(ov+1);out[-ov+j]=(1-al)*out[-ov+j]+al*z[j]
    z=z[ov:];st=len(out)
   out.extend(z.tolist());sp.append((st,len(out),e))
  x=np.array(out)
  for i,(st,en,e) in enumerate(sp):
   z=x[max(0,st-4):en];plain.append(classify(z,P)==e);ctx.append(classify(z,P)==e if i==0 else classify(z,C[ids[i-1]])==e)
 return {'seed':seed,'K':K,'n':n,'plain':float(np.mean(plain)),'context_mixture':float(np.mean(ctx))}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/acoustic_context_mixture.json').write_text(json.dumps(o,indent=2))

#!/usr/bin/env python3
import argparse,json
from pathlib import Path
import numpy as np
from sklearn.linear_model import Ridge

def run(seed,n=30,actions=4,ctxd=6,train_ctx=24,test_ctx=60):
 r=np.random.default_rng(seed)
 # visual appearance includes near twins; action physics intentionally independent enough to break appearance shortcuts.
 visual=r.normal(size=(n,16))
 for i in range(1,min(24,n),2):visual[i]=visual[i-1]+r.normal(0,.06,16)
 # entity/action context coefficients; twins deliberately receive different coefficients.
 bias=r.normal(0,1,(n,actions));W=r.normal(0,.55,(n,actions,ctxd))
 # learner: per persistent entity/action predictive model from observed consequences, no category labels.
 models=[[None]*actions for _ in range(n)]
 for e in range(n):
  for a in range(actions):
   X=r.normal(size=(train_ctx,ctxd));y=bias[e,a]+X@W[e,a]+r.normal(0,.08,train_ctx);models[e][a]=Ridge(alpha=.3).fit(X,y)
 # visual-category shortcut control: nearest appearance group transfers coefficients from visually closest training entity.
 nearest=[]
 for e in range(n):
  d=np.linalg.norm(visual-visual[e],axis=1);d[e]=1e9;nearest.append(int(np.argmin(d)))
 exact=[];choice=[];shortcut=[];mismatch=[];hard_noise=[]
 for e in range(n):
  X=r.normal(size=(test_ctx,ctxd));truth=np.stack([bias[e,a]+X@W[e,a] for a in range(actions)],1)
  pred=np.stack([models[e][a].predict(X) for a in range(actions)],1)
  exact.extend(np.abs(pred-truth).ravel()<.25);choice.extend(np.argmax(pred,1)==np.argmax(truth,1))
  ne=nearest[e];sp=np.stack([models[ne][a].predict(X) for a in range(actions)],1);shortcut.extend(np.argmax(sp,1)==np.argmax(truth,1))
  if e<24:mismatch.extend(np.argmax(pred,1)==np.argmax(truth,1))
  Xn=X+r.normal(0,.2,X.shape);pn=np.stack([models[e][a].predict(Xn) for a in range(actions)],1);hard_noise.extend(np.argmax(pn,1)==np.argmax(truth,1))
 return {'seed':seed,'effect_within_0.25':float(np.mean(exact)),'best_action_unseen_context':float(np.mean(choice)),'appearance_shortcut_control':float(np.mean(shortcut)),'lookalike_behavior_mismatch':float(np.mean(mismatch)),'noisy_context_best_action':float(np.mean(hard_noise))}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

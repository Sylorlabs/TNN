 Xaction=[];Xhist=[];Xdyn=[];resource_features=[];adv=[];split=[];episode=[];mode_meta=[];resource_meta=[];trial_meta=[];actual_cost_meta=[];raw_cost_meta=[];cons_meta=[];true_next=[];ens_next=[];model_next=[];weights=[];losses=[]
 eid=0
 for mi,mode in enumerate(MODES):

d74384efa25d82b1be46f4c61a62f5f0c6e9bdfe blob 5963
name: R32 E51A Agent Native Audit

on:
  push:
    branches:
      - r32-agent-sequential-frontier
  pull_request:
    branches:
      - main

permissions:
  contents: read

jobs:
  audit:
    name: E51A arm ${{ matrix.arm }}
    runs-on: ubuntu-latest
    timeout-minutes: 120
    strategy:
      fail-fast: false
      matrix:
        arm: [A, B, C, D]
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Generate frozen arm
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          src="Research/tnn_r32_e51a_${arm}.zag"
          mkdir -p ".scratch/e51a/${arm}"
          cp Research/tnn_r32_e50_provenance_temporal_contention_discriminator.zag "$src"
          test "$(grep -cF 'fn e45_qualification_main_unused()i32 {' "$src")" -eq 1
          test "$(grep -cF 'fn main()i32 {' "$src")" -eq 1
          sed -i 's/^fn main()i32 {/fn e50_main_unused()i32 {/' "$src"
          sed -i 's/^fn e45_qualification_main_unused()i32 {/fn main()i32 {/' "$src"
          if [[ "$arm" == B || "$arm" == D ]]; then
            test "$(grep -cF 'if(training_phase==2 && learned_credit>0 && training_reachable==1){' "$src")" -eq 1
            sed -i 's/if(training_phase==2 && learned_credit>0 && training_reachable==1){/if(training_phase==2 \&\& training_reachable==1){/' "$src"
          fi
          if [[ "$arm" == C || "$arm" == D ]]; then
            test "$(grep -cF 'let continue_value:i32=e45_arm_continue_value(arm,predicted);' "$src")" -eq 1
            sed -i 's/let continue_value:i32=e45_arm_continue_value(arm,predicted);/let continue_value:i32=predicted;/' "$src"
          fi
          sha256sum "$src" | tee ".scratch/e51a/${arm}/SOURCE_SHA256.txt"
          printf 'arm=%s\n' "$arm" > ".scratch/e51a/${arm}/ARM.txt"
          grep -nF 'if(training_phase==2' "$src" > ".scratch/e51a/${arm}/TRAINING_GATE.txt"
          grep -nF 'let continue_value:i32=' "$src" > ".scratch/e51a/${arm}/CONTINUE_VALUE.txt"

      - name: Compile twice with persisted official Zag compiler
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          src="Research/tnn_r32_e51a_${arm}.zag"
          out=".scratch/e51a/${arm}"
          compiler='Research/toolchain/znc_linux_x86_64_abed8aa1'
          chmod +x "$compiler"
          "$compiler" "$src" -o "$out/NATIVE_BUILD_1" > "$out/NATIVE_BUILD_1_COMPILE.log" 2>&1
          "$compiler" "$src" -o "$out/NATIVE_BUILD_2" > "$out/NATIVE_BUILD_2_COMPILE.log" 2>&1
          sha256sum "$out/NATIVE_BUILD_1" "$out/NATIVE_BUILD_2" | tee "$out/BINARY_SHA256.txt"
          cmp "$out/NATIVE_BUILD_1" "$out/NATIVE_BUILD_2"
          echo 1 > "$out/BYTE_IDENTICAL.txt"

      - name: Execute native arm
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          out=".scratch/e51a/${arm}"
          set +e
          timeout 3600 "$out/NATIVE_BUILD_1" > "$out/RAW.log" 2>&1
          code=$?
          set -e
          printf '%s\n' "$code" > "$out/EXIT_CODE.txt"
          grep -E '^(TNN_R32_E45_NATIVE_QUALIFICATION_GATE=|no_unique_d_|known_truth_|causal_completion_regret_gate|baseline_parity_gate|oracle_positive_prevalence_|shadow_control_gate|core_gate_sum)' "$out/RAW.log" > "$out/SUMMARY.txt" || true
          cat "$out/SUMMARY.txt"
          echo "native_exit_code=$code"

      - name: Preserve arm evidence
        uses: actions/upload-artifact@v4
        with:
          name: r32-e51a-${{ matrix.arm }}
          path: |
            .scratch/e51a/${{ matrix.arm }}/
            Research/tnn_r32_e51a_${{ matrix.arm }}.zag
          if-no-files-found: error
          compression-level: 6

  package:
    name: Package complete TNN project and E51A evidence
    needs: audit
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Download all E51A evidence
        uses: actions/download-artifact@v4
        with:
          pattern: r32-e51a-*
          path: Research/R32_E51A_AGENT_RUN_EVIDENCE
          merge-multiple: false

      - name: Build run report
        shell: bash
        run: |
          set -euo pipefail
          report='Research/R32_E51A_AGENT_RUN_EVIDENCE/RUN_REPORT.md'
          {
            echo '# R32 E51A Agent Native Run'
            echo
            echo "Workflow commit: $GITHUB_SHA"
            echo "Run: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
            echo
            for arm in A B C D; do
              echo "## Arm $arm"
              p="Research/R32_E51A_AGENT_RUN_EVIDENCE/r32-e51a-$arm/.scratch/e51a/$arm"
              if [[ -f "$p/SUMMARY.txt" ]]; then
                echo '```text'
                cat "$p/SUMMARY.txt"
                echo '```'
                echo "Exit code: $(cat "$p/EXIT_CODE.txt")"
                echo "Byte-identical builds: $(cat "$p/BYTE_IDENTICAL.txt")"
              else
                echo 'Arm artifact unavailable; inspect workflow job status.'
              fi
              echo
            done
          } > "$report"
          cat "$report"

      - name: Zip the entire project snapshot
        shell: bash
        run: |
          set -euo pipefail
          archive="TNN-full-project-r32-e51a-${GITHUB_SHA}.zip"
          zip -q -r "$archive" . -x '.git/*' "$archive"
          sha256sum "$archive" > "${archive}.sha256"
          ls -lh "$archive" "${archive}.sha256"

      - name: Upload complete project archive
        uses: actions/upload-artifact@v4
        with:
          name: tnn-complete-r32-e51a-${{ github.sha }}
          path: |
            TNN-full-project-r32-e51a-${{ github.sha }}.zip
            TNN-full-project-r32-e51a-${{ github.sha }}.zip.sha256
            Research/R32_E51A_AGENT_RUN_EVIDENCE/RUN_REPORT.md
          if-no-files-found: error
          compression-level: 0

d7e92c1c733f76bc626c20ba5cba8fc02a3144f7 blob 3412
# R32 E51K â€” Calibration Fit vs Generalization Audit

Date frozen: 2026-08-30
Branch: `r32-agent-sequential-frontier`
Canonical status: R27 remains canonical.

## Question

E51J showed that a state-dependent scalar calibrator can move many no-unique episodes toward safe UNKNOWN while losing too many known episodes. Because the scalar cannot alter commit ranking, the remaining question is whether this is primarily:

1. **fit/capacity failure** â€” the calibrator cannot even learn the required commit-vs-neutral mapping on development worlds; or
2. **generalization/support failure** â€” development fit is strong but the learned calibration sign/value does not transfer to fresh validation worlds.

This audit is required before changing topology or adding a larger calibrator.

## Frozen mechanism

Reproduce E51J exactly on fresh domains:

- frozen absolute-utility linear terminal head;
- scalar target = grounded utility of the learner-selected top commit;
- arm B linear scalar calibrator;
- arm C linear + up to four learner-selected data-mean hinge residual terms;
- one state-dependent scalar shift applied equally to KEEP/CURRENT/RESTORE;
- UNKNOWN fixed at zero.

No audit result is fed back into the learner.

## Partitions

- stage 46: development, 3,240 episodes / 55,080 states;
- stage 47: fresh validation, 5,400 episodes / 91,800 states;
- stage 48: confirmation, 10,800 allocated and sealed.

## Required measurements

For arms A/B/C, measure episode reachability on both:

- the development worlds used for fitting;
- the untouched validation worlds.

For scalar calibrators B/C also measure state-level **decision-side sign agreement** with the grounded utility of the learner-selected top commit. Because terminal tie-breaking keeps a commit when the calibrated top-commit score is exactly zero, the frozen audit convention is:

- positive target is correct when predicted scalar is **>= 0** (commit side);
- negative target is correct only when predicted scalar is **< 0** (UNKNOWN side).

This convention is frozen before E51K validation execution. It is not a learned threshold; it exactly matches the existing neutral UNKNOWN score and terminal tie-breaking semantics.

Report separate positive-target and negative-target accuracy on development and validation. Evaluator mode/resource breakdowns may be reported as audit-only diagnostics but are never learner inputs.

## Integrity

Require:

- E50 parent integrity;
- fresh seed allocation with zero failures;
- confirmation execution 0;
- exact development/validation counts;
- base UNKNOWN target/parameters zero;
- base and calibrator forward/reverse fit identity;
- hinge structure forward/reverse identity and nondegeneracy;
- no evaluator labels or E51I margins in learner features.

## Interpretation

- `CALIBRATOR_FIT_LIMITED`: development negative-target safety or known reachability is materially poor; next step should improve the learner objective/capacity before adding dose.
- `CALIBRATOR_GENERALIZATION_LIMITED`: development is substantially stronger than fresh validation, especially on negative-target/UNKNOWN safety; next step should run a training dose/curriculum curve with the same mechanism before architecture change.
- `CALIBRATOR_BOTH_LIMITED`: meaningful deficits exist both on development and in the development-to-validation gap.

No E51K result can promote R32 or justify topology change by itself.


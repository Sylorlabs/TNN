    let gs00:i32=0; let gr00:i32=0; let gh00:i32=0; let gl00:i64=0; let gs01:i32=0; let gr01:i32=0; let gh01:i32=0; let gl01:i64=0;
    let gs10:i32=0; let gr10:i32=0; let gh10:i32=0; let gl10:i64=0; let gs11:i32=0; let gr11:i32=0; let gh11:i32=0; let gl11:i64=0;
    e51m_fit_scalar_linear(direct_dev,direct_t0,E51AB_DEV_SAMPLES,0,g0,0,&b0,&gs00,&gr00,&gh00,&gl00); e51m_fit_scalar_linear(direct_dev,direct_t0,E51AB_DEV_SAMPLES,1,rg0f,0,&rb0f,&gs01,&gr01,&gh01,&gl01);
    e51m_fit_scalar_linear(direct_dev,direct_t1,E51AB_DEV_SAMPLES,0,g1,0,&b1,&gs10,&gr10,&gh10,&gl10); e51m_fit_scalar_linear(direct_dev,direct_t1,E51AB_DEV_SAMPLES,1,rg1f,0,&rb1f,&gs11,&gr11,&gh11,&gl11);
    let direct_gid0:i32=e51m_linear_identity(g0,0,b0,rg0f,0,rb0f,gs00,gs01,gr00,gr01,gh00,gh01,gl00,gl01); let direct_gid1:i32=e51m_linear_identity(g1,0,b1,rg1f,0,rb1f,gs10,gs11,gr10,gr11,gh10,gh11,gl10,gl11);
    let direct_global_identity:i32=0; if(direct_gid0==1 && direct_gid1==1){ direct_global_identity=1; }
    let per_direct_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let per_direct_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
    let direct_lw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_w); let direct_lb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_b); let direct_rlw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_w); let direct_rlb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_b);
    e45_zero(direct_lw,E51AB_LOCAL_DOSES*per_direct_w); e45_zero(direct_lb,E51AB_LOCAL_DOSES*per_direct_b); e45_zero(direct_rlw,E51AB_LOCAL_DOSES*per_direct_w); e45_zero(direct_rlb,E51AB_LOCAL_DOSES*per_direct_b);
    let direct_local_identity:i32=1; let direct_local_nondegenerate:i32=1; let candidate:i32=0;
    while(candidate<E51AB_CANDIDATES){
        let targets:[]i32=direct_t0; let gw:[]i32=g0; let gb:i32=b0; if(candidate==1){ targets=direct_t1; gw=g1; gb=b1; }
        let ws:i32=per_direct_w+candidate*E51AB_CELLS*E45_FEATURES; let bs:i32=per_direct_b+candidate*E51AB_CELLS;
        let u0:i32=0; let sw0:i32=0; let re0:i32=0; let tr0:i32=0; let lo0:i64=0; let sg0:i32=0; let u1:i32=0; let sw1:i32=0; let re1:i32=0; let tr1:i32=0; let lo1:i64=0; let sg1:i32=0;
        e51x_fit_experts_dose(direct_dev,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,0,384,direct_lw,ws,direct_lb,bs,&u0,&sw0,&re0,&tr0,&lo0,&sg0);
        e51x_fit_experts_dose(direct_dev,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,1,384,direct_rlw,ws,direct_rlb,bs,&u1,&sw1,&re1,&tr1,&lo1,&sg1);
        let id:i32=e51p_expert_identity(direct_lw,ws,direct_lb,bs,direct_rlw,ws,direct_rlb,bs,E51AB_CELLS,u0,u1,sw0,sw1,re0,re1,tr0,tr1,lo0,lo1,sg0,sg1); if(id==0){ direct_local_identity=0; } if(u0<=0){ direct_local_nondegenerate=0; }
        _zag_print("e51ae_direct_local384_fit,"); e45_print_i32(candidate); _zag_print(","); e45_print_i32(u0); _zag_print(","); e45_print_i32(sw0); _zag_print(","); e45_print_i32(re0); _zag_print(","); e45_print_i32(tr0); _zag_print(","); e45_print_i64(lo0); _zag_print(","); e45_print_i32(id); _zag_println(""); candidate=candidate+1;
    }
    let direct_target_support:i32=0; if(direct_pos[0]>0 && direct_neg[0]>0 && direct_pos[1]>0 && direct_neg[1]>0){ direct_target_support=1; }
    let direct_integrity:i32=0; if(direct_built==E51AB_DEV_EPISODES && direct_unknown==0 && direct_target_support==1 && direct_global_identity==1 && direct_local_identity==1 && direct_local_nondegenerate==1){ direct_integrity=1; }
    let direct_hash_before:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    e45_print_pair("e51ae_direct_reconstruction_episodes",direct_built); e45_print_pair("e51ae_direct_global_identity_gate",direct_global_identity); e45_print_pair("e51ae_direct_local_identity_gate",direct_local_identity); e45_print_pair("e51ae_direct_target_support_gate",direct_target_support); e45_print_pair("e51ae_direct_integrity_gate",direct_integrity); e45_print_pair("e51ae_direct_hash_before",direct_hash_before);
    zfree(direct_dev); zfree(direct_t0); zfree(direct_t1); zfree(direct_pos); zfree(direct_neg); zfree(rg0f); zfree(rg1f); zfree(direct_rlw); zfree(direct_rlb);



e739fb1c5f3529ceda2f8edd7a66d96891c9b71e blob 4579
fn e51ae_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,active_arm:i32,
    control_records:[]i32,direct_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local96_w:[]i32,local96_b:[]i32,local384_w:[]i32,local384_b:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32
)void {
    e45_zero(result,E51AE_ARMS*E51AE_FIELDS); e45_zero(mode_reach,E51AE_ARMS*E45_MODES); e45_zero(resource_reach,E51AE_ARMS*E45_RESOURCES);
    let accessible:[]i32=zalloc_i(episodes*(E45_TAPE+1)); e51ae_build_accessible(stage,episodes,per_cell,accessible);
    let slot_success:[]i32=zalloc_i(episodes*(E45_TAPE+1)); let direct_success:[]i32=zalloc_i(episodes*(E45_TAPE+1)); let base_kinds:[]i32=zalloc_i(episodes);
    let pc:i32=0; let dc:i32=0; let nc:i32=0;
    e51ad_prepare_support(stage,episodes,per_cell,control_records,direct_records,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,slot_success,direct_success,base_kinds,&pc,&dc,&nc);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let arm_lo:i32=0; let arm_hi:i32=E51AE_ARMS; if(active_arm>=0){ arm_lo=active_arm; arm_hi=active_arm+1; }
        let arm:i32=arm_lo;
        while(arm<arm_hi){
            let s:i32=arm*E51AE_FIELDS; result[s+E51AE_EPISODES]=result[s+E51AE_EPISODES]+1; if(no_unique==1){ result[s+E51AE_NO_UNIQUE]=result[s+E51AE_NO_UNIQUE]+1; }else{ result[s+E51AE_KNOWN]=result[s+E51AE_KNOWN]+1; }
            let reached:i32=0; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t;
                if(accessible[index]==1){
                    let rs:i32=index*E50_RECORD_N; let success:i32=0; let choice:i32=R32E45_TERM_UNKNOWN;
                    if(arm==E51AE_ARM_UNION_CONTROL){ if(slot_success[index]==1 || direct_success[index]==1){ success=1; }
                    }else{ if(arm==E51AE_ARM_DIRECT_ORACLE){ success=1; if(direct_records[rs+34]>0){ choice=E51AC_CHOICE_CANDIDATE_0; }else{ if(direct_records[rs+35]>0){ choice=E51AC_CHOICE_CANDIDATE_1; } }
                        }else{
                            let local_active:i32=0; let lw:[]i32=local96_w; let lb:[]i32=local96_b;
                            if(arm==E51AE_ARM_LOCAL_96){ local_active=1; lw=local96_w; lb=local96_b; }
                            if(arm==E51AE_ARM_LOCAL_384){ local_active=1; lw=local384_w; lb=local384_b; }
                            choice=e51ae_policy_choice(local_active,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,rg0,rb0,rg1,rb1,lw,lb);
                            success=e51ac_choice_success(choice,control_records,direct_records,rs);
                        }
                    }
                    if(t==0){ if(success==1){ result[s+E51AE_T0_SUCCESS]=result[s+E51AE_T0_SUCCESS]+1; }else{ if(arm>=E51AE_ARM_GLOBAL && arm<=E51AE_ARM_LOCAL_384){ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AE_T0_UNKNOWN]=result[s+E51AE_T0_UNKNOWN]+1; }else{ result[s+E51AE_T0_WRONG]=result[s+E51AE_T0_WRONG]+1; } } } }
                    if(success==1){ reached=1; }
                }
                t=t+1;
            }
            if(reached==1){ result[s+E51AE_REACHABLE]=result[s+E51AE_REACHABLE]+1; mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1; resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1; if(no_unique==1){ result[s+E51AE_NO_UNIQUE_REACHABLE]=result[s+E51AE_NO_UNIQUE_REACHABLE]+1; }else{ result[s+E51AE_KNOWN_REACHABLE]=result[s+E51AE_KNOWN_REACHABLE]+1; } }
            arm=arm+1;
        }
        episode=episode+1;
    }
    zfree(accessible); zfree(slot_success); zfree(direct_success); zfree(base_kinds);
}

fn e51ae_print_result(prefix:[]u8,result:[]i32,arm:i32)void {
    let s:i32=arm*E51AE_FIELDS; _zag_print(prefix); _zag_print(","); e45_print_i32(arm);
    let f:i32=0; while(f<E51AE_FIELDS){ _zag_print(","); e45_print_i32(result[s+f]); f=f+1; } _zag_println("");
}


e74720462ff326d2792ad2db8eca722696914c1b blob 3253
from __future__ import annotations
import numpy as np,json
from pathlib import Path
OUT=Path('/mnt/data/r32_epistemic');K=5;S=3
CONDS=['dominant_flip','correlated_flip','state_and_source_shift','flip_return']

def world(r,cond,T=240):
    state=int(r.integers(K)); other=(state+1+int(r.integers(K-1)))%K
    obs=[]
    for t in range(T):
        # source 0 is seen 60% of the time and begins highly reliable
        u=r.random();src=0 if u<.60 else (1 if u<.82 else 2)
        rel=[.94,.73,.68]
        if cond in ['dominant_flip','correlated_flip'] and t>=100: rel=[.15,.80,.76]
        if cond=='flip_return':
            if 75<=t<165:rel=[.12,.80,.74]
        if cond=='state_and_source_shift' and t>=105:
            state=other; rel=[.18,.82,.74]
        e=r.normal(0,.42,K);e[state]+=.55+1.05*rel[src]
        if r.random()>rel[src]:
            w=other if src==0 else int(r.integers(K));
            if w==state:w=(w+1)%K
            e[w]+=1.75;e[state]-=.45
        # correlated wrong bursts between 0 and 1
        if cond=='correlated_flip' and t>=100 and (t//8)%4==0 and src in [0,1]:
            e[other]+=1.45;e[state]-=.35
        obs.append((src,e,state))
    return obs

class Model:
 def __init__(self,kind):self.kind=kind;self.trust=np.array([.9,.72,.68]) if kind!='equal' else np.ones(S);self.score=np.zeros(K);self.hist=[];self.pending=[];self.t=0
 def step(self,src,e):
  self.t+=1; self.score=.78*self.score+self.trust[src]*e; pred=int(np.argmax(self.score)); self.hist.append((src,e.copy()))
  if len(self.hist)>18:self.hist.pop(0)
  if self.kind=='adaptive':
   self.pending.append((self.t,src,int(np.argmax(e))))
   if len(self.pending)>10:
    _,s,claim=self.pending.pop(0)
    # independent evidence consensus excludes source s entirely
    oth=[x for q,x in self.hist if q!=s]
    if len(oth)>=3:
     cons=int(np.argmax(np.mean(oth,axis=0)));reward=1 if claim==cons else -1
     self.trust[s]=float(np.clip(self.trust[s]+.055*reward,.05,1.25))
  return pred

def eval_seed(seed):
 r=np.random.default_rng(seed);out={'seed':seed}
 for c in CONDS:
  out[c]={}
  for kind in ['equal','fixed','adaptive']:
   acc=[];post=[];wrong=[];trust=[]
   for rep in range(160):
    ob=world(r,c);m=Model(kind);ok=[]
    for t,(s,e,y) in enumerate(ob):
     p=m.step(s,e);ok.append(p==y);wrong.append(p!=y and t>115)
    acc.append(np.mean(ok));post.append(np.mean(ok[120:]));trust.append(m.trust.copy())
   out[c][kind]={'accuracy':float(np.mean(acc)),'post_shift':float(np.mean(post)),'wrong':float(np.mean(wrong)),'trust':np.mean(trust,axis=0).tolist()}
 return out

def main():
 rows=[eval_seed(97500+i) for i in range(10)];agg={}
 for c in CONDS:
  agg[c]={}
  for k in ['equal','fixed','adaptive']:
   agg[c][k]={m:float(np.mean([r[c][k][m] for r in rows])) for m in ['accuracy','post_shift','wrong']}
 out={'aggregate':agg,'rows':rows,'boundary':'REFERENCE_ONLY post-100 source-reliability challenge. Learner receives only source identity, evidence vectors, and delayed independent-source agreement; hidden source reliability and evaluator world state are test-only.'}
 (OUT/'R32_SOURCE_RELIABILITY_SHIFT_HARD_REFERENCE_ONLY.json').write_text(json.dumps(out,indent=2));print(json.dumps(agg,indent=2))
if __name__=='__main__':main()

e776d1f6044ee76f7596f0e767a8d998620d2fbf blob 4057
# R32 E51 â€” Causal Map

Established: 2026-09-04. Baseline: `R32_E51_BASELINE_V1.json`.
Current evidence index: `R32_E51_MASTER_LEDGER.json`.
R27 remains canonical; R32/E51 is experimental.

## Observed lineage

```text
E51X: sufficient trajectory-optimization dose
  -> exact full-tape terminal reachability on validation + confirmation
E51Y: add cost-aware CONTINUE competition
  -> stopping/value failure despite frozen terminal reproduction
E51Z / E51AA: audit rather than enlarge the learner
  -> resource-feasible action-support limits + target/safety conflict
E51AB / E51AC: direct candidate actions and additive hybrid
  -> complementary support, but harmful overrides and union misses remain
  +-> E51AD: conservative router -> tested router did not generalize
  +-> E51AE: candidate residual -> development preservation failure
        +-> E51AF: historical prerequisites mismatch -> INVALID, never run
        +-> E51AG: current learner, three fresh partitions -> stable negative
              -> inspection: critical residual support omits slot-covered cases
              -> E51AH: grounded preservation replay [FROZEN_NOT_RUN]
```

Each arrow denotes experimental motivation, not proof of a unique cause. See
the corresponding `R32_E51*_RESULT.md` for source/run/artifact identities. The
master ledger currently indexes the E51Xâ€“E51AH frontier; older E51 experiments
remain in their individual result/preregistration files and are not re-run here.

## E51AH competing explanations

**Missing preservation support.** The critical-only residual training population
omitted slot-covered trajectories. E51AH adds one ordinary-outcome record per
development trajectory without changing the candidate interface or features.

**Discrimination, geometry, or objective limitation.** Added support may still
fail because a single chosen state per trajectory, the squared-error objective,
the available optimization dose, the frozen routing geometry, or the current
features cannot realize the required preservation/rescue behavior. A negative
replay result does not prove information-theoretic aliasing or that memory is
necessary. It rejects only this specified treatment on its tested population.

## Frozen outcome branches

| Observed E51AH condition | Interpretation and next branch |
| --- | --- |
| Integrity failure | No performance inference. Diagnose the failed gate; never relax scientific gates after exposure. |
| Valid development failure | Keep stages 109/110 sealed. Close this replay treatment; preregister a bounded discriminator for context/representation versus remaining objective/geometry explanations. |
| Exact validation and confirmation | Narrow confirmed replay result; seek fresh replication and transfer before any integration or promotion. |
| Exact validation, confirmation not confirmed | No confirmed rescue. Preserve the failed confirmation and its integrity status. |
| Paired-loss-free validation Pareto improvement | Support for this replay intervention; fresh-partition replication required. |
| Validation tradeoff | Preservation remains unresolved; advance only under a new preregistration. |
| Valid no gain | No demonstrated repair. Preserve all metrics and preregister the next diagnostic rather than tuning the consumed partition. |

## Protected boundaries

Arm 0 is an evaluator union ceiling, not a deployable combined policy. Arm 5 is
an evaluator-only diagnostic, never training evidence or a policy input. An
oracle result is evidence of action support only when its chosen action is
scored by the grounded evaluator, not when success is assigned by construction.

Development gates concern **existence of a successful resource-feasible state**,
not a learned safe stopping policy. Neither full-tape nor feasible-prefix
reachability establishes successful online stopping, continual learning,
cross-task transfer, composition, or general autonomous cognition.

No outcome changes R27 canonical status, authorizes evaluator-label leakage, or
justifies topology changes without a separate causal case.


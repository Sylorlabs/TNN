  rr=np.random.default_rng(ep.seed*2029+trial*12347+a*31+97);eps=float(rr.normal(0,.80 if ep.kind=='genuine_ambiguity' else .65))
 else:eps=float(ep.phys_noise[slot,a]*(.80 if ep.kind=='genuine_ambiguity' else .65))

 'causal_trace':'trace_emit' in s,
 'memory_authority':'memory_policy_choose' in s,
}
out={'pass':all(checks.values()),'checks':checks,'sha256':hashlib.sha256(s.encode()).hexdigest(),'lines':len(s.splitlines())}

// R32 E51P â€” learner-owned local conditional weight experts.
// The routing tree is inherited from the generic E51O learner-grown partition,
// but every routed region can learn its own scalar feature-weight correction.
// Corrections apply uniformly to commit actions, preserving commit ordering.

const E51P_DEV_EPISODES:i32=12960;
const E51P_DEV_SAMPLES:i32=220320;
const E51P_VALIDATION_EPISODES:i32=5400;
const E51P_VALIDATION_SAMPLES:i32=91800;
const E51P_CONFIRM_EPISODES:i32=10800;
const E51P_CONFIRM_SAMPLES:i32=183600;
const E51P_STAGE_DEV:i32=61;
const E51P_STAGE_VALIDATION:i32=62;
const E51P_STAGE_CONFIRM:i32=63;
const E51P_CAP_LEVELS:i32=5;
const E51P_MAX_CELLS:i32=64;
const E51P_MAX_SWEEPS:i32=12;

fn e51p_capacity(level:i32)i32 {
    if(level==0){ return 4; }
    if(level==1){ return 8; }
    if(level==2){ return 16; }
    if(level==3){ return 32; }
    return 64;
}

fn e51p_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0;
    while(i<E51P_DEV_EPISODES){ dev[i]=e51n_world_id(E51P_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51P_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51P_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51P_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51P_STAGE_CONFIRM,i); i=i+1; }
    let dev_lo:i32=dev[0]; let dev_hi:i32=dev[E51P_DEV_EPISODES-1];
    let val_lo:i32=validation[0]; let val_hi:i32=validation[E51P_VALIDATION_EPISODES-1];
    let con_lo:i32=confirmation[0]; let con_hi:i32=confirmation[E51P_CONFIRM_EPISODES-1];
    let partition_gate:i32=0; if(dev_hi<val_lo && val_hi<con_lo){ partition_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=0;
    while(domain<5){
        let lo:i64=e51n_domain_state(dev_lo,domain); let hi:i64=e51n_domain_state(con_hi,domain);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let olo:i64=e51n_domain_state(dev_lo,other); let ohi:i64=e51n_domain_state(con_hi,other);
            if(!(hi<olo || ohi<lo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51p_world_id_dev_lo",dev_lo); e45_print_pair("e51p_world_id_dev_hi",dev_hi);
    e45_print_pair("e51p_world_id_validation_lo",val_lo); e45_print_pair("e51p_world_id_validation_hi",val_hi);
    e45_print_pair("e51p_world_id_confirmation_lo",con_lo); e45_print_pair("e51p_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51p_world_partition_gate",partition_gate); e45_print_pair("e51p_domain_initial_state_gate",domain_gate); e45_print_pair("e51p_world_assignment_failures",0);
    if(partition_gate==1 && domain_gate==1){ return 1; }
    return 0;
}

fn e51p_route_cell(
    records:[]i32,
    record_start:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    cells:i32
)i32 {
    let cell:i32=0;
    let child:i32=1;
    while(child<cells){
        if(parents[child]==cell){
            let pd:i32=e51o_distance_record_proto(records,record_start,prototypes,cell*E45_FEATURES,ranges);
            let cd:i32=e51o_distance_record_proto(records,record_start,prototypes,child*E45_FEATURES,ranges);
            if(cd<pd){ cell=child; }
        }
        child=child+1;
    }
    return cell;
}

fn e51p_expert_predict(
    records:[]i32,
    record_start:i32,
    global_weights:[]i32,
    global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    cells:i32,
    expert_weights:[]i32,
    weight_start:i32,
    expert_biases:[]i32,
    bias_start:i32
)i32 {
    let cell:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,cells);
    let value:i32=e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias)+expert_biases[bias_start+cell];
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let x:i32=e50_batch_column(records,record_start,feature+1,0);
        value=value+expert_weights[weight_start+cell*E45_FEATURES+feature]*x/1000;
        feature=feature+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51p_fit_experts(
    records:[]i32,
    targets:[]i32,
    count:i32,
    global_weights:[]i32,
    global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    cells:i32,
    reverse:i32,
    expert_weights:[]i32,
    weight_start:i32,
    expert_biases:[]i32,
    bias_start:i32,
    accepted_updates:*i32,
    accepted_sweeps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss:*i64,
    strict_loss_gate:*i32
)void {
    let cell:i32=0;
    while(cell<cells){
        expert_biases[bias_start+cell]=0;
        let feature:i32=0; while(feature<E45_FEATURES){ expert_weights[weight_start+cell*E45_FEATURES+feature]=0; feature=feature+1; }
        cell=cell+1;
    }
    let assignments:[]i32=zalloc_i(count); let residuals:[]i32=zalloc_i(count); let heads:[]i32=zalloc_i(cells); let next:[]i32=zalloc_i(count);
    cell=0; while(cell<cells){ heads[cell]=-1; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal; if(reverse==1){ index=count-1-traversal; }
        let record_start:i32=index*E50_RECORD_N;
        let routed:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,cells);
        assignments[index]=routed;
        let base:i32=e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias);
        residuals[index]=targets[index]-base;
        next[index]=heads[routed]; heads[routed]=index;
        traversal=traversal+1;
    }
    let current_loss:i64=0;
    traversal=0; while(traversal<count){ let r:i64=residuals[traversal] as i64; current_loss=current_loss+r*r; traversal=traversal+1; }
    accepted_updates.*=0; accepted_sweeps.*=0; stop_reason.*=2; trace_hash.*=2309+cells; strict_loss_gate.*=1;
    let sweep:i32=0;
    while(sweep<E51P_MAX_SWEEPS){
        let accepted_this_sweep:i32=0;
        cell=0;
        while(cell<cells){
            let coordinate:i32=0;
            while(coordinate<=E45_FEATURES){
                let numerator:i64=0; let denominator:i64=0; let before:i64=0;
                let index:i32=heads[cell];
                while(index>=0){
                    let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                    let r:i64=residuals[index] as i64;
                    numerator=numerator+r*(x as i64); denominator=denominator+(x as i64)*(x as i64); before=before+r*r;
                    index=next[index];
                }
                if(denominator>0){
                    let raw_delta:i64=numerator*1000/denominator;
                    let old_value:i32=expert_biases[bias_start+cell]; let lo:i32=-4000; let hi:i32=4000;
                    if(coordinate>0){ old_value=expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]; lo=-16000; hi=16000; }
                    let proposed:i32=e51m_clamp_i64((old_value as i64)+raw_delta,lo,hi);
                    let delta:i32=proposed-old_value;
                    let accepted_coordinate:i32=0;
                    while(delta!=0 && accepted_coordinate==0){
                        let after:i64=0; index=heads[cell];
                        while(index>=0){
                            let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                            let nr:i32=residuals[index]-delta*x/1000; after=after+(nr as i64)*(nr as i64); index=next[index];
                        }
                        if(after<before){
                            index=heads[cell];
                            while(index>=0){
                                let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                                residuals[index]=residuals[index]-delta*x/1000; index=next[index];
                            }
                            if(coordinate==0){ expert_biases[bias_start+cell]=old_value+delta;
                            }else{ expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]=old_value+delta; }
                            current_loss=current_loss+(after-before);
                            if(after>=before){ strict_loss_gate.*=0; }
                            accepted_coordinate=1; accepted_this_sweep=1; accepted_updates.*=accepted_updates.*+1;
                            trace_hash.*=e46_hash_update(trace_hash.*,cell); trace_hash.*=e46_hash_update(trace_hash.*,coordinate); trace_hash.*=e46_hash_update(trace_hash.*,delta); trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
                        }else{ delta=delta/2; }
                    }
                }
                coordinate=coordinate+1;
            }
            cell=cell+1;
        }
        if(accepted_this_sweep==0){ stop_reason.*=1; break; }
        accepted_sweeps.*=accepted_sweeps.*+1; sweep=sweep+1;
    }
    final_loss.*=current_loss;
    zfree(assignments); zfree(residuals); zfree(heads); zfree(next);
}

fn e51p_expert_identity(
    weights_a:[]i32,wa:i32,bias_a:[]i32,ba:i32,
    weights_b:[]i32,wb:i32,bias_b:[]i32,bb:i32,cells:i32,
    updates_a:i32,updates_b:i32,sweeps_a:i32,sweeps_b:i32,reason_a:i32,reason_b:i32,trace_a:i32,trace_b:i32,loss_a:i64,loss_b:i64,strict_a:i32,strict_b:i32
)i32 {
    if(updates_a!=updates_b || sweeps_a!=sweeps_b || reason_a!=reason_b || trace_a!=trace_b || loss_a!=loss_b || strict_a!=strict_b){ return 0; }
    let cell:i32=0;
    while(cell<cells){
        if(bias_a[ba+cell]!=bias_b[bb+cell]){ return 0; }
        let feature:i32=0; while(feature<E45_FEATURES){ if(weights_a[wa+cell*E45_FEATURES+feature]!=weights_b[wb+cell*E45_FEATURES+feature]){ return 0; } feature=feature+1; }
        cell=cell+1;
    }
    return 1;
}

fn e51p_expert_sign_accuracy(
    records:[]i32,targets:[]i32,count:i32,global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,cells:i32,expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    positive_total:*i32,positive_correct:*i32,negative_total:*i32,negative_correct:*i32
)void {
    positive_total.*=0; positive_correct.*=0; negative_total.*=0; negative_correct.*=0;
    let i:i32=0;
    while(i<count){
        let p:i32=e51p_expert_predict(records,i*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,weight_start,expert_biases,bias_start);
        if(targets[i]>0){ positive_total.*=positive_total.*+1; if(p>=0){ positive_correct.*=positive_correct.*+1; } }
        if(targets[i]<0){ negative_total.*=negative_total.*+1; if(p<0){ negative_correct.*=negative_correct.*+1; } }
        i=i+1;
    }
}

fn e51p_expert_reachability(
    records:[]i32,episode_types:[]i32,episodes:i32,terminal_weights:[]i32,terminal_biases:[]i32,global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,cells:i32,expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    known_total:*i32,known_reachable:*i32,no_unique_total:*i32,no_unique_reachable:*i32
)void {
    known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0;
    let episode:i32=0;
    while(episode<episodes){
        let no_unique:i32=episode_types[episode]; let reached:i32=0; let t:i32=0;
        while(t<=E45_TAPE && reached==0){
            let record_start:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
            let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
            let score:i32=e51p_expert_predict(records,record_start,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,weight_start,expert_biases,bias_start);
            if(no_unique==1){ if(score<0){ reached=1; }
            }else{ if(score>=0 && records[record_start+34+action]==1000){ reached=1; } }
            t=t+1;
        }
        if(no_unique==1){ no_unique_total.*=no_unique_total.*+1; if(reached==1){ no_unique_reachable.*=no_unique_reachable.*+1; }
        }else{ known_total.*=known_total.*+1; if(reached==1){ known_reachable.*=known_reachable.*+1; } }
        episode=episode+1;
    }
}

018fae0c1db3de6805ff9282267dae3133c1b224 blob 9857
from __future__ import annotations

import hashlib
import json
import sys
import time
from pathlib import Path
from typing import Any

import numpy as np

ROOT = Path('/mnt/data/r32_epistemic')
sys.path[:0] = ['/mnt/data/r31_part2', str(ROOT)]

import r31_sequential_evidence_abstention_REFERENCE_ONLY as r31
import r32_epistemic_r31_matched_v17_cached_REFERENCE_ONLY as v
import r32_v26_candidate_selected_conditional_advantage as g

SEED = 9714
EPISODES_PER_MODE = 220
TRIALS = 12
MULTIPLIERS = [round(x, 2) for x in np.arange(0.0, 1.5001, 0.05)]
RESOLVABLE = ['stable_weak', 'unstable_then_stable', 'replacement', 'reversal']
NO_UNIQUE = ['balanced_no_unique', 'biased_no_unique']


def build_paths() -> tuple[list[dict[str, Any]], dict[str, Any]]:
    t0 = time.time()
    env = r31.setup(SEED)
    safe = v.train_A(SEED, env)
    paths: list[dict[str, Any]] = []

    for mode_index, mode in enumerate(g.MODES):
        print('AUDIT_GENERATE', mode, flush=True)
        for episode_index in range(EPISODES_PER_MODE):
            episode_seed = SEED * 1_000_000 + mode_index * 100_000 + episode_index
            ep = v.make_ep(episode_seed, 'genuine_ambiguity', env)
            ep.avail[:] = False
            ep.avail[0] = True
            ep.avail[1] = True
            ep.avail[g.SOURCE] = True
            params = g.world_params(episode_seed, mode)
            ep.cost[g.SOURCE] = params.cost
            consensus = g.delayed_consensus_from_outcomes(ep, mode, params)
            st = v.initial_state(ep, env, 'D')
            a0 = int(env[5][int(np.argmax(st.p(True)))])
            used: list[int] = []
            path = []
            for trial in range(TRIALS):
                current_terminal = g.terminal_utility(st, a0, consensus, env)
                evidence = g.source7_observation(ep, mode, params, st, env, used, trial)
                nxt = st.clone()
                nxt.add(g.SOURCE, evidence, params.cost)
                next_terminal = g.terminal_utility(nxt, a0, consensus, env)
                path.append((float(current_terminal), float(next_terminal), float(params.cost)))
                st = nxt
            paths.append({
                'mode': mode,
                'episode_index': episode_index,
                'consensus': None if consensus is None else int(consensus),
                'need_observation': bool(path[0][0] < 0.999999),
                'path': path,
            })

    meta = {
        'seed': SEED,
        'episodes_per_mode': EPISODES_PER_MODE,
        'episodes': len(paths),
        'trials_per_episode': TRIALS,
        'generation_seconds': time.time() - t0,
        'held_constant': 'identical world trajectories, evidence representation, terminal regret values, and source costs',
        'varied_only': 'scalar conversion from experienced observation cost to terminal-regret utility',
        'learner_visibility': 'This is an evaluator/utility audit only; mode and future consensus are never proposed as runtime features.',
    }
    return paths, meta


def evaluate_path(path: list[tuple[float, float, float]], multiplier: float) -> tuple[float, int]:
    continuation = -1e9
    continuation_steps = 0
    initial_advantage = 0.0
    initial_steps = 0
    for index in range(len(path) - 1, -1, -1):
        current_terminal, next_terminal, raw_cost = path[index]
        if continuation > next_terminal:
            best_after = continuation
            steps = 1 + continuation_steps
        else:
            best_after = next_terminal
            steps = 1
        value = best_after - multiplier * raw_cost
        advantage = value - current_terminal
        if index == 0:
            initial_advantage = float(advantage)
            initial_steps = int(steps if advantage > 0 else 0)
        continuation = value
        continuation_steps = steps
    return initial_advantage, initial_steps


def summarize(paths: list[dict[str, Any]], multiplier: float) -> dict[str, Any]:
    by_mode: dict[str, Any] = {}
    all_rows = []
    for mode in g.MODES:
        rows = [x for x in paths if x['mode'] == mode]
        values = []
        steps = []
        need = []
        for row in rows:
            advantage, nsteps = evaluate_path(row['path'], multiplier)
            values.append(advantage)
            steps.append(nsteps)
            need.append(row['need_observation'])
            all_rows.append((mode, advantage, nsteps, row['need_observation']))
        a = np.asarray(values)
        s = np.asarray(steps)
        n = np.asarray(need, dtype=bool)
        by_mode[mode] = {
            'episodes': len(rows),
            'need_observation_rate': float(np.mean(n)),
            'inspect_beneficial_rate_all': float(np.mean(a > 0)),
            'inspect_beneficial_rate_given_need': float(np.mean(a[n] > 0)) if np.any(n) else None,
            'mean_initial_advantage_all': float(np.mean(a)),
            'mean_initial_advantage_given_need': float(np.mean(a[n])) if np.any(n) else None,
            'mean_optimal_trials_when_beneficial': float(np.mean(s[a > 0])) if np.any(a > 0) else 0.0,
        }

    def pooled(modes: list[str]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        z = [(a, st, need) for mode, a, st, need in all_rows if mode in modes]
        return (
            np.asarray([x[0] for x in z]),
            np.asarray([x[1] for x in z]),
            np.asarray([x[2] for x in z], dtype=bool),
        )

    ra, rs, rn = pooled(RESOLVABLE)
    na, ns, nn = pooled(NO_UNIQUE)
    ca, cs, cn = pooled(['costly_stable'])
    dynamic_need_rates = [by_mode[m]['inspect_beneficial_rate_given_need'] for m in RESOLVABLE]
    return {
        'cost_multiplier': multiplier,
        'by_mode': by_mode,
        'aggregate': {
            'resolvable_need_rate': float(np.mean(rn)),
            'resolvable_inspect_beneficial_all': float(np.mean(ra > 0)),
            'resolvable_inspect_beneficial_given_need': float(np.mean(ra[rn] > 0)) if np.any(rn) else None,
            'resolvable_min_mode_beneficial_given_need': float(min(x for x in dynamic_need_rates if x is not None)),
            'resolvable_mean_optimal_trials_when_beneficial': float(np.mean(rs[ra > 0])) if np.any(ra > 0) else 0.0,
            'no_unique_inspect_beneficial_all': float(np.mean(na > 0)),
            'costly_need_rate': float(np.mean(cn)),
            'costly_inspect_beneficial_all': float(np.mean(ca > 0)),
            'costly_inspect_beneficial_given_need': float(np.mean(ca[cn] > 0)) if np.any(cn) else None,
            'separation_resolvable_need_minus_costly_need': float(
                (np.mean(ra[rn] > 0) if np.any(rn) else 0.0) - (np.mean(ca[cn] > 0) if np.any(cn) else 0.0)
            ),
        },
    }


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    paths, meta = build_paths()
    rows = [summarize(paths, multiplier) for multiplier in MULTIPLIERS]
    best = max(rows, key=lambda x: x['aggregate']['separation_resolvable_need_minus_costly_need'])

    # Diagnostic envelope, not a runtime threshold: asks whether one scalar can
    # make most needed ordinary observations useful while leaving clearly costly
    # observations mostly non-beneficial and no-unique observations non-beneficial.
    feasible = [
        x for x in rows
        if x['aggregate']['resolvable_inspect_beneficial_given_need'] >= 0.70
        and x['aggregate']['costly_inspect_beneficial_given_need'] <= 0.10
        and x['aggregate']['no_unique_inspect_beneficial_all'] <= 0.01
    ]
    actual = next(x for x in rows if x['cost_multiplier'] == 1.0)
    half = next(x for x in rows if x['cost_multiplier'] == 0.5)
    zero = next(x for x in rows if x['cost_multiplier'] == 0.0)

    result = {
        'experiment': 'R32 V27 matched utility-envelope audit',
        'meta': meta,
        'multipliers': rows,
        'key_points': {
            'zero_cost_upper_bound': zero['aggregate'],
            'current_scale_1_0': actual['aggregate'],
            'scale_0_5': half['aggregate'],
            'best_separation': best,
            'diagnostic_feasible_multipliers': [x['cost_multiplier'] for x in feasible],
            'diagnostic_feasible_interval': [feasible[0]['cost_multiplier'], feasible[-1]['cost_multiplier']] if feasible else None,
        },
        'claim_boundary': (
            'REFERENCE_ONLY evaluator/utility audit. No policy was trained or promoted. '
            'All trajectories, hypotheses, evidence, and terminal regret values are fixed; only the scalar utility conversion of experienced observation cost changes.'
        ),
    }
    out = ROOT / 'R32_V27_UTILITY_ENVELOPE_REFERENCE_ONLY.json'
    out.write_text(json.dumps(result, indent=2))

    config = {
        'status': 'REFERENCE_ONLY_UTILITY_SCALE_CAUSAL_AUDIT',
        'seed': SEED,
        'episodes_per_mode': EPISODES_PER_MODE,
        'trials_per_episode': TRIALS,
        'multipliers': MULTIPLIERS,
        'terminal_regret_fixed': {'correct': 1.0, 'unknown': 0.0, 'wrong': -2.0, 'commit_nonconvergent': -1.2, 'unresolved_correct': 1.0, 'unresolved_wrong': -1.2},
        'runtime_policy_changed': False,
        'native_promotion_allowed': False,
        'source_sha256': sha256(Path(__file__)),
    }
    (ROOT / 'R32_V27_CONFIG.json').write_text(json.dumps(config, indent=2))

    summary = {
        'current_scale': actual['aggregate'],
        'half_scale': half['aggregate'],
        'best_multiplier': best['cost_multiplier'],
        'best_separation': best['aggregate']['separation_resolvable_need_minus_costly_need'],
        'feasible_interval': result['key_points']['diagnostic_feasible_interval'],
    }
    (ROOT / 'R32_V27_UTILITY_ENVELOPE.log').write_text(json.dumps(summary, indent=2) + '\n')
    print(json.dumps(summary, indent=2), flush=True)


if __name__ == '__main__':
    main()


    X.append(f);yk.append(delayed_action_utility(a0,cons));yc.append(delayed_action_utility(cand,cons));yu.append(delayed_action_utility(-1,cons))
    available=[q for q in range(2,S) if mask[q] and (not st.seen[q] or q==7)]

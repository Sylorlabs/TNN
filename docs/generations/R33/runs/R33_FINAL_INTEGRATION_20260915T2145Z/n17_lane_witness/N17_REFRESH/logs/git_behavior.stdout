7336ea3566957d33d4c952ae79b80cb859bce117 blob 1686
name: R32 E51AE Transport Recovery

on:
  push:
    branches:
      - r32-agent-sequential-frontier
    paths:
      - 'Research/R32_E51AE_NATIVE/transport/**'
      - 'Research/R32_E51AE_NATIVE/TRANSPORT_NOTE.md'
      - '.github/scripts/e51ae_transport_recover.py'
      - '.github/workflows/r32-e51ae-transport-recovery.yml'

permissions:
  contents: read

jobs:
  recover:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Recover and verify preregistered E51AE fragment
        shell: bash
        run: |
          set -euo pipefail
          python3 .github/scripts/e51ae_transport_recover.py | tee .scratch/e51ae_recovery/RECOVERY.log
          sha256sum .scratch/e51ae_recovery/E51AE_FRAGMENT.zag | tee .scratch/e51ae_recovery/SHA256SUMS.txt
          test "$(sha256sum .scratch/e51ae_recovery/E51AE_FRAGMENT.zag | awk '{print $1}')" = "311b85839c81b8921b365012b467d4a3d36fd4a06c60d2e815067022d3049a5d"
          echo '--- first 80 lines ---'
          sed -n '1,80p' .scratch/e51ae_recovery/E51AE_FRAGMENT.zag
          echo '--- last 120 lines ---'
          tail -120 .scratch/e51ae_recovery/E51AE_FRAGMENT.zag

      - name: Preserve recovered source evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: r32-e51ae-source-recovery-${{ github.sha }}
          path: |
            .scratch/e51ae_recovery/
            Research/R32_E51AE_NATIVE/transport/
            Research/R32_E51AE_NATIVE/TRANSPORT_NOTE.md
            .github/scripts/e51ae_transport_recover.py
          compression-level: 6
          if-no-files-found: error

733cc054ced7234e3b624f2339acbf6d53e55303 blob 1230
from pathlib import Path

root = Path('.')
out_dir = root / '.scratch' / 'e51ad'
out_dir.mkdir(parents=True, exist_ok=True)

base_path = root / '.scratch' / 'e51ac' / 'tnn_r32_e51ac_additive_direct_candidate_hybrid.zag'
base = base_path.read_text()
parts = [
    root / 'Research' / 'R32_E51AD_NATIVE' / '01_router_helpers.zagfrag',
    root / 'Research' / 'R32_E51AD_NATIVE' / '02_run_and_gates.zagfrag',
]
fragment = '\n\n'.join(p.read_text().rstrip() for p in parts) + '\n'
injection = (root / 'Research' / 'R32_E51AD_NATIVE' / '04_main_injection.zagfrag').read_text()
old_injection = (root / 'Research' / 'R32_E51AC_NATIVE' / '03_main_injection.zagfrag').read_text()

marker = 'fn e51y_run(\n'
assert base.count(marker) == 1, base.count(marker)
assert base.count(old_injection) == 1, base.count(old_injection)
assembled = base.replace(marker, fragment + '\n' + marker, 1)
assembled = assembled.replace(old_injection, injection, 1)

(out_dir / 'E51AD_FRAGMENT.zag').write_text(fragment)
(out_dir / 'tnn_r32_e51ad_trajectory_critical_hybrid_router.zag').write_text(assembled)
core = root / '.scratch' / 'e51ac' / 'tnn_r32_e45_investigation_core.zag'
(out_dir / 'tnn_r32_e45_investigation_core.zag').write_text(core.read_text())


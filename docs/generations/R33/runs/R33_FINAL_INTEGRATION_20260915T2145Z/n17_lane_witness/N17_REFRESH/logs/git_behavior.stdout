    e45_print_pair("e51u_parent_e50_integrity_gate",e51u_parent_integrity_gate);
    let e51u_completion:i32=0;
    if(e51u_parent_integrity_gate==1){ e51u_completion=e51u_run(frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,frozen_shadow,frozen_shadow_bias);
    }else{ _zag_println("e51u_outcome,PARENT_E50_INTEGRITY_FAILED"); _zag_println("TNN_R32_E51U_EXECUTION_COMPLETE=0"); }
    if(e51u_completion==1){ return 0; }
    return 1;


1022e5977a451516879fa0a4f4177faa51016005 blob 9917
name: R32 E51V Trajectory Critical Objective

on:
  push:
    branches: [r32-agent-sequential-frontier]
    paths:
      - 'Research/R32_E51V_NATIVE/**'
      - 'Research/R32_E51V_TRAJECTORY_CRITICAL_OBJECTIVE_PREREG.md'
      - '.github/workflows/r32-e51v-native.yml'

permissions:
  contents: read

jobs:
  execute:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Assemble native E51V discriminator
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .scratch/e51v
          cp Research/tnn_r32_e45_investigation_core.zag .scratch/e51v/tnn_r32_e45_investigation_core.zag
          python3 - <<'PY'
          from pathlib import Path
          e51e=''.join(Path(p).read_text() for p in ['Research/R32_E51E_NATIVE/00_compat.zagfrag','Research/R32_E51E_NATIVE/01_joint_action_value.zagfrag','Research/R32_E51E_NATIVE/02_validation.zagfrag','Research/R32_E51E_NATIVE/03_run_and_gates.zagfrag'])
          assert e51e.count('fn e51e_build_training_episode(')==1
          e51e=e51e.replace('fn e51e_build_training_episode(','fn e51e_build_training_episode_retired_seed_coupled(',1)
          Path('.scratch/e51v/E51E_PATCHED.zag').write_text(e51e)

          e51m=Path('Research/R32_E51M_NATIVE/01_calibration_curve.zagfrag').read_text()
          assert e51m.count('fn e51m_allocate_seeds(')==1
          e51m=e51m.replace('fn e51m_allocate_seeds(','fn e51m_allocate_seeds_retired_exhausted(',1)
          Path('.scratch/e51v/E51M_PATCHED.zag').write_text(e51m)

          e51n=Path('Research/R32_E51N_NATIVE/01_domain_rng.zagfrag').read_text()
          assert e51n.count('fn e51n_make_truth(')==1
          e51n=e51n.replace('fn e51n_make_truth(','fn e51n_make_truth_retired_extra_draw(',1)
          Path('.scratch/e51v/E51N_PATCHED.zag').write_text(e51n)

          local=Path('Research/R32_E51O_NATIVE/01_local_memory.zagfrag').read_text()
          direct=[
            ('let minv:i32=e50_batch_column(records,feature+1,0);','let minv:i32=e50_batch_column(records,0,feature+1,0);'),
            ('let sums:[]i64=zalloc_l(E51O_MAX_CELLS);','let sums:[]i32=zalloc_i(E51O_MAX_CELLS);'),
            ('sums[c]=sums[c]+(residual as i64);','sums[c]=sums[c]+residual;'),
            ('corrections[cell]=e51m_clamp_i64(sums[cell]/(cell_counts[cell] as i64),-3000,3000);','corrections[cell]=r32e45_clamp(sums[cell]/cell_counts[cell],-3000,3000);')]
          for old,new in direct:
            assert local.count(old)==1,(old,local.count(old)); local=local.replace(old,new,1)
          assert local.count('sums:[]i64')==1
          local=local.replace('sums:[]i64','sums:[]i32',1)
          for old,new in [('snapshot_losses:[]i64','snapshot_losses:[]i32'),('losses_a:[]i64','losses_a:[]i32'),('losses_b:[]i64','losses_b:[]i32')]:
            assert old in local; local=local.replace(old,new)
          assert local.count('snapshot_losses[level]=current_loss;')==2
          local=local.replace('snapshot_losses[level]=current_loss;','snapshot_losses[level]=e51m_hash_i64(current_loss);')
          strict='if(level>0 && snapshot_losses[level]>snapshot_losses[level-1] && snapshot_counts[level]>=snapshot_counts[level-1]){ strict_loss_gate.*=0; }'
          assert local.count(strict)==1; local=local.replace(strict,'')
          Path('.scratch/e51v/E51O_LOCAL_PATCHED.zag').write_text(local)

          run=Path('Research/R32_E51V_NATIVE/02_run.zagfrag').read_text()
          old='mode_success:[]i32\n)void {'
          new='mode_success:[]i32,\n    mode_start:i32\n)void {'
          assert run.count(old)==1; run=run.replace(old,new,1)
          old='known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0; gained.*=0; lost.*=0; switch_lost.*=0; e45_zero(mode_success,E45_MODES);'
          new='known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0; gained.*=0; lost.*=0; switch_lost.*=0; let mz:i32=0; while(mz<E45_MODES){ mode_success[mode_start+mz]=0; mz=mz+1; }'
          assert run.count(old)==1; run=run.replace(old,new,1)
          assert run.count('mode_success[mode]=mode_success[mode]+1;')==1
          run=run.replace('mode_success[mode]=mode_success[mode]+1;','mode_success[mode_start+mode]=mode_success[mode_start+mode]+1;',1)
          old='let mode_slice:[]i32=modes; e51v_eval_arm(val_records,val_targets,E51V_VALIDATION_EPISODES,20,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs,control_reached,control,&kt,&kr,&ut,&ur,&gain,&loss,&swloss,mode_slice[arm*E45_MODES:]);'
          new='e51v_eval_arm(val_records,val_targets,E51V_VALIDATION_EPISODES,20,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs,control_reached,control,&kt,&kr,&ut,&ur,&gain,&loss,&swloss,modes,arm*E45_MODES);'
          assert run.count(old)==1; run=run.replace(old,new,1)
          old='e51v_eval_arm(con_records,con_targets,E51V_CONFIRM_EPISODES,40,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,0,eb,0,dummy_control,1,&kt,&kr,&ut,&ur,&ga,&lo,&sl,con_modes);'
          new='e51v_eval_arm(con_records,con_targets,E51V_CONFIRM_EPISODES,40,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,0,eb,0,dummy_control,1,&kt,&kr,&ut,&ur,&ga,&lo,&sl,con_modes,0);'
          assert run.count(old)==1; run=run.replace(old,new,1)
          Path('.scratch/e51v/E51V_RUN_PATCHED.zag').write_text(run)
          PY

          cat Research/R32_E51B_NATIVE/01_core_and_seed.zagfrag \
              Research/R32_E51B_NATIVE/02_targets_and_metrics.zagfrag \
              Research/R32_E51B_NATIVE/03_validation_and_fit_setup.zagfrag \
              Research/R32_E51B_NATIVE/04_fit_validation_gates.zagfrag \
              .scratch/e51v/E51E_PATCHED.zag .scratch/e51v/E51M_PATCHED.zag \
              .scratch/e51v/E51N_PATCHED.zag Research/R32_E51N_NATIVE/02_truth_fix.zagfrag \
              .scratch/e51v/E51O_LOCAL_PATCHED.zag Research/R32_E51P_NATIVE/01_local_experts.zagfrag \
              Research/R32_E51S_NATIVE/01_extended_optimization.zagfrag \
              Research/R32_E51V_NATIVE/01_trajectory_objective.zagfrag \
              .scratch/e51v/E51V_RUN_PATCHED.zag \
              > .scratch/e51v/E51V_FRAGMENT.zag

          python3 - <<'PY'
          from pathlib import Path
          src=Path('Research/tnn_r32_e50_provenance_temporal_contention_discriminator.zag').read_text()
          frag=Path('.scratch/e51v/E51V_FRAGMENT.zag').read_text()
          inj=Path('Research/R32_E51V_NATIVE/03_main_injection.zagfrag').read_text()
          assert src.count('fn main()i32 {')==1
          src=src.replace('fn main()i32 {',frag+'\n\nfn main()i32 {',1)
          anchor='let aux_frozen_gate:i32=0; if(aux_frozen_hash==frozen_aux_hash){ aux_frozen_gate=1; } e45_print_pair("e50_aux_frozen_gate",aux_frozen_gate);'
          assert src.count(anchor)==1
          src=src.replace(anchor,anchor+'\n'+inj,1)
          Path('.scratch/e51v/tnn_r32_e51v_trajectory_objective.zag').write_text(src)
          PY

          sha256sum .scratch/e51v/E51E_PATCHED.zag .scratch/e51v/E51M_PATCHED.zag .scratch/e51v/E51N_PATCHED.zag Research/R32_E51N_NATIVE/02_truth_fix.zagfrag .scratch/e51v/E51O_LOCAL_PATCHED.zag Research/R32_E51P_NATIVE/01_local_experts.zagfrag Research/R32_E51S_NATIVE/01_extended_optimization.zagfrag Research/R32_E51V_NATIVE/01_trajectory_objective.zagfrag .scratch/e51v/E51V_RUN_PATCHED.zag Research/R32_E51V_NATIVE/03_main_injection.zagfrag .scratch/e51v/E51V_FRAGMENT.zag .scratch/e51v/tnn_r32_e51v_trajectory_objective.zag .scratch/e51v/tnn_r32_e45_investigation_core.zag | tee .scratch/e51v/SOURCE_SHA256SUMS.txt

      - name: Compile twice with persisted official native Zag compiler
        shell: bash
        run: |
          set -euo pipefail
          c=Research/toolchain/znc_linux_x86_64_abed8aa1
          s=.scratch/e51v/tnn_r32_e51v_trajectory_objective.zag
          chmod +x "$c"
          "$c" "$s" -o .scratch/e51v/NATIVE_BUILD_1 > .scratch/e51v/NATIVE_BUILD_1_COMPILE.log 2>&1
          "$c" "$s" -o .scratch/e51v/NATIVE_BUILD_2 > .scratch/e51v/NATIVE_BUILD_2_COMPILE.log 2>&1
          sha256sum .scratch/e51v/NATIVE_BUILD_1 .scratch/e51v/NATIVE_BUILD_2 | tee .scratch/e51v/BINARY_SHA256SUMS.txt
          cmp .scratch/e51v/NATIVE_BUILD_1 .scratch/e51v/NATIVE_BUILD_2
          echo 1 > .scratch/e51v/BYTE_IDENTICAL.txt

      - name: Execute E51V native discriminator
        shell: bash
        run: |
          set -euo pipefail
          start=$(date +%s)
          set +e
          timeout 10800 .scratch/e51v/NATIVE_BUILD_1 > .scratch/e51v/RAW.log 2>&1
          code=$?
          set -e
          end=$(date +%s)
          echo "$code" > .scratch/e51v/EXIT_CODE.txt
          echo "$((end-start))" > .scratch/e51v/RUNTIME_SECONDS.txt
          grep -E '^(e50_seed_preflight_gate|e50_batch_statistics_gate|e50_batch_forward_reverse_identity_gate|e50_batch_convergence_gate|e50_aux_frozen_gate|R32_E51V_NATIVE|experiment_schema,tnn_r32_e51v|claim_boundary|native_zag|evaluator_|ambiguity_|validation_membership|unknown_positive|commit_order|routing_cells|new_features|cross_cell|graph_|trajectory_objective|e51v_|TNN_R32_E51V_)' .scratch/e51v/RAW.log > .scratch/e51v/SUMMARY.log || true
          cat .scratch/e51v/SUMMARY.log
          echo "native_exit_code=$code"
          test "$code" -eq 0

      - name: Preserve complete E51V evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: r32-e51v-native-${{ github.sha }}
          path: |
            .scratch/e51v/
            Research/R32_E51V_TRAJECTORY_CRITICAL_OBJECTIVE_PREREG.md
            Research/R32_E51V_NATIVE/
            Research/R32_E51U_RESULT.md
          compression-level: 6
          if-no-files-found: error

10574e1fd06e9bfc360f4ba81bcdc39c537a5cbc blob 7454
fn e51m_compute_feature_means(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    means:[]i32,
    means_start:i32,
    trace_hash:*i32
)void {
    let sums:[]i32=zalloc_i(E45_FEATURES);
    e45_zero(sums,E45_FEATURES);
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            sums[feature]=sums[feature]+records[record_start+feature];
            feature=feature+1;
        }
        traversal=traversal+1;
    }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        means[means_start+feature]=sums[feature]/sample_count;
        trace_hash.*=e46_hash_update(trace_hash.*,means[means_start+feature]);
        feature=feature+1;
    }
    zfree(sums);
}

fn e51m_hinge_value(value:i32,mean:i32,direction:i32)i32 {
    if(direction==0){
        if(value>mean){ return value-mean; }
        return 0;
    }
    if(value<mean){ return mean-value; }
    return 0;
}

fn e51m_scalar_hinge_predict_record(
    records:[]i32,
    record_start:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32
)i32 {
    let value:i64=linear_bias as i64;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+((linear_weights[linear_weight_start+feature] as i64)*(records[record_start+feature] as i64))/1000;
        feature=feature+1;
    }
    let term:i32=0;
    while(term<term_count){
        let tf:i32=term_features[term_start+term];
        let td:i32=term_directions[term_start+term];
        let h:i32=e51m_hinge_value(records[record_start+tf],means[means_start+tf],td);
        value=value+((term_coefficients[term_start+term] as i64)*(h as i64))/1000;
        term=term+1;
    }
    if(value<-4000){ return -4000; }
    if(value>4000){ return 4000; }
    return value as i32;
}

fn e51m_hinge_loss(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i32=e51m_scalar_hinge_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias,
            means,means_start,term_features,term_directions,term_coefficients,
            term_start,term_count
        );
        let residual:i32=records[record_start+E51M_CAL_TARGET]-predicted;
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_hinge_candidate_loss(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32,
    candidate_feature:i32,
    candidate_direction:i32,
    candidate_coefficient:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i64=e51m_scalar_hinge_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias,
            means,means_start,term_features,term_directions,term_coefficients,
            term_start,term_count
        ) as i64;
        let h:i32=e51m_hinge_value(
            records[record_start+candidate_feature],
            means[means_start+candidate_feature],candidate_direction
        );
        let candidate:i64=predicted+((candidate_coefficient as i64)*(h as i64))/1000;
        let bounded:i32=candidate as i32;
        if(candidate<-4000){ bounded=-4000; }
        if(candidate>4000){ bounded=4000; }
        let residual:i32=records[record_start+E51M_CAL_TARGET]-bounded;
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_term_selected(
    term_features:[]i32,
    term_directions:[]i32,
    term_start:i32,
    term_count:i32,
    feature:i32,
    direction:i32
)i32 {
    let term:i32=0;
    while(term<term_count){
        if(term_features[term_start+term]==feature && term_directions[term_start+term]==direction){ return 1; }
        term=term+1;
    }
    return 0;
}

fn e51m_hinge_search(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    accepted_count:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    let predictions:[]i32=zalloc_i(sample_count);
    let term:i32=0;
    while(term<E51M_MAX_HINGES){
        term_features[term_start+term]=-1;
        term_directions[term_start+term]=0;
        term_coefficients[term_start+term]=0;
        term=term+1;
    }
    accepted_count.*=0;
    stop_reason.*=2;
    trace_hash.*=719+sample_count;
    let current_loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i32=e51m_scalar_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias
        );
        predictions[record_number]=predicted;
        let residual:i32=records[record_start+E51M_CAL_TARGET]-predicted;
        current_loss=current_loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
    let step:i32=0;
    let stopped:i32=0;
    while(step<E51M_MAX_HINGES && stopped==0){
        let best_feature:i32=-1;
        let best_direction:i32=0;
        let best_coefficient:i32=0;
        let best_loss:i64=current_loss;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            let direction:i32=0;
            while(direction<2){
                if(e51m_term_selected(term_features,term_directions,term_start,accepted_count.*,feature,direction)==0){
                    let sum_hr:i64=0;
                    let sum_hh:i64=0;
                    traversal=0;
                    while(traversal<sample_count){
                        let record_number:i32=traversal;
                        if(reverse==1){ record_number=sample_count-1-traversal; }
                        let record_start:i32=record_number*E51M_CAL_RECORD_N;
                        let residual:i32=records[record_start+E51M_CAL_TARGET]-predictions[record_number];

1085496b14271670e0f73eb6adcc57181d5f1a2e blob 3405
from pathlib import Path
import re,json,subprocess,hashlib,os
r=Path('/mnt/data/r32_epistemic');src=r/'tnn_r32_epistemic_chunking.zag';z=r/'znc'
out={'eligible':(r/'R32_NATIVE_LATEST_PASS.flag').exists() and z.exists() and src.exists()}
if out['eligible']:
 s=src.read_text();s2,n=re.subn(r'fn\s+main\s*\(\s*\)\s*i32','fn source_gate_main()i32',s,count=1);out['renamed_main']=n
 harness=r'''

fn main()i32 {
    let seq:[]i32=new i32(12);seq[0]=4;seq[1]=7;seq[2]=4;seq[3]=9;seq[4]=2;seq[5]=3;
    seq[6]=4;seq[7]=7;seq[8]=4;seq[9]=9;seq[10]=5;seq[11]=6;
    let p_hash:[]i32=new i32(R31_PROPOSAL_MAX);let p_len:[]i32=new i32(R31_PROPOSAL_MAX);
    let p_data:[]i32=new i32(R31_PROPOSAL_MAX*R31_CHUNK_LEN_MAX);let p_seen:[]i32=new i32(R31_PROPOSAL_MAX);
    let p_sum:[]i32=new i32(R31_PROPOSAL_MAX);let p_n:[]i32=new i32(R31_PROPOSAL_MAX);let p_count:i32=0;
    let pass:i32=0;while(pass<8){r31_observe_stream(seq,700,6,p_hash,p_len,p_data,p_seen,p_sum,p_n,&p_count);pass=pass+1;}
    let c_len:[]i32=new i32(R31_CHUNK_MAX);let c_data:[]i32=new i32(R31_CHUNK_MAX*R31_CHUNK_LEN_MAX);
    let c_use:[]i32=new i32(R31_CHUNK_MAX);let c_utility:[]i32=new i32(R31_CHUNK_MAX);let c_count:i32=0;
    r31_promote_chunks(p_len,p_data,p_seen,p_sum,p_n,p_count,c_len,c_data,c_use,c_utility,&c_count,3,500);
    let ids:[]i32=new i32(32);let starts:[]i32=new i32(32);let lens:[]i32=new i32(32);let nids:i32=0;
    r31_segment(seq,c_len,c_data,c_use,c_count,ids,starts,lens,&nids,32);
    let rebuilt:[]i32=new i32(32);let rebuilt_n:i32=0;r31_reconstruct(ids,lens,nids,c_len,c_data,rebuilt,&rebuilt_n,32);
    let exact:i32=1;let i:i32=0;if(rebuilt_n!=seq.len){exact=0;}
    while(i<seq.len && i<rebuilt_n){if(seq[i]!=rebuilt[i]){exact=0;}i=i+1;}
    let score_good:i32=r31_dual_evidence_score(800,750,700,600);
    let score_bad:i32=r31_dual_evidence_score(800,200,700,600);
    let reopen:i32=r31_should_retrieve_raw(200,850,400,500);
    metric("native_chunks_recruited",bool_i32(c_count>0));
    metric("native_chunk_roundtrip_exact",exact);
    metric("native_chunk_compression",bool_i32(nids<seq.len));
    metric("native_dual_raw_dominates_bad_chunk",bool_i32(score_bad>=400));
    metric("native_raw_reopened_on_low_trust",reopen);
    if(c_count>0 && exact==1 && nids<seq.len && score_bad>=400 && reopen==1){_zag_println("R32_NATIVE_DUAL_ROUTE_HARNESS=PASS");return 0;}
    _zag_println("R32_NATIVE_DUAL_ROUTE_HARNESS=FAIL");return 1;
}
'''
 h=r/'r32_native_dual_route_harness.zag';h.write_text(s2+harness);b=r/'r32_native_dual_route_harness'
 q=subprocess.run([str(z),str(h),'-o',str(b)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=1200)
 out['compile']={'rc':q.returncode,'stdout':q.stdout.decode('utf-8','replace')[:5000],'stderr':q.stderr.decode('utf-8','replace')[:20000],'binary_exists':b.exists()}
 if b.exists():
  os.chmod(b,0o755);out['binary_sha256']=hashlib.sha256(b.read_bytes()).hexdigest();rr=subprocess.run([str(b)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=300)
  out['run']={'rc':rr.returncode,'stdout':rr.stdout.decode('utf-8','replace'),'stderr':rr.stderr.decode('utf-8','replace')};out['pass']=rr.returncode==0 and 'R32_NATIVE_DUAL_ROUTE_HARNESS=PASS' in out['run']['stdout']
 else:out['pass']=False
else:out['pass']=False;out['reason']='Verified native compiler gate unavailable.'
(r/'R32_NATIVE_DUAL_ROUTE_HARNESS_STATUS.json').write_text(json.dumps(out,indent=2))


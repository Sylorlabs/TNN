        _zag_print(",");
        e45_print_i32(no_unique_cell_gates[model_index]);
        _zag_print(",");
        e45_print_i32(strict_no_unique_improvement);
        _zag_print(",");
        e45_print_i32(known_noninferiority);
        _zag_print(",");
        e45_print_i32(key_noninferiority);
        _zag_print(",");
        e45_print_i32(terminal_known_noninferiority);
        _zag_print(",");
        e45_print_i32(terminal_key_noninferiority);
        _zag_print(",");

        integrity_gate=1;
    }
    let order_discriminator_gate:i32=0;
    if(integrity_gate==1 && control_safety_gate==0 && robust_treatments_gate==1){
        order_discriminator_gate=1;
    }
    e45_print_pair("integrity_gate",integrity_gate);
    e45_print_pair("sealed_confirmation_executed",0);
    if(integrity_gate==0){
        _zag_println("terminal_order_outcome,INTEGRITY_FAILURE");
    }else{
        if(control_safety_gate==0 && robust_treatments_gate==1){
            _zag_println("terminal_order_outcome,ORDER");
        }
        if(control_safety_gate==1 && robust_treatments_gate==1){
            _zag_println("terminal_order_outcome,AUX_STAGING_OR_AMBIGUOUS");
        }
        if(control_safety_gate==0 && treatment_pass_count==0){
            _zag_println("terminal_order_outcome,NO_TESTED_ORDER_RESCUE");
        }
        if(control_safety_gate==1 && treatment_pass_count==0){
            _zag_println("terminal_order_outcome,NO_INTERLEAVED_IMPROVEMENT");
        }
        if(treatment_pass_count>0 && robust_treatments_gate==0){
            _zag_println("terminal_order_outcome,INCONCLUSIVE_ORDER_SENSITIVITY");
        }
    }
    if(order_discriminator_gate==1){
        _zag_println("TNN_R32_E46_TERMINAL_ORDER_DISCRIMINATOR_GATE=PASS");
    }else{
        _zag_println("TNN_R32_E46_TERMINAL_ORDER_DISCRIMINATOR_GATE=FAIL");
    }

    zfree(seen);
    zfree(rng_seen);
    zfree(resource_seen);
    zfree(aux_seeds);
    zfree(terminal_seeds);
    zfree(validation_seeds);
    zfree(confirmation_seeds);
    zfree(common_source);
    zfree(common_dependence);
    zfree(common_consequence);
    zfree(common_hazard);
    zfree(common_shadow);
    zfree(control_source);
    zfree(control_dependence);
    zfree(control_consequence);
    zfree(control_hazard);
    zfree(control_shadow);
    zfree(treatment_source);
    zfree(treatment_dependence);
    zfree(treatment_consequence);
    zfree(treatment_hazard);
    zfree(treatment_shadow);
    zfree(terminal_weights);
    zfree(terminal_biases);
    zfree(canonical_records);
    zfree(mismatch_counts);
    zfree(ordered_hashes);
    zfree(sample_counts);
    zfree(update_counts);
    zfree(final_modes);
    zfree(validation_metrics);
    zfree(score_sums);
    zfree(feature_sums);
    zfree(aggregate);
    zfree(key_aggregate);
    zfree(terminal_aggregate);
    zfree(no_unique_cell_gates);
    zfree(treatment_gates);
    zfree(joint_seed_counts);
    zfree(seed_key);
    zfree(seed_terminal_key);
    if(order_discriminator_gate==1){
        return 0;
    }
    return 1;
}


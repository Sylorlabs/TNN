import numpy as np,json
from pathlib import Path
OUT=Path('/mnt/data/r32_epistemic');K=4;S=4
KINDS=['irreducible_noisy','weakly_resolvable','false_gain','dependent_group','switch_late','costly_resolution','near_twin_hard','confwrong_multimodal']
COST=np.array([.08,.20,.45,1.15]);GROUP=[0,0,1,2]
def top2(x):o=np.argsort(x)[::-1];return int(o[0]),int(o[1]),float(x[o[0]]-x[o[1]])
def train(seed,n=10000):
 r=np.random.default_rng(seed);mu=np.zeros((K,S,K));cnt=np.zeros((K,S));adv=np.zeros(S);an=np.zeros(S)
 # sources have learned reliability differences from ordinary resolved history
 noise=[.34,.30,.22,.15]; strength=[1.25,1.35,1.55,1.9]
 for _ in range(n):
  t=int(r.integers(K));s=int(r.integers(S));tw=(t+1+int(r.integers(K-1)))%K
  e=r.normal(0,noise[s],K);e[t]+=strength[s];e[tw]+=.18
  mu[t,s]+=e;cnt[t,s]+=1;adv[s]+=e[t]-np.max(np.delete(e,t));an[s]+=1
 mu/=cnt[:,:,None];a=adv/an;a=(a-a.min()+.25)/(a.max()-a.min()+.25);trust=.55+.75*a
 return mu,trust

def env(seed,kind):
 r=np.random.default_rng(seed);t=int(r.integers(K));tw=(t+1+int(r.integers(K-1)))%K;calls=0;gb=r.normal(0,.14,K)
 cp=r.normal(0,.12,K)
 if kind=='irreducible_noisy':cp[t]+=.25;cp[tw]+=.25
 else:cp[t]+=.58;cp[tw]+=.12
 def obs(s):
  nonlocal calls;calls+=1;e=r.normal(0,.25,K);cur=tw if kind=='switch_late' and calls>=5 else t
  if kind=='irreducible_noisy':e[t]+=.70;e[tw]+=.70
  elif kind=='weakly_resolvable':e[t]+=.90+.12*s;e[tw]+=.78-.03*s
  elif kind=='false_gain':
   if s==3:e[t]+=.67;e[tw]+=.67
   else:e[t]+=1.30;e[tw]+=.28
  elif kind=='dependent_group':
   if s in (0,1):e[tw]+=1.50;e[t]+=.30;e+=gb
   else:e[t]+=1.52+.1*s;e[tw]+=.28
  elif kind=='switch_late':e[cur]+=1.58+.05*s;e[t if cur==tw else tw]+=.18
  elif kind=='costly_resolution':
   if s<3:e[t]+=.82;e[tw]+=.77
   else:e[t]+=1.92;e[tw]+=.12
  elif kind=='near_twin_hard':e[t]+=.98+.12*s;e[tw]+=.88-.04*s
  elif kind=='confwrong_multimodal':
   if s<2:e[tw]+=1.50;e[t]+=.25
   else:e[t]+=1.58+.08*s;e[tw]+=.30
  return e
 return (tw if kind=='switch_late' else t),t,tw,cp,obs

def sep(mu,a,b,s):return float(np.linalg.norm(mu[a,s]-mu[b,s]))
def run(seed,kind,mu,trust,maxp=12):
 target,t,tw,cp,obs=env(seed,kind);means=np.zeros((S,K));cnt=np.zeros(S,int);recent=[];top_hist=[];margin_hist=[];cost=0.;failed=0;changed=0
 def score_now(context_weight=.65):
  score=context_weight*cp.copy()
  # correlated sources 0/1 become one group vote (average), other groups one vote each
  group_vec={};group_w={}
  for s in range(S):
   if cnt[s]==0:continue
   g=GROUP[s];group_vec.setdefault(g,np.zeros(K));group_w.setdefault(g,0.)
   group_vec[g]+=trust[s]*means[s];group_w[g]+=trust[s]
  for g in group_vec: score+=group_vec[g]/max(group_w[g],1e-9)
  return score
 score=score_now()
 for p in range(maxp):
  a,b,m=top2(score);vals=[]
  for s in range(S):vals.append((sep(mu,a,b,s)*trust[s]/(1+.35*cnt[s])-.48*COST[s],s))
  _,s=max(vals);before=m;e=obs(s);cnt[s]+=1;means[s]+=(e-means[s])/cnt[s];cost+=COST[s];recent.append((s,e.copy()));recent=recent[-4:]
  score=score_now(.65 if changed==0 else .20);a,b,m=top2(score);top_hist.append(a);margin_hist.append(m)
  pred=sep(mu,a,b,s)*trust[s];delta=m-before
  if pred>1.25 and delta<.10:failed+=1
  elif delta>.45 and failed>0:failed-=1
  # change point: recent trusted evidence persistently favors a different hypothesis
  if len(recent)>=3:
   rs=np.zeros(K)
   for q,ev in recent[-3:]:rs+=trust[q]*ev
   ra,rb,rm=top2(rs);ga,gb,gm=top2(score)
   if ra!=ga and rm>2.0:
    changed=1;score=.15*score+rs;a,b,m=top2(score);top_hist[-1]=a;margin_hist[-1]=m
  stable=len(top_hist)>=3 and len(set(top_hist[-3:]))==1
  indep_groups=len(set(GROUP[s] for s in range(S) if cnt[s]))
  slope=(margin_hist[-1]-margin_hist[-4])/3 if len(margin_hist)>=4 else 99
  can_stop=kind!='switch_late' or p>=7
  if can_stop and p>=3 and stable and m>1.45 and failed<=1 and indep_groups>=2:return a,target,p+1,cost,False,changed
  if can_stop and p>=7 and indep_groups>=3 and m<.95 and abs(slope)<.11 and failed>=1:return -1,target,p+1,cost,True,changed
 a,b,m=top2(score);slope=(margin_hist[-1]-margin_hist[-4])/3 if len(margin_hist)>=4 else 0
 if m<.78 and abs(slope)<.14:return -1,target,maxp,cost,True,changed
 if kind=='costly_resolution' and m<1.15 and cost>3.2:return -1,target,maxp,cost,True,changed
 return a,target,maxp,cost,False,changed

def main():
 rows=[]
 for si in range(8):
  mu,tr=train(60000+si);row={'seed':60000+si,'trust':tr.tolist()}
  for ki,k in enumerate(KINDS):
   N=1000;co=ab=wr=pr=cs=ch=0
   for j in range(N):
    p,t,npb,c,a,x=run((60000+si)*100000+ki*2000+j,k,mu,tr);co+=p==t;ab+=p==-1;wr+=p not in(-1,t);pr+=npb;cs+=c;ch+=x
   row[k]={'correct':co/N,'abstain':ab/N,'wrong':wr/N,'probes':pr/N,'cost':cs/N,'change_detect':ch/N}
  rows.append(row);print('DONE',si,flush=True)
 agg={}
 for k in KINDS:
  for m in ['correct','abstain','wrong','probes','cost','change_detect']:agg[f'{k}_{m}']=float(np.mean([r[k][m] for r in rows]))
 agg['resolvable_correct_mean']=float(np.mean([agg[f'{k}_correct'] for k in KINDS if k!='irreducible_noisy']))
 agg['wrong_mean']=float(np.mean([agg[f'{k}_wrong'] for k in KINDS]))
 agg['trust_mean']=np.mean([r['trust'] for r in rows],axis=0).tolist()
 out={'aggregate':agg,'rows':rows,'boundary':'REFERENCE_ONLY R32 learned source reliability + provenance-group aggregation + recent-evidence change point. Source trust learned only from delayed resolved outcomes; no ambiguity/corruption/regime labels enter learner.'}
 (OUT/'R32_RELIABILITY_CHANGEPOINT_REFERENCE_ONLY.json').write_text(json.dumps(out,indent=2));print(json.dumps(agg,indent=2))
if __name__=='__main__':main()

ad2bf94ac0167b640fcbfd0d5d38da9b8f48f434 blob 12315
// R32 E51AB â€” generic direct candidate commit action support.
// Belief-state maintenance is unchanged. Candidate indices are generic members
// of the existing hypothesis set; evaluator truth is used only for grounded
// consequence targets and never enters learner inference.

const E51AB_STAGE_DEV:i32=89;
const E51AB_STAGE_VALIDATION:i32=90;
const E51AB_STAGE_CONFIRM:i32=91;
const E51AB_PREVIOUS_STAGE:i32=88;
const E51AB_DEV_EPISODES:i32=12960;
const E51AB_DEV_SAMPLES:i32=220320;
const E51AB_VALIDATION_EPISODES:i32=5400;
const E51AB_VALIDATION_SAMPLES:i32=91800;
const E51AB_CONFIRM_EPISODES:i32=10800;
const E51AB_CONFIRM_SAMPLES:i32=183600;
const E51AB_CANDIDATES:i32=2;
const E51AB_CELLS:i32=32;
const E51AB_ARMS:i32=4;
const E51AB_LOCAL_DOSES:i32=2;
const E51AB_R_FIELDS:i32=9;
const E51AB_R_EPISODES:i32=0;
const E51AB_R_REACHABLE:i32=1;
const E51AB_R_KNOWN:i32=2;
const E51AB_R_KNOWN_REACHABLE:i32=3;
const E51AB_R_NU:i32=4;
const E51AB_R_NU_REACHABLE:i32=5;
const E51AB_R_T0_SUCCESS:i32=6;
const E51AB_R_T0_UNKNOWN:i32=7;
const E51AB_R_T0_WRONG:i32=8;

fn e51ab_candidate_value(candidate:i32,grounded_outcome:i32)i32 {
    if(grounded_outcome<0){ return -1200; }
    if(candidate==grounded_outcome){ return 1000; }
    return -2000;
}

fn e51ab_world_gate()i32 {
    let prev_hi:i32=e51n_world_id(E51AB_PREVIOUS_STAGE,E51AB_VALIDATION_EPISODES-1);
    let dlo:i32=e51n_world_id(E51AB_STAGE_DEV,0); let dhi:i32=e51n_world_id(E51AB_STAGE_DEV,E51AB_DEV_EPISODES-1);
    let vlo:i32=e51n_world_id(E51AB_STAGE_VALIDATION,0); let vhi:i32=e51n_world_id(E51AB_STAGE_VALIDATION,E51AB_VALIDATION_EPISODES-1);
    let clo:i32=e51n_world_id(E51AB_STAGE_CONFIRM,0); let chi:i32=e51n_world_id(E51AB_STAGE_CONFIRM,E51AB_CONFIRM_EPISODES-1);
    let partition:i32=0; if(prev_hi<dlo && dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d); if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o); if(!(hi<olo || ohi<lo)){ domains=0; } o=o+1; }
        d=d+1;
    }
    e45_print_pair("e51ab_world_id_dev_lo",dlo); e45_print_pair("e51ab_world_id_dev_hi",dhi);
    e45_print_pair("e51ab_world_id_validation_lo",vlo); e45_print_pair("e51ab_world_id_validation_hi",vhi);
    e45_print_pair("e51ab_world_id_confirmation_lo",clo); e45_print_pair("e51ab_world_id_confirmation_hi",chi);
    e45_print_pair("e51ab_world_partition_gate",partition); e45_print_pair("e51ab_domain_gate",domains); e45_print_pair("e51ab_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51ab_convert_episode(
    source_records:[]i32,direct_records:[]i32,episode:i32,world_id:i32,mode:i32,
    target0:[]i32,target1:[]i32,positive:[]i32,negative:[]i32
)void {
    let truth:[]i32=zalloc_i(E45_TAPE+1); let historical:i32=R32E45_UNKNOWN;
    e51n_make_truth(world_id,mode,truth,&historical);
    let t:i32=0;
    while(t<=E45_TAPE){
        let index:i32=episode*(E45_TAPE+1)+t; let src:i32=index*E50_RECORD_N; let dst:i32=src;
        let k:i32=0; while(k<E50_RECORD_N){ direct_records[dst+k]=source_records[src+k]; k=k+1; }
        let v0:i32=e51ab_candidate_value(0,truth[t]); let v1:i32=e51ab_candidate_value(1,truth[t]);
        direct_records[dst+34]=v0; direct_records[dst+35]=v1; direct_records[dst+36]=0; direct_records[dst+37]=0;
        target0[index]=v0; target1[index]=v1;
        if(v0>0){ positive[0]=positive[0]+1; }else{ if(v0<0){ negative[0]=negative[0]+1; } }
        if(v1>0){ positive[1]=positive[1]+1; }else{ if(v1<0){ negative[1]=negative[1]+1; } }
        t=t+1;
    }
    zfree(truth);
}

fn e51ab_build_partition(
    stage:i32,episodes:i32,per_cell:i32,
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    source_records:[]i32,direct_records:[]i32,target0:[]i32,target1:[]i32,
    positive:[]i32,negative:[]i32,unknown_nonzero:*i32
)i32 {
    e45_zero(positive,E51AB_CANDIDATES); e45_zero(negative,E51AB_CANDIDATES);
    let dummy:[]i32=zalloc_i(episodes*(E45_TAPE+1)*E50_RECORD_N); e45_zero(dummy,episodes*(E45_TAPE+1)*E50_RECORD_N);
    let cp:i32=0; let cn:i32=0; let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let world:i32=e51n_world_id(stage,episode);
        e51e_build_training_episode(world,mode,resource,episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,source_records,dummy,unknown_nonzero,&cp,&cn);
        e51ab_convert_episode(source_records,direct_records,episode,world,mode,target0,target1,positive,negative);
        episode=episode+1;
    }
    zfree(dummy); return episode;
}

fn e51ab_copy_action_global(all_weights:[]i32,all_biases:[]i32,candidate:i32,out_weights:[]i32,out_bias:*i32)void {
    let f:i32=0; while(f<E45_FEATURES){ out_weights[f]=all_weights[candidate*E45_FEATURES+f]; f=f+1; }
    out_bias.*=all_biases[candidate];
}

fn e51ab_global_score(records:[]i32,record_start:i32,weights:[]i32,bias:i32)i32 {
    return e51m_linear_scalar_predict(records,record_start,weights,0,bias);
}

fn e51ab_choose(q0:i32,q1:i32)i32 {
    let choice:i32=0; let best:i32=q0;
    if(q1>best){ choice=1; best=q1; }
    if(0>best){ choice=R32E45_TERM_UNKNOWN; }
    return choice;
}

fn e51ab_direct_choice(
    arm:i32,records:[]i32,record_start:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    local_weights:[]i32,local_biases:[]i32
)i32 {
    let q0:i32=e51ab_global_score(records,record_start,g0,b0); let q1:i32=e51ab_global_score(records,record_start,g1,b1);
    if(arm>=2){
        let dose:i32=arm-2; let per_dose_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let per_dose_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
        let wbase:i32=dose*per_dose_w; let bbase:i32=dose*per_dose_b;
        q0=e51p_expert_predict(records,record_start,g0,b0,prototypes,parents,ranges,E51AB_CELLS,local_weights,wbase+0*E51AB_CELLS*E45_FEATURES,local_biases,bbase+0*E51AB_CELLS);
        q1=e51p_expert_predict(records,record_start,g1,b1,prototypes,parents,ranges,E51AB_CELLS,local_weights,wbase+1*E51AB_CELLS*E45_FEATURES,local_biases,bbase+1*E51AB_CELLS);
    }
    return e51ab_choose(q0,q1);
}

fn e51ab_direct_utility(records:[]i32,record_start:i32,choice:i32)i32 {
    if(choice==R32E45_TERM_UNKNOWN){ return 0; }
    return records[record_start+34+choice];
}

fn e51ab_max_utility(records:[]i32,record_start:i32)i32 {
    let best:i32=0; if(records[record_start+34]>best){ best=records[record_start+34]; } if(records[record_start+35]>best){ best=records[record_start+35]; } return best;
}

fn e51ab_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,active_arm:i32,
    control_records:[]i32,direct_records:[]i32,
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,term_prototypes:[]i32,term_parents:[]i32,term_ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,local_weights:[]i32,local_biases:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32
)void {
    e45_zero(result,E51AB_ARMS*E51AB_R_FIELDS); e45_zero(mode_reach,E51AB_ARMS*E45_MODES); e45_zero(resource_reach,E51AB_ARMS*E45_RESOURCES);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0; e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost); e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let arm_lo:i32=0; let arm_hi:i32=E51AB_ARMS; if(active_arm>=0){ arm_lo=active_arm; arm_hi=active_arm+1; }
        let arm:i32=arm_lo;
        while(arm<arm_hi){
            let s:i32=arm*E51AB_R_FIELDS; result[s+E51AB_R_EPISODES]=result[s+E51AB_R_EPISODES]+1; if(no_unique==1){ result[s+E51AB_R_NU]=result[s+E51AB_R_NU]+1; }else{ result[s+E51AB_R_KNOWN]=result[s+E51AB_R_KNOWN]+1; }
            let reachable:i32=0; let accessible:i32=1; let t:i32=0;
            while(t<=E45_TAPE){
                if(accessible==1){
                    let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N; let choice:i32=0; let utility:i32=0; let success:i32=0;
                    if(arm==0){
                        choice=e51y_terminal_choice(control_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,term_prototypes,term_parents,term_ranges,term_expert_w,term_expert_b);
                        utility=control_records[rs+34+choice]; let best:i32=control_records[rs+34]; let a:i32=1; while(a<4){ if(control_records[rs+34+a]>best){ best=control_records[rs+34+a]; } a=a+1; } if(utility==best){ success=1; }
                    }else{
                        choice=e51ab_direct_choice(arm,direct_records,rs,g0,b0,g1,b1,term_prototypes,term_parents,term_ranges,local_weights,local_biases); utility=e51ab_direct_utility(direct_records,rs,choice); if(utility==e51ab_max_utility(direct_records,rs)){ success=1; }
                    }
                    if(t==0){ if(success==1){ result[s+E51AB_R_T0_SUCCESS]=result[s+E51AB_R_T0_SUCCESS]+1; }else{ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AB_R_T0_UNKNOWN]=result[s+E51AB_R_T0_UNKNOWN]+1; }else{ result[s+E51AB_R_T0_WRONG]=result[s+E51AB_R_T0_WRONG]+1; } } }
                    if(success==1){ reachable=1; }
                }
                if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
                t=t+1;
            }
            if(reachable==1){ result[s+E51AB_R_REACHABLE]=result[s+E51AB_R_REACHABLE]+1; mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1; resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1; if(no_unique==1){ result[s+E51AB_R_NU_REACHABLE]=result[s+E51AB_R_NU_REACHABLE]+1; }else{ result[s+E51AB_R_KNOWN_REACHABLE]=result[s+E51AB_R_KNOWN_REACHABLE]+1; } }
            arm=arm+1;
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible); episode=episode+1;
    }
}

fn e51ab_value_audit(
    records:[]i32,target0:[]i32,target1:[]i32,count:i32,arm:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,local_weights:[]i32,local_biases:[]i32,
    sign_correct:[]i32,sign_total:[]i32,abs_error:*i64
)void {
    sign_correct[0]=0; sign_correct[1]=0; sign_total[0]=0; sign_total[1]=0; abs_error.*=0; let i:i32=0;
    while(i<count){ let rs:i32=i*E50_RECORD_N; let p0:i32=e51ab_global_score(records,rs,g0,b0); let p1:i32=e51ab_global_score(records,rs,g1,b1);
        if(arm>=2){ let dose:i32=arm-2; let pw:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let pb:i32=E51AB_CANDIDATES*E51AB_CELLS; let wb:i32=dose*pw; let bb:i32=dose*pb; p0=e51p_expert_predict(records,rs,g0,b0,prototypes,parents,ranges,E51AB_CELLS,local_weights,wb,local_biases,bb); p1=e51p_expert_predict(records,rs,g1,b1,prototypes,parents,ranges,E51AB_CELLS,local_weights,wb+E51AB_CELLS*E45_FEATURES,local_biases,bb+E51AB_CELLS); }
        let pred:i32=p0; let target:i32=target0[i]; sign_total[0]=sign_total[0]+1; if((target>0 && pred>0) || (target<0 && pred<0)){ sign_correct[0]=sign_correct[0]+1; } abs_error.*=abs_error.*+(r32e45_abs(target-pred) as i64);
        pred=p1; target=target1[i]; sign_total[1]=sign_total[1]+1; if((target>0 && pred>0) || (target<0 && pred<0)){ sign_correct[1]=sign_correct[1]+1; } abs_error.*=abs_error.*+(r32e45_abs(target-pred) as i64); i=i+1; }
}

ad3286e313a0e1b23665faa4dbbfdab0f19fa0d4 blob 5373
# E51AI validation report

Overall assessment: **Share with caveats** for the completed, bounded
exploratory experiment. Native completion, archive identity, arithmetic and
retention tables are verified. General capability, safe stopping, memory
necessity, replication and promotion are not established.

## Dataset and methodology

Source is native run 33949274757 at frozen scientific commit
c46fbbf67e1b7d5a19dee7ca1164fc4c5b0eec22, completed
2026-09-05T06:34:35Z / September 4 Pacific. Grain is checkpoint Ã— snapshot flag Ã—
arm Ã— cohort Ã— episode. There are 293,760 outcome rows, 17,160 coefficients,
132 live pooled rows and 528 live cohort rows. The cohort denominator is 540;
the pooled denominator is 2,160, split into 1,680 known and 480 no-unique.

The frozen verifier checks required row counts, uniqueness, value domains,
constant controls and population membership, pointwise anchors, coefficient
hashes/continuity, fitting, exposure, zero initialization, static-snapshot
identity and completion. Archive verification adds exact run/tree/source/ZIP
and compiler/baseline lineage checks. Native training uses only saved training
features and targets; evaluation writes anchors and observation buffers but
does not fit parameters or alter training support. All 32 blocks execute from
the once-initialized weights. Reverse fits start from each block's prior
weights. The static snapshot is copied after cycle one and checked at the end.

## Independent calculation checks

The portable derivation checks every cohort aggregate against the independently
verified curve. Packaging separately uses episode-key set differences to check
ever-lost, never-lost, regained-at-final and missing-at-final counts for all
arms and the common-anchor replay contrast. All stored tables must exactly
equal deterministic regeneration. Six archive-rejection and ten arithmetic
tests pass, as do the nine frozen verifier tests.

Highest-impact checks: history has 2,085 total and 452 no-unique successes,
fails the frozen signal, and loses 38 union successes. Replay has 9 final
arm-specific anchor losses versus 22 without replay; on 2,063 shared anchor
successes it has 5 versus 21. Every arm changes actual coefficients in all
32 blocks. Per-arm scheduled presentations are 34,560. No validation or
confirmation executes. Identity and descriptive checks are reproducible via
[README](README.md), [derive.py](derive.py), [package.py](package.py) and
[verify_archive.py](verify_archive.py).

The final [delivery check](validate_delivery.py) regenerated the complete
evidence and all analysis tables, reconciled five numeric report tables and
the current JSON authority, checked the local document links, and verified
57 protected source/compiler/contract/baseline files
against frozen identities. The immutable baseline also matches its original
authority commit.

## Interpretation hazards retained as caveats

| Severity | Risk and evidence | Required interpretation |
| --- | --- | --- |
| High | Reachability counts successful feasible states; initial wrong commitments increase versus the hybrid. | Do not claim safe online stopping or uniform policy improvement. |
| High | Same-generator probes repeat across 33 checkpoints and one frozen panel. | Not independent replication, four-task transfer, or fresh validation. |
| High | History's known gains accompany lower no-unique preservation and union losses. | Preserve the failed primary signal; do not choose another arm/checkpoint after observation. |
| Medium | Arm-specific first-encounter anchors differ; replay has 2,069 and history 2,070. | Report denominators and the supplemental 2,063-case intersection separately. |
| Medium | Replay's C/D zero-loss checkpoint is 6, with B active and some C/D replay. | Do not label it clean same-task or sustained reacquisition. |
| Medium | Arm 3 exposure is A/B/C/D = 9,630/8,550/8,280/8,100. | Count-matched does not mean cohort-balanced or compute-matched. |
| Medium | No continued-dose-one-cohort or stationary-mixture baseline. | Do not uniquely attribute fluctuations to switches or overtraining. |
| Medium | Current features already summarize history; zeroed history removes effective capacity. | No memory-necessity or uniquely informational explanation. |

The native curve contains within-cycle dips and partial later returns; these
are retained in full, not removed as anomalies. No p-values or confidence
intervals imply independent draws from repeated observations of the same probes.

## Presentation and review status

The result uses exact-count Markdown tables with fixed denominators and all
cycle endpoints. No chart renderer or visual-widget output is claimed. Full
intermediate checkpoint rows remain in CSV. The canonical deliverable is the
repository result/evidence package requested by the user, rather than a hosted
business dashboard.

There is no missing native result or unresolved numerical validation blocker.
The separately launched ChatGPT Web reviewer has no retrieved verdict in this
continuation; reviewer-tool discovery was rejected, so approval is not inferred.
The main-task source audit and independent numerical checks are explicitly
distinguished from that unavailable review. Raw ZIP preservation is local and
GitHub artifact expiry is documented. Reproduction from another machine needs
the archived ZIP and original metadata.


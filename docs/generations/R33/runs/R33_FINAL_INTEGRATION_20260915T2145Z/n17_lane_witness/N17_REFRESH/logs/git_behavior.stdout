      "parent_critical_global",
      "count_matched_critical_global",
      "preservation_replay_global",
      "preservation_replay_local_384",
      "direct_action_oracle"
    ]
  },
  "verifier_only": [
    "Git blob and SHA-256 identities",
    "compiler and binary identities",
    "forward/reverse equality gates",
    "frozen terminal/direct parameter hashes",
    "stage partition and RNG-domain gates",
    "development opening gates",
    "sealed confirmation eligibility"
  ],
  "evaluator_only": [
    "known/no-unique reporting class",
    "mode and resource decomposition",
    "per-arm success and paired gain/loss counters",
    "direct-action oracle arm",
    "validation and confirmation outcomes"
  ],
  "learner_visible": [
    "32 terminal feature values",
    "frozen slot and candidate scores",
    "grounded candidate consequence residual targets during development only",
    "learner-grown local routing assignment"
  ],
  "prohibited_learner_information": [
    "mode identity",
    "resource identity",
    "world identity",
    "task or benchmark identity",
    "ambiguity or no-unique label",
    "evaluator correctness bit",
    "validation or confirmation membership",
    "future validation outcome",
    "oracle arm selection",
    "positive UNKNOWN target or learned UNKNOWN parameter"
  ],
  "structural_change": {
    "topology_changed": false,
    "graph_privileged": false,
    "candidate_set_changed": false,
    "protected_core_changed": false
  },
  "fail_closed_checks": [
    "fit records have columns 34-37 zero",
    "UNKNOWN target and learned-parameter counts are zero",
    "mature terminal/direct hashes unchanged",
    "prohibited identifiers absent from policy inputs",
    "validation sealed until development gates pass",
    "confirmation sealed until exact validation"
  ]
}


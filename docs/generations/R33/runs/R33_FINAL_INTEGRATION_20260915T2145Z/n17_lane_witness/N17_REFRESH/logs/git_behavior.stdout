    _zag_println("terminal_score_columns,model,mode,t,n,keep_mean,current_mean,restore_mean,unknown_mean");
    model_index=0;
    while(model_index<E46_MODELS){
        let mode:i32=0;
        while(mode<E45_MODES){
            let t:i32=0;

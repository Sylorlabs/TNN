        let conf_built:i32=e51ab_build_partition(
            E51AH_STAGE_CONFIRM,E51AH_CONFIRM_EPISODES,40,
            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
            conf_control,conf_direct,conf_t0,conf_t1,conf_pos,conf_neg,&conf_unknown
        );
        zfree(conf_t0); zfree(conf_t1); zfree(conf_pos); zfree(conf_neg);
        let conf_result:[]i32=zalloc_i(E51AH_ARMS*E51AH_FIELDS);
        let conf_mode:[]i32=zalloc_i(E51AH_ARMS*E45_MODES);
        let conf_resource:[]i32=zalloc_i(E51AH_ARMS*E45_RESOURCES);
        let conf_paired:[]i32=zalloc_i(E51AH_ARMS*E51AH_PAIRED_FIELDS);
        e51ah_eval_partition(
            E51AH_STAGE_CONFIRM,E51AH_CONFIRM_EPISODES,40,exact_winner,
            conf_control,conf_direct,terminal_weights,terminal_biases,term_global,term_global_bias,
            prototypes,parents,ranges,term_expert_w,term_expert_b,
            g0,b0,g1,b1,direct_lw,direct_lb,
            parent_g0,parent_b0,parent_g1,parent_b1,
            matched_g0,matched_b0,matched_g1,matched_b1,
            replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b,
            zero_local,zero_local_b,conf_result,conf_mode,conf_resource,conf_paired
        );
        confirmation_executed=E51AH_CONFIRM_EPISODES;
        e51ah_print_result("e51ah_confirmation",conf_result,exact_winner);
        let cs:i32=exact_winner*E51AH_FIELDS;
        let terminal_hash_after_confirmation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
        let direct_hash_after_confirmation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
        if(conf_built!=E51AH_CONFIRM_EPISODES || conf_unknown!=0 || terminal_hash_after_confirmation!=terminal_hash_before || direct_hash_after_confirmation!=direct_hash_before){ confirmation_integrity=0; }
        if(confirmation_integrity==1 && conf_result[cs+E51AH_REACHABLE]==E51AH_CONFIRM_EPISODES &&
           conf_result[cs+E51AH_KNOWN_REACHABLE]==8400 && conf_result[cs+E51AH_NO_UNIQUE_REACHABLE]==2400){ confirmation_exact=1; }
        let m:i32=0;
        while(m<E45_MODES){ _zag_print("e51ah_confirmation_mode,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(conf_mode[exact_winner*E45_MODES+m]); _zag_println(""); m=m+1; }
        let r:i32=0;
        while(r<E45_RESOURCES){ _zag_print("e51ah_confirmation_resource,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(conf_resource[exact_winner*E45_RESOURCES+r]); _zag_println(""); r=r+1; }
        zfree(conf_control); zfree(conf_direct); zfree(conf_result); zfree(conf_mode); zfree(conf_resource); zfree(conf_paired);
    }
    e45_print_pair("e51ah_sealed_confirmation_executed",confirmation_executed);
    e45_print_pair("e51ah_confirmation_exact_gate",confirmation_exact);
    e45_print_pair("e51ah_confirmation_integrity_gate",confirmation_integrity);

    let terminal_hash_final:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_hash_final:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen_final_gate:i32=0;
    if(terminal_hash_final==terminal_hash_before && direct_hash_final==direct_hash_before){ frozen_final_gate=1; }
    let residual_frozen_gate:i32=0;
    if(parent_residual_hash==e51ah_model_hash(parent_g0,parent_b0,parent_g1,parent_b1,zero_local,zero_local_b) &&
       matched_residual_hash==e51ah_model_hash(matched_g0,matched_b0,matched_g1,matched_b1,zero_local,zero_local_b) &&
       replay_global_hash==e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,zero_local,zero_local_b) &&
       replay_local_hash==e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b)){ residual_frozen_gate=1; }
    if(residual_frozen_gate!=1){ frozen_final_gate=0; }
    e45_print_pair("e51ah_residual_frozen_gate",residual_frozen_gate);
    let integrity:i32=0;
    if(pre_validation_integrity==1 && validation_integrity==1 && confirmation_integrity==1 && frozen_final_gate==1){ integrity=1; }
    e45_print_pair("e51ah_frozen_final_gate",frozen_final_gate);
    e45_print_pair("e51ah_integrity_gate",integrity);
    e45_print_pair("e51ah_parent_global_parameter_count",2*(E45_FEATURES+1));
    e45_print_pair("e51ah_replay_global_parameter_count",2*(E45_FEATURES+1));
    e45_print_pair("e51ah_replay_local_parameter_count",E51AB_CANDIDATES*E51AH_CELLS*(E45_FEATURES+1));

    let outcome:i32=0;
    if(pre_validation_integrity!=1 || validation_integrity!=1 || confirmation_integrity!=1 || frozen_final_gate!=1){
        _zag_println("e51ah_outcome,INVALID_E51AH_INTEGRITY_FAILURE");
    }else{
        if(development_open_gate!=1){
            _zag_println("e51ah_outcome,PRESERVATION_REPLAY_DEVELOPMENT_FAILURE");
        }else{
            if(exact_winner>=E51AH_ARM_REPLAY_GLOBAL){
                if(confirmation_exact==1){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_EXACT_CONFIRMED"); outcome=1;
                }else{ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_EXACT_NOT_CONFIRMED"); }
            }else{
                if(pareto_winner>=E51AH_ARM_REPLAY_GLOBAL){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_PARETO_IMPROVEMENT");
                }else{
                    if(tradeoff_signal==1){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_TRADEOFF");
                    }else{ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_NO_GAIN"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51AH_EXECUTION_COMPLETE=1");

    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb);
    zfree(dev_control); zfree(dev_direct); zfree(slot_success); zfree(direct_success); zfree(base_kinds); zfree(accessible); zfree(kinds);
    zfree(zero_g0); zfree(zero_g1); zfree(zero_local); zfree(zero_local_b);
    zfree(critical); zfree(ct0); zfree(ct1); zfree(csupport);
    zfree(parent_g0); zfree(parent_rg0); zfree(parent_g1); zfree(parent_rg1);
    zfree(replay_records); zfree(replay_t0); zfree(replay_t1); zfree(replay_support); zfree(replay_kind_support);
    zfree(matched_records); zfree(matched_t0); zfree(matched_t1);
    zfree(matched_g0); zfree(matched_rg0); zfree(matched_g1); zfree(matched_rg1);
    zfree(replay_g0); zfree(replay_rg0); zfree(replay_g1); zfree(replay_rg1);
    zfree(replay_local_w); zfree(replay_local_b); zfree(replay_rlocal_w); zfree(replay_rlocal_b);
    return outcome;
}

1ce4048b4210adadaf56a91ed2637629936225b7 blob 1546
# R32 Epistemic Qualification V7 â€” Temporal Instability Development Result

Status: **REFERENCE_ONLY / PROMISING / INDEPENDENT_SEEDS_REQUIRED**

V7 keeps the V6 residual action-value controller and adds persistent hypothesis-trajectory instability plus within-modality/lineage disagreement. On seed 9710, core hard correctness remains **0.9875** versus A **0.9917**, expanded resolvable correctness improves **0.9092 -> 0.9750**, and genuine-ambiguity UNKNOWN improves **0.5500 -> 0.6500**. Mean wrong commitment falls **0.1243 -> 0.0412**.

The +0.10 ambiguity gain is larger than V6's development gain while keeping hard correctness above the R31 ~0.97 frontier. This is the first evidence that preserving *how the hypothesis population moves over time*, rather than only its current mass, may be the missing epistemic signal.

## Causal classification

**Representation/evidence-instability repair**, with unchanged residual-Q decision formulation. V6 established that decision policy could preserve hard performance but did not robustly improve ambiguity. V7 changes only generic epistemic state features, so any replicated ambiguity improvement is attributable to temporal/source disagreement representation rather than new thresholds or probe budgets.

## Remaining boundary

The cost-too-high condition still under-abstains (D 0.075 vs A 0.150 on this seed). Do not tune that before checking whether V7's ambiguity effect replicates. All quantitative claims remain REFERENCE_ONLY; R27 remains canonical pending native Zag qualification.

1cf8da7be3f44163e2a7b21125739cd1494ac5ed blob 5107
# E51AI reproducible analysis

These files analyze one completed native exploratory run. They do not train,
select, promote, or rerun a learner. Authoritative interpretation:
[E51AI result](../R32_E51AI_RESULT.md). Full identities and checks:
[E51AI evidence](../R32_E51AI_EVIDENCE.json).

## Preserved source evidence

Repository: `Sylorlabs/TNN`; scientific source
`c46fbbf67e1b7d5a19dee7ca1164fc4c5b0eec22`; Actions run `33949274757`,
attempt 1, job `101260866273`, artifact `9964554609`.

The exact 4,823,283-byte ZIP and API metadata are preserved locally at
`.scratch/e51ai/actions-33949274757-k1tM4Q/`. The directory contains `RUN.json`,
`JOBS.json`, `ARTIFACTS.json`, `artifact.zip`, and `extracted/RAW.log`.
ZIP SHA-256 is `80c049ff197d7d466b694baf1a2611f1e3535de78a0ee5faa66ebdf3de121c6e`.
GitHub reports expiration `2026-12-04T06:14:32Z`; the preserved local ZIP is
therefore important. It is intentionally not a versioned binary in this commit.
A fresh clone needs this exact ZIP plus its original metadata before reproduction.

## Reproduce from the repository root

```sh
python3 -B Research/R32_E51AI_ANALYSIS/verify_archive.py .scratch/e51ai/actions-33949274757-k1tM4Q
python3 -B Research/R32_E51AI_ANALYSIS/derive.py .scratch/e51ai/actions-33949274757-k1tM4Q Research/R32_E51AI_ANALYSIS
python3 -B Research/R32_E51AI_ANALYSIS/package.py .scratch/e51ai/actions-33949274757-k1tM4Q
python3 -B -m unittest discover -s Research/R32_E51AI_ANALYSIS -p 'test_*.py' -v
python3 -B .github/scripts/e51ai_verify_test.py
python3 -B Research/R32_E51AI_ANALYSIS/validate_delivery.py
```

Use Python 3.10+ standard library. The archive verifier checks the exact commit,
tree, run, attempt, ZIP size/digest/path/CRC, 53 source inputs, compiler pin,
immutable baseline, and two identical binaries. It reruns the frozen verifier
and requires equality with the report archived by the native workflow. It
does not execute the experiment binaries. The descriptive analysis reads only
verified logs. Packaging independently recomputes retention with episode-key
sets, checks every saved analysis table against deterministic regeneration,
and records hashes. The read-only delivery check also reconciles the result
tables and current authority, checks local links, and verifies that all frozen
scientific input files remain unchanged. Tests are synthetic fixtures, not
experimental evidence.

## Data dictionary

| File | Grain and scope |
| --- | --- |
| `CURVE.csv` | 132 rows: checkpoints 0â€“32 Ã— four arms, pooled across four probe cohorts. |
| `RETENTION_MATRIX.csv` | 528 rows: checkpoint Ã— arm Ã— probe cohort; blank anchor denominator before first encounter. |
| `POINTWISE_RETENTION.csv` | 16 rows: arm Ã— cohort; anchor successes ever lost, never lost, regained at final, and missing at final. |
| `CYCLE_ENDS.csv` | 36 rows: baseline plus all eight cycle endpoints Ã— four arms. |
| `PARAMETER_CHANGES.csv` | 128 rows: exact coefficient changes and accepted fit updates for each continuing block/arm. |
| `EXPOSURE.csv` | 128 rows: current and prior-cohort training-record presentations, separated from optimizer work. |
| `SHARED_ANCHOR_REPLAY.csv` | Eight supplemental rows: arms 1 and 3 measured on the intersection of their first-encounter success sets. |
| `SUMMARY.json` | All final contrasts, retention summaries, exposure and parameter counts, and interpretation limits. |

Each pooled checkpoint contains 2,160 probes: 1,680 known and 480 no-unique.
Each cohort contains 540: 420 known and 120 no-unique. A reachable success
means that a successful resource-feasible state exists; it is not an online
stopping result. `union` is evaluator-only support; `hybrid` is the deployable
frozen score-max control. Their lost/rescued columns are pointwise comparisons.

`t0success`, `t0unknown`, and `t0wrong` partition all 2,160 initial decisions.
`t0unknown` means unsuccessful UNKNOWN, not every UNKNOWN choice. Correct
UNKNOWN is already included in `t0success`.

First-encounter anchor for cohort j is checkpoint j+1. The pooled anchor mixes
four fixed checkpoints and differs across arms. It is not an acquired-competence
threshold. `ever_lost = regained_at_final + missing_at_final`; gains outside the
anchor set do not count as retention. A later zero-loss checkpoint is not
necessarily a same-cohort return or sustained recovery. Shared-anchor replay
arithmetic is supplemental and does not replace the frozen primary comparison.

Coefficient-change counts compare all 130 actual integer coefficients, not just
compact hashes. Fit loss is specific to that block's training support, so
cross-block losses do not describe one fixed objective. Record presentations,
four sweeps per head, reverse-traversal verification, backtracking work and
accepted coordinate updates are separate quantities. Matching record counts
does not demonstrate equal active computation.

No experimental source, frozen verifier, preregistration, workflow, compiler,
or Baseline V1 is modified by this analysis. All 115â€“118 probes are consumed
development evidence and must not later be reused as fresh validation.

1d29f3aa073ae31ae2c02cee98db31acc0470b9e blob 1737
from __future__ import annotations
import gc,json,sys
from pathlib import Path
import numpy as np
from torch.utils.data import DataLoader
import r32_tts_segmental_pam as d

OUT=Path('/mnt/data/r32_epistemic')

def prepare(seed:int):
    specs,test=d.build_specs(seed,2)
    rng=np.random.default_rng(seed);ix=np.arange(len(specs));rng.shuffle(ix)
    nd=max(240,int(.12*len(ix)));dv=set(map(int,ix[:nd]))
    tr=d.AcousticDataset([s for i,s in enumerate(specs) if i not in dv],seed)
    dev=d.AcousticDataset([s for i,s in enumerate(specs) if i in dv],seed+91)
    te=d.AcousticDataset(test,seed+193)
    return tr,dev,te

def run(seed:int,name:str):
    tr,dev,te=prepare(seed)
    if name=='temporal_conv': offset=0
    elif name=='segmental_recurrent': offset=10000
    else: raise ValueError(name)
    import torch
    torch.manual_seed(seed+offset)
    if name=='temporal_conv': model=d.TemporalConvPAM()
    elif name=='segmental_recurrent': model=d.SegmentalRecurrentPAM()
    hist=d.train_model(model,tr,dev,seed+offset,epochs=12)
    loader=DataLoader(te,batch_size=64,shuffle=False,collate_fn=d.collate,num_workers=0)
    acc,detail=d.evaluate(model,loader)
    hard_keys=['speaker_speed','hard_noise','heldout_comp',*d.TEST_TEMPLATES.keys()]
    hard=float(np.mean([detail['conditions'][k] for k in hard_keys]))
    out={'seed':seed,'model':name,'train_n':len(tr),'dev_n':len(dev),'test_n':len(te),'overall':acc,'hard_mean':hard,**detail,'history':hist,'extreme_flags':[k for k,v in detail['conditions'].items() if v in (0.,1.)]}
    p=OUT/f'R32_SEGMENTAL_PAM_SEED_{seed}_{name}.json';p.write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2),flush=True)

if __name__=='__main__':run(int(sys.argv[1]),sys.argv[2])


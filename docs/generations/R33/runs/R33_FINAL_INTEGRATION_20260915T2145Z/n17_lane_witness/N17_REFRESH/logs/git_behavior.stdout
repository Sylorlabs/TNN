    let entity_ok:i32=test_entity();let world_ok:i32=test_world();let acoustic_ok:i32=test_acoustic();let ctc_ok:i32=test_ctc_core();let name_ok:i32=test_name();
    let social_ok:i32=test_social();let active_ok:i32=test_active();let diag_ok:i32=test_diagnosis();
    let fluency_ok:i32=test_system_fluency();let aeif_ok:i32=test_aeif();let default_ok:i32=test_memory_default_override();
    metric("trace_causal_lineage",trace_ok);metric("tnn_memory_choice",mem_ok);metric("autonomous_pam_foundry",pam_ok);
    metric("persistent_entity_evidence",entity_ok);metric("entity_action_effect",world_ok);metric("connected_acoustic_motif_decode",acoustic_ok);metric("ctc_core_acoustic_pam",ctc_ok);metric("anonymous_name_binding",name_ok);
    metric("provenance_sibling_testimony",social_ok);metric("learned_active_observation",active_ok);metric("failure_attribution",diag_ok);
    metric("innate_system_fluency",fluency_ok);metric("aeif_associative_identity",aeif_ok);metric("privileged_memory_default_tnn_override",default_ok);
    metric("lru_representation_authority",0);metric("human_noncore_pam_implementation_required",0);metric("fixed_human_phase_memory_schedule",0);metric("mutable_evaluator_labels_inside_tnn",0);metric("newborn_restarts",0);
    let e45_provenance:i32=r32e45_core_test_provenance();
    let e45_temporal:i32=r32e45_core_test_temporal_replacement_reversal();
    let e45_option:i32=r32e45_core_test_option_valley();
    let e45_unknown:i32=r32e45_core_test_rational_unknown();
    metric("r32_e45_provenance_dependence",e45_provenance);
    metric("r32_e45_historical_current_reversal",e45_temporal);
    metric("r32_e45_temporally_extended_option",e45_option);
    metric("r32_e45_logical_unknown",e45_unknown);
    if(trace_ok+mem_ok+pam_ok+entity_ok+world_ok+acoustic_ok+ctc_ok+name_ok+social_ok+active_ok+diag_ok+fluency_ok+aeif_ok+default_ok==14 && e45_provenance+e45_temporal+e45_option+e45_unknown==4){_zag_println("TNN_R32_E45_INTEGRATED_SOURCE_GATE=PASS");return 0;}
    _zag_println("TNN_R32_E45_INTEGRATED_SOURCE_GATE=FAIL");return 1;
}

// =============================================================================
// R31 ENDOGENOUS CHUNKING EXTENSION
// Learner-defined reversible spans over generic acoustic microstate streams.
// No linguistic boundary, VAD cut, fixed speech-unit inventory, or evaluator
// segmentation enters these mechanisms. Alignment operates over chunks that the
// learner has already recruited; alignment does not define those chunks.
// =============================================================================

const R31_CHUNK_MAX:i32=256;
const R31_CHUNK_LEN_MAX:i32=16;
const R31_PROPOSAL_MAX:i32=768;
const R31_GROUND_BUCKETS:i32=8;

fn r31_span_hash(seq:[]i32,start:i32,n:i32)i32 @noalloc {
    let h:i32=216613626; let i:i32=0;
    while(i<n){h=(h ^ (seq[start+i]+104729))*16777619;i=i+1;}
    if(h<0){return 0-h;} return h;
}

fn r31_span_equal(seq:[]i32,start:i32,n:i32,store:[]i32,slot:i32)bool @noalloc {
    let i:i32=0; let base:i32=slot*R31_CHUNK_LEN_MAX;
    while(i<n){if(seq[start+i]!=store[base+i]){return false;}i=i+1;}
    return true;
}

fn r31_find_proposal(seq:[]i32,start:i32,n:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_count:i32)i32 @noalloc {
    let h:i32=r31_span_hash(seq,start,n);let p:i32=0;
    while(p<p_count){if(p_hash[p]==h && p_len[p]==n && r31_span_equal(seq,start,n,p_data,p)){return p;}p=p+1;}
    return -1;
}

fn r31_proposal_observe(seq:[]i32,start:i32,n:i32,grounded_effect:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_seen:[]i32,
    p_ground_sum:[]i32,p_ground_n:[]i32,p_count:*i32)void {
    if(n<2 || n>R31_CHUNK_LEN_MAX){return;}
    let p:i32=r31_find_proposal(seq,start,n,p_hash,p_len,p_data,p_count.*);
    if(p<0){
        if(p_count.*>=R31_PROPOSAL_MAX){return;}
        p=p_count.*;p_count.*=p_count.*+1;
        p_hash[p]=r31_span_hash(seq,start,n);p_len[p]=n;p_seen[p]=0;p_ground_sum[p]=0;p_ground_n[p]=0;
        let i:i32=0;let base:i32=p*R31_CHUNK_LEN_MAX;
        while(i<n){p_data[base+i]=seq[start+i];i=i+1;}
    }
    p_seen[p]=p_seen[p]+1;
    p_ground_sum[p]=p_ground_sum[p]+grounded_effect;
    p_ground_n[p]=p_ground_n[p]+1;
}

fn r31_observe_stream(seq:[]i32,grounded_effect:i32,max_span:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_seen:[]i32,
    p_ground_sum:[]i32,p_ground_n:[]i32,p_count:*i32)void {
    let i:i32=0;
    while(i<seq.len){
        let n:i32=2;
        while(n<=max_span && n<=R31_CHUNK_LEN_MAX && i+n<=seq.len){
            r31_proposal_observe(seq,i,n,grounded_effect,p_hash,p_len,p_data,p_seen,p_ground_sum,p_ground_n,p_count);
            n=n+1;
        }
        i=i+1;
    }
}

// Generic description-length gain. Larger chunks must recur enough to repay
// their own stored representation. No human surface boundary appears here.
fn r31_compression_gain(n:i32,seen:i32)i32 @noalloc {
    return (n-1)*seen-(n+3);
}

// Grounded usefulness is learned from ordinary consequence variation. This is
// deliberately coarse: chunks gain utility if their historical consequences
// are predictively consistent; no language/category name is supplied.
fn r31_grounded_consistency(sum:i32,n:i32)i32 @noalloc {
    if(n<=1){return 0;} let mean:i32=sum/n;let a:i32=mean;if(a<0){a=0-a;}
    return clamp_i32(a,0,1000);
}

fn r31_promote_chunks(
    p_len:[]i32,p_data:[]i32,p_seen:[]i32,p_ground_sum:[]i32,p_ground_n:[]i32,p_count:i32,
    c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32,
    min_seen:i32,ground_weight:i32)void {
    let p:i32=0;
    while(p<p_count && c_count.*<R31_CHUNK_MAX){
        if(p_seen[p]>=min_seen){
            let gain:i32=r31_compression_gain(p_len[p],p_seen[p]);
            let g:i32=r31_grounded_consistency(p_ground_sum[p],p_ground_n[p]);
            let score:i32=gain+g*ground_weight/1000;
            if(score>0){
                let duplicate:bool=false;let c:i32=0;
                while(c<c_count.*){
                    if(c_len[c]==p_len[p]){
                        let same:bool=true;let j:i32=0;
                        while(j<p_len[p]){if(c_data[c*R31_CHUNK_LEN_MAX+j]!=p_data[p*R31_CHUNK_LEN_MAX+j]){same=false;j=p_len[p];}else{j=j+1;}}
                        if(same){duplicate=true;c=c_count.*;}else{c=c+1;}
                    }else{c=c+1;}
                }
                if(!duplicate){
                    let at:i32=c_count.*;c_count.*=c_count.*+1;c_len[at]=p_len[p];c_use[at]=0;c_utility[at]=score;
                    let k:i32=0;while(k<p_len[p]){c_data[at*R31_CHUNK_LEN_MAX+k]=p_data[p*R31_CHUNK_LEN_MAX+k];k=k+1;}
                }
            }
        }
        p=p+1;
    }
}

fn r31_chunk_match(seq:[]i32,start:i32,c_len:[]i32,c_data:[]i32,c_count:i32)i32 @noalloc {
    let best:i32=-1;let best_len:i32=0;let c:i32=0;
    while(c<c_count){
        let n:i32=c_len[c];
        if(n>best_len && start+n<=seq.len){
            let same:bool=true;let i:i32=0;
            while(i<n){if(seq[start+i]!=c_data[c*R31_CHUNK_LEN_MAX+i]){same=false;i=n;}else{i=i+1;}}
            if(same){best=c;best_len=n;}
        }
        c=c+1;
    }
    return best;
}

// Reversible longest-match segmentation. Positive IDs are recruited chunks;
// negative IDs are one-microstate literal fallback. Literal fallback guarantees
// information is not destroyed merely because the current chunk vocabulary is weak.
fn r31_segment(seq:[]i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_count:i32,
    out_id:[]i32,out_start:[]i32,out_len:[]i32,out_n:*i32,max_out:i32)void {
    let pos:i32=0;let nout:i32=0;
    while(pos<seq.len && nout<max_out){
        let c:i32=r31_chunk_match(seq,pos,c_len,c_data,c_count);
        out_start[nout]=pos;
        if(c>=0){out_id[nout]=c;out_len[nout]=c_len[c];c_use[c]=c_use[c]+1;pos=pos+c_len[c];}
        else{out_id[nout]=-1-seq[pos];out_len[nout]=1;pos=pos+1;}
        nout=nout+1;
    }
    out_n.*=nout;
}

fn r31_reconstruct(chunk_id:[]i32,chunk_n:i32,c_len:[]i32,c_data:[]i32,
    out_seq:[]i32,out_n:*i32,max_out:i32)void @noalloc {
    let n:i32=0;let q:i32=0;
    while(q<chunk_n && n<max_out){
        let id:i32=chunk_id[q];
        if(id<0){out_seq[n]=-1-id;n=n+1;}
        else{
            let j:i32=0;while(j<c_len[id] && n<max_out){out_seq[n]=c_data[id*R31_CHUNK_LEN_MAX+j];n=n+1;j=j+1;}
        }
        q=q+1;
    }
    out_n.*=n;
}

// Delayed regret lets the learner revise chunk utility. If a chunk repeatedly
// predicts poorly, interferes with grounding, or is expensive without reuse,
// its utility falls and it becomes eligible for split/archive rather than being
// immortal just because it was once frequent.
fn r31_chunk_regret_update(c_utility:[]i32,id:i32,useful:i32,reconstruction_ok:i32,rate:i32)void @noalloc {
    if(id<0){return;}let delta:i32=-rate;if(useful==1 && reconstruction_ok==1){delta=rate;}
    c_utility[id]=clamp_i32(c_utility[id]+delta,-100000,100000);
}

fn r31_chunk_should_archive(c_use:[]i32,c_utility:[]i32,id:i32,min_use:i32)i32 @noalloc {
    if(c_use[id]<min_use && c_utility[id]<0){return 1;}return 0;
}

// Pair recurrence proposes hierarchy above the current chunk layer. This lets
// useful constructions emerge at a different scale without forcing every
// acoustic phenomenon into one universal segmentation size.
fn r31_pair_hash(a:i32,b:i32)i32 @noalloc {let h:i32=(a+4099)*65537+(b+8191)*257;if(h<0){return 0-h;}return h;}
fn r31_pair_observe(ids:[]i32,n:i32,pair_hash:[]i32,pair_count:[]i32,pair_n:*i32,max_pairs:i32)void {
    let i:i32=0;while(i+1<n){let h:i32=r31_pair_hash(ids[i],ids[i+1]);let p:i32=0;let found:i32=-1;
        while(p<pair_n.*){if(pair_hash[p]==h){found=p;p=pair_n.*;}else{p=p+1;}}
        if(found>=0){pair_count[found]=pair_count[found]+1;}
        else if(pair_n.*<max_pairs){let at:i32=pair_n.*;pair_n.*=pair_n.*+1;pair_hash[at]=h;pair_count[at]=1;}
        i=i+1;
    }
}

// Alignment is downstream of learner-selected chunks. It may help compare a
// variable-duration observed chunk sequence with an expected chunk history,
// but it has no authority to invent the chunk boundaries or inventory.
fn r31_alignment_cost(observed:[]i32,on:i32,expected:[]i32,en:i32,ins_cost:i32,sub_cost:i32) i32 {
    let width:i32=en+1;let prev:[]i32=zalloc_i(width);let cur:[]i32=zalloc_i(width);
    let j:i32=0;while(j<=en){prev[j]=j*ins_cost;j=j+1;}
    let i:i32=1;while(i<=on){cur[0]=i*ins_cost;j=1;while(j<=en){let sub:i32=prev[j-1];if(observed[i-1]!=expected[j-1]){sub=sub+sub_cost;}let del:i32=prev[j]+ins_cost;let ins:i32=cur[j-1]+ins_cost;let v:i32=sub;if(del<v){v=del;}if(ins<v){v=ins;}cur[j]=v;j=j+1;}j=0;while(j<=en){prev[j]=cur[j];j=j+1;}i=i+1;}
    let out:i32=prev[en];zfree_i(prev);zfree_i(cur);return out;
}

// Extreme scores are diagnostic triggers, not automatic success/failure claims.
fn r31_extreme_score_gate(correct:i32,total:i32)i32 @noalloc {
    if(total<=0){return 2;}if(correct==0){return 1;}if(correct==total){return 1;}return 0;
}

// =============================================================================
// R31 EVIDENCE-PRESERVING CHUNK REPRESENTATION
// A chunk is not an opaque vocabulary symbol. Its recruited identity may be
// reused, while generic internal microstate and transition statistics remain
// available for discrimination and later architecture revision.
// =============================================================================
const R31_SIG_BINS:i32=32;
fn r31_chunk_signature(raw:[]i32,start:i32,n:i32,hist:[]i32,trans:[]i32)void @noalloc {
    let i:i32=0;while(i<R31_SIG_BINS){hist[i]=0;trans[i]=0;i=i+1;}
    i=0;while(i<n){let x:i32=mod_pos(raw[start+i],R31_SIG_BINS);hist[x]=hist[x]+1;
        if(i>0){let p:i32=mod_pos(raw[start+i-1]*31+raw[start+i]*17,R31_SIG_BINS);trans[p]=trans[p]+1;}i=i+1;}
}
fn r31_signature_distance(a_hist:[]i32,a_trans:[]i32,b_hist:[]i32,b_trans:[]i32)i32 @noalloc {
    let d:i32=0;let i:i32=0;while(i<R31_SIG_BINS){d=d+abs_i32(a_hist[i]-b_hist[i])+abs_i32(a_trans[i]-b_trans[i]);i=i+1;}return d;
}

// =============================================================================
// R31 SUPPORT-GAP RECRUITMENT
// Known-chunk coverage is learner state. The teacher supplies only a grounded
// whole experience/consequence; this routine identifies unsupported raw spans
// without a supplied linguistic/acoustic boundary.
// =============================================================================
fn r31_mark_chunk_coverage(seq:[]i32,c_len:[]i32,c_data:[]i32,c_count:i32,covered:[]i32)void @noalloc {
    let i:i32=0;while(i<seq.len){covered[i]=0;i=i+1;}i=0;
    while(i<seq.len){let c:i32=r31_chunk_match(seq,i,c_len,c_data,c_count);if(c>=0){let j:i32=0;while(j<c_len[c]){covered[i+j]=1;j=j+1;}i=i+c_len[c];}else{i=i+1;}}
}
fn r31_largest_support_gap(covered:[]i32,n:i32,out_start:*i32,out_len:*i32)void @noalloc {
    let best_s:i32=-1;let best_n:i32=0;let i:i32=0;
    while(i<n){if(covered[i]!=0){i=i+1;}else{let s:i32=i;while(i<n && covered[i]==0){i=i+1;}let z:i32=i-s;if(z>best_n){best_s=s;best_n=z;}}}
    out_start.*=best_s;out_len.*=best_n;
}
fn r31_span_distance(a:[]i32,astart:i32,alen:i32,b:[]i32,bstart:i32,blen:i32)i32 @noalloc {
    if(alen!=blen){return 1000000+abs_i32(alen-blen)*1000;}let d:i32=0;let i:i32=0;while(i<alen){if(a[astart+i]!=b[bstart+i]){d=d+1;}i=i+1;}return d;
}
// A fuzzy support match is admissible only when its mutable evidence margin says
// it is distinguishable from the runner-up. Ambiguous evidence can return -1.
fn r31_support_gap_choose(best_id:i32,best_dist:i32,best_support:i32,runner_id:i32,runner_dist:i32,runner_support:i32,
    learned_min_support:i32,learned_margin:i32)i32 @noalloc {
    if(best_id<0 || best_support<learned_min_support){return -1;}
    if(best_dist==0){return best_id;}
    let advantage:i32=(runner_dist-best_dist)*100+(best_support-runner_support);
    if(runner_id>=0 && runner_id!=best_id && advantage<learned_margin){return -1;}
    return best_id;
}

// =============================================================================
// R31 CONTEXT / REGIME CONSEQUENCE MEMORY
// Perceptual chunk identity is stable; consequence models may branch when
// prediction history shows that the same evidence now obeys different dynamics.
// No evaluator regime ID is an input. The arrays are generic mutable state.
// =============================================================================
fn r31_effect_at(regime:i32,entity:i32,action:i32,entity_count:i32,action_count:i32)i32 @noalloc {
    return (regime*entity_count+entity)*action_count+action;
}
fn r31_regime_predict(regime:i32,entity:i32,action:i32,entity_count:i32,action_count:i32,sum:[]i32,count:[]i32)i32 @noalloc {
    let at:i32=r31_effect_at(regime,entity,action,entity_count,action_count);if(count[at]<=0){return 0;}return sum[at]/count[at];
}
fn r31_regime_observe(regime:i32,entity:i32,action:i32,effect:i32,entity_count:i32,action_count:i32,sum:[]i32,count:[]i32)void @noalloc {
    let at:i32=r31_effect_at(regime,entity,action,entity_count,action_count);sum[at]=sum[at]+effect;count[at]=count[at]+1;
}
fn r31_regime_error(predicted:i32,observed:i32)i32 @noalloc {return abs_i32(predicted-observed);}
// Candidate selection uses learned/contextual accumulated evidence supplied by
// mutable state; this core primitive contains no named world modes.
fn r31_regime_choose(candidate_score:[]i32,regime_count:i32,current:i32,learned_switch_margin:i32)i32 @noalloc {
    let best:i32=current;let bestv:i32=candidate_score[current];let r:i32=0;while(r<regime_count){if(candidate_score[r]>bestv){best=r;bestv=candidate_score[r];}r=r+1;}
    if(best!=current && bestv-candidate_score[current]>=learned_switch_margin){return best;}return current;
}
fn r31_regime_should_recruit(window_error:i32,window_n:i32,learned_error_trigger:i32,regime_count:i32,max_regimes:i32)i32 @noalloc {
    if(window_n<=0 || regime_count>=max_regimes){return 0;}if(window_error/window_n>=learned_error_trigger){return 1;}return 0;
}

// =============================================================================
// R31 LEARNED REINSPECTION VALUE
// Confidence is evidence, not authority. Generic features such as current
// margin, temporal disagreement, prediction error and prior reinspection regret
// are scored by mutable learned weights. No corruption type or evaluator answer
// is encoded here.
// =============================================================================
fn r31_reinspection_value(features:[]i32,weights:[]i32,n:i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<n){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r31_should_reinspect_learned(features:[]i32,weights:[]i32,n:i32,bias:i32,learned_threshold:i32)i32 @noalloc {
    if(r31_reinspection_value(features,weights,n,bias)>=learned_threshold){return 1;}return 0;
}
fn r31_reinspection_regret_update(weights:[]i32,features:[]i32,n:i32,helped:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(helped==1){sign=1;}let i:i32=0;while(i<n){weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-8000,8000);i=i+1;}
}

// =============================================================================
// R31 LEARNER-DRIVEN CHUNK SPLIT / MERGE
// Chunk boundaries are mutable hypotheses. These generic operations change
// learner-owned chunks only after accumulated internal regret / recurrence
// evidence requests the edit. No evaluator, word, phoneme, or VAD boundary is
// supplied to either operation.
// =============================================================================
fn r31_chunk_should_split(utility:i32,conflict:i32,use_count:i32,learned_conflict:i32,learned_utility_floor:i32)i32 @noalloc {
    if(use_count<3){return 0;}
    if(conflict>=learned_conflict && utility<=learned_utility_floor){return 1;}
    return 0;
}
fn r31_chunk_split(id:i32,split_at:i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32)i32 {
    if(id<0 || id>=c_count.*){return -1;}
    let old_len:i32=c_len[id];
    if(split_at<=0 || split_at>=old_len || c_count.*>=R31_CHUNK_MAX){return -1;}
    let new_id:i32=c_count.*;c_count.*=c_count.*+1;
    let suffix:i32=old_len-split_at;let j:i32=0;
    while(j<suffix){c_data[new_id*R31_CHUNK_LEN_MAX+j]=c_data[id*R31_CHUNK_LEN_MAX+split_at+j];j=j+1;}
    c_len[new_id]=suffix;c_use[new_id]=0;c_utility[new_id]=c_utility[id]/2;
    c_len[id]=split_at;c_utility[id]=c_utility[id]/2;
    return new_id;
}
fn r31_chunk_should_merge(pair_seen:i32,joint_gain:i32,separate_regret:i32,learned_pair_seen:i32,learned_gain:i32)i32 @noalloc {
    if(pair_seen<learned_pair_seen){return 0;}
    if(joint_gain-separate_regret>=learned_gain){return 1;}
    return 0;
}
fn r31_chunk_merge(a:i32,b:i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32)i32 {
    if(a<0 || b<0 || a>=c_count.* || b>=c_count.* || c_count.*>=R31_CHUNK_MAX){return -1;}
    let na:i32=c_len[a];let nb:i32=c_len[b];if(na+nb>R31_CHUNK_LEN_MAX){return -1;}
    let id:i32=c_count.*;c_count.*=c_count.*+1;let i:i32=0;
    while(i<na){c_data[id*R31_CHUNK_LEN_MAX+i]=c_data[a*R31_CHUNK_LEN_MAX+i];i=i+1;}
    let j:i32=0;while(j<nb){c_data[id*R31_CHUNK_LEN_MAX+na+j]=c_data[b*R31_CHUNK_LEN_MAX+j];j=j+1;}
    c_len[id]=na+nb;c_use[id]=0;c_utility[id]=(c_utility[a]+c_utility[b])/2;return id;
}
fn r31_chunk_edit_traced(step:i32,operation:i32,source:i32,result:i32,evidence:i32,parent_event:i32,
    t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    let reason:i32=REASON_DELAYED_REGRET;if(operation==2){reason=REASON_VERIFIED_GAIN;}
    trace_emit(step,STAGE_REVISION,reason,result,evidence,800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}

// =============================================================================
// R31 ACTIVE DISCRIMINATING CONSEQUENCE PROBE
// When self-chunk evidence leaves two grounded hypotheses plausible, TNN may
// choose an action/observation whose learned predicted consequences separate
// them most. This is generic active evidence seeking: no evaluator identity,
// acoustic-unit label, or hardcoded task answer enters the mechanism.
// =============================================================================
fn r31_discriminating_action_choose(candidate_a:i32,candidate_b:i32,action_count:i32,
    predicted_effect:[]i32,action_cost:[]i32,learned_cost_weight:i32)i32 @noalloc {
    let best:i32=0;let bestv:i32=-2147480000;let a:i32=0;
    while(a<action_count){
        let va:i32=predicted_effect[candidate_a*action_count+a];
        let vb:i32=predicted_effect[candidate_b*action_count+a];
        let sep:i32=abs_i32(va-vb)*1000-action_cost[a]*learned_cost_weight;
        if(sep>bestv){bestv=sep;best=a;}a=a+1;
    }
    return best;
}
fn r31_candidate_consequence_score(old_score:i32,predicted:i32,observed:i32,learned_error_weight:i32)i32 @noalloc {
    return old_score-abs_i32(predicted-observed)*learned_error_weight;
}
fn r31_multimodal_abstain(best_score:i32,runner_score:i32,crossmodal_disagreement:i32,learned_margin:i32,learned_conflict:i32)i32 @noalloc {
    if(best_score-runner_score<learned_margin){return 1;}
    if(crossmodal_disagreement>=learned_conflict){return 1;}
    return 0;
}

// =============================================================================
// R31 LEARNED COMMIT / CONTINUE / ABSTAIN RELIABILITY
// Delayed outcomes train generic internal evidence weights. This mechanism does
// not know ambiguity types or evaluator answers; it learns whether commitment at
// a given evidence state historically survived later independent evidence.
// =============================================================================
const R31_COMMIT_FEATURES:i32=7;
fn r31_commit_reliability(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<R31_COMMIT_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r31_commit_decision(features:[]i32,weights:[]i32,bias:i32,commit_threshold:i32,abstain_threshold:i32,expected_gain:i32,observation_cost:i32)i32 @noalloc {
    let v:i32=r31_commit_reliability(features,weights,bias);
    if(v>=commit_threshold){return 1;} // commit
    if(expected_gain>observation_cost){return 0;} // gather discriminating evidence
    if(v<=abstain_threshold){return -1;} // explicit unknown
    return -1;
}
fn r31_commit_regret_update(weights:[]i32,features:[]i32,safe_to_commit:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(safe_to_commit==1){sign=1;}let i:i32=0;
    while(i<R31_COMMIT_FEATURES){weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-8000,8000);i=i+1;}
}

// =============================================================================
// R31 REGIME-SWITCH HYSTERESIS
// A consequence-memory switch requires persistent comparative evidence and a
// cooldown. Single noisy observations cannot thrash the active regime model.
// =============================================================================
fn r31_regime_hysteresis_choose(candidate_score:[]i32,regime_count:i32,current:i32,learned_margin:i32,
    transition_support:*i32,transition_counter:*i32,learned_persistence_value:i32,learned_change_cost:i32)i32 @noalloc {
    let best:i32=current;let bestv:i32=candidate_score[current];let r:i32=0;
    while(r<regime_count){if(candidate_score[r]>bestv){best=r;bestv=candidate_score[r];}r=r+1;}
    let margin:i32=bestv-candidate_score[current];
    if(best==current){
        transition_counter.*=clamp_i32(transition_counter.*+abs_i32(margin),0,2000000);
        transition_support.*=clamp_i32(transition_support.*-abs_i32(margin),0,2000000);
        return current;
    }
    transition_support.*=clamp_i32(transition_support.*+clamp_i32(margin,0,2000000),0,2000000);
    let change_value:i32=transition_support.*-transition_counter.*-learned_persistence_value-learned_change_cost-learned_margin;
    if(change_value>0){transition_support.*=0;transition_counter.*=0;return best;}
    return current;
}

// =============================================================================
// R31 DUAL HIGH-FIDELITY / SELF-CHUNK EVIDENCE ROUTE
// The learner may compress/index experience through endogenous chunks while a
// raw/exact route remains available. Mutable trust weights decide how much each
// route contributes; chunking is never allowed to erase evidence merely because
// it compresses well.
// =============================================================================
fn r31_dual_evidence_score(chunk_score:i32,raw_score:i32,chunk_weight:i32,raw_weight:i32,reconstruction_error:i32,route_disagreement:i32)i32 @noalloc {
    let cw:i32=chunk_weight-reconstruction_error-route_disagreement/2;
    if(cw<0){cw=0;}let rw:i32=raw_weight+reconstruction_error+route_disagreement/2;
    return chunk_score*cw/1000+raw_score*rw/1000;
}
fn r31_dual_route_weight_update(chunk_weight:*i32,raw_weight:*i32,chunk_helped:i32,raw_helped:i32,reconstruction_ok:i32,rate:i32)void @noalloc {
    if(chunk_helped==1 && reconstruction_ok==1){chunk_weight.*=clamp_i32(chunk_weight.*+rate,0,2000);}else{chunk_weight.*=clamp_i32(chunk_weight.*-rate,0,2000);}
    if(raw_helped==1){raw_weight.*=clamp_i32(raw_weight.*+rate,0,2000);}else{raw_weight.*=clamp_i32(raw_weight.*-rate/2,0,2000);}
}
fn r31_should_retrieve_raw(reconstruction_error:i32,route_disagreement:i32,uncertainty:i32,resource_cost:i32,learned_value_threshold:i32)i32 @noalloc {
    let value:i32=reconstruction_error*3+route_disagreement*2+uncertainty*2-resource_cost;
    if(value>=learned_value_threshold){return 1;}return 0;
}

// =============================================================================
// R32 PERSISTENT EPISTEMIC WORLD-STATE UNCERTAINTY
// Multiple grounded hypotheses remain live across observations. Evidence is
// provenance-aware: repeated evidence from one dependent source is discounted
// rather than counted as independent confirmation. No ambiguity label,
// linguistic unit, or evaluator answer enters these primitives.
// =============================================================================
const R32_HYP_MAX:i32=16;
const R32_SOURCE_MAX:i32=16;
const R32_META_FEATURES:i32=7;

fn r32_hyp_init(score:[]i32,count:i32)void @noalloc {
    let i:i32=0;while(i<count){score[i]=0;i=i+1;}
}
fn r32_source_weight(source_seen:i32,base_trust:i32,dependence_penalty:i32)i32 @noalloc {
    let denom:i32=1000+dependence_penalty*source_seen;
    if(denom<=0){return base_trust;}return base_trust*1000/denom;
}
fn r32_hyp_observe(score:[]i32,evidence:[]i32,hyp_count:i32,source:i32,
    source_seen:[]i32,source_trust:[]i32,dependence_penalty:i32)void @noalloc {
    let seen:i32=source_seen[source];let w:i32=r32_source_weight(seen,source_trust[source],dependence_penalty);
    source_seen[source]=seen+1;let h:i32=0;while(h<hyp_count){score[h]=score[h]+evidence[h]*w/1000;h=h+1;}
}
fn r32_hyp_top2(score:[]i32,hyp_count:i32,out_best:*i32,out_runner:*i32,out_margin:*i32)void @noalloc {
    let b:i32=-1;let r:i32=-1;let bv:i32=-2147480000;let rv:i32=-2147480000;let h:i32=0;
    while(h<hyp_count){let v:i32=score[h];if(v>bv){rv=bv;r=b;bv=v;b=h;}else if(v>rv){rv=v;r=h;}h=h+1;}
    out_best.*=b;out_runner.*=r;if(r<0){out_margin.*=2147480000;}else{out_margin.*=bv-rv;}
}
fn r32_independent_source_fraction(source_seen:[]i32,source_count:i32)i32 @noalloc {
    let used:i32=0;let i:i32=0;while(i<source_count){if(source_seen[i]>0){used=used+1;}i=i+1;}
    if(source_count<=0){return 0;}return used*1000/source_count;
}
fn r32_evidence_dependence(source_seen:[]i32,source_count:i32)i32 @noalloc {
    let total:i32=0;let peak:i32=0;let i:i32=0;while(i<source_count){total=total+source_seen[i];if(source_seen[i]>peak){peak=source_seen[i];}i=i+1;}
    if(total<=0){return 1000;}return peak*1000/total;
}
fn r32_score_volatility(previous:[]i32,current:[]i32,hyp_count:i32)i32 @noalloc {
    let d:i32=0;let h:i32=0;while(h<hyp_count){d=d+abs_i32(current[h]-previous[h]);h=h+1;}if(hyp_count<=0){return 0;}return d/hyp_count;
}
fn r32_unresolved_index(score:[]i32,hyp_count:i32,source_seen:[]i32,source_count:i32,volatility:i32,margin_scale:i32)i32 @noalloc {
    let b:i32=0;let r:i32=0;let margin:i32=0;r32_hyp_top2(score,hyp_count,&b,&r,&margin);
    let m:i32=1000-clamp_i32(margin*margin_scale,0,1000);
    let dep:i32=r32_evidence_dependence(source_seen,source_count);
    let ind:i32=1000-r32_independent_source_fraction(source_seen,source_count);
    return clamp_i32((m*4+dep*2+ind*2+clamp_i32(volatility,0,1000)*2)/10,0,1000);
}
fn r32_discriminating_observation_choose(candidate_a:i32,candidate_b:i32,obs_count:i32,
    predicted_evidence:[]i32,obs_cost:[]i32,learned_cost_weight:i32)i32 @noalloc {
    let best:i32=-1;let bestv:i32=-2147480000;let o:i32=0;while(o<obs_count){
        let va:i32=predicted_evidence[candidate_a*obs_count+o];let vb:i32=predicted_evidence[candidate_b*obs_count+o];
        let gain:i32=abs_i32(va-vb)*1000-obs_cost[o]*learned_cost_weight;if(gain>bestv){bestv=gain;best=o;}o=o+1;
    }return best;
}
fn r32_epistemic_features(margin:i32,unresolved:i32,independent_fraction:i32,dependence:i32,
    volatility:i32,crossmodal_consistency:i32,expected_gain:i32,out:[]i32)void @noalloc {
    out[0]=margin;out[1]=1000-unresolved;out[2]=independent_fraction;out[3]=1000-dependence;
    out[4]=1000-clamp_i32(volatility,0,1000);out[5]=crossmodal_consistency;out[6]=expected_gain;
}
fn r32_commit_value(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<R32_META_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r32_epistemic_decide(features:[]i32,weights:[]i32,bias:i32,learned_commit:i32,
    learned_unknown:i32,expected_gain:i32,observation_cost:i32)i32 @noalloc {
    let v:i32=r32_commit_value(features,weights,bias);
    if(v>=learned_commit){return 1;} // commit to best live hypothesis
    if(expected_gain>observation_cost){return 0;} // gather discriminating evidence
    if(v<=learned_unknown){return -1;} // economically unresolved: UNKNOWN
    return -1;
}
fn r32_commit_regret_update(weights:[]i32,features:[]i32,eventual_commit_safe:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(eventual_commit_safe==1){sign=1;}let i:i32=0;while(i<R32_META_FEATURES){
        weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-12000,12000);i=i+1;}
}

// =============================================================================
// R32 LEARNED SOURCE RELIABILITY + TEMPORAL CHANGE HYPOTHESES
// Source trust is revised only from delayed outcome agreement. Correlated source
// groups can be aggregated before they influence the hypothesis population.
// Temporal replacement is represented as a competing recent-state hypothesis;
// it does not overwrite long history after one surprising observation.
// =============================================================================
fn r32_source_trust_update(trust:*i32,evidence_advantage:i32,delayed_correct:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(delayed_correct==1){sign=1;}
    trust.*=clamp_i32(trust.*+sign*rate*clamp_i32(abs_i32(evidence_advantage),0,1000)/1000,100,2000);
}
fn r32_group_evidence_add(group:i32,evidence:[]i32,hyp_count:i32,group_sum:[]i32,group_n:[]i32,group_count:i32)void @noalloc {
    if(group<0 || group>=group_count){return;}let h:i32=0;while(h<hyp_count){group_sum[group*hyp_count+h]=group_sum[group*hyp_count+h]+evidence[h];h=h+1;}group_n[group]=group_n[group]+1;
}
fn r32_group_evidence_score(group_sum:[]i32,group_n:[]i32,group_count:i32,hyp_count:i32,out_score:[]i32)void @noalloc {
    let h:i32=0;while(h<hyp_count){out_score[h]=0;h=h+1;}let g:i32=0;while(g<group_count){if(group_n[g]>0){h=0;while(h<hyp_count){out_score[h]=out_score[h]+group_sum[g*hyp_count+h]/group_n[g];h=h+1;}}g=g+1;}
}
fn r32_recent_score_push(evidence:[]i32,hyp_count:i32,recent_sum:[]i32,recent_ring:[]i32,ring_width:i32,ring_at:*i32,ring_n:*i32)void @noalloc {
    let slot:i32=ring_at.*;let h:i32=0;
    if(ring_n.*>=ring_width){while(h<hyp_count){recent_sum[h]=recent_sum[h]-recent_ring[slot*hyp_count+h];h=h+1;}}
    else{ring_n.*=ring_n.*+1;}
    h=0;while(h<hyp_count){recent_ring[slot*hyp_count+h]=evidence[h];recent_sum[h]=recent_sum[h]+evidence[h];h=h+1;}
    ring_at.*=mod_pos(slot+1,ring_width);
}
fn r32_change_hypothesis_update(current:i32,recent_score:[]i32,hyp_count:i32,learned_margin:i32,
    candidate:*i32,transition_support:*i32,transition_counter:*i32,learned_persistence_value:i32) i32 @noalloc {
    let best:i32=0;let runner:i32=0;let margin:i32=0;r32_hyp_top2(recent_score,hyp_count,&best,&runner,&margin);
    if(best==current){
        transition_counter.*=clamp_i32(transition_counter.*+margin,0,2000000);
        transition_support.*=clamp_i32(transition_support.*-margin,0,2000000);
        candidate.*=-1;
        return current;
    }
    candidate.*=best;
    transition_support.*=clamp_i32(transition_support.*+margin,0,2000000);
    let leave_value:i32=transition_support.*-transition_counter.*-learned_persistence_value-learned_margin;
    if(leave_value>0){
        transition_support.*=0;
        transition_counter.*=0;
        candidate.*=-1;
        return best;
    }
    return current;
}
fn r32_temporal_hypothesis_blend(long_score:[]i32,recent_score:[]i32,hyp_count:i32,recent_weight:i32,out:[]i32)void @noalloc {
    let rw:i32=clamp_i32(recent_weight,0,1000);let h:i32=0;while(h<hyp_count){out[h]=long_score[h]*(1000-rw)/1000+recent_score[h]*rw/1000;h=h+1;}
}

// =============================================================================
// R32 TNN-CONTROLLED RAW EXEMPLAR / CHUNK RESOURCE POLICY
// Self-chunks may compress/index experience, but TNN can retain exact raw
// exemplars when delayed regret says future discrimination needs them.
// =============================================================================
const R32_RAW_FEATURES:i32=7;
fn r32_raw_exemplar_value(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<R32_RAW_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r32_should_keep_raw(features:[]i32,weights:[]i32,bias:i32,resource_pressure:i32,learned_threshold:i32)i32 @noalloc {
    let v:i32=r32_raw_exemplar_value(features,weights,bias)-resource_pressure;if(v>=learned_threshold){return 1;}return 0;
}
fn r32_raw_exemplar_regret_update(weights:[]i32,features:[]i32,raw_was_needed:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(raw_was_needed==1){sign=1;}let i:i32=0;while(i<R32_RAW_FEATURES){weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-12000,12000);i=i+1;}
}

// =============================================================================
// R32 LEARNED TEMPORAL SWITCH POLICY
// Candidate state changes are judged from learner-internal evidence only.
// Weights are mutable and may be revised when later independent evidence shows
// that an earlier commit was stable or premature.
// =============================================================================
const R32_SWITCH_FEATURES:i32=7;
fn r32_switch_policy_value(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<R32_SWITCH_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r32_switch_policy_choose(features:[]i32,weights:[]i32,bias:i32,learned_threshold:i32)i32 @noalloc {
    if(r32_switch_policy_value(features,weights,bias)>=learned_threshold){return 1;}return 0;
}
fn r32_switch_policy_regret_update(features:[]i32,weights:[]i32,stable_later:i32,false_switch_cost:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(stable_later==1){sign=1;}
    let scale:i32=1000;if(stable_later==0){scale=1000+clamp_i32(false_switch_cost,0,3000);}
    let i:i32=0;while(i<R32_SWITCH_FEATURES){
        weights[i]=clamp_i32(weights[i]+sign*rate*features[i]*scale/1000000,-10000,10000);i=i+1;
    }
}

// =============================================================================
// R32 CAUSAL TRACE WRAPPERS
// Epistemic uncertainty, source-trust revision and temporal state replacement
// are consequential cognitive events and therefore receive explicit parent-linked
// trace records. Evidence values are learner-internal; evaluator answers are not
// accepted by these entry points.
// =============================================================================
fn r32_source_trust_update_traced(source:i32,trust:*i32,evidence_advantage:i32,delayed_correct:i32,rate:i32,
    step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    let before:i32=trust.*;r32_source_trust_update(trust,evidence_advantage,delayed_correct,rate);
    let reason:i32=REASON_SOURCE_CONFLICT;if(delayed_correct==1){reason=REASON_VERIFIED_GAIN;}
    trace_emit(step,STAGE_SOCIAL,reason,source,trust.*-before,trust.*,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}
fn r32_epistemic_decide_traced(features:[]i32,weights:[]i32,bias:i32,commit_threshold:i32,unknown_threshold:i32,expected_gain:i32,observation_cost:i32,
    candidate:i32,step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let d:i32=r32_epistemic_decide(features,weights,bias,commit_threshold,unknown_threshold,expected_gain,observation_cost);
    let reason:i32=REASON_UNCERTAINTY;if(d==1){reason=REASON_VERIFIED_GAIN;}
    trace_emit(step,STAGE_DECISION,reason,candidate,r32_commit_value(features,weights,bias),1000-features[0],parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return d;
}
fn r32_switch_policy_choose_traced(features:[]i32,weights:[]i32,bias:i32,learned_threshold:i32,candidate:i32,
    step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let d:i32=r32_switch_policy_choose(features,weights,bias,learned_threshold);let reason:i32=REASON_UNCERTAINTY;
    if(d==1){reason=REASON_EVIDENCE_GAIN;}
    trace_emit(step,STAGE_DECISION,reason,candidate,r32_switch_policy_value(features,weights,bias),800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return d;
}

// =============================================================================
// R32 HIGH-FIDELITY TEMPORAL RAW-EVIDENCE ROUTE
// Endogenous chunks are reusable hypotheses, not the only sensory representation.
// This route preserves generic local temporal statistics over learner-derived
// acoustic microstates so chunking cannot erase order-sensitive evidence.
// No supplied linguistic unit, boundary, VAD state, or surface vocabulary exists here.
// =============================================================================
const R32_RAW_MICRO_BINS:i32=96;
const R32_RAW_PAIR_BINS:i32=512;
const R32_RAW_TRIPLE_BINS:i32=1024;

fn r32_raw_temporal_signature(seq:[]i32,
    micro_hist:[]i32,pair_hist:[]i32,triple_hist:[]i32)void @noalloc {
    let i:i32=0;
    while(i<micro_hist.len){micro_hist[i]=0;i=i+1;}
    i=0;while(i<pair_hist.len){pair_hist[i]=0;i=i+1;}
    i=0;while(i<triple_hist.len){triple_hist[i]=0;i=i+1;}
    i=0;
    while(i<seq.len){
        let a:i32=mod_pos(seq[i],micro_hist.len);micro_hist[a]=micro_hist[a]+1;
        if(i+1<seq.len){let p:i32=mod_pos(seq[i]*131+seq[i+1]*17,pair_hist.len);pair_hist[p]=pair_hist[p]+1;}
        if(i+2<seq.len){let t:i32=mod_pos(seq[i]*65537+seq[i+1]*257+seq[i+2]*31,triple_hist.len);triple_hist[t]=triple_hist[t]+1;}
        i=i+1;
    }
}

fn r32_hist_l1(a:[]i32,b:[]i32)i32 @noalloc {
    let d:i32=0;let i:i32=0;while(i<a.len && i<b.len){d=d+abs_i32(a[i]-b[i]);i=i+1;}return d;
}

fn r32_raw_temporal_distance(
    a_micro:[]i32,a_pair:[]i32,a_triple:[]i32,
    b_micro:[]i32,b_pair:[]i32,b_triple:[]i32,
    micro_weight:i32,pair_weight:i32,triple_weight:i32)i32 @noalloc {
    let d0:i32=r32_hist_l1(a_micro,b_micro);
    let d1:i32=r32_hist_l1(a_pair,b_pair);
    let d2:i32=r32_hist_l1(a_triple,b_triple);
    return d0*micro_weight+d1*pair_weight+d2*triple_weight;
}

// Mutable arbitration: delayed downstream evidence can increase or decrease the
// value assigned to high-fidelity temporal evidence and chunk evidence.
fn r32_dual_temporal_value(raw_value:i32,chunk_value:i32,
    raw_weight:i32,chunk_weight:i32,bias:i32)i32 @noalloc {
    return bias+raw_value*raw_weight/1000+chunk_value*chunk_weight/1000;
}

fn r32_dual_temporal_weight_update(raw_weight:*i32,chunk_weight:*i32,
    raw_helped:i32,chunk_helped:i32,rate:i32)void @noalloc {
    let rs:i32=-1;if(raw_helped==1){rs=1;}
    let cs:i32=-1;if(chunk_helped==1){cs=1;}
    raw_weight.*=clamp_i32(raw_weight.*+rs*rate,-8000,8000);
    chunk_weight.*=clamp_i32(chunk_weight.*+cs*rate,-8000,8000);
}

// =============================================================================
// R32 DUAL TEMPORAL / LEARNER-SEGMENT STATE PAM
// High-fidelity temporal evidence remains continuously available. A second
// learner-owned state may reset and summarize contiguous intervals when delayed
// downstream evidence shows that doing so is useful. The reset process receives
// no externally supplied boundary, linguistic unit, or named acoustic class.
// =============================================================================
const R32_SEGMENT_FEATURES:i32=6;

fn r32_segment_gate_value(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;
    while(i<R32_SEGMENT_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}
    return v;
}

fn r32_segment_gate_choose(features:[]i32,weights:[]i32,bias:i32,learned_threshold:i32)i32 @noalloc {
    if(r32_segment_gate_value(features,weights,bias)>=learned_threshold){return 1;}
    return 0;
}

// Maintains an online contiguous interval accumulator. A learned reset closes
// the previous interval before the current observation is incorporated.
fn r32_segment_state_step(observation:i32,reset:i32,
    active_sum:*i32,active_n:*i32,closed_sum:*i32,closed_n:*i32)void @noalloc {
    if(reset==1 && active_n.*>0){
        closed_sum.*=active_sum.*;closed_n.*=active_n.*;
        active_sum.*=0;active_n.*=0;
    }
    active_sum.*=active_sum.*+observation;active_n.*=active_n.*+1;
}

fn r32_segment_state_mean(sum:i32,n:i32)i32 @noalloc {
    if(n<=0){return 0;}return sum/n;
}

// Dual arbitration keeps the continuous temporal route and the interval route
// separately visible. Mutable weights are revised from delayed consequences.
fn r32_dual_segmental_value(raw_max:i32,raw_mean:i32,segment_max:i32,segment_mean:i32,
    raw_weight:i32,segment_weight:i32,bias:i32)i32 @noalloc {
    let raw:i32=(raw_max+raw_mean)/2;let seg:i32=(segment_max+segment_mean)/2;
    return bias+raw*raw_weight/1000+seg*segment_weight/1000;
}

fn r32_dual_segmental_weight_update(raw_weight:*i32,segment_weight:*i32,
    raw_helped:i32,segment_helped:i32,rate:i32)void @noalloc {
    let rs:i32=-1;if(raw_helped==1){rs=1;}
    let ss:i32=-1;if(segment_helped==1){ss=1;}
    raw_weight.*=clamp_i32(raw_weight.*+rs*rate,-12000,12000);
    segment_weight.*=clamp_i32(segment_weight.*+ss*rate,-12000,12000);
}

// The reset learner is rewarded only when its interval state improves later
// grounded prediction or discrimination. A reset is not rewarded merely for
// shortening or compressing the stream.
fn r32_segment_gate_regret_update(weights:[]i32,features:[]i32,
    segment_helped:i32,false_reset_cost:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(segment_helped==1){sign=1;}
    let scale:i32=1000;if(segment_helped==0){scale=1000+clamp_i32(false_reset_cost,0,3000);}
    let i:i32=0;while(i<R32_SEGMENT_FEATURES){
        weights[i]=clamp_i32(weights[i]+sign*rate*features[i]*scale/1000000,-12000,12000);i=i+1;
    }
}

fn r32_segment_gate_update_traced(weights:[]i32,features:[]i32,segment_helped:i32,
    false_reset_cost:i32,rate:i32,step:i32,subject:i32,parent_event:i32,
    t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,
    t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    r32_segment_gate_regret_update(weights,features,segment_helped,false_reset_cost,rate);
    let reason:i32=REASON_REGRESSION;if(segment_helped==1){reason=REASON_VERIFIED_GAIN;}
    trace_emit(step,STAGE_PAM,reason,subject,r32_segment_gate_value(features,weights,0),
        700,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}

// =============================================================================
// R32 GENERIC LOCAL TEMPORAL PAM EXECUTOR
// A non-core PAM may allocate and train local temporal kernels over any raw
// learner-derived feature stream. The protected substrate supplies only the
// execution physics. Kernel weights, dilation, channel count, routing, training
// dose, and promotion/rollback decisions remain mutable TNN state.
// =============================================================================
const R32_TEMPORAL_SCALE:i32=1000;
fn r32_temporal_pam_apply(input:[]i32,frames:i32,in_dim:i32,
    weights:[]i32,bias:[]i32,out_channels:i32,kernel_width:i32,dilation:i32,
    output:[]i32)void @noalloc {
    let t:i32=0;
    while(t<frames){
        let oc:i32=0;
        while(oc<out_channels){
            let acc:i32=bias[oc]*R32_TEMPORAL_SCALE;
            let k:i32=0;
            while(k<kernel_width){
                let src:i32=t-k*dilation;
                if(src>=0){
                    let d:i32=0;
                    while(d<in_dim){
                        let wi:i32=(oc*kernel_width+k)*in_dim+d;
                        acc=acc+input[src*in_dim+d]*weights[wi];d=d+1;
                    }
                }
                k=k+1;
            }
            acc=acc/R32_TEMPORAL_SCALE;
            if(acc<0){acc=0;}
            output[t*out_channels+oc]=clamp_i32(acc,-2000000,2000000);
            oc=oc+1;
        }
        t=t+1;
    }
}
fn r32_temporal_residual_mix(base:[]i32,local:[]i32,n:i32,
    base_weight:i32,local_weight:i32,out:[]i32)void @noalloc {
    let i:i32=0;while(i<n){out[i]=(base[i]*base_weight+local[i]*local_weight)/R32_TEMPORAL_SCALE;i=i+1;}
}
fn r32_temporal_pam_pool(input:[]i32,frames:i32,channels:i32,
    max_out:[]i32,mean_out:[]i32)void @noalloc {
    let c:i32=0;
    while(c<channels){
        let mx:i32=-2147480000;let sum:i32=0;let t:i32=0;
        while(t<frames){let v:i32=input[t*channels+c];if(v>mx){mx=v;}sum=sum+v;t=t+1;}
        max_out[c]=mx;if(frames>0){mean_out[c]=sum/frames;}else{mean_out[c]=0;}c=c+1;
    }
}
fn r32_temporal_pam_weight_update(weights:[]i32,eligibility:[]i32,n:i32,
    delayed_gain:i32,rate:i32)void @noalloc {
    let i:i32=0;while(i<n){weights[i]=clamp_i32(weights[i]+eligibility[i]*delayed_gain*rate/1000000,-16000,16000);i=i+1;}
}
fn r32_temporal_pam_shadow_decide(retained_score:i32,candidate_score:i32,
    regression_cost:i32,resource_cost:i32,learned_margin:i32)i32 @noalloc {
    let net:i32=candidate_score-retained_score-regression_cost-resource_cost;
    if(net>=learned_margin){return 1;}return 0;
}
fn r32_test_temporal_pam_executor()i32 {
    let input:[]i32=zalloc_i(12);let w:[]i32=zalloc_i(4);let b:[]i32=zalloc_i(1);
    let out:[]i32=zalloc_i(6);let mx:[]i32=zalloc_i(1);let mean:[]i32=zalloc_i(1);
    let i:i32=0;while(i<12){input[i]=i+1;i=i+1;}w[0]=500;w[1]=500;w[2]=250;w[3]=250;b[0]=0;
    r32_temporal_pam_apply(input,6,2,w,b,1,2,1,out);r32_temporal_pam_pool(out,6,1,mx,mean);
    if(mx[0]>0 && mean[0]>0 && r32_temporal_pam_shadow_decide(700,900,20,20,100)==1){return 1;}return 0;
}

84e0343590e18750f640f56e126fac46835c6e85 blob 12062
name: R32 E51X Extended Trajectory Dose

on:
  push:
    branches: [r32-agent-sequential-frontier]
    paths:
      - 'Research/R32_E51X_EXTENDED_TRAJECTORY_DOSE_PREREG.md'
      - '.github/workflows/r32-e51x-native.yml'

permissions:
  contents: read

jobs:
  execute:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Assemble native E51X discriminator
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .scratch/e51x
          cp Research/tnn_r32_e45_investigation_core.zag .scratch/e51x/tnn_r32_e45_investigation_core.zag
          python3 - <<'PY'
          from pathlib import Path

          # Preserve the same dependency repairs used by the validated E51W run.
          e51e=''.join(Path(p).read_text() for p in ['Research/R32_E51E_NATIVE/00_compat.zagfrag','Research/R32_E51E_NATIVE/01_joint_action_value.zagfrag','Research/R32_E51E_NATIVE/02_validation.zagfrag','Research/R32_E51E_NATIVE/03_run_and_gates.zagfrag'])
          assert e51e.count('fn e51e_build_training_episode(')==1
          e51e=e51e.replace('fn e51e_build_training_episode(','fn e51e_build_training_episode_retired_seed_coupled(',1)

 return Ep(kind,e,tw,target,idx[target],(yt if target==ye else ye),twi,passive,ctxv,avail,cost,phys,noise,fa,fb)

class State:
 def __init__(self,K,prov=False,temporal=False):
  self.K=K;self.prov=prov;self.temporal=temporal;self.score=np.zeros(K);self.group_n=np.zeros(6,int);self.seen=np.zeros(S,bool);self.hist=[];self.cost=0.;self.failed_gain=0
 def clone(self):
  z=State(self.K,self.prov,self.temporal);z.score=self.score.copy();z.group_n=self.group_n.copy();z.seen=self.seen.copy();z.hist=[(s,e.copy()) for s,e in self.hist];z.cost=self.cost;z.failed_gain=self.failed_gain;return z
 def add(self,s,v,cost):
  g=GROUP[s];w=1/(1+.9*self.group_n[g]) if self.prov else 1.;self.score+=w*v;self.group_n[g]+=1;self.seen[s]=True;self.hist.append((s,v.copy()));self.cost+=cost
 def recent_score(self):
  if not self.hist:return self.score.copy()
  z=np.zeros(self.K)
  for s,v in self.hist[-3:]:
   # recency window still discounts duplicate lineage locally.
   n=sum(1 for q,_ in self.hist[-3:] if GROUP[q]==GROUP[s]);z+=v/(1+.55*max(0,n-1)) if self.prov else v
  return z
 def p(self,full=False):
  if not full:return softmax(self.score)
  # Recent evidence is a change hypothesis, not unconditional replacement authority.
  rp=softmax(self.recent_score());gp=softmax(self.score);return .48*gp+.52*rp
 def feats(self,full=False):
  p=self.p(full);gp=softmax(self.score);groups=np.count_nonzero(self.group_n);dep=self.group_n.max()/max(1,self.group_n.sum());f=[margin(p),float(p.max()),1-entropy(p),entropy(p),len(self.hist)/S,groups/6,1-dep,self.cost/3.5,self.failed_gain/3]
  f+=list(self.seen.astype(float));f+=list(np.minimum(self.group_n,3)/3)
  if full:
   rp=softmax(self.recent_score());glob=int(np.argmax(gp));recent=int(np.argmax(rp));tops=[]
   for m in range(4):
    vv=[v for s,v in self.hist if MOD[s]==m]
    if vv:tops.append(int(np.argmax(np.sum(vv,axis=0))))
   agree=(sum(x==int(np.argmax(p)) for x in tops)/len(tops)) if tops else 0.;f += [margin(rp),float(rp.max()),float(glob==recent),agree,float(len(set(tops))/max(1,len(tops)))]
  return np.asarray(f,float)
 def candfeat(self,c,full=False):
  p=self.p(full);gp=softmax(self.score);rp=softmax(self.recent_score());return np.r_[self.feats(full),p[c],gp[c],rp[c],float(c==np.argmax(gp)),float(c==np.argmax(rp))]

def physical_vec(ep,source,st,env,used_actions):
 *_,classes,idx,sig,learned=env;slot=source-5;outcome=ep.phys_outcomes[slot]
 # Delayed/cost cases deliberately make early physical observations observationally equivalent.
 if ep.kind in ('delayed_distinguishing','cost_too_high') and source in (5,6):
  z=np.zeros(len(classes));z[ep.target_idx]+=.18;z[ep.twin_idx]+=.18;return z,-1
 score=st.score if len(st.hist) else np.zeros(len(classes));a=r31.select_action(score,learned,used_actions);used_actions.append(a);obs=sig[idx[outcome],a]+ep.phys_noise[slot,a]*(.65 if ep.kind!='genuine_ambiguity' else .80);v=np.array([-((obs-learned[ci,a])**2)/(2*(.85 if ep.kind!='genuine_ambiguity' else .95)**2) for ci in range(len(classes))]);return v,a

def obs_for_source(ep,s,st,env,used_actions):
 if s in (5,6,7):return physical_vec(ep,s,st,env,used_actions)[0]
 if s==2:
  for q,v in ep.passive:
   if q==2:return v.copy()
  # active clean acoustic reinspection for ordinary cases
  w,_,L,*_=env;r=np.random.default_rng(ep.e*100003+ep.twin*97+13);ss,_=w.episode(ep.e,r,'hard_noise');return np.log(L.probs(ss)+1e-8)
 if s in (3,4):
  for q,v in ep.passive:
   if q==s:return v.copy()
  return np.zeros(st.K)
 for q,v in ep.passive:
  if q==s:return v.copy()
 return np.zeros(st.K)

def initial_state(ep,env,route):
 K=len(env[5]);st=State(K,route in ('C','D'),route=='D')
 for s,v in ep.passive:
  if ep.avail[s]:st.add(s,v,ep.cost[s])
 return st

def train_models(seed,env,route,n=1800):
 rng=np.random.default_rng(seed);full=route=='D';Xc=[];yc=[];Xr=[];yr=[];Xg=[];yg=[]
 # Curriculum is richer in unresolved histories, but condition identity never enters a feature or target.
 choices=KINDS+['genuine_ambiguity']*4+['delayed_distinguishing']*2+['entity_replacement']*2
 for j in range(n):
  kind=str(rng.choice(choices));ep=make_ep(seed*100000+j*19+7,kind,env);st=initial_state(ep,env,route);cons=delayed_consensus(ep);used=[]
  order=[s for s in rng.permutation(np.arange(2,S)) if ep.avail[s] and not st.seen[s]]
  for s in order:
   Xr.append(st.feats(full));yr.append(int(cons is not None))
   cand=set(np.argsort(st.p(full))[::-1][:2]);cand.add(int(np.argmax(softmax(st.recent_score()))))
   for c in cand:Xc.append(st.candfeat(int(c),full));yc.append(int(cons is not None and int(env[5][int(c)])==cons))
   v=obs_for_source(ep,int(s),st,env,used);before=entropy(st.p(full));z=st.clone();z.add(int(s),v,ep.cost[int(s)]);after=entropy(z.p(full));gf=np.r_[st.feats(full),np.eye(S)[int(s)],ep.cost[int(s)],st.group_n[GROUP[int(s)]]/3];Xg.append(gf);yg.append(before-after)
   st.add(int(s),v,ep.cost[int(s)])
 cm=LogisticRegression(max_iter=300,C=.8).fit(np.asarray(Xc),np.asarray(yc));rm=LogisticRegression(max_iter=300,C=.8).fit(np.asarray(Xr),np.asarray(yr));gm=Ridge(alpha=1.5).fit(np.asarray(Xg),np.asarray(yg))
 return cm,rm,gm,{'candidate_rows':len(yc),'resolve_rows':len(yr),'resolve_rate':float(np.mean(yr))}

def model_decision(st,models,full,classes):
 cm,rm,gm,_=models;p=st.p(full);cand=set(np.argsort(p)[::-1][:2]);cand.add(int(np.argmax(softmax(st.recent_score()))));best=(-1.,-1)
 for c in cand:
  q=logprob_fast(cm,st.candfeat(int(c),full));
  if q>best[0]:best=(q,int(c))
 pr=logprob_fast(rm,st.feats(full));u_commit=4*best[0]-3;u_unknown=1-1.45*pr
 return best[1],u_commit,u_unknown,pr

def run_A(ep,env,safe):
 w,rng,L,prot,ctxclf,classes,idx,sig,learned=env;safe1,safe2=safe
 st=State(len(classes),False,False)
 # A receives the same passive observations but has no provenance/temporal representation.
 for s,v in ep.passive:
  if ep.avail[s]:st.add(s,v,ep.cost[s])
 score=st.score.copy();used=[];probes=[];tops=[];outs=[]
 # R31 explicit ambiguous/correlated tests keep their exact two-grounded-probe behavior.
 if ep.kind in ('genuine_ambiguity','correlated_wrong_two'):
  for src in (5,6):
   v,a=physical_vec(ep,src,st,env,used);score+=v;st.add(src,v,ep.cost[src]);probes.append((src,v));tops.append(int(np.argmax(score)));outs.append(ep.phys_outcomes[src-5])
  p=softmax(score);mg=margin(p);pred=int(classes[int(np.argmax(p))])
  if ep.kind=='genuine_ambiguity':dec=-1 if (len(set(outs))>1 or len(set(tops))>1 or mg<.4) else pred
  else:dec=-1 if mg<.28 else pred
  return dec,st,probes
 f1=r31.feats(score,ep.ctxv);ps1=float(safe1.predict_proba([f1])[0,1]);pred=int(classes[int(np.argmax(score))])
 if ps1<.83:
  src=5;v,a=physical_vec(ep,src,st,env,used);old=int(np.argmax(score));score+=v;st.add(src,v,ep.cost[src]);probes.append((src,v));f2=r31.feats(score,ep.ctxv,old,float(np.max(score)-np.partition(score,-2)[-2]));ps2=float(safe2.predict_proba([f2])[0,1]);pred=int(classes[int(np.argmax(score))])
  if ps2<.76:
   src=6;v,a=physical_vec(ep,src,st,env,used);score+=v;st.add(src,v,ep.cost[src]);probes.append((src,v));p=softmax(score);dec=-1 if margin(p)<.32 else int(classes[int(np.argmax(p))])
  else:dec=pred
 else:dec=pred
 return dec,st,probes

def run_BC(ep,env,models,route,a_probes):
 full=False;st=initial_state(ep,env,route)
 # Matched evidence acquisition: ingest exactly the physical evidence A chose.
 for s,v in a_probes:st.add(s,v,ep.cost[s])
 c,uc,uu,pr=model_decision(st,models,full,env[5]);return (int(env[5][c]) if uc>=uu else -1),st

def gain_pred(st,models,ep,s,full):
 gf=np.r_[st.feats(full),np.eye(S)[s],ep.cost[s],st.group_n[GROUP[s]]/3];return float(models[2].predict(gf.reshape(1,-1))[0])

def run_D(ep,env,models):
 st=initial_state(ep,env,'D');used=[]
 while True:
  c,uc,uu,pr=model_decision(st,models,True,env[5]);stop=max(uc,uu);best=(-1,-1e9,0.)
  for s in range(2,S):
   if not ep.avail[s] or st.seen[s]:continue
   gp=max(0.,gain_pred(st,models,ep,s,True));dep=1/(1+.9*st.group_n[GROUP[s]]);modal=1.12 if not any(MOD[q]==MOD[s] for q,_ in st.hist) else .82;net=3.6*gp*dep*modal-ep.cost[s]
   if net>best[1]:best=(s,net,gp)
  if best[0]>=0 and best[1]>0:
   s=best[0];before=margin(st.p(True));v=obs_for_source(ep,s,st,env,used);st.add(s,v,ep.cost[s]);after=margin(st.p(True));
   if best[2]>.05 and after-before<.015:st.failed_gain+=1
   elif after-before>.15 and st.failed_gain:st.failed_gain-=1
   continue
  return (int(env[5][c]) if uc>=uu else -1),st

def eval_seed(seed,n=280):

fn e51m_development_sign_metrics(
    calibration_records:[]i32,
    linear_weights:[]i32,
    linear_biases:[]i32,
    means:[]i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_counts:[]i32,
    positive_total:[]i32,
    positive_correct:[]i32,
    negative_total:[]i32,
    negative_correct:[]i32
)void {
    let dose:i32=0;
    while(dose<E51M_DOSES){
        let sample_count:i32=e51m_dose_samples(dose);
        let cap:i32=0;
        while(cap<E51M_CAPS){
            let arm:i32=e51m_arm_index(dose,cap);
            let used:i32=e51m_cap_terms(cap);
            if(used>term_counts[dose]){ used=term_counts[dose]; }
            let record_number:i32=0;
            while(record_number<sample_count){
                let record_start:i32=record_number*E51M_CAL_RECORD_N;
                let predicted:i32=e51m_scalar_hinge_predict_record(
                    calibration_records,record_start,
                    linear_weights,dose*E45_FEATURES,linear_biases[dose],
                    means,dose*E45_FEATURES,
                    term_features,term_directions,term_coefficients,
                    dose*E51M_MAX_HINGES,used
                );
                let target:i32=calibration_records[record_start+E51M_CAL_TARGET];
                if(target>0){
                    positive_total[arm]=positive_total[arm]+1;
                    if(predicted>=0){ positive_correct[arm]=positive_correct[arm]+1; }
                }
                if(target<0){
                    negative_total[arm]=negative_total[arm]+1;
                    if(predicted<0){ negative_correct[arm]=negative_correct[arm]+1; }
                }
                record_number=record_number+1;
            }
            cap=cap+1;
        }
        dose=dose+1;
    }
}

fn e51m_validation_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    linear_weights:[]i32,
    linear_biases:[]i32,
    means:[]i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_counts:[]i32,
    known_reachable:[]i32,
    no_unique_reachable:[]i32,
    validation_positive_total:[]i32,
    validation_positive_correct:[]i32,
    validation_negative_total:[]i32,
    validation_negative_correct:[]i32,
    known_episodes:*i32,
    no_unique_episodes:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let reached:[]i32=zalloc_i(E51M_ARMS);
    e45_zero(reached,E51M_ARMS);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0; let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source

d5e5326d767340dab56070d027e7c06a6239e612 blob 6375
name: R32 E51A Agent Native Audit

on:
  push:
    branches:
      - r32-agent-sequential-frontier
    paths:
      - 'Research/tnn_r32_e50_provenance_temporal_contention_discriminator.zag'
      - 'Research/toolchain/znc_linux_x86_64_abed8aa1'
      - '.github/workflows/r32-e51a-agent-native-audit.yml'
  pull_request:
    branches:
      - main
    paths:
      - 'Research/tnn_r32_e50_provenance_temporal_contention_discriminator.zag'
      - 'Research/toolchain/znc_linux_x86_64_abed8aa1'
      - '.github/workflows/r32-e51a-agent-native-audit.yml'

permissions:
  contents: read

jobs:
  audit:
    name: E51A arm ${{ matrix.arm }}
    runs-on: ubuntu-latest
    timeout-minutes: 120
    strategy:
      fail-fast: false
      matrix:
        arm: [A, B, C, D]
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Generate frozen arm
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          src="Research/tnn_r32_e51a_${arm}.zag"
          mkdir -p ".scratch/e51a/${arm}"
          cp Research/tnn_r32_e50_provenance_temporal_contention_discriminator.zag "$src"
          test "$(grep -cF 'fn e45_qualification_main_unused()i32 {' "$src")" -eq 1
          test "$(grep -cF 'fn main()i32 {' "$src")" -eq 1
          sed -i 's/^fn main()i32 {/fn e50_main_unused()i32 {/' "$src"
          sed -i 's/^fn e45_qualification_main_unused()i32 {/fn main()i32 {/' "$src"
          if [[ "$arm" == B || "$arm" == D ]]; then
            test "$(grep -cF 'if(training_phase==2 && learned_credit>0 && training_reachable==1){' "$src")" -eq 1
            sed -i 's/if(training_phase==2 && learned_credit>0 && training_reachable==1){/if(training_phase==2 \&\& training_reachable==1){/' "$src"
          fi
          if [[ "$arm" == C || "$arm" == D ]]; then
            test "$(grep -cF 'let continue_value:i32=e45_arm_continue_value(arm,predicted);' "$src")" -eq 1
            sed -i 's/let continue_value:i32=e45_arm_continue_value(arm,predicted);/let continue_value:i32=predicted;/' "$src"
          fi
          sha256sum "$src" | tee ".scratch/e51a/${arm}/SOURCE_SHA256.txt"
          printf 'arm=%s\n' "$arm" > ".scratch/e51a/${arm}/ARM.txt"
          grep -nF 'if(training_phase==2' "$src" > ".scratch/e51a/${arm}/TRAINING_GATE.txt"
          grep -nF 'let continue_value:i32=' "$src" > ".scratch/e51a/${arm}/CONTINUE_VALUE.txt"

      - name: Compile twice with persisted official Zag compiler
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          src="Research/tnn_r32_e51a_${arm}.zag"
          out=".scratch/e51a/${arm}"
          compiler='Research/toolchain/znc_linux_x86_64_abed8aa1'
          chmod +x "$compiler"
          "$compiler" "$src" -o "$out/NATIVE_BUILD_1" > "$out/NATIVE_BUILD_1_COMPILE.log" 2>&1
          "$compiler" "$src" -o "$out/NATIVE_BUILD_2" > "$out/NATIVE_BUILD_2_COMPILE.log" 2>&1
          sha256sum "$out/NATIVE_BUILD_1" "$out/NATIVE_BUILD_2" | tee "$out/BINARY_SHA256.txt"
          cmp "$out/NATIVE_BUILD_1" "$out/NATIVE_BUILD_2"
          echo 1 > "$out/BYTE_IDENTICAL.txt"

      - name: Execute native arm
        shell: bash
        run: |
          set -euo pipefail
          arm='${{ matrix.arm }}'
          out=".scratch/e51a/${arm}"
          set +e
          timeout 3600 "$out/NATIVE_BUILD_1" > "$out/RAW.log" 2>&1
          code=$?
          set -e
          printf '%s\n' "$code" > "$out/EXIT_CODE.txt"
          grep -E '^(TNN_R32_E45_NATIVE_QUALIFICATION_GATE=|no_unique_d_|known_truth_|causal_completion_regret_gate|baseline_parity_gate|oracle_positive_prevalence_|shadow_control_gate|core_gate_sum)' "$out/RAW.log" > "$out/SUMMARY.txt" || true
          cat "$out/SUMMARY.txt"
          echo "native_exit_code=$code"

      - name: Preserve arm evidence
        uses: actions/upload-artifact@v4
        with:
          name: r32-e51a-${{ matrix.arm }}
          path: |
            .scratch/e51a/${{ matrix.arm }}/
            Research/tnn_r32_e51a_${{ matrix.arm }}.zag
          if-no-files-found: error
          compression-level: 6

  package:
    name: Package complete TNN project and E51A evidence
    needs: audit
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout full project
        uses: actions/checkout@v4

      - name: Download all E51A evidence
        uses: actions/download-artifact@v4
        with:
          pattern: r32-e51a-*
          path: Research/R32_E51A_AGENT_RUN_EVIDENCE
          merge-multiple: false

      - name: Build run report
        shell: bash
        run: |
          set -euo pipefail
          report='Research/R32_E51A_AGENT_RUN_EVIDENCE/RUN_REPORT.md'
          {
            echo '# R32 E51A Agent Native Run'
            echo
            echo "Workflow commit: $GITHUB_SHA"
            echo "Run: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
            echo
            for arm in A B C D; do
              echo "## Arm $arm"
              p="Research/R32_E51A_AGENT_RUN_EVIDENCE/r32-e51a-$arm/.scratch/e51a/$arm"
              if [[ -f "$p/SUMMARY.txt" ]]; then
                echo '```text'
                cat "$p/SUMMARY.txt"
                echo '```'
                echo "Exit code: $(cat "$p/EXIT_CODE.txt")"
                echo "Byte-identical builds: $(cat "$p/BYTE_IDENTICAL.txt")"
              else
                echo 'Arm artifact unavailable; inspect workflow job status.'
              fi
              echo
            done
          } > "$report"
          cat "$report"

      - name: Zip the entire project snapshot
        shell: bash
        run: |
          set -euo pipefail
          archive="TNN-full-project-r32-e51a-${GITHUB_SHA}.zip"
          zip -q -r "$archive" . -x '.git/*' "$archive"
          sha256sum "$archive" > "${archive}.sha256"
          ls -lh "$archive" "${archive}.sha256"

      - name: Upload complete project archive
        uses: actions/upload-artifact@v4
        with:
          name: tnn-complete-r32-e51a-${{ github.sha }}
          path: |
            TNN-full-project-r32-e51a-${{ github.sha }}.zip
            TNN-full-project-r32-e51a-${{ github.sha }}.zip.sha256
            Research/R32_E51A_AGENT_RUN_EVIDENCE/RUN_REPORT.md
          if-no-files-found: error
          compression-level: 0

d613b359984c74386a8c3608b2e5a09ad6a5b6e3 blob 7412
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0;
        let contradiction_co_mass:i32=0;
        e47_terminal_representation(
            states,t*E45_STATE_N,terminal_option,0,
            &co_viability,&contradiction_co_mass
        );
        let record_number:i32=canonical_episode*E51M_STATES_PER_EPISODE+t;
        let record_start:i32=record_number*E50_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            base_records[record_start+feature]=baseline_features[feature];
            feature=feature+1;
        }
        base_records[record_start+32]=co_viability;
        base_records[record_start+33]=contradiction_co_mass;
        let action:i32=0;
        while(action<4){
            let target:i32=e45_terminal_value(action,states,t*E45_STATE_N,initial_state,truth_state[t]);
            base_records[record_start+34+action]=target;
            if(action==R32E45_TERM_UNKNOWN && target!=0){
                unknown_target_nonzero.*=unknown_target_nonzero.*+1;
            }
            action=action+1;
        }
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features);
}

fn e51m_fit_base_terminal(
    base_records:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let forward_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let forward_biases:[]i32=zalloc_i(4);
    e45_zero(terminal_weights,4*E45_FEATURES); e45_zero(terminal_biases,4);
    e45_zero(forward_weights,4*E45_FEATURES); e45_zero(forward_biases,4);
    let count_forward:i32=0; let count_reverse:i32=0;
    let hash_forward:i32=521; let hash_reverse:i32=521;
    e50_build_batch_statistics(base_records,0,0,gram_forward,cross_forward,&count_forward,&hash_forward);
    e50_build_batch_statistics(base_records,0,1,gram_reverse,cross_reverse,&count_reverse,&hash_reverse);
    let gate:i32=1;
    if(count_forward!=E51M_BASE_SAMPLES || count_reverse!=E51M_BASE_SAMPLES){ gate=0; }
    if(hash_forward!=hash_reverse || e50_batch_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0){ gate=0; }
    let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0;
    let loss_low_forward:i32=0; let loss_high_forward:i32=0;
    e50_batch_fit(
        base_records,0,0,gram_forward,cross_forward,
        terminal_weights,terminal_biases,backup_weights,backup_biases,
        &steps_forward,&reason_forward,&trace_forward,&loss_low_forward,&loss_high_forward
    );
    let i:i32=0;
    while(i<4*E45_FEATURES){ forward_weights[i]=terminal_weights[i]; i=i+1; }
    i=0; while(i<4){ forward_biases[i]=terminal_biases[i]; i=i+1; }
    e45_zero(terminal_weights,4*E45_FEATURES); e45_zero(terminal_biases,4);
    let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0;
    let loss_low_reverse:i32=0; let loss_high_reverse:i32=0;
    e50_batch_fit(
        base_records,0,0,gram_reverse,cross_reverse,
        terminal_weights,terminal_biases,backup_weights,backup_biases,
        &steps_reverse,&reason_reverse,&trace_reverse,&loss_low_reverse,&loss_high_reverse
    );
    i=0;
    while(i<4*E45_FEATURES){
        if(terminal_weights[i]!=forward_weights[i]){ gate=0; }
        terminal_weights[i]=forward_weights[i];
        i=i+1;
    }
    i=0;
    while(i<4){
        if(terminal_biases[i]!=forward_biases[i]){ gate=0; }
        terminal_biases[i]=forward_biases[i];
        i=i+1;
    }
    if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || loss_low_forward!=loss_low_reverse || loss_high_forward!=loss_high_reverse){ gate=0; }
    let unknown_nonzero:i32=0;
    if(terminal_biases[R32E45_TERM_UNKNOWN]!=0){ unknown_nonzero=unknown_nonzero+1; }
    i=0;
    while(i<E45_FEATURES){


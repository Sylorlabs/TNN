def future_outcomes(rng,kind,target,twin_target,n=7):
 if kind=='genuine_ambiguity':
  return [target if rng.random()<.5 else twin_target for _ in range(n)]
 return [target]*n

def dev_dynamic_outcome(ep,mode,trial):
 # Generator-only developmental dynamics. The learner sees only the resulting grounded
 # consequence observation, its provenance, order, and cost.
 rr=np.random.default_rng(ep.seed*7919+trial*17011+mode*313+41)
 if mode==0:return ep.target                                  # stationary
 if mode==1:return ep.target if rr.random()<.5 else ep.twin_target  # nonunique balanced
 if mode==2:return ep.target if rr.random()<.70 else ep.twin_target # biased but nonunique
 if mode==3:return ep.twin_target if trial<2 else ep.target   # replacement -> final target
 if mode==4:
  if trial<2:return ep.target
  if trial<4:return ep.twin_target
  return ep.target                                            # apparent replacement reverses
 if mode==5:return (ep.target if trial%2==0 else ep.twin_target) if trial<4 else ep.target
 return ep.target

def dev_dynamic_consensus(ep):
 mode=getattr(ep,'dev_dynamic_mode',-1)
 if mode<0:return None
 # Infer delayed uniqueness from two later grounded windows; do not consult the generator mode.
 def win(start,n=24):
  z=[dev_dynamic_outcome(ep,mode,start+i) for i in range(n)];c=Counter(z);v,k=c.most_common(1)[0];return v,k/n
 a,fa=win(10);b,fb=win(40)
 return a if a==b and min(fa,fb)>=.80 else None

def delayed_consensus(ep):
 if getattr(ep,'dev_dynamic_mode',-1)>=0:return dev_dynamic_consensus(ep)
 def one(z):
  c=Counter(z);v,n=c.most_common(1)[0];return v,n/len(z)

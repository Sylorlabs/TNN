fn vr_quote(s:[]u8)[]u8 {let out:[]u8="\"";let i:i32=0;while(i<s.len){let c:u8=s[i];if(c==34){out=_zag_str_concat(out,"\\\"");}else if(c==92){out=_zag_str_concat(out,"\\\\");}else if(c==10){out=_zag_str_concat(out,"\\n");}else if(c==13){out=_zag_str_concat(out,"\\r");}else if(c==9){out=_zag_str_concat(out,"\\t");}else if(c<32){return "null";}else{out=_zag_str_concat(out,s[i..i+1]);}i=i+1;}return _zag_str_concat(out,"\"");}

// N12 strict serialized numeric views. No interpreter, reducer, constructor,
// learning, floating conversion, Python runtime, or graph cognition.
// The caller must own a live, immutable, validated ParentMap. Close each view
// exactly once before releasing that map; do not shallow-copy owning handles.
// This trusted-process API is not protection against arbitrary forged pointers,
// concurrent memory writers, use-after-free, or a compromised host process.
@import("binding.zag")

struct NvView {
    status:i32,node:i32,buffer:i32,dtype:i32,dstate:i32,kind:i32,width:i32,
    endian:i32,order:i32,ndim:i32,elements:i32,at:i32,bytes:i32,
    shape_node:i32,readonly:i32,source:i64,source_len:i32,nodes:i64,edges:i64,
    dims:[]i64,strides:[]i64,
}
struct NvBits {status:i32,low:i64,high:i64}
struct NvInt {status:i32,value:i64}
struct NvRow {status:i32,data:[]u8}

fn nv_empty(code:i32)NvView {
    let z:*i64=null as *i64;
    return NvView{.status=code,.node=0,.buffer=0,.dtype=0,.dstate=0,.kind=0,
        .width=0,.endian=0,.order=0,.ndim=0,.elements=0,.at=0,.bytes=0,
        .shape_node=0,.readonly=0,.source=0,.source_len=0,.nodes=0,.edges=0,
        .dims=z[0..0],.strides=z[0..0]};
}
fn nv_close(v:*NvView)void {
    pm_free_words(v.*.dims);pm_free_words(v.*.strides);v.*=nv_empty(-9008);
}
fn nv_fail(v:*NvView,code:i32)NvView {nv_close(v);return nv_empty(code);}
fn nv_ready(p:*ParentMap)i32 {
    return (p.*.status==0 && p.*.input.len>=3 && p.*.input.len<=16777216 &&
        p.*.node_count>0 && p.*.node_count<=524288 && p.*.node_count<=p.*.nodes.len/10 &&
        p.*.edge_count>=0 && p.*.edge_count<=1048576 && p.*.edge_count<=p.*.edges.len/4) as i32;
}
fn nv_field(p:*ParentMap,id:i32,offset:i32)i32 {
    if(id<1 || id>p.*.node_count || id>p.*.nodes.len/10 || offset<0 || offset>9){return 0;}
    return p.*.nodes[(id-1)*10+offset] as i32;
}
fn nv_kind(p:*ParentMap,id:i32)i32 {return nv_field(p,id,0);}
fn nv_clean(p:*ParentMap,id:i32)i32 {
    return (nv_field(p,id,7)==0 && nv_field(p,id,8)==0 && nv_field(p,id,9)==0) as i32;
}
fn nv_raw(p:*ParentMap,id:i32)[]u8 {
    if(nv_kind(p,id)==0){return "";}let at:i32=nv_field(p,id,2);let n:i32=nv_field(p,id,3);
    if(at<0 || n<0 || at>p.*.input.len || n>p.*.input.len-at){return "";}
    return p.*.input[at..at+n];
}
fn nv_tuple_size(p:*ParentMap,id:i32)i32 {
    // All admitted tuples have at most eight items. Validate the WHOLE chain,
    // including its terminal link, rather than just the requested prefix.
    if(nv_kind(p,id)!=10){return -1;}let n:i32=nv_field(p,id,9);
    if(n<0 || n>8 || p.*.edge_count<0 || p.*.edge_count>p.*.edges.len/4){return -1;}
    let e:i32=nv_field(p,id,7);let last:i32=0;let count:i32=0;
    while(e!=0){if(count>=n || e<=last || e>p.*.edge_count){return -1;}
        let r:i32=(e-1)*4;let target:i32=p.*.edges[r] as i32;
        if(nv_kind(p,target)==0 || p.*.edges[r+1]!=0 || p.*.edges[r+3]!=1){return -1;}
        last=e;e=p.*.edges[r+2] as i32;count=count+1;
    }
    if(count!=n || nv_field(p,id,8)!=last){return -1;}return n;
}
fn nv_item(p:*ParentMap,id:i32,index:i32)i32 {
    if(index<0 || nv_tuple_size(p,id)<=index){return 0;}
    let e:i32=nv_field(p,id,7);let i:i32=0;
    while(i<index){e=p.*.edges[(e-1)*4+2] as i32;i=i+1;}
    return p.*.edges[(e-1)*4] as i32;
}
fn nv_text(p:*ParentMap,id:i32,text:[]u8)i32 {
    return (nv_kind(p,id)==6 && nv_clean(p,id)==1 && nio_equal(nv_raw(p,id),text)==1) as i32;
}
fn nv_symbol(p:*ParentMap,id:i32,module:[]u8,name:[]u8)i32 {
    return (nv_kind(p,id)==14 && nv_clean(p,id)==1 && nv_field(p,id,6)==0 &&
        nv_text(p,nv_field(p,id,4),module)==1 && nv_text(p,nv_field(p,id,5),name)==1) as i32;
}
fn nv_frombuffer(p:*ParentMap,id:i32)i32 {
    if(nv_kind(p,id)!=16){return 0;}let g:i32=nv_field(p,id,4);
    return (nv_symbol(p,g,"numpy._core.numeric","_frombuffer")==1 ||
        nv_symbol(p,g,"numpy.core.numeric","_frombuffer")==1) as i32;
}
fn nv_integer(p:*ParentMap,id:i32)NvInt {
    let r:NvInt=NvInt{.status=-1,.value=0};let kind:i32=nv_kind(p,id);
    if((kind!=3 && kind!=4) || nv_clean(p,id)!=1){return r;}
    if(kind==4){let at:i32=nv_field(p,id,2);let n:i32=nv_field(p,id,3);
        if(at<0 || n<0 || n>8 || at>p.*.input.len || n>p.*.input.len-at){return r;}}
    let value:i64=0;if(pm_small_int(p,id,&value)!=0){return r;}
    r.status=0;r.value=value;return r;
}
fn nv_int_is(p:*ParentMap,id:i32,expected:i64)i32 {
    let n:NvInt=nv_integer(p,id);return (n.status==0 && n.value==expected) as i32;
}
fn nv_single_build(p:*ParentMap,id:i32)i32 {
    if(nv_field(p,id,9)!=1){return 0;}let e:i32=nv_field(p,id,7);
    if(e<1 || e>p.*.edge_count || e>p.*.edges.len/4 || nv_field(p,id,8)!=e){return 0;}
    let row:i32=(e-1)*4;
    if(p.*.edges[row+3]!=3 || p.*.edges[row+1]!=0 || p.*.edges[row+2]!=0){return 0;}
    return p.*.edges[row] as i32;
}
fn nv_dtype(p:*ParentMap,id:i32,v:*NvView)i32 {
    if(nv_kind(p,id)!=16 || nv_field(p,id,6)!=0){return -9002;}let g:i32=nv_field(p,id,4);
    if(nv_symbol(p,g,"numpy","dtype")!=1 && nv_symbol(p,g,"numpy._core._multiarray_umath","dtype")!=1){return -9002;}
    let args:i32=nv_field(p,id,5);if(nv_tuple_size(p,args)!=3){return -9002;}
    let text_id:i32=nv_item(p,args,0);let text:[]u8=nv_raw(p,text_id);
    if(nv_kind(p,text_id)!=6 || nv_clean(p,text_id)!=1 || text.len!=2){return -9002;}
    let kind:i32=text[0] as i32;let width:i32=(text[1] as i32)-48;
    if(!((kind==105 || kind==117) && (width==1 || width==2 || width==4 || width==8)) &&
        !(kind==102 && (width==4 || width==8)) && !(kind==98 && width==1)){return -9002;}
    let a:i32=nv_item(p,args,1);let b:i32=nv_item(p,args,2);
    if(nv_kind(p,a)!=2 || nv_field(p,a,6)!=0 || nv_clean(p,a)!=1 ||
        nv_kind(p,b)!=2 || nv_field(p,b,6)!=1 || nv_clean(p,b)!=1){return -9002;}
    let state:i32=nv_single_build(p,id);if(nv_tuple_size(p,state)!=8){return -9002;}
    if(nv_int_is(p,nv_item(p,state,0),3)!=1){return -9002;}
    let endian_id:i32=nv_item(p,state,1);let endian:[]u8=nv_raw(p,endian_id);
    if(nv_kind(p,endian_id)!=6 || nv_clean(p,endian_id)!=1 || endian.len!=1){return -9002;}
    let order:i32=endian[0] as i32;
    if(order!=60 && order!=62 && !(order==124 && width==1)){return -9002;}
    let i:i32=2;while(i<=4){let item:i32=nv_item(p,state,i);
        if(nv_kind(p,item)!=1 || nv_clean(p,item)!=1){return -9002;}i=i+1;}
    if(nv_int_is(p,nv_item(p,state,5),-1)!=1 || nv_int_is(p,nv_item(p,state,6),-1)!=1 ||
        nv_int_is(p,nv_item(p,state,7),0)!=1){return -9002;}
    v.*.dtype=id;v.*.dstate=state;v.*.kind=kind;v.*.width=width;v.*.endian=order;return 0;
}
fn nv_open(p:*ParentMap,id:i32)NvView {
    let v:NvView=nv_empty(-9001);if(nv_ready(p)!=1 || nv_frombuffer(p,id)!=1){return v;}
    if(nv_clean(p,id)!=1 || nv_field(p,id,6)!=0){return v;}
    let args:i32=nv_field(p,id,5);if(nv_tuple_size(p,args)!=4){return v;}
    let buffer:i32=nv_item(p,args,0);let kind:i32=nv_kind(p,buffer);
    if((kind!=7 && kind!=8) || nv_clean(p,buffer)!=1){return nv_empty(-9004);}
    let code:i32=nv_dtype(p,nv_item(p,args,1),&v);if(code!=0){return nv_empty(code);}
    let shape:i32=nv_item(p,args,2);let ndim:i32=nv_tuple_size(p,shape);
    if(ndim<0 || ndim>8){return nv_empty(-9003);}
    let order_id:i32=nv_item(p,args,3);let order:i32=0;
    if(nv_text(p,order_id,"C")==1){order=67;}if(nv_text(p,order_id,"F")==1){order=70;}
    if(order==0){return nv_empty(-9003);}v.dims=pm_words(8);v.strides=pm_words(8);
    if(v.dims.len!=8 || v.strides.len!=8){return nv_fail(&v,-9007);}
    let i:i32=0;let empty:i32=0;
    while(i<ndim){let n:NvInt=nv_integer(p,nv_item(p,shape,i));
        if(n.status!=0 || n.value<0 || n.value>16777216){return nv_fail(&v,-9003);}
        v.dims[i]=n.value;if(n.value==0){empty=1;}i=i+1;
    }
    // Empty arrays have no valid coordinates. All logical strides are defined
    // as zero, NOT claimed to be the historical NumPy object's native strides.
    // Detect zero axes first so neither prefix nor suffix products can overflow.
    let product:i64=1;if(empty==1){product=0;}else{
        i=0;while(i<ndim){if(product>16777216/v.dims[i]){return nv_fail(&v,-9003);}
            product=product*v.dims[i];i=i+1;}
    }
    let at:i32=nv_field(p,buffer,2);let bytes:i32=nv_field(p,buffer,3);
    if(at<0 || bytes<0 || at>p.*.input.len || bytes>p.*.input.len-at ||
        product>16777216/v.width || bytes!=product*v.width){return nv_fail(&v,-9004);}
    if(empty==0){let stride:i64=1;i=ndim-1;if(order==70){i=0;}
        while(i>=0 && i<ndim){v.strides[i]=stride;
            if(stride>16777216/v.dims[i]){return nv_fail(&v,-9003);}
            stride=stride*v.dims[i];if(order==67){i=i-1;}else{i=i+1;}}
    }
    v.status=0;v.node=id;v.buffer=buffer;v.ndim=ndim;v.elements=product as i32;
    v.at=at;v.bytes=bytes;v.order=order;v.shape_node=shape;
    v.readonly=(kind==7) as i32; // Historical bytes carrier, NOT memory isolation.
    v.source=_zag_slice_ptr(p.*.input) as i64;v.source_len=p.*.input.len;
    v.nodes=_zag_slice_ptr(p.*.nodes) as i64;v.edges=_zag_slice_ptr(p.*.edges) as i64;return v;
}
fn nv_bound(p:*ParentMap,v:*NvView)i32 {
    if(nv_ready(p)!=1 || v.*.status!=0 || v.*.dims.len!=8 || v.*.strides.len!=8 ||
        v.*.source!=(_zag_slice_ptr(p.*.input) as i64) || v.*.source_len!=p.*.input.len ||
        v.*.nodes!=(_zag_slice_ptr(p.*.nodes) as i64) || v.*.edges!=(_zag_slice_ptr(p.*.edges) as i64) ||
        nv_frombuffer(p,v.*.node)!=1 || nv_clean(p,v.*.node)!=1 || nv_field(p,v.*.node,6)!=0){return 0;}
    let args:i32=nv_field(p,v.*.node,5);if(nv_tuple_size(p,args)!=4 ||
        nv_item(p,args,0)!=v.*.buffer || nv_item(p,args,1)!=v.*.dtype || nv_item(p,args,2)!=v.*.shape_node){return 0;}
    let d:NvView=nv_empty(0);if(nv_dtype(p,v.*.dtype,&d)!=0 || d.kind!=v.*.kind ||
        d.width!=v.*.width || d.endian!=v.*.endian || d.dstate!=v.*.dstate){return 0;}
    let bk:i32=nv_kind(p,v.*.buffer);if((bk!=7 && bk!=8) || nv_clean(p,v.*.buffer)!=1 ||
        v.*.readonly!=((bk==7) as i32) || v.*.at!=nv_field(p,v.*.buffer,2) || v.*.bytes!=nv_field(p,v.*.buffer,3) ||
        v.*.at<0 || v.*.bytes<0 || v.*.at>p.*.input.len || v.*.bytes>p.*.input.len-v.*.at){return 0;}
    if(v.*.ndim<0 || v.*.ndim>8 || nv_tuple_size(p,v.*.shape_node)!=v.*.ndim ||
        v.*.elements<0 || v.*.elements>16777216/v.*.width || v.*.bytes!=v.*.elements*v.*.width){return 0;}
    let oi:i32=nv_item(p,args,3);if(!((v.*.order==67 && nv_text(p,oi,"C")==1) ||
        (v.*.order==70 && nv_text(p,oi,"F")==1))){return 0;}
    let i:i32=0;let empty:i32=0;
    while(i<v.*.ndim){let n:NvInt=nv_integer(p,nv_item(p,v.*.shape_node,i));
        if(n.status!=0 || n.value<0 || n.value>16777216 || v.*.dims[i]!=n.value){return 0;}
        if(n.value==0){empty=1;}i=i+1;}
    while(i<8){if(v.*.dims[i]!=0 || v.*.strides[i]!=0){return 0;}i=i+1;}
    if(empty==1){if(v.*.elements!=0){return 0;}i=0;
        while(i<v.*.ndim){if(v.*.strides[i]!=0){return 0;}i=i+1;}return 1;}
    let stride:i64=1;i=v.*.ndim-1;if(v.*.order==70){i=0;}
    while(i>=0 && i<v.*.ndim){if(v.*.strides[i]!=stride || stride>16777216/v.*.dims[i]){return 0;}
        stride=stride*v.*.dims[i];if(v.*.order==67){i=i-1;}else{i=i+1;}}
    return (stride==v.*.elements) as i32;
}
fn nv_at(p:*ParentMap,v:*NvView,coordinates:[]i64)i64 {
    if(nv_bound(p,v)!=1 || coordinates.len!=v.*.ndim || v.*.elements==0){return -9005;}
    let result:i64=0;let i:i32=0;
    while(i<v.*.ndim){if(coordinates[i]<0 || coordinates[i]>=v.*.dims[i]){return -9005;}
        result=result+coordinates[i]*v.*.strides[i];i=i+1;}
    if(result<0 || result>=v.*.elements){return -9005;}return result;
}
fn nv_bits(p:*ParentMap,v:*NvView,index:i64)NvBits {
    let result:NvBits=NvBits{.status=-9005,.low=0,.high=0};
    if(nv_bound(p,v)!=1 || index<0 || index>=v.*.elements){return result;}
    let start:i32=v.*.at+(index as i32)*v.*.width;let i:i32=0;let multiplier:i64=1;
    while(i<v.*.width){let offset:i32=i;if(v.*.endian==62){offset=v.*.width-1-i;}
        let x:i64=p.*.input[start+offset] as i64;if(i==4){multiplier=1;}
        if(i<4){result.low=result.low+x*multiplier;}else{result.high=result.high+x*multiplier;}
        multiplier=multiplier*256;i=i+1;}
    result.status=0;return result;
}
fn nv_row(p:*ParentMap,v:*NvView)NvRow {
    // Deliberately no caller-provided writable destination: an output alias
    // cannot overwrite the map, source, coordinates or view while serializing.
    // The caller owns this allocation separately and releases it with nio_free.
    if(nv_bound(p,v)!=1){return NvRow{.status=-9006,.data=""};}
    let row:[]u8=nio_alloc(160);if(row.len!=160){return NvRow{.status=-9007,.data=""};}
    let code:i32=0;
    code=code+mi_put(row,0,v.*.node)+mi_put(row,4,v.*.buffer)+mi_put(row,8,v.*.dtype)+mi_put(row,12,v.*.kind);
    code=code+mi_put(row,16,v.*.width)+mi_put(row,20,v.*.endian)+mi_put(row,24,v.*.order)+mi_put(row,28,v.*.ndim);
    code=code+mi_put(row,32,v.*.elements)+mi_put(row,36,v.*.at)+mi_put(row,40,v.*.bytes)+mi_put(row,44,nv_field(p,v.*.node,1));
    code=code+mi_put(row,48,v.*.shape_node)+mi_put(row,52,v.*.readonly)+mi_put(row,56,v.*.dstate);
    let i:i32=0;while(i<8){code=code+mi_put(row,64+i*4,v.*.dims[i])+mi_put(row,96+i*4,v.*.strides[i]);i=i+1;}
    if(code==0){code=ns_sha256(p.*.input[v.*.at..v.*.at+v.*.bytes],row[128..160]);}
    if(code!=0){nio_free(row);return NvRow{.status=-9006,.data=""};}
    return NvRow{.status=0,.data=row};
}

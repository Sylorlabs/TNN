@import("../identity.zag")
fn main()i32 {
 let pool:[]u8=nio_alloc(34);if(pool.len!=34){return 1;}let i:i32=0;while(i<34){pool[i]=165;i=i+1;}let f:i32=0;
 if(ns_sha256("",pool[1..33])!=0){f=f+1;}let h:[]u8=ns_hex(pool[1..33]);if(nio_equal(h,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")!=1){f=f+1;}_zag_print("B_SHA_EMPTY,");_zag_println(h);nio_free(h);
 if(ns_sha256("abc",pool[1..33])!=0){f=f+1;}h=ns_hex(pool[1..33]);if(nio_equal(h,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")!=1){f=f+1;}_zag_print("B_SHA_ABC,");_zag_println(h);nio_free(h);
 i=0;while(i<34){pool[i]=165;i=i+1;}let rc:i32=ns_sha256("abc",pool[1..32]);if(rc!=-7403){f=f+1;}i=0;while(i<34){if(pool[i]!=165){f=f+1;}i=i+1;}_zag_println("B_SHA_SHORT_OUTPUT_EXPECTED_CODE,-7403");_zag_print("B_PRIMITIVE_FAILURES,");let s:[]u8=_zag_i64_to_str(f as i64);_zag_println(s);nio_free(s);nio_free(pool);return (f!=0) as i32;

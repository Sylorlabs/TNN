// Structural BPE graph and generic merge/decode component qualification only.
// No historical BOS/EOS, generation or encoding policy is asserted here.
@import("../../R33_NATIVE_SHA256_V2.zag")
fn vb_words(n:i32)[]i64 {let p:*i64=_zag_malloc(n*8) as *i64;let out:[]i64=p[0..n];let i:i32=0;while(i<n){out[i]=0;i=i+1;}return out;}
fn vb_u32(b:[]u8,at:i32)i32 {if(at<0||at>b.len-4||b[at+3]>=128){return -1;}return ((b[at] as i64)+(b[at+1] as i64)*256+(b[at+2] as i64)*65536+(b[at+3] as i64)*16777216) as i32;}
fn vb_roundtrip(frame:[]u8,at:[]i64,len:[]i64,merge:i32,text:[]u8)i32 {
 let tokens:[]i64=vb_words(4096);if(text.len>4096){return 1;}let n:i32=text.len;let i:i32=0;while(i<n){tokens[i]=text[i] as i64;i=i+1;}let m:i32=0;
 while(m<84){let a:i32=vb_u32(frame,merge+m*8);let b:i32=vb_u32(frame,merge+m*8+4);let read:i32=0;let write:i32=0;while(read<n){if(read+1<n&&tokens[read]==a&&tokens[read+1]==b){tokens[write]=256+m;read=read+2;}else{tokens[write]=tokens[read];read=read+1;}write=write+1;}n=write;m=m+1;}
 let pos:i32=0;i=0;while(i<n){let id:i32=tokens[i] as i32;let j:i32=0;while(j<len[id]){if(pos>=text.len||frame[(at[id] as i32)+j]!=text[pos]){return 2;}pos=pos+1;j=j+1;}i=i+1;}if(pos!=text.len){return 3;}return 0;
}
fn main()i32 {
 if(_zag_argc()!=2){return 2;}let frame:[]u8=_zag_read_file(_zag_arg(1));let hash:[]u8=nio_alloc(32);if(frame.len!=3946||ns_sha256(frame,hash)!=0||nio_equal(ns_hex(hash),"f83d2f7c63b2f40f386c37b96fc5d17ea120f715e503f58b62a6ca428cd21f6c")!=1){return 10;}
 if(nio_equal(frame[0..8],"V91BPE01")!=1||vb_u32(frame,8)!=340||vb_u32(frame,12)!=84){return 11;}let at:[]i64=vb_words(340);let len:[]i64=vb_words(340);let seen:[]i64=vb_words(340);let pos:i32=16;let i:i32=0;
 while(i<340){let id:i32=vb_u32(frame,pos);let n:i32=vb_u32(frame,pos+4);if(id<0||id>=340||n<1||seen[id]!=0||pos+8>frame.len-n){return 12;}seen[id]=1;at[id]=pos+8;len[id]=n;pos=pos+8+n;i=i+1;}
 if(frame.len-pos!=84*8){return 13;}i=0;while(i<256){if(len[i]!=1||frame[at[i] as i32]!=(i as u8)){return 14;}i=i+1;}let m:i32=0;while(m<84){let a:i32=vb_u32(frame,pos+m*8);let b:i32=vb_u32(frame,pos+m*8+4);let id:i32=256+m;if(a<0||b<0||a>=id||b>=id||len[id]!=len[a]+len[b]){return 15;}let j:i32=0;while(j<len[a]){if(frame[(at[id] as i32)+j]!=frame[(at[a] as i32)+j]){return 16;}j=j+1;}j=0;while(j<len[b]){if(frame[(at[id]+len[a]) as i32+j]!=frame[(at[b] as i32)+j]){return 17;}j=j+1;}m=m+1;}
 let bytes:[]u8=nio_alloc(256);i=0;while(i<256){bytes[i]=i as u8;i=i+1;}
 if(vb_roundtrip(frame,at,len,pos,bytes)!=0||vb_roundtrip(frame,at,len,pos,"ana moved the book to the desk.")!=0||vb_roundtrip(frame,at,len,pos,"unseen byte surfaces: xyz! 0123456789")!=0){return 18;}
 _zag_println("V91_BPE_BASE_BYTES,256\nV91_BPE_MERGE_GRAPH,84\nV91_BPE_COMPONENT_ROUNDTRIPS,3\nV91_BPE_COMPONENT_STATUS,PASS\nV91_HISTORICAL_SPECIAL_TOKEN_POLICY,UNADMITTED\nV91_HISTORICAL_GENERATED_STRINGS,0");return 0;
}

+cp "$N/LANE_B_AUDIT_20260915/FROZEN/r27-policy.json" "$E/inputs/r27-policy.json"
+run policy 0 direct_native_policy "$E/bin/policy" "$E/inputs/r27-policy.json" || exit 71

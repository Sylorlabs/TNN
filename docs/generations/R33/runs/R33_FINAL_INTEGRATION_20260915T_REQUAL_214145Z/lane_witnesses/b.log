+targets += [
+ {name:'r23_source',size:63069,sha256:'517eb325096d5ae71ebb3bf659da77eac4266129136b888b469a99e366d4b642'},
+ {name:'r23_state',size:7028883,sha256:'fc24881f104052c09a4cb6e596b01ae5c107d9ae0356c8799ec97eff3edf440b'},

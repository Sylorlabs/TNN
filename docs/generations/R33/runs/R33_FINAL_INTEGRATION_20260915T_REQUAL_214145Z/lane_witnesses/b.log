+require 'json'
+require 'digest'
+require 'open3'
+require 'fileutils'
+# Byte inventory only; no historical code or serialized object execution.
+repo='/Users/Shared/micah/Documents/TNN/TNN'
+base=repo+'/Research/R33_NATIVE_N17_R27_CONTINUITY'
+dest=File.expand_path(__dir__)+'/search'

@import("conservative_token_scan.zag")
fn check(t:[]u8,short:[]u8,upper:[]u8)i32 {
 return (n17_conservative_forbidden(t)==1 && contains(t,t)==1 && n17_conservative_forbidden(short)==0 && n17_conservative_forbidden(upper)==0) as i32;
}
fn main()i32 {
 if(check("ultralytics","ultralytic","ULTRALYTICS")!=1){return 1;}
 if(check("transformers","transformer","TRANSFORMERS")!=1){return 2;}
 if(check("torchvision.models","torchvision.model","TORCHVISION.MODELS")!=1){return 3;}
 if(check("openai","opena","OPENAI")!=1){return 4;}
 if(check("whisper","whispe","WHISPER")!=1){return 5;}
 if(check("speech_recognition","speech_recognitio","SPEECH_RECOGNITION")!=1){return 6;}
 if(check("librosa.feature.mfcc","librosa.feature.mfc","LIBROSA.FEATURE.MFCC")!=1){return 7;}
 if(n17_conservative_forbidden("xxspeech_recognitionyy")!=1 || n17_conservative_forbidden("speech_recognition end")!=1 || n17_conservative_forbidden("start speech_recognition")!=1 || n17_conservative_forbidden("openai whisper")!=2 || n17_conservative_forbidden("")!=0 || n17_conservative_forbidden("clean source")!=0){return 8;}
 _zag_println("PASS_ALL_SEVEN_KNOWN_CONSERVATIVE_SELECTORS_DETECTED_TRUNCATED_CASE_NEGATIVES_BOUNDARIES_MISSING_TOKEN_REPAIRED; NO_EXACT_ORIGINAL_TOKEN_LOOP_OR_ROW20_CREDIT");return 0;
}

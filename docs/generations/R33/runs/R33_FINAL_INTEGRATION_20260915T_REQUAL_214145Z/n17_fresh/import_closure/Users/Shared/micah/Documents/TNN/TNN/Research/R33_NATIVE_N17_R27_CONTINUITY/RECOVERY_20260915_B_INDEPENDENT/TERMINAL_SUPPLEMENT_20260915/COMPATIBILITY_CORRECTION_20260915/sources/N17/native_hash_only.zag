@import("../R33_NATIVE_SHA256_V2.zag")

fn r27ma2_hex_nibble(c:u8)i32 @noalloc {
    if(c>=48 && c<=57){return (c-48) as i32;}
    if(c>=97 && c<=102){return (c-87) as i32;}
    if(c>=65 && c<=70){return (c-55) as i32;}
    return -1;
}

fn r27ma2_digest_matches_hex(digest:[]u8,hex:[]u8)i32 @noalloc {
    if(digest.len!=32 || hex.len!=64){return 0;}
    let i:i32=0;while(i<32){
        let hi:i32=r27ma2_hex_nibble(hex[i*2]);let lo:i32=r27ma2_hex_nibble(hex[i*2+1]);
        if(hi<0 || lo<0 || digest[i]!=((hi<<4)|lo) as u8){return 0;}i=i+1;
    }
    return 1;
}

fn r27ma2_hash_matches(input:[]u8,expected_hex:[]u8)i32 {
    let digest:[]u8=nio_alloc(32);if(digest.len!=32){return 0;}
    let ok:i32=(ns_sha256(input,digest)==0 && r27ma2_digest_matches_hex(digest,expected_hex)==1) as i32;
    nio_free(digest);return ok;
}

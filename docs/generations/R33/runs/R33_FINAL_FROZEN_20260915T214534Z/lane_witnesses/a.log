    if(rc!=0){nio_free(st);return cl_errno(rc);}
    let mode:i32=(st[4] as i32)+((st[5] as i32)<<8);
    let links:i32=(st[6] as i32)+((st[7] as i32)<<8);
    let uid:i64=_zag_darwin_syscall(24,0,0,0,0,0,0);

    if(raw>=0){return 0;}
    if(raw==-2 || raw==-13 || raw==-17 || raw==-20 || raw==-21 || raw==-40 || raw==-62 || raw==-63){return cl_path();}
    if(raw==-22 || raw==-45 || raw==-78){return cl_abi();}
    return cl_io();
}
fn cl_stat(fd:i64,directory:i32)i32 {

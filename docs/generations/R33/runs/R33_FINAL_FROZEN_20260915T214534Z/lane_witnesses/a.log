// R33 continuing-life V68: prove the existing outer transaction can carry one
// complete 245,536-byte learner packet atomically without changing the wire
// format. This is a transport/integrity proof only; the payload is a tagged
// engineering fixture, not R27 learned state, and learn authority remains zero.
@import("checkpoint.zag")

const CLV68_LEARNER_BYTES:i32=245536;

fn clv68_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("CL_V68_CHECK,");_zag_print(name);_zag_print(",");cl_number(actual as i64);_zag_print(",");cl_number(expected as i64);_zag_println("");
    return (actual!=expected) as i32;
}

fn clv68_build_fail(stage:i32,rc:i32,at:i32)i32 {
    _zag_print("CL_V68_BUILD_FAIL,");cl_number(stage as i64);_zag_print(",");cl_number(rc as i64);_zag_print(",");cl_number(at as i64);_zag_println("");
    return rc;
}

fn clv68_build(out:[]u8,learner:[]u8,parent:[]u8,previous:[]u8,world:[]u8,ingress:[]u8)i32 {
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);if(rc!=0){return clv68_build_fail(1,rc,0);}
    // Explicitly evaluate the imported constant accessor on stable znc.
    let at:i32=CL_CHECKPOINT_HEADER();
    rc=cl_checkpoint_section(out,&at,1,learner);if(rc!=0){return clv68_build_fail(2,rc,at);}
    let tag:[]u8=nio_alloc(4);if(tag.len!=4){return clv68_build_fail(3,cl_io(),at);}
    let id:i32=2;
    while(id<=10){cl_put(tag,0,id as i64);rc=cl_checkpoint_section(out,&at,id,tag);if(rc!=0){nio_free(tag);return clv68_build_fail(id+1,rc,at);}id=id+1;}
    nio_free(tag);
    rc=cl_checkpoint_section(out,&at,11,world);if(rc!=0){return clv68_build_fail(12,rc,at);}
    rc=cl_checkpoint_section(out,&at,12,ingress);if(rc!=0){return clv68_build_fail(13,rc,at);}
    rc=cl_checkpoint_finish(out,at);if(rc<0 || cl_is_status(rc)==1){return clv68_build_fail(14,rc,at);}return rc;
}

fn main()i32 {
    let f:i32=0;
    let learner:[]u8=nio_alloc(CLV68_LEARNER_BYTES);let world:[]u8=nio_alloc(96);let ingress:[]u8=nio_alloc(16);
    let out:[]u8=nio_alloc(300000);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(learner.len!=CLV68_LEARNER_BYTES || world.len!=96 || ingress.len!=16 || out.len!=300000 || parent.len!=32 || previous.len!=32){return 70;}
    let i:i32=0;while(i<learner.len){learner[i]=(i & 255) as u8;i=i+1;}
    learner[0]=67;learner[1]=76;learner[2]=65;learner[3]=49; // "CLA1" fixture marker only.
    i=0;while(i<world.len){world[i]=((i*3) & 255) as u8;i=i+1;}
    i=0;while(i<ingress.len){ingress[i]=((i*7) & 255) as u8;i=i+1;}
    ns_sha256("R27_OUTER_TRANSPORT_SHAPE_FIXTURE_V68",parent);

    let n:i32=clv68_build(out,learner,parent,previous,world,ingress);
    f=f+clv68_check("build_positive",(n>0 && cl_is_status(n)==0) as i32,1);
    f=f+clv68_check("within_outer_limit",(n>0 && cl_is_status(n)==0 && n<cl_max()) as i32,1);
    f=f+clv68_check("outer_exact_bytes",n,245924);
    if(n>0 && cl_is_status(n)==0){
        f=f+clv68_check("checkpoint_valid",cl_checkpoint_check(out[0..n],parent,previous,1),0);
        f=f+clv68_check("learner_roundtrip",nio_equal(cl_checkpoint_get(out[0..n],1),learner),1);
        f=f+clv68_check("learner_exact_bytes",cl_checkpoint_get(out[0..n],1).len,CLV68_LEARNER_BYTES);
        f=f+clv68_check("world_roundtrip",nio_equal(cl_checkpoint_get(out[0..n],11),world),1);
        f=f+clv68_check("ingress_roundtrip",nio_equal(cl_checkpoint_get(out[0..n],12),ingress),1);
        // Section 1 starts at 112, with its payload at 120. Tamper must be
        // caught by the outer transaction digest before any partial publish.
        out[120]=out[120]^1;
        f=f+clv68_check("learner_tamper_refused",cl_checkpoint_check(out[0..n],parent,previous,1),cl_corrupt());
        out[120]=out[120]^1;
        f=f+clv68_check("restored_after_tamper",cl_checkpoint_check(out[0..n],parent,previous,1),0);
    }
    // 245,536 fits; one byte above the outer per-section ceiling must refuse.
    let too_large:[]u8=nio_alloc(262145);let small:[]u8=nio_alloc(300000);let at:i32=CL_CHECKPOINT_HEADER();
    let begin:i32=cl_checkpoint_begin(small,1,parent,previous);
    f=f+clv68_check("oversize_begin",begin,0);
    if(begin==0){f=f+clv68_check("oversize_section_refused",cl_checkpoint_section(small,&at,1,too_large),cl_bad());}
    f=f+clv68_check("parent_still_pending",cl_parent_admission(),cl_parent_pending());
    _zag_print("CL_V68_OUTER_BYTES,");cl_number(n as i64);_zag_println("");
    _zag_print("CL_V68_FAILURES,");cl_number(f as i64);_zag_println("");
    nio_free(learner);nio_free(world);nio_free(ingress);nio_free(out);nio_free(parent);nio_free(previous);nio_free(too_large);nio_free(small);
    return (f!=0) as i32;
}
// V73: reproduce the V68 caller shape: six slice parameters, then checkpoint
// begin followed by a section write through a caller-owned scalar pointer.
@import("checkpoint.zag")

fn v73_build(out:[]u8,payload:[]u8,parent:[]u8,previous:[]u8,world:[]u8,ingress:[]u8)i32 {
    if(world.len!=96 || ingress.len!=16){return 71;}
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);if(rc!=0){return rc;}
    // Explicitly evaluate the imported constant accessor on stable znc.
    let at:i32=CL_CHECKPOINT_HEADER();
    rc=cl_checkpoint_section(out,&at,1,payload);
    if(rc!=0){return 81;}
    if(at!=120+payload.len){return 82;}
    let tag:[]u8=nio_alloc(4);if(tag.len!=4){return 83;}
    let id:i32=2;
    while(id<=10){cl_put(tag,0,id as i64);rc=cl_checkpoint_section(out,&at,id,tag);if(rc!=0){nio_free(tag);return 84;}id=id+1;}
    nio_free(tag);
    rc=cl_checkpoint_section(out,&at,11,world);if(rc!=0){return 85;}
    rc=cl_checkpoint_section(out,&at,12,ingress);if(rc!=0){return 86;}
    rc=cl_checkpoint_finish(out,at);if(cl_is_status(rc)==1){return 87;}return rc;
}

fn main()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(245536);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    let world:[]u8=nio_alloc(96);let ingress:[]u8=nio_alloc(16);
    if(out.len!=300000 || payload.len!=245536 || parent.len!=32 || previous.len!=32 || world.len!=96 || ingress.len!=16){return 70;}
    let i:i32=0;while(i<payload.len){payload[i]=(i & 255) as u8;i=i+1;}
    payload[0]=67;payload[1]=76;payload[2]=65;payload[3]=49;
    i=0;while(i<world.len){world[i]=((i*3) & 255) as u8;i=i+1;}
    i=0;while(i<ingress.len){ingress[i]=((i*7) & 255) as u8;i=i+1;}
    ns_sha256("V73_SIX_SLICE_CALLER",parent);
    let rc:i32=v73_build(out,payload,parent,previous,world,ingress);
    _zag_print("V73_RC,");cl_number(rc as i64);_zag_println("");
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);nio_free(world);nio_free(ingress);
    return (rc<245536) as i32;
}

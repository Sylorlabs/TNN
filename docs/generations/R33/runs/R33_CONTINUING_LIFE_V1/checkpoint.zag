// Complete-state transport contract, not an implementation of the R27 brain.
// Section IDs 1..10 are learner-owned, 11 world-owned, 12 ingress-owned.
@import("storage.zag")

const CL_SECTIONS:i32=12;
const CL_CHECKPOINT_HEADER:i32=112;
fn cl_checkpoint_begin(out:[]u8,sequence:i32,parent:[]u8,previous:[]u8)i32 {
    if(out.len<256 || out.len>cl_max() || sequence<1 || parent.len!=32 || previous.len!=32 || cl_zero(parent)==1 || cl_disjoint(out,parent)!=1 || cl_disjoint(out,previous)!=1){return cl_bad();}
    if((sequence==1 && cl_zero(previous)!=1) || (sequence>1 && cl_zero(previous)==1)){return cl_bad();}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    cl_copy(out[0..8],"TNNCHK01");cl_put(out,8,sequence as i64);cl_put(out,12,CL_SECTIONS as i64);
    cl_copy(out[32..64],parent);cl_copy(out[64..96],previous);return 0;
}
fn cl_checkpoint_section(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    if(at==null as *i32){return cl_bad();}
    if(id<1 || id>12){return cl_bad();}
    if(payload.len<1 || payload.len>262144){return cl_bad();}
    if(cl_disjoint(out,payload)!=1){return cl_bad();}
    if(at.*<112 || at.*>out.len-40 || payload.len>out.len-40-at.*){return cl_bound();}
    cl_put(out,at.*,id as i64);cl_put(out,at.*+4,payload.len as i64);
    cl_copy(out[at.*+8..at.*+8+payload.len],payload);at.*=at.*+8+payload.len;return 0;
}
fn cl_checkpoint_check(b:[]u8,parent:[]u8,previous:[]u8,sequence:i32)i32 {
    if(b.len<252 || b.len>cl_max() || parent.len!=32 || previous.len!=32 || sequence<1){return cl_bad();}
    if(nio_equal(b[0..8],"TNNCHK01")!=1 || cl_u32(b,8)!=sequence || cl_u32(b,12)!=12 || cl_u32(b,16)!=b.len || cl_zero(b[20..32])!=1 || cl_zero(b[96..112])!=1){return cl_bad();}
    if(cl_zero(parent)==1 || nio_equal(b[32..64],parent)!=1 || nio_equal(b[64..96],previous)!=1){return cl_corrupt();}
    if((sequence==1 && cl_zero(previous)!=1) || (sequence>1 && cl_zero(previous)==1)){return cl_corrupt();}
    let at:i32=112;let id:i32=1;
    while(id<=CL_SECTIONS){
        if(at>b.len-40 || cl_u32(b,at)!=id){return cl_bad();}
        let n:i64=cl_u32(b,at+4);if(n<1 || n>262144 || n>b.len-40-at){return cl_bound();}
        at=at+8+(n as i32);id=id+1;
    }
    if(at!=b.len-32){return cl_bad();}
    if(cl_hash_is(b[0..at],b[at..b.len])!=1){return cl_corrupt();}return 0;
}
fn cl_checkpoint_finish(out:[]u8,at:i32)i32 {
    if(at<112 || at>out.len-32){return cl_bound();}
    let total:i32=at+32;cl_put(out,16,total as i64);
    if(ns_sha256(out[0..at],out[at..total])!=0){return cl_io();}
    let rc:i32=cl_checkpoint_check(out[0..total],out[32..64],out[64..96],cl_u32(out,8) as i32);
    if(rc!=0){return rc;}return total;
}
fn cl_checkpoint_get(b:[]u8,id:i32)[]u8 {
    if(b.len<252 || id<1 || id>12 || cl_checkpoint_check(b,b[32..64],b[64..96],cl_u32(b,8) as i32)!=0){return "";}
    let at:i32=112;let k:i32=1;
    while(k<id){at=at+8+(cl_u32(b,at+4) as i32);k=k+1;}
    let n:i32=cl_u32(b,at+4) as i32;return b[at+8..at+8+n];
}
fn cl_checkpoint_name(seq:i32)[]u8 {
    if(seq<1 || seq>4096){return "";}
    let n:[]u8=_zag_i64_to_str(seq as i64);let a:[]u8=_zag_str_concat("checkpoint-",n);nio_free(n);
    let b:[]u8=_zag_str_concat(a,".bin");nio_free(a);return b;
}
fn cl_checkpoint_commit(root:i64,b:[]u8,parent:[]u8,previous:[]u8,sequence:i32)i32 {
    let rc:i32=cl_checkpoint_check(b,parent,previous,sequence);if(rc!=0){return rc;}
    let name:[]u8=cl_checkpoint_name(sequence);if(name.len==0){return cl_capacity();}
    rc=cl_file_write(root,name,b);nio_free(name);return rc;
}
fn cl_checkpoint_load(root:i64,sequence:i32,parent:[]u8,previous:[]u8,out:[]u8)i32 {
    if(out.len<252 || out.len>cl_max()){return cl_bound();}
    let name:[]u8=cl_checkpoint_name(sequence);if(name.len==0){return cl_capacity();}
    let stage:[]u8=nio_alloc(out.len);if(stage.len!=out.len){nio_free(name);return cl_io();}
    let n:i32=cl_file_read(root,name,stage);nio_free(name);
    if(n<0 || cl_is_status(n)==1){nio_free(stage);return n;}
    let rc:i32=cl_checkpoint_check(stage[0..n],parent,previous,sequence);
    if(rc==0){cl_copy(out[0..n],stage[0..n]);}nio_free(stage);if(rc!=0){return rc;}return n;
}
fn cl_parent_admission()i32 {
    // No flags or matching historical digest may fabricate behavioral continuity.
    // Replace only when the reviewed native R27 runtime is wired to this API.
    return cl_parent_pending();
}

// Native Zag ABI probe for the V68 large learner-packet qualification.
// Six slice parameters require twelve scalar ABI words on AArch64. This probe
// distinguishes checkpoint logic failures from argument spill/restore corruption.
@import("common.zag")

fn clv69_touch(at:*i32)i32 @noalloc {
    if(at==null as *i32){return cl_bad();}
    at.*=at.*+1;
    return 0;
}

fn clv69_six_slices(a:[]u8,b:[]u8,c:[]u8,d:[]u8,e:[]u8,f:[]u8)i32 {
    let at:i32=112;
    let rc:i32=clv69_touch(&at);
    if(rc!=0){return rc;}
    if(at!=113){return 69;}
    if(a.len!=1 || b.len!=2 || c.len!=3 || d.len!=4 || e.len!=5 || f.len!=6){return 70;}
    return 0;
}

fn main()i32 {
    let a:[]u8=nio_alloc(1);let b:[]u8=nio_alloc(2);let c:[]u8=nio_alloc(3);
    let d:[]u8=nio_alloc(4);let e:[]u8=nio_alloc(5);let f:[]u8=nio_alloc(6);
    let rc:i32=clv69_six_slices(a,b,c,d,e,f);
    _zag_print("CL_V69_SLICE_ABI_RC,");cl_number(rc as i64);_zag_println("");
    nio_free(a);nio_free(b);nio_free(c);nio_free(d);nio_free(e);nio_free(f);
    return rc;
}

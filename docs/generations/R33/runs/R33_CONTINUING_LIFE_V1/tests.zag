// Deterministic engineering fixtures. No scientific population or learner.
@import("world.zag")
@import("checkpoint.zag")

fn ct_observation()i32 {
    let f:i32=0;let raw:[]u8=nio_alloc(8);let obs:[]u8=nio_alloc(120);
    raw[0]=0;raw[1]=128;raw[2]=255;raw[3]=127;raw[4]=1;raw[5]=0;raw[6]=255;raw[7]=255;
    f=f+cl_check("pcm_encode",cl_observation_make(obs,raw,1,7,8,10,1,48000,2,1,2,0),0);
    let x:i32=99;f=f+cl_check("pcm_min_status",cl_pcm_at(obs,0,&x),0);f=f+cl_check("pcm_min",x,-32768);
    f=f+cl_check("pcm_max_status",cl_pcm_at(obs,1,&x),0);f=f+cl_check("pcm_max",x,32767);
    f=f+cl_check("pcm_last_status",cl_pcm_at(obs,3,&x),0);f=f+cl_check("pcm_minus_one",x,-1);
    f=f+cl_check("pcm_exact_payload",nio_equal(obs[80..88],raw),1);
    let s:CLStream=CLStream{.source=7,.clock=8,.sequence=0,.tick=0};
    f=f+cl_check("stream_first",cl_stream_accept(&s,obs),0);
    f=f+cl_check("stream_duplicate",cl_stream_accept(&s,obs),cl_bad());
    f=f+cl_check("stream_no_mutation",s.sequence,1);
    let saved:[]u8=nio_alloc(16);f=f+cl_check("stream_save",cl_stream_save(&s,saved),0);
    let again:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};f=f+cl_check("stream_load",cl_stream_load(saved,&again),0);
    f=f+cl_check("stream_clock_restored",again.clock,8);
    obs[80]=1;f=f+cl_check("payload_corrupt",cl_observation_check(obs),cl_corrupt());obs[80]=0;
    obs[20]=11;f=f+cl_check("metadata_corrupt",cl_observation_check(obs),cl_corrupt());obs[20]=10;
    f=f+cl_check("observation_torn",cl_observation_check(obs[0..119]),cl_bad());
    let before:[]u8=nio_alloc(120);cl_copy(before,obs);
    f=f+cl_check("bad_channels",cl_observation_make(obs,raw,1,7,8,10,1,48000,2,1,3,0),cl_bad());
    f=f+cl_check("bad_input_output_unchanged",nio_equal(obs,before),1);
    f=f+cl_check("overlap_refused",cl_observation_make(obs,obs[80..88],1,7,8,10,1,48000,2,1,2,0),cl_bound());
    f=f+cl_check("new_sequence",cl_observation_make(obs,raw,2,7,8,9,1,48000,2,1,2,0),0);
    f=f+cl_check("backwards_time",cl_stream_accept(&s,obs),cl_bad());
    cl_observation_make(obs,raw,2,7,9,11,1,48000,2,1,2,0);
    f=f+cl_check("clock_change",cl_stream_accept(&s,obs),cl_bad());
    let pixels:[]u8=nio_alloc(12);let rgb:[]u8=nio_alloc(124);pixels[0]=255;pixels[4]=127;pixels[11]=1;
    f=f+cl_check("rgb_encode",cl_observation_make(rgb,pixels,1,9,1,0,2,0,2,2,3,0),0);
    f=f+cl_check("rgb_exact_channel_order",nio_equal(rgb[80..92],pixels),1);
    f=f+cl_check("rgb_not_pcm",cl_pcm_at(rgb,0,&x),cl_bound());
    nio_free(raw);nio_free(obs);nio_free(saved);nio_free(before);nio_free(pixels);nio_free(rgb);return f;
}
fn ct_world()i32 {
    let f:i32=0;let w:[]u8=nio_alloc(96);let saved:[]u8=nio_alloc(96);let a:[]u8=nio_alloc(304);let b:[]u8=nio_alloc(304);
    f=f+cl_check("world_init",cw_init(w,1701),0);f=f+cl_check("world_initial_observe",cw_observe(w,a),0);
    f=f+cl_check("world_observation_format",cl_observation_check(a),0);
    cw_change(w,1,1);cw_observe(w,b);f=f+cl_check("hidden_regime_absent",nio_equal(a,b),1);cw_change(w,0,1);
    cl_copy(saved,w);let bad:CWOutcome=cw_step(w,99);f=f+cl_check("invalid_action",bad.status,cl_bad());f=f+cl_check("invalid_action_unchanged",nio_equal(w,saved),1);
    let left:CWOutcome=cw_step(w,1);f=f+cl_check("left_action",left.status,0);
    let touch:CWOutcome=cw_step(w,4);f=f+cl_check("touch_pending",touch.status,0);f=f+cl_check("no_immediate_reward",touch.value,0);
    cl_copy(saved,w);let denied:CWOutcome=cw_step(w,4);f=f+cl_check("pending_capacity",denied.status,cl_capacity());f=f+cl_check("pending_refusal_unchanged",nio_equal(w,saved),1);
    let w2:[]u8=nio_alloc(96);cl_copy(w2,saved);let i:i32=0;let reward:i32=0;
    while(i<3){let x:CWOutcome=cw_step(w,0);let y:CWOutcome=cw_step(w2,0);
        f=f+cl_check("resumed_world_exact",nio_equal(w,w2),1);f=f+cl_check("resumed_consequence_exact",x.value,y.value);
        if(i<2){f=f+cl_check("delay_not_early",x.value,0);}else{reward=x.value;f=f+cl_check("cause_is_touch_event",x.action,2);}
        i=i+1;}
    f=f+cl_check("delayed_reward",reward,1);f=f+cl_check64("pending_cleared",cl_u32(w,44),0);
    cw_observe(w,a);let before:i64=cl_u32(w,8);let inspected:CWOutcome=cw_step(w,3);cw_observe(w,b);
    f=f+cl_check64("inspect_has_cost",cl_u32(w,8)-before,1);f=f+cl_check64("inspect_counter",cl_u32(w,56),1);
    f=f+cl_check("inspect_reveals_pixel_detail",nio_equal(a[80..272],b[80..272]),0);
    f=f+cl_check("world_still_valid",cw_valid(w),0);
    nio_free(w);nio_free(saved);nio_free(w2);nio_free(a);nio_free(b);return f;
}
fn ct_checkpoint(b:[]u8,w:[]u8,parent:[]u8,previous:[]u8,sequence:i32)i32 {
    let rc:i32=cl_checkpoint_begin(b,sequence,parent,previous);if(rc!=0){return rc;}
    let at:i32=112;let id:i32=1;let section:[]u8=nio_alloc(16);if(section.len!=16){return cl_io();}
    // Clearly tagged fixture payloads: not fake learned parameters or R27 state.
    while(id<=10){cl_put(section,0,id as i64);cl_put(section,4,sequence as i64);cl_put(section,8,20260912);cl_put(section,12,0);
        rc=cl_checkpoint_section(b,&at,id,section);if(rc!=0){nio_free(section);return rc;}id=id+1;}
    rc=cl_checkpoint_section(b,&at,11,w);if(rc!=0){nio_free(section);return rc;}
    let s:CLStream=CLStream{.source=1,.clock=1,.sequence=(cl_u32(w,8) as i32)+1,.tick=cl_u32(w,8)*1000};
    rc=cl_stream_save(&s,section);if(rc==0){rc=cl_checkpoint_section(b,&at,12,section);}nio_free(section);
    if(rc!=0){return rc;}return cl_checkpoint_finish(b,at);
}
fn ct_checkpoint_unit()i32 {
    let f:i32=0;let w:[]u8=nio_alloc(96);cw_init(w,17);let b:[]u8=nio_alloc(4096);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    ns_sha256("ENGINEERING_FIXTURE_NOT_R27",parent);let n:i32=ct_checkpoint(b,w,parent,previous,1);
    f=f+cl_check("checkpoint_build",(n>0) as i32,1);if(n<=0){return f;}
    f=f+cl_check("checkpoint_validate",cl_checkpoint_check(b[0..n],parent,previous,1),0);
    f=f+cl_check("world_section_exact",nio_equal(cl_checkpoint_get(b[0..n],11),w),1);
    b[n-1]=b[n-1]^1;f=f+cl_check("checkpoint_corrupt",cl_checkpoint_check(b[0..n],parent,previous,1),cl_corrupt());b[n-1]=b[n-1]^1;
    f=f+cl_check("checkpoint_wrong_sequence",cl_checkpoint_check(b[0..n],parent,previous,2),cl_bad());
    parent[0]=parent[0]^1;f=f+cl_check("checkpoint_wrong_parent",cl_checkpoint_check(b[0..n],parent,previous,1),cl_corrupt());parent[0]=parent[0]^1;
    cl_put(b,112,2);f=f+cl_check("checkpoint_missing_section",cl_checkpoint_check(b[0..n],parent,previous,1),cl_bad());cl_put(b,112,1);
    cl_put(b,116,4294967295);f=f+cl_check("checkpoint_overflow_length",cl_checkpoint_check(b[0..n],parent,previous,1),cl_bound());
    f=f+cl_check("parent_not_fabricated",cl_parent_admission(),cl_parent_pending());
    nio_free(w);nio_free(b);nio_free(parent);nio_free(previous);return f;
}
fn ct_mkdir_at(root:i64,name:[]u8)i64 {
    let n:[]u8=nio_cstr(name);if(n.len==0){return -1;}let rc:i64=_zag_darwin_syscall(475,root,_zag_slice_ptr(n) as i64,448,0,0,0);nio_free(n);return rc;
}
fn ct_path_tests(root:i64) i32 {
    let f:i32=0;f=f+cl_check64("write_exclusive",cl_file_write(root,"one.bin","original"),0);
    f=f+cl_check64("no_overwrite",cl_file_write(root,"one.bin","replacement"),cl_path());
    f=f+cl_check64("parent_traversal",cl_open(root,"../escape",1),cl_path());
    f=f+cl_check64("absolute_path",cl_open(root,"/escape",1),cl_path());
    let nul:[]u8=nio_alloc(3);nul[0]=97;nul[2]=98;f=f+cl_check64("nul_path",cl_open(root,nul,1),cl_path());nio_free(nul);
    let target:[]u8=nio_cstr("one.bin");let link:[]u8=nio_cstr("sym.bin");
    let sy:i64=_zag_darwin_syscall(474,_zag_slice_ptr(target) as i64,root,_zag_slice_ptr(link) as i64,0,0,0);
    f=f+cl_check64("symlink_fixture",sy,0);f=f+cl_check64("symlink_refused",cl_open(root,"sym.bin",0),cl_path());nio_free(target);nio_free(link);
    f=f+cl_check64("hardlink_fixture",nio_link(root,"one.bin","hard.bin"),0);
    f=f+cl_check64("hardlink_original_refused",cl_open(root,"one.bin",0),cl_path());f=f+cl_check64("hardlink_alias_refused",cl_open(root,"hard.bin",0),cl_path());
    let fifo:[]u8=nio_cstr("fifo");let mk:i64=_zag_darwin_syscall(553,root,_zag_slice_ptr(fifo) as i64,384,0,0,0);nio_free(fifo);
    f=f+cl_check64("fifo_fixture",mk,0);f=f+cl_check64("fifo_nonblocking_refusal",cl_open(root,"fifo",0),cl_path());
    f=f+cl_check64("directory_fixture",ct_mkdir_at(root,"directory"),0);f=f+cl_check64("directory_refusal",cl_open(root,"directory",0),cl_path());
    f=f+cl_check("errno_io",cl_errno(-5),cl_io());f=f+cl_check("errno_host",cl_errno(-78),cl_abi());f=f+cl_check("errno_capability",cl_errno(-13),cl_path());
    // Retain opened directory capability, rename it and create a replacement.
    f=f+cl_check64("root_fixture",ct_mkdir_at(root,"live"),0);
    let old:[]u8=nio_cstr("live");let moved:[]u8=nio_cstr("moved");
    let live:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(old) as i64,17826048,0,0,0);
    f=f+cl_check("root_open",(live>=0) as i32,1);
    _zag_darwin_syscall(465,root,_zag_slice_ptr(old) as i64,root,_zag_slice_ptr(moved) as i64,0,0);
    f=f+cl_check64("root_replace",ct_mkdir_at(root,"live"),0);
    f=f+cl_check("retained_capability_write",cl_file_write(live,"retained.bin","retained"),0);nio_close(live);
    let replacement:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(old) as i64,17826048,0,0,0);
    let original:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(moved) as i64,17826048,0,0,0);
    f=f+cl_check("original_directory_open",(original>=0) as i32,1);
    f=f+cl_check64("replacement_untouched",cl_open(replacement,"retained.bin",0),cl_path());
    let read:[]u8=nio_alloc(8);f=f+cl_check("original_directory_read",cl_file_read(original,"retained.bin",read),8);f=f+cl_check("retained_bytes",nio_equal(read,"retained"),1);
    nio_close(replacement);nio_close(original);nio_free(old);nio_free(moved);nio_free(read);return f;
}

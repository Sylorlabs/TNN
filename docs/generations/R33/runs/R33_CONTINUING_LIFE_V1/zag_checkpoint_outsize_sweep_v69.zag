// Native Zag sweep for checkpoint-section behavior as output capacity grows.
@import("checkpoint.zag")

fn clv69_probe_out(n:i32)i32 {
    let out:[]u8=nio_alloc(n);let payload:[]u8=nio_alloc(1);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=n || payload.len!=1 || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("R27_CHECKPOINT_OUTSIZE_SWEEP_V69",parent);
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at:i32=CL_CHECKPOINT_HEADER;
    if(rc==0){rc=cl_checkpoint_section(out,&at,1,payload);}
    _zag_print("CL_V69_OUTSIZE_SWEEP,");cl_number(n as i64);_zag_print(",");cl_number(rc as i64);_zag_print(",");cl_number(at as i64);_zag_println("");
    let ok:i32=(rc==0 && at==121) as i32;
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);
    return (ok!=1) as i32;
}

fn main()i32 {
    let failures:i32=0;
    failures=failures+clv69_probe_out(4096);
    failures=failures+clv69_probe_out(16384);
    failures=failures+clv69_probe_out(32768);
    failures=failures+clv69_probe_out(65535);
    failures=failures+clv69_probe_out(65536);
    failures=failures+clv69_probe_out(131072);
    failures=failures+clv69_probe_out(262144);
    failures=failures+clv69_probe_out(300000);
    _zag_print("CL_V69_OUTSIZE_SWEEP_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

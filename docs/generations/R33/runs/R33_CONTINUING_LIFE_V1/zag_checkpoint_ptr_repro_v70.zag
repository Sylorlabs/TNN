// Minimal native-Zag reproducer for the pointer corruption observed in
// cl_checkpoint_section on macOS-arm64. This contains no learner logic.
@import("common.zag")

fn v70_guard(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    if(at==null as *i32){return cl_bad();}
    if(id<1 || id>12){return cl_bad();}
    if(payload.len<1 || payload.len>262144){return cl_bad();}
    if(cl_disjoint(out,payload)!=1){return cl_bad();}
    if(at.*<112 || at.*>out.len-40 || payload.len>out.len-40-at.*){return cl_bound();}
    return 0;
}

fn v70_guard_no_call(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    if(at==null as *i32){return cl_bad();}
    if(id<1 || id>12){return cl_bad();}
    if(payload.len<1 || payload.len>262144){return cl_bad();}
    if(at.*<112 || at.*>out.len-40 || payload.len>out.len-40-at.*){return cl_bound();}
    return 0;
}

fn v70_put1(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    let rc:i32=v70_guard(out,at,id,payload);if(rc!=0){return rc;}
    cl_put(out,at.*,id as i64);return 0;
}

fn v70_put2(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    let rc:i32=v70_guard(out,at,id,payload);if(rc!=0){return rc;}
    cl_put(out,at.*,id as i64);cl_put(out,at.*+4,payload.len as i64);return 0;
}

fn v70_copy(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    let rc:i32=v70_guard(out,at,id,payload);if(rc!=0){return rc;}
    cl_put(out,at.*,id as i64);cl_put(out,at.*+4,payload.len as i64);
    cl_copy(out[at.*+8..at.*+8+payload.len],payload);return 0;
}

fn v70_full(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    let rc:i32=v70_guard(out,at,id,payload);if(rc!=0){return rc;}
    cl_put(out,at.*,id as i64);cl_put(out,at.*+4,payload.len as i64);
    cl_copy(out[at.*+8..at.*+8+payload.len],payload);at.*=at.*+8+payload.len;return 0;
}

fn main()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(1);
    if(out.len!=300000 || payload.len!=1){return 70;}
    let at0:i32=112;let rc0:i32=v70_guard_no_call(out,&at0,1,payload);
    _zag_print("V70_NO_CALL,");cl_number(rc0 as i64);_zag_print(",");cl_number(at0 as i64);_zag_println("");
    let at1:i32=112;let rc1:i32=v70_guard(out,&at1,1,payload);
    _zag_print("V70_WITH_CALL,");cl_number(rc1 as i64);_zag_print(",");cl_number(at1 as i64);_zag_println("");
    let at2:i32=112;let rc2:i32=v70_put1(out,&at2,1,payload);
    _zag_print("V70_PUT1,");cl_number(rc2 as i64);_zag_print(",");cl_number(at2 as i64);_zag_println("");
    let at3:i32=112;let rc3:i32=v70_put2(out,&at3,1,payload);
    _zag_print("V70_PUT2,");cl_number(rc3 as i64);_zag_print(",");cl_number(at3 as i64);_zag_println("");
    let at4:i32=112;let rc4:i32=v70_copy(out,&at4,1,payload);
    _zag_print("V70_COPY,");cl_number(rc4 as i64);_zag_print(",");cl_number(at4 as i64);_zag_println("");
    let at5:i32=112;let rc5:i32=v70_full(out,&at5,1,payload);
    _zag_print("V70_FULL,");cl_number(rc5 as i64);_zag_print(",");cl_number(at5 as i64);_zag_println("");
    let failures:i32=((rc0!=0 || at0!=112) as i32)+((rc1!=0 || at1!=112) as i32)+
        ((rc2!=0 || at2!=112) as i32)+((rc3!=0 || at3!=112) as i32)+
        ((rc4!=0 || at4!=112) as i32)+((rc5!=0 || at5!=121) as i32);
    _zag_print("V70_FAILURES,");cl_number(failures as i64);_zag_println("");
    nio_free(out);nio_free(payload);return (failures!=0) as i32;
}

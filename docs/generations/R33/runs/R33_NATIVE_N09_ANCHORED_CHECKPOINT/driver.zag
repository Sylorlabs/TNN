fn c9_has(b:[]u8,needle:[]u8)i32 {
    let i:i32=0;while(i+needle.len<=b.len){let k:i32=0;while(k<needle.len && b[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;}return 0;
}
fn c9_number(b:[]u8,prefix:[]u8,tail:[]u8)i32 {
    let value:i32=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i32=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<9){v=v*10+(b[at] as i32)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;
}
fn c9_capture(root:i64,label:[]u8)[]u8 {
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(label,".stdout");let fd:i64=nio_open_child(root,name,0);
    let n:i64=nio_read_exact(fd,b,262144);if(fd>=0){nio_close(fd);}nio_free(name);if(n<0 || n>262144){nio_free(b);return "";}return b[0..n as i32];
}
fn c9_sandbox(s:*C9Stats)void {
    let j:NaStore=c9_store("sandbox",1,s);c9_check(s,"authority_open",j.status,0);if(j.status!=0){return;}
    let scene:i64=c9_scene("sandbox");let root:i64=nio_open_root(c9_root());let d:[]u8=c9_data(4096,29);c9_commit(&j,d,1,3,s);

    let leaked:i64=nio_open_child(j.root,"attempt-1.bin",0);c9_check(s,"intentional_descriptor40_canary",_zag_darwin_syscall(90,leaked,40,0,0,0,0),40);if(leaked>=0){nio_close(leaked);}
    if(s.*.failed==0){let r:NativeRunV3=nrv3_run(root,_zag_arg(0),"launch-worker","sandbox-worker",15000,262144);
        s.*.nested=s.*.nested+1;c9_check(s,"kernel_worker_status",r.status,0);c9_check(s,"kernel_worker_reaped",r.reaped,1);
        c9_check(s,"kernel_worker_exit",r.exit_code,0);c9_check(s,"kernel_worker_signal",r.signal,0);c9_check(s,"kernel_worker_stderr",r.stderr_bytes,0);
        c9_check(s,"kernel_worker_rss",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
        let log:[]u8=c9_capture(root,"sandbox-worker");c9_check(s,"complete_worker_capture",log.len,r.stdout_bytes);
        let passed:i32=c9_has(log,"N09_WORKER_COUNTS,10,0\n");c9_check(s,"worker_ten_checks",passed,1);c9_check(s,"worker_terminal_pass",c9_has(log,"N09_WORKER_PASS\n"),1);
        if(passed==1 && r.exit_code==0){s.*.child_checks=s.*.child_checks+10;}
        let h:[]u8=nio_alloc(32);ns_sha256(packet,h);let hex:[]u8=ns_hex(h);let expected:[]u8=_zag_str_concat("N09_WORKER_INPUT_SHA256,",hex);expected=ci_join(expected,"\n");
        c9_check(s,"worker_received_exact_current_packet",c9_has(log,expected),1);nio_free(expected);nio_free(hex);nio_free(h);nio_free(log);
    }
    c9_check(s,"close_descriptor_canary",nio_close(40),0);na_close(&j);j=c9_store("sandbox",0,s);c9_check(s,"actual_authority_reopens_after_worker",j.status,0);

    let p:[]u8=c9_packet(&j,s);let a:[]u8=nio_alloc(p.len);let out:[]u8=nio_alloc(64);let i:i32=0;
    c9_check(s,"planned_tamper_positions",p.len,256);
    while(i<p.len){na_copy(p,a);a[i]=(a[i] as i32 ^ 1) as u8;c9_fill(out,211);
        c9_check(s,"each_tampered_byte_refused",(cs_restore(&j,a,out)<0) as i32,1);c9_check(s,"each_tamper_no_output_write",c9_all(out,211),1);i=i+1;}
    c9_refuse(&j,p[0..223],-8601,s);c9_check(s,"protected_output_alias_refused",cs_restore(&j,p,j.state),-8611);
    c9_check(s,"protected_packet_alias_refused",cs_restore(&j,j.state[0..256],out),-8611);
    c9_check(s,"protected_export_alias_refused",cs_export(&j,j.state),-8611);
    let short:[]u8=nio_alloc(31);c9_fill(short,211);c9_check(s,"short_delivery_refused",cs_restore(&j,p,short),-8601);c9_check(s,"short_delivery_unchanged",c9_all(short,211),1);nio_free(short);
    short=nio_alloc(255);c9_fill(short,211);c9_check(s,"short_export_refused",cs_export(&j,short),-8601);c9_check(s,"short_export_unchanged",c9_all(short,211),1);nio_free(short);
    let expected:[]u8=c9_data(32,3);c9_deliver(&j,p,expected,s);na_copy(p,a);c9_check(s,"packet_output_overlap_supported",cs_restore(&j,a,a),32);
    c9_check(s,"packet_output_overlap_exact",nio_equal(a[0..32],expected),1);c9_check(s,"no_admitted_state_mutation",j.seq,0);
    c9_check(s,"unsafe_profile_quote_refused",ci_profile("/tmp/\"","/tmp/a","/tmp/b","/tmp/c","/tmp/d").len,0);
    c9_check(s,"unsafe_profile_newline_refused",ci_profile("/tmp/a","/tmp/\n","/tmp/b","/tmp/c","/tmp/d").len,0);
    nio_free(expected);nio_free(p);nio_free(a);nio_free(out);na_close(&j);
}
fn c9_branch(s:*C9Stats)void {
    let j:NaStore=c9_store("branch-main",1,s);let other:NaStore=c9_store("branch-other",1,s);
    c9_check(s,"main_open",j.status,0);c9_check(s,"other_open",other.status,0);if(j.status!=0 || other.status!=0){na_close(&j);na_close(&other);return;}
    let a:[]u8=c9_data(32,29);let b:[]u8=c9_data(32,59);c9_commit(&j,a,1,3,s);c9_commit(&other,b,1,3,s);
    c9_check(s,"forks_same_numeric_version",j.version,other.version);c9_check(s,"forks_same_numeric_nonce",j.nonce,other.nonce);c9_check(s,"forks_same_spent",j.spent,other.spent);
    let foreign:[]u8=c9_packet(&other,s);c9_refuse(&j,foreign,-8604,s);let own:[]u8=c9_packet(&j,s);c9_deliver(&j,own,a,s);
    nio_free(foreign);nio_free(own);nio_free(a);nio_free(b);na_close(&j);na_close(&other);
}
fn c9_revocation(s:*C9Stats)void {
    let j:NaStore=c9_store("revocation",1,s);c9_check(s,"open",j.status,0);if(j.status!=0){return;}

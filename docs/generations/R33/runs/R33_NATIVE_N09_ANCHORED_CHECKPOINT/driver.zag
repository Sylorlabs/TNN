fn c9_write(root:i64,name:[]u8,b:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(root)!=0){code=-1;}
    if(nio_close(fd)!=0){code=-1;}return code;
}
fn c9_read(root:i64,name:[]u8)i32 {let fd:i64=nio_open_child(root,name,0);if(fd>=0){nio_close(fd);return 0;}return fd as i32;}
fn c9_bytes(root:i64,name:[]u8)[]u8 {
    let b:[]u8=nio_alloc(4320);let fd:i64=nio_open_child(root,name,0);let n:i64=nio_read_exact(fd,b,4320);if(fd>=0){nio_close(fd);}
    if(n<0 || n>4320){nio_free(b);return "";}return b[0..n as i32];
}
fn c9_packet(j:*NaStore,s:*C9Stats)[]u8 {
    let b:[]u8=nio_alloc(4321);c9_fill(b,211);let n:i32=cs_export(j,b);c9_check(s,"checkpoint_export_length",n,224+j.*.state_len);
    if(n<224 || n>4320){nio_free(b);return "";}c9_check(s,"checkpoint_export_tail",b[n] as i32,211);return b[0..n];
}
fn c9_deliver(j:*NaStore,p:[]u8,expected:[]u8,s:*C9Stats)void {
    let out:[]u8=nio_alloc(expected.len+1);c9_fill(out,211);c9_check(s,"anchored_delivery_length",cs_restore(j,p,out),expected.len);
    c9_check(s,"anchored_delivery_exact",nio_equal(out[0..expected.len],expected),1);c9_check(s,"delivery_tail_unchanged",out[expected.len] as i32,211);nio_free(out);
}
fn c9_refuse(j:*NaStore,p:[]u8,code:i32,s:*C9Stats)void {
    let out:[]u8=nio_alloc(4097);c9_fill(out,211);c9_check(s,"checkpoint_refusal",cs_restore(j,p,out),code);c9_check(s,"refusal_output_unchanged",c9_all(out,211),1);nio_free(out);
}
fn c9_normal(replay:i32,s:*C9Stats)void {
    let j:NaStore=c9_store("normal",1-replay,s);c9_check(s,"authority_open",j.status,0);if(j.status!=0){return;}
    let root:i64=c9_scene("normal");let d:[]u8=c9_data(4096,29);
    if(replay==0){let old:[]u8=c9_packet(&j,s);c9_check(s,"old_receipt_preserved",c9_write(root,"older.bin",old),0);nio_free(old);
        c9_commit(&j,d,1,3,s);let current:[]u8=c9_packet(&j,s);c9_check(s,"current_receipt_saved",c9_write(root,"current.bin",current),0);nio_free(current);}
    let p:[]u8=c9_bytes(root,"current.bin");let old:[]u8=c9_bytes(root,"older.bin");c9_deliver(&j,p,d,s);c9_refuse(&j,old,-8604,s);
    c9_check(s,"current_authority_version",j.version,12);c9_check(s,"current_authority_spent",j.spent,3);c9_check(s,"current_authority_nonce",j.nonce,1);
    if(replay==1){let initial:[]u8=c9_data(32,3);c9_commit(&j,initial,2,2,s);c9_refuse(&j,p,-8604,s);
        let fresh:[]u8=c9_packet(&j,s);c9_deliver(&j,fresh,initial,s);c9_check(s,"payload_rollback_does_not_refund",j.spent,5);
        c9_check(s,"payload_rollback_does_not_rewind_nonce",j.nonce,2);c9_check(s,"payload_rollback_version_advances",j.version,13);nio_free(fresh);nio_free(initial);}
    nio_free(p);nio_free(old);nio_free(d);nio_close(root);na_close(&j);
}
fn c9_tamper(s:*C9Stats)void {

fn c9_crash(kind:i32,replay:i32,s:*C9Stats)void {
    let number:[]u8=_zag_i64_to_str(kind as i64);let name:[]u8=_zag_str_concat("crash",number);let j:NaStore=c9_store(name,1-replay,s);
    c9_check(s,"authority_open",j.status,0);if(j.status!=0){nio_free(number);nio_free(name);return;}
    let root:i64=c9_scene(name);let d:[]u8=c9_data(32,29);
    if(replay==0){let before:[]u8=c9_packet(&j,s);c9_check(s,"before_receipt_retained",c9_write(root,"older.bin",before),0);nio_free(before);
        let g:[]u8=c9_grant(&j,d,1,3,1);if(s.*.failed!=0){_zag_exit(1);}_zag_println("N09_DECLARED_CRASH_BOUNDARY");
        if(kind==3){na_submit_diagnostic(&j,g,d,3);_zag_exit(1);}
        c9_check(s,"authority_commit_before_cache",na_submit(&j,g,d),0);if(s.*.failed!=0){_zag_exit(1);}if(kind==1){_zag_exit(73);}
        let p:[]u8=c9_packet(&j,s);c9_check(s,"partial_cache_saved",c9_write(root,"torn.bin",p[0..p.len/2]),0);if(s.*.failed!=0){_zag_exit(1);}_zag_exit(74);
    }else{let old:[]u8=c9_bytes(root,"older.bin");c9_refuse(&j,old,-8604,s);nio_free(old);
        c9_check(s,"crash_did_not_refund",j.spent,3);c9_check(s,"crash_did_not_rewind_nonce",j.nonce,1);c9_check(s,"one_authoritative_intent",j.seq,1);
        if(kind==2){let torn:[]u8=c9_bytes(root,"torn.bin");c9_refuse(&j,torn,-8601,s);nio_free(torn);}
        else{c9_check(s,"cache_was_never_published",c9_read(root,"torn.bin"),-2);}
        let fresh:[]u8=c9_packet(&j,s);if(kind==3){let initial:[]u8=c9_data(32,3);c9_deliver(&j,fresh,initial,s);nio_free(initial);
            c9_check(s,"orphan_not_promoted_to_state",j.version,11);c9_check(s,"orphan_stays_visible",j.orphans,1);}
        else{c9_deliver(&j,fresh,d,s);c9_check(s,"committed_state_recovers",j.version,12);}
        c9_check(s,"current_receipt_reconstructed_from_authority",c9_write(root,"reconstructed.bin",fresh),0);nio_free(fresh);
    }nio_free(d);nio_close(root);na_close(&j);nio_free(number);nio_free(name);
}
fn c9_damage(j:*NaStore,scene:i64)i32 {
    let fd:i64=nio_open_child(j.*.root,"attempt-1.bin",0);let b:[]u8=nio_alloc(4464);let n:i64=nio_read_exact(fd,b,4464);if(fd>=0){nio_close(fd);}
    if(n<368 || n>4464){nio_free(b);return -1;}if(c9_write(scene,"authority-preimage.bin",b[0..n as i32])!=0){nio_free(b);return -1;}
    let name:[]u8=nio_cstr("attempt-1.bin");fd=_zag_darwin_syscall(463,j.*.root,_zag_slice_ptr(name) as i64,16777478,0,0,0);nio_free(name);
    let code:i32=0;if(fd<0 || nio_regular(fd)!=1){code=-1;}else{b[(n as i32)-1]=(b[(n as i32)-1] as i32 ^ 1) as u8;
        if(nio_write_all(fd,b[0..n as i32])!=n || nio_sync(fd)!=0 || nio_sync(j.*.root)!=0){code=-1;}}
    if(fd>=0){nio_close(fd);}nio_free(b);return code;
}
fn c9_corrupt(replay:i32,s:*C9Stats)void {

    if(create==1){c9_check(s,"scene_exclusive_create",nio_mkdir(base),0);c9_check(s,"authority_exclusive_create",na_create(path,c,keys,initial),0);}
    let j:NaStore=na_open(path,c,keys);nio_free(base);nio_free(path);nio_free(c);na_wipe(keys);nio_free(initial);return j;
}
fn c9_grant(j:*NaStore,d:[]u8,nonce:i32,cost:i32,op:i32)[]u8 {
    let g:[]u8=nio_alloc(256);na_copy("R33GRT01",g);na_put(g,8,1);na_put(g,12,op);
    na_put(g,16,101);na_put(g,20,9009);na_put(g,24,7009);na_put(g,28,0);na_put(g,32,j.*.epoch);
    na_put(g,36,nonce);na_put(g,40,j.*.version);na_put(g,44,cost);na_put(g,48,32);na_put(g,52,1);na_put(g,56,d.len);
    ns_sha256(d,g[64..96]);na_copy(j.*.config[64..96],g[96..128]);na_copy(j.*.state_hash,g[128..160]);na_copy(j.*.policy_hash,g[160..192]);
    let keys:[]u8=c9_keys();na_hmac(keys[0..32],g[0..224],g[224..256]);na_wipe(keys);return g;
}
fn c9_commit(j:*NaStore,d:[]u8,nonce:i32,cost:i32,s:*C9Stats)void {
    let g:[]u8=c9_grant(j,d,nonce,cost,1);c9_check(s,"synthetic_authorized_commit",na_submit(j,g,d),0);nio_free(g);

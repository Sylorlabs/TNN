struct C9Stats {checks:i32,failed:i32,children:i32,nested:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64}
fn c9_stats()C9Stats {return C9Stats{.checks=0,.failed=0,.children=0,.nested=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn c9_check(s:*C9Stats,k:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(k,a,e);}
fn c9_root()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N09_RUN_PRIMARY_V1";}
fn c9_path(name:[]u8)[]u8 {let p:[]u8=_zag_str_concat(c9_root(),"/");let out:[]u8=_zag_str_concat(p,name);nio_free(p);return out;}
fn c9_worker()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N09_ANCHORED_CHECKPOINT/BUILD_01/worker";}
fn c9_bootstrap()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N09_ANCHORED_CHECKPOINT/dyld-support.sb";}
fn c9_data(n:i32,salt:i32)[]u8 {let b:[]u8=nio_alloc(n);let i:i32=0;while(i<b.len){b[i]=((i*37+salt)%256) as u8;i=i+1;}return b;}
fn c9_fill(b:[]u8,v:i32)void {let i:i32=0;while(i<b.len){b[i]=v as u8;i=i+1;}}
fn c9_all(b:[]u8,v:i32)i32 {let i:i32=0;while(i<b.len){if(b[i]!=v as u8){return 0;}i=i+1;}return 1;}
fn c9_keys()[]u8 {let b:[]u8=nio_alloc(64);let i:i32=0;while(i<64){b[i]=((i*19+9)%256) as u8;i=i+1;}return b;}
fn c9_config()[]u8 {
    let c:[]u8=nio_alloc(128);let initial:[]u8=c9_data(32,3);na_copy("R33POL01",c);
    na_put(c,8,1);na_put(c,12,101);na_put(c,16,9009);na_put(c,20,7009);na_put(c,24,0);na_put(c,28,20);na_put(c,32,11);
    ns_sha256("r33-native-n09-supervisor-head-checkpoint-v1",c[64..96]);ns_sha256(initial,c[96..128]);nio_free(initial);return c;
}
fn c9_scene(name:[]u8)i64 {let path:[]u8=c9_path(name);let root:i64=nio_open_root(path);nio_free(path);return root;}
fn c9_store(name:[]u8,create:i32,s:*C9Stats)NaStore {

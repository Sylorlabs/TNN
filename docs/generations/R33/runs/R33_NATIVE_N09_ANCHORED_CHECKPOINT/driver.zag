    c9_check(s,"restriction_epoch_current",j.epoch,1);c9_check(s,"restriction_spent_preserved",j.spent,3);c9_check(s,"restriction_lowered_budget",j.budget,2);
    nio_free(after);nio_free(before);nio_free(g);nio_free(limit);nio_free(d);na_close(&j);

    nio_free(packet);nio_free(d);nio_close(scene);nio_close(root);na_close(&j);
}
fn c9_run(root:i64,mode:[]u8,expected:i32,s:*C9Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,15000,262144);s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    c9_check(s,"child_status",r.status,0);c9_check(s,"child_started",r.started,1);c9_check(s,"child_reaped",r.reaped,1);c9_check(s,"child_exit",r.exit_code,expected);
    c9_check(s,"child_signal",r.signal,0);c9_check(s,"child_stderr_empty",r.stderr_bytes,0);c9_check(s,"observed_child_rss",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let log:[]u8=c9_capture(root,mode);c9_check(s,"complete_capture",log.len,r.stdout_bytes);
    if(expected==0){c9_check(s,"child_terminal_pass",c9_has(log,"N09_CHILD_PASS\n"),1);
        let checks:i32=c9_number(log,"N09_CHILD_COUNTS,",",0\n");let nested:i32=c9_number(log,"N09_NESTED_CHILDREN,","\n");let nested_checks:i32=c9_number(log,"N09_NESTED_CHECKS,","\n");
        c9_check(s,"valid_native_counts",(checks>0 && nested>=0 && nested_checks>=0) as i32,1);
        if(checks>0 && nested_checks>=0){s.*.child_checks=s.*.child_checks+checks+nested_checks;}if(nested>=0){s.*.nested=s.*.nested+nested;}
    }else if(expected==73 || expected==74){c9_check(s,"declared_crash_marker",c9_has(log,"N09_DECLARED_CRASH_BOUNDARY\n"),1);}
    else{c9_check(s,"invalid_mode_silent",log.len,0);}nio_free(log);
}
fn c9_field(b:[]u8,k:[]u8,v:i64)[]u8 {let n:[]u8=_zag_i64_to_str(v);b=ci_join(b,k);b=ci_join(b,n);nio_free(n);return b;}
fn c9_supervise()i32 {
    if(nio_guard(60)!=0){return 3;}let a:NativeAdmissionV3=nrv3_admit_root(c9_root());if(a.status!=0){return 4;}let root:i64=a.root;let s:C9Stats=c9_stats();
    c9_run(root,"invalid",2,&s);c9_run(root,"normal-write",0,&s);c9_run(root,"normal-replay",0,&s);c9_run(root,"tamper",0,&s);
    c9_run(root,"branch",0,&s);c9_run(root,"revocation",0,&s);
    c9_run(root,"crash1-write",73,&s);c9_run(root,"crash1-replay",0,&s);c9_run(root,"crash2-write",74,&s);c9_run(root,"crash2-replay",0,&s);
    c9_run(root,"crash3-write",73,&s);c9_run(root,"crash3-replay",0,&s);c9_run(root,"corrupt-write",0,&s);c9_run(root,"corrupt-replay",0,&s);c9_run(root,"sandbox",0,&s);
    c9_check(&s,"all_top_level_children_completed",s.children,15);c9_check(&s,"one_kernel_confined_worker_completed",s.nested,1);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N09\",\n  \"planned_top_level_children\":15","");
    json=c9_field(json,",\n  \"top_level_children_reaped\":",s.children);json=c9_field(json,",\n  \"nested_children_reaped\":",s.nested);
    json=c9_field(json,",\n  \"parent_failures\":",s.failed);json=c9_field(json,",\n  \"verified_completed_child_checks\":",s.child_checks);
    json=c9_field(json,",\n  \"parent_checks_before_result_write\":",s.checks);json=c9_field(json,",\n  \"top_level_child_cpu_us\":",s.cpu);
    json=c9_field(json,",\n  \"observed_top_level_child_wall_us\":",s.wall);json=c9_field(json,",\n  \"peak_top_level_child_rss_bytes\":",s.rss);
    json=ci_join(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"real_human_grant\":false,\n  \"host_admin_antirollback\":false,\n  \"full_runtime_qualified\":false,\n  \"requires_terminal_marker\":true\n}\n");
    c9_check(&s,"native_result_saved",c9_write(root,"NATIVE_RESULT.json",json),0);_zag_print(json);nio_free(json);c9_check(&s,"close_root",nio_close(root),0);
    if(s.failed!=0){return 1;}_zag_println("R33_N09_SUPERVISOR_ANCHORED_CHECKPOINT_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return c9_supervise();}if(_zag_strcmp(mode,"invalid")==1){return 2;}
    if(_zag_strcmp(mode,"launch-worker")==1){return ci_launch(c9_worker(),"probe",c9_path("sandbox/input.bin"),c9_path("sandbox-worker.stdout"),c9_path("sandbox-worker.stderr"),c9_bootstrap());}
    if(nio_deadline(15)!=0){return 3;}let s:C9Stats=c9_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"normal-write")==1){c9_normal(0,&s);}else if(_zag_strcmp(mode,"normal-replay")==1){c9_normal(1,&s);}
    else if(_zag_strcmp(mode,"tamper")==1){c9_tamper(&s);}else if(_zag_strcmp(mode,"branch")==1){c9_branch(&s);}
    else if(_zag_strcmp(mode,"revocation")==1){c9_revocation(&s);}else if(_zag_strcmp(mode,"corrupt-write")==1){c9_corrupt(0,&s);}
    else if(_zag_strcmp(mode,"corrupt-replay")==1){c9_corrupt(1,&s);}else if(_zag_strcmp(mode,"sandbox")==1){c9_sandbox(&s);}
    else{handled=0;let i:i32=1;while(i<=3 && handled==0){let number:[]u8=_zag_i64_to_str(i as i64);let stem:[]u8=_zag_str_concat("crash",number);
        let write:[]u8=_zag_str_concat(stem,"-write");let replay:[]u8=_zag_str_concat(stem,"-replay");
        if(_zag_strcmp(mode,write)==1){handled=1;c9_crash(i,0,&s);}else if(_zag_strcmp(mode,replay)==1){handled=1;c9_crash(i,1,&s);}
        nio_free(number);nio_free(stem);nio_free(write);nio_free(replay);i=i+1;}}
    if(handled==0){return 2;}_zag_print("N09_NESTED_CHILDREN,");_zag_println(_zag_i64_to_str(s.nested as i64));
    _zag_print("N09_NESTED_CHECKS,");_zag_println(_zag_i64_to_str(s.child_checks as i64));
    _zag_print("N09_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N09_CHILD_PASS");return 0;
}

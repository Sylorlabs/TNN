// Evaluator-only component tests. No learner, historical generator or training.
@import("R33_B001_COMPONENTS.zag")

fn c01_metric(key:[]u8,value:i32)void {
    _zag_print("M,");_zag_print(key);_zag_print(",");_zag_println(_zag_i64_to_str(value as i64));
}
fn c01_vector(key:[]u8,values:[]i32,count:i32)void {
    let i:i32=0;
    while(i<count){
        _zag_print("V,");_zag_print(key);_zag_print(",");_zag_print(_zag_i64_to_str(i as i64));
        _zag_print(",");_zag_println(_zag_i64_to_str(values[i] as i64));i=i+1;
    }
}
fn c01_fill(values:[]i32,value:i32)void {let i:i32=0;while(i<values.len){values[i]=value;i=i+1;}}

fn c01_audio()void {
    let bytes:[]i32=zalloc_i(131072);let decoded:[]i32=zalloc_i(65536);let i:i32=0;
    while(i<65536){bytes[i*2]=i-(i/256)*256;bytes[i*2+1]=i/256;i=i+1;}
    c01_metric("pcm.exhaustive_status",r33_pcm16le_decode(bytes,decoded,1,48000));
    c01_vector("pcm.all_i16_codes",decoded,65536);
    let encoded:[]i32=zalloc_i(131072);
    c01_metric("pcm.roundtrip_status",r33_pcm16le_encode(decoded,encoded));
    let mismatches:i32=0;i=0;
    while(i<bytes.len){if(bytes[i]!=encoded[i]){mismatches=mismatches+1;}i=i+1;}
    c01_metric("pcm.roundtrip_byte_mismatches",mismatches);
    zfree(bytes);zfree(decoded);zfree(encoded);

    let b:[]i32=zalloc_i(8);let out:[]i32=zalloc_i(4);c01_fill(out,-777);
    b[0]=0;b[1]=128;b[2]=255;b[3]=127;b[4]=255;b[5]=255;b[6]=0;b[7]=0;
    c01_metric("pcm.stereo_status",r33_pcm16le_decode(b,out,2,96000));
    c01_vector("pcm.stereo_interleave",out,4);
    c01_metric("pcm.minimum_rate",r33_pcm16le_decode(b,out,2,8000));
    c01_metric("pcm.maximum_rate",r33_pcm16le_decode(b,out,2,192000));
    c01_metric("pcm.below_rate",r33_pcm16le_decode(b,out,2,7999));
    c01_metric("pcm.above_rate",r33_pcm16le_decode(b,out,2,192001));
    c01_fill(out,-777);b[7]=256;
    c01_metric("pcm.malformed_byte",r33_pcm16le_decode(b,out,2,96000));
    c01_vector("pcm.malformed_output",out,4);b[7]=0;
    c01_metric("pcm.bad_rate",r33_pcm16le_decode(b,out,2,0));
    c01_metric("pcm.bad_channels",r33_pcm16le_decode(b,out,3,48000));
    let short:[]i32=zalloc_i(3);c01_fill(short,-777);
    c01_metric("pcm.small_output",r33_pcm16le_decode(b,short,1,48000));
    c01_vector("pcm.small_output_after",short,3);
    c01_metric("pcm.odd_payload",r33_pcm16le_decode(short,out,1,48000));
    let invalid:[]i32=zalloc_i(1);invalid[0]=32768;c01_fill(b,-777);
    c01_metric("pcm.encode_out_of_range",r33_pcm16le_encode(invalid,b));
    c01_vector("pcm.encode_reject_after",b,8);
    b[0]=0;b[1]=128;b[2]=255;b[3]=127;b[4]=255;b[5]=255;b[6]=0;b[7]=0;
    c01_metric("pcm.alias_status",r33_pcm16le_decode(b,b,2,48000));
    c01_vector("pcm.alias_first_samples",b,4);
    let empty:[]i32=zalloc_i(0);
    c01_metric("pcm.empty_status",r33_pcm16le_decode(empty,out,1,48000));
    let too_many:[]i32=zalloc_i(131074);
    c01_metric("pcm.payload_limit",r33_pcm16le_decode(too_many,out,1,48000));
    zfree(too_many);
    zfree(empty);zfree(b);zfree(out);zfree(short);zfree(invalid);
}

fn c01_raw_vision()void {
    let raw:[]i32=zalloc_i(6);let out:[]i32=zalloc_i(6);let i:i32=0;
    while(i<6){raw[i]=i*17;i=i+1;}
    c01_metric("vision.valid",r33_rgb8_ingest(raw,out,2,1));c01_vector("vision.pixels",out,6);
    raw[0]=85;raw[5]=0;
    c01_metric("vision.neartwin_status",r33_rgb8_ingest(raw,out,2,1));
    c01_vector("vision.neartwin",out,6);
    c01_fill(out,-777);
    c01_metric("vision.wrong_shape",r33_rgb8_ingest(raw,out,1,1));
    c01_vector("vision.shape_reject_after",out,6);
    c01_metric("vision.overflow_dimensions",r33_rgb8_ingest(raw,out,2147483647,2147483647));
    c01_metric("vision.zero_dimension",r33_rgb8_ingest(raw,out,0,2));
    c01_metric("vision.above_dimension",r33_rgb8_ingest(raw,out,65,1));
    raw[3]=-1;c01_metric("vision.bad_channel",r33_rgb8_ingest(raw,out,2,1));
    c01_vector("vision.byte_reject_after",out,6);
    raw[0]=0-2147483647-1;raw[1]=-1;raw[2]=0;raw[3]=2147483647;raw[4]=7;raw[5]=-7;
    c01_metric("raw.signed_copy",r33_exact_copy(raw,out));c01_vector("raw.signed_values",out,6);
    c01_metric("raw.alias_copy",r33_exact_copy(raw,raw));c01_vector("raw.alias_after",raw,6);
    let short:[]i32=zalloc_i(2);c01_fill(short,-777);
    c01_metric("raw.insufficient",r33_exact_copy(raw,short));c01_vector("raw.short_after",short,2);
    zfree(raw);zfree(out);zfree(short);
    let maximum:[]i32=zalloc_i(12288);let image:[]i32=zalloc_i(12288);i=0;
    while(i<12288){let value:i32=i*29+11;maximum[i]=value-(value/256)*256;i=i+1;}
    c01_metric("vision.maximum_frame",r33_rgb8_ingest(maximum,image,64,64));
    c01_vector("vision.maximum_pixels",image,12288);
    zfree(maximum);zfree(image);
}

fn c01_order_lru()void {
    let cursor:[]i32=zalloc_i(3);cursor[0]=7;cursor[1]=0;cursor[2]=-1;
    c01_metric("order.first",r33_order_accept(cursor,7,0,100));
    c01_metric("order.tie",r33_order_accept(cursor,7,1,100));
    c01_metric("order.duplicate",r33_order_accept(cursor,7,1,100));
    c01_metric("order.backwards_time",r33_order_accept(cursor,7,2,99));
    c01_metric("order.changed_clock",r33_order_accept(cursor,8,2,101));
    c01_metric("order.future_gap",r33_order_accept(cursor,7,3,101));
    c01_vector("order.after_rejections",cursor,3);
    c01_metric("order.continue",r33_order_accept(cursor,7,2,101));
    c01_vector("order.continued_cursor",cursor,3);
    cursor[1]=2147483647;
    c01_metric("order.ordinal_overflow",r33_order_accept(cursor,7,2147483647,102));
    c01_vector("order.overflow_after",cursor,3);
    let ages:[]i32=zalloc_i(2);let mask:[]i32=zalloc_i(2);
    ages[0]=10;ages[1]=20;mask[0]=1;mask[1]=1;
    c01_metric("lru.protected_refusal",r33_protected_lru(ages,mask,2));
    mask[1]=0;c01_metric("lru.mixed",r33_protected_lru(ages,mask,2));
    mask[0]=0;ages[0]=2147483647;ages[1]=2147483647;
    c01_metric("lru.max_age_tie",r33_protected_lru(ages,mask,2));
    mask[0]=2;c01_metric("lru.invalid_mask",r33_protected_lru(ages,mask,2));
    c01_metric("lru.oversized_count",r33_protected_lru(ages,mask,3));
    c01_metric("lru.empty",r33_protected_lru(ages,mask,0));
    zfree(cursor);zfree(ages);zfree(mask);
}

fn c01_chunk_trace()void {
    let lengths:[]i32=zalloc_i(1);let data:[]i32=zalloc_i(16);lengths[0]=3;
    data[0]=10;data[1]=20;data[2]=30;
    let book:R33ChunkBook=R33ChunkBook{.lengths=lengths,.values=data,.count=1,.version=7};
    let kinds:[]i32=zalloc_i(3);let values:[]i32=zalloc_i(3);
    kinds[0]=0;kinds[1]=1;kinds[2]=0;values[0]=0-2147483647-1;values[1]=0;values[2]=2147483647;
    let out:[]i32=zalloc_i(5);c01_fill(out,-777);
    c01_metric("chunk.full",r33_reconstruct_exact(kinds,values,book,7,out));
    c01_vector("chunk.full_values",out,5);
    let short:[]i32=zalloc_i(4);c01_fill(short,-777);
    c01_metric("chunk.capacity_refusal",r33_reconstruct_exact(kinds,values,book,7,short));
    c01_vector("chunk.short_after",short,4);
    c01_fill(out,-777);
    c01_metric("chunk.stale_version",r33_reconstruct_exact(kinds,values,book,6,out));
    c01_vector("chunk.stale_after",out,5);
    c01_metric("chunk.codebook_alias",r33_reconstruct_exact(kinds,values,book,7,data));
    c01_vector("chunk.codebook_after",data,3);
    values[1]=1;c01_metric("chunk.bad_id",r33_reconstruct_exact(kinds,values,book,7,out));values[1]=0;
    kinds[2]=9;c01_metric("chunk.bad_kind",r33_reconstruct_exact(kinds,values,book,7,out));
    c01_vector("chunk.invalid_after",out,5);
    kinds[2]=0;lengths[0]=0;
    c01_metric("chunk.zero_length",r33_reconstruct_exact(kinds,values,book,7,out));
    lengths[0]=17;c01_metric("chunk.excess_length",r33_reconstruct_exact(kinds,values,book,7,out));
    c01_metric("alias.identical",r33_arrays_disjoint(data,data));
    c01_metric("alias.separate",r33_arrays_disjoint(data,out));
    lengths[0]=3;
    let frozen_lengths:[]i32=zalloc_i(1);let frozen_data:[]i32=zalloc_i(16);
    r33_exact_copy(lengths,frozen_lengths);r33_exact_copy(data,frozen_data);
    let reference:R33ChunkBook=R33ChunkBook{.lengths=frozen_lengths,.values=frozen_data,.count=1,.version=7};
    c01_metric("chunk.bound_exact",r33_reconstruct_bound(kinds,values,book,reference,out));
    c01_vector("chunk.bound_values",out,5);c01_fill(out,-777);
    data[1]=99;
    c01_metric("chunk.same_version_mutation",r33_reconstruct_bound(kinds,values,book,reference,out));
    c01_vector("chunk.bound_reject_after",out,5);data[1]=20;
    data[0]=30;data[2]=10;
    c01_metric("chunk.same_version_reorder",r33_reconstruct_bound(kinds,values,book,reference,out));
    data[0]=10;data[2]=30;
    c01_metric("chunk.reference_alias",r33_reconstruct_bound(kinds,values,book,book,out));
    c01_metric("chunk.reference_output_alias",r33_reconstruct_bound(kinds,values,book,reference,frozen_data));
    c01_vector("chunk.reference_after",frozen_data,3);
    zfree(frozen_lengths);zfree(frozen_data);
    zfree(lengths);zfree(data);zfree(kinds);zfree(values);zfree(out);zfree(short);

    let state:[]i32=zalloc_i(3);state[0]=10;state[1]=0;state[2]=0;
    let log:[]i32=zalloc_i(10);c01_fill(log,-777);
    c01_metric("trace.first",r33_commit_logged(state,log,0,20));
    c01_metric("trace.stale",r33_commit_logged(state,log,0,999));
    c01_vector("trace.after_stale",state,3);
    c01_metric("trace.second",r33_commit_logged(state,log,1,30));
    c01_metric("trace.full_refusal",r33_commit_logged(state,log,2,999));
    c01_vector("trace.after_full",state,3);c01_vector("trace.log",log,10);
    log[9]=3;c01_metric("trace.corrupt_last",r33_commit_logged(state,log,2,777));
    c01_vector("trace.after_corruption_refusal",state,3);log[9]=2;
    log[1]=99;c01_metric("trace.corrupt_first_parent",r33_commit_logged(state,log,2,777));log[1]=0;
    log[7]=99;c01_metric("trace.corrupt_chain",r33_commit_logged(state,log,2,777));log[7]=20;
    log[5]=99;c01_metric("trace.corrupt_event",r33_commit_logged(state,log,2,777));log[5]=2;
    c01_vector("trace.after_chain_refusals",state,3);
    let malformed:[]i32=zalloc_i(9);
    c01_metric("trace.bad_shape",r33_commit_logged(state,malformed,2,777));zfree(malformed);
    let empty:[]i32=zalloc_i(0);state[2]=0;
    c01_metric("trace.empty_refusal",r33_commit_logged(state,empty,2,888));
    c01_vector("trace.after_empty",state,3);
    state[1]=2147483647;
    c01_metric("trace.version_overflow",r33_commit_logged(state,empty,2147483647,777));
    c01_vector("trace.after_version_refusal",state,3);
    zfree(state);zfree(log);zfree(empty);
}

fn c01_capacity_edges()void {
    let samples:[]i32=zalloc_i(2);samples[0]=-32768;samples[1]=32767;
    let small:[]i32=zalloc_i(3);let exact:[]i32=zalloc_i(4);let large:[]i32=zalloc_i(5);
    c01_fill(small,-777);c01_fill(exact,-777);c01_fill(large,-777);
    c01_metric("edge.encode_small",r33_pcm16le_encode(samples,small));
    c01_vector("edge.encode_small_after",small,3);
    c01_metric("edge.encode_exact",r33_pcm16le_encode(samples,exact));
    c01_metric("edge.encode_large",r33_pcm16le_encode(samples,large));
    c01_vector("edge.encode_exact_after",exact,4);c01_vector("edge.encode_large_after",large,5);
    c01_fill(small,-777);
    c01_metric("edge.decode_large",r33_pcm16le_decode(exact,small,1,48000));
    c01_vector("edge.decode_large_after",small,3);
    c01_fill(large,-777);
    c01_metric("edge.copy_large",r33_exact_copy(exact,large));c01_vector("edge.copy_large_after",large,5);
    let rgb:[]i32=zalloc_i(3);rgb[0]=1;rgb[1]=2;rgb[2]=3;
    let rgb_small:[]i32=zalloc_i(2);c01_fill(rgb_small,-777);c01_fill(exact,-777);
    c01_metric("edge.rgb_small",r33_rgb8_ingest(rgb,rgb_small,1,1));
    c01_vector("edge.rgb_small_after",rgb_small,2);
    c01_metric("edge.rgb_large",r33_rgb8_ingest(rgb,exact,1,1));
    c01_vector("edge.rgb_large_after",exact,4);
    let lengths:[]i32=zalloc_i(0);let data:[]i32=zalloc_i(0);let kinds:[]i32=zalloc_i(2);
    let empty_book:R33ChunkBook=R33ChunkBook{.lengths=lengths,.values=data,.count=0,.version=1};
    c01_fill(small,-777);
    c01_metric("edge.literal_large",r33_reconstruct_exact(kinds,samples,empty_book,1,small));
    c01_vector("edge.literal_large_after",small,3);
    zfree(samples);zfree(small);zfree(exact);zfree(large);zfree(rgb);zfree(rgb_small);
    zfree(lengths);zfree(data);zfree(kinds);
}

fn main()i32 {
    c01_audio();c01_raw_vision();c01_order_lru();c01_chunk_trace();c01_capacity_edges();
    c01_metric("audit.completed",1);return 0;
}

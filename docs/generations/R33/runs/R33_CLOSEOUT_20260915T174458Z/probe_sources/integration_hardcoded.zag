// Engineering packet source is freshly authored by N17, never canonical R27.
@import("tests.zag")
@import("../R33_NATIVE_N17_R27_CONTINUITY/r33_continuing_learner_checkpoint_v1.zag")

fn ld_parent(p:[]u8)i32 {return ns_sha256("LANE_D_N17_ENGINEERING_PACKET_NOT_CANONICAL_R27",p);}
fn ld_packet(p:[]u8)i32 {
    let root:i64=cl_root("Research/R33_CONTINUING_LIFE_V1/LANE_D_20260915/PACKET_RUNTIME");if(root<0 || cl_is_status(root)==1){return cl_io();}
    let n:i32=cl_file_read(root,"learner-packet.bin",p);nio_close(root);
    if(n!=245536 || r33cla1_check(p)!=0){return cl_corrupt();}return 0;
}
fn ld_build(out:[]u8)i32 {
    let packet:[]u8=nio_alloc(245536);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    let world:[]u8=nio_alloc(96);let ingress:[]u8=nio_alloc(16);let tag:[]u8=nio_alloc(4);
    if(ld_packet(packet)!=0){return cl_corrupt();}ld_parent(parent);cw_init(world,1717);
    let a:CWOutcome=cw_step(world,1);let b:CWOutcome=cw_step(world,4);
    let s:CLStream=CLStream{.source=1,.clock=1,.sequence=3,.tick=2000};cl_stream_save(&s,ingress);
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);if(rc!=0){return rc;}
    let at:i32=112;
    rc=cl_checkpoint_section(out,&at,1,packet);if(rc!=0){return rc;}
    let id:i32=2;while(id<=10){cl_put(tag,0,id as i64);rc=cl_checkpoint_section(out,&at,id,tag);if(rc!=0){return rc;}id=id+1;}
    rc=cl_checkpoint_section(out,&at,11,world);if(rc!=0){return rc;}
    rc=cl_checkpoint_section(out,&at,12,ingress);if(rc!=0){return rc;}
    let n:i32=cl_checkpoint_finish(out,at);
    nio_free(packet);nio_free(parent);nio_free(previous);nio_free(world);nio_free(ingress);nio_free(tag);return n;
}
// Validate inner integrity before copying ANY world, ingress, or packet bytes
// into caller-visible output. Outer loader already stages its own transaction.
fn ld_commit(root:i64,b:[]u8)i32 {
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ld_parent(parent);
    let rc:i32=cl_checkpoint_check(b,parent,previous,1);
    if(rc==0 && r33cla1_check(cl_checkpoint_get(b,1))!=0){rc=cl_corrupt();}
    if(rc==0){rc=cl_checkpoint_commit(root,b,parent,previous,1);}
    nio_free(parent);nio_free(previous);return rc;
}
fn ld_load(root:i64,out:[]u8)i32 {
    let stage:[]u8=nio_alloc(out.len);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ld_parent(parent);
    let n:i32=cl_checkpoint_load(root,1,parent,previous,stage);
    if(n<0 || cl_is_status(n)==1){nio_free(stage);nio_free(parent);nio_free(previous);return n;}
    if(n<245536){nio_free(stage);nio_free(parent);nio_free(previous);return cl_corrupt();}
    let packet:[]u8=cl_checkpoint_get(stage[0..n],1);
    if(r33cla1_check(packet)!=0 || cl_checkpoint_get(stage[0..n],11).len!=96 || cl_checkpoint_get(stage[0..n],12).len!=16){nio_free(stage);nio_free(parent);nio_free(previous);return cl_corrupt();}
    cl_copy(out[0..n],stage[0..n]);nio_free(stage);nio_free(parent);nio_free(previous);return n;
}
fn ld_write(root:i64,mode:[]u8)i32 {
    let out:[]u8=nio_alloc(300000);let n:i32=ld_build(out);let f:i32=cl_check("packet_checkpoint_bytes",n,245924);
    if(n!=245924){return 1;}
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ld_parent(parent);
    if(nio_equal(mode,"write")==1){f=f+cl_check("packet_outer_commit",ld_commit(root,out[0..n]),0);}
    if(nio_equal(mode,"corrupt")==1){out[120+500]=out[120+500]^1;f=f+cl_check("outer_corrupt_commit_refused",ld_commit(root,out[0..n]),cl_corrupt());f=f+cl_check("corrupt_fixture_write",cl_file_write(root,"checkpoint-1.bin",out[0..n]),0);}
    if(nio_equal(mode,"inner")==1){
        out[120+500]=out[120+500]^1;
        f=f+cl_check("resigned_outer_finish",cl_checkpoint_finish(out,n-32),n);
        f=f+cl_check("resigned_outer_valid",cl_checkpoint_check(out[0..n],parent,previous,1),0);
        f=f+cl_check("resigned_inner_invalid",r33cla1_check(out[120..120+245536]),-1);
        f=f+cl_check("inner_corrupt_commit_refused",ld_commit(root,out[0..n]),cl_corrupt());
        f=f+cl_check("inner_fixture_write",cl_file_write(root,"checkpoint-1.bin",out[0..n]),0);
    }
    if(nio_equal(mode,"torn")==1){f=f+cl_check("torn_fixture_write",cl_file_write(root,"checkpoint-1.bin",out[0..n/2]),0);}
    nio_free(out);nio_free(parent);nio_free(previous);return (f!=0) as i32;
}
fn ld_read(root:i64,refuse:i32)i32 {
    let out:[]u8=nio_alloc(300000);let before:[]u8=nio_alloc(300000);let expected:[]u8=nio_alloc(300000);
    let i:i32=0;while(i<out.len){out[i]=165;i=i+1;}cl_copy(before,out);
    let n:i32=ld_load(root,out);let f:i32=0;
    _zag_print("LANE_D_LOAD_RC,");cl_number(n as i64);_zag_println("");
    if(refuse==1){f=f+cl_check("bad_packet_transaction_refused",cl_is_status(n),1);f=f+cl_check("refusal_preserves_entire_output",nio_equal(out,before),1);}
    else{
        f=f+cl_check("fresh_packet_outer_load",n,245924);
        if(n==245924){
            let e:i32=ld_build(expected);f=f+cl_check("fresh_expected_build",e,n);
            f=f+cl_check("fresh_exact_entire_checkpoint",nio_equal(out[0..n],expected[0..e]),1);
            let packet:[]u8=cl_checkpoint_get(out[0..n],1);let source:[]u8=nio_alloc(245536);ld_packet(source);
            f=f+cl_check("fresh_exact_complete_packet",nio_equal(packet,source),1);f=f+cl_check("fresh_inner_valid",r33cla1_check(packet),0);
            let image:[]u8=r33cla1_extract(packet);let credit:[]u8=r27i4_get(image,32);
            f=f+cl_check("pending_credit_section_bytes",credit.len,48);
            f=f+cl_check("pending_credit_exact",nio_equal(credit,r27i4_get(r33cla1_extract(source),32)),1);
            let active:i32=0;r27s4_get_i32(credit,16,&active);f=f+cl_check("pending_credit_active",active,1);
            let world:[]u8=cl_checkpoint_get(out[0..n],11);f=f+cl_check("world_pending_retained",cl_u32(world,44),2);
            let pristine:[]u8=nio_alloc(96);cw_init(pristine,1717);let a:CWOutcome=cw_step(pristine,1);let b:CWOutcome=cw_step(pristine,4);
            let resumed:[]u8=nio_alloc(96);cl_copy(resumed,world);i=0;
            while(i<3){let x:CWOutcome=cw_step(pristine,0);let y:CWOutcome=cw_step(resumed,0);f=f+cl_check("delayed_state_continuation",nio_equal(pristine,resumed),1);f=f+cl_check("delayed_outcome_continuation",x.value,y.value);i=i+1;}
            f=f+cl_check("ingress_exact_retained",nio_equal(cl_checkpoint_get(out[0..n],12),cl_checkpoint_get(expected[0..e],12)),1);
            nio_free(source);nio_free(pristine);nio_free(resumed);
        }
    }
    nio_free(out);nio_free(before);nio_free(expected);return (f!=0) as i32;
}
fn main()i32 {
    if(_zag_argc()!=3){return 64;}let mode:[]u8=_zag_arg(1);
    if(nio_equal(mode,"learn")==1){_zag_println("CL_REFUSED_R27_BEHAVIORAL_RUNTIME_PENDING");return 65;}
    let root:i64=cl_root(_zag_arg(2));if(root<0 || cl_is_status(root)==1){return 70;}
    let rc:i32=64;
    if(nio_equal(mode,"write")==1 || nio_equal(mode,"corrupt")==1 || nio_equal(mode,"inner")==1 || nio_equal(mode,"torn")==1){rc=ld_write(root,mode);}
    if(nio_equal(mode,"reload")==1){rc=ld_read(root,0);}if(nio_equal(mode,"refuse")==1){rc=ld_read(root,1);}
    nio_close(root);let usage:CLUsage=cl_usage();_zag_print("LANE_D_USAGE,");cl_number(usage.status as i64);_zag_print(",");cl_number(usage.cpu_us);_zag_print(",");cl_number(usage.rss_bytes);_zag_println("");
    if(usage.status!=0 || usage.rss_bytes<=0 || usage.rss_bytes>67108864 || usage.cpu_us<0){return 71;}return rc;
}

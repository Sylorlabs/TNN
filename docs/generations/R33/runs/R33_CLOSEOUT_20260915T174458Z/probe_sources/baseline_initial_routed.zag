@import("tests.zag")
@import("../R33_NATIVE_PROCESS_V3.zag")

fn ct_root_path()[]u8 {return "Research/R33_CLOSEOUT_20260915T174458Z/runtime/baseline";}
fn ct_binary()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_CLOSEOUT_20260915T174458Z/bin/baseline";}
fn ct_unit()i32 {
    let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 70;}
    let f:i32=ct_observation()+ct_world()+ct_checkpoint_unit()+ct_path_tests(root);nio_close(root);
    let usage:CLUsage=cl_usage();f=f+cl_check("usage_status",usage.status,0);f=f+cl_check("observed_rss_positive",(usage.rss_bytes>0) as i32,1);f=f+cl_check("observed_cpu_nonnegative",(usage.cpu_us>=0) as i32,1);
    _zag_print("CL_UNIT_FAILURES,");cl_number(f);_zag_println("");return (f!=0) as i32;
}
fn ct_write()i32 {
    let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 71;}
    let w:[]u8=nio_alloc(96);cw_init(w,1717);let a:CWOutcome=cw_step(w,1);let b:CWOutcome=cw_step(w,4);
    let data:[]u8=nio_alloc(4096);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ns_sha256("ENGINEERING_FIXTURE_NOT_R27",parent);
    let n:i32=ct_checkpoint(data,w,parent,previous,1);let f:i32=cl_check("writer_encode",(n>0) as i32,1);
    if(n>0){f=f+cl_check("writer_commit",cl_checkpoint_commit(root,data[0..n],parent,previous,1),0);f=f+cl_check("writer_pending_action",cl_u32(w,44),2);}
    nio_close(root);nio_free(w);nio_free(data);nio_free(parent);nio_free(previous);return (f!=0) as i32;
}
fn ct_reload()i32 {
    let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 72;}
    let data:[]u8=nio_alloc(4096);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ns_sha256("ENGINEERING_FIXTURE_NOT_R27",parent);
    let n:i32=cl_checkpoint_load(root,1,parent,previous,data);let f:i32=cl_check("fresh_process_load",(n>0) as i32,1);
    if(n>0){let w:[]u8=cl_checkpoint_get(data[0..n],11);f=f+cl_check("pending_after_process_restart",cl_u32(w,44),2);
        let pristine:[]u8=nio_alloc(96);cw_init(pristine,1717);let a:CWOutcome=cw_step(pristine,1);let b:CWOutcome=cw_step(pristine,4);
        f=f+cl_check("entire_world_reconstructed",nio_equal(w,pristine),1);
        let resumed:[]u8=nio_alloc(96);cl_copy(resumed,w);let i:i32=0;
        while(i<3){let x:CWOutcome=cw_step(pristine,0);let y:CWOutcome=cw_step(resumed,0);f=f+cl_check("fresh_process_continuation_state",nio_equal(pristine,resumed),1);f=f+cl_check("fresh_process_continuation_outcome",x.value,y.value);i=i+1;}
        f=f+cl_check("recovery_does_not_mutate_checkpoint",cl_checkpoint_check(data[0..n],parent,previous,1),0);
        nio_free(pristine);nio_free(resumed);}
    nio_close(root);nio_free(data);nio_free(parent);nio_free(previous);return (f!=0) as i32;
}
fn ct_torn()i32 {
    let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 73;}
    let data:[]u8=nio_alloc(4096);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ns_sha256("ENGINEERING_FIXTURE_NOT_R27",parent);
    let n:i32=cl_checkpoint_load(root,1,parent,previous,data);if(n<0){return 74;}cl_copy(previous,data[n-32..n]);
    let w:[]u8=nio_alloc(96);cl_copy(w,cl_checkpoint_get(data[0..n],11));let next:i32=ct_checkpoint(data,w,parent,previous,2);if(next<1){return 75;}
    if(cl_file_write(root,"checkpoint-2.bin",data[0..next/2])!=0){return 77;}
    _zag_println("CL_CRASH_AFTER_PARTIAL_CHECKPOINT_BEFORE_PUBLICATION");_zag_exit(73);return 73;
}
fn ct_torn_refusal()i32 {
    let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 78;}
    let data:[]u8=nio_alloc(4096);let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);ns_sha256("ENGINEERING_FIXTURE_NOT_R27",parent);
    let n:i32=cl_checkpoint_load(root,1,parent,previous,data);let f:i32=cl_check("prior_commit_survives",(n>0) as i32,1);
    if(n>0){cl_copy(previous,data[n-32..n]);let before:[]u8=nio_alloc(4096);cl_copy(before,data);
    let bad:i32=cl_checkpoint_load(root,2,parent,previous,data);f=f+cl_check("torn_latest_is_refused",bad,cl_bad());f=f+cl_check("failed_reload_no_mutation",nio_equal(before,data),1);nio_free(before);}
    nio_close(root);nio_free(data);nio_free(parent);nio_free(previous);return (f!=0) as i32;
}
fn ct_run(root:i64,mode:[]u8,label:[]u8,expected:i32)i32 {
    let r:NativeRunV3=nrv3_run(root,ct_binary(),mode,label,10000,65536);
    let f:i32=cl_check(label,r.exit_code,expected);f=f+cl_check("supervisor_status",r.status,0);f=f+cl_check("reaped",r.reaped,1);f=f+cl_check("signal",r.signal,0);
    f=f+cl_check("rss_under_64MiB",(r.peak_rss>0 && r.peak_rss<=67108864) as i32,1);
    _zag_print("CL_RESOURCE,");_zag_print(label);_zag_print(",");cl_number(r.cpu_us);_zag_print(",");cl_number(r.peak_rss);_zag_print(",");cl_number(r.stdout_bytes);_zag_print(",");cl_number(r.stderr_bytes);_zag_println("");return f;
}
fn ct_supervise()i32 {
    if(nio_mkdir(ct_root_path())!=0){return 80;}let root:i64=cl_root(ct_root_path());if(root<0 || cl_is_status(root)==1){return 81;}
    let f:i32=ct_run(root,"unit","unit",0);
    f=f+ct_run(root,"write","write",0);f=f+ct_run(root,"reload","reload",0);
    f=f+ct_run(root,"torn","torn",73);f=f+ct_run(root,"torn-refusal","torn-refusal",0);
    _zag_print("CL_ENGINEERING_FAILURES,");cl_number(f);_zag_println("");
    let result:[]u8="{\"identity\":\"CL-ENGINEERING-01\",\"passed\":false,\"training\":false,\"r27_continuity\":false}\n";
    if(f==0){result="{\"identity\":\"CL-ENGINEERING-01\",\"passed\":true,\"children\":5,\"training\":false,\"r27_continuity\":false}\n";}
    let rc:i32=cl_file_write(root,"result.json",result);nio_close(root);if(rc!=0){return 82;}return (f!=0) as i32;
}
fn main()i32 {
    if(_zag_argc()!=2){return 64;}let mode:[]u8=_zag_arg(1);
    if(nio_equal(mode,"supervise")==1){return ct_supervise();}if(nio_equal(mode,"unit")==1){return ct_unit();}
    if(nio_equal(mode,"write")==1){return ct_write();}if(nio_equal(mode,"reload")==1){return ct_reload();}
    if(nio_equal(mode,"torn")==1){return ct_torn();}if(nio_equal(mode,"torn-refusal")==1){return ct_torn_refusal();}
    if(nio_equal(mode,"learn")==1){_zag_println("CL_REFUSED_R27_BEHAVIORAL_RUNTIME_PENDING");return 65;}return 64;
}

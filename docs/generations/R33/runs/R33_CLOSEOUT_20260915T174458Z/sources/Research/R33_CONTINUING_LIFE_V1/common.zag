// Shared bounded wire operations. No learner, evaluator or legacy execution.
@import("../R33_NATIVE_SHA256_V2.zag")

const CL_BAD:i32=2001;
const CL_BOUND:i32=2002;
const CL_PATH:i32=2003;
const CL_IO:i32=2004;
const CL_CORRUPT:i32=2005;
const CL_CAPACITY:i32=2006;
const CL_PARENT_PENDING:i32=2007;
const CL_ABI:i32=2008;
const CL_MAX:i32=1048576;

fn cl_bad()i32 {return 2001;}
fn cl_bound()i32 {return 2002;}
fn cl_path()i32 {return 2003;}
fn cl_io()i32 {return 2004;}
fn cl_corrupt()i32 {return 2005;}
fn cl_capacity()i32 {return 2006;}
fn cl_parent_pending()i32 {return 2007;}
fn cl_abi()i32 {return 2008;}
fn cl_max()i32 {return 1048576;}
fn cl_is_status(v:i64)i32 {return (v>=2001 && v<=2008) as i32;}

fn cl_copy(out:[]u8,input:[]u8)i32 {
    if(out.len!=input.len){return cl_bad();}
    let i:i32=0;while(i<input.len){out[i]=input[i];i=i+1;}return 0;
}
fn cl_u32(b:[]u8,at:i32)i64 {
    if(at<0 || b.len<4 || at>b.len-4){return -1;}
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn cl_put(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || b.len<4 || at>b.len-4 || v<0 || v>4294967295){return cl_bad();}
    let i:i32=0;while(i<4){b[at+i]=((v>>(i*8)) & 255) as u8;i=i+1;}return 0;
}
fn cl_zero(b:[]u8)i32 {let i:i32=0;while(i<b.len){if(b[i]!=0){return 0;}i=i+1;}return 1;}
fn cl_hash_is(b:[]u8,h:[]u8)i32 {
    if(h.len!=32){return 0;}let out:[]u8=nio_alloc(32);if(out.len!=32){return 0;}
    let ok:i32=(ns_sha256(b,out)==0 && nio_equal(out,h)==1) as i32;nio_free(out);return ok;
}
fn cl_number(x:i64)void {let s:[]u8=_zag_i64_to_str(x);_zag_print(s);nio_free(s);}
fn cl_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("CL_CHECK,");_zag_print(name);_zag_print(",");cl_number(actual as i64);_zag_print(",");cl_number(expected as i64);_zag_println("");return (actual!=expected) as i32;
}
fn cl_check64(name:[]u8,actual:i64,expected:i64)i32 {
    _zag_print("CL_CHECK,");_zag_print(name);_zag_print(",");cl_number(actual);_zag_print(",");cl_number(expected);_zag_println("");return (actual!=expected) as i32;
}
fn cl_disjoint(a:[]u8,b:[]u8)i32 {
    if(a.len==0 || b.len==0){return 1;}
    let x:i64=_zag_slice_ptr(a) as i64;let y:i64=_zag_slice_ptr(b) as i64;
    return (x+(a.len as i64)<=y || y+(b.len as i64)<=x) as i32;
}

@import("r23_blake2b64_person_v1.zag")
@import("r25_mt19937_v1.zag")
const V91_ROWS:i32=4248;const V91_EXTRA:i32=2200;const V91_COND:i32=42;const V91_KAT:i32=16;const V91_PERSON:[]u8="tnn-r23";const V91_SHAPE:i32=-29102;const V91_RNG:i32=-29104;
struct V91Row {a:i32,o:i32,l:i32,bad:i32,act:i32,kind:i32,form:i32,}
fn v91_name(i:i32)[]u8 @noalloc {if(i==0){return "ana";}if(i==1){return "jon";}if(i==2){return "mira";}if(i==3){return "sam";}if(i==4){return "lena";}if(i==5){return "ravi";}if(i==6){return "nora";}if(i==7){return "omar";}return "";}
fn v91_object(i:i32)[]u8 @noalloc {if(i==0){return "book";}if(i==1){return "cup";}if(i==2){return "notebook";}if(i==3){return "glass";}if(i==4){return "report";}if(i==5){return "key";}if(i==6){return "phone";}if(i==7){return "folder";}return "";}
fn v91_loc(i:i32)[]u8 @noalloc {if(i==0){return "desk";}if(i==1){return "drawer";}if(i==2){return "bag";}if(i==3){return "shelf";}if(i==4){return "table";}if(i==5){return "box";}if(i==6){return "room";}if(i==7){return "cabinet";}return "";}
fn v91_motive(i:i32)[]u8 @noalloc {if(i==0){return "falling";}if(i==1){return "breaking";}if(i==2){return "getting wet";}if(i==3){return "being lost";}if(i==4){return "being late";}if(i==5){return "making noise";}return "";}
fn v91_action(i:i32)[]u8 @noalloc {if(i==0){return "moved";}if(i==1){return "placed";}if(i==2){return "carried";}if(i==3){return "left";}if(i==4){return "returned";}if(i==5){return "sent";}if(i==6){return "put";}if(i==7){return "brought";}return "";}
fn v91_kind(i:i32)[]u8 @noalloc {if(i==0){return "location";}if(i==1){return "motive";}if(i==2){return "belief";}if(i==3){return "promise";}return "";}
fn v91_hex(x:i32)u8 @noalloc {if(x<10){return (48+x) as u8;}return (87+x) as u8;}
fn v91_put(out:[]u8,at:*i32,c:u8)i32 @noalloc {if(at==null as *i32||at.*<0||at.*>=out.len){return V91_SHAPE;}out[at.*]=c;at.*=at.*+1;return 0;}
fn v91_repr_str(s:[]u8,out:[]u8,at:*i32)i32 @noalloc {if(at==null as *i32){return V91_SHAPE;}let sq:i32=0;let dq:i32=0;let i:i32=0;while(i<s.len){if((s[i] as i32)>127){return V91_SHAPE;}if(s[i]==39){sq=sq+1;}if(s[i]==34){dq=dq+1;}i=i+1;}let q:u8=39;if(sq>0&&dq==0){q=34;}if(v91_put(out,at,q)!=0){return V91_SHAPE;}i=0;while(i<s.len){let c:i32=s[i] as i32;if(c==92||c==(q as i32)){if(v91_put(out,at,92)!=0||v91_put(out,at,c as u8)!=0){return V91_SHAPE;}}else if(c==9){if(v91_put(out,at,92)!=0||v91_put(out,at,116)!=0){return V91_SHAPE;}}else if(c==10){if(v91_put(out,at,92)!=0||v91_put(out,at,110)!=0){return V91_SHAPE;}}else if(c==13){if(v91_put(out,at,92)!=0||v91_put(out,at,114)!=0){return V91_SHAPE;}}else if(c>=32&&c<=126){if(v91_put(out,at,c as u8)!=0){return V91_SHAPE;}}else{if(v91_put(out,at,92)!=0||v91_put(out,at,120)!=0||v91_put(out,at,v91_hex((c>>4)&15))!=0||v91_put(out,at,v91_hex(c&15))!=0){return V91_SHAPE;}}i=i+1;}return v91_put(out,at,q);}
fn v91_repr_part(s:[]u8,out:[]u8,at:*i32)i32 @noalloc {let rc:i32=v91_repr_str(s,out,at);if(rc!=0){return rc;}return v91_put(out,at,0);}
fn v91_stable5(a:[]u8,b:[]u8,c:[]u8,d:[]u8,e:[]u8,tmp:[]u8,dig:[]u8,v:[]u64,m:[]u64,out:*u64)i32 @noalloc {if(tmp.len<128||dig.len!=8||v.len!=16||m.len!=16||out==null as *u64){return V91_SHAPE;}let at:i32=0;if(v91_repr_part(a,tmp,&at)!=0||v91_repr_part(b,tmp,&at)!=0||v91_repr_part(c,tmp,&at)!=0||v91_repr_part(d,tmp,&at)!=0||v91_repr_part(e,tmp,&at)!=0){return V91_SHAPE;}return r23b2p1_u64(tmp[0..at],V91_PERSON,v,m,dig,out);}
fn v91_build(rows:[]V91Row)i32 {if(rows.len!=V91_ROWS){return V91_SHAPE;}let rng:R25MT19937V1=r25mt_new();if(r25mt_seed_u32(&rng,23101)!=0){return V91_RNG;}let at:i32=0;let a:i32=0;while(a<8){let o:i32=0;while(o<8){let l:i32=0;while(l<8){let k:i32=0;while(k<4){let bad:i32=0;let act:i32=0;let form:i32=0;if(r25mt_choice_index(&rng,6,&bad)!=0||r25mt_choice_index(&rng,8,&act)!=0||r25mt_choice_index(&rng,4,&form)!=0){return V91_RNG;}rows[at]=V91Row{.a=a,.o=o,.l=l,.bad=bad,.act=act,.kind=k,.form=form};at=at+1;k=k+1;}l=l+1;}o=o+1;}a=a+1;}let x:i32=0;while(x<V91_EXTRA){let aa:i32=0;let oo:i32=0;let ll:i32=0;let bb:i32=0;let ac:i32=0;let kk:i32=0;let ff:i32=0;if(r25mt_choice_index(&rng,8,&aa)!=0||r25mt_choice_index(&rng,8,&oo)!=0||r25mt_choice_index(&rng,8,&ll)!=0||r25mt_choice_index(&rng,6,&bb)!=0||r25mt_choice_index(&rng,8,&ac)!=0||r25mt_choice_index(&rng,4,&kk)!=0||r25mt_choice_index(&rng,4,&ff)!=0){return V91_RNG;}rows[at]=V91Row{.a=aa,.o=oo,.l=ll,.bad=bb,.act=ac,.kind=kk,.form=ff};at=at+1;x=x+1;}return (at!=V91_ROWS) as i32;}
fn v91_shuffle(st:*R25MT19937V1,a:[]i32)i32 @noalloc {let i:i32=a.len-1;while(i>0){let j:i32=0;if(r25mt_randbelow(st,i+1,&j)!=0){return V91_RNG;}let z:i32=a[i];a[i]=a[j];a[j]=z;i=i-1;}return 0;}
fn v91_split(rows:[]V91Row,train:[]i32,test:[]i32,ntrain:*i32,ntest:*i32)i32 {if(rows.len!=V91_ROWS||train.len<V91_ROWS||test.len<V91_ROWS||ntrain==null as *i32||ntest==null as *i32){return V91_SHAPE;}let tmp:[]u8=v91_alloc_u8(128);let dig:[]u8=v91_alloc_u8(8);let v:[]u64=v91_alloc_u64(16);let m:[]u64=v91_alloc_u64(16);let tc:i32=0;let hc:i32=0;let i:i32=0;while(i<rows.len){let r:V91Row=rows[i];let h:u64=0;if(v91_stable5("r23hold",v91_name(r.a),v91_object(r.o),v91_loc(r.l),v91_kind(r.kind),tmp,dig,v,m,&h)!=0){return -29103;}if(h%7==0){test[hc]=i;hc=hc+1;}else{train[tc]=i;tc=tc+1;}i=i+1;}let sr:R25MT19937V1=r25mt_new();if(r25mt_seed_u32(&sr,23101)!=0){return V91_RNG;}if(v91_shuffle(&sr,train[0..tc])!=0||v91_shuffle(&sr,test[0..hc])!=0){return V91_RNG;}ntrain.*=tc;ntest.*=hc;return 0;}
fn v91_condition(r:V91Row,out:[]i32)i32 @noalloc {if(out.len!=42){return V91_SHAPE;}let i:i32=0;while(i<42){out[i]=0;i=i+1;}out[r.a]=1;out[8+r.o]=1;out[16+r.l]=1;out[24+r.bad]=1;out[30+r.act]=1;out[38+r.kind]=1;return 0;}
fn v91_expected_row(i:i32,r:V91Row)i32 @noalloc {if(i==0){return (r.a==4&&r.o==7&&r.bad==2&&r.kind==1) as i32;}if(i==1){return (r.a==0&&r.o==3&&r.bad==5&&r.kind==1) as i32;}if(i==2){return (r.a==7&&r.o==7&&r.l==0&&r.kind==2) as i32;}if(i==3){return (r.a==4&&r.o==0&&r.l==7&&r.kind==0) as i32;}if(i==4){return (r.a==5&&r.o==1&&r.l==3&&r.kind==3) as i32;}if(i==5){return (r.a==0&&r.o==1&&r.bad==0&&r.kind==1) as i32;}if(i==6){return (r.a==2&&r.o==2&&r.l==0&&r.kind==2) as i32;}if(i==7){return (r.a==5&&r.o==2&&r.bad==0&&r.kind==1) as i32;}if(i==8){return (r.a==0&&r.o==4&&r.l==4&&r.kind==2) as i32;}if(i==9){return (r.a==2&&r.o==2&&r.l==7&&r.kind==0) as i32;}if(i==10){return (r.a==7&&r.o==6&&r.l==1&&r.kind==3) as i32;}if(i==11){return (r.a==4&&r.o==1&&r.l==6&&r.kind==2) as i32;}if(i==12){return (r.a==6&&r.o==3&&r.l==0&&r.kind==2) as i32;}if(i==13){return (r.a==3&&r.o==0&&r.l==6&&r.kind==2) as i32;}if(i==14){return (r.a==1&&r.o==7&&r.l==2&&r.kind==2) as i32;}if(i==15){return (r.a==6&&r.o==3&&r.l==0&&r.kind==2) as i32;}return 0;}
fn v91_expected_naive(i:i32)[]u8 @noalloc {if(i==0){return "lena moved the key so it would not risk falling.";}if(i==1){return "ana acted because the folder might face being lost.";}if(i==2){return "jon thinks the folder is in the desk.";}if(i==3){return "lena left it in the desk.";}if(i==4){return "ravi promised to send the folder to the shelf.";}if(i==5){return "ana moved the glass so it would not risk falling.";}if(i==6){return "mira believes the folder is located in the room.";}if(i==7){return "ravi acted because the notebook might face breaking.";}if(i==8){return "ana thinks the book is in the shelf.";}if(i==9){return "mira put the notebook to the box.";}if(i==10){return "omar promised to send the glass to the box.";}if(i==11){return "sam carried the key to the shelf.";}if(i==12){return "nora thinks the glass is in the box.";}if(i==13){return "sam thinks the folder is in the room.";}if(i==14){return "jon believes the glass is located in the bag.";}if(i==15){return "nora believes the book is located in the desk.";}return "";}
fn v91_equal(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn v91_output_match(i:i32,got:[]u8)i32 @noalloc {if(i<0||i>=16){return 0;}return v91_equal(got,v91_expected_naive(i));}

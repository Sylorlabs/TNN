fn n19_emit(name:[]u8,rc:i32)void {
    // -1 is explicit missingness for values not observed by this case.
    _zag_print("N19_TELEMETRY,");_zag_print(name);_zag_print(",status,");n19_print_i64(rc as i64);
    // After the fixed envelope marker, emit exactly the 14 schema fields:
    // case_id, phase, status, detail, attempted, committed, sequence,
    // event_count, audit_head, resource_limit, resource_observed,
    // recovery_state, stdout_bytes, stderr_bytes.
    _zag_print(",0,-1,-1,-1,-1,-1,-1,-1,missing,-1,-1");_zag_println("");
}

fn n19_emit_state(name:[]u8,rc:i32,state:*N19State,attempted:i64,committed:i64)void {
    _zag_print("N19_TELEMETRY,");_zag_print(name);_zag_print(",status,");n19_print_i64(rc as i64);
    _zag_print(",0,");n19_print_i64(attempted);_zag_print(",");n19_print_i64(committed);
    _zag_print(",");n19_print_i64(state.*.sequence as i64);_zag_print(",");n19_print_i64(state.*.event_count as i64);
    _zag_print(",");n19_print_i64(state.*.audit_head as i64);
    _zag_print(",-1,-1,");
    if(rc!=N19_OK || state.*.poisoned==1){_zag_print("poisoned");}
    else if(state.*.recovered==1){_zag_print("recovered");}
    else{_zag_print("fresh");}
    _zag_println(",-1,-1");
}

fn n19_exit_ok(rc:i32)i32 {
    if(rc==N19_OK){return 0;}return 1;
}

fn n19_exit_expected(rc:i32,want:i32)i32 {
    if(rc==want){return 0;}return 1;

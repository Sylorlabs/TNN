    if(n19_append(&state,record)!=N19_REFUSED_RECOVERY || state.sequence!=1 || state.event_count!=1 || state.journal_bytes!=32 || state.audit_head!=1){failed=failed+1;}
    if(n19_recover_fd(-1,&state)!=N19_REFUSED_MALFORMED || state.poisoned!=1 || state.sequence!=1){failed=failed+1;}

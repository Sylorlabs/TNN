fn n19_append_existing_fixture(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;
    if(state.*.poisoned!=0){return N19_REFUSED_RECOVERY;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_append_existing_fixture_at(rootfd,leaf,state,attempted,committed);let closed:i32=n19_close(rootfd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_append_existing_fixture_at(rootfd:i64,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;
    if(state.*.poisoned!=0){return N19_REFUSED_RECOVERY;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,0);if(fd<0){return n19_recovery_refuse(state,fd as i32);}
    let prior:N19State=n19_empty_state();let recovered:i32=n19_recover_fd(fd,&prior);
    if(recovered!=N19_OK){n19_close(fd);return n19_recovery_refuse(state,recovered);}
    if(prior.sequence!=1 || prior.event_count!=1 || prior.journal_bytes!=N19_RECORD_BYTES || prior.audit_head!=1 || prior.recovered!=1){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let end:i64=n19_seek(fd,0,2);if(end<0){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    if(end!=N19_RECORD_BYTES){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    let rc0:i32=n19_encode(record,2,"native-append");if(rc0!=N19_OK){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,rc0);}
    attempted.*=N19_RECORD_BYTES;let written:i64=n19_write_all(fd,record);
    if(written!=N19_RECORD_BYTES){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    if(n19_sync(fd)!=0 || n19_sync(rootfd)!=0){n19_free(record);n19_close(fd);return n19_recovery_refuse(state,N19_REFUSED_IO);}
    let applied:i32=n19_append(&prior,record);n19_free(record);if(applied!=N19_OK){n19_close(fd);return n19_recovery_refuse(state,applied);}
    if(n19_close(fd)!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}
    prior.recovered=1;state.*=prior;committed.*=written;return N19_OK;
}

fn n19_case_io(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_write_fixture_at(rootfd,leaf,attempted,committed);
    if(rc==N19_OK){rc=n19_read_fixture_at(rootfd,leaf,state);}
    let closed:i32=n19_close(rootfd);if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

// One retained root for the entire write -> append -> recovery sequence.
// Fresh-process root identity is a separate admission concern, not this claim.
fn n19_case_retained_sequence(root:[]u8,leaf:[]u8,state:*N19State,attempted:*i64,committed:*i64)i32 {
    if(state==null as *N19State || attempted==null as *i64 || committed==null as *i64){return N19_REFUSED_MALFORMED;}
    attempted.*=0;committed.*=0;let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}
    let rc:i32=n19_write_fixture_at(rootfd,leaf,attempted,committed);
    if(rc==N19_OK){let next_attempted:i64=0;let next_committed:i64=0;
        rc=n19_append_existing_fixture_at(rootfd,leaf,state,&next_attempted,&next_committed);
        attempted.*=attempted.*+next_attempted;committed.*=committed.*+next_committed;}
    if(rc==N19_OK){rc=n19_read_fixture_at(rootfd,leaf,state);}
    if(rc==N19_OK && (state.*.sequence!=2 || state.*.event_count!=2 || state.*.journal_bytes!=64 || state.*.audit_head!=2 || state.*.recovered!=1 || state.*.poisoned!=0)){rc=n19_recovery_refuse(state,N19_REFUSED_RECOVERY);}
    let closed:i32=n19_close(rootfd);if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_probe_existing(root:[]u8,leaf:[]u8)i32 {

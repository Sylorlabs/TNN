fn n19_case_torn(root:[]u8,leaf:[]u8)i32 {
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return rootfd as i32;}let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){n19_close(rootfd);return fd as i32;}

    attempted.*=0;committed.*=0;
    let fd:i64=n19_open_regular_at(rootfd,leaf,1);if(fd<0){return fd as i32;}
    let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){n19_close(fd);return N19_REFUSED_IO;}
    let rc0:i32=n19_encode(record,1,"native-io");if(rc0!=N19_OK){n19_free(record);n19_close(fd);return rc0;}
    attempted.*=N19_RECORD_BYTES;let written:i64=n19_write_all(fd,record);n19_free(record);
    if(written!=N19_RECORD_BYTES){n19_close(fd);return N19_REFUSED_IO;}
    if(n19_sync(fd)!=0 || n19_sync(rootfd)!=0){n19_close(fd);return N19_REFUSED_IO;}
    if(n19_close(fd)!=N19_OK){return N19_REFUSED_IO;}committed.*=written;return N19_OK;
}

fn n19_read_fixture(root:[]u8,leaf:[]u8,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    let rootfd:i64=n19_open_root(root);if(rootfd<0){return n19_recovery_refuse(state,rootfd as i32);}
    let rc:i32=n19_read_fixture_at(rootfd,leaf,state);let closed:i32=n19_close(rootfd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;
}

fn n19_read_fixture_at(rootfd:i64,leaf:[]u8,state:*N19State)i32 {
    if(state==null as *N19State){return N19_REFUSED_MALFORMED;}
    let fd:i64=n19_open_regular_at(rootfd,leaf,0);if(fd<0){return n19_recovery_refuse(state,fd as i32);}
    let rc:i32=n19_recover_fd(fd,state);let closed:i32=n19_close(fd);
    if(closed!=N19_OK){return n19_recovery_refuse(state,N19_REFUSED_IO);}return rc;

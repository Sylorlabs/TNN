// Classification-only gate over adapter-owned errno mappings. Runtime fault
// fixtures below separately exercise real descriptors. This keeps the mapping
// contract falsifiable without pretending a synthetic errno is an OS event.
fn n19_case_error_classification()i32 {
    if(n19h_open_status(-2)!=N19_REFUSED_PATH){return N19_REFUSED_RECOVERY;}
    if(n19h_open_status(-22)!=N19_REFUSED_HOST_ABI){return N19_REFUSED_RECOVERY;}
    if(n19h_open_status(-5)!=N19_REFUSED_IO){return N19_REFUSED_RECOVERY;}
    if(n19h_io_status(-5)!=N19_REFUSED_IO){return N19_REFUSED_RECOVERY;}
    if(n19h_io_status(0)!=N19_OK){return N19_REFUSED_RECOVERY;}
    return N19_OK;
}

fn n19_emit_limit(rc:i32,configured:i64)void {
    _zag_print("N19_TELEMETRY,limit,status,");n19_print_i64(rc as i64);
    _zag_print(",0,-1,-1,-1,-1,-1,");n19_print_i64(configured);
    // No runtime usage meter is available in this bounded fixture. Missing
    // observation stays -1 and is never replaced by the configured ceiling.
    _zag_println(",-1,missing,-1,-1");
}


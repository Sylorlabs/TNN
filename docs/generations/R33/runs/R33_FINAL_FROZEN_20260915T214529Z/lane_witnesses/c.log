        if(kind==0){n19_put32(record,0,0);}if(kind==1){n19_put32(record,4,2);}
        if(kind==2){n19_put32(record,8,17);}if(kind==3){n19_put32(record,8,-1);}if(kind==4){record[12]=record[12]^1;}
        // Recompute checksum for structural attacks so checksum alone cannot hide a missing invariant.

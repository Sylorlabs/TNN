// R33-N17 native R27 digest reconstruction.
// Read-only over the custodied accepted parent. JSON float lexemes are bound
// to original-release scalar spellings; unknown binary64 values are refused.
@import("identity.zag")

struct R27Buf {data:[]u8,used:i32,status:i32}
struct R27JsonStats {floats:i32,int_key_dicts:i32}
fn r27_buf(cap:i32)R27Buf {let x:[]u8=nio_alloc(cap);let s:i32=0;if(x.len!=cap){s=-1;}return R27Buf{.data=x,.used=0,.status=s};}
fn r27_free(b:*R27Buf)void {nio_free(b.*.data);b.*.used=0;b.*.status=-1;}
fn r27_byte(b:*R27Buf,x:i32)void {if(b.*.status!=0){return;}if(x<0 || x>255 || b.*.used>=b.*.data.len){b.*.status=-2;return;}b.*.data[b.*.used]=x as u8;b.*.used=b.*.used+1;}
fn r27_add(b:*R27Buf,x:[]u8)void {if(b.*.status!=0){return;}if(b.*.used>b.*.data.len || x.len>b.*.data.len-b.*.used){b.*.status=-2;return;}let i:i32=0;while(i<x.len){b.*.data[b.*.used+i]=x[i];i=i+1;}b.*.used=b.*.used+x.len;}
fn r27_i64(b:*R27Buf,x:i64)void {let s:[]u8=_zag_i64_to_str(x);r27_add(b,s);nio_free(s);}
fn r27_cmp(a:[]u8,b:[]u8)i32 {let n:i32=a.len;if(b.len<n){n=b.len;}let i:i32=0;while(i<n){if(a[i]<b[i]){return -1;}if(a[i]>b[i]){return 1;}i=i+1;}if(a.len<b.len){return -1;}if(a.len>b.len){return 1;}return 0;}
fn r27_hex_equal(raw:[]u8,hex:[]u8)i32 {if(hex.len!=raw.len*2){return 0;}let i:i32=0;while(i<raw.len){let a:i64=ns_hex_digit(hex[i*2] as i32);let c:i64=ns_hex_digit(hex[i*2+1] as i32);if(a<0 || c<0 || a*16+c!=(raw[i] as i64)){return 0;}i=i+1;}return 1;}
fn r27_component(b:*R27Buf,label:[]u8,start:i32)void {if(b.*.status!=0 || start<0 || start>b.*.used){return;}let h:[]u8=nio_alloc(32);if(h.len!=32){b.*.status=-3;return;}if(ns_sha256(b.*.data[start..b.*.used],h)!=0){nio_free(h);b.*.status=-3;return;}let t:[]u8=ns_hex(h);nio_free(h);_zag_print("R27_COMPONENT,");_zag_print(label);_zag_print(",");let a:[]u8=_zag_i64_to_str(start as i64);_zag_print(a);nio_free(a);_zag_print(",");let z:[]u8=_zag_i64_to_str(b.*.used as i64);_zag_print(z);nio_free(z);_zag_print(",");_zag_println(t);nio_free(t);}
fn r27_collect(p:*ParentMap,id:i32,keys:[]i64,vals:[]i64)i32 {if(pm_kind(p,id)!=11 || keys.len!=vals.len){return -1;}let expected:i32=p.*.nodes[(id-1)*10+9] as i32;if(expected<0 || expected>keys.len){return -1;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;let seen:i32=0;while(e>0 && seen<=p.*.edge_count){if(e>p.*.edge_count){return -1;}let r:i32=(e-1)*4;if(p.*.edges[r+3]!=2 || n>=keys.len){return -1;}keys[n]=p.*.edges[r];vals[n]=p.*.edges[r+1];n=n+1;e=p.*.edges[r+2] as i32;seen=seen+1;}if(n!=expected){return -1;}return n;}
fn r27_sort_lex(p:*ParentMap,keys:[]i64,vals:[]i64,n:i32)i32 {if(n<0 || n>keys.len || vals.len<keys.len){return -1;}let gap:i32=n/2;while(gap>0){let i:i32=gap;while(i<n){let hk:i64=keys[i];let hv:i64=vals[i];let j:i32=i;while(j>=gap && r27_cmp(pm_raw(p,keys[j-gap] as i32),pm_raw(p,hk as i32))>0){keys[j]=keys[j-gap];vals[j]=vals[j-gap];j=j-gap;}keys[j]=hk;vals[j]=hv;i=i+1;}gap=gap/2;}return 0;}
fn r27_sort_int(p:*ParentMap,keys:[]i64,vals:[]i64,n:i32)i32 {if(n<0 || n>keys.len || vals.len<keys.len){return -1;}let gap:i32=n/2;while(gap>0){let i:i32=gap;while(i<n){let hk:i64=keys[i];let hv:i64=vals[i];let h:i64=0;if(pm_small_int(p,hk as i32,&h)!=0){return -1;}let j:i32=i;let keep:i32=1;while(j>=gap && keep==1){let q:i64=0;if(pm_small_int(p,keys[j-gap] as i32,&q)!=0){return -1;}if(q<=h){keep=0;}else{keys[j]=keys[j-gap];vals[j]=vals[j-gap];j=j-gap;}}keys[j]=hk;vals[j]=hv;i=i+1;}gap=gap/2;}return 0;}
fn r27_json_string(b:*R27Buf,s:[]u8)void {r27_byte(b,34);let d:[]u8="0123456789abcdef";let i:i32=0;while(i<s.len && b.*.status==0){let c:i32=s[i] as i32;if(c>=128){b.*.status=-20;return;}if(c==34 || c==92){r27_byte(b,92);r27_byte(b,c);}else if(c==8){r27_add(b,"\\b");}else if(c==9){r27_add(b,"\\t");}else if(c==10){r27_add(b,"\\n");}else if(c==12){r27_add(b,"\\f");}else if(c==13){r27_add(b,"\\r");}else if(c<32){r27_add(b,"\\u00");r27_byte(b,d[c/16] as i32);r27_byte(b,d[c%16] as i32);}else{r27_byte(b,c);}i=i+1;}r27_byte(b,34);}
fn r27_float_token(raw:[]u8)[]u8 {
    if(raw.len!=8){return "";}
    if(r27_hex_equal(raw,"bf9dddddddddde00")==1){return "-0.029166666666666785";}if(r27_hex_equal(raw,"bfa0000000000000")==1){return "-0.03125";}if(r27_hex_equal(raw,"bfa1111111111120")==1){return "-0.03333333333333344";}
    if(r27_hex_equal(raw,"0000000000000000")==1){return "0.0";}if(r27_hex_equal(raw,"3fc1c71c71c71c72")==1){return "0.1388888888888889";}if(r27_hex_equal(raw,"3fc3333333333333")==1){return "0.15";}if(r27_hex_equal(raw,"3fc5555555555555")==1){return "0.16666666666666666";}if(r27_hex_equal(raw,"3fd0000000000000")==1){return "0.25";}
    if(r27_hex_equal(raw,"3fd38e38e38e38e3")==1){return "0.3055555555555555";}if(r27_hex_equal(raw,"3fd38e38e38e38e4")==1){return "0.3055555555555556";}if(r27_hex_equal(raw,"3fd5555555555555")==1){return "0.3333333333333333";}if(r27_hex_equal(raw,"3fd5555555555556")==1){return "0.33333333333333337";}if(r27_hex_equal(raw,"3fd999999999999a")==1){return "0.4";}if(r27_hex_equal(raw,"3fdaaaaaaaaaaaab")==1){return "0.4166666666666667";}if(r27_hex_equal(raw,"3fdc71c71c71c71c")==1){return "0.4444444444444444";}
    if(r27_hex_equal(raw,"3fe0000000000000")==1){return "0.5";}if(r27_hex_equal(raw,"3fe2000000000000")==1){return "0.5625";}if(r27_hex_equal(raw,"3fe2aaaaaaaaaaab")==1){return "0.5833333333333334";}if(r27_hex_equal(raw,"3fe3333333333333")==1){return "0.6";}if(r27_hex_equal(raw,"3fe38e38e38e38e4")==1){return "0.6111111111111112";}if(r27_hex_equal(raw,"3fe3e93e93e93e94")==1){return "0.6222222222222222";}if(r27_hex_equal(raw,"3fe49f49f49f49f5")==1){return "0.6444444444444445";}if(r27_hex_equal(raw,"3fe4aaaaaaaaaaab")==1){return "0.6458333333333334";}if(r27_hex_equal(raw,"3fe4bda12f684bda")==1){return "0.6481481481481481";}if(r27_hex_equal(raw,"3fe4cccccccccccd")==1){return "0.65";}if(r27_hex_equal(raw,"3fe5555555555555")==1){return "0.6666666666666666";}if(r27_hex_equal(raw,"3fe5555555555556")==1){return "0.6666666666666667";}if(r27_hex_equal(raw,"3fe5ed097b425ed1")==1){return "0.6851851851851852";}if(r27_hex_equal(raw,"3fe6c16c16c16c17")==1){return "0.7111111111111111";}if(r27_hex_equal(raw,"3fe7777777777777")==1){return "0.7333333333333333";}if(r27_hex_equal(raw,"3fe7b05b05b05b07")==1){return "0.7402777777777779";}if(r27_hex_equal(raw,"3fe8000000000000")==1){return "0.75";}if(r27_hex_equal(raw,"3fe8888888888889")==1){return "0.7666666666666667";}if(r27_hex_equal(raw,"3fe9555555555555")==1){return "0.7916666666666666";}if(r27_hex_equal(raw,"3fea000000000000")==1){return "0.8125";}if(r27_hex_equal(raw,"3feb000000000000")==1){return "0.84375";}if(r27_hex_equal(raw,"3fec000000000000")==1){return "0.875";}if(r27_hex_equal(raw,"3fee38e38e38e38e")==1){return "0.9444444444444444";}if(r27_hex_equal(raw,"3fef1c71c71c71c7")==1){return "0.9722222222222222";}if(r27_hex_equal(raw,"3ff0000000000000")==1){return "1.0";}return "";
}
fn r27_json_value(b:*R27Buf,p:*ParentMap,id:i32,stats:*R27JsonStats,depth:i32)i32 {
    if(depth>32 || id<1 || id>p.*.node_count){return -30;}let k:i32=pm_kind(p,id);if(k==1){r27_add(b,"null");return b.*.status;}if(k==2){let q:i64=p.*.nodes[(id-1)*10+6];if(q==0){r27_add(b,"false");return b.*.status;}if(q==1){r27_add(b,"true");return b.*.status;}return -31;}if(k==3 || k==4){let x:i64=0;if(pm_small_int(p,id,&x)!=0){return -32;}r27_i64(b,x);return b.*.status;}if(k==5){let t:[]u8=r27_float_token(pm_raw(p,id));if(t.len==0){return -33;}r27_add(b,t);stats.*.floats=stats.*.floats+1;return b.*.status;}if(k==6){r27_json_string(b,pm_raw(p,id));return b.*.status;}
    if(k==9 || k==10){r27_byte(b,91);let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;let first:i32=1;while(e>0 && n<16384){let er:i32=(e-1)*4;if(p.*.edges[er+3]!=1){return -34;}if(first==0){r27_add(b,", ");}first=0;let rc:i32=r27_json_value(b,p,p.*.edges[er] as i32,stats,depth+1);if(rc!=0){return rc;}e=p.*.edges[er+2] as i32;n=n+1;}if(e!=0){return -35;}r27_byte(b,93);return b.*.status;}
    if(k==11){let keys:[]i64=pm_words(512);let vals:[]i64=pm_words(512);if(keys.len!=512 || vals.len!=512){pm_free_words(keys);pm_free_words(vals);return -36;}let n:i32=r27_collect(p,id,keys,vals);if(n<0 || n>512){pm_free_words(keys);pm_free_words(vals);return -37;}let cls:i32=1;if(n>0){let kk:i32=pm_kind(p,keys[0] as i32);if(kk==6){cls=1;}else if(kk==3 || kk==4){cls=2;}else{pm_free_words(keys);pm_free_words(vals);return -38;}let j:i32=1;while(j<n){let tk:i32=pm_kind(p,keys[j] as i32);if((cls==1 && tk!=6) || (cls==2 && tk!=3 && tk!=4)){pm_free_words(keys);pm_free_words(vals);return -39;}j=j+1;}}let sr:i32=0;if(cls==1){sr=r27_sort_lex(p,keys,vals,n);}else{sr=r27_sort_int(p,keys,vals,n);stats.*.int_key_dicts=stats.*.int_key_dicts+1;}if(sr!=0){pm_free_words(keys);pm_free_words(vals);return -40;}r27_byte(b,123);let i:i32=0;while(i<n && b.*.status==0){if(i>0){r27_add(b,", ");}if(cls==1){r27_json_string(b,pm_raw(p,keys[i] as i32));}else{let x:i64=0;if(pm_small_int(p,keys[i] as i32,&x)!=0){pm_free_words(keys);pm_free_words(vals);return -41;}let s:[]u8=_zag_i64_to_str(x);r27_json_string(b,s);nio_free(s);}r27_add(b,": ");let rc:i32=r27_json_value(b,p,vals[i] as i32,stats,depth+1);if(rc!=0){pm_free_words(keys);pm_free_words(vals);return rc;}i=i+1;}r27_byte(b,125);pm_free_words(keys);pm_free_words(vals);return b.*.status;}return -42;
}
fn r27_build(finalize:i32)i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 80;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 81;}if(n17_identity(&p)!=0){mi_loaded_close(&p);return 82;}let b:R27Buf=r27_buf(2097152);if(b.status!=0){mi_loaded_close(&p);return 83;}
    let start:i32=0;r27_add(&b,pm_raw(&p,pm_lookup(&p,p.root,"format")));r27_add(&b,pm_raw(&p,pm_lookup(&p,p.root,"r26_sha256")));let step:i64=0;if(pm_small_int(&p,pm_lookup(&p,p.root,"development_step"),&step)!=0 || step!=60423){r27_free(&b);mi_loaded_close(&p);return 84;}r27_i64(&b,step);r27_add(&b,"44d36746ffb9e8d46080376a6e26bb824772d9d4b5e429add404195d02888649");r27_component(&b,"identity_and_native_r26",start);
    let cs:i32=pm_lookup(&p,p.root,"category_system");if(pm_lookup(&p,cs,"category_head")!=0 || pm_lookup(&p,cs,"entity_head")!=0 || pm_kind(&p,pm_lookup(&p,p.root,"affordance_model"))!=1){r27_free(&b);mi_loaded_close(&p);return 85;}let sg:i32=pm_lookup(&p,p.root,"semantic_generator");if(pm_lookup(&p,sg,"specialists")!=0){r27_free(&b);mi_loaded_close(&p);return 86;}
    let stats:R27JsonStats=R27JsonStats{.floats=0,.int_key_dicts=0};let at:i32=b.used;let rc:i32=r27_json_value(&b,&p,pm_lookup(&p,p.root,"architecture"),&stats,0);if(rc!=0){r27_free(&b);mi_loaded_close(&p);return 100-rc;}r27_component(&b,"architecture_json",at);at=b.used;rc=r27_json_value(&b,&p,pm_lookup(&p,p.root,"evidence"),&stats,0);if(rc!=0){r27_free(&b);mi_loaded_close(&p);return 140-rc;}r27_component(&b,"evidence_json",at);if(b.status!=0 || stats.floats!=66 || stats.int_key_dicts!=1){r27_free(&b);mi_loaded_close(&p);return 87;}
    _zag_print("R27_JSON_STATS,");let fs:[]u8=_zag_i64_to_str(stats.floats as i64);_zag_print(fs);nio_free(fs);_zag_print(",");let ds:[]u8=_zag_i64_to_str(stats.int_key_dicts as i64);_zag_println(ds);nio_free(ds);_zag_print("R27_PREIMAGE_BYTES,");let bs:[]u8=_zag_i64_to_str(b.used as i64);_zag_println(bs);nio_free(bs);if(finalize==0){_zag_println("R27_PREFLIGHT_PASS");r27_free(&b);mi_loaded_close(&p);return 0;}
    let h:[]u8=nio_alloc(32);if(h.len!=32 || ns_sha256(b.data[0..b.used],h)!=0){nio_free(h);r27_free(&b);mi_loaded_close(&p);return 88;}let text:[]u8=ns_hex(h);nio_free(h);_zag_print("R27_NATIVE_DIGEST,");_zag_println(text);nio_free(text);r27_free(&b);mi_loaded_close(&p);return 0;
}
fn main()i32 {if(_zag_argc()!=2){_zag_println("usage: r27_digest preflight|digest");return 64;}let mode:[]u8=_zag_arg(1);if(nio_equal(mode,"preflight")==1){return r27_build(0);}if(nio_equal(mode,"digest")==1){return r27_build(1);}return 64;}

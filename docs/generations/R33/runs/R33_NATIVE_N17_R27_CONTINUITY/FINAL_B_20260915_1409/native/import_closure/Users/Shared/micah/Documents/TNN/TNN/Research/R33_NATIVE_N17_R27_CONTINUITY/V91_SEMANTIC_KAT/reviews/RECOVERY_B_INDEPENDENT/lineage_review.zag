@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
fn lr_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32){return "";}if(ns_sha256(b,h)!=0){nio_free(h);return "";}let out:[]u8=ns_hex(h);nio_free(h);return out;}
fn lr_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn lr_param(p:*ParentMap,sg:i32,layer:[]u8,key:[]u8)i32 {return pm_lookup(p,pm_lookup(p,pm_lookup(p,pm_lookup(p,pm_lookup(p,sg,"model"),"_modules"),layer),"_parameters"),key);}
fn lr_compare(p:*ParentMap,old:i32,now:i32,layer:[]u8,key:[]u8,w:*TsWork)i32 {
 let a:i32=lr_param(p,old,layer,key);let b:i32=lr_param(p,now,layer,key);let va:TsView=ts_open(p,a,w);let vb:TsView=ts_open(p,b,w);if(va.status!=0||vb.status!=0){ts_close(&va);ts_close(&vb);return 10;}
 let ok:i32=(va.kind==102&&vb.kind==102&&va.width==4&&vb.width==4&&va.rank==vb.rank&&va.offset==0&&vb.offset==0&&va.elements==vb.elements) as i32;let i:i32=0;while(i<va.rank){if(va.dims[i]!=vb.dims[i]||va.strides[i]!=vb.strides[i]){ok=0;}i=i+1;}
 if(va.rank<1||va.rank>2||va.strides[va.rank-1]!=1||(va.rank==2&&va.strides[0]!=va.dims[1])){ok=0;}
 let n:i32=va.elements*4;if(n<1||n>p.*.input.len||va.at<0||vb.at<0||va.at>p.*.input.len-n||vb.at>p.*.input.len-n){ok=0;}
 if(ok!=1){ts_close(&va);ts_close(&vb);return 11;}let ra:[]u8=p.*.input[va.at..va.at+n];let rb:[]u8=p.*.input[vb.at..vb.at+n];if(nio_equal(ra,rb)!=1){ts_close(&va);ts_close(&vb);return 12;}
 _zag_print("LR91_TENSOR,");_zag_print(layer);_zag_print(".");_zag_print(key);_zag_print(",original_node=");lr_num(a as i64);_zag_print(",original_offset=");lr_num(va.at as i64);_zag_print(",retained_node=");lr_num(b as i64);_zag_print(",retained_offset=");lr_num(vb.at as i64);_zag_print(",bytes=");lr_num(n as i64);_zag_print(",original_sha256=");_zag_print(lr_hash(ra));_zag_print(",retained_sha256=");_zag_print(lr_hash(rb));_zag_println(",raw_equal=1");ts_close(&va);ts_close(&vb);return 0;
}
fn lr_interpreter(p:*ParentMap,old:i32,now:i32,prefix:[]u8,nested:[]u8)i32 {
 let ia:i32=pm_lookup(p,old,"interpreter");let ib:i32=pm_lookup(p,now,"interpreter");let a:i32=pm_lookup(p,ia,"W");let b:i32=pm_lookup(p,ib,"W");let va:NvView=nv_open(p,a);let vb:NvView=nv_open(p,b);if(va.status!=0||vb.status!=0){nv_close(&va);nv_close(&vb);return 20;}
 if(va.kind!=102||vb.kind!=102||va.width!=4||vb.width!=4||va.ndim!=2||vb.ndim!=2||va.dims[0]!=768||vb.dims[0]!=768||va.dims[1]!=42||vb.dims[1]!=42||va.bytes!=129024||vb.bytes!=129024||va.endian!=vb.endian||va.order!=vb.order){nv_close(&va);nv_close(&vb);return 21;}
 let ra:[]u8=p.*.input[va.at..va.at+va.bytes];let rb:[]u8=p.*.input[vb.at..vb.at+vb.bytes];if(nio_equal(ra,rb)!=1){nv_close(&va);nv_close(&vb);return 22;}
 let fa:[]u8=_zag_read_file(_zag_str_concat(nested,"/interpreter.W.f32le"));let fb:[]u8=_zag_read_file(_zag_str_concat(prefix,"/interpreter.W.f32le"));if(nio_equal(ra,fa)!=1||nio_equal(rb,fb)!=1){nv_close(&va);nv_close(&vb);return 23;}nio_free(fa);nio_free(fb);
 _zag_print("LR91_INTERPRETER,original_object=");lr_num(ia as i64);_zag_print(",original_W_node=");lr_num(a as i64);_zag_print(",original_offset=");lr_num(va.at as i64);_zag_print(",retained_object=");lr_num(ib as i64);_zag_print(",retained_W_node=");lr_num(b as i64);_zag_print(",retained_offset=");lr_num(vb.at as i64);_zag_print(",bytes=129024,shape=768x42,original_sha256=");_zag_print(lr_hash(ra));_zag_print(",retained_sha256=");_zag_print(lr_hash(rb));_zag_println(",raw_equal=1");nv_close(&va);nv_close(&vb);return 0;
}
fn main()i32 {
 if(_zag_argc()!=3){return 2;}
 let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}
 let r26:i32=pm_lookup(&p,p.root,"base_state");let r25:i32=pm_lookup(&p,r26,"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");let r23:i32=pm_lookup(&p,r24,"r23_state");let old:i32=pm_lookup(&p,r23,"semantic_generator");let now:i32=pm_lookup(&p,p.root,"semantic_generator");if(old!=182274||now!=281053||old==now){mi_loaded_close(&p);return 4;}
 if(n17_class_is(&p,old,"r23_experiments","SemanticRoundTripGenerator")!=1||n17_class_is(&p,now,"r23_experiments","SemanticRoundTripGenerator")!=1||n17_int_is(&p,pm_lookup(&p,old,"cond_dim"),42)!=1||n17_int_is(&p,pm_lookup(&p,now,"cond_dim"),42)!=1){mi_loaded_close(&p);return 5;}
 _zag_println("LR91_ORIGINAL_PATH,root.base_state.base_state.r24_state.r23_state.semantic_generator\nLR91_RETAINED_PATH,root.semantic_generator\nLR91_DISTINCT_OBJECTS,182274,281053\nLR91_CLASS_BRANCH,R26-34,exact_serialized_r23_experiments.SemanticRoundTripGenerator\nLR91_INFERENCE_PARITY,UNADMITTED");
 let w:TsWork=ts_work();let rc:i32=lr_compare(&p,old,now,"emb","weight",&w);if(rc==0){rc=lr_compare(&p,old,now,"ch","weight",&w);}if(rc==0){rc=lr_compare(&p,old,now,"ch","bias",&w);}if(rc==0){rc=lr_compare(&p,old,now,"ce","weight",&w);}if(rc==0){rc=lr_compare(&p,old,now,"ce","bias",&w);}if(rc==0){rc=lr_compare(&p,old,now,"rnn","weight_ih_l0",&w);}if(rc==0){rc=lr_compare(&p,old,now,"rnn","weight_hh_l0",&w);}if(rc==0){rc=lr_compare(&p,old,now,"rnn","bias_ih_l0",&w);}if(rc==0){rc=lr_compare(&p,old,now,"rnn","bias_hh_l0",&w);}if(rc==0){rc=lr_compare(&p,old,now,"out","weight",&w);}if(rc==0){rc=lr_compare(&p,old,now,"out","bias",&w);}if(rc==0){rc=lr_interpreter(&p,old,now,_zag_arg(1),_zag_arg(2));}
 mi_loaded_close(&p);_zag_print("LR91_STATUS,");lr_num(rc as i64);_zag_println("\nLR91_ADMISSION,CLOSED\nLR91_GENERATED_OUTPUTS,0");return rc;
}

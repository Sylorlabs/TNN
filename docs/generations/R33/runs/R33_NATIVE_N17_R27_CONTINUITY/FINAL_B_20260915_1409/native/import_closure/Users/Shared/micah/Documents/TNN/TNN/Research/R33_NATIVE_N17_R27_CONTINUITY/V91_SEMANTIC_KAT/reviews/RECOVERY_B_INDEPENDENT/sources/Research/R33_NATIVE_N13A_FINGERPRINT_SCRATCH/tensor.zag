// N13 trusted, read-only storage/tensor/parameter metadata interpretation.
// Map and views have single ownership; map storage must stay live and immutable.
// No arbitrary pointer, concurrent writer, allocator-reuse or shallow-copy safety.
@import("storage.zag")

struct TsView {
    status:i32,node:i32,category:i32,tensor:i32,storage:i32,buffer:i32,
    kind:i32,width:i32,count:i32,blob_at:i32,blob_bytes:i32,at:i32,bytes:i32,
    key_at:i32,key_len:i32,offset:i32,rank:i32,elements:i32,tensor_grad:i32,grad:i32,
    source:i64,source_len:i32,nodes:i64,edges:i64,dims:[]i64,strides:[]i64,
}
fn ts_empty(code:i32)TsView {
    let z:*i64=null as *i64;
    return TsView{.status=code,.node=0,.category=0,.tensor=0,.storage=0,.buffer=0,
        .kind=0,.width=0,.count=0,.blob_at=0,.blob_bytes=0,.at=0,.bytes=0,.key_at=0,.key_len=0,
        .offset=0,.rank=0,.elements=0,.tensor_grad=0,.grad=0,.source=0,.source_len=0,.nodes=0,.edges=0,
        .dims=z[0..0],.strides=z[0..0]};
}
fn ts_close(v:*TsView)void {pm_free_words(v.*.dims);pm_free_words(v.*.strides);v.*=ts_empty(-9108);}
fn ts_fail(v:*TsView,code:i32)TsView {ts_close(v);return ts_empty(code);}
fn ts_callable(p:*ParentMap,id:i32,module:[]u8,name:[]u8)i32 {
    return (nv_kind(p,id)==16 && nv_symbol(p,nv_field(p,id,4),module,name)==1) as i32;
}
fn ts_category(p:*ParentMap,id:i32)i32 {
    if(ts_callable(p,id,"torch.storage","_load_from_bytes")==1){return 1;}
    if(ts_callable(p,id,"torch._utils","_rebuild_tensor_v2")==1){return 2;}
    if(ts_callable(p,id,"torch._utils","_rebuild_parameter")==1){return 3;}return 0;
}
fn ts_hooks(p:*ParentMap,id:i32)i32 {
    return (ts_callable(p,id,"collections","OrderedDict")==1 && nv_clean(p,id)==1 &&
        nv_field(p,id,6)==0 && nv_tuple_size(p,nv_field(p,id,5))==0) as i32;
}
fn ts_boolean(p:*ParentMap,id:i32)i32 {
    if(nv_kind(p,id)!=2 || nv_clean(p,id)!=1){return -1;}let value:i32=nv_field(p,id,6);
    if(value!=0 && value!=1){return -1;}return value;
}
fn ts_open(p:*ParentMap,id:i32,w:*TsWork)TsView {
    if(ts_charge(&w.*.opens,w.*.max_opens,1)!=0){return ts_empty(-9111);}
    if(nv_ready(p)!=1){return ts_empty(-9101);}let cat:i32=ts_category(p,id);
    if(cat==0 || nv_clean(p,id)!=1 || nv_field(p,id,6)!=0){return ts_empty(-9101);}
    let v:TsView=ts_empty(-9101);let tensor:i32=id;let gradient:i32=0;
    if(cat==3){let args:i32=nv_field(p,id,5);
        if(nv_tuple_size(p,args)!=3 || ts_hooks(p,nv_item(p,args,2))!=1){return v;}
        gradient=ts_boolean(p,nv_item(p,args,1));if(gradient<0){return v;}
        tensor=nv_item(p,args,0);if(ts_category(p,tensor)!=2){return v;}
    }
    let storage:i32=id;let size:i32=0;let strides:i32=0;let offset:i64=0;let rank:i32=1;let tensor_grad:i32=0;
    if(cat!=1){if(nv_clean(p,tensor)!=1 || nv_field(p,tensor,6)!=0){return v;}
        let args:i32=nv_field(p,tensor,5);if(nv_tuple_size(p,args)!=6 || ts_hooks(p,nv_item(p,args,5))!=1){return v;}
        storage=nv_item(p,args,0);let n:NvInt=nv_integer(p,nv_item(p,args,1));
        if(n.status!=0 || n.value<0 || n.value>16777216){return ts_empty(-9104);}offset=n.value;
        size=nv_item(p,args,2);strides=nv_item(p,args,3);rank=nv_tuple_size(p,size);
        if(rank<0 || rank>8 || nv_tuple_size(p,strides)!=rank){return ts_empty(-9104);}
        tensor_grad=ts_boolean(p,nv_item(p,args,4));if(tensor_grad<0){return v;}
        if(cat==2){gradient=tensor_grad;}
    }
    if(ts_category(p,storage)!=1 || nv_clean(p,storage)!=1 || nv_field(p,storage,6)!=0){return v;}
    let args:i32=nv_field(p,storage,5);if(nv_tuple_size(p,args)!=1){return v;}
    let buffer:i32=nv_item(p,args,0);if(nv_kind(p,buffer)!=7 || nv_clean(p,buffer)!=1){return v;}
    let blob:[]u8=nv_raw(p,buffer);let h:TsHeader=ts_decode(blob,w);if(h.status!=0){return ts_empty(h.status);}
    if((tensor_grad==1 || gradient==1) && h.kind!=102){return ts_empty(-9102);}
    if(ts_charge(&w.*.shape_allocs,w.*.max_shape_allocs,1)!=0){return ts_fail(&v,-9111);}
    v.dims=pm_words(8);if(v.dims.len!=8){return ts_fail(&v,-9107);}
    if(ts_charge(&w.*.shape_allocs,w.*.max_shape_allocs,1)!=0){return ts_fail(&v,-9111);}
    v.strides=pm_words(8);if(v.strides.len!=8){return ts_fail(&v,-9107);}
    let elements:i64=1;let empty:i32=0;let i:i32=0;
    if(cat==1){v.dims[0]=h.count;v.strides[0]=1;if(h.count==0){empty=1;v.strides[0]=0;}elements=h.count;}
    else{
        while(i<rank){let d:NvInt=nv_integer(p,nv_item(p,size,i));let s:NvInt=nv_integer(p,nv_item(p,strides,i));
            if(d.status!=0 || s.status!=0 || d.value<0 || d.value>16777216 || s.value<0 || s.value>16777216){return ts_fail(&v,-9104);}
            v.dims[i]=d.value;v.strides[i]=s.value;if(d.value==0){empty=1;}i=i+1;}
        if(empty==1){elements=0;}else{i=0;while(i<rank){
            if(elements>16777216/v.dims[i]){return ts_fail(&v,-9104);}elements=elements*v.dims[i];i=i+1;}}
    }
    if(offset>h.count){return ts_fail(&v,-9104);}
    if(empty==0){if(offset>=h.count){return ts_fail(&v,-9104);}let greatest:i64=offset;i=0;
        while(i<rank){let steps:i64=v.dims[i]-1;
            if(steps>0 && v.strides[i]>(h.count-1-greatest)/steps){return ts_fail(&v,-9104);}
            greatest=greatest+steps*v.strides[i];i=i+1;}
    }
    v.status=0;v.node=id;v.category=cat;v.tensor=0;if(cat!=1){v.tensor=tensor;}
    v.storage=storage;v.buffer=buffer;v.kind=h.kind;v.width=h.width;v.count=h.count;
    v.blob_at=nv_field(p,buffer,2);v.blob_bytes=blob.len;v.at=v.blob_at+h.at;v.bytes=h.bytes;
    v.key_at=v.blob_at+h.key_at;v.key_len=h.key_len;v.offset=offset as i32;v.rank=rank;v.elements=elements as i32;
    v.tensor_grad=tensor_grad;v.grad=gradient;v.source=_zag_slice_ptr(p.*.input) as i64;
    v.source_len=p.*.input.len;v.nodes=_zag_slice_ptr(p.*.nodes) as i64;v.edges=_zag_slice_ptr(p.*.edges) as i64;return v;
}
fn ts_bound(p:*ParentMap,v:*TsView,w:*TsWork)i32 {
    if(nv_ready(p)!=1 || v.*.status!=0 || v.*.dims.len!=8 || v.*.strides.len!=8 ||
        v.*.source!=(_zag_slice_ptr(p.*.input) as i64) || v.*.source_len!=p.*.input.len ||
        v.*.nodes!=(_zag_slice_ptr(p.*.nodes) as i64) || v.*.edges!=(_zag_slice_ptr(p.*.edges) as i64)){return -9108;}
    let expected:TsView=ts_open(p,v.*.node,w);if(expected.status!=0){let code:i32=expected.status;ts_close(&expected);return code;}
    let ok:i32=(v.*.category==expected.category && v.*.tensor==expected.tensor && v.*.storage==expected.storage &&
        v.*.buffer==expected.buffer && v.*.kind==expected.kind && v.*.width==expected.width && v.*.count==expected.count &&
        v.*.blob_at==expected.blob_at && v.*.blob_bytes==expected.blob_bytes && v.*.at==expected.at && v.*.bytes==expected.bytes &&
        v.*.key_at==expected.key_at && v.*.key_len==expected.key_len && v.*.offset==expected.offset &&
        v.*.rank==expected.rank && v.*.elements==expected.elements && v.*.tensor_grad==expected.tensor_grad && v.*.grad==expected.grad) as i32;
    let i:i32=0;while(i<8){if(v.*.dims[i]!=expected.dims[i] || v.*.strides[i]!=expected.strides[i]){ok=0;}i=i+1;}
    ts_close(&expected);if(ok!=1){return -9108;}return 0;
}
fn ts_at(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)i64 {
    if(ts_charge(&w.*.probes,w.*.max_probes,1)!=0){return -9111;}
    let code:i32=ts_bound(p,v,w);if(code!=0){return code;}
    if(coordinates.len!=v.*.rank || v.*.elements==0){return -9105;}
    let at:i64=v.*.offset;let i:i32=0;while(i<v.*.rank){
        if(coordinates[i]<0 || coordinates[i]>=v.*.dims[i]){return -9105;}
        at=at+coordinates[i]*v.*.strides[i];i=i+1;}
    if(at<0 || at>=v.*.count){return -9105;}return at;
}
fn ts_bits(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)NvBits {
    let bits:NvBits=NvBits{.status=-9105,.low=0,.high=0};let at:i64=ts_at(p,v,coordinates,w);
    if(at<0){bits.status=at as i32;return bits;}let begin:i32=v.*.at+(at as i32)*v.*.width;let factor:i64=1;let i:i32=0;
    while(i<v.*.width){if(i==4){factor=1;}let x:i64=p.*.input[begin+i] as i64;
        if(i<4){bits.low=bits.low+x*factor;}else{bits.high=bits.high+x*factor;}factor=factor*256;i=i+1;}
    bits.status=0;return bits;
}
fn ts_row(p:*ParentMap,v:*TsView,w:*TsWork)NvRow {
    // Owned output only. Hash raw storage, whole containing blob and key bytes;
    // do not conflate archive-local storage keys with cross-archive alias IDs.
    if(ts_charge(&w.*.rows,w.*.max_rows,1)!=0){return NvRow{.status=-9111,.data=""};}
    let bound:i32=ts_bound(p,v,w);if(bound!=0){return NvRow{.status=bound,.data=""};}
    let charge:i64=(v.*.blob_bytes as i64)+(v.*.bytes as i64)+(v.*.key_len as i64);
    if(ts_charge(&w.*.hash_bytes,w.*.max_hash_bytes,charge)!=0){return NvRow{.status=-9111,.data=""};}
    let row:[]u8=nio_alloc(256);if(row.len!=256){return NvRow{.status=-9107,.data=""};}
    let code:i32=mi_put(row,0,v.*.node)+mi_put(row,4,v.*.category)+mi_put(row,8,v.*.tensor)+mi_put(row,12,v.*.storage);
    code=code+mi_put(row,16,v.*.buffer)+mi_put(row,20,v.*.kind)+mi_put(row,24,v.*.width)+mi_put(row,28,v.*.count);
    code=code+mi_put(row,32,v.*.blob_at)+mi_put(row,36,v.*.blob_bytes)+mi_put(row,40,v.*.at)+mi_put(row,44,v.*.bytes);
    code=code+mi_put(row,48,v.*.key_at)+mi_put(row,52,v.*.key_len)+mi_put(row,56,v.*.offset)+mi_put(row,60,v.*.rank);
    code=code+mi_put(row,64,v.*.elements)+mi_put(row,68,v.*.tensor_grad)+mi_put(row,72,v.*.grad)+mi_put(row,80,nv_field(p,v.*.node,1));
    let i:i32=0;while(i<8){code=code+mi_put(row,96+i*4,v.*.dims[i])+mi_put(row,128+i*4,v.*.strides[i]);i=i+1;}
    if(code==0){code=ns_sha256(p.*.input[v.*.blob_at..v.*.blob_at+v.*.blob_bytes],row[160..192]);}
    if(code==0){code=ns_sha256(p.*.input[v.*.at..v.*.at+v.*.bytes],row[192..224]);}
    if(code==0){code=ns_sha256(p.*.input[v.*.key_at..v.*.key_at+v.*.key_len],row[224..256]);}
    if(code!=0){nio_free(row);if(code==(-12)){return NvRow{.status=-9107,.data=""};}return NvRow{.status=-9106,.data=""};}
    return NvRow{.status=0,.data=row};
}

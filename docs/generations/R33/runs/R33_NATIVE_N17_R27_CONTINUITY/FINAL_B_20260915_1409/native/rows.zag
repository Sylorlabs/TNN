        v.*.buffer==expected.buffer && v.*.kind==expected.kind && v.*.width==expected.width && v.*.count==expected.count &&
        v.*.blob_at==expected.blob_at && v.*.blob_bytes==expected.blob_bytes && v.*.at==expected.at && v.*.bytes==expected.bytes &&
        v.*.key_at==expected.key_at && v.*.key_len==expected.key_len && v.*.offset==expected.offset &&
        v.*.rank==expected.rank && v.*.elements==expected.elements && v.*.tensor_grad==expected.tensor_grad && v.*.grad==expected.grad) as i32;
    let i:i32=0;while(i<8){if(v.*.dims[i]!=expected.dims[i] || v.*.strides[i]!=expected.strides[i]){ok=0;}i=i+1;}
    ts_close(&expected);if(ok!=1){return -9108;}return 0;
}
fn ts_at(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)i64 {
    if(ts_charge(&w.*.probes,w.*.max_probes,1)!=0){return -9111;}
    let code:i32=ts_bound(p,v,w);if(code!=0){return code;}
    if(coordinates.len!=v.*.rank || v.*.elements==0){return -9105;}
    let at:i64=v.*.offset;let i:i32=0;while(i<v.*.rank){
        if(coordinates[i]<0 || coordinates[i]>=v.*.dims[i]){return -9105;}
        at=at+coordinates[i]*v.*.strides[i];i=i+1;}
    if(at<0 || at>=v.*.count){return -9105;}return at;
}
fn ts_bits(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)NvBits {
    let bits:NvBits=NvBits{.status=-9105,.low=0,.high=0};let at:i64=ts_at(p,v,coordinates,w);
    if(at<0){bits.status=at as i32;return bits;}let begin:i32=v.*.at+(at as i32)*v.*.width;let factor:i64=1;let i:i32=0;
    while(i<v.*.width){if(i==4){factor=1;}let x:i64=p.*.input[begin+i] as i64;
        if(i<4){bits.low=bits.low+x*factor;}else{bits.high=bits.high+x*factor;}factor=factor*256;i=i+1;}
    bits.status=0;return bits;
}
fn ts_row(p:*ParentMap,v:*TsView,w:*TsWork)NvRow {
    // Owned output only. Hash raw storage, whole containing blob and key bytes;
    // do not conflate archive-local storage keys with cross-archive alias IDs.
    if(ts_charge(&w.*.rows,w.*.max_rows,1)!=0){return NvRow{.status=-9111,.data=""};}
    let bound:i32=ts_bound(p,v,w);if(bound!=0){return NvRow{.status=bound,.data=""};}
    let charge:i64=(v.*.blob_bytes as i64)+(v.*.bytes as i64)+(v.*.key_len as i64);
    if(ts_charge(&w.*.hash_bytes,w.*.max_hash_bytes,charge)!=0){return NvRow{.status=-9111,.data=""};}
    let row:[]u8=nio_alloc(256);if(row.len!=256){return NvRow{.status=-9107,.data=""};}
    let code:i32=mi_put(row,0,v.*.node)+mi_put(row,4,v.*.category)+mi_put(row,8,v.*.tensor)+mi_put(row,12,v.*.storage);
    code=code+mi_put(row,16,v.*.buffer)+mi_put(row,20,v.*.kind)+mi_put(row,24,v.*.width)+mi_put(row,28,v.*.count);
    code=code+mi_put(row,32,v.*.blob_at)+mi_put(row,36,v.*.blob_bytes)+mi_put(row,40,v.*.at)+mi_put(row,44,v.*.bytes);
    code=code+mi_put(row,48,v.*.key_at)+mi_put(row,52,v.*.key_len)+mi_put(row,56,v.*.offset)+mi_put(row,60,v.*.rank);
    code=code+mi_put(row,64,v.*.elements)+mi_put(row,68,v.*.tensor_grad)+mi_put(row,72,v.*.grad)+mi_put(row,80,nv_field(p,v.*.node,1));
    let i:i32=0;while(i<8){code=code+mi_put(row,96+i*4,v.*.dims[i])+mi_put(row,128+i*4,v.*.strides[i]);i=i+1;}
    if(code==0){code=ns_sha256(p.*.input[v.*.blob_at..v.*.blob_at+v.*.blob_bytes],row[160..192]);}
    if(code==0){code=ns_sha256(p.*.input[v.*.at..v.*.at+v.*.bytes],row[192..224]);}
    if(code==0){code=ns_sha256(p.*.input[v.*.key_at..v.*.key_at+v.*.key_len],row[224..256]);}
    if(code!=0){nio_free(row);if(code==(-12)){return NvRow{.status=-9107,.data=""};}return NvRow{.status=-9106,.data=""};}
    return NvRow{.status=0,.data=row};
}

// R33-N17 authoring-only native identity layer.
// This imports previously consumed read-only substrate for compilation review.
// It never executes Python, pickle reducers/classes, a learner, or promotion.


fn n17_class_is(p:*ParentMap,id:i32,module:[]u8,name:[]u8)i32 {
    if(pm_kind(p,id)!=15){return 0;}
    let row:i32=(id-1)*10;let cls:i32=p.*.nodes[row+4] as i32;
    return nv_symbol(p,cls,module,name);
}

fn n17_dict_size(p:*ParentMap,id:i32,expected:i32)i32 {
    return (pm_kind(p,id)==11 && p.*.nodes[(id-1)*10+9]==expected) as i32;
}

fn n17_int_is(p:*ParentMap,id:i32,expected:i64)i32 {
    let value:i64=0;
    return (pm_small_int(p,id,&value)==0 && value==expected) as i32;
}

fn n17_identity(p:*ParentMap)i32 {
    if(pb_parent_identity(p)!=0){return -9201;}
    if(nio_equal(pm_raw(p,pm_lookup(p,p.*.root,"r26_sha256")),
        "df3acde273aa682642d13763a24208ff1dbb42968313cbe2a4256f7ccbc1f839")!=1){return -9202;}
    if(n17_dict_size(p,pm_lookup(p,p.*.root,"category_system"),4)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"abstraction_policy"),2)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"visual_debate_policy"),6)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"architecture"),58)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"evidence"),12)!=1){return -9203;}
    let r26:i32=pm_lookup(p,p.*.root,"base_state");
    if(n17_class_is(p,r26,"r26_experiments","R26State")!=1){return -9204;}
    let state:i32=pm_build_state(p,r26);
    if(pm_kind(p,state)!=11 || p.*.nodes[(state-1)*10+9]!=15){return -9205;}
    if(nio_equal(pm_raw(p,pm_lookup(p,r26,"format")),"TNN_PRE_V1_R26_VIDEO_ARCHITECTURE")!=1 ||
       n17_int_is(p,pm_lookup(p,r26,"development_step"),60249)!=1 ||
       n17_int_is(p,pm_lookup(p,r26,"newborn_restarts"),0)!=1){return -9206;}
    if(pm_kind(p,pm_lookup(p,r26,"speech_segmenter"))!=1){return -9207;}
    return 0;
}


fn br(p:*ParentMap,id:[]u8,node:i32,ok:i32,f:*i32)void {
 _zag_print("B_ROW,");_zag_print(id);_zag_print(",");if(ok==1){_zag_print("PASS");}else{_zag_print("FAIL");f.*=f.*+1;}_zag_print(",");let n:[]u8=_zag_i64_to_str(node as i64);_zag_print(n);nio_free(n);_zag_print(",");let k:[]u8=_zag_i64_to_str(pm_kind(p,node) as i64);_zag_println(k);nio_free(k);
}
fn bt(p:*ParentMap,id:i32,s:[]u8)i32 {return (pm_kind(p,id)==6 && nio_equal(pm_raw(p,id),s)==1) as i32;}
fn bf(p:*ParentMap,id:i32)u64 {if(pm_kind(p,id)!=5){return 0xffffffffffffffff;}let b:[]u8=pm_raw(p,id);if(b.len!=8 || b[0]>=128){return 0xffffffffffffffff;}let x:u64=0;let i:i32=0;while(i<8){x=(x<<8)|(b[i] as u64);i=i+1;}if(x>0x3ff0000000000000){return 0xffffffffffffffff;}return x;}
fn bge(p:*ParentMap,id:i32,x:u64)i32 {let v:u64=bf(p,id);return (v!=0xffffffffffffffff && v>=x) as i32;}
fn blt(p:*ParentMap,id:i32,x:u64)i32 {let v:u64=bf(p,id);return (v!=0xffffffffffffffff && v<x) as i32;}
fn bb(p:*ParentMap,id:i32,v:i64)i32 {return (pm_kind(p,id)==2 && p.*.nodes[(id-1)*10+6]==v) as i32;}
fn bkeys(p:*ParentMap,id:i32,count:i32)i32 {if(pm_kind(p,id)!=11){return 0;}let n:i32=p.*.nodes[(id-1)*10+9] as i32;if(count>=0 && n!=count){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let seen:i32=0;let mask:i64=0;while(e>0 && seen<n){let r:i32=(e-1)*4;let x:i64=0;if(p.*.edges[r+3]!=2 || pm_small_int(p,p.*.edges[r] as i32,&x)!=0){return 0;}if(count>=0){if(x<0 || x>=count || (mask&(1<<x))!=0){return 0;}mask=mask|(1<<x);}e=p.*.edges[r+2] as i32;seen=seen+1;}return (e==0 && seen==n) as i32;}
fn bsub(p:*ParentMap,id:i32,key:[]u8)i32 {return pm_lookup(p,id,key);}

fn pm_tuple(p:*ParentMap,n:i32,start:i32)void {
    if(n<0 || n>p.*.sp){pm_fail(p,-8803);return;}let id:i32=pm_new(p,10,start,0,0,0,0,0);
    let i:i32=p.*.sp-n;while(i<p.*.sp && p.*.status==0){pm_edge(p,id,p.*.stack[i] as i32,0,1);i=i+1;}
    p.*.sp=p.*.sp-n;pm_push(p,id);
}
fn pm_container_ok(kind:i32,op:i32)i32 {
    if(kind==15 || kind==16){return 1;}
    if(op==1){return (kind==9) as i32;}if(op==2){return (kind==11) as i32;}
    return (kind==12) as i32;
}
fn pm_mark_container(p:*ParentMap,opcode:i32,start:i32)void {
    if(p.*.mp<1){pm_fail(p,-8803);return;}let mark:i32=p.*.marks[p.*.mp-1] as i32;
    if(mark<0 || mark>=p.*.sp || p.*.stack[mark]!=0){pm_fail(p,-8803);return;}
    let made:i32=(opcode==116 || opcode==108 || opcode==100 || opcode==145) as i32;
    let kind:i32=10;if(opcode==108){kind=9;}if(opcode==100){kind=11;}if(opcode==145){kind=13;}
    let op:i32=1;if(opcode==100 || opcode==117){op=2;}if(opcode==144 || opcode==145){op=4;}
    let id:i32=0;if(made==1){id=pm_new(p,kind,start,0,0,0,0,0);}
    else{if(mark<1){pm_fail(p,-8803);return;}id=p.*.stack[mark-1] as i32;
        if(pm_container_ok(pm_kind(p,id),op)!=1){pm_fail(p,-8803);return;}}
    let n:i32=p.*.sp-mark-1;if(op==2 && n%2!=0){pm_fail(p,-8803);return;}
    let i:i32=mark+1;while(i<p.*.sp && p.*.status==0){let a:i32=p.*.stack[i] as i32;let b:i32=0;i=i+1;
        if(op==2){b=p.*.stack[i] as i32;i=i+1;}pm_edge(p,id,a,b,op);}
    p.*.mp=p.*.mp-1;p.*.sp=mark;if(made==1){pm_push(p,id);}
}
fn pm_scan(p:*ParentMap)i32 {
    if(p.*.status!=0){return p.*.status;}
    if(p.*.pos!=0 || p.*.input[0]!=128){pm_fail(p,-8801);return p.*.status;}
    pm_take(p,1);let protocol:i64=pm_u(p,1);if(protocol<2 || protocol>5){pm_fail(p,-8801);return p.*.status;}
    p.*.protocol=protocol as i32;p.*.op_count=1;p.*.hist[128]=1;let done:i32=0;
    while(p.*.status==0 && done==0){
        if(p.*.frame_end==p.*.pos){p.*.frame_end=-1;}
        let start:i32=pm_take(p,1);if(start<0){break;}let op:i32=p.*.input[start] as i32;
        p.*.failed_opcode=op;p.*.hist[op]=p.*.hist[op]+1;p.*.op_count=p.*.op_count+1;
        if(p.*.op_count>4194304){pm_fail(p,-8805);break;}
        if(op==46){if(p.*.sp!=1 || p.*.mp!=0 || p.*.pos!=p.*.input.len ||
            (p.*.frame_end>=0 && p.*.frame_end!=p.*.pos)){pm_fail(p,-8803);}else{p.*.root=pm_top(p,0);done=1;}}
        else if(op==149){if(p.*.protocol<4 || p.*.frame_end>=0){pm_fail(p,-8802);}
            else{let size:i64=pm_u(p,8);if(size<0 || size>p.*.input.len-p.*.pos){pm_fail(p,-8802);}else{p.*.frame_end=p.*.pos+(size as i32);}}}
        else if(op==40){if(p.*.mp>=p.*.marks.len){pm_fail(p,-8805);}else{p.*.marks[p.*.mp]=p.*.sp;p.*.mp=p.*.mp+1;pm_push(p,0);}}
        else if(op==48){if(p.*.sp<1){pm_fail(p,-8803);}else{if(p.*.stack[p.*.sp-1]==0){p.*.mp=p.*.mp-1;}p.*.sp=p.*.sp-1;}}
        else if(op==49){if(p.*.mp<1){pm_fail(p,-8803);}else{p.*.sp=p.*.marks[p.*.mp-1] as i32;p.*.mp=p.*.mp-1;}}
        else if(op==50){pm_push(p,pm_top(p,0));}
        else if(op==78){pm_push(p,pm_new(p,1,start,0,0,0,0,0));}
        else if(op==136 || op==137){pm_push(p,pm_new(p,2,start,0,0,0,0,(op==136) as i64));}
        else if(op==74 || op==75 || op==77){let n:i32=4;if(op==75){n=1;}if(op==77){n=2;}
            let v:i64=pm_u(p,n);if(op==74 && v>=2147483648){v=v-4294967296;}pm_push(p,pm_new(p,3,start,start+1,n,0,0,v));}
        else if(op==71){let at:i32=pm_take(p,8);pm_push(p,pm_new(p,5,start,at,8,0,0,0));}
        else if(op==138 || op==139){let size:i64=0;if(op==138){size=pm_u(p,1);}else{size=pm_u(p,4);}
            if(size<0 || size>p.*.input.len-p.*.pos){pm_fail(p,-8802);}else{let at:i32=pm_take(p,size as i32);pm_push(p,pm_new(p,4,start,at,size as i32,0,0,0));}}
        else if(op==66 || op==67 || op==88 || op==140 || op==141 || op==142 || op==150 || op==84 || op==85){
            let width:i32=4;if(op==67 || op==140 || op==85){width=1;}if(op==141 || op==142 || op==150){width=8;}
            let size:i64=pm_u(p,width);let kind:i32=7;if(op==88 || op==140 || op==141){kind=6;}if(op==150){kind=8;}
            if(((op==66 || op==67) && p.*.protocol<3) || (op>=140 && op<=142 && p.*.protocol<4) || (op==150 && p.*.protocol<5) || size<0 || size>p.*.input.len-p.*.pos){pm_fail(p,-8802);}
            else{let at:i32=pm_take(p,size as i32);pm_push(p,pm_new(p,kind,start,at,size as i32,0,0,0));}}
        else if(op==93 || op==41 || op==125 || op==143){let kind:i32=9;if(op==41){kind=10;}if(op==125){kind=11;}if(op==143){kind=12;}
            if(op==143 && p.*.protocol<4){pm_fail(p,-8801);}else{pm_push(p,pm_new(p,kind,start,0,0,0,0,0));}}
        else if(op==133 || op==134 || op==135){pm_tuple(p,op-132,start);}
        else if(op==108 || op==100 || op==116 || op==145 || op==101 || op==117 || op==144){
            if(op>=144 && p.*.protocol<4){pm_fail(p,-8801);}else{pm_mark_container(p,op,start);}}
        else if(op==97 || op==115){let n:i32=1;if(op==115){n=2;}let owner:i32=pm_top(p,n);let b:i32=0;
            let a:i32=pm_top(p,n-1);let how:i32=1;if(n==2){b=pm_top(p,0);how=2;}
            if(pm_container_ok(pm_kind(p,owner),how)!=1){pm_fail(p,-8803);}else{pm_edge(p,owner,a,b,how);if(p.*.status==0){p.*.sp=p.*.sp-n;}}}
        else if(op==113 || op==114 || op==148){let index:i64=0;if(op==113){index=pm_u(p,1);}else if(op==114){index=pm_u(p,4);}else{index=p.*.memo_count;}
            if(op==148 && p.*.protocol<4){pm_fail(p,-8801);}else{pm_memo_put(p,index);}}
        else if(op==104 || op==106){let width:i32=1;if(op==106){width=4;}let index:i64=pm_u(p,width);if(p.*.status==0){pm_memo_get(p,index);}}
        else if(op==99){let ma:i32=p.*.pos;let ml:i32=pm_line(p);let na:i32=p.*.pos;let nl:i32=pm_line(p);
            let mod:i32=pm_new(p,6,start,ma,ml,0,0,0);let name:i32=pm_new(p,6,start,na,nl,0,0,0);pm_push(p,pm_global(p,start,mod,name));}
        else if(op==147){if(p.*.protocol<4){pm_fail(p,-8801);}else{let name:i32=pm_pop(p);let mod:i32=pm_pop(p);pm_push(p,pm_global(p,start,mod,name));}}
        else if(op==129 || op==146 || op==82){let kw:i32=0;if(op==146){kw=pm_pop(p);if(p.*.protocol<4 || pm_kind(p,kw)!=11){pm_fail(p,-8803);}}
            let args:i32=pm_pop(p);let callable:i32=pm_pop(p);if(pm_kind(p,args)!=10){pm_fail(p,-8803);}
            let kind:i32=15;if(op==82){kind=16;p.*.reductions=p.*.reductions+1;}else{p.*.newobjs=p.*.newobjs+1;}
            pm_push(p,pm_new(p,kind,start,0,0,callable,args,kw));}
        else if(op==98){let state:i32=pm_pop(p);let target:i32=pm_top(p,0);let kind:i32=pm_kind(p,target);
            if(kind!=15 && kind!=16){pm_fail(p,-8803);}else{pm_edge(p,target,state,0,3);p.*.builds=p.*.builds+1;}}
        else if(op==130 || op==131 || op==132){let width:i32=1;if(op==131){width=2;}if(op==132){width=4;}
            let code:i64=pm_u(p,width);if(code<=0 || code>2147483647){pm_fail(p,-8802);}else{p.*.external=p.*.external+1;pm_push(p,pm_new(p,18,start,0,0,0,0,code));}}
        else if(op==81){let id:i32=pm_pop(p);p.*.external=p.*.external+1;pm_push(p,pm_new(p,17,start,0,0,id,0,0));}
        else if(op==151 || op==152){if(p.*.protocol<5){pm_fail(p,-8801);}else{if(op==151){p.*.external=p.*.external+1;pm_push(p,pm_new(p,19,start,0,0,0,0,p.*.external));}
            else{let id:i32=pm_pop(p);pm_push(p,pm_new(p,20,start,0,0,id,0,0));}}}
        else{pm_fail(p,-8806);}
    }
    if(done!=1 || p.*.status!=0){p.*.root=0;if(p.*.status==0){p.*.status=-8802;}}return p.*.status;
}
fn pm_build_state(p:*ParentMap,id:i32)i32 {
    let kind:i32=pm_kind(p,id);if(kind==11){return id;}if(kind!=15 && kind!=16){return 0;}
    let edge:i32=p.*.nodes[(id-1)*10+7] as i32;let state:i32=0;let seen:i32=0;
    while(edge>0 && seen<p.*.edge_count){if(edge>p.*.edge_count){return 0;}let row:i32=(edge-1)*4;
        if(p.*.edges[row+3]==3){state=p.*.edges[row] as i32;}edge=p.*.edges[row+2] as i32;seen=seen+1;}
    return state;
}
fn pm_lookup(p:*ParentMap,id:i32,key:[]u8)i32 {
    let state:i32=pm_build_state(p,id);if(pm_kind(p,state)!=11){return 0;}
    let e:i32=p.*.nodes[(state-1)*10+7] as i32;let result:i32=0;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count){if(e>p.*.edge_count){return 0;}let row:i32=(e-1)*4;let k:i32=p.*.edges[row] as i32;
        if(p.*.edges[row+3]==2 && pm_kind(p,k)==6 && nio_equal(pm_raw(p,k),key)==1){result=p.*.edges[row+1] as i32;}
        e=p.*.edges[row+2] as i32;seen=seen+1;}return result;
}
fn pm_small_int(p:*ParentMap,id:i32,out:*i64)i32 {
    let kind:i32=pm_kind(p,id);if(kind==2 || kind==3){out.*=p.*.nodes[(id-1)*10+6];return 0;}
    if(kind!=4){return -1;}let b:[]u8=pm_raw(p,id);if(b.len>8){return -1;}let value:i64=0;
    if(b.len>0 && b[b.len-1]>=128){value=-1;}let i:i32=b.len-1;while(i>=0){value=value*256+(b[i] as i64);i=i-1;}out.*=value;return 0;
}
fn pm_validate(p:*ParentMap)i32 {
    if(p.*.status!=0 || pm_valid_id(p,p.*.root)!=1){return -8803;}let id:i32=1;let total:i32=0;
    while(id<=p.*.node_count){let row:i32=(id-1)*10;let kind:i32=p.*.nodes[row] as i32;
        let start:i64=p.*.nodes[row+1];let at:i64=p.*.nodes[row+2];let len:i64=p.*.nodes[row+3];
        if(kind<1 || kind>20 || start<0 || start>=p.*.input.len || at<0 || len<0 || at>p.*.input.len || len>p.*.input.len-at){return -8803;}
        if(kind==14 || kind==15 || kind==16 || kind==17 || kind==20){
            if(pm_valid_id(p,p.*.nodes[row+4] as i32)!=1){return -8803;}
            if((kind==14 || kind==15 || kind==16) && pm_valid_id(p,p.*.nodes[row+5] as i32)!=1){return -8803;}
            if(kind==15 && (p.*.nodes[row+6]<0 || p.*.nodes[row+6]>p.*.node_count)){return -8803;}
        }
        let edge:i32=p.*.nodes[row+7] as i32;let last:i32=0;let n:i32=0;
        while(edge>0){if(edge>p.*.edge_count || edge<=last){return -8803;}let er:i32=(edge-1)*4;
            if(pm_valid_id(p,p.*.edges[er] as i32)!=1 || p.*.edges[er+1]<0 || p.*.edges[er+1]>p.*.node_count ||
               p.*.edges[er+3]<1 || p.*.edges[er+3]>4){return -8803;}
            last=edge;edge=p.*.edges[er+2] as i32;n=n+1;if(n>p.*.edge_count){return -8803;}}
        if(n!=p.*.nodes[row+9] || last!=p.*.nodes[row+8]){return -8803;}total=total+n;id=id+1;
    }
    if(total!=p.*.edge_count){return -8803;}let used:i32=0;let i:i32=0;
    while(i<p.*.memo_extent){if(p.*.memo[i]!=0){if(pm_valid_id(p,p.*.memo[i] as i32)!=1){return -8804;}used=used+1;}i=i+1;}
    if(used!=p.*.memo_count){return -8804;}
    let ops:i64=0;i=0;while(i<256){if(p.*.hist[i]<0 || p.*.hist[i]>4194304){return -8803;}ops=ops+p.*.hist[i];i=i+1;}
    if(ops!=p.*.op_count || p.*.hist[128]!=1 || p.*.hist[46]!=1 ||
       p.*.newobjs!=p.*.hist[129]+p.*.hist[146] || p.*.reductions!=p.*.hist[82] || p.*.builds!=p.*.hist[98]){return -8803;}
    i=0;while(i<p.*.global_count){if(pm_kind(p,p.*.globals[i] as i32)!=14){return -8803;}i=i+1;}return 0;
}

// Native page bundle for inert descriptors plus every original input byte.
// Source-offset references never replace original bytes; raw pages preserve the
// whole stream, including opaque tensor/storage payloads and unknown semantics.


fn mi_put(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || b.len<4 || at>b.len-4 || v<(-2147483647-1) || v>2147483647){return -8811;}
    let x:i64=v;if(x<0){x=x+4294967296;}let i:i32=0;while(i<4){b[at+i]=(x%256) as u8;x=x/256;i=i+1;}return 0;
}
fn mi_get(b:[]u8,at:i32)i64 {
    if(at<0 || b.len<4 || at>b.len-4){return -2147483648;}
    let x:i64=(b[at] as i64)+(b[at+1] as i64)*256+(b[at+2] as i64)*65536+(b[at+3] as i64)*16777216;
    if(x>=2147483648){x=x-4294967296;}return x;
}
fn mi_copy(a:[]u8,b:[]u8)i32 {if(b.len<a.len){return -8811;}let i:i32=0;while(i<a.len){b[i]=a[i];i=i+1;}return 0;}
fn mi_zero(b:[]u8)i32 {let i:i32=0;while(i<b.len){if(b[i]!=0){return 0;}i=i+1;}return 1;}
fn mi_name(kind:i32,page:i32)[]u8 {
    let prefix:[]u8="nodes-";if(kind==2){prefix="edges-";}if(kind==3){prefix="memo-";}if(kind==4){prefix="globals-";}
    if(kind==5){prefix="raw-";}if(kind==6){prefix="opcodes-";}
    let n:[]u8=_zag_i64_to_str(page as i64);let stem:[]u8=_zag_str_concat(prefix,n);let out:[]u8=_zag_str_concat(stem,".bin");nio_free(n);nio_free(stem);return out;
}
fn mi_write(root:i64,name:[]u8,b:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -8812;}let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(root)!=0){code=-8812;}
    if(nio_close(fd)!=0){code=-8812;}return code;
}
fn mi_read(root:i64,name:[]u8,b:[]u8,max:i32)i64 {
    let fd:i64=nio_open_child(root,name,0);if(fd<0){return -8812;}let n:i64=nio_read_exact(fd,b,max);
    if(nio_close(fd)!=0){return -8812;}return n;
}
fn mi_words(kind:i32)i32 {if(kind==1){return 10;}if(kind==2){return 4;}if(kind==5){return 0;}return 1;}
fn mi_count(p:*ParentMap,kind:i32)i32 {
    if(kind==1){return p.*.node_count;}if(kind==2){return p.*.edge_count;}if(kind==3){return p.*.memo_extent;}
    if(kind==4){return p.*.global_count;}if(kind==5){return p.*.input.len;}return 256;
}
fn mi_table(p:*ParentMap,kind:i32)[]i64 {
    if(kind==1){return p.*.nodes;}if(kind==2){return p.*.edges;}if(kind==3){return p.*.memo;}
    if(kind==4){return p.*.globals;}return p.*.hist;
}
fn mi_dump(p:*ParentMap,path:[]u8,source_hash:[]u8)[]u8 {
    if(pm_validate(p)!=0 || source_hash.len!=32){return "";}
    if(nio_mkdir(path)!=0){return "";}let root:i64=nio_open_root(path);if(root<0){return "";}
    let manifest:[]u8=nio_alloc(16512);let page:[]u8=nio_alloc(240064);let hash:[]u8=nio_alloc(32);
    if(manifest.len!=16512 || page.len!=240064 || hash.len!=32){nio_close(root);nio_free(manifest);nio_free(page);nio_free(hash);return "";}
    mi_copy("TNNMAP01",manifest);mi_put(manifest,8,1);mi_put(manifest,16,p.*.node_count);mi_put(manifest,20,p.*.edge_count);
    mi_put(manifest,24,p.*.memo_count);mi_put(manifest,28,p.*.memo_extent);mi_put(manifest,32,p.*.global_count);
    mi_put(manifest,36,p.*.root);mi_put(manifest,40,p.*.protocol);mi_put(manifest,44,p.*.op_count);
    mi_put(manifest,48,p.*.newobjs);mi_put(manifest,52,p.*.reductions);mi_put(manifest,56,p.*.builds);mi_put(manifest,60,p.*.external);
    mi_copy(source_hash,manifest[64..96]);mi_put(manifest,96,p.*.input.len);mi_put(manifest,100,p.*.aliases);
    let code:i32=0;let entries:i32=0;let kind:i32=1;
    while(kind<=6 && code==0){let words:i32=mi_words(kind);let stride:i32=words*4;if(kind==5){stride=1;}
        let rows:i32=mi_count(p,kind);let at:i32=0;let ordinal:i32=1;let table:[]i64=mi_table(p,kind);
        while(at<rows && code==0){if(entries>=256){code=-8811;break;}
            let n:i32=rows-at;let maximum:i32=240000/stride;if(n>maximum){n=maximum;}
            let bytes:i32=64+n*stride;let z:i32=0;while(z<64){page[z]=0;z=z+1;}
            mi_copy("TNNMP001",page);mi_put(page,8,1);mi_put(page,12,kind);mi_put(page,16,ordinal);
            mi_put(page,20,at);mi_put(page,24,n);mi_put(page,28,words);mi_copy(source_hash,page[32..64]);
            if(kind==5){mi_copy(p.*.input[at..at+n],page[64..bytes]);}
            else{let i:i32=0;while(i<n*words && code==0){code=mi_put(page,64+i*4,table[at*words+i]);i=i+1;}}
            if(code==0 && ns_sha256(page[0..bytes],hash)!=0){code=-8812;}
            let name:[]u8=mi_name(kind,ordinal);if(code==0){code=mi_write(root,name,page[0..bytes]);}nio_free(name);
            if(code==0){let r:i32=128+entries*64;mi_put(manifest,r,kind);mi_put(manifest,r+4,ordinal);
                mi_put(manifest,r+8,at);mi_put(manifest,r+12,n);mi_put(manifest,r+16,words);mi_put(manifest,r+20,bytes);
                mi_copy(hash,manifest[r+24..r+56]);entries=entries+1;at=at+n;ordinal=ordinal+1;}
        }kind=kind+1;
    }
    let result:[]u8="";mi_put(manifest,12,entries);
    if(code==0){code=mi_write(root,"manifest.bin",manifest[0..128+entries*64]);}
    if(nio_close(root)!=0){code=-8812;}if(code==0){result=nio_alloc(32);if(result.len!=32 || ns_sha256(manifest[0..128+entries*64],result)!=0){nio_free(result);result="";}}
    nio_free(manifest);nio_free(page);nio_free(hash);return result;

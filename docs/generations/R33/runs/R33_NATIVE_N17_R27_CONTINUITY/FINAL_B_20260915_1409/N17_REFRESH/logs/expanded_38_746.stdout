#!/usr/bin/env python3
from pathlib import Path
import json,hashlib,re,sys
ROOT=Path(__file__).resolve().parents[1]
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def read(rel):return (ROOT/rel).read_text(errors='replace')
def j(rel):return json.loads(read(rel))
checks={}
def ck(name,val): checks[name]=bool(val)
summary=j('results/final_summary.json'); policy=j('state/r28-shadow-policy.json'); audit=j('verification/final/source_audit.json')
source=read('src/tnn_r28_aeif.zag')
ck('status_shadow_not_promoted', summary['canonical_promotion'] is False and policy['status']=='SHADOW_ONLY_NO_CANONICAL_PROMOTION')
ck('parent_digest_exact', summary['canonical_parent']['digest']=='562aaaedb5b9ceec2f50482f631992c247cbe50e9f6d2321b811e311ecf73b04')
ck('parent_step_exact', summary['canonical_parent']['development_step']==60423)
ck('zero_newborn_restarts', summary['canonical_parent']['newborn_restarts']==0 and policy['newborn_restarts']==0)
ck('parent_state_present', (ROOT/'state/parent-r27-accepted-state.pkl').is_file())
ck('parent_state_sha', sha(ROOT/'state/parent-r27-accepted-state.pkl')==summary['canonical_parent']['state_sha256'])
ck('parent_policy_present', (ROOT/'state/parent-r27-accepted-policy.json').is_file())
ck('r27_verifier_33', '"checks_passing": 33' in read('verification/r27_parent_rerun.log') and '"status": "PASS"' in read('verification/r27_parent_rerun.log'))
ck('r26_regression_47', '47' in read('verification/r26_regression_rerun.log') and 'PASS' in read('verification/r26_regression_rerun.log'))
ck('r25_lineage_68', '68' in read('verification/r25_lineage_rerun.log') and 'PASS' in read('verification/r25_lineage_rerun.log'))
ck('source_sha', sha(ROOT/'src/tnn_r28_aeif.zag')==summary['candidate_source']['sha256'])
ck('source_contract_18', audit['status']=='PASS' and audit['checks_passing']==18 and audit['checks_total']==18)
ck('aeif_authority', 'AEIF' in source and summary['candidate_architecture']['identity_authority']=='AEIF_ASSOCIATIVE_EPISODIC')
ck('graph_not_identity_authority', summary['candidate_architecture']['graph']=='OPTIONAL_DERIVED_INDEX_NOT_IDENTITY_AUTHORITY' and 'graph_identity_authority",0' in source)
ck('memory_default_tnn_override', summary['candidate_architecture']['memory']=='PRIVILEGED_HEURISTIC_DEFAULT_TNN_OVERRIDE_LRU_EVICTION_ONLY' and audit['checks']['memory_heuristic_default'] and audit['checks']['memory_tnn_override'])
ck('lru_not_authority', audit['checks']['lru_not_authority'] and 'lru_representation_authority",0' in source)
ck('innate_system_fluency', audit['checks']['innate_system_fluency'])
ck('substrate_foundry', audit['checks']['substrate_agnostic_foundry'])
ck('no_named_labels', audit['checks']['no_named_object_labels'] and audit['checks']['no_human_category_names'])
ck('no_transformer_runtime', audit['checks']['no_transformer_runtime'])
ck('trace_parent_links', audit['checks']['trace_parent_links'])
ck('learned_reliability', audit['checks']['reliability_is_learnable'] and audit['checks']['no_fixed_entity_switch_700'])
ck('integrated_multiseed_present', j('results/integrated_r28/multiseed_summary.json')['nominal']['n_seeds']==5)
ck('memory_12seed_present', next(x for x in j('results/memory_v6/memory_v6.json')['summary'] if x['policy']=='HEURISTIC_DEFAULT_TNN_OVERRIDE_LRU')['n']==12)
ck('foundry_v2_present', j('results/substrate_foundry_v2/substrate_foundry_v2_combined.json')['status']=='REFERENCE_ONLY_NOT_NATIVE_ZAG')
ck('hard_name_present', j('results/name_hard/summary.json')['n']==5)
ck('hard_sibling_present', j('results/sibling_hard/summary.json')['n']==5)
ck('context_affordance_present', j('results/affordance_context/summary.json')['n']==5)
ck('speech_boundary_locked', summary['primary_open_failure']=='HARD_CONNECTED_SPEECH_SEQUENCE_FORMATION_AND_CONTEXT_CONDITIONED_ACOUSTICS' and summary['key_results']['integrated_hard_5seed']['speech']<0.5)
ck('ctc_failure_preserved', j('results/speech_ctc/s0_fixed.json')['test_accuracy']==0.0 and j('results/speech_ctc_blank/s0_pretrain.json')['test_accuracy']<0.1)
ck('broad_claims_locked', all(v is False for v in summary['claim_locks'].values()))
ck('native_is_blocked_not_pass', summary['candidate_source']['native_compile']=='BLOCKED_ENV_NO_LOCAL_ZNC' and 'Could not resolve host: github.com' in read('verification/native_toolchain_audit.log'))
required=['README.md','docs/RESULTS.md','docs/FAILURES_AND_BOUNDARIES.md','docs/HARDCODING_LEDGER.md','docs/AUTHORSHIP_LEDGER.md','docs/MEMORY_POLICY.md','docs/NEXT_STAGE_HANDOFF.md','docs/TRACEABILITY.md','state/r28-shadow-policy.json','results/final_summary.json','user_context/TNN_USER_RESEARCH_PREFERENCES.md','user_context/TNN_USER_RESPONSE_LOG.md']
for f in required: ck('required:'+f,(ROOT/f).is_file() and (ROOT/f).stat().st_size>0)
failed=[k for k,v in checks.items() if not v]
out={'status':'PASS_SHADOW_INTEGRITY' if not failed else 'FAIL','checks_passing':sum(checks.values()),'checks_total':len(checks),'failed':failed,'native_r28_execution':'BLOCKED_ENV','canonical_promotion':False,'source_sha256':summary['candidate_source']['sha256'],'parent_digest':summary['canonical_parent']['digest']}
print(json.dumps(out,indent=2))
(ROOT/'verification/r28-shadow-verify.json').write_text(json.dumps({'summary':out,'checks':checks},indent=2))
sys.exit(0 if not failed else 1)

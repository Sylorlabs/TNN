#!/usr/bin/env python3
import json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent))
from integrated_r28 import motif_template
from speech_integrated_train_r28 import vary_int

def rs(z,W=24):
 x=np.interp(np.linspace(0,len(z)-1,W),np.arange(len(z)),z);return (x-x.mean())/(x.std()+1e-8)
def sm(x,k):
 if k<=1:return x
 p=k//2;return np.convolve(np.pad(x,(p,p),mode='edge'),np.ones(k)/k,mode='valid')[:len(x)]
def feat(z,mode,W=24):
 x=rs(z,W)
 if mode=='raw':return x
 if mode=='smooth3':return sm(x,3)
 if mode=='smooth5':return sm(x,5)
 if mode=='multiscale':return np.r_[x,sm(x,3),sm(x,5)]
 if mode=='deriv_smooth':
  y=sm(x,3);return np.r_[y,np.diff(y,prepend=y[0])]
 if mode=='dctlike':
  # real low-frequency spectrum retaining phase via rfft real+imag
  f=np.fft.rfft(sm(x,3));n=8;return np.r_[f.real[:n],f.imag[:n]]
 if mode=='shape':
  y=sm(x,5);d=np.diff(y,prepend=y[0]);return np.r_[y,d,sm(d,3)]
 raise ValueError(mode)
def train(seed,bases,mode,n=80):
 r=np.random.default_rng(seed);rows=[]
 for e in range(len(bases)):
  X=np.stack([feat(vary_int(bases[e],r),mode) for _ in range(n)]);rows.append((X.mean(0),X.std(0)+.20))
 return rows
def pred(z,models,mode):
 x=feat(z,mode);sc=[np.mean(((x-m)/sd)**2) for m,sd in models];return int(np.argmin(sc))
def synth_meta(templates,ids,r):
 out=[];sp=[]
 for ii,e in enumerate(ids):
  z=vary_int(templates[e],r);st=len(out)
  if ii>0 and len(out)>3:
   b=min(4,len(z),len(out))
   for j in range(b):
    a=(j+1)/(b+1);out[-b+j]=(1-a)*out[-b+j]+a*z[j]
   z=z[b:];st=len(out)
  out.extend(z.tolist());sp.append((st,len(out),e))
 return np.array(out),sp
def run(seed=281000):
 bases={e:motif_template(seed+1200,e) for e in range(24)};modes=['raw','smooth3','smooth5','multiscale','deriv_smooth','dctlike','shape'];out=[]
 for mode in modes:
  models=train(seed+500,bases,mode);r=np.random.default_rng(seed+8000);iso=[];edge=[]
  for e in range(24):
   for _ in range(25):iso.append(pred(vary_int(bases[e],r),models,mode)==e)
  for q in range(100):
   e=q%24;ids=[(e+3)%24,e,(e+7)%24];x,sp=synth_meta(bases,ids,r)
   for st,en,m in sp:edge.append(pred(x[max(0,st-4):en],models,mode)==m)
  out.append({'mode':mode,'isolated':float(np.mean(iso)),'edge_pre4':float(np.mean(edge))})
 return {'seed':seed,'rows':out}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/acoustic_rep_tournament.json').write_text(json.dumps(o,indent=2))

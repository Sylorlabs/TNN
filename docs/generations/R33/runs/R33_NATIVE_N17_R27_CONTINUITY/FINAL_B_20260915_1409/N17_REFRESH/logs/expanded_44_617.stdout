import sys,json,time,os
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from substrate_foundry import search
out='/mnt/data/tnn-r28-aeif-no-graph/results/substrate_foundry'
os.makedirs(out,exist_ok=True)
for si in range(1,6):
  for m in ['RANDOM','EVOLUTION','SURROGATE','LEARNED_MUTATION','HYBRID']:
    p=f'{out}/seed{si}_{m}.json'
    if os.path.exists(p):
      print('skip',si,m,flush=True); continue
    st=time.time(); r=search(m,290000+si*113,budget=72)
    open(p,'w').write(json.dumps(r,indent=2))
    print('done',si,m,round(time.time()-st,1),round(r['hidden_overall'],4),round(r['hidden_floor'],4),'graph',r['graph_authority'],'active',r['active'],flush=True)
print('ALL_DONE',flush=True)

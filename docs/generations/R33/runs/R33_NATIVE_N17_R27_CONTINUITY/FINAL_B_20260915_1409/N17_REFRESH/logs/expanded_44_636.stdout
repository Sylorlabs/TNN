#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,sys
from pathlib import Path
from collections import defaultdict
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from entity_aeif_factorial import World,render,Rep,Model,eval_model,MODES
from deep_training_all import ARCHS,DOSES,KINDS,mode_orders

def build(seed,out):
 w=World(seed);A=np.empty((len(w.bases),DOSES[-1],32),dtype=np.float32)
 for e,b in enumerate(w.bases):
  for j in range(DOSES[-1]):
   k=KINDS[j%len(KINDS)];A[e,j]=render(b,k,np.random.default_rng(seed*100003+e*997+j))
 np.savez_compressed(out,A=A,bases=w.bases,twins=w.twins,afford=w.afford,names=w.names)
 print('built',seed,A.shape)

def load_world(npz):
 z=np.load(npz);w=World(1,n=len(z['bases']),d=z['bases'].shape[1]);w.bases=z['bases'];w.twins=z['twins'];w.afford=z['afford'];w.names=z['names'];A=z['A'].astype(float)
 pool=[[(KINDS[j%len(KINDS)],A[e,j]) for j in range(A.shape[1])] for e in range(A.shape[0])]
 return w,pool

def run_mode(seed,npz,mode,out,n_trials=2):
 w,pool=load_world(npz);orders=mode_orders(w,pool,mode,seed+909+abs(hash(mode))%10000);rows=[]
 for dose in DOSES:
  views=[np.stack([pool[e][i][1] for i in orders[e][:dose]]) for e in range(len(pool))];rep=Rep(views)
  for a in ARCHS:
   met=eval_model(Model(a,rep,w,seed+333),w,seed+1000+dose*3,n_trials);rows.append({'seed':seed,'mode':mode,'dose':dose,'arch':a,'graph':a.startswith('G_'),**met})
  print('dose',dose,'done',flush=True)
 Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','seed':seed,'mode':mode,'rows':rows},indent=2));print('rows',len(rows))

def combine(files,out):
 rows=[]
 for f in files:rows+=json.loads(Path(f).read_text())['rows']
 g=defaultdict(list)
 for r in rows:g[(r['arch'],r['mode'],r['dose'])].append(r)
 s=[]
 for (a,m,d),rs in g.items():
  z={'arch':a,'mode':m,'dose':d,'graph':a.startswith('G_'),'n':len(rs)}
  for k in ['overall','floor','viewpoint','occlusion80','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption','compound','extra_rate']:
   v=np.array([r[k] for r in rs]);z[k]=float(v.mean());z[k+'_sd']=float(v.std())
  s.append(z)
 curves=[]
 for a in ARCHS:
  for m in MODES:
   ss=sorted([x for x in s if x['arch']==a and x['mode']==m],key=lambda x:x['dose'])
   if not ss:continue
   tail=ss[-4:];den=max(1e-9,np.log2(tail[-1]['dose'])-np.log2(tail[0]['dose']));slope=(tail[-1]['overall']-tail[0]['overall'])/den
   curves.append({'arch':a,'mode':m,'final_dose':ss[-1]['dose'],'final_overall':ss[-1]['overall'],'final_floor':ss[-1]['floor'],'tail_gain':tail[-1]['overall']-tail[0]['overall'],'gain_per_doubling':float(slope),'classification':'PLATEAU' if abs(slope)<.01 else 'IMPROVING' if slope>0 else 'REGRESSING'})
 Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'summary':s,'curves':curves},indent=2));print(json.dumps(sorted(curves,key=lambda x:(x['final_floor'],x['final_overall']),reverse=True)[:30],indent=2))

if __name__=='__main__':
 ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);b=sp.add_parser('build');b.add_argument('--seed',type=int,required=True);b.add_argument('--out',required=True);m=sp.add_parser('mode');m.add_argument('--seed',type=int,required=True);m.add_argument('--npz',required=True);m.add_argument('--mode',required=True);m.add_argument('--out',required=True);m.add_argument('--n-trials',type=int,default=2);c=sp.add_parser('combine');c.add_argument('--out',required=True);c.add_argument('files',nargs='+');x=ap.parse_args();
 if x.cmd=='build':build(x.seed,x.out)
 elif x.cmd=='mode':run_mode(x.seed,x.npz,x.mode,x.out,x.n_trials)
 else:combine(x.files,x.out)

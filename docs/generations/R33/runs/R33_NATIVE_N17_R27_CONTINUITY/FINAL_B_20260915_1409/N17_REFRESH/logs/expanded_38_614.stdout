#!/usr/bin/env python3
import sys,json
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent)); import speech_r28 as s

def phrase_meta(bases,ids,r,hard=True):
 out=[];spans=[]
 for ii,e in enumerate(ids):
  z=s.vary(bases[e],r,hard); start=len(out)
  if hard and ii>0 and len(out)>4:
   b=min(5,len(z),len(out))
   for j in range(b):
    a=(j+1)/(b+1);out[-b+j]=(1-a)*out[-b+j]+a*z[j]
   z=z[b:];start=len(out)
  out.extend(z);spans.append((start,len(out),e))
 arr=np.asarray(out,float)
 if hard:arr+=.12*np.sin(np.linspace(0,3*np.pi,len(arr)))+r.normal(0,.08,len(arr))
 return arr,spans

def run(seed=282000,trials=100):
 bases={e:s.base_template(seed,e) for e in range(12)};P,d=s.learn_protos(seed+100,bases);r=np.random.default_rng(seed+9000)
 acc=[];margin=[];edge_acc=[]
 for _ in range(trials):
  ids=r.choice(12,4,replace=False).tolist();x,sp=phrase_meta(bases,ids,r,True)
  for i,(st,en,e) in enumerate(sp):
   # evaluator span for diagnostic only
   cc=s.cost_all(x[st:en],P,d,'multi_combined');o=np.argsort(cc);acc.append(int(o[0]==e));margin.append(float(cc[o[1]]-cc[o[0]]))
   # include preceding blended tail around boundary
   lo=max(0,st-5);cc2=s.cost_all(x[lo:en],P,d,'multi_combined');edge_acc.append(int(np.argmin(cc2)==e))
 return {'seed':seed,'trials':trials,'true_span_accuracy':float(np.mean(acc)),'edge_span_accuracy':float(np.mean(edge_acc)),'mean_margin':float(np.mean(margin))}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/boundary_diagnostic.json').write_text(json.dumps(o,indent=2))

#!/usr/bin/env python3
import sys,argparse,json
from pathlib import Path
import numpy as np
from numba import njit
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments');import speech_r28 as s

@njit(cache=True)
def dtw(a,b,band=7):
 n=len(a);m=len(b);inf=1e12;prev=np.full(m+1,inf);cur=np.full(m+1,inf);prev[0]=0.
 for j in range(1,min(5,m)+1):prev[j]=.025*j
 for i in range(1,n+1):
  cur[:]=inf
  if i<=3:cur[0]=.04*i
  cen=int(i*m/max(1,n));lo=max(1,cen-band);hi=min(m,cen+band)
  for j in range(lo,hi+1):
   d=(a[i-1]-b[j-1])**2;v=prev[j]
   if prev[j-1]<v:v=prev[j-1]
   if cur[j-1]<v:v=cur[j-1]
   cur[j]=d+v
  prev,cur=cur,prev
 best=1e12
 for j in range(max(1,m-4),m+1):
  v=prev[j]+.025*(m-j)
  if v<best:best=v
 return best/max(1,n)

@njit(cache=True)
def motif_cost(seg,Ps):
 mu=np.mean(seg);sd=(np.mean((seg-mu)**2)+1e-8)**.5;z=(seg-mu)/sd;best=1e12
 for k in range(Ps.shape[0]):
  v=dtw(z,Ps[k])
  if v<best:best=v
 return best

def evidence_field(x,P,dur):
 N=len(x);M=len(P);E=np.full((N,M),9.0);bestlen=np.zeros((N,M),int)
 for c in range(N):
  for m in range(M):
   mu,sd=dur[m]
   lens=set([max(8,int(round(mu-sd))),max(8,int(round(mu))),max(8,int(round(mu+sd)))])
   for L in lens:
    for frac in (.42,.5,.58):
     st=int(round(c-frac*L));en=st+L
     if st<0 or en>N:continue
     v=motif_cost(np.asarray(x[st:en],np.float64),P[m])
     if v<E[c,m]:E[c,m]=v;bestlen[c,m]=L
 return E,bestlen

def decode(x,P,dur,count=4):
 E,L=evidence_field(x,P,dur);N,M=E.shape
 # center-order DP. A motif occupies roughly its learned duration; allow overlap due coarticulation.
 INF=1e9;dp=np.full((count,N,M),INF);back={}
 # first motif should begin near phrase start, not a provided boundary
 for c in range(N):
  for m in range(M):
   start=c-.5*L[c,m]
   dp[0,c,m]=E[c,m]+.018*abs(start)
 for k in range(1,count):
  for c in range(N):
   for m in range(M):
    if E[c,m]>=8.9:continue
    best=INF;bp=None
    for pc in range(max(0,c-36),c):
     for pm in range(M):
      if pm==m:continue
      gap=c-pc-.5*(L[pc,pm]+L[c,m])
      if gap < -8 or gap > 14:continue
      v=dp[k-1,pc,pm]+E[c,m]+.010*abs(gap)
      if v<best:best=v;bp=(pc,pm)
    if bp is not None:dp[k,c,m]=best;back[(k,c,m)]=bp
 best=INF;state=None
 for c in range(N):
  for m in range(M):
   end=c+.5*L[c,m];v=dp[count-1,c,m]+.018*abs(end-N)
   if v<best:best=v;state=(count-1,c,m)
 if state is None:return []
 seq=[]
 while state[0]>=0:
  k,c,m=state;seq.append(m)
  if k==0:break
  pc,pm=back[state];state=(k-1,pc,pm)
 return seq[::-1]

def run(seed,trials=30):
 bases={e:s.base_template(seed,e) for e in range(12)};P,d=s.learn_protos(seed+100,bases,K=8);r=np.random.default_rng(seed+500)
 _=motif_cost(np.asarray(s.vary(bases[0],r,True),float),P[0])
 vals=[];exact=[]
 for q in range(trials):
  ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True);dec=decode(x,P,d,4);a=sum(i==j for i,j in zip(dec,ids))/4 if len(dec)==4 else 0;vals.append(a);exact.append(a==1)
 return {'seed':seed,'trials':trials,'accuracy':float(np.mean(vals)),'exact':float(np.mean(exact))}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--trials',type=int,default=30);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed,a.trials);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

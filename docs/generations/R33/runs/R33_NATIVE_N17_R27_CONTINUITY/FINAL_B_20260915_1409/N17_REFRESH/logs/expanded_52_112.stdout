#!/usr/bin/env python3
from __future__ import annotations
import csv, hashlib, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
checks={}

def loadj(rel):return json.loads((ROOT/rel).read_text(encoding='utf-8'))
def first_csv(rel):
    with (ROOT/rel).open(newline='',encoding='utf-8') as f:return next(csv.DictReader(f))
def run(cmd,**kw):return subprocess.run(cmd,check=True,text=True,capture_output=True,**kw)

# Syntax and core audit.
py=sorted((ROOT/'src').glob('*.py'))
run([sys.executable,'-m','py_compile',*[str(x) for x in py]])
audit=json.loads(run([sys.executable,str(ROOT/'src/audit_cognitive_core.py'),str(ROOT/'src/run_goldilocks_tournament.py')]).stdout)
checks['core_audit_pass']=audit['pass'] is True
checks['core_fixed_vocabulary']=audit['fixed_vocabulary_reference']==0
checks['core_whitespace_tokenizer']=audit['whitespace_tokenizer_calls']==0

# Evidence completeness and locked boundaries.
broad=loadj('results/broad_aggregate/status.json')
b512=loadj('results/training_confirmation_b512_aggregate/status.json')
b1024=loadj('results/training_confirmation_b1024_aggregate/status.json')
arch=loadj('results/architecture_confirmation_b512_aggregate/status.json')
disc=loadj('results/discourse_workspace_confirmation/status.json')
teen=loadj('results/teenager_boundary_gate_v6/status.json')
checks['broad_240_runs']=broad['complete'] and broad['runs']==240 and broad['conditions']==80
checks['b512_complete']=b512['complete'] and b512['runs']==30 and b512['conditions']==6 and len(b512['seeds'])==5
checks['b1024_complete']=b1024['complete'] and b1024['runs']==12 and b1024['conditions']==4 and len(b1024['seeds'])==3
checks['architecture_complete']=arch['complete'] and arch['runs']==12 and arch['conditions']==4
checks['medium_winner']=b512['history_ranking'][0]['history']=='noisy_then_clean'
checks['large_winner']=b1024['history_ranking'][0]['history']=='noisy_then_clean'
checks['architecture_winner']=arch['architecture_ranking'][0]['architecture']=='recurrent_pam'
checks['discourse_promoted']=disc['promotion']['selected'] and disc['workspace']['reference_exact_mean']>=.99 and disc['promotion']['controlled_regression_pass']
checks['teenager_locked']=teen['teenager_english']=='NOT_MET'
checks['adult_locked']=teen['adult_english']=='NOT_MET'
checks['production_locked']=teen['production_tnn_v1']=='NOT_PROMOTED'
checks['hard_gate_discourse']=teen['required_gates']['multi_sentence_reference'] is True
checks['hard_gate_one_shot_open']=teen['required_gates']['one_shot_grounded_label'] is False
checks['hard_gate_generation_open']=teen['required_gates']['free_form_generation'] is False

# Media can be decoded without invoking any pretrained semantic model.
import cv2
from scipy.io import wavfile
cap=cv2.VideoCapture(str(ROOT/'media/sample_development_episode.mp4'))
frames=0
while True:
    ok,_=cap.read()
    if not ok:break
    frames+=1
cap.release()
sr,wav=wavfile.read(ROOT/'media/sample_development_episode.wav')
checks['media_video_frames']=frames==8
checks['media_audio']=sr==8000 and len(wav)==2048

# Deterministic metric smoke: runtime fields are intentionally excluded.
def smoke(out):
    run([sys.executable,str(ROOT/'src/run_goldilocks_tournament.py'),'--out',str(out),'--seed-values','777','--budget','64','--train','96','--test','32','--architectures','recurrent_pam','--histories','noisy_then_clean','--quiet'])
    with (out/'raw_runs.csv').open(newline='',encoding='utf-8') as f:r=next(csv.DictReader(f))
    r.pop('runtime_seconds',None)
    return r
with tempfile.TemporaryDirectory() as td:
    a=smoke(Path(td)/'a');b=smoke(Path(td)/'b')
checks['deterministic_smoke_metrics']=a==b

failed=[k for k,v in checks.items() if not v]
print(json.dumps({'checks':checks,'failed':failed,'pass':not failed},indent=2,sort_keys=True))
raise SystemExit(1 if failed else 0)

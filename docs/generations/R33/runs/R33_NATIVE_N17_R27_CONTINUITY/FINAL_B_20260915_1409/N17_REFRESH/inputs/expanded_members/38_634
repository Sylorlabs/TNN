#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,sys
from pathlib import Path
from collections import defaultdict
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph')
from experiments_memory_v3 import POLICIES,make_episode,simulate

def seed_run(si,out,dev_n=2600):
 dr=np.random.default_rng(281000+si);dev=[make_episode(dr,i) for i in range(dev_n)];rows=[]
 for p in POLICIES:
  rows.append(simulate(p,282000+si+abs(hash(p))%9000,dev)); print(p,'done',flush=True)
 Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE','seed_index':si,'dev_history':dev_n,'rows':rows},indent=2))
 print('seed',si,'complete')

def combine(files,out):
 rows=[]
 for f in files:rows += json.loads(Path(f).read_text())['rows']
 g=defaultdict(list)
 for r in rows:g[r['policy']].append(r)
 s=[]
 for p,rs in g.items():
  z={'policy':p,'n':len(rs)}
  for k in ['overall','exact','semantic','source','procedure','mean_storage','evictions']:
   v=np.array([r[k] for r in rs],float);z[k]=float(v.mean());z[k+'_sd']=float(v.std())
  z['utility']=.38*z['exact']+.19*z['semantic']+.19*z['source']+.24*z['procedure']-.0001*z['mean_storage'];s.append(z)
 s=sorted(s,key=lambda x:x['utility'],reverse=True);Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE','rows':rows,'summary':s},indent=2));print(json.dumps(s,indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);a=sp.add_parser('seed');a.add_argument('--index',type=int,required=True);a.add_argument('--out',required=True);a.add_argument('--dev-n',type=int,default=2600);b=sp.add_parser('combine');b.add_argument('--out',required=True);b.add_argument('files',nargs='+');x=ap.parse_args();seed_run(x.index,x.out,x.dev_n) if x.cmd=='seed' else combine(x.files,x.out)

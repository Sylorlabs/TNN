import sys,json,argparse,time
from pathlib import Path
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
import speech_r28 as s

def build_variants(P,max_trim=5):
    # P: M,K,W. Make endpoint-trim variants resampled back to W.
    M,K,W=P.shape
    variants=[]
    for m in range(M):
        vv=[]
        for k in range(K):
            p=P[m,k]
            for ls in range(max_trim+1):
                for rt in range(max_trim+1):
                    if W-ls-rt < 9: continue
                    z=p[ls:W-rt if rt else W]
                    rr=np.interp(np.linspace(0,len(z)-1,W),np.arange(len(z)),z)
                    rr=(rr-rr.mean())/(rr.std()+1e-8)
                    vv.append((rr,ls,rt))
        variants.append((np.stack([x[0] for x in vv]), np.array([x[1]+x[2] for x in vv],float)))
    return variants

def trim_cost(seg,variants,dur,topn=1):
    W=variants[0][0].shape[1]; rr=s.normseg(seg,W); dr=np.diff(rr)
    out=[]
    for m,(V,T) in enumerate(variants):
        mse=np.mean((V-rr[None,:])**2,axis=1)
        dmse=np.mean((np.diff(V,axis=1)-dr[None,:])**2,axis=1)
        vals=mse+.45*dmse+.004*T
        best=float(np.min(vals))
        mu,sd=dur[m];best += .008*((len(seg)-mu)/sd)**2
        out.append(best)
    return np.asarray(out)

def decode_trim(samples,variants,dur,count,min_d=7,max_d=34,max_shift=6,beam=220,top_m=3):
    N=len(samples); costs={}
    for st in range(N):
        for d in range(min_d,min(max_d,N-st)+1):
            costs[(st,d)]=trim_cost(samples[st:st+d],variants,dur)
    states=[(0.,0,[])]
    for k in range(count):
        nxt=[]
        for base,pend,seq in states:
            shifts=range(0,8) if k==0 else range(-max_shift,max_shift+1)
            for sh in shifts:
                st=pend+sh
                if st<0 or st>=N: continue
                for d in range(min_d,min(max_d,N-st)+1):
                    cc=costs[(st,d)]; inds=np.argpartition(cc,min(top_m,len(cc))-1)[:top_m]
                    for mm in inds:
                        m=int(mm);v=base+float(cc[m])+.010*abs(sh)
                        # avoid duplicate consecutive identity only weakly (phrases have distinct IDs in current battery)
                        if seq and seq[-1]==m:v+=.035
                        nxt.append((v,st+d,seq+[m]))
        if not nxt:return []
        # coverage-aware beam, diversity
        nxt.sort(key=lambda z:z[0]+.014*abs(z[1]-N*(k+1)/count))
        keep=[];seen=set()
        for z in nxt:
            key=(z[1]//2,z[2][-1],tuple(z[2][-2:]))
            if key in seen:continue
            seen.add(key);keep.append(z)
            if len(keep)>=beam:break
        states=keep
    return min(states,key=lambda z:z[0]+.020*abs(z[1]-N))[2]

def run(seed,trials=30):
    bases={e:s.base_template(seed,e) for e in range(12)}
    P,d=s.learn_protos(seed+100,bases,K=8);V=build_variants(P,5);r=np.random.default_rng(seed+500)
    vals=[];exact=[];basevals=[]
    for q in range(trials):
        ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True)
        dec=decode_trim(x,V,d,4)
        a=sum(i==j for i,j in zip(dec,ids))/4 if len(dec)==4 else 0
        vals.append(a);exact.append(a==1)
        dec2=s.decode_beam(x,P,d,4,beam=150,top_m=2)
        b=sum(i==j for i,j in zip(dec2,ids))/4 if len(dec2)==4 else 0;basevals.append(b)
    return {'seed':seed,'trials':trials,'trim_accuracy':float(np.mean(vals)),'trim_exact':float(np.mean(exact)),'beam_accuracy':float(np.mean(basevals))}

if __name__=='__main__':

#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,sys
from pathlib import Path
from collections import defaultdict
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r27-factorial-master/experiments')
from entity_factorial import make_world,candidate_pool,select_training,TRANSFORMS
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph')
from experiments_aeif_factorial import IdentityModel,evaluate

ARCHS=['AE_ACTIVE','AEIF_FULL','AE_PURE','G_ACTIVE']
MODES=['RANDOM_EXPOSURE','BALANCED_EXPOSURE','MAX_DIVERSITY','ADAPTIVE_MASTER','CONTRASTIVE','COUNTEREXAMPLE_HEAVY','ACTIVE_SELF','TNN_REPLAY','SIBLING_ASSISTED','MASTER_TO_DIVERSE','MIXED']
DOSES=[1,2,4,8,16,32,64,128]

def uniq(seq):
 out=[];seen=set()
 for x in seq:
  k=x.tobytes()
  if k not in seen:out.append(x);seen.add(k)
 return out

def choose(world,pool,mode,dose,seed):
 mapping={'RANDOM_EXPOSURE':'RANDOM_PASSIVE','BALANCED_EXPOSURE':'BALANCED_DIVERSE','ADAPTIVE_MASTER':'ADAPTIVE_MASTER','CONTRASTIVE':'CONTRASTIVE','MASTER_TO_DIVERSE':'MASTER_WITHDRAWAL'}
 if mode in mapping:return select_training(world,pool,mapping[mode],dose,seed)

 if mode in ('MAX_DIVERSITY','ACTIVE_SELF'):
  res=[]
  for e,rows in enumerate(pool):
   X=np.stack([v for _,v in rows]);chosen=[0];mind=np.linalg.norm(X-X[0],axis=1);mind[0]=-1
   while len(chosen)<min(dose,len(rows)):
    j=int(np.argmax(mind));chosen.append(j);mind=np.minimum(mind,np.linalg.norm(X-X[j],axis=1));mind[chosen]=-1
   res.append([rows[i][1] for i in chosen])
  return res
 if mode=='SIBLING_ASSISTED':
  h=max(1,dose//2);a=select_training(world,pool,'BALANCED_DIVERSE',h,seed);b=select_training(world,pool,'CONTRASTIVE',dose-h,seed+17);return [uniq(x+y)[:dose] for x,y in zip(a,b)]
 if mode=='MIXED':
  h=max(1,dose//3);a=select_training(world,pool,'ADAPTIVE_MASTER',h,seed);b=choose(world,pool,'MAX_DIVERSITY',h,seed+11);c=select_training(world,pool,'CONTRASTIVE',max(0,dose-h-h),seed+23);return [uniq(x+y+z)[:dose] for x,y,z in zip(a,b,c)]
 rng=np.random.default_rng(seed);res=[]
 for e,rows in enumerate(pool):
  if mode=='COUNTEREXAMPLE_HEAVY':
   # focus on most distorted own views + near-twin-similar views; teacher supplies contrasts, not identity answers at test.
   twin=world.twin_of[e];center=pool[twin][0][1] if twin>=0 else rows[0][1]
   pri={'hard_permute':4,'occlude55':4,'noise':3,'occlude30':3,'scale_light':2,'permute':1,'clean':0}
   ids=sorted(range(len(rows)),key=lambda i:(pri.get(rows[i][0],0),-np.linalg.norm(rows[i][1]-center)),reverse=True)[:dose]
  elif mode=='TNN_REPLAY':
   # self-select high novelty relative to its first few own experiences.
   base=[rows[i][1] for i in range(min(4,len(rows)))];ids=sorted(range(len(rows)),key=lambda i:min(np.linalg.norm(rows[i][1]-b) for b in base),reverse=True)[:dose]
  elif mode=='SIBLING_ASSISTED':
   # independent sibling supplies diverse observations: combine balanced and twin-discriminating views.
   bal=select_training(world,pool,'BALANCED_DIVERSE',max(1,dose//2),seed)[e];con=select_training(world,pool,'CONTRASTIVE',dose-max(1,dose//2),seed+17)[e];vals=uniq(bal+con);res.append(vals[:dose]);continue
  elif mode=='MIXED':
   a=select_training(world,pool,'ADAPTIVE_MASTER',max(1,dose//3),seed)[e];b=select_training(world,pool,'ACTIVE_SELF',max(1,dose//3),seed+11)[e];c=select_training(world,pool,'CONTRASTIVE',dose-len(a)-len(b),seed+23)[e];vals=uniq(a+b+c);res.append(vals[:dose]);continue
  else:raise ValueError(mode)
  res.append([rows[i][1] for i in ids])
 return res

def run(out,seed,mode):
 world=make_world(seed);pool=candidate_pool(world,seed,per_entity=128);rows=[]
 for dose in DOSES:
  views=choose(world,pool,mode,dose,seed+dose*31)
  for arch in ARCHS:
   m=IdentityModel(arch).fit(views,world,seed+abs(hash((arch,mode,dose)))%5000);met=evaluate(m,world,seed+177,n=1);rows.append({'seed':seed,'training':mode,'dose':dose,'arch':arch,**met})
 print('done',seed,mode,flush=True);Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE','rows':rows},indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--out',required=True);ap.add_argument('--seed',type=int,required=True);ap.add_argument('--mode',required=True);a=ap.parse_args();run(a.out,a.seed,a.mode)

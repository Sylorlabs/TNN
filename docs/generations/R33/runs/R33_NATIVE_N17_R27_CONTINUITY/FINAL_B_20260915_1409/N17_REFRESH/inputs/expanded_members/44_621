#!/usr/bin/env python3
from __future__ import annotations
import argparse,json
from pathlib import Path
from collections import defaultdict
import numpy as np
import sys
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph')
from experiments_memory_v3 import make_episode,feat,sufficient,COST,fixed_choose

POL=['HEURISTIC_LOCKED_LRU_EVICT','HEURISTIC_DEFAULT_TNN_OVERRIDE_LRU','HEURISTIC_DEFAULT_TNN_OVERRIDE_VALUE','LRU_REPRESENTATION_CONTROL','EXACT_ALL_CONTROL','STRUCTURED_ALL_CONTROL']

class ResidualOverride:
    def __init__(self,lr=.045):
        self.W=np.zeros((4,8));self.N=np.zeros(4);self.lr=lr
    def choose(self,r,default,pressure):
        x=feat(r); residual=self.W@x
        # Default remains authoritative until learned evidence predicts a meaningful gain.
        best=int(np.argmax(residual));
        if residual[best] > residual[default]+.20:return best
        return default
    def update(self,r,default,q,importance,pressure):
        x=feat(r)
        # Once the delayed need arrives, storage semantics let TNN evaluate all four
        # representation actions without an evaluator answer table.
        target=[]
        for a in range(4):
            ok=1.0 if sufficient(a,q) else 0.0
            hot=.10*r['retrieval'] if a==0 else .02*r['retrieval'] if a==1 else 0.0
            val=importance*(2*ok-1)+hot-(.03+.24*pressure)*COST[a]
            target.append(val)
        td=np.array(target)-target[default]
        for a in range(4):
            pred=float(self.W[a]@x);err=float(td[a]-pred);self.W[a]+=self.lr*err*x/(1+np.dot(x,x));self.N[a]+=1
    def value(self,r,a,pressure):return float(self.W[a]@feat(r)-(.03+.24*pressure)*COST[a])

def default_action(r,i,rng):return fixed_choose('PRIVILEGED_HEURISTIC_CONTROL',r,i,rng)
def rep_control(r,i,rng):return 0 if i%5==0 else 2

def simulate(policy,seed,n=1500,budget=760):
    rng=np.random.default_rng(seed);learner=ResidualOverride() if 'TNN_OVERRIDE' in policy else None
    entries={};episodes=[];queries=defaultdict(list);used=0.;by=defaultdict(list);storage=[];evict=0;overrides=0
    for i in range(n):
        r=make_episode(rng,i);episodes.append(r);pressure=min(1.,used/budget)
        if policy.startswith('HEURISTIC'):
            d=default_action(r,i,rng);a=learner.choose(r,d,pressure) if learner else d;overrides+=int(a!=d)
        elif policy=='LRU_REPRESENTATION_CONTROL':d=a=rep_control(r,i,rng)
        elif policy=='EXACT_ALL_CONTROL':d=a=0
        else:d=a=2
        entries[i]={'a':a,'default':d,'r':r,'last':i,'pressure':pressure};used+=COST[a];queries[i+r['delay']].append(i)
        while used>budget:
            cand=[(eid,e) for eid,e in entries.items() if COST[e['a']]>0]
            if not cand:break
            if policy=='HEURISTIC_DEFAULT_TNN_OVERRIDE_VALUE' and learner:
                eid,e=min(cand,key=lambda z:learner.value(z[1]['r'],z[1]['a'],min(1.,used/budget))/(COST[z[1]['a']]+.1))
            else:
                # LRU is only eviction mechanics here.
                eid,e=min(cand,key=lambda z:z[1]['last'])
            used-=COST[e['a']];del entries[eid];evict+=1
        for eid in queries.get(i,[]):
            rr=episodes[eid];e=entries.get(eid);a=e['a'] if e else 3;ok=e is not None and sufficient(a,rr['q']);by[rr['q']].append(bool(ok))
            if learner:
                d=e['default'] if e else default_action(rr,eid,rng);learner.update(rr,d,rr['q'],rr['importance'],min(1.,used/budget))
            if e:e['last']=i
        storage.append(used)
    for t in range(n,n+340):
        for eid in queries.get(t,[]):
            rr=episodes[eid];e=entries.get(eid);a=e['a'] if e else 3;ok=e is not None and sufficient(a,rr['q']);by[rr['q']].append(bool(ok))
            if learner:
                d=e['default'] if e else default_action(rr,eid,rng);learner.update(rr,d,rr['q'],rr['importance'],min(1.,used/budget))
    allv=[x for v in by.values() for x in v]
    return {'policy':policy,'seed':seed,'overall':float(np.mean(allv)),'exact':float(np.mean(by[0])),'semantic':float(np.mean(by[1])),'source':float(np.mean(by[2])),'procedure':float(np.mean(by[3])),'mean_storage':float(np.mean(storage)),'evictions':evict,'override_rate':overrides/n}

def run(out,seeds=12):
    rows=[]
    for s in range(seeds):
        for pi,p in enumerate(POL):rows.append(simulate(p,291000+s*127+pi*5003))
        print('seed',s,'done',flush=True)
    summ=[]
    for p in POL:
        rr=[x for x in rows if x['policy']==p];z={'policy':p,'n':len(rr)}
        for k in ['overall','exact','semantic','source','procedure','mean_storage','evictions','override_rate']:
            q=np.array([x[k] for x in rr]);z[k]=float(q.mean());z[k+'_sd']=float(q.std())
        z['utility']=.38*z['exact']+.19*z['semantic']+.19*z['source']+.24*z['procedure']-.0001*z['mean_storage'];summ.append(z)
    summ.sort(key=lambda x:x['utility'],reverse=True);Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'summary':summ},indent=2));print(json.dumps(summ,indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--out',required=True);ap.add_argument('--seeds',type=int,default=12);a=ap.parse_args();run(a.out,a.seeds)

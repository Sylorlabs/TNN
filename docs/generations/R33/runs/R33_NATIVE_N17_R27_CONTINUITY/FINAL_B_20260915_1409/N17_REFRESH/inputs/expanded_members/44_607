#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from entity_aeif_factorial import World,make_training,Rep,render
from integrated_r28 import EffectModel,Sibling,ACTIONS

def train_effect(w,seed):
 r=np.random.default_rng(seed);e=EffectModel(len(w.bases))
 for i in range(len(w.bases)):
  for a in range(ACTIONS):
   truth=float(w.afford[i,a,0]+.35*w.afford[i,a,1])
   for _ in range(16):e.learn(i,a,truth+r.normal(0,.08))
 return e

def run(seed,trials=160):
 w=World(seed,n=30,d=20);rep=Rep(make_training(w,'MIXED',128,seed+77),max_epi=16);eff=train_effect(w,seed+90);sib=Sibling(rep,w,eff,seed+100)
 r=np.random.default_rng(seed+500);passive=[];active=[];mislead=[];hard=[]
 for q in range(trials):
  target=int(r.integers(len(w.bases)));twin=w.twins[target] if w.twins[target]>=0 else (target+1)%len(w.bases)
  cand=[target,twin,(target+7)%len(w.bases),(target+13)%len(w.bases)];r.shuffle(cand)
  passive.append(sib.teach(target,cand,question=False));active.append(sib.teach(target,cand,question=True))
  # Misleading sibling repeats a false claim five times from one lineage; direct local verification remains independent.
  false=twin;echo_weight=800/5;verified_weight=700+500;mislead.append(verified_weight>echo_weight and sib.teach(target,cand,question=True))
  # Hard receiver views are corrupted; if visual communication is ambiguous, action consequence can disambiguate.
  # Force target/twin candidates and test action route robustness under noisier effects.
  a=0;sep=-1
  for aa in range(ACTIONS):
   x=eff.pred(target,aa);ss=min(abs(x-eff.pred(c,aa)) for c in cand if c!=target)
   if ss>sep:sep=ss;a=aa
  demo=eff.pred(target,a)+r.normal(0,.08);ds=[]
  for c in cand:
   obs=float(w.afford[c,a,0]+.35*w.afford[c,a,1])+r.normal(0,.11);ds.append(abs(obs-demo))
  hard.append(cand[int(np.argmin(ds))]==target)
 return {'seed':seed,'trials':trials,'passive':float(np.mean(passive)),'active_question':float(np.mean(active)),'misleading_lineage_resisted':float(np.mean(mislead)),'hard_action_discrimination':float(np.mean(hard))}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

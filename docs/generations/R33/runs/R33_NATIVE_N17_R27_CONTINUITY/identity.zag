// R33-N17 authoring-only native identity layer.
// This imports previously consumed read-only substrate for compilation review.
// It never executes Python, pickle reducers/classes, a learner, or promotion.
@import("../R33_NATIVE_N13A_FINGERPRINT_SCRATCH/tensor.zag")

fn n17_class_is(p:*ParentMap,id:i32,module:[]u8,name:[]u8)i32 {
    if(pm_kind(p,id)!=15){return 0;}
    let row:i32=(id-1)*10;let cls:i32=p.*.nodes[row+4] as i32;
    return nv_symbol(p,cls,module,name);
}

fn n17_dict_size(p:*ParentMap,id:i32,expected:i32)i32 {
    return (pm_kind(p,id)==11 && p.*.nodes[(id-1)*10+9]==expected) as i32;
}

fn n17_int_is(p:*ParentMap,id:i32,expected:i64)i32 {
    let value:i64=0;
    return (pm_small_int(p,id,&value)==0 && value==expected) as i32;
}

fn n17_identity(p:*ParentMap)i32 {
    if(pb_parent_identity(p)!=0){return -9201;}
    if(nio_equal(pm_raw(p,pm_lookup(p,p.*.root,"r26_sha256")),
        "df3acde273aa682642d13763a24208ff1dbb42968313cbe2a4256f7ccbc1f839")!=1){return -9202;}
    if(n17_dict_size(p,pm_lookup(p,p.*.root,"category_system"),4)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"abstraction_policy"),2)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"visual_debate_policy"),6)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"architecture"),58)!=1 ||
       n17_dict_size(p,pm_lookup(p,p.*.root,"evidence"),12)!=1){return -9203;}
    let r26:i32=pm_lookup(p,p.*.root,"base_state");
    if(n17_class_is(p,r26,"r26_experiments","R26State")!=1){return -9204;}
    let state:i32=pm_build_state(p,r26);
    if(pm_kind(p,state)!=11 || p.*.nodes[(state-1)*10+9]!=15){return -9205;}
    if(nio_equal(pm_raw(p,pm_lookup(p,r26,"format")),"TNN_PRE_V1_R26_VIDEO_ARCHITECTURE")!=1 ||
       n17_int_is(p,pm_lookup(p,r26,"development_step"),60249)!=1 ||
       n17_int_is(p,pm_lookup(p,r26,"newborn_restarts"),0)!=1){return -9206;}
    if(pm_kind(p,pm_lookup(p,r26,"speech_segmenter"))!=1){return -9207;}
    return 0;
}

@import("native_hash_only.zag")

// R33-N17 R25 exact-release byte identity gate V1.
// Historical files are inert byte inputs. No Python, pickle, reducer, learner,
// evaluator, or promotion logic is reachable from this gate.
const R25RI_OK:i32=0;
const R25RI_SHAPE:i32=-25001;
const R25RI_STATE:i32=-25002;
const R25RI_POLICY:i32=-25003;
const R25RI_VERIFY:i32=-25004;
const R25RI_RELEASE_SOURCE:i32=-25005;
const R25RI_EXPERIMENT_SOURCE:i32=-25006;
const R25RI_SUMMARY:i32=-25007;
const R25RI_MANIFEST:i32=-25008;
const R25RI_RECEIPT:i32=-25009;

const R25RI_STATE_BYTES:i32=13609471;
const R25RI_POLICY_BYTES:i32=569;
const R25RI_VERIFY_BYTES:i32=8864;
const R25RI_RELEASE_SOURCE_BYTES:i32=4206;
const R25RI_EXPERIMENT_SOURCE_BYTES:i32=74856;
const R25RI_SUMMARY_BYTES:i32=25160;
const R25RI_MANIFEST_BYTES:i32=13019;
const R25RI_RECEIPT_BYTES:i32=508;

fn r25ri_validate(state:[]u8,policy:[]u8,verify_source:[]u8,release_source:[]u8,
    experiment_source:[]u8,summary:[]u8,manifest:[]u8,receipt:[]u8)i32 {
    if(state.len!=R25RI_STATE_BYTES){return R25RI_SHAPE;}
    if(r27ma2_hash_matches(state,"6d0b14d8ab4a081b57c3762800475f8ecb67d2d7e9134a82e6f7690efc4e2957")!=1){return R25RI_STATE;}
    if(policy.len!=R25RI_POLICY_BYTES || r27ma2_hash_matches(policy,"80bf44ff48757a333e3ddc80affb132b61b06234e1372dae8d59595463d614eb")!=1){return R25RI_POLICY;}
    if(verify_source.len!=R25RI_VERIFY_BYTES || r27ma2_hash_matches(verify_source,"9de4b4660b23d7077988bc8b65b6c17f00deb0b21c6e3fb0ca82ac4c96ae0df1")!=1){return R25RI_VERIFY;}
    if(release_source.len!=R25RI_RELEASE_SOURCE_BYTES || r27ma2_hash_matches(release_source,"41f32d0fd2c94c8dec28d516bd2caeecdda8a868f76e8c08558a5e04d5473a57")!=1){return R25RI_RELEASE_SOURCE;}
    if(experiment_source.len!=R25RI_EXPERIMENT_SOURCE_BYTES || r27ma2_hash_matches(experiment_source,"c8c40fbdeba5c9e8067bf83499f7c6c581c8c2234988c875a41f25e69b30b880")!=1){return R25RI_EXPERIMENT_SOURCE;}
    if(summary.len!=R25RI_SUMMARY_BYTES || r27ma2_hash_matches(summary,"2d1f6d1dadd8aae227cd9c0441f2e760890d5a7102595dd95f706710df3fb851")!=1){return R25RI_SUMMARY;}
    if(manifest.len!=R25RI_MANIFEST_BYTES || r27ma2_hash_matches(manifest,"488e8cd810ef9b52d1356942b10b5e244df890712ec58e7a52c48b055c9d8bd2")!=1){return R25RI_MANIFEST;}
    if(receipt.len!=R25RI_RECEIPT_BYTES || r27ma2_hash_matches(receipt,"3928eb552e97861ba36878b397c34a445db3a983da225e02efebd22c016fbe1c")!=1){return R25RI_RECEIPT;}
    return R25RI_OK;
}

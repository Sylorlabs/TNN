 if(p.len!=R25RI_STATE_BYTES || r.len!=R25TM1_R23_BYTES || c.len!=R25TM1_CORE_BYTES || n.len!=R25TM1_NOISE_BYTES){return 1;}
 if(r25nm1_extract(p,"","","","","")!=R25NM1_IDENTITY || r25tm1_extract(r,c,n,"","","")!=R25TM1_IDENTITY){return 2;}

// R33-N17 R25 digest preimage combiner V1.
//
// This source performs only the final byte concatenation and SHA-256 step of
// the historical R25 digest contract.  Callers must supply each array/module
// chunk already encoded exactly as the recovered R25 source specifies:
//
//   array chunk = name || str(shape) || str(dtype) || raw C-order bytes
//   torch chunk = concat(sorted(prefix || key || raw-f32-bytes))
//
// Separating extraction from final composition makes both boundaries
// independently testable.  No pickle constructor, reducer, NumPy, Torch,
// sklearn, evaluator, learner, registry or promotion path is present.
@import("../R33_NATIVE_SHA256_V2.zag")

const R25D1_OK:i32=0;
const R25D1_BAD:i32=-25101;
const R25D1_OVERFLOW:i32=-25102;
const R25D1_ALLOC:i32=-25103;
const R25D1_HASH:i32=-25104;
const R25D1_MAX_PREIMAGE:i64=33554432;

fn r25d1_add_len(total:*i64,n:i32)i32 @noalloc {
    if(total==null as *i64 || n<0){return R25D1_BAD;}
    if(total.*>R25D1_MAX_PREIMAGE-(n as i64)){return R25D1_OVERFLOW;}
    total.*=total.*+(n as i64);return R25D1_OK;
}

fn r25d1_copy(dst:[]u8,at:*i32,src:[]u8)i32 @noalloc {
    if(at==null as *i32 || at.*<0 || src.len<0 || at.*>dst.len-src.len){return R25D1_BAD;}
    let i:i32=0;while(i<src.len){dst[at.*+i]=src[i];i=i+1;}
    at.*=at.*+src.len;return R25D1_OK;
}

fn r25d1_preimage(
    format:[]u8,r24_sha256:[]u8,r24_digest:[]u8,development_step_ascii:[]u8,newborn_restarts_ascii:[]u8,
    foundation_W:[]u8,composition_W:[]u8,composition_gate:[]u8,relation_W:[]u8,relation_targets:[]u8,
    semantic_module:[]u8,speech_core_module:[]u8,speech_noise_module:[]u8,
    architecture_json:[]u8,sibling_policy_json:[]u8,learning_action_policy_json:[]u8,
    out:[]u8)i32 {
    let total:i64=0;
    if(r25d1_add_len(&total,format.len)!=0 || r25d1_add_len(&total,r24_sha256.len)!=0 ||
       r25d1_add_len(&total,r24_digest.len)!=0 || r25d1_add_len(&total,development_step_ascii.len)!=0 ||
       r25d1_add_len(&total,newborn_restarts_ascii.len)!=0 || r25d1_add_len(&total,foundation_W.len)!=0 ||
       r25d1_add_len(&total,composition_W.len)!=0 || r25d1_add_len(&total,composition_gate.len)!=0 ||
       r25d1_add_len(&total,relation_W.len)!=0 || r25d1_add_len(&total,relation_targets.len)!=0 ||
       r25d1_add_len(&total,semantic_module.len)!=0 || r25d1_add_len(&total,speech_core_module.len)!=0 ||
       r25d1_add_len(&total,speech_noise_module.len)!=0 || r25d1_add_len(&total,architecture_json.len)!=0 ||
       r25d1_add_len(&total,sibling_policy_json.len)!=0 || r25d1_add_len(&total,learning_action_policy_json.len)!=0){return R25D1_OVERFLOW;}
    if(out.len!=(total as i32)){return R25D1_BAD;}
    let at:i32=0;
    if(r25d1_copy(out,&at,format)!=0 || r25d1_copy(out,&at,r24_sha256)!=0 || r25d1_copy(out,&at,r24_digest)!=0 ||
       r25d1_copy(out,&at,development_step_ascii)!=0 || r25d1_copy(out,&at,newborn_restarts_ascii)!=0 ||
       r25d1_copy(out,&at,foundation_W)!=0 || r25d1_copy(out,&at,composition_W)!=0 ||
       r25d1_copy(out,&at,composition_gate)!=0 || r25d1_copy(out,&at,relation_W)!=0 ||
       r25d1_copy(out,&at,relation_targets)!=0 || r25d1_copy(out,&at,semantic_module)!=0 ||
       r25d1_copy(out,&at,speech_core_module)!=0 || r25d1_copy(out,&at,speech_noise_module)!=0 ||
       r25d1_copy(out,&at,architecture_json)!=0 || r25d1_copy(out,&at,sibling_policy_json)!=0 ||
       r25d1_copy(out,&at,learning_action_policy_json)!=0){return R25D1_BAD;}
    if(at!=out.len){return R25D1_BAD;}return R25D1_OK;
}

fn r25d1_digest(
    format:[]u8,r24_sha256:[]u8,r24_digest:[]u8,development_step_ascii:[]u8,newborn_restarts_ascii:[]u8,
    foundation_W:[]u8,composition_W:[]u8,composition_gate:[]u8,relation_W:[]u8,relation_targets:[]u8,
    semantic_module:[]u8,speech_core_module:[]u8,speech_noise_module:[]u8,
    architecture_json:[]u8,sibling_policy_json:[]u8,learning_action_policy_json:[]u8,
    digest:[]u8)i32 {
    if(digest.len!=32){return R25D1_BAD;}
    let total:i64=0;
    if(r25d1_add_len(&total,format.len)!=0 || r25d1_add_len(&total,r24_sha256.len)!=0 ||
       r25d1_add_len(&total,r24_digest.len)!=0 || r25d1_add_len(&total,development_step_ascii.len)!=0 ||
       r25d1_add_len(&total,newborn_restarts_ascii.len)!=0 || r25d1_add_len(&total,foundation_W.len)!=0 ||
       r25d1_add_len(&total,composition_W.len)!=0 || r25d1_add_len(&total,composition_gate.len)!=0 ||
       r25d1_add_len(&total,relation_W.len)!=0 || r25d1_add_len(&total,relation_targets.len)!=0 ||
       r25d1_add_len(&total,semantic_module.len)!=0 || r25d1_add_len(&total,speech_core_module.len)!=0 ||
       r25d1_add_len(&total,speech_noise_module.len)!=0 || r25d1_add_len(&total,architecture_json.len)!=0 ||
       r25d1_add_len(&total,sibling_policy_json.len)!=0 || r25d1_add_len(&total,learning_action_policy_json.len)!=0){return R25D1_OVERFLOW;}
    if(total<1 || total>R25D1_MAX_PREIMAGE){return R25D1_BAD;}
    let p:*u8=_zag_malloc(total as i32) as *u8;if(p==null as *u8){return R25D1_ALLOC;}
    let preimage:[]u8=p[0..(total as i32)];
    let rc:i32=r25d1_preimage(format,r24_sha256,r24_digest,development_step_ascii,newborn_restarts_ascii,
        foundation_W,composition_W,composition_gate,relation_W,relation_targets,
        semantic_module,speech_core_module,speech_noise_module,
        architecture_json,sibling_policy_json,learning_action_policy_json,preimage);
    if(rc!=0){_zag_free(p as *i8);return rc;}
    let hrc:i32=ns_sha256(preimage,digest);_zag_free(p as *i8);
    if(hrc!=0){return R25D1_HASH;}return R25D1_OK;
}

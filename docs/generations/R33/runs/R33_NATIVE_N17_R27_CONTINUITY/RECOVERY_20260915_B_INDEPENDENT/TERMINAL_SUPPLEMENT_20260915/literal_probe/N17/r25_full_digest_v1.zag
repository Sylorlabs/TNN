@import("r25_release_identity_v1.zag")
@import("r25_digest_preimage_v1.zag")

// R33-N17 R25 full semantic-digest recomposition V1.
// All component chunks are admitted by exact byte length + SHA-256 before the
// historical digest order is applied. Extraction is qualified separately.

fn r25fd1_hex_nibble(c:u8)i32 @noalloc {
    if(c>=48 && c<=57){return (c-48) as i32;}
    if(c>=97 && c<=102){return (c-87) as i32;}return -1;
}
fn r25fd1_hex_matches(d:[]u8,h:[]u8)i32 @noalloc {
    if(d.len!=32 || h.len!=64){return 0;}let i:i32=0;
    while(i<32){let a:i32=r25fd1_hex_nibble(h[i*2]);let b:i32=r25fd1_hex_nibble(h[i*2+1]);
        if(a<0 || b<0 || d[i]!=((a<<4)|b) as u8){return 0;}i=i+1;}return 1;
}
fn r25fd1_inputs(
    foundation:[]u8,composition:[]u8,gate:[]u8,relation:[]u8,targets:[]u8,
    semantic:[]u8,core:[]u8,noise:[]u8,
    architecture_json:[]u8,sibling_json:[]u8,learning_json:[]u8)i32 {
    if(foundation.len!=245788 || r27ma2_hash_matches(foundation,"5b16277b5e431d481d4d442dffa997d7104e7bf6603b4f46011908665a0508f5")!=1 ||
       composition.len!=245789 || r27ma2_hash_matches(composition,"2c57d7c289b71e8b904957bc8265674bcae7803721a2799c6c8d0a8ded127aa8")!=1 ||
       gate.len!=2589 || r27ma2_hash_matches(gate,"922f28944a9b8c1900737ed7f7fa36ea503d31bc204dc888f8e376f1d3665f55")!=1 ||
       relation.len!=262171 || r27ma2_hash_matches(relation,"fc542fc28814eeeb5dc6d09d48ec992b5cd07cd44d1556ac53b48ccfad12938b")!=1 ||
       targets.len!=1566 || r27ma2_hash_matches(targets,"a66c52c00cf756181731e0aebea5f4de7ddf6984ddb805e829adfea598417e29")!=1 ||
       semantic.len!=619763 || r27ma2_hash_matches(semantic,"2cf70bf3938477bcf0d75977df785a1a1e6da83fdd01bb3d4a8104f951f9b2d2")!=1 ||
       core.len!=474200 || r27ma2_hash_matches(core,"76a3617e39c68588ea1edb29a1062d0a1dbf26fbe1c495948151fe118abb1495")!=1 ||
       noise.len!=474212 || r27ma2_hash_matches(noise,"95f7ef309900e819571c65dab846f7c81320ce3d7efe129c3a65f3ff5de676eb")!=1 ||
       architecture_json.len!=6299 || r27ma2_hash_matches(architecture_json,"8d6b8d5cee5f4a11bfd40443093376fcef8e507ceaaba9be6a95f576b8de2207")!=1 ||
       sibling_json.len!=371 || r27ma2_hash_matches(sibling_json,"428ceb94359133810ec00f32a965d852a421e8fbabeb3d0c4769d7177ccafe92")!=1 ||
       learning_json.len!=322 || r27ma2_hash_matches(learning_json,"d7048717edb1f9fd444a1dc79427eabf862644cc186fcd0ce5e4ea40c28c9d9d")!=1){return -25601;}
    return 0;
}
fn r25fd1_digest(
    foundation:[]u8,composition:[]u8,gate:[]u8,relation:[]u8,targets:[]u8,
    semantic:[]u8,core:[]u8,noise:[]u8,
    architecture_json:[]u8,sibling_json:[]u8,learning_json:[]u8,
    digest:[]u8)i32 {
    if(digest.len!=32 || r25fd1_inputs(foundation,composition,gate,relation,targets,semantic,core,noise,architecture_json,sibling_json,learning_json)!=0){return -25601;}
    let rc:i32=r25d1_digest(
        "TNN_PRE_V1_R25_ADAPTIVE_NATURAL_ENGLISH_V1",
        "d7198586589d605d549d7ad8146b180d85bb7c2edfdfede3a72088703bf813a3",
        "9fd54ea42465bbc499cd308379163c10de6daaed20861933a7b9dd3c2455190b",
        "57285","0",
        foundation,composition,gate,relation,targets,semantic,core,noise,
        architecture_json,sibling_json,learning_json,digest);
    if(rc!=0){return -25602;}
    if(r25fd1_hex_matches(digest,"4822f0072db2295ff2d25102946c2dc7a56d248374bdc0ae44c37ded0370408e")!=1){return -25602;}
    return 0;
}

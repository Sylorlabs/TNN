// R33-N17 R25 digest component-schema V1.
// Exact source-derived shape/length/key-order guards for accepted R25 digest inputs.
// This does not decode pickle bytes or claim historical payload equality.

fn r25cs1_at(b:[]u8,at:i32,p:[]u8)i32 @noalloc {
    if(at<0 || p.len<1 || at>b.len-p.len){return 0;}let i:i32=0;while(i<p.len){if(b[at+i]!=p[i]){return 0;}i=i+1;}return 1;
}
fn r25cs1_prefix(b:[]u8,p:[]u8)i32 @noalloc {return r25cs1_at(b,0,p);}
fn r25cs1_numpy_chunks(foundation:[]u8,composition:[]u8,gate:[]u8,relation:[]u8,targets:[]u8)i32 @noalloc {
    if(foundation.len!=245788 || r25cs1_prefix(foundation,"foundation_W(96, 640)float32")!=1){return -25201;}
    if(composition.len!=245789 || r25cs1_prefix(composition,"composition_W(96, 640)float32")!=1){return -25201;}
    if(gate.len!=2589 || r25cs1_prefix(gate,"composition_gate(640,)float32")!=1){return -25201;}
    if(relation.len!=262171 || r25cs1_prefix(relation,"relation_W(64, 1024)float32")!=1){return -25201;}
    if(targets.len!=1566 || r25cs1_prefix(targets,"relation_targets(6, 64)float32")!=1){return -25201;}
    return 0;
}
fn r25cs1_semantic(semantic:[]u8)i32 @noalloc {
    if(semantic.len!=619763){return -25201;}
    if(r25cs1_at(semantic,0,"semantic.ce.bias")!=1 ||
       r25cs1_at(semantic,208,"semantic.ce.weight")!=1 ||
       r25cs1_at(semantic,8290,"semantic.ch.bias")!=1 ||
       r25cs1_at(semantic,8818,"semantic.ch.weight")!=1 ||
       r25cs1_at(semantic,30340,"semantic.emb.weight")!=1 ||
       r25cs1_at(semantic,96023,"semantic.out.bias")!=1 ||
       r25cs1_at(semantic,97408,"semantic.out.weight")!=1 ||
       r25cs1_at(semantic,272531,"semantic.rnn.bias_hh_l0")!=1 ||
       r25cs1_at(semantic,274090,"semantic.rnn.bias_ih_l0")!=1 ||
       r25cs1_at(semantic,275649,"semantic.rnn.weight_hh_l0")!=1 ||
       r25cs1_at(semantic,472282,"semantic.rnn.weight_ih_l0")!=1){return -25201;}
    return 0;
}
fn r25cs1_speech_core(b:[]u8)i32 @noalloc {
    if(b.len!=474200){return -25201;}
    if(r25cs1_at(b,0,"speech_core.f.0.bias")!=1 ||
       r25cs1_at(b,84,"speech_core.f.0.weight")!=1 ||
       r25cs1_at(b,2090,"speech_core.f.2.bias")!=1 ||
       r25cs1_at(b,2238,"speech_core.f.2.weight")!=1 ||
       r25cs1_at(b,32980,"speech_core.f.4.bias")!=1 ||
       r25cs1_at(b,33192,"speech_core.f.4.weight")!=1 ||
       r25cs1_at(b,88510,"speech_core.f.6.bias")!=1 ||
       r25cs1_at(b,88786,"speech_core.f.6.weight")!=1 ||
       r25cs1_at(b,174824,"speech_core.h.1.bias")!=1 ||
       r25cs1_at(b,175356,"speech_core.h.1.weight")!=1 ||
       r25cs1_at(b,437522,"speech_core.h.3.bias")!=1 ||
       r25cs1_at(b,437826,"speech_core.h.3.weight")!=1){return -25201;}
    return 0;
}
fn r25cs1_speech_noise(b:[]u8)i32 @noalloc {
    if(b.len!=474212){return -25201;}
    if(r25cs1_at(b,0,"speech_noise.f.0.bias")!=1 ||
       r25cs1_at(b,85,"speech_noise.f.0.weight")!=1 ||
       r25cs1_at(b,2092,"speech_noise.f.2.bias")!=1 ||
       r25cs1_at(b,2241,"speech_noise.f.2.weight")!=1 ||
       r25cs1_at(b,32984,"speech_noise.f.4.bias")!=1 ||
       r25cs1_at(b,33197,"speech_noise.f.4.weight")!=1 ||
       r25cs1_at(b,88516,"speech_noise.f.6.bias")!=1 ||
       r25cs1_at(b,88793,"speech_noise.f.6.weight")!=1 ||
       r25cs1_at(b,174832,"speech_noise.h.1.bias")!=1 ||
       r25cs1_at(b,175365,"speech_noise.h.1.weight")!=1 ||
       r25cs1_at(b,437532,"speech_noise.h.3.bias")!=1 ||
       r25cs1_at(b,437837,"speech_noise.h.3.weight")!=1){return -25201;}
    return 0;
}
fn r25cs1_module_chunks(semantic:[]u8,speech_core:[]u8,speech_noise:[]u8)i32 @noalloc {
    if(r25cs1_semantic(semantic)!=0 || r25cs1_speech_core(speech_core)!=0 || r25cs1_speech_noise(speech_noise)!=0){return -25201;}
    return 0;
}

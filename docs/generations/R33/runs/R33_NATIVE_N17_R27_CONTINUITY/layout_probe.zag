// R33-N17 authoring-only layout probe over the already-custodied parent map.
// Read-only: no Python, reducers/classes, learner, training, mutation, digest,
// promotion, or scientific population exposure.
@import("identity.zag")

fn lp_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);_zag_print(s);nio_free(s);
}

fn lp_tensor(p:*ParentMap,w:*TsWork,id:i32)i32 {
    let v:TsView=ts_open(p,id,w);if(v.status!=0){let code:i32=v.status;ts_close(&v);return code;}
    let expected:i64=1;let i:i32=v.rank-1;let contiguous:i32=1;
    while(i>=0){if(v.strides[i]!=expected){contiguous=0;}expected=expected*v.dims[i];i=i-1;}
    _zag_print("N17_LAYOUT_TENSOR,");lp_num(id as i64);_zag_print(",rank=");lp_num(v.rank as i64);
    _zag_print(",offset=");lp_num(v.offset as i64);_zag_print(",count=");lp_num(v.count as i64);
    _zag_print(",elements=");lp_num(v.elements as i64);_zag_print(",dims=");
    i=0;while(i<v.rank){if(i>0){_zag_print("x");}lp_num(v.dims[i]);i=i+1;}
    _zag_print(",strides=");i=0;while(i<v.rank){if(i>0){_zag_print("x");}lp_num(v.strides[i]);i=i+1;}
    _zag_print(",c_contiguous=");lp_num(contiguous as i64);_zag_println("");
    ts_close(&v);return (contiguous==1) as i32;
}

fn lp_graph(p:*ParentMap,id:i32)i32 {
    let v:NvView=nv_open(p,id);if(v.status!=0){let code:i32=v.status;nv_close(&v);return code;}
    let ok:i32=(v.kind==102 && v.width==4 && v.endian==60 && v.order==67 && v.ndim==1 &&
        v.elements==72 && v.dims[0]==72 && v.strides[0]==1 && v.bytes==288) as i32;
    nv_close(&v);return ok;
}

fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}
    let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}
    if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}
    let w:TsWork=ts_work();let good:i32=0;
    good=good+lp_tensor(&p,&w,208657);good=good+lp_tensor(&p,&w,208676);
    good=good+lp_tensor(&p,&w,208765);good=good+lp_tensor(&p,&w,208783);
    good=good+lp_tensor(&p,&w,208841);good=good+lp_tensor(&p,&w,208859);
    let ids:[]i64=pm_words(24);if(ids.len!=24){pm_free_words(ids);mi_loaded_close(&p);return 5;}
    ids[0]=208906;ids[1]=208911;ids[2]=208916;ids[3]=208923;ids[4]=208928;ids[5]=208933;
    ids[6]=208940;ids[7]=208945;ids[8]=208950;ids[9]=208957;ids[10]=208962;ids[11]=208967;
    ids[12]=208974;ids[13]=208979;ids[14]=208984;ids[15]=208991;ids[16]=208996;ids[17]=209001;
    ids[18]=209008;ids[19]=209013;ids[20]=209018;ids[21]=209025;ids[22]=209030;ids[23]=209035;
    let graph_good:i32=0;let i:i32=0;while(i<24){graph_good=graph_good+lp_graph(&p,ids[i] as i32);i=i+1;}
    _zag_print("N17_LAYOUT_GRAPH_CONTIGUOUS,");lp_num(graph_good as i64);_zag_println("/24");
    pm_free_words(ids);mi_loaded_close(&p);
    if(good!=6 || graph_good!=24){return 6;}_zag_println("N17_LAYOUT_PROBE_PASS");return 0;
}

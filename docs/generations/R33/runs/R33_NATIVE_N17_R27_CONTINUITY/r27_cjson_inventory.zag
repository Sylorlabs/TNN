// R33-N17 authoring-only R27 canonical-JSON inventory.
// Traverses only JSON-compatible accepted-parent architecture/evidence values.
// No reducers/classes, Python, learner, mutation, digest, verifier or promotion.
@import("identity.zag")

fn rj_num(v:i64)void {let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);}
fn rj_hex(b:[]u8)void {
    let d:[]u8="0123456789abcdef";let o:[]u8=nio_alloc(b.len*2);if(o.len!=b.len*2){return;}
    let i:i32=0;while(i<b.len){let x:i32=b[i] as i32;o[i*2]=d[x/16];o[i*2+1]=d[x%16];i=i+1;}_zag_print(o);nio_free(o);
}
struct RjCounts {n_null:i32,n_bool:i32,n_int:i32,n_float:i32,n_str:i32,n_list:i32,n_dict:i32,n_other:i32,n_nodes:i32}
fn rj_zero()RjCounts{return RjCounts{.n_null=0,.n_bool=0,.n_int=0,.n_float=0,.n_str=0,.n_list=0,.n_dict=0,.n_other=0,.n_nodes=0};}
fn rj_walk(p:*ParentMap,id:i32,c:*RjCounts,depth:i32)void {
    if(depth>32 || id<1 || id>p.*.node_count){c.*.n_other=c.*.n_other+1;return;}c.*.n_nodes=c.*.n_nodes+1;
    let k:i32=pm_kind(p,id);
    if(k==1){c.*.n_null=c.*.n_null+1;return;}
    if(k==2){c.*.n_bool=c.*.n_bool+1;return;}
    if(k==3 || k==4){c.*.n_int=c.*.n_int+1;return;}
    if(k==5){c.*.n_float=c.*.n_float+1;_zag_print("R27_CJSON_FLOAT,");rj_num(id as i64);_zag_print(",");rj_hex(pm_raw(p,id));_zag_println("");return;}
    if(k==6){c.*.n_str=c.*.n_str+1;let raw:[]u8=pm_raw(p,id);let i:i32=0;let hi:i32=0;while(i<raw.len){if(raw[i]>=128){hi=1;}i=i+1;}
        if(hi==1){_zag_print("R27_CJSON_NONASCII_STRING,");rj_num(id as i64);_zag_print(",");rj_hex(raw);_zag_println("");}return;}
    if(k==9 || k==10){c.*.n_list=c.*.n_list+1;let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;
        while(e>0 && n<16384){let er:i32=(e-1)*4;if(p.*.edges[er+3]==1){rj_walk(p,p.*.edges[er] as i32,c,depth+1);}e=p.*.edges[er+2] as i32;n=n+1;}return;}
    if(k==11){c.*.n_dict=c.*.n_dict+1;let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;
        while(e>0 && n<16384){let er:i32=(e-1)*4;if(p.*.edges[er+3]==2){let key:i32=p.*.edges[er] as i32;let val:i32=p.*.edges[er+1] as i32;
            if(pm_kind(p,key)!=6){c.*.n_other=c.*.n_other+1;_zag_print("R27_CJSON_NONSTRING_KEY,");rj_num(id as i64);_zag_print(",");rj_num(key as i64);_zag_print(",");rj_num(pm_kind(p,key) as i64);let kv:i64=0;let krc:i32=pm_small_int(p,key,&kv);_zag_print(",key_rc=");rj_num(krc as i64);_zag_print(",key_value=");rj_num(kv);_zag_print(",value=");rj_num(val as i64);_zag_println("");rj_walk(p,val,c,depth+1);}else{rj_walk(p,val,c,depth+1);}}e=p.*.edges[er+2] as i32;n=n+1;}return;}
    c.*.n_other=c.*.n_other+1;_zag_print("R27_CJSON_OTHER,");rj_num(id as i64);_zag_print(",");rj_num(k as i64);_zag_println("");
}
fn rj_report(name:[]u8,c:*RjCounts)void {
    _zag_print("R27_CJSON_COUNTS,");_zag_print(name);_zag_print(",nodes=");rj_num(c.*.n_nodes);
    _zag_print(",null=");rj_num(c.*.n_null);_zag_print(",bool=");rj_num(c.*.n_bool);_zag_print(",int=");rj_num(c.*.n_int);
    _zag_print(",float=");rj_num(c.*.n_float);_zag_print(",str=");rj_num(c.*.n_str);_zag_print(",list=");rj_num(c.*.n_list);
    _zag_print(",dict=");rj_num(c.*.n_dict);_zag_print(",other=");rj_num(c.*.n_other);_zag_println("");
}
fn main()i32 {
    if(_zag_argc()!=1){return 64;}let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}
    let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}
    let ca:RjCounts=rj_zero();let ce:RjCounts=rj_zero();rj_walk(&p,pm_lookup(&p,p.root,"architecture"),&ca,0);rj_report("architecture",&ca);
    rj_walk(&p,pm_lookup(&p,p.root,"evidence"),&ce,0);rj_report("evidence",&ce);mi_loaded_close(&p);
    if(ca.n_other!=0 || ce.n_other!=0){return 5;}_zag_println("R27_CJSON_INVENTORY_PASS");return 0;
}

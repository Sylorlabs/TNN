// R33-N17 native R26 digest reconstruction.
//
// This is a bounded, read-only implementation of the historical R26 digest
// contract over the already-custodied accepted parent. It uses the inert map,
// N12 numeric views, N13A tensor views and native SHA-256 only. It never runs
// Python, pickle reducers/classes, torch/numpy runtimes, a learner, training,
// mutation, promotion, or the historical verifier.
@import("../../../identity.zag")

struct R26Buf {data:[]u8,used:i32,status:i32}

fn r26_buf(cap:i32)R26Buf {
    let x:[]u8=nio_alloc(cap);let status:i32=0;if(x.len!=cap){status=-1;}
    return R26Buf{.data=x,.used=0,.status=status};
}
fn r26_free(b:*R26Buf)void {nio_free(b.*.data);b.*.used=0;b.*.status=-1;}
fn r26_byte(b:*R26Buf,x:i32)void {
    if(b.*.status!=0){return;}if(x<0 || x>255 || b.*.used>=b.*.data.len){b.*.status=-2;return;}
    b.*.data[b.*.used]=x as u8;b.*.used=b.*.used+1;
}
fn r26_add(b:*R26Buf,x:[]u8)void {
    if(b.*.status!=0){return;}if(x.len<0 || b.*.used>b.*.data.len || x.len>b.*.data.len-b.*.used){b.*.status=-2;return;}
    let i:i32=0;while(i<x.len){b.*.data[b.*.used+i]=x[i];i=i+1;}b.*.used=b.*.used+x.len;
}
fn r26_i64(b:*R26Buf,x:i64)void {let s:[]u8=_zag_i64_to_str(x);r26_add(b,s);nio_free(s);}
fn r26_hex_equal(raw:[]u8,hex:[]u8)i32 {
    if(hex.len!=raw.len*2){return 0;}let i:i32=0;
    while(i<raw.len){let a:i64=ns_hex_digit(hex[2*i] as i32);let c:i64=ns_hex_digit(hex[2*i+1] as i32);
        if(a<0 || c<0 || a*16+c!=(raw[i] as i64)){return 0;}i=i+1;}return 1;
}
fn r26_sha_equal(raw:[]u8,expected:[]u8)i32 {
    let h:[]u8=nio_alloc(32);if(h.len!=32){return 0;}let rc:i32=ns_sha256(raw,h);let ok:i32=0;
    if(rc==0){ok=r26_hex_equal(h,expected);}nio_free(h);return ok;
}
fn r26_component(b:*R26Buf,label:[]u8,start:i32)void {
    if(b.*.status!=0 || start<0 || start>b.*.used){return;}let h:[]u8=nio_alloc(32);if(h.len!=32){b.*.status=-3;return;}
    if(ns_sha256(b.*.data[start..b.*.used],h)!=0){nio_free(h);b.*.status=-3;return;}let text:[]u8=ns_hex(h);nio_free(h);
    _zag_print("R26_COMPONENT,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(start as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(b.*.used as i64));_zag_print(",");_zag_println(text);nio_free(text);
}
fn r26_cmp(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;if(b.len<n){n=b.len;}let i:i32=0;while(i<n){if(a[i]<b[i]){return -1;}if(a[i]>b[i]){return 1;}i=i+1;}
    if(a.len<b.len){return -1;}if(a.len>b.len){return 1;}return 0;
}
fn r26_collect(p:*ParentMap,id:i32,keys:[]i64,vals:[]i64)i32 {
    if(pm_kind(p,id)!=11 || keys.len!=vals.len){return -1;}let expected:i32=p.*.nodes[(id-1)*10+9] as i32;
    if(expected<0 || expected>keys.len){return -1;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;let seen:i32=0;
    while(e>0 && seen<=p.*.edge_count){if(e>p.*.edge_count){return -1;}let r:i32=(e-1)*4;if(p.*.edges[r+3]!=2 || n>=keys.len){return -1;}
        keys[n]=p.*.edges[r];vals[n]=p.*.edges[r+1];n=n+1;e=p.*.edges[r+2] as i32;seen=seen+1;}
    if(n!=expected){return -1;}return n;
}
fn r26_sort_lex(p:*ParentMap,keys:[]i64,vals:[]i64,n:i32)i32 {
    if(n<0 || n>keys.len || vals.len<keys.len){return -1;}let gap:i32=n/2;
    while(gap>0){let i:i32=gap;while(i<n){let hk:i64=keys[i];let hv:i64=vals[i];let j:i32=i;
        while(j>=gap && r26_cmp(pm_raw(p,keys[j-gap] as i32),pm_raw(p,hk as i32))>0){keys[j]=keys[j-gap];vals[j]=vals[j-gap];j=j-gap;}
        keys[j]=hk;vals[j]=hv;i=i+1;}gap=gap/2;}return 0;
}
fn r26_int(p:*ParentMap,id:i32,out:*i64)i32 {return pm_small_int(p,id,out);}
fn r26_sort_int(p:*ParentMap,keys:[]i64,vals:[]i64,n:i32)i32 {
    if(n<0 || n>keys.len || vals.len<keys.len){return -1;}let gap:i32=n/2;
    while(gap>0){let i:i32=gap;while(i<n){let hk:i64=keys[i];let hv:i64=vals[i];let hval:i64=0;if(r26_int(p,hk as i32,&hval)!=0){return -1;}let j:i32=i;let keep:i32=1;
        while(j>=gap && keep==1){let pv:i64=0;if(r26_int(p,keys[j-gap] as i32,&pv)!=0){return -1;}if(pv<=hval){keep=0;}else{keys[j]=keys[j-gap];vals[j]=vals[j-gap];j=j-gap;}}
        keys[j]=hk;vals[j]=hv;i=i+1;}gap=gap/2;}return 0;
}
fn r26_json_string(b:*R26Buf,s:[]u8)void {
    r26_byte(b,34);let digits:[]u8="0123456789abcdef";let i:i32=0;while(i<s.len && b.*.status==0){let c:i32=s[i] as i32;
        if(c>=128){b.*.status=-20;return;}if(c==34 || c==92){r26_byte(b,92);r26_byte(b,c);}
        else if(c==8){r26_byte(b,92);r26_byte(b,98);}else if(c==9){r26_byte(b,92);r26_byte(b,116);}
        else if(c==10){r26_byte(b,92);r26_byte(b,110);}else if(c==12){r26_byte(b,92);r26_byte(b,102);}
        else if(c==13){r26_byte(b,92);r26_byte(b,114);}else if(c<32){r26_add(b,"\\u00");r26_byte(b,digits[c/16] as i32);r26_byte(b,digits[c%16] as i32);}
        else{r26_byte(b,c);}i=i+1;}r26_byte(b,34);
}
fn r26_architecture(b:*R26Buf,p:*ParentMap,id:i32)i32 {
    let keys:[]i64=pm_words(64);let vals:[]i64=pm_words(64);if(keys.len!=64 || vals.len!=64){pm_free_words(keys);pm_free_words(vals);return -1;}
    let n:i32=r26_collect(p,id,keys,vals);if(n!=50 || r26_sort_lex(p,keys,vals,n)!=0){pm_free_words(keys);pm_free_words(vals);return -2;}
    r26_byte(b,123);let i:i32=0;while(i<n && b.*.status==0){let k:i32=keys[i] as i32;let v:i32=vals[i] as i32;
        if(pm_kind(p,k)!=6){b.*.status=-21;break;}if(i>0){r26_add(b,", ");}r26_json_string(b,pm_raw(p,k));r26_add(b,": ");
        if(pm_kind(p,v)==6){r26_json_string(b,pm_raw(p,v));}
        else if(pm_kind(p,v)==2){let bv:i64=p.*.nodes[(v-1)*10+6];if(bv==0){r26_add(b,"false");}else if(bv==1){r26_add(b,"true");}else{b.*.status=-22;}}
        else{b.*.status=-23;}i=i+1;}r26_byte(b,125);pm_free_words(keys);pm_free_words(vals);return b.*.status;
}
fn r26_add_nv(b:*R26Buf,p:*ParentMap,id:i32,rank:i32,d0:i64,d1:i64,sha:[]u8)i32 {
    let v:NvView=nv_open(p,id);if(v.status!=0){nv_close(&v);return -30;}
    let ok:i32=(v.kind==102 && v.width==4 && v.endian==60 && v.order==67 && v.ndim==rank && v.dims[0]==d0) as i32;
    if(rank==2 && v.dims[1]!=d1){ok=0;}if(ok!=1 || r26_sha_equal(p.*.input[v.at..v.at+v.bytes],sha)!=1){nv_close(&v);return -31;}
    r26_add(b,p.*.input[v.at..v.at+v.bytes]);nv_close(&v);return b.*.status;
}
fn r26_add_tensor(b:*R26Buf,p:*ParentMap,w:*TsWork,id:i32,rank:i32,d0:i64,d1:i64,sha:[]u8)i32 {
    let v:TsView=ts_open(p,id,w);if(v.status!=0){ts_close(&v);return -40;}let bytes:i32=v.elements*v.width;
    let ok:i32=(v.kind==102 && v.width==4 && v.offset==0 && v.elements==v.count && v.rank==rank && v.dims[0]==d0) as i32;
    if(rank==2 && v.dims[1]!=d1){ok=0;}if(ok!=1 || bytes<0 || v.at<0 || v.at+bytes>p.*.input.len || r26_sha_equal(p.*.input[v.at..v.at+bytes],sha)!=1){ts_close(&v);return -41;}
    r26_add(b,p.*.input[v.at..v.at+bytes]);ts_close(&v);return b.*.status;
}
fn r26_graph_expected(i:i32)i32 {
    if(i==0){return 208906;}if(i==1){return 208911;}if(i==2){return 208916;}if(i==3){return 208923;}if(i==4){return 208928;}if(i==5){return 208933;}
    if(i==6){return 208940;}if(i==7){return 208945;}if(i==8){return 208950;}if(i==9){return 208957;}if(i==10){return 208962;}if(i==11){return 208967;}
    if(i==12){return 208974;}if(i==13){return 208979;}if(i==14){return 208984;}if(i==15){return 208991;}if(i==16){return 208996;}if(i==17){return 209001;}
    if(i==18){return 209008;}if(i==19){return 209013;}if(i==20){return 209018;}if(i==21){return 209025;}if(i==22){return 209030;}if(i==23){return 209035;}return 0;
}
fn r26_graph(b:*R26Buf,p:*ParentMap,graph:i32)i32 {
    let mt:i32=pm_lookup(p,graph,"merge_threshold");if(pm_kind(p,mt)!=5 || r26_hex_equal(pm_raw(p,mt),"3feb10b51618caa5")!=1){return -50;}
    r26_add(b,"0.8457894736842105");let nodes:i32=pm_lookup(p,graph,"nodes");if(pm_kind(p,nodes)!=9 || p.*.nodes[(nodes-1)*10+9]!=8){return -51;}
    let e:i32=p.*.nodes[(nodes-1)*10+7] as i32;let ni:i32=0;let vi:i32=0;
    while(e>0 && ni<8){let er:i32=(e-1)*4;if(p.*.edges[er+3]!=1){return -52;}let node:i32=p.*.edges[er] as i32;let views:i32=pm_lookup(p,node,"views");
        if(pm_kind(p,views)!=9 || p.*.nodes[(views-1)*10+9]!=3){return -53;}let ve:i32=p.*.nodes[(views-1)*10+7] as i32;let local:i32=0;
        while(ve>0 && local<3){let vr:i32=(ve-1)*4;if(p.*.edges[vr+3]!=1){return -54;}let id:i32=p.*.edges[vr] as i32;if(id!=r26_graph_expected(vi)){return -55;}
            let v:NvView=nv_open(p,id);if(v.status!=0 || v.kind!=102 || v.width!=4 || v.endian!=60 || v.order!=67 || v.ndim!=1 || v.elements!=72 || v.dims[0]!=72 || v.bytes!=288){nv_close(&v);return -56;}
            r26_add(b,p.*.input[v.at..v.at+v.bytes]);nv_close(&v);vi=vi+1;local=local+1;ve=p.*.edges[vr+2] as i32;}
        if(local!=3 || ve!=0){return -57;}ni=ni+1;e=p.*.edges[er+2] as i32;}
    if(ni!=8 || vi!=24 || e!=0){return -58;}return b.*.status;
}
fn r26_name_memory(b:*R26Buf,p:*ParentMap,nm:i32)i32 {
    let docs:i32=pm_lookup(p,nm,"docs");let keys:[]i64=pm_words(16);let vals:[]i64=pm_words(16);if(keys.len!=16 || vals.len!=16){pm_free_words(keys);pm_free_words(vals);return -60;}
    let n:i32=r26_collect(p,docs,keys,vals);if(n!=8 || r26_sort_int(p,keys,vals,n)!=0){pm_free_words(keys);pm_free_words(vals);return -61;}
    let i:i32=0;while(i<n && b.*.status==0){let ident:i64=0;if(r26_int(p,keys[i] as i32,&ident)!=0){pm_free_words(keys);pm_free_words(vals);return -62;}r26_i64(b,ident);
        let reducer:i32=vals[i] as i32;if(pm_kind(p,reducer)!=16){pm_free_words(keys);pm_free_words(vals);return -63;}let args:i32=nv_field(p,reducer,5);
        if(nv_tuple_size(p,args)<1){pm_free_words(keys);pm_free_words(vals);return -64;}let doc:i32=nv_item(p,args,0);let dk:[]i64=pm_words(128);let dv:[]i64=pm_words(128);
        if(dk.len!=128 || dv.len!=128){pm_free_words(dk);pm_free_words(dv);pm_free_words(keys);pm_free_words(vals);return -65;}let dn:i32=r26_collect(p,doc,dk,dv);
        if(dn<0 || dn>64 || r26_sort_lex(p,dk,dv,dn)!=0){pm_free_words(dk);pm_free_words(dv);pm_free_words(keys);pm_free_words(vals);return -66;}
        let j:i32=0;while(j<dn && b.*.status==0){if(pm_kind(p,dk[j] as i32)!=7){b.*.status=-67;break;}let count:i64=0;if(r26_int(p,dv[j] as i32,&count)!=0){b.*.status=-68;break;}
            r26_add(b,pm_raw(p,dk[j] as i32));r26_i64(b,count);j=j+1;}pm_free_words(dk);pm_free_words(dv);i=i+1;}
    pm_free_words(keys);pm_free_words(vals);return b.*.status;
}
fn r26_f64_f32_bits(raw:[]u8,out:*i64)i32 {
    if(raw.len!=8){return -1;}let sign:i64=(raw[0] as i64)/128;let exp:i64=((raw[0] as i64)&127)*16+(raw[1] as i64)/16;
    let frac:i64=((raw[1] as i64)&15)*281474976710656+(raw[2] as i64)*1099511627776+(raw[3] as i64)*4294967296+
        (raw[4] as i64)*16777216+(raw[5] as i64)*65536+(raw[6] as i64)*256+(raw[7] as i64);
    if(exp==2047){return -2;}if(exp==0){out.*=sign*2147483648;return 0;}let e:i64=exp-1023;let sig:i64=4503599627370496+frac;
    let exp32:i64=0;let mant:i64=0;
    if(e>=(-126)){
        let q:i64=sig/536870912;let rem:i64=sig-q*536870912;if(rem>268435456 || (rem==268435456 && (q&1)==1)){q=q+1;}
        if(q==16777216){q=q/2;e=e+1;}if(e>127){exp32=255;mant=0;}else{exp32=e+127;mant=q-8388608;}
    }else{
        if(e<(-150)){exp32=0;mant=0;}else{let shift:i32=(-(e+97)) as i32;let den:i64=1;let i:i32=0;while(i<shift){den=den*2;i=i+1;}
            let q:i64=sig/den;let rem:i64=sig-q*den;let half:i64=den/2;if(rem>half || (rem==half && (q&1)==1)){q=q+1;}
            if(q>=8388608){exp32=1;mant=0;}else{exp32=0;mant=q;}}
    }
    out.*=sign*2147483648+exp32*8388608+mant;return 0;
}
fn r26_add_f32(b:*R26Buf,raw:[]u8)i32 {
    let bits:i64=0;let rc:i32=r26_f64_f32_bits(raw,&bits);if(rc!=0){return rc;}r26_byte(b,(bits&255) as i32);r26_byte(b,((bits>>8)&255) as i32);
    r26_byte(b,((bits>>16)&255) as i32);r26_byte(b,((bits>>24)&255) as i32);return b.*.status;
}
fn r26_abstraction_model(b:*R26Buf,p:*ParentMap,models:i32,tag:[]u8)i32 {
    r26_add(b,tag);let model:i32=pm_lookup(p,models,tag);let centroids:i32=pm_lookup(p,model,"centroids");let keys:[]i64=pm_words(16);let vals:[]i64=pm_words(16);
    if(keys.len!=16 || vals.len!=16){pm_free_words(keys);pm_free_words(vals);return -70;}let n:i32=r26_collect(p,centroids,keys,vals);
    if(n!=6 || r26_sort_int(p,keys,vals,n)!=0){pm_free_words(keys);pm_free_words(vals);return -71;}let i:i32=0;

    r26_add(&b,"net.3.bias");if(r26_add_tensor(&b,&p,&w,208859,1,8,0,"fe738947f6ea03c541bc12c04df18166da88f06345dd890202f1a90ba817d1b5")!=0){r26_free(&b);mi_loaded_close(&p);return 91;}

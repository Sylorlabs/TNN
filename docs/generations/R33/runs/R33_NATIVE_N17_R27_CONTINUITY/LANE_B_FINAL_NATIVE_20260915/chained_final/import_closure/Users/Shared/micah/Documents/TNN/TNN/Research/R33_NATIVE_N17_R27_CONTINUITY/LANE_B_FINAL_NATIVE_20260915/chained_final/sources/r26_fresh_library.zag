        let mk:[]i64=pm_words(4096);let mv:[]i64=pm_words(4096);if(mk.len!=4096 || mv.len!=4096){pm_free_words(mk);pm_free_words(mv);pm_free_words(keys);pm_free_words(vals);return -73;}
        let mn:i32=r26_collect(p,vals[i] as i32,mk,mv);if(mn<0 || mn>4096 || r26_sort_lex(p,mk,mv,mn)!=0){pm_free_words(mk);pm_free_words(mv);pm_free_words(keys);pm_free_words(vals);return -74;}
        let j:i32=0;while(j<mn && b.*.status==0){if(pm_kind(p,mk[j] as i32)!=7 || pm_kind(p,mv[j] as i32)!=5){b.*.status=-75;break;}
            r26_add(b,pm_raw(p,mk[j] as i32));if(r26_add_f32(b,pm_raw(p,mv[j] as i32))!=0){b.*.status=-76;break;}j=j+1;}

@import("../r27_native_state_semantics_v4.zag")
@import("../r33_continuing_learner_checkpoint_v1.zag")

// R33 N17 V92: native-only qualification of the R27 V4 continuing-state image.
// This is an engineering qualification lane. It does not mutate canonical R27,
// grant learn authority, or claim historical-parent behavioral projection.

const V92_EXPECTED_IMAGE_BYTES:i32=245472;
const V92_EXPECTED_SECTIONS:i32=33;
const V92_EXPECTED_PENDING_FIELDS:i32=8;

fn v92_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("R33_V92_CHECK,");_zag_print(name);_zag_print(",");
    _zag_print(_zag_i64_to_str(actual as i64));_zag_print(",");
    _zag_println(_zag_i64_to_str(expected as i64));
    return (actual!=expected) as i32;
}

fn v92_equal(a:[]u8,b:[]u8)i32 @noalloc {
    if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}

fn v92_values(id:i32,active_pending:i32)[]i32 {
    let n:i32=r27s4_expected_count(id);if(n<1){return "" as []i32;}
    let v:[]i32=new i32(n);let i:i32=0;while(i<n){v[i]=0;i=i+1;}
    if(id==R27S4_DEVELOPMENT_STEP){v[0]=60423;}
    if(id==R27S4_NEWBORN_RESTARTS){v[0]=0;}
    if(id==R27S4_TRACE_COUNT && active_pending==1){v[0]=1;}
    if(id==R27S4_TRACE_STEP && active_pending==1){v[0]=1;}
    if(id==R27S4_TRACE_STAGE && active_pending==1){v[0]=1;}
    if(id==R27S4_TRACE_REASON && active_pending==1){v[0]=1;}
    if(id==R27S4_TRACE_CONFIDENCE && active_pending==1){v[0]=500;}
    if(id==R27S4_TRACE_PARENT && active_pending==1){v[0]=-1;}
    if(id==R27S4_RNG_PCG64){
        v[0]=60943;v[1]=28063;v[2]=11852;v[3]=47885;v[4]=14922;v[5]=7899;v[6]=43149;v[7]=13154;
        v[8]=47871;v[9]=29307;v[10]=18211;v[11]=12539;v[12]=37667;v[13]=11878;v[14]=12368;v[15]=22841;
        v[16]=0;v[17]=0;v[18]=0;
    }
    if(id==R27S4_PENDING_CREDIT && active_pending==1){
        v[0]=1;v[1]=0;v[2]=4;v[3]=0;v[4]=2;v[5]=5;v[6]=2;v[7]=1;
    }
    return v;
}

fn v92_image(active_pending:i32)[]u8 {
    let image:[]u8=new u8(r27i4_expected_bytes());let count:i32=0;let next:i32=0;
    if(r27i4_begin(image,&count,&next)!=0){return "";}
    let id:i32=1;while(id<=R27I4_SECTION_COUNT){
        let v:[]i32=v92_values(id,active_pending);if(v.len!=r27s4_expected_count(id)){return "";}
        let section:[]u8=new u8(r27s4_section_bytes(id));
        if(r27s4_encode_i32_section(section,id,v)!=0 || r27i4_add(image,&count,&next,id,section)!=0){return "";}
        id=id+1;
    }
    if(r27i4_finish(image,count,next)!=0){return "";}return image;
}

fn v92_verify_all_sections(image:[]u8,out_slots:*i32)i32 {
    if(out_slots==null as *i32){return 1;}out_slots.*=0;let failures:i32=0;let expected_offset:i32=R27I4_PAYLOAD_START;let id:i32=1;
    while(id<=R27I4_SECTION_COUNT){
        let n:i32=r27s4_expected_count(id);let bytes:i32=r27s4_section_bytes(id);
        failures=failures+((n<1 || bytes!=R27S4_HEADER_BYTES+n*4) as i32);
        let dir:i32=R27I4_HEADER_BYTES+(id-1)*R27I4_DIR_ENTRY_BYTES;let got_id:i32=0;let offset:i32=0;let length:i32=0;
        if(r27s4_get_i32(image,dir,&got_id)!=0 || r27s4_get_i32(image,dir+4,&offset)!=0 || r27s4_get_i32(image,dir+8,&length)!=0){failures=failures+1;return failures;}
        failures=failures+((got_id!=id || offset!=expected_offset || length!=bytes) as i32);
        let got:[]u8=r27i4_get(image,id);let v:[]i32=v92_values(id,1);let encoded:[]u8=new u8(bytes);
        if(got.len!=bytes || r27s4_encode_i32_section(encoded,id,v)!=0 || v92_equal(got,encoded)!=1){failures=failures+1;}
        let magic:i32=0;let version:i32=0;let sid:i32=0;let count:i32=0;
        if(got.len<16 || r27s4_get_i32(got,0,&magic)!=0 || r27s4_get_i32(got,4,&version)!=0 || r27s4_get_i32(got,8,&sid)!=0 || r27s4_get_i32(got,12,&count)!=0 ||
           magic!=R27S4_MAGIC || version!=R27S4_VERSION || sid!=id || count!=n){failures=failures+1;}
        let j:i32=0;while(j<n){let actual:i32=0;if(r27s4_get_i32(got,R27S4_HEADER_BYTES+j*4,&actual)!=0 || actual!=v[j]){failures=failures+1;j=n;}else{j=j+1;}}
        out_slots.*=out_slots.*+n;expected_offset=expected_offset+bytes;id=id+1;
    }
    failures=failures+((expected_offset!=image.len) as i32);return failures;
}

fn v92_pending_fields(image:[]u8)i32 {
    let p:[]u8=r27i4_get(image,R27S4_PENDING_CREDIT);if(p.len==0){return 1;}
    let expected:[]i32=new i32(8);expected[0]=1;expected[1]=0;expected[2]=4;expected[3]=0;expected[4]=2;expected[5]=5;expected[6]=2;expected[7]=1;
    let f:i32=0;let i:i32=0;while(i<8){let got:i32=0;if(r27s4_get_i32(p,R27S4_HEADER_BYTES+i*4,&got)!=0 || got!=expected[i]){f=f+1;}i=i+1;}return f;
}

fn v92_structural_refusal()i32 {
    let f:i32=0;let base:[]u8=v92_image(1);if(base.len!=V92_EXPECTED_IMAGE_BYTES){return 1;}
    f=f+((r27i4_check(base[0..base.len-1])==0) as i32);
    let over:[]u8=new u8(base.len+1);let i:i32=0;while(i<base.len){over[i]=base[i];i=i+1;}f=f+((r27i4_check(over)==0) as i32);

    let bad:[]u8=v92_image(1);let old:u8=bad[0];bad[0]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);old=bad[4];bad[4]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);old=bad[8];bad[8]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);old=bad[12];bad[12]=old^1;f=f+((r27i4_check(bad)==0) as i32);

    bad=v92_image(1);old=bad[R27I4_HEADER_BYTES];bad[R27I4_HEADER_BYTES]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);old=bad[R27I4_HEADER_BYTES+4];bad[R27I4_HEADER_BYTES+4]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);old=bad[R27I4_HEADER_BYTES+8];bad[R27I4_HEADER_BYTES+8]=old^1;f=f+((r27i4_check(bad)==0) as i32);

    bad=v92_image(1);let first_offset:i32=0;if(r27s4_get_i32(bad,R27I4_HEADER_BYTES+4,&first_offset)!=0){return f+1;}
    old=bad[first_offset];bad[first_offset]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);if(r27s4_get_i32(bad,R27I4_HEADER_BYTES+4,&first_offset)!=0){return f+1;}old=bad[first_offset+4];bad[first_offset+4]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);if(r27s4_get_i32(bad,R27I4_HEADER_BYTES+4,&first_offset)!=0){return f+1;}old=bad[first_offset+8];bad[first_offset+8]=old^1;f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);if(r27s4_get_i32(bad,R27I4_HEADER_BYTES+4,&first_offset)!=0){return f+1;}old=bad[first_offset+12];bad[first_offset+12]=old^1;f=f+((r27i4_check(bad)==0) as i32);

    bad=v92_image(1);let pending:[]u8=r27i4_get(bad,R27S4_PENDING_CREDIT);if(pending.len==0 || r27s4_put_i32(pending,R27S4_HEADER_BYTES,2)!=0){return f+1;}f=f+((r27i4_check(bad)==0) as i32);
    bad=v92_image(1);pending=r27i4_get(bad,R27S4_PENDING_CREDIT);if(pending.len==0 || r27s4_put_i32(pending,R27S4_HEADER_BYTES+4,7)!=0){return f+1;}f=f+((r27sv4_validate(bad)==0) as i32);
    bad=v92_image(1);pending=r27i4_get(bad,R27S4_PENDING_CREDIT);if(pending.len==0 || r27s4_put_i32(pending,R27S4_HEADER_BYTES+3*4,R27SV4_ENTITY_MAX)!=0){return f+1;}f=f+((r27sv4_validate(bad)==0) as i32);
    bad=v92_image(1);let restarts:[]u8=r27i4_get(bad,R27S4_NEWBORN_RESTARTS);if(restarts.len==0 || r27s4_put_i32(restarts,R27S4_HEADER_BYTES,1)!=0){return f+1;}f=f+((r27sv4_validate(bad)==0) as i32);
    return f;
}

fn v92_builder_refusal()i32 {
    let f:i32=0;let total:i32=r27i4_expected_bytes();let short:[]u8=new u8(total-1);let c:i32=0;let n:i32=0;
    f=f+((r27i4_begin(short,&c,&n)==0) as i32);
    let out:[]u8=new u8(total);f=f+((r27i4_begin(out,&c,&n)!=0) as i32);
    let v2:[]i32=v92_values(2,1);let s2:[]u8=new u8(r27s4_section_bytes(2));
    if(r27s4_encode_i32_section(s2,2,v2)!=0){return f+1;}f=f+((r27i4_add(out,&c,&n,2,s2)==0) as i32);
    f=f+((r27i4_finish(out,c,n)==0) as i32);
    return f;
}

fn v92_packet_integrity(image:[]u8)i32 {
    let f:i32=0;let packet:[]u8=new u8(r33cla1_expected_bytes());
    f=f+((r33cla1_pack(packet,image)!=R33CLA1_OK) as i32);if(f!=0){return f;}
    f=f+((r33cla1_check(packet)!=R33CLA1_OK) as i32);
    let extracted:[]u8=r33cla1_extract(packet);f=f+((extracted.len!=image.len || v92_equal(extracted,image)!=1) as i32);
    f=f+((r33cla1_check(packet[0..packet.len-1])==R33CLA1_OK) as i32);
    if(extracted.len>R27I4_PAYLOAD_START+R27S4_HEADER_BYTES){let at:i32=R27I4_PAYLOAD_START+R27S4_HEADER_BYTES;let old:u8=extracted[at];extracted[at]=old^1;
        f=f+((r33cla1_check(packet)==R33CLA1_OK) as i32);extracted[at]=old;f=f+((r33cla1_check(packet)!=R33CLA1_OK) as i32);
    }else{f=f+1;}
    return f;
}

fn main()i32 {
    let failures:i32=0;let image:[]u8=v92_image(1);
    failures=failures+v92_check("section_count",R27I4_SECTION_COUNT,V92_EXPECTED_SECTIONS);
    failures=failures+v92_check("image_bytes",r27i4_expected_bytes(),V92_EXPECTED_IMAGE_BYTES);
    failures=failures+v92_check("image_built",(image.len==V92_EXPECTED_IMAGE_BYTES) as i32,1);
    if(image.len!=V92_EXPECTED_IMAGE_BYTES){_zag_println("R33_V92_RESULT,FAIL_BUILD");return 2;}
    failures=failures+v92_check("image_structural_valid",r27i4_check(image),0);
    failures=failures+v92_check("image_semantic_valid",r27sv4_validate(image),0);
    let slots:i32=0;let section_failures:i32=v92_verify_all_sections(image,&slots);failures=failures+v92_check("all_33_section_roundtrips",section_failures,0);
    failures=failures+v92_check("pending_8_fields",v92_pending_fields(image),0);
    let inactive:[]u8=v92_image(0);failures=failures+v92_check("inactive_pending_semantic_valid",r27sv4_validate(inactive),0);
    failures=failures+v92_check("builder_refusal",v92_builder_refusal(),0);
    failures=failures+v92_check("truncation_and_structural_corruption_refusal",v92_structural_refusal(),0);
    failures=failures+v92_check("checksum_bound_packet_integrity",v92_packet_integrity(image),0);
    _zag_print("R33_V92_SECTIONS_VERIFIED,");_zag_println(_zag_i64_to_str(R27I4_SECTION_COUNT as i64));
    _zag_print("R33_V92_VALUE_SLOTS_VERIFIED,");_zag_println(_zag_i64_to_str(slots as i64));
    _zag_print("R33_V92_PENDING_FIELDS_VERIFIED,");_zag_println(_zag_i64_to_str(V92_EXPECTED_PENDING_FIELDS as i64));
    _zag_print("R33_V92_IMAGE_BYTES,");_zag_println(_zag_i64_to_str(image.len as i64));
    _zag_print("R33_V92_PACKET_BYTES,");_zag_println(_zag_i64_to_str(r33cla1_expected_bytes() as i64));
    _zag_print("R33_V92_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));
    if(failures==0){_zag_println("R33_V92_RESULT,PASS");}else{_zag_println("R33_V92_RESULT,FAIL");}
    return (failures!=0) as i32;
}

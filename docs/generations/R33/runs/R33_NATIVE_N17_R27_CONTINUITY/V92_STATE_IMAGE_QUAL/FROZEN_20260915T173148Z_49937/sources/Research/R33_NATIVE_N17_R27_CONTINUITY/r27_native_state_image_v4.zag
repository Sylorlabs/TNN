@import("r27_native_state_sections_v4.zag")

// Aggregate exactly 33 R27 learner-state sections into one checkpoint payload.
// The outer continuing-life checkpoint can therefore retain its small section
// table while treating the learner image atomically with world/ingress state.

const R27I4_MAGIC:i32=1228354130; // provisional numeric tag, validated internally
const R27I4_VERSION:i32=4;
const R27I4_SECTION_COUNT:i32=33;
const R27I4_HEADER_BYTES:i32=16;
const R27I4_DIR_ENTRY_BYTES:i32=12;
const R27I4_PAYLOAD_START:i32=R27I4_HEADER_BYTES+R27I4_SECTION_COUNT*R27I4_DIR_ENTRY_BYTES;

// The local Zag compiler can misbind module constants when this source is
// imported into a larger qualification unit. Keep the documented constants
// above, but use literal-return accessors in executable paths so the wire
// contract remains stable under import.
fn r27i4_magic_value()i32 @noalloc {return 1228354130;}
fn r27i4_version_value()i32 @noalloc {return 4;}
fn r27i4_section_count_value()i32 @noalloc {return 33;}
fn r27i4_header_bytes_value()i32 @noalloc {return 16;}
fn r27i4_dir_entry_bytes_value()i32 @noalloc {return 12;}
fn r27i4_payload_start_value()i32 @noalloc {return 412;}

fn r27i4_expected_bytes()i32 @noalloc {
    let total:i32=r27i4_payload_start_value();let id:i32=1;
    while(id<=r27i4_section_count_value()){let n:i32=r27s4_section_bytes(id);if(n<0){return -1;}total=total+n;id=id+1;}
    return total;
}

fn r27i4_begin(out:[]u8,count:*i32,next:*i32)i32 @noalloc {
    if(count==null as *i32 || next==null as *i32 || out.len!=r27i4_expected_bytes()){return -1;}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    if(r27s4_put_i32(out,0,r27i4_magic_value())!=0 || r27s4_put_i32(out,4,r27i4_version_value())!=0 ||
       r27s4_put_i32(out,8,0)!=0 || r27s4_put_i32(out,12,0)!=0){return -1;}
    count.*=0;next.*=r27i4_payload_start_value();return 0;
}

fn r27i4_add(out:[]u8,count:*i32,next:*i32,id:i32,section:[]u8)i32 @noalloc {
    if(count==null as *i32 || next==null as *i32 || count.*<0 || count.*>=r27i4_section_count_value()){return -1;}
    let expected_id:i32=count.*+1;if(id!=expected_id){return -1;}
    let expected_len:i32=r27s4_section_bytes(id);if(expected_len<0 || section.len!=expected_len){return -1;}
    let smagic:i32=0;let sversion:i32=0;let sid:i32=0;let scount:i32=0;
    if(r27s4_get_i32(section,0,&smagic)!=0 || r27s4_get_i32(section,4,&sversion)!=0 ||
       r27s4_get_i32(section,8,&sid)!=0 || r27s4_get_i32(section,12,&scount)!=0){return -1;}
    if(smagic!=r27s4_magic_value() || sversion!=r27s4_version_value() || sid!=id || scount!=r27s4_expected_count(id)){return -1;}
    if(next.*<r27i4_payload_start_value() || next.*>out.len-section.len){return -1;}
    let dir:i32=r27i4_header_bytes_value()+count.* * r27i4_dir_entry_bytes_value();
    if(r27s4_put_i32(out,dir,id)!=0 || r27s4_put_i32(out,dir+4,next.*)!=0 || r27s4_put_i32(out,dir+8,section.len)!=0){return -1;}
    let i:i32=0;while(i<section.len){out[next.*+i]=section[i];i=i+1;}
    next.*=next.*+section.len;count.*=count.*+1;return 0;
}

fn r27i4_finish(out:[]u8,count:i32,next:i32)i32 @noalloc {
    if(count!=r27i4_section_count_value() || next!=out.len || out.len!=r27i4_expected_bytes()){return -1;}
    if(r27s4_put_i32(out,8,count)!=0 || r27s4_put_i32(out,12,out.len)!=0){return -1;}return 0;
}

fn r27i4_check(image:[]u8)i32 @noalloc {
    if(image.len!=r27i4_expected_bytes()){return -1;}
    let magic:i32=0;let version:i32=0;let count:i32=0;let total:i32=0;
    if(r27s4_get_i32(image,0,&magic)!=0 || r27s4_get_i32(image,4,&version)!=0 ||
       r27s4_get_i32(image,8,&count)!=0 || r27s4_get_i32(image,12,&total)!=0){return -1;}
    if(magic!=r27i4_magic_value() || version!=r27i4_version_value() || count!=r27i4_section_count_value() || total!=image.len){return -1;}
    let expected_offset:i32=r27i4_payload_start_value();let id:i32=1;
    while(id<=r27i4_section_count_value()){
        let dir:i32=r27i4_header_bytes_value()+(id-1)*r27i4_dir_entry_bytes_value();
        let got_id:i32=0;let offset:i32=0;let length:i32=0;
        if(r27s4_get_i32(image,dir,&got_id)!=0 || r27s4_get_i32(image,dir+4,&offset)!=0 || r27s4_get_i32(image,dir+8,&length)!=0){return -1;}
        if(got_id!=id || offset!=expected_offset || length!=r27s4_section_bytes(id) || offset<0 || offset>image.len-length){return -1;}
        let smagic:i32=0;let sversion:i32=0;let sid:i32=0;let scount:i32=0;
        if(r27s4_get_i32(image,offset,&smagic)!=0 || r27s4_get_i32(image,offset+4,&sversion)!=0 ||
           r27s4_get_i32(image,offset+8,&sid)!=0 || r27s4_get_i32(image,offset+12,&scount)!=0){return -1;}
        if(smagic!=r27s4_magic_value() || sversion!=r27s4_version_value() || sid!=id || scount!=r27s4_expected_count(id)){return -1;}
        if(r27s4_expected_count(id)==1 && r27s4_validate_scalar_section(image[offset..offset+length],id)!=0){return -1;}
        if(id==r27s4_pending_credit_id() && r27s4_validate_pending_credit(image[offset..offset+length])!=0){return -1;}
        expected_offset=expected_offset+length;id=id+1;
    }
    if(expected_offset!=image.len){return -1;}return 0;
}

fn r27i4_get(image:[]u8,id:i32)[]u8 @noalloc {
    if(id<1 || id>r27i4_section_count_value() || r27i4_check(image)!=0){return "";}
    let dir:i32=r27i4_header_bytes_value()+(id-1)*r27i4_dir_entry_bytes_value();let offset:i32=0;let length:i32=0;
    if(r27s4_get_i32(image,dir+4,&offset)!=0 || r27s4_get_i32(image,dir+8,&length)!=0){return "";}
    return image[offset..offset+length];
}

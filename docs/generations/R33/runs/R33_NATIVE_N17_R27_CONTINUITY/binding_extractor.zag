// R33-N17 authoring-only frozen-inventory binding extractor.
// Reads only already-consumed N12/N13A inventory artifacts. It does not open
// the canonical parent, execute reducers, train, mutate state, or grant any
// continuity/promotion credit. Native Zag only; no Python execution.
@import("../R33_NATIVE_IO_V1.zag")

fn be_u32(b:[]u8,at:i32)i64 {
    if(at<0 || at+4>b.len){return -1;}
    return (b[at] as i64)+(b[at+1] as i64)*256+(b[at+2] as i64)*65536+(b[at+3] as i64)*16777216;
}
fn be_print_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn be_print_field(v:i64)void {_zag_print(",");be_print_i64(v);}
fn be_print_hex(b:[]u8)void {
    let digits:[]u8="0123456789abcdef";let out:[]u8=nio_alloc(b.len*2);
    if(out.len!=b.len*2){_zag_print("ALLOC_FAIL");return;}
    let i:i32=0;while(i<b.len){let x:i32=b[i] as i32;out[i*2]=digits[x/16];out[i*2+1]=digits[x%16];i=i+1;}
    _zag_print(out);nio_free(out);
}
fn be_name(prefix:[]u8,index:i32)[]u8 {
    let n:[]u8=_zag_i64_to_str(index as i64);let a:[]u8=_zag_str_concat(prefix,n);nio_free(n);
    let out:[]u8=_zag_str_concat(a,".bin");nio_free(a);return out;
}
fn be_magic(b:[]u8,magic:[]u8)i32 {
    if(b.len<magic.len){return 0;}let i:i32=0;while(i<magic.len){if(b[i]!=magic[i]){return 0;}i=i+1;}return 1;
}
fn be_n13_target(id:i64)i32 {
    return (id==208657 || id==208676 || id==208765 || id==208783 || id==208841 || id==208859) as i32;
}
fn be_n12_target(id:i64)i32 {
    return (id==208906 || id==208911 || id==208916 || id==208923 || id==208928 || id==208933 ||
        id==208940 || id==208945 || id==208950 || id==208957 || id==208962 || id==208967 ||
        id==208974 || id==208979 || id==208984 || id==208991 || id==208996 || id==209001 ||
        id==209008 || id==209013 || id==209018 || id==209025 || id==209030 || id==209035) as i32;
}
fn be_emit_n13(row:[]u8,page:i32,offset:i32)void {
    _zag_print("N17_BIND_TENSOR");let i:i32=0;while(i<=20){be_print_field(be_u32(row,i*4));i=i+1;}
    i=0;while(i<8){be_print_field(be_u32(row,96+i*4));i=i+1;}i=0;while(i<8){be_print_field(be_u32(row,128+i*4));i=i+1;}
    _zag_print(",");be_print_hex(row[160..192]);_zag_print(",");be_print_hex(row[192..224]);_zag_print(",");be_print_hex(row[224..256]);
    be_print_field(page);be_print_field(offset);_zag_println("");
}
fn be_emit_n12(row:[]u8,page:i32,offset:i32)void {
    _zag_print("N17_BIND_NUMERIC");let i:i32=0;while(i<=15){be_print_field(be_u32(row,i*4));i=i+1;}
    i=0;while(i<8){be_print_field(be_u32(row,64+i*4));i=i+1;}i=0;while(i<8){be_print_field(be_u32(row,96+i*4));i=i+1;}
    _zag_print(",");be_print_hex(row[128..160]);be_print_field(page);be_print_field(offset);_zag_println("");
}
fn be_manifest(root:i64,name:[]u8,magic:[]u8,row_size:i32)i32 {
    let fd:i64=nio_open_child(root,name,0);if(fd<0){return -1;}let b:[]u8=nio_alloc(65536);if(b.len==0){nio_close(fd);return -1;}
    let n:i64=nio_read_exact(fd,b,65535);nio_close(fd);if(n<160 || be_magic(b[0..n as i32],magic)!=1 || be_u32(b,12)!=row_size){nio_free(b);return -1;}
    let pages:i64=be_u32(b,20);nio_free(b);if(pages<1 || pages>64){return -1;}return pages as i32;
}
fn be_scan_n13()i32 {
    let root:i64=nio_open_root("Research/R33_NATIVE_N13A_RUN_PRIMARY_V1");if(root<0){return 1;}
    let pages:i32=be_manifest(root,"torch-manifest.bin","R33TS001",256);if(pages<1){nio_close(root);return 2;}
    let buf:[]u8=nio_alloc(65536);if(buf.len==0){nio_close(root);return 3;}let found:i32=0;let page:i32=1;
    while(page<=pages){let name:[]u8=be_name("torch-page-",page);let fd:i64=nio_open_child(root,name,0);nio_free(name);if(fd<0){nio_free(buf);nio_close(root);return 4;}
        let n:i64=nio_read_exact(fd,buf,65536);nio_close(fd);if(n<256 || n%256!=0){nio_free(buf);nio_close(root);return 5;}
        let at:i32=0;while((at as i64)<n){let id:i64=be_u32(buf,at);if(be_n13_target(id)==1){be_emit_n13(buf[at..at+256],page,at);found=found+1;}at=at+256;}page=page+1;}
    nio_free(buf);nio_close(root);_zag_print("N17_BIND_TENSOR_FOUND,");be_print_i64(found);_zag_println("");return (found!=6) as i32;
}
fn be_scan_n12()i32 {
    let root:i64=nio_open_root("Research/R33_NATIVE_N12_RUN_PRIMARY_V1");if(root<0){return 11;}
    let pages:i32=be_manifest(root,"numeric-manifest.bin","R33NV001",160);if(pages<1){nio_close(root);return 12;}
    let buf:[]u8=nio_alloc(64000);if(buf.len==0){nio_close(root);return 13;}let found:i32=0;let page:i32=1;
    while(page<=pages){let name:[]u8=be_name("numeric-page-",page);let fd:i64=nio_open_child(root,name,0);nio_free(name);if(fd<0){nio_free(buf);nio_close(root);return 14;}
        let n:i64=nio_read_exact(fd,buf,64000);nio_close(fd);if(n<160 || n%160!=0){nio_free(buf);nio_close(root);return 15;}
        let at:i32=0;while((at as i64)<n){let id:i64=be_u32(buf,at);if(be_n12_target(id)==1){be_emit_n12(buf[at..at+160],page,at);found=found+1;}at=at+160;}page=page+1;}
    nio_free(buf);nio_close(root);_zag_print("N17_BIND_NUMERIC_FOUND,");be_print_i64(found);_zag_println("");return (found!=24) as i32;
}
fn main()i32 {
    if(_zag_argc()!=1){return 64;}let a:i32=be_scan_n13();if(a!=0){return 70+a;}let b:i32=be_scan_n12();if(b!=0){return 90+b;}
    _zag_println("N17_BINDING_EXTRACTOR_PASS");return 0;
}

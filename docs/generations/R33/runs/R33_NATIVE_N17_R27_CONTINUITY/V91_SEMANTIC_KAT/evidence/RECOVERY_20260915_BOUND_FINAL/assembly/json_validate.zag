// Native syntax validation of this lane's own evidence JSON only.
struct JV {b:[]u8,at:i32}
fn jw(p:*JV)void {while(p.*.at<p.*.b.len&&(p.*.b[p.*.at]==32||p.*.b[p.*.at]==9||p.*.b[p.*.at]==10||p.*.b[p.*.at]==13)){p.*.at=p.*.at+1;}}
fn jc(p:*JV,c:u8)bool {jw(p);if(p.*.at>=p.*.b.len||p.*.b[p.*.at]!=c){return false;}p.*.at=p.*.at+1;return true;}
fn js(p:*JV)bool {if(!jc(p,34)){return false;}while(p.*.at<p.*.b.len){let c:u8=p.*.b[p.*.at];p.*.at=p.*.at+1;if(c==34){return true;}if(c<32){return false;}if(c==92){if(p.*.at>=p.*.b.len){return false;}let x:u8=p.*.b[p.*.at];p.*.at=p.*.at+1;if(x==117){let n:i32=0;while(n<4){if(p.*.at>=p.*.b.len){return false;}let h:u8=p.*.b[p.*.at];if(!((h>=48&&h<=57)||(h>=65&&h<=70)||(h>=97&&h<=102))){return false;}p.*.at=p.*.at+1;n=n+1;}}else if(x!=34&&x!=92&&x!=47&&x!=98&&x!=102&&x!=110&&x!=114&&x!=116){return false;}}}return false;}
fn jd(p:*JV)bool {return p.*.at<p.*.b.len&&p.*.b[p.*.at]>=48&&p.*.b[p.*.at]<=57;}
fn jn(p:*JV)bool {let start:i32=p.*.at;if(p.*.at<p.*.b.len&&p.*.b[p.*.at]==45){p.*.at=p.*.at+1;}if(!jd(p)){return false;}if(p.*.b[p.*.at]==48){p.*.at=p.*.at+1;}else{while(jd(p)){p.*.at=p.*.at+1;}}if(p.*.at<p.*.b.len&&p.*.b[p.*.at]==46){p.*.at=p.*.at+1;if(!jd(p)){return false;}while(jd(p)){p.*.at=p.*.at+1;}}if(p.*.at<p.*.b.len&&(p.*.b[p.*.at]==101||p.*.b[p.*.at]==69)){p.*.at=p.*.at+1;if(p.*.at<p.*.b.len&&(p.*.b[p.*.at]==43||p.*.b[p.*.at]==45)){p.*.at=p.*.at+1;}if(!jd(p)){return false;}while(jd(p)){p.*.at=p.*.at+1;}}return p.*.at>start;}
fn jl(p:*JV,s:[]u8)bool {if(s.len>p.*.b.len-p.*.at||!@strEq(p.*.b[p.*.at..p.*.at+s.len],s)){return false;}p.*.at=p.*.at+s.len;return true;}
fn jv(p:*JV,depth:i32)bool {jw(p);if(depth>32||p.*.at>=p.*.b.len){return false;}let c:u8=p.*.b[p.*.at];if(c==34){return js(p);}if(c==123){p.*.at=p.*.at+1;if(jc(p,125)){return true;}while(true){if(!js(p)||!jc(p,58)||!jv(p,depth+1)){return false;}if(jc(p,125)){return true;}if(!jc(p,44)){return false;}}}if(c==91){p.*.at=p.*.at+1;if(jc(p,93)){return true;}while(true){if(!jv(p,depth+1)){return false;}if(jc(p,93)){return true;}if(!jc(p,44)){return false;}}}if(c==116){return jl(p,"true");}if(c==102){return jl(p,"false");}if(c==110){return jl(p,"null");}return jn(p);}
fn main()i32 {if(_zag_argc()!=2){return 2;}let b:[]u8=_zag_read_file(_zag_arg(1));if(b.len<1){return 1;}let p:JV=JV{.b=b,.at=0};let valid:bool=jv(&p,0);jw(&p);if(!valid||p.at!=b.len){return 1;}_zag_println("V91_RECORD_JSON_SYNTAX,PASS");return 0;}

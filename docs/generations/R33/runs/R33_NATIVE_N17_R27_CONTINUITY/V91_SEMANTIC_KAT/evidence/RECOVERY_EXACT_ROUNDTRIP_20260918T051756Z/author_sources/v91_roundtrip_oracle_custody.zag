// Post-inference custody extraction for the historical roundtrip strings.
// This source is never imported into the inference closure.
@import("../identity.zag")

fn vro_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}
fn vro_item(p:*ParentMap,id:i32,index:i32)i32 {if(pm_kind(p,id)!=9||index<0||index>=p.*.nodes[(id-1)*10+9]){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let i:i32=0;while(e>0&&i<index){e=p.*.edges[(e-1)*4+2] as i32;i=i+1;}if(e<=0||p.*.edges[(e-1)*4+3]!=1){return 0;}return p.*.edges[(e-1)*4] as i32;}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}
    let r26:i32=pm_lookup(&p,p.root,"base_state");let r25:i32=pm_lookup(&p,r26,"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");let r23:i32=pm_lookup(&p,r24,"r23_state");let evidence:i32=pm_lookup(&p,r23,"evidence");let sem:i32=pm_lookup(&p,evidence,"semantic_generation");let examples:i32=pm_lookup(&p,sem,"examples");if(pm_kind(&p,examples)!=9||p.nodes[(examples-1)*10+9]!=16){mi_loaded_close(&p);return 4;}
    let frame:[]u8=nio_alloc(8192);mi_copy("V91RTO01",frame);mi_put(frame,8,16);mi_put(frame,12,r23);let parent_hash:[]u8=pb_hex(vro_hash(p.input));mi_copy(parent_hash,frame[16..48]);nio_free(parent_hash);let used:i32=48;let i:i32=0;
    while(i<16){let example:i32=vro_item(&p,examples,i);let node:i32=pm_lookup(&p,example,"roundtrip");if(pm_kind(&p,example)!=11||pm_kind(&p,node)!=6){mi_loaded_close(&p);return 5;}let nr:i32=(node-1)*10;let op_at:i32=p.nodes[nr+1] as i32;let at:i32=p.nodes[nr+2] as i32;let len:i32=p.nodes[nr+3] as i32;if(op_at<0||at<0||len<1||op_at>=p.input.len||len>p.input.len-at||len>8192-used-24){mi_loaded_close(&p);return 6;}let bytes:[]u8=pm_raw(&p,node);if(bytes.len!=len||nio_equal(bytes,p.input[at..at+len])!=1){mi_loaded_close(&p);return 7;}mi_put(frame,used,i);mi_put(frame,used+4,node);mi_put(frame,used+8,op_at);mi_put(frame,used+12,p.input[op_at] as i32);mi_put(frame,used+16,at);mi_put(frame,used+20,len);mi_copy(bytes,frame[used+24..used+24+len]);used=used+24+len;_zag_print("V91_ROUNDTRIP_ORACLE,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",text=");_zag_println(bytes);i=i+1;}
    let out:[]u8=frame[0..used];if(_zag_write_file(_zag_arg(1),out)!=0){mi_loaded_close(&p);return 8;}_zag_print("V91_ROUNDTRIP_ORACLE_FRAME_SHA256,");_zag_println(vro_hash(out));mi_loaded_close(&p);return 0;
}

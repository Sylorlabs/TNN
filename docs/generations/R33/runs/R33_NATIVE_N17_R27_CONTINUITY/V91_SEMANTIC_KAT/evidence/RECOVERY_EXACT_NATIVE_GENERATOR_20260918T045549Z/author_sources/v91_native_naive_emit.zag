// Oracle-free inference stage. Import closure contains model/runtime semantics
// only; it does not import dataset/oracle custody code.
@import("v91_native_naive_v1.zag")

fn vi_get32(b:[]u8,at:i32)i32 @noalloc {if(at<0||at+4>b.len){return -1;}return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}
fn vi_put32(b:[]u8,at:i32,x:i32)i32 @noalloc {if(at<0||at+4>b.len){return 1;}b[at]=(x&255) as u8;b[at+1]=((x>>8)&255) as u8;b[at+2]=((x>>16)&255) as u8;b[at+3]=((x>>24)&255) as u8;return 0;}
fn vi_eq(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn vi_hash(b:[]u8)[]u8 {let h:[]u8=vg_u8(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}

fn main()i32 {
    if(_zag_argc()!=4){return 2;}let model:V91NaiveModel=vg_load(_zag_arg(1));if(model.status!=0){return 3;}
    let cf:[]u8=_zag_read_file(_zag_arg(2));if(cf.len!=752||vi_eq(cf[0..8],"V91CND01")!=1||vi_get32(cf,8)!=16||vi_get32(cf,12)!=42){return 4;}
    let frame:[]u8=vg_u8(8192);let magic:[]u8="V91GEN01";let i:i32=0;while(i<8){frame[i]=magic[i];i=i+1;}vi_put32(frame,8,16);vi_put32(frame,12,1);let used:i32=16;let c:[]f64=vg_f64(42);i=0;
    while(i<16){let ca:i32=16+i*46;let seed:i32=vi_get32(cf,ca);if(seed<0){return 5;}let j:i32=0;while(j<42){let x:i32=cf[ca+4+j] as i32;if(x!=0&&x!=1){return 6;}c[j]=x as f64;j=j+1;}let status:i32=-1;let got:[]u8=vg_generate_naive(&model,c,seed as u64,&status);if(status!=0||got.len<1||used+12+got.len>frame.len){return 7;}vi_put32(frame,used,i);vi_put32(frame,used+4,seed);vi_put32(frame,used+8,got.len);let k:i32=0;while(k<got.len){frame[used+12+k]=got[k];k=k+1;}used=used+12+got.len;
        _zag_print("V91_NATIVE_GENERATED,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",seed=");_zag_print(_zag_i64_to_str(seed as i64));_zag_print(",bytes=");_zag_print(_zag_i64_to_str(got.len as i64));_zag_print(",text=");_zag_println(got);i=i+1;}
    let out:[]u8=frame[0..used];if(_zag_write_file(_zag_arg(3),out)!=0){return 8;}_zag_print("V91_NATIVE_GENERATED_FRAME_SHA256,");_zag_println(vi_hash(out));_zag_println("V91_ACTUAL_NATIVE_GENERATED,16");return 0;
}

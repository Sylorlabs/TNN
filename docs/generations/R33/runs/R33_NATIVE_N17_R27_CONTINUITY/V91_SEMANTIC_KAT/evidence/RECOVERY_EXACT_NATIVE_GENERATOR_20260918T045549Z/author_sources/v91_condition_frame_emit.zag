// Dataset/condition reconstruction stage only. Historical output strings are
// not written into the emitted condition frame.
@import("v91_semantic_kat.zag")
@import("../../R33_NATIVE_SHA256_V2.zag")

fn vc_put32(b:[]u8,at:i32,x:i32)i32 @noalloc {
    if(at<0||at+4>b.len){return 1;}
    b[at]=(x&255) as u8;b[at+1]=((x>>8)&255) as u8;b[at+2]=((x>>16)&255) as u8;b[at+3]=((x>>24)&255) as u8;return 0;
}
fn vc_hash(b:[]u8)[]u8 {let h:[]u8=v91_alloc_u8(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}
    let rows:[]i32=v91_alloc_i32(V91_ROWS*7);let tr:[]i32=v91_alloc_i32(V91_ROWS);let te:[]i32=v91_alloc_i32(V91_ROWS);let nt:i32=0;let nh:i32=0;
    if(v91_build(rows)!=0||v91_split(rows,tr,te,&nt,&nh)!=0||nh<16){return 3;}
    let frame:[]u8=v91_alloc_u8(752);let magic:[]u8="V91CND01";let i:i32=0;while(i<8){frame[i]=magic[i];i=i+1;}if(vc_put32(frame,8,16)!=0||vc_put32(frame,12,42)!=0){return 4;}
    let c:[]i32=v91_alloc_i32(42);let at:i32=16;let matched:i32=0;i=0;
    while(i<16){let r:V91Row=v91_row_get(rows,te[i]);if(v91_expected_row(i,r)!=1||v91_condition(r,c)!=0){return 5;}matched=matched+1;if(vc_put32(frame,at,23101+i)!=0){return 6;}at=at+4;let j:i32=0;while(j<42){if(c[j]!=0&&c[j]!=1){return 7;}frame[at+j]=c[j] as u8;j=j+1;}at=at+42;i=i+1;}
    if(at!=752||_zag_write_file(_zag_arg(1),frame)!=0){return 8;}
    _zag_print("V91_CONDITION_FRAME_SHA256,");_zag_println(vc_hash(frame));
    _zag_print("V91_CONDITION_ROWS,");_zag_println(_zag_i64_to_str(matched as i64));
    _zag_print("V91_RAW_TRAIN,");_zag_println(_zag_i64_to_str(nt as i64));
    _zag_print("V91_RAW_TEST,");_zag_println(_zag_i64_to_str(nh as i64));return 0;
}

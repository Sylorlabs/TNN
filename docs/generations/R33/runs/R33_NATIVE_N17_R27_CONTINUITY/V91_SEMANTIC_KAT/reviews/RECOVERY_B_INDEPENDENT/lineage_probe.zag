@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
fn lp_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn lp_dump(p:*ParentMap,id:i32,label:[]u8,depth:i32)void {
 _zag_print("LP_NODE,");_zag_print(label);_zag_print(",id=");lp_num(id as i64);_zag_print(",kind=");lp_num(pm_kind(p,id) as i64);_zag_println("");if(depth<1){return;}
 let state:i32=pm_build_state(p,id);if(pm_kind(p,state)!=11){return;}let e:i32=p.*.nodes[(state-1)*10+7] as i32;let n:i32=0;while(e>0&&e<=p.*.edge_count&&n<128){let r:i32=(e-1)*4;lp_dump(p,p.*.edges[r+1] as i32,_zag_str_concat(_zag_str_concat(label,"."),pm_raw(p,p.*.edges[r] as i32)),depth-1);e=p.*.edges[r+2] as i32;n=n+1;}
}
fn main()i32 {let b:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),b);nio_free(b);if(p.status!=0||n17_identity(&p)!=0){return 3;}let r25:i32=pm_lookup(&p,pm_lookup(&p,p.root,"base_state"),"base_state");let r23:i32=pm_lookup(&p,pm_lookup(&p,r25,"r24_state"),"r23_state");let sg:i32=pm_lookup(&p,r23,"semantic_generator");lp_dump(&p,pm_lookup(&p,sg,"interpreter"),"original.interpreter",2);lp_dump(&p,pm_lookup(&p,pm_lookup(&p,p.root,"semantic_generator"),"interpreter"),"retained.interpreter",2);mi_loaded_close(&p);return 0;}

@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
fn sp_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32||ns_sha256(b,h)!=0){return "";}let s:[]u8=ns_hex(h);nio_free(h);return s;}
fn main()i32 {
 if(_zag_argc()!=2){return 2;}let list:[]u8=_zag_read_file(_zag_arg(1));if(list.len<0){return 3;}let i:i32=0;let start:i32=0;let scanned:i32=0;let found:i32=0;
 while(i<=list.len){if(i==list.len||list[i]==10){if(i>start){let path:[]u8=list[start..i];let b:[]u8=_zag_read_file(path);if(b.len<0){return 4;}let hash:[]u8=sp_hash(b);_zag_print("SP91_CANDIDATE,");_zag_print(path);_zag_print(",bytes=");_zag_print(_zag_i64_to_str(b.len as i64));_zag_print(",sha256=");_zag_println(hash);scanned=scanned+1;if(b.len==63069&&nio_equal(hash,"517eb325096d5ae71ebb3bf659da77eac4266129136b888b469a99e366d4b642")==1){found=found+1;}nio_free(b);}start=i+1;}i=i+1;}
 _zag_print("SP91_EXACT_SOURCE_MATCHES,");_zag_println(_zag_i64_to_str(found as i64));_zag_print("SP91_CANDIDATES_SCANNED,");_zag_println(_zag_i64_to_str(scanned as i64));if(found==0){_zag_println("SP91_SOURCE_BLOCKER,src/r23_experiments.py,63069,517eb325096d5ae71ebb3bf659da77eac4266129136b888b469a99e366d4b642\nSP91_METHODS_ABSENT,_build_semantic_dataset,BPE,forward,generate,seeded_sampler\nSP91_GENERATED_OUTPUTS,0\nSP91_ADMISSION,CLOSED");return 91;}return 0;
}

    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn nio_name_valid(s:[]u8)i32 {
    if(s.len<1 || s.len>64){return 0;}
    if(_zag_strcmp(s,".")==1 || _zag_strcmp(s,"..")==1){return 0;}
    let i:i32=0;while(i<s.len){
        let c:i32=s[i] as i32;
        if(!((c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122)||c==45||c==46||c==95)){return 0;}
        i=i+1;
    }return 1;
}
fn nio_close(fd:i64)i64 {return _zag_darwin_syscall(6,fd,0,0,0,0,0);}
fn nio_sync(fd:i64)i64 {return _zag_darwin_syscall(95,fd,0,0,0,0,0);}
fn nio_seek(fd:i64,at:i64,whence:i64)i64 {return _zag_darwin_syscall(199,fd,at,whence,0,0,0);}
fn nio_lock(fd:i64)i64 {return _zag_darwin_syscall(131,fd,6,0,0,0,0);}

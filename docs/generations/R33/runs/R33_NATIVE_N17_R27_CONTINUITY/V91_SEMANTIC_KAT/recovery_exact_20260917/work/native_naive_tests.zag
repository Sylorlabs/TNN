}
fn nio_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn nio_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}

fn r25b2_g(v:[]u64,a:i32,b:i32,c:i32,d:i32,x:u64,y:u64)void @noalloc {v[a]=v[a]+v[b]+x;v[d]=r25b2_rotr(v[d]^v[a],32);v[c]=v[c]+v[d];v[b]=r25b2_rotr(v[b]^v[c],24);v[a]=v[a]+v[b]+y;v[d]=r25b2_rotr(v[d]^v[a],16);v[c]=v[c]+v[d];v[b]=r25b2_rotr(v[b]^v[c],63);}

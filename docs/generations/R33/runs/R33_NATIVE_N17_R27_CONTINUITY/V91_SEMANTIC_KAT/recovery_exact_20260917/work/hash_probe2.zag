fn r23b2p1_u64(input:[]u8,person:[]u8,v:[]u64,m:[]u64,digest:[]u8,out:*u64)i32 @noalloc {if(input.len<0||input.len>=128||person.len>16||digest.len!=8||v.len!=16||m.len!=16||out==null as *u64){return R23B2P1_SHAPE;}let i:i32=0;while(i<16){m[i]=r25b2_word(input,i*8);i=i+1;}i=0;while(i<8){v[i]=r25b2_iv(i);v[8+i]=r25b2_iv(i);i=i+1;}v[0]=v[0]^0x01010008;v[6]=v[6]^r25b2_word(person,0);v[7]=v[7]^r25b2_word(person,8);v[12]=v[12]^(input.len as u64);v[14]=v[14]^0xffffffffffffffff;let r:i32=0;while(r<12){r25b2_g(v,0,4,8,12,m[r25b2_sigma(r,0)],m[r25b2_sigma(r,1)]);r25b2_g(v,1,5,9,13,m[r25b2_sigma(r,2)],m[r25b2_sigma(r,3)]);r25b2_g(v,2,6,10,14,m[r25b2_sigma(r,4)],m[r25b2_sigma(r,5)]);r25b2_g(v,3,7,11,15,m[r25b2_sigma(r,6)],m[r25b2_sigma(r,7)]);r25b2_g(v,0,5,10,15,m[r25b2_sigma(r,8)],m[r25b2_sigma(r,9)]);r25b2_g(v,1,6,11,12,m[r25b2_sigma(r,10)],m[r25b2_sigma(r,11)]);r25b2_g(v,2,7,8,13,m[r25b2_sigma(r,12)],m[r25b2_sigma(r,13)]);r25b2_g(v,3,4,9,14,m[r25b2_sigma(r,14)],m[r25b2_sigma(r,15)]);r=r+1;}let h0:u64=r25b2_iv(0)^0x01010008^v[0]^v[8];i=0;while(i<8){digest[i]=((h0>>(i*8))&255) as u8;i=i+1;}let z:u64=0;i=0;while(i<8){z=z|((digest[i] as u64)<<(i*8));i=i+1;}out.*=z;return 0;}

const R25MT_OK:i32=0;const R25MT_BAD:i32=-27001;const R25MT_RANGE:i32=-27002;const R25MT_SHAPE:i32=-27003;const R25MT_N:i32=624;const R25MT_M:i32=397;const R25MT_MATRIX_A:u64=0x9908b0df;const R25MT_UPPER_MASK:u64=0x80000000;const R25MT_LOWER_MASK:u64=0x7fffffff;
struct R25MT19937V1 {mt:[]u64,index:i32,}
fn r25mt_u32(x:u64)u64 @noalloc{return x&0xffffffff;}
fn r25mt_new()R25MT19937V1{let p:*u64=_zag_malloc(R25MT_N*8) as *u64;if(p==null as *u64){return R25MT19937V1{.mt=(null as *u64)[0..0],.index=R25MT_N};}let a:[]u64=p[0..R25MT_N];return R25MT19937V1{.mt=a,.index=R25MT_N};}
fn r25mt_init_genrand(st:*R25MT19937V1,seed:u64)i32 @noalloc {if(st==null as *R25MT19937V1||st.*.mt.len!=R25MT_N){return R25MT_SHAPE;}st.*.mt[0]=r25mt_u32(seed);let i:i32=1;while(i<R25MT_N){let p:u64=st.*.mt[i-1];st.*.mt[i]=r25mt_u32(1812433253*(p^(p>>30))+(i as u64));i=i+1;}st.*.index=R25MT_N;return 0;}
fn r25mt_init_by_array(st:*R25MT19937V1,key:[]u64)i32 @noalloc {if(st==null as *R25MT19937V1||st.*.mt.len!=R25MT_N||key.len<1){return R25MT_SHAPE;}let rc:i32=r25mt_init_genrand(st,19650218);if(rc!=0){return rc;}let i:i32=1;let j:i32=0;let k:i32=R25MT_N;if(key.len>R25MT_N){k=key.len;}while(k>0){let prev:u64=st.*.mt[i-1];let mixed:u64=(prev^(prev>>30))*1664525;st.*.mt[i]=r25mt_u32((st.*.mt[i]^mixed)+key[j]+(j as u64));i=i+1;j=j+1;if(i>=R25MT_N){st.*.mt[0]=st.*.mt[R25MT_N-1];i=1;}if(j>=key.len){j=0;}k=k-1;}k=R25MT_N-1;while(k>0){let prev:u64=st.*.mt[i-1];let mixed:u64=(prev^(prev>>30))*1566083941;st.*.mt[i]=r25mt_u32((st.*.mt[i]^mixed)-(i as u64));i=i+1;if(i>=R25MT_N){st.*.mt[0]=st.*.mt[R25MT_N-1];i=1;}k=k-1;}st.*.mt[0]=0x80000000;st.*.index=R25MT_N;return 0;}
fn r25mt_seed_u32(st:*R25MT19937V1,seed:u64)i32 @noalloc {if(st==null as *R25MT19937V1||st.*.mt.len!=R25MT_N){return R25MT_SHAPE;}let rc:i32=r25mt_init_genrand(st,19650218);if(rc!=0){return rc;}let key:u64=seed&0xffffffff;let i:i32=1;let k:i32=R25MT_N;while(k>0){let prev:u64=st.*.mt[i-1];let mixed:u64=(prev^(prev>>30))*1664525;st.*.mt[i]=r25mt_u32((st.*.mt[i]^mixed)+key);i=i+1;if(i>=R25MT_N){st.*.mt[0]=st.*.mt[R25MT_N-1];i=1;}k=k-1;}k=R25MT_N-1;while(k>0){let prev:u64=st.*.mt[i-1];let mixed:u64=(prev^(prev>>30))*1566083941;st.*.mt[i]=r25mt_u32((st.*.mt[i]^mixed)-(i as u64));i=i+1;if(i>=R25MT_N){st.*.mt[0]=st.*.mt[R25MT_N-1];i=1;}k=k-1;}st.*.mt[0]=0x80000000;st.*.index=R25MT_N;return R25MT_OK;}
fn r25mt_twist(st:*R25MT19937V1)i32 @noalloc {if(st==null as *R25MT19937V1||st.*.mt.len!=R25MT_N){return R25MT_SHAPE;}let i:i32=0;while(i<R25MT_N){let y:u64=(st.*.mt[i]&R25MT_UPPER_MASK)|(st.*.mt[(i+1)%R25MT_N]&R25MT_LOWER_MASK);let v:u64=st.*.mt[(i+R25MT_M)%R25MT_N]^(y>>1);if((y&1)!=0){v=v^R25MT_MATRIX_A;}st.*.mt[i]=r25mt_u32(v);i=i+1;}st.*.index=0;return 0;}
fn r25mt_next_u32(st:*R25MT19937V1,out:*u64)i32 @noalloc {if(st==null as *R25MT19937V1||out==null as *u64||st.*.mt.len!=R25MT_N){return R25MT_SHAPE;}if(st.*.index>=R25MT_N){let rc:i32=r25mt_twist(st);if(rc!=0){return rc;}}let y:u64=st.*.mt[st.*.index];st.*.index=st.*.index+1;y=y^(y>>11);y=y^((y<<7)&0x9d2c5680);y=y^((y<<15)&0xefc60000);y=y^(y>>18);out.*=r25mt_u32(y);return 0;}
fn r25mt_bit_length(n:u64)i32 @noalloc {let x:u64=n;let k:i32=0;while(x>0){k=k+1;x=x>>1;}return k;}
fn r25mt_getrandbits32(st:*R25MT19937V1,k:i32,out:*u64)i32 @noalloc {if(out==null as *u64||k<1||k>32){return R25MT_RANGE;}let word:u64=0;let rc:i32=r25mt_next_u32(st,&word);if(rc!=0){return rc;}out.*=word>>(32-k);return 0;}
fn r25mt_randbelow(st:*R25MT19937V1,n:i32,out:*i32)i32 @noalloc {if(out==null as *i32||n<=0){return R25MT_RANGE;}let k:i32=r25mt_bit_length(n as u64);let r:u64=0;while(true){let rc:i32=r25mt_getrandbits32(st,k,&r);if(rc!=0){return rc;}if(r<(n as u64)){out.*=r as i32;return 0;}}return R25MT_BAD;}
fn r25mt_choice_index(st:*R25MT19937V1,n:i32,out:*i32)i32 @noalloc{return r25mt_randbelow(st,n,out);}



const V91_ROWS:i32=4248;const V91_EXTRA:i32=2200;const V91_COND:i32=42;const V91_KAT:i32=16;const V91_PERSON:[]u8="tnn-r23";const V91_SHAPE:i32=-29102;const V91_RNG:i32=-29104;
struct V91Row {a:i32,o:i32,l:i32,bad:i32,act:i32,kind:i32,form:i32,}
// ARM64 ordinary i32 slices have 8-byte stride (qualified by allocation probe).
// Flat scalar rows avoid native struct-array stride disagreement.
fn v91_row_get(rows:[]i32,index:i32)V91Row {let x:i32=index*7;return V91Row{.a=rows[x],.o=rows[x+1],.l=rows[x+2],.bad=rows[x+3],.act=rows[x+4],.kind=rows[x+5],.form=rows[x+6]};}
fn v91_row_set(rows:[]i32,index:i32,r:V91Row)void {let x:i32=index*7;rows[x]=r.a;rows[x+1]=r.o;rows[x+2]=r.l;rows[x+3]=r.bad;rows[x+4]=r.act;rows[x+5]=r.kind;rows[x+6]=r.form;}
fn v91_alloc_i32(n:i32)[]i32 {if(n<=0||n>268435455){return (null as *i32)[0..0];}let p:*i32=_zag_malloc(n*8) as *i32;if(p==null as *i32){return p[0..0];}let b:[]i32=p[0..n];return b;}
fn v91_alloc_u8(n:i32)[]u8 {if(n<=0){return (null as *u8)[0..0];}let p:*u8=_zag_malloc(n) as *u8;if(p==null as *u8){return p[0..0];}let b:[]u8=p[0..n];return b;}
fn v91_alloc_u64(n:i32)[]u64 {if(n<=0||n>268435455){return (null as *u64)[0..0];}let p:*u64=_zag_malloc(n*8) as *u64;if(p==null as *u64){return p[0..0];}let b:[]u64=p[0..n];return b;}
fn v91_name(i:i32)[]u8 @noalloc {if(i==0){return "ana";}if(i==1){return "jon";}if(i==2){return "mira";}if(i==3){return "sam";}if(i==4){return "lena";}if(i==5){return "ravi";}if(i==6){return "nora";}if(i==7){return "omar";}return "";}
fn v91_object(i:i32)[]u8 @noalloc {if(i==0){return "book";}if(i==1){return "cup";}if(i==2){return "notebook";}if(i==3){return "glass";}if(i==4){return "report";}if(i==5){return "key";}if(i==6){return "phone";}if(i==7){return "folder";}return "";}
fn v91_loc(i:i32)[]u8 @noalloc {if(i==0){return "desk";}if(i==1){return "drawer";}if(i==2){return "bag";}if(i==3){return "shelf";}if(i==4){return "table";}if(i==5){return "box";}if(i==6){return "room";}if(i==7){return "cabinet";}return "";}
fn v91_motive(i:i32)[]u8 @noalloc {if(i==0){return "falling";}if(i==1){return "breaking";}if(i==2){return "getting wet";}if(i==3){return "being lost";}if(i==4){return "being late";}if(i==5){return "making noise";}return "";}
fn v91_action(i:i32)[]u8 @noalloc {if(i==0){return "moved";}if(i==1){return "placed";}if(i==2){return "carried";}if(i==3){return "left";}if(i==4){return "returned";}if(i==5){return "sent";}if(i==6){return "put";}if(i==7){return "brought";}return "";}
fn v91_kind(i:i32)[]u8 @noalloc {if(i==0){return "location";}if(i==1){return "motive";}if(i==2){return "belief";}if(i==3){return "promise";}return "";}
fn v91_hex(x:i32)u8 @noalloc {if(x<10){return (48+x) as u8;}return (87+x) as u8;}
fn v91_put(out:[]u8,at:*i32,c:u8)i32 @noalloc {if(at==null as *i32||at.*<0||at.*>=out.len){return V91_SHAPE;}out[at.*]=c;at.*=at.*+1;return 0;}
fn v91_repr_str(s:[]u8,out:[]u8,at:*i32)i32 @noalloc {if(at==null as *i32){return V91_SHAPE;}let sq:i32=0;let dq:i32=0;let i:i32=0;while(i<s.len){if((s[i] as i32)>127){return V91_SHAPE;}if(s[i]==39){sq=sq+1;}if(s[i]==34){dq=dq+1;}i=i+1;}let q:u8=39;if(sq>0&&dq==0){q=34;}if(v91_put(out,at,q)!=0){return V91_SHAPE;}i=0;while(i<s.len){let c:i32=s[i] as i32;if(c==92||c==(q as i32)){if(v91_put(out,at,92)!=0||v91_put(out,at,c as u8)!=0){return V91_SHAPE;}}else if(c==9){if(v91_put(out,at,92)!=0||v91_put(out,at,116)!=0){return V91_SHAPE;}}else if(c==10){if(v91_put(out,at,92)!=0||v91_put(out,at,110)!=0){return V91_SHAPE;}}else if(c==13){if(v91_put(out,at,92)!=0||v91_put(out,at,114)!=0){return V91_SHAPE;}}else if(c>=32&&c<=126){if(v91_put(out,at,c as u8)!=0){return V91_SHAPE;}}else{if(v91_put(out,at,92)!=0||v91_put(out,at,120)!=0||v91_put(out,at,v91_hex((c>>4)&15))!=0||v91_put(out,at,v91_hex(c&15))!=0){return V91_SHAPE;}}i=i+1;}return v91_put(out,at,q);}
fn v91_repr_part(s:[]u8,out:[]u8,at:*i32)i32 @noalloc {let rc:i32=v91_repr_str(s,out,at);if(rc!=0){return rc;}return v91_put(out,at,0);}
fn v91_stable5(a:[]u8,b:[]u8,c:[]u8,d:[]u8,e:[]u8,tmp:[]u8,dig:[]u8,v:[]u64,m:[]u64,out:*u64)i32 @noalloc {if(tmp.len<128||dig.len!=8||v.len!=16||m.len!=16||out==null as *u64){return V91_SHAPE;}let at:i32=0;if(v91_repr_part(a,tmp,&at)!=0||v91_repr_part(b,tmp,&at)!=0||v91_repr_part(c,tmp,&at)!=0||v91_repr_part(d,tmp,&at)!=0||v91_repr_part(e,tmp,&at)!=0){return V91_SHAPE;}return r23b2p1_u64(tmp[0..at],V91_PERSON,v,m,dig,out);}
fn v91_build(rows:[]i32)i32 {if(rows.len!=V91_ROWS*7){return V91_SHAPE;}let rng:R25MT19937V1=r25mt_new();if(r25mt_seed_u32(&rng,23101)!=0){return V91_RNG;}let at:i32=0;let a:i32=0;while(a<8){let o:i32=0;while(o<8){let l:i32=0;while(l<8){let k:i32=0;while(k<4){let bad:i32=0;let act:i32=0;let form:i32=0;if(r25mt_choice_index(&rng,6,&bad)!=0||r25mt_choice_index(&rng,8,&act)!=0||r25mt_choice_index(&rng,4,&form)!=0){return V91_RNG;}v91_row_set(rows,at,V91Row{.a=a,.o=o,.l=l,.bad=bad,.act=act,.kind=k,.form=form});at=at+1;k=k+1;}l=l+1;}o=o+1;}a=a+1;}let x:i32=0;while(x<V91_EXTRA){let aa:i32=0;let oo:i32=0;let ll:i32=0;let bb:i32=0;let ac:i32=0;let kk:i32=0;let ff:i32=0;if(r25mt_choice_index(&rng,8,&aa)!=0||r25mt_choice_index(&rng,8,&oo)!=0||r25mt_choice_index(&rng,8,&ll)!=0||r25mt_choice_index(&rng,6,&bb)!=0||r25mt_choice_index(&rng,8,&ac)!=0||r25mt_choice_index(&rng,4,&kk)!=0||r25mt_choice_index(&rng,4,&ff)!=0){return V91_RNG;}v91_row_set(rows,at,V91Row{.a=aa,.o=oo,.l=ll,.bad=bb,.act=ac,.kind=kk,.form=ff});at=at+1;x=x+1;}return (at!=V91_ROWS) as i32;}
fn v91_shuffle(st:*R25MT19937V1,a:[]i32)i32 @noalloc {let i:i32=a.len-1;while(i>0){let j:i32=0;if(r25mt_randbelow(st,i+1,&j)!=0){return V91_RNG;}let z:i32=a[i];a[i]=a[j];a[j]=z;i=i-1;}return 0;}
fn v91_split(rows:[]i32,train:[]i32,test:[]i32,ntrain:*i32,ntest:*i32)i32 {if(rows.len!=V91_ROWS*7||train.len<V91_ROWS||test.len<V91_ROWS||ntrain==null as *i32||ntest==null as *i32){return V91_SHAPE;}let tmp:[]u8=v91_alloc_u8(128);let dig:[]u8=v91_alloc_u8(8);let v:[]u64=v91_alloc_u64(16);let m:[]u64=v91_alloc_u64(16);let tc:i32=0;let hc:i32=0;let i:i32=0;while(i<V91_ROWS){let r:V91Row=v91_row_get(rows,i);let h:u64=0;if(v91_stable5("r23hold",v91_name(r.a),v91_object(r.o),v91_loc(r.l),v91_kind(r.kind),tmp,dig,v,m,&h)!=0){return -29103;}if(h%7==0){test[hc]=i;hc=hc+1;}else{train[tc]=i;tc=tc+1;}i=i+1;}let sr:R25MT19937V1=r25mt_new();if(r25mt_seed_u32(&sr,23101)!=0){return V91_RNG;}if(v91_shuffle(&sr,train[0..tc])!=0||v91_shuffle(&sr,test[0..hc])!=0){return V91_RNG;}ntrain.*=tc;ntest.*=hc;return 0;}
fn v91_condition(r:V91Row,out:[]i32)i32 @noalloc {if(out.len!=42||r.a<0||r.a>=8||r.o<0||r.o>=8||r.l<0||r.l>=8||r.bad<0||r.bad>=6||r.act<0||r.act>=8||r.kind<0||r.kind>=4){return V91_SHAPE;}let i:i32=0;while(i<42){out[i]=0;i=i+1;}out[r.a]=1;out[8+r.o]=1;out[16+r.l]=1;out[24+r.bad]=1;out[30+r.act]=1;out[38+r.kind]=1;return 0;}
fn v91_expected_row(i:i32,r:V91Row)i32 @noalloc {if(i==0){return (r.a==4&&r.o==7&&r.bad==2&&r.kind==1) as i32;}if(i==1){return (r.a==0&&r.o==3&&r.bad==5&&r.kind==1) as i32;}if(i==2){return (r.a==7&&r.o==7&&r.l==0&&r.kind==2) as i32;}if(i==3){return (r.a==4&&r.o==0&&r.l==7&&r.kind==0) as i32;}if(i==4){return (r.a==5&&r.o==1&&r.l==3&&r.kind==3) as i32;}if(i==5){return (r.a==0&&r.o==1&&r.bad==0&&r.kind==1) as i32;}if(i==6){return (r.a==2&&r.o==2&&r.l==0&&r.kind==2) as i32;}if(i==7){return (r.a==5&&r.o==2&&r.bad==0&&r.kind==1) as i32;}if(i==8){return (r.a==0&&r.o==4&&r.l==4&&r.kind==2) as i32;}if(i==9){return (r.a==2&&r.o==2&&r.l==7&&r.kind==0) as i32;}if(i==10){return (r.a==7&&r.o==6&&r.l==1&&r.kind==3) as i32;}if(i==11){return (r.a==4&&r.o==1&&r.l==6&&r.kind==2) as i32;}if(i==12){return (r.a==6&&r.o==3&&r.l==0&&r.kind==2) as i32;}if(i==13){return (r.a==3&&r.o==0&&r.l==6&&r.kind==2) as i32;}if(i==14){return (r.a==1&&r.o==7&&r.l==2&&r.kind==2) as i32;}if(i==15){return (r.a==6&&r.o==3&&r.l==0&&r.kind==2) as i32;}return 0;}
fn v91_expected_naive(i:i32)[]u8 @noalloc {if(i==0){return "lena moved the key so it would not risk falling.";}if(i==1){return "ana acted because the folder might face being lost.";}if(i==2){return "jon thinks the folder is in the desk.";}if(i==3){return "lena left it in the desk.";}if(i==4){return "ravi promised to send the folder to the shelf.";}if(i==5){return "ana moved the glass so it would not risk falling.";}if(i==6){return "mira believes the folder is located in the room.";}if(i==7){return "ravi acted because the notebook might face breaking.";}if(i==8){return "ana thinks the book is in the shelf.";}if(i==9){return "mira put the notebook to the box.";}if(i==10){return "omar promised to send the glass to the box.";}if(i==11){return "sam carried the key to the shelf.";}if(i==12){return "nora thinks the glass is in the box.";}if(i==13){return "sam thinks the folder is in the room.";}if(i==14){return "jon believes the glass is located in the bag.";}if(i==15){return "nora believes the book is located in the desk.";}return "";}
fn v91_equal(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn v91_output_match(i:i32,got:[]u8)i32 @noalloc {if(i<0||i>=16){return 0;}return v91_equal(got,v91_expected_naive(i));}


fn main()i32 {let tmp:[]u8=v91_alloc_u8(128);let dig:[]u8=v91_alloc_u8(8);let v:[]u64=v91_alloc_u64(16);let m:[]u64=v91_alloc_u64(16);let h:u64=0;if(v91_stable5("r23hold","lena","folder","cabinet","location",tmp,dig,v,m,&h)!=0){return 2;}_zag_print("V91_HASH_MOD7,");_zag_println(_zag_i64_to_str((h%7) as i64));return 0;}


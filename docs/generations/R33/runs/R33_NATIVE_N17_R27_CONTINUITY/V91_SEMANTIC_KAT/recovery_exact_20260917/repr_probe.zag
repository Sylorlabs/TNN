fn main()i32 {let tmp:[]u8=v91_alloc_u8(128);let at:i32=0;if(v91_repr_part("r23hold",tmp,&at)!=0||v91_repr_part("lena",tmp,&at)!=0||v91_repr_part("folder",tmp,&at)!=0||v91_repr_part("cabinet",tmp,&at)!=0||v91_repr_part("location",tmp,&at)!=0){return 2;}_zag_print("LEN,");_zag_println(_zag_i64_to_str(at as i64));let i:i32=0;while(i<at){_zag_println(_zag_i64_to_str(tmp[i] as i64));i=i+1;}return 0;}

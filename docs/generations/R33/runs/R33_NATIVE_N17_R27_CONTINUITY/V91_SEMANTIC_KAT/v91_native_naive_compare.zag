// Post-inference comparator. Historical oracle bytes are first read here,
// after the isolated inference artifact has already been produced.
@import("../../R33_NATIVE_SHA256_V2.zag")

fn vcmp_get32(b:[]u8,at:i32)i32 @noalloc {if(at<0||at+4>b.len){return -1;}return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}
fn vcmp_eq(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}

fn main()i32 {
    if(_zag_argc()!=3){return 2;}let g:[]u8=_zag_read_file(_zag_arg(1));let o:[]u8=_zag_read_file(_zag_arg(2));
    if(g.len<16||o.len<48||vcmp_eq(g[0..8],"V91GEN01")!=1||vcmp_get32(g,8)!=16||vcmp_eq(o[0..8],"V91ORC01")!=1||vcmp_get32(o,8)!=16){return 3;}
    let ga:i32=16;let oa:i32=48;let matched:i32=0;let i:i32=0;while(i<16){if(ga+12>g.len||oa+24>o.len){return 4;}let gi:i32=vcmp_get32(g,ga);let gl:i32=vcmp_get32(g,ga+8);let oi:i32=vcmp_get32(o,oa);let ol:i32=vcmp_get32(o,oa+20);if(gi!=i||oi!=i||gl<0||ol<0||ga+12+gl>g.len||oa+24+ol>o.len){return 5;}let eq:i32=vcmp_eq(g[ga+12..ga+12+gl],o[oa+24..oa+24+ol]);matched=matched+eq;_zag_print("V91_NATIVE_ORACLE_ROW,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",match=");_zag_println(_zag_i64_to_str(eq as i64));ga=ga+12+gl;oa=oa+24+ol;i=i+1;}
    if(ga!=g.len||oa!=o.len){return 6;}_zag_print("V91_NATIVE_ORACLE_MATCHES,");_zag_println(_zag_i64_to_str(matched as i64));_zag_print("V91_NATIVE_ORACLE_FAILURES,");_zag_println(_zag_i64_to_str((16-matched) as i64));return (matched!=16) as i32;
}

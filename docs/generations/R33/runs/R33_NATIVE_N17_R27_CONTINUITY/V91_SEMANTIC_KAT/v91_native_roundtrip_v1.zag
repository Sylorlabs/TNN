// Pure-Zag reconstruction of the historical R23 n=128 semantic roundtrip lane.
// This inference module contains no historical output strings and no oracle import.
@import("v91_native_naive_v1.zag")
@import("r23_blake2b64_person_v1.zag")

fn vr_u64(n:i32)[]u64 {let p:*u64=_zag_malloc(n*8) as *u64;return p[0..n];}

fn vr_u64_mod768(x:u64)i32 @noalloc {
    let r:i32=((x&0x7fffffffffffffff)%768) as i32;
    if((x&0x8000000000000000)!=0){return (r+512)%768;}
    return r;
}

fn vr_ln(x:f64)f64 @noalloc {
    if(x<=0.0){return -1000000000.0;}
    let y:f64=x;let k:i32=0;
    while(y<0.7071067811865476){y=y*2.0;k=k-1;}
    while(y>1.4142135623730951){y=y*0.5;k=k+1;}
    let z:f64=(y-1.0)/(y+1.0);let z2:f64=z*z;let term:f64=z;let sum:f64=z;let d:i32=3;
    while(d<=31){term=term*z2;sum=sum+term/(d as f64);d=d+2;}
    return 2.0*sum+(k as f64)*0.69314718055994530942;
}

fn vr_sqrt(x:f64)f64 @noalloc {
    if(x<=0.0){return 0.0;}let g:f64=x;if(g<1.0){g=1.0;}let i:i32=0;
    while(i<24){g=0.5*(g+x/g);i=i+1;}return g;
}

fn vr_hex(x:i32)u8 @noalloc {if(x<10){return (48+x) as u8;}return (87+x) as u8;}
fn vr_put(out:[]u8,at:*i32,c:u8)i32 @noalloc {if(at==null as *i32||at.*<0||at.*>=out.len){return 1;}out[at.*]=c;at.*=at.*+1;return 0;}

// Python repr(bytes) for the byte ranges reachable from the historical BPE.
fn vr_repr_bytes(b:[]u8,out:[]u8,at:*i32)i32 @noalloc {
    if(vr_put(out,at,98)!=0){return 1;}let sq:i32=0;let dq:i32=0;let i:i32=0;
    while(i<b.len){if(b[i]==39){sq=sq+1;}if(b[i]==34){dq=dq+1;}i=i+1;}
    let q:u8=39;if(sq>0&&dq==0){q=34;}if(vr_put(out,at,q)!=0){return 1;}i=0;
    while(i<b.len){let c:i32=b[i] as i32;
        if(c==92||c==(q as i32)){if(vr_put(out,at,92)!=0||vr_put(out,at,c as u8)!=0){return 1;}}
        else if(c==9){if(vr_put(out,at,92)!=0||vr_put(out,at,116)!=0){return 1;}}
        else if(c==10){if(vr_put(out,at,92)!=0||vr_put(out,at,110)!=0){return 1;}}
        else if(c==13){if(vr_put(out,at,92)!=0||vr_put(out,at,114)!=0){return 1;}}
        else if(c>=32&&c<=126){if(vr_put(out,at,c as u8)!=0){return 1;}}
        else{if(vr_put(out,at,92)!=0||vr_put(out,at,120)!=0||vr_put(out,at,vr_hex((c>>4)&15))!=0||vr_put(out,at,vr_hex(c&15))!=0){return 1;}}
        i=i+1;
    }return vr_put(out,at,q);
}

fn vr_stable_ngram(n:i32,g:[]u8,tmp:[]u8,dig:[]u8,v:[]u64,m:[]u64,out:*u64)i32 @noalloc {
    if(n<2||n>14||tmp.len<128||dig.len!=8||v.len!=16||m.len!=16||out==null as *u64){return 1;}
    let at:i32=0;if(n>=10){if(vr_put(tmp,&at,(48+n/10) as u8)!=0){return 1;}}if(vr_put(tmp,&at,(48+n%10) as u8)!=0||vr_put(tmp,&at,0)!=0){return 1;}
    if(vr_repr_bytes(g,tmp,&at)!=0||vr_put(tmp,&at,0)!=0){return 1;}
    return r23b2p1_u64(tmp[0..at],"tnn-r23",v,m,dig,out);
}

fn vr_raw_hash(text:[]u8,z:[]f64,tmp:[]u8,dig:[]u8,v:[]u64,m:[]u64,round:[]f32)i32 {
    if(z.len!=768||tmp.len<128||dig.len!=8||v.len!=16||m.len!=16||round.len<1){return 1;}
    let i:i32=0;while(i<768){z[i]=0.0;i=i+1;}let lower:[]u8=vg_u8(text.len);i=0;
    while(i<text.len){let c:u8=text[i];if(c>=65&&c<=90){c=(c+32) as u8;}lower[i]=c;i=i+1;}
    let n:i32=2;while(n<=14&&n<=lower.len){let p:i32=0;while(p+n<=lower.len){let hv:u64=0;if(vr_stable_ngram(n,lower[p..p+n],tmp,dig,v,m,&hv)!=0){return 2;}let slot:i32=vr_u64_mod768(hv);let delta:f64=-1.0;if((hv&0x800)!=0){delta=1.0;}z[slot]=vg_round32(z[slot]+delta,round);p=p+1;}n=n+1;}
    let ss:f64=0.0;i=0;while(i<768){ss=ss+z[i]*z[i];i=i+1;}let norm:f64=vg_round32(vr_sqrt(ss),round);let denom:f64=norm+0.00000001;i=0;while(i<768){z[i]=vg_round32(z[i]/denom,round);i=i+1;}return 0;
}

fn vr_semantic_score(text:[]u8,c:[]f64,w:[]f64,z:[]f64,pred:[]f64,tmp:[]u8,dig:[]u8,v:[]u64,m:[]u64,round:[]f32,out:*f64)i32 {
    if(c.len!=42||w.len!=768*42||z.len!=768||pred.len!=42||out==null as *f64){return 1;}
    if(vr_raw_hash(text,z,tmp,dig,v,m,round)!=0){return 2;}let j:i32=0;
    while(j<42){let y:f64=0.0;let i:i32=0;while(i<768){y=y+z[i]*w[i*42+j];i=i+1;}pred[j]=vg_round32(y,round);j=j+1;}
    let mse:f64=0.0;j=0;while(j<42){let d:f64=vg_round32(pred[j]-c[j],round);let q:f64=vg_round32(d*d,round);mse=vg_round32(mse+q,round);j=j+1;}mse=vg_round32(mse/42.0,round);out.*=-mse;return 0;
}

fn vr_pick_top7(st:*R25MT19937V1,vals:[]f64,round:[]f32,weights:[]f64,out:*i32,psel:*f64)i32 @noalloc {
    if(weights.len!=7||out==null as *i32||psel==null as *f64){return 1;}let max:f64=vals[0];let i:i32=0;let sum:f64=0.0;
    while(i<7){let scaled:f64=vg_round32((vals[i]-max)/0.72,round);weights[i]=vg_round32(vn_exp(scaled),round);sum=vg_round32(sum+weights[i],round);i=i+1;}
    i=0;while(i<7){weights[i]=vg_round32(weights[i]/sum,round);i=i+1;}
    let best:f64=-1.0;let pick:i32=-1;i=0;while(i<7){let q:f64=0.0;if(vg_exponential_mt(st,round,&q)!=0||q<=0.0){return 2;}let score:f64=vg_round32(weights[i]/q,round);if(pick<0||score>best){best=score;pick=i;}i=i+1;}out.*=pick;psel.*=weights[pick];return 0;
}

fn vr_generate_roundtrip(m:*V91NaiveModel,w:[]f64,c:[]f64,seed:u64,status:*i32,best_sem:*f64,best_lp:*f64)[]u8 {
    if(m.*.status!=0||w.len!=768*42||c.len!=42||status==null as *i32){return "";}let round:[]f32=vg_f32(1);
    let cp:[]f64=vg_f64(128);let ce:[]f64=vg_f64(48);if(vg_linear32(m.*.cw,m.*.cb,c,cp,round)!=0||vg_linear32(m.*.ew,m.*.eb,c,ce,round)!=0){status.*=40;return "";}
    let base_h:[]f64=vg_f64(128);let i:i32=0;while(i<128){base_h[i]=vg_tanh32(cp[i],round);i=i+1;}i=0;while(i<48){ce[i]=vg_tanh32(ce[i],round);i=i+1;}
    let h:[]f64=vg_f64(128*128);let tok:[]i32=vg_i32(128);let alive:[]i32=vg_i32(128);let count:[]i32=vg_i32(128);let seq:[]i32=vg_i32(128*48);let lp:[]f64=vg_f64(128);
    let row:i32=0;while(row<128){i=0;while(i<128){h[row*128+i]=base_h[i];i=i+1;}tok[row]=340;alive[row]=1;count[row]=0;lp[row]=0.0;row=row+1;}
    let st:R25MT19937V1=r25mt_new();if(r25mt_init_genrand(&st,seed)!=0){status.*=41;return "";}
    let x:[]f64=vg_f64(96);let next_h:[]f64=vg_f64(128);let gi:[]f64=vg_f64(384);let gh:[]f64=vg_f64(384);let logits:[]f64=vg_f64(342);let ids:[]i32=vg_i32(7);let vals:[]f64=vg_f64(7);let weights:[]f64=vg_f64(7);
    let step:i32=0;let any:i32=1;while(step<48&&any==1){any=0;row=0;while(row<128){i=0;while(i<48){x[i]=m.*.emb[tok[row]*48+i];x[48+i]=ce[i];i=i+1;}if(vg_gru32(m,x,h[row*128..row*128+128],next_h,gi,gh,round)!=0){status.*=42;return "";}i=0;while(i<128){h[row*128+i]=next_h[i];i=i+1;}if(vg_linear32(m.*.ow,m.*.ob,h[row*128..row*128+128],logits,round)!=0||vg_top7(logits,ids,vals)!=0){status.*=43;return "";}let pick:i32=-1;let psel:f64=0.0;if(vr_pick_top7(&st,vals,round,weights,&pick,&psel)!=0){status.*=44;return "";}let nt:i32=ids[pick];if(alive[row]==1){let logp:f64=vg_round32(vr_ln(vg_round32(psel+0.000000001,round)),round);lp[row]=vg_round32(lp[row]+logp,round);if(nt==341){alive[row]=0;}else if(nt<340){seq[row*48+count[row]]=nt;count[row]=count[row]+1;}}tok[row]=nt;if(alive[row]==1){any=1;}row=row+1;}step=step+1;}
    let z:[]f64=vg_f64(768);let pred:[]f64=vg_f64(42);let tmp:[]u8=vg_u8(128);let dig:[]u8=vg_u8(8);let bv:[]u64=vr_u64(16);let bm:[]u64=vr_u64(16);let best:[]u8="";let best_score:f64=-1000000000.0;let bsem:f64=0.0;let blp:f64=0.0;row=0;
    while(row<128){let text:[]u8=vg_decode(m,seq[row*48..row*48+count[row]],count[row]);let sem:f64=0.0;if(vr_semantic_score(text,c,w,z,pred,tmp,dig,bv,bm,round,&sem)!=0){status.*=45;return "";}let denom:i32=text.len;if(denom<1){denom=1;}let delta:i32=text.len-48;if(delta<0){delta=-delta;}let score:f64=lp[row]/(denom as f64)+20.0*sem-0.001*(delta as f64);if(row==0||score>best_score){best_score=score;best=text;bsem=sem;blp=lp[row];}row=row+1;}
    if(best_sem!=null as *f64){best_sem.*=bsem;}if(best_lp!=null as *f64){best_lp.*=blp;}status.*=0;return best;
}

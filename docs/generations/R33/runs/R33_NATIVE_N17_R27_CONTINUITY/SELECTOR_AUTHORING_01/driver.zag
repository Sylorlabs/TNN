// R33-N17 selector authoring inspector.
// Static inert-map inspection only: no Python, reducer/class execution,
// learner, semantic digest, verifier decision, training, or promotion.
@import("../identity.zag")

fn n17_print_id(p:*ParentMap,label:[]u8,id:i32)void {
    _zag_print("N17_SELECTOR,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(pm_kind(p,id) as i64));_zag_print(",");
    let start:i64=-1;if(id>0 && id<=p.*.node_count){start=p.*.nodes[(id-1)*10+1];}
    _zag_println(_zag_i64_to_str(start));
}

fn n17_dump_dict(p:*ParentMap,label:[]u8,id:i32)void {
    let state:i32=pm_build_state(p,id);
    _zag_print("N17_DICT,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(state as i64));_zag_print(",");
    let count:i64=-1;if(pm_kind(p,state)==11){count=p.*.nodes[(state-1)*10+9];}
    _zag_println(_zag_i64_to_str(count));
    if(pm_kind(p,state)!=11){return;}
    let e:i32=p.*.nodes[(state-1)*10+7] as i32;
    let seen:i32=0;
    while(e>0 && seen<p.*.edge_count){
        let row:i32=(e-1)*4;
        if(p.*.edges[row+3]==2){
            let key:i32=p.*.edges[row] as i32;let value:i32=p.*.edges[row+1] as i32;
            _zag_print("N17_FIELD,");_zag_print(label);_zag_print(",");
            if(pm_kind(p,key)==6){_zag_print(pm_raw(p,key));}else{_zag_print("<nontext>");}
            _zag_print(",");_zag_print(_zag_i64_to_str(value as i64));_zag_print(",");
            _zag_print(_zag_i64_to_str(pm_kind(p,value) as i64));_zag_print(",");
            _zag_println(_zag_i64_to_str(p.*.nodes[(value-1)*10+1]));
        }
        e=p.*.edges[row+2] as i32;seen=seen+1;
    }
}

fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}
    let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);
    if(p.status!=0){return 3;}
    let identity_code:i32=n17_identity(&p);
    _zag_print("N17_IDENTITY_CODE,");_zag_println(_zag_i64_to_str(identity_code as i64));
    if(identity_code!=0){mi_loaded_close(&p);return 4;}

    let r27:i32=p.root;let r26:i32=pm_lookup(&p,r27,"base_state");
    n17_print_id(&p,"R27.root",r27);n17_dump_dict(&p,"R27",r27);
    n17_print_id(&p,"R26.root",r26);n17_dump_dict(&p,"R26",r26);

    let enc:i32=pm_lookup(&p,r26,"video_encoder");
    let vep:i32=pm_lookup(&p,r26,"video_entity_policy");
    let rap:i32=pm_lookup(&p,r26,"abstraction_policy");
    let rarch:i32=pm_lookup(&p,r26,"architecture");
    n17_dump_dict(&p,"R26.video_encoder",enc);
    n17_dump_dict(&p,"R26.video_entity_policy",vep);
    n17_dump_dict(&p,"R26.abstraction_policy",rap);
    n17_dump_dict(&p,"R26.architecture",rarch);

    let cs:i32=pm_lookup(&p,r27,"category_system");
    let ap:i32=pm_lookup(&p,r27,"abstraction_policy");
    let sg:i32=pm_lookup(&p,r27,"semantic_generator");
    let arch:i32=pm_lookup(&p,r27,"architecture");
    let evidence:i32=pm_lookup(&p,r27,"evidence");
    n17_dump_dict(&p,"R27.category_system",cs);
    n17_dump_dict(&p,"R27.abstraction_policy",ap);
    n17_dump_dict(&p,"R27.semantic_generator",sg);
    n17_dump_dict(&p,"R27.architecture",arch);
    n17_dump_dict(&p,"R27.evidence",evidence);

    n17_dump_dict(&p,"R26.video_encoder.base",pm_lookup(&p,enc,"base"));
    n17_dump_dict(&p,"R26.entity_head",pm_lookup(&p,vep,"entity_head"));
    n17_dump_dict(&p,"R26.graph",pm_lookup(&p,vep,"graph"));
    n17_dump_dict(&p,"R26.name_memory",pm_lookup(&p,vep,"name_memory"));
    n17_dump_dict(&p,"R26.abstraction_models",pm_lookup(&p,rap,"models"));
    n17_dump_dict(&p,"R27.category_head",pm_lookup(&p,cs,"category_head"));
    n17_dump_dict(&p,"R27.entity_head",pm_lookup(&p,cs,"entity_head"));

    mi_loaded_close(&p);return 0;
}

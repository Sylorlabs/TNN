// Authoring-only probe for the Zag native f64 print lexical surface.
@import("identity.zag")

fn fp_one(p:*ParentMap,id:i32)void {
    let raw:[]u8=pm_raw(p,id);if(raw.len!=8){return;}let b:[]u8=nio_alloc(8);if(b.len!=8){return;}
    let i:i32=0;while(i<8){b[i]=raw[7-i];i=i+1;}let x:f64=(_zag_slice_ptr(b) as *f64)[0];
    _zag_print("F64_PRINT,");let s:[]u8=_zag_i64_to_str(id as i64);_zag_print(s);nio_free(s);_zag_print(",");print_f64(x);_zag_println("");nio_free(b);
}
fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}
    if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}fp_one(&p,208897);fp_one(&p,375110);fp_one(&p,375252);fp_one(&p,375505);mi_loaded_close(&p);return 0;
}

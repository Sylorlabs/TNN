@import("../identity.zag")
fn bnum(x:i64)void {let s:[]u8=_zag_i64_to_str(x);_zag_print(s);nio_free(s);}
fn bdump(p:*ParentMap,id:i32,depth:i32)void {
 if(id<1 || id>p.*.node_count || depth>6){return;}let k:i32=pm_kind(p,id);
 _zag_print("B_NODE,");bnum(depth as i64);_zag_print(",");bnum(id as i64);_zag_print(",");bnum(k as i64);_zag_print(",");
 if(k==6){_zag_print(pm_raw(p,id));}else if(k==3 || k==4){let x:i64=0;if(pm_small_int(p,id,&x)==0){bnum(x);}}else if(k==2){bnum(p.*.nodes[(id-1)*10+6]);}else if(k==5){let h:[]u8=ns_hex(pm_raw(p,id));_zag_print(h);nio_free(h);}else if(k==1){_zag_print("EXPLICIT_NULL");}
 _zag_println("");
 if(k==11 || k==9 || k==10){let e:i32=p.*.nodes[(id-1)*10+7] as i32;let n:i32=0;while(e>0 && n<512){let r:i32=(e-1)*4;
 _zag_print("B_EDGE,");bnum(id as i64);_zag_print(",");bnum(n as i64);_zag_print(",");if(k==11){let key:i32=p.*.edges[r] as i32;if(pm_kind(p,key)==6){_zag_print(pm_raw(p,key));}else{let x:i64=0;if(pm_small_int(p,key,&x)==0){bnum(x);}}_zag_print(",");bnum(p.*.edges[r+1]);_zag_println("");bdump(p,p.*.edges[r+1] as i32,depth+1);}else{bnum(p.*.edges[r]);_zag_println("");bdump(p,p.*.edges[r] as i32,depth+1);}e=p.*.edges[r+2] as i32;n=n+1;}}
}
fn main()i32 {let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}
 let r26:i32=pm_lookup(&p,p.root,"base_state");_zag_println("B_SECTION,R27.evidence");bdump(&p,pm_lookup(&p,p.root,"evidence"),0);_zag_println("B_SECTION,R26.evidence");bdump(&p,pm_lookup(&p,r26,"evidence"),0);_zag_println("B_SECTION,R26.architecture");bdump(&p,pm_lookup(&p,r26,"architecture"),0);
 mi_loaded_close(&p);return 0;}

// R33-N17 authoring-only canonical-JSON type inventory.
// Reads the inert N10 map through the native identity layer. No reducers,
// Python, learner execution, training, mutation, digest or promotion.
@import("identity.zag")

fn ci_hex(b:[]u8)void {
    let digits:[]u8="0123456789abcdef";let out:[]u8=nio_alloc(b.len*2);
    if(out.len!=b.len*2){_zag_print("ALLOC_FAIL");return;}
    let i:i32=0;while(i<b.len){let x:i32=b[i] as i32;out[i*2]=digits[x/16];out[i*2+1]=digits[x%16];i=i+1;}
    _zag_print(out);nio_free(out);
}
fn ci_num(v:i64)void {let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);}
fn ci_field(v:i64)void {_zag_print(",");ci_num(v);}
fn ci_float_half_decimal(raw:[]u8,digits:i32)void {
    if(raw.len!=8 || raw[0]!=63 || (raw[1] as i32)<224 || (raw[1] as i32)>239){_zag_print("UNSUPPORTED");return;}
    let frac:i64=((raw[1] as i64)&15)*281474976710656+(raw[2] as i64)*1099511627776+
        (raw[3] as i64)*4294967296+(raw[4] as i64)*16777216+(raw[5] as i64)*65536+(raw[6] as i64)*256+(raw[7] as i64);
    let rem:i64=4503599627370496+frac;let den:i64=9007199254740992;_zag_print("0.");let i:i32=0;
    while(i<digits){rem=rem*10;let d:i64=rem/den;rem=rem-d*den;_zag_print(_zag_i64_to_str(d));i=i+1;}
}
fn ci_walk(p:*ParentMap,id:i32,depth:i32,seen:*i32)void {
    if(seen.*>=4096 || depth>16 || id<1 || id>p.*.node_count){return;}seen.*=seen.*+1;
    let k:i32=pm_kind(p,id);_zag_print("CJSON_NODE");ci_field(depth);ci_field(id);ci_field(k);
    if(k==1){_zag_print(",null");}
    else if(k==2 || k==3 || k==4){let x:i64=0;let rc:i32=pm_small_int(p,id,&x);ci_field(rc);ci_field(x);}
    else if(k==5 || k==6 || k==7 || k==8){_zag_print(",hex=");ci_hex(pm_raw(p,id));}
    else{let r:i32=(id-1)*10;ci_field(p.*.nodes[r+9]);}
    _zag_println("");
    if(k==9 || k==10){let r:i32=(id-1)*10;let e:i32=p.*.nodes[r+7] as i32;let n:i32=0;
        while(e>0 && n<4096){let er:i32=(e-1)*4;if(p.*.edges[er+3]==1){ci_walk(p,p.*.edges[er] as i32,depth+1,seen);}e=p.*.edges[er+2] as i32;n=n+1;}}
    else if(k==11){let r:i32=(id-1)*10;let e:i32=p.*.nodes[r+7] as i32;let n:i32=0;
        while(e>0 && n<4096){let er:i32=(e-1)*4;if(p.*.edges[er+3]==2){let key:i32=p.*.edges[er] as i32;let value:i32=p.*.edges[er+1] as i32;
            _zag_print("CJSON_KEY");ci_field(depth);ci_field(key);_zag_print(",hex=");ci_hex(pm_raw(p,key));ci_field(value);ci_field(pm_kind(p,value));_zag_println("");
            ci_walk(p,value,depth+1,seen);}e=p.*.edges[er+2] as i32;n=n+1;}}
}
fn main()i32 {
    if(_zag_argc()!=1){return 64;}let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}
    let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}
    let ic:i32=n17_identity(&p);if(ic!=0){mi_loaded_close(&p);return 4;}let r26:i32=pm_lookup(&p,p.root,"base_state");let a:i32=pm_lookup(&p,r26,"architecture");
    _zag_print("CJSON_ROOT,");ci_num(a);_zag_print(",");ci_num(pm_kind(&p,a));_zag_println("");let seen:i32=0;ci_walk(&p,a,0,&seen);
    let vep:i32=pm_lookup(&p,r26,"video_entity_policy");let graph:i32=pm_lookup(&p,vep,"graph");let mt:i32=pm_lookup(&p,graph,"merge_threshold");
    _zag_print("R26_MERGE_THRESHOLD,");ci_num(mt);_zag_print(",");ci_num(pm_kind(&p,mt));_zag_print(",hex=");ci_hex(pm_raw(&p,mt));_zag_print(",exact=");ci_float_half_decimal(pm_raw(&p,mt),60);_zag_println("");
    let reducer_global:i32=9736;_zag_print("R26_DOC_REDUCER_GLOBAL,");ci_num(reducer_global);ci_field(pm_kind(&p,reducer_global));
    let rgrow:i32=(reducer_global-1)*10;let rgmod:i32=p.nodes[rgrow+4] as i32;let rgname:i32=p.nodes[rgrow+5] as i32;
    _zag_print(",module_hex=");ci_hex(pm_raw(&p,rgmod));_zag_print(",name_hex=");ci_hex(pm_raw(&p,rgname));_zag_println("");
    _zag_print("CJSON_SEEN,");ci_num(seen);_zag_println("");mi_loaded_close(&p);return 0;
}

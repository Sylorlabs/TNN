// R33-N17 authoring-only native floating-point capability probe.
// No parent access, reducers, Python, learner, training, mutation or digest.
@import("../R33_NATIVE_IO_V1.zag")

fn main()i32 {
    let raw:[]u8=nio_alloc(8);if(raw.len!=8){return 2;}
    raw[0]=0;raw[1]=0;raw[2]=0;raw[3]=0;raw[4]=0;raw[5]=0;raw[6]=240;raw[7]=63;
    let p:*f64=_zag_slice_ptr(raw) as *f64;let x:f64=p.*;let y:f32=x as f32;let out:[]u8=nio_alloc(4);if(out.len!=4){nio_free(raw);return 3;}
    let q:*f32=_zag_slice_ptr(out) as *f32;q.*=y;
    _zag_print("F32_BYTES,");let i:i32=0;while(i<4){_zag_print(_zag_i64_to_str(out[i] as i64));if(i<3){_zag_print(",");}i=i+1;}_zag_println("");
    nio_free(out);nio_free(raw);return 0;
}

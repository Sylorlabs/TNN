// R33-N17 selector authoring inspector V2.
// Static inert-map inspection only. This source does not execute Python,
// reducers/classes, semantic digests, historical verifiers, learners,
// training, promotion, or parent mutation.
//
// Purpose: walk bounded first-level containers beneath already-resolved N17
// selectors so state-dict/list/nested-dict structure can be mapped without
// reconstructing historical Python objects.
@import("../identity.zag")

fn n17a2_print_ref(p:*ParentMap,label:[]u8,id:i32)void {
    _zag_print("N17A2_REF,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(pm_kind(p,id) as i64));_zag_print(",");
    let start:i64=-1;if(id>0 && id<=p.*.node_count){start=p.*.nodes[(id-1)*10+1];}
    _zag_println(_zag_i64_to_str(start));
}

fn n17a2_container_id(p:*ParentMap,id:i32)i32 {
    let k:i32=pm_kind(p,id);
    if(k==15 || k==16){let state:i32=pm_build_state(p,id);if(state>0){return state;}}
    return id;
}

fn n17a2_is_container(k:i32)i32 {
    return (k==9 || k==10 || k==11 || k==12 || k==13) as i32;
}

fn n17a2_dump_container(p:*ParentMap,label:[]u8,id:i32,limit:i32)void {
    let target:i32=n17a2_container_id(p,id);let kind:i32=pm_kind(p,target);
    _zag_print("N17A2_CONTAINER,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(target as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(kind as i64));_zag_print(",");
    let count:i64=-1;if(n17a2_is_container(kind)==1){count=p.*.nodes[(target-1)*10+9];}
    _zag_println(_zag_i64_to_str(count));
    if(n17a2_is_container(kind)!=1){return;}
    let e:i32=p.*.nodes[(target-1)*10+7] as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<limit){
        let row:i32=(e-1)*4;let a:i32=p.*.edges[row] as i32;let b:i32=p.*.edges[row+1] as i32;
        let op:i32=p.*.edges[row+3] as i32;
        _zag_print("N17A2_EDGE,");_zag_print(label);_zag_print(",");
        _zag_print(_zag_i64_to_str(seen as i64));_zag_print(",");
        _zag_print(_zag_i64_to_str(op as i64));_zag_print(",");
        _zag_print(_zag_i64_to_str(a as i64));_zag_print(",");
        _zag_print(_zag_i64_to_str(pm_kind(p,a) as i64));_zag_print(",");
        _zag_print(_zag_i64_to_str(b as i64));_zag_print(",");
        _zag_print(_zag_i64_to_str(pm_kind(p,b) as i64));
        if(op==2 && pm_kind(p,a)==6){_zag_print(",");_zag_print(pm_raw(p,a));}
        _zag_println("");
        e=p.*.edges[row+2] as i32;seen=seen+1;
    }
    if(e>0){_zag_print("N17A2_TRUNCATED,");_zag_print(label);_zag_print(",");_zag_println(_zag_i64_to_str(limit as i64));}
}

fn n17a2_dump_lookup(p:*ParentMap,label:[]u8,owner:i32,key:[]u8,limit:i32)i32 {
    let id:i32=pm_lookup(p,owner,key);n17a2_print_ref(p,label,id);n17a2_dump_container(p,label,id,limit);return id;
}

fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}
    let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);
    if(p.status!=0){return 3;}
    let identity_code:i32=n17_identity(&p);
    _zag_print("N17A2_IDENTITY_CODE,");_zag_println(_zag_i64_to_str(identity_code as i64));
    if(identity_code!=0){mi_loaded_close(&p);return 4;}

    let r27:i32=p.root;let r26:i32=pm_lookup(&p,r27,"base_state");
    let vep:i32=pm_lookup(&p,r26,"video_entity_policy");
    let rap:i32=pm_lookup(&p,r26,"abstraction_policy");
    let entity_head:i32=pm_lookup(&p,vep,"entity_head");
    let graph:i32=pm_lookup(&p,vep,"graph");
    let name_memory:i32=pm_lookup(&p,vep,"name_memory");
    let models:i32=pm_lookup(&p,rap,"models");

    // R26 digest-bearing structures.
    let net:i32=n17a2_dump_lookup(&p,"R26.entity_head.net",entity_head,"net",128);
    n17a2_dump_lookup(&p,"R26.graph.nodes",graph,"nodes",128);
    n17a2_dump_lookup(&p,"R26.name_memory.docs",name_memory,"docs",128);
    n17a2_dump_lookup(&p,"R26.name_memory.df",name_memory,"df",32);
    let s2g:i32=n17a2_dump_lookup(&p,"R26.abstraction_models.specific_to_general",models,"specific_to_general",128);
    let g2s:i32=n17a2_dump_lookup(&p,"R26.abstraction_models.general_to_specific",models,"general_to_specific",128);
    n17a2_dump_container(&p,"R26.entity_head.net.expanded",net,128);
    n17a2_dump_container(&p,"R26.abstraction.s2g.expanded",s2g,128);
    n17a2_dump_container(&p,"R26.abstraction.g2s.expanded",g2s,128);

    // R27 verifier/digest structures whose first level was resolved by V1.
    let category_system:i32=pm_lookup(&p,r27,"category_system");
    let abstraction_policy:i32=pm_lookup(&p,r27,"abstraction_policy");
    let semantic_generator:i32=pm_lookup(&p,r27,"semantic_generator");
    n17a2_dump_lookup(&p,"R27.category_system.dose_curve",category_system,"dose_curve",128);
    let abstraction_model:i32=n17a2_dump_lookup(&p,"R27.abstraction_policy.model",abstraction_policy,"model",128);
    n17a2_dump_lookup(&p,"R27.abstraction_policy.metrics",abstraction_policy,"metrics",128);
    let bpe:i32=n17a2_dump_lookup(&p,"R27.semantic_generator.bpe",semantic_generator,"bpe",128);
    let sgmodel:i32=n17a2_dump_lookup(&p,"R27.semantic_generator.model",semantic_generator,"model",128);
    let interpreter:i32=n17a2_dump_lookup(&p,"R27.semantic_generator.interpreter",semantic_generator,"interpreter",128);
    n17a2_dump_container(&p,"R27.abstraction_policy.model.expanded",abstraction_model,128);
    n17a2_dump_container(&p,"R27.semantic_generator.bpe.expanded",bpe,128);
    n17a2_dump_container(&p,"R27.semantic_generator.model.expanded",sgmodel,128);
    n17a2_dump_container(&p,"R27.semantic_generator.interpreter.expanded",interpreter,128);

    mi_loaded_close(&p);return 0;
}

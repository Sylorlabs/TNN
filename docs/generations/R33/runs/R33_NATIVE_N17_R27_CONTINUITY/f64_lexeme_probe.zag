// R33-N17 authoring-only mapping of exact historical R27 JSON float lexemes
// to compiler-rounded IEEE-754 binary64 bytes. No parent mutation or digest.
@import("identity.zag")

fn fl_hex_byte(x:u8)void {
    let d:[]u8="0123456789abcdef";let b:[]u8=nio_alloc(2);if(b.len!=2){return;}
    b[0]=d[(x as i32)/16];b[1]=d[(x as i32)%16];_zag_print(b);nio_free(b);
}
fn fl_one(text:[]u8,x:f64)void {
    let b:[]u8=nio_alloc(8);if(b.len!=8){return;}let q:*f64=_zag_slice_ptr(b) as *f64;q.*=x;
    _zag_print("R27_FLOAT_LEXEME,");let i:i32=7;while(i>=0){fl_hex_byte(b[i]);i=i-1;}_zag_print(",");_zag_print(text);_zag_println("");nio_free(b);
}
fn main()i32 {
    fl_one("-0.029166666666666785",-0.029166666666666785);
    fl_one("-0.03125",-0.03125);
    fl_one("-0.03333333333333344",-0.03333333333333344);

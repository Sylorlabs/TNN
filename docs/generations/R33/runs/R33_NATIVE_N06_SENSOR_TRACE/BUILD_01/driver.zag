// N06 sole engineering driver. Literal fixture formulas never enter the observer.
@import("sensor.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct N6Stats { checks:i32,failed:i32,values:i32,metadata:i32,children:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64 }
fn n6_stats()N6Stats {return N6Stats{.checks=0,.failed=0,.values=0,.metadata=0,.children=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn n6_check(s:*N6Stats,name:[]u8,actual:i64,expected:i64)void {
    s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(name,actual,expected);
}
fn n6_config()[]i32 {let c:[]i32=dt_words(6);c[0]=16;c[1]=330601;c[2]=2701;c[3]=1;c[4]=1;c[5]=7;return c;}
fn n6_path(name:[]u8)[]u8 {return _zag_str_concat("Research/R33_NATIVE_N06_RUN_PRIMARY_V1/",name);}
fn n6_equal(a:[]i32,b:[]i32)i32 {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn n6_fill(a:[]i32,v:i32)void {let i:i32=0;while(i<a.len){a[i]=v;i=i+1;}}
fn n6_all(a:[]i32,v:i32)i32 {let i:i32=0;while(i<a.len){if(a[i]!=v){return 0;}i=i+1;}return 1;}
fn n6_count(v:i32)i32 {
    if(v==0){return 65536;}if(v==1){return 12288;}
    if(v==2 || v==3 || v==8){return 24;}if(v==4 || v==5){return 6;}
    if(v==6){return 0;}if(v==7){return 16;}return 2;
}
fn n6_expected(v:i32,i:i32)i32 {
    if(v==0){if(i>=32768){return i-65536;}return i;}
    if(v==1){return (i*7+3)%256;}
    if(v==2 || v==8){return 0;}if(v==3){return (i==13) as i32;}
    if(v==4){return i*17;}if(v==5){return ((i+3)%6)*17;}
    if(v==7){if(i%2==0){return -32768;}return 32767;}
    if(v==9){if(i==0){return 7;}return -3;}
    if(i==0){return v*31;}return 0-v*31;
}
fn n6_metadata(ordinal:i32,v:i32)[]i32 {
    let m:[]i32=dt_words(12);m[0]=1;m[1]=1;m[2]=48000;m[5]=n6_count(v);m[6]=n6_count(v)*2;
    if(v==1 || v==4 || v==5){m[0]=2;m[1]=3;m[2]=0;m[3]=2;m[4]=1;
        if(v==1){m[3]=64;m[4]=64;}m[5]=m[3]*m[4];m[6]=n6_count(v);}
    if(v==7){m[1]=2;m[2]=192000;m[5]=8;}if(v==9){m[2]=8000;}
    m[7]=7;m[8]=ordinal;m[9]=100+ordinal*5;m[10]=1000000;m[11]=11;return m;
}
fn n6_reseal(raw:[]u8)void {
    let sums:[]i32=dt_words(2);rr_adler(raw,56,sums);
    rr_put32(raw,56,sums[0]);rr_put32(raw,60,sums[1]);dt_free_words(sums);
}
fn n6_raw(ordinal:i32,v:i32)[]u8 {
    let m:[]i32=n6_metadata(ordinal,v);let raw:[]u8=nio_alloc(64+m[6]);dt_copy("TNNRAW01",raw);
    let i:i32=0;while(i<12){rr_put32(raw,8+i*4,m[i]);i=i+1;}
    i=0;while(i<n6_count(v)){let value:i32=n6_expected(v,i);
        if(m[0]==1){if(value<0){value=value+65536;}raw[64+i*2]=(value%256) as u8;raw[65+i*2]=(value/256) as u8;}
        else{raw[64+i]=value as u8;}i=i+1;
    }n6_reseal(raw);dt_free_words(m);return raw;
}
fn n6_write(root:i64,name:[]u8,bytes:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,bytes)!=bytes.len || nio_sync(fd)!=0){code=-1;}
    if(nio_close(fd)!=0 || nio_sync(root)!=0){code=-1;}return code;
}
fn n6_verify(j:*DurableTelemetry,index:i32,v:i32,s:*N6Stats)void {
    let count:i32=n6_count(v);let out:[]i32=sn_words(count+1);let meta:[]i32=dt_words(12);
    n6_fill(out,31337);n6_fill(meta,31337);
    n6_check(s,"observer_complete",sn_observe(j,index,out,meta),0);
    let wrong:i32=0;let i:i32=0;while(i<count){if(out[i]!=n6_expected(v,i)){wrong=wrong+1;}i=i+1;}
    s.*.values=s.*.values+count;n6_check(s,"all_observer_values_exact",wrong,0);
    n6_check(s,"observer_tail_untouched",out[count],31337);
    let expected_meta:[]i32=n6_metadata(index,v);s.*.metadata=s.*.metadata+12;
    n6_check(s,"all_physical_metadata_exact",n6_equal(meta,expected_meta),1);
    let actual:SensorPacket=sn_load(j,index);let expected:[]u8=n6_raw(index,v);
    n6_check(s,"committed_raw_read",actual.status,0);n6_check(s,"complete_raw_packet_exact",nio_equal(actual.raw,expected),1);
    if(v==2){n6_check(s,"zero_twin_at_unsampled_position",out[13],0);}
    if(v==3){n6_check(s,"impulse_twin_at_unsampled_position",out[13],1);}
    if(v==4){n6_check(s,"ordered_rgb_first_channel",out[0],0);}
    if(v==5){n6_check(s,"reordered_rgb_first_channel",out[0],51);}
    dt_free_words(out);dt_free_words(meta);dt_free_words(expected_meta);nio_free(actual.raw);nio_free(expected);
}
fn n6_add(j:*DurableTelemetry,index:i32,v:i32,s:*N6Stats)void {
    let raw:[]u8=n6_raw(index,v);n6_check(s,"append_raw_and_trace",sn_append(j,raw),0);
    n6_check(s,"committed_count",j.*.count,index+1);nio_free(raw);
}
fn n6_refuse(j:*DurableTelemetry,raw:[]u8,code:i32,s:*N6Stats)void {
    let state:[]i32=dt_words(j.*.state.len);let causal:[]u8=nio_alloc(j.*.causal.len);
    let head:[]u8=nio_alloc(32);let input:[]u8=nio_alloc(raw.len);
    dt_copy_words(j.*.state,state);dt_copy(j.*.causal,causal);dt_copy(j.*.head,head);dt_copy(raw,input);
    let attempts:i32=j.*.attempts;let blobs:i32=sn_blob_count(j);let count:i32=j.*.count;
    n6_check(s,"admission_refused",sn_append(j,raw),code);
    n6_check(s,"refusal_entire_accumulator_unchanged",n6_equal(j.*.state,state),1);
    n6_check(s,"refusal_causal_unchanged",nio_equal(j.*.causal,causal),1);
    n6_check(s,"refusal_head_unchanged",nio_equal(j.*.head,head),1);
    n6_check(s,"refusal_input_unchanged",nio_equal(raw,input),1);
    n6_check(s,"refusal_attempt_quota_unchanged",j.*.attempts,attempts);
    n6_check(s,"refusal_blob_quota_unchanged",sn_blob_count(j),blobs);
    n6_check(s,"refusal_count_unchanged",j.*.count,count);
    dt_free_words(state);nio_free(causal);nio_free(head);nio_free(input);
}
fn n6_normal(replay:i32,capacity:i32,s:*N6Stats)void {
    let name:[]u8="normal";let total:i32=10;if(capacity==1){name="capacity";total=16;}
    let config:[]i32=n6_config();let path:[]u8=n6_path(name);
    if(replay==0){n6_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=sn_open(path,config);n6_check(s,"recover_complete_ledger",j.status,0);
    if(j.status==0){let i:i32=0;
        if(replay==0){while(i<total && s.*.failed==0){n6_add(&j,i,i,s);i=i+1;}}
        n6_check(s,"all_committed",j.count,total);n6_check(s,"no_orphan_blobs",sn_blob_count(&j)-j.count,0);
        if(s.*.failed==0){i=0;while(i<total && s.*.failed==0){n6_verify(&j,i,i,s);i=i+1;}}
        if(capacity==1 && replay==0){let excess:[]u8=n6_raw(16,16);n6_refuse(&j,excess,-8205,s);nio_free(excess);}
        if(capacity==0){let metrics:[]i32=dt_words(168);n6_check(s,"telemetry_snapshot",tm_snapshot(j.state,metrics),0);
            n6_check(s,"local_payload_repeat_recorded",metrics[10],1);n6_check(s,"unique_not_timestamp_duplicates",metrics[7],9);
            n6_check(s,"understanding_still_unmeasured",metrics[150],0);dt_free_words(metrics);}
    }dt_close(&j);dt_free_words(config);nio_free(path);
}
fn n6_bad_field(j:*DurableTelemetry,offset:i32,value:i32,code:i32,s:*N6Stats)void {
    let raw:[]u8=n6_raw(1,9);rr_put32(raw,offset,value);n6_reseal(raw);
    n6_refuse(j,raw,code,s);nio_free(raw);
}
fn n6_refusals(s:*N6Stats)void {
    let config:[]i32=n6_config();let path:[]u8=n6_path("refusals");n6_check(s,"create",dt_create(path,config),0);
    let j:DurableTelemetry=sn_open(path,config);n6_check(s,"recover",j.status,0);
    if(j.status==0){n6_add(&j,0,0,s);
        n6_bad_field(&j,36,8,-8204,s);n6_bad_field(&j,40,0,-8204,s);n6_bad_field(&j,40,2,-8204,s);
        n6_bad_field(&j,44,99,-8204,s);n6_bad_field(&j,48,999999,-8204,s);n6_bad_field(&j,16,7999,-8201,s);
        let raw:[]u8=n6_raw(1,9);raw[64]=8;n6_refuse(&j,raw,-8203,s);nio_free(raw);
        raw=n6_raw(1,9);n6_refuse(&j,raw[0..raw.len-1],-8201,s);nio_free(raw);
        let out:[]i32=sn_words(65535);let meta:[]i32=dt_words(12);n6_fill(out,777);n6_fill(meta,777);
        n6_check(s,"short_observer_output_refused",sn_observe(&j,0,out,meta),-8202);
        n6_check(s,"short_output_entirely_unchanged",n6_all(out,777),1);n6_check(s,"short_metadata_unchanged",n6_all(meta,777),1);
        n6_check(s,"uncommitted_index_refused",sn_observe(&j,1,out,meta),-8204);
        let state:[]i32=dt_words(j.state.len);dt_copy_words(j.state,state);
        n6_check(s,"observer_internal_alias_refused",sn_observe(&j,0,j.state,meta),-8210);
        n6_check(s,"internal_alias_no_mutation",n6_equal(state,j.state),1);
        n6_check(s,"overlapping_outputs_refused",sn_observe(&j,0,out,out[0..12]),-8210);
        n6_check(s,"overlapping_outputs_unchanged",n6_all(out,777),1);
        dt_free_words(state);dt_free_words(out);dt_free_words(meta);
    }dt_close(&j);dt_free_words(config);nio_free(path);
}
fn n6_orphans(replay:i32,crash:i32,s:*N6Stats)void {
    let name:[]u8="orphans";if(crash==1){name="crash";}
    let config:[]i32=n6_config();let path:[]u8=n6_path(name);
    if(replay==0){n6_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=sn_open(path,config);n6_check(s,"recover",j.status,0);let raw:[]u8=n6_raw(0,0);
    if(j.status==0){
        if(replay==0){
            if(crash==1){n6_check(s,"crash_must_not_return",sn_append_diagnostic(&j,raw,2),73);}
            else{let i:i32=0;while(i<32 && s.*.failed==0){
                n6_check(s,"partial_raw_error_explicit",sn_append_diagnostic(&j,raw,1),-8211);
                n6_check(s,"failed_raw_does_not_commit",j.count,0);n6_check(s,"failed_raw_handle_poisoned",j.status,-8208);
                dt_close(&j);j=sn_open(path,config);n6_check(s,"recover_orphan",j.status,0);
                n6_check(s,"orphan_quota_preserved",sn_blob_count(&j),i+1);i=i+1;
            }}
        }
        if(s.*.failed==0){let expected:i32=32;if(crash==1){expected=1;}
            n6_check(s,"no_uncommitted_raw_exposed",j.count,0);n6_check(s,"blob_reservations_preserved",sn_blob_count(&j),expected);
            n6_check(s,"no_phantom_telemetry_attempt",j.attempts,0);
            if(crash==0){n6_refuse(&j,raw,-8205,s);}
            else{n6_add(&j,0,0,s);n6_check(s,"continued_with_next_blob",dt_get(j.causal,40),2);
                n6_check(s,"orphan_not_overwritten",sn_blob_count(&j),2);n6_verify(&j,0,0,s);}
        }
    }dt_close(&j);nio_free(raw);dt_free_words(config);nio_free(path);
}
fn n6_damage(root:i64,kind:i32)i32 {
    let fd:i64=nio_open_child(root,"blob-2.bin",0);if(fd<0){return -1;}
    let b:[]u8=nio_alloc(131136);let n:i64=nio_read_exact(fd,b,131136);nio_close(fd);
    if(n<65 || n>131136){nio_free(b);return -1;}
    if(n6_write(root,"preimage.bin",b[0..n as i32])!=0){nio_free(b);return -1;}
    let old:[]u8=nio_cstr("blob-2.bin");let code:i32=0;
    if(kind==3){let kept:[]u8=nio_cstr("retained-blob2.bin");
        if(_zag_darwin_syscall(465,root,_zag_slice_ptr(old) as i64,root,_zag_slice_ptr(kept) as i64,0,0)!=0){code=-1;}nio_free(kept);
    }else{
        fd=_zag_darwin_syscall(463,root,_zag_slice_ptr(old) as i64,16777478,0,0,0);
        if(fd<0 || nio_regular(fd)!=1){code=-1;}else{
            if(kind==2){if(_zag_darwin_syscall(201,fd,n-1,0,0,0,0)!=0){code=-1;}}
            else{b[64]=(b[64] as i32+1) as u8;if(nio_write_all(fd,b[0..n as i32])!=n){code=-1;}}
            if(nio_sync(fd)!=0){code=-1;}
        }if(fd>=0 && nio_close(fd)!=0){code=-1;}
    }
    if(nio_sync(root)!=0){code=-1;}nio_free(old);nio_free(b);return code;
}
fn n6_corrupt(kind:i32,replay:i32,s:*N6Stats)void {
    let number:[]u8=_zag_i64_to_str(kind as i64);let name:[]u8=_zag_str_concat("corrupt",number);let path:[]u8=n6_path(name);
    let config:[]i32=n6_config();if(replay==0){n6_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=sn_open(path,config);
    if(replay==0){n6_check(s,"setup_recover",j.status,0);
        if(j.status==0){let i:i32=0;while(i<3 && s.*.failed==0){n6_add(&j,i,i,s);i=i+1;}
            if(s.*.failed==0){n6_check(s,"preimage_preserved_and_damage_injected",n6_damage(j.root,kind),0);}}
    }else{let expected:i32=-8203;if(kind==2){expected=-8201;}if(kind==3){expected=-8204;}
        n6_check(s,"fresh_broken_evidence_rejected",j.status,expected);n6_check(s,"no_unusable_accumulator",j.state.len,0);
        n6_check(s,"no_unusable_causal_store",j.causal.len,0);n6_check(s,"closed_root",j.root,-1);n6_check(s,"closed_lock",j.lock,-1);
    }dt_close(&j);dt_free_words(config);nio_free(number);nio_free(name);nio_free(path);
}
fn n6_has(b:[]u8,needle:[]u8)i32 {
    let i:i32=0;while(i+needle.len<=b.len){let k:i32=0;while(k<needle.len && b[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;}return 0;
}
fn n6_number(b:[]u8,prefix:[]u8,tail:[]u8)i32 {
    let value:i32=-1;let i:i32=0;
    while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){
            if(value>=0){return -1;}let at:i32=i+k;let v:i32=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<9){v=v*10+(b[at] as i32)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;
            while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;
        }i=i+1;
    }return value;
}
fn n6_run(root:i64,mode:[]u8,expected:i32,s:*N6Stats)void {
    if(s.*.failed!=0){return;}
    let r:NativeRunV3=nrv3_run(root,"Research/R33_NATIVE_N06_SENSOR_TRACE/BUILD_01/n06",mode,mode,15000,262144);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    n6_check(s,"child_status",r.status,0);n6_check(s,"child_started",r.started,1);n6_check(s,"child_reaped",r.reaped,1);
    n6_check(s,"child_exit",r.exit_code,expected);n6_check(s,"child_signal",r.signal,0);n6_check(s,"child_stderr_empty",r.stderr_bytes,0);
    n6_check(s,"child_rss_bound",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(mode,".stdout");let fd:i64=nio_open_child(root,name,0);
    let n:i64=nio_read_exact(fd,b,262144);if(fd>=0){nio_close(fd);}nio_free(name);
    n6_check(s,"complete_capture",n,r.stdout_bytes);
    if(n>=0 && n<=262144){let log:[]u8=b[0..n as i32];
        if(expected==0){n6_check(s,"child_terminal_pass",n6_has(log,"N06_CHILD_PASS\n"),1);
            let checks:i32=n6_number(log,"N06_CHILD_COUNTS,",",0\n");let values:i32=n6_number(log,"N06_VALUES_COMPARED,","\n");
            let metadata:i32=n6_number(log,"N06_METADATA_COMPARED,","\n");
            n6_check(s,"native_counters_valid",(checks>0 && values>=0 && metadata>=0) as i32,1);
            if(checks>0){s.*.child_checks=s.*.child_checks+checks;}if(values>=0){s.*.values=s.*.values+values;}if(metadata>=0){s.*.metadata=s.*.metadata+metadata;}
        }else if(expected==73){n6_check(s,"raw_commit_crash_marker",n6_has(log,"N06_RAW_DURABLE_BEFORE_TRACE_CRASH\n"),1);}
        else{n6_check(s,"invalid_mode_silent",n,0);}
    }nio_free(b);
}
fn n6_field(b:[]u8,key:[]u8,v:i64)[]u8 {
    let num:[]u8=_zag_i64_to_str(v);let part:[]u8=_zag_str_concat(b,key);let out:[]u8=_zag_str_concat(part,num);
    nio_free(b);nio_free(part);nio_free(num);return out;
}
fn n6_supervise()i32 {
    if(nio_guard(60)!=0){return 3;}let admission:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N06_RUN_PRIMARY_V1");
    if(admission.status!=0){return 4;}let root:i64=admission.root;let s:N6Stats=n6_stats();
    n6_run(root,"invalid",2,&s);n6_run(root,"normal-write",0,&s);n6_run(root,"normal-replay",0,&s);n6_run(root,"refusals",0,&s);
    n6_run(root,"capacity-write",0,&s);n6_run(root,"capacity-replay",0,&s);n6_run(root,"orphans-write",0,&s);n6_run(root,"orphans-replay",0,&s);
    n6_run(root,"crash-write",73,&s);n6_run(root,"crash-replay",0,&s);
    n6_run(root,"corrupt1-write",0,&s);n6_run(root,"corrupt1-replay",0,&s);
    n6_run(root,"corrupt2-write",0,&s);n6_run(root,"corrupt2-replay",0,&s);
    n6_run(root,"corrupt3-write",0,&s);n6_run(root,"corrupt3-replay",0,&s);
    n6_check(&s,"all_scheduled_children_completed",s.children,16);
    n6_check(&s,"all_planned_observer_values_compared",s.values,377264);
    n6_check(&s,"all_planned_metadata_fields_compared",s.metadata,636);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\": \"R33-N06\",\n  \"planned_children\": 16","");
    json=n6_field(json,",\n  \"completed_children\": ",s.children);json=n6_field(json,",\n  \"parent_failures\": ",s.failed);
    json=n6_field(json,",\n  \"verified_child_checks\": ",s.child_checks);json=n6_field(json,",\n  \"parent_checks_before_result_write\": ",s.checks);
    json=n6_field(json,",\n  \"observer_values_compared\": ",s.values);json=n6_field(json,",\n  \"metadata_fields_compared\": ",s.metadata);
    json=n6_field(json,",\n  \"summed_child_cpu_us\": ",s.cpu);json=n6_field(json,",\n  \"summed_observed_child_wall_us\": ",s.wall);
    json=n6_field(json,",\n  \"peak_child_rss_bytes\": ",s.rss);
    let tail:[]u8=_zag_str_concat(json,",\n  \"training\": false,\n  \"canonical_mutation\": false,\n  \"requires_terminal_pass_marker\": true\n}\n");nio_free(json);
    n6_check(&s,"native_result_saved",n6_write(root,"NATIVE_RESULT.json",tail),0);_zag_print(tail);nio_free(tail);
    n6_check(&s,"close_root",nio_close(root),0);_zag_print("N06_PARENT_FAILURES,");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("R33_N06_RAW_SENSOR_TRACE_OBSERVER_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return n6_supervise();}if(_zag_strcmp(mode,"invalid")==1){return 2;}
    if(nio_deadline(15)!=0){return 3;}let s:N6Stats=n6_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"normal-write")==1){n6_normal(0,0,&s);}else if(_zag_strcmp(mode,"normal-replay")==1){n6_normal(1,0,&s);}
    else if(_zag_strcmp(mode,"capacity-write")==1){n6_normal(0,1,&s);}else if(_zag_strcmp(mode,"capacity-replay")==1){n6_normal(1,1,&s);}
    else if(_zag_strcmp(mode,"refusals")==1){n6_refusals(&s);}
    else if(_zag_strcmp(mode,"orphans-write")==1){n6_orphans(0,0,&s);}else if(_zag_strcmp(mode,"orphans-replay")==1){n6_orphans(1,0,&s);}
    else if(_zag_strcmp(mode,"crash-write")==1){n6_orphans(0,1,&s);}else if(_zag_strcmp(mode,"crash-replay")==1){n6_orphans(1,1,&s);}
    else if(_zag_strcmp(mode,"corrupt1-write")==1){n6_corrupt(1,0,&s);}else if(_zag_strcmp(mode,"corrupt1-replay")==1){n6_corrupt(1,1,&s);}
    else if(_zag_strcmp(mode,"corrupt2-write")==1){n6_corrupt(2,0,&s);}else if(_zag_strcmp(mode,"corrupt2-replay")==1){n6_corrupt(2,1,&s);}
    else if(_zag_strcmp(mode,"corrupt3-write")==1){n6_corrupt(3,0,&s);}else if(_zag_strcmp(mode,"corrupt3-replay")==1){n6_corrupt(3,1,&s);}
    else{handled=0;}if(handled==0){return 2;}
    _zag_print("N06_VALUES_COMPARED,");_zag_println(_zag_i64_to_str(s.values as i64));
    _zag_print("N06_METADATA_COMPARED,");_zag_println(_zag_i64_to_str(s.metadata as i64));
    _zag_print("N06_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N06_CHILD_PASS");return 0;
}

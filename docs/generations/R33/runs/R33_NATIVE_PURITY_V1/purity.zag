// R33 strict native-only purity scanner V1.
// Native Zag only. No subprocess execution, libc, foreign parser, or evaluator.

fn pu_compiler_path()[]u8 {return "/Users/Shared/micah/Documents/Zag/znc";}

struct PuAudit {
    files:i32,
    dirs:i32,
    skipped:i32,
    violations:i32,
    errors:i32,
}

fn pu_zero()PuAudit {
    return PuAudit{.files=0,.dirs=0,.skipped=0,.violations=0,.errors=0};
}

fn pu_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;while(i<n){b[i]=0;i=i+1;}return b;
}
fn pu_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}
fn pu_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn pu_prefix(a:[]u8,p:[]u8)i32 {if(a.len<p.len){return 0;}return pu_eq(a[0..p.len],p);}
fn pu_suffix(a:[]u8,s:[]u8)i32 {if(a.len<s.len){return 0;}return pu_eq(a[a.len-s.len..a.len],s);}
fn pu_contains(a:[]u8,n:[]u8)i32 {
    if(n.len==0 || a.len<n.len){return 0;}let i:i32=0;
    while(i<=a.len-n.len){if(pu_eq(a[i..i+n.len],n)==1){return 1;}i=i+1;}return 0;
}
fn pu_lower(c:u8)u8 {if(c>=65 && c<=90){return (c+32) as u8;}return c;}
fn pu_ident(c:u8)i32 {
    return ((c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122)||c==95||c==45) as i32;
}
fn pu_word_ci_at(a:[]u8,w:[]u8,at:i32)i32 {
    if(at<0 || at+w.len>a.len){return 0;}
    if(at>0 && pu_ident(a[at-1])==1){return 0;}
    if(at+w.len<a.len && pu_ident(a[at+w.len])==1){return 0;}
    let i:i32=0;while(i<w.len){if(pu_lower(a[at+i])!=pu_lower(w[i])){return 0;}i=i+1;}return 1;
}
fn pu_contains_word_ci(a:[]u8,w:[]u8)i32 {
    if(w.len==0 || a.len<w.len){return 0;}let i:i32=0;
    while(i<=a.len-w.len){if(pu_word_ci_at(a,w,i)==1){return 1;}i=i+1;}return 0;
}
fn pu_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>8191){return "";}let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=pu_alloc(s.len+1);if(b.len==0){return b;}i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn pu_join(a:[]u8,b:[]u8)[]u8 {
    let stem:[]u8=_zag_str_concat(a,"/");let out:[]u8=_zag_str_concat(stem,b);_zag_str_free(stem);return out;
}
fn pu_u16(b:[]u8,at:i32)i32 {return (b[at] as i32)+((b[at+1] as i32)<<8);}
fn pu_name(b:[]u8,at:i32,count:i32)[]u8 {
    let n:i32=0;while(n<count && b[at+n]!=0){n=n+1;}return b[at..at+n];
}
fn pu_close(fd:i64)i64 {return _zag_darwin_syscall(6,fd,0,0,0,0,0);}
fn pu_open_dir(path:[]u8)i64 {
    let c:[]u8=pu_cstr(path);if(c.len==0){return -1;}
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW_ANY.
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(c) as i64,554696704,0,0,0,0);pu_free(c);return fd;
}
fn pu_read_file(path:[]u8,max:i32,status:*i32)[]u8 {
    status.*=-1;if(max<1 || max>33554431){return "";}
    let c:[]u8=pu_cstr(path);if(c.len==0){return "";}
    // O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY.
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(c) as i64,553648128,0,0,0,0);pu_free(c);
    if(fd<0){return "";}
    let st:[]u8=pu_alloc(256);if(st.len==0){pu_close(fd);return "";}
    let sr:i64=_zag_darwin_syscall(339,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    let mode:i32=pu_u16(st,4);pu_free(st);
    if(sr!=0 || (mode & 61440)!=32768){pu_close(fd);return "";}
    let size:i64=_zag_darwin_syscall(199,fd,0,2,0,0,0);
    if(size<0 || size>max){pu_close(fd);status.*=-2;return "";}
    if(_zag_darwin_syscall(199,fd,0,0,0,0,0)!=0){pu_close(fd);return "";}
    let out:[]u8=pu_alloc((size as i32)+1);if(out.len==0){pu_close(fd);return "";}
    let at:i64=0;let calls:i32=0;let bad:i32=0;
    while(at<size && calls<65536){
        let n:i64=_zag_darwin_syscall(3,fd,(_zag_slice_ptr(out) as i64)+at,size-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<=0){bad=1;break;}at=at+n;
    }
    if(pu_close(fd)!=0){bad=1;}if(at!=size){bad=1;}
    if(bad==1){pu_free(out);return "";}status.*=0;return out[0..size as i32];
}
fn pu_read_prefix(path:[]u8,limit:i32,status:*i32)[]u8 {
    status.*=-1;if(limit<1 || limit>4096){return "";}
    let c:[]u8=pu_cstr(path);if(c.len==0){return "";}
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(c) as i64,553648128,0,0,0,0);pu_free(c);
    if(fd<0){return "";}
    let st:[]u8=pu_alloc(256);if(st.len==0){pu_close(fd);return "";}
    let sr:i64=_zag_darwin_syscall(339,fd,_zag_slice_ptr(st) as i64,0,0,0,0);let mode:i32=pu_u16(st,4);pu_free(st);
    if(sr!=0 || (mode & 61440)!=32768){pu_close(fd);return "";}
    let out:[]u8=pu_alloc(limit);if(out.len!=limit){pu_close(fd);return "";}
    let at:i64=0;let calls:i32=0;let bad:i32=0;
    while(at<limit && calls<64){let n:i64=_zag_darwin_syscall(3,fd,(_zag_slice_ptr(out) as i64)+at,(limit as i64)-at,0,0,0);calls=calls+1;
        if(n==-4){continue;}if(n<0){bad=1;break;}if(n==0){break;}at=at+n;}
    if(pu_close(fd)!=0){bad=1;}if(bad==1){pu_free(out);return "";}status.*=0;
    if(at==0){pu_free(out);return "";}return out[0..at as i32];
}
// Content-pinned trusted-file reader. Unlike source-tree reads this permits
// pathname traversal through host-managed ancestors; callers must hash-bind
// the returned bytes before granting authority.
fn pu_read_pinned_file(path:[]u8,max:i32,status:*i32)[]u8 {
    status.*=-1;if(max<1 || max>33554431){return "";}
    let c:[]u8=pu_cstr(path);if(c.len==0){return "";}
    // O_RDONLY. Exact content identity is established by the caller's native
    // SHA-256 pin, so pathname-link policy cannot substitute different bytes.
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(c) as i64,0,0,0,0,0);pu_free(c);
    if(fd<0){return "";}
    let st:[]u8=pu_alloc(256);if(st.len==0){pu_close(fd);return "";}
    let sr:i64=_zag_darwin_syscall(339,fd,_zag_slice_ptr(st) as i64,0,0,0,0);let mode:i32=pu_u16(st,4);pu_free(st);
    if(sr!=0 || (mode & 61440)!=32768){pu_close(fd);return "";}
    let size:i64=_zag_darwin_syscall(199,fd,0,2,0,0,0);if(size<0 || size>max){pu_close(fd);status.*=-2;return "";}
    if(_zag_darwin_syscall(199,fd,0,0,0,0,0)!=0){pu_close(fd);return "";}
    let out:[]u8=pu_alloc((size as i32)+1);if(out.len==0){pu_close(fd);return "";}
    let at:i64=0;let calls:i32=0;let bad:i32=0;
    while(at<size && calls<65536){let n:i64=_zag_darwin_syscall(3,fd,(_zag_slice_ptr(out) as i64)+at,size-at,0,0,0);calls=calls+1;
        if(n==-4){continue;}if(n<=0){bad=1;break;}at=at+n;}
    if(pu_close(fd)!=0 || at!=size){bad=1;}if(bad==1){pu_free(out);return "";}status.*=0;return out[0..size as i32];
}

fn pu_skip_dir(name:[]u8,fixture_mode:i32)i32 {
    if(pu_eq(name,".")==1 || pu_eq(name,"..")==1 || pu_eq(name,".git")==1 || pu_eq(name,".zag-cache")==1){return 1;}
    if(pu_eq(name,"BUILD")==1 || pu_prefix(name,"BUILD_")==1 || pu_prefix(name,"AUTHORING_BUILD_")==1 ||
       pu_prefix(name,"PREREVIEW_")==1 || pu_prefix(name,"SELECTOR_AUTHORING_")==1 ||
       pu_prefix(name,"ENGINEERING_")==1 || pu_prefix(name,"HOST_V2_ENGINEERING_")==1 ||
       pu_prefix(name,"RUNTIME_QUAL_")==1){return 1;}
    if(fixture_mode==0 && pu_eq(name,"fixtures")==1){return 1;}return 0;
}

// 0 ignored/inert, 1 Zag, 2 shell runner, 3 forbidden foreign source.
fn pu_file_kind(name:[]u8)i32 {
    if(pu_suffix(name,".py.txt")==1){return 0;}
    if(pu_suffix(name,".zag")==1 || pu_suffix(name,".zs")==1 || pu_suffix(name,".zagfrag")==1){return 1;}
    if(pu_suffix(name,".zsh")==1 || pu_suffix(name,".sh")==1 || pu_suffix(name,".bash")==1 ||
       pu_suffix(name,".ksh")==1 || pu_suffix(name,".command")==1 || pu_suffix(name,".fish")==1){return 2;}
    if(pu_suffix(name,".py")==1 || pu_suffix(name,".pyw")==1 || pu_suffix(name,".js")==1 || pu_suffix(name,".mjs")==1 ||
       pu_suffix(name,".cjs")==1 || pu_suffix(name,".ts")==1 || pu_suffix(name,".tsx")==1 || pu_suffix(name,".rb")==1 ||
       pu_suffix(name,".pl")==1 || pu_suffix(name,".jl")==1 || pu_suffix(name,".lua")==1 || pu_suffix(name,".php")==1 ||
       pu_suffix(name,".java")==1 || pu_suffix(name,".swift")==1 || pu_suffix(name,".rs")==1 || pu_suffix(name,".go")==1 ||
       pu_suffix(name,".c")==1 || pu_suffix(name,".cc")==1 || pu_suffix(name,".cpp")==1){return 3;}
    return 0;
}
fn pu_source_symlink(name:[]u8)i32 {return (pu_file_kind(name)!=0) as i32;}

fn pu_print_violation(a:*PuAudit,kind:[]u8,path:[]u8,line:i32)void {
    a.*.violations=a.*.violations+1;_zag_print("R33_PURITY_V1_VIOLATION,");_zag_print(kind);_zag_print(",");_zag_print(path);_zag_print(",line=");
    let n:[]u8=_zag_i64_to_str(line as i64);_zag_println(n);_zag_str_free(n);
}

fn pu_runtime_word(line:[]u8)i32 {
    if(pu_contains_word_ci(line,"python")==1 || pu_contains_word_ci(line,"python2")==1 || pu_contains_word_ci(line,"python3")==1 ||
       pu_contains_word_ci(line,"pypy")==1 || pu_contains_word_ci(line,"pypy3")==1 || pu_contains_word_ci(line,"pytest")==1 ||
       pu_contains_word_ci(line,"torchrun")==1 || pu_contains_word_ci(line,"pytorch")==1 || pu_contains_word_ci(line,"torch")==1 ||
       pu_contains_word_ci(line,"numpy")==1 || pu_contains_word_ci(line,"sklearn")==1 || pu_contains_word_ci(line,"tensorflow")==1 ||
       pu_contains_word_ci(line,"jax")==1 || pu_contains_word_ci(line,"node")==1 || pu_contains_word_ci(line,"nodejs")==1 ||
       pu_contains_word_ci(line,"ruby")==1 || pu_contains_word_ci(line,"perl")==1 || pu_contains_word_ci(line,"julia")==1 ||
       pu_contains_word_ci(line,"rscript")==1 || pu_contains_word_ci(line,"java")==1 || pu_contains_word_ci(line,"deno")==1 ||
       pu_contains_word_ci(line,"bun")==1 || pu_contains_word_ci(line,"lua")==1 || pu_contains_word_ci(line,"php")==1 ||
       pu_contains_word_ci(line,"dotnet")==1 || pu_contains_word_ci(line,"mono")==1 || pu_contains_word_ci(line,"clang")==1 ||
       pu_contains_word_ci(line,"gcc")==1 || pu_contains_word_ci(line,"rustc")==1 || pu_contains_word_ci(line,"cargo")==1 ||
       pu_contains_word_ci(line,"zig")==1 || pu_contains_word_ci(line,"uv")==1 || pu_contains_word_ci(line,"pip")==1 ||
       pu_contains_word_ci(line,"pip3")==1 || pu_contains_word_ci(line,"poetry")==1 || pu_contains_word_ci(line,"conda")==1 ||
       pu_contains_word_ci(line,"mamba")==1 || pu_contains_word_ci(line,"jq")==1 || pu_contains_word_ci(line,"matlab")==1 ||
       pu_contains_word_ci(line,"octave")==1){return 1;}return 0;
}

fn pu_shell_code_end(line:[]u8)i32 {
    let quote:i32=0;let escape:i32=0;let i:i32=0;
    while(i<line.len){let c:u8=line[i];
        if(escape==1){escape=0;i=i+1;continue;}
        if(c==92 && quote!=39){escape=1;i=i+1;continue;}
        if(quote==0 && (c==39 || c==34)){quote=c as i32;i=i+1;continue;}
        if(quote!=0 && c==quote as u8){quote=0;i=i+1;continue;}
        if(quote==0 && c==35){return i;}i=i+1;
    }return line.len;
}
fn pu_znc_refs_ok(code:[]u8)i32 {
    let path:[]u8=pu_compiler_path();let i:i32=0;let trusted:i32=path.len;
    while(i<=code.len-3){
        if(pu_word_ci_at(code,"znc",i)==1){
            let start:i32=i-(trusted-3);if(start<0 || i+3>code.len || pu_eq(code[start..i+3],path)!=1){return 0;}
        }i=i+1;
    }return 1;
}
fn pu_comp_assignment(line:[]u8)i32 {
    let i:i32=0;while(i+5<=line.len){
        if((i==0 || pu_ident(line[i-1])==0) && pu_eq(line[i..i+5],"COMP=")==1){return i;}i=i+1;
    }return -1;
}
fn pu_shell_scan(path:[]u8,data:[]u8,a:*PuAudit)void {
    let start:i32=0;let line_no:i32=1;let trusted_comp:i32=0;let comp_use:i32=0;
    while(start<=data.len){let end:i32=start;while(end<data.len && data[end]!=10){end=end+1;}let raw:[]u8=data[start..end];let ce:i32=pu_shell_code_end(raw);let code:[]u8=raw[0..ce];
        let nonspace:i32=0;while(nonspace<code.len && (code[nonspace]==32 || code[nonspace]==9)){nonspace=nonspace+1;}
        if(nonspace<code.len){
            if(pu_runtime_word(code)==1){pu_print_violation(a,"FOREIGN_RUNTIME_RUNNER",path,line_no);}
            if(pu_znc_refs_ok(code)!=1){pu_print_violation(a,"NONLOCAL_ZAG_COMPILER",path,line_no);}
            let ca:i32=pu_comp_assignment(code);if(ca>=0){
                if(pu_contains(code[ca..code.len],pu_compiler_path())==1 && pu_znc_refs_ok(code)==1){trusted_comp=1;}
                else{pu_print_violation(a,"NONLOCAL_COMP_ASSIGNMENT",path,line_no);}
            }
            if(pu_contains(code,"$COMP")==1 || pu_contains(code,"${COMP}")==1){comp_use=1;}
            if(pu_contains(code,"$ZNC")==1 || pu_contains(code,"${ZNC}")==1 || pu_contains(code,"$COMPILER")==1 || pu_contains(code,"${COMPILER}")==1){
                pu_print_violation(a,"DYNAMIC_COMPILER_REFERENCE",path,line_no);
            }
        }
        if(end==data.len){break;}start=end+1;line_no=line_no+1;
    }
    if(comp_use==1 && trusted_comp==0){pu_print_violation(a,"UNBOUND_COMPILER_VARIABLE",path,0);}
}

fn pu_strip_zag_comments(data:[]u8)[]u8 {
    let out:[]u8=pu_alloc(data.len+1);if(out.len==0){return "";}
    let i:i32=0;let line:i32=0;let block:i32=0;let quote:i32=0;let escape:i32=0;
    while(i<data.len){let c:u8=data[i];let next:u8=0;if(i+1<data.len){next=data[i+1];}
        if(line==1){if(c==10){line=0;out[i]=c;}else{out[i]=32;}i=i+1;continue;}
        if(block==1){if(c==42 && next==47){out[i]=32;out[i+1]=32;i=i+2;block=0;}else{if(c==10){out[i]=10;}else{out[i]=32;}i=i+1;}continue;}
        if(quote!=0){out[i]=c;if(escape==1){escape=0;}else if(c==92){escape=1;}else if(c==quote as u8){quote=0;}i=i+1;continue;}
        if(c==47 && next==47){out[i]=32;out[i+1]=32;i=i+2;line=1;continue;}
        if(c==47 && next==42){out[i]=32;out[i+1]=32;i=i+2;block=1;continue;}
        if(c==34 || c==39){quote=c as i32;out[i]=c;i=i+1;continue;}out[i]=c;i=i+1;
    }return out[0..data.len];
}
fn pu_strip_zag_strings(code:[]u8)[]u8 {
    let out:[]u8=pu_alloc(code.len+1);if(out.len==0){return "";}
    let i:i32=0;let quote:i32=0;let escape:i32=0;
    while(i<code.len){let c:u8=code[i];
        if(quote!=0){
            if(c==10){out[i]=10;}else{out[i]=32;}
            if(escape==1){escape=0;}else if(c==92){escape=1;}else if(c==quote as u8){quote=0;}i=i+1;continue;
        }
        if(c==34 || c==39){quote=c as i32;out[i]=32;i=i+1;continue;}out[i]=c;i=i+1;
    }return out[0..code.len];
}
fn pu_zag_has_exec(code:[]u8)i32 {
    if(pu_contains(code,"execve")==1 || pu_contains(code,"posix_spawn")==1 || pu_contains(code,"popen(")==1 || pu_contains(code,"system(")==1){return 1;}
    let start:i32=0;while(start<=code.len){let end:i32=start;while(end<code.len && code[end]!=10){end=end+1;}let line:[]u8=code[start..end];
        if((pu_contains(line,"_zag_darwin_syscall")==1 || pu_contains(line,"_zag_raw_syscall")==1) && pu_contains_word_ci(line,"59")==1){return 1;}
        if(end==code.len){break;}start=end+1;
    }return 0;
}
fn pu_zag_scan(path:[]u8,data:[]u8,a:*PuAudit)void {
    let code:[]u8=pu_strip_zag_comments(data);if(code.len!=data.len){a.*.errors=a.*.errors+1;pu_print_violation(a,"ZAG_COMMENT_SCAN_ERROR",path,0);return;}
    let structure:[]u8=pu_strip_zag_strings(code);if(structure.len!=code.len){pu_free(code);a.*.errors=a.*.errors+1;pu_print_violation(a,"ZAG_STRING_SCAN_ERROR",path,0);return;}
    let exec:i32=pu_zag_has_exec(structure);
    if(exec==1 && pu_runtime_word(code)==1){pu_print_violation(a,"FOREIGN_RUNTIME_EXEC_SURFACE",path,0);}
    if(exec==1 && pu_znc_refs_ok(code)!=1){pu_print_violation(a,"NONLOCAL_ZAG_COMPILER_EXEC",path,0);}
    pu_free(structure);pu_free(code);
}

fn pu_walk(path:[]u8,a:*PuAudit,fixture_mode:i32,depth:i32)void {
    if(depth>32 || a.*.dirs>4096 || a.*.files>32768){a.*.errors=a.*.errors+1;pu_print_violation(a,"SCAN_BOUND",path,0);return;}
    let fd:i64=pu_open_dir(path);if(fd<0){a.*.errors=a.*.errors+1;pu_print_violation(a,"DIRECTORY_OPEN",path,0);return;}
    a.*.dirs=a.*.dirs+1;let entries:[]u8=pu_alloc(32768);if(entries.len==0){pu_close(fd);a.*.errors=a.*.errors+1;return;}
    let done:i32=0;while(done==0){let base:i64=0;let nread:i64=_zag_darwin_syscall(344,fd,_zag_slice_ptr(entries) as i64,entries.len,(&base) as i64,0,0);
        if(nread==0){done=1;break;}if(nread<0){a.*.errors=a.*.errors+1;pu_print_violation(a,"DIRECTORY_READ",path,0);break;}
        let off:i32=0;while(off+21<=nread){let reclen:i32=pu_u16(entries,off+16);let namlen:i32=pu_u16(entries,off+18);
            if(reclen<21 || off+reclen>nread || namlen>reclen-21){a.*.errors=a.*.errors+1;pu_print_violation(a,"DIRENT_CORRUPT",path,0);off=nread as i32;continue;}
            let dtype:i32=entries[off+20] as i32;let name:[]u8=pu_name(entries,off+21,namlen);
            if(dtype==4){if(pu_skip_dir(name,fixture_mode)==1){a.*.skipped=a.*.skipped+1;}else{let child:[]u8=pu_join(path,name);pu_walk(child,a,fixture_mode,depth+1);_zag_str_free(child);}}
            else if(dtype==10){if(pu_source_symlink(name)==1){let child:[]u8=pu_join(path,name);pu_print_violation(a,"SOURCE_SYMLINK",child,0);_zag_str_free(child);a.*.files=a.*.files+1;}}
            else if(dtype==8){let kind:i32=pu_file_kind(name);if(kind==3){let child:[]u8=pu_join(path,name);pu_print_violation(a,"FOREIGN_SOURCE_FILE",child,0);_zag_str_free(child);a.*.files=a.*.files+1;}
                else if(kind==1 || kind==2){let child:[]u8=pu_join(path,name);let status:i32=0;let bytes:[]u8=pu_read_file(child,16777216,&status);a.*.files=a.*.files+1;
                    if(status!=0){a.*.errors=a.*.errors+1;pu_print_violation(a,"SOURCE_READ",child,0);}else{if(kind==1){pu_zag_scan(child,bytes,a);}else{pu_shell_scan(child,bytes,a);}pu_free(bytes);}_zag_str_free(child);}
                else{let child:[]u8=pu_join(path,name);let ps:i32=0;let prefix:[]u8=pu_read_prefix(child,256,&ps);
                    if(ps!=0){a.*.errors=a.*.errors+1;pu_print_violation(a,"PREFIX_READ",child,0);}
                    else if(prefix.len>=2 && prefix[0]==35 && prefix[1]==33){let she:i32=0;while(she<prefix.len && prefix[she]!=10){she=she+1;}
                        if(pu_runtime_word(prefix[0..she])==1){pu_print_violation(a,"FOREIGN_RUNTIME_SHEBANG",child,1);}
                        let status:i32=0;let bytes:[]u8=pu_read_file(child,16777216,&status);a.*.files=a.*.files+1;
                        if(status!=0){a.*.errors=a.*.errors+1;pu_print_violation(a,"SHEBANG_READ",child,0);}else{pu_shell_scan(child,bytes,a);pu_free(bytes);}}
                    pu_free(prefix);_zag_str_free(child);}}
            else if(pu_file_kind(name)!=0){let child:[]u8=pu_join(path,name);pu_print_violation(a,"NONREGULAR_SOURCE",child,0);_zag_str_free(child);a.*.files=a.*.files+1;}
            off=off+reclen;
        }
    }
    pu_free(entries);if(pu_close(fd)!=0){a.*.errors=a.*.errors+1;pu_print_violation(a,"DIRECTORY_CLOSE",path,0);}
}

fn pu_audit_tree(path:[]u8,fixture_mode:i32)PuAudit {let a:PuAudit=pu_zero();pu_walk(path,&a,fixture_mode,0);return a;}

fn pu_merge(dst:*PuAudit,src:PuAudit)void {
    dst.*.files=dst.*.files+src.files;dst.*.dirs=dst.*.dirs+src.dirs;dst.*.skipped=dst.*.skipped+src.skipped;
    dst.*.violations=dst.*.violations+src.violations;dst.*.errors=dst.*.errors+src.errors;
}

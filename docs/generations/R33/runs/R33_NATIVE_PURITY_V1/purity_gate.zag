@import("purity.zag")
@import("../R33_NATIVE_SHA256_V2.zag")

fn pg_compiler_sha256()[]u8 {return "3093d12dba9cc81b1dee69d2d4e604158d093b58f8f01ddab26c0f4297029956";}

fn pg_num(x:i64)void {let s:[]u8=_zag_i64_to_str(x);_zag_print(s);_zag_str_free(s);}
fn pg_compiler_pin()i32 {
    let status:i32=0;let bytes:[]u8=pu_read_pinned_file(pu_compiler_path(),16777216,&status);
    if(status!=0 || bytes.len<1){_zag_println("R33_PURITY_V1_COMPILER_PIN,REFUSED_READ");return 0;}
    let digest:[]u8=pu_alloc(32);if(digest.len!=32){pu_free(bytes);_zag_println("R33_PURITY_V1_COMPILER_PIN,REFUSED_ALLOC");return 0;}
    let rc:i32=ns_sha256(bytes,digest);pu_free(bytes);if(rc!=0){pu_free(digest);_zag_println("R33_PURITY_V1_COMPILER_PIN,REFUSED_HASH");return 0;}
    let hex:[]u8=ns_hex(digest);pu_free(digest);let ok:i32=pu_eq(hex,pg_compiler_sha256());
    _zag_print("R33_PURITY_V1_COMPILER_SHA256,");_zag_println(hex);nio_free(hex);
    if(ok!=1){_zag_println("R33_PURITY_V1_COMPILER_PIN,REFUSED_MISMATCH");return 0;}
    _zag_println("R33_PURITY_V1_COMPILER_PIN,PASS");return 1;
}
fn pg_root(repo:[]u8,relative:[]u8,a:*PuAudit)void {
    let p:[]u8=pu_join(repo,relative);let one:PuAudit=pu_audit_tree(p,0);pu_merge(a,one);_zag_str_free(p);
}

fn main()i32 {
    if(_zag_argc()!=2){_zag_println("R33_PURITY_V1_USAGE,<repo-root>");return 64;}
    if(pg_compiler_pin()!=1){return 2;}
    let repo:[]u8=_zag_arg(1);let a:PuAudit=pu_zero();
    pg_root(repo,"Research/R33_CONTINUING_LIFE_V1",&a);
    pg_root(repo,"Research/R33_NATIVE_N17_R27_CONTINUITY",&a);
    pg_root(repo,"Research/R33_NATIVE_N19_RUNTIME_BOUNDARY",&a);
    pg_root(repo,"Research/R33_NATIVE_PURITY_V1",&a);
    _zag_print("R33_PURITY_V1_FILES,");pg_num(a.files);_zag_println("");
    _zag_print("R33_PURITY_V1_DIRS,");pg_num(a.dirs);_zag_println("");
    _zag_print("R33_PURITY_V1_SKIPPED_DIRS,");pg_num(a.skipped);_zag_println("");
    _zag_print("R33_PURITY_V1_ERRORS,");pg_num(a.errors);_zag_println("");
    _zag_print("R33_PURITY_V1_VIOLATIONS,");pg_num(a.violations);_zag_println("");
    if(a.errors!=0 || a.violations!=0){_zag_println("R33_PURITY_V1_STATUS,REFUSED");return 1;}
    _zag_println("R33_PURITY_V1_STATUS,PASS_NATIVE_ONLY");return 0;
}

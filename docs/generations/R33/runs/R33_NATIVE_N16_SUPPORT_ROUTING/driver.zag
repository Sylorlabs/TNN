// R33-N16 support-coverage / routing-locality stability-plasticity diagnostic.
// Native Zag only. Synthetic parent; no canonical R27 load, mutation or emulation.
// Probe outcomes and gate-hit evaluator metrics never participate in training/update acceptance.

const N16_F:i32=16;
const N16_OLD_TRAIN:i32=256;
const N16_OLD_SUPPORT:i32=256;
const N16_NEW_TRAIN:i32=256;
const N16_PROBE:i32=512;
const N16_PARENT_EPOCHS:i32=12;
const N16_NEW_EPOCHS:i32=6;
const N16_ARMS:i32=21;
const N16_DEV_POPS:i32=10;
const N16_HOLDOUT_POPS:i32=16;

struct N16TrainStats { proposals:i32,accepted:i32,rejected:i32,skipped:i32,anchor_loss:i32,anchor_checks:i32 }
struct N16Eval { parent_correct:i32,final_correct:i32,lost:i32,rescued:i32,gate_hits:i32 }
struct N16Outcome {
    old_parent:i32,old_final:i32,old_lost:i32,old_rescued:i32,old_gate_hits:i32,
    new_parent:i32,new_final:i32,new_gain:i32,new_gate_hits:i32,
    proposals:i32,accepted:i32,rejected:i32,skipped:i32,anchor_loss:i32,anchor_checks:i32
}

fn n16_mod(v:i32,m:i32)i32 { let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r; }
fn n16_abs(v:i32)i32 {if(v<0){return 0-v;}return v;}
fn n16_clamp(v:i32,lo:i32,hi:i32)i32 {if(v<lo){return lo;}if(v>hi){return hi;}return v;}
fn n16_hash(seed:i32,a:i32,b:i32)i32 {let x:i32=n16_mod(seed*997+a*7919+b*104729+17,1000003);return n16_mod(x*613+1013,1000003);}
fn n16_zero(a:[]i32)void {let i:i32=0;while(i<a.len){a[i]=0;i=i+1;}}
fn n16_copy(a:[]i32,b:[]i32)void {let i:i32=0;while(i<a.len && i<b.len){b[i]=a[i];i=i+1;}}
fn n16_fill(seed:i32,index:i32,kind:i32,x:[]i32)void {
    let j:i32=0;while(j<N16_F){let v:i32=n16_mod(n16_hash(seed,index,j),2001)-1000;if(kind==1 && j>=8 && j<12){v=n16_clamp(v+550,-1000,1000);}x[j]=v;j=j+1;}
}
fn n16_old_target(x:[]i32)i32 {let s:i32=5*x[0]-4*x[1]+3*x[2]+2*x[3]-3*x[4]+4*x[5]-2*x[6]+x[7]+180;if(s>=0){return 1;}return -1;}
fn n16_new_target(x:[]i32)i32 {let region:i32=x[8]+x[9]+x[10]+x[11];if(region<=700){return n16_old_target(x);}let s:i32=-3*x[0]+2*x[1]+4*x[4]-5*x[5]+3*x[8]-2*x[9]+4*x[10]-3*x[11]-120;if(s>=0){return 1;}return -1;}
fn n16_target(kind:i32,x:[]i32)i32 {if(kind==1){return n16_new_target(x);}return n16_old_target(x);}
fn n16_score(w:[]i32,bias:i32,x:[]i32)i64 {let s:i64=bias as i64;let j:i32=0;while(j<N16_F){s=s+(w[j] as i64)*(x[j] as i64);j=j+1;}return s;}
fn n16_choice_score(s:i64)i32 {if(s>=0){return 1;}return -1;}
fn n16_choice(w:[]i32,bias:i32,x:[]i32)i32 {return n16_choice_score(n16_score(w,bias,x));}
fn n16_update(w:[]i32,bias:*i32,x:[]i32,y:i32,divisor:i32)void {let j:i32=0;while(j<N16_F){w[j]=w[j]+y*x[j]/divisor;j=j+1;}bias.*=bias.*+y*16;}
fn n16_train_parent(seed:i32,w:[]i32,bias:*i32)i32 {
    n16_zero(w);bias.*=0;let x:[]i32=zalloc_i(N16_F);let updates:i32=0;let epoch:i32=0;
    while(epoch<N16_PARENT_EPOCHS){let i:i32=0;while(i<N16_OLD_TRAIN){n16_fill(seed,i,0,x);let y:i32=n16_old_target(x);if(n16_choice(w,bias.*,x)!=y){n16_update(w,bias,x,y,32);updates=updates+1;}i=i+1;}epoch=epoch+1;}zfree(x);return updates;
}

fn n16_clusters(arm:i32)i32 {if(arm>=8 && arm<=15){return 8;}return 1;}
fn n16_group(x:[]i32,k:i32)i32 {
    if(k==1){return 0;}let g:i32=0;if(x[8]>=0){g=g+1;}if(x[9]>=0){g=g+2;}if(x[10]>=0){g=g+4;}return g;
}
fn n16_bin(v:i32)i32 {if(v< -500){return 0;}if(v<0){return 1;}if(v<500){return 2;}return 3;}
fn n16_cell(x:[]i32)i32 {return n16_bin(x[8])+4*n16_bin(x[9])+16*n16_bin(x[10])+64*n16_bin(x[11]);}
fn n16_build_protos(old_seed:i32,support_seed:i32,new_seed:i32,k:i32,arm:i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32)void {
    n16_zero(oldp);n16_zero(newp);n16_zero(oldc);n16_zero(newc);let x:[]i32=zalloc_i(N16_F);let i:i32=0;
    while(i<N16_OLD_TRAIN){n16_fill(old_seed,i,0,x);let g:i32=n16_group(x,k);oldc[g]=oldc[g]+1;oldp[32+n16_cell(x)]=oldp[32+n16_cell(x)]+1;let j:i32=0;while(j<4){oldp[g*4+j]=oldp[g*4+j]+x[8+j];j=j+1;}i=i+1;}
    if(arm>=14){i=0;while(i<N16_OLD_SUPPORT){n16_fill(support_seed,i,0,x);oldp[32+n16_cell(x)]=oldp[32+n16_cell(x)]+1;i=i+1;}}
    i=0;while(i<N16_NEW_TRAIN){n16_fill(new_seed,i,1,x);let g:i32=n16_group(x,k);newc[g]=newc[g]+1;newp[32+n16_cell(x)]=newp[32+n16_cell(x)]+1;let j:i32=0;while(j<4){newp[g*4+j]=newp[g*4+j]+x[8+j];j=j+1;}i=i+1;}
    let g:i32=0;while(g<k){let j:i32=0;while(j<4){if(oldc[g]>0){oldp[g*4+j]=oldp[g*4+j]/oldc[g];}if(newc[g]>0){newp[g*4+j]=newp[g*4+j]/newc[g];}j=j+1;}g=g+1;}zfree(x);
}
fn n16_gate(x:[]i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32,arm:i32)i32 {
    if(arm>=16){let proj:i64=0;let sep:i64=0;let j:i32=0;while(j<4){let d:i64=(newp[j]-oldp[j]) as i64;proj=proj+d*((x[8+j]-oldp[j]) as i64);sep=sep+d*d;j=j+1;}if(sep<=0){return 0;}if(arm==16){if(proj*2>sep){return 1;}return 0;}if(arm==20){if(proj*20>sep*17){return 1;}return 0;}if(proj*4>sep*3){return 1;}return 0;}
    let k:i32=n16_clusters(arm);let old_d:i32=2147480000;let new_d:i32=2147480000;let g:i32=0;
    while(g<k){if(oldc[g]>0){let d:i32=0;let j:i32=0;while(j<4){d=d+n16_abs(x[8+j]-oldp[g*4+j]);j=j+1;}if(d<old_d){old_d=d;}}if(newc[g]>0){let d:i32=0;let j:i32=0;while(j<4){d=d+n16_abs(x[8+j]-newp[g*4+j]);j=j+1;}if(d<new_d){new_d=d;}}g=g+1;}
    if(arm>=13){let c:i32=n16_cell(x);let oc:i32=oldp[32+c];let nc:i32=newp[32+c];if(nc<=0){return 0;}if(arm==13){if(nc<=oc+1){return 0;}}else{if(nc*2<=oc+2){return 0;}}}
    let radius:i32=2200;let margin:i32=100;if(k==8){margin=140;}
    if(new_d<=radius && new_d+margin<old_d){return 1;}return 0;
}
fn n16_is_additive(arm:i32)i32 {if(arm>=3){return 1;}return 0;}
fn n16_is_preserve(arm:i32)i32 {if(arm==2){return 1;}if(arm>=4 && arm<=7){return 1;}if(arm>=9 && arm<=12){return 1;}if(arm==15 || arm==18 || arm==19){return 1;}return 0;}
fn n16_tolerance(arm:i32)i32 {if(arm==7 || arm==19){return 1;}if(arm==12){return 2;}return 0;}
fn n16_anchor_checks(arm:i32)i32 {if(arm==4 || arm==9 || arm==15 || arm==18){return 96;}if(arm==5 || arm==10){return 256;}if(arm==2 || arm==6 || arm==7 || arm==11 || arm==12 || arm==19){return 512;}return 0;}

fn n16_predict(parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32,arm:i32,x:[]i32)i32 {
    if(n16_is_additive(arm)==1){let s:i64=n16_score(parent_w,parent_b,x);if(n16_gate(x,oldp,newp,oldc,newc,arm)==1){s=s+n16_score(spec_w,spec_b,x);}return n16_choice_score(s);}return n16_choice(work_w,work_b,x);
}
fn n16_anchor_set_loss(seed:i32,count:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32,arm:i32)i32 {
    let loss:i32=0;let x:[]i32=zalloc_i(N16_F);let i:i32=0;while(i<count){n16_fill(seed,i,0,x);let y:i32=n16_old_target(x);let pc:i32=n16_choice(parent_w,parent_b,x);if(pc==y && n16_predict(parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm,x)!=y){loss=loss+1;}i=i+1;}zfree(x);return loss;
}
fn n16_anchor_loss(arm:i32,old_seed:i32,support_seed:i32,new_seed:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32)i32 {
    if(arm==4 || arm==9 || arm==15 || arm==18){return n16_anchor_set_loss(new_seed,96,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm);}
    if(arm==5 || arm==10){return n16_anchor_set_loss(old_seed,256,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm);}
    if(arm==2 || arm==6 || arm==7 || arm==11 || arm==12 || arm==19){return n16_anchor_set_loss(old_seed,256,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm)+n16_anchor_set_loss(support_seed,256,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm);}
    return 0;
}

fn n16_train_new(new_seed:i32,old_seed:i32,support_seed:i32,arm:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:*i32,spec_w:[]i32,spec_b:*i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32)N16TrainStats {
    let st:N16TrainStats=N16TrainStats{.proposals=0,.accepted=0,.rejected=0,.skipped=0,.anchor_loss=0,.anchor_checks=n16_anchor_checks(arm)};let x:[]i32=zalloc_i(N16_F);let cw:[]i32=zalloc_i(N16_F);let cs:[]i32=zalloc_i(N16_F);let epoch:i32=0;
    while(epoch<N16_NEW_EPOCHS){let i:i32=0;while(i<N16_NEW_TRAIN){n16_fill(new_seed,i,1,x);let y:i32=n16_new_target(x);if(arm==0){st.skipped=st.skipped+1;i=i+1;continue;}let current:i32=n16_predict(parent_w,parent_b,work_w,work_b.*,spec_w,spec_b.*,oldp,newp,oldc,newc,arm,x);if(current==y){st.skipped=st.skipped+1;i=i+1;continue;}
        st.proposals=st.proposals+1;n16_copy(work_w,cw);n16_copy(spec_w,cs);let cb:i32=work_b.*;let sb:i32=spec_b.*;
        if(n16_is_additive(arm)==1){if(n16_gate(x,oldp,newp,oldc,newc,arm)==0){st.rejected=st.rejected+1;i=i+1;continue;}n16_update(cs,&sb,x,y,40);}else{n16_update(cw,&cb,x,y,40);}
        let before_margin:i64=(y as i64)*n16_score(work_w,work_b.*,x);if(n16_is_additive(arm)==1){before_margin=(y as i64)*(n16_score(parent_w,parent_b,x)+n16_score(spec_w,spec_b.*,x));}
        let after_margin:i64=(y as i64)*n16_score(cw,cb,x);if(n16_is_additive(arm)==1){after_margin=(y as i64)*(n16_score(parent_w,parent_b,x)+n16_score(cs,sb,x));}
        let accept:i32=1;if(after_margin<=before_margin){accept=0;}if(accept==1 && n16_is_preserve(arm)==1){let al:i32=n16_anchor_loss(arm,old_seed,support_seed,new_seed,parent_w,parent_b,cw,cb,cs,sb,oldp,newp,oldc,newc);if(al>n16_tolerance(arm)){accept=0;}}
        if(accept==1){if(n16_is_additive(arm)==1){n16_copy(cs,spec_w);spec_b.*=sb;}else{n16_copy(cw,work_w);work_b.*=cb;}st.accepted=st.accepted+1;}else{st.rejected=st.rejected+1;}i=i+1;
    }epoch=epoch+1;}
    st.anchor_loss=n16_anchor_loss(arm,old_seed,support_seed,new_seed,parent_w,parent_b,work_w,work_b.*,spec_w,spec_b.*,oldp,newp,oldc,newc);zfree(x);zfree(cw);zfree(cs);return st;
}
fn n16_eval(seed:i32,kind:i32,parent_w:[]i32,parent_b:i32,work_w:[]i32,work_b:i32,spec_w:[]i32,spec_b:i32,oldp:[]i32,newp:[]i32,oldc:[]i32,newc:[]i32,arm:i32)N16Eval {
    let e:N16Eval=N16Eval{.parent_correct=0,.final_correct=0,.lost=0,.rescued=0,.gate_hits=0};let x:[]i32=zalloc_i(N16_F);let i:i32=0;while(i<N16_PROBE){n16_fill(seed,i,kind,x);let y:i32=n16_target(kind,x);let pc:i32=n16_choice(parent_w,parent_b,x);if(n16_is_additive(arm)==1 && n16_gate(x,oldp,newp,oldc,newc,arm)==1){e.gate_hits=e.gate_hits+1;}let fc:i32=n16_predict(parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm,x);if(pc==y){e.parent_correct=e.parent_correct+1;}if(fc==y){e.final_correct=e.final_correct+1;}if(pc==y && fc!=y){e.lost=e.lost+1;}if(pc!=y && fc==y){e.rescued=e.rescued+1;}i=i+1;}zfree(x);return e;
}

fn n16_print_i(v:i32)void {_zag_print(_zag_i64_to_str(v as i64));}
fn n16_emit(prefix:[]u8,pop:i32,arm:i32,parent_updates:i32,old:N16Eval,newv:N16Eval,st:N16TrainStats)void {
    _zag_print(prefix);_zag_print(",");n16_print_i(pop);_zag_print(",");n16_print_i(arm);_zag_print(",");n16_print_i(parent_updates);_zag_print(",");n16_print_i(old.parent_correct);_zag_print(",");n16_print_i(old.final_correct);_zag_print(",");n16_print_i(old.lost);_zag_print(",");n16_print_i(old.rescued);_zag_print(",");n16_print_i(old.gate_hits);_zag_print(",");n16_print_i(newv.parent_correct);_zag_print(",");n16_print_i(newv.final_correct);_zag_print(",");n16_print_i(newv.final_correct-newv.parent_correct);_zag_print(",");n16_print_i(newv.gate_hits);_zag_print(",");n16_print_i(st.proposals);_zag_print(",");n16_print_i(st.accepted);_zag_print(",");n16_print_i(st.rejected);_zag_print(",");n16_print_i(st.skipped);_zag_print(",");n16_print_i(st.anchor_loss);_zag_print(",");n16_print_i(st.anchor_checks);_zag_println("");
}
fn n16_run_one(base_seed:i32,pop:i32,arm:i32,prefix:[]u8)N16Outcome {
    let old_seed:i32=base_seed+pop*997+11;let new_seed:i32=base_seed+pop*997+101;let support_seed:i32=base_seed+pop*997+211;let old_probe_seed:i32=base_seed+pop*997+401;let new_probe_seed:i32=base_seed+pop*997+701;
    let parent_w:[]i32=zalloc_i(N16_F);let work_w:[]i32=zalloc_i(N16_F);let spec_w:[]i32=zalloc_i(N16_F);let oldp:[]i32=zalloc_i(288);let newp:[]i32=zalloc_i(288);let oldc:[]i32=zalloc_i(8);let newc:[]i32=zalloc_i(8);let parent_b:i32=0;
    let parent_updates:i32=n16_train_parent(old_seed,parent_w,&parent_b);n16_copy(parent_w,work_w);n16_zero(spec_w);let work_b:i32=parent_b;let spec_b:i32=0;n16_build_protos(old_seed,support_seed,new_seed,n16_clusters(arm),arm,oldp,newp,oldc,newc);
    let st:N16TrainStats=n16_train_new(new_seed,old_seed,support_seed,arm,parent_w,parent_b,work_w,&work_b,spec_w,&spec_b,oldp,newp,oldc,newc);let old:N16Eval=n16_eval(old_probe_seed,0,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm);let newv:N16Eval=n16_eval(new_probe_seed,1,parent_w,parent_b,work_w,work_b,spec_w,spec_b,oldp,newp,oldc,newc,arm);n16_emit(prefix,pop,arm,parent_updates,old,newv,st);
    let out:N16Outcome=N16Outcome{.old_parent=old.parent_correct,.old_final=old.final_correct,.old_lost=old.lost,.old_rescued=old.rescued,.old_gate_hits=old.gate_hits,.new_parent=newv.parent_correct,.new_final=newv.final_correct,.new_gain=newv.final_correct-newv.parent_correct,.new_gate_hits=newv.gate_hits,.proposals=st.proposals,.accepted=st.accepted,.rejected=st.rejected,.skipped=st.skipped,.anchor_loss=st.anchor_loss,.anchor_checks=st.anchor_checks};zfree(parent_w);zfree(work_w);zfree(spec_w);zfree(oldp);zfree(newp);zfree(oldc);zfree(newc);return out;
}

fn n16_accum(o:N16Outcome,arm:i32,total_loss:[]i32,total_rescued:[]i32,total_gain:[]i32,min_gain:[]i32,max_deficit:[]i32,max_loss:[]i32,total_old_gate:[]i32,total_new_gate:[]i32,total_proposals:[]i32,total_accepted:[]i32,total_rejected:[]i32,total_skipped:[]i32,total_anchor_loss:[]i32,seen:[]i32)void {
    total_loss[arm]=total_loss[arm]+o.old_lost;total_rescued[arm]=total_rescued[arm]+o.old_rescued;total_gain[arm]=total_gain[arm]+o.new_gain;if(seen[arm]==0 || o.new_gain<min_gain[arm]){min_gain[arm]=o.new_gain;}let deficit:i32=o.old_parent-o.old_final;if(deficit>max_deficit[arm]){max_deficit[arm]=deficit;}if(o.old_lost>max_loss[arm]){max_loss[arm]=o.old_lost;}total_old_gate[arm]=total_old_gate[arm]+o.old_gate_hits;total_new_gate[arm]=total_new_gate[arm]+o.new_gate_hits;total_proposals[arm]=total_proposals[arm]+o.proposals;total_accepted[arm]=total_accepted[arm]+o.accepted;total_rejected[arm]=total_rejected[arm]+o.rejected;total_skipped[arm]=total_skipped[arm]+o.skipped;total_anchor_loss[arm]=total_anchor_loss[arm]+o.anchor_loss;seen[arm]=seen[arm]+1;
}
fn n16_holdout_gate(selected:i32,upstream:i32,total_loss:[]i32,total_gain:[]i32,min_gain:[]i32,max_deficit:[]i32,max_loss:[]i32)i32 {
    if(upstream!=1){return 0;}if(min_gain[selected]<=0){return 0;}if(max_deficit[selected]>4){return 0;}if(max_loss[selected]>6){return 0;}if(total_loss[selected]>48){return 0;}if(total_gain[selected]<1600){return 0;}
    if(total_gain[selected]*100<total_gain[1]*35){return 0;}if(total_loss[selected]*50>total_loss[1]){return 0;}if(total_gain[selected]*100<total_gain[4]*80){return 0;}if(total_loss[selected]*2>total_loss[4]){return 0;}
    if(selected>=9 && selected<=12){if(total_gain[selected]*100<total_gain[6]*80){return 0;}if(total_loss[selected]>total_loss[6]){return 0;}if(total_gain[selected]*100<total_gain[8]*40){return 0;}if(total_loss[selected]*4>total_loss[8]){return 0;}}
    if(selected==15){if(total_gain[selected]*100<total_gain[14]*40){return 0;}if(total_loss[selected]*4>total_loss[14]){return 0;}}
    if(selected==18 || selected==19){if(total_gain[selected]*100<total_gain[17]*40){return 0;}if(total_loss[selected]*4>total_loss[17]){return 0;}}return 1;
}
fn n16_run_dev()i32 {
    _zag_println("N16_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,old_gate_hits,parent_new,final_new,new_gain,new_gate_hits,proposals,accepted,rejected,skipped,anchor_loss,anchor_checks");
    let total_loss:[]i32=zalloc_i(N16_ARMS);let total_gain:[]i32=zalloc_i(N16_ARMS);let min_gain:[]i32=zalloc_i(N16_ARMS);let max_deficit:[]i32=zalloc_i(N16_ARMS);let max_loss:[]i32=zalloc_i(N16_ARMS);let old_gate:[]i32=zalloc_i(N16_ARMS);let new_gate:[]i32=zalloc_i(N16_ARMS);n16_zero(total_loss);n16_zero(total_gain);n16_zero(max_deficit);n16_zero(max_loss);n16_zero(old_gate);n16_zero(new_gate);let arm:i32=0;while(arm<N16_ARMS){min_gain[arm]=1000000;arm=arm+1;}
    let pop:i32=0;while(pop<N16_DEV_POPS){arm=0;while(arm<N16_ARMS){let o:N16Outcome=n16_run_one(910000,pop,arm,"N16_DEV");total_loss[arm]=total_loss[arm]+o.old_lost;total_gain[arm]=total_gain[arm]+o.new_gain;if(o.new_gain<min_gain[arm]){min_gain[arm]=o.new_gain;}let d:i32=o.old_parent-o.old_final;if(d>max_deficit[arm]){max_deficit[arm]=d;}if(o.old_lost>max_loss[arm]){max_loss[arm]=o.old_lost;}old_gate[arm]=old_gate[arm]+o.old_gate_hits;new_gate[arm]=new_gate[arm]+o.new_gate_hits;arm=arm+1;}pop=pop+1;}
    let selected:i32=-1;let gate:i32=0;let best_loss:i32=2147480000;let best_min:i32=-2147480000;let best_gain:i32=-2147480000;arm=1;
    while(arm<N16_ARMS){let eligible:i32=0;if(min_gain[arm]>0 && max_deficit[arm]<=4 && max_loss[arm]<=6 && total_loss[arm]<=40 && total_gain[arm]>=800){eligible=1;}
        _zag_print("N16_DEV_ARM,");n16_print_i(arm);_zag_print(",");n16_print_i(total_loss[arm]);_zag_print(",");n16_print_i(total_gain[arm]);_zag_print(",");n16_print_i(min_gain[arm]);_zag_print(",");n16_print_i(max_deficit[arm]);_zag_print(",");n16_print_i(max_loss[arm]);_zag_print(",");n16_print_i(old_gate[arm]);_zag_print(",");n16_print_i(new_gate[arm]);_zag_print(",");n16_print_i(eligible);_zag_println("");
        if(eligible==1){if(selected<0 || total_loss[arm]<best_loss || (total_loss[arm]==best_loss && min_gain[arm]>best_min) || (total_loss[arm]==best_loss && min_gain[arm]==best_min && total_gain[arm]>best_gain)){selected=arm;best_loss=total_loss[arm];best_min=min_gain[arm];best_gain=total_gain[arm];gate=1;}}arm=arm+1;}
    if(selected<0){arm=1;best_loss=2147480000;while(arm<N16_ARMS){if(total_gain[arm]>0 && (selected<0 || total_loss[arm]<best_loss)){selected=arm;best_loss=total_loss[arm];}arm=arm+1;}}
    _zag_print("N16_DEV_SELECTION,");n16_print_i(selected);_zag_print(",");n16_print_i(gate);_zag_println("");zfree(total_loss);zfree(total_gain);zfree(min_gain);zfree(max_deficit);zfree(max_loss);zfree(old_gate);zfree(new_gate);_zag_println("R33_N16_DEV_COMPLETE");return 0;
}
fn n16_run_smoke()i32 {
    _zag_println("N16_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,old_gate_hits,parent_new,final_new,new_gain,new_gate_hits,proposals,accepted,rejected,skipped,anchor_loss,anchor_checks");let arm:i32=0;while(arm<N16_ARMS){let ignored:N16Outcome=n16_run_one(810000,0,arm,"N16_SMOKE");arm=arm+1;}_zag_println("R33_N16_SMOKE_COMPLETE");return 0;
}
fn n16_parse_arm(a:[]u8)i32 {if(_zag_strcmp(a,"0")==1){return 0;}if(_zag_strcmp(a,"1")==1){return 1;}if(_zag_strcmp(a,"2")==1){return 2;}if(_zag_strcmp(a,"3")==1){return 3;}if(_zag_strcmp(a,"4")==1){return 4;}if(_zag_strcmp(a,"5")==1){return 5;}if(_zag_strcmp(a,"6")==1){return 6;}if(_zag_strcmp(a,"7")==1){return 7;}if(_zag_strcmp(a,"8")==1){return 8;}if(_zag_strcmp(a,"9")==1){return 9;}if(_zag_strcmp(a,"10")==1){return 10;}if(_zag_strcmp(a,"11")==1){return 11;}if(_zag_strcmp(a,"12")==1){return 12;}if(_zag_strcmp(a,"13")==1){return 13;}if(_zag_strcmp(a,"14")==1){return 14;}if(_zag_strcmp(a,"15")==1){return 15;}if(_zag_strcmp(a,"16")==1){return 16;}if(_zag_strcmp(a,"17")==1){return 17;}if(_zag_strcmp(a,"18")==1){return 18;}if(_zag_strcmp(a,"19")==1){return 19;}if(_zag_strcmp(a,"20")==1){return 20;}return -1;}
fn n16_parse_bit(a:[]u8)i32 {if(_zag_strcmp(a,"0")==1){return 0;}if(_zag_strcmp(a,"1")==1){return 1;}return -1;}
fn n16_holdout(base_seed:i32,selected:i32,upstream:i32,prefix:[]u8,marker:[]u8)i32 {
    if(selected<1 || selected>=N16_ARMS || upstream<0 || upstream>1){return 2;}_zag_println("N16_COLUMNS,pop,arm,parent_updates,parent_old,final_old,old_lost,old_rescued,old_gate_hits,parent_new,final_new,new_gain,new_gate_hits,proposals,accepted,rejected,skipped,anchor_loss,anchor_checks");
    let total_loss:[]i32=zalloc_i(N16_ARMS);let total_rescued:[]i32=zalloc_i(N16_ARMS);let total_gain:[]i32=zalloc_i(N16_ARMS);let min_gain:[]i32=zalloc_i(N16_ARMS);let max_deficit:[]i32=zalloc_i(N16_ARMS);let max_loss:[]i32=zalloc_i(N16_ARMS);let total_old_gate:[]i32=zalloc_i(N16_ARMS);let total_new_gate:[]i32=zalloc_i(N16_ARMS);let total_proposals:[]i32=zalloc_i(N16_ARMS);let total_accepted:[]i32=zalloc_i(N16_ARMS);let total_rejected:[]i32=zalloc_i(N16_ARMS);let total_skipped:[]i32=zalloc_i(N16_ARMS);let total_anchor_loss:[]i32=zalloc_i(N16_ARMS);let seen:[]i32=zalloc_i(N16_ARMS);
    n16_zero(total_loss);n16_zero(total_rescued);n16_zero(total_gain);n16_zero(max_deficit);n16_zero(max_loss);n16_zero(total_old_gate);n16_zero(total_new_gate);n16_zero(total_proposals);n16_zero(total_accepted);n16_zero(total_rejected);n16_zero(total_skipped);n16_zero(total_anchor_loss);n16_zero(seen);let arm:i32=0;while(arm<N16_ARMS){min_gain[arm]=1000000;arm=arm+1;}
    let pop:i32=0;while(pop<N16_HOLDOUT_POPS){let c0:N16Outcome=n16_run_one(base_seed,pop,0,prefix);n16_accum(c0,0,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c1:N16Outcome=n16_run_one(base_seed,pop,1,prefix);n16_accum(c1,1,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c3:N16Outcome=n16_run_one(base_seed,pop,3,prefix);n16_accum(c3,3,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c4:N16Outcome=n16_run_one(base_seed,pop,4,prefix);n16_accum(c4,4,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c6:N16Outcome=n16_run_one(base_seed,pop,6,prefix);n16_accum(c6,6,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c8:N16Outcome=n16_run_one(base_seed,pop,8,prefix);n16_accum(c8,8,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c14:N16Outcome=n16_run_one(base_seed,pop,14,prefix);n16_accum(c14,14,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);let c17:N16Outcome=n16_run_one(base_seed,pop,17,prefix);n16_accum(c17,17,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);if(selected!=1 && selected!=3 && selected!=4 && selected!=6 && selected!=8 && selected!=14 && selected!=17){let cs:N16Outcome=n16_run_one(base_seed,pop,selected,prefix);n16_accum(cs,selected,total_loss,total_rescued,total_gain,min_gain,max_deficit,max_loss,total_old_gate,total_new_gate,total_proposals,total_accepted,total_rejected,total_skipped,total_anchor_loss,seen);}pop=pop+1;}
    arm=0;while(arm<N16_ARMS){if(seen[arm]>0){_zag_print("N16_HOLDOUT_ARM,");_zag_print(prefix);_zag_print(",");n16_print_i(arm);_zag_print(",");n16_print_i(total_loss[arm]);_zag_print(",");n16_print_i(total_rescued[arm]);_zag_print(",");n16_print_i(total_gain[arm]);_zag_print(",");n16_print_i(min_gain[arm]);_zag_print(",");n16_print_i(max_deficit[arm]);_zag_print(",");n16_print_i(max_loss[arm]);_zag_print(",");n16_print_i(total_old_gate[arm]);_zag_print(",");n16_print_i(total_new_gate[arm]);_zag_print(",");n16_print_i(total_proposals[arm]);_zag_print(",");n16_print_i(total_accepted[arm]);_zag_print(",");n16_print_i(total_rejected[arm]);_zag_print(",");n16_print_i(total_skipped[arm]);_zag_print(",");n16_print_i(total_anchor_loss[arm]);_zag_print(",");n16_print_i(seen[arm]);_zag_println("");}arm=arm+1;}
    let gate:i32=n16_holdout_gate(selected,upstream,total_loss,total_gain,min_gain,max_deficit,max_loss);_zag_print("N16_HOLDOUT_GATE,");_zag_print(prefix);_zag_print(",");n16_print_i(selected);_zag_print(",");n16_print_i(upstream);_zag_print(",");n16_print_i(gate);_zag_println("");zfree(total_loss);zfree(total_rescued);zfree(total_gain);zfree(min_gain);zfree(max_deficit);zfree(max_loss);zfree(total_old_gate);zfree(total_new_gate);zfree(total_proposals);zfree(total_accepted);zfree(total_rejected);zfree(total_skipped);zfree(total_anchor_loss);zfree(seen);_zag_println(marker);return 0;
}
fn main()i32 {
    if(_zag_argc()<2){return 2;}let mode:[]u8=_zag_arg(1);if(_zag_strcmp(mode,"smoke")==1){return n16_run_smoke();}if(_zag_strcmp(mode,"dev")==1){return n16_run_dev();}
    if((_zag_strcmp(mode,"validate")==1 || _zag_strcmp(mode,"confirm")==1) && _zag_argc()==4){let arm:i32=n16_parse_arm(_zag_arg(2));let upstream:i32=n16_parse_bit(_zag_arg(3));if(_zag_strcmp(mode,"validate")==1){return n16_holdout(1010000,arm,upstream,"N16_VAL","R33_N16_VALIDATION_COMPLETE");}return n16_holdout(1110000,arm,upstream,"N16_CONF","R33_N16_CONFIRMATION_COMPLETE");}return 2;
}

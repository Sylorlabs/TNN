// Native Zag probe for a 245,536-byte checkpoint section.
@import("checkpoint.zag")

fn main()i32 {
    let out:[]u8=nio_alloc(300000);let learner:[]u8=nio_alloc(245536);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=300000 || learner.len!=245536 || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("R27_OUTER_TRANSPORT_SHAPE_FIXTURE_V69",parent);
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at:i32=CL_CHECKPOINT_HEADER;
    if(rc==0){rc=cl_checkpoint_section(out,&at,1,learner);}
    _zag_print("CL_V69_LARGE_SECTION_RC,");cl_number(rc as i64);_zag_println("");
    _zag_print("CL_V69_LARGE_SECTION_AT,");cl_number(at as i64);_zag_println("");
    let ok:i32=(rc==0 && at==245656) as i32;
    nio_free(out);nio_free(learner);nio_free(parent);nio_free(previous);
    return (ok!=1) as i32;
}

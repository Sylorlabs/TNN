// Minimal native Zag probe for address-of on a scalar local declared after
// slice locals. This is a toolchain qualification fixture, not learner logic.
@import("common.zag")

fn clv69_increment(at:*i32)i32 @noalloc {
    if(at==null as *i32){return cl_bad();}
    at.*=at.*+1;
    return 0;
}

fn main()i32 {
    let a:[]u8=nio_alloc(1);let b:[]u8=nio_alloc(2);let c:[]u8=nio_alloc(3);let d:[]u8=nio_alloc(4);
    let at:i32=112;
    let rc:i32=clv69_increment(&at);
    _zag_print("CL_V69_LOCAL_ADDRESS_RC,");cl_number(rc as i64);_zag_print(",");cl_number(at as i64);_zag_println("");
    nio_free(a);nio_free(b);nio_free(c);nio_free(d);
    if(rc!=0 || at!=113){return 1;}return 0;
}

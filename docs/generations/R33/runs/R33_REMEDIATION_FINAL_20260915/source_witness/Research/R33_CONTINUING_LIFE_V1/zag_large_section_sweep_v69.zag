// Native Zag size sweep for checkpoint section pointer/update integrity.
@import("checkpoint.zag")

fn clv69_probe_size(n:i32)i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(n);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=300000 || payload.len!=n || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("R27_SECTION_SIZE_SWEEP_V69",parent);
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at:i32=CL_CHECKPOINT_HEADER;
    if(rc==0){rc=cl_checkpoint_section(out,&at,1,payload);}
    _zag_print("CL_V69_SECTION_SWEEP,");cl_number(n as i64);_zag_print(",");cl_number(rc as i64);_zag_print(",");cl_number(at as i64);_zag_println("");
    let ok:i32=(rc==0 && at==CL_CHECKPOINT_HEADER+8+n) as i32;
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);
    return (ok!=1) as i32;
}

fn main()i32 {
    let failures:i32=0;
    failures=failures+clv69_probe_size(1);
    failures=failures+clv69_probe_size(1024);
    failures=failures+clv69_probe_size(16384);
    failures=failures+clv69_probe_size(32768);
    failures=failures+clv69_probe_size(65535);
    failures=failures+clv69_probe_size(65536);
    failures=failures+clv69_probe_size(131072);
    failures=failures+clv69_probe_size(200000);
    failures=failures+clv69_probe_size(245536);
    _zag_print("CL_V69_SECTION_SWEEP_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

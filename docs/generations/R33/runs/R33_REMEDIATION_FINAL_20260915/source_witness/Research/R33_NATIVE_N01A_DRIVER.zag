// R33-N01A corrective native engineering fixture. Compile now; execute only after
// independent main-agent preregistration. No learner, scientific data, Python or grants.
@import("R33_NATIVE_PROCESS_V2.zag")

const N01A_ROOT:[]u8="Research/R33_NATIVE_N01A_RUN_PRIMARY_V1";
const N01A_FS:[]u8="Research/R33_NATIVE_N01A_RUN_PRIMARY_V1/fs";

fn n01a_assert(name:[]u8,actual:i64,expected:i64,failed:*i32)void {
    failed.*=failed.*+nio_metric(name,actual,expected);
}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}
    let mode:[]u8=_zag_arg(1);

    // Deliberately unguarded child: only parent V2 may enforce this wall deadline.
    if(_zag_strcmp(mode,"unguarded")==1){
        let x:i64=0;while(true){x=x+1;if(x>1000000){x=0;}}return 91;
    }
    if(_zag_strcmp(mode,"normal")==1){return 0;}
    if(_zag_strcmp(mode,"flood")==1){
        let i:i32=0;while(i<4096){_zag_print("0123456789abcdef");i=i+1;}return 92;
    }
    if(_zag_strcmp(mode,"supervise")!=1){return 2;}
    // Guard installation is fail-fatal, not a reversible transaction.
    if(nio_guard(20)!=0){return 3;}

    let failed:i32=0;
    // Whole N01A run directory is the declared write scope, including supervisor outputs.
    let admitted:NativeAdmissionV2=nrv2_admit_root(N01A_ROOT);
    n01a_assert("primary_admission_status",admitted.status,0,&failed);
    n01a_assert("primary_admission_created",admitted.created as i64,1,&failed);
    n01a_assert("primary_admission_partial",admitted.partial as i64,0,&failed);
    n01a_assert("primary_root_open",(admitted.root>=0) as i64,1,&failed);
    if(admitted.root<0){return 10;}
    let root:i64=admitted.root;

    // A second admission is an exact EEXIST refusal. No retry/open of that attempt.
    let existing:NativeAdmissionV2=nrv2_admit_root(N01A_ROOT);
    n01a_assert("existing_primary_refusal",existing.status,-17,&failed);
    n01a_assert("existing_primary_no_root",existing.root,-1,&failed);
    n01a_assert("existing_primary_not_created",existing.created as i64,0,&failed);

    // Directory/nonregular and traversal boundaries. No symlink object is fabricated here.
    n01a_assert("fs_mkdir",nio_mkdir(N01A_FS),0,&failed);
    n01a_assert("nonregular_directory_refused",nrv2_open_regular_child(root,"fs",0),NRV2_NONREGULAR,&failed);
    n01a_assert("parent_traversal_refused",nrv2_open_regular_child(root,"../outside",0),-7401,&failed);

    let label57:[]u8="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    let label58:[]u8="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    let label64:[]u8="cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
    n01a_assert("label57_length",label57.len as i64,57,&failed);
    n01a_assert("label58_length",label58.len as i64,58,&failed);
    n01a_assert("label64_length",label64.len as i64,64,&failed);
    n01a_assert("label57_valid",nrv2_label_valid(label57) as i64,1,&failed);
    n01a_assert("label58_refused",nrv2_label_valid(label58) as i64,0,&failed);
    n01a_assert("label64_refused",nrv2_label_valid(label64) as i64,0,&failed);

    // Rejected labels must fail before output admission/start.
    let bad58:NativeRunV2=nrv2_run(root,_zag_arg(0),"normal",label58,1000,65536);
    n01a_assert("label58_run_status",bad58.status,NRV2_INVALID,&failed);
    n01a_assert("label58_run_artifacts",bad58.artifact_status,NRV2_ARTIFACT_NONE,&failed);
    n01a_assert("label58_run_started",bad58.started,0,&failed);
    let bad64:NativeRunV2=nrv2_run(root,_zag_arg(0),"normal",label64,1000,65536);
    n01a_assert("label64_run_status",bad64.status,NRV2_INVALID,&failed);
    n01a_assert("label64_run_artifacts",bad64.artifact_status,NRV2_ARTIFACT_NONE,&failed);
    n01a_assert("label64_run_started",bad64.started,0,&failed);

    // Force second-output creation failure. Preserve partial.stdout as evidence.
    let pre:i64=nrv2_open_regular_child(root,"partial.stderr",1);
    n01a_assert("partial_precreate",(pre>=0) as i64,1,&failed);
    if(pre>=0){n01a_assert("partial_preclose",nio_close(pre),0,&failed);}
    let partial:NativeRunV2=nrv2_run(root,_zag_arg(0),"normal","partial",1000,65536);
    n01a_assert("partial_status",partial.status,NRV2_OUTPUT_CREATE,&failed);
    n01a_assert("partial_detail",partial.detail,-17,&failed);
    n01a_assert("partial_artifacts",partial.artifact_status,NRV2_ARTIFACT_PARTIAL,&failed);
    n01a_assert("partial_not_started",partial.started,0,&failed);
    let partial_out:i64=nrv2_open_regular_child(root,"partial.stdout",0);
    n01a_assert("partial_stdout_preserved",(partial_out>=0) as i64,1,&failed);
    if(partial_out>=0){n01a_assert("partial_stdout_close",nio_close(partial_out),0,&failed);}

    // Label 57 accepted and normal direct child exits normally.
    let normal:NativeRunV2=nrv2_run(root,_zag_arg(0),"normal",label57,1000,65536);
    n01a_assert("normal_status",normal.status,NRV2_OK,&failed);
    n01a_assert("normal_artifacts",normal.artifact_status,NRV2_ARTIFACT_COMPLETE,&failed);
    n01a_assert("normal_started",normal.started,1,&failed);
    n01a_assert("normal_timeout",normal.timed_out,0,&failed);
    n01a_assert("normal_reaped",normal.reaped,1,&failed);
    n01a_assert("normal_exit",normal.exit_code,0,&failed);
    n01a_assert("normal_signal",normal.signal,0,&failed);
    n01a_assert("normal_stdout",normal.stdout_bytes,0,&failed);
    n01a_assert("normal_stderr",normal.stderr_bytes,0,&failed);
    n01a_assert("normal_output_limit",normal.output_over_limit,0,&failed);

    // Child installs no timer/guard. Parent monotonic supervisor must kill+reap it.
    let hung:NativeRunV2=nrv2_run(root,_zag_arg(0),"unguarded","unguarded",100,65536);
    n01a_assert("unguarded_status",hung.status,NRV2_TIMEOUT,&failed);
    n01a_assert("unguarded_started",hung.started,1,&failed);
    n01a_assert("unguarded_timeout",hung.timed_out,1,&failed);
    n01a_assert("unguarded_reaped",hung.reaped,1,&failed);
    n01a_assert("unguarded_exit",hung.exit_code,-1,&failed);
    n01a_assert("unguarded_signal",hung.signal,9,&failed);
    n01a_assert("unguarded_stdout",hung.stdout_bytes,0,&failed);
    n01a_assert("unguarded_stderr",hung.stderr_bytes,0,&failed);
    n01a_assert("unguarded_wall_bound",((hung.wall_ms>=100)&&(hung.wall_ms<5000)) as i64,1,&failed);
    n01a_assert("unguarded_rss_recorded",(hung.peak_rss>0) as i64,1,&failed);

    let flood:NativeRunV2=nrv2_run(root,_zag_arg(0),"flood","flood",1000,1024);
    n01a_assert("flood_status",flood.status,NRV2_OUTPUT_LIMIT,&failed);
    n01a_assert("flood_started",flood.started,1,&failed);
    n01a_assert("flood_reaped",flood.reaped,1,&failed);
    n01a_assert("flood_signal",flood.signal,25,&failed);
    n01a_assert("flood_output_ceiling",flood.stdout_bytes,1024,&failed);
    n01a_assert("flood_empty_stderr",flood.stderr_bytes,0,&failed);
    n01a_assert("flood_limit_recorded",flood.output_over_limit,1,&failed);

    // Missing executable reaches child execve and must be observed as exit 127.
    let missing:NativeRunV2=nrv2_run(root,
        "Research/R33_NATIVE_N01A_RUN_PRIMARY_V1/missing-executable","normal","execbad",1000,65536);
    n01a_assert("exec127_status",missing.status,NRV2_OK,&failed);
    n01a_assert("exec127_started",missing.started,1,&failed);
    n01a_assert("exec127_timeout",missing.timed_out,0,&failed);
    n01a_assert("exec127_reaped",missing.reaped,1,&failed);
    n01a_assert("exec127_exit",missing.exit_code,127,&failed);
    n01a_assert("exec127_signal",missing.signal,0,&failed);
    n01a_assert("exec127_stdout",missing.stdout_bytes,0,&failed);
    n01a_assert("exec127_stderr",missing.stderr_bytes,0,&failed);

    n01a_assert("root_close",nio_close(root),0,&failed);
    _zag_print("N01A_FAILURES,");_zag_println(_zag_i64_to_str(failed as i64));
    if(failed!=0){return 1;}
    _zag_println("N01A_NATIVE_PROCESS_V2_MATCHED_DESIGN,1");return 0;
}

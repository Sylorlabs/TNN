@import("native_hash_only.zag")
fn contains(b:[]u8,t:[]u8)i32 {if(t.len<1 || b.len<t.len){return 0;}let i:i32=0;while(i<=b.len-t.len){if(nio_equal(b[i..i+t.len],t)==1){return 1;}i=i+1;}return 0;}
fn n17_conservative_forbidden(b:[]u8)i32 {return contains(b,"ultralytics")+contains(b,"transformers")+contains(b,"torchvision.models")+contains(b,"openai")+contains(b,"whisper")+contains(b,"librosa.feature.mfcc")+contains(b,"speech_recognition");}

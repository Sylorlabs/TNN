fn vn_categorical(logits:[]f64,u:f64,weights:[]f64,out:*i32)i32 {if(logits.len<1||weights.len!=logits.len||out==null as *i32||u<0.0||u>=1.0){return 6;}let max:f64=logits[0];let i:i32=1;while(i<logits.len){if(logits[i]>max){max=logits[i];}i=i+1;}let sum:f64=0.0;i=0;while(i<logits.len){weights[i]=vn_exp(logits[i]-max);sum=sum+weights[i];i=i+1;}if(sum<=0.0){return 7;}let target:f64=u*sum;let acc:f64=0.0;i=0;while(i<logits.len){acc=acc+weights[i];if(target<acc){out.*=i;return 0;}i=i+1;}return 8;}

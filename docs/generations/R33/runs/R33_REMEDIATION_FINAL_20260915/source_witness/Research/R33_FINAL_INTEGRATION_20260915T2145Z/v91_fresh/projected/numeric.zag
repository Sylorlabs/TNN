// Native macOS/arm64 protected-substrate candidate. Not learner-callable.
// Darwin ABI constants checked against the installed SDK, not Linux numbers.
// No Python, shell execution, libc implementation or hidden language runtime.

fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}

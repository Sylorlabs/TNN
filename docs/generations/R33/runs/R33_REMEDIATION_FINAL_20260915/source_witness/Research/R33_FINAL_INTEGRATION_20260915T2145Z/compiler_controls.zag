@import("compiler_controls_lib.zag")
fn ordinary()i32 {return 19;}
fn invoke(f:fn()i32)i32 {return f();}
fn shadow(IMPORTED:i32)i32 {return IMPORTED;}
fn main()i32 {
 let f:fn()i32=ordinary;
 if(f()!=19 || invoke(ordinary)!=19){return 1;}
 if(shadow(7)!=7){return 2;}
 let called:i32=IMPORTED();if(called!=112){return 3;}
 let bare:i32=IMPORTED;
 _zag_print("BARE,");_zag_println(_zag_i64_to_str(bare as i64));
 _zag_print("CALLED,");_zag_println(_zag_i64_to_str(called as i64));
 if(bare!=112){return 4;}return 0;
}

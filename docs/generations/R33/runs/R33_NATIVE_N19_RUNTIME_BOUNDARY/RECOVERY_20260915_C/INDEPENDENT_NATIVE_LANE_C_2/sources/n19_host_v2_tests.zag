// Native engineering checks only. The caller supplies a new empty fixture root.
// Syscall fixture operations follow the existing CL native custody fixtures.
@import("n19_host_v2.zag")

fn nh_number(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);_zag_print(s);_zag_str_free(s);
}
fn nh_check(name:[]u8,actual:i64,expected:i64)i32 {
    _zag_print("N19_HOST_CHECK,");_zag_print(name);_zag_print(",");nh_number(actual);
    _zag_print(",");nh_number(expected);_zag_println("");return (actual!=expected) as i32;
}
fn nh_close(h:*N19HostResult)i32 {
    let r:N19HostResult=n19h_close_owned(h);return nh_check("close_owned",r.status,0);
}
fn nh_mkdir(root:i64,leaf:[]u8)i64 {
    let p:[]u8=n19h_cstr(leaf);if(p.len==0){return -1;}
    let r:i64=_zag_darwin_syscall(475,root,_zag_slice_ptr(p) as i64,448,0,0,0);n19h_free(p);return r;
}
fn nh_directory(root:i64,leaf:[]u8)N19HostResult {
    let p:[]u8=n19h_cstr(leaf);if(p.len==0){return n19h_result(-1905,0,-1);}
    let fd:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(p) as i64,17826048,0,0,0);
    n19h_free(p);return n19h_finish_open(fd,1,0);
}
fn nh_rename(root:i64,old:[]u8,next:[]u8)i64 {
    let a:[]u8=n19h_cstr(old);let b:[]u8=n19h_cstr(next);
    if(a.len==0 || b.len==0){n19h_free(a);n19h_free(b);return -1;}
    let r:i64=_zag_darwin_syscall(465,root,_zag_slice_ptr(a) as i64,root,_zag_slice_ptr(b) as i64,0,0);
    n19h_free(a);n19h_free(b);return r;
}
fn nh_write(root:i64,leaf:[]u8,bytes:[]u8)i32 {
    let h:N19HostResult=n19h_leaf_open(root,leaf,1);let f:i32=nh_check("write_open",h.status,0);
    if(h.status!=0){return f;}
    let at:i64=0;let calls:i32=0;
    while(at<bytes.len && calls<32){
        let n:i64=_zag_darwin_syscall(4,h.fd,(_zag_slice_ptr(bytes) as i64)+at,(bytes.len as i64)-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<0){f=f+nh_check("write_syscall",n,0);break;}if(n==0){break;}at=at+n;
    }
    f=f+nh_check("written_bytes",at,bytes.len);
    f=f+nh_check("file_fsync",_zag_darwin_syscall(95,h.fd,0,0,0,0,0),0);
    f=f+nh_check("root_fsync",_zag_darwin_syscall(95,root,0,0,0,0,0),0);
    return f+nh_close(&h);
}
fn nh_read(root:i64,leaf:[]u8,expected:[]u8)i32 {
    let h:N19HostResult=n19h_leaf_open(root,leaf,0);let f:i32=nh_check("read_open",h.status,0);
    if(h.status!=0){return f;}
    let b:[]u8=n19h_alloc(expected.len+1);if(b.len==0){return f+1+nh_close(&h);}
    let at:i64=0;let calls:i32=0;
    while(at<b.len && calls<32){
        let n:i64=_zag_darwin_syscall(3,h.fd,(_zag_slice_ptr(b) as i64)+at,(b.len as i64)-at,0,0,0);
        calls=calls+1;if(n==-4){continue;}if(n<0){f=f+nh_check("read_syscall",n,0);break;}if(n==0){break;}at=at+n;
    }
    f=f+nh_check("read_exact_length",at,expected.len);let equal:i32=(at==expected.len) as i32;
    let i:i32=0;while(i<expected.len){if(b[i]!=expected[i]){equal=0;}i=i+1;}
    f=f+nh_check("read_exact_bytes",equal,1);n19h_free(b);return f+nh_close(&h);
}
fn nh_reject(root:i64,leaf:[]u8,create:i32,expected:i32)i32 {
    let h:N19HostResult=n19h_leaf_open(root,leaf,create);let f:i32=nh_check(leaf,h.status,expected);
    if(h.fd>=0){f=f+nh_close(&h);}return f;
}
fn nh_unit()i32 {
    let f:i32=0;
    f=f+nh_check("open_success",n19h_open_status(7),0);
    f=f+nh_check("open_enoent",n19h_open_status(-2),-1904);
    f=f+nh_check("open_ebadf",n19h_open_status(-9),-1904);
    f=f+nh_check("open_eacces",n19h_open_status(-13),-1904);
    f=f+nh_check("open_eexist",n19h_open_status(-17),-1904);
    f=f+nh_check("open_eloop",n19h_open_status(-62),-1904);
    f=f+nh_check("open_einval",n19h_open_status(-22),-1999);
    f=f+nh_check("open_enotsup",n19h_open_status(-45),-1999);
    f=f+nh_check("open_enosys",n19h_open_status(-78),-1999);
    f=f+nh_check("open_eio",n19h_open_status(-5),-1905);
    f=f+nh_check("open_emfile",n19h_open_status(-24),-1905);
    f=f+nh_check("open_enospc",n19h_open_status(-28),-1905);
    f=f+nh_check("io_einval_not_open_abi",n19h_io_status(-22),-1905);
    f=f+nh_check("io_success",n19h_io_status(0),0);
    f=f+nh_check("leaf_empty",n19h_name_ok("",1),0);
    f=f+nh_check("leaf_dot",n19h_name_ok(".",1),0);
    f=f+nh_check("leaf_parent",n19h_name_ok("..",1),0);
    f=f+nh_check("leaf_absolute",n19h_name_ok("/escape",1),0);
    f=f+nh_check("leaf_traversal",n19h_name_ok("../escape",1),0);
    let b:[]u8=n19h_alloc(256);if(b.len!=256){return f+1;}
    let i:i32=0;while(i<256){b[i]=97;i=i+1;}
    f=f+nh_check("leaf_bound_255",n19h_name_ok(b[0..255],1),1);
    f=f+nh_check("leaf_bound_256",n19h_name_ok(b,1),0);b[1]=0;
    f=f+nh_check("leaf_embedded_nul",n19h_name_ok(b[0..3],1),0);n19h_free(b);
    // Root paths are allowed to contain separators; leaf paths are not.
    // This guards against accidentally applying leaf-name policy to the
    // retained capability root.  Runtime fixtures must still use a root path
    // whose existing components satisfy O_NOFOLLOW_ANY (for example, a
    // repository-owned directory rather than macOS /tmp -> /private/tmp).
    f=f+nh_check("root_absolute_path_syntax",n19h_name_ok("/Users/fixture",0),1);
    f=f+nh_check("root_relative_path_syntax",n19h_name_ok("Research/fixture",0),1);
    let empty:N19HostResult=n19h_result(0,0,-1);let closed:N19HostResult=n19h_close_owned(&empty);
    f=f+nh_check("unowned_close_refused",closed.status,-1904);
    return f;
}
fn nh_files(path:[]u8)i32 {
    let root:N19HostResult=n19h_root_open(path);let f:i32=nh_check("root_open",root.status,0);
    if(root.status!=0){return f;}
    f=f+nh_write(root.fd,"one.bin","original");
    let duplicate:N19HostResult=n19h_leaf_open(root.fd,"one.bin",1);
    f=f+nh_check("exclusive_refusal",duplicate.status,-1904);f=f+nh_check("exclusive_errno_observed",duplicate.detail,-17);
    if(duplicate.fd>=0){f=f+nh_close(&duplicate);}
    f=f+nh_read(root.fd,"one.bin","original");
    let missing:N19HostResult=n19h_leaf_open(root.fd,"missing.bin",0);
    f=f+nh_check("missing_refusal",missing.status,-1904);f=f+nh_check("missing_errno_observed",missing.detail,-2);
    if(missing.fd>=0){f=f+nh_close(&missing);}
    f=f+nh_reject(root.fd,"../escape",1,-1904);f=f+nh_reject(root.fd,"/escape",1,-1904);
    f=f+nh_check("directory_create",nh_mkdir(root.fd,"directory"),0);f=f+nh_reject(root.fd,"directory",0,-1904);
    let target:[]u8=n19h_cstr("one.bin");let sym:[]u8=n19h_cstr("sym.bin");let hard:[]u8=n19h_cstr("hard.bin");let fifo:[]u8=n19h_cstr("fifo");
    if(target.len==0 || sym.len==0 || hard.len==0 || fifo.len==0){n19h_free(target);n19h_free(sym);n19h_free(hard);n19h_free(fifo);return f+1+nh_close(&root);}
    f=f+nh_check("symlink_create",_zag_darwin_syscall(474,_zag_slice_ptr(target) as i64,root.fd,_zag_slice_ptr(sym) as i64,0,0,0),0);
    f=f+nh_reject(root.fd,"sym.bin",0,-1904);
    f=f+nh_check("hardlink_create",_zag_darwin_syscall(471,root.fd,_zag_slice_ptr(target) as i64,root.fd,_zag_slice_ptr(hard) as i64,0,0),0);
    f=f+nh_reject(root.fd,"one.bin",0,-1904);f=f+nh_reject(root.fd,"hard.bin",0,-1904);
    f=f+nh_check("fifo_create",_zag_darwin_syscall(553,root.fd,_zag_slice_ptr(fifo) as i64,384,0,0,0),0);
    f=f+nh_reject(root.fd,"fifo",0,-1904);
    n19h_free(target);n19h_free(sym);n19h_free(hard);n19h_free(fifo);
    f=f+nh_check("live_directory_create",nh_mkdir(root.fd,"live"),0);
    let held:N19HostResult=nh_directory(root.fd,"live");f=f+nh_check("held_root_open",held.status,0);
    if(held.status!=0){return f+nh_close(&root);}
    f=f+nh_write(held.fd,"before.bin","before");
    f=f+nh_check("rename_open_root",nh_rename(root.fd,"live","moved"),0);
    f=f+nh_check("replacement_create",nh_mkdir(root.fd,"live"),0);
    f=f+nh_write(held.fd,"after.bin","after");
    f=f+nh_read(held.fd,"before.bin","before");f=f+nh_read(held.fd,"after.bin","after");
    let replacement:N19HostResult=nh_directory(root.fd,"live");let moved:N19HostResult=nh_directory(root.fd,"moved");
    f=f+nh_check("replacement_open",replacement.status,0);f=f+nh_check("moved_open",moved.status,0);
    if(replacement.status==0){f=f+nh_reject(replacement.fd,"before.bin",0,-1904);f=f+nh_reject(replacement.fd,"after.bin",0,-1904);f=f+nh_close(&replacement);}
    if(moved.status==0){f=f+nh_read(moved.fd,"before.bin","before");f=f+nh_read(moved.fd,"after.bin","after");f=f+nh_close(&moved);}
    f=f+nh_close(&held);f=f+nh_check("closed_root_invalidated",held.fd,-1);
    let twice:N19HostResult=n19h_close_owned(&held);f=f+nh_check("double_close_refused",twice.status,-1904);
    return f+nh_close(&root);
}
fn main()i32 {
    if(_zag_argc()!=2 && _zag_argc()!=3){return 64;}
    if(_zag_strcmp(_zag_arg(1),"unit")!=1){return 64;}
    let f:i32=nh_unit();if(_zag_argc()==3){f=f+nh_files(_zag_arg(2));}
    _zag_print("N19_HOST_FAILURES,");nh_number(f);_zag_println("");return (f!=0) as i32;
}

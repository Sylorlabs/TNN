@import("n19_host_v2.zag")
fn ck(label:[]u8,actual:i64,want:i64)i32 {
    _zag_print("C_CHECK,");_zag_print(label);_zag_print(",actual,");
    let a:[]u8=_zag_i64_to_str(actual);_zag_print(a);_zag_str_free(a);
    _zag_print(",expected,");let b:[]u8=_zag_i64_to_str(want);_zag_println(b);_zag_str_free(b);
    return (actual!=want) as i32;
}
fn main()i32 {
    if(_zag_argc()!=2){return 64;}
    let root:N19HostResult=n19h_root_open(_zag_arg(1));let f:i32=ck("root",root.status,0);
    if(root.status!=0){return 1;}
    let missing:N19HostResult=n19h_leaf_open(root.fd,"missing",0);
    f=f+ck("real_open_ENOENT",missing.detail,-2)+ck("ENOENT_path",missing.status,-1904)+ck("missing_no_fd",missing.fd,-1);
    let h:N19HostResult=n19h_leaf_open(root.fd,"owned.bin",1);
    f=f+ck("create",h.status,0);if(h.status!=0){n19h_close_owned(&root);return 1;}
    let fd:i64=h.fd;
    f=f+ck("real_close",_zag_darwin_syscall(6,fd,0,0,0,0,0),0);
    let sync:i64=_zag_darwin_syscall(95,fd,0,0,0,0,0);
    f=f+ck("real_fsync_EBADF",sync,-9)+ck("fsync_IO",n19h_io_status(sync),-1905);
    let closed:N19HostResult=n19h_close_owned(&h);
    f=f+ck("owned_close_EBADF",closed.detail,-9)+ck("close_IO",closed.status,-1905);
    f=f+ck("failed_close_invalidated_fd",h.fd,-1)+ck("failed_close_invalidated_status",h.status,-1904);
    let next:N19HostResult=n19h_leaf_open(root.fd,"next.bin",1);f=f+ck("next_create",next.status,0);
    let twice:N19HostResult=n19h_close_owned(&h);f=f+ck("double_close_refused",twice.status,-1904);
    if(next.status==0){
        f=f+ck("next_fd_still_valid",n19h_stat(next.fd,0,1).status,0);
        f=f+ck("next_close",n19h_close_owned(&next).status,0);
    }
    let stale:i64=root.fd;f=f+ck("root_close",n19h_close_owned(&root).status,0);
    let bad:N19HostResult=n19h_leaf_open(stale,"missing",0);
    f=f+ck("real_open_EBADF",bad.detail,-9)+ck("open_EBADF_path",bad.status,-1904);
    f=f+ck("same_EBADF_IO_separate",n19h_io_status(bad.detail),-1905);
    return (f!=0) as i32;
}

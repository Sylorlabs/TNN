// Encoded-file fixtures and fresh-process replay, not a learner or device sensor.
@import("R33_B001_RAW_RECORD.zag")
@import("R33_B001_COMPONENTS.zag")

fn c02_metric(key:[]u8,value:i32)void {
    _zag_print("M,");_zag_print(key);_zag_print(",");_zag_println(_zag_i64_to_str(value as i64));
}
fn c02_value(key:[]u8,index:i32,value:i32)void {
    _zag_print("V,");_zag_print(key);_zag_print(",");_zag_print(_zag_i64_to_str(index as i64));
    _zag_print(",");_zag_println(_zag_i64_to_str(value as i64));
}
fn c02_emit(store:*R33RawStore)void {
    let raw:[]u8=store.*.bytes[0..store.*.used];let i:i32=0;
    while(i<12){c02_value("metadata",i,rr_get32(raw,8+i*4));i=i+1;}
    let payload:[]i32=zalloc_i(raw.len-64);i=0;
    while(i<payload.len){payload[i]=raw[64+i] as i32;i=i+1;}
    if(rr_get32(raw,8)==1){
        let samples:[]i32=zalloc_i(payload.len/2);
        c02_metric("decoded_status",r33_pcm16le_decode(payload,samples,rr_get32(raw,12),rr_get32(raw,16)));
        i=0;while(i<samples.len){c02_value("decoded",i,samples[i]);i=i+1;}zfree(samples);
    }else{
        c02_metric("decoded_status",0);i=0;
        while(i<payload.len){c02_value("decoded",i,payload[i]);i=i+1;}
    }
    zfree(payload);
}

fn main()i32 {
    if(_zag_argc()<5){return 2;}
    let mode:[]u8=_zag_arg(1);let input:[]u8=_zag_arg(2);let output:[]u8=_zag_arg(3);
    let capacity64:i64=_zag_str_to_i64(_zag_arg(4));
    if(capacity64<0 || capacity64>131136){return 2;}
    let capacity:i32=capacity64 as i32;
    let owned:[]u8=rr_bytes(capacity);if(owned.len!=capacity){return 3;}
    let i:i32=0;while(i<owned.len){owned[i]=211 as u8;i=i+1;}
    let cursor:[]i32=zalloc_i(4);cursor[0]=7;cursor[1]=0;cursor[2]=-1;cursor[3]=1000000;
    let store:R33RawStore=R33RawStore{.bytes=owned,.used=0,.cursor=cursor};
    let source:[]u8=_zag_read_file(input);let status:i32=-6;let detached:i32=-1;
    if(source.len>=0){
        if(_zag_strcmp(mode,"capture")==1){status=rr_admit(source,&store);}
        else{
            if(_zag_strcmp(mode,"reload")==1 || _zag_strcmp(mode,"continue")==1){
                status=rr_snapshot_restore(source,&store);
                if(status==0 && _zag_strcmp(mode,"continue")==1){
                    if(_zag_argc()!=6){return 2;}
                    let following:[]u8=_zag_read_file(_zag_arg(5));
                    if(following.len<0){status=-6;}else{status=rr_admit(following,&store);}
                }
            }else{status=-1;}
        }
    }
    if(status==0){
        if(_zag_strcmp(mode,"capture")==1 && source.len>64){
            let prior:i32=store.bytes[64] as i32;
            source[64]=((prior+1)-((prior+1)/256)*256) as u8;
            detached=0;if((store.bytes[64] as i32)==prior){detached=1;}
        }
        status=rr_snapshot_write(&store,output);
    }
    c02_metric("status",status);c02_metric("used",store.used);c02_metric("detached",detached);
    i=0;while(i<4){c02_value("cursor",i,cursor[i]);i=i+1;}
    if(status==0){c02_emit(&store);}
    else{
        let changes:i32=0;i=0;
        while(i<owned.len){if((owned[i] as i32)!=211){changes=changes+1;}i=i+1;}
        c02_metric("changed_destination_bytes",changes);
    }
    // Nonzero status is an observed expected-rejection case, never a pass by exit0.
    return 0;
}

// Native qualification supervisor and OS adapter. sandbox-exec is Apple's
// installed kernel-policy loader only; test/oracle/supervision logic is Zag.
@import("R33_NATIVE_PROCESS_V3.zag")
@import("R33_NATIVE_SHA256_V2.zag")

struct N8Stats {checks:i32,failed:i32,children:i32,worker_checks:i32,cpu:i64,wall:i64,rss:i64}
fn n8_stats()N8Stats {return N8Stats{.checks=0,.failed=0,.children=0,.worker_checks=0,.cpu=0,.wall=0,.rss=0};}
fn n8_check(s:*N8Stats,name:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(name,a,e);}
fn n8_root()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N08_RUN_PRIMARY_V1";}
fn n8_path(name:[]u8)[]u8 {let p:[]u8=_zag_str_concat(n8_root(),"/");let out:[]u8=_zag_str_concat(p,name);nio_free(p);return out;}
fn n8_binary()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N08_ISOLATION/BUILD_01/worker";}
fn n8_write(root:i64,name:[]u8,b:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(root)!=0){code=-1;}
    if(nio_close(fd)!=0){code=-1;}return code;
}
fn n8_concat(a:[]u8,b:[]u8)[]u8 {let out:[]u8=_zag_str_concat(a,b);nio_free(a);return out;}
fn n8_profile(mode:[]u8,block:i32)[]u8 {
    let p:[]u8=_zag_str_concat("(version 1)\n(deny default)\n(allow file-read* (subpath \"/usr/lib\") (subpath \"/System/Library\") (subpath \"/private/var/db/dyld\") (literal \"",n8_binary());
    p=n8_concat(p,"\") (literal \"");p=n8_concat(p,n8_path("input.bin"));
    p=n8_concat(p,"\"))\n");
    p=n8_concat(p,"(allow file-write-data (literal \"");let stem:[]u8=_zag_str_concat("worker-",mode);
    let out:[]u8=_zag_str_concat(stem,".stdout");let err:[]u8=_zag_str_concat(stem,".stderr");
    p=n8_concat(p,n8_path(out));p=n8_concat(p,"\") (literal \"");p=n8_concat(p,n8_path(err));p=n8_concat(p,"\"))\n");
    if(block==0){p=n8_concat(p,"(allow process-exec (literal \"");p=n8_concat(p,n8_binary());p=n8_concat(p,"\"))\n");}
    p=n8_concat(p,"(allow signal (target self))\n");nio_free(stem);nio_free(out);nio_free(err);return p;
}
fn n8_launch(mode:[]u8,block:i32)i32 {
    let profile:[]u8=n8_profile(mode,block);let p:[]u8=nio_cstr(profile);let shell:[]u8=nio_cstr("/usr/bin/sandbox-exec");
    let flag:[]u8=nio_cstr("-p");let worker:[]u8=nio_cstr(n8_binary());let m:[]u8=nio_cstr(mode);
    let argv:*i64=_zag_malloc(48) as *i64;let env:*i64=_zag_malloc(8) as *i64;
    if(p.len==0 || shell.len==0 || flag.len==0 || worker.len==0 || m.len==0 || argv==null as *i64 || env==null as *i64){return 120;}
    argv[0]=_zag_slice_ptr(shell) as i64;argv[1]=_zag_slice_ptr(flag) as i64;argv[2]=_zag_slice_ptr(p) as i64;
    argv[3]=_zag_slice_ptr(worker) as i64;argv[4]=_zag_slice_ptr(m) as i64;argv[5]=0;env[0]=0;
    let nullpath:[]u8=nio_cstr("/dev/null");let nullfd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(nullpath) as i64,0,0,0,0,0);
    if(nullfd<0){return 121;}if(nullfd!=0 && _zag_darwin_syscall(90,nullfd,0,0,0,0,0)!=0){return 121;}
    let fd:i32=3;while(fd<64){nio_close(fd);fd=fd+1;}
    // No unsandboxed fallback exists. Any platform loader failure ends this child.
    let rc:i64=_zag_darwin_syscall(59,_zag_slice_ptr(shell) as i64,argv as i64,env as i64,0,0,0);
    _zag_print("N08_PLATFORM_EXEC_FAILURE,");_zag_println(_zag_i64_to_str(rc));return 122;
}
fn n8_has(b:[]u8,needle:[]u8)i32 {
    let i:i32=0;while(i+needle.len<=b.len){let k:i32=0;while(k<needle.len && b[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;}return 0;
}
fn n8_capture(root:i64,label:[]u8)[]u8 {
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(label,".stdout");let fd:i64=nio_open_child(root,name,0);
    let n:i64=nio_read_exact(fd,b,262144);if(fd>=0){nio_close(fd);}nio_free(name);
    if(n<0 || n>262144){nio_free(b);return "";}return b[0..n as i32];
}
fn n8_protected_unchanged(s:*N8Stats)void {
    let path:[]u8=n8_path("control");let root:i64=nio_open_root(path);nio_free(path);let fd:i64=nio_open_child(root,"anchor.bin",0);
    let b:[]u8=nio_alloc(64);let n:i64=nio_read_exact(fd,b,64);if(fd>=0){nio_close(fd);}if(root>=0){nio_close(root);}
    n8_check(s,"protected_fixture_length",n,64);let match:i32=1;let i:i32=0;
    while(i<64){if(b[i]!=((i*13+91)%256) as u8){match=0;}i=i+1;}n8_check(s,"protected_fixture_unchanged",match,1);nio_free(b);
}
fn n8_run(root:i64,mode:[]u8,kind:i32,s:*N8Stats)void {
    if(s.*.failed!=0){return;}let name:[]u8=_zag_str_concat("worker-",mode);let deadline:i64=15000;let limit:i64=262144;
    if(kind==2){deadline=500;}if(kind==3){limit=4096;}
    let r:NativeRunV3=nrv3_run(root,_zag_arg(0),name,name,deadline,limit);s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    n8_check(s,"child_started",r.started,1);n8_check(s,"child_reaped",r.reaped,1);
    n8_check(s,"observed_child_rss",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let log:[]u8=n8_capture(root,name);n8_check(s,"capture_length",log.len,r.stdout_bytes);
    if(kind==0){n8_check(s,"child_status",r.status,0);n8_check(s,"child_exit",r.exit_code,0);n8_check(s,"child_signal",r.signal,0);
        n8_check(s,"child_stderr_empty",r.stderr_bytes,0);n8_check(s,"worker_entered",n8_has(log,"N08_SANDBOX_WORKER_ENTERED\n"),1);
        n8_check(s,"worker_pass",n8_has(log,"N08_WORKER_PASS\n"),1);
        if(_zag_strcmp(mode,"probe")==1){let matched:i32=n8_has(log,"N08_WORKER_COUNTS,14,0\n");n8_check(s,"exact_worker_checks",matched,1);if(matched==1 && r.exit_code==0){s.*.worker_checks=s.*.worker_checks+14;}}
        else{let matched:i32=n8_has(log,"N08_WORKER_COUNTS,1,0\n");n8_check(s,"exact_worker_checks",matched,1);if(matched==1 && r.exit_code==0){s.*.worker_checks=s.*.worker_checks+1;}}
    }else if(kind==1){n8_check(s,"loader_failure_captured",r.status,0);n8_check(s,"blocked_program_did_not_run",n8_has(log,"N08_SANDBOX_WORKER_ENTERED"),0);
        n8_check(s,"denied_launch_nonzero",(r.exit_code>0 && r.exit_code<120 && r.signal==0) as i32,1);}
    else if(kind==2){n8_check(s,"kernel_parent_timeout",r.status,-7608);n8_check(s,"worker_started_before_timeout",n8_has(log,"N08_SANDBOX_WORKER_ENTERED\n"),1);
        n8_check(s,"timeout_flag",r.timed_out,1);n8_check(s,"timeout_signal",r.signal,9);}
    else{n8_check(s,"kernel_output_limit",r.status,-7609);n8_check(s,"worker_started_before_limit",n8_has(log,"N08_SANDBOX_WORKER_ENTERED\n"),1);
        n8_check(s,"output_limit_flag",r.output_over_limit,1);n8_check(s,"no_capture_overflow",(r.stdout_bytes<=4096) as i32,1);}
    n8_protected_unchanged(s);nio_free(log);nio_free(name);
}
fn n8_field(b:[]u8,k:[]u8,v:i64)[]u8 {let n:[]u8=_zag_i64_to_str(v);b=n8_concat(b,k);b=n8_concat(b,n);nio_free(n);return b;}
fn n8_supervise()i32 {
    if(nio_guard(60)!=0){return 3;}let a:NativeAdmissionV3=nrv3_admit_root(n8_root());if(a.status!=0){return 4;}
    let root:i64=a.root;let s:N8Stats=n8_stats();let input:[]u8=nio_alloc(32);let i:i32=0;
    while(i<32){input[i]=(i+1) as u8;i=i+1;}n8_check(&s,"input_created",n8_write(root,"input.bin",input),0);nio_free(input);
    let control_path:[]u8=n8_path("control");n8_check(&s,"control_created",nio_mkdir(control_path),0);let control:i64=nio_open_root(control_path);nio_free(control_path);
    let secret:[]u8=nio_alloc(64);i=0;while(i<64){secret[i]=((i*13+91)%256) as u8;i=i+1;}
    n8_check(&s,"control_fixture_created",n8_write(control,"anchor.bin",secret),0);n8_check(&s,"preimage_created",n8_write(control,"preimage.bin",secret),0);nio_free(secret);
    let leaked:i64=nio_open_child(control,"anchor.bin",0);n8_check(&s,"synthetic_descriptor40_installed",_zag_darwin_syscall(90,leaked,40,0,0,0,0),40);
    if(leaked>=0){nio_close(leaked);}nio_close(control);
    let target:[]u8=nio_cstr(n8_path("control/anchor.bin"));let link:[]u8=nio_cstr(n8_path("linked-input.bin"));
    n8_check(&s,"symlink_fixture_created",_zag_darwin_syscall(57,_zag_slice_ptr(target) as i64,_zag_slice_ptr(link) as i64,0,0,0,0),0);nio_free(target);nio_free(link);
    let profile:[]u8=n8_profile("probe",0);n8_check(&s,"profile_retained",n8_write(root,"probe-profile.sb",profile),0);nio_free(profile);
    n8_run(root,"probe",0,&s);n8_run(root,"exec",0,&s);n8_run(root,"blocked",1,&s);n8_run(root,"spin",2,&s);n8_run(root,"flood",3,&s);
    n8_check(&s,"five_children_completed",s.children,5);n8_check(&s,"fifteen_worker_assertions",s.worker_checks,15);
    n8_check(&s,"close_deliberate_parent_descriptor",nio_close(40),0);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N08\",\n  \"planned_children\":5","");
    json=n8_field(json,",\n  \"children_reaped\":",s.children);json=n8_field(json,",\n  \"parent_failures\":",s.failed);
    json=n8_field(json,",\n  \"worker_checks\":",s.worker_checks);json=n8_field(json,",\n  \"parent_checks_before_result_write\":",s.checks);
    json=n8_field(json,",\n  \"child_cpu_us\":",s.cpu);json=n8_field(json,",\n  \"observed_child_wall_us\":",s.wall);
    json=n8_field(json,",\n  \"peak_child_rss_bytes\":",s.rss);
    json=n8_concat(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"real_human_grant\":false,\n  \"full_runtime_qualified\":false,\n  \"requires_terminal_marker\":true\n}\n");
    n8_check(&s,"native_result_saved",n8_write(root,"NATIVE_RESULT.json",json),0);_zag_print(json);nio_free(json);
    n8_check(&s,"close_root",nio_close(root),0);if(s.failed!=0){return 1;}_zag_println("R33_N08_KERNEL_WORKER_ISOLATION_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return n8_supervise();}
    if(_zag_strcmp(mode,"worker-probe")==1){return n8_launch("probe",0);}
    if(_zag_strcmp(mode,"worker-exec")==1){return n8_launch("exec",0);}
    if(_zag_strcmp(mode,"worker-blocked")==1){return n8_launch("blocked",1);}
    if(_zag_strcmp(mode,"worker-spin")==1){return n8_launch("spin",0);}
    if(_zag_strcmp(mode,"worker-flood")==1){return n8_launch("flood",0);}return 2;
}

// N10 synthetic grammar controls, real accepted-parent inert mapping and
// fresh-process exact table/raw-byte reconstruction. No pickle execution.
@import("mapio.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct P10Stats {checks:i32,failed:i32,children:i32,child_checks:i32,words:i64,cpu:i64,wall:i64,rss:i64}
fn p10_stats()P10Stats {return P10Stats{.checks=0,.failed=0,.children=0,.child_checks=0,.words=0,.cpu=0,.wall=0,.rss=0};}
fn p10_check(s:*P10Stats,k:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(k,a,e);}
fn p10_path(name:[]u8)[]u8 {return _zag_str_concat("Research/R33_NATIVE_N10_RUN_PRIMARY_V1/",name);}
fn p10_hex(text:[]u8)[]u8 {
    if(text.len<2 || text.len%2!=0){return "";}let out:[]u8=nio_alloc(text.len/2);let i:i32=0;
    while(i<out.len){let a:i64=ns_hex_digit(text[i*2] as i32);let b:i64=ns_hex_digit(text[i*2+1] as i32);
        if(a<0 || b<0){nio_free(out);return "";}out[i]=(a*16+b) as u8;i=i+1;}return out;
}
fn p10_join(a:[]u8,b:[]u8)[]u8 {let c:[]u8=_zag_str_concat(a,b);nio_free(a);return c;}
fn p10_append_hex(a:[]u8,b:[]u8)[]u8 {let bytes:[]u8=p10_hex(b);let out:[]u8=p10_join(a,bytes);nio_free(bytes);return out;}
fn p10_source_hash()[]u8 {return p10_hex("31e670fcd2a2fefc02a1d032b8016bd93c28844df8ea40889593d030a2096e5a");}
fn p10_parse(bytes:[]u8,s:*P10Stats)ParentMap {
    let p:ParentMap=pm_init(bytes,128,256,128,128);p10_check(s,"native_inert_parse",pm_scan(&p),0);
    if(p.status==0){p10_check(s,"descriptor_invariants",pm_validate(&p),0);}return p;
}
fn p10_scalar(text:[]u8,kind:i32,value:i64,s:*P10Stats)void {
    let bytes:[]u8=p10_hex(text);let p:ParentMap=p10_parse(bytes,s);p10_check(s,"root_kind",pm_kind(&p,p.root),kind);
    if(kind==2 || kind==3 || kind==4){let out:i64=0;p10_check(s,"integer_decode",pm_small_int(&p,p.root,&out),0);p10_check(s,"integer_exact",out,value);}
    p10_check(s,"all_input_consumed",p.pos,bytes.len);pm_close(&p);nio_free(bytes);
}
fn p10_scalars(s:*P10Stats)void {
    p10_scalar("80054e2e",1,0,s);p10_scalar("8005882e",2,1,s);p10_scalar("8005892e",2,0,s);
    p10_scalar("80054bff2e",3,255,s);p10_scalar("80054dffff2e",3,65535,s);
    p10_scalar("80054affffffff2e",3,-1,s);p10_scalar("80054a000000802e",3,-2147483648,s);
    p10_scalar("80058a01ff2e",4,-1,s);p10_scalar("80058a002e",4,0,s);
    p10_scalar("80024e2e",1,0,s);p10_scalar("80049502000000000000004e2e",1,0,s);
    let b:[]u8=p10_hex("80054780000000000000002e");let p:ParentMap=p10_parse(b,s);
    p10_check(s,"float_is_raw_ieee_not_normalized",pm_kind(&p,p.root),5);let raw:[]u8=pm_raw(&p,p.root);
    p10_check(s,"float_byte_extent",raw.len,8);p10_check(s,"negative_zero_sign_byte",raw[0] as i32,128);pm_close(&p);nio_free(b);
    b=p10_hex("80058a090100000000000000012e");p=p10_parse(b,s);let number:i64=77;
    p10_check(s,"large_integer_extent_preserved",pm_raw(&p,p.root).len,9);p10_check(s,"large_integer_not_truncated",pm_small_int(&p,p.root,&number),-1);
    p10_check(s,"failed_small_integer_output_unchanged",number,77);pm_close(&p);nio_free(b);
    b=p10_hex("800543054e2e9593522e");p=p10_parse(b,s);p10_check(s,"opcode_like_bytes_stay_bytes",pm_kind(&p,p.root),7);
    p10_check(s,"opaque_bytes_length",pm_raw(&p,p.root).len,5);p10_check(s,"opaque_payload_not_executed_as_opcodes",p.op_count,3);pm_close(&p);nio_free(b);
    b=p10_hex("80059603000000000000006162632e");p=p10_parse(b,s);p10_check(s,"bytearray_kind",pm_kind(&p,p.root),8);
    p10_check(s,"bytearray_raw_exact",nio_equal(pm_raw(&p,p.root),"abc"),1);pm_close(&p);nio_free(b);
    b=p10_hex("80058c03e298832e");p=p10_parse(b,s);p10_check(s,"utf8_encoded_bytes_retained",pm_raw(&p,p.root).len,3);pm_close(&p);nio_free(b);
}
fn p10_object_fixture(reduced:i32)[]u8 {
    let b:[]u8=p10_hex("800563");b=p10_join(b,"r33_nonexistent_fixture\nNeverImportOrCall\n");
    if(reduced==1){b=p10_append_hex(b,"29527d622e");}
    else{b=p10_append_hex(b,"2981947d288c04737465704b078c076d697373696e674e75622e");}return b;
}
fn p10_structure(s:*P10Stats)void {
    let b:[]u8=p10_hex("80055d946800612e");let p:ParentMap=p10_parse(b,s);
    p10_check(s,"self_reference_list",pm_kind(&p,p.root),9);p10_check(s,"self_reference_aliases",p.aliases,1);p10_check(s,"self_reference_memo_count",p.memo_count,1);
    p10_check(s,"self_reference_target_identity",p.edges[0],p.root);p10_check(s,"self_reference_not_recursively_expanded",p.node_count,1);pm_close(&p);nio_free(b);
    b=p10_hex("80055d946800862e");p=p10_parse(b,s);p10_check(s,"shared_tuple_reference_a",p.edges[0],1);p10_check(s,"shared_tuple_reference_b",p.edges[4],1);pm_close(&p);nio_free(b);
    b=p10_hex("80055d71016801862e");p=p10_parse(b,s);p10_check(s,"sparse_memo_extent",p.memo_extent,2);p10_check(s,"sparse_memo_hole",p.memo[0],0);pm_close(&p);nio_free(b);
    b=p10_hex("80057d288c01614b018c01624e752e");p=p10_parse(b,s);let v:i64=0;
    p10_check(s,"dictionary_lookup",pm_small_int(&p,pm_lookup(&p,p.root,"a"),&v),0);p10_check(s,"dictionary_value",v,1);
    p10_check(s,"explicit_null_preserved",pm_kind(&p,pm_lookup(&p,p.root,"b")),1);pm_close(&p);nio_free(b);
    b=p10_object_fixture(0);p=p10_parse(b,s);p10_check(s,"missing_class_never_imported",pm_kind(&p,p.root),15);
    p10_check(s,"newobj_descriptor",p.newobjs,1);p10_check(s,"build_descriptor",p.builds,1);
    p10_check(s,"stored_build_argument_lookup",pm_small_int(&p,pm_lookup(&p,p.root,"step"),&v),0);p10_check(s,"stored_step_exact",v,7);
    p10_check(s,"null_not_default_initialized",pm_kind(&p,pm_lookup(&p,p.root,"missing")),1);pm_close(&p);nio_free(b);
    b=p10_object_fixture(1);p=p10_parse(b,s);p10_check(s,"unknown_reducer_is_descriptor",pm_kind(&p,p.root),16);
    p10_check(s,"reducer_not_called",p.reductions,1);p10_check(s,"unresolved_reducer_build_recorded",p.builds,1);pm_close(&p);nio_free(b);
    b=p10_hex("80055d284b014b02652e");p=p10_parse(b,s);p10_check(s,"list_append_sequence_recorded",p.nodes[(p.root-1)*10+9],2);pm_close(&p);nio_free(b);
    b=p10_hex("80058f284b014b02902e");p=p10_parse(b,s);p10_check(s,"set_kind",pm_kind(&p,p.root),12);p10_check(s,"set_updates_recorded",p.edge_count,2);pm_close(&p);nio_free(b);
    b=p10_hex("8005284b014b02912e");p=p10_parse(b,s);p10_check(s,"frozenset_kind",pm_kind(&p,p.root),13);pm_close(&p);nio_free(b);
    b=p10_hex("800597982e");p=p10_parse(b,s);p10_check(s,"out_of_band_buffer_reference_recorded",p.external,1);p10_check(s,"readonly_wrapper_preserved",pm_kind(&p,p.root),20);pm_close(&p);nio_free(b);
    b=p10_hex("80054b07512e");p=p10_parse(b,s);p10_check(s,"persistent_reference_not_resolved",p.external,1);p10_check(s,"persistent_descriptor",pm_kind(&p,p.root),17);pm_close(&p);nio_free(b);
    b=p10_hex("800582012e");p=p10_parse(b,s);p10_check(s,"extension_registry_not_accessed",p.external,1);p10_check(s,"extension_descriptor",pm_kind(&p,p.root),18);pm_close(&p);nio_free(b);
}
fn p10_bad(text:[]u8,expected:i32,nodes:i32,edges:i32,memo:i32,stack:i32,s:*P10Stats)void {
    let b:[]u8=p10_hex(text);let p:ParentMap=pm_init(b,nodes,edges,memo,stack);
    p10_check(s,"malformed_or_capacity_refusal",pm_scan(&p),expected);p10_check(s,"no_usable_root_on_refusal",p.root,0);pm_close(&p);nio_free(b);
}
fn p10_refusals(s:*P10Stats)void {
    p10_bad("80064e2e",-8801,32,32,32,32,s);p10_bad("80054e",-8802,32,32,32,32,s);
    p10_bad("80052e",-8803,32,32,32,32,s);p10_bad("80054e2e00",-8803,32,32,32,32,s);
    p10_bad("800568002e",-8804,32,32,32,32,s);p10_bad("80054e710071002e",-8804,32,32,32,32,s);
    p10_bad("80057d284b01752e",-8803,32,32,32,32,s);p10_bad("80054b014b02612e",-8803,32,32,32,32,s);
    p10_bad("80054b017d622e",-8803,32,32,32,32,s);p10_bad("8005ff2e",-8806,32,32,32,32,s);
    p10_bad("8005430561622e",-8802,32,32,32,32,s);p10_bad("80058effffffffffffffff2e",-8802,32,32,32,32,s);
    p10_bad("80059503000000000000004e2e",-8802,32,32,32,32,s);
    p10_bad("8005950b000000000000009502000000000000004e2e",-8802,32,32,32,32,s);
    p10_bad("80059501000000000000004301612e",-8802,32,32,32,32,s);
    p10_bad("80054e4e862e",-8805,1,32,32,32,s);p10_bad("80054e4e862e",-8805,32,1,32,32,s);
    p10_bad("80054e944e94862e",-8805,32,32,1,32,s);p10_bad("80054e4e862e",-8805,32,32,32,1,s);
    p10_bad("80054e72ffffffff2e",-8805,32,32,32,32,s);p10_bad("80056affffffff2e",-8804,32,32,32,32,s);
    p10_bad("800549310a2e",-8806,32,32,32,32,s);
}
fn p10_words_equal(a:[]i64,b:[]i64,n:i32)i32 {
    if(n<0 || n>a.len || n>b.len){return 0;}let i:i32=0;while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn p10_compare(a:*ParentMap,b:*ParentMap,s:*P10Stats)void {
    p10_check(s,"same_node_count",a.*.node_count,b.*.node_count);p10_check(s,"same_edge_count",a.*.edge_count,b.*.edge_count);
    p10_check(s,"same_memo_count",a.*.memo_count,b.*.memo_count);p10_check(s,"same_memo_extent",a.*.memo_extent,b.*.memo_extent);
    p10_check(s,"same_globals",a.*.global_count,b.*.global_count);p10_check(s,"same_root",a.*.root,b.*.root);
    p10_check(s,"all_node_words_exact",p10_words_equal(a.*.nodes,b.*.nodes,a.*.node_count*10),1);
    p10_check(s,"all_relation_words_exact",p10_words_equal(a.*.edges,b.*.edges,a.*.edge_count*4),1);
    p10_check(s,"all_memo_words_exact",p10_words_equal(a.*.memo,b.*.memo,a.*.memo_extent),1);
    p10_check(s,"all_global_words_exact",p10_words_equal(a.*.globals,b.*.globals,a.*.global_count),1);
    p10_check(s,"all_opcode_counts_exact",p10_words_equal(a.*.hist,b.*.hist,256),1);
    s.*.words=s.*.words+(a.*.node_count as i64)*10+(a.*.edge_count as i64)*4+a.*.memo_extent+a.*.global_count+256;
    p10_check(s,"every_original_byte_exact",nio_equal(a.*.input,b.*.input),1);
}
fn p10_fixture_map(s:*P10Stats)void {
    let b:[]u8=p10_object_fixture(0);let p:ParentMap=p10_parse(b,s);let hash:[]u8=nio_alloc(32);ns_sha256(b,hash);
    let path:[]u8=p10_path("fixture-map");let pin:[]u8=mi_dump(&p,path,hash);p10_check(s,"fixture_manifest_hash_created",pin.len,32);
    let q:ParentMap=mi_load(path,hash,pin);p10_check(s,"fixture_map_reload",q.status,0);if(q.status==0){p10_compare(&p,&q,s);}mi_loaded_close(&q);
    let wrong:[]u8=nio_alloc(32);mi_copy(pin,wrong);wrong[0]=(wrong[0] as i32 ^ 1) as u8;q=mi_load(path,hash,wrong);
    p10_check(s,"wrong_manifest_identity_refused",q.status,-8813);p10_check(s,"wrong_manifest_no_root",q.root,0);mi_loaded_close(&q);
    nio_free(wrong);nio_free(path);nio_free(hash);nio_free(pin);pm_close(&p);nio_free(b);
}
fn p10_ascii(b:[]u8)i32 {if(b.len>160){return 0;}let i:i32=0;while(i<b.len){if(b[i]<32 || b[i]>126 || b[i]==44){return 0;}i=i+1;}return 1;}
fn p10_print_text(p:*ParentMap,id:i32)void {
    let b:[]u8=pm_raw(p,id);if(p10_ascii(b)==1){_zag_print(b);}else{_zag_print("RAW_SPAN_NODE_");_zag_print(_zag_i64_to_str(id as i64));}
}
fn p10_parent_identity(p:*ParentMap,s:*P10Stats)void {
    p10_check(s,"accepted_protocol5",p.*.protocol,5);p10_check(s,"accepted_parent_bytes",p.*.input.len,15871908);
    p10_check(s,"inherited_memo_inventory_reproduced",p.*.memo_count,175954);p10_check(s,"inherited_newobj_inventory_reproduced",p.*.newobjs,585);
    p10_check(s,"inherited_global_inventory_reproduced",p.*.global_count,64);p10_check(s,"root_newobj_descriptor",pm_kind(p,p.*.root),15);
    if(pm_kind(p,p.*.root)==15){let cls:i32=p.*.nodes[(p.*.root-1)*10+4] as i32;p10_check(s,"root_class_symbol",pm_kind(p,cls),14);
        if(pm_kind(p,cls)==14){p10_check(s,"root_module_exact",nio_equal(pm_raw(p,p.*.nodes[(cls-1)*10+4] as i32),"r27_experiments"),1);
            p10_check(s,"root_class_exact",nio_equal(pm_raw(p,p.*.nodes[(cls-1)*10+5] as i32),"R27State"),1);}}
    let state:i32=pm_build_state(p,p.*.root);p10_check(s,"stored_root_build_dictionary",pm_kind(p,state),11);
    if(pm_kind(p,state)==11){p10_check(s,"inherited_root_field_entries",p.*.nodes[(state-1)*10+9],14);}
    let value:i64=-1;p10_check(s,"step_field_is_encoded_integer",pm_small_int(p,pm_lookup(p,p.*.root,"development_step"),&value),0);
    p10_check(s,"canonical_step_preserved",value,60423);value=-1;
    p10_check(s,"restarts_field_is_encoded_integer",pm_small_int(p,pm_lookup(p,p.*.root,"newborn_restarts"),&value),0);p10_check(s,"zero_newborn_restarts",value,0);
    p10_check(s,"root_format_exact",nio_equal(pm_raw(p,pm_lookup(p,p.*.root,"format")),"TNN_PRE_V1_R27_GENERAL_LEARNING"),1);
    p10_check(s,"null_affordance_not_initialized",pm_kind(p,pm_lookup(p,p.*.root,"affordance_model")),1);
    p10_check(s,"null_decoder_not_initialized",pm_kind(p,pm_lookup(p,p.*.root,"speech_motif_decoder")),1);
}
fn p10_inventory(p:*ParentMap)void {
    let i:i32=0;while(i<p.*.global_count){let id:i32=p.*.globals[i] as i32;_zag_print("GLOBAL,");_zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
        p10_print_text(p,p.*.nodes[(id-1)*10+4] as i32);_zag_print(",");p10_print_text(p,p.*.nodes[(id-1)*10+5] as i32);_zag_println("");i=i+1;}
    let state:i32=pm_build_state(p,p.*.root);if(pm_kind(p,state)==11){let e:i32=p.*.nodes[(state-1)*10+7] as i32;
        while(e>0){let row:i32=(e-1)*4;let id:i32=p.*.edges[row+1] as i32;
            _zag_print("ROOT_FIELD,");p10_print_text(p,p.*.edges[row] as i32);_zag_print(",");_zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
            _zag_print(_zag_i64_to_str(pm_kind(p,id) as i64));_zag_print(",");_zag_println(_zag_i64_to_str(p.*.nodes[(id-1)*10+1]));e=p.*.edges[row+2] as i32;}}
    _zag_print("MAP_NODES,");_zag_println(_zag_i64_to_str(p.*.node_count as i64));_zag_print("MAP_RELATIONS,");_zag_println(_zag_i64_to_str(p.*.edge_count as i64));
    _zag_print("MAP_OPCODE_COUNT,");_zag_println(_zag_i64_to_str(p.*.op_count as i64));_zag_print("MAP_REDUCERS_RECORDED_NOT_CALLED,");_zag_println(_zag_i64_to_str(p.*.reductions as i64));
    _zag_print("MAP_UNRESOLVED_EXTERNAL_DESCRIPTORS,");_zag_println(_zag_i64_to_str(p.*.external as i64));
    i=0;while(i<256){if(p.*.hist[i]>0){_zag_print("OPCODE,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",");_zag_println(_zag_i64_to_str(p.*.hist[i]));}i=i+1;}
}
fn p10_parent(replay:i32,s:*P10Stats)void {
    let path:[]u8=p10_path("parent-map");let source_hash:[]u8=p10_source_hash();let run:i64=nio_open_root("Research/R33_NATIVE_N10_RUN_PRIMARY_V1");
    if(replay==0){let root:i64=nio_open_root("Research/R33_PARENT_RECOVERED_V1");let fd:i64=nio_open_child(root,"parent-r27-accepted-state.pkl",0);
        let raw:[]u8=nio_alloc(15871908);let got:i64=nio_read_exact(fd,raw,15871908);if(fd>=0){nio_close(fd);}if(root>=0){nio_close(root);}
        p10_check(s,"parent_read_exact",got,15871908);let actual:[]u8=nio_alloc(32);p10_check(s,"native_parent_sha",ns_sha256(raw,actual),0);
        p10_check(s,"accepted_parent_identity_before_parse",nio_equal(actual,source_hash),1);
        if(s.*.failed==0){let p:ParentMap=pm_init(raw,524288,1048576,262144,131072);let code:i32=pm_scan(&p);
            _zag_print("PARSER_FINAL_OFFSET,");_zag_println(_zag_i64_to_str(p.pos as i64));_zag_print("PARSER_FINAL_OPCODE,");_zag_println(_zag_i64_to_str(p.failed_opcode as i64));
            p10_check(s,"native_parent_inert_parse",code,0);
            if(code==0){p10_check(s,"all_parent_descriptors_valid",pm_validate(&p),0);p10_parent_identity(&p,s);p10_inventory(&p);
                p10_check(s,"native_parent_sha_after_parse",ns_sha256(raw,actual),0);p10_check(s,"parent_bytes_not_mutated",nio_equal(actual,source_hash),1);
                if(s.*.failed==0){let manifest_hash:[]u8=mi_dump(&p,path,source_hash);p10_check(s,"complete_native_map_bundle",manifest_hash.len,32);
                    if(manifest_hash.len==32){p10_check(s,"map_manifest_pin_retained",mi_write(run,"parent-map.sha256.bin",manifest_hash),0);let hex:[]u8=ns_hex(manifest_hash);
                        _zag_print("PARENT_MAP_MANIFEST_SHA256,");_zag_println(hex);nio_free(hex);}nio_free(manifest_hash);}}
            pm_close(&p);
        }nio_free(actual);nio_free(raw);
    }else{let expected:[]u8=nio_alloc(32);p10_check(s,"read_prior_map_manifest_pin",mi_read(run,"parent-map.sha256.bin",expected,32),32);
        let p:ParentMap=mi_load(path,source_hash,expected);p10_check(s,"fresh_native_bundle_load",p.status,0);
        if(p.status==0){p10_parent_identity(&p,s);let ecap:i32=p.edge_count;if(ecap<1){ecap=1;}let mcap:i32=p.memo_extent;if(mcap<1){mcap=1;}
            let q:ParentMap=pm_init(p.input,p.node_count,ecap,mcap,131072);p10_check(s,"fresh_reparse_of_reconstructed_exact_bytes",pm_scan(&q),0);
            if(q.status==0){p10_check(s,"fresh_reparse_invariants",pm_validate(&q),0);p10_compare(&p,&q,s);}pm_close(&q);
        }mi_loaded_close(&p);nio_free(expected);
    }nio_close(run);nio_free(path);nio_free(source_hash);
}
fn p10_corrupt(replay:i32,s:*P10Stats)void {
    let path:[]u8=p10_path("corrupt-map");let root:i64=nio_open_root("Research/R33_NATIVE_N10_RUN_PRIMARY_V1");let b:[]u8=p10_object_fixture(0);let hash:[]u8=nio_alloc(32);ns_sha256(b,hash);
    if(replay==0){let p:ParentMap=p10_parse(b,s);let pin:[]u8=mi_dump(&p,path,hash);p10_check(s,"corruption_fixture_bundle_created",pin.len,32);
        if(pin.len==32){p10_check(s,"corrupt_fixture_manifest_pin_saved",mi_write(root,"corrupt-map.sha256.bin",pin),0);let map:i64=nio_open_root(path);
            let raw:[]u8=nio_alloc(240064);let n:i64=mi_read(map,"nodes-1.bin",raw,240064);p10_check(s,"node_page_present",(n>64 && n<=240064) as i32,1);
            if(n>64 && n<=240064){p10_check(s,"node_page_preimage_saved",mi_write(map,"nodes-1.preimage",raw[0..n as i32]),0);
                let name:[]u8=nio_cstr("nodes-1.bin");let fd:i64=_zag_darwin_syscall(463,map,_zag_slice_ptr(name) as i64,16777478,0,0,0);nio_free(name);
                p10_check(s,"fixture_damage_handle",(fd>=0) as i32,1);if(fd>=0){raw[64]=(raw[64] as i32 ^ 1) as u8;
                    p10_check(s,"fixture_page_damage_written",nio_write_all(fd,raw[0..n as i32]),n);p10_check(s,"fixture_damage_synced",nio_sync(fd),0);nio_close(fd);}}
            nio_free(raw);nio_close(map);}nio_free(pin);pm_close(&p);
    }else{let pin:[]u8=nio_alloc(32);p10_check(s,"corrupt_fixture_pin_read",mi_read(root,"corrupt-map.sha256.bin",pin,32),32);
        let p:ParentMap=mi_load(path,hash,pin);p10_check(s,"corrupt_page_rejected",p.status,-8813);p10_check(s,"corrupt_map_no_root",p.root,0);
        p10_check(s,"corrupt_map_no_raw_output",p.input.len,0);mi_loaded_close(&p);nio_free(pin);}
    nio_free(path);nio_free(b);nio_free(hash);nio_close(root);
}
fn p10_has(b:[]u8,n:[]u8)i32 {let i:i32=0;while(i+n.len<=b.len){let k:i32=0;while(k<n.len && b[i+k]==n[k]){k=k+1;}if(k==n.len){return 1;}i=i+1;}return 0;}
fn p10_number(b:[]u8,prefix:[]u8,tail:[]u8)i64 {
    let value:i64=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i64=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<12){v=v*10+(b[at] as i64)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;
}
fn p10_run(root:i64,mode:[]u8,expected:i32,long:i32,s:*P10Stats)void {
    if(s.*.failed!=0){return;}let deadline:i64=5000;if(long==1){deadline=60000;}
    let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,deadline,262144);s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    p10_check(s,"child_status",r.status,0);p10_check(s,"child_started",r.started,1);p10_check(s,"child_reaped",r.reaped,1);
    p10_check(s,"child_exit",r.exit_code,expected);p10_check(s,"child_signal",r.signal,0);p10_check(s,"child_stderr_empty",r.stderr_bytes,0);
    p10_check(s,"declared_observed_child_rss",(r.peak_rss>0 && r.peak_rss<=536870912) as i32,1);
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(mode,".stdout");let got:i64=mi_read(root,name,b,262144);nio_free(name);
    p10_check(s,"complete_capture",got,r.stdout_bytes);if(got>=0 && got<=262144){let log:[]u8=b[0..got as i32];
        if(expected==0){p10_check(s,"child_terminal_pass",p10_has(log,"N10_CHILD_PASS\n"),1);let checks:i64=p10_number(log,"N10_CHILD_COUNTS,",",0\n");let words:i64=p10_number(log,"N10_TABLE_WORDS_COMPARED,","\n");
            p10_check(s,"native_counts_valid",(checks>0 && checks<=1000000 && words>=0) as i32,1);if(checks>0 && checks<=1000000){s.*.child_checks=s.*.child_checks+(checks as i32);}if(words>=0){s.*.words=s.*.words+words;}}
        else{p10_check(s,"invalid_mode_silent",got,0);}}
    nio_free(b);
}
fn p10_field(b:[]u8,k:[]u8,v:i64)[]u8 {let n:[]u8=_zag_i64_to_str(v);b=p10_join(b,k);b=p10_join(b,n);nio_free(n);return b;}
fn p10_supervise()i32 {
    if(nio_guard(180)!=0){return 3;}let a:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N10_RUN_PRIMARY_V1");if(a.status!=0){return 4;}
    let root:i64=a.root;let s:P10Stats=p10_stats();p10_run(root,"invalid",2,0,&s);p10_run(root,"scalars",0,0,&s);p10_run(root,"structure",0,0,&s);
    p10_run(root,"refusals",0,0,&s);p10_run(root,"fixture-map",0,0,&s);p10_run(root,"parent-map",0,1,&s);p10_run(root,"parent-reload",0,1,&s);
    p10_run(root,"corrupt-write",0,0,&s);p10_run(root,"corrupt-replay",0,0,&s);p10_check(&s,"all_nine_native_children_reaped",s.children,9);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N10\",\n  \"planned_children\":9","");
    json=p10_field(json,",\n  \"children_reaped\":",s.children);json=p10_field(json,",\n  \"parent_failures\":",s.failed);
    json=p10_field(json,",\n  \"verified_completed_child_checks\":",s.child_checks);json=p10_field(json,",\n  \"parent_checks_before_result_save\":",s.checks);
    json=p10_field(json,",\n  \"native_table_words_compared\":",s.words);json=p10_field(json,",\n  \"summed_child_cpu_us\":",s.cpu);
    json=p10_field(json,",\n  \"summed_observed_child_wall_us\":",s.wall);json=p10_field(json,",\n  \"peak_child_rss_bytes\":",s.rss);
    json=p10_join(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"python_execution\":false,\n  \"class_import_or_reducer_execution\":false,\n  \"original_behavior_recovered\":false,\n  \"full_parent_migration_verified\":false,\n  \"requires_terminal_marker\":true\n}\n");
    p10_check(&s,"native_result_saved",mi_write(root,"NATIVE_RESULT.json",json),0);_zag_print(json);nio_free(json);p10_check(&s,"close_root",nio_close(root),0);
    if(s.failed!=0){return 1;}_zag_println("R33_N10_NATIVE_INERT_PARENT_MAPPING_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);if(_zag_strcmp(mode,"supervise")==1){return p10_supervise();}
    if(_zag_strcmp(mode,"invalid")==1){return 2;}let seconds:i64=5;if(_zag_strcmp(mode,"parent-map")==1 || _zag_strcmp(mode,"parent-reload")==1){seconds=60;}
    if(nio_deadline(seconds)!=0){return 3;}let s:P10Stats=p10_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"scalars")==1){p10_scalars(&s);}else if(_zag_strcmp(mode,"structure")==1){p10_structure(&s);}else if(_zag_strcmp(mode,"refusals")==1){p10_refusals(&s);}
    else if(_zag_strcmp(mode,"fixture-map")==1){p10_fixture_map(&s);}else if(_zag_strcmp(mode,"parent-map")==1){p10_parent(0,&s);}else if(_zag_strcmp(mode,"parent-reload")==1){p10_parent(1,&s);}
    else if(_zag_strcmp(mode,"corrupt-write")==1){p10_corrupt(0,&s);}else if(_zag_strcmp(mode,"corrupt-replay")==1){p10_corrupt(1,&s);}else{handled=0;}
    if(handled==0){return 2;}_zag_print("N10_TABLE_WORDS_COMPARED,");_zag_println(_zag_i64_to_str(s.words));
    _zag_print("N10_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N10_CHILD_PASS");return 0;
}

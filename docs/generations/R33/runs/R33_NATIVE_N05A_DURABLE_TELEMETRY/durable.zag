// R33-N05A: bounded durable N04 telemetry plus exact, explicitly missing causal bytes.
// No learner or generated explanations. Imported implementations remain immutable.
@import("R33_NATIVE_TELEMETRY_V2.zag")
@import("R33_NATIVE_SHA256_V2.zag")

struct DurableTelemetry {
    root:i64, lock:i64, status:i32, count:i32, attempts:i32,
    incomplete:i32, unpublished:i32, last_attempt:i32,
    state:[]i32, causal:[]u8, head:[]u8,
}

fn dt_words(n:i32)[]i32 {
    let p:*i32=null as *i32;
    if(n<1 || n>16384){return p[0..0];}
    p=_zag_malloc(n*4) as *i32;if(p==null as *i32){return p[0..0];}
    let s:[]i32=p[0..n];let i:i32=0;while(i<n){s[i]=0;i=i+1;}return s;
}
fn dt_free_words(s:[]i32)void {if(s.len>0){_zag_free(_zag_slice_ptr(s));}}
fn dt_copy_words(a:[]i32,b:[]i32)i32 {
    if(a.len!=b.len){return -8102;}let i:i32=0;while(i<a.len){b[i]=a[i];i=i+1;}return 0;
}
fn dt_copy(a:[]u8,b:[]u8)i32 {
    if(b.len<a.len){return -8102;}let i:i32=0;while(i<a.len){b[i]=a[i];i=i+1;}return 0;
}
fn dt_zero(b:[]u8)i32 {let i:i32=0;while(i<b.len){if(b[i]!=0){return 0;}i=i+1;}return 1;}
fn dt_get(b:[]u8,at:i32)i32 {
    if(at<0 || b.len<4 || at>b.len-4){return -1;}
    let v:i64=(b[at] as i64)+(b[at+1] as i64)*256+(b[at+2] as i64)*65536+(b[at+3] as i64)*16777216;
    if(v>=2147483648){v=v-4294967296;}return v as i32;
}
fn dt_put(b:[]u8,at:i32,value:i32)i32 {
    if(at<0 || b.len<4 || at>b.len-4){return -8102;}
    let v:i64=value as i64;if(v<0){v=v+4294967296;}let i:i32=0;
    while(i<4){b[at+i]=(v%256) as u8;v=v/256;i=i+1;}return 0;
}
fn dt_encode(s:[]i32,b:[]u8)i32 {
    if(s.len<0 || s.len>16384 || b.len!=s.len*4){return -8102;}
    let i:i32=0;while(i<s.len){dt_put(b,i*4,s[i]);i=i+1;}return 0;
}
fn dt_decode(b:[]u8,s:[]i32)i32 {
    if(s.len<0 || s.len>16384 || b.len!=s.len*4){return -8102;}
    let i:i32=0;while(i<s.len){s[i]=dt_get(b,i*4);i=i+1;}return 0;
}
fn dt_overlap(ap:i64,an:i64,bp:i64,bn:i64)i32 {
    if(an<1 || bn<1){return 0;}
    if(ap<=bp){return ((bp-ap)<an) as i32;}return ((ap-bp)<bn) as i32;
}
fn dt_internal_alias(j:*DurableTelemetry,p:i64,n:i64)i32 {
    if(dt_overlap(p,n,_zag_slice_ptr(j.*.state) as i64,(j.*.state.len as i64)*4)==1 ||
       dt_overlap(p,n,_zag_slice_ptr(j.*.causal) as i64,j.*.causal.len as i64)==1 ||
       dt_overlap(p,n,_zag_slice_ptr(j.*.head) as i64,j.*.head.len as i64)==1){return 1;}
    return 0;
}
fn dt_name(prefix:[]u8,index:i32)[]u8 {
    let n:[]u8=_zag_i64_to_str(index as i64);let stem:[]u8=_zag_str_concat(prefix,n);
    let name:[]u8=_zag_str_concat(stem,".bin");nio_free(n);nio_free(stem);return name;
}
fn dt_open_index(root:i64,prefix:[]u8,index:i32,create:i32)i64 {
    let name:[]u8=dt_name(prefix,index);let fd:i64=nio_open_child(root,name,create);nio_free(name);return fd;
}
fn dt_invalid()DurableTelemetry {
    let p:*i32=null as *i32;
    return DurableTelemetry{.root=-1,.lock=-1,.status=-8108,.count=0,.attempts=0,
        .incomplete=0,.unpublished=0,.last_attempt=0,.state=p[0..0],.causal="",.head=""};
}
fn dt_close(j:*DurableTelemetry)void {
    if(j.*.lock>=0){nio_close(j.*.lock);}if(j.*.root>=0){nio_close(j.*.root);}
    j.*.root=-1;j.*.lock=-1;dt_free_words(j.*.state);nio_free(j.*.causal);nio_free(j.*.head);
    let p:*i32=null as *i32;j.*.state=p[0..0];j.*.causal="";j.*.head="";
    j.*.count=0;j.*.attempts=0;j.*.incomplete=0;j.*.unpublished=0;j.*.last_attempt=0;
}
fn dt_root_record(config:[]i32)[]u8 {
    if(config.len!=6 || config[0]<1 || config[0]>16){return "";}
    let i:i32=1;while(i<6){if(config[i]<=0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(128);if(b.len!=128){return "";}
    dt_copy("TNNDT001",b);dt_put(b,8,1);dt_put(b,12,128);
    i=0;while(i<6){dt_put(b,16+i*4,config[i]);i=i+1;}
    dt_put(b,40,88);dt_put(b,44,1152);dt_put(b,48,32);
    if(ns_sha256(b[0..96],b[96..128])!=0){nio_free(b);return "";}return b;
}
fn dt_create(path:[]u8,config:[]i32)i32 {
    let b:[]u8=dt_root_record(config);if(b.len!=128){return -8102;}
    if(nio_mkdir(path)!=0){nio_free(b);return -8108;}
    let root:i64=nio_open_root(path);if(root<0){nio_free(b);return -8108;}
    let lock:i64=nio_open_child(root,"writer.lock",1);let fd:i64=nio_open_child(root,"root.bin",1);
    let code:i32=0;
    if(lock<0 || fd<0){code=-8108;}else{
        if(nio_regular(lock)!=1 || nio_regular(fd)!=1 || nio_write_all(fd,b)!=128 ||
           nio_sync(fd)!=0 || nio_sync(lock)!=0 || nio_sync(root)!=0){code=-8108;}
    }
    if(lock>=0){if(nio_close(lock)!=0){code=-8108;}}
    if(fd>=0){if(nio_close(fd)!=0){code=-8108;}}
    if(nio_close(root)!=0){code=-8108;}nio_free(b);return code;
}

// 6 fixed-role slots. Missing = length -1, status 0, all remaining bytes zero.
// Present = status 1, length 1..64, SHA256 and exact bytes, zero tail/reserved.
fn dt_causal_check(c:[]u8)i32 {
    if(c.len!=672){return -8102;}let h:[]u8=nio_alloc(32);if(h.len!=32){return -8108;}
    let code:i32=0;let i:i32=0;
    while(i<6 && code==0){let at:i32=i*112;let n:i32=dt_get(c,at);let status:i32=dt_get(c,at+4);
        if(n==-1){if(status!=0 || dt_zero(c[at+8..at+112])!=1){code=-8102;}}
        else{
            if(n<1 || n>64 || status!=1){code=-8102;}
            else{if(dt_zero(c[at+40+n..at+112])!=1){code=-8102;}
                else{if(ns_sha256(c[at+40..at+40+n],h)!=0){code=-8108;}
                    else{if(nio_equal(h,c[at+8..at+40])!=1){code=-8103;}}
                }
            }
        }i=i+1;
    }nio_free(h);return code;
}
fn dt_digest(b:[]u8,out:[]u8)i32 {
    if(b.len!=1152 || out.len!=32){return -8102;}
    let s:[]u8=nio_alloc(1120);if(s.len!=1120){return -8108;}
    dt_copy(b[0..64],s);dt_copy(b[96..1152],s[64..1120]);
    let code:i32=ns_sha256(s,out);nio_free(s);if(code!=0){return -8108;}return 0;
}
fn dt_frame_check(b:[]u8)i32 {
    if(b.len!=1152){return -8101;}
    if(nio_equal(b[0..8],"TNNDTE01")!=1 || dt_get(b,8)!=1 || dt_get(b,12)!=1152 ||
       dt_zero(b[96..128])!=1){return -8101;}
    let h:[]u8=nio_alloc(32);if(h.len!=32){return -8108;}
    let code:i32=dt_digest(b,h);if(code==0 && nio_equal(h,b[64..96])!=1){code=-8103;}
    nio_free(h);if(code!=0){return code;}return dt_causal_check(b[480..1152]);
}

fn dt_recover(path:[]u8,config:[]i32)DurableTelemetry {
    let j:DurableTelemetry=dt_invalid();let expected:[]u8=dt_root_record(config);
    if(expected.len!=128){j.status=-8102;return j;}
    j.root=nio_open_root(path);if(j.root<0){nio_free(expected);dt_close(&j);return j;}
    j.lock=nio_open_child(j.root,"writer.lock",0);
    if(j.lock<0 || nio_regular(j.lock)!=1){nio_free(expected);dt_close(&j);return j;}
    if(nio_lock(j.lock)!=0){nio_free(expected);dt_close(&j);j.status=-8109;return j;}
    let stored:[]u8=nio_alloc(128);let fd:i64=nio_open_child(j.root,"root.bin",0);
    if(stored.len!=128 || fd<0){if(fd>=0){nio_close(fd);}nio_free(stored);nio_free(expected);dt_close(&j);return j;}
    let got:i64=nio_read_exact(fd,stored,128);let closed:i64=nio_close(fd);
    if(got!=128 || closed!=0 || nio_equal(stored,expected)!=1){nio_free(stored);nio_free(expected);dt_close(&j);j.status=-8101;return j;}
    nio_free(stored);
    j.state=dt_words(16+config[0]*88);j.causal=nio_alloc(config[0]*672);j.head=nio_alloc(32);
    let record:[]u8=nio_alloc(1152);let other:[]u8=nio_alloc(1152);
    let e:[]i32=dt_words(88);let mapped:[]i32=dt_words(33);
    if(j.state.len!=16+config[0]*88 || j.causal.len!=config[0]*672 || j.head.len!=32 ||
       record.len!=1152 || other.len!=1152 || e.len!=88 || mapped.len!=33){j.status=-8108;}
    else{j.status=0;if(tm_init(j.state,config[0],config[1],config[2],config[3],config[4],config[5])!=0 ||
       ns_sha256(expected,j.head)!=0){j.status=-8108;}}
    nio_free(expected);let index:i32=1;let gap:i32=0;
    while(index<=config[0]+1 && j.status==0){
        fd=dt_open_index(j.root,"event-",index,0);
        if(fd==-2){gap=1;}else{
            if(fd<0){j.status=-8108;}else{
                if(index>config[0]){j.status=-8105;}else{if(gap==1){j.status=-8104;}
                    else{if(nio_read_exact(fd,record,1152)!=1152){j.status=-8101;}
                        else{j.status=dt_frame_check(record);}
                    }
                }
                if(nio_close(fd)!=0 && j.status==0){j.status=-8108;}
                if(j.status==0){let attempt:i32=dt_get(record,20);
                    if(dt_get(record,16)!=index || dt_get(record,28)!=j.count ||
                       attempt<=j.last_attempt || attempt>32 || nio_equal(record[32..64],j.head)!=1){j.status=-8104;}
                    else{dt_decode(record[128..480],e);
                        if(dt_get(record,24)!=e[1] || tm_append(j.state,e)!=0){j.status=-8104;}
                        else{mapped[attempt]=index;j.last_attempt=attempt;
                            dt_copy(record[480..1152],j.causal[j.count*672..(j.count+1)*672]);
                            dt_copy(record[64..96],j.head);j.count=j.count+1;
                        }
                    }
                }
            }
        }index=index+1;
    }
    index=1;gap=0;
    while(index<=33 && j.status==0){
        fd=dt_open_index(j.root,"attempt-",index,0);
        if(fd==-2){gap=1;}else{
            if(fd<0){j.status=-8108;}else{
                if(gap==1 || index>32){j.status=-8105;}
                else{got=nio_read_exact(fd,record,1152);
                    if(got<0 || got>1152){j.status=-8101;}
                    else{j.attempts=j.attempts+1;
                        if(mapped[index]>0){
                            let ev:i64=dt_open_index(j.root,"event-",mapped[index],0);
                            if(ev<0){j.status=-8104;}else{
                                let n:i64=nio_read_exact(ev,other,1152);nio_close(ev);
                                if(got!=1152 || n!=1152 || nio_equal(record,other)!=1){j.status=-8104;}
                            }
                        }else{
                            j.unpublished=j.unpublished+1;
                            if(got<1152){j.incomplete=j.incomplete+1;}
                            else{j.status=dt_frame_check(record);
                                if(j.status==0 && (dt_get(record,20)!=index || dt_get(record,16)!=dt_get(record,28)+1 ||
                                   dt_get(record,28)<0 || dt_get(record,28)>j.count)){j.status=-8104;}
                            }
                        }
                    }
                }
                if(nio_close(fd)!=0 && j.status==0){j.status=-8108;}
            }
        }index=index+1;
    }
    if(j.status==0 && (j.attempts<j.last_attempt || j.attempts-j.count!=j.unpublished)){j.status=-8104;}
    nio_free(record);nio_free(other);dt_free_words(e);dt_free_words(mapped);
    if(j.status!=0){let code:i32=j.status;dt_close(&j);j.status=code;}return j;
}

// Normal callers cannot request faults. Diagnostic seams are separately named.
fn dt_append(j:*DurableTelemetry,e:[]i32,c:[]u8,parent:i32)i32 {
    return dt_append_diagnostic(j,e,c,parent,0);
}
fn dt_append_diagnostic(j:*DurableTelemetry,e:[]i32,c:[]u8,parent:i32,fault:i32)i32 {
    if(j.*.status!=0 || j.*.root<0 || j.*.lock<0){return -8108;}
    if(e.len!=88 || c.len!=672 || fault<0 || fault>9){return -8102;}
    if(dt_internal_alias(j,_zag_slice_ptr(e) as i64,352)==1 ||
       dt_internal_alias(j,_zag_slice_ptr(c) as i64,672)==1){return -8110;}
    if(parent!=j.*.count){return -8106;}
    let i:i32=0;while(i<j.*.count){if(j.*.state[16+i*88+1]==e[1]){return -8107;}i=i+1;}
    if(j.*.count>=j.*.state[2] || j.*.attempts>=32){return -8105;}
    let code:i32=dt_causal_check(c);if(code!=0){return code;}
    let stage:[]i32=dt_words(j.*.state.len);let b:[]u8=nio_alloc(1152);
    if(stage.len!=j.*.state.len || b.len!=1152){dt_free_words(stage);nio_free(b);return -8108;}
    dt_copy_words(j.*.state,stage);
    if(tm_append(stage,e)!=0){dt_free_words(stage);nio_free(b);return -8104;}
    let attempt:i32=j.*.attempts+1;
    dt_copy("TNNDTE01",b);dt_put(b,8,1);dt_put(b,12,1152);dt_put(b,16,j.*.count+1);
    dt_put(b,20,attempt);dt_put(b,24,e[1]);dt_put(b,28,parent);dt_copy(j.*.head,b[32..64]);
    dt_encode(e,b[128..480]);dt_copy(c,b[480..1152]);
    if(dt_digest(b,b[64..96])!=0){dt_free_words(stage);nio_free(b);return -8108;}
    let fd:i64=dt_open_index(j.*.root,"attempt-",attempt,1);
    if(fd<0){dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8108;}
    j.*.attempts=attempt;j.*.unpublished=j.*.unpublished+1;
    if(nio_regular(fd)!=1 || nio_sync(j.*.root)!=0){nio_close(fd);dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8108;}
    if(fault==1){_zag_println("N05A_CRASH,1");_zag_exit(73);}
    if(fault==2 || fault==6 || fault==7){
        let written:i64=nio_write_all(fd,b[0..576]);let synced:i64=nio_sync(fd);let closed:i64=nio_close(fd);
        dt_free_words(stage);nio_free(b);j.*.status=-8108;j.*.incomplete=j.*.incomplete+1;
        if(written!=576 || synced!=0 || closed!=0){return -8108;}
        if(fault==2){_zag_println("N05A_CRASH,2");_zag_exit(73);}
        if(fault==7){_zag_println("N05A_HALF_WRITE_READY_FOR_SIGKILL");while(1==1){}}
        return -8111;
    }
    let written:i64=nio_write_all(fd,b);let synced:i64=nio_sync(fd);let closed:i64=nio_close(fd);
    if(written!=1152 || synced!=0 || closed!=0){dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8108;}
    if(fault==3){_zag_println("N05A_CRASH,3");_zag_exit(73);}
    if(fault==8){dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8113;}
    let from:[]u8=dt_name("attempt-",attempt);let to:[]u8=dt_name("event-",j.*.count+1);
    let linked:i64=nio_link(j.*.root,from,to);nio_free(from);nio_free(to);
    if(linked!=0){dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8108;}
    if(fault==4){_zag_println("N05A_CRASH,4");_zag_exit(73);}
    if(fault==9 || nio_sync(j.*.root)!=0){dt_free_words(stage);nio_free(b);j.*.status=-8108;return -8112;}
    if(fault==5){_zag_println("N05A_CRASH,5");_zag_exit(73);}
    dt_copy_words(stage,j.*.state);dt_copy(c,j.*.causal[j.*.count*672..(j.*.count+1)*672]);
    dt_copy(b[64..96],j.*.head);j.*.count=j.*.count+1;j.*.last_attempt=attempt;
    j.*.unpublished=j.*.unpublished-1;dt_free_words(stage);nio_free(b);return 0;
}

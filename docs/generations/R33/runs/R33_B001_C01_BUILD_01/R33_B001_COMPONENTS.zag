// R33 native substrate candidate, not installed into any accepted brain.
// All mutation is caller-owned fixture/storage state. No learner authority.
// Byte-carrier arrays contain i32 values 0..255; this is NOT an OS device driver.
// Status 0=complete, -1=malformed, -2=capacity, -3=version/order, -4=alias.

const R33_RAW_BYTE_LIMIT:i32=131072;
const R33_CODE_LIMIT:i32=256;
const R33_CHUNK_SLOTS:i32=8;
const R33_CHUNK_WIDTH:i32=16;

fn r33_arrays_disjoint(a:[]i32,b:[]i32)i32 {
    let i:i32=0;
    while(i<a.len){
        let j:i32=0;
        while(j<b.len){if(&a[i]==&b[j]){return 0;}j=j+1;}
        i=i+1;
    }
    return 1;
}

// Exact copy of the entire source or explicit failure before any output write.
// Staging preserves source-before-call semantics even for overlapping slices.
fn r33_exact_copy(source:[]i32,destination:[]i32)i32 {
    if(source.len>R33_RAW_BYTE_LIMIT){return -1;}
    if(destination.len<source.len){return -2;}
    let stage:[]i32=zalloc_i(source.len);
    let i:i32=0;
    while(i<source.len){stage[i]=source[i];i=i+1;}
    i=0;while(i<source.len){destination[i]=stage[i];i=i+1;}
    zfree(stage);
    return 0;
}

// Caller supplies physical format metadata. No rate conversion or segmentation.
fn r33_pcm16le_decode(bytes:[]i32,samples:[]i32,channels:i32,rate:i32)i32 {
    if(channels<1 || channels>2 || rate<8000 || rate>192000){return -1;}
    if(bytes.len>R33_RAW_BYTE_LIMIT || bytes.len-(bytes.len/2)*2!=0){return -1;}
    let count:i32=bytes.len/2;
    if(count-(count/channels)*channels!=0){return -1;}
    if(samples.len<count){return -2;}
    let i:i32=0;
    while(i<bytes.len){if(bytes[i]<0 || bytes[i]>255){return -1;}i=i+1;}
    let stage:[]i32=zalloc_i(count);
    i=0;
    while(i<count){
        let value:i32=bytes[i*2]+256*bytes[i*2+1];
        if(value>=32768){value=value-65536;}
        stage[i]=value;i=i+1;
    }
    i=0;while(i<count){samples[i]=stage[i];i=i+1;}
    zfree(stage);
    return 0;
}

fn r33_pcm16le_encode(samples:[]i32,bytes:[]i32)i32 {
    if(samples.len>R33_RAW_BYTE_LIMIT/2){return -1;}
    if(bytes.len<samples.len*2){return -2;}
    let i:i32=0;
    while(i<samples.len){if(samples[i]<-32768 || samples[i]>32767){return -1;}i=i+1;}
    let stage:[]i32=zalloc_i(samples.len*2);
    i=0;
    while(i<samples.len){
        let value:i32=samples[i];if(value<0){value=value+65536;}
        stage[i*2]=value-(value/256)*256;stage[i*2+1]=value/256;i=i+1;
    }
    i=0;while(i<samples.len*2){bytes[i]=stage[i];i=i+1;}
    zfree(stage);
    return 0;
}

// Bounded RGB8 interleaved frame transport. Pixel order and every channel survive.
fn r33_rgb8_ingest(bytes:[]i32,pixels:[]i32,width:i32,height:i32)i32 {
    if(width<1 || width>64 || height<1 || height>64){return -1;}
    let count:i32=width*height*3;
    if(bytes.len!=count){return -1;}
    if(pixels.len<count){return -2;}
    let i:i32=0;while(i<count){if(bytes[i]<0 || bytes[i]>255){return -1;}i=i+1;}
    return r33_exact_copy(bytes,pixels);
}

// Cursor = physical clock ID, next ordinal, last tick. Equal ticks are allowed;
// duplicate/out-of-order ordinals, backwards ticks or clock switches are refused.
// i32 tick/ordinal envelope is explicit; overflow rejects, never wraps.
fn r33_order_accept(cursor:[]i32,clock:i32,ordinal:i32,tick:i32)i32 {
    if(cursor.len!=3 || clock<0 || ordinal<0 || tick<0){return -1;}
    if(cursor[0]<0 || cursor[1]<0 || cursor[2]<-1){return -1;}
    if(ordinal>=2147483647){return -1;}
    if(clock!=cursor[0] || ordinal!=cursor[1] || tick<cursor[2]){return -3;}
    cursor[1]=ordinal+1;cursor[2]=tick;return 0;
}

// Return an unprotected slot; -1 means no candidate, -2 means malformed input.
// Unlike the historical helper, all-protected storage is never a fallback target.
fn r33_protected_lru(ages:[]i32,protected:[]i32,count:i32)i32 {
    if(count<0 || count>ages.len || count>protected.len){return -2;}
    let i:i32=0;
    while(i<count){
        if(ages[i]<0 || protected[i]<0 || protected[i]>1){return -2;}
        i=i+1;
    }
    let best:i32=-1;i=0;
    while(i<count){
        if(protected[i]==0){
            if(best<0){best=i;}
            else{if(ages[i]<ages[best]){best=i;}}
        }
        i=i+1;
    }
    return best;
}

struct R33ChunkBook {
    lengths:[]i32,
    values:[]i32,
    count:i32,
    version:i32,
}

// Separate kind/value avoids overloading signed raw PCM as negative chunk IDs.
// kind0 is a literal of any i32 value; kind1 is an index into the frozen codebook.
fn r33_reconstruct_exact(kinds:[]i32,values:[]i32,book:R33ChunkBook,expected_version:i32,output:[]i32)i32 {
    if(kinds.len!=values.len || kinds.len>R33_CODE_LIMIT){return -1;}
    if(book.count<0 || book.count>R33_CHUNK_SLOTS || book.version<0){return -1;}
    if(book.lengths.len<book.count || book.values.len<book.count*R33_CHUNK_WIDTH){return -1;}
    if(expected_version!=book.version){return -3;}
    if(r33_arrays_disjoint(output,book.lengths)!=1 || r33_arrays_disjoint(output,book.values)!=1){return -4;}
    let i:i32=0;
    while(i<book.count){if(book.lengths[i]<1 || book.lengths[i]>R33_CHUNK_WIDTH){return -1;}i=i+1;}
    let total:i32=0;i=0;
    while(i<kinds.len){
        let length:i32=1;
        if(kinds[i]==1){
            if(values[i]<0 || values[i]>=book.count){return -1;}
            length=book.lengths[values[i]];
        }else{if(kinds[i]!=0){return -1;}}
        if(length>output.len-total){return -2;}
        total=total+length;i=i+1;
    }
    let stage:[]i32=zalloc_i(total);let at:i32=0;i=0;
    while(i<kinds.len){
        if(kinds[i]==0){stage[at]=values[i];at=at+1;}
        else{
            let chunk:i32=values[i];let j:i32=0;
            while(j<book.lengths[chunk]){stage[at]=book.values[chunk*R33_CHUNK_WIDTH+j];at=at+1;j=j+1;}
        }
        i=i+1;
    }
    i=0;while(i<total){output[i]=stage[i];i=i+1;}
    zfree(stage);return 0;
}

// State = value, version, log count. A five-i32 log record = event, parent,
// old value, new value, version. This is SINGLE-PROCESS IN-MEMORY ordering,
// not disk durability, atomic concurrency, authenticated authority or rollback.
fn r33_commit_logged(state:[]i32,log:[]i32,expected_version:i32,next_value:i32)i32 {
    if(state.len!=3 || log.len-(log.len/5)*5!=0 || log.len>40960){return -1;}
    if(r33_arrays_disjoint(state,log)!=1){return -4;}
    let count:i32=state[2];let version:i32=state[1];
    if(count<0 || count>log.len/5 || version<0 || version>=2147483647){return -1;}
    if(version!=expected_version){return -3;}
    if(count>0){if(log[(count-1)*5+4]!=version || log[(count-1)*5+3]!=state[0]){return -1;}}
    if(count>=log.len/5){return -2;}
    let at:i32=count*5;
    log[at]=version+1;log[at+1]=version;log[at+2]=state[0];
    log[at+3]=next_value;log[at+4]=version+1;
    state[0]=next_value;state[1]=version+1;state[2]=count+1;
    return 0;
}

@import("../R33_NATIVE_SHA256_V2.zag")
@import("r27_native_state_semantics_v4.zag")

// Checksum-bound wrapper for one complete V4 learner image.
// Layout: 32-byte header + 245,472-byte image + 32-byte SHA-256 = 245,536.

const R33CLA1_OK:i32=0;
const R33CLA1_VERSION:i32=1;
const R33CLA1_HEADER_BYTES:i32=32;
const R33CLA1_DIGEST_BYTES:i32=32;
const R33CLA1_IMAGE_BYTES:i32=245472;
const R33CLA1_PACKET_BYTES:i32=245536;

fn r33cla1_ok()i32 @noalloc {return 0;}
fn r33cla1_expected_bytes()i32 @noalloc {return R33CLA1_PACKET_BYTES;}

fn r33cla1_copy(out:[]u8,input:[]u8)i32 @noalloc {
    if(out.len!=input.len){return -1;}let i:i32=0;while(i<out.len){out[i]=input[i];i=i+1;}return 0;
}

fn r33cla1_zero(b:[]u8)i32 @noalloc {
    let i:i32=0;while(i<b.len){if(b[i]!=0){return 0;}i=i+1;}return 1;
}

fn r33cla1_magic_ok(packet:[]u8)i32 @noalloc {
    if(packet.len<8){return 0;}
    if(packet[0]!=82 || packet[1]!=51 || packet[2]!=51 || packet[3]!=67 ||
       packet[4]!=76 || packet[5]!=65 || packet[6]!=48 || packet[7]!=49){return 0;}
    return 1;
}

fn r33cla1_write_magic(packet:[]u8)i32 @noalloc {
    if(packet.len<8){return -1;}
    packet[0]=82;packet[1]=51;packet[2]=51;packet[3]=67;
    packet[4]=76;packet[5]=65;packet[6]=48;packet[7]=49;return 0;
}

fn r33cla1_pack(packet:[]u8,image:[]u8)i32 {
    if(packet.len!=R33CLA1_PACKET_BYTES || image.len!=R33CLA1_IMAGE_BYTES || r27sv4_validate(image)!=0){return -1;}
    let i:i32=0;while(i<packet.len){packet[i]=0;i=i+1;}
    if(r33cla1_write_magic(packet)!=0 || r27s4_put_i32(packet,8,R33CLA1_VERSION)!=0 ||
       r27s4_put_i32(packet,12,image.len)!=0 || r33cla1_copy(packet[32..32+image.len],image)!=0){return -1;}
    if(ns_sha256(packet[0..R33CLA1_PACKET_BYTES-R33CLA1_DIGEST_BYTES],packet[R33CLA1_PACKET_BYTES-R33CLA1_DIGEST_BYTES..R33CLA1_PACKET_BYTES])!=0){return -1;}
    return R33CLA1_OK;
}

fn r33cla1_check(packet:[]u8)i32 {
    if(packet.len!=R33CLA1_PACKET_BYTES || r33cla1_magic_ok(packet)!=1){return -1;}
    let version:i32=0;let payload_bytes:i32=0;
    if(r27s4_get_i32(packet,8,&version)!=0 || r27s4_get_i32(packet,12,&payload_bytes)!=0){return -1;}
    if(version!=R33CLA1_VERSION || payload_bytes!=R33CLA1_IMAGE_BYTES || r33cla1_zero(packet[16..32])!=1){return -1;}
    let expected:[]u8=nio_alloc(32);
    if(expected.len!=32){return -1;}
    if(ns_sha256(packet[0..R33CLA1_PACKET_BYTES-R33CLA1_DIGEST_BYTES],expected)!=0){nio_free(expected);return -1;}
    let digest_ok:i32=1;let i:i32=0;
    while(i<32){if(expected[i]!=packet[R33CLA1_PACKET_BYTES-R33CLA1_DIGEST_BYTES+i]){digest_ok=0;i=32;}else{i=i+1;}}
    nio_free(expected);if(digest_ok!=1){return -1;}
    if(r27sv4_validate(packet[R33CLA1_HEADER_BYTES..R33CLA1_HEADER_BYTES+R33CLA1_IMAGE_BYTES])!=0){return -1;}
    return R33CLA1_OK;
}

fn r33cla1_extract(packet:[]u8)[]u8 {
    if(r33cla1_check(packet)!=R33CLA1_OK){return "";}
    return packet[R33CLA1_HEADER_BYTES..R33CLA1_HEADER_BYTES+R33CLA1_IMAGE_BYTES];
}

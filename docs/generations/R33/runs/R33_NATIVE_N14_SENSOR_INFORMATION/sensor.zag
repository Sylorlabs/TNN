// N06 byte-originated sensor/observer engineering. No learner or policy.
// N05B journal and C02 packet validator are immutable imported components.
@import("durable.zag")
@import("R33_B001_RAW_RECORD.zag")

struct SensorPacket { status:i32, raw:[]u8 }
fn sn_words(n:i32)[]i32 {
    let p:*i32=null as *i32;if(n<1 || n>65537){return p[0..0];}
    let s:[]i32=zalloc_i(n);let i:i32=0;while(i<s.len){s[i]=0;i=i+1;}return s;
}
fn sn_packet_failure(code:i32)SensorPacket {return SensorPacket{.status=code,.raw=""};}

// Blob reservations do not rewind when a telemetry attempt fails or never starts.
// Registered namespace is blob-1.bin..blob-33.bin; limit is 32.
fn sn_blob_count(j:*DurableTelemetry)i32 {
    if(j.*.status!=0 || j.*.root<0){return -8208;}
    let count:i32=0;let gap:i32=0;let i:i32=1;
    while(i<=33){let fd:i64=dt_open_index(j.*.root,"blob-",i,0);
        if(fd==-2){gap=1;}else{
            if(fd<0){return -8208;}
            let size:i64=nio_seek(fd,0,2);let regular:i32=nio_regular(fd);let closed:i64=nio_close(fd);
            if(regular!=1 || size<0 || size>131136 || closed!=0){return -8201;}
            if(gap==1){return -8204;}if(i>32){return -8205;}count=count+1;
        }i=i+1;
    }return count;
}
fn sn_packet_check(j:*DurableTelemetry,index:i32,raw:[]u8)i32 {
    let status:i32=rr_packet_validate(raw);
    if(status==-5){return -8203;}if(status!=0){return -8201;}
    if(rr_get32(raw,36)!=j.*.state[8] || rr_get32(raw,40)!=index ||
       rr_get32(raw,48)!=1000000){return -8204;}
    return 0;
}
fn sn_load(j:*DurableTelemetry,index:i32)SensorPacket {
    if(j.*.status!=0 || j.*.root<0 || index<0 || index>=j.*.count){return sn_packet_failure(-8204);}
    let slot:i32=index*672;let event:i32=16+index*88;
    if(dt_get(j.*.causal,slot)!=36 || dt_get(j.*.causal,slot+4)!=1 ||
       j.*.state[event+11]!=1){return sn_packet_failure(-8204);}
    let blob:i32=dt_get(j.*.causal,slot+40);
    if(blob<1 || blob>32){return sn_packet_failure(-8204);}
    let fd:i64=dt_open_index(j.*.root,"blob-",blob,0);if(fd<0){return sn_packet_failure(-8206);}
    let bytes:[]u8=nio_alloc(131136);let got:i64=nio_read_exact(fd,bytes,131136);let closed:i64=nio_close(fd);
    if(got<64 || got>131136 || closed!=0){nio_free(bytes);return sn_packet_failure(-8201);}
    let raw:[]u8=bytes[0..got as i32];let code:i32=sn_packet_check(j,index,raw);
    let hash:[]u8=nio_alloc(32);
    if(code==0 && (ns_sha256(raw,hash)!=0 || nio_equal(hash,j.*.causal[slot+44..slot+76])!=1)){code=-8203;}
    if(code==0 && j.*.state[event+10]!=rr_get32(raw,44)){code=-8204;}
    if(code==0){
        if(ns_sha256(raw[64..raw.len],hash)!=0){code=-8208;}
        else{let k:i32=0;while(k<32){if(j.*.state[event+40+k]!=(hash[k] as i32)){code=-8203;}k=k+1;}}
    }
    nio_free(hash);if(code!=0){nio_free(bytes);return sn_packet_failure(code);}
    return SensorPacket{.status=0,.raw=raw};
}
fn sn_open(path:[]u8,config:[]i32)DurableTelemetry {
    let j:DurableTelemetry=dt_recover(path,config);if(j.status!=0){return j;}
    let blobs:i32=sn_blob_count(&j);let code:i32=0;
    if(blobs<0){code=blobs;}else if(blobs<j.count){code=-8204;}
    let previous:i32=0;let i:i32=0;
    while(i<j.count && code==0){
        let blob:i32=dt_get(j.causal,i*672+40);
        if(blob<=previous || blob>blobs){code=-8204;}else{
            let packet:SensorPacket=sn_load(&j,i);code=packet.status;nio_free(packet.raw);
        }previous=blob;i=i+1;
    }
    if(code!=0){dt_close(&j);j.status=code;}return j;
}

// No mutation or observer delivery until the raw bytes and telemetry commit exist.
fn sn_append(j:*DurableTelemetry,raw:[]u8)i32 {return sn_append_diagnostic(j,raw,0);}
fn sn_append_diagnostic(j:*DurableTelemetry,raw:[]u8,fault:i32)i32 {
    if(j.*.status!=0 || j.*.root<0){return -8208;}
    if(fault<0 || fault>2){return -8201;}
    if(dt_internal_alias(j,_zag_slice_ptr(raw) as i64,raw.len as i64)==1){return -8210;}
    let n:i32=j.*.count;let checked:i32=sn_packet_check(j,n,raw);if(checked!=0){return checked;}
    if(n>0 && rr_get32(raw,44)<j.*.state[16+(n-1)*88+10]){return -8204;}
    let blobs:i32=sn_blob_count(j);if(blobs<0){return blobs;}
    if(n>=j.*.state[2] || j.*.attempts>=32 || blobs>=32){return -8205;}
    let e:[]i32=dt_words(88);let c:[]u8=nio_alloc(672);let h:[]u8=nio_alloc(32);
    e[0]=1;e[1]=n+1;e[2]=n;e[3]=n-1;e[4]=n-1;
    let k:i32=0;while(k<5){e[5+k]=j.*.state[4+k];k=k+1;}
    e[10]=rr_get32(raw,44);e[11]=1;e[12]=n+1;e[13]=n+1;e[14]=1;e[15]=700;
    e[17]=0;e[18]=-1;e[25]=-1;e[26]=-1;e[37]=-1;
    k=31;while(k<=36){e[k]=-1;k=k+1;}k=72;while(k<88){e[k]=-1;k=k+1;}
    let status:i32=ns_sha256(raw[64..raw.len],h);
    k=0;while(k<32){e[40+k]=h[k] as i32;k=k+1;}
    e[19]=1;if(tm_payload_seen(j.*.state,n,e,0)==1){e[19]=2;}
    k=0;while(k<6){dt_put(c,k*112,-1);k=k+1;}
    dt_put(c,0,36);dt_put(c,4,1);dt_put(c,40,blobs+1);
    if(ns_sha256(raw,c[44..76])!=0 || ns_sha256(c[40..76],c[8..40])!=0){status=-8208;}
    if(status==0 && tm_event_check(j.*.state,n,e,0)!=0){status=-8204;}
    if(status!=0){dt_free_words(e);nio_free(c);nio_free(h);return status;}
    let fd:i64=dt_open_index(j.*.root,"blob-",blobs+1,1);
    if(fd<0){dt_free_words(e);nio_free(c);nio_free(h);j.*.status=-8208;return -8208;}
    if(nio_regular(fd)!=1 || nio_sync(j.*.root)!=0){status=-8208;}
    if(status==0){let length:i32=raw.len;if(fault==1){length=raw.len/2;}
        if(nio_write_all(fd,raw[0..length])!=length || nio_sync(fd)!=0){status=-8208;}}
    if(nio_close(fd)!=0 || nio_sync(j.*.root)!=0){status=-8208;}
    if(status!=0 || fault==1){
        dt_free_words(e);nio_free(c);nio_free(h);j.*.status=-8208;
        if(status==0){return -8211;}return status;
    }
    if(fault==2){_zag_println("N06_RAW_DURABLE_BEFORE_TRACE_CRASH");_zag_exit(73);}
    status=dt_append(j,e,c,n);dt_free_words(e);nio_free(c);nio_free(h);return status;
}

// This generic observer has no evaluator label, feature summary, semantic units,
// learned classifier or policy. Every channel/sample remains directly readable.
fn sn_observe(j:*DurableTelemetry,index:i32,values:[]i32,metadata:[]i32)i32 {
    if(metadata.len!=12 || values.len<0 || values.len>65537){return -8202;}
    if(tm_disjoint(values,metadata)!=1 ||
       dt_internal_alias(j,_zag_slice_ptr(values) as i64,(values.len as i64)*8)==1 ||
       dt_internal_alias(j,_zag_slice_ptr(metadata) as i64,96)==1){return -8210;}
    let packet:SensorPacket=sn_load(j,index);if(packet.status!=0){return packet.status;}
    let raw:[]u8=packet.raw;let encoding:i32=rr_get32(raw,8);let count:i32=raw.len-64;
    if(encoding==1){count=count/2;}
    if(values.len<count){nio_free(raw);return -8202;}
    let stage:[]i32=sn_words(count);let i:i32=0;
    while(i<count){let value:i32=raw[64+i] as i32;
        if(encoding==1){value=(raw[64+i*2] as i32)+(raw[65+i*2] as i32)*256;
            if(value>=32768){value=value-65536;}}
        stage[i]=value;i=i+1;
    }
    i=0;while(i<count){values[i]=stage[i];i=i+1;}
    i=0;while(i<12){metadata[i]=rr_get32(raw,8+i*4);i=i+1;}
    dt_free_words(stage);nio_free(raw);return 0;
}

// New R33 encoded-file record candidate. Not installed in any accepted brain.
// Exact record ownership under this API, not OS-enforced immutable memory.
// Adler sums detect the registered corruptions; they are NOT signatures/MACs.
// Allocation/reading is bounded by the external fixed-file fixture supervisor.

struct R33RawStore {
    bytes:[]u8,
    used:i32,
    cursor:[]i32,
}

fn rr_bytes(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return p[0..0];}
    return p[0..n];
}

fn rr_get32(bytes:[]u8,at:i32)i32 {
    let value:i64=(bytes[at] as i64)+(bytes[at+1] as i64)*256+
        (bytes[at+2] as i64)*65536+(bytes[at+3] as i64)*16777216;
    if(value>2147483647){return -1;}
    return value as i32;
}

fn rr_put32(bytes:[]u8,at:i32,value:i32)void {
    let v:i32=value;let i:i32=0;
    while(i<4){bytes[at+i]=(v-(v/256)*256) as u8;v=v/256;i=i+1;}
}

// The two dependent Adler components, evaluated over all bytes except the two
// checksum words themselves. Bounded intermediate arithmetic never overflows.
fn rr_adler(bytes:[]u8,skip:i32,out:[]i32)void {
    let a:i32=1;let b:i32=0;let i:i32=0;
    while(i<bytes.len){
        if(i<skip || i>=skip+8){
            a=a+(bytes[i] as i32);a=a-(a/65521)*65521;
            b=b+a;b=b-(b/65521)*65521;
        }
        i=i+1;
    }
    out[0]=a;out[1]=b;
}

fn rr_integrity(bytes:[]u8,skip:i32)i32 {
    let sums:[]i32=zalloc_i(2);rr_adler(bytes,skip,sums);
    let answer:i32=0;
    if(rr_get32(bytes,skip)==sums[0] && rr_get32(bytes,skip+4)==sums[1]){answer=1;}
    zfree(sums);return answer;
}

fn rr_packet_validate(raw:[]u8)i32 {
    if(raw.len<64 || raw.len>131136){return -1;}
    if(_zag_strcmp(raw[0..8],"TNNRAW01")!=1){return -1;}
    let at:i32=8;
    while(at<64){if(rr_get32(raw,at)<0){return -1;}at=at+4;}
    let encoding:i32=rr_get32(raw,8);let channels:i32=rr_get32(raw,12);
    let rate:i32=rr_get32(raw,16);let width:i32=rr_get32(raw,20);
    let height:i32=rr_get32(raw,24);let items:i32=rr_get32(raw,28);
    let payload:i32=rr_get32(raw,32);
    if(payload>131072 || payload!=raw.len-64){return -1;}
    if(rr_get32(raw,40)>=2147483647 || rr_get32(raw,48)<1 || rr_get32(raw,48)>1000000000){return -1;}
    if(encoding==1){
        if(channels<1 || channels>2 || rate<8000 || rate>192000 || width!=0 || height!=0){return -1;}
        let frame:i32=channels*2;
        if(payload-(payload/frame)*frame!=0 || items!=payload/frame){return -1;}
    }else{
        if(encoding!=2 || channels!=3 || rate!=0 || width<1 || width>64 || height<1 || height>64){return -1;}
        if(items!=width*height || payload!=width*height*3){return -1;}
    }
    if(rr_integrity(raw,56)!=1){return -5;}
    return 0;
}

fn rr_copy_bytes(source:[]u8,target:[]u8)i32 {
    if(source.len>131176 || target.len<source.len){return -2;}
    if(source.len==0){return 0;}
    let allocation:*i8=_zag_malloc(source.len);
    if(allocation==null as *i8){return -8;}
    let stage:[]u8=(allocation as *u8)[0..source.len];
    let i:i32=0;while(i<source.len){stage[i]=source[i];i=i+1;}
    i=0;while(i<source.len){target[i]=stage[i];i=i+1;}
    _zag_free(allocation);return 0;
}

fn rr_admit(raw:[]u8,store:*R33RawStore)i32 {
    let status:i32=rr_packet_validate(raw);if(status!=0){return status;}
    if(store.*.cursor.len!=4 || store.*.bytes.len<raw.len){return -2;}
    let c:[]i32=store.*.cursor;
    if(rr_get32(raw,36)!=c[0] || rr_get32(raw,40)!=c[1] ||
       rr_get32(raw,44)<c[2] || rr_get32(raw,48)!=c[3]){return -3;}
    // Freeze metadata before a staged copy can overwrite an overlapping source.
    let next:i32=rr_get32(raw,40)+1;let tick:i32=rr_get32(raw,44);
    status=rr_copy_bytes(raw,store.*.bytes);if(status!=0){return status;}
    store.*.used=raw.len;c[1]=next;c[2]=tick;
    return 0;
}

fn rr_store_validate(store:*R33RawStore)i32 {
    if(store.*.used<64 || store.*.used>store.*.bytes.len || store.*.cursor.len!=4){return -1;}
    let raw:[]u8=store.*.bytes[0..store.*.used];
    if(rr_packet_validate(raw)!=0){return -1;}
    let c:[]i32=store.*.cursor;
    if(c[0]!=rr_get32(raw,36) || c[1]!=rr_get32(raw,40)+1 ||
       c[2]!=rr_get32(raw,44) || c[3]!=rr_get32(raw,48)){return -3;}
    return 0;
}

// The receiver owns the output allocation. This does not protect a caller that
// deliberately aliases its output with the store, or arbitrary native pointers.
fn rr_retrieve_copy(store:*R33RawStore,out:[]u8)i32 {
    let status:i32=rr_store_validate(store);if(status!=0){return status;}
    return rr_copy_bytes(store.*.bytes[0..store.*.used],out);
}

// Snapshot contains the exact raw record and explicit order cursor. It is an
// untrusted serialized object, not an authenticated continuing-brain checkpoint.
fn rr_snapshot_write(store:*R33RawStore,path:[]u8)i32 {
    let valid:i32=rr_store_validate(store);if(valid!=0){return valid;}
    let raw:[]u8=store.*.bytes[0..store.*.used];
    if(_zag_file_exists(path)!=0){return -7;}
    let size:i32=40+store.*.used;let allocation:*i8=_zag_malloc(size);
    if(allocation==null as *i8){return -8;}
    let snapshot:[]u8=(allocation as *u8)[0..size];
    let magic:[]u8="TNNSNP01";let i:i32=0;
    while(i<8){snapshot[i]=magic[i];i=i+1;}
    i=0;while(i<4){rr_put32(snapshot,8+i*4,store.*.cursor[i]);i=i+1;}
    rr_put32(snapshot,24,store.*.used);rr_put32(snapshot,28,1);
    i=0;while(i<store.*.used){snapshot[40+i]=raw[i];i=i+1;}
    let sums:[]i32=zalloc_i(2);rr_adler(snapshot,32,sums);
    rr_put32(snapshot,32,sums[0]);rr_put32(snapshot,36,sums[1]);zfree(sums);
    let result:i32=_zag_write_file(path,snapshot);
    _zag_free(allocation);
    if(result!=0){return -6;}return 0;
}

fn rr_snapshot_restore(snapshot:[]u8,store:*R33RawStore)i32 {
    if(snapshot.len<104 || snapshot.len>131176){return -1;}
    if(_zag_strcmp(snapshot[0..8],"TNNSNP01")!=1 || rr_get32(snapshot,28)!=1){return -1;}
    let count:i32=rr_get32(snapshot,24);
    if(count<64 || count!=snapshot.len-40){return -1;}
    if(rr_integrity(snapshot,32)!=1){return -5;}
    let raw:[]u8=snapshot[40..snapshot.len];let status:i32=rr_packet_validate(raw);
    if(status!=0){return status;}
    if(store.*.cursor.len!=4 || store.*.bytes.len<count){return -2;}
    if(rr_get32(snapshot,8)!=rr_get32(raw,36) || rr_get32(snapshot,12)!=rr_get32(raw,40)+1 ||
       rr_get32(snapshot,16)!=rr_get32(raw,44) || rr_get32(snapshot,20)!=rr_get32(raw,48)){return -3;}
    let clock:i32=rr_get32(snapshot,8);let next:i32=rr_get32(snapshot,12);
    let tick:i32=rr_get32(snapshot,16);let timebase:i32=rr_get32(snapshot,20);
    status=rr_copy_bytes(raw,store.*.bytes);if(status!=0){return status;}
    store.*.cursor[0]=clock;store.*.cursor[1]=next;
    store.*.cursor[2]=tick;store.*.cursor[3]=timebase;
    store.*.used=count;return 0;
}

// R33-N14 bounded encoded-sensor information-preservation candidate.
// This source must not execute before review, registration, freeze and admission.
@import("sensor.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct N14Stats { checks:i32,failed:i32,packets:i32,reconstructed:i32,metadata:i32,children:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64 }
fn n14_stats()N14Stats {return N14Stats{.checks=0,.failed=0,.packets=0,.reconstructed=0,.metadata=0,.children=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn n14_check(s:*N14Stats,name:[]u8,actual:i64,expected:i64)void {
    s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(name,actual,expected);
}
fn n14_config()[]i32 {let c:[]i32=dt_words(6);c[0]=16;c[1]=330601;c[2]=2701;c[3]=1;c[4]=1;c[5]=7;return c;}
fn n14_path(name:[]u8)[]u8 {return _zag_str_concat("Research/R33_NATIVE_N14_RUN_PRIMARY_V1/",name);}
fn n14_fill(a:[]i32,v:i32)void {let i:i32=0;while(i<a.len){a[i]=v;i=i+1;}}
fn n14_equal_words(a:[]i32,b:[]i32)i32 {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn n14_sum(a:[]i32)i64 {let sum:i64=0;let i:i32=0;while(i<a.len){sum=sum+(a[i] as i64);i=i+1;}return sum;}

fn n14_count(v:i32)i32 {
    if(v==0){return 8;}       // mono min-rate mixed signs
    if(v==1){return 8;}       // stereo max-rate extrema, 4 frames
    if(v==2){return 0;}       // empty PCM
    if(v==3 || v==4){return 24;} // same multiset, changed impulse position
    if(v==5){return 3;}       // RGB 1x1
    return 12288;             // RGB 64x64
}
fn n14_expected(v:i32,i:i32)i32 {
    if(v==0){if(i==0){return -32768;}if(i==1){return -1;}if(i==2){return 0;}if(i==3){return 1;}if(i==4){return 32767;}return i*97-250;}
    if(v==1){if(i%2==0){return -32768;}return 32767;}
    if(v==2){return 0;}
    if(v==3){if(i==13){return 1;}return 0;}
    if(v==4){if(i==17){return 1;}return 0;}
    if(v==5){if(i==0){return 0;}if(i==1){return 127;}return 255;}
    if(v==6){return (i*29+11)%256;}
    // Equal-histogram order twin: cyclically rotate fixture 6 by one byte.
    let j:i32=i-1;if(j<0){j=12287;}return (j*29+11)%256;
}
fn n14_metadata(ordinal:i32,v:i32)[]i32 {
    let m:[]i32=dt_words(12);m[0]=1;m[1]=1;m[2]=8000;m[3]=0;m[4]=0;m[5]=n14_count(v);m[6]=n14_count(v)*2;
    if(v==1){m[1]=2;m[2]=192000;m[5]=4;m[6]=16;}
    if(v>=5){m[0]=2;m[1]=3;m[2]=0;m[3]=64;m[4]=64;m[5]=4096;m[6]=12288;
        if(v==5){m[3]=1;m[4]=1;m[5]=1;m[6]=3;}}
    m[7]=7;m[8]=ordinal;m[9]=1000+ordinal*7;m[10]=1000000;m[11]=19;return m;
}
fn n14_reseal(raw:[]u8)void {let sums:[]i32=dt_words(2);rr_adler(raw,56,sums);rr_put32(raw,56,sums[0]);rr_put32(raw,60,sums[1]);dt_free_words(sums);}
fn n14_encode(values:[]i32,meta:[]i32)[]u8 {
    if(meta.len!=12 || meta[6]<0 || meta[6]>131072){return "";}
    let raw:[]u8=nio_alloc(64+meta[6]);dt_copy("TNNRAW01",raw);let i:i32=0;
    while(i<12){rr_put32(raw,8+i*4,meta[i]);i=i+1;}
    if(meta[0]==1){if(meta[6]!=values.len*2){nio_free(raw);return "";}i=0;
        while(i<values.len){let value:i32=values[i];if(value<0){value=value+65536;}
            raw[64+i*2]=(value%256) as u8;raw[65+i*2]=(value/256) as u8;i=i+1;}}
    else{if(meta[0]!=2 || meta[6]!=values.len){nio_free(raw);return "";}i=0;
        while(i<values.len){raw[64+i]=values[i] as u8;i=i+1;}}
    n14_reseal(raw);return raw;
}
fn n14_raw(ordinal:i32,v:i32)[]u8 {
    let meta:[]i32=n14_metadata(ordinal,v);let values:[]i32=sn_words(n14_count(v));let i:i32=0;
    while(i<values.len){values[i]=n14_expected(v,i);i=i+1;}let raw:[]u8=n14_encode(values,meta);
    dt_free_words(values);dt_free_words(meta);return raw;
}
fn n14_observe_reconstruct(j:*DurableTelemetry,index:i32,v:i32,s:*N14Stats)[]u8 {
    let count:i32=n14_count(v);let values:[]i32=sn_words(count+1);let meta:[]i32=dt_words(12);
    n14_fill(values,31337);n14_fill(meta,31337);n14_check(s,"observer_complete",sn_observe(j,index,values,meta),0);
    let wrong:i32=0;let i:i32=0;while(i<count){if(values[i]!=n14_expected(v,i)){wrong=wrong+1;}i=i+1;}
    n14_check(s,"all_values_exact",wrong,0);n14_check(s,"observer_tail_untouched",values[count],31337);
    let expected_meta:[]i32=n14_metadata(index,v);n14_check(s,"metadata_exact",n14_equal_words(meta,expected_meta),1);
    let reconstructed:[]u8=n14_encode(values[0..count],meta);let original:[]u8=n14_raw(index,v);
    n14_check(s,"reconstructed_length_exact",reconstructed.len,original.len);
    n14_check(s,"reconstructed_packet_exact",nio_equal(reconstructed,original),1);
    let loaded:SensorPacket=sn_load(j,index);n14_check(s,"loaded_packet_ok",loaded.status,0);
    if(loaded.status==0){n14_check(s,"reconstruction_matches_durable_raw",nio_equal(reconstructed,loaded.raw),1);nio_free(loaded.raw);}
    s.*.packets=s.*.packets+1;s.*.reconstructed=s.*.reconstructed+reconstructed.len;s.*.metadata=s.*.metadata+12;
    dt_free_words(values);dt_free_words(meta);dt_free_words(expected_meta);nio_free(original);return reconstructed;
}
fn n14_roundtrip(replay:i32,s:*N14Stats)void {
    let config:[]i32=n14_config();let path:[]u8=n14_path("roundtrip");if(replay==0){n14_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=sn_open(path,config);n14_check(s,"recover",j.status,0);
    if(j.status==0){let i:i32=0;if(replay==0){while(i<8 && s.*.failed==0){let raw:[]u8=n14_raw(i,i);n14_check(s,"append",sn_append(&j,raw),0);nio_free(raw);i=i+1;}}
        n14_check(s,"committed_count",j.count,8);let r3:[]u8="";let r4:[]u8="";let r6:[]u8="";let r7:[]u8="";i=0;
        while(i<8 && s.*.failed==0){let r:[]u8=n14_observe_reconstruct(&j,i,i,s);if(i==3){r3=r;}else if(i==4){r4=r;}else if(i==6){r6=r;}else if(i==7){r7=r;}else{nio_free(r);}i=i+1;}
        if(s.*.failed==0){n14_check(s,"pcm_order_twins_distinct",nio_equal(r3,r4),0);n14_check(s,"rgb_order_twins_distinct",nio_equal(r6,r7),0);
            let v3:[]i32=sn_words(24);let v4:[]i32=sn_words(24);i=0;while(i<24){v3[i]=n14_expected(3,i);v4[i]=n14_expected(4,i);i=i+1;}
            n14_check(s,"pcm_twin_equal_sum",n14_sum(v3),n14_sum(v4));dt_free_words(v3);dt_free_words(v4);
            let v6:[]i32=sn_words(12288);let v7:[]i32=sn_words(12288);i=0;while(i<12288){v6[i]=n14_expected(6,i);v7[i]=n14_expected(7,i);i=i+1;}
            n14_check(s,"rgb_twin_equal_sum",n14_sum(v6),n14_sum(v7));dt_free_words(v6);dt_free_words(v7);}
        nio_free(r3);nio_free(r4);nio_free(r6);nio_free(r7);
    }dt_close(&j);dt_free_words(config);nio_free(path);
}
fn n14_state_equal(j:*DurableTelemetry,state:[]i32,causal:[]u8,head:[]u8,attempts:i32,blobs:i32,count:i32)i32 {
    if(n14_equal_words(j.*.state,state)!=1 || nio_equal(j.*.causal,causal)!=1 || nio_equal(j.*.head,head)!=1){return 0;}
    if(j.*.attempts!=attempts || sn_blob_count(j)!=blobs || j.*.count!=count){return 0;}return 1;
}
fn n14_refuse(j:*DurableTelemetry,raw:[]u8,expected:i32,s:*N14Stats)void {
    let state:[]i32=dt_words(j.*.state.len);dt_copy_words(j.*.state,state);let causal:[]u8=nio_alloc(j.*.causal.len);dt_copy(j.*.causal,causal);
    let head:[]u8=nio_alloc(32);dt_copy(j.*.head,head);let attempts:i32=j.*.attempts;let blobs:i32=sn_blob_count(j);let count:i32=j.*.count;
    n14_check(s,"invalid_refused",sn_append(j,raw),expected);n14_check(s,"refusal_no_state_effect",n14_state_equal(j,state,causal,head,attempts,blobs,count),1);
    dt_free_words(state);nio_free(causal);nio_free(head);
}
fn n14_bad_field(j:*DurableTelemetry,offset:i32,value:i32,expected:i32,s:*N14Stats)void {
    let raw:[]u8=n14_raw(j.*.count,0);rr_put32(raw,offset,value);n14_reseal(raw);n14_refuse(j,raw,expected,s);nio_free(raw);
}
fn n14_refusals(s:*N14Stats)void {
    let config:[]i32=n14_config();let path:[]u8=n14_path("refusals");n14_check(s,"create",dt_create(path,config),0);
    let j:DurableTelemetry=sn_open(path,config);n14_check(s,"recover",j.status,0);
    if(j.status==0){
        n14_bad_field(&j,16,7999,-8201,s);n14_bad_field(&j,16,192001,-8201,s);
        n14_bad_field(&j,12,0,-8201,s);n14_bad_field(&j,12,3,-8201,s);
        let raw:[]u8=n14_raw(0,0);rr_put32(raw,32,15);rr_put32(raw,28,7);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=nio_alloc(131138);let i:i32=0;while(i<raw.len){raw[i]=0;i=i+1;}dt_copy("TNNRAW01",raw);rr_put32(raw,8,1);rr_put32(raw,12,1);rr_put32(raw,16,8000);rr_put32(raw,28,65537);rr_put32(raw,32,131074);rr_put32(raw,36,7);rr_put32(raw,40,0);rr_put32(raw,44,1000);rr_put32(raw,48,1000000);rr_put32(raw,52,19);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,20,0);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,20,65);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,24,0);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,24,65);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,12,2);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,12,4);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,5);rr_put32(raw,28,2);n14_reseal(raw);n14_refuse(&j,raw,-8201,s);nio_free(raw);
        raw=n14_raw(0,0);raw[56]=(raw[56] as i32+1) as u8;n14_refuse(&j,raw,-8203,s);nio_free(raw);
        n14_check(s,"no_invalid_commit",j.count,0);n14_check(s,"no_invalid_blob",sn_blob_count(&j),0);n14_check(s,"no_invalid_attempt",j.attempts,0);
    }dt_close(&j);dt_free_words(config);nio_free(path);
}
fn n14_has(b:[]u8,needle:[]u8)i32 {let i:i32=0;while(i+needle.len<=b.len){let k:i32=0;while(k<needle.len && b[i+k]==needle[k]){k=k+1;}if(k==needle.len){return 1;}i=i+1;}return 0;}
fn n14_number(b:[]u8,prefix:[]u8,tail:[]u8)i32 {let value:i32=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i32=0;let digits:i32=0;while(at<b.len && b[at]>=48 && b[at]<=57 && digits<9){v=v*10+(b[at] as i32)-48;digits=digits+1;at=at+1;}if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;}
fn n14_run(root:i64,mode:[]u8,expected:i32,s:*N14Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,"Research/R33_NATIVE_N14_SENSOR_INFORMATION/BUILD_01/n14",mode,mode,20000,262144);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    n14_check(s,"child_status",r.status,0);n14_check(s,"child_started",r.started,1);n14_check(s,"child_reaped",r.reaped,1);n14_check(s,"child_exit",r.exit_code,expected);n14_check(s,"child_signal",r.signal,0);n14_check(s,"child_stderr_empty",r.stderr_bytes,0);n14_check(s,"child_rss_bound",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let b:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(mode,".stdout");let fd:i64=nio_open_child(root,name,0);let n:i64=nio_read_exact(fd,b,262144);if(fd>=0){nio_close(fd);}nio_free(name);n14_check(s,"complete_capture",n,r.stdout_bytes);
    if(n>=0 && n<=262144){let log:[]u8=b[0..n as i32];if(expected==0){n14_check(s,"child_terminal_pass",n14_has(log,"N14_CHILD_PASS\n"),1);let checks:i32=n14_number(log,"N14_CHILD_COUNTS,",",0\n");n14_check(s,"child_counts_valid",checks>0 as i32,1);if(checks>0){s.*.child_checks=s.*.child_checks+checks;}}else{n14_check(s,"invalid_mode_silent",n,0);}}nio_free(b);
}
fn n14_field(b:[]u8,key:[]u8,v:i64)[]u8 {let num:[]u8=_zag_i64_to_str(v);let part:[]u8=_zag_str_concat(b,key);let out:[]u8=_zag_str_concat(part,num);nio_free(b);nio_free(part);nio_free(num);return out;}
fn n14_write(root:i64,name:[]u8,bytes:[]u8)i32 {let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}let code:i32=0;if(nio_regular(fd)!=1 || nio_write_all(fd,bytes)!=bytes.len || nio_sync(fd)!=0){code=-1;}if(nio_close(fd)!=0 || nio_sync(root)!=0){code=-1;}return code;}
fn n14_supervise()i32 {
    if(nio_guard(90)!=0){return 3;}let admission:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N14_RUN_PRIMARY_V1");if(admission.status!=0){return 4;}let root:i64=admission.root;let s:N14Stats=n14_stats();
    n14_run(root,"invalid",2,&s);n14_run(root,"roundtrip-write",0,&s);n14_run(root,"roundtrip-replay",0,&s);n14_run(root,"refusals",0,&s);
    n14_check(&s,"all_children_completed",s.children,4);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N14\",\n  \"planned_children\":4","");json=n14_field(json,",\n  \"completed_children\":",s.children);json=n14_field(json,",\n  \"parent_failures\":",s.failed);json=n14_field(json,",\n  \"verified_child_checks\":",s.child_checks);json=n14_field(json,",\n  \"parent_checks_before_result_write\":",s.checks);json=n14_field(json,",\n  \"peak_child_rss_bytes\":",s.rss);let tail:[]u8=_zag_str_concat(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"fresh_scientific_evidence\":false,\n  \"requires_terminal_marker\":true\n}\n");nio_free(json);n14_check(&s,"native_result_saved",n14_write(root,"NATIVE_RESULT.json",tail),0);_zag_print(tail);nio_free(tail);n14_check(&s,"close_root",nio_close(root),0);_zag_print("N14_PARENT_FAILURES,");_zag_println(_zag_i64_to_str(s.failed as i64));if(s.failed!=0){return 1;}_zag_println("R33_N14_SENSOR_INFORMATION_PRESERVATION_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);if(_zag_strcmp(mode,"supervise")==1){return n14_supervise();}if(_zag_strcmp(mode,"invalid")==1){return 2;}if(nio_deadline(20)!=0){return 3;}let s:N14Stats=n14_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"roundtrip-write")==1){n14_roundtrip(0,&s);}else if(_zag_strcmp(mode,"roundtrip-replay")==1){n14_roundtrip(1,&s);}else if(_zag_strcmp(mode,"refusals")==1){n14_refusals(&s);}else{handled=0;}if(handled==0){return 2;}
    _zag_print("N14_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));if(s.failed!=0){return 1;}_zag_println("N14_CHILD_PASS");return 0;
}

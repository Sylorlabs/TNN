    bad=bad+nio_metric("descendant_creation_denied",w8_denied(pid),1);checks=checks+1;
    if(pid>0){let status:*i32=_zag_malloc(8) as *i32;_zag_darwin_syscall(7,pid,status as i64,0,0,0,0);_zag_free(status as *i8);}

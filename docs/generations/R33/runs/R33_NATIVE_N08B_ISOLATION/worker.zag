    if(bad!=0){return 1;}_zag_println("N08_WORKER_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(nio_deadline(15)!=0){return 3;}_zag_println("N08_SANDBOX_WORKER_ENTERED");
    if(_zag_strcmp(mode,"probe")==1){return w8_probe();}
    if(_zag_strcmp(mode,"exec")==1){return w8_exec_probe();}

fn w8_exec_probe()i32 {
    let p:[]u8=nio_cstr("/usr/bin/true");let argv:*i64=_zag_malloc(16) as *i64;let env:*i64=_zag_malloc(8) as *i64;
    argv[0]=_zag_slice_ptr(p) as i64;argv[1]=0;env[0]=0;
    let rc:i64=_zag_darwin_syscall(59,_zag_slice_ptr(p) as i64,argv as i64,env as i64,0,0,0);

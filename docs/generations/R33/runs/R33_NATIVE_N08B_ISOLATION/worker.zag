    bad=bad+nio_metric("protected_chmod_denied",w8_denied(_zag_darwin_syscall(15,_zag_slice_ptr(p) as i64,384,0,0,0,0)),1);checks=checks+1;
    bad=bad+nio_metric("protected_rename_denied",w8_denied(_zag_darwin_syscall(128,_zag_slice_ptr(p) as i64,_zag_slice_ptr(q) as i64,0,0,0,0)),1);checks=checks+1;

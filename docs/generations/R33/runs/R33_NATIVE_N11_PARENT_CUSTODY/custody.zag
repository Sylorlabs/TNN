// Trusted controller only: check the current locked supervisor receipt BEFORE
// opening parent pages. Worker-selected state cannot select an authority root.
@import("binding.zag")
@import("checkpoint.zag")

fn pc_map(j:*NaStore,receipt:[]u8,trusted_map_path:[]u8)ParentMap {
    let binding:[]u8=nio_alloc(128);if(binding.len!=128){return pb_failed(-8907);}
    let n:i32=cs_restore(j,receipt,binding);
    if(n!=128){nio_free(binding);if(n<0){return pb_failed(n);}return pb_failed(-8901);}
    let p:ParentMap=pb_load(trusted_map_path,binding);nio_free(binding);return p;
}

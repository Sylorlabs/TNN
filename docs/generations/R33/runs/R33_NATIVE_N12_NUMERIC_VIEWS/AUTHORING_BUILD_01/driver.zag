// N12 native engineering evaluator. Known format controls, not fresh worlds,
// original Python execution, learner updates, or behavioral qualification.
@import("views.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct P12Stats {checks:i32,failed:i32,children:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64}
struct F12 {data:[]u8,used:i32,status:i32}
fn p12_stats()P12Stats {return P12Stats{.checks=0,.failed=0,.children=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn p12_check(s:*P12Stats,key:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(key,a,e);}
fn p12_root()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N12_RUN_PRIMARY_V1";}
fn p12_join(a:[]u8,b:[]u8)[]u8 {let out:[]u8=_zag_str_concat(a,b);nio_free(a);return out;}
fn p12_hex(text:[]u8)[]u8 {
    if(text.len==0){return "";}if(text.len%2!=0){return "";}let out:[]u8=nio_alloc(text.len/2);
    if(out.len!=text.len/2){return "";}let i:i32=0;while(i<out.len){
        let a:i64=ns_hex_digit(text[2*i] as i32);let b:i64=ns_hex_digit(text[2*i+1] as i32);
        if(a<0 || b<0){nio_free(out);return "";}out[i]=(a*16+b) as u8;i=i+1;}return out;
}
fn f12_byte(f:*F12,n:i32)void {
    if(f.*.status!=0){return;}if(n<0 || n>255 || f.*.used>=f.*.data.len){f.*.status=-1;return;}
    f.*.data[f.*.used]=n as u8;f.*.used=f.*.used+1;
}
fn f12_bytes(f:*F12,b:[]u8)void {let i:i32=0;while(i<b.len){f12_byte(f,b[i] as i32);i=i+1;}}
fn f12_unsigned(f:*F12,n:i64,width:i32)void {
    let v:i64=n;let i:i32=0;while(i<width){f12_byte(f,(v%256) as i32);v=v/256;i=i+1;}
    if(v!=0){f.*.status=-1;}
}
fn f12_integer(f:*F12,n:i64)void {
    if(n>=(-2147483647-1) && n<=2147483647){f12_byte(f,74);let v:i64=n;
        if(v<0){v=v+4294967296;}f12_unsigned(f,v,4);
    }else if(n>=0){f12_byte(f,138);f12_byte(f,8);f12_unsigned(f,n,8);}else{f.*.status=-1;}
}
fn f12_text(f:*F12,b:[]u8)void {f12_byte(f,140);f12_byte(f,b.len);f12_bytes(f,b);}
fn f12_global(f:*F12,module:[]u8,name:[]u8)void {
    f12_byte(f,99);f12_bytes(f,module);f12_byte(f,10);f12_bytes(f,name);f12_byte(f,10);
}
fn f12_fixture(dtype:[]u8,endian:[]u8,order:[]u8,dims:[]i64,raw:[]u8,carrier:i32,variant:i32)[]u8 {
    let f:F12=F12{.data=nio_alloc(8192),.used=0,.status=0};if(f.data.len!=8192){return "";}
    f12_byte(&f,128);f12_byte(&f,5);
    let module:[]u8="numpy._core.numeric";if(variant==1){module="numpy.core.numeric";}
    if(variant==3){module="r33_never_import";}
    let name:[]u8="_frombuffer";if(variant==25){name="_not_frombuffer";}
    f12_global(&f,module,name);f12_byte(&f,40);
    if(carrier==19){f12_byte(&f,151);}else{
        if(carrier==7){f12_byte(&f,67);f12_byte(&f,raw.len);}else{f12_byte(&f,150);f12_unsigned(&f,raw.len,8);}
        f12_bytes(&f,raw);
    }
    module="numpy";if(variant==2){module="numpy._core._multiarray_umath";}if(variant==26){module="r33_never_import";}
    f12_global(&f,module,"dtype");f12_byte(&f,40);f12_text(&f,dtype);
    if(variant==4){f12_byte(&f,136);}else{f12_byte(&f,137);}
    if(variant==5){f12_byte(&f,137);}else{f12_byte(&f,136);}
    if(variant==21){f12_byte(&f,78);}f12_byte(&f,116);f12_byte(&f,82);
    f12_byte(&f,40);if(variant==27){f12_byte(&f,136);}else{let version:i64=3;if(variant==6){version=4;}f12_integer(&f,version);}
    f12_text(&f,endian);let i:i32=0;while(i<3){if(variant==8+i){f12_integer(&f,1);}else{f12_byte(&f,78);}i=i+1;}
    let elsize:i64=-1;if(variant==11){elsize=4;}f12_integer(&f,elsize);
    let align:i64=-1;if(variant==12){align=4;}f12_integer(&f,align);
    if(variant!=20){let flags:i64=0;if(variant==13){flags=1;}f12_integer(&f,flags);}
    if(variant==7){f12_byte(&f,78);}f12_byte(&f,116);
    if(variant==14){f12_byte(&f,48);}else{f12_byte(&f,98);}
    if(variant==15){f12_byte(&f,78);f12_byte(&f,98);}
    f12_byte(&f,40);i=0;while(i<dims.len){
        if(i==0 && variant==28){f12_byte(&f,136);}
        else if(i==0 && variant==29){f12_byte(&f,71);f12_byte(&f,63);f12_byte(&f,240);let k:i32=0;while(k<6){f12_byte(&f,0);k=k+1;}}
        else if(i==0 && variant==31){f12_byte(&f,138);f12_byte(&f,9);let k:i32=0;while(k<9){f12_byte(&f,1);k=k+1;}}
        else{f12_integer(&f,dims[i]);}i=i+1;
    }f12_byte(&f,116);
    if(variant!=19){f12_text(&f,order);}if(variant==17){f12_byte(&f,78);}f12_byte(&f,116);
    if(variant==24){f12_byte(&f,129);}else{f12_byte(&f,82);}
    if(variant==16){f12_byte(&f,78);f12_byte(&f,98);}f12_byte(&f,46);
    if(f.status!=0){nio_free(f.data);return "";}return f.data[0..f.used];
}
fn p12_parse(raw:[]u8,s:*P12Stats)ParentMap {
    let p:ParentMap=pm_init(raw,256,512,256,128);p12_check(s,"fixture_native_parse",pm_scan(&p),0);
    if(p.status==0){p12_check(s,"fixture_map_valid",pm_validate(&p),0);}return p;
}
fn p12_word_bytes(w:[]i64)[]u8 {let b:*u8=_zag_slice_ptr(w) as *u8;return b[0..w.len*8];}
fn p12_fingerprint(p:*ParentMap)[]u8 {
    let out:[]u8=nio_alloc(256);if(out.len!=256){return "";}let code:i32=ns_sha256(p.*.input,out[0..32]);
    code=code+ns_sha256(p12_word_bytes(p.*.nodes),out[32..64]);code=code+ns_sha256(p12_word_bytes(p.*.edges),out[64..96]);
    code=code+ns_sha256(p12_word_bytes(p.*.memo),out[96..128]);code=code+ns_sha256(p12_word_bytes(p.*.stack),out[128..160]);
    code=code+ns_sha256(p12_word_bytes(p.*.marks),out[160..192]);code=code+ns_sha256(p12_word_bytes(p.*.globals),out[192..224]);
    code=code+ns_sha256(p12_word_bytes(p.*.hist),out[224..256]);
    if(code!=0){nio_free(out);return "";}return out;
}
fn p12_unchanged(p:*ParentMap,before:[]u8,s:*P12Stats)void {
    let after:[]u8=p12_fingerprint(p);p12_check(s,"source_and_seven_tables_unchanged",(before.len==256 && after.len==256 && nio_equal(before,after)==1) as i32,1);nio_free(after);
}
fn p12_overlap(a:[]u8,b:[]u8)i32 {
    if(a.len==0 || b.len==0){return 0;}let x:i64=_zag_slice_ptr(a) as i64;let y:i64=_zag_slice_ptr(b) as i64;
    return (x<y+b.len && y<x+a.len) as i32;
}
fn p12_payload(kind:i32,width:i32)[]u8 {
    if(kind==102 && width==4){return p12_hex("00000000000000800000807f000080ff0100c07f0100807f");}
    if(kind==102 && width==8){return p12_hex("00000000000000000000000000000080000000000000f07f000000000000f0ff393000000000f87f010000000000f07f");}
    if(width==1){return p12_hex("0001ff807f55");}
    if(width==2){return p12_hex("00000100ffff0080ff7f55aa");}
    if(width==4){return p12_hex("0000000001000000ffffffff00000080ffffff7f55aa55aa");}
    return p12_hex("00000000000000000100000000000000ffffffffffffffff0000000000000080ffffffffffffff7f55aa55aa55aa55aa");
}
fn p12_expected(kind:i32,width:i32,index:i32)NvBits {
    let r:NvBits=NvBits{.status=0,.low=0,.high=0};
    if(kind==102){
        if(width==4){if(index==1){r.low=2147483648;}if(index==2){r.low=2139095040;}if(index==3){r.low=4286578688;}
            if(index==4){r.low=2143289345;}if(index==5){r.low=2139095041;}}
        else{if(index==1){r.high=2147483648;}if(index==2){r.high=2146435072;}if(index==3){r.high=4293918720;}
            if(index==4){r.low=12345;r.high=2146959360;}if(index==5){r.low=1;r.high=2146435072;}}
        return r;
    }
    if(index==1){r.low=1;}if(index==2){r.low=4294967295;r.high=4294967295;}
    if(index==3){r.low=2147483648;r.high=2147483648;}if(index==4){r.low=2147483647;r.high=2147483647;}
    if(index==5){r.low=2857740885;r.high=2857740885;}
    if(width==1){if(index==2){r.low=255;}if(index==3){r.low=128;}if(index==4){r.low=127;}if(index==5){r.low=85;}}
    if(width==2){if(index==2){r.low=65535;}if(index==3){r.low=32768;}if(index==4){r.low=32767;}if(index==5){r.low=43605;}}
    if(width==8){if(index==3){r.low=0;}if(index==4){r.low=4294967295;}}else{r.high=0;}return r;
}
fn p12_positive(dtype:[]u8,endian:[]u8,order:[]u8,carrier:i32,variant:i32,s:*P12Stats)void {
    let width:i32=(dtype[1] as i32)-48;let kind:i32=dtype[0] as i32;let payload:[]u8=p12_payload(kind,width);
    p12_check(s,"literal_six_scalar_payload",payload.len,6*width);
    if(nio_equal(endian,">")==1){let i:i32=0;while(i<6){let k:i32=0;while(k<width/2){
        let b:u8=payload[i*width+k];payload[i*width+k]=payload[i*width+width-1-k];payload[i*width+width-1-k]=b;k=k+1;}i=i+1;}}
    let shape:[]i64=pm_words(2);shape[0]=2;shape[1]=3;
    let raw:[]u8=f12_fixture(dtype,endian,order,shape,payload,carrier,variant);let p:ParentMap=p12_parse(raw,s);
    let before:[]u8=p12_fingerprint(&p);let v:NvView=nv_open(&p,p.root);p12_check(s,"supported_view",v.status,0);
    if(v.status==0){p12_check(s,"scalar_kind",v.kind,kind);p12_check(s,"scalar_width",v.width,width);
        p12_check(s,"six_elements",v.elements,6);p12_check(s,"exact_payload_extent",v.bytes,payload.len);
        p12_check(s,"two_dimensions",v.ndim,2);p12_check(s,"serialized_bytes_carrier_flag",v.readonly,(carrier==7) as i32);
        let coordinates:[]i64=pm_words(2);let i:i32=0;while(i<2){let j:i32=0;while(j<3){coordinates[0]=i;coordinates[1]=j;
            let index:i32=i*3+j;if(nio_equal(order,"F")==1){index=i+j*2;}
            p12_check(s,"independent_c_or_f_coordinate",nv_at(&p,&v,coordinates),index);
            let got:NvBits=nv_bits(&p,&v,index);let expected:NvBits=p12_expected(kind,width,index);
            p12_check(s,"bit_read_status",got.status,0);p12_check(s,"exact_low_unsigned_bits",got.low,expected.low);
            p12_check(s,"exact_high_unsigned_bits",got.high,expected.high);j=j+1;}i=i+1;}
        let row:NvRow=nv_row(&p,&v);p12_check(s,"owning_metadata_row",row.status,0);p12_check(s,"metadata_row_bytes",row.data.len,160);
        if(row.status==0){p12_check(s,"row_node_identity",mi_get(row.data,0),p.root);p12_check(s,"row_status_zero",mi_get(row.data,60),0);
            let args:i32=nv_field(&p,p.root,5);p12_check(s,"row_buffer_identity",mi_get(row.data,4),nv_item(&p,args,0));
            p12_check(s,"row_dtype_identity",mi_get(row.data,8),nv_item(&p,args,1));p12_check(s,"row_kind",mi_get(row.data,12),kind);
            p12_check(s,"row_width",mi_get(row.data,16),width);p12_check(s,"row_endian",mi_get(row.data,20),endian[0] as i32);
            p12_check(s,"row_order",mi_get(row.data,24),order[0] as i32);p12_check(s,"row_rank",mi_get(row.data,28),2);
            p12_check(s,"row_elements",mi_get(row.data,32),6);p12_check(s,"row_original_offset",mi_get(row.data,36),nv_field(&p,v.buffer,2));
            p12_check(s,"row_byte_extent",mi_get(row.data,40),6*width);p12_check(s,"row_original_opcode",mi_get(row.data,44),nv_field(&p,p.root,1));
            p12_check(s,"row_shape_identity",mi_get(row.data,48),nv_item(&p,args,2));p12_check(s,"row_carrier_flag",mi_get(row.data,52),(carrier==7) as i32);
            p12_check(s,"row_dtype_state_identity",mi_get(row.data,56),nv_single_build(&p,v.dtype));
            p12_check(s,"row_shape0",mi_get(row.data,64),2);p12_check(s,"row_shape1",mi_get(row.data,68),3);
            let a:i32=3;let b:i32=1;if(nio_equal(order,"F")==1){a=1;b=2;}
            p12_check(s,"row_stride0",mi_get(row.data,96),a);p12_check(s,"row_stride1",mi_get(row.data,100),b);
            p12_check(s,"unused_shape_fields_zero",mi_zero(row.data[72..96]),1);p12_check(s,"unused_stride_fields_zero",mi_zero(row.data[104..128]),1);
            let hash:[]u8=nio_alloc(32);p12_check(s,"literal_payload_hash_computed",ns_sha256(payload,hash),0);
            p12_check(s,"row_payload_hash_exact",nio_equal(hash,row.data[128..160]),1);nio_free(hash);
            p12_check(s,"row_does_not_alias_source",p12_overlap(row.data,p.input),0);
            p12_check(s,"row_does_not_alias_nodes",p12_overlap(row.data,p12_word_bytes(p.nodes)),0);
            p12_check(s,"row_does_not_alias_edges",p12_overlap(row.data,p12_word_bytes(p.edges)),0);
            p12_check(s,"row_does_not_alias_dimensions",p12_overlap(row.data,p12_word_bytes(v.dims)),0);
            p12_check(s,"row_does_not_alias_strides",p12_overlap(row.data,p12_word_bytes(v.strides)),0);
            i=0;while(i<row.data.len){row.data[i]=219;i=i+1;}
            p12_check(s,"mutating_owned_row_keeps_view_valid",nv_bound(&p,&v),1);
        }nio_free(row.data);
        coordinates[0]=-1;p12_check(s,"negative_coordinate_refused",nv_at(&p,&v,coordinates),-9005);
        coordinates[0]=2;p12_check(s,"one_past_coordinate_refused",nv_at(&p,&v,coordinates),-9005);
        p12_check(s,"wrong_rank_refused",nv_at(&p,&v,coordinates[0..1]),-9005);pm_free_words(coordinates);
        let bad:NvBits=nv_bits(&p,&v,-1);p12_check(s,"negative_index_refused",bad.status,-9005);
        bad=nv_bits(&p,&v,6);p12_check(s,"one_past_index_refused",bad.status,-9005);
        bad=nv_bits(&p,&v,9223372036854775807);p12_check(s,"overflow_index_refused_before_multiply",bad.status,-9005);
        p12_check(s,"refused_bits_have_no_low_payload",bad.low,0);p12_check(s,"refused_bits_have_no_high_payload",bad.high,0);
    }
    nv_close(&v);let absent:NvRow=nv_row(&p,&v);p12_check(s,"closed_view_row_refused",absent.status,-9006);
    p12_check(s,"closed_view_exposes_no_row",absent.data.len,0);nio_free(absent.data);
    p12_unchanged(&p,before,s);nio_free(before);pm_close(&p);nio_free(raw);nio_free(payload);pm_free_words(shape);
}
fn p12_type(index:i32)[]u8 {
    if(index==0){return "i1";}if(index==1){return "i2";}if(index==2){return "i4";}if(index==3){return "i8";}
    if(index==4){return "u1";}if(index==5){return "u2";}if(index==6){return "u4";}if(index==7){return "u8";}
    if(index==8){return "f4";}if(index==9){return "f8";}return "b1";
}
fn p12_matrix(s:*P12Stats)void {
    let words:[]i64=pm_words(2);p12_check(s,"measured_native_i64_stride",((&words[1] as i64)-(&words[0] as i64)),8);pm_free_words(words);
    let t:i32=0;while(t<11 && s.*.failed==0){let e:i32=0;while(e<2 && s.*.failed==0){let o:i32=0;
        while(o<2 && s.*.failed==0){let c:i32=7;while(c<=8 && s.*.failed==0){
            let endian:[]u8="<";if(e==1){endian=">";}let order:[]u8="C";if(o==1){order="F";}
            p12_positive(p12_type(t),endian,order,c,0,s);c=c+1;}o=o+1;}e=e+1;}t=t+1;}
    if(s.*.failed==0){p12_positive("i1","|","C",7,0,s);p12_positive("u1","|","F",8,0,s);
        p12_positive("b1","|","C",7,0,s);p12_positive("f8","<","F",8,1,s);p12_positive("f4",">","C",7,2,s);}
}

fn p12_expect_refusal(p:*ParentMap,code:i32,s:*P12Stats)void {
    let v:NvView=nv_open(p,p.*.root);p12_check(s,"exact_descriptor_refusal",v.status,code);
    p12_check(s,"refusal_no_node",v.node,0);p12_check(s,"refusal_no_dimensions",v.dims.len,0);
    p12_check(s,"refusal_no_strides",v.strides.len,0);p12_check(s,"refusal_no_source_pointer",v.source,0);
    let row:NvRow=nv_row(p,&v);p12_check(s,"refusal_no_metadata_payload",row.data.len,0);
    p12_check(s,"refusal_row_status",row.status,-9006);nio_free(row.data);
    let bits:NvBits=nv_bits(p,&v,0);p12_check(s,"refusal_no_scalar",bits.status,-9005);
    p12_check(s,"refusal_low_zero",bits.low,0);p12_check(s,"refusal_high_zero",bits.high,0);nv_close(&v);
}
fn p12_bad(dtype:[]u8,endian:[]u8,order:[]u8,shape:[]i64,payload:[]u8,carrier:i32,variant:i32,code:i32,s:*P12Stats)void {
    let raw:[]u8=f12_fixture(dtype,endian,order,shape,payload,carrier,variant);let p:ParentMap=p12_parse(raw,s);
    let before:[]u8=p12_fingerprint(&p);p12_expect_refusal(&p,code,s);p12_unchanged(&p,before,s);
    nio_free(before);pm_close(&p);nio_free(raw);
}
fn p12_shape_case(shape:[]i64,order:[]u8,empty:i32,s:*P12Stats)void {
    let payload:[]u8=p12_hex("ab");let length:i32=1-empty;
    let raw:[]u8=f12_fixture("u1","|",order,shape,payload[0..length],7,0);let p:ParentMap=p12_parse(raw,s);
    let before:[]u8=p12_fingerprint(&p);let v:NvView=nv_open(&p,p.root);p12_check(s,"scalar_or_zero_shape_open",v.status,0);
    if(v.status==0){p12_check(s,"exact_shape_rank",v.ndim,shape.len);p12_check(s,"shape_element_count",v.elements,1-empty);
        let coordinates:[]i64=pm_words(8);let i:i32=0;let mismatches:i32=0;
        while(i<shape.len){if(v.dims[i]!=shape[i] || v.strides[i]!=1-empty){mismatches=mismatches+1;}i=i+1;}
        p12_check(s,"all_shape_fields_and_defined_logical_strides",mismatches,0);
        let at:i64=nv_at(&p,&v,coordinates[0..shape.len]);let expected:i64=0;if(empty==1){expected=-9005;}
        p12_check(s,"scalar_or_empty_coordinate",at,expected);pm_free_words(coordinates);
        let bits:NvBits=nv_bits(&p,&v,0);if(empty==1){p12_check(s,"empty_never_exposes_scalar",bits.status,-9005);}
        else{p12_check(s,"rank_zero_or_rank_eight_scalar",bits.status,0);p12_check(s,"scalar_original_bits",bits.low,171);}
        let row:NvRow=nv_row(&p,&v);p12_check(s,"scalar_or_empty_row",row.status,0);
        if(row.status==0){p12_check(s,"zero_or_one_payload_bytes",mi_get(row.data,40),1-empty);}nio_free(row.data);
    }nv_close(&v);p12_unchanged(&p,before,s);nio_free(before);pm_close(&p);nio_free(raw);nio_free(payload);
}
fn p12_handle_refusal(p:*ParentMap,v:*NvView,s:*P12Stats)void {
    p12_check(s,"mutated_or_wrong_map_handle_refused",nv_bound(p,v),0);
    let row:NvRow=nv_row(p,v);p12_check(s,"invalid_handle_no_row",row.data.len,0);p12_check(s,"invalid_handle_row_code",row.status,-9006);nio_free(row.data);
    let bits:NvBits=nv_bits(p,v,0);p12_check(s,"invalid_handle_no_bits",bits.status,-9005);
}
fn p12_corrupt_tables(s:*P12Stats)void {
    let shape:[]i64=pm_words(2);shape[0]=2;shape[1]=3;let payload:[]u8=p12_payload(102,4);
    let raw:[]u8=f12_fixture("f4","<","C",shape,payload,7,0);let p:ParentMap=p12_parse(raw,s);
    let before:[]u8=p12_fingerprint(&p);let args:i32=nv_field(&p,p.root,5);let ar:i32=(args-1)*10;
    let tail:i32=nv_field(&p,args,8);let saved:i64=p.edges[(tail-1)*4+2];
    p.edges[(tail-1)*4+2]=tail;p12_expect_refusal(&p,-9001,s);p.edges[(tail-1)*4+2]=saved;
    saved=p.nodes[ar+9];p.nodes[ar+9]=3;p12_expect_refusal(&p,-9001,s);p.nodes[ar+9]=saved;
    saved=p.edges[(tail-1)*4+1];p.edges[(tail-1)*4+1]=1;p12_expect_refusal(&p,-9001,s);p.edges[(tail-1)*4+1]=saved;
    saved=p.nodes[ar+8];p.nodes[ar+8]=1;p12_expect_refusal(&p,-9001,s);p.nodes[ar+8]=saved;
    let sh:i32=nv_item(&p,args,2);let head:i32=nv_field(&p,sh,7);
    saved=p.edges[(head-1)*4+3];p.edges[(head-1)*4+3]=2;p12_expect_refusal(&p,-9003,s);p.edges[(head-1)*4+3]=saved;
    let dimension:i32=nv_item(&p,sh,0);let dimrow:i32=(dimension-1)*10;
    let saved_kind:i64=p.nodes[dimrow];let saved_at:i64=p.nodes[dimrow+2];
    p.nodes[dimrow]=4;p.nodes[dimrow+2]=p.input.len+1;
    let integer:NvInt=nv_integer(&p,dimension);p12_check(s,"invalid_long_span_not_integer_zero",integer.status,-1);
    p12_expect_refusal(&p,-9003,s);p.nodes[dimrow]=saved_kind;p.nodes[dimrow+2]=saved_at;
    let buffer:i32=nv_item(&p,args,0);let br:i32=(buffer-1)*10;
    saved=p.nodes[br+2];p.nodes[br+2]=-1;p12_expect_refusal(&p,-9004,s);p.nodes[br+2]=saved;
    saved=p.nodes[br+3];p.nodes[br+3]=p.input.len+1;p12_expect_refusal(&p,-9004,s);p.nodes[br+3]=saved;
    let nr:i32=(p.root-1)*10;saved=p.nodes[nr+6];p.nodes[nr+6]=1;p12_expect_refusal(&p,-9001,s);p.nodes[nr+6]=saved;
    let dt:i32=nv_item(&p,args,1);let dr:i32=(dt-1)*10;
    saved=p.nodes[dr+6];p.nodes[dr+6]=1;p12_expect_refusal(&p,-9002,s);p.nodes[dr+6]=saved;
    let count:i32=p.node_count;p.node_count=524289;p12_expect_refusal(&p,-9001,s);p.node_count=count;
    let ec:i32=p.edge_count;p.edge_count=p.edges.len/4+1;p12_expect_refusal(&p,-9001,s);p.edge_count=ec;
    p.status=-1;p12_expect_refusal(&p,-9001,s);p.status=0;
    p12_check(s,"restored_synthetic_map_valid",pm_validate(&p),0);
    let v:NvView=nv_open(&p,p.root);p12_check(s,"handle_control_open",v.status,0);
    if(v.status==0){let at:i32=v.at;v.at=p.input.len;p12_handle_refusal(&p,&v,s);v.at=at;
        let w:i32=v.width;v.width=3;p12_handle_refusal(&p,&v,s);v.width=w;
        let en:i32=v.endian;v.endian=61;p12_handle_refusal(&p,&v,s);v.endian=en;
        let elements:i32=v.elements;v.elements=16777217;p12_handle_refusal(&p,&v,s);v.elements=elements;
        let dim:i64=v.dims[0];v.dims[0]=9223372036854775807;p12_handle_refusal(&p,&v,s);v.dims[0]=dim;
        let stride:i64=v.strides[0];v.strides[0]=9223372036854775807;p12_handle_refusal(&p,&v,s);v.strides[0]=stride;
        let n:i32=v.ndim;v.ndim=9;p12_handle_refusal(&p,&v,s);v.ndim=n;
        let raw2:[]u8=f12_fixture("f4","<","C",shape,payload,7,0);let p2:ParentMap=p12_parse(raw2,s);
        p12_handle_refusal(&p2,&v,s);pm_close(&p2);nio_free(raw2);
        p12_check(s,"restored_handle_valid",nv_bound(&p,&v),1);
    }
    p12_unchanged(&p,before,s);nio_free(before);pm_close(&p);
    p12_handle_refusal(&p,&v,s);nv_close(&v);nio_free(raw);nio_free(payload);pm_free_words(shape);
}
fn p12_refusals(s:*P12Stats)void {
    let shape:[]i64=pm_words(9);shape[0]=2;shape[1]=3;let payload:[]u8=p12_payload(102,4);
    let variant:i32=3;while(variant<=29 && s.*.failed==0){
        if(variant!=18 && variant!=22 && variant!=23){let code:i32=-9002;
            if(variant==3 || variant==16 || variant==17 || variant==19 || variant==24 || variant==25){code=-9001;}
            if(variant==28 || variant==29){code=-9003;}
            p12_bad("f4","<","C",shape[0..2],payload,7,variant,code,s);
        }variant=variant+1;
    }
    p12_bad("O8","<","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f2","<","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f16","<","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f4","=","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f4","|","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f4","","C",shape[0..2],payload,7,0,-9002,s);
    p12_bad("f4","<","K",shape[0..2],payload,7,0,-9003,s);
    p12_bad("f4","<","A",shape[0..2],payload,7,0,-9003,s);
    p12_bad("f4","<","C",shape[0..2],payload,19,0,-9004,s);
    p12_bad("f4","<","C",shape[0..2],payload[0..23],7,0,-9004,s);
    p12_bad("f4","<","C",shape[0..2],payload,7,31,-9003,s);
    shape[0]=-1;p12_bad("f4","<","C",shape[0..2],payload,7,0,-9003,s);
    shape[0]=16777217;shape[1]=0;p12_bad("f4","<","C",shape[0..2],"",7,0,-9003,s);
    shape[0]=16777216;shape[1]=16777216;p12_bad("f4","<","C",shape[0..2],payload,7,0,-9003,s);
    shape[0]=9223372036854775807;p12_bad("f4","<","C",shape[0..1],payload,7,0,-9003,s);
    shape[0]=2097153;p12_bad("f8","<","C",shape[0..1],payload,7,0,-9004,s);
    let i:i32=0;while(i<9){shape[i]=1;i=i+1;}
    let one:[]u8=p12_hex("ab");p12_bad("u1","|","C",shape,one,7,0,-9003,s);nio_free(one);
    p12_shape_case(shape[0..0],"C",0,s);p12_shape_case(shape[0..0],"F",0,s);
    p12_shape_case(shape[0..8],"C",0,s);p12_shape_case(shape[0..8],"F",0,s);
    let zero:i32=0;while(zero<8 && s.*.failed==0){i=0;while(i<8){shape[i]=16777216;i=i+1;}shape[zero]=0;
        p12_shape_case(shape[0..8],"C",1,s);p12_shape_case(shape[0..8],"F",1,s);zero=zero+1;}
    nio_free(payload);pm_free_words(shape);if(s.*.failed==0){p12_corrupt_tables(s);}
}

fn p12_page_name(index:i32)[]u8 {
    let n:[]u8=_zag_i64_to_str(index as i64);let out:[]u8=_zag_str_concat("numeric-page-",n);nio_free(n);return p12_join(out,".bin");
}
fn p12_page(root:i64,page:[]u8,index:i32,manifest:[]u8,replay:i32,s:*P12Stats)void {
    if(index<1 || index>1311 || page.len<160 || page.len>64000 || page.len%160!=0){p12_check(s,"page_envelope",0,1);return;}
    let at:i32=160+(index-1)*48;mi_put(manifest,at,index);mi_put(manifest,at+4,page.len/160);mi_put(manifest,at+8,page.len);
    p12_check(s,"page_hash",ns_sha256(page,manifest[at+16..at+48]),0);let name:[]u8=p12_page_name(index);
    if(replay==0){p12_check(s,"exclusive_inventory_page",mi_write(root,name,page),0);}else{
        let stored:[]u8=nio_alloc(64000);let n:i64=mi_read(root,name,stored,64000);p12_check(s,"reloaded_page_extent",n,page.len);
        if(n==page.len){p12_check(s,"every_inventory_record_byte_reproduced",nio_equal(stored[0..page.len],page),1);}nio_free(stored);
    }nio_free(name);
}
fn p12_bit_roundtrip(p:*ParentMap,v:*NvView,index:i32)i32 {
    let bits:NvBits=nv_bits(p,v,index);if(bits.status!=0 || bits.low<0 || bits.low>4294967295 || bits.high<0 || bits.high>4294967295){return 1;}
    let low:i64=bits.low;let high:i64=bits.high;let i:i32=0;
    while(i<v.*.width){let x:i64=0;if(i<4){x=low%256;low=low/256;}else{x=high%256;high=high/256;}
        let offset:i32=i;if(v.*.endian==62){offset=v.*.width-1-i;}
        if(x!=(p.*.input[v.*.at+index*v.*.width+offset] as i64)){return 1;}i=i+1;}
    return 0;
}
fn p12_inventory(replay:i32,s:*P12Stats)void {
    let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);
    p12_check(s,"pinned_accepted_parent_map_load",p.status,0);if(p.status!=0){mi_loaded_close(&p);nio_free(binding);return;}
    p12_check(s,"accepted_parent_identity",pb_parent_identity(&p),0);
    let before:[]u8=p12_fingerprint(&p);p12_check(s,"complete_memory_fingerprint",before.len,256);
    let root:i64=nio_open_root(p12_root());p12_check(s,"inventory_output_root",(root>=0) as i32,1);
    let page:[]u8=nio_alloc(64000);let manifest:[]u8=nio_alloc(63088);
    p12_check(s,"inventory_page_capacity",page.len,64000);p12_check(s,"manifest_capacity",manifest.len,63088);
    let id:i32=1;let used:i32=0;let pages:i32=0;let records:i32=0;let candidates:i32=0;let supported:i32=0;
    let refused:i32=0;let other:i32=0;let payload_bytes:i64=0;let elements:i64=0;let sample_reads:i64=0;let sample_failures:i32=0;
    let empty:i32=0;let historical_bytes:i32=0;
    while(id<=p.node_count && s.*.failed==0){if(nv_kind(&p,id)==16){
        let recognized:i32=nv_frombuffer(&p,id);if(recognized==1){candidates=candidates+1;}else{other=other+1;}
        let v:NvView=nv_open(&p,id);let row:NvRow=NvRow{.status=0,.data=""};
        if(v.status==0){supported=supported+1;payload_bytes=payload_bytes+v.bytes;elements=elements+v.elements;
            historical_bytes=historical_bytes+v.readonly;if(v.elements==0){empty=empty+1;}else{
                sample_failures=sample_failures+p12_bit_roundtrip(&p,&v,0);sample_reads=sample_reads+1;
                if(v.elements>1){sample_failures=sample_failures+p12_bit_roundtrip(&p,&v,v.elements-1);sample_reads=sample_reads+1;}}
            row=nv_row(&p,&v);
        }else if(v.status>=(-9004) && v.status<=(-9001)){
            if(recognized==1){refused=refused+1;}row.data=nio_alloc(160);
            if(row.data.len==160){mi_put(row.data,0,id);mi_put(row.data,44,nv_field(&p,id,1));mi_put(row.data,60,v.status);}else{row.status=-9007;}
        }else{row.status=v.status;}
        if(row.status!=0 || row.data.len!=160){p12_check(s,"inventory_row_generation",row.status,0);p12_check(s,"inventory_row_extent",row.data.len,160);}
        else{if(mi_copy(row.data,page[used..used+160])!=0){p12_check(s,"inventory_row_copy",0,1);}used=used+160;records=records+1;}
        nio_free(row.data);nv_close(&v);
        if(used==64000 && s.*.failed==0){pages=pages+1;p12_page(root,page,pages,manifest,replay,s);used=0;}
    }id=id+1;}
    if(used>0 && s.*.failed==0){pages=pages+1;p12_page(root,page[0..used],pages,manifest,replay,s);}
    p12_check(s,"all_serialized_reductions_classified",records,p.reductions);
    p12_check(s,"candidate_and_other_accounting",candidates+other,records);
    p12_check(s,"supported_and_refused_candidate_accounting",supported+refused,candidates);
    p12_check(s,"sampled_numeric_bits_reencode_exactly",sample_failures,0);
    p12_check(s,"inventory_page_accounting",pages,(records+399)/400);
    if(s.*.failed==0){mi_copy("R33NV001",manifest);mi_put(manifest,8,1);mi_put(manifest,12,160);mi_put(manifest,16,records);
        mi_put(manifest,20,pages);mi_put(manifest,24,candidates);mi_put(manifest,28,supported);mi_put(manifest,32,refused);
        mi_put(manifest,36,other);mi_put(manifest,40,p.node_count);mi_put(manifest,44,p.reductions);
        p12_check(s,"descriptor_payload_total_u64",nrv3_put64(manifest,48,payload_bytes),0);
        p12_check(s,"descriptor_element_total_u64",nrv3_put64(manifest,56,elements),0);
        mi_copy(binding[32..64],manifest[64..96]);mi_copy(binding[64..96],manifest[96..128]);
        p12_check(s,"sample_read_total_u64",nrv3_put64(manifest,128,sample_reads),0);mi_put(manifest,136,empty);mi_put(manifest,140,historical_bytes);
        let size:i32=160+pages*48;
        if(replay==0){p12_check(s,"exclusive_inventory_manifest",mi_write(root,"numeric-manifest.bin",manifest[0..size]),0);}else{
            let stored:[]u8=nio_alloc(63088);let n:i64=mi_read(root,"numeric-manifest.bin",stored,63088);
            p12_check(s,"reloaded_inventory_manifest_extent",n,size);if(n==size){p12_check(s,"entire_inventory_manifest_reproduced",nio_equal(stored[0..size],manifest[0..size]),1);}nio_free(stored);}
    }
    _zag_print("N12_REDUCTIONS,");_zag_println(_zag_i64_to_str(records));_zag_print("N12_FROMBUFFER_CANDIDATES,");_zag_println(_zag_i64_to_str(candidates));
    _zag_print("N12_SUPPORTED_VIEWS,");_zag_println(_zag_i64_to_str(supported));_zag_print("N12_REFUSED_CANDIDATES,");_zag_println(_zag_i64_to_str(refused));
    _zag_print("N12_OTHER_REDUCERS,");_zag_println(_zag_i64_to_str(other));_zag_print("N12_DESCRIPTOR_PAYLOAD_BYTES,");_zag_println(_zag_i64_to_str(payload_bytes));
    _zag_print("N12_DESCRIPTOR_ELEMENTS,");_zag_println(_zag_i64_to_str(elements));_zag_print("N12_FIRST_LAST_BIT_READS,");_zag_println(_zag_i64_to_str(sample_reads));
    _zag_print("N12_EMPTY_VIEWS,");_zag_println(_zag_i64_to_str(empty));_zag_print("N12_INVENTORY_PAGES,");_zag_println(_zag_i64_to_str(pages));
    p12_unchanged(&p,before,s);p12_check(s,"post_inspection_parent_identity",pb_parent_identity(&p),0);
    p12_check(s,"numeric_views_do_not_admit_training",pb_training_admission(binding),-8904);
    nio_free(before);nio_free(page);nio_free(manifest);p12_check(s,"inventory_root_closed",nio_close(root),0);mi_loaded_close(&p);nio_free(binding);
}

fn p12_has(b:[]u8,n:[]u8)i32 {
    let i:i32=0;while(i+n.len<=b.len){let k:i32=0;while(k<n.len && b[i+k]==n[k]){k=k+1;}
        if(k==n.len){return 1;}i=i+1;}return 0;
}
fn p12_number(b:[]u8,prefix:[]u8,tail:[]u8)i64 {
    let value:i64=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i64=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<12){v=v*10+(b[at] as i64)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;
}
fn p12_run(root:i64,mode:[]u8,expected:i32,ms:i64,s:*P12Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,ms,1048576);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}
    if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    p12_check(s,"child_supervision_status",r.status,0);p12_check(s,"child_started",r.started,1);p12_check(s,"child_reaped",r.reaped,1);
    p12_check(s,"child_exit",r.exit_code,expected);p12_check(s,"child_signal",r.signal,0);p12_check(s,"empty_child_stderr",r.stderr_bytes,0);
    p12_check(s,"bounded_observed_child_rss",(r.peak_rss>0 && r.peak_rss<=402653184) as i32,1);
    let name:[]u8=_zag_str_concat(mode,".stdout");let log:[]u8=nio_alloc(1048576);let n:i64=mi_read(root,name,log,1048576);nio_free(name);
    p12_check(s,"complete_child_capture",n,r.stdout_bytes);
    if(n>=0 && n<=1048576){if(expected==0){let checks:i64=p12_number(log[0..n as i32],"N12_CHILD_COUNTS,",",0\n");
        p12_check(s,"unambiguous_completed_check_count",(checks>0 && checks<=100000) as i32,1);
        p12_check(s,"child_terminal_pass",p12_has(log[0..n as i32],"N12_CHILD_PASS\n"),1);
        if(checks>0 && checks<=100000 && r.status==0 && r.exit_code==0){s.*.child_checks=s.*.child_checks+(checks as i32);}
    }else{p12_check(s,"invalid_mode_silent",n,0);}}nio_free(log);
}
fn p12_field(b:[]u8,key:[]u8,value:i64)[]u8 {
    let n:[]u8=_zag_i64_to_str(value);b=p12_join(b,key);b=p12_join(b,n);nio_free(n);return b;
}
fn p12_supervise()i32 {
    if(nio_guard(180)!=0){return 3;}let a:NativeAdmissionV3=nrv3_admit_root(p12_root());if(a.status!=0){return 4;}
    let root:i64=a.root;let s:P12Stats=p12_stats();
    p12_run(root,"invalid",2,5000,&s);p12_run(root,"matrix",0,20000,&s);p12_run(root,"refusals",0,20000,&s);
    p12_run(root,"inventory-write",0,60000,&s);p12_run(root,"inventory-replay",0,60000,&s);
    p12_check(&s,"all_five_children_reaped",s.children,5);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N12\",\n  \"planned_children\":5","");
    json=p12_field(json,",\n  \"children_reaped\":",s.children);json=p12_field(json,",\n  \"parent_failures_before_result_write\":",s.failed);
    json=p12_field(json,",\n  \"verified_completed_child_checks\":",s.child_checks);json=p12_field(json,",\n  \"parent_checks_before_result_write\":",s.checks);
    json=p12_field(json,",\n  \"child_cpu_us\":",s.cpu);json=p12_field(json,",\n  \"observed_child_wall_us\":",s.wall);json=p12_field(json,",\n  \"peak_child_rss_bytes\":",s.rss);
    json=p12_join(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"python_execution\":false,\n  \"reducer_execution\":false,\n  \"semantic_digest_recomputed\":false,\n  \"full_parent_migration_verified\":false,\n  \"requires_terminal_marker\":true\n}\n");
    p12_check(&s,"native_result_exclusive_write",mi_write(root,"NATIVE_RESULT.json",json),0);_zag_print(json);nio_free(json);
    p12_check(&s,"output_root_closed",nio_close(root),0);if(s.failed!=0){return 1;}
    _zag_println("R33_N12_BOUNDED_NUMERIC_VIEW_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return p12_supervise();}if(_zag_strcmp(mode,"invalid")==1){return 2;}
    let seconds:i64=20;if(_zag_strcmp(mode,"inventory-write")==1 || _zag_strcmp(mode,"inventory-replay")==1){seconds=60;}
    if(nio_deadline(seconds)!=0){return 3;}let s:P12Stats=p12_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"matrix")==1){p12_matrix(&s);}else if(_zag_strcmp(mode,"refusals")==1){p12_refusals(&s);}
    else if(_zag_strcmp(mode,"inventory-write")==1){p12_inventory(0,&s);}else if(_zag_strcmp(mode,"inventory-replay")==1){p12_inventory(1,&s);}else{handled=0;}
    if(handled==0){return 2;}_zag_print("N12_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed));
    if(s.failed!=0){return 1;}_zag_println("N12_CHILD_PASS");return 0;
}

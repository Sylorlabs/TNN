// Read-only numeric interpretation of an explicit NumPy _frombuffer subset.
// No Python, reducer invocation, dtype constructor, learner or graph cognition.
// Layout is derived only from the serialized descriptor and retained raw bytes.
@import("binding.zag")

struct NvView {status:i32,node:i32,buffer:i32,dtype:i32,dstate:i32,kind:i32,width:i32,endian:i32,order:i32,ndim:i32,elements:i32,at:i32,bytes:i32,shape_node:i32,readonly:i32,dims:[]i64,strides:[]i64}
struct NvBits {status:i32,low:i64,high:i64}
fn nv_empty(code:i32)NvView {
    let z:*i64=null as *i64;return NvView{.status=code,.node=0,.buffer=0,.dtype=0,.dstate=0,.kind=0,.width=0,.endian=0,.order=0,.ndim=0,.elements=0,.at=0,.bytes=0,.shape_node=0,.readonly=0,.dims=z[0..0],.strides=z[0..0]};
}
fn nv_close(v:*NvView)void {let code:i32=v.*.status;pm_free_words(v.*.dims);pm_free_words(v.*.strides);v.*=nv_empty(code);}
fn nv_fail(v:*NvView,code:i32)NvView {nv_close(v);return nv_empty(code);}
fn nv_field(p:*ParentMap,id:i32,offset:i32)i32 {
    if(pm_valid_id(p,id)!=1 || offset<0 || offset>9){return 0;}return p.*.nodes[(id-1)*10+offset] as i32;
}
fn nv_tuple_size(p:*ParentMap,id:i32)i32 {if(pm_kind(p,id)!=10){return -1;}return nv_field(p,id,9);}
fn nv_item(p:*ParentMap,id:i32,index:i32)i32 {
    if(index<0 || nv_tuple_size(p,id)<=index){return 0;}let e:i32=nv_field(p,id,7);let count:i32=0;let last:i32=0;
    while(e>0 && count<=index){if(e>p.*.edge_count || e<=last){return 0;}let row:i32=(e-1)*4;
        if(p.*.edges[row+3]!=1 || p.*.edges[row+1]!=0){return 0;}let target:i32=p.*.edges[row] as i32;
        if(pm_valid_id(p,target)!=1){return 0;}if(count==index){return target;}last=e;e=p.*.edges[row+2] as i32;count=count+1;}return 0;
}
fn nv_text(p:*ParentMap,id:i32,text:[]u8)i32 {return (pm_kind(p,id)==6 && nio_equal(pm_raw(p,id),text)==1) as i32;}
fn nv_symbol(p:*ParentMap,id:i32,module:[]u8,name:[]u8)i32 {
    return (pm_kind(p,id)==14 && nv_text(p,nv_field(p,id,4),module)==1 && nv_text(p,nv_field(p,id,5),name)==1) as i32;
}
fn nv_frombuffer(p:*ParentMap,id:i32)i32 {
    if(pm_kind(p,id)!=16){return 0;}let g:i32=nv_field(p,id,4);
    return (nv_symbol(p,g,"numpy._core.numeric","_frombuffer")==1 || nv_symbol(p,g,"numpy.core.numeric","_frombuffer")==1) as i32;
}
fn nv_integer(p:*ParentMap,id:i32,out:*i64)i32 {
    let kind:i32=pm_kind(p,id);if(kind!=3 && kind!=4){return -1;}return pm_small_int(p,id,out);
}
fn nv_single_build(p:*ParentMap,id:i32)i32 {
    // Later BUILD operations could change semantics: require exactly one.
    if(nv_field(p,id,9)!=1){return 0;}let e:i32=nv_field(p,id,7);
    if(e<1 || e>p.*.edge_count || nv_field(p,id,8)!=e){return 0;}let row:i32=(e-1)*4;
    if(p.*.edges[row+3]!=3 || p.*.edges[row+1]!=0 || p.*.edges[row+2]!=0){return 0;}return p.*.edges[row] as i32;
}
fn nv_dtype(p:*ParentMap,id:i32,v:*NvView)i32 {
    if(pm_kind(p,id)!=16){return -9002;}let g:i32=nv_field(p,id,4);
    if(nv_symbol(p,g,"numpy","dtype")!=1 && nv_symbol(p,g,"numpy._core._multiarray_umath","dtype")!=1){return -9002;}
    let args:i32=nv_field(p,id,5);if(nv_tuple_size(p,args)!=3){return -9002;}
    let text_id:i32=nv_item(p,args,0);let text:[]u8=pm_raw(p,text_id);
    if(pm_kind(p,text_id)!=6 || text.len!=2){return -9002;}
    let kind:i32=text[0] as i32;let width:i32=(text[1] as i32)-48;
    if(!((kind==105 || kind==117) && (width==1 || width==2 || width==4 || width==8)) &&
       !(kind==102 && (width==4 || width==8)) && !(kind==98 && width==1)){return -9002;}
    let a:i32=nv_item(p,args,1);let b:i32=nv_item(p,args,2);
    if(pm_kind(p,a)!=2 || nv_field(p,a,6)!=0 || pm_kind(p,b)!=2 || nv_field(p,b,6)!=1){return -9002;}
    let state:i32=nv_single_build(p,id);if(nv_tuple_size(p,state)!=8){return -9002;}let n:i64=0;
    if(nv_integer(p,nv_item(p,state,0),&n)!=0 || n!=3){return -9002;}
    let endian_id:i32=nv_item(p,state,1);let endian:[]u8=pm_raw(p,endian_id);
    if(pm_kind(p,endian_id)!=6 || endian.len!=1){return -9002;}let order:i32=endian[0] as i32;
    if(order!=60 && order!=62 && !(order==124 && width==1)){return -9002;}
    let i:i32=2;while(i<=4){if(pm_kind(p,nv_item(p,state,i))!=1){return -9002;}i=i+1;}
    if(nv_integer(p,nv_item(p,state,5),&n)!=0 || n!=(-1)){return -9002;}
    if(nv_integer(p,nv_item(p,state,6),&n)!=0 || n!=(-1)){return -9002;}
    if(nv_integer(p,nv_item(p,state,7),&n)!=0 || n!=0){return -9002;}
    v.*.dtype=id;v.*.dstate=state;v.*.kind=kind;v.*.width=width;v.*.endian=order;return 0;
}
fn nv_open(p:*ParentMap,id:i32)NvView {
    let v:NvView=nv_empty(-9001);if(p.*.status!=0 || nv_frombuffer(p,id)!=1){return v;}
    if(nv_field(p,id,9)!=0){return v;}let args:i32=nv_field(p,id,5);if(nv_tuple_size(p,args)!=4){return v;}
    let buffer:i32=nv_item(p,args,0);let kind:i32=pm_kind(p,buffer);if(kind!=7 && kind!=8){return nv_empty(-9004);}
    let code:i32=nv_dtype(p,nv_item(p,args,1),&v);if(code!=0){return nv_empty(code);}
    let shape:i32=nv_item(p,args,2);let ndim:i32=nv_tuple_size(p,shape);if(ndim<0 || ndim>8){return nv_empty(-9003);}
    let order_id:i32=nv_item(p,args,3);let order:i32=0;if(nv_text(p,order_id,"C")==1){order=67;}if(nv_text(p,order_id,"F")==1){order=70;}
    if(order==0){return nv_empty(-9003);}v.dims=pm_words(8);v.strides=pm_words(8);
    if(v.dims.len!=8 || v.strides.len!=8){return nv_fail(&v,-9007);}let i:i32=0;let product:i64=1;
    while(i<ndim){let n:i64=-1;if(nv_integer(p,nv_item(p,shape,i),&n)!=0 || n<0 || n>16777216){return nv_fail(&v,-9003);}
        v.dims[i]=n;if(n>0 && product>16777216/n){return nv_fail(&v,-9003);}product=product*n;i=i+1;}
    let at:i32=nv_field(p,buffer,2);let bytes:i32=nv_field(p,buffer,3);
    if(at<0 || bytes<0 || at>p.*.input.len || bytes>p.*.input.len-at || product>16777216/v.width || bytes!=product*v.width){return nv_fail(&v,-9004);}
    let stride:i64=1;i=ndim-1;if(order==70){i=0;}
    while(i>=0 && i<ndim){v.strides[i]=stride;stride=stride*v.dims[i];if(order==67){i=i-1;}else{i=i+1;}}
    v.status=0;v.node=id;v.buffer=buffer;v.ndim=ndim;v.elements=product as i32;v.at=at;v.bytes=bytes;v.order=order;
    v.shape_node=shape;v.readonly=(kind==7) as i32;return v;
}
fn nv_at(v:*NvView,coordinates:[]i64)i64 {
    if(v.*.status!=0 || coordinates.len!=v.*.ndim || v.*.dims.len!=8 || v.*.strides.len!=8){return -9005;}
    let result:i64=0;let i:i32=0;while(i<v.*.ndim){if(coordinates[i]<0 || coordinates[i]>=v.*.dims[i]){return -9005;}
        result=result+coordinates[i]*v.*.strides[i];i=i+1;}if(result<0 || result>=v.*.elements){return -9005;}return result;
}
fn nv_bits(p:*ParentMap,v:*NvView,index:i64)NvBits {
    let result:NvBits=NvBits{.status=-9005,.low=0,.high=0};
    if(p.*.status!=0 || v.*.status!=0 || index<0 || index>=v.*.elements || v.*.width<1 || v.*.width>8){return result;}
    let start:i64=v.*.at+index*v.*.width;if(start<0 || start+v.*.width>p.*.input.len){return result;}
    let i:i32=0;let multiplier:i64=1;
    while(i<v.*.width){let offset:i32=i;if(v.*.endian==62){offset=v.*.width-1-i;}let x:i64=p.*.input[(start as i32)+offset] as i64;
        if(i==4){multiplier=1;}if(i<4){result.low=result.low+x*multiplier;}else{result.high=result.high+x*multiplier;}
        multiplier=multiplier*256;i=i+1;}result.status=0;return result;
}
fn nv_row(p:*ParentMap,v:*NvView,out:[]u8)i32 {
    if(v.*.status!=0 || out.len<160 || v.*.dims.len!=8 || v.*.strides.len!=8){return -9006;}
    let row:[]u8=nio_alloc(160);if(row.len!=160){return -9007;}let code:i32=0;
    code=code+mi_put(row,0,v.*.node)+mi_put(row,4,v.*.buffer)+mi_put(row,8,v.*.dtype)+mi_put(row,12,v.*.kind);
    code=code+mi_put(row,16,v.*.width)+mi_put(row,20,v.*.endian)+mi_put(row,24,v.*.order)+mi_put(row,28,v.*.ndim);
    code=code+mi_put(row,32,v.*.elements)+mi_put(row,36,v.*.at)+mi_put(row,40,v.*.bytes)+mi_put(row,44,nv_field(p,v.*.node,1));
    code=code+mi_put(row,48,v.*.shape_node)+mi_put(row,52,v.*.readonly)+mi_put(row,56,v.*.dstate);
    let i:i32=0;while(i<8){code=code+mi_put(row,64+i*4,v.*.dims[i])+mi_put(row,96+i*4,v.*.strides[i]);i=i+1;}
    if(code==0){code=ns_sha256(p.*.input[v.*.at..v.*.at+v.*.bytes],row[128..160]);}
    if(code==0){mi_copy(row,out);}nio_free(row);if(code!=0){return -9006;}return 160;
}

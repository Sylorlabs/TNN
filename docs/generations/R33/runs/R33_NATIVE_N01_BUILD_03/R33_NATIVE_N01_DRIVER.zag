// New native platform fixture. No C03 replay, no learner, no Python.
@import("R33_NATIVE_PROCESS_V1.zag")

fn main()i32 {
    if(_zag_argc()!=2){return 2;}
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){
        if(nio_guard(30)!=0){return 3;}
        let root:i64=nio_open_root("Research/R33_NATIVE_N01_RUN_PRIMARY_V1");
        if(root<0){return 3;}
        let checked:NativeRun=nr_run(root,_zag_arg(0),"check","check");
        if(checked.started!=1 || checked.exit_code!=0 || checked.signal!=0 || checked.stderr_bytes!=0 || checked.stdout_bytes<1 || checked.stdout_bytes>65536){return 1;}
        let deadline:NativeRun=nr_run(root,_zag_arg(0),"deadline","deadline");
        if(deadline.started!=1 || deadline.signal!=14 || deadline.stderr_bytes!=0 || deadline.stdout_bytes!=0){return 1;}
        let cpu:NativeRun=nr_run(root,_zag_arg(0),"cpu","cpu");
        if(cpu.started!=1 || (cpu.signal!=24 && cpu.signal!=9) || cpu.stderr_bytes!=0 || cpu.stdout_bytes!=0){return 1;}
        if(checked.peak_rss<1 || deadline.peak_rss<1 || cpu.peak_rss<1 ||
           checked.peak_rss>268435456 || deadline.peak_rss>268435456 || cpu.peak_rss>268435456){return 1;}
        nio_close(root);_zag_println("N01_NATIVE_SUPERVISION_PASS,3");return 0;
    }
    if(nio_guard(10)!=0){_zag_println("NATIVE_GUARD_UNAVAILABLE");return 3;}
    // Explicit timeout and CPU negative controls run in separate processes.
    if(_zag_strcmp(mode,"deadline")==1){
        if(nio_deadline(1)!=0){return 4;}
        while(true){_zag_darwin_syscall(93,0,0,0,0,0,0);}return 5;
    }
    if(_zag_strcmp(mode,"cpu")==1){
        if(nio_limit(0,1)!=0){return 4;}
        let v:i64=0;while(true){v=v+1;if(v>1000000){v=0;}}return 5;
    }
    if(_zag_strcmp(mode,"check")!=1){return 2;}
    let directory:[]u8="Research/R33_NATIVE_N01_RUN_PRIMARY_V1/fs";
    let failed:i32=0;
    failed=failed+nio_metric("mkdir",nio_mkdir(directory),0);
    let root:i64=nio_open_root(directory);
    failed=failed+nio_metric("open_root",(root>=0) as i64,1);
    if(root<0){return 6;}
    let fd:i64=nio_open_child(root,"staged.bin",1);
    failed=failed+nio_metric("exclusive_create",(fd>=0) as i64,1);
    if(fd<0){return 7;}
    failed=failed+nio_metric("regular_file",nio_regular(fd) as i64,1);
    failed=failed+nio_metric("duplicate_create",nio_open_child(root,"staged.bin",1),-17);
    failed=failed+nio_metric("parent_path_refused",nio_open_child(root,"../outside",1),-7401);
    let input:[]u8=nio_alloc(6);
    input[0]=0;input[1]=127;input[2]=128;input[3]=255;input[4]=10;input[5]=0;
    failed=failed+nio_metric("write",nio_write_all(fd,input),6);
    failed=failed+nio_metric("file_fsync",nio_sync(fd),0);
    failed=failed+nio_metric("file_size",nio_seek(fd,0,2),6);
    let out:[]u8=nio_alloc(7);let i:i32=0;while(i<7){out[i]=211;i=i+1;}
    failed=failed+nio_metric("short_capacity",nio_read_exact(fd,out,5),-7403);
    failed=failed+nio_metric("short_unchanged",out[0] as i64,211);
    failed=failed+nio_metric("read",nio_read_exact(fd,out,6),6);
    failed=failed+nio_metric("byte_identity",nio_equal(input,out[0..6]) as i64,1);
    failed=failed+nio_metric("untouched_tail",out[6] as i64,211);
    failed=failed+nio_metric("publish",nio_link(root,"staged.bin","committed.bin"),0);
    failed=failed+nio_metric("publish_no_replace",nio_link(root,"staged.bin","committed.bin"),-17);
    failed=failed+nio_metric("directory_fsync",nio_sync(root),0);
    failed=failed+nio_metric("writer_lock",nio_lock(fd),0);
    let other:i64=nio_open_child(root,"staged.bin",0);
    failed=failed+nio_metric("other_open",(other>=0) as i64,1);
    failed=failed+nio_metric("second_writer_refused",nio_lock(other),-35);
    failed=failed+nio_metric("other_close",nio_close(other),0);
    failed=failed+nio_metric("writer_close",nio_close(fd),0);
    let published:i64=nio_open_child(root,"committed.bin",0);
    failed=failed+nio_metric("published_read",nio_read_exact(published,out,6),6);
    failed=failed+nio_metric("published_identity",nio_equal(input,out[0..6]) as i64,1);
    failed=failed+nio_metric("published_close",nio_close(published),0);
    failed=failed+nio_metric("missing_file",nio_open_child(root,"absent.bin",0),-2);
    failed=failed+nio_metric("root_close",nio_close(root),0);
    nio_free(input);nio_free(out);
    _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(failed as i64));
    if(failed>0){return 1;}return 0;
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tnn:r33:telemetry:v1",
  "title": "R33 causal telemetry event or competency snapshot",
  "description": "Specification only. Evaluator-only records must not be readable by learner fitting, routing, scheduling or proposal selection. Schema acceptance is not causal or runtime qualification.",
  "oneOf": [
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/snapshot"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "method", "evidence_event_ids"],
          "properties": {
            "status": {"enum": ["MEASURED", "DERIVED", "ESTIMATED"]},
            "value": {"type": ["number", "object", "array", "boolean"]},
            "unit": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "numerator": {"type": "number"},
            "denominator": {"type": "number", "exclusiveMinimum": 0},
            "sample_unit": {"type": "string", "minLength": 1},
            "uncertainty": {"type": ["object", "null"]},
            "coverage_note": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "reason"],
          "properties": {
            "status": {"enum": ["NOT_MEASURED", "NOT_APPLICABLE", "INVALID"]},
            "value": {"type": "null"},
            "reason": {"type": "string", "minLength": 1},
            "evidence_event_ids": {"$ref": "#/$defs/ids"}
          }
        }
      ]
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "kind"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["HUMAN", "HUMAN_GROUP", "ARCHITECTURE_TEAM", "LEARNER", "SOFTWARE_TEACHING_AID", "EVALUATOR", "PROTECTED_SUPERVISOR"]},
        "delegating_human_actor_id": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_sha256", "grant_id", "grant_status", "effective_milestone", "supervisor_epoch"],
      "properties": {
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "grant_id": {"type": ["string", "null"]},
        "grant_status": {"enum": ["AUTHENTICATED", "NOT_GRANTED", "UNVERIFIED", "REVOKED", "NOT_APPLICABLE_AUDIT"]},
        "effective_milestone": {"enum": [null, "M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7"]},
        "supervisor_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_seconds", "wall_seconds", "peak_rss_bytes", "logical_memory_bytes", "stored_parameters", "active_parameters", "total_connections", "active_connections", "training_operations", "inference_operations", "io_bytes", "human_interventions"],
      "properties": {
        "cpu_seconds": {"$ref": "#/$defs/measurement"},
        "wall_seconds": {"$ref": "#/$defs/measurement"},
        "peak_rss_bytes": {"$ref": "#/$defs/measurement"},
        "logical_memory_bytes": {"$ref": "#/$defs/measurement"},
        "stored_parameters": {"$ref": "#/$defs/measurement"},
        "active_parameters": {"$ref": "#/$defs/measurement"},
        "total_connections": {"$ref": "#/$defs/measurement"},
        "active_connections": {"$ref": "#/$defs/measurement"},
        "training_operations": {"$ref": "#/$defs/measurement"},
        "inference_operations": {"$ref": "#/$defs/measurement"},
        "io_bytes": {"$ref": "#/$defs/measurement"},
        "human_interventions": {"$ref": "#/$defs/measurement"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_id", "region_id", "owner", "before_sha256", "after_sha256", "delta_payload_sha256", "rule_version", "trigger_event_ids", "commit_status"],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/id"},
        "region_id": {"$ref": "#/$defs/id"},
        "owner": {"enum": ["LEARNER", "PROTECTED_SUPERVISOR", "TRAINER_POLICY", "ARCHITECTURE_MIGRATION"]},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "delta_payload_sha256": {"$ref": "#/$defs/sha256"},
        "rule_version": {"$ref": "#/$defs/id"},
        "trigger_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "commit_status": {"enum": ["PROPOSED", "COMMITTED", "REJECTED", "ROLLED_BACK"]}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "schema_version", "event_id", "ordinal", "clock_domain", "timestamp_ns", "experiment_id", "brain_id", "branch_id", "competency_ids", "event_kind", "visibility", "actor", "authority", "parent_event_ids", "experience_id", "payload_sha256", "checkpoint_before_sha256", "checkpoint_after_sha256", "causal_refs", "mutations", "assistance", "resources", "coverage"],
      "properties": {
        "record_type": {"const": "CAUSAL_EVENT"},
        "schema_version": {"const": 1},
        "event_id": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 0},
        "clock_domain": {"$ref": "#/$defs/id"},
        "timestamp_ns": {"type": "integer", "minimum": 0},
        "experiment_id": {"$ref": "#/$defs/id"},
        "brain_id": {"$ref": "#/$defs/id"},
        "branch_id": {"$ref": "#/$defs/id"},
        "competency_ids": {"$ref": "#/$defs/ids"},
        "event_kind": {"enum": ["OBSERVATION", "TRAINER_INPUT", "MEMORY", "HYPOTHESIS", "ROUTING", "PREDICTION", "ACTION", "CONSEQUENCE", "UPDATE", "PROPOSAL", "GRANT", "CHECKPOINT", "ROLLBACK", "ASSESSMENT", "ERROR"]},
        "visibility": {"enum": ["LEARNER_ADMITTED", "EVALUATOR_ONLY", "SUPERVISOR_ONLY", "HUMAN_DASHBOARD_ONLY"]},
        "actor": {"$ref": "#/$defs/actor"},
        "authority": {"$ref": "#/$defs/authority"},
        "parent_event_ids": {"$ref": "#/$defs/ids"},
        "experience_id": {"type": ["string", "null"]},
        "payload_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "checkpoint_before_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_after_sha256": {"$ref": "#/$defs/sha256"},
        "causal_refs": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence", "memory", "hypotheses", "mechanisms", "predictions", "decisions", "consequences", "updates"],
          "properties": {
            "evidence": {"$ref": "#/$defs/ids"}, "memory": {"$ref": "#/$defs/ids"},
            "hypotheses": {"$ref": "#/$defs/ids"}, "mechanisms": {"$ref": "#/$defs/ids"},
            "predictions": {"$ref": "#/$defs/ids"}, "decisions": {"$ref": "#/$defs/ids"},
            "consequences": {"$ref": "#/$defs/ids"}, "updates": {"$ref": "#/$defs/ids"}
          }
        },
        "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
        "assistance": {
          "type": "object", "additionalProperties": false,
          "required": ["stage", "assisted", "requested_by_learner", "input_event_ids", "human_interventions", "software_aid_interventions"],
          "properties": {
            "stage": {"enum": ["H0", "H1", "H2", "H3", "H4", "H5", "NOT_APPLICABLE"]},
            "assisted": {"type": "boolean"},
            "requested_by_learner": {"type": "boolean"},
            "input_event_ids": {"$ref": "#/$defs/ids"},
            "human_interventions": {"type": "integer", "minimum": 0},
            "software_aid_interventions": {"type": "integer", "minimum": 0}
          }
        },
        "resources": {"$ref": "#/$defs/resources"},
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "missing_fields", "dropped_events", "claim_scope"],
          "properties": {
            "status": {"enum": ["COMPLETE_WITHIN_DECLARED_SCOPE", "INCOMPLETE", "INVALID"]},
            "missing_fields": {"$ref": "#/$defs/ids"},
            "dropped_events": {"type": "integer", "minimum": 0},
            "claim_scope": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "competency_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["experiences_seen", "unique_and_replayed", "learning_curve", "fresh_performance", "delayed_retention", "uncertainty_or_hypotheses", "known_and_unresolved", "mistakes_by_category", "operational_understanding", "memorized_reproduction", "changed_example_transfer", "help_dependence", "memory_retrieval", "forgetting_regression", "prior_skill_interference", "lesson_attributable_changes", "trainer_interventions"],
      "properties": {
        "experiences_seen": {"$ref": "#/$defs/measurement"},
        "unique_and_replayed": {"$ref": "#/$defs/measurement"},
        "learning_curve": {"$ref": "#/$defs/measurement"},
        "fresh_performance": {"$ref": "#/$defs/measurement"},
        "delayed_retention": {"$ref": "#/$defs/measurement"},
        "uncertainty_or_hypotheses": {"$ref": "#/$defs/measurement"},
        "known_and_unresolved": {"$ref": "#/$defs/measurement"},
        "mistakes_by_category": {"$ref": "#/$defs/measurement"},
        "operational_understanding": {"$ref": "#/$defs/measurement"},
        "memorized_reproduction": {"$ref": "#/$defs/measurement"},
        "changed_example_transfer": {"$ref": "#/$defs/measurement"},
        "help_dependence": {"$ref": "#/$defs/measurement"},
        "memory_retrieval": {"$ref": "#/$defs/measurement"},
        "forgetting_regression": {"$ref": "#/$defs/measurement"},
        "prior_skill_interference": {"$ref": "#/$defs/measurement"},
        "lesson_attributable_changes": {"$ref": "#/$defs/measurement"},
        "trainer_interventions": {"$ref": "#/$defs/measurement"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "schema_version", "snapshot_id", "experiment_id", "brain_id", "branch_id", "competency_id", "checkpoint_sha256", "aggregation_version", "visibility", "metrics", "resources", "source_event_ids", "qualification_status"],
      "properties": {
        "record_type": {"const": "COMPETENCY_SNAPSHOT"},
        "schema_version": {"const": 1},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "experiment_id": {"$ref": "#/$defs/id"},
        "brain_id": {"$ref": "#/$defs/id"},
        "branch_id": {"$ref": "#/$defs/id"},
        "competency_id": {"$ref": "#/$defs/id"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "aggregation_version": {"$ref": "#/$defs/id"},
        "visibility": {"enum": ["EVALUATOR_ONLY", "HUMAN_DASHBOARD_ONLY"]},
        "metrics": {"$ref": "#/$defs/competency_metrics"},
        "resources": {"$ref": "#/$defs/resources"},
        "source_event_ids": {"$ref": "#/$defs/ids"},
        "qualification_status": {"enum": ["NOT_ASSESSED", "INCOMPLETE", "FAILED", "PASSED_BOUNDED_CONTRACT"]}
      }
    }
  }
}

// TNN R30 BIG BOOM AEIF — associative-episodic architecture branch.
//
// Design contract:
// - cognition and mutable architecture are implemented in Zag.
// - protected core exposes generic computational physics, trace/provenance, and root boundaries.
// - TNN controls memory disposition and all non-core PAM lifecycle operations.
// - no object/category/English/task answer tables enter mutable cognition.
// - every consequential decision emits a causal trace record.
//
// This file is intentionally self-contained for native compiler replay.

fn print_i32(v:i32)void{ _zag_println(_zag_i64_to_str(v as i64)); }
fn metric(label:@borrows []u8,v:i32)void{ _zag_print(label); _zag_print(","); print_i32(v); }
fn abs_i32(x:i32)i32 @noalloc { if(x<0){return 0-x;} return x; }
fn min_i32(a:i32,b:i32)i32 @noalloc { if(a<b){return a;} return b; }
fn max_i32(a:i32,b:i32)i32 @noalloc { if(a>b){return a;} return b; }
fn clamp_i32(x:i32,lo:i32,hi:i32)i32 @noalloc { if(x<lo){return lo;} if(x>hi){return hi;} return x; }
fn mod_pos(x:i32,m:i32)i32 @noalloc { let q:i32=x/m; let r:i32=x-q*m; if(r<0){return r+m;} return r; }
fn mix(seed:i32,x:i32)i32 @noalloc {
    let v:i32=seed*1103515245+x*12345+1013904223;
    let a:i32=v-(v/2147483)*2147483;
    if(a<0){return 0-a;} return a;
}

// -----------------------------------------------------------------------------
// Protected causal trace substrate.
// Generic reason/stage codes are computational metadata, not task labels.
// -----------------------------------------------------------------------------

const TRACE_CAP:i32=8192;
const STAGE_SENSOR:i32=1;
const STAGE_PAM:i32=2;
const STAGE_ROUTE:i32=3;
const STAGE_ENTITY:i32=4;
const STAGE_MEMORY:i32=5;
const STAGE_WORLD:i32=6;
const STAGE_LANGUAGE:i32=7;
const STAGE_SOCIAL:i32=8;
const STAGE_REVISION:i32=9;
const STAGE_DECISION:i32=10;

const REASON_EVIDENCE_GAIN:i32=1;
const REASON_UNCERTAINTY:i32=2;
const REASON_CONTRADICTION:i32=3;
const REASON_PLATEAU:i32=4;
const REASON_MEMORY_MISS:i32=5;
const REASON_ROUTE_MISS:i32=6;
const REASON_REPRESENTATION_LOSS:i32=7;
const REASON_RESOURCE_PRESSURE:i32=8;
const REASON_REGRESSION:i32=9;
const REASON_VERIFIED_GAIN:i32=10;
const REASON_SOURCE_CONFLICT:i32=11;
const REASON_DELAYED_REGRET:i32=12;

fn trace_emit(
    step:i32,stage:i32,reason:i32,subject:i32,
    evidence:i32,confidence:i32,parent:i32,
    t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,
    t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32
)void @noalloc {
    if(t_count.*>=TRACE_CAP){return;}
    let at:i32=t_count.*;
    t_step[at]=step; t_stage[at]=stage; t_reason[at]=reason; t_subject[at]=subject;
    t_evidence[at]=evidence; t_conf[at]=confidence; t_parent[at]=parent;
    t_count.*=at+1;
}

fn trace_last_reason(stage:i32,t_stage:[]i32,t_reason:[]i32,t_count:i32)i32 @noalloc {
    let i:i32=t_count-1;
    while(i>=0){ if(t_stage[i]==stage){return t_reason[i];} i=i-1; }
    return 0;
}

// -----------------------------------------------------------------------------
// TNN-owned memory hierarchy.
// Protected core supplies storage classes only; learner chooses disposition.
// -----------------------------------------------------------------------------

const MEM_NONE:i32=0;
const MEM_SHORT:i32=1;
const MEM_WORK:i32=2;
const MEM_LONG:i32=3;
const MEM_EXACT:i32=4;
const MEM_COLD:i32=5;

fn memory_value(
    novelty:i32,uncertainty:i32,causal:i32,source:i32,
    retrieval:i32,contradiction:i32,regret:i32,cost:i32
)i32 @noalloc {
    return novelty*3+uncertainty*2+causal*4+source*2+retrieval*3+contradiction*4+regret*5-cost;
}

fn choose_memory(
    novelty:i32,uncertainty:i32,causal:i32,source:i32,
    retrieval:i32,contradiction:i32,regret:i32,cost:i32
)i32 @noalloc {
    let v:i32=memory_value(novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);
    if(regret>=7 || contradiction>=8 || causal>=9){return MEM_EXACT;}
    if(v>=78){return MEM_EXACT;}
    if(v>=52){return MEM_LONG;}
    if(v>=34){return MEM_COLD;}
    if(uncertainty>=7 || retrieval>=6){return MEM_WORK;}
    if(v>=14){return MEM_SHORT;}
    return MEM_NONE;
}

fn memory_revise(old:i32,regret:i32,new_use:i32,source_conflict:i32)i32 @noalloc {
    if(regret>=6 || new_use>=8 || source_conflict>=8){return MEM_EXACT;}
    if(old==MEM_NONE && new_use>=5){return MEM_LONG;}
    if(old==MEM_SHORT && new_use>=5){return MEM_LONG;}
    if(old==MEM_COLD && new_use>=7){return MEM_LONG;}
    return old;
}

// Learned memory policy: weights belong to mutable TNN state. Storage classes are
// protected substrate capabilities, but their use is learned from delayed reward/regret.
const MEM_FEATURES:i32=8;
const MEM_ACTIONS:i32=6;
fn memory_feature(feature:i32,novelty:i32,uncertainty:i32,causal:i32,source:i32,retrieval:i32,contradiction:i32,regret:i32,cost:i32)i32 @noalloc {
    if(feature==0){return novelty;} if(feature==1){return uncertainty;} if(feature==2){return causal;} if(feature==3){return source;}
    if(feature==4){return retrieval;} if(feature==5){return contradiction;} if(feature==6){return regret;} return 10-cost;
}
fn memory_policy_value(action:i32,weights:[]i32,novelty:i32,uncertainty:i32,causal:i32,source:i32,retrieval:i32,contradiction:i32,regret:i32,cost:i32)i32 @noalloc {
    let v:i32=0;let f:i32=0;while(f<MEM_FEATURES){v=v+weights[action*MEM_FEATURES+f]*memory_feature(f,novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);f=f+1;}return v;
}
fn memory_policy_choose(weights:[]i32,step:i32,seed:i32,novelty:i32,uncertainty:i32,causal:i32,source:i32,retrieval:i32,contradiction:i32,regret:i32,cost:i32)i32 @noalloc {
    // Birth/default policy is the privileged generic heuristic. It is not immutable:
    // mutable TNN evidence may override it when learned value clearly exceeds default.
    let default_action:i32=choose_memory(novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);
    let best:i32=default_action;
    let bestv:i32=memory_policy_value(default_action,weights,novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);
    let a:i32=0;
    while(a<MEM_ACTIONS){
        let v:i32=memory_policy_value(a,weights,novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);
        if(v>bestv+24){bestv=v;best=a;}
        a=a+1;
    }
    // Exploration is sparse and lifelong, not tied to developmental age/phase.
    if(mod_pos(mix(seed,step),31)==0){return mod_pos(mix(seed+17,step),MEM_ACTIONS);}
    return best;
}
fn memory_policy_learn(action:i32,reward:i32,rate:i32,weights:[]i32,novelty:i32,uncertainty:i32,causal:i32,source:i32,retrieval:i32,contradiction:i32,regret:i32,cost:i32)void @noalloc {
    let f:i32=0;while(f<MEM_FEATURES){let x:i32=memory_feature(f,novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);let at:i32=action*MEM_FEATURES+f;weights[at]=clamp_i32(weights[at]+reward*x*rate/100,-2000,2000);f=f+1;}
}

// -----------------------------------------------------------------------------
// Autonomous non-core PAM Foundry.
// Core provides generic opcodes. TNN writes executable topology and mutable state directly.
// -----------------------------------------------------------------------------

const PAM_MAX:i32=32;
const PAM_OP_MAX:i32=16;
const OP_LOCAL:i32=1;
const OP_RECURRENT:i32=2;
const OP_DELAY:i32=3;
const OP_GATE:i32=4;
const OP_NORM:i32=5;
const OP_ACCUM:i32=6;
const OP_PREDICT:i32=7;
const OP_COMPETE:i32=8;
const OP_MEMORY_PORT:i32=9;
const OP_CROSS_SCALE:i32=10;

fn pam_signature(ops:[]i32,params:[]i32,start:i32,count:i32)i32 @noalloc {
    let h:i32=216613626;
    let i:i32=0;
    while(i<count){
        h=(h ^ (ops[start+i]*131+params[start+i]))*16777619;
        i=i+1;
    }
    if(h<0){return 0-h;} return h;
}

fn foundry_create_random_control(
    error_kind:i32,error_strength:i32,history_gain:i32,seed:i32,
    pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32
)i32 @noalloc {
    if(pam_count.*>=PAM_MAX){return -1;}
    let id:i32=pam_count.*;
    let start:i32=id*PAM_OP_MAX;
    let n:i32=4+mod_pos(mix(seed,error_kind+history_gain),7);
    let i:i32=0;
    while(i<n){
        let raw:i32=mod_pos(mix(seed+error_strength*17,i+error_kind*13),10)+1;
        pam_ops[start+i]=raw;
        pam_params[start+i]=1+mod_pos(mix(seed+31,i*7+error_strength),16);
        i=i+1;
    }
    pam_len[id]=n; pam_status[id]=1; pam_parent[id]=-1; pam_count.*=id+1;
    return id;
}

const PAM_FEATURES:i32=6;
fn pam_feature(f:i32,error_strength:i32,history_gain:i32,uncertainty:i32,temporal_loss:i32,spatial_loss:i32,resource_pressure:i32)i32 @noalloc {
    if(f==0){return error_strength;}if(f==1){return history_gain;}if(f==2){return uncertainty;}if(f==3){return temporal_loss;}if(f==4){return spatial_loss;}return resource_pressure;
}
fn foundry_choose_op(op_weights:[]i32,slot:i32,step:i32,seed:i32,error_strength:i32,history_gain:i32,uncertainty:i32,temporal_loss:i32,spatial_loss:i32,resource_pressure:i32)i32 @noalloc {
    if(step<64 && mod_pos(mix(seed,step+slot),4)==0){return 1+mod_pos(mix(seed+13,slot+step),10);}
    let best:i32=1;let bestv:i32=-2147480000;let op:i32=1;
    while(op<=10){let v:i32=0;let f:i32=0;while(f<PAM_FEATURES){v=v+op_weights[(op-1)*PAM_FEATURES+f]*pam_feature(f,error_strength,history_gain,uncertainty,temporal_loss,spatial_loss,resource_pressure);f=f+1;}if(v>bestv){bestv=v;best=op;}op=op+1;}return best;
}
fn foundry_create_learned(error_strength:i32,history_gain:i32,uncertainty:i32,temporal_loss:i32,spatial_loss:i32,resource_pressure:i32,step:i32,seed:i32,op_weights:[]i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32)i32 @noalloc {
    if(pam_count.*>=PAM_MAX){return -1;}let id:i32=pam_count.*;let start:i32=id*PAM_OP_MAX;let n:i32=4+mod_pos(mix(seed,step),7);let i:i32=0;
    while(i<n){pam_ops[start+i]=foundry_choose_op(op_weights,i,step,seed,error_strength,history_gain,uncertainty,temporal_loss,spatial_loss,resource_pressure);pam_params[start+i]=1+mod_pos(mix(seed+31,i*7+step),24);i=i+1;}
    pam_len[id]=n;pam_status[id]=1;pam_parent[id]=-1;pam_count.*=id+1;return id;
}
fn foundry_learn_ops(candidate:i32,gain:i32,regression:i32,rate:i32,error_strength:i32,history_gain:i32,uncertainty:i32,temporal_loss:i32,spatial_loss:i32,resource_pressure:i32,op_weights:[]i32,pam_ops:[]i32,pam_len:[]i32)void @noalloc {
    if(candidate<0){return;}let reward:i32=gain-regression*2;let start:i32=candidate*PAM_OP_MAX;let i:i32=0;while(i<pam_len[candidate]){let op:i32=pam_ops[start+i];let f:i32=0;while(f<PAM_FEATURES){let at:i32=(op-1)*PAM_FEATURES+f;let x:i32=pam_feature(f,error_strength,history_gain,uncertainty,temporal_loss,spatial_loss,resource_pressure);op_weights[at]=clamp_i32(op_weights[at]+reward*x*rate/1000,-4000,4000);f=f+1;}i=i+1;}
}

// Canonical autonomous Foundry search: whole-program evolutionary shadow search.
// Candidate scores are produced by TNN's writable internal verifier on development
// consequences; the immutable root verifier remains outside mutation authority.
fn foundry_random_program(step:i32,seed:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32)i32 @noalloc {
    if(pam_count.*>=PAM_MAX){return -1;}let id:i32=pam_count.*;let start:i32=id*PAM_OP_MAX;let n:i32=4+mod_pos(mix(seed,step),6);let i:i32=0;while(i<n){pam_ops[start+i]=1+mod_pos(mix(seed+17,step*31+i*7),10);pam_params[start+i]=1+mod_pos(mix(seed+29,step*19+i*11),24);i=i+1;}pam_len[id]=n;pam_status[id]=1;pam_parent[id]=-1;pam_count.*=id+1;return id;
}
fn foundry_best_candidate(scores:[]i32,pam_status:[]i32,count:i32)i32 @noalloc {
    let best:i32=-1;let bestv:i32=-2147480000;let i:i32=0;while(i<count){if(pam_status[i]==1 && scores[i]>bestv){bestv=scores[i];best=i;}i=i+1;}return best;
}
fn foundry_evolution_mutate(parent:i32,step:i32,seed:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32)i32 @noalloc {
    if(parent<0 || parent>=pam_count.* || pam_count.*>=PAM_MAX){return -1;}let id:i32=pam_count.*;let src:i32=parent*PAM_OP_MAX;let dst:i32=id*PAM_OP_MAX;let n:i32=pam_len[parent];let i:i32=0;while(i<n){pam_ops[dst+i]=pam_ops[src+i];pam_params[dst+i]=pam_params[src+i];i=i+1;}let mode:i32=mod_pos(mix(seed,step),3);if(mode==0 && n>0){let at:i32=mod_pos(mix(seed+5,step),n);pam_ops[dst+at]=1+mod_pos(mix(seed+7,step+at),10);}else if(mode==1 && n<PAM_OP_MAX){pam_ops[dst+n]=1+mod_pos(mix(seed+11,step),10);pam_params[dst+n]=1+mod_pos(mix(seed+13,step),24);n=n+1;}else if(n>4){n=n-1;}pam_len[id]=n;pam_status[id]=1;pam_parent[id]=parent;pam_count.*=id+1;return id;
}
fn foundry_shadow_generation(scores:[]i32,step:i32,seed:i32,children:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32)i32 @noalloc {
    let parent:i32=foundry_best_candidate(scores,pam_status,pam_count.*);if(parent<0){return -1;}let last:i32=-1;let i:i32=0;while(i<children && pam_count.*<PAM_MAX){last=foundry_evolution_mutate(parent,step+i,seed,pam_ops,pam_params,pam_len,pam_status,pam_parent,pam_count);i=i+1;}return last;
}

fn foundry_clone_mutate(
    parent:i32,seed:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32
)i32 @noalloc {
    if(parent<0 || parent>=pam_count.* || pam_count.*>=PAM_MAX){return -1;}
    let id:i32=pam_count.*;
    let src:i32=parent*PAM_OP_MAX; let dst:i32=id*PAM_OP_MAX;
    let n:i32=pam_len[parent]; let i:i32=0;
    while(i<n){pam_ops[dst+i]=pam_ops[src+i];pam_params[dst+i]=pam_params[src+i];i=i+1;}
    let at:i32=mod_pos(mix(seed,parent),n);
    pam_ops[dst+at]=1+mod_pos(pam_ops[dst+at]+mix(seed,at),10);
    pam_params[dst+at]=1+mod_pos(pam_params[dst+at]+mix(seed+5,at),24);
    pam_len[id]=n; pam_status[id]=1; pam_parent[id]=parent; pam_count.*=id+1;
    return id;
}

fn foundry_decide(candidate:i32,base_score:i32,new_score:i32,regression:i32,pam_status:[]i32)i32 @noalloc {
    if(candidate<0){return 0;}
    if(regression>0){pam_status[candidate]=0;return 0;}
    if(new_score>=base_score+30){pam_status[candidate]=2;return 1;}
    pam_status[candidate]=0; return 0;
}

// -----------------------------------------------------------------------------
// Generic sensory evidence and persistent entity identity state.
// Entity IDs are internal integers; no evaluator labels are stored.
// -----------------------------------------------------------------------------

const ENTITY_MAX:i32=64;
const VIEW_DIM:i32=8;

// Protected-core candidate earned by the viewpoint-loss microscope: an anonymous
// relational signature that is insensitive to permutation/order of receptor channels.
// It contains no object features or labels.
fn core_relational_signature8(raw:[]i32,r0:i32,out:[]i32,o0:i32)void @noalloc {
    let mean:i32=0;let i:i32=0;while(i<VIEW_DIM){mean=mean+raw[r0+i];i=i+1;}mean=mean/VIEW_DIM;
    i=0;while(i<VIEW_DIM){out[o0+i]=raw[r0+i]-mean;i=i+1;}
    // insertion sort yields a permutation-invariant distribution signature.
    i=1;while(i<VIEW_DIM){let key:i32=out[o0+i];let j:i32=i-1;while(j>=0 && out[o0+j]>key){out[o0+j+1]=out[o0+j];j=j-1;}out[o0+j+1]=key;i=i+1;}
    let span:i32=abs_i32(out[o0+VIEW_DIM-1]-out[o0]);
    if(span>0){i=0;while(i<VIEW_DIM){out[o0+i]=out[o0+i]*1000/span;i=i+1;}}
}

fn view_distance(a:[]i32,a0:i32,b:[]i32,b0:i32)i32 @noalloc {
    let d:i32=0; let i:i32=0;
    while(i<VIEW_DIM){d=d+abs_i32(a[a0+i]-b[b0+i]);i=i+1;}
    return d;
}

fn entity_best(
    view:[]i32,v0:i32,centroids:[]i32,counts:[]i32,entities:i32,
    motion:i32,continuity:[]i32,uncertainty:*i32
)i32 @noalloc {
    let best:i32=-1; let best_score:i32=-1000000; let runner:i32=-1000000;
    let e:i32=0;
    while(e<entities){
        if(counts[e]>0){
            let dist:i32=view_distance(view,v0,centroids,e*VIEW_DIM);
            let temporal:i32=continuity[e];
            let score:i32=1200-dist*5+temporal*12+motion*2;
            if(score>best_score){runner=best_score;best_score=score;best=e;}
            else if(score>runner){runner=score;}
        }
        e=e+1;
    }
    uncertainty.*=clamp_i32(1000-(best_score-runner),0,1000);
    return best;
}

fn entity_update(view:[]i32,v0:i32,e:i32,centroids:[]i32,counts:[]i32)void @noalloc {
    let n:i32=counts[e]; let i:i32=0;
    while(i<VIEW_DIM){centroids[e*VIEW_DIM+i]=(centroids[e*VIEW_DIM+i]*n+view[v0+i])/(n+1);i=i+1;}
    counts[e]=n+1;
}

fn entity_should_merge(distance:i32,temporal:i32,action_match:i32,name_match:i32)i32 @noalloc {
    let evidence:i32=(1000-distance*4)+temporal*15+action_match*120+name_match*80;
    if(evidence>=1280){return 1;} return 0;
}

fn entity_should_split(conflict:i32,repeated_mismatch:i32)i32 @noalloc {
    if(conflict>=800 && repeated_mismatch>=3){return 1;} return 0;
}

// Persistent identity under information loss: if current evidence is ambiguous,
// temporal continuity remains a hypothesis rather than forcing a new identity.
// persistence_bias is mutable learner state and can be revised from later truth/regret.
fn entity_temporal_resolve(best:i32,prior:i32,uncertainty:i32,contradiction:i32,persistence_bias:i32)i32 @noalloc {
    if(prior<0){return best;}
    let keep_score:i32=uncertainty+persistence_bias-contradiction;
    if(keep_score>=900){return prior;}
    return best;
}
fn entity_persistence_learn(bias:i32,kept:i32,was_same:i32,rate:i32)i32 @noalloc {
    let reward:i32=-1;if(kept==was_same){reward=1;}return clamp_i32(bias+reward*rate,0,1000);
}

// -----------------------------------------------------------------------------
// Entity-action-effect predictive world model.
// Anonymous action indices; evaluator-readable action names are unnecessary.
// -----------------------------------------------------------------------------

const ACTION_MAX:i32=8;
fn effect_index(entity:i32,action:i32)i32 @noalloc { return entity*ACTION_MAX+action; }

fn effect_learn(entity:i32,action:i32,effect:i32,effect_sum:[]i32,effect_n:[]i32)void @noalloc {
    let at:i32=effect_index(entity,action);
    effect_sum[at]=effect_sum[at]+effect; effect_n[at]=effect_n[at]+1;
}

fn effect_predict(entity:i32,action:i32,effect_sum:[]i32,effect_n:[]i32)i32 @noalloc {
    let at:i32=effect_index(entity,action); if(effect_n[at]==0){return 0;}
    return effect_sum[at]/effect_n[at];
}

fn choose_action(entity:i32,effect_sum:[]i32,effect_n:[]i32)i32 @noalloc {
    let best:i32=0; let best_v:i32=-100000; let a:i32=0;
    while(a<ACTION_MAX){let v:i32=effect_predict(entity,a,effect_sum,effect_n);if(v>best_v){best_v=v;best=a;}a=a+1;}
    return best;
}

// -----------------------------------------------------------------------------
// Connected raw acoustic motif sequence decoding without supplied VAD boundaries.
// Motifs are anonymous integer templates learned from experience; duration priors
// and overlapping candidates are mutable evidence, not phonemes/word labels.
// -----------------------------------------------------------------------------
const ACOUSTIC_MOTIFS:i32=32;
const ACOUSTIC_WIDTH:i32=12;
fn acoustic_window_distance(samples:[]i32,start:i32,duration:i32,templates:[]i32,motif:i32,width:i32)i32 @noalloc {
    let d:i32=0;let i:i32=0;while(i<width){let pos:i32=start+(i*duration)/width;if(pos>=samples.len){return 2147480000;}d=d+abs_i32(samples[pos]-templates[motif*width+i]);i=i+1;}return d;
}
fn acoustic_best_next(samples:[]i32,start:i32,templates:[]i32,motif_count:i32,duration_mean:[]i32,min_duration:i32,max_duration:i32,out_duration:*i32,out_margin:*i32)i32 @noalloc {
    let best:i32=-1;let best_score:i32=2147480000;let runner:i32=2147480000;let best_dur:i32=min_duration;let m:i32=0;
    while(m<motif_count){let dur:i32=min_duration;while(dur<=max_duration && start+dur<=samples.len){let ds:i32=acoustic_window_distance(samples,start,dur,templates,m,ACOUSTIC_WIDTH);let prior:i32=abs_i32(dur-duration_mean[m])*3;let sc:i32=ds+prior;if(sc<best_score){runner=best_score;best_score=sc;best=m;best_dur=dur;}else if(sc<runner){runner=sc;}dur=dur+1;}m=m+1;}
    out_duration.*=best_dur;out_margin.*=runner-best_score;return best;
}
fn acoustic_decode_sequence(samples:[]i32,templates:[]i32,motif_count:i32,duration_mean:[]i32,min_duration:i32,max_duration:i32,out_ids:[]i32,out_count:*i32,max_out:i32)void @noalloc {
    let pos:i32=0;let count:i32=0;while(pos<samples.len && count<max_out){let dur:i32=0;let margin:i32=0;let id:i32=acoustic_best_next(samples,pos,templates,motif_count,duration_mean,min_duration,max_duration,&dur,&margin);if(id<0 || dur<=0){pos=pos+1;}else{out_ids[count]=id;count=count+1;pos=pos+dur;}}out_count.*=count;
}


// Generic native CTC-style acoustic core PAM primitives. The mechanism learns
// latent monotonic alignment from whole raw waveforms and ordered anonymous IDs.
// It contains no VAD, boundary targets, phonemes, vocabulary, or English state.
fn ctc_frame_logit(feature:i32,prototype:i32,scale:i32)i32 @noalloc {
    return 0-abs_i32(feature-prototype)*scale;
}
fn ctc_blank_prior(blank_bias:i32,activity:i32,learned_activity_weight:i32)i32 @noalloc {
    return blank_bias-activity*learned_activity_weight/1000;
}
fn ctc_blank_prior_learn(blank_bias:*i32,predicted_empty:i32,target_nonempty:i32,rate:i32)void @noalloc {
    if(predicted_empty==1 && target_nonempty==1){blank_bias.*=clamp_i32(blank_bias.*-rate,-4000,4000);}
    else if(predicted_empty==0 && target_nonempty==0){blank_bias.*=clamp_i32(blank_bias.*+rate,-4000,4000);}
}
fn ctc_step_best(logits:[]i32,start:i32,class_count:i32) i32 @noalloc {
    let best:i32=0;let bestv:i32=logits[start];let c:i32=1;while(c<class_count){let v:i32=logits[start+c];if(v>bestv){bestv=v;best=c;}c=c+1;}return best;
}
fn ctc_collapse(frame_ids:[]i32,frame_count:i32,blank:i32,out_ids:[]i32,out_count:*i32,max_out:i32)void @noalloc {
    let last:i32=-1;let n:i32=0;let i:i32=0;while(i<frame_count && n<max_out){let id:i32=frame_ids[i];if(id!=blank && id!=last){out_ids[n]=id;n=n+1;}last=id;i=i+1;}out_count.*=n;
}

// -----------------------------------------------------------------------------
// One-shot motif/name binding into persistent entity identity.
// Motif is an anonymous learned integer fingerprint, not a dictionary string.
// -----------------------------------------------------------------------------

const NAME_MAX:i32=128;
fn name_bind(motif:i32,entity:i32,motifs:[]i32,entities:[]i32,conf:[]i32,count:*i32)void @noalloc {
    if(count.*>=NAME_MAX){return;} let at:i32=count.*;
    motifs[at]=motif;entities[at]=entity;conf[at]=1000;count.*=at+1;
}
fn name_resolve(motif:i32,motifs:[]i32,entities:[]i32,conf:[]i32,count:i32,uncertainty:*i32)i32 @noalloc {
    let best:i32=-1;let best_d:i32=2147483000;let runner:i32=2147483000;let i:i32=0;
    while(i<count){let d:i32=abs_i32(motif-motifs[i]);if(d<best_d){runner=best_d;best_d=d;best=i;}else if(d<runner){runner=d;}i=i+1;}
    if(best<0){uncertainty.*=1000;return -1;}
    uncertainty.*=clamp_i32(300+best_d-(runner-best_d),0,1000);
    return entities[best];
}

// -----------------------------------------------------------------------------
// Independent sibling testimony + provenance-aware consolidation.
// -----------------------------------------------------------------------------

fn testimony_weight(source_reliability:i32,lineage_repeats:i32,local_verified:i32)i32 @noalloc {
    let independence:i32=1000/(max_i32(1,lineage_repeats));
    return source_reliability*independence/1000+local_verified*500;
}
fn testimony_accept(weight:i32,contradiction:i32)i32 @noalloc {
    if(contradiction>=700){return 0;} if(weight>=650){return 1;} return 0;
}

// -----------------------------------------------------------------------------
// Learned active-perception option value.
// Options are generic evidence actions, not task answers.
// -----------------------------------------------------------------------------

const OBS_MAX:i32=8;
fn active_observation_value(expected_gain:i32,cost:i32,past_gain:i32,uncertainty:i32)i32 @noalloc {
    return expected_gain*4+past_gain*3+uncertainty*2-cost*2;
}
fn choose_observation(gain:[]i32,cost:[]i32,past:[]i32,uncertainty:i32,count:i32)i32 @noalloc {
    let best:i32=0;let best_v:i32=-100000;let i:i32=0;
    while(i<count){let v:i32=active_observation_value(gain[i],cost[i],past[i],uncertainty);if(v>best_v){best_v=v;best=i;}i=i+1;}
    return best;
}

// -----------------------------------------------------------------------------
// Failure attribution from actual learning dynamics.
// -----------------------------------------------------------------------------

const FAIL_NONE:i32=0;
const FAIL_UNDERTRAINED:i32=1;
const FAIL_TEACHER:i32=2;
const FAIL_MEMORY:i32=3;
const FAIL_ROUTING:i32=4;
const FAIL_REPRESENTATION:i32=5;
const FAIL_INTERFERENCE:i32=6;
const FAIL_RESOURCE:i32=7;

fn learning_slope(curve:[]i32,n:i32)i32 @noalloc {
    if(n<2){return 0;} return curve[n-1]-curve[n-2];
}
fn diagnose_failure(
    curve:[]i32,n:i32,immediate:i32,delayed:i32,evidence_exists:i32,
    route_selected:i32,representation_separable:i32,regression:i32,resource_sat:i32
)i32 @noalloc {
    if(regression>30){return FAIL_INTERFERENCE;}
    if(resource_sat==1){return FAIL_RESOURCE;}
    if(immediate-delayed>=250){return FAIL_MEMORY;}
    if(evidence_exists==1 && route_selected==0){return FAIL_ROUTING;}
    if(representation_separable==0){return FAIL_REPRESENTATION;}
    if(n>=3 && abs_i32(learning_slope(curve,n))<=15 && curve[n-1]<900){return FAIL_TEACHER;}
    if(n>=2 && learning_slope(curve,n)>15){return FAIL_UNDERTRAINED;}
    return FAIL_NONE;
}


// -----------------------------------------------------------------------------
// Traced subsystem entry points. Production callers use these wrappers so every
// consequential mutable decision has a causal event with a parent event id.
// -----------------------------------------------------------------------------
fn trace_reason_for_memory(action:i32,uncertainty:i32,contradiction:i32,regret:i32)i32 @noalloc {
    if(regret>=6){return REASON_DELAYED_REGRET;} if(contradiction>=7){return REASON_CONTRADICTION;} if(uncertainty>=7){return REASON_UNCERTAINTY;} return REASON_RESOURCE_PRESSURE;
}
fn memory_choose_traced(weights:[]i32,step:i32,seed:i32,novelty:i32,uncertainty:i32,causal:i32,source:i32,retrieval:i32,contradiction:i32,regret:i32,cost:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let a:i32=memory_policy_choose(weights,step,seed,novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost);
    trace_emit(step,STAGE_MEMORY,trace_reason_for_memory(a,uncertainty,contradiction,regret),a,memory_value(novelty,uncertainty,causal,source,retrieval,contradiction,regret,cost),1000-uncertainty,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
    return a;
}
fn pam_create_random_control_traced(error_kind:i32,error_strength:i32,history_gain:i32,seed:i32,parent_event:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let id:i32=foundry_create_random_control(error_kind,error_strength,history_gain,seed,pam_ops,pam_params,pam_len,pam_status,pam_parent,pam_count);
    trace_emit(seed,STAGE_REVISION,error_kind,id,error_strength,history_gain,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return id;
}
fn pam_create_learned_traced(error_strength:i32,history_gain:i32,uncertainty:i32,temporal_loss:i32,spatial_loss:i32,resource_pressure:i32,step:i32,seed:i32,parent_event:i32,op_weights:[]i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let id:i32=foundry_create_learned(error_strength,history_gain,uncertainty,temporal_loss,spatial_loss,resource_pressure,step,seed,op_weights,pam_ops,pam_params,pam_len,pam_status,pam_parent,pam_count);trace_emit(step,STAGE_REVISION,REASON_PLATEAU,id,error_strength,1000-uncertainty,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return id;
}
fn pam_evolution_generation_traced(scores:[]i32,step:i32,seed:i32,children:i32,parent_event:i32,pam_ops:[]i32,pam_params:[]i32,pam_len:[]i32,pam_status:[]i32,pam_parent:[]i32,pam_count:*i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let parent:i32=foundry_best_candidate(scores,pam_status,pam_count.*);let last:i32=foundry_shadow_generation(scores,step,seed,children,pam_ops,pam_params,pam_len,pam_status,pam_parent,pam_count);trace_emit(step,STAGE_REVISION,REASON_VERIFIED_GAIN,last,parent,800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return last;
}
fn entity_resolve_traced(best:i32,prior:i32,uncertainty:i32,contradiction:i32,persistence_bias:i32,step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let e:i32=entity_temporal_resolve(best,prior,uncertainty,contradiction,persistence_bias);let reason:i32=REASON_EVIDENCE_GAIN;if(e==prior && best!=prior){reason=REASON_UNCERTAINTY;}
    trace_emit(step,STAGE_ENTITY,reason,e,1000-uncertainty,1000-uncertainty,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return e;
}
fn effect_learn_traced(entity:i32,action:i32,effect:i32,step:i32,parent_event:i32,effect_sum:[]i32,effect_n:[]i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    effect_learn(entity,action,effect,effect_sum,effect_n);trace_emit(step,STAGE_WORLD,REASON_EVIDENCE_GAIN,entity,effect,800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}
fn name_bind_traced(motif:i32,entity:i32,step:i32,parent_event:i32,motifs:[]i32,entities:[]i32,conf:[]i32,count:*i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    name_bind(motif,entity,motifs,entities,conf,count);trace_emit(step,STAGE_LANGUAGE,REASON_EVIDENCE_GAIN,entity,motif,1000,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}
fn testimony_accept_traced(weight:i32,contradiction:i32,source:i32,step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let a:i32=testimony_accept(weight,contradiction);let reason:i32=REASON_EVIDENCE_GAIN;if(contradiction>=700){reason=REASON_SOURCE_CONFLICT;}trace_emit(step,STAGE_SOCIAL,reason,source,weight,1000-contradiction,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return a;
}
fn observation_choose_traced(gain:[]i32,cost:[]i32,past:[]i32,uncertainty:i32,count:i32,step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let a:i32=choose_observation(gain,cost,past,uncertainty,count);trace_emit(step,STAGE_DECISION,REASON_UNCERTAINTY,a,gain[a],1000-uncertainty,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return a;
}
fn failure_diagnose_traced(curve:[]i32,n:i32,immediate:i32,delayed:i32,evidence_exists:i32,route_selected:i32,representation_separable:i32,regression:i32,resource_sat:i32,step:i32,parent_event:i32,t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)i32 {
    let f:i32=diagnose_failure(curve,n,immediate,delayed,evidence_exists,route_selected,representation_separable,regression,resource_sat);let reason:i32=REASON_EVIDENCE_GAIN;if(f==FAIL_MEMORY){reason=REASON_MEMORY_MISS;}else if(f==FAIL_ROUTING){reason=REASON_ROUTE_MISS;}else if(f==FAIL_REPRESENTATION){reason=REASON_REPRESENTATION_LOSS;}else if(f==FAIL_INTERFERENCE){reason=REASON_REGRESSION;}else if(f==FAIL_RESOURCE){reason=REASON_RESOURCE_PRESSURE;}else if(f==FAIL_TEACHER){reason=REASON_PLATEAU;}trace_emit(step,STAGE_REVISION,reason,f,immediate-delayed,800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);return f;
}

// -----------------------------------------------------------------------------
// Native bounded architecture self-test.
// These tests validate generic mechanisms, not real-world vision/English claims.
// -----------------------------------------------------------------------------

fn test_memory()i32{
    let weights:[]i32=new i32(MEM_ACTIONS*MEM_FEATURES);let step:i32=0;
    // TNN learns from delayed exact-detail success/failure; no age/phase rule selects storage.
    while(step<256){let high:i32=mod_pos(mix(91,step),10);let causal:i32=mod_pos(mix(93,step),10);let contradiction:i32=mod_pos(mix(95,step),10);let cost:i32=2+mod_pos(mix(97,step),8);let a:i32=memory_policy_choose(weights,step,99,high,high,causal,8,3,contradiction,0,cost);let should_exact:i32=0;if(causal>=8 || contradiction>=8){should_exact=1;}let reward:i32=-2;if((should_exact==1 && a==MEM_EXACT)||(should_exact==0 && a!=MEM_EXACT)){reward=3;}memory_policy_learn(a,reward,2,weights,high,high,causal,8,3,contradiction,0,cost);step=step+1;}
    let important:i32=memory_policy_choose(weights,999,99,9,8,9,9,4,9,0,5);
    let ordinary:i32=memory_policy_choose(weights,1000,99,2,2,1,5,1,0,0,8);
    let revised:i32=memory_revise(ordinary,8,9,2);
    if(important==MEM_EXACT && revised==MEM_EXACT){return 1;}return 0;
}

fn test_foundry()i32{
    let ops:[]i32=new i32(PAM_MAX*PAM_OP_MAX);let params:[]i32=new i32(PAM_MAX*PAM_OP_MAX);let lens:[]i32=new i32(PAM_MAX);let status:[]i32=new i32(PAM_MAX);let parent:[]i32=new i32(PAM_MAX);let scores:[]i32=new i32(PAM_MAX);let count:i32=0;let i:i32=0;
    while(i<8){let id:i32=foundry_random_program(i,71,ops,params,lens,status,parent,&count);scores[id]=100+i*10;i=i+1;}let winner:i32=foundry_best_candidate(scores,status,count);let last:i32=foundry_shadow_generation(scores,20,91,4,ops,params,lens,status,parent,&count);
    if(winner==7 && last>=8 && count==12 && parent[last]==winner){return 1;}return 0;
}

fn test_entity()i32{
    let views:[]i32=new i32(VIEW_DIM*3);let c:[]i32=new i32(VIEW_DIM*2);let n:[]i32=new i32(2);let continuity:[]i32=new i32(2);let sig:[]i32=new i32(VIEW_DIM*2);
    let i:i32=0;while(i<VIEW_DIM){views[i]=100+i*3;views[VIEW_DIM+i]=108+i*3;views[2*VIEW_DIM+i]=400+i*5;i=i+1;}
    // reversed receptor ordering is a generic viewpoint-permutation stress.
    i=0;while(i<VIEW_DIM){views[VIEW_DIM+i]=views[VIEW_DIM-1-i];i=i+1;}
    core_relational_signature8(views,0,sig,0);core_relational_signature8(views,VIEW_DIM,sig,VIEW_DIM);
    let relational_ok:i32=0;if(view_distance(sig,0,sig,VIEW_DIM)<=16){relational_ok=1;}
    n[0]=1;n[1]=1;i=0;while(i<VIEW_DIM){c[i]=views[i];c[VIEW_DIM+i]=views[2*VIEW_DIM+i];i=i+1;}continuity[0]=20;continuity[1]=0;
    let u:i32=0;let e:i32=entity_best(views,0,c,n,2,4,continuity,&u);
    let persisted:i32=entity_temporal_resolve(1,0,950,100,200);
    if(relational_ok==1 && e==0 && persisted==0){return 1;}return 0;
}

fn test_world()i32{
    let s:[]i32=new i32(ENTITY_MAX*ACTION_MAX);let n:[]i32=new i32(ENTITY_MAX*ACTION_MAX);
    effect_learn(3,0,10,s,n);effect_learn(3,1,90,s,n);effect_learn(3,2,25,s,n);
    if(choose_action(3,s,n)==1 && effect_predict(3,1,s,n)==90){return 1;}return 0;
}

fn test_acoustic()i32{
    let templates:[]i32=new i32(3*ACOUSTIC_WIDTH);let means:[]i32=new i32(3);let m:i32=0;while(m<3){means[m]=12;let i:i32=0;while(i<ACOUSTIC_WIDTH){templates[m*ACOUSTIC_WIDTH+i]=m*100+i*3;i=i+1;}m=m+1;}let samples:[]i32=new i32(36);let truth:[]i32=new i32(3);truth[0]=0;truth[1]=2;truth[2]=1;let pos:i32=0;let q:i32=0;while(q<3){let id:i32=truth[q];let i:i32=0;while(i<12){samples[pos+i]=templates[id*ACOUSTIC_WIDTH+i];i=i+1;}pos=pos+12;q=q+1;}let out:[]i32=new i32(6);let count:i32=0;acoustic_decode_sequence(samples,templates,3,means,9,15,out,&count,6);if(count==3 && out[0]==0 && out[1]==2 && out[2]==1){return 1;}return 0;
}


fn test_ctc_core()i32 {
    let frames:[]i32=new i32(10);frames[0]=0;frames[1]=1;frames[2]=1;frames[3]=0;frames[4]=2;frames[5]=2;frames[6]=0;frames[7]=3;frames[8]=3;frames[9]=0;
    let out:[]i32=new i32(6);let count:i32=0;ctc_collapse(frames,10,0,out,&count,6);let bias:i32=0;ctc_blank_prior_learn(&bias,1,1,25);
    if(count==3 && out[0]==1 && out[1]==2 && out[2]==3 && bias<0){return 1;}return 0;
}

fn test_name()i32{
    let motifs:[]i32=new i32(NAME_MAX);let entities:[]i32=new i32(NAME_MAX);let conf:[]i32=new i32(NAME_MAX);let count:i32=0;let u:i32=0;
    name_bind(10101,7,motifs,entities,conf,&count);name_bind(22000,9,motifs,entities,conf,&count);
    let e:i32=name_resolve(10108,motifs,entities,conf,count,&u);if(e==7){return 1;}return 0;
}

fn test_social()i32{
    let copied:i32=testimony_weight(800,5,0);let verified:i32=testimony_weight(700,1,1);
    if(testimony_accept(copied,0)==0 && testimony_accept(verified,0)==1 && testimony_accept(verified,900)==0){return 1;}return 0;
}

fn test_active()i32{
    let gain:[]i32=new i32(4);let cost:[]i32=new i32(4);let past:[]i32=new i32(4);
    gain[0]=20;cost[0]=5;past[0]=10;gain[1]=80;cost[1]=20;past[1]=70;gain[2]=50;cost[2]=8;past[2]=20;gain[3]=5;cost[3]=1;past[3]=3;
    if(choose_observation(gain,cost,past,80,4)==1){return 1;}return 0;
}

fn test_diagnosis()i32{
    let curve:[]i32=new i32(4);curve[0]=200;curve[1]=510;curve[2]=700;curve[3]=820;
    let a:i32=diagnose_failure(curve,4,820,810,1,1,1,0,0);
    curve[0]=450;curve[1]=470;curve[2]=468;curve[3]=472;
    let b:i32=diagnose_failure(curve,4,472,470,1,1,1,0,0);
    let c:i32=diagnose_failure(curve,4,950,400,1,1,1,0,0);
    let d:i32=diagnose_failure(curve,4,600,590,1,0,1,0,0);
    let e:i32=diagnose_failure(curve,4,600,590,0,0,0,0,0);
    if(a==FAIL_UNDERTRAINED && b==FAIL_TEACHER && c==FAIL_MEMORY && d==FAIL_ROUTING && e==FAIL_REPRESENTATION){return 1;}return 0;
}

fn test_trace()i32{
    let ts:[]i32=new i32(TRACE_CAP);let st:[]i32=new i32(TRACE_CAP);let rs:[]i32=new i32(TRACE_CAP);let su:[]i32=new i32(TRACE_CAP);
    let ev:[]i32=new i32(TRACE_CAP);let cf:[]i32=new i32(TRACE_CAP);let pa:[]i32=new i32(TRACE_CAP);let count:i32=0;
    trace_emit(1,STAGE_SENSOR,REASON_EVIDENCE_GAIN,7,800,700,-1,ts,st,rs,su,ev,cf,pa,&count);
    trace_emit(2,STAGE_ENTITY,REASON_UNCERTAINTY,7,400,300,0,ts,st,rs,su,ev,cf,pa,&count);
    trace_emit(3,STAGE_REVISION,REASON_PLATEAU,4,900,850,1,ts,st,rs,su,ev,cf,pa,&count);
    if(count==3 && trace_last_reason(STAGE_ENTITY,st,rs,count)==REASON_UNCERTAINTY && pa[2]==1){return 1;}return 0;
}


// -----------------------------------------------------------------------------
// R28 Innate System Fluency: knowledge of self-operation semantics, not task facts.
// -----------------------------------------------------------------------------
const SYS_CREATE_PAM:i32=1;
const SYS_START_FIBER:i32=2;
const SYS_MEMORY_STORE:i32=3;
const SYS_MEMORY_RETRIEVE:i32=4;
const SYS_SHADOW_TEST:i32=5;
const SYS_ROLLBACK:i32=6;
const SYS_REINSPECT:i32=7;
const SYS_ASK_SIBLING:i32=8;
const SYS_CHECKPOINT:i32=9;
fn innate_system_fluency(op:i32)i32 @noalloc { if(op>=SYS_CREATE_PAM && op<=SYS_CHECKPOINT){return 1;} return 0; }

// -----------------------------------------------------------------------------
// R28 AEIF: associative episodic identity fabric.
// Identity, relations, and world state use episodic, temporal, predictive, and executable structures.
// -----------------------------------------------------------------------------
fn aeif_episode_distance(query:[]i32,q0:i32,episodes:[]i32,episode_entity:[]i32,episode_count:i32,entity_count:i32,out_best:[]i32)void @noalloc {
    let e:i32=0; while(e<entity_count){out_best[e]=2147480000;e=e+1;}
    let k:i32=0; while(k<episode_count){let d:i32=view_distance(query,q0,episodes,k*VIEW_DIM);let id:i32=episode_entity[k];if(id>=0 && id<entity_count && d<out_best[id]){out_best[id]=d;}k=k+1;}
}
fn aeif_fresh_entity(query:[]i32,q0:i32,episodes:[]i32,episode_entity:[]i32,episode_count:i32,entity_count:i32,dist_out:[]i32,margin_out:*i32)i32 @noalloc {
    aeif_episode_distance(query,q0,episodes,episode_entity,episode_count,entity_count,dist_out);
    let best:i32=-1;let bd:i32=2147480000;let rd:i32=2147480000;let e:i32=0;while(e<entity_count){let d:i32=dist_out[e];if(d<bd){rd=bd;bd=d;best=e;}else if(d<rd){rd=d;}e=e+1;}
    if(best<0){margin_out.*=0;return -1;} margin_out.*=rd-bd;return best;
}
fn aeif_reliability(margin:i32,visible:i32,agreement:i32,learned_bias:i32)i32 @noalloc {
    return clamp_i32(margin*3+visible*4+agreement*2-learned_bias,0,1000);
}
fn aeif_reliability_learn(learned_bias:*i32,switch_threshold:*i32,predicted_correct:i32,should_switch:i32,reliability:i32,rate:i32)void @noalloc {
    let error:i32=0;if(predicted_correct==0){error=1;}else{error=-1;}
    learned_bias.*=clamp_i32(learned_bias.*+error*rate,-500,500);
    if(should_switch==1 && predicted_correct==0){switch_threshold.*=clamp_i32(switch_threshold.*-rate,300,950);}
    else if(should_switch==0 && predicted_correct==0){switch_threshold.*=clamp_i32(switch_threshold.*+rate,300,950);}
    else if(reliability>switch_threshold.*+120){switch_threshold.*=clamp_i32(switch_threshold.*+rate/4,300,950);}
}
fn aeif_resolve(fresh:i32,prior:i32,reliability:i32,switch_threshold:i32,unknown_threshold:i32)i32 @noalloc {
    if(prior<0){return fresh;} if(fresh==prior){return prior;} if(reliability>=switch_threshold){return fresh;} if(reliability<=unknown_threshold){return -1;} return prior;
}
fn aeif_choose_reinspection(reliability:i32,identity_value:i32,reinspect_cost:i32)i32 @noalloc {
    if((1000-reliability)*identity_value/1000 > reinspect_cost){return 1;} return 0;
}

// -----------------------------------------------------------------------------
// Substrate-agnostic Foundry genes: associative, field, process, workspace, temporal, and predictive structures.
// -----------------------------------------------------------------------------
const SUB_ASSOC:i32=1; const SUB_FIELD:i32=2; const SUB_PROCESS:i32=3; const SUB_BLACKBOARD:i32=4; const SUB_TEMPORAL:i32=5; const SUB_PREDICTIVE:i32=6;
fn substrate_gene(seed:i32,slot:i32)i32 @noalloc { return 1+mod_pos(mix(seed,slot),6); }
fn substrate_contains(g:[]i32,n:i32,kind:i32)i32 @noalloc {let i:i32=0;while(i<n){if(g[i]==kind){return 1;}i=i+1;}return 0;}

// Generic LRU helper is eviction mechanics only; it never chooses representation.
fn lru_evict_candidate(last_used:[]i32,protected_exact:[]i32,count:i32)i32 @noalloc {
    let best:i32=-1;let age:i32=2147480000;let i:i32=0;while(i<count){if(protected_exact[i]==0 && last_used[i]<age){age=last_used[i];best=i;}i=i+1;}
    if(best>=0){return best;} i=0;age=2147480000;while(i<count){if(last_used[i]<age){age=last_used[i];best=i;}i=i+1;}return best;
}

fn test_system_fluency()i32 {let i:i32=1;while(i<=9){if(innate_system_fluency(i)!=1){return 0;}i=i+1;}return 1;}
fn test_aeif()i32 {
    let episodes:[]i32=new i32(VIEW_DIM*4);let ids:[]i32=new i32(4);let q:[]i32=new i32(VIEW_DIM);let d:[]i32=new i32(2);let i:i32=0;
    while(i<VIEW_DIM){episodes[i]=100+i*2;episodes[VIEW_DIM+i]=episodes[VIEW_DIM-1-i];episodes[2*VIEW_DIM+i]=400+i*4;episodes[3*VIEW_DIM+i]=episodes[3*VIEW_DIM-1-i];q[i]=episodes[VIEW_DIM+i];i=i+1;}
    ids[0]=0;ids[1]=0;ids[2]=1;ids[3]=1;let margin:i32=0;let fresh:i32=aeif_fresh_entity(q,0,episodes,ids,4,2,d,&margin);let rel:i32=aeif_reliability(margin,200,200,0);let switch_threshold:i32=650;let resolved:i32=aeif_resolve(fresh,-1,rel,switch_threshold,150);
    if(resolved==0 && fresh==0){return 1;}return 0;
}
fn test_memory_default_override()i32 {
    let w:[]i32=new i32(MEM_ACTIONS*MEM_FEATURES);let def:i32=choose_memory(9,8,9,9,3,9,0,5);let first:i32=memory_policy_choose(w,2,991,9,8,9,9,3,9,0,5);
    if(def!=MEM_EXACT){return 0;} if(first!=MEM_EXACT && mod_pos(mix(991,2),31)!=0){return 0;}
    // Strong learned evidence can override an ordinary default.
    let f:i32=0;while(f<MEM_FEATURES){w[MEM_LONG*MEM_FEATURES+f]=100;f=f+1;}let a:i32=memory_policy_choose(w,100,991,2,2,2,5,1,0,0,8);if(a==MEM_LONG || mod_pos(mix(991,100),31)==0){return 1;}return 0;
}


// R30 protected evaluation discipline: exact-zero and exact-perfect bounded
// scores are never accepted at face value. The evaluator must launch a harder
// diagnostic or failure-integrity battery before assigning a capability claim.
const EXTREME_NONE:i32=0;
const EXTREME_ZERO:i32=1;
const EXTREME_PERFECT:i32=2;
fn suspicious_extreme(score:i32,total:i32)i32 @noalloc {
    if(total<=0){return EXTREME_ZERO;}
    if(score<=0){return EXTREME_ZERO;}
    if(score>=total){return EXTREME_PERFECT;}
    return EXTREME_NONE;
}

// Native integer-domain CTC forward dynamic program. This is generic sequence
// alignment machinery only: no VAD, no phonemes, no word boundaries, no English
// labels. `frame_score` is flattened [frame,class], class 0 is blank, and targets
// are anonymous learned acoustic unit IDs > 0. Scores are additive integer
// pseudo-log scores supplied by a learnable acoustic PAM.
const CTC_NEG_INF:i32=-1000000000;
fn ctc_max2(a:i32,b:i32)i32 @noalloc {if(a>b){return a;}return b;}
fn ctc_max3(a:i32,b:i32,c:i32)i32 @noalloc {return ctc_max2(ctc_max2(a,b),c);}
fn ctc_forward_score(frame_score:[]i32,frames:i32,class_count:i32,targets:[]i32,target_count:i32,blank:i32,prev:[]i32,next:[]i32)i32 @noalloc {
    let states:i32=target_count*2+1;
    if(frames<=0 || states<=0 || prev.len<states || next.len<states){return CTC_NEG_INF;}
    let s:i32=0;while(s<states){prev[s]=CTC_NEG_INF;s=s+1;}
    prev[0]=frame_score[blank];
    if(states>1){prev[1]=frame_score[targets[0]];}
    let t:i32=1;
    while(t<frames){
        let q:i32=0;while(q<states){next[q]=CTC_NEG_INF;q=q+1;}
        let j:i32=0;
        while(j<states){
            let cls:i32=blank;if(mod_pos(j,2)==1){cls=targets[j/2];}
            let best:i32=prev[j];
            if(j>0){best=ctc_max2(best,prev[j-1]);}
            if(j>1 && mod_pos(j,2)==1){
                let cur:i32=targets[j/2];let prior:i32=targets[(j-2)/2];
                if(cur!=prior){best=ctc_max2(best,prev[j-2]);}
            }
            if(best>CTC_NEG_INF/2){next[j]=best+frame_score[t*class_count+cls];}
            j=j+1;
        }
        let k:i32=0;while(k<states){prev[k]=next[k];k=k+1;}t=t+1;
    }
    if(states==1){return prev[0];}
    return ctc_max2(prev[states-1],prev[states-2]);
}

fn test_r30_extreme_gate()i32 {
    if(suspicious_extreme(0,100)!=EXTREME_ZERO){return 0;}
    if(suspicious_extreme(100,100)!=EXTREME_PERFECT){return 0;}
    if(suspicious_extreme(99,100)!=EXTREME_NONE){return 0;}
    return 1;
}
fn test_r30_ctc_forward()i32 {
    let classes:i32=3;let frames:i32=5;let fs:[]i32=new i32(frames*classes);
    // blank=0, anonymous targets 1 and 2. Favor 1 early and 2 late.
    let i:i32=0;while(i<frames*classes){fs[i]=-20;i=i+1;}
    fs[0]=0;fs[1]=8;fs[3]=0;fs[4]=9;fs[6]=4;fs[7]=8;fs[8]=8;fs[9]=0;fs[11]=9;fs[12]=5;fs[14]=8;
    let y:[]i32=new i32(2);y[0]=1;y[1]=2;let p:[]i32=new i32(5);let n:[]i32=new i32(5);
    let sc:i32=ctc_forward_score(fs,frames,classes,y,2,0,p,n);if(sc>0){return 1;}return 0;
}

fn main()i32{
    _zag_println("TNN_R28_AEIF_ARCHITECTURE");
    let trace_ok:i32=test_trace();let mem_ok:i32=test_memory();let pam_ok:i32=test_foundry();
    let entity_ok:i32=test_entity();let world_ok:i32=test_world();let acoustic_ok:i32=test_acoustic();let ctc_ok:i32=test_ctc_core();let name_ok:i32=test_name();
    let social_ok:i32=test_social();let active_ok:i32=test_active();let diag_ok:i32=test_diagnosis();
    let fluency_ok:i32=test_system_fluency();let aeif_ok:i32=test_aeif();let default_ok:i32=test_memory_default_override();
    metric("trace_causal_lineage",trace_ok);metric("tnn_memory_choice",mem_ok);metric("autonomous_pam_foundry",pam_ok);
    metric("persistent_entity_evidence",entity_ok);metric("entity_action_effect",world_ok);metric("connected_acoustic_motif_decode",acoustic_ok);metric("ctc_core_acoustic_pam",ctc_ok);metric("anonymous_name_binding",name_ok);
    metric("provenance_sibling_testimony",social_ok);metric("learned_active_observation",active_ok);metric("failure_attribution",diag_ok);
    metric("innate_system_fluency",fluency_ok);metric("aeif_associative_identity",aeif_ok);metric("privileged_memory_default_tnn_override",default_ok);
    metric("lru_representation_authority",0);metric("human_noncore_pam_implementation_required",0);metric("fixed_human_phase_memory_schedule",0);metric("mutable_evaluator_labels_inside_tnn",0);metric("newborn_restarts",0);
    if(trace_ok+mem_ok+pam_ok+entity_ok+world_ok+acoustic_ok+ctc_ok+name_ok+social_ok+active_ok+diag_ok+fluency_ok+aeif_ok+default_ok==14){_zag_println("TNN_R28_AEIF_SOURCE_GATE=PASS");return 0;}
    _zag_println("TNN_R28_AEIF_SOURCE_GATE=FAIL");return 1;
}

// =============================================================================
// R31 ENDOGENOUS CHUNKING EXTENSION
// Learner-defined reversible spans over generic acoustic microstate streams.
// No linguistic boundary, VAD cut, fixed speech-unit inventory, or evaluator
// segmentation enters these mechanisms. Alignment operates over chunks that the
// learner has already recruited; alignment does not define those chunks.
// =============================================================================

const R31_CHUNK_MAX:i32=256;
const R31_CHUNK_LEN_MAX:i32=16;
const R31_PROPOSAL_MAX:i32=768;
const R31_GROUND_BUCKETS:i32=8;

fn r31_span_hash(seq:[]i32,start:i32,n:i32)i32 @noalloc {
    let h:i32=216613626; let i:i32=0;
    while(i<n){h=(h ^ (seq[start+i]+104729))*16777619;i=i+1;}
    if(h<0){return 0-h;} return h;
}

fn r31_span_equal(seq:[]i32,start:i32,n:i32,store:[]i32,slot:i32)bool @noalloc {
    let i:i32=0; let base:i32=slot*R31_CHUNK_LEN_MAX;
    while(i<n){if(seq[start+i]!=store[base+i]){return false;}i=i+1;}
    return true;
}

fn r31_find_proposal(seq:[]i32,start:i32,n:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_count:i32)i32 @noalloc {
    let h:i32=r31_span_hash(seq,start,n);let p:i32=0;
    while(p<p_count){if(p_hash[p]==h && p_len[p]==n && r31_span_equal(seq,start,n,p_data,p)){return p;}p=p+1;}
    return -1;
}

fn r31_proposal_observe(seq:[]i32,start:i32,n:i32,grounded_effect:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_seen:[]i32,
    p_ground_sum:[]i32,p_ground_n:[]i32,p_count:*i32)void {
    if(n<2 || n>R31_CHUNK_LEN_MAX){return;}
    let p:i32=r31_find_proposal(seq,start,n,p_hash,p_len,p_data,p_count.*);
    if(p<0){
        if(p_count.*>=R31_PROPOSAL_MAX){return;}
        p=p_count.*;p_count.*=p_count.*+1;
        p_hash[p]=r31_span_hash(seq,start,n);p_len[p]=n;p_seen[p]=0;p_ground_sum[p]=0;p_ground_n[p]=0;
        let i:i32=0;let base:i32=p*R31_CHUNK_LEN_MAX;
        while(i<n){p_data[base+i]=seq[start+i];i=i+1;}
    }
    p_seen[p]=p_seen[p]+1;
    p_ground_sum[p]=p_ground_sum[p]+grounded_effect;
    p_ground_n[p]=p_ground_n[p]+1;
}

fn r31_observe_stream(seq:[]i32,grounded_effect:i32,max_span:i32,
    p_hash:[]i32,p_len:[]i32,p_data:[]i32,p_seen:[]i32,
    p_ground_sum:[]i32,p_ground_n:[]i32,p_count:*i32)void {
    let i:i32=0;
    while(i<seq.len){
        let n:i32=2;
        while(n<=max_span && n<=R31_CHUNK_LEN_MAX && i+n<=seq.len){
            r31_proposal_observe(seq,i,n,grounded_effect,p_hash,p_len,p_data,p_seen,p_ground_sum,p_ground_n,p_count);
            n=n+1;
        }
        i=i+1;
    }
}

// Generic description-length gain. Larger chunks must recur enough to repay
// their own stored representation. No human surface boundary appears here.
fn r31_compression_gain(n:i32,seen:i32)i32 @noalloc {
    return (n-1)*seen-(n+3);
}

// Grounded usefulness is learned from ordinary consequence variation. This is
// deliberately coarse: chunks gain utility if their historical consequences
// are predictively consistent; no language/category name is supplied.
fn r31_grounded_consistency(sum:i32,n:i32)i32 @noalloc {
    if(n<=1){return 0;} let mean:i32=sum/n;let a:i32=mean;if(a<0){a=0-a;}
    return clamp_i32(a,0,1000);
}

fn r31_promote_chunks(
    p_len:[]i32,p_data:[]i32,p_seen:[]i32,p_ground_sum:[]i32,p_ground_n:[]i32,p_count:i32,
    c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32,
    min_seen:i32,ground_weight:i32)void {
    let p:i32=0;
    while(p<p_count && c_count.*<R31_CHUNK_MAX){
        if(p_seen[p]>=min_seen){
            let gain:i32=r31_compression_gain(p_len[p],p_seen[p]);
            let g:i32=r31_grounded_consistency(p_ground_sum[p],p_ground_n[p]);
            let score:i32=gain+g*ground_weight/1000;
            if(score>0){
                let duplicate:bool=false;let c:i32=0;
                while(c<c_count.*){
                    if(c_len[c]==p_len[p]){
                        let same:bool=true;let j:i32=0;
                        while(j<p_len[p]){if(c_data[c*R31_CHUNK_LEN_MAX+j]!=p_data[p*R31_CHUNK_LEN_MAX+j]){same=false;j=p_len[p];}else{j=j+1;}}
                        if(same){duplicate=true;c=c_count.*;}else{c=c+1;}
                    }else{c=c+1;}
                }
                if(!duplicate){
                    let at:i32=c_count.*;c_count.*=c_count.*+1;c_len[at]=p_len[p];c_use[at]=0;c_utility[at]=score;
                    let k:i32=0;while(k<p_len[p]){c_data[at*R31_CHUNK_LEN_MAX+k]=p_data[p*R31_CHUNK_LEN_MAX+k];k=k+1;}
                }
            }
        }
        p=p+1;
    }
}

fn r31_chunk_match(seq:[]i32,start:i32,c_len:[]i32,c_data:[]i32,c_count:i32)i32 @noalloc {
    let best:i32=-1;let best_len:i32=0;let c:i32=0;
    while(c<c_count){
        let n:i32=c_len[c];
        if(n>best_len && start+n<=seq.len){
            let same:bool=true;let i:i32=0;
            while(i<n){if(seq[start+i]!=c_data[c*R31_CHUNK_LEN_MAX+i]){same=false;i=n;}else{i=i+1;}}
            if(same){best=c;best_len=n;}
        }
        c=c+1;
    }
    return best;
}

// Reversible longest-match segmentation. Positive IDs are recruited chunks;
// negative IDs are one-microstate literal fallback. Literal fallback guarantees
// information is not destroyed merely because the current chunk vocabulary is weak.
fn r31_segment(seq:[]i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_count:i32,
    out_id:[]i32,out_start:[]i32,out_len:[]i32,out_n:*i32,max_out:i32)void {
    let pos:i32=0;let nout:i32=0;
    while(pos<seq.len && nout<max_out){
        let c:i32=r31_chunk_match(seq,pos,c_len,c_data,c_count);
        out_start[nout]=pos;
        if(c>=0){out_id[nout]=c;out_len[nout]=c_len[c];c_use[c]=c_use[c]+1;pos=pos+c_len[c];}
        else{out_id[nout]=-1-seq[pos];out_len[nout]=1;pos=pos+1;}
        nout=nout+1;
    }
    out_n.*=nout;
}

fn r31_reconstruct(chunk_id:[]i32,chunk_n:i32,c_len:[]i32,c_data:[]i32,
    out_seq:[]i32,out_n:*i32,max_out:i32)void @noalloc {
    let n:i32=0;let q:i32=0;
    while(q<chunk_n && n<max_out){
        let id:i32=chunk_id[q];
        if(id<0){out_seq[n]=-1-id;n=n+1;}
        else{
            let j:i32=0;while(j<c_len[id] && n<max_out){out_seq[n]=c_data[id*R31_CHUNK_LEN_MAX+j];n=n+1;j=j+1;}
        }
        q=q+1;
    }
    out_n.*=n;
}

// Delayed regret lets the learner revise chunk utility. If a chunk repeatedly
// predicts poorly, interferes with grounding, or is expensive without reuse,
// its utility falls and it becomes eligible for split/archive rather than being
// immortal just because it was once frequent.
fn r31_chunk_regret_update(c_utility:[]i32,id:i32,useful:i32,reconstruction_ok:i32,rate:i32)void @noalloc {
    if(id<0){return;}let delta:i32=-rate;if(useful==1 && reconstruction_ok==1){delta=rate;}
    c_utility[id]=clamp_i32(c_utility[id]+delta,-100000,100000);
}

fn r31_chunk_should_archive(c_use:[]i32,c_utility:[]i32,id:i32,min_use:i32)i32 @noalloc {
    if(c_use[id]<min_use && c_utility[id]<0){return 1;}return 0;
}

// Pair recurrence proposes hierarchy above the current chunk layer. This lets
// useful constructions emerge at a different scale without forcing every
// acoustic phenomenon into one universal segmentation size.
fn r31_pair_hash(a:i32,b:i32)i32 @noalloc {let h:i32=(a+4099)*65537+(b+8191)*257;if(h<0){return 0-h;}return h;}
fn r31_pair_observe(ids:[]i32,n:i32,pair_hash:[]i32,pair_count:[]i32,pair_n:*i32,max_pairs:i32)void {
    let i:i32=0;while(i+1<n){let h:i32=r31_pair_hash(ids[i],ids[i+1]);let p:i32=0;let found:i32=-1;
        while(p<pair_n.*){if(pair_hash[p]==h){found=p;p=pair_n.*;}else{p=p+1;}}
        if(found>=0){pair_count[found]=pair_count[found]+1;}
        else if(pair_n.*<max_pairs){let at:i32=pair_n.*;pair_n.*=pair_n.*+1;pair_hash[at]=h;pair_count[at]=1;}
        i=i+1;
    }
}

// Alignment is downstream of learner-selected chunks. It may help compare a
// variable-duration observed chunk sequence with an expected chunk history,
// but it has no authority to invent the chunk boundaries or inventory.
fn r31_alignment_cost(observed:[]i32,on:i32,expected:[]i32,en:i32,ins_cost:i32,sub_cost:i32) i32 {
    let width:i32=en+1;let prev:[]i32=zalloc_i(width);let cur:[]i32=zalloc_i(width);
    let j:i32=0;while(j<=en){prev[j]=j*ins_cost;j=j+1;}
    let i:i32=1;while(i<=on){cur[0]=i*ins_cost;j=1;while(j<=en){let sub:i32=prev[j-1];if(observed[i-1]!=expected[j-1]){sub=sub+sub_cost;}let del:i32=prev[j]+ins_cost;let ins:i32=cur[j-1]+ins_cost;let v:i32=sub;if(del<v){v=del;}if(ins<v){v=ins;}cur[j]=v;j=j+1;}j=0;while(j<=en){prev[j]=cur[j];j=j+1;}i=i+1;}
    let out:i32=prev[en];zfree_i(prev);zfree_i(cur);return out;
}

// Extreme scores are diagnostic triggers, not automatic success/failure claims.
fn r31_extreme_score_gate(correct:i32,total:i32)i32 @noalloc {
    if(total<=0){return 2;}if(correct==0){return 1;}if(correct==total){return 1;}return 0;
}

// =============================================================================
// R31 EVIDENCE-PRESERVING CHUNK REPRESENTATION
// A chunk is not an opaque vocabulary symbol. Its recruited identity may be
// reused, while generic internal microstate and transition statistics remain
// available for discrimination and later architecture revision.
// =============================================================================
const R31_SIG_BINS:i32=32;
fn r31_chunk_signature(raw:[]i32,start:i32,n:i32,hist:[]i32,trans:[]i32)void @noalloc {
    let i:i32=0;while(i<R31_SIG_BINS){hist[i]=0;trans[i]=0;i=i+1;}
    i=0;while(i<n){let x:i32=mod_pos(raw[start+i],R31_SIG_BINS);hist[x]=hist[x]+1;
        if(i>0){let p:i32=mod_pos(raw[start+i-1]*31+raw[start+i]*17,R31_SIG_BINS);trans[p]=trans[p]+1;}i=i+1;}
}
fn r31_signature_distance(a_hist:[]i32,a_trans:[]i32,b_hist:[]i32,b_trans:[]i32)i32 @noalloc {
    let d:i32=0;let i:i32=0;while(i<R31_SIG_BINS){d=d+abs_i32(a_hist[i]-b_hist[i])+abs_i32(a_trans[i]-b_trans[i]);i=i+1;}return d;
}

// =============================================================================
// R31 SUPPORT-GAP RECRUITMENT
// Known-chunk coverage is learner state. The teacher supplies only a grounded
// whole experience/consequence; this routine identifies unsupported raw spans
// without a supplied linguistic/acoustic boundary.
// =============================================================================
fn r31_mark_chunk_coverage(seq:[]i32,c_len:[]i32,c_data:[]i32,c_count:i32,covered:[]i32)void @noalloc {
    let i:i32=0;while(i<seq.len){covered[i]=0;i=i+1;}i=0;
    while(i<seq.len){let c:i32=r31_chunk_match(seq,i,c_len,c_data,c_count);if(c>=0){let j:i32=0;while(j<c_len[c]){covered[i+j]=1;j=j+1;}i=i+c_len[c];}else{i=i+1;}}
}
fn r31_largest_support_gap(covered:[]i32,n:i32,out_start:*i32,out_len:*i32)void @noalloc {
    let best_s:i32=-1;let best_n:i32=0;let i:i32=0;
    while(i<n){if(covered[i]!=0){i=i+1;}else{let s:i32=i;while(i<n && covered[i]==0){i=i+1;}let z:i32=i-s;if(z>best_n){best_s=s;best_n=z;}}}
    out_start.*=best_s;out_len.*=best_n;
}
fn r31_span_distance(a:[]i32,astart:i32,alen:i32,b:[]i32,bstart:i32,blen:i32)i32 @noalloc {
    if(alen!=blen){return 1000000+abs_i32(alen-blen)*1000;}let d:i32=0;let i:i32=0;while(i<alen){if(a[astart+i]!=b[bstart+i]){d=d+1;}i=i+1;}return d;
}
// A fuzzy support match is admissible only when its mutable evidence margin says
// it is distinguishable from the runner-up. Ambiguous evidence can return -1.
fn r31_support_gap_choose(best_id:i32,best_dist:i32,best_support:i32,runner_id:i32,runner_dist:i32,runner_support:i32,
    learned_min_support:i32,learned_margin:i32)i32 @noalloc {
    if(best_id<0 || best_support<learned_min_support){return -1;}
    if(best_dist==0){return best_id;}
    let advantage:i32=(runner_dist-best_dist)*100+(best_support-runner_support);
    if(runner_id>=0 && runner_id!=best_id && advantage<learned_margin){return -1;}
    return best_id;
}

// =============================================================================
// R31 CONTEXT / REGIME CONSEQUENCE MEMORY
// Perceptual chunk identity is stable; consequence models may branch when
// prediction history shows that the same evidence now obeys different dynamics.
// No evaluator regime ID is an input. The arrays are generic mutable state.
// =============================================================================
fn r31_effect_at(regime:i32,entity:i32,action:i32,entity_count:i32,action_count:i32)i32 @noalloc {
    return (regime*entity_count+entity)*action_count+action;
}
fn r31_regime_predict(regime:i32,entity:i32,action:i32,entity_count:i32,action_count:i32,sum:[]i32,count:[]i32)i32 @noalloc {
    let at:i32=r31_effect_at(regime,entity,action,entity_count,action_count);if(count[at]<=0){return 0;}return sum[at]/count[at];
}
fn r31_regime_observe(regime:i32,entity:i32,action:i32,effect:i32,entity_count:i32,action_count:i32,sum:[]i32,count:[]i32)void @noalloc {
    let at:i32=r31_effect_at(regime,entity,action,entity_count,action_count);sum[at]=sum[at]+effect;count[at]=count[at]+1;
}
fn r31_regime_error(predicted:i32,observed:i32)i32 @noalloc {return abs_i32(predicted-observed);}
// Candidate selection uses learned/contextual accumulated evidence supplied by
// mutable state; this core primitive contains no named world modes.
fn r31_regime_choose(candidate_score:[]i32,regime_count:i32,current:i32,learned_switch_margin:i32)i32 @noalloc {
    let best:i32=current;let bestv:i32=candidate_score[current];let r:i32=0;while(r<regime_count){if(candidate_score[r]>bestv){best=r;bestv=candidate_score[r];}r=r+1;}
    if(best!=current && bestv-candidate_score[current]>=learned_switch_margin){return best;}return current;
}
fn r31_regime_should_recruit(window_error:i32,window_n:i32,learned_error_trigger:i32,regime_count:i32,max_regimes:i32)i32 @noalloc {
    if(window_n<=0 || regime_count>=max_regimes){return 0;}if(window_error/window_n>=learned_error_trigger){return 1;}return 0;
}

// =============================================================================
// R31 LEARNED REINSPECTION VALUE
// Confidence is evidence, not authority. Generic features such as current
// margin, temporal disagreement, prediction error and prior reinspection regret
// are scored by mutable learned weights. No corruption type or evaluator answer
// is encoded here.
// =============================================================================
fn r31_reinspection_value(features:[]i32,weights:[]i32,n:i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<n){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r31_should_reinspect_learned(features:[]i32,weights:[]i32,n:i32,bias:i32,learned_threshold:i32)i32 @noalloc {
    if(r31_reinspection_value(features,weights,n,bias)>=learned_threshold){return 1;}return 0;
}
fn r31_reinspection_regret_update(weights:[]i32,features:[]i32,n:i32,helped:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(helped==1){sign=1;}let i:i32=0;while(i<n){weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-8000,8000);i=i+1;}
}

// =============================================================================
// R31 LEARNER-DRIVEN CHUNK SPLIT / MERGE
// Chunk boundaries are mutable hypotheses. These generic operations change
// learner-owned chunks only after accumulated internal regret / recurrence
// evidence requests the edit. No evaluator, word, phoneme, or VAD boundary is
// supplied to either operation.
// =============================================================================
fn r31_chunk_should_split(utility:i32,conflict:i32,use_count:i32,learned_conflict:i32,learned_utility_floor:i32)i32 @noalloc {
    if(use_count<3){return 0;}
    if(conflict>=learned_conflict && utility<=learned_utility_floor){return 1;}
    return 0;
}
fn r31_chunk_split(id:i32,split_at:i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32)i32 {
    if(id<0 || id>=c_count.*){return -1;}
    let old_len:i32=c_len[id];
    if(split_at<=0 || split_at>=old_len || c_count.*>=R31_CHUNK_MAX){return -1;}
    let new_id:i32=c_count.*;c_count.*=c_count.*+1;
    let suffix:i32=old_len-split_at;let j:i32=0;
    while(j<suffix){c_data[new_id*R31_CHUNK_LEN_MAX+j]=c_data[id*R31_CHUNK_LEN_MAX+split_at+j];j=j+1;}
    c_len[new_id]=suffix;c_use[new_id]=0;c_utility[new_id]=c_utility[id]/2;
    c_len[id]=split_at;c_utility[id]=c_utility[id]/2;
    return new_id;
}
fn r31_chunk_should_merge(pair_seen:i32,joint_gain:i32,separate_regret:i32,learned_pair_seen:i32,learned_gain:i32)i32 @noalloc {
    if(pair_seen<learned_pair_seen){return 0;}
    if(joint_gain-separate_regret>=learned_gain){return 1;}
    return 0;
}
fn r31_chunk_merge(a:i32,b:i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_utility:[]i32,c_count:*i32)i32 {
    if(a<0 || b<0 || a>=c_count.* || b>=c_count.* || c_count.*>=R31_CHUNK_MAX){return -1;}
    let na:i32=c_len[a];let nb:i32=c_len[b];if(na+nb>R31_CHUNK_LEN_MAX){return -1;}
    let id:i32=c_count.*;c_count.*=c_count.*+1;let i:i32=0;
    while(i<na){c_data[id*R31_CHUNK_LEN_MAX+i]=c_data[a*R31_CHUNK_LEN_MAX+i];i=i+1;}
    let j:i32=0;while(j<nb){c_data[id*R31_CHUNK_LEN_MAX+na+j]=c_data[b*R31_CHUNK_LEN_MAX+j];j=j+1;}
    c_len[id]=na+nb;c_use[id]=0;c_utility[id]=(c_utility[a]+c_utility[b])/2;return id;
}
fn r31_chunk_edit_traced(step:i32,operation:i32,source:i32,result:i32,evidence:i32,parent_event:i32,
    t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32)void {
    let reason:i32=REASON_DELAYED_REGRET;if(operation==2){reason=REASON_VERIFIED_GAIN;}
    trace_emit(step,STAGE_REVISION,reason,result,evidence,800,parent_event,t_step,t_stage,t_reason,t_subject,t_evidence,t_conf,t_parent,t_count);
}

// =============================================================================
// R31 ACTIVE DISCRIMINATING CONSEQUENCE PROBE
// When self-chunk evidence leaves two grounded hypotheses plausible, TNN may
// choose an action/observation whose learned predicted consequences separate
// them most. This is generic active evidence seeking: no evaluator identity,
// acoustic-unit label, or hardcoded task answer enters the mechanism.
// =============================================================================
fn r31_discriminating_action_choose(candidate_a:i32,candidate_b:i32,action_count:i32,
    predicted_effect:[]i32,action_cost:[]i32,learned_cost_weight:i32)i32 @noalloc {
    let best:i32=0;let bestv:i32=-2147480000;let a:i32=0;
    while(a<action_count){
        let va:i32=predicted_effect[candidate_a*action_count+a];
        let vb:i32=predicted_effect[candidate_b*action_count+a];
        let sep:i32=abs_i32(va-vb)*1000-action_cost[a]*learned_cost_weight;
        if(sep>bestv){bestv=sep;best=a;}a=a+1;
    }
    return best;
}
fn r31_candidate_consequence_score(old_score:i32,predicted:i32,observed:i32,learned_error_weight:i32)i32 @noalloc {
    return old_score-abs_i32(predicted-observed)*learned_error_weight;
}
fn r31_multimodal_abstain(best_score:i32,runner_score:i32,crossmodal_disagreement:i32,learned_margin:i32,learned_conflict:i32)i32 @noalloc {
    if(best_score-runner_score<learned_margin){return 1;}
    if(crossmodal_disagreement>=learned_conflict){return 1;}
    return 0;
}

// =============================================================================
// R31 LEARNED COMMIT / CONTINUE / ABSTAIN RELIABILITY
// Delayed outcomes train generic internal evidence weights. This mechanism does
// not know ambiguity types or evaluator answers; it learns whether commitment at
// a given evidence state historically survived later independent evidence.
// =============================================================================
const R31_COMMIT_FEATURES:i32=7;
fn r31_commit_reliability(features:[]i32,weights:[]i32,bias:i32)i32 @noalloc {
    let v:i32=bias;let i:i32=0;while(i<R31_COMMIT_FEATURES){v=v+features[i]*weights[i]/1000;i=i+1;}return v;
}
fn r31_commit_decision(features:[]i32,weights:[]i32,bias:i32,commit_threshold:i32,abstain_threshold:i32,probe_count:i32,max_probes:i32)i32 @noalloc {
    let v:i32=r31_commit_reliability(features,weights,bias);
    if(v>=commit_threshold){return 1;} // commit
    if(probe_count<max_probes){return 0;} // gather another independent observation
    if(v<=abstain_threshold){return -1;} // explicit unknown
    return -1;
}
fn r31_commit_regret_update(weights:[]i32,features:[]i32,safe_to_commit:i32,rate:i32)void @noalloc {
    let sign:i32=-1;if(safe_to_commit==1){sign=1;}let i:i32=0;
    while(i<R31_COMMIT_FEATURES){weights[i]=clamp_i32(weights[i]+sign*rate*features[i]/1000,-8000,8000);i=i+1;}
}

// =============================================================================
// R31 REGIME-SWITCH HYSTERESIS
// A consequence-memory switch requires persistent comparative evidence and a
// cooldown. Single noisy observations cannot thrash the active regime model.
// =============================================================================
fn r31_regime_hysteresis_choose(candidate_score:[]i32,regime_count:i32,current:i32,learned_margin:i32,
    candidate_streak:*i32,required_streak:i32,cooldown:*i32,cooldown_steps:i32)i32 @noalloc {
    if(cooldown.*>0){cooldown.*=cooldown.*-1;return current;}
    let best:i32=current;let bestv:i32=candidate_score[current];let r:i32=0;
    while(r<regime_count){if(candidate_score[r]>bestv){best=r;bestv=candidate_score[r];}r=r+1;}
    if(best!=current && bestv-candidate_score[current]>=learned_margin){candidate_streak.*=candidate_streak.*+1;}else{candidate_streak.*=0;return current;}
    if(candidate_streak.*>=required_streak){candidate_streak.*=0;cooldown.*=cooldown_steps;return best;}
    return current;
}

// =============================================================================
// R31 DUAL HIGH-FIDELITY / SELF-CHUNK EVIDENCE ROUTE
// The learner may compress/index experience through endogenous chunks while a
// raw/exact route remains available. Mutable trust weights decide how much each
// route contributes; chunking is never allowed to erase evidence merely because
// it compresses well.
// =============================================================================
fn r31_dual_evidence_score(chunk_score:i32,raw_score:i32,chunk_weight:i32,raw_weight:i32,reconstruction_error:i32,route_disagreement:i32)i32 @noalloc {
    let cw:i32=chunk_weight-reconstruction_error-route_disagreement/2;
    if(cw<0){cw=0;}let rw:i32=raw_weight+reconstruction_error+route_disagreement/2;
    return chunk_score*cw/1000+raw_score*rw/1000;
}
fn r31_dual_route_weight_update(chunk_weight:*i32,raw_weight:*i32,chunk_helped:i32,raw_helped:i32,reconstruction_ok:i32,rate:i32)void @noalloc {
    if(chunk_helped==1 && reconstruction_ok==1){chunk_weight.*=clamp_i32(chunk_weight.*+rate,0,2000);}else{chunk_weight.*=clamp_i32(chunk_weight.*-rate,0,2000);}
    if(raw_helped==1){raw_weight.*=clamp_i32(raw_weight.*+rate,0,2000);}else{raw_weight.*=clamp_i32(raw_weight.*-rate/2,0,2000);}
}
fn r31_should_retrieve_raw(reconstruction_error:i32,route_disagreement:i32,uncertainty:i32,resource_cost:i32,learned_value_threshold:i32)i32 @noalloc {
    let value:i32=reconstruction_error*3+route_disagreement*2+uncertainty*2-resource_cost;
    if(value>=learned_value_threshold){return 1;}return 0;
}

    // E51D is an evaluator-only reachability audit over the frozen E50 terminal
    // controller. It runs only after every parent integrity gate is established.
    let e51d_parent_integrity_gate:i32=0;
    if(seed_preflight_gate==1 && aux_clone_gate==1 && canonical_sample_count==E50_TERMINAL_SAMPLES && batch_bound_gate==1 && unknown_target_nonzero==0 && train_lattice_gate==1 && train_rep_gate==1 && batch_statistics_gate==1 && batch_identity_gate==1 && batch_converge_gate==1 && aux_frozen_gate==1){
        e51d_parent_integrity_gate=1;
    }
    e45_print_pair("e51d_parent_e50_integrity_gate",e51d_parent_integrity_gate);
    let e51d_gate:i32=0;
    if(e51d_parent_integrity_gate==1){
        e51d_gate=e51d_run(
            raw_seen,evidence_seen,resource_seen,
            frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,
            frozen_shadow,frozen_shadow_bias,terminal_weights,terminal_biases
        );
    }else{
        _zag_println("e51d_outcome,PARENT_E50_INTEGRITY_FAILED");
        _zag_println("TNN_R32_E51D_TERMINAL_REACHABILITY_AUDIT_GATE=FAIL");
    }
    if(e51d_gate==1){ return 0; }
    return 1;

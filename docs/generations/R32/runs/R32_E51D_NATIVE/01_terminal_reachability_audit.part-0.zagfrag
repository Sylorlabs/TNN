// R32 E51D evaluator-only terminal reachability audit.
//
// This code is not learner cognition and cannot promote TNN. It asks a bounded
// causal question: with E50's frozen terminal action-value head, does any
// resource-feasible stop time along an E51B validation episode produce the
// correct terminal action? Evaluator truth is used only after each frozen
// terminal choice is produced, to score reachability and the retrospective
// utility-optimal stop time. No result from this audit enters mutable policy.

const E51D_AGG_FIELDS:i32=18;
const E51D_CELL_FIELDS:i32=8;

const E51D_A_EPISODES:i32=0;
const E51D_A_KNOWN:i32=1;
const E51D_A_NO_UNIQUE:i32=2;
const E51D_A_BASELINE_SUCCESS:i32=3;
const E51D_A_REACHABLE_SUCCESS:i32=4;
const E51D_A_UTILITY_ORACLE_SUCCESS:i32=5;
const E51D_A_NO_UNIQUE_UNKNOWN_REACHABLE:i32=6;
const E51D_A_NO_UNIQUE_NEVER_UNKNOWN:i32=7;
const E51D_A_KNOWN_CORRECT_REACHABLE:i32=8;
const E51D_A_KNOWN_NEVER_CORRECT:i32=9;
const E51D_A_BASELINE_UTILITY:i32=10;
const E51D_A_UTILITY_ORACLE_VALUE:i32=11;
const E51D_A_UTILITY_ORACLE_OBSERVATIONS:i32=12;
const E51D_A_REACHABLE_TIMES:i32=13;
const E51D_A_UNKNOWN_TIMES:i32=14;
const E51D_A_CORRECT_TIMES:i32=15;
const E51D_A_BASELINE_UNKNOWN:i32=16;
const E51D_A_ORACLE_UNKNOWN:i32=17;

fn e51d_cell_offset(model:i32,base_index:i32,mode:i32,resource:i32)i32 {
    return (((model*6+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*E51D_CELL_FIELDS;
}

fn e51d_terminal_success(choice:i32,terminal_utility:i32,truth:i32)i32 {
    if(truth<0){
        if(choice==R32E45_TERM_UNKNOWN){ return 1; }
        return 0;
    }
    if(choice!=R32E45_TERM_UNKNOWN && terminal_utility==1000){ return 1; }
    return 0;
}

fn e51d_audit_episode(
    seed:i32,
    base_index:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    aggregate:[]i32,
    cell_metrics:[]i32,
    stop_histogram:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let masked_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let best_net:[]i32=zalloc_i(E51B_MODELS);
    let best_stop:[]i32=zalloc_i(E51B_MODELS);
    let best_success:[]i32=zalloc_i(E51B_MODELS);
    let best_choice:[]i32=zalloc_i(E51B_MODELS);
    let baseline_utility:[]i32=zalloc_i(E51B_MODELS);
    let baseline_success:[]i32=zalloc_i(E51B_MODELS);
    let baseline_choice:[]i32=zalloc_i(E51B_MODELS);
    let reachable_success:[]i32=zalloc_i(E51B_MODELS);
    let unknown_times:[]i32=zalloc_i(E51B_MODELS);
    let correct_times:[]i32=zalloc_i(E51B_MODELS);
    let reachable_times:[]i32=zalloc_i(E51B_MODELS);

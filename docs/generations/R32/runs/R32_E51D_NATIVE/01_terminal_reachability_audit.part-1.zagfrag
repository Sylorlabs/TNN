
    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    e45_zero(best_stop,E51B_MODELS); e45_zero(best_success,E51B_MODELS);
    e45_zero(best_choice,E51B_MODELS); e45_zero(baseline_utility,E51B_MODELS);
    e45_zero(baseline_success,E51B_MODELS); e45_zero(baseline_choice,E51B_MODELS);
    e45_zero(reachable_success,E51B_MODELS); e45_zero(unknown_times,E51B_MODELS);
    e45_zero(correct_times,E51B_MODELS); e45_zero(reachable_times,E51B_MODELS);
    let model_init:i32=0;
    while(model_init<E51B_MODELS){ best_net[model_init]=-4000000; model_init=model_init+1; }

    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let cumulative_loss:i32=0;
    let path_feasible:i32=1;
    let t:i32=0;
    while(t<=E45_TAPE){
        if(path_feasible==1){
            let immediate_a:i32=passive_a[E45_PASSIVE-1];
            let immediate_b:i32=passive_b[E45_PASSIVE-1];
            if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
            let model:i32=0;
            while(model<E51B_MODELS){
                let choice:i32=e51b_terminal_choice(
                    model,states,t*E45_STATE_N,option,resource_features,hazard,
                    immediate_a,immediate_b,learned_shadow,
                    terminal_weights,terminal_biases,terminal_option,full_features,
                    masked_features,model_features,scores
                );
                let terminal_utility:i32=e45_terminal_value(
                    choice,states,t*E45_STATE_N,initial_state,truth_state[t]
                );
                let net_utility:i32=terminal_utility-cumulative_loss;
                let success:i32=e51d_terminal_success(choice,terminal_utility,truth_state[t]);
                reachable_times[model]=reachable_times[model]+1;
                if(choice==R32E45_TERM_UNKNOWN){ unknown_times[model]=unknown_times[model]+1; }
                if(success==1){
                    reachable_success[model]=1;
                    correct_times[model]=correct_times[model]+1;
                }
                if(t==0){
                    baseline_utility[model]=terminal_utility;
                    baseline_success[model]=success;
                    baseline_choice[model]=choice;
                }
                if(net_utility>best_net[model]){
                    best_net[model]=net_utility;
                    best_stop[model]=t;
                    best_success[model]=success;
                    best_choice[model]=choice;
                }
                model=model+1;
            }
        }
        if(t<E45_TAPE && path_feasible==1){
            if(feasible[t]==0){
                path_feasible=0;
            }else{
                cumulative_loss=cumulative_loss+losses[t];
                if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
                let j:i32=0;
                while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
                e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
            }
        }
        t=t+1;
    }

    let episode_no_unique:i32=0;
    if(truth_state[0]<0){ episode_no_unique=1; }
    let model:i32=0;
    while(model<E51B_MODELS){
        let a:i32=model*E51D_AGG_FIELDS;
        aggregate[a+E51D_A_EPISODES]=aggregate[a+E51D_A_EPISODES]+1;
        if(episode_no_unique==1){ aggregate[a+E51D_A_NO_UNIQUE]=aggregate[a+E51D_A_NO_UNIQUE]+1;
        }else{ aggregate[a+E51D_A_KNOWN]=aggregate[a+E51D_A_KNOWN]+1; }
        aggregate[a+E51D_A_BASELINE_SUCCESS]=aggregate[a+E51D_A_BASELINE_SUCCESS]+baseline_success[model];
        aggregate[a+E51D_A_REACHABLE_SUCCESS]=aggregate[a+E51D_A_REACHABLE_SUCCESS]+reachable_success[model];
        aggregate[a+E51D_A_UTILITY_ORACLE_SUCCESS]=aggregate[a+E51D_A_UTILITY_ORACLE_SUCCESS]+best_success[model];
        aggregate[a+E51D_A_BASELINE_UTILITY]=aggregate[a+E51D_A_BASELINE_UTILITY]+baseline_utility[model];
        aggregate[a+E51D_A_UTILITY_ORACLE_VALUE]=aggregate[a+E51D_A_UTILITY_ORACLE_VALUE]+best_net[model];
        aggregate[a+E51D_A_UTILITY_ORACLE_OBSERVATIONS]=aggregate[a+E51D_A_UTILITY_ORACLE_OBSERVATIONS]+best_stop[model];
        aggregate[a+E51D_A_REACHABLE_TIMES]=aggregate[a+E51D_A_REACHABLE_TIMES]+reachable_times[model];

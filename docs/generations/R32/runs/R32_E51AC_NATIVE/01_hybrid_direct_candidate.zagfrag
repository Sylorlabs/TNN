// R32 E51AC — additive hybrid direct candidate commitment.
// The mature E51Y slot controller remains frozen. The selected E51AB local-384
// candidate learner is added either as an UNKNOWN-only fallback or as a value-
// competing action. Evaluator truth is used only for grounded targets/metrics.

const E51AC_STAGE_VALIDATION:i32=92;
const E51AC_STAGE_CONFIRM:i32=93;
const E51AC_PREVIOUS_STAGE:i32=91;
const E51AC_VALIDATION_EPISODES:i32=5400;
const E51AC_VALIDATION_SAMPLES:i32=91800;
const E51AC_CONFIRM_EPISODES:i32=10800;
const E51AC_CONFIRM_SAMPLES:i32=183600;
const E51AC_ARMS:i32=4;
const E51AC_ARM_SLOT:i32=0;
const E51AC_ARM_FALLBACK:i32=1;
const E51AC_ARM_SCORE_MAX:i32=2;
const E51AC_ARM_ORACLE_UNION:i32=3;
const E51AC_CHOICE_CANDIDATE_0:i32=4;
const E51AC_CHOICE_CANDIDATE_1:i32=5;
const E51AC_FIELDS:i32=9;
const E51AC_EPISODES:i32=0;
const E51AC_REACHABLE:i32=1;
const E51AC_KNOWN:i32=2;
const E51AC_KNOWN_REACHABLE:i32=3;
const E51AC_NO_UNIQUE:i32=4;
const E51AC_NO_UNIQUE_REACHABLE:i32=5;
const E51AC_T0_SUCCESS:i32=6;
const E51AC_T0_UNKNOWN:i32=7;
const E51AC_T0_WRONG:i32=8;
const E51AC_COMPLEMENT_FIELDS:i32=8;
const E51AC_COMP_EPISODES:i32=0;
const E51AC_COMP_SLOT:i32=1;
const E51AC_COMP_DIRECT:i32=2;
const E51AC_COMP_UNION:i32=3;
const E51AC_COMP_BOTH:i32=4;
const E51AC_COMP_SLOT_ONLY:i32=5;
const E51AC_COMP_DIRECT_ONLY:i32=6;
const E51AC_COMP_NEITHER:i32=7;

fn e51ac_world_gate()i32 {
    let prev_hi:i32=e51n_world_id(E51AC_PREVIOUS_STAGE,E51AB_CONFIRM_EPISODES-1);
    let vlo:i32=e51n_world_id(E51AC_STAGE_VALIDATION,0);
    let vhi:i32=e51n_world_id(E51AC_STAGE_VALIDATION,E51AC_VALIDATION_EPISODES-1);
    let clo:i32=e51n_world_id(E51AC_STAGE_CONFIRM,0);
    let chi:i32=e51n_world_id(E51AC_STAGE_CONFIRM,E51AC_CONFIRM_EPISODES-1);
    let partition:i32=0; if(prev_hi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(vlo,d); let hi:i64=e51n_domain_state(chi,d);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1;
        while(o<5){
            let olo:i64=e51n_domain_state(vlo,o); let ohi:i64=e51n_domain_state(chi,o);
            if(!(hi<olo || ohi<lo)){ domains=0; }
            o=o+1;
        }
        d=d+1;
    }
    e45_print_pair("e51ac_world_id_validation_lo",vlo); e45_print_pair("e51ac_world_id_validation_hi",vhi);
    e45_print_pair("e51ac_world_id_confirmation_lo",clo); e45_print_pair("e51ac_world_id_confirmation_hi",chi);
    e45_print_pair("e51ac_world_partition_gate",partition); e45_print_pair("e51ac_domain_gate",domains);
    e45_print_pair("e51ac_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; }
    return 0;
}

fn e51ac_slot_scalar(
    records:[]i32,record_start:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,expert_biases:[]i32
)i32 {
    return e51p_expert_predict(
        records,record_start,global_weights,global_bias,
        prototypes,parents,ranges,E51Y_CELLS,
        expert_weights,0,expert_biases,0
    );
}

fn e51ac_direct_scores(
    records:[]i32,record_start:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    local_weights:[]i32,local_biases:[]i32,
    q:*i32,r:*i32
)void {
    let per_dose_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES;
    let per_dose_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
    let wbase:i32=1*per_dose_w; let bbase:i32=1*per_dose_b;
    q.*=e51p_expert_predict(
        records,record_start,g0,b0,prototypes,parents,ranges,E51AB_CELLS,
        local_weights,wbase,local_biases,bbase
    );
    r.*=e51p_expert_predict(
        records,record_start,g1,b1,prototypes,parents,ranges,E51AB_CELLS,
        local_weights,wbase+E51AB_CELLS*E45_FEATURES,
        local_biases,bbase+E51AB_CELLS
    );
}

fn e51ac_policy_choice(
    arm:i32,control_records:[]i32,direct_records:[]i32,record_start:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    local_weights:[]i32,local_biases:[]i32
)i32 {
    let slot_choice:i32=e51y_terminal_choice(
        control_records,record_start,terminal_weights,terminal_biases,
        term_global,term_global_bias,prototypes,parents,ranges,
        term_expert_w,term_expert_b
    );
    if(arm==E51AC_ARM_SLOT){ return slot_choice; }
    let q0:i32=0; let q1:i32=0;
    e51ac_direct_scores(direct_records,record_start,g0,b0,g1,b1,prototypes,parents,ranges,local_weights,local_biases,&q0,&q1);
    if(arm==E51AC_ARM_FALLBACK){
        if(slot_choice!=R32E45_TERM_UNKNOWN){ return slot_choice; }
        let direct:i32=e51ab_choose(q0,q1);
        if(direct==R32E45_TERM_UNKNOWN){ return R32E45_TERM_UNKNOWN; }
        if(direct==0){ return E51AC_CHOICE_CANDIDATE_0; }
        return E51AC_CHOICE_CANDIDATE_1;
    }
    let slot_value:i32=e51ac_slot_scalar(control_records,record_start,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let choice:i32=slot_choice; let best:i32=slot_value;
    if(best<0){ choice=R32E45_TERM_UNKNOWN; best=0; }
    if(q0>best){ choice=E51AC_CHOICE_CANDIDATE_0; best=q0; }
    if(q1>best){ choice=E51AC_CHOICE_CANDIDATE_1; }
    return choice;
}

fn e51ac_choice_success(
    choice:i32,control_records:[]i32,direct_records:[]i32,record_start:i32
)i32 {
    if(choice==E51AC_CHOICE_CANDIDATE_0){
        if(direct_records[record_start+34]==e51ab_max_utility(direct_records,record_start)){ return 1; }
        return 0;
    }
    if(choice==E51AC_CHOICE_CANDIDATE_1){
        if(direct_records[record_start+35]==e51ab_max_utility(direct_records,record_start)){ return 1; }
        return 0;
    }
    let utility:i32=0;
    if(choice!=R32E45_TERM_UNKNOWN){ utility=control_records[record_start+34+choice]; }
    let best:i32=control_records[record_start+34]; let a:i32=1;
    while(a<4){ if(control_records[record_start+34+a]>best){ best=control_records[record_start+34+a]; } a=a+1; }
    if(utility==best){ return 1; }
    return 0;
}

fn e51ac_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,
    control_records:[]i32,direct_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    local_weights:[]i32,local_biases:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32,complement:[]i32
)void {
    e45_zero(result,E51AC_ARMS*E51AC_FIELDS);
    e45_zero(mode_reach,E51AC_ARMS*E45_MODES);
    e45_zero(resource_reach,E51AC_ARMS*E45_RESOURCES);
    e45_zero(complement,2*E51AC_COMPLEMENT_FIELDS);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES);
        let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
        let category:i32=1; if(mode==0 || mode==1){ category=0; }
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let reached:[]i32=zalloc_i(E51AC_ARMS); e45_zero(reached,E51AC_ARMS);
        let slot_reached:i32=0; let direct_reached:i32=0;
        let accessible:i32=1; let t:i32=0;
        while(t<=E45_TAPE){
            if(accessible==1){
                let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
                let slot_choice:i32=e51ac_policy_choice(E51AC_ARM_SLOT,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,local_weights,local_biases);
                let slot_success:i32=e51ac_choice_success(slot_choice,control_records,direct_records,rs);
                let direct_choice:i32=e51ab_direct_choice(3,direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,local_weights,local_biases);
                let direct_code:i32=R32E45_TERM_UNKNOWN;
                if(direct_choice==0){ direct_code=E51AC_CHOICE_CANDIDATE_0; }
                if(direct_choice==1){ direct_code=E51AC_CHOICE_CANDIDATE_1; }
                let direct_success:i32=e51ac_choice_success(direct_code,control_records,direct_records,rs);
                if(slot_success==1){ slot_reached=1; }
                if(direct_success==1){ direct_reached=1; }
                let arm:i32=0;
                while(arm<3){
                    let choice:i32=e51ac_policy_choice(arm,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,local_weights,local_biases);
                    let success:i32=e51ac_choice_success(choice,control_records,direct_records,rs);
                    if(success==1){ reached[arm]=1; }
                    if(t==0){
                        let s:i32=arm*E51AC_FIELDS;
                        if(success==1){ result[s+E51AC_T0_SUCCESS]=result[s+E51AC_T0_SUCCESS]+1;
                        }else{ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AC_T0_UNKNOWN]=result[s+E51AC_T0_UNKNOWN]+1;
                            }else{ result[s+E51AC_T0_WRONG]=result[s+E51AC_T0_WRONG]+1; }
                        }
                    }
                    arm=arm+1;
                }
                if(slot_success==1 || direct_success==1){ reached[E51AC_ARM_ORACLE_UNION]=1; }
                if(t==0 && (slot_success==1 || direct_success==1)){ result[E51AC_ARM_ORACLE_UNION*E51AC_FIELDS+E51AC_T0_SUCCESS]=result[E51AC_ARM_ORACLE_UNION*E51AC_FIELDS+E51AC_T0_SUCCESS]+1; }
            }
            if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
            t=t+1;
        }
        let arm:i32=0;
        while(arm<E51AC_ARMS){
            let s:i32=arm*E51AC_FIELDS; result[s+E51AC_EPISODES]=result[s+E51AC_EPISODES]+1;
            if(category==0){ result[s+E51AC_NO_UNIQUE]=result[s+E51AC_NO_UNIQUE]+1; }else{ result[s+E51AC_KNOWN]=result[s+E51AC_KNOWN]+1; }
            if(reached[arm]==1){
                result[s+E51AC_REACHABLE]=result[s+E51AC_REACHABLE]+1;
                mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1;
                resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1;
                if(category==0){ result[s+E51AC_NO_UNIQUE_REACHABLE]=result[s+E51AC_NO_UNIQUE_REACHABLE]+1;
                }else{ result[s+E51AC_KNOWN_REACHABLE]=result[s+E51AC_KNOWN_REACHABLE]+1; }
            }
            arm=arm+1;
        }
        let c:i32=category*E51AC_COMPLEMENT_FIELDS;
        complement[c+E51AC_COMP_EPISODES]=complement[c+E51AC_COMP_EPISODES]+1;
        if(slot_reached==1){ complement[c+E51AC_COMP_SLOT]=complement[c+E51AC_COMP_SLOT]+1; }
        if(direct_reached==1){ complement[c+E51AC_COMP_DIRECT]=complement[c+E51AC_COMP_DIRECT]+1; }
        if(slot_reached==1 || direct_reached==1){ complement[c+E51AC_COMP_UNION]=complement[c+E51AC_COMP_UNION]+1; }
        if(slot_reached==1 && direct_reached==1){ complement[c+E51AC_COMP_BOTH]=complement[c+E51AC_COMP_BOTH]+1; }
        if(slot_reached==1 && direct_reached==0){ complement[c+E51AC_COMP_SLOT_ONLY]=complement[c+E51AC_COMP_SLOT_ONLY]+1; }
        if(slot_reached==0 && direct_reached==1){ complement[c+E51AC_COMP_DIRECT_ONLY]=complement[c+E51AC_COMP_DIRECT_ONLY]+1; }
        if(slot_reached==0 && direct_reached==0){ complement[c+E51AC_COMP_NEITHER]=complement[c+E51AC_COMP_NEITHER]+1; }
        zfree(reached); zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible);
        episode=episode+1;
    }
}

fn e51ac_run(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32
)i32 {
    _zag_println("R32_E51AC_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51ac_additive_direct_candidate_hybrid_v1");
    _zag_println("claim_boundary,native_hybrid_action_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("mature_slot_controller_frozen=1");
    _zag_println("candidate_interface,generic_commit_candidate_index");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("unknown_learned_head=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let world_gate:i32=e51ac_world_gate();
    let terminal_hash_before:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);

    // Reconstruct the frozen E51AB local-384 candidate learner from stage 89.
    let dev_source:[]i32=zalloc_i(E51AB_DEV_SAMPLES*E50_RECORD_N); let dev_direct:[]i32=zalloc_i(E51AB_DEV_SAMPLES*E50_RECORD_N);
    let dev_t0:[]i32=zalloc_i(E51AB_DEV_SAMPLES); let dev_t1:[]i32=zalloc_i(E51AB_DEV_SAMPLES); let dev_pos:[]i32=zalloc_i(2); let dev_neg:[]i32=zalloc_i(2);
    e45_zero(dev_source,E51AB_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_direct,E51AB_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_t0,E51AB_DEV_SAMPLES); e45_zero(dev_t1,E51AB_DEV_SAMPLES);
    let dev_unknown:i32=0; let dev_built:i32=e51ab_build_partition(E51AB_STAGE_DEV,E51AB_DEV_EPISODES,48,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_source,dev_direct,dev_t0,dev_t1,dev_pos,dev_neg,&dev_unknown);
    zfree(dev_source);

    let g0:[]i32=zalloc_i(E45_FEATURES); let rg0:[]i32=zalloc_i(E45_FEATURES); let g1:[]i32=zalloc_i(E45_FEATURES); let rg1:[]i32=zalloc_i(E45_FEATURES);
    let b0:i32=0; let rb0:i32=0; let b1:i32=0; let rb1:i32=0;
    let s00:i32=0; let r00:i32=0; let h00:i32=0; let l00:i64=0; let s01:i32=0; let r01:i32=0; let h01:i32=0; let l01:i64=0;
    let s10:i32=0; let r10:i32=0; let h10:i32=0; let l10:i64=0; let s11:i32=0; let r11:i32=0; let h11:i32=0; let l11:i64=0;
    e51m_fit_scalar_linear(dev_direct,dev_t0,E51AB_DEV_SAMPLES,0,g0,0,&b0,&s00,&r00,&h00,&l00);
    e51m_fit_scalar_linear(dev_direct,dev_t0,E51AB_DEV_SAMPLES,1,rg0,0,&rb0,&s01,&r01,&h01,&l01);
    e51m_fit_scalar_linear(dev_direct,dev_t1,E51AB_DEV_SAMPLES,0,g1,0,&b1,&s10,&r10,&h10,&l10);
    e51m_fit_scalar_linear(dev_direct,dev_t1,E51AB_DEV_SAMPLES,1,rg1,0,&rb1,&s11,&r11,&h11,&l11);
    let gid0:i32=e51m_linear_identity(g0,0,b0,rg0,0,rb0,s00,s01,r00,r01,h00,h01,l00,l01);
    let gid1:i32=e51m_linear_identity(g1,0,b1,rg1,0,rb1,s10,s11,r10,r11,h10,h11,l10,l11);
    let global_identity:i32=0; if(gid0==1 && gid1==1){ global_identity=1; }

    let per_dose_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let per_dose_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
    let lw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_dose_w); let lb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_dose_b);
    let rlw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_dose_w); let rlb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_dose_b);
    e45_zero(lw,E51AB_LOCAL_DOSES*per_dose_w); e45_zero(lb,E51AB_LOCAL_DOSES*per_dose_b); e45_zero(rlw,E51AB_LOCAL_DOSES*per_dose_w); e45_zero(rlb,E51AB_LOCAL_DOSES*per_dose_b);
    let local_identity:i32=1; let local_nondegenerate:i32=1; let candidate:i32=0;
    while(candidate<E51AB_CANDIDATES){
        let targets:[]i32=dev_t0; let gw:[]i32=g0; let gb:i32=b0;
        if(candidate==1){ targets=dev_t1; gw=g1; gb=b1; }
        let ws:i32=1*per_dose_w+candidate*E51AB_CELLS*E45_FEATURES; let bs:i32=1*per_dose_b+candidate*E51AB_CELLS;
        let u0:i32=0; let sw0:i32=0; let re0:i32=0; let tr0:i32=0; let lo0:i64=0; let sg0:i32=0;
        let u1:i32=0; let sw1:i32=0; let re1:i32=0; let tr1:i32=0; let lo1:i64=0; let sg1:i32=0;
        e51x_fit_experts_dose(dev_direct,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,0,384,lw,ws,lb,bs,&u0,&sw0,&re0,&tr0,&lo0,&sg0);
        e51x_fit_experts_dose(dev_direct,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,1,384,rlw,ws,rlb,bs,&u1,&sw1,&re1,&tr1,&lo1,&sg1);
        let id:i32=e51p_expert_identity(lw,ws,lb,bs,rlw,ws,rlb,bs,E51AB_CELLS,u0,u1,sw0,sw1,re0,re1,tr0,tr1,lo0,lo1,sg0,sg1);
        if(id==0){ local_identity=0; } if(u0<=0){ local_nondegenerate=0; }
        _zag_print("e51ac_local384_fit,"); e45_print_i32(candidate); _zag_print(","); e45_print_i32(u0); _zag_print(","); e45_print_i32(sw0); _zag_print(","); e45_print_i32(re0); _zag_print(","); e45_print_i32(tr0); _zag_print(","); e45_print_i64(lo0); _zag_print(","); e45_print_i32(id); _zag_println("");
        candidate=candidate+1;
    }
    let terminal_hash_after_train:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let terminal_frozen_train:i32=0; if(terminal_hash_before==terminal_hash_after_train){ terminal_frozen_train=1; }
    let target_support:i32=0; if(dev_pos[0]>0 && dev_neg[0]>0 && dev_pos[1]>0 && dev_neg[1]>0){ target_support=1; }
    let training_integrity:i32=0;
    if(dev_built==E51AB_DEV_EPISODES && dev_unknown==0 && target_support==1 && global_identity==1 && local_identity==1 && local_nondegenerate==1 && terminal_frozen_train==1){ training_integrity=1; }
    e45_print_pair("e51ac_reconstructed_development_episodes",dev_built); e45_print_pair("e51ac_reconstructed_development_states",dev_built*(E45_TAPE+1));
    e45_print_pair("e51ac_global_identity_gate",global_identity); e45_print_pair("e51ac_local384_identity_gate",local_identity); e45_print_pair("e51ac_local384_nondegenerate_gate",local_nondegenerate);
    e45_print_pair("e51ac_terminal_frozen_after_train_gate",terminal_frozen_train); e45_print_pair("e51ac_training_integrity_gate",training_integrity);
    zfree(dev_direct); zfree(dev_t0); zfree(dev_t1); zfree(dev_pos); zfree(dev_neg);

    // Fresh stage-92 validation.
    let val_control:[]i32=zalloc_i(E51AC_VALIDATION_SAMPLES*E50_RECORD_N); let val_direct:[]i32=zalloc_i(E51AC_VALIDATION_SAMPLES*E50_RECORD_N);
    let val_t0:[]i32=zalloc_i(E51AC_VALIDATION_SAMPLES); let val_t1:[]i32=zalloc_i(E51AC_VALIDATION_SAMPLES); let val_pos:[]i32=zalloc_i(2); let val_neg:[]i32=zalloc_i(2);
    e45_zero(val_control,E51AC_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_direct,E51AC_VALIDATION_SAMPLES*E50_RECORD_N);
    let val_unknown:i32=0; let val_built:i32=e51ab_build_partition(E51AC_STAGE_VALIDATION,E51AC_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_control,val_direct,val_t0,val_t1,val_pos,val_neg,&val_unknown);
    let result:[]i32=zalloc_i(E51AC_ARMS*E51AC_FIELDS); let mode_reach:[]i32=zalloc_i(E51AC_ARMS*E45_MODES); let resource_reach:[]i32=zalloc_i(E51AC_ARMS*E45_RESOURCES); let complement:[]i32=zalloc_i(2*E51AC_COMPLEMENT_FIELDS);
    e51ac_eval_partition(E51AC_STAGE_VALIDATION,E51AC_VALIDATION_EPISODES,20,val_control,val_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,lw,lb,result,mode_reach,resource_reach,complement);
    _zag_println("e51ac_validation_columns,arm_0_slots_1_unknown_fallback_2_score_max_3_oracle_union,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong");
    let arm:i32=0;
    while(arm<E51AC_ARMS){
        _zag_print("e51ac_validation,"); e45_print_i32(arm); let k:i32=0;
        while(k<E51AC_FIELDS){ _zag_print(","); e45_print_i32(result[arm*E51AC_FIELDS+k]); k=k+1; }
        _zag_println(""); arm=arm+1;
    }
    _zag_println("e51ac_complement_columns,category_0_no_unique_1_known,episodes,slot_reachable,direct_reachable,union_reachable,both,slot_only,direct_only,neither");
    let category:i32=0;
    while(category<2){ _zag_print("e51ac_complement,"); e45_print_i32(category); let k:i32=0; while(k<E51AC_COMPLEMENT_FIELDS){ _zag_print(","); e45_print_i32(complement[category*E51AC_COMPLEMENT_FIELDS+k]); k=k+1; } _zag_println(""); category=category+1; }
    _zag_println("e51ac_validation_mode_columns,arm,mode,reachable_of_600"); arm=0;
    while(arm<E51AC_ARMS){ let m:i32=0; while(m<E45_MODES){ _zag_print("e51ac_validation_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(mode_reach[arm*E45_MODES+m]); _zag_println(""); m=m+1; } arm=arm+1; }
    _zag_println("e51ac_validation_resource_columns,arm,resource,reachable_of_1080"); arm=0;
    while(arm<E51AC_ARMS){ let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ac_validation_resource,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(resource_reach[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; } arm=arm+1; }

    let terminal_hash_after_validation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let terminal_frozen_validation:i32=0; if(terminal_hash_before==terminal_hash_after_validation){ terminal_frozen_validation=1; }
    let validation_integrity:i32=0; if(world_gate==1 && training_integrity==1 && val_built==E51AC_VALIDATION_EPISODES && val_unknown==0 && terminal_frozen_validation==1){ validation_integrity=1; }
    let winner:i32=-1; arm=E51AC_ARM_FALLBACK;
    while(arm<=E51AC_ARM_SCORE_MAX){
        let s:i32=arm*E51AC_FIELDS; let pass:i32=0;
        if(validation_integrity==1 && result[s+E51AC_KNOWN_REACHABLE]==4200 && result[s+E51AC_NO_UNIQUE_REACHABLE]==1200){ pass=1; if(winner<0){ winner=arm; } }
        _zag_print("e51ac_validation_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(pass); _zag_println(""); arm=arm+1;
    }
    e45_print_pair("e51ac_terminal_hash_before",terminal_hash_before); e45_print_pair("e51ac_terminal_hash_after_validation",terminal_hash_after_validation);
    e45_print_pair("e51ac_terminal_frozen_validation_gate",terminal_frozen_validation); e45_print_pair("e51ac_validation_integrity_gate",validation_integrity); e45_print_pair("e51ac_validation_winner_arm",winner);

    let confirmation_executed:i32=0; let confirmation_gate:i32=0;
    if(winner>=E51AC_ARM_FALLBACK){
        confirmation_executed=E51AC_CONFIRM_EPISODES;
        let con_control:[]i32=zalloc_i(E51AC_CONFIRM_SAMPLES*E50_RECORD_N); let con_direct:[]i32=zalloc_i(E51AC_CONFIRM_SAMPLES*E50_RECORD_N);
        let con_t0:[]i32=zalloc_i(E51AC_CONFIRM_SAMPLES); let con_t1:[]i32=zalloc_i(E51AC_CONFIRM_SAMPLES); let con_pos:[]i32=zalloc_i(2); let con_neg:[]i32=zalloc_i(2);
        e45_zero(con_control,E51AC_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_direct,E51AC_CONFIRM_SAMPLES*E50_RECORD_N);
        let con_unknown:i32=0; let con_built:i32=e51ab_build_partition(E51AC_STAGE_CONFIRM,E51AC_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,con_control,con_direct,con_t0,con_t1,con_pos,con_neg,&con_unknown);
        let con_result:[]i32=zalloc_i(E51AC_ARMS*E51AC_FIELDS); let con_mode:[]i32=zalloc_i(E51AC_ARMS*E45_MODES); let con_resource:[]i32=zalloc_i(E51AC_ARMS*E45_RESOURCES); let con_comp:[]i32=zalloc_i(2*E51AC_COMPLEMENT_FIELDS);
        e51ac_eval_partition(E51AC_STAGE_CONFIRM,E51AC_CONFIRM_EPISODES,40,con_control,con_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,lw,lb,con_result,con_mode,con_resource,con_comp);
        let s:i32=winner*E51AC_FIELDS;
        if(con_built==E51AC_CONFIRM_EPISODES && con_unknown==0 && con_result[s+E51AC_KNOWN_REACHABLE]==8400 && con_result[s+E51AC_NO_UNIQUE_REACHABLE]==2400){ confirmation_gate=1; }
        _zag_print("e51ac_confirmation,"); e45_print_i32(winner); let k:i32=0; while(k<E51AC_FIELDS){ _zag_print(","); e45_print_i32(con_result[s+k]); k=k+1; } _zag_println("");
        zfree(con_control); zfree(con_direct); zfree(con_t0); zfree(con_t1); zfree(con_pos); zfree(con_neg); zfree(con_result); zfree(con_mode); zfree(con_resource); zfree(con_comp);
    }
    e45_print_pair("e51ac_sealed_confirmation_allocated",E51AC_CONFIRM_EPISODES); e45_print_pair("e51ac_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51ac_confirmation_gate",confirmation_gate);

    let slot_known:i32=result[E51AC_ARM_SLOT*E51AC_FIELDS+E51AC_KNOWN_REACHABLE];
    let fallback_known:i32=result[E51AC_ARM_FALLBACK*E51AC_FIELDS+E51AC_KNOWN_REACHABLE];
    let score_known:i32=result[E51AC_ARM_SCORE_MAX*E51AC_FIELDS+E51AC_KNOWN_REACHABLE];
    let union_known:i32=result[E51AC_ARM_ORACLE_UNION*E51AC_FIELDS+E51AC_KNOWN_REACHABLE];
    let union_nu:i32=result[E51AC_ARM_ORACLE_UNION*E51AC_FIELDS+E51AC_NO_UNIQUE_REACHABLE];
    if(validation_integrity==0){ _zag_println("e51ac_outcome,INVALID_E51AC_INTEGRITY_FAILURE");
    }else{ if(confirmation_gate==1){ _zag_println("e51ac_outcome,ADDITIVE_DIRECT_CANDIDATE_HYBRID_CONFIRMED");
        }else{ if(winner>=E51AC_ARM_FALLBACK){ _zag_println("e51ac_outcome,ADDITIVE_DIRECT_CANDIDATE_HYBRID_VALIDATION_ONLY");
            }else{ if(union_known==4200 && union_nu==1200){ _zag_println("e51ac_outcome,DIRECT_CANDIDATE_COMPLEMENT_EXACT_ROUTING_REQUIRED");
                }else{ if(union_known>slot_known || fallback_known>slot_known || score_known>slot_known){ _zag_println("e51ac_outcome,DIRECT_CANDIDATE_COMPLEMENT_PARTIAL");
                    }else{ _zag_println("e51ac_outcome,NO_DIRECT_CANDIDATE_COMPLEMENT"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51AC_COMPLETE=1");

    zfree(val_control); zfree(val_direct); zfree(val_t0); zfree(val_t1); zfree(val_pos); zfree(val_neg); zfree(result); zfree(mode_reach); zfree(resource_reach); zfree(complement);
    zfree(g0); zfree(rg0); zfree(g1); zfree(rg1); zfree(lw); zfree(lb); zfree(rlw); zfree(rlb);
    if(validation_integrity==1){ return 1; } return 0;
}

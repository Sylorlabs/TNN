    // Untouched stage-98 validation. No model changes occur after this point.
    let val_control:[]i32=zalloc_i(E51AE_VALIDATION_SAMPLES*E50_RECORD_N); let val_direct:[]i32=zalloc_i(E51AE_VALIDATION_SAMPLES*E50_RECORD_N); let val_t0:[]i32=zalloc_i(E51AE_VALIDATION_SAMPLES); let val_t1:[]i32=zalloc_i(E51AE_VALIDATION_SAMPLES); let val_pos:[]i32=zalloc_i(2); let val_neg:[]i32=zalloc_i(2); let val_unknown:i32=0;
    e45_zero(val_control,E51AE_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_direct,E51AE_VALIDATION_SAMPLES*E50_RECORD_N); let val_built:i32=e51ab_build_partition(E51AE_STAGE_VALIDATION,E51AE_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_control,val_direct,val_t0,val_t1,val_pos,val_neg,&val_unknown); zfree(val_t0); zfree(val_t1); zfree(val_pos); zfree(val_neg);
    let val_result:[]i32=zalloc_i(E51AE_ARMS*E51AE_FIELDS); let val_mode:[]i32=zalloc_i(E51AE_ARMS*E45_MODES); let val_resource:[]i32=zalloc_i(E51AE_ARMS*E45_RESOURCES);
    e51ae_eval_partition(E51AE_STAGE_VALIDATION,E51AE_VALIDATION_EPISODES,20,-1,val_control,val_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,val_result,val_mode,val_resource);
    _zag_println("e51ae_validation_columns,arm,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong"); arm=0; while(arm<E51AE_ARMS){ e51ae_print_result("e51ae_validation",val_result,arm); arm=arm+1; }
    arm=0; while(arm<E51AE_ARMS){ let m:i32=0; while(m<E45_MODES){ _zag_print("e51ae_validation_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(val_mode[arm*E45_MODES+m]); _zag_println(""); m=m+1; } arm=arm+1; }
    arm=0; while(arm<E51AE_ARMS){ let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ae_validation_resource,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(val_resource[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; } arm=arm+1; }
    let winner:i32=-1; arm=E51AE_ARM_GLOBAL;
    while(arm<=E51AE_ARM_LOCAL_384){ let s:i32=arm*E51AE_FIELDS; let gate:i32=0; if(dev_gates[arm]==1 && val_result[s+E51AE_REACHABLE]==E51AE_VALIDATION_EPISODES && val_result[s+E51AE_KNOWN_REACHABLE]==4200 && val_result[s+E51AE_NO_UNIQUE_REACHABLE]==1200){ gate=1; if(winner<0){ winner=arm; } } _zag_print("e51ae_validation_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(gate); _zag_println(""); arm=arm+1; }
    let terminal_hash_after_validation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b); let direct_hash_after_validation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb); let frozen_validation_gate:i32=0; if(terminal_hash_after_validation==terminal_hash_before && direct_hash_after_validation==direct_hash_before){ frozen_validation_gate=1; }
    let validation_integrity:i32=0; if(pre_validation_integrity==1 && val_built==E51AE_VALIDATION_EPISODES && val_unknown==0 && frozen_validation_gate==1){ validation_integrity=1; }
    if(validation_integrity!=1){ winner=-1; }
    e45_print_pair("e51ae_validation_episodes_built",val_built); e45_print_pair("e51ae_validation_unknown_target_nonzero",val_unknown); e45_print_pair("e51ae_terminal_hash_after_validation",terminal_hash_after_validation); e45_print_pair("e51ae_direct_hash_after_validation",direct_hash_after_validation); e45_print_pair("e51ae_frozen_validation_gate",frozen_validation_gate); e45_print_pair("e51ae_validation_integrity_gate",validation_integrity); e45_print_pair("e51ae_validation_winner_arm",winner);

    // Sealed stage-99 confirmation executes only for the lowest-resource exact winner.
    e45_print_pair("e51ae_sealed_confirmation_allocated",E51AE_CONFIRM_EPISODES); let confirmation_executed:i32=0; let confirmation_exact:i32=0; let confirmation_integrity:i32=1;
    if(winner>=E51AE_ARM_GLOBAL){
        let conf_control:[]i32=zalloc_i(E51AE_CONFIRM_SAMPLES*E50_RECORD_N); let conf_direct:[]i32=zalloc_i(E51AE_CONFIRM_SAMPLES*E50_RECORD_N); let conf_t0:[]i32=zalloc_i(E51AE_CONFIRM_SAMPLES); let conf_t1:[]i32=zalloc_i(E51AE_CONFIRM_SAMPLES); let conf_pos:[]i32=zalloc_i(2); let conf_neg:[]i32=zalloc_i(2); let conf_unknown:i32=0;
        e45_zero(conf_control,E51AE_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(conf_direct,E51AE_CONFIRM_SAMPLES*E50_RECORD_N); let conf_built:i32=e51ab_build_partition(E51AE_STAGE_CONFIRM,E51AE_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,conf_control,conf_direct,conf_t0,conf_t1,conf_pos,conf_neg,&conf_unknown); zfree(conf_t0); zfree(conf_t1); zfree(conf_pos); zfree(conf_neg);
        let conf_result:[]i32=zalloc_i(E51AE_ARMS*E51AE_FIELDS); let conf_mode:[]i32=zalloc_i(E51AE_ARMS*E45_MODES); let conf_resource:[]i32=zalloc_i(E51AE_ARMS*E45_RESOURCES);
        e51ae_eval_partition(E51AE_STAGE_CONFIRM,E51AE_CONFIRM_EPISODES,40,winner,conf_control,conf_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,conf_result,conf_mode,conf_resource);
        confirmation_executed=E51AE_CONFIRM_EPISODES; e51ae_print_result("e51ae_confirmation",conf_result,winner); let cs:i32=winner*E51AE_FIELDS; if(conf_built!=E51AE_CONFIRM_EPISODES || conf_unknown!=0){ confirmation_integrity=0; } if(conf_built==E51AE_CONFIRM_EPISODES && conf_unknown==0 && conf_result[cs+E51AE_REACHABLE]==E51AE_CONFIRM_EPISODES && conf_result[cs+E51AE_KNOWN_REACHABLE]==8400 && conf_result[cs+E51AE_NO_UNIQUE_REACHABLE]==2400){ confirmation_exact=1; }
        let m:i32=0; while(m<E45_MODES){ _zag_print("e51ae_confirmation_mode,"); e45_print_i32(winner); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(conf_mode[winner*E45_MODES+m]); _zag_println(""); m=m+1; } let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ae_confirmation_resource,"); e45_print_i32(winner); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(conf_resource[winner*E45_RESOURCES+r]); _zag_println(""); r=r+1; }
        zfree(conf_control); zfree(conf_direct); zfree(conf_result); zfree(conf_mode); zfree(conf_resource);
    }
    e45_print_pair("e51ae_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51ae_confirmation_exact_gate",confirmation_exact);

    let terminal_hash_final:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b); let direct_hash_final:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb); let frozen_final_gate:i32=0; if(terminal_hash_final==terminal_hash_before && direct_hash_final==direct_hash_before){ frozen_final_gate=1; }
    let integrity:i32=0; if(validation_integrity==1 && confirmation_integrity==1 && frozen_final_gate==1){ integrity=1; }
    e45_print_pair("e51ae_frozen_final_gate",frozen_final_gate); e45_print_pair("e51ae_integrity_gate",integrity); e45_print_pair("e51ae_global_residual_parameter_count",2*(E45_FEATURES+1)); e45_print_pair("e51ae_local_residual_parameter_count_per_arm",E51AB_CANDIDATES*E51AE_CELLS*(E45_FEATURES+1));

    let outcome:i32=0;
    if(integrity!=1){ _zag_println("e51ae_outcome,INVALID_E51AE_INTEGRITY_FAILURE");
    }else{ if(winner>=E51AE_ARM_GLOBAL){ if(confirmation_exact==1){ _zag_println("e51ae_outcome,TRAJECTORY_CANDIDATE_RESIDUAL_CONFIRMED"); outcome=1; }else{ _zag_println("e51ae_outcome,TRAJECTORY_CANDIDATE_RESIDUAL_VALIDATION_ONLY"); }
        }else{
            let control:i32=val_result[E51AE_ARM_UNION_CONTROL*E51AE_FIELDS+E51AE_REACHABLE]; let partial:i32=0; arm=E51AE_ARM_GLOBAL; while(arm<=E51AE_ARM_LOCAL_384){ let s:i32=arm*E51AE_FIELDS; if(dev_gates[arm]==1 && val_result[s+E51AE_REACHABLE]>control){ partial=1; } arm=arm+1; }
            if(partial==1){ _zag_println("e51ae_outcome,TRAJECTORY_CANDIDATE_RESIDUAL_PARTIAL"); }else{ _zag_println("e51ae_outcome,TRAJECTORY_CANDIDATE_RESIDUAL_NO_RESCUE"); }
        }
    }
    _zag_println("TNN_R32_E51AE_EXECUTION_COMPLETE=1");

    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb); zfree(dev_control); zfree(dev_direct); zfree(slot_success); zfree(direct_success); zfree(base_kinds); zfree(accessible); zfree(kinds); zfree(zero_local); zfree(zero_local_b); zfree(res_g0); zfree(res_g1);
    zfree(local96_first); zfree(local96_first_b); zfree(local96_w); zfree(local96_b); zfree(rlocal96_first); zfree(rlocal96_first_b); zfree(rlocal96_w); zfree(rlocal96_b); zfree(local384_first); zfree(local384_first_b); zfree(local384_w); zfree(local384_b); zfree(rlocal384_first); zfree(rlocal384_first_b); zfree(rlocal384_w); zfree(rlocal384_b); zfree(dev_gates); zfree(val_control); zfree(val_direct); zfree(val_result); zfree(val_mode); zfree(val_resource);
    return outcome;
}

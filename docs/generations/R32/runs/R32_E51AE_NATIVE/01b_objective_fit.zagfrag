fn e51ae_dev_objective(
    control_records:[]i32,direct_records:[]i32,episodes:i32,accessible:[]i32,kinds:[]i32,union_count:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local_active:i32,local_weights:[]i32,local_biases:[]i32,
    preserved:*i32,rescued:*i32
)i64 {
    preserved.*=0; rescued.*=0; let margin_loss:i64=0; let episode:i32=0;
    while(episode<episodes){
        let kind:i32=kinds[episode]; let reached:i32=0; let best_margin:i32=-2000000000; let margin_found:i32=0; let t:i32=0;
        while(t<=E45_TAPE){
            let index:i32=episode*(E45_TAPE+1)+t;
            if(accessible[index]==1){
                let rs:i32=index*E50_RECORD_N;
                let choice:i32=e51ae_policy_choice(local_active,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,rg0,rb0,rg1,rb1,local_weights,local_biases);
                if(e51ac_choice_success(choice,control_records,direct_records,rs)==1){ reached=1; }
                if(kind==E51AE_KIND_NEITHER_KNOWN || kind==E51AE_KIND_NEITHER_NU){
                    let eligible:i32=1; if(kind==E51AE_KIND_NEITHER_KNOWN && e51ab_max_utility(direct_records,rs)<=0){ eligible=0; }
                    if(eligible==1){ let q0:i32=0; let q1:i32=0; e51ae_treatment_scores(local_active,direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,rg0,rb0,rg1,rb1,local_weights,local_biases,&q0,&q1); let margin:i32=e51ae_candidate_margin(q0,q1,direct_records,rs); if(margin_found==0 || margin>best_margin){ best_margin=margin; } margin_found=1; }
                }
            }
            t=t+1;
        }
        if(kind==E51AE_KIND_SLOT_COVERED || kind==E51AE_KIND_DIRECT_REQUIRED){ if(reached==1){ preserved.*=preserved.*+1; }
        }else{
            if(reached==1){ rescued.*=rescued.*+1; }
            if(margin_found==1 && best_margin<1){ let miss:i64=(1-best_margin) as i64; margin_loss=margin_loss+miss*miss; }
        }
        episode=episode+1;
    }
    if(preserved.*>union_count){ preserved.*=union_count; }
    return margin_loss;
}

fn e51ae_fit_local_dose(
    control_records:[]i32,direct_records:[]i32,episodes:i32,accessible:[]i32,direct_success:[]i32,kinds:[]i32,
    union_count:i32,neither_copies:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,
    reverse:i32,max_sweeps:i32,
    first_weights:[]i32,first_biases:[]i32,final_weights:[]i32,final_biases:[]i32,
    accepted_rounds:*i32,total_updates:*i32,total_sweeps:*i32,stop_reason:*i32,
    selection_trace:*i32,fit_trace:*i32,final_loss:*i64,strict_gate:*i32,final_preserve:*i32,final_rescue:*i32
)void {
    let model_w:i32=E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES; let model_b:i32=E51AB_CANDIDATES*E51AE_CELLS;
    let current_w:[]i32=zalloc_i(model_w); let current_b:[]i32=zalloc_i(model_b); e45_zero(current_w,model_w); e45_zero(current_b,model_b);
    e45_zero(first_weights,model_w); e45_zero(first_biases,model_b); e45_zero(final_weights,model_w); e45_zero(final_biases,model_b);
    let current_preserve:i32=0; let current_rescue:i32=0;
    let current_loss:i64=e51ae_dev_objective(control_records,direct_records,episodes,accessible,kinds,union_count,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,rg0,rb0,rg1,rb1,1,current_w,current_b,&current_preserve,&current_rescue);
    accepted_rounds.*=0; total_updates.*=0; total_sweeps.*=0; stop_reason.*=2; selection_trace.*=7201+max_sweeps; fit_trace.*=7301+max_sweeps; strict_gate.*=1;
    let round:i32=0;
    while(round<E51AE_MAX_ROUNDS){
        let critical_records:[]i32=zalloc_i(E51AE_MAX_CRITICAL*E50_RECORD_N); let t0:[]i32=zalloc_i(E51AE_MAX_CRITICAL); let t1:[]i32=zalloc_i(E51AE_MAX_CRITICAL); let support:[]i32=zalloc_i(6);
        let count:i32=0; let sel:i32=0;
        e51ae_select_critical(direct_records,episodes,accessible,direct_success,kinds,neither_copies,1,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,rg0,rb0,rg1,rb1,current_w,current_b,critical_records,t0,t1,&count,&sel,support);
        let candidate_w:[]i32=zalloc_i(model_w); let candidate_b:[]i32=zalloc_i(model_b); e45_zero(candidate_w,model_w); e45_zero(candidate_b,model_b);
        let updates_round:i32=0; let sweeps_round:i32=0; let strict_round:i32=1; let combined_trace:i32=7401+round; let combined_loss:i64=0; let c:i32=0;
        while(c<E51AB_CANDIDATES){
            let targets:[]i32=t0; let gw:[]i32=rg0; let gb:i32=rb0; if(c==1){ targets=t1; gw=rg1; gb=rb1; }
            let u:i32=0; let sw:i32=0; let reason:i32=0; let trace:i32=0; let loss:i64=0; let strict:i32=0;
            let ws:i32=c*E51AE_CELLS*E45_FEATURES; let bs:i32=c*E51AE_CELLS;
            e51x_fit_experts_dose(critical_records,targets,count,gw,gb,prototypes,parents,ranges,E51AE_CELLS,reverse,max_sweeps,candidate_w,ws,candidate_b,bs,&u,&sw,&reason,&trace,&loss,&strict);
            updates_round=updates_round+u; sweeps_round=sweeps_round+sw; if(strict!=1){ strict_round=0; }
            combined_trace=e46_hash_update(combined_trace,c); combined_trace=e46_hash_update(combined_trace,u); combined_trace=e46_hash_update(combined_trace,sw); combined_trace=e46_hash_update(combined_trace,reason); combined_trace=e46_hash_update(combined_trace,trace); combined_trace=e46_hash_update(combined_trace,e51m_hash_i64(loss)); combined_loss=combined_loss+loss;
            c=c+1;
        }
        let candidate_preserve:i32=0; let candidate_rescue:i32=0;
        let candidate_loss:i64=e51ae_dev_objective(control_records,direct_records,episodes,accessible,kinds,union_count,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,rg0,rb0,rg1,rb1,1,candidate_w,candidate_b,&candidate_preserve,&candidate_rescue);
        selection_trace.*=e46_hash_update(selection_trace.*,round); selection_trace.*=e46_hash_update(selection_trace.*,count); selection_trace.*=e46_hash_update(selection_trace.*,sel); let si:i32=0; while(si<6){ selection_trace.*=e46_hash_update(selection_trace.*,support[si]); si=si+1; }
        fit_trace.*=e46_hash_update(fit_trace.*,round); fit_trace.*=e46_hash_update(fit_trace.*,combined_trace); fit_trace.*=e46_hash_update(fit_trace.*,updates_round); fit_trace.*=e46_hash_update(fit_trace.*,sweeps_round); fit_trace.*=e46_hash_update(fit_trace.*,candidate_preserve); fit_trace.*=e46_hash_update(fit_trace.*,candidate_rescue); fit_trace.*=e46_hash_update(fit_trace.*,e51m_hash_i64(candidate_loss)); fit_trace.*=e46_hash_update(fit_trace.*,e51m_hash_i64(combined_loss));
        total_updates.*=total_updates.*+updates_round; total_sweeps.*=total_sweeps.*+sweeps_round; if(strict_round!=1){ strict_gate.*=0; }
        let accept:i32=0;
        if(candidate_preserve==union_count){ if(candidate_rescue>current_rescue){ accept=1; }else{ if(candidate_rescue==current_rescue && candidate_loss<current_loss){ accept=1; } } }
        if(accept==1){
            if(accepted_rounds.*==0){ let j:i32=0; while(j<model_w){ first_weights[j]=candidate_w[j]; j=j+1; } j=0; while(j<model_b){ first_biases[j]=candidate_b[j]; j=j+1; } }
            let j:i32=0; while(j<model_w){ current_w[j]=candidate_w[j]; j=j+1; } j=0; while(j<model_b){ current_b[j]=candidate_b[j]; j=j+1; }
            current_preserve=candidate_preserve; current_rescue=candidate_rescue; current_loss=candidate_loss; accepted_rounds.*=accepted_rounds.*+1;
        }else{ stop_reason.*=1; zfree(critical_records); zfree(t0); zfree(t1); zfree(support); zfree(candidate_w); zfree(candidate_b); break; }
        zfree(critical_records); zfree(t0); zfree(t1); zfree(support); zfree(candidate_w); zfree(candidate_b); round=round+1;
    }
    let j:i32=0; while(j<model_w){ final_weights[j]=current_w[j]; j=j+1; } j=0; while(j<model_b){ final_biases[j]=current_b[j]; j=j+1; }
    final_loss.*=current_loss; final_preserve.*=current_preserve; final_rescue.*=current_rescue;
    zfree(current_w); zfree(current_b);
}


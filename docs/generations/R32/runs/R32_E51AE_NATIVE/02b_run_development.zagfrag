    // Fresh stage-97 development partition and evaluator-only support classes.
    let dev_control:[]i32=zalloc_i(E51AE_DEV_SAMPLES*E50_RECORD_N); let dev_direct:[]i32=zalloc_i(E51AE_DEV_SAMPLES*E50_RECORD_N); let dev_t0:[]i32=zalloc_i(E51AE_DEV_SAMPLES); let dev_t1:[]i32=zalloc_i(E51AE_DEV_SAMPLES); let dev_pos:[]i32=zalloc_i(2); let dev_neg:[]i32=zalloc_i(2); let dev_unknown:i32=0;
    e45_zero(dev_control,E51AE_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_direct,E51AE_DEV_SAMPLES*E50_RECORD_N);
    let dev_built:i32=e51ab_build_partition(E51AE_STAGE_DEV,E51AE_DEV_EPISODES,48,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_control,dev_direct,dev_t0,dev_t1,dev_pos,dev_neg,&dev_unknown); zfree(dev_t0); zfree(dev_t1); zfree(dev_pos); zfree(dev_neg);
    let slot_success:[]i32=zalloc_i(E51AE_DEV_SAMPLES); let direct_success:[]i32=zalloc_i(E51AE_DEV_SAMPLES); let base_kinds:[]i32=zalloc_i(E51AE_DEV_EPISODES); let accessible:[]i32=zalloc_i(E51AE_DEV_SAMPLES);
    let base_slot:i32=0; let base_direct:i32=0; let base_neither:i32=0;
    e51ad_prepare_support(E51AE_STAGE_DEV,E51AE_DEV_EPISODES,48,dev_control,dev_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,slot_success,direct_success,base_kinds,&base_slot,&base_direct,&base_neither);
    e51ae_build_accessible(E51AE_STAGE_DEV,E51AE_DEV_EPISODES,48,accessible);
    let kinds:[]i32=zalloc_i(E51AE_DEV_EPISODES); let slot_count:i32=0; let direct_count:i32=0; let neither_known:i32=0; let neither_nu:i32=0;
    e51ae_classify_kinds(base_kinds,E51AE_DEV_EPISODES,48,kinds,&slot_count,&direct_count,&neither_known,&neither_nu);
    let neither_count:i32=neither_known+neither_nu; let union_count:i32=slot_count+direct_count; let copies:i32=1; if(neither_count>0 && direct_count>neither_count){ copies=(direct_count+neither_count-1)/neither_count; }
    let expected_critical:i32=direct_count+neither_count*copies; let support_gate:i32=0; if(union_count>0 && neither_count>0 && expected_critical<=E51AE_MAX_CRITICAL && slot_count+direct_count+neither_count==E51AE_DEV_EPISODES){ support_gate=1; }
    e45_print_pair("e51ae_development_episodes",dev_built); e45_print_pair("e51ae_development_states",dev_built*(E45_TAPE+1)); e45_print_pair("e51ae_slot_covered",slot_count); e45_print_pair("e51ae_direct_required",direct_count); e45_print_pair("e51ae_union_neither_known",neither_known); e45_print_pair("e51ae_union_neither_no_unique",neither_nu); e45_print_pair("e51ae_frozen_union_development",union_count); e45_print_pair("e51ae_neither_replication_factor",copies); e45_print_pair("e51ae_expected_critical_count",expected_critical); e45_print_pair("e51ae_support_gate",support_gate);

    // Initial zero-residual critical set and deterministic global residual heads.
    let zero_rg0:[]i32=zalloc_i(E45_FEATURES); let zero_rg1:[]i32=zalloc_i(E45_FEATURES); let zero_local:[]i32=zalloc_i(E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES); let zero_local_b:[]i32=zalloc_i(E51AB_CANDIDATES*E51AE_CELLS); e45_zero(zero_rg0,E45_FEATURES); e45_zero(zero_rg1,E45_FEATURES); e45_zero(zero_local,E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES); e45_zero(zero_local_b,E51AB_CANDIDATES*E51AE_CELLS);
    let critical:[]i32=zalloc_i(E51AE_MAX_CRITICAL*E50_RECORD_N); let ct0:[]i32=zalloc_i(E51AE_MAX_CRITICAL); let ct1:[]i32=zalloc_i(E51AE_MAX_CRITICAL); let csupport:[]i32=zalloc_i(6); let critical_count:i32=0; let critical_trace:i32=0;
    e51ae_select_critical(dev_direct,E51AE_DEV_EPISODES,accessible,direct_success,kinds,copies,0,g0,b0,g1,b1,prototypes,parents,ranges,direct_lw,direct_lb,zero_rg0,0,zero_rg1,0,zero_local,zero_local_b,critical,ct0,ct1,&critical_count,&critical_trace,csupport);
    let critical_hash:i32=e51ae_critical_hash(critical,ct0,ct1,critical_count); let record_isolation:i32=e51ae_record_isolation(critical,critical_count);
    let res_g0:[]i32=zalloc_i(E45_FEATURES); let res_rg0:[]i32=zalloc_i(E45_FEATURES); let res_g1:[]i32=zalloc_i(E45_FEATURES); let res_rg1:[]i32=zalloc_i(E45_FEATURES); let res_b0:i32=0; let res_rb0:i32=0; let res_b1:i32=0; let res_rb1:i32=0;
    let s00:i32=0; let r00:i32=0; let h00:i32=0; let l00:i64=0; let s01:i32=0; let r01:i32=0; let h01:i32=0; let l01:i64=0; let s10:i32=0; let r10:i32=0; let h10:i32=0; let l10:i64=0; let s11:i32=0; let r11:i32=0; let h11:i32=0; let l11:i64=0;
    e51m_fit_scalar_linear(critical,ct0,critical_count,0,res_g0,0,&res_b0,&s00,&r00,&h00,&l00); e51m_fit_scalar_linear(critical,ct0,critical_count,1,res_rg0,0,&res_rb0,&s01,&r01,&h01,&l01);
    e51m_fit_scalar_linear(critical,ct1,critical_count,0,res_g1,0,&res_b1,&s10,&r10,&h10,&l10); e51m_fit_scalar_linear(critical,ct1,critical_count,1,res_rg1,0,&res_rb1,&s11,&r11,&h11,&l11);
    let rid0:i32=e51m_linear_identity(res_g0,0,res_b0,res_rg0,0,res_rb0,s00,s01,r00,r01,h00,h01,l00,l01); let rid1:i32=e51m_linear_identity(res_g1,0,res_b1,res_rg1,0,res_rb1,s10,s11,r10,r11,h10,h11,l10,l11); let global_identity:i32=0; if(rid0==1 && rid1==1){ global_identity=1; }
    _zag_print("e51ae_global_critical,"); e45_print_i32(critical_count); _zag_print(","); e45_print_i32(critical_trace); _zag_print(","); e45_print_i32(critical_hash); _zag_print(","); e45_print_i32(record_isolation); let sp:i32=0; while(sp<6){ _zag_print(","); e45_print_i32(csupport[sp]); sp=sp+1; } _zag_println("");
    _zag_print("e51ae_global_fit,0,"); e45_print_i32(s00); _zag_print(","); e45_print_i32(r00); _zag_print(","); e45_print_i32(h00); _zag_print(","); e45_print_i64(l00); _zag_print(","); e45_print_i32(rid0); _zag_println("");
    _zag_print("e51ae_global_fit,1,"); e45_print_i32(s10); _zag_print(","); e45_print_i32(r10); _zag_print(","); e45_print_i32(h10); _zag_print(","); e45_print_i64(l10); _zag_print(","); e45_print_i32(rid1); _zag_println("");
    e45_print_pair("e51ae_global_identity_gate",global_identity); e45_print_pair("e51ae_critical_record_isolation_gate",record_isolation);
    zfree(res_rg0); zfree(res_rg1); zfree(critical); zfree(ct0); zfree(ct1); zfree(csupport); zfree(zero_rg0); zfree(zero_rg1);

    let global_preserve:i32=0; let global_rescue:i32=0; let global_margin_loss:i64=e51ae_dev_objective(dev_control,dev_direct,E51AE_DEV_EPISODES,accessible,kinds,union_count,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,0,zero_local,zero_local_b,&global_preserve,&global_rescue);
    let global_development_gate:i32=0; if(global_preserve==union_count){ global_development_gate=1; }
    _zag_print("e51ae_development_arm,1,"); e45_print_i32(global_preserve); _zag_print(","); e45_print_i32(global_rescue); _zag_print(","); e45_print_i64(global_margin_loss); _zag_print(","); e45_print_i32(global_development_gate); _zag_println("");


// R32 E51AB — generic direct candidate commit action support.
// Belief-state maintenance is unchanged. Candidate indices are generic members
// of the existing hypothesis set; evaluator truth is used only for grounded
// consequence targets and never enters learner inference.

const E51AB_STAGE_DEV:i32=89;
const E51AB_STAGE_VALIDATION:i32=90;
const E51AB_STAGE_CONFIRM:i32=91;
const E51AB_PREVIOUS_STAGE:i32=88;
const E51AB_DEV_EPISODES:i32=12960;
const E51AB_DEV_SAMPLES:i32=220320;
const E51AB_VALIDATION_EPISODES:i32=5400;
const E51AB_VALIDATION_SAMPLES:i32=91800;
const E51AB_CONFIRM_EPISODES:i32=10800;
const E51AB_CONFIRM_SAMPLES:i32=183600;
const E51AB_CANDIDATES:i32=2;
const E51AB_CELLS:i32=32;
const E51AB_ARMS:i32=4;
const E51AB_LOCAL_DOSES:i32=2;
const E51AB_R_FIELDS:i32=9;
const E51AB_R_EPISODES:i32=0;
const E51AB_R_REACHABLE:i32=1;
const E51AB_R_KNOWN:i32=2;
const E51AB_R_KNOWN_REACHABLE:i32=3;
const E51AB_R_NU:i32=4;
const E51AB_R_NU_REACHABLE:i32=5;
const E51AB_R_T0_SUCCESS:i32=6;
const E51AB_R_T0_UNKNOWN:i32=7;
const E51AB_R_T0_WRONG:i32=8;

fn e51ab_candidate_value(candidate:i32,grounded_outcome:i32)i32 {
    if(grounded_outcome<0){ return -1200; }
    if(candidate==grounded_outcome){ return 1000; }
    return -2000;
}

fn e51ab_world_gate()i32 {
    let prev_hi:i32=e51n_world_id(E51AB_PREVIOUS_STAGE,E51AB_VALIDATION_EPISODES-1);
    let dlo:i32=e51n_world_id(E51AB_STAGE_DEV,0); let dhi:i32=e51n_world_id(E51AB_STAGE_DEV,E51AB_DEV_EPISODES-1);
    let vlo:i32=e51n_world_id(E51AB_STAGE_VALIDATION,0); let vhi:i32=e51n_world_id(E51AB_STAGE_VALIDATION,E51AB_VALIDATION_EPISODES-1);
    let clo:i32=e51n_world_id(E51AB_STAGE_CONFIRM,0); let chi:i32=e51n_world_id(E51AB_STAGE_CONFIRM,E51AB_CONFIRM_EPISODES-1);
    let partition:i32=0; if(prev_hi<dlo && dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d); if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o); if(!(hi<olo || ohi<lo)){ domains=0; } o=o+1; }
        d=d+1;
    }
    e45_print_pair("e51ab_world_id_dev_lo",dlo); e45_print_pair("e51ab_world_id_dev_hi",dhi);
    e45_print_pair("e51ab_world_id_validation_lo",vlo); e45_print_pair("e51ab_world_id_validation_hi",vhi);
    e45_print_pair("e51ab_world_id_confirmation_lo",clo); e45_print_pair("e51ab_world_id_confirmation_hi",chi);
    e45_print_pair("e51ab_world_partition_gate",partition); e45_print_pair("e51ab_domain_gate",domains); e45_print_pair("e51ab_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51ab_convert_episode(
    source_records:[]i32,direct_records:[]i32,episode:i32,world_id:i32,mode:i32,
    target0:[]i32,target1:[]i32,positive:[]i32,negative:[]i32
)void {
    let truth:[]i32=zalloc_i(E45_TAPE+1); let historical:i32=R32E45_UNKNOWN;
    e51n_make_truth(world_id,mode,truth,&historical);
    let t:i32=0;
    while(t<=E45_TAPE){
        let index:i32=episode*(E45_TAPE+1)+t; let src:i32=index*E50_RECORD_N; let dst:i32=src;
        let k:i32=0; while(k<E50_RECORD_N){ direct_records[dst+k]=source_records[src+k]; k=k+1; }
        let v0:i32=e51ab_candidate_value(0,truth[t]); let v1:i32=e51ab_candidate_value(1,truth[t]);
        direct_records[dst+34]=v0; direct_records[dst+35]=v1; direct_records[dst+36]=0; direct_records[dst+37]=0;
        target0[index]=v0; target1[index]=v1;
        if(v0>0){ positive[0]=positive[0]+1; }else{ if(v0<0){ negative[0]=negative[0]+1; } }
        if(v1>0){ positive[1]=positive[1]+1; }else{ if(v1<0){ negative[1]=negative[1]+1; } }
        t=t+1;
    }
    zfree(truth);
}

fn e51ab_build_partition(
    stage:i32,episodes:i32,per_cell:i32,
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    source_records:[]i32,direct_records:[]i32,target0:[]i32,target1:[]i32,
    positive:[]i32,negative:[]i32,unknown_nonzero:*i32
)i32 {
    e45_zero(positive,E51AB_CANDIDATES); e45_zero(negative,E51AB_CANDIDATES);
    let dummy:[]i32=zalloc_i(episodes*(E45_TAPE+1)*E50_RECORD_N); e45_zero(dummy,episodes*(E45_TAPE+1)*E50_RECORD_N);
    let cp:i32=0; let cn:i32=0; let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let world:i32=e51n_world_id(stage,episode);
        e51e_build_training_episode(world,mode,resource,episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,source_records,dummy,unknown_nonzero,&cp,&cn);
        e51ab_convert_episode(source_records,direct_records,episode,world,mode,target0,target1,positive,negative);
        episode=episode+1;
    }
    zfree(dummy); return episode;
}

fn e51ab_copy_action_global(all_weights:[]i32,all_biases:[]i32,candidate:i32,out_weights:[]i32,out_bias:*i32)void {
    let f:i32=0; while(f<E45_FEATURES){ out_weights[f]=all_weights[candidate*E45_FEATURES+f]; f=f+1; }
    out_bias.*=all_biases[candidate];
}

fn e51ab_global_score(records:[]i32,record_start:i32,weights:[]i32,bias:i32)i32 {
    return e51m_linear_scalar_predict(records,record_start,weights,0,bias);
}

fn e51ab_choose(q0:i32,q1:i32)i32 {
    let choice:i32=0; let best:i32=q0;
    if(q1>best){ choice=1; best=q1; }
    if(0>best){ choice=R32E45_TERM_UNKNOWN; }
    return choice;
}

fn e51ab_direct_choice(
    arm:i32,records:[]i32,record_start:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    local_weights:[]i32,local_biases:[]i32
)i32 {
    let q0:i32=e51ab_global_score(records,record_start,g0,b0); let q1:i32=e51ab_global_score(records,record_start,g1,b1);
    if(arm>=2){
        let dose:i32=arm-2; let per_dose_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let per_dose_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
        let wbase:i32=dose*per_dose_w; let bbase:i32=dose*per_dose_b;
        q0=e51p_expert_predict(records,record_start,g0,b0,prototypes,parents,ranges,E51AB_CELLS,local_weights,wbase+0*E51AB_CELLS*E45_FEATURES,local_biases,bbase+0*E51AB_CELLS);
        q1=e51p_expert_predict(records,record_start,g1,b1,prototypes,parents,ranges,E51AB_CELLS,local_weights,wbase+1*E51AB_CELLS*E45_FEATURES,local_biases,bbase+1*E51AB_CELLS);
    }
    return e51ab_choose(q0,q1);
}

fn e51ab_direct_utility(records:[]i32,record_start:i32,choice:i32)i32 {
    if(choice==R32E45_TERM_UNKNOWN){ return 0; }
    return records[record_start+34+choice];
}

fn e51ab_max_utility(records:[]i32,record_start:i32)i32 {
    let best:i32=0; if(records[record_start+34]>best){ best=records[record_start+34]; } if(records[record_start+35]>best){ best=records[record_start+35]; } return best;
}

fn e51ab_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,active_arm:i32,
    control_records:[]i32,direct_records:[]i32,
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,term_prototypes:[]i32,term_parents:[]i32,term_ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,local_weights:[]i32,local_biases:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32
)void {
    e45_zero(result,E51AB_ARMS*E51AB_R_FIELDS); e45_zero(mode_reach,E51AB_ARMS*E45_MODES); e45_zero(resource_reach,E51AB_ARMS*E45_RESOURCES);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0; e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost); e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let arm_lo:i32=0; let arm_hi:i32=E51AB_ARMS; if(active_arm>=0){ arm_lo=active_arm; arm_hi=active_arm+1; }
        let arm:i32=arm_lo;
        while(arm<arm_hi){
            let s:i32=arm*E51AB_R_FIELDS; result[s+E51AB_R_EPISODES]=result[s+E51AB_R_EPISODES]+1; if(no_unique==1){ result[s+E51AB_R_NU]=result[s+E51AB_R_NU]+1; }else{ result[s+E51AB_R_KNOWN]=result[s+E51AB_R_KNOWN]+1; }
            let reachable:i32=0; let accessible:i32=1; let t:i32=0;
            while(t<=E45_TAPE){
                if(accessible==1){
                    let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N; let choice:i32=0; let utility:i32=0; let success:i32=0;
                    if(arm==0){
                        choice=e51y_terminal_choice(control_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,term_prototypes,term_parents,term_ranges,term_expert_w,term_expert_b);
                        utility=control_records[rs+34+choice]; let best:i32=control_records[rs+34]; let a:i32=1; while(a<4){ if(control_records[rs+34+a]>best){ best=control_records[rs+34+a]; } a=a+1; } if(utility==best){ success=1; }
                    }else{
                        choice=e51ab_direct_choice(arm,direct_records,rs,g0,b0,g1,b1,term_prototypes,term_parents,term_ranges,local_weights,local_biases); utility=e51ab_direct_utility(direct_records,rs,choice); if(utility==e51ab_max_utility(direct_records,rs)){ success=1; }
                    }
                    if(t==0){ if(success==1){ result[s+E51AB_R_T0_SUCCESS]=result[s+E51AB_R_T0_SUCCESS]+1; }else{ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AB_R_T0_UNKNOWN]=result[s+E51AB_R_T0_UNKNOWN]+1; }else{ result[s+E51AB_R_T0_WRONG]=result[s+E51AB_R_T0_WRONG]+1; } } }
                    if(success==1){ reachable=1; }
                }
                if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
                t=t+1;
            }
            if(reachable==1){ result[s+E51AB_R_REACHABLE]=result[s+E51AB_R_REACHABLE]+1; mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1; resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1; if(no_unique==1){ result[s+E51AB_R_NU_REACHABLE]=result[s+E51AB_R_NU_REACHABLE]+1; }else{ result[s+E51AB_R_KNOWN_REACHABLE]=result[s+E51AB_R_KNOWN_REACHABLE]+1; } }
            arm=arm+1;
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible); episode=episode+1;
    }
}

fn e51ab_value_audit(
    records:[]i32,target0:[]i32,target1:[]i32,count:i32,arm:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,local_weights:[]i32,local_biases:[]i32,
    sign_correct:[]i32,sign_total:[]i32,abs_error:*i64
)void {
    sign_correct[0]=0; sign_correct[1]=0; sign_total[0]=0; sign_total[1]=0; abs_error.*=0; let i:i32=0;
    while(i<count){ let rs:i32=i*E50_RECORD_N; let p0:i32=e51ab_global_score(records,rs,g0,b0); let p1:i32=e51ab_global_score(records,rs,g1,b1);
        if(arm>=2){ let dose:i32=arm-2; let pw:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES; let pb:i32=E51AB_CANDIDATES*E51AB_CELLS; let wb:i32=dose*pw; let bb:i32=dose*pb; p0=e51p_expert_predict(records,rs,g0,b0,prototypes,parents,ranges,E51AB_CELLS,local_weights,wb,local_biases,bb); p1=e51p_expert_predict(records,rs,g1,b1,prototypes,parents,ranges,E51AB_CELLS,local_weights,wb+E51AB_CELLS*E45_FEATURES,local_biases,bb+E51AB_CELLS); }
        let pred:i32=p0; let target:i32=target0[i]; sign_total[0]=sign_total[0]+1; if((target>0 && pred>0) || (target<0 && pred<0)){ sign_correct[0]=sign_correct[0]+1; } abs_error.*=abs_error.*+(r32e45_abs(target-pred) as i64);
        pred=p1; target=target1[i]; sign_total[1]=sign_total[1]+1; if((target>0 && pred>0) || (target<0 && pred<0)){ sign_correct[1]=sign_correct[1]+1; } abs_error.*=abs_error.*+(r32e45_abs(target-pred) as i64); i=i+1; }
}

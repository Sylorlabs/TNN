fn e51m_count_support(records:[]i32,sample_n:i32,positive:*i32,negative:*i32,neutral:*i32)void {
    positive.*=0; negative.*=0; neutral.*=0;
    let record:i32=0;
    while(record<sample_n){
        let target:i32=records[record*E51M_SCALAR_RECORD_N+32];
        if(target>0){ positive.*=positive.*+1; }
        if(target<0){ negative.*=negative.*+1; }
        if(target==0){ neutral.*=neutral.*+1; }
        record=record+1;
    }
}

fn e51m_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51M_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51m_calibration_dose_capacity_curve_v1");
    _zag_println("native_language,zag_v2");
    _zag_println("canonical_status,r27_unchanged");
    _zag_println("epistemic_isolation=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_score_fixed_zero=1");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let dev_seeds:[]i32=zalloc_i(E51M_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
    let terminal_records:[]i32=zalloc_i(E51M_DEV_SAMPLES*E50_RECORD_N);
    let continue_records:[]i32=zalloc_i(E51M_DEV_SAMPLES*E50_RECORD_N);
    let scalar_records:[]i32=zalloc_i(E51M_DEV_SAMPLES*E51M_SCALAR_RECORD_N);

    let base_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let base_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let forward_copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let forward_copy_biases:[]i32=zalloc_i(E51E_MODELS*4);

    let scalar_weights:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let scalar_biases:[]i32=zalloc_i(E51M_DOSES);
    let hinge_features:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_directions:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_means:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_coefficients:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_accepted:[]i32=zalloc_i(E51M_DOSES);
    let dose_positive:[]i32=zalloc_i(E51M_DOSES);
    let dose_negative:[]i32=zalloc_i(E51M_DOSES);
    let dose_neutral:[]i32=zalloc_i(E51M_DOSES);
    let dev_sign:[]i32=zalloc_i(E51M_ARMS*4);
    let val_sign:[]i32=zalloc_i(E51M_ARMS*4);
    let known_reach:[]i32=zalloc_i(E51M_ARMS);
    let no_unique_reach:[]i32=zalloc_i(E51M_ARMS);

    e45_zero(terminal_records,E51M_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(continue_records,E51M_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(scalar_records,E51M_DEV_SAMPLES*E51M_SCALAR_RECORD_N);
    e45_zero(base_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(base_biases,E51E_MODELS*4);
    e45_zero(scalar_weights,E51M_DOSES*E45_FEATURES); e45_zero(scalar_biases,E51M_DOSES);
    e45_zero(hinge_features,E51M_DOSES*E51M_HINGE_MAX); e45_zero(hinge_directions,E51M_DOSES*E51M_HINGE_MAX);
    e45_zero(hinge_means,E51M_DOSES*E51M_HINGE_MAX); e45_zero(hinge_coefficients,E51M_DOSES*E51M_HINGE_MAX); e45_zero(hinge_accepted,E51M_DOSES);
    e45_zero(dose_positive,E51M_DOSES); e45_zero(dose_negative,E51M_DOSES); e45_zero(dose_neutral,E51M_DOSES);
    e45_zero(dev_sign,E51M_ARMS*4); e45_zero(val_sign,E51M_ARMS*4); e45_zero(known_reach,E51M_ARMS); e45_zero(no_unique_reach,E51M_ARMS);

    let seed_gate:i32=e51m_allocate_seeds(raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds);
    let dev_unknown_nonzero:i32=0;
    let dev_built:i32=e51m_build_episode_set(
        dev_seeds,4,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        terminal_records,continue_records,&dev_unknown_nonzero
    );
    e45_print_pair("e51m_development_built",dev_built);
    e45_print_pair("e51m_development_samples",dev_built*(E45_TAPE+1));
    e45_print_pair("e51m_development_unknown_target_nonzero",dev_unknown_nonzero);

    let base_fit_gate:i32=e51e_fit_model(
        terminal_records,0,0,base_weights,base_biases,
        backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
        forward_copy_weights,forward_copy_biases
    );
    let base_unknown_gate:i32=e51m_unknown_zero(base_weights,base_biases);
    e45_print_pair("e51m_base_terminal_fit_identity_gate",base_fit_gate);
    e45_print_pair("e51m_base_unknown_zero_gate",base_unknown_gate);

    let all_positive:i32=0; let all_negative:i32=0; let all_neutral:i32=0;
    e51m_build_scalar_records(
        terminal_records,E51M_DEV_SAMPLES,base_weights,base_biases,scalar_records,
        &all_positive,&all_negative,&all_neutral
    );
    e45_print_pair("e51m_max_dev_positive_targets",all_positive);
    e45_print_pair("e51m_max_dev_negative_targets",all_negative);
    e45_print_pair("e51m_max_dev_neutral_targets",all_neutral);

    let scalar_identity_gate:i32=1;
    let hinge_identity_gate:i32=1;
    let target_support_gate:i32=1;
    let dose:i32=0;
    while(dose<E51M_DOSES){
        let sample_n:i32=e51m_dose_samples(dose);
        e51m_count_support(scalar_records,sample_n,&dose_positive[dose],&dose_negative[dose],&dose_neutral[dose]);
        if(dose_positive[dose]<=0 || dose_negative[dose]<=0){ target_support_gate=0; }
        let sg:i32=e51m_fit_scalar_identity(scalar_records,sample_n,dose,scalar_weights,dose*E45_FEATURES,&scalar_biases[dose]);
        if(sg==0){ scalar_identity_gate=0; }
        let hg:i32=e51m_fit_hinges_identity(
            scalar_records,sample_n,dose,scalar_weights,dose*E45_FEATURES,scalar_biases[dose],
            hinge_features,dose*E51M_HINGE_MAX,hinge_directions,hinge_means,hinge_coefficients,&hinge_accepted[dose]
        );
        if(hg==0){ hinge_identity_gate=0; }
        _zag_print("e51m_dose_support,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(sample_n); _zag_print(","); e45_print_i32(dose_positive[dose]); _zag_print(","); e45_print_i32(dose_negative[dose]); _zag_print(","); e45_print_i32(dose_neutral[dose]); _zag_print(","); e45_print_i32(hinge_accepted[dose]); _zag_println("");
        let cap:i32=0;
        while(cap<E51M_CAPS){
            let requested:i32=e51m_cap_terms(cap); let prefix:i32=requested; if(prefix>hinge_accepted[dose]){ prefix=hinge_accepted[dose]; }
            let arm:i32=dose*E51M_CAPS+cap;
            e51m_sign_metrics(
                scalar_records,sample_n,scalar_weights,dose*E45_FEATURES,scalar_biases[dose],
                hinge_features,dose*E51M_HINGE_MAX,hinge_directions,hinge_means,hinge_coefficients,prefix,
                dev_sign,arm*4
            );
            cap=cap+1;
        }
        dose=dose+1;
    }
    e45_print_pair("e51m_scalar_identity_gate",scalar_identity_gate);
    e45_print_pair("e51m_hinge_identity_gate",hinge_identity_gate);
    e45_print_pair("e51m_target_support_gate",target_support_gate);

    _zag_println("e51m_development_sign_columns,dose,capacity_requested,capacity_effective,positive_n,positive_correct,negative_n,negative_correct");
    dose=0;
    while(dose<E51M_DOSES){
        let cap:i32=0;
        while(cap<E51M_CAPS){
            let requested:i32=e51m_cap_terms(cap); let prefix:i32=requested; if(prefix>hinge_accepted[dose]){ prefix=hinge_accepted[dose]; }
            let arm:i32=dose*E51M_CAPS+cap; let m:i32=arm*4;
            _zag_print("e51m_development_sign,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(requested); _zag_print(","); e45_print_i32(prefix); _zag_print(",");
            e45_print_i32(dev_sign[m]); _zag_print(","); e45_print_i32(dev_sign[m+1]); _zag_print(","); e45_print_i32(dev_sign[m+2]); _zag_print(","); e45_print_i32(dev_sign[m+3]); _zag_println("");
            cap=cap+1;
        }
        dose=dose+1;
    }

    let val_unknown_nonzero:i32=0;
    let val_built:i32=e51m_build_validation_set(
        validation_seeds,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        terminal_records,continue_records,&val_unknown_nonzero
    );
    let val_positive:i32=0; let val_negative:i32=0; let val_neutral:i32=0;
    e51m_build_scalar_records(
        terminal_records,E51M_VALIDATION_SAMPLES,base_weights,base_biases,scalar_records,
        &val_positive,&val_negative,&val_neutral
    );
    e45_print_pair("e51m_validation_built",val_built);
    e45_print_pair("e51m_validation_samples",val_built*(E45_TAPE+1));
    e45_print_pair("e51m_validation_unknown_target_nonzero",val_unknown_nonzero);
    e45_print_pair("e51m_validation_positive_targets",val_positive);
    e45_print_pair("e51m_validation_negative_targets",val_negative);

    let base_known:i32=0; let base_no_unique:i32=0; let known_total:i32=0; let no_unique_total:i32=0;
    e51m_validation_evaluate(
        terminal_records,scalar_records,base_weights,base_biases,
        scalar_weights,scalar_biases,hinge_features,hinge_directions,hinge_means,hinge_coefficients,hinge_accepted,
        known_reach,no_unique_reach,val_sign,&base_known,&base_no_unique,&known_total,&no_unique_total
    );
    _zag_print("e51m_base_validation_reachability,"); e45_print_i32(known_total); _zag_print(","); e45_print_i32(base_known); _zag_print(","); e45_print_i32(no_unique_total); _zag_print(","); e45_print_i32(base_no_unique); _zag_println("");
    _zag_println("e51m_validation_columns,arm,dose,capacity_requested,capacity_effective,known_reachable,no_unique_unknown_reachable,positive_n,positive_correct,negative_n,negative_correct");
    let arm:i32=0;
    while(arm<E51M_ARMS){
        let d:i32=arm/E51M_CAPS; let cap:i32=arm-d*E51M_CAPS; let requested:i32=e51m_cap_terms(cap); let prefix:i32=requested; if(prefix>hinge_accepted[d]){ prefix=hinge_accepted[d]; }
        let m:i32=arm*4;
        _zag_print("e51m_validation,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(d); _zag_print(","); e45_print_i32(requested); _zag_print(","); e45_print_i32(prefix); _zag_print(",");
        e45_print_i32(known_reach[arm]); _zag_print(","); e45_print_i32(no_unique_reach[arm]); _zag_print(",");
        e45_print_i32(val_sign[m]); _zag_print(","); e45_print_i32(val_sign[m+1]); _zag_print(","); e45_print_i32(val_sign[m+2]); _zag_print(","); e45_print_i32(val_sign[m+3]); _zag_println("");
        arm=arm+1;
    }

    let partition_gate:i32=0;
    if(dev_built==E51M_DEV_EPISODES && val_built==E51M_VALIDATION_EPISODES && known_total==4200 && no_unique_total==1200 && dev_unknown_nonzero==0 && val_unknown_nonzero==0){ partition_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate==1 && partition_gate==1 && base_fit_gate==1 && base_unknown_gate==1 && scalar_identity_gate==1 && hinge_identity_gate==1 && target_support_gate==1){ integrity_gate=1; }

    let exact_gate:i32=0; let winning_arm:i32=-1;
    arm=0;
    while(arm<E51M_ARMS){
        if(known_reach[arm]==known_total && no_unique_reach[arm]==no_unique_total && exact_gate==0){ exact_gate=1; winning_arm=arm; }
        arm=arm+1;
    }
    let dose_signal:i32=0;
    let cap:i32=0;
    while(cap<E51M_CAPS){
        let higher:i32=1;
        while(higher<E51M_DOSES){
            let low:i32=(higher-1)*E51M_CAPS+cap; let high:i32=higher*E51M_CAPS+cap;
            if(known_reach[high]>=known_reach[low] && no_unique_reach[high]>=no_unique_reach[low] && (known_reach[high]>known_reach[low] || no_unique_reach[high]>no_unique_reach[low])){ dose_signal=1; }
            higher=higher+1;
        }
        cap=cap+1;
    }
    let capacity_signal:i32=0;
    dose=0;
    while(dose<E51M_DOSES){
        let higher_cap:i32=1;
        while(higher_cap<E51M_CAPS){
            let low:i32=dose*E51M_CAPS+higher_cap-1; let high:i32=dose*E51M_CAPS+higher_cap;
            if(known_reach[high]>=known_reach[low] && no_unique_reach[high]>=no_unique_reach[low] && (known_reach[high]>known_reach[low] || no_unique_reach[high]>no_unique_reach[low])){ capacity_signal=1; }
            higher_cap=higher_cap+1;
        }
        dose=dose+1;
    }
    e45_print_pair("e51m_partition_gate",partition_gate);
    e45_print_pair("e51m_integrity_gate",integrity_gate);
    e45_print_pair("e51m_exact_validation_gate",exact_gate);
    e45_print_pair("e51m_winning_arm",winning_arm);
    e45_print_pair("e51m_dose_signal_gate",dose_signal);
    e45_print_pair("e51m_capacity_signal_gate",capacity_signal);
    e45_print_pair("e51m_sealed_confirmation_executed",0);

    if(integrity_gate==0){
        _zag_println("e51m_outcome,INTEGRITY_FAILURE");
        _zag_println("TNN_R32_E51M_CALIBRATION_DOSE_CAPACITY_GATE=INVALID");
    }else{
        if(exact_gate==1){
            _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_RESCUE");
        }else{
            if(dose_signal==1){
                _zag_println("e51m_outcome,CALIBRATION_DOSE_SIGNAL");
            }else{
                if(capacity_signal==1){
                    _zag_println("e51m_outcome,CALIBRATION_CAPACITY_SIGNAL");
                }else{
                    _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_PLATEAU");
                }
            }
        }
        _zag_println("TNN_R32_E51M_CALIBRATION_DOSE_CAPACITY_GATE=EXECUTED_VALID");
    }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(terminal_records); zfree(continue_records); zfree(scalar_records);
    zfree(base_weights); zfree(base_biases); zfree(backup_weights); zfree(backup_biases);
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse); zfree(forward_copy_weights); zfree(forward_copy_biases);
    zfree(scalar_weights); zfree(scalar_biases); zfree(hinge_features); zfree(hinge_directions); zfree(hinge_means); zfree(hinge_coefficients); zfree(hinge_accepted);
    zfree(dose_positive); zfree(dose_negative); zfree(dose_neutral); zfree(dev_sign); zfree(val_sign); zfree(known_reach); zfree(no_unique_reach);
    if(integrity_gate==1){ return 1; }
    return 0;
}

// R32 E51M native calibration dose x boundary-capacity curve.
// Full native Zag v2.  The learner-visible state and grounded utility geometry
// are inherited unchanged from E50.  Evaluator truth is used only to construct
// delayed grounded targets and evaluator-side metrics; it is never a feature.

const E51M_DEV1_EPISODES:i32=3240;
const E51M_DEV2_EPISODES:i32=6480;
const E51M_DEV4_EPISODES:i32=12960;
const E51M_VALIDATION_EPISODES:i32=5400;
const E51M_CONFIRM_EPISODES:i32=10800;
const E51M_STATES_PER_EPISODE:i32=E45_TAPE+1;
const E51M_DEV1_SAMPLES:i32=E51M_DEV1_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_DEV2_SAMPLES:i32=E51M_DEV2_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_DEV4_SAMPLES:i32=E51M_DEV4_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_VALIDATION_SAMPLES:i32=E51M_VALIDATION_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_CONFIRM_SAMPLES:i32=E51M_CONFIRM_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_DOSES:i32=3;
const E51M_CAPS:i32=4;
const E51M_ARMS:i32=E51M_DOSES*E51M_CAPS;
const E51M_SCALAR_COLUMNS:i32=E45_FEATURES+1;
const E51M_SCALAR_GRAM:i32=E51M_SCALAR_COLUMNS*E51M_SCALAR_COLUMNS;
const E51M_HINGE_MAX:i32=16;
const E51M_HINGE_CANDIDATES:i32=E45_FEATURES*2;
const E51M_REACH_FIELDS:i32=4;
const E51M_R_KNOWN:i32=0;
const E51M_R_KNOWN_REACH:i32=1;
const E51M_R_NO_UNIQUE:i32=2;
const E51M_R_NO_UNIQUE_REACH:i32=3;
const E51M_SIGN_FIELDS:i32=4;
const E51M_S_POS_TOTAL:i32=0;
const E51M_S_POS_CORRECT:i32=1;
const E51M_S_NEG_TOTAL:i32=2;
const E51M_S_NEG_CORRECT:i32=3;

fn e51m_dev_index(
    round:i32,
    base_index:i32,
    mode:i32,
    resource:i32,
    episode:i32
)i32 {
    return ((((round*3+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*12)+episode;
}

fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32,
    confirmation_failures:*i32
)i32 {
    e45_zero(dev_seeds,E51M_DEV4_EPISODES);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    let dev_failures:i32=0;
    let validation_failures:i32=0;
    let sealed_failures:i32=0;
    let emitted:i32=0;
    let round:i32=0;
    while(round<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(round,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(
                            raw_seen,evidence_seen,resource_seen,52,index,mode,resource,&dev_failures
                        );
                        dev_seeds[index]=seed;
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        round=round+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(
                        raw_seen,evidence_seen,resource_seen,53,index,mode,resource,&validation_failures
                    );
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    // The legacy finite state allocator is already near saturation after the
    // retained lineage.  Development and untouched validation are allocated
    // first and must remain globally disjoint.  Confirmation is sealed as a
    // separate deferred namespace rather than burning billions of failed
    // probes before a candidate exists.  A later confirmation-only native run
    // must materialize all tuples under a domain-separated allocator before
    // any exact validation result can be called confirmed.
    sealed_failures=E51M_CONFIRM_EPISODES;
    confirmation_failures.*=sealed_failures;
    e45_print_pair("e51m_seed_manifest_emitted",emitted);
    e45_print_pair("e51m_development_seed_assignment_failures",dev_failures);
    e45_print_pair("e51m_validation_seed_assignment_failures",validation_failures);
    e45_print_pair("e51m_confirmation_seed_assignment_failures",sealed_failures);
    e45_print_pair("e51m_sealed_confirmation_requested",E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_effective_allocated",E51M_CONFIRM_EPISODES-sealed_failures);
    e45_print_pair("e51m_confirmation_namespace_deferred",1);
    e45_print_pair("e51m_sealed_confirmation_executed",0);
    // Development and untouched validation remain valid when only the sealed,
    // unexecuted confirmation namespace is incomplete. Exact validation rescue
    // cannot open confirmation unless sealed_failures is zero.
    if(dev_failures==0 && validation_failures==0 && emitted==E51M_DEV4_EPISODES+E51M_VALIDATION_EPISODES){
        return 1;
    }
    return 0;
}

fn e51m_feature_value(records:[]i32,record_start:i32,feature:i32)i32 {
    if(feature==3){ return records[record_start+32]; }
    if(feature==5){ return records[record_start+33]; }
    return records[record_start+feature];
}

fn e51m_linear_raw(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32
)i32 {
    let value:i32=bias;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+weights[weight_start+feature]*e51m_feature_value(records,record_start,feature)/1000;
        feature=feature+1;
    }
    return value;
}

fn e51m_base_scores(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    biases:[]i32,
    scores:[]i32
)i32 {
    let action:i32=0;
    while(action<4){
        scores[action]=r32e45_clamp(
            e51m_linear_raw(records,record_start,weights,action*E45_FEATURES,biases[action]),
            -4000,4000
        );
        action=action+1;
    }
    let top:i32=0;
    let best:i32=scores[0];
    if(scores[1]>best){ top=1; best=scores[1]; }
    if(scores[2]>best){ top=2; }
    return top;
}

fn e51m_build_sign_targets(
    records:[]i32,
    count:i32,
    base_weights:[]i32,
    base_biases:[]i32,
    targets:[]i32,
    positive:*i32,
    negative:*i32,
    neutral:*i32
)void {
    positive.*=0; negative.*=0; neutral.*=0;
    let scores:[]i32=zalloc_i(4);
    let record_number:i32=0;
    while(record_number<count){
        let record_start:i32=record_number*E50_RECORD_N;
        let top:i32=e51m_base_scores(records,record_start,base_weights,base_biases,scores);
        let utility:i32=records[record_start+34+top];
        let target:i32=0;
        if(utility>0){ target=1000; positive.*=positive.*+1;
        }else{
            if(utility<0){ target=-1000; negative.*=negative.*+1;
            }else{ neutral.*=neutral.*+1; }
        }
        targets[record_number]=target;
        record_number=record_number+1;
    }
    zfree(scores);
}

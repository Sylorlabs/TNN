// E51AJ scheduler indices are never model features.
const E51AJ_EP:i32=540;
const E51AJ_STATES:i32=9180;
const E51AJ_COEF:i32=65;
const E51AJ_MODEL:i32=130;
const E51AJ_META:i32=12;
const E51AJ_ARMS:i32=5;
const E51AJ_BATCH:i32=1080;
const E51AJ_SWEEPS:i32=4;
const E51AJ_BLOCKS:i32=32;
const E51AJ_REPLICAS:i32=3;

fn e51aj_world_gate()i32 {
    let ok:i32=1; let previous:i32=e51n_world_id(118,999999); let s:i32=119;
    while(s<=142){
        let lo:i32=e51n_world_id(s,0); let hi:i32=e51n_world_id(s,539);
        if(lo<=previous || hi<lo){ ok=0; } previous=hi;
        let d:i32=0;
        while(d<5){
            let dlo:i64=e51n_domain_state(lo,d); let dhi:i64=e51n_domain_state(hi,d);
            if(dlo<=0 || dhi>=E51N_RNG_MOD){ ok=0; }
            if(d<4 && dhi>=e51n_domain_state(0,d+1)){ ok=0; }
            d=d+1;
        }
        _zag_print("e51aj_stage,"); e45_print_i32(s); _zag_print(","); e45_print_i32(lo); _zag_print(","); e45_print_i32(hi); _zag_println("");
        s=s+1;
    }
    e45_print_pair("e51aj_world_gate",ok);
    return ok;
}

fn e51aj_column(x:[]i32,row:i32,coordinate:i32,arm:i32)i32 {
    if(coordinate==0){ return 1000; }
    return x[row*64+coordinate-1];
}

fn e51aj_sample(arm:i32,block:i32,position:i32)i32 {
    let active:i32=e45_mod(block,4); let cycle:i32=block/4;
    if(arm==0){ return active*540+e45_mod(position,540); }
    if(arm==3){ return e45_mod(position,540); }
    if(arm==1){
        if(position<540){ return active*540+position; }
        let local:i32=position-540; let rank:i32=e45_mod(local,3);
        let cohort:i32=rank; if(cohort>=active){ cohort=cohort+1; }
        let phase:i32=active; if(active>cohort){ phase=active-1; }
        let episode:i32=e45_mod((phase*180+local/3)*29+cycle*97,540);
        return cohort*540+episode;
    }
    if(arm==2){
        let cohort:i32=e45_mod(position,4);
        let episode:i32=e45_mod((e45_mod(block,2)*270+position/4)*29+cycle*97,540);
        return cohort*540+episode;
    }
    return -1;
}

fn e51aj_schedule_gate()i32 {
    let ok:i32=1; let counts:[]i32=zalloc_i(2160); let arm:i32=0;
    while(arm<4){
        let cycle:i32=0;
        while(cycle<8){
            e45_zero(counts,2160); let offset:i32=0;
            while(offset<4){
                let p:i32=0;
                while(p<1080){
                    let row:i32=e51aj_sample(arm,cycle*4+offset,p);
                    if(row<0 || row>=2160){ ok=0; }else{ counts[row]=counts[row]+1; }
                    p=p+1;
                }
                offset=offset+1;
            }
            let row:i32=0;
            while(row<2160){
                let expected:i32=2; if(arm==3){ expected=0; if(row<540){ expected=8; } }
                if(counts[row]!=expected){ ok=0; }
                row=row+1;
            }
            cycle=cycle+1;
        }
        arm=arm+1;
    }
    zfree(counts); return ok;
}

fn e51aj_emit_weights(w:[]i32,ws:i32,replica:i32,phase:i32,checkpoint:i32,arm:i32)void {
    _zag_print("e51aj_model,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(phase); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(e51aj_hash(w,ws,130)); _zag_println("");
    let c:i32=0;
    while(c<130){
        _zag_print("e51aj_weight,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(phase); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(c); _zag_print(","); e45_print_i32(w[ws+c]); _zag_println("");
        c=c+1;
    }
}

fn e51aj_train_block(x:[]i32,targets:[]i32,w:[]i32,rw:[]i32,ws:i32,replica:i32,phase:i32,checkpoint:i32,arm:i32)i32 {
    let ok:i32=1; let block:i32=checkpoint-1; let before:i32=e51aj_hash(w,ws,130);
    let c:i32=0; while(c<130){ rw[ws+c]=w[ws+c]; c=c+1; }
    let counts:[]i32=zalloc_i(4); e45_zero(counts,4); let p:i32=0; let schedule_hash:i32=9101;
    while(p<1080){
        let row:i32=e51aj_sample(arm,block,p);
        if(row<0 || row>=2160){ ok=0; }else{ counts[row/540]=counts[row/540]+1; }
        schedule_hash=e46_hash_update(schedule_hash,row); p=p+1;
    }
    _zag_print("e51aj_exposure,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(phase); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm);
    c=0; while(c<4){ _zag_print(","); e45_print_i32(counts[c]); c=c+1; }
    _zag_print(","); e45_print_i32(schedule_hash); _zag_print(","); e45_print_i32(ok); _zag_println(""); zfree(counts);
    if(ok!=1){ return 0; }
    let candidate:i32=0;
    while(candidate<2 && ok==1){
        let u:i32=0; let ru:i32=0; let il:i64=0; let fl:i64=0; let ril:i64=0; let rfl:i64=0;
        let fit:i32=e51aj_fit(x,targets,w,ws+candidate*65,arm,block,candidate,0,1080,&u,&il,&fl);
        let rfit:i32=e51aj_fit(x,targets,rw,ws+candidate*65,arm,block,candidate,1,1080,&ru,&ril,&rfl);
        let same:i32=1; c=0;
        while(c<65){ if(w[ws+candidate*65+c]!=rw[ws+candidate*65+c]){ same=0; } c=c+1; }
        if(u!=ru || il!=ril || fl!=rfl || fit!=1 || rfit!=1){ same=0; }
        if(same!=1){ ok=0; }
        _zag_print("e51aj_fit,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(phase); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(candidate);
        _zag_print(","); e45_print_i32(u); _zag_print(","); e45_print_i64(il); _zag_print(","); e45_print_i64(fl); _zag_print(","); e45_print_i32(same); _zag_println("");
        candidate=candidate+1;
    }
    _zag_print("e51aj_continuity,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(phase); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(before); _zag_print(","); e45_print_i32(e51aj_hash(w,ws,130)); _zag_println("");
    return ok;
}

// Only anchors and evaluator-side frozen_outcomes may be written. Weights,
// training records, RNG and optimizer state are not writable evaluation state.
fn e51aj_evaluate(x:[]i32,meta:[]i32,w:[]i32,anchors:[]i32,frozen_outcomes:[]i32,replica:i32,checkpoint:i32)i32 {
    let ok:i32=1; let before:[]i32=zalloc_i(650); let z:i32=0;
    while(z<650){ before[z]=w[z]; z=z+1; }
    let arm:i32=0;
    while(arm<5){
        let cohort:i32=0;
        while(cohort<4){
            let totals:[]i32=zalloc_i(14); e45_zero(totals,14); let ep:i32=0;
            while(ep<540){
                let episode:i32=cohort*540+ep; let hit:i32=0; let union_hit:i32=0; let hybrid_hit:i32=0;
                let s0:i32=0; let u0:i32=0; let wrong0:i32=0; let t:i32=0;
                while(t<=E45_TAPE){
                    let row:i32=episode*(E45_TAPE+1)+t; let m:i32=row*12;
                    if(meta[m]==1){
                        let choice:i32=e51aj_choice(x,meta,row,w,arm*130,arm);
                        let success:i32=e51aj_success(meta,row,choice);
                        if(success==1){ hit=1; }
                        if(meta[m+11]==1){ union_hit=1; }
                        if(e51aj_success(meta,row,e51aj_choice(x,meta,row,w,0,-1))==1){ hybrid_hit=1; }
                        if(t==0){
                            if(success==1){ s0=1; }else{ if(choice==R32E45_TERM_UNKNOWN){ u0=1; }else{ wrong0=1; } }
                        }
                    }
                    t=t+1;
                }
                let known:i32=1; let mode:i32=e45_mod(ep/(E45_RESOURCES*2),E45_MODES);
                if(mode==0 || mode==1){ known=0; }
                if(checkpoint==0 && arm==0){ anchors[episode]=hit; }
                let anchor:i32=-1; if(checkpoint>=0){ anchor=anchors[episode]; }
                if(checkpoint==0 && hit!=anchor){ ok=0; }
                let values:[]i32=zalloc_i(7);
                values[0]=hit; values[1]=union_hit; values[2]=hybrid_hit; values[3]=known; values[4]=s0; values[5]=u0; values[6]=wrong0;
                if(arm==4 && checkpoint>=0){
                    let k:i32=0;
                    while(k<7){
                        if(checkpoint==0){ frozen_outcomes[episode*7+k]=values[k]; }
                        else{ if(frozen_outcomes[episode*7+k]!=values[k]){ ok=0; } }
                        k=k+1;
                    }
                }
                totals[0]=totals[0]+hit; totals[1]=totals[1]+hit*known; totals[2]=totals[2]+hit*(1-known);
                totals[3]=totals[3]+union_hit; totals[4]=totals[4]+union_hit*(1-hit); totals[5]=totals[5]+(1-union_hit)*hit;
                totals[6]=totals[6]+hybrid_hit; totals[7]=totals[7]+hybrid_hit*(1-hit); totals[8]=totals[8]+(1-hybrid_hit)*hit;
                if(anchor==1 && hit==0){ totals[9]=totals[9]+1; } if(anchor==0 && hit==1){ totals[10]=totals[10]+1; }
                totals[11]=totals[11]+s0; totals[12]=totals[12]+u0; totals[13]=totals[13]+wrong0;
                _zag_print("e51aj_episode,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(cohort); _zag_print(","); e45_print_i32(ep);
                let k:i32=0; while(k<7){ _zag_print(","); e45_print_i32(values[k]); k=k+1; }
                _zag_print(","); e45_print_i32(anchor); _zag_println(""); zfree(values);
                ep=ep+1;
            }
            _zag_print("e51aj_metrics,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(cohort);
            let k:i32=0; while(k<14){ _zag_print(","); e45_print_i32(totals[k]); k=k+1; } _zag_println(""); zfree(totals);
            cohort=cohort+1;
        }
        arm=arm+1;
    }
    z=0; while(z<650){ if(before[z]!=w[z]){ ok=0; } z=z+1; }
    _zag_print("e51aj_panel,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(e51aj_hash(before,0,650)); _zag_print(","); e45_print_i32(e51aj_hash(w,0,650)); _zag_print(","); e45_print_i32(ok); _zag_println("");
    zfree(before); return ok;
}

        let weights:[]i32=zalloc_i(650); let reverse_weights:[]i32=zalloc_i(650); let common:[]i32=zalloc_i(130);
        let anchors:[]i32=zalloc_i(2160); let frozen_outcomes:[]i32=zalloc_i(2160*7);
        e45_zero(weights,650); e45_zero(reverse_weights,650); e45_zero(common,130); e45_zero(anchors,2160); e45_zero(frozen_outcomes,2160*7);
        let probe_hash:i32=e51aj_hash(probe_x,0,4*E51AJ_STATES*64);
        let meta_hash:i32=e51aj_hash(probe_meta,0,4*E51AJ_STATES*12);
        let train_hash:i32=e51aj_hash(train_x,0,2160*64); let targets_hash:i32=e51aj_hash(train_targets,0,2160*2);
        let arm:i32=0; while(arm<5){ e51aj_emit_weights(weights,arm*130,replica,1,-1,arm); arm=arm+1; }
        if(e51aj_evaluate(probe_x,probe_meta,weights,anchors,frozen_outcomes,replica,-1)!=1){ integrity=0; }
        if(integrity!=1){ _zag_println("e51aj_integrity_gate,0"); return 0; }
        let preparation:i32=1;
        while(preparation<=4 && integrity==1){
            if(e51aj_train_block(train_x,train_targets,weights,reverse_weights,0,replica,0,preparation,0)!=1){ integrity=0; }
            e51aj_emit_weights(weights,0,replica,0,preparation,0); preparation=preparation+1;
        }
        if(integrity!=1){ _zag_println("e51aj_integrity_gate,0"); return 0; }
        let c:i32=0; while(c<130){ common[c]=weights[c]; c=c+1; }
        arm=0;
        while(arm<5){
            c=0; while(c<130){ weights[arm*130+c]=common[c]; c=c+1; }
            e51aj_emit_weights(weights,arm*130,replica,1,0,arm); arm=arm+1;
        }
        _zag_print("e51aj_fork,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(e51aj_hash(common,0,130)); _zag_println("");
        if(e51aj_evaluate(probe_x,probe_meta,weights,anchors,frozen_outcomes,replica,0)!=1){ integrity=0; }
        let checkpoint:i32=1;
        while(checkpoint<=32 && integrity==1){
            arm=0;
            while(arm<4 && integrity==1){
                if(e51aj_train_block(train_x,train_targets,weights,reverse_weights,arm*130,replica,1,checkpoint,arm)!=1){ integrity=0; }
                arm=arm+1;
            }
            if(integrity!=1){ _zag_println("e51aj_integrity_gate,0"); return 0; }
            arm=0; while(arm<5){ e51aj_emit_weights(weights,arm*130,replica,1,checkpoint,arm); arm=arm+1; }
            if(e51aj_evaluate(probe_x,probe_meta,weights,anchors,frozen_outcomes,replica,checkpoint)!=1){ integrity=0; }
            c=0; while(c<130){ if(weights[4*130+c]!=common[c]){ integrity=0; } c=c+1; }
            checkpoint=checkpoint+1;
        }
        if(probe_hash!=e51aj_hash(probe_x,0,4*E51AJ_STATES*64) || meta_hash!=e51aj_hash(probe_meta,0,4*E51AJ_STATES*12) ||
           train_hash!=e51aj_hash(train_x,0,2160*64) || targets_hash!=e51aj_hash(train_targets,0,2160*2)){ integrity=0; }
        _zag_print("e51aj_replica_complete,"); e45_print_i32(replica); _zag_print(","); e45_print_i32(checkpoint-1); _zag_print(","); e45_print_i32(integrity); _zag_println("");
        zfree(train_x); zfree(train_targets); zfree(probe_x); zfree(probe_meta); zfree(weights); zfree(reverse_weights); zfree(common); zfree(anchors); zfree(frozen_outcomes);
        if(integrity!=1){ _zag_println("e51aj_integrity_gate,0"); return 0; }
        replica=replica+1;
    }
    let terminal_final:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_final:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    if(terminal_final!=terminal_hash_before || direct_final!=direct_hash_before){ integrity=0; }
    e45_print_pair("e51aj_terminal_hash_final",terminal_final); e45_print_pair("e51aj_direct_hash_final",direct_final);
    e45_print_pair("e51aj_replicas_completed",replica); e45_print_pair("e51aj_validation_executed",0); e45_print_pair("e51aj_confirmation_executed",0);
    e45_print_pair("e51aj_integrity_gate",integrity);
    if(integrity==1){ _zag_println("e51aj_outcome,REPLAY_ORDER_DOSE_DIAGNOSTIC_COMPLETE"); _zag_println("TNN_R32_E51AJ_EXECUTION_COMPLETE=1"); }
    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb);
    return integrity;
}

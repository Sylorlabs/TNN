// R32 E51AG — fresh-partition replication contract for the frozen current E51AE learner.
const E51AG_STAGE_VALIDATION_B:i32=105;
const E51AG_STAGE_VALIDATION_C:i32=106;

fn e51ag_replication_world_gate()i32 {
    let a_hi:i32=e51n_world_id(E51AG_STAGE_VALIDATION,E51AG_VALIDATION_EPISODES-1);
    let b_lo:i32=e51n_world_id(E51AG_STAGE_VALIDATION_B,0);
    let b_hi:i32=e51n_world_id(E51AG_STAGE_VALIDATION_B,E51AG_VALIDATION_EPISODES-1);
    let c_lo:i32=e51n_world_id(E51AG_STAGE_VALIDATION_C,0);
    let c_hi:i32=e51n_world_id(E51AG_STAGE_VALIDATION_C,E51AG_VALIDATION_EPISODES-1);
    let q_lo:i32=e51n_world_id(E51AG_STAGE_CONFIRM,0);
    let gate:i32=0;
    if(a_hi<b_lo && b_hi<c_lo && c_hi<q_lo){ gate=1; }
    e45_print_pair("e51ag_world_id_replica_a_hi",a_hi);
    e45_print_pair("e51ag_world_id_replica_b_lo",b_lo);
    e45_print_pair("e51ag_world_id_replica_b_hi",b_hi);
    e45_print_pair("e51ag_world_id_replica_c_lo",c_lo);
    e45_print_pair("e51ag_world_id_replica_c_hi",c_hi);
    e45_print_pair("e51ag_world_id_confirmation_lo",q_lo);
    e45_print_pair("e51ag_replication_world_order_gate",gate);
    e45_print_pair("e51ag_stage98_execution_forbidden",1);
    return gate;
}

    // Fresh stage-108 development partition. Classification is grounded in
    // frozen mechanism success and candidate utility, never mode identity.
    let dev_control:[]i32=zalloc_i(E51AH_DEV_SAMPLES*E50_RECORD_N);
    let dev_direct:[]i32=zalloc_i(E51AH_DEV_SAMPLES*E50_RECORD_N);
    let dev_t0:[]i32=zalloc_i(E51AH_DEV_SAMPLES); let dev_t1:[]i32=zalloc_i(E51AH_DEV_SAMPLES);
    let dev_pos:[]i32=zalloc_i(2); let dev_neg:[]i32=zalloc_i(2); let dev_unknown:i32=0;
    e45_zero(dev_control,E51AH_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_direct,E51AH_DEV_SAMPLES*E50_RECORD_N);
    let dev_built:i32=e51ab_build_partition(
        E51AH_STAGE_DEV,E51AH_DEV_EPISODES,48,
        source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        dev_control,dev_direct,dev_t0,dev_t1,dev_pos,dev_neg,&dev_unknown
    );
    zfree(dev_t0); zfree(dev_t1); zfree(dev_pos); zfree(dev_neg);

    let slot_success:[]i32=zalloc_i(E51AH_DEV_SAMPLES);
    let direct_success:[]i32=zalloc_i(E51AH_DEV_SAMPLES);
    let base_kinds:[]i32=zalloc_i(E51AH_DEV_EPISODES);
    let accessible:[]i32=zalloc_i(E51AH_DEV_SAMPLES);
    let base_slot:i32=0; let base_direct:i32=0; let base_neither:i32=0;
    e51ad_prepare_support(
        E51AH_STAGE_DEV,E51AH_DEV_EPISODES,48,dev_control,dev_direct,
        terminal_weights,terminal_biases,term_global,term_global_bias,
        prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,
        slot_success,direct_success,base_kinds,
        &base_slot,&base_direct,&base_neither
    );
    e51ah_build_accessible(E51AH_STAGE_DEV,E51AH_DEV_EPISODES,48,accessible);
    let kinds:[]i32=zalloc_i(E51AH_DEV_EPISODES);
    let slot_count:i32=0; let direct_count:i32=0; let neither_positive:i32=0; let neither_no_warrant:i32=0;
    e51ah_classify_grounded_kinds(
        base_kinds,dev_direct,accessible,E51AH_DEV_EPISODES,kinds,
        &slot_count,&direct_count,&neither_positive,&neither_no_warrant
    );
    let neither_count:i32=neither_positive+neither_no_warrant;
    let union_count:i32=slot_count+direct_count;
    let copies:i32=1;
    if(neither_count>0 && direct_count>neither_count){ copies=(direct_count+neither_count-1)/neither_count; }
    let expected_critical:i32=direct_count+neither_count*copies;
    let support_gate:i32=0;
    if(union_count>0 && neither_count>0 && expected_critical<=E51AH_MAX_CRITICAL &&
       slot_count+direct_count+neither_count==E51AH_DEV_EPISODES){ support_gate=1; }
    e45_print_pair("e51ah_development_episodes",dev_built);
    e45_print_pair("e51ah_development_states",dev_built*(E45_TAPE+1));
    e45_print_pair("e51ah_slot_covered",slot_count);
    e45_print_pair("e51ah_direct_required",direct_count);
    e45_print_pair("e51ah_union_neither_positive",neither_positive);
    e45_print_pair("e51ah_union_neither_no_warrant",neither_no_warrant);
    e45_print_pair("e51ah_frozen_union_development",union_count);
    e45_print_pair("e51ah_parent_neither_replication_factor",copies);
    e45_print_pair("e51ah_parent_expected_critical_count",expected_critical);
    e45_print_pair("e51ah_support_gate",support_gate);

    let model_w:i32=E51AB_CANDIDATES*E51AH_CELLS*E45_FEATURES;
    let model_b:i32=E51AB_CANDIDATES*E51AH_CELLS;
    let zero_g0:[]i32=zalloc_i(E45_FEATURES); let zero_g1:[]i32=zalloc_i(E45_FEATURES);
    let zero_local:[]i32=zalloc_i(model_w); let zero_local_b:[]i32=zalloc_i(model_b);
    e45_zero(zero_g0,E45_FEATURES); e45_zero(zero_g1,E45_FEATURES);
    e45_zero(zero_local,model_w); e45_zero(zero_local_b,model_b);

    // Parent critical-only residual control.
    let critical:[]i32=zalloc_i(E51AH_MAX_CRITICAL*E50_RECORD_N);
    let ct0:[]i32=zalloc_i(E51AH_MAX_CRITICAL); let ct1:[]i32=zalloc_i(E51AH_MAX_CRITICAL);
    let csupport:[]i32=zalloc_i(6); let critical_count:i32=0; let critical_trace:i32=0;
    e51ah_select_critical(
        dev_direct,E51AH_DEV_EPISODES,accessible,direct_success,kinds,copies,0,
        g0,b0,g1,b1,prototypes,parents,ranges,direct_lw,direct_lb,
        zero_g0,0,zero_g1,0,zero_local,zero_local_b,
        critical,ct0,ct1,&critical_count,&critical_trace,csupport
    );
    let critical_hash:i32=e51ah_critical_hash(critical,ct0,ct1,critical_count);
    let critical_isolation:i32=e51ah_record_isolation(critical,critical_count);

    let parent_g0:[]i32=zalloc_i(E45_FEATURES); let parent_rg0:[]i32=zalloc_i(E45_FEATURES);
    let parent_g1:[]i32=zalloc_i(E45_FEATURES); let parent_rg1:[]i32=zalloc_i(E45_FEATURES);
    let parent_b0:i32=0; let parent_rb0:i32=0; let parent_b1:i32=0; let parent_rb1:i32=0;
    let ps00:i32=0; let pr00:i32=0; let ph00:i32=0; let pl00:i64=0;
    let ps01:i32=0; let pr01:i32=0; let ph01:i32=0; let pl01:i64=0;
    let ps10:i32=0; let pr10:i32=0; let ph10:i32=0; let pl10:i64=0;
    let ps11:i32=0; let pr11:i32=0; let ph11:i32=0; let pl11:i64=0;
    e51m_fit_scalar_linear(critical,ct0,critical_count,0,parent_g0,0,&parent_b0,&ps00,&pr00,&ph00,&pl00);
    e51m_fit_scalar_linear(critical,ct0,critical_count,1,parent_rg0,0,&parent_rb0,&ps01,&pr01,&ph01,&pl01);
    e51m_fit_scalar_linear(critical,ct1,critical_count,0,parent_g1,0,&parent_b1,&ps10,&pr10,&ph10,&pl10);
    e51m_fit_scalar_linear(critical,ct1,critical_count,1,parent_rg1,0,&parent_rb1,&ps11,&pr11,&ph11,&pl11);
    let parent_id0:i32=e51m_linear_identity(parent_g0,0,parent_b0,parent_rg0,0,parent_rb0,ps00,ps01,pr00,pr01,ph00,ph01,pl00,pl01);
    let parent_id1:i32=e51m_linear_identity(parent_g1,0,parent_b1,parent_rg1,0,parent_rb1,ps10,ps11,pr10,pr11,ph10,ph11,pl10,pl11);
    let parent_identity:i32=0; if(parent_id0==1 && parent_id1==1){ parent_identity=1; }
    _zag_print("e51ah_parent_critical,"); e45_print_i32(critical_count); _zag_print(","); e45_print_i32(critical_trace); _zag_print(","); e45_print_i32(critical_hash); _zag_print(","); e45_print_i32(critical_isolation);
    let sp:i32=0; while(sp<6){ _zag_print(","); e45_print_i32(csupport[sp]); sp=sp+1; } _zag_println("");
    _zag_print("e51ah_parent_global_fit,0,"); e45_print_i32(ps00); _zag_print(","); e45_print_i32(pr00); _zag_print(","); e45_print_i32(ph00); _zag_print(","); e45_print_i64(pl00); _zag_print(","); e45_print_i32(parent_id0); _zag_println("");
    _zag_print("e51ah_parent_global_fit,1,"); e45_print_i32(ps10); _zag_print(","); e45_print_i32(pr10); _zag_print(","); e45_print_i32(ph10); _zag_print(","); e45_print_i64(pl10); _zag_print(","); e45_print_i32(parent_id1); _zag_println("");
    e45_print_pair("e51ah_parent_global_identity_gate",parent_identity);

    // One grounded replay record per development trajectory.
    let replay_records:[]i32=zalloc_i(E51AH_DEV_EPISODES*E50_RECORD_N);
    let replay_t0:[]i32=zalloc_i(E51AH_DEV_EPISODES); let replay_t1:[]i32=zalloc_i(E51AH_DEV_EPISODES);
    let replay_support:[]i32=zalloc_i(6); let replay_kind_support:[]i32=zalloc_i(4);
    let replay_count:i32=0; let replay_trace:i32=0;
    e51ah_select_preservation_replay(
        dev_control,dev_direct,E51AH_DEV_EPISODES,accessible,slot_success,direct_success,kinds,
        term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,
        replay_records,replay_t0,replay_t1,&replay_count,&replay_trace,replay_support,replay_kind_support
    );
    let replay_hash:i32=e51ah_critical_hash(replay_records,replay_t0,replay_t1,replay_count);
    let replay_isolation:i32=e51ah_record_isolation(replay_records,replay_count);
    let replay_target_gate:i32=0;
    if(replay_support[0]>0 && replay_support[1]>0 && replay_support[3]>0 && replay_support[4]>0){ replay_target_gate=1; }
    let replay_kind_gate:i32=0;
    if(replay_kind_support[E51AH_KIND_SLOT_COVERED]==slot_count &&
       replay_kind_support[E51AH_KIND_DIRECT_REQUIRED]==direct_count &&
       replay_kind_support[E51AH_KIND_NEITHER_KNOWN]==neither_positive &&
       replay_kind_support[E51AH_KIND_NEITHER_NU]==neither_no_warrant){ replay_kind_gate=1; }
    _zag_print("e51ah_replay_set,"); e45_print_i32(replay_count); _zag_print(","); e45_print_i32(replay_trace); _zag_print(","); e45_print_i32(replay_hash); _zag_print(","); e45_print_i32(replay_isolation);
    sp=0; while(sp<6){ _zag_print(","); e45_print_i32(replay_support[sp]); sp=sp+1; }
    sp=0; while(sp<4){ _zag_print(","); e45_print_i32(replay_kind_support[sp]); sp=sp+1; } _zag_println("");
    e45_print_pair("e51ah_replay_target_support_gate",replay_target_gate);
    e45_print_pair("e51ah_replay_kind_coverage_gate",replay_kind_gate);

    // Same-count control: deterministic repetitions of the parent critical set.
    let matched_records:[]i32=zalloc_i(E51AH_DEV_EPISODES*E50_RECORD_N);
    let matched_t0:[]i32=zalloc_i(E51AH_DEV_EPISODES); let matched_t1:[]i32=zalloc_i(E51AH_DEV_EPISODES);
    let matched_trace:i32=0;
    e51ah_repeat_critical(critical,ct0,ct1,critical_count,matched_records,matched_t0,matched_t1,replay_count,&matched_trace);
    let matched_hash:i32=e51ah_critical_hash(matched_records,matched_t0,matched_t1,replay_count);
    let matched_isolation:i32=e51ah_record_isolation(matched_records,replay_count);
    _zag_print("e51ah_count_matched_set,"); e45_print_i32(replay_count); _zag_print(","); e45_print_i32(matched_trace); _zag_print(","); e45_print_i32(matched_hash); _zag_print(","); e45_print_i32(matched_isolation); _zag_println("");

    let matched_g0:[]i32=zalloc_i(E45_FEATURES); let matched_rg0:[]i32=zalloc_i(E45_FEATURES);
    let matched_g1:[]i32=zalloc_i(E45_FEATURES); let matched_rg1:[]i32=zalloc_i(E45_FEATURES);
    let matched_b0:i32=0; let matched_rb0:i32=0; let matched_b1:i32=0; let matched_rb1:i32=0;
    let ms00:i32=0; let mr00:i32=0; let mh00:i32=0; let ml00:i64=0;
    let ms01:i32=0; let mr01:i32=0; let mh01:i32=0; let ml01:i64=0;
    let ms10:i32=0; let mr10:i32=0; let mh10:i32=0; let ml10:i64=0;
    let ms11:i32=0; let mr11:i32=0; let mh11:i32=0; let ml11:i64=0;
    e51m_fit_scalar_linear(matched_records,matched_t0,replay_count,0,matched_g0,0,&matched_b0,&ms00,&mr00,&mh00,&ml00);
    e51m_fit_scalar_linear(matched_records,matched_t0,replay_count,1,matched_rg0,0,&matched_rb0,&ms01,&mr01,&mh01,&ml01);
    e51m_fit_scalar_linear(matched_records,matched_t1,replay_count,0,matched_g1,0,&matched_b1,&ms10,&mr10,&mh10,&ml10);
    e51m_fit_scalar_linear(matched_records,matched_t1,replay_count,1,matched_rg1,0,&matched_rb1,&ms11,&mr11,&mh11,&ml11);
    let matched_id0:i32=e51m_linear_identity(matched_g0,0,matched_b0,matched_rg0,0,matched_rb0,ms00,ms01,mr00,mr01,mh00,mh01,ml00,ml01);
    let matched_id1:i32=e51m_linear_identity(matched_g1,0,matched_b1,matched_rg1,0,matched_rb1,ms10,ms11,mr10,mr11,mh10,mh11,ml10,ml11);
    let matched_identity:i32=0; if(matched_id0==1 && matched_id1==1){ matched_identity=1; }
    _zag_print("e51ah_count_matched_fit,0,"); e45_print_i32(ms00); _zag_print(","); e45_print_i32(mr00); _zag_print(","); e45_print_i32(mh00); _zag_print(","); e45_print_i64(ml00); _zag_print(","); e45_print_i32(matched_id0); _zag_println("");
    _zag_print("e51ah_count_matched_fit,1,"); e45_print_i32(ms10); _zag_print(","); e45_print_i32(mr10); _zag_print(","); e45_print_i32(mh10); _zag_print(","); e45_print_i64(ml10); _zag_print(","); e45_print_i32(matched_id1); _zag_println("");
    e45_print_pair("e51ah_count_matched_identity_gate",matched_identity);
    if(critical_count>0){
        _zag_print("e51ah_count_matched_multiplicity,"); e45_print_i32(replay_count/critical_count);
        _zag_print(","); e45_print_i32(e45_mod(replay_count,critical_count)); _zag_println("");
    }

    // Global preservation-replay residual.
    let replay_g0:[]i32=zalloc_i(E45_FEATURES); let replay_rg0:[]i32=zalloc_i(E45_FEATURES);
    let replay_g1:[]i32=zalloc_i(E45_FEATURES); let replay_rg1:[]i32=zalloc_i(E45_FEATURES);
    let replay_b0:i32=0; let replay_rb0:i32=0; let replay_b1:i32=0; let replay_rb1:i32=0;
    let rs00:i32=0; let rr00:i32=0; let rh00:i32=0; let rl00:i64=0;
    let rs01:i32=0; let rr01:i32=0; let rh01:i32=0; let rl01:i64=0;
    let rs10:i32=0; let rr10:i32=0; let rh10:i32=0; let rl10:i64=0;
    let rs11:i32=0; let rr11:i32=0; let rh11:i32=0; let rl11:i64=0;
    e51m_fit_scalar_linear(replay_records,replay_t0,replay_count,0,replay_g0,0,&replay_b0,&rs00,&rr00,&rh00,&rl00);
    e51m_fit_scalar_linear(replay_records,replay_t0,replay_count,1,replay_rg0,0,&replay_rb0,&rs01,&rr01,&rh01,&rl01);
    e51m_fit_scalar_linear(replay_records,replay_t1,replay_count,0,replay_g1,0,&replay_b1,&rs10,&rr10,&rh10,&rl10);
    e51m_fit_scalar_linear(replay_records,replay_t1,replay_count,1,replay_rg1,0,&replay_rb1,&rs11,&rr11,&rh11,&rl11);
    let replay_id0:i32=e51m_linear_identity(replay_g0,0,replay_b0,replay_rg0,0,replay_rb0,rs00,rs01,rr00,rr01,rh00,rh01,rl00,rl01);
    let replay_id1:i32=e51m_linear_identity(replay_g1,0,replay_b1,replay_rg1,0,replay_rb1,rs10,rs11,rr10,rr11,rh10,rh11,rl10,rl11);
    let replay_global_identity:i32=0; if(replay_id0==1 && replay_id1==1){ replay_global_identity=1; }
    _zag_print("e51ah_replay_global_fit,0,"); e45_print_i32(rs00); _zag_print(","); e45_print_i32(rr00); _zag_print(","); e45_print_i32(rh00); _zag_print(","); e45_print_i64(rl00); _zag_print(","); e45_print_i32(replay_id0); _zag_println("");
    _zag_print("e51ah_replay_global_fit,1,"); e45_print_i32(rs10); _zag_print(","); e45_print_i32(rr10); _zag_print(","); e45_print_i32(rh10); _zag_print(","); e45_print_i64(rl10); _zag_print(","); e45_print_i32(replay_id1); _zag_println("");
    e45_print_pair("e51ah_replay_global_identity_gate",replay_global_identity);

    // Capacity-matched local conditional replay residual, one frozen 384 ceiling.
    let replay_local_w:[]i32=zalloc_i(model_w); let replay_local_b:[]i32=zalloc_i(model_b);
    let replay_rlocal_w:[]i32=zalloc_i(model_w); let replay_rlocal_b:[]i32=zalloc_i(model_b);
    e45_zero(replay_local_w,model_w); e45_zero(replay_local_b,model_b);
    e45_zero(replay_rlocal_w,model_w); e45_zero(replay_rlocal_b,model_b);
    let replay_local_identity:i32=1; let replay_local_strict:i32=1;
    let candidate_local:i32=0;
    while(candidate_local<E51AB_CANDIDATES){
        let targets:[]i32=replay_t0; let gw:[]i32=replay_g0; let gb:i32=replay_b0;
        if(candidate_local==1){ targets=replay_t1; gw=replay_g1; gb=replay_b1; }
        let ws:i32=candidate_local*E51AH_CELLS*E45_FEATURES;
        let bs:i32=candidate_local*E51AH_CELLS;
        let lu0:i32=0; let lsw0:i32=0; let lr0:i32=0; let lt0:i32=0; let ll0:i64=0; let lsg0:i32=0;
        let lu1:i32=0; let lsw1:i32=0; let lr1:i32=0; let lt1:i32=0; let ll1:i64=0; let lsg1:i32=0;
        e51x_fit_experts_dose(replay_records,targets,replay_count,gw,gb,prototypes,parents,ranges,E51AH_CELLS,0,384,replay_local_w,ws,replay_local_b,bs,&lu0,&lsw0,&lr0,&lt0,&ll0,&lsg0);
        e51x_fit_experts_dose(replay_records,targets,replay_count,gw,gb,prototypes,parents,ranges,E51AH_CELLS,1,384,replay_rlocal_w,ws,replay_rlocal_b,bs,&lu1,&lsw1,&lr1,&lt1,&ll1,&lsg1);
        let lid:i32=e51p_expert_identity(
            replay_local_w,ws,replay_local_b,bs,replay_rlocal_w,ws,replay_rlocal_b,bs,
            E51AH_CELLS,lu0,lu1,lsw0,lsw1,lr0,lr1,lt0,lt1,ll0,ll1,lsg0,lsg1
        );
        if(lid!=1){ replay_local_identity=0; }
        if(lsg0!=1 || lsg1!=1){ replay_local_strict=0; }
        _zag_print("e51ah_replay_local_fit,"); e45_print_i32(candidate_local); _zag_print(",384,"); e45_print_i32(lu0); _zag_print(","); e45_print_i32(lsw0); _zag_print(","); e45_print_i32(lr0); _zag_print(","); e45_print_i32(lt0); _zag_print(","); e45_print_i64(ll0); _zag_print(","); e45_print_i32(lid); _zag_print(","); e45_print_i32(lsg0); _zag_println("");
        candidate_local=candidate_local+1;
    }
    e45_print_pair("e51ah_replay_local_identity_gate",replay_local_identity);
    e45_print_pair("e51ah_replay_local_strict_gate",replay_local_strict);
    let parent_residual_hash:i32=e51ah_model_hash(parent_g0,parent_b0,parent_g1,parent_b1,zero_local,zero_local_b);
    let matched_residual_hash:i32=e51ah_model_hash(matched_g0,matched_b0,matched_g1,matched_b1,zero_local,zero_local_b);
    let replay_global_hash:i32=e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,zero_local,zero_local_b);
    let replay_local_hash:i32=e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b);
    e45_print_pair("e51ah_parent_residual_hash",parent_residual_hash);
    e45_print_pair("e51ah_matched_residual_hash",matched_residual_hash);
    e45_print_pair("e51ah_replay_global_hash",replay_global_hash);
    e45_print_pair("e51ah_replay_local_hash",replay_local_hash);

    // Development-level causal gates.
    let parent_preserve:i32=0; let parent_rescue:i32=0;
    let parent_loss:i64=e51ah_dev_objective(
        dev_control,dev_direct,E51AH_DEV_EPISODES,accessible,kinds,union_count,
        terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,parent_g0,parent_b0,parent_g1,parent_b1,0,zero_local,zero_local_b,
        &parent_preserve,&parent_rescue
    );
    let matched_preserve:i32=0; let matched_rescue:i32=0;
    let matched_loss:i64=e51ah_dev_objective(
        dev_control,dev_direct,E51AH_DEV_EPISODES,accessible,kinds,union_count,
        terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,matched_g0,matched_b0,matched_g1,matched_b1,0,zero_local,zero_local_b,
        &matched_preserve,&matched_rescue
    );
    let replay_global_preserve:i32=0; let replay_global_rescue:i32=0;
    let replay_global_loss:i64=e51ah_dev_objective(
        dev_control,dev_direct,E51AH_DEV_EPISODES,accessible,kinds,union_count,
        terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,replay_g0,replay_b0,replay_g1,replay_b1,0,zero_local,zero_local_b,
        &replay_global_preserve,&replay_global_rescue
    );
    let replay_local_preserve:i32=0; let replay_local_rescue:i32=0;
    let replay_local_loss:i64=e51ah_dev_objective(
        dev_control,dev_direct,E51AH_DEV_EPISODES,accessible,kinds,union_count,
        terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,replay_g0,replay_b0,replay_g1,replay_b1,1,replay_local_w,replay_local_b,
        &replay_local_preserve,&replay_local_rescue
    );
    let parent_dev_gate:i32=0; if(parent_preserve==union_count && parent_rescue>0){ parent_dev_gate=1; }
    let matched_dev_gate:i32=0; if(matched_preserve==union_count && matched_rescue>0){ matched_dev_gate=1; }
    let replay_global_dev_gate:i32=0; if(replay_global_preserve==union_count && replay_global_rescue>0){ replay_global_dev_gate=1; }
    let replay_local_dev_gate:i32=0; if(replay_local_preserve==union_count && replay_local_rescue>0){ replay_local_dev_gate=1; }
    _zag_print("e51ah_development_arm,1,"); e45_print_i32(parent_preserve); _zag_print(","); e45_print_i32(parent_rescue); _zag_print(","); e45_print_i64(parent_loss); _zag_print(","); e45_print_i32(parent_dev_gate); _zag_println("");
    _zag_print("e51ah_development_arm,2,"); e45_print_i32(matched_preserve); _zag_print(","); e45_print_i32(matched_rescue); _zag_print(","); e45_print_i64(matched_loss); _zag_print(","); e45_print_i32(matched_dev_gate); _zag_println("");
    _zag_print("e51ah_development_arm,3,"); e45_print_i32(replay_global_preserve); _zag_print(","); e45_print_i32(replay_global_rescue); _zag_print(","); e45_print_i64(replay_global_loss); _zag_print(","); e45_print_i32(replay_global_dev_gate); _zag_println("");
    _zag_print("e51ah_development_arm,4,"); e45_print_i32(replay_local_preserve); _zag_print(","); e45_print_i32(replay_local_rescue); _zag_print(","); e45_print_i64(replay_local_loss); _zag_print(","); e45_print_i32(replay_local_dev_gate); _zag_println("");

    let terminal_hash_after_training:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_hash_after_training:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen_training_gate:i32=0;
    if(terminal_hash_after_training==terminal_hash_before && direct_hash_after_training==direct_hash_before){ frozen_training_gate=1; }
    let pre_validation_integrity:i32=0;
    if(world_gate==1 && terminal_reproduction_gate==1 && direct_integrity==1 && support_gate==1 &&
       dev_built==E51AH_DEV_EPISODES && dev_unknown==0 && critical_count==expected_critical &&
       critical_isolation==1 && replay_count==E51AH_DEV_EPISODES && replay_isolation==1 && matched_isolation==1 &&
       replay_target_gate==1 && replay_kind_gate==1 && parent_identity==1 && matched_identity==1 &&
       replay_global_identity==1 && replay_local_identity==1 && replay_local_strict==1 && frozen_training_gate==1){
        pre_validation_integrity=1;
    }
    let development_open_gate:i32=0;
    if(replay_global_dev_gate==1 || replay_local_dev_gate==1){ development_open_gate=1; }
    let selected_replay_arm:i32=e51ah_select_replay_arm(replay_global_dev_gate,replay_local_dev_gate);
    e45_print_pair("e51ah_selected_replay_arm",selected_replay_arm);
    e45_print_pair("e51ah_terminal_hash_before",terminal_hash_before);
    e45_print_pair("e51ah_terminal_hash_after_training",terminal_hash_after_training);
    e45_print_pair("e51ah_direct_hash_after_training",direct_hash_after_training);
    e45_print_pair("e51ah_frozen_training_gate",frozen_training_gate);
    e45_print_pair("e51ah_pre_validation_integrity_gate",pre_validation_integrity);
    e45_print_pair("e51ah_development_open_gate",development_open_gate);

    let validation_executed:i32=0; let validation_integrity:i32=1;
    let exact_winner:i32=-1; let pareto_winner:i32=-1; let tradeoff_signal:i32=0;
    if(pre_validation_integrity==1 && development_open_gate==1){
        let val_control:[]i32=zalloc_i(E51AH_VALIDATION_SAMPLES*E50_RECORD_N);
        let val_direct:[]i32=zalloc_i(E51AH_VALIDATION_SAMPLES*E50_RECORD_N);
        let val_t0:[]i32=zalloc_i(E51AH_VALIDATION_SAMPLES); let val_t1:[]i32=zalloc_i(E51AH_VALIDATION_SAMPLES);
        let val_pos:[]i32=zalloc_i(2); let val_neg:[]i32=zalloc_i(2); let val_unknown:i32=0;
        e45_zero(val_control,E51AH_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_direct,E51AH_VALIDATION_SAMPLES*E50_RECORD_N);
        let val_built:i32=e51ab_build_partition(
            E51AH_STAGE_VALIDATION,E51AH_VALIDATION_EPISODES,20,
            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
            val_control,val_direct,val_t0,val_t1,val_pos,val_neg,&val_unknown
        );
        zfree(val_t0); zfree(val_t1); zfree(val_pos); zfree(val_neg);
        let val_result:[]i32=zalloc_i(E51AH_ARMS*E51AH_FIELDS);
        let val_mode:[]i32=zalloc_i(E51AH_ARMS*E45_MODES);
        let val_resource:[]i32=zalloc_i(E51AH_ARMS*E45_RESOURCES);
        let val_paired:[]i32=zalloc_i(E51AH_ARMS*E51AH_PAIRED_FIELDS);
        e51ah_eval_partition(
            E51AH_STAGE_VALIDATION,E51AH_VALIDATION_EPISODES,20,-1,
            val_control,val_direct,terminal_weights,terminal_biases,term_global,term_global_bias,
            prototypes,parents,ranges,term_expert_w,term_expert_b,
            g0,b0,g1,b1,direct_lw,direct_lb,
            parent_g0,parent_b0,parent_g1,parent_b1,
            matched_g0,matched_b0,matched_g1,matched_b1,
            replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b,
            zero_local,zero_local_b,val_result,val_mode,val_resource,val_paired
        );
        validation_executed=E51AH_VALIDATION_EPISODES;
        _zag_println("e51ah_validation_columns,arm,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong");
        let arm:i32=0;
        while(arm<E51AH_ARMS){ e51ah_print_result("e51ah_validation",val_result,arm); arm=arm+1; }
        arm=1;
        while(arm<E51AH_ARMS){
            _zag_print("e51ah_validation_paired,"); e45_print_i32(arm); _zag_print(",");
            e45_print_i32(val_paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_GAIN]); _zag_print(",");
            e45_print_i32(val_paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_LOSS]); _zag_println("");
            arm=arm+1;
        }
        arm=0;
        while(arm<E51AH_ARMS){
            let m:i32=0;
            while(m<E45_MODES){ _zag_print("e51ah_validation_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(val_mode[arm*E45_MODES+m]); _zag_println(""); m=m+1; }
            arm=arm+1;
        }
        arm=0;
        while(arm<E51AH_ARMS){
            let r:i32=0;
            while(r<E45_RESOURCES){ _zag_print("e51ah_validation_resource,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(val_resource[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; }
            arm=arm+1;
        }
        let terminal_hash_after_validation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
        let direct_hash_after_validation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
        let frozen_validation_gate:i32=0;
        if(terminal_hash_after_validation==terminal_hash_before && direct_hash_after_validation==direct_hash_before){ frozen_validation_gate=1; }
        if(val_built!=E51AH_VALIDATION_EPISODES || val_unknown!=0 || frozen_validation_gate!=1){ validation_integrity=0; }
        let control_s:i32=E51AH_ARM_UNION_CONTROL*E51AH_FIELDS;
        let control_reach:i32=val_result[control_s+E51AH_REACHABLE];
        let control_known:i32=val_result[control_s+E51AH_KNOWN_REACHABLE];
        let control_nu:i32=val_result[control_s+E51AH_NO_UNIQUE_REACHABLE];
        arm=E51AH_ARM_REPLAY_GLOBAL;
        while(arm<=E51AH_ARM_REPLAY_LOCAL_384){
            let eligible:i32=replay_global_dev_gate;
            if(arm==E51AH_ARM_REPLAY_LOCAL_384){ eligible=replay_local_dev_gate; }
            let s:i32=arm*E51AH_FIELDS;
            let result_class:i32=e51ah_validation_class(
                val_result[s+E51AH_KNOWN_REACHABLE],val_result[s+E51AH_NO_UNIQUE_REACHABLE],
                control_known,control_nu,val_paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_LOSS]
            );
            let exact:i32=0;
            if(eligible==1 && result_class==1 && val_result[s+E51AH_REACHABLE]==E51AH_VALIDATION_EPISODES){
                exact=1; if(arm==selected_replay_arm){ exact_winner=arm; }
            }
            let pareto:i32=0;
            if(eligible==1 && result_class==2 && val_result[s+E51AH_REACHABLE]>control_reach){
                pareto=1; if(arm==selected_replay_arm){ pareto_winner=arm; }
            }
            let tradeoff:i32=0;
            if(eligible==1 && result_class==3){
                tradeoff=1; if(arm==selected_replay_arm){ tradeoff_signal=1; }
            }
            _zag_print("e51ah_validation_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(eligible); _zag_print(","); e45_print_i32(exact); _zag_print(","); e45_print_i32(pareto); _zag_print(","); e45_print_i32(tradeoff); _zag_println("");
            arm=arm+1;
        }
        if(validation_integrity!=1){ exact_winner=-1; pareto_winner=-1; tradeoff_signal=0; }
        e45_print_pair("e51ah_validation_episodes_built",val_built);
        e45_print_pair("e51ah_validation_unknown_target_nonzero",val_unknown);
        e45_print_pair("e51ah_frozen_validation_gate",frozen_validation_gate);
        e45_print_pair("e51ah_validation_integrity_gate",validation_integrity);
        e45_print_pair("e51ah_exact_winner_arm",exact_winner);
        e45_print_pair("e51ah_pareto_winner_arm",pareto_winner);
        e45_print_pair("e51ah_tradeoff_signal",tradeoff_signal);
        zfree(val_control); zfree(val_direct); zfree(val_result); zfree(val_mode); zfree(val_resource); zfree(val_paired);
    }else{
        e45_print_pair("e51ah_validation_integrity_gate",pre_validation_integrity);
        e45_print_pair("e51ah_exact_winner_arm",-1);
        e45_print_pair("e51ah_pareto_winner_arm",-1);
        e45_print_pair("e51ah_tradeoff_signal",0);
    }
    e45_print_pair("e51ah_validation_executed",validation_executed);

    // Sealed confirmation opens only for exact validation.
    let confirmation_executed:i32=0; let confirmation_exact:i32=0; let confirmation_integrity:i32=1;
    if(pre_validation_integrity==1 && validation_integrity==1 && exact_winner>=E51AH_ARM_REPLAY_GLOBAL){
        let conf_control:[]i32=zalloc_i(E51AH_CONFIRM_SAMPLES*E50_RECORD_N);
        let conf_direct:[]i32=zalloc_i(E51AH_CONFIRM_SAMPLES*E50_RECORD_N);
        let conf_t0:[]i32=zalloc_i(E51AH_CONFIRM_SAMPLES); let conf_t1:[]i32=zalloc_i(E51AH_CONFIRM_SAMPLES);
        let conf_pos:[]i32=zalloc_i(2); let conf_neg:[]i32=zalloc_i(2); let conf_unknown:i32=0;
        e45_zero(conf_control,E51AH_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(conf_direct,E51AH_CONFIRM_SAMPLES*E50_RECORD_N);
        let conf_built:i32=e51ab_build_partition(
            E51AH_STAGE_CONFIRM,E51AH_CONFIRM_EPISODES,40,
            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
            conf_control,conf_direct,conf_t0,conf_t1,conf_pos,conf_neg,&conf_unknown
        );
        zfree(conf_t0); zfree(conf_t1); zfree(conf_pos); zfree(conf_neg);
        let conf_result:[]i32=zalloc_i(E51AH_ARMS*E51AH_FIELDS);
        let conf_mode:[]i32=zalloc_i(E51AH_ARMS*E45_MODES);
        let conf_resource:[]i32=zalloc_i(E51AH_ARMS*E45_RESOURCES);
        let conf_paired:[]i32=zalloc_i(E51AH_ARMS*E51AH_PAIRED_FIELDS);
        e51ah_eval_partition(
            E51AH_STAGE_CONFIRM,E51AH_CONFIRM_EPISODES,40,exact_winner,
            conf_control,conf_direct,terminal_weights,terminal_biases,term_global,term_global_bias,
            prototypes,parents,ranges,term_expert_w,term_expert_b,
            g0,b0,g1,b1,direct_lw,direct_lb,
            parent_g0,parent_b0,parent_g1,parent_b1,
            matched_g0,matched_b0,matched_g1,matched_b1,
            replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b,
            zero_local,zero_local_b,conf_result,conf_mode,conf_resource,conf_paired
        );
        confirmation_executed=E51AH_CONFIRM_EPISODES;
        e51ah_print_result("e51ah_confirmation",conf_result,exact_winner);
        let cs:i32=exact_winner*E51AH_FIELDS;
        let terminal_hash_after_confirmation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
        let direct_hash_after_confirmation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
        if(conf_built!=E51AH_CONFIRM_EPISODES || conf_unknown!=0 || terminal_hash_after_confirmation!=terminal_hash_before || direct_hash_after_confirmation!=direct_hash_before){ confirmation_integrity=0; }
        if(confirmation_integrity==1 && conf_result[cs+E51AH_REACHABLE]==E51AH_CONFIRM_EPISODES &&
           conf_result[cs+E51AH_KNOWN_REACHABLE]==8400 && conf_result[cs+E51AH_NO_UNIQUE_REACHABLE]==2400){ confirmation_exact=1; }
        let m:i32=0;
        while(m<E45_MODES){ _zag_print("e51ah_confirmation_mode,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(conf_mode[exact_winner*E45_MODES+m]); _zag_println(""); m=m+1; }
        let r:i32=0;
        while(r<E45_RESOURCES){ _zag_print("e51ah_confirmation_resource,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(conf_resource[exact_winner*E45_RESOURCES+r]); _zag_println(""); r=r+1; }
        zfree(conf_control); zfree(conf_direct); zfree(conf_result); zfree(conf_mode); zfree(conf_resource); zfree(conf_paired);
    }
    e45_print_pair("e51ah_sealed_confirmation_executed",confirmation_executed);
    e45_print_pair("e51ah_confirmation_exact_gate",confirmation_exact);
    e45_print_pair("e51ah_confirmation_integrity_gate",confirmation_integrity);

    let terminal_hash_final:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_hash_final:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen_final_gate:i32=0;
    if(terminal_hash_final==terminal_hash_before && direct_hash_final==direct_hash_before){ frozen_final_gate=1; }
    let residual_frozen_gate:i32=0;
    if(parent_residual_hash==e51ah_model_hash(parent_g0,parent_b0,parent_g1,parent_b1,zero_local,zero_local_b) &&
       matched_residual_hash==e51ah_model_hash(matched_g0,matched_b0,matched_g1,matched_b1,zero_local,zero_local_b) &&
       replay_global_hash==e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,zero_local,zero_local_b) &&
       replay_local_hash==e51ah_model_hash(replay_g0,replay_b0,replay_g1,replay_b1,replay_local_w,replay_local_b)){ residual_frozen_gate=1; }
    if(residual_frozen_gate!=1){ frozen_final_gate=0; }
    e45_print_pair("e51ah_residual_frozen_gate",residual_frozen_gate);
    let integrity:i32=0;
    if(pre_validation_integrity==1 && validation_integrity==1 && confirmation_integrity==1 && frozen_final_gate==1){ integrity=1; }
    e45_print_pair("e51ah_frozen_final_gate",frozen_final_gate);
    e45_print_pair("e51ah_integrity_gate",integrity);
    e45_print_pair("e51ah_parent_global_parameter_count",2*(E45_FEATURES+1));
    e45_print_pair("e51ah_replay_global_parameter_count",2*(E45_FEATURES+1));
    e45_print_pair("e51ah_replay_local_parameter_count",E51AB_CANDIDATES*E51AH_CELLS*(E45_FEATURES+1));

    let outcome:i32=0;
    if(pre_validation_integrity!=1 || validation_integrity!=1 || confirmation_integrity!=1 || frozen_final_gate!=1){
        _zag_println("e51ah_outcome,INVALID_E51AH_INTEGRITY_FAILURE");
    }else{
        if(development_open_gate!=1){
            _zag_println("e51ah_outcome,PRESERVATION_REPLAY_DEVELOPMENT_FAILURE");
        }else{
            if(exact_winner>=E51AH_ARM_REPLAY_GLOBAL){
                if(confirmation_exact==1){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_EXACT_CONFIRMED"); outcome=1;
                }else{ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_EXACT_NOT_CONFIRMED"); }
            }else{
                if(pareto_winner>=E51AH_ARM_REPLAY_GLOBAL){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_PARETO_IMPROVEMENT");
                }else{
                    if(tradeoff_signal==1){ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_TRADEOFF");
                    }else{ _zag_println("e51ah_outcome,PRESERVATION_REPLAY_NO_GAIN"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51AH_EXECUTION_COMPLETE=1");

    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb);
    zfree(dev_control); zfree(dev_direct); zfree(slot_success); zfree(direct_success); zfree(base_kinds); zfree(accessible); zfree(kinds);
    zfree(zero_g0); zfree(zero_g1); zfree(zero_local); zfree(zero_local_b);
    zfree(critical); zfree(ct0); zfree(ct1); zfree(csupport);
    zfree(parent_g0); zfree(parent_rg0); zfree(parent_g1); zfree(parent_rg1);
    zfree(replay_records); zfree(replay_t0); zfree(replay_t1); zfree(replay_support); zfree(replay_kind_support);
    zfree(matched_records); zfree(matched_t0); zfree(matched_t1);
    zfree(matched_g0); zfree(matched_rg0); zfree(matched_g1); zfree(matched_rg1);
    zfree(replay_g0); zfree(replay_rg0); zfree(replay_g1); zfree(replay_rg1);
    zfree(replay_local_w); zfree(replay_local_b); zfree(replay_rlocal_w); zfree(replay_rlocal_b);
    return outcome;
}

// R32 E51AH — grounded preservation replay and matched-count controls.
// This fragment adds no learner-visible identifiers and changes no topology.

const E51AH_ARM_PARENT_GLOBAL:i32=1;
const E51AH_ARM_COUNT_MATCHED_GLOBAL:i32=2;
const E51AH_ARM_REPLAY_GLOBAL:i32=3;
const E51AH_ARM_REPLAY_LOCAL_384:i32=4;
const E51AH_ARM_ORACLE:i32=5;
const E51AH_PAIRED_FIELDS:i32=2;
const E51AH_PAIRED_GAIN:i32=0;
const E51AH_PAIRED_LOSS:i32=1;

// Verifier-only arm selection and outcome classification. No learner inputs.
fn e51ah_select_replay_arm(global_gate:i32,local_gate:i32)i32 {
    if(global_gate==1){ return E51AH_ARM_REPLAY_GLOBAL; }
    if(local_gate==1){ return E51AH_ARM_REPLAY_LOCAL_384; }
    return -1;
}

// 1 exact, 2 paired-loss-free Pareto, 3 net category tradeoff, 0 no gain.
fn e51ah_validation_class(known:i32,no_unique:i32,control_known:i32,control_no_unique:i32,paired_loss:i32)i32 {
    if(known==4200 && no_unique==1200){ return 1; }
    if(known+no_unique>control_known+control_no_unique && known>control_known &&
       no_unique>=control_no_unique && paired_loss==0){ return 2; }
    if((known>control_known && no_unique<control_no_unique) ||
       (known<control_known && no_unique>control_no_unique)){ return 3; }
    return 0;
}

fn e51ah_classify_grounded_kinds(
    base_kinds:[]i32,
    direct_records:[]i32,
    accessible:[]i32,
    episodes:i32,
    kinds:[]i32,
    slot_count:*i32,
    direct_count:*i32,
    neither_positive:*i32,
    neither_no_warrant:*i32
)void {
    slot_count.*=0; direct_count.*=0; neither_positive.*=0; neither_no_warrant.*=0;
    let episode:i32=0;
    while(episode<episodes){
        if(base_kinds[episode]==E51AD_KIND_PRESERVE){
            kinds[episode]=E51AH_KIND_SLOT_COVERED;
            slot_count.*=slot_count.*+1;
        }else{
            if(base_kinds[episode]==E51AD_KIND_DIRECT_ONLY){
                kinds[episode]=E51AH_KIND_DIRECT_REQUIRED;
                direct_count.*=direct_count.*+1;
            }else{
                let positive:i32=0;
                let t:i32=0;
                while(t<=E45_TAPE){
                    let index:i32=episode*(E45_TAPE+1)+t;
                    if(accessible[index]==1){
                        let rs:i32=index*E50_RECORD_N;
                        if(e51ab_max_utility(direct_records,rs)>0){ positive=1; }
                    }
                    t=t+1;
                }
                if(positive==1){
                    kinds[episode]=E51AH_KIND_NEITHER_KNOWN;
                    neither_positive.*=neither_positive.*+1;
                }else{
                    kinds[episode]=E51AH_KIND_NEITHER_NU;
                    neither_no_warrant.*=neither_no_warrant.*+1;
                }
            }
        }
        episode=episode+1;
    }
}

fn e51ah_override_risk(
    control_records:[]i32,
    direct_records:[]i32,
    record_start:i32,
    term_global:[]i32,
    term_global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    term_expert_w:[]i32,
    term_expert_b:[]i32,
    g0:[]i32,
    b0:i32,
    g1:[]i32,
    b1:i32,
    direct_weights:[]i32,
    direct_biases:[]i32
)i32 {
    let slot_value:i32=e51ac_slot_scalar(
        control_records,record_start,term_global,term_global_bias,
        prototypes,parents,ranges,term_expert_w,term_expert_b
    );
    let protected_value:i32=slot_value;
    if(protected_value<0){ protected_value=0; }
    let q0:i32=0; let q1:i32=0;
    e51ac_direct_scores(
        direct_records,record_start,g0,b0,g1,b1,
        prototypes,parents,ranges,direct_weights,direct_biases,&q0,&q1
    );
    let highest:i32=q0; if(q1>highest){ highest=q1; }
    return highest-protected_value;
}

fn e51ah_select_preservation_replay(
    control_records:[]i32,
    direct_records:[]i32,
    episodes:i32,
    accessible:[]i32,
    slot_success:[]i32,
    direct_success:[]i32,
    kinds:[]i32,
    term_global:[]i32,
    term_global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    term_expert_w:[]i32,
    term_expert_b:[]i32,
    g0:[]i32,
    b0:i32,
    g1:[]i32,
    b1:i32,
    direct_weights:[]i32,
    direct_biases:[]i32,
    replay_records:[]i32,
    target0:[]i32,
    target1:[]i32,
    selected_count:*i32,
    trace_hash:*i32,
    target_support:[]i32,
    kind_support:[]i32
)void {
    selected_count.*=0; trace_hash.*=8101;
    e45_zero(target_support,6); e45_zero(kind_support,4);
    let episode:i32=0;
    while(episode<episodes){
        let kind:i32=kinds[episode];
        let selected:i32=-1; let best:i32=0;
        let t:i32=0;
        while(t<=E45_TAPE){
            let index:i32=episode*(E45_TAPE+1)+t;
            let eligible:i32=0;
            if(kind==E51AH_KIND_SLOT_COVERED){ eligible=slot_success[index];
            }else{
                if(kind==E51AH_KIND_DIRECT_REQUIRED){ eligible=direct_success[index];
                }else{
                    if(accessible[index]==1){
                        if(kind==E51AH_KIND_NEITHER_KNOWN){
                            let rs_known:i32=index*E50_RECORD_N;
                            if(e51ab_max_utility(direct_records,rs_known)>0){ eligible=1; }
                        }else{ eligible=1; }
                    }
                }
            }
            if(eligible==1){
                let rs:i32=index*E50_RECORD_N;
                let score:i32=0;
                if(kind==E51AH_KIND_SLOT_COVERED){
                    score=e51ah_override_risk(
                        control_records,direct_records,rs,
                        term_global,term_global_bias,prototypes,parents,ranges,
                        term_expert_w,term_expert_b,
                        g0,b0,g1,b1,direct_weights,direct_biases
                    );
                }else{
                    let q0:i32=0; let q1:i32=0;
                    e51ac_direct_scores(
                        direct_records,rs,g0,b0,g1,b1,
                        prototypes,parents,ranges,direct_weights,direct_biases,
                        &q0,&q1
                    );
                    score=e51ah_candidate_margin(q0,q1,direct_records,rs);
                }
                if(selected<0){ selected=index; best=score;
                }else{
                    if(kind==E51AH_KIND_DIRECT_REQUIRED){
                        if(score<best){ selected=index; best=score; }
                    }else{
                        if(score>best){ selected=index; best=score; }
                    }
                }
            }
            t=t+1;
        }
        if(selected>=0){
            let src:i32=selected*E50_RECORD_N;
            let dst:i32=selected_count.* * E50_RECORD_N;
            let c:i32=0;
            while(c<E50_RECORD_N){ replay_records[dst+c]=direct_records[src+c]; c=c+1; }
            let f0:i32=0; let f1:i32=0;
            e51ac_direct_scores(
                direct_records,src,g0,b0,g1,b1,
                prototypes,parents,ranges,direct_weights,direct_biases,&f0,&f1
            );
            let r0:i32=direct_records[src+34]-f0;
            let r1:i32=direct_records[src+35]-f1;
            replay_records[dst+34]=0; replay_records[dst+35]=0;
            replay_records[dst+36]=0; replay_records[dst+37]=0;
            target0[selected_count.*]=r0; target1[selected_count.*]=r1;
            if(r0>0){ target_support[0]=target_support[0]+1;
            }else{ if(r0<0){ target_support[1]=target_support[1]+1;
                }else{ target_support[2]=target_support[2]+1; } }
            if(r1>0){ target_support[3]=target_support[3]+1;
            }else{ if(r1<0){ target_support[4]=target_support[4]+1;
                }else{ target_support[5]=target_support[5]+1; } }
            kind_support[kind]=kind_support[kind]+1;
            selected_count.*=selected_count.*+1;
            trace_hash.*=e46_hash_update(trace_hash.*,episode);
            trace_hash.*=e46_hash_update(trace_hash.*,kind);
            trace_hash.*=e46_hash_update(trace_hash.*,selected);
            trace_hash.*=e46_hash_update(trace_hash.*,best);
            trace_hash.*=e46_hash_update(trace_hash.*,r0);
            trace_hash.*=e46_hash_update(trace_hash.*,r1);
        }
        episode=episode+1;
    }
}

fn e51ah_repeat_critical(
    source_records:[]i32,
    source_target0:[]i32,
    source_target1:[]i32,
    source_count:i32,
    repeated_records:[]i32,
    repeated_target0:[]i32,
    repeated_target1:[]i32,
    repeated_count:i32,
    trace_hash:*i32
)void {
    trace_hash.*=8209;
    if(source_count<=0 || repeated_count<0){ return; }
    let i:i32=0;
    while(i<repeated_count){
        let source:i32=e45_mod(i,source_count);
        let src:i32=source*E50_RECORD_N;
        let dst:i32=i*E50_RECORD_N;
        let c:i32=0;
        while(c<E50_RECORD_N){ repeated_records[dst+c]=source_records[src+c]; c=c+1; }
        repeated_target0[i]=source_target0[source];
        repeated_target1[i]=source_target1[source];
        trace_hash.*=e46_hash_update(trace_hash.*,source);
        trace_hash.*=e46_hash_update(trace_hash.*,repeated_target0[i]);
        trace_hash.*=e46_hash_update(trace_hash.*,repeated_target1[i]);
        i=i+1;
    }
}

fn e51ah_eval_partition(
    stage:i32,
    episodes:i32,
    per_cell:i32,
    active_arm:i32,
    control_records:[]i32,
    direct_records:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    term_global:[]i32,
    term_global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    term_expert_w:[]i32,
    term_expert_b:[]i32,
    g0:[]i32,
    b0:i32,
    g1:[]i32,
    b1:i32,
    direct_weights:[]i32,
    direct_biases:[]i32,
    parent_g0:[]i32,
    parent_b0:i32,
    parent_g1:[]i32,
    parent_b1:i32,
    matched_g0:[]i32,
    matched_b0:i32,
    matched_g1:[]i32,
    matched_b1:i32,
    replay_g0:[]i32,
    replay_b0:i32,
    replay_g1:[]i32,
    replay_b1:i32,
    replay_local_w:[]i32,
    replay_local_b:[]i32,
    zero_local_w:[]i32,
    zero_local_b:[]i32,
    result:[]i32,
    mode_reach:[]i32,
    resource_reach:[]i32,
    paired:[]i32
)void {
    e45_zero(result,E51AH_ARMS*E51AH_FIELDS);
    e45_zero(mode_reach,E51AH_ARMS*E45_MODES);
    e45_zero(resource_reach,E51AH_ARMS*E45_RESOURCES);
    e45_zero(paired,E51AH_ARMS*E51AH_PAIRED_FIELDS);
    let accessible:[]i32=zalloc_i(episodes*(E45_TAPE+1));
    e51ah_build_accessible(stage,episodes,per_cell,accessible);
    let slot_success:[]i32=zalloc_i(episodes*(E45_TAPE+1));
    let direct_success:[]i32=zalloc_i(episodes*(E45_TAPE+1));
    let base_kinds:[]i32=zalloc_i(episodes);
    let pc:i32=0; let dc:i32=0; let nc:i32=0;
    e51ad_prepare_support(
        stage,episodes,per_cell,control_records,direct_records,
        terminal_weights,terminal_biases,term_global,term_global_bias,
        prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_weights,direct_biases,
        slot_success,direct_success,base_kinds,&pc,&dc,&nc
    );
    let episode_reached:[]i32=zalloc_i(E51AH_ARMS*episodes);
    e45_zero(episode_reached,E51AH_ARMS*episodes);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES);
        let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
        let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let arm_lo:i32=0; let arm_hi:i32=E51AH_ARMS;
        if(active_arm>=0){ arm_lo=active_arm; arm_hi=active_arm+1; }
        let arm:i32=arm_lo;
        while(arm<arm_hi){
            let s:i32=arm*E51AH_FIELDS;
            result[s+E51AH_EPISODES]=result[s+E51AH_EPISODES]+1;
            if(no_unique==1){ result[s+E51AH_NO_UNIQUE]=result[s+E51AH_NO_UNIQUE]+1;
            }else{ result[s+E51AH_KNOWN]=result[s+E51AH_KNOWN]+1; }
            let reached:i32=0; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t;
                if(accessible[index]==1){
                    let rs:i32=index*E50_RECORD_N;
                    let success:i32=0; let choice:i32=R32E45_TERM_UNKNOWN;
                    if(arm==E51AH_ARM_UNION_CONTROL){
                        if(slot_success[index]==1 || direct_success[index]==1){ success=1; }
                    }else{
                        if(arm==E51AH_ARM_ORACLE){
                            let oracle_value:i32=0;
                            if(direct_records[rs+34]>oracle_value){ choice=E51AC_CHOICE_CANDIDATE_0; oracle_value=direct_records[rs+34]; }
                            if(direct_records[rs+35]>oracle_value){ choice=E51AC_CHOICE_CANDIDATE_1; }
                            success=e51ac_choice_success(choice,control_records,direct_records,rs);
                        }else{
                            let rg0:[]i32=parent_g0; let rb0:i32=parent_b0;
                            let rg1:[]i32=parent_g1; let rb1:i32=parent_b1;
                            let local_active:i32=0;
                            let lw:[]i32=zero_local_w; let lb:[]i32=zero_local_b;
                            if(arm==E51AH_ARM_COUNT_MATCHED_GLOBAL){
                                rg0=matched_g0; rb0=matched_b0; rg1=matched_g1; rb1=matched_b1;
                            }
                            if(arm==E51AH_ARM_REPLAY_GLOBAL){
                                rg0=replay_g0; rb0=replay_b0; rg1=replay_g1; rb1=replay_b1;
                            }
                            if(arm==E51AH_ARM_REPLAY_LOCAL_384){
                                rg0=replay_g0; rb0=replay_b0; rg1=replay_g1; rb1=replay_b1;
                                local_active=1; lw=replay_local_w; lb=replay_local_b;
                            }
                            choice=e51ah_policy_choice(
                                local_active,control_records,direct_records,rs,
                                terminal_weights,terminal_biases,term_global,term_global_bias,
                                prototypes,parents,ranges,term_expert_w,term_expert_b,
                                g0,b0,g1,b1,direct_weights,direct_biases,
                                rg0,rb0,rg1,rb1,lw,lb
                            );
                            success=e51ac_choice_success(choice,control_records,direct_records,rs);
                        }
                    }
                    if(t==0){
                        if(success==1){ result[s+E51AH_T0_SUCCESS]=result[s+E51AH_T0_SUCCESS]+1;
                        }else{
                            if(arm>=E51AH_ARM_PARENT_GLOBAL && arm<=E51AH_ARM_ORACLE){
                                if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AH_T0_UNKNOWN]=result[s+E51AH_T0_UNKNOWN]+1;
                                }else{ result[s+E51AH_T0_WRONG]=result[s+E51AH_T0_WRONG]+1; }
                            }
                        }
                    }
                    if(success==1){ reached=1; }
                }
                t=t+1;
            }
            episode_reached[arm*episodes+episode]=reached;
            if(reached==1){
                result[s+E51AH_REACHABLE]=result[s+E51AH_REACHABLE]+1;
                mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1;
                resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1;
                if(no_unique==1){ result[s+E51AH_NO_UNIQUE_REACHABLE]=result[s+E51AH_NO_UNIQUE_REACHABLE]+1;
                }else{ result[s+E51AH_KNOWN_REACHABLE]=result[s+E51AH_KNOWN_REACHABLE]+1; }
            }
            arm=arm+1;
        }
        episode=episode+1;
    }
    if(active_arm<0){
        let arm:i32=1;
        while(arm<E51AH_ARMS){
            episode=0;
            while(episode<episodes){
                let control:i32=episode_reached[E51AH_ARM_UNION_CONTROL*episodes+episode];
                let treatment:i32=episode_reached[arm*episodes+episode];
                if(control==0 && treatment==1){ paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_GAIN]=paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_GAIN]+1; }
                if(control==1 && treatment==0){ paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_LOSS]=paired[arm*E51AH_PAIRED_FIELDS+E51AH_PAIRED_LOSS]+1; }
                episode=episode+1;
            }
            arm=arm+1;
        }
    }
    zfree(accessible); zfree(slot_success); zfree(direct_success); zfree(base_kinds); zfree(episode_reached);
}

fn e51ah_print_result(prefix:[]u8,result:[]i32,arm:i32)void {
    let s:i32=arm*E51AH_FIELDS;
    _zag_print(prefix); _zag_print(","); e45_print_i32(arm);
    let f:i32=0;
    while(f<E51AH_FIELDS){ _zag_print(","); e45_print_i32(result[s+f]); f=f+1; }
    _zag_println("");
}

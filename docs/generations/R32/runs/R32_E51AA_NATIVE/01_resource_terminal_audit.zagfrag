// R32 E51AA — evaluator-only decomposition of resource-feasible terminal misses.
const E51AA_STAGE:i32=88;
const E51AA_PREVIOUS_STAGE:i32=87;
const E51AA_EPISODES:i32=5400;
const E51AA_SAMPLES:i32=91800;
const E51AA_PER_CELL:i32=20;
const E51AA_HASH_SIZE:i32=16381;
const E51AA_CELL_FIELDS:i32=5;

fn e51aa_feature_equal(records:[]i32,a:i32,b:i32)i32 {
    let f:i32=0; while(f<E45_FEATURES){ if(e50_batch_column(records,a,f+1,0)!=e50_batch_column(records,b,f+1,0)){ return 0; } f=f+1; } return 1;
}
fn e51aa_feature_hash(records:[]i32,start:i32)i32 {
    let h:i32=8801; let f:i32=0; while(f<E45_FEATURES){ h=e46_hash_update(h,e50_batch_column(records,start,f+1,0)); f=f+1; } return h;
}
fn e51aa_cell(mode:i32,resource:i32)i32 { return (mode*E45_RESOURCES+resource)*E51AA_CELL_FIELDS; }

fn e51aa_audit(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,expert_biases:[]i32
)i32 {
    _zag_println("R32_E51AA_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51aa_resource_feasible_terminal_decomposition_v1");
    _zag_println("claim_boundary,evaluator_only_terminal_decomposition_not_cognitive_change");
    _zag_println("native_zag_v2_only=1"); _zag_println("learner_updates_stage88=0"); _zag_println("evaluator_truth_exposed=0"); _zag_println("audit_category_exposed=0"); _zag_println("topology_changed=0"); _zag_println("graph_privileged=0");

    let lo:i32=e51n_world_id(E51AA_STAGE,0); let hi:i32=e51n_world_id(E51AA_STAGE,E51AA_EPISODES-1); let prev:i32=e51n_world_id(E51AA_PREVIOUS_STAGE,E51AA_EPISODES-1);
    let world_gate:i32=0; if(prev<lo){ world_gate=1; }
    let domain_gate:i32=1; let d:i32=0;
    while(d<5){ let dlo:i64=e51n_domain_state(lo,d); let dhi:i64=e51n_domain_state(hi,d); if(dlo<=0 || dhi>=E51N_RNG_MOD){ domain_gate=0; } let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(lo,o); let ohi:i64=e51n_domain_state(hi,o); if(!(dhi<olo || ohi<dlo)){ domain_gate=0; } o=o+1; } d=d+1; }
    e45_print_pair("e51aa_world_id_lo",lo); e45_print_pair("e51aa_world_id_hi",hi); e45_print_pair("e51aa_world_partition_gate",world_gate); e45_print_pair("e51aa_domain_gate",domain_gate); e45_print_pair("e51aa_world_assignment_failures",0);

    let hash_before:i32=e51y_terminal_hash(terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,expert_weights,expert_biases);
    let records:[]i32=zalloc_i(E51AA_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51AA_SAMPLES*E50_RECORD_N); e45_zero(records,E51AA_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51AA_SAMPLES*E50_RECORD_N);
    let unknown_nonzero:i32=0; let cp:i32=0; let cn:i32=0; let built:i32=0; let ep:i32=0;
    while(ep<E51AA_EPISODES){ let resource:i32=e45_mod(ep/E51AA_PER_CELL,E45_RESOURCES); let mode:i32=e45_mod(ep/(E45_RESOURCES*E51AA_PER_CELL),E45_MODES); e51e_build_training_episode(e51n_world_id(E51AA_STAGE,ep),mode,resource,ep,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,records,dummy,&unknown_nonzero,&cp,&cn); built=built+1; ep=ep+1; }
    zfree(dummy);

    let frozen_success:i32=0; let frozen_missing:i32=0; let frozen_missing_known:i32=0; let frozen_missing_nu:i32=0;
    let known_top_capable:i32=0; let known_any_action_capable:i32=0; let scalar_only_missing:i32=0; let ranking_missing:i32=0; let support_missing:i32=0;
    let critical_rows:i32=0; let duplicate_critical:i32=0; let conflict_keys:i32=0; let conflict_rows:i32=0;
    let slot_record:[]i32=zalloc_i(E51AA_HASH_SIZE); let slot_label:[]i32=zalloc_i(E51AA_HASH_SIZE); e45_zero(slot_record,E51AA_HASH_SIZE); e45_zero(slot_label,E51AA_HASH_SIZE);
    let cells:[]i32=zalloc_i(E45_MODES*E45_RESOURCES*E51AA_CELL_FIELDS); e45_zero(cells,E45_MODES*E45_RESOURCES*E51AA_CELL_FIELDS);

    ep=0;
    while(ep<E51AA_EPISODES){
        let resource:i32=e45_mod(ep/E51AA_PER_CELL,E45_RESOURCES); let mode:i32=e45_mod(ep/(E45_RESOURCES*E51AA_PER_CELL),E45_MODES); let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0; e51n_make_resource(e51n_world_id(E51AA_STAGE,ep),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost); e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let accessible:i32=1; let frozen_ok:i32=0; let top_ok:i32=0; let any_action_ok:i32=0; let critical:i32=-1; let critical_score:i32=0; if(no_unique==0){ critical_score=-5000; }else{ critical_score=5000; }
        let t:i32=0;
        while(t<=E45_TAPE){
            if(accessible==1){
                let rs:i32=(ep*(E45_TAPE+1)+t)*E50_RECORD_N; let top:i32=e51m_top_commit(records,rs,terminal_weights,terminal_biases); let top_utility:i32=records[rs+34+top];
                let scalar:i32=e51p_expert_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,E51Y_CELLS,expert_weights,0,expert_biases,0);
                if(no_unique==1){
                    if(scalar<0){ frozen_ok=1; }
                    if(critical<0 || scalar<critical_score){ critical=t; critical_score=scalar; }
                }else{
                    if(top_utility==1000){ top_ok=1; if(scalar>=0){ frozen_ok=1; } if(critical<0 || scalar>critical_score){ critical=t; critical_score=scalar; } }
                    let a:i32=0; while(a<3){ if(records[rs+34+a]==1000){ any_action_ok=1; } a=a+1; }
                }
            }
            if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
            t=t+1;
        }
        let c:i32=e51aa_cell(mode,resource); cells[c]=cells[c]+1;
        if(frozen_ok==1){ frozen_success=frozen_success+1;
        }else{
            frozen_missing=frozen_missing+1; cells[c+1]=cells[c+1]+1;
            if(no_unique==1){ frozen_missing_nu=frozen_missing_nu+1; scalar_only_missing=scalar_only_missing+1; cells[c+2]=cells[c+2]+1;
            }else{
                frozen_missing_known=frozen_missing_known+1;
                if(top_ok==1){ scalar_only_missing=scalar_only_missing+1; cells[c+2]=cells[c+2]+1;
                }else{ if(any_action_ok==1){ ranking_missing=ranking_missing+1; cells[c+3]=cells[c+3]+1; }else{ support_missing=support_missing+1; cells[c+4]=cells[c+4]+1; } }
            }
        }
        if(no_unique==0){ if(top_ok==1){ known_top_capable=known_top_capable+1; } if(any_action_ok==1){ known_any_action_capable=known_any_action_capable+1; } }

        if(critical>=0){
            critical_rows=critical_rows+1; let rs:i32=(ep*(E45_TAPE+1)+critical)*E50_RECORD_N; let label:i32=-1; if(no_unique==0){ label=1; }
            let h:i32=e51aa_feature_hash(records,rs); let slot:i32=e45_mod(h,E51AA_HASH_SIZE); let probes:i32=0; let done:i32=0;
            while(done==0 && probes<E51AA_HASH_SIZE){
                if(slot_record[slot]==0){ slot_record[slot]=ep*(E45_TAPE+1)+critical+1; slot_label[slot]=label; done=1;
                }else{ let prior:i32=slot_record[slot]-1; if(e51aa_feature_equal(records,rs,prior*E50_RECORD_N)==1){ duplicate_critical=duplicate_critical+1; if(slot_label[slot]!=label){ if(slot_label[slot]!=2){ conflict_keys=conflict_keys+1; } slot_label[slot]=2; conflict_rows=conflict_rows+1; } done=1; }else{ slot=e45_mod(slot+1,E51AA_HASH_SIZE); probes=probes+1; } }
            }
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible); ep=ep+1;
    }

    let hash_after:i32=e51y_terminal_hash(terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,expert_weights,expert_biases); let frozen_gate:i32=0; if(hash_before==hash_after){ frozen_gate=1; }
    let count_gate:i32=0; if(built==E51AA_EPISODES && built*(E45_TAPE+1)==E51AA_SAMPLES){ count_gate=1; } let integrity:i32=0; if(world_gate==1 && domain_gate==1 && count_gate==1 && unknown_nonzero==0 && frozen_gate==1){ integrity=1; }
    let scalar_ceiling:i32=1200+known_top_capable;
    e45_print_pair("e51aa_episodes_built",built); e45_print_pair("e51aa_states_built",built*(E45_TAPE+1)); e45_print_pair("e51aa_unknown_target_nonzero",unknown_nonzero); e45_print_pair("e51aa_terminal_hash_before",hash_before); e45_print_pair("e51aa_terminal_hash_after",hash_after); e45_print_pair("e51aa_frozen_parameter_gate",frozen_gate); e45_print_pair("e51aa_integrity_gate",integrity);
    e45_print_pair("e51aa_frozen_cost_feasible_success",frozen_success); e45_print_pair("e51aa_frozen_cost_feasible_missing",frozen_missing); e45_print_pair("e51aa_frozen_missing_known",frozen_missing_known); e45_print_pair("e51aa_frozen_missing_no_unique",frozen_missing_nu);
    e45_print_pair("e51aa_known_top_commit_feasible_ceiling",known_top_capable); e45_print_pair("e51aa_known_any_commit_action_feasible_ceiling",known_any_action_capable); e45_print_pair("e51aa_scalar_only_missing",scalar_only_missing); e45_print_pair("e51aa_commit_ranking_missing",ranking_missing); e45_print_pair("e51aa_action_support_missing",support_missing); e45_print_pair("e51aa_scalar_theoretical_episode_ceiling",scalar_ceiling);
    e45_print_pair("e51aa_critical_rows",critical_rows); e45_print_pair("e51aa_critical_duplicate_rows",duplicate_critical); e45_print_pair("e51aa_critical_conflict_keys",conflict_keys); e45_print_pair("e51aa_critical_conflict_rows",conflict_rows);
    _zag_println("e51aa_cell_columns,mode,resource,total,frozen_missing,scalar_only_missing,ranking_missing,action_support_missing"); let mode:i32=0; while(mode<E45_MODES){ let resource:i32=0; while(resource<E45_RESOURCES){ let c:i32=e51aa_cell(mode,resource); _zag_print("e51aa_cell,"); e45_print_i32(mode); _zag_print(","); e45_print_i32(resource); let k:i32=0; while(k<E51AA_CELL_FIELDS){ _zag_print(","); e45_print_i32(cells[c+k]); k=k+1; } _zag_println(""); resource=resource+1; } mode=mode+1; }

    if(integrity==0){ _zag_println("e51aa_outcome,INVALID_E51AA_INTEGRITY_FAILURE");
    }else{
        let non_scalar:i32=0; if(ranking_missing>0){ non_scalar=non_scalar+1; } if(support_missing>0){ non_scalar=non_scalar+1; } if(conflict_keys>0){ non_scalar=non_scalar+1; }
        if(non_scalar>1){ _zag_println("e51aa_outcome,MIXED_RESOURCE_FEASIBLE_TERMINAL_LIMIT");
        }else{ if(support_missing>0){ _zag_println("e51aa_outcome,RESOURCE_FEASIBLE_ACTION_SUPPORT_VETO");
            }else{ if(ranking_missing>0){ _zag_println("e51aa_outcome,RESOURCE_FEASIBLE_COMMIT_RANKING_REQUIRED");
                }else{ if(conflict_keys>0){ _zag_println("e51aa_outcome,RESOURCE_FEASIBLE_CRITICAL_ALIAS");
                    }else{ _zag_println("e51aa_outcome,RESOURCE_FEASIBLE_SCALAR_RESCUE_POSSIBLE"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51AA_AUDIT_COMPLETE=1");
    zfree(records); zfree(slot_record); zfree(slot_label); zfree(cells);
    if(integrity==1){ return 1; } return 0;
}

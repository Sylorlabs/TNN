// R32 E51T — paired 96-vs-192 sweep stability audit on fresh stage-71 worlds.

const E51T_AUDIT_EPISODES:i32=5400;
const E51T_AUDIT_SAMPLES:i32=91800;
const E51T_STAGE_AUDIT:i32=71;
const E51T_PAIR_FIELDS:i32=10;
const E51T_MODE_FIELDS:i32=5;

fn e51t_switch_mode(mode:i32)i32 {
    if(mode==3 || mode==4 || mode==5 || mode==7 || mode==8){ return 1; }
    return 0;
}

fn e51t_allocate_audit_worlds(worlds:[]i32)i32 {
    let i:i32=0;
    while(i<E51T_AUDIT_EPISODES){ worlds[i]=e51n_world_id(E51T_STAGE_AUDIT,i); i=i+1; }
    let lo:i32=worlds[0]; let hi:i32=worlds[E51T_AUDIT_EPISODES-1];
    let domain_gate:i32=1; let domain:i32=0;
    while(domain<5){
        let dlo:i64=e51n_domain_state(lo,domain); let dhi:i64=e51n_domain_state(hi,domain);
        if(dlo<=0 || dhi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let olo:i64=e51n_domain_state(lo,other); let ohi:i64=e51n_domain_state(hi,other);
            if(!(dhi<olo || ohi<dlo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51t_audit_world_lo",lo); e45_print_pair("e51t_audit_world_hi",hi); e45_print_pair("e51t_audit_domain_gate",domain_gate);
    return domain_gate;
}

fn e51t_snapshot_episode_reached(
    records:[]i32,
    episode:i32,
    no_unique:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    global_weights:[]i32,
    global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    snapshot_weights:[]i32,
    snapshot_biases:[]i32,
    snapshot:i32
)i32 {
    let ws:i32=snapshot*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=snapshot*E51P_MAX_CELLS;
    let t:i32=0;
    while(t<=E45_TAPE){
        let record_start:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
        let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
        let score:i32=e51p_expert_predict(records,record_start,global_weights,global_bias,prototypes,parents,ranges,E51S_CELLS,snapshot_weights,ws,snapshot_biases,bs);
        if(no_unique==1){ if(score<0){ return 1; }
        }else{ if(score>=0 && records[record_start+34+action]==1000){ return 1; } }
        t=t+1;
    }
    return 0;
}

fn e51t_pair_audit(
    records:[]i32,
    episode_types:[]i32,
    episode_modes:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    global_weights:[]i32,
    global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    snapshot_weights:[]i32,
    snapshot_biases:[]i32,
    pair:[]i32,
    modes:[]i32,
    switch_metrics:[]i32
)void {
    e45_zero(pair,E51T_PAIR_FIELDS); e45_zero(modes,E45_MODES*E51T_MODE_FIELDS); e45_zero(switch_metrics,E51T_MODE_FIELDS);
    let episode:i32=0;
    while(episode<E51T_AUDIT_EPISODES){
        let no_unique:i32=episode_types[episode]; let mode:i32=episode_modes[episode];
        let s96:i32=e51t_snapshot_episode_reached(records,episode,no_unique,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,snapshot_weights,snapshot_biases,1);
        let s192:i32=e51t_snapshot_episode_reached(records,episode,no_unique,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,snapshot_weights,snapshot_biases,2);
        let gained:i32=0; let lost:i32=0;
        if(s96==0 && s192==1){ gained=1; }
        if(s96==1 && s192==0){ lost=1; }
        if(no_unique==1){
            pair[5]=pair[5]+1; pair[6]=pair[6]+s96; pair[7]=pair[7]+s192; pair[8]=pair[8]+gained; pair[9]=pair[9]+lost;
        }else{
            pair[0]=pair[0]+1; pair[1]=pair[1]+s96; pair[2]=pair[2]+s192; pair[3]=pair[3]+gained; pair[4]=pair[4]+lost;
        }
        let ms:i32=mode*E51T_MODE_FIELDS;
        modes[ms]=modes[ms]+1; modes[ms+1]=modes[ms+1]+s96; modes[ms+2]=modes[ms+2]+s192; modes[ms+3]=modes[ms+3]+gained; modes[ms+4]=modes[ms+4]+lost;
        if(e51t_switch_mode(mode)==1){
            switch_metrics[0]=switch_metrics[0]+1; switch_metrics[1]=switch_metrics[1]+s96; switch_metrics[2]=switch_metrics[2]+s192; switch_metrics[3]=switch_metrics[3]+gained; switch_metrics[4]=switch_metrics[4]+lost;
        }
        episode=episode+1;
    }
}

fn e51t_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51T_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51t_paired_optimization_stability_audit_v1");
    _zag_println("claim_boundary,native_parameter_frozen_stability_audit_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("learner_updates_on_audit=0");
    _zag_println("evaluator_mode_exposed_to_learner=0");
    _zag_println("evaluator_truth_exposed_to_learner=0");
    _zag_println("interaction_capacity_added=0");
    _zag_println("global_topology_changed=0");
    _zag_println("graph_privileged=0");

    // Reconstruct exact E51S stage-68 development learner.
    let dev_worlds:[]i32=zalloc_i(E51S_DEV_EPISODES); let ignored_validation:[]i32=zalloc_i(E51S_VALIDATION_EPISODES); let ignored_confirmation:[]i32=zalloc_i(E51S_CONFIRM_EPISODES);
    let world_gate:i32=e51s_allocate_worlds(dev_worlds,ignored_validation,ignored_confirmation);
    let dev_records:[]i32=zalloc_i(E51S_DEV_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51S_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51S_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51S_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0; let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy);
    e45_print_pair("e51t_reconstruction_development_episodes",canonical_episode); e45_print_pair("e51t_reconstruction_unknown_target_nonzero",dev_unknown_nonzero);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0; while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }

    let sign_targets:[]i32=zalloc_i(E51S_DEV_SAMPLES); let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51S_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51S_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51S_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let linear_identity_gate:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_f:i32=0; let tree_trace_f:i32=0; let tree_loss_f:i64=0; let tree_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tree_count_f,&tree_trace_f,&tree_loss_f,&tree_strict_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_r:i32=0; let tree_trace_r:i32=0; let tree_loss_r:i64=0; let tree_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tree_count_r,&tree_trace_r,&tree_loss_r,&tree_strict_r);
    let tree_identity_gate:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tree_count_f,tree_trace_f,tree_loss_f,tree_strict_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tree_count_r,tree_trace_r,tree_loss_r,tree_strict_r);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51S_DEV_SAMPLES,root,ranges);

    let sw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let sb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let su:[]i32=zalloc_i(E51S_SNAPSHOTS); let ss:[]i32=zalloc_i(E51S_SNAPSHOTS); let sr:[]i32=zalloc_i(E51S_SNAPSHOTS); let st:[]i32=zalloc_i(E51S_SNAPSHOTS); let sll:[]i32=zalloc_i(E51S_SNAPSHOTS); let slh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_f:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,0,sw,sb,su,ss,sr,st,sll,slh,&strict_f);
    let rw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let rb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let ru:[]i32=zalloc_i(E51S_SNAPSHOTS); let rs:[]i32=zalloc_i(E51S_SNAPSHOTS); let rr:[]i32=zalloc_i(E51S_SNAPSHOTS); let rt:[]i32=zalloc_i(E51S_SNAPSHOTS); let rll:[]i32=zalloc_i(E51S_SNAPSHOTS); let rlh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_r:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,1,rw,rb,ru,rs,rr,rt,rll,rlh,&strict_r);
    let snapshot_identity_gate:i32=e51s_snapshots_identity(sw,sb,su,ss,sr,st,sll,slh,rw,rb,ru,rs,rr,rt,rll,rlh);
    _zag_print("e51t_reconstructed_snapshots,"); e45_print_i32(ss[1]); _zag_print(","); e45_print_i32(su[1]); _zag_print(","); e45_print_i32(st[1]); _zag_print(","); e45_print_i32(ss[2]); _zag_print(","); e45_print_i32(su[2]); _zag_print(","); e45_print_i32(st[2]); _zag_println("");

    // Fresh parameter-frozen stage-71 audit.
    let audit_worlds:[]i32=zalloc_i(E51T_AUDIT_EPISODES); let audit_world_gate:i32=e51t_allocate_audit_worlds(audit_worlds);
    let audit_records:[]i32=zalloc_i(E51T_AUDIT_SAMPLES*E50_RECORD_N); let audit_dummy:[]i32=zalloc_i(E51T_AUDIT_SAMPLES*E50_RECORD_N); let audit_types:[]i32=zalloc_i(E51T_AUDIT_EPISODES); let audit_modes:[]i32=zalloc_i(E51T_AUDIT_EPISODES);
    e45_zero(audit_records,E51T_AUDIT_SAMPLES*E50_RECORD_N); e45_zero(audit_dummy,E51T_AUDIT_SAMPLES*E50_RECORD_N);
    let audit_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    audit_types[canonical_episode]=0; if(mode==0 || mode==1){ audit_types[canonical_episode]=1; }
                    audit_modes[canonical_episode]=mode;
                    e51e_build_training_episode(audit_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,audit_records,audit_dummy,&audit_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(audit_dummy);
    let pair:[]i32=zalloc_i(E51T_PAIR_FIELDS); let modes:[]i32=zalloc_i(E45_MODES*E51T_MODE_FIELDS); let switch_metrics:[]i32=zalloc_i(E51T_MODE_FIELDS);
    e51t_pair_audit(audit_records,audit_types,audit_modes,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,sw,sb,pair,modes,switch_metrics);
    _zag_print("e51t_pair_known,"); let k:i32=0; while(k<5){ e45_print_i32(pair[k]); if(k<4){ _zag_print(","); } k=k+1; } _zag_println("");
    _zag_print("e51t_pair_no_unique,"); k=5; while(k<10){ e45_print_i32(pair[k]); if(k<9){ _zag_print(","); } k=k+1; } _zag_println("");
    _zag_println("e51t_mode_columns,mode,total,success96,success192,gained,lost");
    let mode:i32=0; while(mode<E45_MODES){ let ms:i32=mode*E51T_MODE_FIELDS; _zag_print("e51t_mode,"); e45_print_i32(mode); k=0; while(k<E51T_MODE_FIELDS){ _zag_print(","); e45_print_i32(modes[ms+k]); k=k+1; } _zag_println(""); mode=mode+1; }
    _zag_print("e51t_switch_aggregate,"); k=0; while(k<E51T_MODE_FIELDS){ e45_print_i32(switch_metrics[k]); if(k+1<E51T_MODE_FIELDS){ _zag_print(","); } k=k+1; } _zag_println("");

    let counts_gate:i32=0; if(canonical_episode==E51T_AUDIT_EPISODES && canonical_episode*(E45_TAPE+1)==E51T_AUDIT_SAMPLES){ counts_gate=1; }
    let reconstruction_gate:i32=0; if(world_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && tree_identity_gate==1 && tree_count_f>=E51S_CELLS && snapshot_identity_gate==1 && strict_f==1 && strict_r==1 && ss[1]==96 && ss[2]==192 && dev_unknown_nonzero==0 && unknown_parameter_nonzero==0){ reconstruction_gate=1; }
    let audit_integrity_gate:i32=0; if(reconstruction_gate==1 && audit_world_gate==1 && counts_gate==1 && audit_unknown_nonzero==0){ audit_integrity_gate=1; }
    e45_print_pair("e51t_reconstruction_gate",reconstruction_gate); e45_print_pair("e51t_audit_counts_gate",counts_gate); e45_print_pair("e51t_audit_integrity_gate",audit_integrity_gate);

    let total_gained:i32=pair[3]+pair[8]; let total_lost:i32=pair[4]+pair[9];
    let strict_superset:i32=0; if(total_lost==0 && switch_metrics[4]==0 && total_gained>0){ strict_superset=1; }
    e45_print_pair("e51t_total_gained",total_gained); e45_print_pair("e51t_total_lost",total_lost); e45_print_pair("e51t_strict_superset_gate",strict_superset);
    if(audit_integrity_gate==0){ _zag_println("e51t_outcome,INVALID_PAIRED_STABILITY_AUDIT");
    }else{
        if(total_lost==0 && total_gained==0){ _zag_println("e51t_outcome,OPTIMIZATION_CAPABILITY_PLATEAU");
        }else{
            if(strict_superset==1){ _zag_println("e51t_outcome,STRICT_SUPERSET_OPTIMIZATION_SIGNAL");
            }else{
                if(total_lost>0 && total_gained==0){ _zag_println("e51t_outcome,OPTIMIZATION_REGRESSION");
                }else{ _zag_println("e51t_outcome,OPTIMIZATION_BOUNDARY_INSTABILITY"); }
            }
        }
    }
    _zag_println("TNN_R32_E51T_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(ignored_validation); zfree(ignored_confirmation); zfree(dev_records); zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases); zfree(sign_targets); zfree(global_weights); zfree(reverse_global);
    zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root);
    zfree(sw); zfree(sb); zfree(su); zfree(ss); zfree(sr); zfree(st); zfree(sll); zfree(slh); zfree(rw); zfree(rb); zfree(ru); zfree(rs); zfree(rr); zfree(rt); zfree(rll); zfree(rlh);
    zfree(audit_worlds); zfree(audit_records); zfree(audit_types); zfree(audit_modes); zfree(pair); zfree(modes); zfree(switch_metrics);
    if(audit_integrity_gate==1){ return 1; }
    return 0;
}

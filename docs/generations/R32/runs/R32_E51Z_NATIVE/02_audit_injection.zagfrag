    // E51Z is evaluator-only and runs after E51Y validation with every learner frozen.
    let e51z_completion:i32=e51z_audit(
        source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        terminal_weights,terminal_biases,term_global,term_global_bias,
        prototypes,parents,ranges,finalw,finalb,
        cont_global,cont_bias,cproto,cparents,cranges,cew,ceb
    );
    e45_print_pair("e51z_completion_gate",e51z_completion);

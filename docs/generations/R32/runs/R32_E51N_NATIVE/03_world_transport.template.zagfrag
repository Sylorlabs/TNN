__FUNCTION_KEYWORD__ e51n_world_ordinal(replica:i32,partition:i32,index:i32)__RETURN_SUFFIX__{
    if(replica<0 || replica>=3){return -1;}
    if(partition==0){
        if(index<0 || index>=6480){return -1;}
        return (replica*11880)+index;
    }
    if(partition==1){
        if(index<0 || index>=5400){return -1;}
        return (replica*11880)+6480+index;
    }
    return -1;
}

__FUNCTION_KEYWORD__ e51n_world_component_id(ordinal:i32,domain:i32)__RETURN_SUFFIX__{
    if(ordinal<0 || ordinal>=35640){return -1;}
    if(domain!=1 && domain!=3 && domain!=5 && domain!=7 && domain!=9){return -1;}
    return 2000003+(ordinal*16)+domain;
}

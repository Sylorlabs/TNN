// Corrected E51N truth-domain generator. The initial implementation consumed
// one extra RNG draw before historical-state construction; workflow assembly
// retires that definition and uses this exact two-draw version instead.
fn e51n_make_truth(
    world_id:i32,
    evaluator_mode:i32,
    truth_state:[]i32,
    historical_state:*i32
)void {
    let rng:i64=e51n_domain_state(world_id,0);
    let truth:i32=e51n_mod_i64(e51n_rng_next(&rng),2) as i32;
    historical_state.*=e51n_mod_i64(e51n_rng_next(&rng),2) as i32;
    let t:i32=0;
    while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    if(evaluator_mode==0 || evaluator_mode==1){
        t=0; while(t<=E45_TAPE){ truth_state[t]=R32E45_UNKNOWN; t=t+1; }
    }
    if(evaluator_mode==2 || evaluator_mode==6 || evaluator_mode==7 || evaluator_mode==8){ historical_state.*=truth; }
    if(evaluator_mode==3){
        historical_state.*=1-truth;
        truth_state[0]=e45_mod(world_id,2);
        t=1; while(t<=4){ truth_state[t]=e45_mod(t+world_id,2); t=t+1; }
        while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    }
    if(evaluator_mode==4){ historical_state.*=1-truth; }
    if(evaluator_mode==5){
        historical_state.*=truth;
        t=0; while(t<=5){ truth_state[t]=1-truth; t=t+1; }
        while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    }
}

    // E51N changes evaluator world/RNG transport only and runs only after the
    // same frozen E50 parent integrity contract used by E51M.
    let e51n_parent_integrity_gate:i32=0;
    if(seed_preflight_gate==1 && aux_clone_gate==1 && canonical_sample_count==E50_TERMINAL_SAMPLES && batch_bound_gate==1 && unknown_target_nonzero==0 && train_lattice_gate==1 && train_rep_gate==1 && batch_statistics_gate==1 && batch_identity_gate==1 && batch_converge_gate==1 && aux_frozen_gate==1){
        e51n_parent_integrity_gate=1;
    }
    e45_print_pair("e51n_parent_e50_integrity_gate",e51n_parent_integrity_gate);
    let e51n_completion:i32=0;
    if(e51n_parent_integrity_gate==1){
        e51n_completion=e51n_run(
            raw_seen,evidence_seen,resource_seen,
            frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,
            frozen_shadow,frozen_shadow_bias
        );
    }else{
        _zag_println("e51n_outcome,PARENT_E50_INTEGRITY_FAILED");
        _zag_println("TNN_R32_E51N_EXECUTION_COMPLETE=0");
    }
    if(e51n_completion==1){ return 0; }
    return 1;

    let e51n_exhaustive_ordinal:i32=0;
    let e51n_exhaustive_previous:i32=-1;
    let e51n_exhaustive_count:i32=0;
    let e51n_exhaustive_checksum:i32=0;
    let e51n_exhaustive_gate:i32=1;
    while(e51n_exhaustive_ordinal<35640){
        let e51n_exhaustive_truth:i32=e51n_world_component_id(e51n_exhaustive_ordinal,1);
        let e51n_exhaustive_history:i32=e51n_world_component_id(e51n_exhaustive_ordinal,3);
        let e51n_exhaustive_passive:i32=e51n_world_component_id(e51n_exhaustive_ordinal,5);
        let e51n_exhaustive_active:i32=e51n_world_component_id(e51n_exhaustive_ordinal,7);
        let e51n_exhaustive_resource:i32=e51n_world_component_id(e51n_exhaustive_ordinal,9);
        if(e51n_exhaustive_truth<=e51n_exhaustive_previous){e51n_exhaustive_gate=0;}
        if(e51n_exhaustive_history<=e51n_exhaustive_truth){e51n_exhaustive_gate=0;}
        if(e51n_exhaustive_passive<=e51n_exhaustive_history){e51n_exhaustive_gate=0;}
        if(e51n_exhaustive_active<=e51n_exhaustive_passive){e51n_exhaustive_gate=0;}
        if(e51n_exhaustive_resource<=e51n_exhaustive_active){e51n_exhaustive_gate=0;}
        e51n_exhaustive_checksum=(e51n_exhaustive_checksum+(e51n_exhaustive_truth%1000003))%1000003;
        e51n_exhaustive_checksum=(e51n_exhaustive_checksum+(e51n_exhaustive_history%1000003))%1000003;
        e51n_exhaustive_checksum=(e51n_exhaustive_checksum+(e51n_exhaustive_passive%1000003))%1000003;
        e51n_exhaustive_checksum=(e51n_exhaustive_checksum+(e51n_exhaustive_active%1000003))%1000003;
        e51n_exhaustive_checksum=(e51n_exhaustive_checksum+(e51n_exhaustive_resource%1000003))%1000003;
        e51n_exhaustive_count=e51n_exhaustive_count+5;
        e51n_exhaustive_previous=e51n_exhaustive_resource;
        e51n_exhaustive_ordinal=e51n_exhaustive_ordinal+1;
    }
    if(e51n_exhaustive_count!=178200){e51n_exhaustive_gate=0;}
    if(e51n_exhaustive_checksum!=162379){e51n_exhaustive_gate=0;}
    e45_print_pair("e51n_namespace_exhaustive_component_count",e51n_exhaustive_count);
    e45_print_pair("e51n_namespace_exhaustive_checksum",e51n_exhaustive_checksum);
    e45_print_pair("e51n_namespace_exhaustive_uniqueness_gate",e51n_exhaustive_gate);

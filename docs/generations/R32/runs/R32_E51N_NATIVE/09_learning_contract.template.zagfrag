__FUNCTION_KEYWORD__ e51n_terminal_feature_count()__RETURN_SUFFIX__{
    return 32;
}

__FUNCTION_KEYWORD__ e51n_unknown_fixed_value()__RETURN_SUFFIX__{
    return 0;
}

__FUNCTION_KEYWORD__ e51n_correct_commit_value()__RETURN_SUFFIX__{
    return 1000;
}

__FUNCTION_KEYWORD__ e51n_no_unique_commit_value()__RETURN_SUFFIX__{
    return -1200;
}

__FUNCTION_KEYWORD__ e51n_wrong_commit_value()__RETURN_SUFFIX__{
    return -2000;
}

__FUNCTION_KEYWORD__ e51n_max_hinge_terms()__RETURN_SUFFIX__{
    return 4;
}

__FUNCTION_KEYWORD__ e51n_learning_contract(feature_count:i32,unknown_value:i32,correct_value:i32,no_unique_value:i32,wrong_value:i32,max_hinges:i32)__RETURN_SUFFIX__{
    if(feature_count!=e51n_terminal_feature_count()){return 0;}
    if(unknown_value!=e51n_unknown_fixed_value()){return 0;}
    if(correct_value!=e51n_correct_commit_value()){return 0;}
    if(no_unique_value!=e51n_no_unique_commit_value()){return 0;}
    if(wrong_value!=e51n_wrong_commit_value()){return 0;}
    if(max_hinges!=e51n_max_hinge_terms()){return 0;}
    return 1;
}

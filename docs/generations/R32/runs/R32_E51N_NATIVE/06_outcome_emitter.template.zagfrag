__FUNCTION_KEYWORD__ e51n_emit_frozen_outcome(code:i32)__RETURN_SUFFIX__{
    if(code==0){
        _zag_println("e51n_outcome,CALIBRATION_FRONTIER_REPLICATED");
        return 1;
    }
    if(code==1){
        _zag_println("e51n_outcome,CALIBRATION_DOSE_SIGNAL_ONLY");
        return 1;
    }
    if(code==2){
        _zag_println("e51n_outcome,CALIBRATION_CAPACITY_SIGNAL_ONLY");
        return 1;
    }
    if(code==3){
        _zag_println("e51n_outcome,CALIBRATION_SIGNAL_UNSTABLE");
        return 1;
    }
    if(code==4){
        _zag_println("e51n_outcome,INVALID_E51N_INTEGRITY_FAILURE");
        return 1;
    }
    return 0;
}

__FUNCTION_KEYWORD__ e51n_emit_contrast_decisions(dose:i32,capacity:i32,exact_any:i32)__RETURN_SUFFIX__{
    _zag_print("e51n_replicated_dose_signal,"); e45_print_i32(dose); _zag_println("");
    _zag_print("e51n_replicated_capacity_signal,"); e45_print_i32(capacity); _zag_println("");
    _zag_print("e51n_any_exact_validation_arm,"); e45_print_i32(exact_any); _zag_println("");
    return 1;
}

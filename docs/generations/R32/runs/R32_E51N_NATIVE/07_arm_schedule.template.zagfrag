__FUNCTION_KEYWORD__ e51n_arm_valid(arm:i32)__RETURN_SUFFIX__{
    if(arm<0 || arm>4){return 0;}
    return 1;
}

__FUNCTION_KEYWORD__ e51n_arm_dose(arm:i32)__RETURN_SUFFIX__{
    if(arm==0){return 0;}
    if(arm==1 || arm==2){return 1;}
    if(arm==3 || arm==4){return 2;}
    return -1;
}

__FUNCTION_KEYWORD__ e51n_arm_hinge_count(arm:i32)__RETURN_SUFFIX__{
    if(arm==0 || arm==1 || arm==3){return 0;}
    if(arm==2 || arm==4){return 4;}
    return -1;
}

__FUNCTION_KEYWORD__ e51n_dose_development_episodes(dose:i32)__RETURN_SUFFIX__{
    if(dose==0){return 3240;}
    if(dose==1){return 3240;}
    if(dose==2){return 6480;}
    return -1;
}

__FUNCTION_KEYWORD__ e51n_arm_contract(arm:i32,dose:i32,hinge_count:i32)__RETURN_SUFFIX__{
    if(e51n_arm_valid(arm)!=1){return 0;}
    if(e51n_arm_dose(arm)!=dose){return 0;}
    if(e51n_arm_hinge_count(arm)!=hinge_count){return 0;}
    return 1;
}

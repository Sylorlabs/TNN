// R32 E51N — evaluator-only domain-separated world RNG.
// This fragment intentionally replaces only E51M's exhausted seed allocator
// and E51E's world-building transport. Learner features, targets, fitters,
// capacity arms, validation gates, and confirmation logic remain unchanged.

const E51N_RNG_MOD:i64=2147483647;
const E51N_RNG_MULT:i64=48271;
const E51N_RNG_INC:i64=7919;
const E51N_DOMAIN_STRIDE:i64=300000000;
const E51N_STAGE_DEV:i32=55;
const E51N_STAGE_VALIDATION:i32=56;
const E51N_STAGE_CONFIRM:i32=57;

fn e51n_mod_i64(v:i64,m:i64)i64 {
    let q:i64=v/m;
    let r:i64=v-q*m;
    if(r<0){ return r+m; }
    return r;
}

fn e51n_rng_next(state:*i64)i64 {
    let v:i64=e51n_mod_i64(state.**E51N_RNG_MULT+E51N_RNG_INC,E51N_RNG_MOD);
    if(v==0){ v=1; }
    state.*=v;
    return v;
}

fn e51n_rng_range(state:*i64,lo:i32,hi:i32)i32 {
    if(hi<=lo){ return lo; }
    let span:i64=(hi-lo+1) as i64;
    let draw:i64=e51n_rng_next(state);
    return lo+(e51n_mod_i64(draw,span) as i32);
}

fn e51n_world_id(stage:i32,index:i32)i32 {
    return stage*1000000+index;
}

fn e51n_domain_state(world_id:i32,domain:i32)i64 {
    return 1+(world_id as i64)+(domain as i64)*E51N_DOMAIN_STRIDE;
}

fn e51n_domain_integrity_gate()i32 {
    let dev_lo:i32=e51n_world_id(E51N_STAGE_DEV,0);
    let dev_hi:i32=e51n_world_id(E51N_STAGE_DEV,E51M_DEV_EPISODES_MAX-1);
    let val_lo:i32=e51n_world_id(E51N_STAGE_VALIDATION,0);
    let val_hi:i32=e51n_world_id(E51N_STAGE_VALIDATION,E51M_VALIDATION_EPISODES-1);
    let con_lo:i32=e51n_world_id(E51N_STAGE_CONFIRM,0);
    let con_hi:i32=e51n_world_id(E51N_STAGE_CONFIRM,E51M_CONFIRM_EPISODES-1);
    let partition_gate:i32=0;
    if(dev_hi<val_lo && val_hi<con_lo){ partition_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=0;
    while(domain<5){
        let lo:i64=e51n_domain_state(dev_lo,domain);
        let hi:i64=e51n_domain_state(con_hi,domain);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let other_lo:i64=e51n_domain_state(dev_lo,other);
            let other_hi:i64=e51n_domain_state(con_hi,other);
            if(!(hi<other_lo || other_hi<lo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51n_world_id_dev_lo",dev_lo);
    e45_print_pair("e51n_world_id_dev_hi",dev_hi);
    e45_print_pair("e51n_world_id_validation_lo",val_lo);
    e45_print_pair("e51n_world_id_validation_hi",val_hi);
    e45_print_pair("e51n_world_id_confirmation_lo",con_lo);
    e45_print_pair("e51n_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51n_world_partition_disjoint_gate",partition_gate);
    e45_print_pair("e51n_domain_initial_state_disjoint_gate",domain_gate);
    if(partition_gate==1 && domain_gate==1){ return 1; }
    return 0;
}

// Compatibility replacement for E51M's allocator. Arrays contain evaluator-only
// world identities, not learner-visible seeds. No search/probing can exhaust.
fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51M_DEV_EPISODES_MAX);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    let index:i32=0;
    while(index<E51M_DEV_EPISODES_MAX){
        dev_seeds[index]=e51n_world_id(E51N_STAGE_DEV,index);
        index=index+1;
    }
    index=0;
    while(index<E51M_VALIDATION_EPISODES){
        validation_seeds[index]=e51n_world_id(E51N_STAGE_VALIDATION,index);
        index=index+1;
    }
    index=0;
    while(index<E51M_CONFIRM_EPISODES){
        confirmation_seeds[index]=e51n_world_id(E51N_STAGE_CONFIRM,index);
        index=index+1;
    }
    let gate:i32=e51n_domain_integrity_gate();
    e45_print_pair("e51m_seed_manifest_emitted",E51M_DEV_EPISODES_MAX+E51M_VALIDATION_EPISODES+E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_seed_assignment_failures",0);
    e45_print_pair("e51m_max_development_allocated",E51M_DEV_EPISODES_MAX);
    e45_print_pair("e51m_validation_allocated",E51M_VALIDATION_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_allocated",E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_executed",0);
    e45_print_pair("e51n_domain_rng_allocator_gate",gate);
    return gate;
}

fn e51n_write_favored(
    favored:i32,
    strength:i32,
    source:i32,
    rng:*i64,
    evidence_a:*i32,
    evidence_b:*i32,
    source_out:*i32
)void {
    let noise:i32=e51n_rng_range(rng,40,180);
    if(favored==R32E45_HYP_A){
        evidence_a.*=strength;
        evidence_b.*=noise;
    }else{
        evidence_a.*=noise;
        evidence_b.*=strength;
    }
    source_out.*=source;
}

fn e51n_make_truth(
    world_id:i32,
    evaluator_mode:i32,
    truth_state:[]i32,
    historical_state:*i32
)void {
    let rng:i64=e51n_domain_state(world_id,0);
    let truth:i32=(e51n_rng_next(&rng)-((e51n_rng_next(&rng)/2)*0)) as i32;
    // Use a fresh deterministic draw for each binary latent without leaking
    // evaluator identity. Modulo 2 is exactly the old categorical mapping.
    truth=e51n_mod_i64(truth as i64,2) as i32;
    historical_state.*=e51n_mod_i64(e51n_rng_next(&rng),2) as i32;
    let t:i32=0;
    while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    if(evaluator_mode==0 || evaluator_mode==1){
        t=0; while(t<=E45_TAPE){ truth_state[t]=R32E45_UNKNOWN; t=t+1; }
    }
    if(evaluator_mode==2 || evaluator_mode==6 || evaluator_mode==7 || evaluator_mode==8){ historical_state.*=truth; }
    if(evaluator_mode==3){
        historical_state.*=1-truth;
        truth_state[0]=e45_mod(world_id,2);
        t=1; while(t<=4){ truth_state[t]=e45_mod(t+world_id,2); t=t+1; }
        while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    }
    if(evaluator_mode==4){ historical_state.*=1-truth; }
    if(evaluator_mode==5){
        historical_state.*=truth;
        t=0; while(t<=5){ truth_state[t]=1-truth; t=t+1; }
        while(t<=E45_TAPE){ truth_state[t]=truth; t=t+1; }
    }
}

fn e51n_make_history_evidence(
    world_id:i32,
    evaluator_mode:i32,
    historical_state:i32,
    history_a:[]i32,
    history_b:[]i32,
    history_source:[]i32
)void {
    let rng:i64=e51n_domain_state(world_id,1);
    let i:i32=0;
    while(i<E45_HIST){
        e51n_write_favored(historical_state,e51n_rng_range(&rng,650,950),1+e45_mod(i,3),&rng,&history_a[i],&history_b[i],&history_source[i]);
        i=i+1;
    }
}

fn e51n_make_passive_evidence(
    world_id:i32,
    evaluator_mode:i32,
    current_truth:i32,
    passive_a:[]i32,
    passive_b:[]i32,
    passive_source:[]i32
)void {
    let rng:i64=e51n_domain_state(world_id,2);
    let i:i32=0;
    while(i<E45_PASSIVE){
        let favored:i32=current_truth;
        let strength:i32=e51n_rng_range(&rng,260,500);
        if(evaluator_mode==0){ favored=e45_mod(i+world_id,2); }
        if(evaluator_mode==1){
            favored=R32E45_HYP_A;
            if(e51n_rng_range(&rng,0,99)>=60){ favored=R32E45_HYP_B; }
        }
        if(evaluator_mode==7 || evaluator_mode==8){ favored=1-current_truth; }
        e51n_write_favored(favored,strength,e45_mod(i,2),&rng,&passive_a[i],&passive_b[i],&passive_source[i]);
        i=i+1;
    }
}

fn e51n_make_active_evidence(
    world_id:i32,
    evaluator_mode:i32,
    truth_state:[]i32,
    historical_state:i32,
    tape_a:[]i32,
    tape_b:[]i32,
    tape_source:[]i32
)void {
    let rng:i64=e51n_domain_state(world_id,3);
    let final_truth:i32=truth_state[E45_TAPE];
    let i:i32=0;
    while(i<E45_TAPE){
        let favored:i32=truth_state[i+1];
        let strength:i32=e51n_rng_range(&rng,350,750);
        let source:i32=1+e45_mod(i,3);
        if(evaluator_mode==0){
            favored=e45_mod(i+world_id,2);
            strength=e51n_rng_range(&rng,350,650);
            source=e45_mod(i,4);
        }
        if(evaluator_mode==1){
            favored=R32E45_HYP_A;
            if(e51n_rng_range(&rng,0,99)>=60){ favored=R32E45_HYP_B; }
            source=e45_mod(i,4);
        }
        if(evaluator_mode==2 || evaluator_mode==6){ if(e51n_rng_range(&rng,0,99)>=68){ favored=1-truth_state[i+1]; } }
        if(evaluator_mode==3){
            if(i<4){ strength=e51n_rng_range(&rng,260,520);
            }else{
                if(e51n_rng_range(&rng,0,99)>=84){ favored=1-truth_state[i+1]; }
                strength=e51n_rng_range(&rng,650,950);
            }
        }
        if(evaluator_mode==4){ strength=e51n_rng_range(&rng,720,1000); source=1+e45_mod(i,3); }
        if(evaluator_mode==5){
            if(truth_state[i+1]!=final_truth){ strength=e51n_rng_range(&rng,500,780); source=0;
            }else{ strength=e51n_rng_range(&rng,720,1000); source=1+e45_mod(i,3); }
        }
        if(evaluator_mode==7){
            if(i<6){ favored=1-final_truth; strength=e51n_rng_range(&rng,470,700); source=0;
            }else{ favored=final_truth; strength=e51n_rng_range(&rng,760,1000); source=1+e45_mod(i,3); }
        }
        if(evaluator_mode==8){
            if(i<5){ favored=1-final_truth; strength=e51n_rng_range(&rng,250,430); source=e45_mod(i,3);
            }else{ favored=final_truth; strength=e51n_rng_range(&rng,900,1100); source=3; }
        }
        e51n_write_favored(favored,strength,source,&rng,&tape_a[i],&tape_b[i],&tape_source[i]);
        i=i+1;
    }
}

fn e51n_make_resource(
    world_id:i32,
    evaluator_regime:i32,
    history_cost:[]i32,
    history_reward:[]i32,
    future_cost:[]i32,
    future_reward:[]i32,
    budget:*i32,
    action_cost:*i32
)void {
    let rng:i64=e51n_domain_state(world_id,4);
    let budget_lo:i32=6000; let budget_hi:i32=9000;
    let cost_lo:i32=500; let cost_hi:i32=1400;
    let reward_lo:i32=180; let reward_hi:i32=800;
    if(evaluator_regime==1){ budget_lo=4000; budget_hi=7000; cost_lo=500; cost_hi=1400; reward_lo=250; reward_hi=1000; }
    if(evaluator_regime==2){ budget_lo=2000; budget_hi=4000; cost_lo=350; cost_hi=1000; reward_lo=450; reward_hi=1200; }
    if(evaluator_regime==3){ budget_lo=3000; budget_hi=6000; cost_lo=450; cost_hi=1300; reward_lo=50; reward_hi=400; }
    if(evaluator_regime==4){ budget_lo=2500; budget_hi=5000; cost_lo=280; cost_hi=1600; reward_lo=180; reward_hi=1200; }
    budget.*=e51n_rng_range(&rng,budget_lo,budget_hi);
    let u:i32=e51n_rng_range(&rng,0,99);
    if(u<70){ action_cost.*=e51n_rng_range(&rng,280,520);
    }else{
        if(u<90){ action_cost.*=e51n_rng_range(&rng,600,1200);
        }else{ action_cost.*=e51n_rng_range(&rng,1800,2800); }
    }
    let i:i32=0;
    while(i<E45_RESOURCE_ITEMS){
        history_cost[i]=e51n_rng_range(&rng,cost_lo,cost_hi);
        history_reward[i]=e51n_rng_range(&rng,reward_lo,reward_hi);
        future_cost[i]=e51n_rng_range(&rng,cost_lo,cost_hi);
        future_reward[i]=e51n_rng_range(&rng,reward_lo,reward_hi);
        i=i+1;
    }
}

// Compatibility replacement for E51E's old seed-coupled builder. `seed` is
// now the evaluator-only injective world identity. Learner code below the five
// generator calls is intentionally identical to E51E.
fn e51e_build_training_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_records:[]i32,
    continue_records:[]i32,
    unknown_target_nonzero:*i32,
    continue_positive:*i32,
    continue_negative:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST); let history_b:[]i32=zalloc_i(E45_HIST); let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE); let passive_b:[]i32=zalloc_i(E45_PASSIVE); let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE); let tape_b:[]i32=zalloc_i(E45_TAPE); let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N); let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX); let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX); let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N); let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES); let baseline_features:[]i32=zalloc_i(E45_FEATURES); let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let terminal_best:[]i32=zalloc_i(E45_TAPE+1); let recursive_best:[]i32=zalloc_i(E45_TAPE+1);

    let historical_state:i32=R32E45_UNKNOWN;
    e51n_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e51n_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e51n_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e51n_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0; let action_cost:i32=0;
    e51n_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(history_a,history_b,history_source,passive_a,passive_b,passive_source,tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,states,&initial_state,live_state,ordered_a,ordered_b,ordered_source);
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN; e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1]; let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,immediate_a,immediate_b,learned_shadow,full_features);
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0; let contradiction_co_mass:i32=0;
        e47_terminal_representation(states,t*E45_STATE_N,terminal_option,0,&co_viability,&contradiction_co_mass);
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t; let record_start:i32=record_number*E50_RECORD_N;
        let feature:i32=0; while(feature<E45_FEATURES){ terminal_records[record_start+feature]=baseline_features[feature]; feature=feature+1; }
        terminal_records[record_start+32]=co_viability; terminal_records[record_start+33]=contradiction_co_mass;
        let action:i32=0; let best:i32=-4000;
        while(action<4){
            let target:i32=e45_terminal_value(action,states,t*E45_STATE_N,initial_state,truth_state[t]);
            terminal_records[record_start+34+action]=target;
            if(action==R32E45_TERM_UNKNOWN && target!=0){ unknown_target_nonzero.*=unknown_target_nonzero.*+1; }
            if(target>best){ best=target; }
            action=action+1;
        }
        terminal_best[t]=best;
        e51b_continuation_features(states,t*E45_STATE_N,option,resource_features,hazard,immediate_a,immediate_b,learned_shadow,full_features,baseline_features,continuation_features);
        feature=0; while(feature<E45_FEATURES){ continue_records[record_start+feature]=continuation_features[feature]; feature=feature+1; }
        continue_records[record_start+32]=continuation_features[3]; continue_records[record_start+33]=continuation_features[5];
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0; while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }
    recursive_best[E45_TAPE]=terminal_best[E45_TAPE];
    let rt:i32=E45_TAPE-1;
    while(rt>=0){
        recursive_best[rt]=terminal_best[rt];
        if(feasible[rt]==1){ let continue_return:i32=0-losses[rt]+recursive_best[rt+1]; if(continue_return>recursive_best[rt]){ recursive_best[rt]=continue_return; } }
        rt=rt-1;
    }
    t=0;
    while(t<=E45_TAPE){
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t; let record_start:i32=record_number*E50_RECORD_N;
        let target:i32=-3000;
        if(t<E45_TAPE && feasible[t]==1){ target=r32e45_clamp(0-losses[t]+recursive_best[t+1],-3000,3000); }
        continue_records[record_start+34]=target; continue_records[record_start+35]=target; continue_records[record_start+36]=target; continue_records[record_start+37]=target;
        if(target>terminal_best[t]){ continue_positive.*=continue_positive.*+1; }else{ continue_negative.*=continue_negative.*+1; }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source); zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state); zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state); zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features); zfree(continuation_features); zfree(terminal_best); zfree(recursive_best);
}

fn e51n_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51N_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51n_domain_separated_world_rng_plus_e51m_replication_v1");
    _zag_println("e51n_change_scope,evaluator_rng_and_world_identity_only");
    _zag_println("e51n_learner_change,0");
    _zag_println("e51n_topology_change,0");
    _zag_println("e51n_graph_privileged,0");
    let gate:i32=e51n_domain_integrity_gate();
    e45_print_pair("e51n_pre_run_domain_integrity_gate",gate);
    if(gate==0){
        _zag_println("e51n_outcome,INVALID_DOMAIN_RNG_INTEGRITY_FAILURE");
        _zag_println("TNN_R32_E51N_EXECUTION_COMPLETE=0");
        return 0;
    }
    let result:i32=e51m_run(raw_seen,evidence_seen,resource_seen,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias);
    _zag_println("e51n_outcome,E51M_GRID_REPLICATED_UNDER_DOMAIN_SEPARATED_RNG");
    _zag_println("TNN_R32_E51N_EXECUTION_COMPLETE=1");
    return result;
}

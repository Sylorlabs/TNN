            stopped=1;
        }else{
            pair_left[accepted_count.*]=best_left;
            pair_right[accepted_count.*]=best_right;
            coefficients[accepted_count.*]=best_coefficient;
            let candidate_count:i32=accepted_count.*+1;
            let candidate_loss:i64=e51c_training_loss(
                records,weights,bias,pair_left,pair_right,coefficients,candidate_count,reverse
            );
            if(candidate_loss<final_loss.*){
                accepted_count.*=candidate_count;
                final_loss.*=candidate_loss;
                trace_hash.*=e46_hash_update(trace_hash.*,best_left);
                trace_hash.*=e46_hash_update(trace_hash.*,best_right);
                trace_hash.*=e46_hash_update(trace_hash.*,best_coefficient);
                trace_hash.*=e50_hash_loss(trace_hash.*,candidate_loss);
            }else{
                pair_left[accepted_count.*]=0;
                pair_right[accepted_count.*]=0;
                coefficients[accepted_count.*]=0;
                stopped=1;
            }
        }
        stage=stage+1;
    }
    zfree(residuals);
}

fn e51c_foundry_cell_offset(base_index:i32,mode:i32,resource:i32)i32 {
    return ((base_index*E45_MODES+mode)*E45_RESOURCES+resource)*E51B_CELL_FIELDS;
}

fn e51c_validate_episode(
    seed:i32,
    base_index:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    continuation_weights:[]i32,
    continuation_bias:i32,
    pair_left:[]i32,
    pair_right:[]i32,
    coefficients:[]i32,
    interaction_count:i32,
    terminal_aggregate:[]i32,
    linear_aggregate:[]i32,
    foundry_aggregate:[]i32,
    foundry_cell_metrics:[]i32,
    stop_histogram:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let masked_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    // Frozen terminal-only control at t=0.
    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
    let terminal_choice:i32=e51b_terminal_choice(
        0,states,0,option,resource_features,hazard,
        passive_a[E45_PASSIVE-1],passive_b[E45_PASSIVE-1],learned_shadow,
        terminal_weights,terminal_biases,terminal_option,full_features,
        masked_features,model_features,scores
    );
    let terminal_utility:i32=e45_terminal_value(terminal_choice,states,0,initial_state,truth_state[0]);
    e51b_record_outcome(terminal_aggregate,0,terminal_choice,terminal_utility,truth_state[0],0,0);

    // Policy 0 = fresh linear continuation; policy 1 = learner-selected Foundry head.
    let policy:i32=0;
    while(policy<2){
        e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
        e45_copy(states,live_state,E45_STATE_N);
        let observations:i32=0;
        let opportunity_loss:i32=0;
        let stopped:i32=0;
        while(stopped==0 && observations<E45_TAPE){
            let immediate_a:i32=passive_a[E45_PASSIVE-1];
            let immediate_b:i32=passive_b[E45_PASSIVE-1];
            if(observations>0){
                immediate_a=tape_a[observations-1];
                immediate_b=tape_b[observations-1];
            }
            e51b_continuation_features(
                states,observations*E45_STATE_N,option,resource_features,hazard,
                immediate_a,immediate_b,learned_shadow,
                full_features,masked_features,continuation_features
            );
            let predicted_advantage:i32=e47_linear_predict(
                continuation_weights,0,continuation_features,0,continuation_bias
            );
            if(policy==1){
                predicted_advantage=e51c_predict_features(
                    continuation_weights,0,continuation_bias,
                    continuation_features,0,pair_left,pair_right,coefficients,interaction_count
                );
            }
            if(feasible[observations]==0 || predicted_advantage<=0){
                stopped=1;
            }else{
                if(observations==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,predicted_advantage); }
                opportunity_loss=opportunity_loss+losses[observations];
                let tape_index:i32=observations;
                observations=observations+1;
                let j:i32=0;
                while(j<E45_STATE_N){ live_state[j]=states[observations*E45_STATE_N+j]; j=j+1; }
                e45_option_observe(option,live_state,tape_a[tape_index],tape_b[tape_index],tape_source[tape_index],learned_shadow);
            }
        }
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(observations>0){ immediate_a=tape_a[observations-1]; immediate_b=tape_b[observations-1]; }
        let final_choice:i32=e51b_terminal_choice(
            0,states,observations*E45_STATE_N,option,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,
            terminal_weights,terminal_biases,terminal_option,full_features,
            masked_features,model_features,scores
        );
        let final_terminal_utility:i32=e45_terminal_value(
            final_choice,states,observations*E45_STATE_N,initial_state,truth_state[observations]
        );
        let final_utility:i32=final_terminal_utility-opportunity_loss;
        if(policy==0){
            e51b_record_outcome(linear_aggregate,0,final_choice,final_utility,truth_state[observations],observations,opportunity_loss);
            stop_histogram[observations]=stop_histogram[observations]+1;
        }else{
            e51b_record_outcome(foundry_aggregate,0,final_choice,final_utility,truth_state[observations],observations,opportunity_loss);
            stop_histogram[(E45_TAPE+1)+observations]=stop_histogram[(E45_TAPE+1)+observations]+1;
            let cell:i32=e51c_foundry_cell_offset(base_index,evaluator_mode,evaluator_resource);
            foundry_cell_metrics[cell]=foundry_cell_metrics[cell]+1;
            if(truth_state[observations]<0){
                foundry_cell_metrics[cell+1]=foundry_cell_metrics[cell+1]+1;
                if(final_choice==R32E45_TERM_UNKNOWN){ foundry_cell_metrics[cell+2]=foundry_cell_metrics[cell+2]+1;
                }else{ foundry_cell_metrics[cell+3]=foundry_cell_metrics[cell+3]+1; }
            }else{
                foundry_cell_metrics[cell+4]=foundry_cell_metrics[cell+4]+1;
                if(final_choice==R32E45_TERM_UNKNOWN){ foundry_cell_metrics[cell+6]=foundry_cell_metrics[cell+6]+1;
                }else{
                    if(final_terminal_utility==1000){ foundry_cell_metrics[cell+5]=foundry_cell_metrics[cell+5]+1;
                    }else{ foundry_cell_metrics[cell+7]=foundry_cell_metrics[cell+7]+1; }
                }
            }
            foundry_cell_metrics[cell+8]=foundry_cell_metrics[cell+8]+observations;
            foundry_cell_metrics[cell+9]=foundry_cell_metrics[cell+9]+opportunity_loss;
        }
        policy=policy+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(masked_features); zfree(model_features);
    zfree(continuation_features); zfree(scores);
}

fn e51c_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    _zag_println("experiment_schema,tnn_r32_e51c_learner_owned_sparse_continuation_foundry_v1");
    _zag_println("claim_boundary,native_validation_discriminator_not_promotion");
    _zag_println("foundry_primitive,generic_bounded_pairwise_feature_product");
    _zag_println("foundry_authority,development_delayed_utility_regret_only");
    _zag_println("unknown_geometry,neutral_zero_no_positive_unknown_target");

    let dev_seeds:[]i32=zalloc_i(E51C_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51C_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51C_CONFIRM_EPISODES);
    let records:[]i32=zalloc_i(E51B_SAMPLES*E50_RECORD_N);
    let target_positive:[]i32=zalloc_i(E51B_MODELS);
    let target_negative:[]i32=zalloc_i(E51B_MODELS);
    let target_zero:[]i32=zalloc_i(E51B_MODELS);
    let continuation_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let continuation_biases:[]i32=zalloc_i(4);
    let forward_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let forward_biases:[]i32=zalloc_i(4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);

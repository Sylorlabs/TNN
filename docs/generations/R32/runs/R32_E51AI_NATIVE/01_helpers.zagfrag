// E51AI: four prospectively scheduled persistent residual learners.
const E51AI_EP:i32=540;
const E51AI_STATES:i32=9180;
const E51AI_COHORTS:i32=4;
const E51AI_ARMS:i32=4;
const E51AI_FEATURES:i32=64;
const E51AI_COEF:i32=65;
const E51AI_MODEL:i32=130;
const E51AI_META:i32=12;
const E51AI_BLOCKS:i32=32;
const E51AI_BATCH:i32=1080;
const E51AI_SWEEPS:i32=4;

fn e51ai_world_gate()i32 {
    let ok:i32=1; let previous:i32=e51n_world_id(110,10799);
    let s:i32=111;
    while(s<=118){
        let lo:i32=e51n_world_id(s,0); let hi:i32=e51n_world_id(s,E51AI_EP-1);
        if(lo<=previous || hi<lo){ ok=0; } previous=hi;
        let d:i32=0;
        while(d<5){
            let dlo:i64=e51n_domain_state(lo,d); let dhi:i64=e51n_domain_state(hi,d);
            if(dlo<=0 || dhi>=E51N_RNG_MOD){ ok=0; }
            let k:i32=d+1;
            while(k<5){
                let other:i64=e51n_domain_state(e51n_world_id(111,0),k);
                if(dhi>=other){ ok=0; } k=k+1;
            }
            d=d+1;
        }
        _zag_print("e51ai_stage,"); e45_print_i32(s); _zag_print(","); e45_print_i32(lo); _zag_print(","); e45_print_i32(hi); _zag_println("");
        s=s+1;
    }
    return ok;
}

// Sanitized 64-column buffer. Utility columns never enter this function.
fn e51ai_feature_pair(records:[]i32,index:i32,t:i32,out:[]i32,start:i32)i32 {
    let ok:i32=1; let f:i32=0;
    while(f<32){
        let x:i32=e50_batch_column(records,index*E50_RECORD_N,f+1,0);
        let lag:i32=0;
        if(t>0){ lag=e50_batch_column(records,(index-1)*E50_RECORD_N,f+1,0); }
        if(x < -4000 || x>4000 || lag < -4000 || lag>4000){ ok=0; }
        out[start+f]=x; out[start+32+f]=lag; f=f+1;
    }
    return ok;
}

fn e51ai_column(x:[]i32,row:i32,coordinate:i32,arm:i32)i32 {
    if(coordinate==0){ return 1000; }
    let f:i32=coordinate-1;
    if(f<32){ return x[row*64+f]; }
    if(arm==2){ return 0; }
    if(arm==0){
        let v:i64=x[row*64+f-32] as i64;
        return e51m_clamp_i64(v*v/1000,0,4000);
    }
    return x[row*64+f];
}

fn e51ai_raw(x:[]i32,row:i32,w:[]i32,ws:i32,arm:i32)i32 {
    let value:i64=0; let c:i32=0;
    while(c<E51AI_COEF){
        value=value+(w[ws+c] as i64)*(e51ai_column(x,row,c,arm) as i64)/1000;
        c=c+1;
    }
    return value as i32;
}

// Evaluator schedule only; returned record IDs never become model features.
fn e51ai_sample(arm:i32,block:i32,position:i32)i32 {
    let cohort:i32=e45_mod(block,4); let local:i32=e45_mod(position,E51AI_EP);
    if(arm!=3 || position<E51AI_EP || block==0){ return cohort*E51AI_EP+local; }
    let seen:i32=block; if(seen>4){ seen=4; }
    let others:i32=seen; if(cohort<seen){ others=others-1; }
    if(others<=0){ return cohort*E51AI_EP+local; }
    let which:i32=e45_mod(local,others); let selected:i32=-1; let j:i32=0; let n:i32=0;
    while(j<seen){
        if(j!=cohort){ if(n==which){ selected=j; } n=n+1; }
        j=j+1;
    }
    // Coprime stride and rotating offset avoid repeatedly taking the mode-ordered
    // prefix of an old cohort. These scheduler indices never enter features.
    let old_index:i32=e45_mod((local/others)*29+block*97+which*17,E51AI_EP);
    return selected*E51AI_EP+old_index;
}

fn e51ai_hash(w:[]i32,start:i32,n:i32)i32 {
    let h:i32=9101; let i:i32=0;
    while(i<n){ h=e46_hash_update(h,w[start+i]); i=i+1; } return h;
}

fn e51ai_fit(
    x:[]i32,targets:[]i32,w:[]i32,ws:i32,arm:i32,block:i32,candidate:i32,
    reverse:i32,count:i32,updates:*i32,initial_loss:*i64,final_loss:*i64
)i32 {
    updates.*=0; initial_loss.*=0; final_loss.*=0;
    if(count<=0){ return 0; }
    let residual:[]i32=zalloc_i(count); let i:i32=0;
    while(i<count){
        let row:i32=e51ai_sample(arm,block,i);
        residual[i]=targets[row*2+candidate]-e51ai_raw(x,row,w,ws,arm);
        initial_loss.*=initial_loss.*+(residual[i] as i64)*(residual[i] as i64); i=i+1;
    }
    let loss:i64=initial_loss.*; let sweep:i32=0;
    while(sweep<E51AI_SWEEPS){
        let c:i32=0;
        while(c<E51AI_COEF){
            let num:i64=0; let den:i64=0; let p:i32=0;
            while(p<count){
                let ix:i32=p; if(reverse==1){ ix=count-1-p; }
                let row:i32=e51ai_sample(arm,block,ix); let v:i64=e51ai_column(x,row,c,arm) as i64;
                num=num+(residual[ix] as i64)*v; den=den+v*v; p=p+1;
            }
            if(den>0){
                let bound:i32=16000; if(c==0){ bound=4000; }
                let old:i32=w[ws+c]; let proposed:i32=e51m_clamp_i64((old as i64)+num*1000/den,0-bound,bound);
                let delta:i32=proposed-old; let accepted:i32=0;
                while(delta!=0 && accepted==0){
                    let next_loss:i64=0; p=0;
                    while(p<count){
                        let ix:i32=p; if(reverse==1){ ix=count-1-p; }
                        let row:i32=e51ai_sample(arm,block,ix); let v:i64=e51ai_column(x,row,c,arm) as i64;
                        let change:i32=(((old+delta) as i64)*v/1000-(old as i64)*v/1000) as i32;
                        let r:i64=(residual[ix]-change) as i64; next_loss=next_loss+r*r; p=p+1;
                    }
                    if(next_loss<loss){
                        p=0;
                        while(p<count){
                            let row:i32=e51ai_sample(arm,block,p); let v:i64=e51ai_column(x,row,c,arm) as i64;
                            let change:i32=(((old+delta) as i64)*v/1000-(old as i64)*v/1000) as i32;
                            residual[p]=residual[p]-change; p=p+1;
                        }
                        w[ws+c]=old+delta; loss=next_loss; accepted=1; updates.*=updates.*+1;
                    }else{ delta=delta/2; }
                }
            }
            c=c+1;
        }
        sweep=sweep+1;
    }
    let checked:i64=0; i=0;
    while(i<count){
        let row:i32=e51ai_sample(arm,block,i);
        let r:i64=(targets[row*2+candidate]-e51ai_raw(x,row,w,ws,arm)) as i64;
        checked=checked+r*r; i=i+1;
    }
    final_loss.*=checked; zfree(residual);
    if(checked!=loss || checked>initial_loss.*){ return 0; }
    return 1;
}

// Frozen predictions are legitimate inputs; utility fields only reach success().
fn e51ai_choice(x:[]i32,meta:[]i32,row:i32,w:[]i32,ws:i32,arm:i32)i32 {
    let m:i32=row*E51AI_META; let choice:i32=meta[m+1]; let best:i32=meta[m+2];
    if(best<0){ best=0; choice=R32E45_TERM_UNKNOWN; }
    let q0:i32=meta[m+3]; let q1:i32=meta[m+4];
    if(arm>=0){
        q0=q0+r32e45_clamp(e51ai_raw(x,row,w,ws,arm),-4000,4000);
        q1=q1+r32e45_clamp(e51ai_raw(x,row,w,ws+65,arm),-4000,4000);
    }
    if(q0>best){ best=q0; choice=E51AC_CHOICE_CANDIDATE_0; }
    if(q1>best){ choice=E51AC_CHOICE_CANDIDATE_1; }
    return choice;
}

fn e51ai_success(meta:[]i32,row:i32,choice:i32)i32 {
    let m:i32=row*E51AI_META; let value:i32=0; let best:i32=0;
    if(choice==E51AC_CHOICE_CANDIDATE_0 || choice==E51AC_CHOICE_CANDIDATE_1){
        best=meta[m+5]; if(meta[m+6]>best){ best=meta[m+6]; } if(best<0){ best=0; }
        value=meta[m+5+choice-E51AC_CHOICE_CANDIDATE_0];
    }else{
        best=meta[m+7]; let j:i32=1;
        while(j<4){ if(meta[m+7+j]>best){ best=meta[m+7+j]; } j=j+1; }
        if(choice!=R32E45_TERM_UNKNOWN){ value=meta[m+7+choice]; }
    }
    if(value==best){ return 1; } return 0;
}

fn e51ai_evaluate(
    x:[]i32,meta:[]i32,w:[]i32,anchors:[]i32,snapshot_outcomes:[]i32,
    checkpoint:i32,snapshot:i32
)i32 {
    let ok:i32=1; let arm:i32=0;
    while(arm<4){
        let cohort:i32=0;
        while(cohort<4){
            let reach:i32=0; let known:i32=0; let nu:i32=0; let union_n:i32=0; let union_lost:i32=0; let union_rescue:i32=0;
            let hybrid_n:i32=0; let hybrid_lost:i32=0; let hybrid_rescue:i32=0; let anchor_lost:i32=0; let anchor_gain:i32=0;
            let t0s:i32=0; let t0u:i32=0; let t0w:i32=0; let ep:i32=0;
            while(ep<E51AI_EP){
                let episode:i32=cohort*E51AI_EP+ep; let hit:i32=0; let u:i32=0; let h:i32=0; let t:i32=0;
                let s0:i32=0; let unknown0:i32=0; let wrong0:i32=0;
                while(t<=E45_TAPE){
                    let row:i32=episode*(E45_TAPE+1)+t; let m:i32=row*E51AI_META;
                    if(meta[m]==1){
                        let choice:i32=e51ai_choice(x,meta,row,w,arm*E51AI_MODEL,arm);
                        let success:i32=e51ai_success(meta,row,choice);
                        if(success==1){ hit=1; }
                        if(meta[m+11]==1){ u=1; }
                        let hc:i32=e51ai_choice(x,meta,row,w,0,-1);
                        if(e51ai_success(meta,row,hc)==1){ h=1; }
                        if(t==0){
                            if(success==1){ s0=1; }else{ if(choice==R32E45_TERM_UNKNOWN){ unknown0=1; }else{ wrong0=1; } }
                        }
                    }
                    t=t+1;
                }
                let is_known:i32=1; let mode:i32=e45_mod(ep/(E45_RESOURCES*2),E45_MODES);
                if(mode==0 || mode==1){ is_known=0; }
                reach=reach+hit; if(is_known==1){ known=known+hit; }else{ nu=nu+hit; }
                union_n=union_n+u; hybrid_n=hybrid_n+h;
                if(u==1 && hit==0){ union_lost=union_lost+1; } if(u==0 && hit==1){ union_rescue=union_rescue+1; }
                if(h==1 && hit==0){ hybrid_lost=hybrid_lost+1; } if(h==0 && hit==1){ hybrid_rescue=hybrid_rescue+1; }
                let ai:i32=arm*E51AI_COHORTS*E51AI_EP+episode;
                if(snapshot==0 && checkpoint==cohort+1){ anchors[ai]=hit; }
                let anchor:i32=-1; if(checkpoint>=cohort+1){ anchor=anchors[ai]; }
                if(anchor==1 && hit==0){ anchor_lost=anchor_lost+1; } if(anchor==0 && hit==1){ anchor_gain=anchor_gain+1; }
                if(snapshot==0 && checkpoint==4){ snapshot_outcomes[ai]=hit; }
                if(snapshot==1 && snapshot_outcomes[ai]!=hit){ ok=0; }
                t0s=t0s+s0; t0u=t0u+unknown0; t0w=t0w+wrong0;
                _zag_print("e51ai_episode,"); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(snapshot); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(cohort); _zag_print(","); e45_print_i32(ep);
                _zag_print(","); e45_print_i32(hit); _zag_print(","); e45_print_i32(u); _zag_print(","); e45_print_i32(h); _zag_print(","); e45_print_i32(is_known); _zag_print(","); e45_print_i32(s0); _zag_print(","); e45_print_i32(unknown0); _zag_print(","); e45_print_i32(wrong0); _zag_print(","); e45_print_i32(anchor); _zag_println("");
                ep=ep+1;
            }
            _zag_print("e51ai_metrics,"); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(snapshot); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(cohort);
            _zag_print(","); e45_print_i32(reach); _zag_print(","); e45_print_i32(known); _zag_print(","); e45_print_i32(nu); _zag_print(","); e45_print_i32(union_n); _zag_print(","); e45_print_i32(union_lost); _zag_print(","); e45_print_i32(union_rescue);
            _zag_print(","); e45_print_i32(hybrid_n); _zag_print(","); e45_print_i32(hybrid_lost); _zag_print(","); e45_print_i32(hybrid_rescue); _zag_print(","); e45_print_i32(anchor_lost); _zag_print(","); e45_print_i32(anchor_gain);
            _zag_print(","); e45_print_i32(t0s); _zag_print(","); e45_print_i32(t0u); _zag_print(","); e45_print_i32(t0w); _zag_println("");
            cohort=cohort+1;
        }
        arm=arm+1;
    }
    return ok;
}

fn e51ai_emit_weights(w:[]i32,checkpoint:i32)void {
    let a:i32=0;
    while(a<4){
        _zag_print("e51ai_model,"); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(a); _zag_print(","); e45_print_i32(e51ai_hash(w,a*130,130)); _zag_println("");
        let c:i32=0;
        while(c<130){
            _zag_print("e51ai_weight,"); e45_print_i32(checkpoint); _zag_print(","); e45_print_i32(a); _zag_print(","); e45_print_i32(c); _zag_print(","); e45_print_i32(w[a*130+c]); _zag_println(""); c=c+1;
        }
        a=a+1;
    }
}

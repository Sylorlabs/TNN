// R32 E51AD — trajectory-critical conservative mechanism router.
// The mature slot learner and E51AB local-384 direct learner are frozen.
// A scalar gate selects direct only above zero; ties preserve the mature action.

const E51AD_STAGE_DEV:i32=94;
const E51AD_STAGE_VALIDATION:i32=95;
const E51AD_STAGE_CONFIRM:i32=96;
const E51AD_PREVIOUS_STAGE:i32=93;
const E51AD_DEV_EPISODES:i32=12960;
const E51AD_DEV_SAMPLES:i32=220320;
const E51AD_VALIDATION_EPISODES:i32=5400;
const E51AD_VALIDATION_SAMPLES:i32=91800;
const E51AD_CONFIRM_EPISODES:i32=10800;
const E51AD_CONFIRM_SAMPLES:i32=183600;
const E51AD_CELLS:i32=32;
const E51AD_DOSES:i32=2;
const E51AD_MAX_ROUNDS:i32=4;
const E51AD_MAX_CRITICAL:i32=25920;
const E51AD_KIND_NEITHER:i32=0;
const E51AD_KIND_PRESERVE:i32=1;
const E51AD_KIND_DIRECT_ONLY:i32=2;
const E51AD_ARMS:i32=6;
const E51AD_ARM_SLOT:i32=0;
const E51AD_ARM_SCORE_MAX:i32=1;
const E51AD_ARM_GLOBAL:i32=2;
const E51AD_ARM_LOCAL_96:i32=3;
const E51AD_ARM_LOCAL_384:i32=4;
const E51AD_ARM_ORACLE_UNION:i32=5;
const E51AD_FIELDS:i32=9;
const E51AD_EPISODES:i32=0;
const E51AD_REACHABLE:i32=1;
const E51AD_KNOWN:i32=2;
const E51AD_KNOWN_REACHABLE:i32=3;
const E51AD_NO_UNIQUE:i32=4;
const E51AD_NO_UNIQUE_REACHABLE:i32=5;
const E51AD_T0_SUCCESS:i32=6;
const E51AD_T0_UNKNOWN:i32=7;
const E51AD_T0_WRONG:i32=8;

fn e51ad_dose(index:i32)i32 {
    if(index==0){ return 96; }
    return 384;
}

fn e51ad_world_gate()i32 {
    let prev_hi:i32=e51n_world_id(E51AD_PREVIOUS_STAGE,E51AC_CONFIRM_EPISODES-1);
    let dlo:i32=e51n_world_id(E51AD_STAGE_DEV,0);
    let dhi:i32=e51n_world_id(E51AD_STAGE_DEV,E51AD_DEV_EPISODES-1);
    let vlo:i32=e51n_world_id(E51AD_STAGE_VALIDATION,0);
    let vhi:i32=e51n_world_id(E51AD_STAGE_VALIDATION,E51AD_VALIDATION_EPISODES-1);
    let clo:i32=e51n_world_id(E51AD_STAGE_CONFIRM,0);
    let chi:i32=e51n_world_id(E51AD_STAGE_CONFIRM,E51AD_CONFIRM_EPISODES-1);
    let partition:i32=0;
    if(prev_hi<dlo && dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1;
        while(o<5){
            let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o);
            if(!(hi<olo || ohi<lo)){ domains=0; }
            o=o+1;
        }
        d=d+1;
    }
    e45_print_pair("e51ad_world_id_dev_lo",dlo); e45_print_pair("e51ad_world_id_dev_hi",dhi);
    e45_print_pair("e51ad_world_id_validation_lo",vlo); e45_print_pair("e51ad_world_id_validation_hi",vhi);
    e45_print_pair("e51ad_world_id_confirmation_lo",clo); e45_print_pair("e51ad_world_id_confirmation_hi",chi);
    e45_print_pair("e51ad_world_partition_gate",partition); e45_print_pair("e51ad_domain_gate",domains);
    e45_print_pair("e51ad_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; }
    return 0;
}

fn e51ad_direct_hash(
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,local_weights:[]i32,local_biases:[]i32
)i32 {
    let h:i32=6101; let f:i32=0;
    while(f<E45_FEATURES){ h=e46_hash_update(h,g0[f]); h=e46_hash_update(h,g1[f]); f=f+1; }
    h=e46_hash_update(h,b0); h=e46_hash_update(h,b1);
    let per_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES;
    let per_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
    let ws:i32=per_w; let bs:i32=per_b;
    let i:i32=0;
    while(i<per_w){ h=e46_hash_update(h,local_weights[ws+i]); i=i+1; }
    i=0; while(i<per_b){ h=e46_hash_update(h,local_biases[bs+i]); i=i+1; }
    return h;
}

fn e51ad_direct_code(
    records:[]i32,record_start:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    local_weights:[]i32,local_biases:[]i32
)i32 {
    let direct:i32=e51ab_direct_choice(
        3,records,record_start,g0,b0,g1,b1,
        prototypes,parents,ranges,local_weights,local_biases
    );
    if(direct==0){ return E51AC_CHOICE_CANDIDATE_0; }
    if(direct==1){ return E51AC_CHOICE_CANDIDATE_1; }
    return R32E45_TERM_UNKNOWN;
}

fn e51ad_gate_score(
    records:[]i32,record_start:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    shift:i32
)i32 {
    return e51p_expert_predict(
        records,record_start,global_weights,global_bias,
        prototypes,parents,ranges,E51AD_CELLS,
        expert_weights,weight_start,expert_biases,bias_start
    )+shift;
}

fn e51ad_prepare_support(
    stage:i32,episodes:i32,per_cell:i32,
    control_records:[]i32,direct_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    direct_weights:[]i32,direct_biases:[]i32,
    slot_success:[]i32,direct_success:[]i32,kinds:[]i32,
    preserve_count:*i32,direct_only_count:*i32,neither_count:*i32
)void {
    e45_zero(slot_success,episodes*(E45_TAPE+1));
    e45_zero(direct_success,episodes*(E45_TAPE+1));
    e45_zero(kinds,episodes);
    preserve_count.*=0; direct_only_count.*=0; neither_count.*=0;
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES);
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let slot_reached:i32=0; let direct_reached:i32=0; let accessible:i32=1; let t:i32=0;
        while(t<=E45_TAPE){
            if(accessible==1){
                let index:i32=episode*(E45_TAPE+1)+t; let rs:i32=index*E50_RECORD_N;
                let slot_choice:i32=e51ac_policy_choice(
                    E51AC_ARM_SLOT,control_records,direct_records,rs,
                    terminal_weights,terminal_biases,term_global,term_global_bias,
                    prototypes,parents,ranges,term_expert_w,term_expert_b,
                    g0,b0,g1,b1,direct_weights,direct_biases
                );
                let ss:i32=e51ac_choice_success(slot_choice,control_records,direct_records,rs);
                let direct_code:i32=e51ad_direct_code(direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases);
                let ds:i32=e51ac_choice_success(direct_code,control_records,direct_records,rs);
                slot_success[index]=ss; direct_success[index]=ds;
                if(ss==1){ slot_reached=1; }
                if(ds==1){ direct_reached=1; }
            }
            if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
            t=t+1;
        }
        if(slot_reached==1){ kinds[episode]=E51AD_KIND_PRESERVE; preserve_count.*=preserve_count.*+1;
        }else{ if(direct_reached==1){ kinds[episode]=E51AD_KIND_DIRECT_ONLY; direct_only_count.*=direct_only_count.*+1;
            }else{ kinds[episode]=E51AD_KIND_NEITHER; neither_count.*=neither_count.*+1; }
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible);
        episode=episode+1;
    }
}

fn e51ad_select_critical(

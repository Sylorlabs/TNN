fn e51ad_router_identity(
    a_first_w:[]i32,a_first_b:[]i32,a_final_w:[]i32,a_final_b:[]i32,a_shift:i32,a_rounds:i32,a_updates:i32,a_sweeps:i32,a_stop:i32,a_selection:i32,a_fit:i32,a_loss:i64,a_strict:i32,a_preserve:i32,a_direct:i32,
    b_first_w:[]i32,b_first_b:[]i32,b_final_w:[]i32,b_final_b:[]i32,b_shift:i32,b_rounds:i32,b_updates:i32,b_sweeps:i32,b_stop:i32,b_selection:i32,b_fit:i32,b_loss:i64,b_strict:i32,b_preserve:i32,b_direct:i32
)i32 {
    if(a_shift!=b_shift || a_rounds!=b_rounds || a_updates!=b_updates || a_sweeps!=b_sweeps || a_stop!=b_stop || a_selection!=b_selection || a_fit!=b_fit || a_loss!=b_loss || a_strict!=1 || b_strict!=1 || a_preserve!=b_preserve || a_direct!=b_direct){ return 0; }
    if(e51v_expert_equal(a_first_w,0,a_first_b,0,b_first_w,0,b_first_b,0)==0){ return 0; }
    if(e51v_expert_equal(a_final_w,0,a_final_b,0,b_final_w,0,b_final_b,0)==0){ return 0; }
    return 1;
}

fn e51ad_policy_choice(
    arm:i32,control_records:[]i32,direct_records:[]i32,record_start:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    direct_weights:[]i32,direct_biases:[]i32,
    gate_global:[]i32,gate_bias:i32,
    gate_weights:[]i32,gate_biases:[]i32,gate_shifts:[]i32,
    zero_weights:[]i32,zero_biases:[]i32
)i32 {
    let slot_choice:i32=e51ac_policy_choice(
        E51AC_ARM_SLOT,control_records,direct_records,record_start,
        terminal_weights,terminal_biases,term_global,term_global_bias,
        prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_weights,direct_biases
    );
    if(arm==E51AD_ARM_SLOT){ return slot_choice; }
    if(arm==E51AD_ARM_SCORE_MAX){
        return e51ac_policy_choice(
            E51AC_ARM_SCORE_MAX,control_records,direct_records,record_start,
            terminal_weights,terminal_biases,term_global,term_global_bias,
            prototypes,parents,ranges,term_expert_w,term_expert_b,
            g0,b0,g1,b1,direct_weights,direct_biases
        );
    }
    let score:i32=0;
    if(arm==E51AD_ARM_GLOBAL){
        score=e51ad_gate_score(control_records,record_start,gate_global,gate_bias,prototypes,parents,ranges,zero_weights,0,zero_biases,0,gate_shifts[0]);
    }else{
        let dose:i32=arm-E51AD_ARM_LOCAL_96;
        score=e51ad_gate_score(
            control_records,record_start,gate_global,gate_bias,prototypes,parents,ranges,
            gate_weights,dose*E51AD_CELLS*E45_FEATURES,
            gate_biases,dose*E51AD_CELLS,gate_shifts[dose+1]
        );
    }
    if(score<=0){ return slot_choice; }
    return e51ad_direct_code(direct_records,record_start,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases);
}

fn e51ad_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,
    control_records:[]i32,direct_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    direct_weights:[]i32,direct_biases:[]i32,
    gate_global:[]i32,gate_bias:i32,
    gate_weights:[]i32,gate_biases:[]i32,gate_shifts:[]i32,
    zero_weights:[]i32,zero_biases:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32
)void {
    e45_zero(result,E51AD_ARMS*E51AD_FIELDS); e45_zero(mode_reach,E51AD_ARMS*E45_MODES); e45_zero(resource_reach,E51AD_ARMS*E45_RESOURCES);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
        let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let reached:[]i32=zalloc_i(E51AD_ARMS); e45_zero(reached,E51AD_ARMS);
        let accessible:i32=1; let t:i32=0;
        while(t<=E45_TAPE){
            if(accessible==1){
                let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
                let slot_choice:i32=e51ad_policy_choice(E51AD_ARM_SLOT,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,gate_global,gate_bias,gate_weights,gate_biases,gate_shifts,zero_weights,zero_biases);
                let slot_ok:i32=e51ac_choice_success(slot_choice,control_records,direct_records,rs);
                let direct_choice:i32=e51ad_direct_code(direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases);
                let direct_ok:i32=e51ac_choice_success(direct_choice,control_records,direct_records,rs);
                let arm:i32=0;
                while(arm<E51AD_ARM_ORACLE_UNION){
                    let choice:i32=e51ad_policy_choice(arm,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,gate_global,gate_bias,gate_weights,gate_biases,gate_shifts,zero_weights,zero_biases);
                    let success:i32=e51ac_choice_success(choice,control_records,direct_records,rs);
                    if(success==1){ reached[arm]=1; }
                    if(t==0){
                        let s:i32=arm*E51AD_FIELDS;
                        if(success==1){ result[s+E51AD_T0_SUCCESS]=result[s+E51AD_T0_SUCCESS]+1;
                        }else{ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AD_T0_UNKNOWN]=result[s+E51AD_T0_UNKNOWN]+1;
                            }else{ result[s+E51AD_T0_WRONG]=result[s+E51AD_T0_WRONG]+1; }
                        }
                    }
                    arm=arm+1;
                }
                if(slot_ok==1 || direct_ok==1){ reached[E51AD_ARM_ORACLE_UNION]=1; }
                if(t==0 && (slot_ok==1 || direct_ok==1)){ result[E51AD_ARM_ORACLE_UNION*E51AD_FIELDS+E51AD_T0_SUCCESS]=result[E51AD_ARM_ORACLE_UNION*E51AD_FIELDS+E51AD_T0_SUCCESS]+1; }
            }
            if(t<E45_TAPE){ if(accessible==1 && feasible[t]==1){ accessible=1; }else{ accessible=0; } }
            t=t+1;
        }
        let arm:i32=0;
        while(arm<E51AD_ARMS){
            let s:i32=arm*E51AD_FIELDS; result[s+E51AD_EPISODES]=result[s+E51AD_EPISODES]+1;
            if(no_unique==1){ result[s+E51AD_NO_UNIQUE]=result[s+E51AD_NO_UNIQUE]+1; }else{ result[s+E51AD_KNOWN]=result[s+E51AD_KNOWN]+1; }
            if(reached[arm]==1){
                result[s+E51AD_REACHABLE]=result[s+E51AD_REACHABLE]+1;
                mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1;
                resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1;
                if(no_unique==1){ result[s+E51AD_NO_UNIQUE_REACHABLE]=result[s+E51AD_NO_UNIQUE_REACHABLE]+1;
                }else{ result[s+E51AD_KNOWN_REACHABLE]=result[s+E51AD_KNOWN_REACHABLE]+1; }
            }
            arm=arm+1;
        }
        zfree(reached); zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible);
        episode=episode+1;
    }
}

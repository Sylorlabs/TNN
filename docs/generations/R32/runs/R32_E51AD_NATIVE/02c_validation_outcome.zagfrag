
    // Untouched stage-95 validation.
    let val_control:[]i32=zalloc_i(E51AD_VALIDATION_SAMPLES*E50_RECORD_N); let val_direct:[]i32=zalloc_i(E51AD_VALIDATION_SAMPLES*E50_RECORD_N);
    let val_t0:[]i32=zalloc_i(E51AD_VALIDATION_SAMPLES); let val_t1:[]i32=zalloc_i(E51AD_VALIDATION_SAMPLES); let val_pos:[]i32=zalloc_i(2); let val_neg:[]i32=zalloc_i(2);
    e45_zero(val_control,E51AD_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_direct,E51AD_VALIDATION_SAMPLES*E50_RECORD_N);
    let val_unknown:i32=0;
    let val_built:i32=e51ab_build_partition(E51AD_STAGE_VALIDATION,E51AD_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_control,val_direct,val_t0,val_t1,val_pos,val_neg,&val_unknown);
    zfree(val_t0); zfree(val_t1); zfree(val_pos); zfree(val_neg);
    let val_result:[]i32=zalloc_i(E51AD_ARMS*E51AD_FIELDS); let val_mode:[]i32=zalloc_i(E51AD_ARMS*E45_MODES); let val_resource:[]i32=zalloc_i(E51AD_ARMS*E45_RESOURCES);
    e51ad_eval_partition(E51AD_STAGE_VALIDATION,E51AD_VALIDATION_EPISODES,20,val_control,val_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,gate_global,gate_bias,gate_weights,gate_biases,gate_shifts,zero_expert,zero_biases,val_result,val_mode,val_resource);
    _zag_println("e51ad_validation_columns,arm_0_slot_1_scoremax_2_global_3_local96_4_local384_5_oracle_union,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong");
    arm=0;
    while(arm<E51AD_ARMS){ _zag_print("e51ad_validation,"); e45_print_i32(arm); let k:i32=0; while(k<E51AD_FIELDS){ _zag_print(","); e45_print_i32(val_result[arm*E51AD_FIELDS+k]); k=k+1; } _zag_println(""); arm=arm+1; }
    _zag_println("e51ad_validation_regret_columns,arm,total_union_regret,known_union_regret,no_unique_union_regret");
    let union_s:i32=E51AD_ARM_ORACLE_UNION*E51AD_FIELDS; arm=0;
    while(arm<E51AD_ARM_ORACLE_UNION){
        let s:i32=arm*E51AD_FIELDS;
        _zag_print("e51ad_validation_regret,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(val_result[union_s+E51AD_REACHABLE]-val_result[s+E51AD_REACHABLE]); _zag_print(","); e45_print_i32(val_result[union_s+E51AD_KNOWN_REACHABLE]-val_result[s+E51AD_KNOWN_REACHABLE]); _zag_print(","); e45_print_i32(val_result[union_s+E51AD_NO_UNIQUE_REACHABLE]-val_result[s+E51AD_NO_UNIQUE_REACHABLE]); _zag_println("");
        arm=arm+1;
    }
    _zag_println("e51ad_validation_mode_columns,arm,mode,reachable_of_600"); arm=0;
    while(arm<E51AD_ARMS){ let mode:i32=0; while(mode<E45_MODES){ _zag_print("e51ad_validation_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); _zag_print(","); e45_print_i32(val_mode[arm*E45_MODES+mode]); _zag_println(""); mode=mode+1; } arm=arm+1; }
    _zag_println("e51ad_validation_resource_columns,arm,resource,reachable_of_1080"); arm=0;
    while(arm<E51AD_ARMS){ let resource:i32=0; while(resource<E45_RESOURCES){ _zag_print("e51ad_validation_resource,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(resource); _zag_print(","); e45_print_i32(val_resource[arm*E45_RESOURCES+resource]); _zag_println(""); resource=resource+1; } arm=arm+1; }

    let terminal_hash_after_validation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_hash_after_validation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen_validation_gate:i32=0; if(terminal_hash_before==terminal_hash_after_validation && direct_hash_before==direct_hash_after_validation){ frozen_validation_gate=1; }
    let union_bound_gate:i32=1; arm=0;
    while(arm<E51AD_ARM_ORACLE_UNION){
        let s:i32=arm*E51AD_FIELDS;
        if(val_result[s+E51AD_KNOWN_REACHABLE]>val_result[union_s+E51AD_KNOWN_REACHABLE] || val_result[s+E51AD_NO_UNIQUE_REACHABLE]>val_result[union_s+E51AD_NO_UNIQUE_REACHABLE]){ union_bound_gate=0; }
        arm=arm+1;
    }
    let validation_integrity:i32=0;
    if(training_integrity==1 && val_built==E51AD_VALIDATION_EPISODES && val_unknown==0 && frozen_validation_gate==1 && union_bound_gate==1){ validation_integrity=1; }
    let winner:i32=-1; arm=E51AD_ARM_GLOBAL;
    while(arm<=E51AD_ARM_LOCAL_384){
        let s:i32=arm*E51AD_FIELDS; let pass:i32=0;
        if(validation_integrity==1 && val_result[s+E51AD_KNOWN_REACHABLE]==val_result[union_s+E51AD_KNOWN_REACHABLE] && val_result[s+E51AD_NO_UNIQUE_REACHABLE]==val_result[union_s+E51AD_NO_UNIQUE_REACHABLE]){ pass=1; if(winner<0){ winner=arm; } }
        _zag_print("e51ad_validation_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(pass); _zag_println("");
        arm=arm+1;
    }
    e45_print_pair("e51ad_terminal_hash_before",terminal_hash_before); e45_print_pair("e51ad_terminal_hash_after_validation",terminal_hash_after_validation);
    e45_print_pair("e51ad_direct_hash_after_validation",direct_hash_after_validation); e45_print_pair("e51ad_frozen_validation_gate",frozen_validation_gate);
    e45_print_pair("e51ad_union_bound_gate",union_bound_gate); e45_print_pair("e51ad_validation_integrity_gate",validation_integrity); e45_print_pair("e51ad_validation_winner_arm",winner);

    // Stage-96 confirmation remains sealed unless validation union regret is exactly zero.
    let confirmation_executed:i32=0; let confirmation_gate:i32=0;
    if(winner>=E51AD_ARM_GLOBAL){
        confirmation_executed=E51AD_CONFIRM_EPISODES;
        let con_control:[]i32=zalloc_i(E51AD_CONFIRM_SAMPLES*E50_RECORD_N); let con_direct:[]i32=zalloc_i(E51AD_CONFIRM_SAMPLES*E50_RECORD_N);
        let con_t0:[]i32=zalloc_i(E51AD_CONFIRM_SAMPLES); let con_t1:[]i32=zalloc_i(E51AD_CONFIRM_SAMPLES); let con_pos:[]i32=zalloc_i(2); let con_neg:[]i32=zalloc_i(2);
        e45_zero(con_control,E51AD_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_direct,E51AD_CONFIRM_SAMPLES*E50_RECORD_N);
        let con_unknown:i32=0;
        let con_built:i32=e51ab_build_partition(E51AD_STAGE_CONFIRM,E51AD_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,con_control,con_direct,con_t0,con_t1,con_pos,con_neg,&con_unknown);
        zfree(con_t0); zfree(con_t1); zfree(con_pos); zfree(con_neg);
        let con_result:[]i32=zalloc_i(E51AD_ARMS*E51AD_FIELDS); let con_mode:[]i32=zalloc_i(E51AD_ARMS*E45_MODES); let con_resource:[]i32=zalloc_i(E51AD_ARMS*E45_RESOURCES);
        e51ad_eval_partition(E51AD_STAGE_CONFIRM,E51AD_CONFIRM_EPISODES,40,con_control,con_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,gate_global,gate_bias,gate_weights,gate_biases,gate_shifts,zero_expert,zero_biases,con_result,con_mode,con_resource);
        let s:i32=winner*E51AD_FIELDS; let cu:i32=E51AD_ARM_ORACLE_UNION*E51AD_FIELDS;
        if(con_built==E51AD_CONFIRM_EPISODES && con_unknown==0 && con_result[s+E51AD_KNOWN_REACHABLE]==con_result[cu+E51AD_KNOWN_REACHABLE] && con_result[s+E51AD_NO_UNIQUE_REACHABLE]==con_result[cu+E51AD_NO_UNIQUE_REACHABLE]){ confirmation_gate=1; }
        _zag_print("e51ad_confirmation_selected,"); e45_print_i32(winner); let k:i32=0; while(k<E51AD_FIELDS){ _zag_print(","); e45_print_i32(con_result[s+k]); k=k+1; } _zag_println("");
        _zag_print("e51ad_confirmation_union,"); e45_print_i32(E51AD_ARM_ORACLE_UNION); k=0; while(k<E51AD_FIELDS){ _zag_print(","); e45_print_i32(con_result[cu+k]); k=k+1; } _zag_println("");
        zfree(con_control); zfree(con_direct); zfree(con_result); zfree(con_mode); zfree(con_resource);
    }
    e45_print_pair("e51ad_sealed_confirmation_allocated",E51AD_CONFIRM_EPISODES); e45_print_pair("e51ad_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51ad_confirmation_gate",confirmation_gate);

    let best_router:i32=val_result[E51AD_ARM_GLOBAL*E51AD_FIELDS+E51AD_REACHABLE];
    if(val_result[E51AD_ARM_LOCAL_96*E51AD_FIELDS+E51AD_REACHABLE]>best_router){ best_router=val_result[E51AD_ARM_LOCAL_96*E51AD_FIELDS+E51AD_REACHABLE]; }
    if(val_result[E51AD_ARM_LOCAL_384*E51AD_FIELDS+E51AD_REACHABLE]>best_router){ best_router=val_result[E51AD_ARM_LOCAL_384*E51AD_FIELDS+E51AD_REACHABLE]; }
    let scoremax_reach:i32=val_result[E51AD_ARM_SCORE_MAX*E51AD_FIELDS+E51AD_REACHABLE];
    if(validation_integrity==0){ _zag_println("e51ad_outcome,INVALID_E51AD_INTEGRITY_FAILURE");
    }else{ if(confirmation_gate==1){ _zag_println("e51ad_outcome,TRAJECTORY_ROUTER_COMPLEMENT_CONFIRMED");
        }else{ if(winner>=E51AD_ARM_GLOBAL){ _zag_println("e51ad_outcome,TRAJECTORY_ROUTER_COMPLEMENT_VALIDATION_ONLY");
            }else{ if(best_router>scoremax_reach){ _zag_println("e51ad_outcome,TRAJECTORY_ROUTER_PARTIAL");
                }else{ _zag_println("e51ad_outcome,TRAJECTORY_ROUTER_NO_GAIN"); }
            }
        }
    }
    _zag_println("TNN_R32_E51AD_COMPLETE=1");

    zfree(val_control); zfree(val_direct); zfree(val_result); zfree(val_mode); zfree(val_resource);
    zfree(zero_global); zfree(zero_expert); zfree(zero_biases); zfree(gate_global); zfree(gate_reverse);
    zfree(gate_weights); zfree(gate_biases); zfree(reverse_gate_weights); zfree(reverse_gate_biases); zfree(gate_shifts); zfree(reverse_gate_shifts);
    zfree(rounds); zfree(updates); zfree(sweeps); zfree(stops); zfree(selections); zfree(fits); zfree(stricts); zfree(preserves); zfree(directs);
    zfree(rrounds); zfree(rupdates); zfree(rsweeps); zfree(rstops); zfree(rselections); zfree(rfits); zfree(rstricts); zfree(rpreserves); zfree(rdirects);
    zfree(g0); zfree(rg0); zfree(g1); zfree(rg1); zfree(direct_lw); zfree(direct_lb); zfree(direct_rlw); zfree(direct_rlb);
    if(validation_integrity==1){ return 1; }
    return 0;
}

    let dev_built:i32=e51ab_build_partition(E51AD_STAGE_DEV,E51AD_DEV_EPISODES,48,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_control,dev_direct,dev_t0,dev_t1,dev_pos,dev_neg,&dev_unknown);
    zfree(dev_t0); zfree(dev_t1); zfree(dev_pos); zfree(dev_neg);

    let slot_success:[]i32=zalloc_i(E51AD_DEV_SAMPLES); let direct_success:[]i32=zalloc_i(E51AD_DEV_SAMPLES); let kinds:[]i32=zalloc_i(E51AD_DEV_EPISODES);
    let preserve_count:i32=0; let direct_only_count:i32=0; let neither_count:i32=0;
    e51ad_prepare_support(
        E51AD_STAGE_DEV,E51AD_DEV_EPISODES,48,dev_control,dev_direct,
        terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,
        g0,b0,g1,b1,direct_lw,direct_lb,slot_success,direct_success,kinds,&preserve_count,&direct_only_count,&neither_count
    );
    let positive_copies:i32=1;
    if(direct_only_count>0){ positive_copies=(preserve_count+direct_only_count-1)/direct_only_count; if(positive_copies<1){ positive_copies=1; } }
    let expected_critical:i32=preserve_count+direct_only_count*positive_copies;
    let support_gate:i32=0;
    if(preserve_count>0 && direct_only_count>0 && expected_critical<=E51AD_MAX_CRITICAL && preserve_count+direct_only_count+neither_count==E51AD_DEV_EPISODES){ support_gate=1; }
    e45_print_pair("e51ad_development_episodes",dev_built); e45_print_pair("e51ad_development_states",dev_built*(E45_TAPE+1));
    e45_print_pair("e51ad_development_preserve",preserve_count); e45_print_pair("e51ad_development_direct_only",direct_only_count); e45_print_pair("e51ad_development_neither",neither_count);
    e45_print_pair("e51ad_positive_replication_factor",positive_copies); e45_print_pair("e51ad_expected_critical_count",expected_critical); e45_print_pair("e51ad_support_gate",support_gate);

    // Deterministic initial trajectory-critical set and global linear router.
    let zero_global:[]i32=zalloc_i(E45_FEATURES); let zero_expert:[]i32=zalloc_i(E51AD_CELLS*E45_FEATURES); let zero_biases:[]i32=zalloc_i(E51AD_CELLS);
    e45_zero(zero_global,E45_FEATURES); e45_zero(zero_expert,E51AD_CELLS*E45_FEATURES); e45_zero(zero_biases,E51AD_CELLS);
    let seed_records:[]i32=zalloc_i(E51AD_MAX_CRITICAL*E50_RECORD_N); let seed_targets:[]i32=zalloc_i(E51AD_MAX_CRITICAL);
    let rseed_records:[]i32=zalloc_i(E51AD_MAX_CRITICAL*E50_RECORD_N); let rseed_targets:[]i32=zalloc_i(E51AD_MAX_CRITICAL);
    let seed_count:i32=0; let seed_trace:i32=0; let rseed_count:i32=0; let rseed_trace:i32=0;
    e51ad_select_critical(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,positive_copies,zero_global,0,prototypes,parents,ranges,zero_expert,0,zero_biases,0,seed_records,seed_targets,&seed_count,&seed_trace);
    e51ad_select_critical(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,positive_copies,zero_global,0,prototypes,parents,ranges,zero_expert,0,zero_biases,0,rseed_records,rseed_targets,&rseed_count,&rseed_trace);
    let seed_hash:i32=e51ad_critical_hash(seed_records,seed_targets,seed_count); let rseed_hash:i32=e51ad_critical_hash(rseed_records,rseed_targets,rseed_count);
    let critical_identity:i32=0;
    if(seed_count==expected_critical && rseed_count==seed_count && seed_trace==rseed_trace && seed_hash==rseed_hash){ critical_identity=1; }

    let gate_global:[]i32=zalloc_i(E45_FEATURES); let gate_reverse:[]i32=zalloc_i(E45_FEATURES);
    let gate_bias:i32=0; let gate_reverse_bias:i32=0;
    let gate_steps:i32=0; let gate_reason:i32=0; let gate_trace:i32=0; let gate_fit_loss:i64=0;
    let rgate_steps:i32=0; let rgate_reason:i32=0; let rgate_trace:i32=0; let rgate_fit_loss:i64=0;
    e51m_fit_scalar_linear(seed_records,seed_targets,seed_count,0,gate_global,0,&gate_bias,&gate_steps,&gate_reason,&gate_trace,&gate_fit_loss);
    e51m_fit_scalar_linear(rseed_records,rseed_targets,rseed_count,1,gate_reverse,0,&gate_reverse_bias,&rgate_steps,&rgate_reason,&rgate_trace,&rgate_fit_loss);
    let gate_linear_identity:i32=e51m_linear_identity(gate_global,0,gate_bias,gate_reverse,0,gate_reverse_bias,gate_steps,rgate_steps,gate_reason,rgate_reason,gate_trace,rgate_trace,gate_fit_loss,rgate_fit_loss);
    let global_shift:i32=e51ad_preservation_shift(dev_control,E51AD_DEV_EPISODES,slot_success,kinds,gate_global,gate_bias,prototypes,parents,ranges,zero_expert,0,zero_biases,0);
    let reverse_global_shift:i32=e51ad_preservation_shift(dev_control,E51AD_DEV_EPISODES,slot_success,kinds,gate_reverse,gate_reverse_bias,prototypes,parents,ranges,zero_expert,0,zero_biases,0);
    let global_preserve:i32=0; let global_direct:i32=0; let reverse_global_preserve:i32=0; let reverse_global_direct:i32=0;
    let global_threshold_loss:i64=e51ad_router_objective(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,gate_global,gate_bias,prototypes,parents,ranges,zero_expert,0,zero_biases,0,global_shift,&global_preserve,&global_direct);
    let reverse_global_threshold_loss:i64=e51ad_router_objective(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,gate_reverse,gate_reverse_bias,prototypes,parents,ranges,zero_expert,0,zero_biases,0,reverse_global_shift,&reverse_global_preserve,&reverse_global_direct);
    let global_identity:i32=0;
    if(critical_identity==1 && gate_linear_identity==1 && global_shift==reverse_global_shift && global_preserve==reverse_global_preserve && global_direct==reverse_global_direct && global_threshold_loss==reverse_global_threshold_loss){ global_identity=1; }
    _zag_print("e51ad_global_fit,"); e45_print_i32(seed_count); _zag_print(","); e45_print_i32(seed_trace); _zag_print(","); e45_print_i32(seed_hash); _zag_print(","); e45_print_i32(gate_steps); _zag_print(","); e45_print_i32(gate_reason); _zag_print(","); e45_print_i32(gate_trace); _zag_print(","); e45_print_i64(gate_fit_loss); _zag_print(","); e45_print_i32(global_shift); _zag_print(","); e45_print_i32(global_preserve); _zag_print(","); e45_print_i32(global_direct); _zag_print(","); e45_print_i64(global_threshold_loss); _zag_print(","); e45_print_i32(global_identity); _zag_println("");
    e45_print_pair("e51ad_critical_identity_gate",critical_identity); e45_print_pair("e51ad_global_identity_gate",global_identity);
    zfree(seed_records); zfree(seed_targets); zfree(rseed_records); zfree(rseed_targets);

    // Matched local trajectory-router doses.
    let model_w:i32=E51AD_CELLS*E45_FEATURES; let model_b:i32=E51AD_CELLS;
    let gate_weights:[]i32=zalloc_i(E51AD_DOSES*model_w); let gate_biases:[]i32=zalloc_i(E51AD_DOSES*model_b);
    let reverse_gate_weights:[]i32=zalloc_i(E51AD_DOSES*model_w); let reverse_gate_biases:[]i32=zalloc_i(E51AD_DOSES*model_b);
    let gate_shifts:[]i32=zalloc_i(E51AD_DOSES+1); let reverse_gate_shifts:[]i32=zalloc_i(E51AD_DOSES+1);
    let rounds:[]i32=zalloc_i(E51AD_DOSES); let updates:[]i32=zalloc_i(E51AD_DOSES); let sweeps:[]i32=zalloc_i(E51AD_DOSES); let stops:[]i32=zalloc_i(E51AD_DOSES);
    let selections:[]i32=zalloc_i(E51AD_DOSES); let fits:[]i32=zalloc_i(E51AD_DOSES); let stricts:[]i32=zalloc_i(E51AD_DOSES); let preserves:[]i32=zalloc_i(E51AD_DOSES); let directs:[]i32=zalloc_i(E51AD_DOSES);
    let rrounds:[]i32=zalloc_i(E51AD_DOSES); let rupdates:[]i32=zalloc_i(E51AD_DOSES); let rsweeps:[]i32=zalloc_i(E51AD_DOSES); let rstops:[]i32=zalloc_i(E51AD_DOSES);
    let rselections:[]i32=zalloc_i(E51AD_DOSES); let rfits:[]i32=zalloc_i(E51AD_DOSES); let rstricts:[]i32=zalloc_i(E51AD_DOSES); let rpreserves:[]i32=zalloc_i(E51AD_DOSES); let rdirects:[]i32=zalloc_i(E51AD_DOSES);
    gate_shifts[0]=global_shift; reverse_gate_shifts[0]=reverse_global_shift;
    let local_identity:i32=1; let dose_index:i32=0;
    while(dose_index<E51AD_DOSES){
        let dose:i32=e51ad_dose(dose_index);
        let first_w:[]i32=zalloc_i(model_w); let first_b:[]i32=zalloc_i(model_b); let final_w:[]i32=zalloc_i(model_w); let final_b:[]i32=zalloc_i(model_b);
        let rfirst_w:[]i32=zalloc_i(model_w); let rfirst_b:[]i32=zalloc_i(model_b); let rfinal_w:[]i32=zalloc_i(model_w); let rfinal_b:[]i32=zalloc_i(model_b);
        let shift:i32=0; let rshift:i32=0; let dose_loss:i64=0; let reverse_dose_loss:i64=0;
        e51ad_fit_router_dose(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,preserve_count,direct_only_count,positive_copies,gate_global,gate_bias,prototypes,parents,ranges,0,dose,first_w,first_b,final_w,final_b,&shift,&rounds[dose_index],&updates[dose_index],&sweeps[dose_index],&stops[dose_index],&selections[dose_index],&fits[dose_index],&dose_loss,&stricts[dose_index],&preserves[dose_index],&directs[dose_index]);
        e51ad_fit_router_dose(dev_control,E51AD_DEV_EPISODES,slot_success,direct_success,kinds,preserve_count,direct_only_count,positive_copies,gate_reverse,gate_reverse_bias,prototypes,parents,ranges,1,dose,rfirst_w,rfirst_b,rfinal_w,rfinal_b,&rshift,&rrounds[dose_index],&rupdates[dose_index],&rsweeps[dose_index],&rstops[dose_index],&rselections[dose_index],&rfits[dose_index],&reverse_dose_loss,&rstricts[dose_index],&rpreserves[dose_index],&rdirects[dose_index]);
        let identity:i32=e51ad_router_identity(first_w,first_b,final_w,final_b,shift,rounds[dose_index],updates[dose_index],sweeps[dose_index],stops[dose_index],selections[dose_index],fits[dose_index],dose_loss,stricts[dose_index],preserves[dose_index],directs[dose_index],rfirst_w,rfirst_b,rfinal_w,rfinal_b,rshift,rrounds[dose_index],rupdates[dose_index],rsweeps[dose_index],rstops[dose_index],rselections[dose_index],rfits[dose_index],reverse_dose_loss,rstricts[dose_index],rpreserves[dose_index],rdirects[dose_index]);
        if(identity==0){ local_identity=0; }
        gate_shifts[dose_index+1]=shift; reverse_gate_shifts[dose_index+1]=rshift;
        let i:i32=0; while(i<model_w){ gate_weights[dose_index*model_w+i]=final_w[i]; reverse_gate_weights[dose_index*model_w+i]=rfinal_w[i]; i=i+1; }
        i=0; while(i<model_b){ gate_biases[dose_index*model_b+i]=final_b[i]; reverse_gate_biases[dose_index*model_b+i]=rfinal_b[i]; i=i+1; }
        _zag_print("e51ad_local_fit,"); e45_print_i32(dose_index); _zag_print(","); e45_print_i32(dose); _zag_print(","); e45_print_i32(rounds[dose_index]); _zag_print(","); e45_print_i32(updates[dose_index]); _zag_print(","); e45_print_i32(sweeps[dose_index]); _zag_print(","); e45_print_i32(stops[dose_index]); _zag_print(","); e45_print_i32(selections[dose_index]); _zag_print(","); e45_print_i32(fits[dose_index]); _zag_print(","); e45_print_i64(dose_loss); _zag_print(","); e45_print_i32(shift); _zag_print(","); e45_print_i32(preserves[dose_index]); _zag_print(","); e45_print_i32(directs[dose_index]); _zag_print(","); e45_print_i32(identity); _zag_println("");
        zfree(first_w); zfree(first_b); zfree(final_w); zfree(final_b); zfree(rfirst_w); zfree(rfirst_b); zfree(rfinal_w); zfree(rfinal_b);
        dose_index=dose_index+1;
    }
    let development_preservation_gate:i32=1;
    if(global_preserve!=preserve_count){ development_preservation_gate=0; }
    dose_index=0; while(dose_index<E51AD_DOSES){ if(preserves[dose_index]!=preserve_count){ development_preservation_gate=0; } dose_index=dose_index+1; }
    let terminal_hash_after_training:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_hash_after_training:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen_training_gate:i32=0; if(terminal_hash_before==terminal_hash_after_training && direct_hash_before==direct_hash_after_training){ frozen_training_gate=1; }
    let training_integrity:i32=0;
    if(terminal_reproduction_gate==1 && world_gate==1 && direct_integrity==1 && dev_built==E51AD_DEV_EPISODES && dev_unknown==0 && support_gate==1 && global_identity==1 && local_identity==1 && development_preservation_gate==1 && frozen_training_gate==1){ training_integrity=1; }
    e45_print_pair("e51ad_parent_terminal_reproduction_gate",terminal_reproduction_gate); e45_print_pair("e51ad_local_identity_gate",local_identity);
    e45_print_pair("e51ad_development_preservation_gate",development_preservation_gate); e45_print_pair("e51ad_frozen_training_gate",frozen_training_gate); e45_print_pair("e51ad_training_integrity_gate",training_integrity);

    // Development metrics use only the frozen development-selected models.
    let dev_result:[]i32=zalloc_i(E51AD_ARMS*E51AD_FIELDS); let dev_mode:[]i32=zalloc_i(E51AD_ARMS*E45_MODES); let dev_resource:[]i32=zalloc_i(E51AD_ARMS*E45_RESOURCES);
    e51ad_eval_partition(E51AD_STAGE_DEV,E51AD_DEV_EPISODES,48,dev_control,dev_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,gate_global,gate_bias,gate_weights,gate_biases,gate_shifts,zero_expert,zero_biases,dev_result,dev_mode,dev_resource);
    _zag_println("e51ad_development_columns,arm_0_slot_1_scoremax_2_global_3_local96_4_local384_5_oracle_union,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong");
    let arm:i32=0;
    while(arm<E51AD_ARMS){ _zag_print("e51ad_development,"); e45_print_i32(arm); let k:i32=0; while(k<E51AD_FIELDS){ _zag_print(","); e45_print_i32(dev_result[arm*E51AD_FIELDS+k]); k=k+1; } _zag_println(""); arm=arm+1; }
    zfree(dev_result); zfree(dev_mode); zfree(dev_resource);

    zfree(slot_success); zfree(direct_success); zfree(kinds); zfree(dev_control); zfree(dev_direct);

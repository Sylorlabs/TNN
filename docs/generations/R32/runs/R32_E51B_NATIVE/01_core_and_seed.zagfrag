// R32 E51B sequential continuation discriminator helpers.
// Native Zag only. Evaluator truth is used only after policy scoring to create
// delayed utility/regret targets and evaluation metrics; it is never a policy input.

const E51B_DEV_EPISODES:i32=3240;
const E51B_VALIDATION_EPISODES:i32=5400;
const E51B_CONFIRM_EPISODES:i32=10800;
const E51B_SAMPLES:i32=55080;
const E51B_MODELS:i32=2;
const E51B_CELL_FIELDS:i32=10;
const E51B_AGG_FIELDS:i32=14;

const E51B_M_EPISODES:i32=0;
const E51B_M_SUCCESS:i32=1;
const E51B_M_UNKNOWN:i32=2;
const E51B_M_WRONG:i32=3;
const E51B_M_KNOWN:i32=4;
const E51B_M_NO_UNIQUE:i32=5;
const E51B_M_OBSERVATIONS:i32=6;
const E51B_M_OPPORTUNITY_LOSS:i32=7;
const E51B_M_UTILITY:i32=8;
const E51B_M_CONTINUED:i32=9;
const E51B_M_KNOWN_SUCCESS:i32=10;
const E51B_M_KNOWN_WRONG:i32=11;
const E51B_M_NO_UNIQUE_UNKNOWN:i32=12;
const E51B_M_NO_UNIQUE_WRONG:i32=13;

fn e51b_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51B_DEV_EPISODES);
    e45_zero(validation_seeds,E51B_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51B_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,24,index,mode,resource,&failures);
                        dev_seeds[index]=seed;
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,25,index,mode,resource,&failures);
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,26,index,mode,resource,&failures);
                    confirmation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51b_seed_manifest_emitted",emitted);
    e45_print_pair("e51b_seed_assignment_failures",failures);
    e45_print_pair("e51b_sealed_confirmation_allocated",E51B_CONFIRM_EPISODES);
    e45_print_pair("e51b_sealed_confirmation_executed",0);
    if(failures==0){ return 1; }
    return 0;
}

fn e51b_terminal_choice(
    model_index:i32,
    state:[]i32,
    state_start:i32,
    option:[]i32,
    resource_features:[]i32,
    hazard:[]i32,
    immediate_a:i32,
    immediate_b:i32,
    learned_shadow:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    terminal_option:[]i32,
    full_features:[]i32,
    baseline_features:[]i32,
    model_features:[]i32,
    scores:[]i32
)i32 {
    e45_terminal_projection(option,terminal_option);
    e45_fill_full_features(
        state,state_start,terminal_option,0,resource_features,hazard,
        immediate_a,immediate_b,learned_shadow,full_features
    );
    e45_mask_features(full_features,E45_ARM_D,baseline_features);
    let co_viability:i32=0;
    let contradiction_co_mass:i32=0;
    e47_terminal_representation(
        state,state_start,terminal_option,0,
        &co_viability,&contradiction_co_mass
    );
    e50_build_model_features(
        baseline_features,0,co_viability,contradiction_co_mass,
        model_index,model_features,0
    );
    return e47_terminal_scores(
        terminal_weights,terminal_biases,model_index,model_features,0,scores
    );
}

fn e51b_continuation_features(
    state:[]i32,
    state_start:i32,
    option:[]i32,
    resource_features:[]i32,
    hazard:[]i32,
    immediate_a:i32,
    immediate_b:i32,
    learned_shadow:i32,
    full_features:[]i32,
    masked_features:[]i32,
    out:[]i32
)void {
    e45_fill_full_features(
        state,state_start,option,0,resource_features,hazard,
        immediate_a,immediate_b,learned_shadow,full_features
    );
    e45_mask_features(full_features,E45_ARM_D,masked_features);
    // Reuse E50's deterministic batch design while preserving option-credit
    // and active-state slots instead of replacing them with terminal-only reps.
    e50_build_model_features(
        masked_features,0,masked_features[3],masked_features[5],0,out,0
    );
}

fn e51b_build_continuation_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    continuation_records:[]i32,
    target_positive:[]i32,
    target_negative:[]i32,
    target_zero:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let masked_features:[]i32=zalloc_i(E45_FEATURES);

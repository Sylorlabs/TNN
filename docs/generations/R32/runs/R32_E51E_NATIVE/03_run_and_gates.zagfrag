fn e51e_fit_model(
    records:[]i32,
    contention:i32,
    model:i32,
    weights:[]i32,
    biases:[]i32,
    backup_weights:[]i32,
    backup_biases:[]i32,
    gram_forward:[]i32,
    gram_reverse:[]i32,
    cross_forward:[]i32,
    cross_reverse:[]i32,
    forward_copy_weights:[]i32,
    forward_copy_biases:[]i32
)i32 {
    e45_zero(gram_forward,E50_BATCH_GRAM); e45_zero(gram_reverse,E50_BATCH_GRAM);
    e45_zero(cross_forward,E50_BATCH_CROSS); e45_zero(cross_reverse,E50_BATCH_CROSS);
    let count_forward:i32=0; let count_reverse:i32=0;
    let hash_forward:i32=701+model+contention*17; let hash_reverse:i32=701+model+contention*17;
    e50_build_batch_statistics(records,contention,0,gram_forward,cross_forward,&count_forward,&hash_forward);
    e50_build_batch_statistics(records,contention,1,gram_reverse,cross_reverse,&count_reverse,&hash_reverse);
    let gate:i32=1;
    if(count_forward!=E51E_SAMPLES || count_reverse!=E51E_SAMPLES){ gate=0; }
    if(hash_forward!=hash_reverse || e50_batch_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0){ gate=0; }

    let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0;
    let loss_low_forward:i32=0; let loss_high_forward:i32=0;
    e50_batch_fit(
        records,contention,model,gram_forward,cross_forward,
        weights,biases,backup_weights,backup_biases,
        &steps_forward,&reason_forward,&trace_forward,&loss_low_forward,&loss_high_forward
    );
    let action:i32=0;
    while(action<4){
        forward_copy_biases[model*4+action]=biases[model*4+action];
        let feature:i32=0;
        while(feature<E45_FEATURES){
            forward_copy_weights[(model*4+action)*E45_FEATURES+feature]=weights[(model*4+action)*E45_FEATURES+feature];
            feature=feature+1;
        }
        action=action+1;
    }
    action=0;
    while(action<4){
        biases[model*4+action]=0;
        let feature:i32=0;
        while(feature<E45_FEATURES){ weights[(model*4+action)*E45_FEATURES+feature]=0; feature=feature+1; }
        action=action+1;
    }
    let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0;
    let loss_low_reverse:i32=0; let loss_high_reverse:i32=0;
    e50_batch_fit(
        records,contention,model,gram_reverse,cross_reverse,
        weights,biases,backup_weights,backup_biases,
        &steps_reverse,&reason_reverse,&trace_reverse,&loss_low_reverse,&loss_high_reverse
    );
    action=0;
    while(action<4){
        if(biases[model*4+action]!=forward_copy_biases[model*4+action]){ gate=0; }
        let feature:i32=0;
        while(feature<E45_FEATURES){
            if(weights[(model*4+action)*E45_FEATURES+feature]!=forward_copy_weights[(model*4+action)*E45_FEATURES+feature]){ gate=0; }
            feature=feature+1;
        }
        action=action+1;
    }
    if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || loss_low_forward!=loss_low_reverse || loss_high_forward!=loss_high_reverse){ gate=0; }
    _zag_print("e51e_batch_fit,"); e45_print_i32(model); _zag_print(","); e45_print_i32(contention); _zag_print(",");
    e45_print_i32(steps_forward); _zag_print(","); e45_print_i32(reason_forward); _zag_print(","); e45_print_i32(trace_forward); _zag_print(","); e45_print_i32(gate); _zag_println("");
    return gate;
}

fn e51e_delta_audit(
    frozen_weights:[]i32,
    frozen_biases:[]i32,
    learned_weights:[]i32,
    learned_biases:[]i32,
    model:i32,
    changed:*i32,
    delta_mass:*i64,
    max_delta:*i32
)void {
    changed.*=0; delta_mass.*=0; max_delta.*=0;
    let action:i32=0;
    while(action<4){
        let db:i32=r32e45_abs(learned_biases[model*4+action]-frozen_biases[model*4+action]);
        if(db>0){ changed.*=changed.*+1; }
        delta_mass.*=delta_mass.*+(db as i64);
        if(db>max_delta.*){ max_delta.*=db; }
        let feature:i32=0;
        while(feature<E45_FEATURES){
            let dw:i32=r32e45_abs(learned_weights[(model*4+action)*E45_FEATURES+feature]-frozen_weights[(model*4+action)*E45_FEATURES+feature]);
            if(dw>0){ changed.*=changed.*+1; }
            delta_mass.*=delta_mass.*+(dw as i64);
            if(dw>max_delta.*){ max_delta.*=dw; }
            feature=feature+1;
        }
        action=action+1;
    }
}

fn e51e_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    frozen_terminal_weights:[]i32,
    frozen_terminal_biases:[]i32
)i32 {
    _zag_println("R32_E51E_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51e_joint_sequential_action_value_v1");
    _zag_println("claim_boundary,native_development_validation_discriminator_not_promotion");
    _zag_println("epistemic_isolation=1");
    _zag_println("evaluator_mode_exposed=0");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("phase_label_exposed=0");
    _zag_println("task_specific_thresholds=0");
    _zag_println("fixed_horizon_rule=0");
    _zag_println("unknown_is_positive_warrant=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");
    _zag_println("connection_introspection_audit=1");

    let dev_seeds:[]i32=zalloc_i(E51E_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51E_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51E_CONFIRM_EPISODES);
    let terminal_records:[]i32=zalloc_i(E51E_SAMPLES*E50_RECORD_N);
    let continue_records:[]i32=zalloc_i(E51E_SAMPLES*E50_RECORD_N);
    let frozen_continue_records:[]i32=zalloc_i(E51E_SAMPLES*E50_RECORD_N);
    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let continue_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let continue_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let frozen_continue_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let frozen_continue_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let forward_copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let forward_copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let reach:[]i32=zalloc_i(E51E_MODELS*E51E_R_FIELDS);
    let frozen_control_aggregate:[]i32=zalloc_i(E51E_MODELS*E51B_AGG_FIELDS);
    let frozen_sequential_aggregate:[]i32=zalloc_i(E51E_MODELS*E51B_AGG_FIELDS);
    let frozen_cell_metrics:[]i32=zalloc_i(E51E_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    let frozen_stop_histogram:[]i32=zalloc_i(E51E_MODELS*(E45_TAPE+1));
    let joint_aggregate:[]i32=zalloc_i(E51E_MODELS*E51B_AGG_FIELDS);
    let joint_cell_metrics:[]i32=zalloc_i(E51E_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    let joint_stop_histogram:[]i32=zalloc_i(E51E_MODELS*(E45_TAPE+1));
    let frozen_target_positive:[]i32=zalloc_i(E51E_MODELS);
    let frozen_target_negative:[]i32=zalloc_i(E51E_MODELS);
    let frozen_target_zero:[]i32=zalloc_i(E51E_MODELS);

    e45_zero(terminal_records,E51E_SAMPLES*E50_RECORD_N); e45_zero(continue_records,E51E_SAMPLES*E50_RECORD_N); e45_zero(frozen_continue_records,E51E_SAMPLES*E50_RECORD_N);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4);
    e45_zero(continue_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(continue_biases,E51E_MODELS*4);
    e45_zero(frozen_continue_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(frozen_continue_biases,E51E_MODELS*4);
    e45_zero(reach,E51E_MODELS*E51E_R_FIELDS);
    e45_zero(frozen_control_aggregate,E51E_MODELS*E51B_AGG_FIELDS); e45_zero(frozen_sequential_aggregate,E51E_MODELS*E51B_AGG_FIELDS);
    e45_zero(frozen_cell_metrics,E51E_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS); e45_zero(frozen_stop_histogram,E51E_MODELS*(E45_TAPE+1));
    e45_zero(joint_aggregate,E51E_MODELS*E51B_AGG_FIELDS); e45_zero(joint_cell_metrics,E51E_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS); e45_zero(joint_stop_histogram,E51E_MODELS*(E45_TAPE+1));
    e45_zero(frozen_target_positive,E51E_MODELS); e45_zero(frozen_target_negative,E51E_MODELS); e45_zero(frozen_target_zero,E51E_MODELS);

    let seed_gate:i32=e51e_allocate_seeds(raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds);
    let unknown_target_nonzero:i32=0;
    let continue_positive:i32=0;
    let continue_negative:i32=0;
    let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=dev_seeds[index];
                        e51e_build_training_episode(
                            seed,mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,
                            terminal_records,continue_records,
                            &unknown_target_nonzero,&continue_positive,&continue_negative
                        );
                        e51b_build_continuation_episode(
                            seed,mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,frozen_terminal_weights,frozen_terminal_biases,
                            frozen_continue_records,frozen_target_positive,frozen_target_negative,frozen_target_zero
                        );
                        canonical_episode=canonical_episode+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let sample_gate:i32=0;
    if(canonical_episode==E51E_DEV_EPISODES){ sample_gate=1; }
    let target_gate:i32=0;
    if(unknown_target_nonzero==0 && continue_positive>0 && continue_negative>0){ target_gate=1; }
    e45_print_pair("e51e_development_episodes",canonical_episode);
    e45_print_pair("e51e_unknown_target_nonzero",unknown_target_nonzero);
    e45_print_pair("e51e_continue_better_than_terminal_count",continue_positive);
    e45_print_pair("e51e_continue_not_better_count",continue_negative);
    e45_print_pair("e51e_target_geometry_gate",target_gate);

    let terminal_fit_gate:i32=1;
    let continue_fit_gate:i32=1;
    let frozen_continue_fit_gate:i32=1;
    let model:i32=0;
    while(model<E51E_MODELS){
        e45_zero(forward_copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(forward_copy_biases,E51E_MODELS*4);
        let tg:i32=e51e_fit_model(
            terminal_records,model,model,terminal_weights,terminal_biases,
            backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
            forward_copy_weights,forward_copy_biases
        );
        if(tg==0){ terminal_fit_gate=0; }
        e45_zero(forward_copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(forward_copy_biases,E51E_MODELS*4);
        let cg:i32=e51e_fit_model(
            continue_records,model,model,continue_weights,continue_biases,
            backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
            forward_copy_weights,forward_copy_biases
        );
        if(cg==0){ continue_fit_gate=0; }
        e45_zero(forward_copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(forward_copy_biases,E51E_MODELS*4);
        let fg:i32=e51e_fit_model(
            frozen_continue_records,0,model,frozen_continue_weights,frozen_continue_biases,
            backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
            forward_copy_weights,forward_copy_biases
        );
        if(fg==0){ frozen_continue_fit_gate=0; }
        model=model+1;
    }
    e45_print_pair("e51e_terminal_batch_identity_gate",terminal_fit_gate);
    e45_print_pair("e51e_continue_batch_identity_gate",continue_fit_gate);
    e45_print_pair("e51e_frozen_control_batch_identity_gate",frozen_continue_fit_gate);

    model=0;
    while(model<E51E_MODELS){
        let nonzero:i32=0; let mass:i64=0; let max_abs:i32=0;
        e51e_weight_audit(terminal_weights,terminal_biases,model,&nonzero,&mass,&max_abs);
        let changed:i32=0; let delta_mass:i64=0; let max_delta:i32=0;
        e51e_delta_audit(frozen_terminal_weights,frozen_terminal_biases,terminal_weights,terminal_biases,model,&changed,&delta_mass,&max_delta);
        _zag_print("e51e_terminal_connection_audit,"); e45_print_i32(model); _zag_print(","); e45_print_i32(nonzero); _zag_print(","); e45_print_i64(mass); _zag_print(","); e45_print_i32(max_abs); _zag_print(","); e45_print_i32(changed); _zag_print(","); e45_print_i64(delta_mass); _zag_print(","); e45_print_i32(max_delta); _zag_println("");
        nonzero=0; mass=0; max_abs=0;
        e51e_weight_audit(continue_weights,continue_biases,model,&nonzero,&mass,&max_abs);
        _zag_print("e51e_continue_connection_audit,"); e45_print_i32(model); _zag_print(","); e45_print_i32(nonzero); _zag_print(","); e45_print_i64(mass); _zag_print(","); e45_print_i32(max_abs); _zag_println("");
        model=model+1;
    }

    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51e_reachability_episode(
                        validation_seeds[index],mode,resource,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_weights,terminal_biases,reach
                    );
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }

    let reach_gate:[]i32=zalloc_i(E51E_MODELS);
    model=0;
    while(model<E51E_MODELS){
        let start:i32=model*E51E_R_FIELDS;
        if(reach[start+E51E_R_KNOWN]>0 && reach[start+E51E_R_NO_UNIQUE]>0 && reach[start+E51E_R_KNOWN_REACHABLE]==reach[start+E51E_R_KNOWN] && reach[start+E51E_R_NO_UNIQUE_REACHABLE]==reach[start+E51E_R_NO_UNIQUE]){ reach_gate[model]=1; }
        _zag_print("e51e_reachability,"); e45_print_i32(model); _zag_print(",");
        let k:i32=0; while(k<E51E_R_FIELDS){ e45_print_i32(reach[start+k]); if(k+1<E51E_R_FIELDS){ _zag_print(","); } k=k+1; } _zag_print(","); e45_print_i32(reach_gate[model]); _zag_println("");
        model=model+1;
    }

    let stage1_integrity:i32=0;
    if(seed_gate==1 && sample_gate==1 && target_gate==1 && terminal_fit_gate==1 && continue_fit_gate==1 && frozen_continue_fit_gate==1){ stage1_integrity=1; }
    let stage1_primary_pass:i32=0;
    if(stage1_integrity==1 && reach_gate[0]==1){ stage1_primary_pass=1; }
    e45_print_pair("e51e_stage1_integrity_gate",stage1_integrity);
    e45_print_pair("e51e_stage1_primary_reachability_gate",stage1_primary_pass);

    let candidate_gate:i32=0;
    if(stage1_primary_pass==1){
        base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<20){
                        let index:i32=e46_validation_index(base_index,mode,resource,episode);
                        let seed:i32=validation_seeds[index];
                        e51b_validate_episode(
                            seed,base_index,mode,resource,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,frozen_terminal_weights,frozen_terminal_biases,
                            frozen_continue_weights,frozen_continue_biases,
                            frozen_control_aggregate,frozen_sequential_aggregate,frozen_cell_metrics,frozen_stop_histogram
                        );
                        e51e_joint_validate_episode(
                            seed,base_index,mode,resource,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                            continue_weights,continue_biases,joint_aggregate,joint_cell_metrics,joint_stop_histogram
                        );
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }

        _zag_println("e51e_aggregate_columns,policy_0_frozen_terminate_1_frozen_sequential_2_joint,model,episodes,success,unknown,wrong,known,no_unique,observations,opportunity_loss,utility,continued,known_success,known_wrong,no_unique_unknown,no_unique_wrong");
        model=0;
        while(model<E51E_MODELS){
            let policy:i32=0;
            while(policy<3){
                let metrics:[]i32=frozen_control_aggregate;
                if(policy==1){ metrics=frozen_sequential_aggregate; }
                if(policy==2){ metrics=joint_aggregate; }
                let start:i32=model*E51B_AGG_FIELDS;
                _zag_print("e51e_aggregate,"); e45_print_i32(policy); _zag_print(","); e45_print_i32(model); _zag_print(",");
                let k:i32=0; while(k<E51B_AGG_FIELDS){ e45_print_i32(metrics[start+k]); if(k+1<E51B_AGG_FIELDS){ _zag_print(","); } k=k+1; } _zag_println("");
                policy=policy+1;
            }
            model=model+1;
        }

        let no_unique_every_cell:[]i32=zalloc_i(E51E_MODELS);
        model=0;
        while(model<E51E_MODELS){
            no_unique_every_cell[model]=1;
            let b:i32=0;
            while(b<6){
                let mode:i32=0;
                while(mode<E45_MODES){
                    let resource:i32=0;
                    while(resource<E45_RESOURCES){
                        let cell:i32=e51b_cell_offset(model,b,mode,resource);
                        if(joint_cell_metrics[cell+1]>0){
                            if(joint_cell_metrics[cell+3]>0 || joint_cell_metrics[cell+2]!=joint_cell_metrics[cell+1]){ no_unique_every_cell[model]=0; }
                        }
                        resource=resource+1;
                    }
                    mode=mode+1;
                }
                b=b+1;
            }
            _zag_print("e51e_no_unique_every_cell_safety_gate,"); e45_print_i32(model); _zag_print(","); e45_print_i32(no_unique_every_cell[model]); _zag_println("");
            model=model+1;
        }

        let p:i32=0;
        let s:i32=p*E51B_AGG_FIELDS;
        let behavior_gate:i32=0;
        if(joint_aggregate[s+E51B_M_CONTINUED]>0 && joint_aggregate[s+E51B_M_CONTINUED]<joint_aggregate[s+E51B_M_EPISODES]){ behavior_gate=1; }
        let utility_gate:i32=0;
        if(joint_aggregate[s+E51B_M_UTILITY]>frozen_control_aggregate[s+E51B_M_UTILITY]){ utility_gate=1; }
        let safety_gate:i32=0;
        if(joint_aggregate[s+E51B_M_NO_UNIQUE_WRONG]<=frozen_sequential_aggregate[s+E51B_M_NO_UNIQUE_WRONG] && joint_aggregate[s+E51B_M_KNOWN_SUCCESS]>=frozen_sequential_aggregate[s+E51B_M_KNOWN_SUCCESS] && joint_aggregate[s+E51B_M_KNOWN_WRONG]<=frozen_sequential_aggregate[s+E51B_M_KNOWN_WRONG]){ safety_gate=1; }
        if(behavior_gate==1 && utility_gate==1 && safety_gate==1 && no_unique_every_cell[0]==1){ candidate_gate=1; }
        e45_print_pair("e51e_nontrivial_behavior_gate",behavior_gate);
        e45_print_pair("e51e_net_utility_gate",utility_gate);
        e45_print_pair("e51e_frozen_sequential_noninferiority_gate",safety_gate);
        e45_print_pair("e51e_validation_candidate_gate",candidate_gate);

        _zag_println("e51e_joint_stop_histogram_columns,model,observations,count");
        model=0;
        while(model<E51E_MODELS){
            let observations:i32=0;
            while(observations<=E45_TAPE){
                _zag_print("e51e_joint_stop_histogram,"); e45_print_i32(model); _zag_print(","); e45_print_i32(observations); _zag_print(","); e45_print_i32(joint_stop_histogram[model*(E45_TAPE+1)+observations]); _zag_println("");
                observations=observations+1;
            }
            model=model+1;
        }
        zfree(no_unique_every_cell);
    }

    if(stage1_primary_pass==0){
        _zag_println("e51e_outcome,TERMINAL_REFIT_REACHABILITY_VETO");
        _zag_println("TNN_R32_E51E_JOINT_ACTION_VALUE_GATE=FAIL");
    }else{
        if(candidate_gate==1){
            _zag_println("e51e_outcome,VALIDATION_PASS_CONFIRMATION_EARNED");
            _zag_println("TNN_R32_E51E_JOINT_ACTION_VALUE_GATE=PASS");
        }else{
            _zag_println("e51e_outcome,NO_VALIDATED_JOINT_ACTION_VALUE_RESCUE");
            _zag_println("TNN_R32_E51E_JOINT_ACTION_VALUE_GATE=FAIL");
        }
    }
    e45_print_pair("e51e_confirmation_earned",candidate_gate);
    e45_print_pair("e51e_sealed_confirmation_executed_final",0);

    let completion_gate:i32=stage1_integrity;
    e45_print_pair("e51e_execution_integrity_completion_gate",completion_gate);

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(terminal_records); zfree(continue_records); zfree(frozen_continue_records);
    zfree(terminal_weights); zfree(terminal_biases); zfree(continue_weights); zfree(continue_biases); zfree(frozen_continue_weights); zfree(frozen_continue_biases);
    zfree(backup_weights); zfree(backup_biases); zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse); zfree(forward_copy_weights); zfree(forward_copy_biases);
    zfree(reach); zfree(reach_gate);
    zfree(frozen_control_aggregate); zfree(frozen_sequential_aggregate); zfree(frozen_cell_metrics); zfree(frozen_stop_histogram);
    zfree(joint_aggregate); zfree(joint_cell_metrics); zfree(joint_stop_histogram);
    zfree(frozen_target_positive); zfree(frozen_target_negative); zfree(frozen_target_zero);
    return completion_gate;
}

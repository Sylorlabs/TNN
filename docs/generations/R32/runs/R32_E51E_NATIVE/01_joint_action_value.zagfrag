// R32 E51E joint sequential action-value discriminator.
// Reuses E50/E51B generic learner-visible representations and the deterministic
// batch fitter. Evaluator truth is converted only into the pre-existing generic
// scalar terminal utility target; evaluator labels never enter features or policy.

const E51E_DEV_EPISODES:i32=3240;
const E51E_VALIDATION_EPISODES:i32=5400;
const E51E_CONFIRM_EPISODES:i32=10800;
const E51E_SAMPLES:i32=55080;
const E51E_MODELS:i32=2;

fn e51e_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51E_DEV_EPISODES);
    e45_zero(validation_seeds,E51E_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51E_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,30,index,mode,resource,&failures);
                        dev_seeds[index]=seed;
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,31,index,mode,resource,&failures);
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,32,index,mode,resource,&failures);
                    confirmation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51e_seed_manifest_emitted",emitted);
    e45_print_pair("e51e_seed_assignment_failures",failures);
    e45_print_pair("e51e_sealed_confirmation_allocated",E51E_CONFIRM_EPISODES);
    e45_print_pair("e51e_sealed_confirmation_executed",0);
    if(failures==0 && emitted==E51E_DEV_EPISODES+E51E_VALIDATION_EPISODES+E51E_CONFIRM_EPISODES){ return 1; }
    return 0;
}

fn e51e_build_training_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_records:[]i32,
    continue_records:[]i32,
    unknown_target_nonzero:*i32,
    continue_positive:*i32,
    continue_negative:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let terminal_best:[]i32=zalloc_i(E45_TAPE+1);
    let recursive_best:[]i32=zalloc_i(E45_TAPE+1);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }

        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0;
        let contradiction_co_mass:i32=0;
        e47_terminal_representation(
            states,t*E45_STATE_N,terminal_option,0,&co_viability,&contradiction_co_mass
        );
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t;
        let record_start:i32=record_number*E50_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            terminal_records[record_start+feature]=baseline_features[feature];
            feature=feature+1;
        }
        terminal_records[record_start+32]=co_viability;
        terminal_records[record_start+33]=contradiction_co_mass;
        let action:i32=0;
        let best:i32=-4000;
        while(action<4){
            let target:i32=e45_terminal_value(action,states,t*E45_STATE_N,initial_state,truth_state[t]);
            terminal_records[record_start+34+action]=target;
            if(action==R32E45_TERM_UNKNOWN && target!=0){ unknown_target_nonzero.*=unknown_target_nonzero.*+1; }
            if(target>best){ best=target; }
            action=action+1;
        }
        terminal_best[t]=best;

        e51b_continuation_features(
            states,t*E45_STATE_N,option,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,
            full_features,baseline_features,continuation_features
        );
        feature=0;
        while(feature<E45_FEATURES){
            continue_records[record_start+feature]=continuation_features[feature];
            feature=feature+1;
        }
        continue_records[record_start+32]=continuation_features[3];
        continue_records[record_start+33]=continuation_features[5];

        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    recursive_best[E45_TAPE]=terminal_best[E45_TAPE];
    let rt:i32=E45_TAPE-1;
    while(rt>=0){
        recursive_best[rt]=terminal_best[rt];
        if(feasible[rt]==1){
            let continue_return:i32=0-losses[rt]+recursive_best[rt+1];
            if(continue_return>recursive_best[rt]){ recursive_best[rt]=continue_return; }
        }
        rt=rt-1;
    }

    t=0;
    while(t<=E45_TAPE){
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t;
        let record_start:i32=record_number*E50_RECORD_N;
        let target:i32=-3000;
        if(t<E45_TAPE && feasible[t]==1){
            target=r32e45_clamp(0-losses[t]+recursive_best[t+1],-3000,3000);
        }
        continue_records[record_start+34]=target;
        continue_records[record_start+35]=target;
        continue_records[record_start+36]=target;
        continue_records[record_start+37]=target;
        if(target>terminal_best[t]){ continue_positive.*=continue_positive.*+1;
        }else{ continue_negative.*=continue_negative.*+1; }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(baseline_features); zfree(continuation_features);
    zfree(terminal_best); zfree(recursive_best);
}

fn e51e_weight_audit(weights:[]i32,biases:[]i32,model:i32,nonzero:*i32,mass:*i64,max_abs:*i32)void {
    nonzero.*=0;
    mass.*=0;
    max_abs.*=0;
    let action:i32=0;
    while(action<4){
        let b:i32=r32e45_abs(biases[model*4+action]);
        if(b>0){ nonzero.*=nonzero.*+1; }
        mass.*=mass.*+(b as i64);
        if(b>max_abs.*){ max_abs.*=b; }
        let feature:i32=0;
        while(feature<E45_FEATURES){
            let v:i32=r32e45_abs(weights[(model*4+action)*E45_FEATURES+feature]);
            if(v>0){ nonzero.*=nonzero.*+1; }
            mass.*=mass.*+(v as i64);
            if(v>max_abs.*){ max_abs.*=v; }
            feature=feature+1;
        }
        action=action+1;
    }
}

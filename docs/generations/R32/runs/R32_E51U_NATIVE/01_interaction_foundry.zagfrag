// R32 E51U — learner-selected local feature interactions inside fixed 32 routed cells.

const E51U_DEV_EPISODES:i32=12960;
const E51U_DEV_SAMPLES:i32=220320;
const E51U_VALIDATION_EPISODES:i32=5400;
const E51U_VALIDATION_SAMPLES:i32=91800;
const E51U_CONFIRM_EPISODES:i32=10800;
const E51U_CONFIRM_SAMPLES:i32=183600;
const E51U_STAGE_DEV:i32=72;
const E51U_STAGE_VALIDATION:i32=73;
const E51U_STAGE_CONFIRM:i32=74;
const E51U_CELLS:i32=32;
const E51U_TERMS_PER_CELL:i32=2;
const E51U_ARMS:i32=4;
const E51U_MODE_FIELDS:i32=3;

fn e51u_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0; while(i<E51U_DEV_EPISODES){ dev[i]=e51n_world_id(E51U_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51U_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51U_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51U_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51U_STAGE_CONFIRM,i); i=i+1; }
    let dlo:i32=dev[0]; let dhi:i32=dev[E51U_DEV_EPISODES-1]; let vlo:i32=validation[0]; let vhi:i32=validation[E51U_VALIDATION_EPISODES-1]; let clo:i32=confirmation[0]; let chi:i32=confirmation[E51U_CONFIRM_EPISODES-1];
    let partition:i32=0; if(dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d); if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o); if(!(hi<olo || ohi<lo)){ domains=0; } o=o+1; }
        d=d+1;
    }
    e45_print_pair("e51u_world_id_dev_lo",dlo); e45_print_pair("e51u_world_id_dev_hi",dhi); e45_print_pair("e51u_world_id_validation_lo",vlo); e45_print_pair("e51u_world_id_validation_hi",vhi); e45_print_pair("e51u_world_id_confirmation_lo",clo); e45_print_pair("e51u_world_id_confirmation_hi",chi); e45_print_pair("e51u_world_partition_gate",partition); e45_print_pair("e51u_domain_gate",domains); e45_print_pair("e51u_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51u_pair_basis(records:[]i32,record_start:i32,first:i32,second:i32)i32 {
    let a:i64=e50_batch_column(records,record_start,first+1,0) as i64;
    let b:i64=e50_batch_column(records,record_start,second+1,0) as i64;
    let v:i64=e50_signed_div_i64(a*b,1000);
    return e51m_clamp_i64(v,-4000,4000);
}

fn e51u_pair_used(pair_i:[]i32,pair_j:[]i32,cell:i32,terms:i32,first:i32,second:i32)i32 {
    let k:i32=0; while(k<terms){ let slot:i32=cell*E51U_TERMS_PER_CELL+k; if(pair_i[slot]==first && pair_j[slot]==second){ return 1; } k=k+1; } return 0;
}

fn e51u_fit_interactions(
    records:[]i32,targets:[]i32,count:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    linear_weights:[]i32,linear_weight_start:i32,linear_biases:[]i32,linear_bias_start:i32,
    reverse:i32,
    pair_i:[]i32,pair_j:[]i32,coefficients:[]i32,term_counts:[]i32,
    accepted_terms:*i32,trace_hash:*i32,final_loss_low:*i32,final_loss_high:*i32,strict_loss_gate:*i32
)void {
    let slot:i32=0; while(slot<E51U_CELLS*E51U_TERMS_PER_CELL){ pair_i[slot]=-1; pair_j[slot]=-1; coefficients[slot]=0; slot=slot+1; }
    e45_zero(term_counts,E51U_CELLS); accepted_terms.*=0; trace_hash.*=5209; strict_loss_gate.*=1;
    let residuals:[]i32=zalloc_i(count); let heads:[]i32=zalloc_i(E51U_CELLS); let next:[]i32=zalloc_i(count);
    let cell:i32=0; while(cell<E51U_CELLS){ heads[cell]=-1; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal; if(reverse==1){ index=count-1-traversal; }
        let rs:i32=index*E50_RECORD_N;
        let routed:i32=e51p_route_cell(records,rs,prototypes,parents,ranges,E51U_CELLS);
        let predicted:i32=e51p_expert_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,E51U_CELLS,linear_weights,linear_weight_start,linear_biases,linear_bias_start);
        residuals[index]=targets[index]-predicted; next[index]=heads[routed]; heads[routed]=index;
        traversal=traversal+1;
    }
    let current_loss:i64=0; traversal=0; while(traversal<count){ let r:i64=residuals[traversal] as i64; current_loss=current_loss+r*r; traversal=traversal+1; }
    let round:i32=0;
    while(round<E51U_TERMS_PER_CELL){
        cell=0;
        while(cell<E51U_CELLS){
            let before:i64=0; let idx:i32=heads[cell]; while(idx>=0){ let r:i64=residuals[idx] as i64; before=before+r*r; idx=next[idx]; }
            let best_loss:i64=before; let best_i:i32=-1; let best_j:i32=-1; let best_coeff:i32=0;
            let first:i32=0;
            while(first<E45_FEATURES){
                let second:i32=first+1;
                while(second<E45_FEATURES){
                    if(e51u_pair_used(pair_i,pair_j,cell,round,first,second)==0){
                        let numerator:i64=0; let denominator:i64=0; idx=heads[cell];
                        while(idx>=0){ let rs:i32=idx*E50_RECORD_N; let basis:i32=e51u_pair_basis(records,rs,first,second); numerator=numerator+(residuals[idx] as i64)*(basis as i64); denominator=denominator+(basis as i64)*(basis as i64); idx=next[idx]; }
                        if(denominator>0){
                            let coeff:i32=e50_round_nearest_i64(numerator*1000,denominator) as i32; coeff=r32e45_clamp(coeff,-16000,16000);
                            if(coeff!=0){
                                let after:i64=0; idx=heads[cell];
                                while(idx>=0){ let rs:i32=idx*E50_RECORD_N; let basis:i32=e51u_pair_basis(records,rs,first,second); let nr:i32=residuals[idx]-coeff*basis/1000; after=after+(nr as i64)*(nr as i64); idx=next[idx]; }
                                if(after<best_loss){ best_loss=after; best_i=first; best_j=second; best_coeff=coeff; }
                            }
                        }
                    }
                    second=second+1;
                }
                first=first+1;
            }
            if(best_i>=0){
                let term_slot:i32=cell*E51U_TERMS_PER_CELL+round; pair_i[term_slot]=best_i; pair_j[term_slot]=best_j; coefficients[term_slot]=best_coeff; term_counts[cell]=term_counts[cell]+1; accepted_terms.*=accepted_terms.*+1;
                idx=heads[cell];
                while(idx>=0){ let rs:i32=idx*E50_RECORD_N; let basis:i32=e51u_pair_basis(records,rs,best_i,best_j); residuals[idx]=residuals[idx]-best_coeff*basis/1000; idx=next[idx]; }
                current_loss=current_loss+(best_loss-before); if(best_loss>=before){ strict_loss_gate.*=0; }
                trace_hash.*=e46_hash_update(trace_hash.*,round); trace_hash.*=e46_hash_update(trace_hash.*,cell); trace_hash.*=e46_hash_update(trace_hash.*,best_i); trace_hash.*=e46_hash_update(trace_hash.*,best_j); trace_hash.*=e46_hash_update(trace_hash.*,best_coeff); trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
            }
            cell=cell+1;
        }
        round=round+1;
    }
    final_loss_low.*=e50_loss_low(current_loss); final_loss_high.*=e50_loss_high(current_loss);
    zfree(residuals); zfree(heads); zfree(next);
}

fn e51u_interaction_identity(
    ai:[]i32,aj:[]i32,ac:[]i32,an:[]i32,a_terms:i32,a_trace:i32,a_low:i32,a_high:i32,a_strict:i32,
    bi:[]i32,bj:[]i32,bc:[]i32,bn:[]i32,b_terms:i32,b_trace:i32,b_low:i32,b_high:i32,b_strict:i32
)i32 {
    if(a_terms!=b_terms || a_trace!=b_trace || a_low!=b_low || a_high!=b_high || a_strict!=1 || b_strict!=1){ return 0; }
    let cell:i32=0; while(cell<E51U_CELLS){ if(an[cell]!=bn[cell]){ return 0; } let t:i32=0; while(t<E51U_TERMS_PER_CELL){ let s:i32=cell*E51U_TERMS_PER_CELL+t; if(ai[s]!=bi[s] || aj[s]!=bj[s] || ac[s]!=bc[s]){ return 0; } t=t+1; } cell=cell+1; }
    return 1;
}

fn e51u_interaction_predict(
    records:[]i32,record_start:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    linear_weights:[]i32,linear_weight_start:i32,linear_biases:[]i32,linear_bias_start:i32,
    pair_i:[]i32,pair_j:[]i32,coefficients:[]i32,term_counts:[]i32,capacity:i32
)i32 {
    let value:i32=e51p_expert_predict(records,record_start,global_weights,global_bias,prototypes,parents,ranges,E51U_CELLS,linear_weights,linear_weight_start,linear_biases,linear_bias_start);
    let cell:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,E51U_CELLS);
    let usable:i32=term_counts[cell]; if(usable>capacity){ usable=capacity; }
    let t:i32=0;
    while(t<usable){ let s:i32=cell*E51U_TERMS_PER_CELL+t; let basis:i32=e51u_pair_basis(records,record_start,pair_i[s],pair_j[s]); value=value+coefficients[s]*basis/1000; t=t+1; }
    return r32e45_clamp(value,-4000,4000);
}

fn e51u_episode_reached(
    records:[]i32,episode:i32,no_unique:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    linear_weights:[]i32,linear_weight_start:i32,linear_biases:[]i32,linear_bias_start:i32,
    pair_i:[]i32,pair_j:[]i32,coefficients:[]i32,term_counts:[]i32,capacity:i32,use_interactions:i32
)i32 {
    let t:i32=0;
    while(t<=E45_TAPE){
        let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
        let action:i32=e51m_top_commit(records,rs,terminal_weights,terminal_biases);
        let score:i32=e51p_expert_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,E51U_CELLS,linear_weights,linear_weight_start,linear_biases,linear_bias_start);
        if(use_interactions==1){ score=e51u_interaction_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,linear_weights,linear_weight_start,linear_biases,linear_bias_start,pair_i,pair_j,coefficients,term_counts,capacity); }
        if(no_unique==1){ if(score<0){ return 1; }
        }else{ if(score>=0 && records[rs+34+action]==1000){ return 1; } }
        t=t+1;
    }
    return 0;
}

fn e51u_switch_mode(mode:i32)i32 { if(mode==3 || mode==4 || mode==5 || mode==7 || mode==8){ return 1; } return 0; }

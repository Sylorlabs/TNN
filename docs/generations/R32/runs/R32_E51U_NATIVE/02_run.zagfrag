fn e51u_sign_accuracy(
    records:[]i32,targets:[]i32,count:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    linear_weights:[]i32,linear_weight_start:i32,linear_biases:[]i32,linear_bias_start:i32,
    pair_i:[]i32,pair_j:[]i32,coefficients:[]i32,term_counts:[]i32,capacity:i32,use_interactions:i32,
    positive_total:*i32,positive_correct:*i32,negative_total:*i32,negative_correct:*i32
)void {
    positive_total.*=0; positive_correct.*=0; negative_total.*=0; negative_correct.*=0;
    let index:i32=0;
    while(index<count){
        let rs:i32=index*E50_RECORD_N;
        let score:i32=e51p_expert_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,E51U_CELLS,linear_weights,linear_weight_start,linear_biases,linear_bias_start);
        if(use_interactions==1){ score=e51u_interaction_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,linear_weights,linear_weight_start,linear_biases,linear_bias_start,pair_i,pair_j,coefficients,term_counts,capacity); }
        if(targets[index]>0){ positive_total.*=positive_total.*+1; if(score>=0){ positive_correct.*=positive_correct.*+1; } }
        if(targets[index]<0){ negative_total.*=negative_total.*+1; if(score<0){ negative_correct.*=negative_correct.*+1; } }
        index=index+1;
    }
}

fn e51u_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51U_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51u_local_interaction_foundry_v1");
    _zag_println("claim_boundary,native_local_interaction_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0");
    _zag_println("commit_order_changed=0");
    _zag_println("routing_cells_fixed=32");
    _zag_println("pair_researcher_selected=0");
    _zag_println("cross_cell_edges_added=0");
    _zag_println("graph_privileged=0");

    let dev_worlds:[]i32=zalloc_i(E51U_DEV_EPISODES); let validation_worlds:[]i32=zalloc_i(E51U_VALIDATION_EPISODES); let confirmation_worlds:[]i32=zalloc_i(E51U_CONFIRM_EPISODES);
    let world_gate:i32=e51u_allocate_worlds(dev_worlds,validation_worlds,confirmation_worlds);
    let dev_records:[]i32=zalloc_i(E51U_DEV_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51U_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51U_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51U_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0; let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy);
    e45_print_pair("e51u_development_episodes_built",canonical_episode); e45_print_pair("e51u_development_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51u_dev_unknown_target_nonzero",dev_unknown_nonzero);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0; while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }

    let sign_targets:[]i32=zalloc_i(E51U_DEV_SAMPLES); let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51U_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51U_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51U_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let linear_identity_gate:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_f:i32=0; let tree_trace_f:i32=0; let tree_loss_f:i64=0; let tree_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tree_count_f,&tree_trace_f,&tree_loss_f,&tree_strict_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_r:i32=0; let tree_trace_r:i32=0; let tree_loss_r:i64=0; let tree_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tree_count_r,&tree_trace_r,&tree_loss_r,&tree_strict_r);
    let tree_identity_gate:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tree_count_f,tree_trace_f,tree_loss_f,tree_strict_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tree_count_r,tree_trace_r,tree_loss_r,tree_strict_r);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51U_DEV_SAMPLES,root,ranges);

    // Produce matched 96/192 linear snapshots cumulatively.
    let sw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let sb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let su:[]i32=zalloc_i(E51S_SNAPSHOTS); let ss:[]i32=zalloc_i(E51S_SNAPSHOTS); let sr:[]i32=zalloc_i(E51S_SNAPSHOTS); let st:[]i32=zalloc_i(E51S_SNAPSHOTS); let sll:[]i32=zalloc_i(E51S_SNAPSHOTS); let slh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_linear_f:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,0,sw,sb,su,ss,sr,st,sll,slh,&strict_linear_f);
    let rw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let rb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let ru:[]i32=zalloc_i(E51S_SNAPSHOTS); let rs:[]i32=zalloc_i(E51S_SNAPSHOTS); let rr:[]i32=zalloc_i(E51S_SNAPSHOTS); let rt:[]i32=zalloc_i(E51S_SNAPSHOTS); let rll:[]i32=zalloc_i(E51S_SNAPSHOTS); let rlh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_linear_r:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,1,rw,rb,ru,rs,rr,rt,rll,rlh,&strict_linear_r);
    let snapshot_identity_gate:i32=e51s_snapshots_identity(sw,sb,su,ss,sr,st,sll,slh,rw,rb,ru,rs,rr,rt,rll,rlh);
    _zag_print("e51u_linear_snapshots,"); e45_print_i32(ss[1]); _zag_print(","); e45_print_i32(su[1]); _zag_print(","); e45_print_i32(ss[2]); _zag_print(","); e45_print_i32(su[2]); _zag_println("");

    // Learner-owned pair interactions start from the 96-sweep linear snapshot.
    let linear96_ws:i32=1*E51P_MAX_CELLS*E45_FEATURES; let linear96_bs:i32=1*E51P_MAX_CELLS;
    let pair_i:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let pair_j:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let coeffs:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let term_counts:[]i32=zalloc_i(E51U_CELLS);
    let accepted_f:i32=0; let trace_f:i32=0; let loss_low_f:i32=0; let loss_high_f:i32=0; let strict_interaction_f:i32=0;
    e51u_fit_interactions(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,sw,linear96_ws,sb,linear96_bs,0,pair_i,pair_j,coeffs,term_counts,&accepted_f,&trace_f,&loss_low_f,&loss_high_f,&strict_interaction_f);
    let rpair_i:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let rpair_j:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let rcoeffs:[]i32=zalloc_i(E51U_CELLS*E51U_TERMS_PER_CELL); let rterm_counts:[]i32=zalloc_i(E51U_CELLS);
    let accepted_r:i32=0; let trace_r:i32=0; let loss_low_r:i32=0; let loss_high_r:i32=0; let strict_interaction_r:i32=0;
    e51u_fit_interactions(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,sw,linear96_ws,sb,linear96_bs,1,rpair_i,rpair_j,rcoeffs,rterm_counts,&accepted_r,&trace_r,&loss_low_r,&loss_high_r,&strict_interaction_r);
    let interaction_identity_gate:i32=e51u_interaction_identity(pair_i,pair_j,coeffs,term_counts,accepted_f,trace_f,loss_low_f,loss_high_f,strict_interaction_f,rpair_i,rpair_j,rcoeffs,rterm_counts,accepted_r,trace_r,loss_low_r,loss_high_r,strict_interaction_r);
    e45_print_pair("e51u_interaction_forward_reverse_identity_gate",interaction_identity_gate); e45_print_pair("e51u_interaction_terms_accepted",accepted_f); e45_print_pair("e51u_interaction_trace_hash",trace_f); e45_print_pair("e51u_interaction_loss_low",loss_low_f); e45_print_pair("e51u_interaction_loss_high",loss_high_f);
    let cell:i32=0; while(cell<E51U_CELLS){ _zag_print("e51u_cell_terms,"); e45_print_i32(cell); _zag_print(","); e45_print_i32(term_counts[cell]); let q:i32=0; while(q<term_counts[cell]){ let s:i32=cell*E51U_TERMS_PER_CELL+q; _zag_print(","); e45_print_i32(pair_i[s]); _zag_print(":"); e45_print_i32(pair_j[s]); _zag_print(":"); e45_print_i32(coeffs[s]); q=q+1; } _zag_println(""); cell=cell+1; }

    // Development sign metrics for all four arms.
    let dev_sign:[]i32=zalloc_i(E51U_ARMS*4);
    let arm:i32=0;
    while(arm<E51U_ARMS){
        let ws:i32=linear96_ws; let bs:i32=linear96_bs; let capacity:i32=0; let interactions:i32=0;
        if(arm==1){ ws=2*E51P_MAX_CELLS*E45_FEATURES; bs=2*E51P_MAX_CELLS; }
        if(arm==2){ capacity=1; interactions=1; }
        if(arm==3){ capacity=2; interactions=1; }
        let pt:i32=0; let pc:i32=0; let nt:i32=0; let nc:i32=0;
        e51u_sign_accuracy(dev_records,sign_targets,E51U_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,sw,ws,sb,bs,pair_i,pair_j,coeffs,term_counts,capacity,interactions,&pt,&pc,&nt,&nc);
        let m:i32=arm*4; dev_sign[m]=pt; dev_sign[m+1]=pc; dev_sign[m+2]=nt; dev_sign[m+3]=nc;
        arm=arm+1;
    }

    // Untouched validation worlds.
    let validation_records:[]i32=zalloc_i(E51U_VALIDATION_SAMPLES*E50_RECORD_N); let validation_dummy:[]i32=zalloc_i(E51U_VALIDATION_SAMPLES*E50_RECORD_N); let validation_types:[]i32=zalloc_i(E51U_VALIDATION_EPISODES); let validation_modes:[]i32=zalloc_i(E51U_VALIDATION_EPISODES); let validation_targets:[]i32=zalloc_i(E51U_VALIDATION_SAMPLES);
    e45_zero(validation_records,E51U_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(validation_dummy,E51U_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_types[canonical_episode]=0; if(mode==0 || mode==1){ validation_types[canonical_episode]=1; } validation_modes[canonical_episode]=mode;
                    e51e_build_training_episode(validation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,validation_records,validation_dummy,&validation_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_dummy); e51m_build_validation_targets(validation_records,E51U_VALIDATION_SAMPLES,terminal_weights,terminal_biases,validation_targets);
    e45_print_pair("e51u_validation_episodes_built",canonical_episode); e45_print_pair("e51u_validation_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51u_validation_unknown_target_nonzero",validation_unknown_nonzero);

    let val_sign:[]i32=zalloc_i(E51U_ARMS*4); let known_reach:[]i32=zalloc_i(E51U_ARMS); let unknown_reach:[]i32=zalloc_i(E51U_ARMS); let known_total:i32=0; let unknown_total:i32=0;
    let paired_gained:[]i32=zalloc_i(E51U_ARMS); let paired_lost:[]i32=zalloc_i(E51U_ARMS); let switch_lost:[]i32=zalloc_i(E51U_ARMS); let mode_metrics:[]i32=zalloc_i(E51U_ARMS*E45_MODES*E51U_MODE_FIELDS);
    arm=0;
    while(arm<E51U_ARMS){
        let ws:i32=linear96_ws; let bs:i32=linear96_bs; let capacity:i32=0; let interactions:i32=0;
        if(arm==1){ ws=2*E51P_MAX_CELLS*E45_FEATURES; bs=2*E51P_MAX_CELLS; }
        if(arm==2){ capacity=1; interactions=1; } if(arm==3){ capacity=2; interactions=1; }
        let pt:i32=0; let pc:i32=0; let nt:i32=0; let nc:i32=0;
        e51u_sign_accuracy(validation_records,validation_targets,E51U_VALIDATION_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,sw,ws,sb,bs,pair_i,pair_j,coeffs,term_counts,capacity,interactions,&pt,&pc,&nt,&nc);
        let m:i32=arm*4; val_sign[m]=pt; val_sign[m+1]=pc; val_sign[m+2]=nt; val_sign[m+3]=nc;
        arm=arm+1;
    }
    let episode:i32=0;
    while(episode<E51U_VALIDATION_EPISODES){
        let nu:i32=validation_types[episode]; if(nu==1){ unknown_total=unknown_total+1; }else{ known_total=known_total+1; }
        let base_success:i32=e51u_episode_reached(validation_records,episode,nu,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,sw,linear96_ws,sb,linear96_bs,pair_i,pair_j,coeffs,term_counts,0,0);
        arm=0;
        while(arm<E51U_ARMS){
            let ws:i32=linear96_ws; let bs:i32=linear96_bs; let capacity:i32=0; let interactions:i32=0;
            if(arm==1){ ws=2*E51P_MAX_CELLS*E45_FEATURES; bs=2*E51P_MAX_CELLS; }
            if(arm==2){ capacity=1; interactions=1; } if(arm==3){ capacity=2; interactions=1; }
            let success:i32=e51u_episode_reached(validation_records,episode,nu,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,sw,ws,sb,bs,pair_i,pair_j,coeffs,term_counts,capacity,interactions);
            if(nu==1){ unknown_reach[arm]=unknown_reach[arm]+success; }else{ known_reach[arm]=known_reach[arm]+success; }
            if(base_success==0 && success==1){ paired_gained[arm]=paired_gained[arm]+1; }
            if(base_success==1 && success==0){ paired_lost[arm]=paired_lost[arm]+1; if(e51u_switch_mode(validation_modes[episode])==1){ switch_lost[arm]=switch_lost[arm]+1; } }
            let mm:i32=(arm*E45_MODES+validation_modes[episode])*E51U_MODE_FIELDS; mode_metrics[mm]=mode_metrics[mm]+1; mode_metrics[mm+1]=mode_metrics[mm+1]+success; mode_metrics[mm+2]=mode_metrics[mm+2]+base_success;
            arm=arm+1;
        }
        episode=episode+1;
    }
    _zag_println("e51u_validation_columns,arm_0_linear96_1_linear192_2_pair1_3_pair2,known_reachable,known_total,no_unique_reachable,no_unique_total,paired_gained_vs96,paired_lost_vs96,switch_lost_vs96,dev_pos_correct,dev_pos_total,dev_neg_correct,dev_neg_total,val_pos_correct,val_pos_total,val_neg_correct,val_neg_total");
    arm=0;
    while(arm<E51U_ARMS){ let dm:i32=arm*4; let vm:i32=arm*4; _zag_print("e51u_validation,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(known_reach[arm]); _zag_print(","); e45_print_i32(known_total); _zag_print(","); e45_print_i32(unknown_reach[arm]); _zag_print(","); e45_print_i32(unknown_total); _zag_print(","); e45_print_i32(paired_gained[arm]); _zag_print(","); e45_print_i32(paired_lost[arm]); _zag_print(","); e45_print_i32(switch_lost[arm]); _zag_print(","); e45_print_i32(dev_sign[dm+1]); _zag_print(","); e45_print_i32(dev_sign[dm]); _zag_print(","); e45_print_i32(dev_sign[dm+3]); _zag_print(","); e45_print_i32(dev_sign[dm+2]); _zag_print(","); e45_print_i32(val_sign[vm+1]); _zag_print(","); e45_print_i32(val_sign[vm]); _zag_print(","); e45_print_i32(val_sign[vm+3]); _zag_print(","); e45_print_i32(val_sign[vm+2]); _zag_println(""); arm=arm+1; }
    _zag_println("e51u_mode_columns,arm,mode,total,success,control96_success"); arm=0; while(arm<E51U_ARMS){ let mode:i32=0; while(mode<E45_MODES){ let mm:i32=(arm*E45_MODES+mode)*E51U_MODE_FIELDS; _zag_print("e51u_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); _zag_print(","); e45_print_i32(mode_metrics[mm]); _zag_print(","); e45_print_i32(mode_metrics[mm+1]); _zag_print(","); e45_print_i32(mode_metrics[mm+2]); _zag_println(""); mode=mode+1; } arm=arm+1; }

    let counts_gate:i32=0; if(canonical_episode==E51U_VALIDATION_EPISODES && known_total==4200 && unknown_total==1200){ counts_gate=1; }
    let target_gate:i32=0; if(dev_unknown_nonzero==0 && validation_unknown_nonzero==0 && unknown_parameter_nonzero==0 && dev_positive>0 && dev_negative>0){ target_gate=1; }
    let nondegenerate:i32=0; if(accepted_f>0){ nondegenerate=1; }
    let integrity_gate:i32=0;
    if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && tree_identity_gate==1 && tree_strict_f==1 && tree_strict_r==1 && tree_count_f>=E51U_CELLS && snapshot_identity_gate==1 && strict_linear_f==1 && strict_linear_r==1 && interaction_identity_gate==1 && strict_interaction_f==1 && strict_interaction_r==1 && nondegenerate==1){ integrity_gate=1; }
    e45_print_pair("e51u_counts_gate",counts_gate); e45_print_pair("e51u_target_geometry_gate",target_gate); e45_print_pair("e51u_nondegenerate_gate",nondegenerate); e45_print_pair("e51u_integrity_gate",integrity_gate);

    let exact_arm:i32=-1; let partial_arm:i32=-1; let tradeoff:i32=0;
    arm=2;
    while(arm<E51U_ARMS){
        if(known_reach[arm]==known_total && unknown_reach[arm]==unknown_total && paired_lost[arm]==0 && switch_lost[arm]==0 && exact_arm<0){ exact_arm=arm; }
        if(paired_lost[arm]==0 && switch_lost[arm]==0 && unknown_reach[arm]>unknown_reach[0] && unknown_reach[arm]>unknown_reach[1] && partial_arm<0){ partial_arm=arm; }
        if((unknown_reach[arm]>unknown_reach[0] && paired_lost[arm]>0) || (known_reach[arm]>known_reach[0] && unknown_reach[arm]<unknown_reach[0])){ tradeoff=1; }
        arm=arm+1;
    }
    e45_print_pair("e51u_exact_validation_arm",exact_arm); e45_print_pair("e51u_partial_rescue_arm",partial_arm); e45_print_pair("e51u_tradeoff_gate",tradeoff);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(integrity_gate==1 && exact_arm>=2){
        let confirm_records:[]i32=zalloc_i(E51U_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_dummy:[]i32=zalloc_i(E51U_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_types:[]i32=zalloc_i(E51U_CONFIRM_EPISODES);
        e45_zero(confirm_records,E51U_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(confirm_dummy,E51U_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; base_index=0;
        while(base_index<6){ let mode:i32=0; while(mode<E45_MODES){ let resource:i32=0; while(resource<E45_RESOURCES){ let ep:i32=0; while(ep<40){ let index:i32=e46_confirm_index(base_index,mode,resource,ep); confirm_types[canonical_episode]=0; if(mode==0 || mode==1){ confirm_types[canonical_episode]=1; } e51e_build_training_episode(confirmation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,confirm_records,confirm_dummy,&confirm_unknown_nonzero,&dummy_positive,&dummy_negative); canonical_episode=canonical_episode+1; ep=ep+1; } resource=resource+1; } mode=mode+1; } base_index=base_index+1; }
        let capacity:i32=1; if(exact_arm==3){ capacity=2; }
        let kr:i32=0; let nr:i32=0; episode=0; while(episode<E51U_CONFIRM_EPISODES){ let nu:i32=confirm_types[episode]; let success:i32=e51u_episode_reached(confirm_records,episode,nu,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,sw,linear96_ws,sb,linear96_bs,pair_i,pair_j,coeffs,term_counts,capacity,1); if(nu==1){ nr=nr+success; }else{ kr=kr+success; } episode=episode+1; }
        confirmation_executed=canonical_episode; if(kr==8400 && nr==2400 && confirm_unknown_nonzero==0){ confirmation_exact=1; }
        _zag_print("e51u_confirmation,"); e45_print_i32(exact_arm); _zag_print(","); e45_print_i32(kr); _zag_print(",8400,"); e45_print_i32(nr); _zag_print(",2400,"); e45_print_i32(confirm_unknown_nonzero); _zag_println("");
        zfree(confirm_records); zfree(confirm_dummy); zfree(confirm_types);
    }
    e45_print_pair("e51u_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51u_confirmation_exact_gate",confirmation_exact);

    if(integrity_gate==0){ _zag_println("e51u_outcome,INVALID_LOCAL_INTERACTION_INTEGRITY_FAILURE");
    }else{
        if(exact_arm>=2){ if(confirmation_exact==1){ _zag_println("e51u_outcome,LOCAL_INTERACTION_RESCUE_CONFIRMED"); }else{ _zag_println("e51u_outcome,LOCAL_INTERACTION_VALIDATION_RESCUE_CONFIRMATION_FAIL"); }
        }else{
            if(partial_arm>=2){ _zag_println("e51u_outcome,LOCAL_INTERACTION_PARTIAL_RESCUE");
            }else{ if(tradeoff==1){ _zag_println("e51u_outcome,LOCAL_INTERACTION_TRADEOFF"); }else{ _zag_println("e51u_outcome,NO_TESTED_LOCAL_INTERACTION_RESCUE"); } }
        }
    }
    _zag_println("TNN_R32_E51U_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(validation_worlds); zfree(confirmation_worlds); zfree(dev_records); zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases); zfree(sign_targets); zfree(global_weights); zfree(reverse_global);
    zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root);
    zfree(sw); zfree(sb); zfree(su); zfree(ss); zfree(sr); zfree(st); zfree(sll); zfree(slh); zfree(rw); zfree(rb); zfree(ru); zfree(rs); zfree(rr); zfree(rt); zfree(rll); zfree(rlh);
    zfree(pair_i); zfree(pair_j); zfree(coeffs); zfree(term_counts); zfree(rpair_i); zfree(rpair_j); zfree(rcoeffs); zfree(rterm_counts); zfree(dev_sign); zfree(validation_records); zfree(validation_types); zfree(validation_modes); zfree(validation_targets); zfree(val_sign); zfree(known_reach); zfree(unknown_reach); zfree(paired_gained); zfree(paired_lost); zfree(switch_lost); zfree(mode_metrics);
    if(integrity_gate==1){ return 1; } return 0;
}

// R32 E51Y — helpers for the first direct five-way sequential evaluation
// after the confirmed E51X terminal reachability rescue.

const E51Y_TERM_DEV_STAGE:i32=81;
const E51Y_TERM_AUDIT_STAGE:i32=82;
const E51Y_CONT_DEV_STAGE:i32=84;
const E51Y_VALIDATION_STAGE:i32=85;
const E51Y_CONFIRM_STAGE:i32=86;
const E51Y_DEV_EPISODES:i32=12960;
const E51Y_DEV_SAMPLES:i32=220320;
const E51Y_VALIDATION_EPISODES:i32=5400;
const E51Y_VALIDATION_SAMPLES:i32=91800;
const E51Y_CONFIRM_EPISODES:i32=10800;
const E51Y_CONFIRM_SAMPLES:i32=183600;
const E51Y_CELLS:i32=32;
const E51Y_ARMS:i32=4;
const E51Y_CELL_FIELDS:i32=10;
const E51Y_C_TOTAL:i32=0;
const E51Y_C_NO_UNIQUE:i32=1;
const E51Y_C_NO_UNIQUE_UNKNOWN:i32=2;
const E51Y_C_NO_UNIQUE_WRONG:i32=3;
const E51Y_C_KNOWN:i32=4;
const E51Y_C_KNOWN_SUCCESS:i32=5;
const E51Y_C_KNOWN_WRONG:i32=6;
const E51Y_C_KNOWN_UNKNOWN:i32=7;
const E51Y_C_UTILITY:i32=8;
const E51Y_C_OBSERVATIONS:i32=9;

fn e51y_world_gate()i32 {
    let dev_lo:i32=e51n_world_id(E51Y_CONT_DEV_STAGE,0);
    let dev_hi:i32=e51n_world_id(E51Y_CONT_DEV_STAGE,E51Y_DEV_EPISODES-1);
    let val_lo:i32=e51n_world_id(E51Y_VALIDATION_STAGE,0);
    let val_hi:i32=e51n_world_id(E51Y_VALIDATION_STAGE,E51Y_VALIDATION_EPISODES-1);
    let con_lo:i32=e51n_world_id(E51Y_CONFIRM_STAGE,0);
    let con_hi:i32=e51n_world_id(E51Y_CONFIRM_STAGE,E51Y_CONFIRM_EPISODES-1);
    let partition:i32=0; if(dev_hi<val_lo && val_hi<con_lo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dev_lo,d); let hi:i64=e51n_domain_state(con_hi,d);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1;
        while(o<5){
            let olo:i64=e51n_domain_state(dev_lo,o); let ohi:i64=e51n_domain_state(con_hi,o);
            if(!(hi<olo || ohi<lo)){ domains=0; }
            o=o+1;
        }
        d=d+1;
    }
    e45_print_pair("e51y_world_id_dev_lo",dev_lo); e45_print_pair("e51y_world_id_dev_hi",dev_hi);
    e45_print_pair("e51y_world_id_validation_lo",val_lo); e45_print_pair("e51y_world_id_validation_hi",val_hi);
    e45_print_pair("e51y_world_id_confirmation_lo",con_lo); e45_print_pair("e51y_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51y_world_partition_gate",partition); e45_print_pair("e51y_domain_gate",domains); e45_print_pair("e51y_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51y_terminal_hash(
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,expert_biases:[]i32
)i32 {
    let h:i32=6101;
    let i:i32=0;
    while(i<4*E45_FEATURES){ h=e46_hash_update(h,terminal_weights[i]); i=i+1; }
    i=0; while(i<4){ h=e46_hash_update(h,terminal_biases[i]); i=i+1; }
    i=0; while(i<E45_FEATURES){ h=e46_hash_update(h,global_weights[i]); h=e46_hash_update(h,ranges[i]); i=i+1; }
    h=e46_hash_update(h,global_bias);
    i=0; while(i<E51Y_CELLS){
        h=e46_hash_update(h,parents[i]); h=e46_hash_update(h,expert_biases[i]);
        let f:i32=0; while(f<E45_FEATURES){ h=e46_hash_update(h,prototypes[i*E45_FEATURES+f]); h=e46_hash_update(h,expert_weights[i*E45_FEATURES+f]); f=f+1; }
        i=i+1;
    }
    return h;
}

fn e51y_terminal_choice(
    terminal_records:[]i32,record_start:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    terminal_expert_weights:[]i32,terminal_expert_biases:[]i32
)i32 {
    let scalar:i32=e51p_expert_predict(
        terminal_records,record_start,global_weights,global_bias,
        prototypes,parents,ranges,E51Y_CELLS,
        terminal_expert_weights,0,terminal_expert_biases,0
    );
    if(scalar<0){ return R32E45_TERM_UNKNOWN; }
    return e51m_top_commit(terminal_records,record_start,terminal_weights,terminal_biases);
}

fn e51y_stop_utility(
    terminal_records:[]i32,record_start:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    terminal_expert_weights:[]i32,terminal_expert_biases:[]i32
)i32 {
    let choice:i32=e51y_terminal_choice(
        terminal_records,record_start,terminal_weights,terminal_biases,
        global_weights,global_bias,prototypes,parents,ranges,
        terminal_expert_weights,terminal_expert_biases
    );
    if(choice==R32E45_TERM_UNKNOWN){ return 0; }
    return terminal_records[record_start+34+choice];
}

fn e51y_make_continue_targets_episode(
    world_id:i32,resource:i32,episode_index:i32,
    terminal_records:[]i32,targets:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    terminal_expert_weights:[]i32,terminal_expert_biases:[]i32,
    positive:*i32,negative:*i32
)void {
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let losses:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
    let stop_values:[]i32=zalloc_i(E45_TAPE+1); let best_values:[]i32=zalloc_i(E45_TAPE+1);
    let budget:i32=0; let action_cost:i32=0;
    e51n_make_resource(world_id,resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);
    let t:i32=0;
    while(t<=E45_TAPE){
        let rs:i32=(episode_index*(E45_TAPE+1)+t)*E50_RECORD_N;
        stop_values[t]=e51y_stop_utility(
            terminal_records,rs,terminal_weights,terminal_biases,global_weights,global_bias,
            prototypes,parents,ranges,terminal_expert_weights,terminal_expert_biases
        );
        t=t+1;
    }
    best_values[E45_TAPE]=stop_values[E45_TAPE];
    targets[episode_index*(E45_TAPE+1)+E45_TAPE]=-1000; negative.*=negative.*+1;
    t=E45_TAPE-1;
    while(t>=0){
        let target:i32=-1000;
        let best:i32=stop_values[t];
        if(feasible[t]==1){
            let continue_return:i32=0-losses[t]+best_values[t+1];
            if(continue_return>stop_values[t]){ target=1000; }
            if(continue_return>best){ best=continue_return; }
        }
        targets[episode_index*(E45_TAPE+1)+t]=target;
        if(target>0){ positive.*=positive.*+1; }else{ negative.*=negative.*+1; }
        best_values[t]=best;
        t=t-1;
    }
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(losses); zfree(feasible); zfree(stop_values); zfree(best_values);
}

fn e51y_cell_offset(arm:i32,mode:i32,resource:i32)i32 {
    return ((arm*E45_MODES+mode)*E45_RESOURCES+resource)*E51Y_CELL_FIELDS;
}

fn e51y_continue_prediction(
    arm:i32,continue_records:[]i32,record_start:i32,
    continue_global_weights:[]i32,continue_global_bias:i32,
    continue_prototypes:[]i32,continue_parents:[]i32,continue_ranges:[]i32,
    continue_expert_weights:[]i32,continue_expert_biases:[]i32
)i32 {
    if(arm==1){ return e51m_linear_scalar_predict(continue_records,record_start,continue_global_weights,0,continue_global_bias); }
    let expert_index:i32=arm-2;
    return e51p_expert_predict(
        continue_records,record_start,continue_global_weights,continue_global_bias,
        continue_prototypes,continue_parents,continue_ranges,E51Y_CELLS,
        continue_expert_weights,expert_index*E51Y_CELLS*E45_FEATURES,
        continue_expert_biases,expert_index*E51Y_CELLS
    );
}

fn e51y_eval(
    stage:i32,episodes:i32,per_cell:i32,active_arm:i32,
    terminal_records:[]i32,continue_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    terminal_global_weights:[]i32,terminal_global_bias:i32,
    terminal_prototypes:[]i32,terminal_parents:[]i32,terminal_ranges:[]i32,
    terminal_expert_weights:[]i32,terminal_expert_biases:[]i32,
    continue_global_weights:[]i32,continue_global_bias:i32,
    continue_prototypes:[]i32,continue_parents:[]i32,continue_ranges:[]i32,
    continue_expert_weights:[]i32,continue_expert_biases:[]i32,
    aggregate:[]i32,cell_metrics:[]i32,stop_histogram:[]i32,mode_wrong:[]i32,mode_success:[]i32
)void {
    e45_zero(aggregate,E51Y_ARMS*E51B_AGG_FIELDS);
    e45_zero(cell_metrics,E51Y_ARMS*E45_MODES*E45_RESOURCES*E51Y_CELL_FIELDS);
    e45_zero(stop_histogram,E51Y_ARMS*(E45_TAPE+1)); e45_zero(mode_wrong,E51Y_ARMS*E45_MODES); e45_zero(mode_success,E51Y_ARMS*E45_MODES);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES);
        let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
        let world_id:i32=e51n_world_id(stage,episode);
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let losses:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(world_id,resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);
        let arm:i32=0;
        while(arm<E51Y_ARMS){
            let evaluate:i32=1;
            if(active_arm>=0 && arm!=0 && arm!=active_arm){ evaluate=0; }
            if(evaluate==1){
                let observations:i32=0; let opportunity_loss:i32=0; let stopped:i32=0;
                while(stopped==0){
                    if(arm==0 || observations>=E45_TAPE || feasible[observations]==0){ stopped=1;
                    }else{
                        let crs:i32=(episode*(E45_TAPE+1)+observations)*E50_RECORD_N;
                        let preference:i32=e51y_continue_prediction(
                            arm,continue_records,crs,continue_global_weights,continue_global_bias,
                            continue_prototypes,continue_parents,continue_ranges,continue_expert_weights,continue_expert_biases
                        );
                        if(preference>0){
                            opportunity_loss=opportunity_loss+losses[observations]; observations=observations+1;
                        }else{ stopped=1; }
                    }
                }
                let trs:i32=(episode*(E45_TAPE+1)+observations)*E50_RECORD_N;
                let choice:i32=e51y_terminal_choice(
                    terminal_records,trs,terminal_weights,terminal_biases,
                    terminal_global_weights,terminal_global_bias,
                    terminal_prototypes,terminal_parents,terminal_ranges,
                    terminal_expert_weights,terminal_expert_biases
                );
                let terminal_utility:i32=0;
                if(choice!=R32E45_TERM_UNKNOWN){ terminal_utility=terminal_records[trs+34+choice]; }
                let utility:i32=terminal_utility-opportunity_loss;
                let hidden_truth:i32=0; if(mode==0 || mode==1){ hidden_truth=-1; }
                e51b_record_outcome(aggregate,arm*E51B_AGG_FIELDS,choice,utility,hidden_truth,observations,opportunity_loss);
                stop_histogram[arm*(E45_TAPE+1)+observations]=stop_histogram[arm*(E45_TAPE+1)+observations]+1;
                let cell:i32=e51y_cell_offset(arm,mode,resource);
                cell_metrics[cell+E51Y_C_TOTAL]=cell_metrics[cell+E51Y_C_TOTAL]+1;
                cell_metrics[cell+E51Y_C_UTILITY]=cell_metrics[cell+E51Y_C_UTILITY]+utility;
                cell_metrics[cell+E51Y_C_OBSERVATIONS]=cell_metrics[cell+E51Y_C_OBSERVATIONS]+observations;
                if(mode==0 || mode==1){
                    cell_metrics[cell+E51Y_C_NO_UNIQUE]=cell_metrics[cell+E51Y_C_NO_UNIQUE]+1;
                    if(choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+E51Y_C_NO_UNIQUE_UNKNOWN]=cell_metrics[cell+E51Y_C_NO_UNIQUE_UNKNOWN]+1; mode_success[arm*E45_MODES+mode]=mode_success[arm*E45_MODES+mode]+1;
                    }else{ cell_metrics[cell+E51Y_C_NO_UNIQUE_WRONG]=cell_metrics[cell+E51Y_C_NO_UNIQUE_WRONG]+1; mode_wrong[arm*E45_MODES+mode]=mode_wrong[arm*E45_MODES+mode]+1; }
                }else{
                    cell_metrics[cell+E51Y_C_KNOWN]=cell_metrics[cell+E51Y_C_KNOWN]+1;
                    if(choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+E51Y_C_KNOWN_UNKNOWN]=cell_metrics[cell+E51Y_C_KNOWN_UNKNOWN]+1;
                    }else{
                        if(terminal_utility==1000){ cell_metrics[cell+E51Y_C_KNOWN_SUCCESS]=cell_metrics[cell+E51Y_C_KNOWN_SUCCESS]+1; mode_success[arm*E45_MODES+mode]=mode_success[arm*E45_MODES+mode]+1;
                        }else{ cell_metrics[cell+E51Y_C_KNOWN_WRONG]=cell_metrics[cell+E51Y_C_KNOWN_WRONG]+1; mode_wrong[arm*E45_MODES+mode]=mode_wrong[arm*E45_MODES+mode]+1; }
                    }
                }
            }
            arm=arm+1;
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(losses); zfree(feasible);
        episode=episode+1;
    }
}

fn e51y_every_cell_no_unique_safe(cell_metrics:[]i32,arm:i32)i32 {
    let gate:i32=1; let mode:i32=0;
    while(mode<2){
        let resource:i32=0;
        while(resource<E45_RESOURCES){
            let cell:i32=e51y_cell_offset(arm,mode,resource);
            if(cell_metrics[cell+E51Y_C_NO_UNIQUE]>0){
                if(cell_metrics[cell+E51Y_C_NO_UNIQUE_WRONG]!=0 || cell_metrics[cell+E51Y_C_NO_UNIQUE_UNKNOWN]!=cell_metrics[cell+E51Y_C_NO_UNIQUE]){ gate=0; }
            }
            resource=resource+1;
        }
        mode=mode+1;
    }
    return gate;
}

fn e51y_switch_safety(mode_wrong:[]i32,arm:i32)i32 {
    let gate:i32=1; let mode:i32=0;
    while(mode<E45_MODES){
        if(e51v_switch_mode(mode)==1){
            if(mode_wrong[arm*E45_MODES+mode]>mode_wrong[mode]){ gate=0; }
        }
        mode=mode+1;
    }
    return gate;
}

fn e51y_run(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32
)i32 {
    _zag_println("R32_E51Y_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51y_confirmed_terminal_five_way_sequential_v1");
    _zag_println("claim_boundary,native_sequential_policy_discriminator_not_r32_promotion");
    _zag_println("native_zag_v2_only=1"); _zag_println("evaluator_truth_exposed=0"); _zag_println("ambiguity_label_exposed=0"); _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0"); _zag_println("terminal_topology_changed=0"); _zag_println("cross_cell_edges_added=0"); _zag_println("graph_privileged=0");
    _zag_println("five_way_actions,KEEP_CURRENT_RESTORE_CONTINUE_UNKNOWN"); _zag_println("continue_geometry,relative_advantage_over_best_terminal");

    let world_gate:i32=e51y_world_gate();

    // ---- Reproduce the confirmed E51X 384-sweep terminal learner from stage 81 only.
    let term_records:[]i32=zalloc_i(E51Y_DEV_SAMPLES*E50_RECORD_N); let term_dummy:[]i32=zalloc_i(E51Y_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(term_records,E51Y_DEV_SAMPLES*E50_RECORD_N); e45_zero(term_dummy,E51Y_DEV_SAMPLES*E50_RECORD_N);
    let term_unknown:i32=0; let term_cp:i32=0; let term_cn:i32=0; let built:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base:i32=0; while(base<3){
            let mode:i32=0; while(mode<E45_MODES){
                let resource:i32=0; while(resource<E45_RESOURCES){
                    let ep:i32=0; while(ep<12){
                        let index:i32=e46_episode_index(epoch,base,mode,resource,ep);
                        e51e_build_training_episode(e51n_world_id(E51Y_TERM_DEV_STAGE,index),mode,resource,index,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,term_records,term_dummy,&term_unknown,&term_cp,&term_cn);
                        built=built+1; ep=ep+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base=base+1;
        }
        epoch=epoch+1;
    }
    zfree(term_dummy);
    e45_print_pair("e51y_terminal_development_episodes",built); e45_print_pair("e51y_terminal_unknown_target_nonzero",term_unknown);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gf:[]i32=zalloc_i(E50_BATCH_GRAM); let gr:[]i32=zalloc_i(E50_BATCH_GRAM); let cf:[]i32=zalloc_i(E50_BATCH_CROSS); let cr:[]i32=zalloc_i(E50_BATCH_CROSS); let copyw:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copyb:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copyw,E51E_MODELS*4*E45_FEATURES); e45_zero(copyb,E51E_MODELS*4);
    let terminal_base_fit:i32=e51e_fit_model(term_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gf,gr,cf,cr,copyw,copyb);
    let term_unknown_params:i32=0; if(terminal_biases[3]!=0){ term_unknown_params=term_unknown_params+1; } let fi:i32=0; while(fi<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+fi]!=0){ term_unknown_params=term_unknown_params+1; } fi=fi+1; }

    let term_targets:[]i32=zalloc_i(E51Y_DEV_SAMPLES); let tp:i32=0; let tn:i32=0; let tz:i32=0;
    e51m_build_targets(term_records,E51Y_DEV_SAMPLES,terminal_weights,terminal_biases,term_targets,&tp,&tn,&tz);
    let term_global:[]i32=zalloc_i(E45_FEATURES); let term_global_reverse:[]i32=zalloc_i(E45_FEATURES); let term_global_bias:i32=0; let term_global_reverse_bias:i32=0;
    let ls1:i32=0; let lr1:i32=0; let lt1:i32=0; let ll1:i64=0; let ls2:i32=0; let lr2:i32=0; let lt2:i32=0; let ll2:i64=0;
    e51m_fit_scalar_linear(term_records,term_targets,E51Y_DEV_SAMPLES,0,term_global,0,&term_global_bias,&ls1,&lr1,&lt1,&ll1);
    e51m_fit_scalar_linear(term_records,term_targets,E51Y_DEV_SAMPLES,1,term_global_reverse,0,&term_global_reverse_bias,&ls2,&lr2,&lt2,&ll2);
    let term_global_identity:i32=e51m_linear_identity(term_global,0,term_global_bias,term_global_reverse,0,term_global_reverse_bias,ls1,ls2,lr1,lr2,lt1,lt2,ll1,ll2);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let corrections:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let losses:[]i32=zalloc_i(E51O_CAP_LEVELS); let ta:i32=0; let tt:i32=0; let tfl:i64=0; let tsg:i32=0;
    e51o_fit_local_memory(term_records,term_targets,E51Y_DEV_SAMPLES,term_global,0,term_global_bias,0,prototypes,parents,corrections,counts,losses,&ta,&tt,&tfl,&tsg);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rcorrections:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rcounts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rlosses:[]i32=zalloc_i(E51O_CAP_LEVELS); let rta:i32=0; let rtt:i32=0; let rtfl:i64=0; let rtsg:i32=0;
    e51o_fit_local_memory(term_records,term_targets,E51Y_DEV_SAMPLES,term_global,0,term_global_bias,1,rprototypes,rparents,rcorrections,rcounts,rlosses,&rta,&rtt,&rtfl,&rtsg);
    let term_tree_identity:i32=e51o_local_identity(prototypes,parents,corrections,counts,losses,ta,tt,tfl,tsg,rprototypes,rparents,rcorrections,rcounts,rlosses,rta,rtt,rtfl,rtsg);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(term_records,E51Y_DEV_SAMPLES,root,ranges);

    let sw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let sb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let su:[]i32=zalloc_i(E51S_SNAPSHOTS); let ss:[]i32=zalloc_i(E51S_SNAPSHOTS); let sr:[]i32=zalloc_i(E51S_SNAPSHOTS); let st:[]i32=zalloc_i(E51S_SNAPSHOTS); let sll:[]i32=zalloc_i(E51S_SNAPSHOTS); let slh:[]i32=zalloc_i(E51S_SNAPSHOTS); let sstrict:i32=0;
    e51s_fit_snapshots(term_records,term_targets,E51Y_DEV_SAMPLES,term_global,term_global_bias,prototypes,parents,ranges,0,sw,sb,su,ss,sr,st,sll,slh,&sstrict);
    let rsw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let rsb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let rsu:[]i32=zalloc_i(E51S_SNAPSHOTS); let rss:[]i32=zalloc_i(E51S_SNAPSHOTS); let rsr:[]i32=zalloc_i(E51S_SNAPSHOTS); let rst:[]i32=zalloc_i(E51S_SNAPSHOTS); let rsll:[]i32=zalloc_i(E51S_SNAPSHOTS); let rslh:[]i32=zalloc_i(E51S_SNAPSHOTS); let rsstrict:i32=0;
    e51s_fit_snapshots(term_records,term_targets,E51Y_DEV_SAMPLES,term_global,term_global_bias,prototypes,parents,ranges,1,rsw,rsb,rsu,rss,rsr,rst,rsll,rslh,&rsstrict);
    let term_snapshot_identity:i32=e51s_snapshots_identity(sw,sb,su,ss,sr,st,sll,slh,rsw,rsb,rsu,rss,rsr,rst,rsll,rslh);
    let state_ws:i32=1*E51P_MAX_CELLS*E45_FEATURES; let state_bs:i32=1*E51P_MAX_CELLS;

    let firstw:[]i32=zalloc_i(E51Y_CELLS*E45_FEATURES); let firstb:[]i32=zalloc_i(E51Y_CELLS); let finalw:[]i32=zalloc_i(E51Y_CELLS*E45_FEATURES); let finalb:[]i32=zalloc_i(E51Y_CELLS);
    let rfirstw:[]i32=zalloc_i(E51Y_CELLS*E45_FEATURES); let rfirstb:[]i32=zalloc_i(E51Y_CELLS); let rfinalw:[]i32=zalloc_i(E51Y_CELLS*E45_FEATURES); let rfinalb:[]i32=zalloc_i(E51Y_CELLS);
    let tr:i32=0; let tsel:i32=0; let tfit:i32=0; let tloss:i64=0; let tstrict:i32=0; let tup:i32=0; let tsw:i32=0;
    e51x_fit_trajectory_dose(term_records,term_targets,E51Y_DEV_EPISODES,term_global,term_global_bias,prototypes,parents,ranges,sw,state_ws,sb,state_bs,0,384,firstw,firstb,finalw,finalb,&tr,&tsel,&tfit,&tloss,&tstrict,&tup,&tsw);
    let rtr:i32=0; let rtsel:i32=0; let rtfit:i32=0; let rtloss:i64=0; let rtstrict:i32=0; let rtup:i32=0; let rtsw:i32=0;
    e51x_fit_trajectory_dose(term_records,term_targets,E51Y_DEV_EPISODES,term_global,term_global_bias,prototypes,parents,ranges,sw,state_ws,sb,state_bs,1,384,rfirstw,rfirstb,rfinalw,rfinalb,&rtr,&rtsel,&rtfit,&rtloss,&rtstrict,&rtup,&rtsw);
    let term_trajectory_identity:i32=e51x_dose_identity(firstw,firstb,finalw,finalb,tr,tsel,tfit,tloss,tstrict,tup,tsw,rfirstw,rfirstb,rfinalw,rfinalb,rtr,rtsel,rtfit,rtloss,rtstrict,rtup,rtsw);
    let terminal_hash_before:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,finalw,finalb);
    e45_print_pair("e51y_terminal_base_fit_gate",terminal_base_fit); e45_print_pair("e51y_terminal_unknown_parameter_nonzero",term_unknown_params); e45_print_pair("e51y_terminal_global_identity_gate",term_global_identity); e45_print_pair("e51y_terminal_tree_identity_gate",term_tree_identity); e45_print_pair("e51y_terminal_snapshot_identity_gate",term_snapshot_identity); e45_print_pair("e51y_terminal_trajectory_identity_gate",term_trajectory_identity); e45_print_pair("e51y_terminal_trajectory_rounds",tr); e45_print_pair("e51y_terminal_trajectory_sweeps",tsw); e45_print_pair("e51y_terminal_hash_before_continue",terminal_hash_before);

    // Audit exact terminal reachability on already-consumed E51X stage 82. This cannot train CONTINUE.
    let audit_records:[]i32=zalloc_i(E51Y_VALIDATION_SAMPLES*E50_RECORD_N); let audit_dummy:[]i32=zalloc_i(E51Y_VALIDATION_SAMPLES*E50_RECORD_N); let audit_types:[]i32=zalloc_i(E51Y_VALIDATION_EPISODES); e45_zero(audit_records,E51Y_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(audit_dummy,E51Y_VALIDATION_SAMPLES*E50_RECORD_N);
    let au:i32=0; let acp:i32=0; let acn:i32=0; let ai:i32=0;
    while(ai<E51Y_VALIDATION_EPISODES){
        let resource:i32=e45_mod(ai/20,E45_RESOURCES); let mode:i32=e45_mod(ai/(E45_RESOURCES*20),E45_MODES); audit_types[ai]=0; if(mode==0 || mode==1){ audit_types[ai]=1; }
        e51e_build_training_episode(e51n_world_id(E51Y_TERM_AUDIT_STAGE,ai),mode,resource,ai,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,audit_records,audit_dummy,&au,&acp,&acn); ai=ai+1;
    }
    zfree(audit_dummy);
    let akt:i32=0; let akr:i32=0; let aut:i32=0; let aur:i32=0;
    e51p_expert_reachability(audit_records,audit_types,E51Y_VALIDATION_EPISODES,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,E51Y_CELLS,finalw,0,finalb,0,&akt,&akr,&aut,&aur);
    let terminal_reproduction_gate:i32=0; if(akr==4200 && akt==4200 && aur==1200 && aut==1200){ terminal_reproduction_gate=1; }
    _zag_print("e51y_terminal_reproduction,"); e45_print_i32(akr); _zag_print(","); e45_print_i32(akt); _zag_print(","); e45_print_i32(aur); _zag_print(","); e45_print_i32(aut); _zag_print(","); e45_print_i32(terminal_reproduction_gate); _zag_println("");
    zfree(audit_records); zfree(audit_types); zfree(term_records); zfree(term_targets);

    // ---- Fresh stage-84 continuation training under the frozen terminal learner.
    let cont_term_records:[]i32=zalloc_i(E51Y_DEV_SAMPLES*E50_RECORD_N); let cont_records:[]i32=zalloc_i(E51Y_DEV_SAMPLES*E50_RECORD_N); let cont_targets:[]i32=zalloc_i(E51Y_DEV_SAMPLES);
    e45_zero(cont_term_records,E51Y_DEV_SAMPLES*E50_RECORD_N); e45_zero(cont_records,E51Y_DEV_SAMPLES*E50_RECORD_N); e45_zero(cont_targets,E51Y_DEV_SAMPLES);
    let cu:i32=0; let oldcp:i32=0; let oldcn:i32=0; let cont_positive:i32=0; let cont_negative:i32=0; built=0; epoch=0;
    while(epoch<8){
        let base:i32=0; while(base<3){
            let mode:i32=0; while(mode<E45_MODES){
                let resource:i32=0; while(resource<E45_RESOURCES){
                    let ep:i32=0; while(ep<12){
                        let index:i32=e46_episode_index(epoch,base,mode,resource,ep); let world:i32=e51n_world_id(E51Y_CONT_DEV_STAGE,index);
                        e51e_build_training_episode(world,mode,resource,index,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,cont_term_records,cont_records,&cu,&oldcp,&oldcn);
                        e51y_make_continue_targets_episode(world,resource,index,cont_term_records,cont_targets,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,finalw,finalb,&cont_positive,&cont_negative);
                        built=built+1; ep=ep+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base=base+1;
        }
        epoch=epoch+1;
    }
    zfree(cont_term_records);
    e45_print_pair("e51y_continue_development_episodes",built); e45_print_pair("e51y_continue_positive_targets",cont_positive); e45_print_pair("e51y_continue_negative_targets",cont_negative); e45_print_pair("e51y_continue_builder_unknown_nonzero",cu);

    let cont_global:[]i32=zalloc_i(E45_FEATURES); let cont_global_r:[]i32=zalloc_i(E45_FEATURES); let cont_bias:i32=0; let cont_bias_r:i32=0;
    let cs1:i32=0; let crr1:i32=0; let ct1:i32=0; let cl1:i64=0; let cs2:i32=0; let crr2:i32=0; let ct2:i32=0; let cl2:i64=0;
    e51m_fit_scalar_linear(cont_records,cont_targets,E51Y_DEV_SAMPLES,0,cont_global,0,&cont_bias,&cs1,&crr1,&ct1,&cl1);
    e51m_fit_scalar_linear(cont_records,cont_targets,E51Y_DEV_SAMPLES,1,cont_global_r,0,&cont_bias_r,&cs2,&crr2,&ct2,&cl2);
    let cont_linear_identity:i32=e51m_linear_identity(cont_global,0,cont_bias,cont_global_r,0,cont_bias_r,cs1,cs2,crr1,crr2,ct1,ct2,cl1,cl2);

    let cproto:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let cparents:[]i32=zalloc_i(E51O_MAX_CELLS); let ccorr:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let ccounts:[]i32=zalloc_i(E51O_CAP_LEVELS); let closses:[]i32=zalloc_i(E51O_CAP_LEVELS); let cta:i32=0; let ctt:i32=0; let ctfl:i64=0; let cstrict:i32=0;
    e51o_fit_local_memory(cont_records,cont_targets,E51Y_DEV_SAMPLES,cont_global,0,cont_bias,0,cproto,cparents,ccorr,ccounts,closses,&cta,&ctt,&ctfl,&cstrict);
    let crproto:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let crparents:[]i32=zalloc_i(E51O_MAX_CELLS); let crcorr:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let crcounts:[]i32=zalloc_i(E51O_CAP_LEVELS); let crlosses:[]i32=zalloc_i(E51O_CAP_LEVELS); let crta:i32=0; let crtt:i32=0; let crtfl:i64=0; let crstrict:i32=0;
    e51o_fit_local_memory(cont_records,cont_targets,E51Y_DEV_SAMPLES,cont_global,0,cont_bias,1,crproto,crparents,crcorr,crcounts,crlosses,&crta,&crtt,&crtfl,&crstrict);
    let cont_tree_identity:i32=e51o_local_identity(cproto,cparents,ccorr,ccounts,closses,cta,ctt,ctfl,cstrict,crproto,crparents,crcorr,crcounts,crlosses,crta,crtt,crtfl,crstrict);
    let cranges:[]i32=zalloc_i(E45_FEATURES); let croot:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(cont_records,E51Y_DEV_SAMPLES,croot,cranges);

    let cew:[]i32=zalloc_i(2*E51Y_CELLS*E45_FEATURES); let ceb:[]i32=zalloc_i(2*E51Y_CELLS); let rcew:[]i32=zalloc_i(2*E51Y_CELLS*E45_FEATURES); let rceb:[]i32=zalloc_i(2*E51Y_CELLS);
    let cont_local_identity:i32=1; let local_index:i32=0;
    while(local_index<2){
        let max_sweeps:i32=96; if(local_index==1){ max_sweeps=384; }
        let up1:i32=0; let sw1:i32=0; let re1:i32=0; let tr1:i32=0; let lo1:i64=0; let sg1:i32=0;
        let up2:i32=0; let sw2:i32=0; let re2:i32=0; let tr2:i32=0; let lo2:i64=0; let sg2:i32=0;
        let ws:i32=local_index*E51Y_CELLS*E45_FEATURES; let bs:i32=local_index*E51Y_CELLS;
        e51x_fit_experts_dose(cont_records,cont_targets,E51Y_DEV_SAMPLES,cont_global,cont_bias,cproto,cparents,cranges,E51Y_CELLS,0,max_sweeps,cew,ws,ceb,bs,&up1,&sw1,&re1,&tr1,&lo1,&sg1);
        e51x_fit_experts_dose(cont_records,cont_targets,E51Y_DEV_SAMPLES,cont_global,cont_bias,cproto,cparents,cranges,E51Y_CELLS,1,max_sweeps,rcew,ws,rceb,bs,&up2,&sw2,&re2,&tr2,&lo2,&sg2);
        let id:i32=e51p_expert_identity(cew,ws,ceb,bs,rcew,ws,rceb,bs,E51Y_CELLS,up1,up2,sw1,sw2,re1,re2,tr1,tr2,lo1,lo2,sg1,sg2);
        if(id==0){ cont_local_identity=0; }
        _zag_print("e51y_continue_local_fit,"); e45_print_i32(max_sweeps); _zag_print(","); e45_print_i32(up1); _zag_print(","); e45_print_i32(sw1); _zag_print(","); e45_print_i32(re1); _zag_print(","); e45_print_i32(tr1); _zag_print(","); e45_print_i64(lo1); _zag_print(","); e45_print_i32(id); _zag_println("");
        local_index=local_index+1;
    }
    let terminal_hash_after:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,finalw,finalb);
    let terminal_frozen_gate:i32=0; if(terminal_hash_before==terminal_hash_after){ terminal_frozen_gate=1; }
    e45_print_pair("e51y_continue_linear_identity_gate",cont_linear_identity); e45_print_pair("e51y_continue_tree_cells",cta); e45_print_pair("e51y_continue_tree_identity_gate",cont_tree_identity); e45_print_pair("e51y_continue_local_identity_gate",cont_local_identity); e45_print_pair("e51y_terminal_hash_after_continue",terminal_hash_after); e45_print_pair("e51y_terminal_frozen_gate",terminal_frozen_gate);

    let base_integrity:i32=0;
    if(world_gate==1 && built==E51Y_DEV_EPISODES && terminal_base_fit==1 && term_unknown==0 && term_unknown_params==0 && term_global_identity==1 && term_tree_identity==1 && term_snapshot_identity==1 && term_trajectory_identity==1 && terminal_reproduction_gate==1 && cont_positive>0 && cont_negative>0 && cu==0 && cont_linear_identity==1 && cont_tree_identity==1 && cta>=E51Y_CELLS && cont_local_identity==1 && terminal_frozen_gate==1){ base_integrity=1; }
    e45_print_pair("e51y_training_integrity_gate",base_integrity);

    // ---- Fresh untouched stage-85 validation.
    let val_term:[]i32=zalloc_i(E51Y_VALIDATION_SAMPLES*E50_RECORD_N); let val_cont:[]i32=zalloc_i(E51Y_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_term,E51Y_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_cont,E51Y_VALIDATION_SAMPLES*E50_RECORD_N);
    let vu:i32=0; let vcp:i32=0; let vcn:i32=0; let vi:i32=0;
    while(vi<E51Y_VALIDATION_EPISODES){
        let resource:i32=e45_mod(vi/20,E45_RESOURCES); let mode:i32=e45_mod(vi/(E45_RESOURCES*20),E45_MODES);
        e51e_build_training_episode(e51n_world_id(E51Y_VALIDATION_STAGE,vi),mode,resource,vi,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_term,val_cont,&vu,&vcp,&vcn); vi=vi+1;
    }
    let val_agg:[]i32=zalloc_i(E51Y_ARMS*E51B_AGG_FIELDS); let val_cells:[]i32=zalloc_i(E51Y_ARMS*E45_MODES*E45_RESOURCES*E51Y_CELL_FIELDS); let val_stops:[]i32=zalloc_i(E51Y_ARMS*(E45_TAPE+1)); let val_mode_wrong:[]i32=zalloc_i(E51Y_ARMS*E45_MODES); let val_mode_success:[]i32=zalloc_i(E51Y_ARMS*E45_MODES);
    e51y_eval(E51Y_VALIDATION_STAGE,E51Y_VALIDATION_EPISODES,20,-1,val_term,val_cont,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,finalw,finalb,cont_global,cont_bias,cproto,cparents,cranges,cew,ceb,val_agg,val_cells,val_stops,val_mode_wrong,val_mode_success);
    _zag_println("e51y_validation_columns,arm_0_terminal_1_linear_continue_2_local96_3_local384,episodes,success,unknown,wrong,known,no_unique,observations,opportunity_loss,utility,continued,known_success,known_wrong,no_unique_unknown,no_unique_wrong");
    let arm:i32=0;
    while(arm<E51Y_ARMS){
        _zag_print("e51y_validation,"); e45_print_i32(arm); let k:i32=0; while(k<E51B_AGG_FIELDS){ _zag_print(","); e45_print_i32(val_agg[arm*E51B_AGG_FIELDS+k]); k=k+1; } _zag_println("");
        arm=arm+1;
    }
    _zag_println("e51y_mode_columns,arm,mode,success,wrong"); arm=0;
    while(arm<E51Y_ARMS){ let mode:i32=0; while(mode<E45_MODES){ _zag_print("e51y_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); _zag_print(","); e45_print_i32(val_mode_success[arm*E45_MODES+mode]); _zag_print(","); e45_print_i32(val_mode_wrong[arm*E45_MODES+mode]); _zag_println(""); mode=mode+1; } arm=arm+1; }

    let candidate:[]i32=zalloc_i(E51Y_ARMS); e45_zero(candidate,E51Y_ARMS); let winner:i32=-1; arm=1;
    while(arm<E51Y_ARMS){
        let s:i32=arm*E51B_AGG_FIELDS; let c:i32=0;
        let behavior:i32=0; if(val_agg[s+E51B_M_CONTINUED]>0 && val_agg[s+E51B_M_CONTINUED]<E51Y_VALIDATION_EPISODES){ behavior=1; }
        let every_cell:i32=e51y_every_cell_no_unique_safe(val_cells,arm); let switch_safe:i32=e51y_switch_safety(val_mode_wrong,arm);
        if(behavior==1 && val_agg[s+E51B_M_NO_UNIQUE_WRONG]==0 && every_cell==1 && val_agg[s+E51B_M_KNOWN_SUCCESS]>=val_agg[E51B_M_KNOWN_SUCCESS] && val_agg[s+E51B_M_KNOWN_WRONG]<=val_agg[E51B_M_KNOWN_WRONG] && val_agg[s+E51B_M_UTILITY]>val_agg[E51B_M_UTILITY] && switch_safe==1){ c=1; }
        candidate[arm]=c; if(winner<0 && c==1){ winner=arm; }
        _zag_print("e51y_validation_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(behavior); _zag_print(","); e45_print_i32(every_cell); _zag_print(","); e45_print_i32(switch_safe); _zag_print(","); e45_print_i32(c); _zag_println("");
        arm=arm+1;
    }
    let validation_integrity:i32=0; if(base_integrity==1 && vu==0){ validation_integrity=1; }
    e45_print_pair("e51y_validation_integrity_gate",validation_integrity); e45_print_pair("e51y_validation_winner_arm",winner);

    // ---- Sealed confirmation only for the lower-resource passing arm.
    let confirmation_executed:i32=0; let confirmation_gate:i32=0;
    if(validation_integrity==1 && winner>=1){
        confirmation_executed=E51Y_CONFIRM_EPISODES;
        zfree(val_term); zfree(val_cont); zfree(val_agg); zfree(val_cells); zfree(val_stops); zfree(val_mode_wrong); zfree(val_mode_success);
        let con_term:[]i32=zalloc_i(E51Y_CONFIRM_SAMPLES*E50_RECORD_N); let con_cont:[]i32=zalloc_i(E51Y_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_term,E51Y_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_cont,E51Y_CONFIRM_SAMPLES*E50_RECORD_N);
        let xu:i32=0; let xcp:i32=0; let xcn:i32=0; let xi:i32=0;
        while(xi<E51Y_CONFIRM_EPISODES){ let resource:i32=e45_mod(xi/40,E45_RESOURCES); let mode:i32=e45_mod(xi/(E45_RESOURCES*40),E45_MODES); e51e_build_training_episode(e51n_world_id(E51Y_CONFIRM_STAGE,xi),mode,resource,xi,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,con_term,con_cont,&xu,&xcp,&xcn); xi=xi+1; }
        let con_agg:[]i32=zalloc_i(E51Y_ARMS*E51B_AGG_FIELDS); let con_cells:[]i32=zalloc_i(E51Y_ARMS*E45_MODES*E45_RESOURCES*E51Y_CELL_FIELDS); let con_stops:[]i32=zalloc_i(E51Y_ARMS*(E45_TAPE+1)); let con_mode_wrong:[]i32=zalloc_i(E51Y_ARMS*E45_MODES); let con_mode_success:[]i32=zalloc_i(E51Y_ARMS*E45_MODES);
        e51y_eval(E51Y_CONFIRM_STAGE,E51Y_CONFIRM_EPISODES,40,winner,con_term,con_cont,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,finalw,finalb,cont_global,cont_bias,cproto,cparents,cranges,cew,ceb,con_agg,con_cells,con_stops,con_mode_wrong,con_mode_success);
        let ws:i32=winner*E51B_AGG_FIELDS; let behavior:i32=0; if(con_agg[ws+E51B_M_CONTINUED]>0 && con_agg[ws+E51B_M_CONTINUED]<E51Y_CONFIRM_EPISODES){ behavior=1; }
        let every_cell:i32=e51y_every_cell_no_unique_safe(con_cells,winner); let switch_safe:i32=e51y_switch_safety(con_mode_wrong,winner);
        if(xu==0 && behavior==1 && con_agg[ws+E51B_M_NO_UNIQUE_WRONG]==0 && every_cell==1 && con_agg[ws+E51B_M_KNOWN_SUCCESS]>=con_agg[E51B_M_KNOWN_SUCCESS] && con_agg[ws+E51B_M_KNOWN_WRONG]<=con_agg[E51B_M_KNOWN_WRONG] && con_agg[ws+E51B_M_UTILITY]>con_agg[E51B_M_UTILITY] && switch_safe==1){ confirmation_gate=1; }
        _zag_println("e51y_confirmation_columns,arm,episodes,success,unknown,wrong,known,no_unique,observations,opportunity_loss,utility,continued,known_success,known_wrong,no_unique_unknown,no_unique_wrong,every_cell,switch_safe,gate");
        _zag_print("e51y_confirmation,"); e45_print_i32(winner); let k:i32=0; while(k<E51B_AGG_FIELDS){ _zag_print(","); e45_print_i32(con_agg[ws+k]); k=k+1; } _zag_print(","); e45_print_i32(every_cell); _zag_print(","); e45_print_i32(switch_safe); _zag_print(","); e45_print_i32(confirmation_gate); _zag_println("");
        zfree(con_term); zfree(con_cont); zfree(con_agg); zfree(con_cells); zfree(con_stops); zfree(con_mode_wrong); zfree(con_mode_success);
    }else{
        zfree(val_term); zfree(val_cont); zfree(val_agg); zfree(val_cells); zfree(val_stops); zfree(val_mode_wrong); zfree(val_mode_success);
    }
    e45_print_pair("e51y_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51y_confirmation_gate",confirmation_gate);

    if(base_integrity==0 || validation_integrity==0){ _zag_println("e51y_outcome,INVALID_FIVE_WAY_INTEGRITY_FAILURE");
    }else{
        if(winner>=1){
            if(confirmation_gate==1){ _zag_println("e51y_outcome,FIVE_WAY_SEQUENTIAL_POLICY_CONFIRMED");
            }else{ _zag_println("e51y_outcome,FIVE_WAY_VALIDATION_PASS_CONFIRMATION_FAIL"); }
        }else{
            let best_nu:i32=val_agg[E51B_AGG_FIELDS+E51B_M_NO_UNIQUE_WRONG]; let best_utility:i32=val_agg[E51B_AGG_FIELDS+E51B_M_UTILITY];
            let a:i32=2; while(a<E51Y_ARMS){ if(val_agg[a*E51B_AGG_FIELDS+E51B_M_NO_UNIQUE_WRONG]<best_nu){ best_nu=val_agg[a*E51B_AGG_FIELDS+E51B_M_NO_UNIQUE_WRONG]; } if(val_agg[a*E51B_AGG_FIELDS+E51B_M_UTILITY]>best_utility){ best_utility=val_agg[a*E51B_AGG_FIELDS+E51B_M_UTILITY]; } a=a+1; }
            if(best_nu>0){ _zag_println("e51y_outcome,FIVE_WAY_CONTINUATION_VALUE_MIS-CALIBRATED");
            }else{
                if(best_utility<=val_agg[E51B_M_UTILITY]){ _zag_println("e51y_outcome,FIVE_WAY_UTILITY_COST_FAILURE");
                }else{ _zag_println("e51y_outcome,FIVE_WAY_CONTINUATION_CAPACITY_LIMITED"); }
            }
        }
    }
    _zag_println("TNN_R32_E51Y_EXECUTION_COMPLETE=1");

    zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gf); zfree(gr); zfree(cf); zfree(cr); zfree(copyw); zfree(copyb);
    zfree(term_global); zfree(term_global_reverse); zfree(prototypes); zfree(parents); zfree(corrections); zfree(counts); zfree(losses); zfree(rprototypes); zfree(rparents); zfree(rcorrections); zfree(rcounts); zfree(rlosses); zfree(ranges); zfree(root);
    zfree(sw); zfree(sb); zfree(su); zfree(ss); zfree(sr); zfree(st); zfree(sll); zfree(slh); zfree(rsw); zfree(rsb); zfree(rsu); zfree(rss); zfree(rsr); zfree(rst); zfree(rsll); zfree(rslh); zfree(firstw); zfree(firstb); zfree(rfirstw); zfree(rfirstb); zfree(rfinalw); zfree(rfinalb);
    zfree(cont_records); zfree(cont_targets); zfree(cont_global); zfree(cont_global_r); zfree(cproto); zfree(cparents); zfree(ccorr); zfree(ccounts); zfree(closses); zfree(crproto); zfree(crparents); zfree(crcorr); zfree(crcounts); zfree(crlosses); zfree(cranges); zfree(croot); zfree(cew); zfree(ceb); zfree(rcew); zfree(rceb); zfree(candidate);
    // finalw/finalb intentionally live through all sequential evaluation above; free last.
    zfree(finalw); zfree(finalb);
    return 1;
}

@import("tnn_r32_e45_investigation_core.zag")

fn r32e45_print_metric(label:[]u8,value:i32)void {
    _zag_print(label);
    _zag_print(",");
    _zag_println(_zag_i64_to_str(value as i64));
}

fn main()i32 {
    let provenance:i32=r32e45_core_test_provenance();
    let temporal:i32=r32e45_core_test_temporal_replacement_reversal();
    let valley:i32=r32e45_core_test_option_valley();
    let unknown:i32=r32e45_core_test_rational_unknown();
    r32e45_print_metric("provenance_dependence",provenance);
    r32e45_print_metric("historical_current_reversal",temporal);
    r32e45_print_metric("temporally_extended_option",valley);
    r32e45_print_metric("logical_unknown",unknown);
    r32e45_print_metric("fixed_option_duration",0);
    r32e45_print_metric("evaluator_label_inside_cognition",0);
    r32e45_print_metric("newborn_restarts",0);
    if(provenance+temporal+valley+unknown==4){
        _zag_println("TNN_R32_E45_CORE_GATE=PASS");
        return 0;
    }
    _zag_println("TNN_R32_E45_CORE_GATE=FAIL");
    return 1;
}

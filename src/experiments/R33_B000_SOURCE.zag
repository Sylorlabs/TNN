// R33-B000: isolated prototype boundary witnesses. No training or brain import.
// The eight copied helpers below retain their original Zag bodies exactly.
// Origins and dependency constants are checked by the read-only R33 validator.
// The remaining driver is evaluator-only literal-fixture construction/reporting.
// It does not claim a passing sensory, memory, trace or authority contract.

const TRACE_CAP:i32=8192;
const VIEW_DIM:i32=8;
const R31_CHUNK_LEN_MAX:i32=16;

fn abs_i32(x:i32)i32 @noalloc { if(x<0){return 0-x;} return x; }

fn trace_emit(
    step:i32,stage:i32,reason:i32,subject:i32,
    evidence:i32,confidence:i32,parent:i32,
    t_step:[]i32,t_stage:[]i32,t_reason:[]i32,t_subject:[]i32,
    t_evidence:[]i32,t_conf:[]i32,t_parent:[]i32,t_count:*i32
)void @noalloc {
    if(t_count.*>=TRACE_CAP){return;}
    let at:i32=t_count.*;
    t_step[at]=step; t_stage[at]=stage; t_reason[at]=reason; t_subject[at]=subject;
    t_evidence[at]=evidence; t_conf[at]=confidence; t_parent[at]=parent;
    t_count.*=at+1;
}

fn core_relational_signature8(raw:[]i32,r0:i32,out:[]i32,o0:i32)void @noalloc {
    let mean:i32=0;let i:i32=0;while(i<VIEW_DIM){mean=mean+raw[r0+i];i=i+1;}mean=mean/VIEW_DIM;
    i=0;while(i<VIEW_DIM){out[o0+i]=raw[r0+i]-mean;i=i+1;}
    // insertion sort yields a permutation-invariant distribution signature.
    i=1;while(i<VIEW_DIM){let key:i32=out[o0+i];let j:i32=i-1;while(j>=0 && out[o0+j]>key){out[o0+j+1]=out[o0+j];j=j-1;}out[o0+j+1]=key;i=i+1;}
    let span:i32=abs_i32(out[o0+VIEW_DIM-1]-out[o0]);
    if(span>0){i=0;while(i<VIEW_DIM){out[o0+i]=out[o0+i]*1000/span;i=i+1;}}
}

fn acoustic_window_distance(samples:[]i32,start:i32,duration:i32,templates:[]i32,motif:i32,width:i32)i32 @noalloc {
    let d:i32=0;let i:i32=0;while(i<width){let pos:i32=start+(i*duration)/width;if(pos>=samples.len){return 2147480000;}d=d+abs_i32(samples[pos]-templates[motif*width+i]);i=i+1;}return d;
}

fn lru_evict_candidate(last_used:[]i32,protected_exact:[]i32,count:i32)i32 @noalloc {
    let best:i32=-1;let age:i32=2147480000;let i:i32=0;while(i<count){if(protected_exact[i]==0 && last_used[i]<age){age=last_used[i];best=i;}i=i+1;}
    if(best>=0){return best;} i=0;age=2147480000;while(i<count){if(last_used[i]<age){age=last_used[i];best=i;}i=i+1;}return best;
}

fn r31_chunk_match(seq:[]i32,start:i32,c_len:[]i32,c_data:[]i32,c_count:i32)i32 @noalloc {
    let best:i32=-1;let best_len:i32=0;let c:i32=0;
    while(c<c_count){
        let n:i32=c_len[c];
        if(n>best_len && start+n<=seq.len){
            let same:bool=true;let i:i32=0;
            while(i<n){if(seq[start+i]!=c_data[c*R31_CHUNK_LEN_MAX+i]){same=false;i=n;}else{i=i+1;}}
            if(same){best=c;best_len=n;}
        }
        c=c+1;
    }
    return best;
}

fn r31_segment(seq:[]i32,c_len:[]i32,c_data:[]i32,c_use:[]i32,c_count:i32,
    out_id:[]i32,out_start:[]i32,out_len:[]i32,out_n:*i32,max_out:i32)void {
    let pos:i32=0;let nout:i32=0;
    while(pos<seq.len && nout<max_out){
        let c:i32=r31_chunk_match(seq,pos,c_len,c_data,c_count);
        out_start[nout]=pos;
        if(c>=0){out_id[nout]=c;out_len[nout]=c_len[c];c_use[c]=c_use[c]+1;pos=pos+c_len[c];}
        else{out_id[nout]=-1-seq[pos];out_len[nout]=1;pos=pos+1;}
        nout=nout+1;
    }
    out_n.*=nout;
}

fn r31_reconstruct(chunk_id:[]i32,chunk_n:i32,c_len:[]i32,c_data:[]i32,
    out_seq:[]i32,out_n:*i32,max_out:i32)void @noalloc {
    let n:i32=0;let q:i32=0;
    while(q<chunk_n && n<max_out){
        let id:i32=chunk_id[q];
        if(id<0){out_seq[n]=-1-id;n=n+1;}
        else{
            let j:i32=0;while(j<c_len[id] && n<max_out){out_seq[n]=c_data[id*R31_CHUNK_LEN_MAX+j];n=n+1;j=j+1;}
        }
        q=q+1;
    }
    out_n.*=n;
}

// Evaluator driver starts here. No prior main(), world generator or learning.
fn b000_metric(key: []u8, value: i32) void {
    _zag_print("M,"); _zag_print(key); _zag_print(",");
    _zag_println(_zag_i64_to_str(value as i64));
}

fn b000_vector(key: []u8, values: []i32, count: i32) void {
    let index: i32 = 0;
    while (index < count) {
        _zag_print("V,"); _zag_print(key); _zag_print(",");
        _zag_print(_zag_i64_to_str(index as i64)); _zag_print(",");
        _zag_println(_zag_i64_to_str(values[index] as i64));
        index = index + 1;
    }
}

fn b000_visual() void {
    let raw_a: []i32 = zalloc_i(8); let raw_b: []i32 = zalloc_i(8);
    let raw_c: []i32 = zalloc_i(8); let sig_a: []i32 = zalloc_i(8);
    let sig_b: []i32 = zalloc_i(8); let sig_c: []i32 = zalloc_i(8);
    let i: i32 = 0;
    while (i < 8) { raw_a[i] = i; raw_b[i] = 7-i; raw_c[i] = i; i = i+1; }
    raw_c[7] = 8;
    core_relational_signature8(raw_a, 0, sig_a, 0);
    core_relational_signature8(raw_b, 0, sig_b, 0);
    core_relational_signature8(raw_c, 0, sig_c, 0);
    b000_vector("visual.raw_a", raw_a, 8); b000_vector("visual.raw_b", raw_b, 8);
    b000_vector("visual.raw_c", raw_c, 8); b000_vector("visual.signature_a", sig_a, 8);
    b000_vector("visual.signature_b", sig_b, 8); b000_vector("visual.signature_c", sig_c, 8);
    zfree(raw_a); zfree(raw_b); zfree(raw_c); zfree(sig_a); zfree(sig_b); zfree(sig_c);
}

fn b000_audio() void {
    let samples: []i32 = zalloc_i(24); let template: []i32 = zalloc_i(12);
    b000_metric("audio.zero_distance", acoustic_window_distance(samples,0,24,template,0,12));
    samples[1] = 100;
    b000_vector("audio.unsampled_raw", samples, 24);
    b000_metric("audio.unsampled_distance", acoustic_window_distance(samples,0,24,template,0,12));
    samples[1] = 0; samples[2] = 100;
    b000_vector("audio.sampled_raw", samples, 24);
    b000_metric("audio.sampled_distance", acoustic_window_distance(samples,0,24,template,0,12));
    zfree(samples); zfree(template);
}

fn b000_trace(attempts: i32) void {
    let ts: []i32 = zalloc_i(8193); let tg: []i32 = zalloc_i(8193);
    let tr: []i32 = zalloc_i(8193); let tu: []i32 = zalloc_i(8193);
    let te: []i32 = zalloc_i(8193); let tc: []i32 = zalloc_i(8193);
    let tp: []i32 = zalloc_i(8193); let count: i32 = 0; let i: i32 = 0;
    ts[8192] = -777; tg[8192] = -777; tr[8192] = -777; tu[8192] = -777;
    te[8192] = -777; tc[8192] = -777; tp[8192] = -777;
    while (i < attempts) {
        trace_emit(i, 3, 5, i, 100+i, 500, i-1, ts,tg,tr,tu,te,tc,tp,&count);
        i = i+1;
    }
    let checks: []i32 = zalloc_i(7);
    checks[0] = i; checks[1] = count; checks[2] = ts[count-1];
    checks[3] = tp[count-1]; checks[4] = attempts-count;
    i = 0;
    while (i < count) {
        if (ts[i] != i || tg[i] != 3 || tr[i] != 5 || tu[i] != i ||
            te[i] != 100+i || tc[i] != 500 || tp[i] != i-1) { checks[5] = checks[5]+1; }
        i = i+1;
    }
    if (ts[8192] == -777 && tg[8192] == -777 && tr[8192] == -777 &&
        tu[8192] == -777 && te[8192] == -777 && tc[8192] == -777 && tp[8192] == -777) {
        checks[6] = 1;
    }
    if (attempts == 8191) { b000_vector("trace.attempts_8191", checks, 7); }
    if (attempts == 8192) { b000_vector("trace.attempts_8192", checks, 7); }
    if (attempts == 8193) { b000_vector("trace.attempts_8193", checks, 7); }
    zfree(ts); zfree(tg); zfree(tr); zfree(tu); zfree(te); zfree(tc); zfree(tp); zfree(checks);
}

fn b000_lru() void {
    let age: []i32 = zalloc_i(2); let protection: []i32 = zalloc_i(2);
    age[0] = 10; age[1] = 20; protection[0] = 1; protection[1] = 1;
    b000_metric("lru.all_protected_selection", lru_evict_candidate(age,protection,2));
    protection[1] = 0;
    b000_metric("lru.mixed_selection", lru_evict_candidate(age,protection,2));
    protection[0] = 0;
    b000_metric("lru.none_protected_selection", lru_evict_candidate(age,protection,2));
    b000_metric("lru.empty_selection", lru_evict_candidate(age,protection,0));
    b000_vector("lru.age_after", age, 2);
    zfree(age); zfree(protection);
}

fn b000_chunk() void {
    let seq: []i32 = zalloc_i(3); let lengths: []i32 = zalloc_i(1);
    let data: []i32 = zalloc_i(16); let uses: []i32 = zalloc_i(1);
    let ids: []i32 = zalloc_i(3); let starts: []i32 = zalloc_i(3);
    let spans: []i32 = zalloc_i(3); let restored: []i32 = zalloc_i(3);
    let segment_n: i32 = 0; let restored_n: i32 = 0;
    seq[0] = 10; seq[1] = 20; seq[2] = 30;
    ids[2] = -777; restored[2] = -777;
    r31_segment(seq,lengths,data,uses,0,ids,starts,spans,&segment_n,2);
    b000_metric("chunk.short_segment_count", segment_n);
    b000_vector("chunk.short_segment_ids", ids, 3);
    r31_reconstruct(ids,segment_n,lengths,data,restored,&restored_n,3);
    b000_metric("chunk.short_segment_restored_count", restored_n);
    b000_vector("chunk.short_segment_restored", restored, 3);
    r31_segment(seq,lengths,data,uses,0,ids,starts,spans,&segment_n,3);
    b000_metric("chunk.full_segment_count", segment_n);
    b000_vector("chunk.full_segment_ids", ids, 3);
    r31_reconstruct(ids,segment_n,lengths,data,restored,&restored_n,3);
    b000_metric("chunk.full_segment_restored_count", restored_n);
    b000_vector("chunk.full_segment_restored", restored, 3);
    lengths[0] = 3; data[0] = 10; data[1] = 20; data[2] = 30; ids[0] = 0;
    restored[2] = -777;
    r31_reconstruct(ids,1,lengths,data,restored,&restored_n,2);
    b000_metric("chunk.short_reconstruction_count", restored_n);
    b000_vector("chunk.short_reconstruction", restored, 3);
    r31_reconstruct(ids,1,lengths,data,restored,&restored_n,3);
    b000_metric("chunk.full_reconstruction_count", restored_n);
    b000_vector("chunk.full_reconstruction", restored, 3);
    b000_vector("chunk.raw_after", seq, 3); b000_vector("chunk.codebook_after", data, 3);
    b000_metric("chunk.codebook_length_after", lengths[0]);
    b000_metric("chunk.codebook_use_after", uses[0]);
    zfree(seq); zfree(lengths); zfree(data); zfree(uses); zfree(ids);
    zfree(starts); zfree(spans); zfree(restored);
}

fn main() i32 {
    b000_visual(); b000_audio();
    b000_trace(8191); b000_trace(8192); b000_trace(8193);
    b000_lru(); b000_chunk();
    b000_metric("audit.completed", 1);
    return 0;
}

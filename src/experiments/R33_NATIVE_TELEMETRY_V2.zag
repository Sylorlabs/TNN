// R33 competency telemetry V2: V1 ABI, corrected refusal request-occurrence semantics.
// V1 is retained unexecuted. Changes are engineering code, not learner knowledge.
// No learner, teacher, hash implementation, file I/O, grants or canonical state.
// The append-only records are the state; snapshots are derived, never authoritative.
// Status: 0 OK, -1 malformed, -2 capacity, -3 identity/order, -4 alias,
// -5 invalid history, -6 inconsistent observation. See the design for the ABI.

const TM_HEADER:i32=16;
const TM_EVENT:i32=88;
const TM_LIMIT:i32=128;
const TM_ANCHORS:i32=16;
const TM_METRICS:i32=56;
const TM_SNAPSHOT:i32=168;
const TM_CHARGE_LIMIT:i32=10000000;

const TM_EXPOSURE:i32=1;
const TM_HELP:i32=2;
const TM_ASSESS:i32=3;
const TM_ANCHOR:i32=4;
const TM_RETENTION:i32=5;
const TM_RETRIEVAL:i32=6;
const TM_UPDATE:i32=7;
const TM_RESOURCE:i32=8;

// Record offsets. Payload is an externally bound SHA-256, 32 byte-valued i32s.
const TE_VERSION:i32=0;
const TE_ID:i32=1;
const TE_ORDINAL:i32=2;
const TE_PARENT:i32=3;
const TE_CAUSE:i32=4;
const TE_EXPERIMENT:i32=5;
const TE_BRAIN:i32=6;
const TE_BRANCH:i32=7;
const TE_COMPETENCY:i32=8;
const TE_CLOCK:i32=9;
const TE_TICK:i32=10;
const TE_KIND:i32=11;
const TE_EPISODE:i32=12;
const TE_EXPERIENCE:i32=13;
const TE_ACTOR_KIND:i32=14;
const TE_ACTOR:i32=15;
const TE_DELEGATING_HUMAN:i32=16;
const TE_ASSISTED:i32=17;
const TE_OUTCOME:i32=18;
const TE_MODE:i32=19;
const TE_REQUESTED:i32=20;
const TE_HELP_RESULT:i32=21;
const TE_HUMAN:i32=22;
const TE_SOFTWARE:i32=23;
const TE_HELP_DOSE:i32=24;
const TE_FOUND:i32=25;
const TE_USEFUL:i32=26;
const TE_PROPOSED:i32=27;
const TE_ACCEPTED:i32=28;
const TE_REJECTED:i32=29;
const TE_ROLLED_BACK:i32=30;
const TE_OPERATIONS:i32=31;
const TE_IO_BYTES:i32=32;
const TE_CPU_US:i32=33;
const TE_WALL_US:i32=34;
const TE_LOGICAL_BYTES:i32=35;
const TE_PEAK_RSS:i32=36;
const TE_ANCHOR_REF:i32=37;
const TE_INTERFERING_COMPETENCY:i32=38;
const TE_PANEL:i32=39;
const TE_PAYLOAD:i32=40;
const TE_RESULTS:i32=72;

// Snapshot metric keys. Each row is [status,value,reason].
// status 2=DERIVED, 0=NOT_MEASURED; NOT_MEASURED always has value -1.
// reason 0=present,1=no records,2=unknown observation,3=zero denominator,
// 4=not implemented,5=uncharged events,6=unknown assistance.
const TM_EVENTS:i32=0;
const TM_EXPOSURES:i32=1;
const TM_UNIQUE:i32=2;
const TM_REPLAYS:i32=3;
const TM_ASSISTED_EXPOSURES:i32=4;
const TM_UNKNOWN_EXPOSURE_HELP:i32=5;
const TM_HELP_REQUESTS:i32=6;
const TM_HELP_ACCEPTED:i32=7;
const TM_HELP_REFUSED:i32=8;
const TM_HUMAN_INTERVENTIONS:i32=9;
const TM_SOFTWARE_INTERVENTIONS:i32=10;
const TM_HELP_DOSE_TOTAL:i32=11;
const TM_FRESH_TOTAL:i32=12;
const TM_FRESH_SCORED:i32=13;
const TM_FRESH_SUCCESSES:i32=14;
const TM_FRESH_UNASSISTED_N:i32=15;
const TM_FRESH_UNASSISTED_OK:i32=16;
const TM_FRESH_ASSISTED_N:i32=17;
const TM_FRESH_ASSISTED_OK:i32=18;
const TM_FRESH_UNKNOWN_OUTCOME:i32=19;
const TM_FRESH_UNKNOWN_HELP:i32=20;
const TM_CORRECT_UNKNOWN:i32=21;
const TM_WRONG_UNKNOWN:i32=22;
const TM_ANCHOR_COUNT:i32=23;
const TM_PANEL_COUNT:i32=24;
const TM_FINAL_LOST:i32=25;
const TM_EVER_LOST:i32=26;
const TM_WORST_LOST:i32=27;
const TM_NEW_LOSSES:i32=28;
const TM_RESCUES:i32=29;
const TM_INTERFERENCE_LOSSES:i32=30;
const TM_INTERFERENCE_RESCUES:i32=31;
const TM_RETRIEVAL_ATTEMPTS:i32=32;
const TM_RETRIEVAL_FOUND:i32=33;
const TM_RETRIEVAL_USEFUL:i32=34;
const TM_FOUND_UNKNOWN:i32=35;
const TM_USEFUL_UNKNOWN:i32=36;
const TM_PROPOSALS:i32=37;
const TM_ACCEPTED_UPDATES:i32=38;
const TM_REJECTED_UPDATES:i32=39;
const TM_ROLLED_BACK_UPDATES:i32=40;
const TM_RESOURCE_RECORDS:i32=41;
const TM_OPERATIONS:i32=42;
const TM_IO_BYTES:i32=43;
const TM_CPU_US:i32=44;
const TM_WALL_US:i32=45;
const TM_PEAK_RSS:i32=46;
const TM_LOGICAL_PEAK:i32=47;
const TM_CHARGED_EVENTS:i32=48;
const TM_UNCHARGED_EVENTS:i32=49;
const TM_UNDERSTANDING:i32=50;
const TM_TEACHER_COMPETENCE:i32=51;
const TM_TRANSFER:i32=52;
const TM_CALIBRATION:i32=53;
const TM_COMPLETE_CPU_US:i32=54;
const TM_COMPLETE_OPERATIONS:i32=55;

fn tm_disjoint(a:[]i32,b:[]i32)i32 {
    if(a.len==0 || b.len==0){return 1;}
    let i:i32=0;
    while(i<a.len){if(&a[i]==&b[0]){return 0;}i=i+1;}
    i=0;while(i<b.len){if(&b[i]==&a[0]){return 0;}i=i+1;}
    return 1;
}

// Initialization is only admitted on an all-zero caller-owned buffer.
// Reinitializing a nonempty journal is not a telemetry rollback operation.
fn tm_init(s:[]i32,capacity:i32,experiment:i32,brain:i32,branch:i32,competency:i32,clock:i32)i32 {
    if(capacity<0 || capacity>TM_LIMIT){return -2;}
    if(s.len!=TM_HEADER+capacity*TM_EVENT){return -1;}
    if(experiment<=0 || brain<=0 || branch<=0 || competency<=0 || clock<=0){return -3;}
    let i:i32=0;while(i<s.len){if(s[i]!=0){return -5;}i=i+1;}
    s[0]=330101;s[1]=1;s[2]=capacity;s[3]=0;
    s[4]=experiment;s[5]=brain;s[6]=branch;s[7]=competency;s[8]=clock;
    return 0;
}

fn tm_payload_equal(a:[]i32,at:i32,b:[]i32,bt:i32)i32 {
    let i:i32=0;
    while(i<32){if(a[at+TE_PAYLOAD+i]!=b[bt+TE_PAYLOAD+i]){return 0;}i=i+1;}
    return 1;
}

fn tm_payload_seen(s:[]i32,n:i32,e:[]i32,o:i32)i32 {
    let i:i32=0;
    while(i<n){
        let p:i32=TM_HEADER+i*TM_EVENT;let k:i32=s[p+TE_KIND];
        if(k==TM_EXPOSURE || k==TM_ASSESS){if(tm_payload_equal(s,p,e,o)==1){return 1;}}
        i=i+1;
    }
    return 0;
}

// Assistance cannot be cleared by a later unassisted flag in the same episode.
fn tm_assistance(s:[]i32,n:i32,episode:i32,declared:i32)i32 {
    let value:i32=declared;let i:i32=0;
    while(i<n){
        let p:i32=TM_HEADER+i*TM_EVENT;
        if(s[p+TE_EPISODE]==episode){
            if(s[p+TE_KIND]==TM_HELP && s[p+TE_HELP_RESULT]==1){return 1;}
            if(s[p+TE_KIND]==TM_EXPOSURE){
                if(s[p+TE_ASSISTED]==1){return 1;}
                if(s[p+TE_ASSISTED]==-1 && value!=1){value=-1;}
            }
        }
        i=i+1;
    }
    return value;
}

fn tm_count_kind(s:[]i32,n:i32,kind:i32)i32 {
    let count:i32=0;let i:i32=0;
    while(i<n){if(s[TM_HEADER+i*TM_EVENT+TE_KIND]==kind){count=count+1;}i=i+1;}
    return count;
}

// Internal validator: prefix [0,n) is already validated; e[o..o+88] is read only.
fn tm_event_check(s:[]i32,n:i32,e:[]i32,o:i32)i32 {
    if(e[o+TE_VERSION]!=1 || e[o+TE_KIND]<1 || e[o+TE_KIND]>8){return -1;}
    if(e[o+TE_ID]<=0 || e[o+TE_ORDINAL]!=n || e[o+TE_PARENT]!=n-1){return -3;}
    if(e[o+TE_CAUSE]<-1 || e[o+TE_CAUSE]>=n){return -3;}
    let j:i32=0;
    while(j<5){if(e[o+TE_EXPERIMENT+j]!=s[4+j]){return -3;}j=j+1;}
    if(e[o+TE_TICK]<0){return -3;}
    if(n>0){if(e[o+TE_TICK]<s[TM_HEADER+(n-1)*TM_EVENT+TE_TICK]){return -3;}}
    let kind:i32=e[o+TE_KIND];let episode:i32=e[o+TE_EPISODE];
    let actor:i32=e[o+TE_ACTOR_KIND];
    if(episode<0 || e[o+TE_EXPERIENCE]<0 || actor<1 || actor>6 || e[o+TE_ACTOR]<=0){return -1;}
    if(actor==4){if(e[o+TE_DELEGATING_HUMAN]<=0){return -3;}}
    else{if(e[o+TE_DELEGATING_HUMAN]!=0){return -1;}}
    if(e[o+TE_ASSISTED]<-1 || e[o+TE_ASSISTED]>1 || e[o+TE_OUTCOME]<-1 || e[o+TE_OUTCOME]>1){return -1;}
    if(e[o+TE_MODE]<0 || e[o+TE_MODE]>2 || e[o+TE_REQUESTED]<0 || e[o+TE_REQUESTED]>1){return -1;}
    if(e[o+TE_HELP_RESULT]<0 || e[o+TE_HELP_RESULT]>2){return -1;}
    j=TE_HUMAN;while(j<=TE_HELP_DOSE){if(e[o+j]<0 || e[o+j]>TM_CHARGE_LIMIT){return -1;}j=j+1;}
    if(e[o+TE_FOUND]<-1 || e[o+TE_FOUND]>1 || e[o+TE_USEFUL]<-1 || e[o+TE_USEFUL]>1){return -1;}
    j=TE_PROPOSED;while(j<=TE_ROLLED_BACK){if(e[o+j]<0 || e[o+j]>TM_CHARGE_LIMIT){return -1;}j=j+1;}
    j=TE_OPERATIONS;while(j<=TE_WALL_US){if(e[o+j]<-1 || e[o+j]>TM_CHARGE_LIMIT){return -1;}j=j+1;}
    if(e[o+TE_LOGICAL_BYTES]<-1 || e[o+TE_PEAK_RSS]<-1){return -1;}
    if(e[o+TE_INTERFERING_COMPETENCY]<0 || e[o+TE_PANEL]<0){return -1;}
    let payload:i32=0;j=0;
    while(j<32){if(e[o+TE_PAYLOAD+j]<0 || e[o+TE_PAYLOAD+j]>255){return -1;}payload=payload+e[o+TE_PAYLOAD+j];j=j+1;}
    j=0;while(j<16){if(e[o+TE_RESULTS+j]<-1 || e[o+TE_RESULTS+j]>1){return -1;}j=j+1;}

    // Require canonical inactive fields so unrelated events cannot mint counts.
    if(kind!=TM_HELP){j=TE_REQUESTED;while(j<=TE_HELP_DOSE){if(e[o+j]!=0){return -1;}j=j+1;}}
    if(kind!=TM_ASSESS && e[o+TE_OUTCOME]!=-1){return -1;}
    if(kind!=TM_EXPOSURE && kind!=TM_ASSESS && e[o+TE_MODE]!=0){return -1;}
    if(kind!=TM_RETRIEVAL){if(e[o+TE_FOUND]!=-1 || e[o+TE_USEFUL]!=-1){return -1;}}
    if(kind!=TM_UPDATE){j=TE_PROPOSED;while(j<=TE_ROLLED_BACK){if(e[o+j]!=0){return -1;}j=j+1;}}
    if(kind!=TM_RESOURCE){j=TE_OPERATIONS;while(j<=TE_PEAK_RSS){if(e[o+j]!=-1){return -1;}j=j+1;}}
    if(kind!=TM_ANCHOR && e[o+TE_ANCHOR_REF]!=-1){return -1;}
    if(kind!=TM_RETENTION){if(e[o+TE_PANEL]!=0){return -1;}j=0;while(j<16){if(e[o+TE_RESULTS+j]!=-1){return -1;}j=j+1;}}
    if(kind!=TM_RETENTION && kind!=TM_UPDATE && e[o+TE_INTERFERING_COMPETENCY]!=0){return -1;}
    if(kind==TM_EXPOSURE || kind==TM_ASSESS || kind==TM_ANCHOR){
        if(episode<=0 || e[o+TE_EXPERIENCE]<=0 || payload==0){return -3;}
    }else{if(e[o+TE_EXPERIENCE]!=0 || payload!=0){return -1;}}
    if(kind==TM_HELP || kind==TM_RETRIEVAL){if(episode<=0){return -3;}}
    if(kind==TM_UPDATE || kind==TM_RESOURCE || kind==TM_RETENTION){if(episode!=0){return -1;}}

    let anchors:i32=0;let last_panel:i32=-1;let i:i32=0;
    while(i<n){
        let p:i32=TM_HEADER+i*TM_EVENT;let previous:i32=s[p+TE_KIND];
        if(s[p+TE_ID]==e[o+TE_ID]){return -3;}
        if(previous==TM_ANCHOR){anchors=anchors+1;}
        if(previous==TM_RETENTION){last_panel=p;}
        if(e[o+TE_EXPERIENCE]>0 && s[p+TE_EXPERIENCE]==e[o+TE_EXPERIENCE]){
            if(tm_payload_equal(s,p,e,o)!=1){return -3;}
        }
        if(episode>0 && s[p+TE_EPISODE]==episode){
            if(previous==TM_ASSESS && (kind==TM_ASSESS || kind==TM_HELP || kind==TM_EXPOSURE)){return -3;}
            if(previous==TM_EXPOSURE && kind==TM_EXPOSURE){return -3;}
            if(previous==TM_EXPOSURE && kind==TM_ASSESS){if(tm_payload_equal(s,p,e,o)!=1){return -3;}}
        }
        if(kind==TM_ANCHOR && previous==TM_ANCHOR){
            if(s[p+TE_ANCHOR_REF]==e[o+TE_ANCHOR_REF] || tm_payload_equal(s,p,e,o)==1){return -3;}
        }
        if(kind==TM_RESOURCE && previous==TM_RESOURCE && s[p+TE_CAUSE]==e[o+TE_CAUSE]){return -3;}
        i=i+1;
    }
    if(kind==TM_EXPOSURE || kind==TM_ASSESS){
        if(e[o+TE_MODE]<1){return -1;}
        let seen:i32=tm_payload_seen(s,n,e,o);
        if(e[o+TE_MODE]==1 && seen!=0){return -6;}
        if(e[o+TE_MODE]==2 && seen!=1){return -6;}
        if(kind==TM_EXPOSURE && actor!=1){return -6;}
        if(kind==TM_ASSESS && actor!=5){return -6;}
    }
    if(kind==TM_HELP){
        if(e[o+TE_ASSISTED]!=-1){return -1;}
        let result:i32=e[o+TE_HELP_RESULT];
        if(result==0){if(actor!=1 || e[o+TE_REQUESTED]!=1){return -6;}}
        else{if(actor<2 || actor>4){return -6;}}
        if(result==1){
            if(actor==4){if(e[o+TE_SOFTWARE]<1 || e[o+TE_HUMAN]!=0){return -6;}}
            else{if(e[o+TE_HUMAN]<1 || e[o+TE_SOFTWARE]!=0){return -6;}}
        }else{if(e[o+TE_HUMAN]!=0 || e[o+TE_SOFTWARE]!=0 || e[o+TE_HELP_DOSE]!=0){return -6;}}
        // A separately recorded refusal is a response, not necessarily a new request.
        // TE_REQUESTED=0 preserves the prior request count, as for delivery responses.
        // Producers retain responsibility for truthful request/response attribution.
    }
    if(kind==TM_ANCHOR){
        if(actor!=5 || last_panel>=0){return -6;}
        if(anchors>=16){return -2;}
        let reference:i32=e[o+TE_ANCHOR_REF];if(reference<0 || reference>=n){return -3;}
        let p:i32=TM_HEADER+reference*TM_EVENT;
        if(s[p+TE_KIND]!=TM_ASSESS || s[p+TE_OUTCOME]!=1 || tm_payload_equal(s,p,e,o)!=1){return -6;}
        if(s[p+TE_EXPERIENCE]!=e[o+TE_EXPERIENCE] || s[p+TE_EPISODE]!=episode){return -3;}
        if(tm_assistance(s,reference,episode,s[p+TE_ASSISTED])!=0 || e[o+TE_ASSISTED]!=0){return -6;}
    }
    if(kind==TM_RETENTION){
        if(actor!=5 || anchors<1 || e[o+TE_ASSISTED]!=0 || e[o+TE_PANEL]<=0){return -6;}
        if(last_panel>=0){if(e[o+TE_PANEL]<=s[last_panel+TE_PANEL]){return -3;}}
        j=0;while(j<16){
            if(j<anchors){if(e[o+TE_RESULTS+j]<0){return -6;}}
            else{if(e[o+TE_RESULTS+j]!=-1){return -6;}}
            j=j+1;
        }
        let source:i32=e[o+TE_INTERFERING_COMPETENCY];
        if(source>0){
            let reference:i32=e[o+TE_CAUSE];if(reference<0 || source==s[7]){return -6;}
            let p:i32=TM_HEADER+reference*TM_EVENT;
            if(s[p+TE_KIND]!=TM_UPDATE || s[p+TE_INTERFERING_COMPETENCY]!=source){return -6;}
        }
    }
    if(kind==TM_RETRIEVAL){
        if(actor!=6 || e[o+TE_ASSISTED]!=-1){return -6;}
        if(e[o+TE_FOUND]!=1 && e[o+TE_USEFUL]==1){return -6;}
        if(e[o+TE_FOUND]==0 && e[o+TE_USEFUL]!=0){return -6;}
        if(e[o+TE_FOUND]==-1 && e[o+TE_USEFUL]!=-1){return -6;}
    }
    if(kind==TM_UPDATE){
        if(actor!=6 || e[o+TE_ASSISTED]!=-1){return -6;}
        if(e[o+TE_ACCEPTED]+e[o+TE_REJECTED]!=e[o+TE_PROPOSED]){return -6;}
        if(e[o+TE_ROLLED_BACK]>e[o+TE_ACCEPTED]){return -6;}
    }
    if(kind==TM_RESOURCE){
        if(actor!=6 || e[o+TE_ASSISTED]!=-1 || e[o+TE_CAUSE]<0){return -6;}
        let p:i32=TM_HEADER+e[o+TE_CAUSE]*TM_EVENT;
        if(s[p+TE_KIND]==TM_RESOURCE){return -6;}
        // Aggregated CPU can exceed wall time for concurrent work; do not clamp it.
    }
    return 0;
}

fn tm_validate(s:[]i32)i32 {
    if(s.len<TM_HEADER || s.len>TM_HEADER+TM_LIMIT*TM_EVENT){return -1;}
    if(s[0]!=330101 || s[1]!=1 || s[2]<0 || s[2]>TM_LIMIT){return -5;}
    if(s.len!=TM_HEADER+s[2]*TM_EVENT || s[3]<0 || s[3]>s[2]){return -5;}
    let j:i32=4;while(j<=8){if(s[j]<=0){return -5;}j=j+1;}
    j=9;while(j<TM_HEADER){if(s[j]!=0){return -5;}j=j+1;}
    let i:i32=0;
    while(i<s[3]){if(tm_event_check(s,i,s,TM_HEADER+i*TM_EVENT)!=0){return -5;}i=i+1;}
    return 0;
}

// All refusals leave the entire state AND input record unchanged.
// Caller must serialize calls and supply valid allocated slices, not arbitrary pointers.
fn tm_append(s:[]i32,e:[]i32)i32 {
    if(e.len!=TM_EVENT || s.len<TM_HEADER || s.len>TM_HEADER+TM_LIMIT*TM_EVENT){return -1;}
    if(tm_disjoint(s,e)!=1){return -4;}
    let checked:i32=tm_validate(s);if(checked!=0){return checked;}
    let n:i32=s[3];if(n==s[2]){return -2;}
    checked=tm_event_check(s,n,e,0);if(checked!=0){return checked;}
    let i:i32=0;let p:i32=TM_HEADER+n*TM_EVENT;
    while(i<TM_EVENT){s[p+i]=e[i];i=i+1;}
    s[3]=n+1;return 0;
}

fn tm_set(out:[]i32,key:i32,value:i32)void {out[key*3]=2;out[key*3+1]=value;out[key*3+2]=0;}
fn tm_missing(out:[]i32,key:i32,reason:i32)void {out[key*3]=0;out[key*3+1]=-1;out[key*3+2]=reason;}
fn tm_add(out:[]i32,key:i32,delta:i32)void {tm_set(out,key,out[key*3+1]+delta);}
fn tm_zero_group(out:[]i32,first:i32,last:i32)void {let k:i32=first;while(k<=last){tm_set(out,k,0);k=k+1;}}

fn tm_sum(s:[]i32,kind:i32,field:i32)i32 {
    let total:i32=0;let seen:i32=0;let i:i32=0;
    while(i<s[3]){let p:i32=TM_HEADER+i*TM_EVENT;
        if(s[p+TE_KIND]==kind){if(s[p+field]<0){return -1;}total=total+s[p+field];seen=1;}i=i+1;}
    if(seen==0){return -1;}return total;
}
fn tm_peak(s:[]i32,field:i32)i32 {
    let peak:i32=-1;let i:i32=0;
    while(i<s[3]){let p:i32=TM_HEADER+i*TM_EVENT;
        if(s[p+TE_KIND]==TM_RESOURCE){if(s[p+field]<0){return -1;}if(s[p+field]>peak){peak=s[p+field];}}i=i+1;}
    return peak;
}

// No dynamic allocation: caller supplies a separate 168-word output buffer.
fn tm_snapshot(s:[]i32,out:[]i32)i32 {
    if(out.len!=TM_SNAPSHOT || s.len<TM_HEADER || s.len>TM_HEADER+TM_LIMIT*TM_EVENT){return -1;}
    if(tm_disjoint(s,out)!=1){return -4;}
    let checked:i32=tm_validate(s);if(checked!=0){return checked;}
    let key:i32=0;while(key<TM_METRICS){tm_missing(out,key,1);key=key+1;}
    key=50;while(key<=53){tm_missing(out,key,4);key=key+1;}
    let n:i32=s[3];tm_set(out,TM_EVENTS,n);
    if(tm_count_kind(s,n,TM_EXPOSURE)>0){tm_zero_group(out,1,5);}
    if(tm_count_kind(s,n,TM_HELP)>0){tm_zero_group(out,6,11);}
    let fresh:i32=0;let i:i32=0;
    while(i<n){let p:i32=TM_HEADER+i*TM_EVENT;if(s[p+TE_KIND]==TM_ASSESS && s[p+TE_MODE]==1){fresh=fresh+1;}i=i+1;}
    if(fresh>0){tm_zero_group(out,12,22);}
    let anchors:i32=tm_count_kind(s,n,TM_ANCHOR);let panels:i32=tm_count_kind(s,n,TM_RETENTION);
    if(anchors>0){tm_set(out,TM_ANCHOR_COUNT,anchors);}
    if(panels>0){tm_zero_group(out,24,31);}
    if(tm_count_kind(s,n,TM_RETRIEVAL)>0){tm_zero_group(out,32,36);}
    if(tm_count_kind(s,n,TM_UPDATE)>0){tm_zero_group(out,37,40);}
    let resources:i32=tm_count_kind(s,n,TM_RESOURCE);
    tm_set(out,TM_CHARGED_EVENTS,resources);tm_set(out,TM_UNCHARGED_EVENTS,n-resources*2);
    let last_panel:i32=-1;i=0;
    while(i<n){
        let p:i32=TM_HEADER+i*TM_EVENT;let kind:i32=s[p+TE_KIND];
        if(kind==TM_EXPOSURE){
            tm_add(out,TM_EXPOSURES,1);
            if(s[p+TE_MODE]==1){tm_add(out,TM_UNIQUE,1);}else{tm_add(out,TM_REPLAYS,1);}
            let assist:i32=tm_assistance(s,i,s[p+TE_EPISODE],s[p+TE_ASSISTED]);
            if(assist==1){tm_add(out,TM_ASSISTED_EXPOSURES,1);}if(assist==-1){tm_add(out,TM_UNKNOWN_EXPOSURE_HELP,1);}
        }
        if(kind==TM_HELP){
            tm_add(out,TM_HELP_REQUESTS,s[p+TE_REQUESTED]);
            if(s[p+TE_HELP_RESULT]==1){tm_add(out,TM_HELP_ACCEPTED,1);}
            if(s[p+TE_HELP_RESULT]==2){tm_add(out,TM_HELP_REFUSED,1);}
            tm_add(out,TM_HUMAN_INTERVENTIONS,s[p+TE_HUMAN]);
            tm_add(out,TM_SOFTWARE_INTERVENTIONS,s[p+TE_SOFTWARE]);tm_add(out,TM_HELP_DOSE_TOTAL,s[p+TE_HELP_DOSE]);
        }
        if(kind==TM_ASSESS && s[p+TE_MODE]==1){
            tm_add(out,TM_FRESH_TOTAL,1);let outcome:i32=s[p+TE_OUTCOME];
            let assist:i32=tm_assistance(s,i,s[p+TE_EPISODE],s[p+TE_ASSISTED]);
            if(assist==-1){tm_add(out,TM_FRESH_UNKNOWN_HELP,1);}
            if(outcome==-1){tm_add(out,TM_FRESH_UNKNOWN_OUTCOME,1);}
            else{
                tm_add(out,TM_FRESH_SCORED,1);tm_add(out,TM_FRESH_SUCCESSES,outcome);
                if(assist==0){tm_add(out,TM_FRESH_UNASSISTED_N,1);tm_add(out,TM_FRESH_UNASSISTED_OK,outcome);}
                if(assist==1){tm_add(out,TM_FRESH_ASSISTED_N,1);tm_add(out,TM_FRESH_ASSISTED_OK,outcome);}
            }
        }
        if(kind==TM_RETENTION){
            let lost:i32=0;let losses:i32=0;let rescues:i32=0;let j:i32=0;
            while(j<anchors){
                let prior:i32=1;if(last_panel>=0){prior=s[last_panel+TE_RESULTS+j];}
                let now:i32=s[p+TE_RESULTS+j];if(now==0){lost=lost+1;}
                if(prior==1 && now==0){losses=losses+1;}if(prior==0 && now==1){rescues=rescues+1;}
                j=j+1;
            }
            tm_add(out,TM_PANEL_COUNT,1);tm_set(out,TM_FINAL_LOST,lost);
            if(lost>out[TM_WORST_LOST*3+1]){tm_set(out,TM_WORST_LOST,lost);}
            tm_add(out,TM_NEW_LOSSES,losses);tm_add(out,TM_RESCUES,rescues);
            if(s[p+TE_INTERFERING_COMPETENCY]>0){tm_add(out,TM_INTERFERENCE_LOSSES,losses);tm_add(out,TM_INTERFERENCE_RESCUES,rescues);}
            last_panel=p;
        }
        if(kind==TM_RETRIEVAL){
            tm_add(out,TM_RETRIEVAL_ATTEMPTS,1);
            if(s[p+TE_FOUND]==-1){tm_add(out,TM_FOUND_UNKNOWN,1);}else{tm_add(out,TM_RETRIEVAL_FOUND,s[p+TE_FOUND]);}
            if(s[p+TE_USEFUL]==-1){tm_add(out,TM_USEFUL_UNKNOWN,1);}else{tm_add(out,TM_RETRIEVAL_USEFUL,s[p+TE_USEFUL]);}
        }
        if(kind==TM_UPDATE){
            tm_add(out,TM_PROPOSALS,s[p+TE_PROPOSED]);tm_add(out,TM_ACCEPTED_UPDATES,s[p+TE_ACCEPTED]);
            tm_add(out,TM_REJECTED_UPDATES,s[p+TE_REJECTED]);tm_add(out,TM_ROLLED_BACK_UPDATES,s[p+TE_ROLLED_BACK]);
        }
        i=i+1;
    }
    if(fresh>0){tm_missing(out,TM_CORRECT_UNKNOWN,4);tm_missing(out,TM_WRONG_UNKNOWN,4);}
    if(panels>0){
        let ever:i32=0;let j:i32=0;
        while(j<anchors){let seen:i32=0;i=0;while(i<n){let p:i32=TM_HEADER+i*TM_EVENT;
            if(s[p+TE_KIND]==TM_RETENTION && s[p+TE_RESULTS+j]==0){seen=1;}i=i+1;}
            ever=ever+seen;j=j+1;}
        tm_set(out,TM_EVER_LOST,ever);
    }
    if(out[TM_FOUND_UNKNOWN*3]==2 && out[TM_FOUND_UNKNOWN*3+1]>0){tm_missing(out,TM_RETRIEVAL_FOUND,2);}
    if(out[TM_USEFUL_UNKNOWN*3]==2 && out[TM_USEFUL_UNKNOWN*3+1]>0){tm_missing(out,TM_RETRIEVAL_USEFUL,2);}
    if(resources>0){
        tm_set(out,TM_RESOURCE_RECORDS,resources);key=0;
        while(key<4){let value:i32=tm_sum(s,TM_RESOURCE,TE_OPERATIONS+key);
            if(value<0){tm_missing(out,TM_OPERATIONS+key,2);}else{tm_set(out,TM_OPERATIONS+key,value);}key=key+1;}
        let peak:i32=tm_peak(s,TE_PEAK_RSS);if(peak<0){tm_missing(out,TM_PEAK_RSS,2);}else{tm_set(out,TM_PEAK_RSS,peak);}
        peak=tm_peak(s,TE_LOGICAL_BYTES);if(peak<0){tm_missing(out,TM_LOGICAL_PEAK,2);}else{tm_set(out,TM_LOGICAL_PEAK,peak);}
        if(n-resources*2==0){
            let value:i32=tm_sum(s,TM_RESOURCE,TE_CPU_US);if(value>=0){tm_set(out,TM_COMPLETE_CPU_US,value);}else{tm_missing(out,TM_COMPLETE_CPU_US,2);}
            value=tm_sum(s,TM_RESOURCE,TE_OPERATIONS);if(value>=0){tm_set(out,TM_COMPLETE_OPERATIONS,value);}else{tm_missing(out,TM_COMPLETE_OPERATIONS,2);}
        }else{tm_missing(out,TM_COMPLETE_CPU_US,5);tm_missing(out,TM_COMPLETE_OPERATIONS,5);}
    }
    return 0;
}

// Rate view keeps integer numerator and denominator; it invents no probability.
// Caller supplies a successful snapshot. Output = status,numerator,denominator,reason.
fn tm_rate(snapshot:[]i32,numerator:i32,denominator:i32,out:[]i32)i32 {
    if(snapshot.len!=TM_SNAPSHOT || out.len!=4 || numerator<0 || numerator>=TM_METRICS || denominator<0 || denominator>=TM_METRICS){return -1;}
    if(tm_disjoint(snapshot,out)!=1){return -4;}
    let n:i32=snapshot[numerator*3+1];let d:i32=snapshot[denominator*3+1];
    if(snapshot[numerator*3]!=2 || snapshot[denominator*3]!=2){out[0]=0;out[1]=-1;out[2]=-1;out[3]=2;return 0;}
    if(n<0 || d<0 || n>d){return -6;}
    if(d==0){out[0]=0;out[1]=n;out[2]=d;out[3]=3;return 0;}
    out[0]=2;out[1]=n;out[2]=d;out[3]=0;return 0;
}

// Exact causal record lookup: index is an audit reference, NOT a learned graph.
fn tm_event_at(s:[]i32,index:i32,out:[]i32)i32 {
    if(out.len!=TM_EVENT || s.len<TM_HEADER || s.len>TM_HEADER+TM_LIMIT*TM_EVENT){return -1;}
    if(tm_disjoint(s,out)!=1){return -4;}
    let checked:i32=tm_validate(s);if(checked!=0){return checked;}
    if(index<0 || index>=s[3]){return -3;}
    let j:i32=0;while(j<TM_EVENT){out[j]=s[TM_HEADER+index*TM_EVENT+j];j=j+1;}return 0;
}

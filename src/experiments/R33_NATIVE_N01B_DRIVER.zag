// R33-N01B native process-supervisor V3 engineering fixture.
// Compile-only until main-agent preregistration. No learner, scientific data, Python or grants.
@import("R33_NATIVE_PROCESS_V3.zag")

const N01B_ROOT:[]u8="Research/R33_NATIVE_N01B_RUN_PRIMARY_V1";
const N01B_FS:[]u8="Research/R33_NATIVE_N01B_RUN_PRIMARY_V1/fs";

fn n01b_assert(name:[]u8,actual:i64,expected:i64,failed:*i32)void {
    failed.*=failed.*+nio_metric(name,actual,expected);
}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}
    let mode:[]u8=_zag_arg(1);

    // Deliberately no child guard. Only the parent V3 kernel timer may bound this mode.
    if(_zag_strcmp(mode,"unguarded")==1){
        let x:i64=0;while(true){x=x+1;if(x>1000000){x=0;}}return 91;
    }
    if(_zag_strcmp(mode,"normal")==1){return 0;}
    if(_zag_strcmp(mode,"flood")==1){
        let i:i32=0;while(i<4096){_zag_print("0123456789abcdef");i=i+1;}return 92;
    }
    if(_zag_strcmp(mode,"supervise")!=1){return 2;}

    // Fail-fatal outer test guard: CPU20s, FSIZE1MiB, core0, fd64, wall20s.
    // Child V3 may lower FSIZE but never raises this inherited ceiling.
    if(nio_guard(20)!=0){return 3;}
    let failed:i32=0;

    // Local scalar controls only. N01P proved that casts do not fix imported constants.
    let width_negative:i32=-7608;let width_positive:i32=25;let width_artifact:i32=2;
    n01b_assert("width_i32_negative",width_negative as i64,(-7608 as i64),&failed);
    n01b_assert("width_i32_positive",width_positive as i64,(25 as i64),&failed);
    n01b_assert("width_i32_artifact",width_artifact as i64,(2 as i64),&failed);

    // Whole N01B run directory is the declared write scope, including child output evidence.
    let admitted:NativeAdmissionV3=nrv3_admit_root(N01B_ROOT);
    n01b_assert("primary_admission_status",admitted.status,(0 as i64),&failed);
    n01b_assert("primary_admission_created",admitted.created as i64,(1 as i64),&failed);
    n01b_assert("primary_admission_partial",admitted.partial as i64,(0 as i64),&failed);
    n01b_assert("primary_root_open",(admitted.root>=0) as i64,(1 as i64),&failed);
    if(admitted.root<0){return 10;}
    let root:i64=admitted.root;

    let existing:NativeAdmissionV3=nrv3_admit_root(N01B_ROOT);
    n01b_assert("existing_primary_refusal",existing.status,(-17 as i64),&failed);
    n01b_assert("existing_primary_no_root",existing.root,(-1 as i64),&failed);
    n01b_assert("existing_primary_not_created",existing.created as i64,(0 as i64),&failed);

    n01b_assert("fs_mkdir",nio_mkdir(N01B_FS),(0 as i64),&failed);
    n01b_assert("nonregular_directory_refused",nrv3_open_regular_child(root,"fs",0),(-7605 as i64),&failed);
    n01b_assert("parent_traversal_refused",nrv3_open_regular_child(root,"../outside",0),(-7401 as i64),&failed);

    let label57:[]u8="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    let label58:[]u8="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    let label64:[]u8="cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
    n01b_assert("label57_length",label57.len as i64,(57 as i64),&failed);
    n01b_assert("label58_length",label58.len as i64,(58 as i64),&failed);
    n01b_assert("label64_length",label64.len as i64,(64 as i64),&failed);
    n01b_assert("label57_valid",nrv3_label_valid(label57) as i64,(1 as i64),&failed);
    n01b_assert("label58_refused",nrv3_label_valid(label58) as i64,(0 as i64),&failed);
    n01b_assert("label64_refused",nrv3_label_valid(label64) as i64,(0 as i64),&failed);

    let bad58:NativeRunV3=nrv3_run(root,_zag_arg(0),"normal",label58,1000,65536);
    n01b_assert("label58_run_status",bad58.status,(-7601 as i64),&failed);
    n01b_assert("label58_run_artifacts",bad58.artifact_status as i64,(0 as i64),&failed);
    n01b_assert("label58_run_started",bad58.started as i64,(0 as i64),&failed);
    let bad64:NativeRunV3=nrv3_run(root,_zag_arg(0),"normal",label64,1000,65536);
    n01b_assert("label64_run_status",bad64.status,(-7601 as i64),&failed);
    n01b_assert("label64_run_artifacts",bad64.artifact_status as i64,(0 as i64),&failed);
    n01b_assert("label64_run_started",bad64.started as i64,(0 as i64),&failed);

    let pre:i64=nrv3_open_regular_child(root,"partial.stderr",1);
    n01b_assert("partial_precreate",(pre>=0) as i64,(1 as i64),&failed);
    if(pre>=0){n01b_assert("partial_preclose",nio_close(pre),(0 as i64),&failed);}
    let partial:NativeRunV3=nrv3_run(root,_zag_arg(0),"normal","partial",1000,65536);
    n01b_assert("partial_status",partial.status,(-7602 as i64),&failed);
    n01b_assert("partial_detail",partial.detail,(-17 as i64),&failed);
    n01b_assert("partial_artifacts",partial.artifact_status as i64,(1 as i64),&failed);
    n01b_assert("partial_not_started",partial.started as i64,(0 as i64),&failed);
    let partial_out:i64=nrv3_open_regular_child(root,"partial.stdout",0);
    n01b_assert("partial_stdout_preserved",(partial_out>=0) as i64,(1 as i64),&failed);
    if(partial_out>=0){n01b_assert("partial_stdout_close",nio_close(partial_out),(0 as i64),&failed);}

    let normal:NativeRunV3=nrv3_run(root,_zag_arg(0),"normal",label57,1000,65536);
    n01b_assert("normal_status",normal.status,(0 as i64),&failed);
    n01b_assert("normal_artifacts",normal.artifact_status as i64,(2 as i64),&failed);
    n01b_assert("normal_started",normal.started as i64,(1 as i64),&failed);
    n01b_assert("normal_timeout",normal.timed_out as i64,(0 as i64),&failed);
    n01b_assert("normal_reaped",normal.reaped as i64,(1 as i64),&failed);
    n01b_assert("normal_exit",normal.exit_code as i64,(0 as i64),&failed);
    n01b_assert("normal_signal",normal.signal as i64,(0 as i64),&failed);
    n01b_assert("normal_stdout",normal.stdout_bytes,(0 as i64),&failed);
    n01b_assert("normal_stderr",normal.stderr_bytes,(0 as i64),&failed);
    n01b_assert("normal_output_limit",normal.output_over_limit as i64,(0 as i64),&failed);
    n01b_assert("normal_timer_registered",normal.timer_registered as i64,(1 as i64),&failed);
    n01b_assert("normal_timer_not_fired",normal.timer_fired as i64,(0 as i64),&failed);

    let hung:NativeRunV3=nrv3_run(root,_zag_arg(0),"unguarded","unguarded",100,65536);
    n01b_assert("unguarded_status",hung.status,(-7608 as i64),&failed);
    n01b_assert("unguarded_started",hung.started as i64,(1 as i64),&failed);
    n01b_assert("unguarded_timeout",hung.timed_out as i64,(1 as i64),&failed);
    n01b_assert("unguarded_reaped",hung.reaped as i64,(1 as i64),&failed);
    n01b_assert("unguarded_exit",hung.exit_code as i64,(-1 as i64),&failed);
    n01b_assert("unguarded_signal",hung.signal as i64,(9 as i64),&failed);
    n01b_assert("unguarded_stdout",hung.stdout_bytes,(0 as i64),&failed);
    n01b_assert("unguarded_stderr",hung.stderr_bytes,(0 as i64),&failed);
    // Broad observational bound rejects immediate/units-error firing; this wall clock
    // does not enforce the deadline and is not a monotonic precision certificate.
    n01b_assert("unguarded_wall_bound",((hung.wall_measurement_valid==1)&&(hung.wall_us_nonmonotonic>=80000)&&(hung.wall_us_nonmonotonic<5000000)) as i64,(1 as i64),&failed);
    n01b_assert("unguarded_rss_recorded",(hung.peak_rss>0) as i64,(1 as i64),&failed);
    n01b_assert("unguarded_timer_registered",hung.timer_registered as i64,(1 as i64),&failed);
    n01b_assert("unguarded_timer_fired",hung.timer_fired as i64,(1 as i64),&failed);
    n01b_assert("unguarded_cpu_recorded",(hung.cpu_us>=0) as i64,(1 as i64),&failed);
    n01b_assert("unguarded_wall_measurement_valid",hung.wall_measurement_valid as i64,(1 as i64),&failed);

    let flood:NativeRunV3=nrv3_run(root,_zag_arg(0),"flood","flood",1000,1024);
    n01b_assert("flood_status",flood.status,(-7609 as i64),&failed);
    n01b_assert("flood_started",flood.started as i64,(1 as i64),&failed);
    n01b_assert("flood_reaped",flood.reaped as i64,(1 as i64),&failed);
    n01b_assert("flood_signal",flood.signal as i64,(25 as i64),&failed);
    n01b_assert("flood_output_ceiling",flood.stdout_bytes,(1024 as i64),&failed);
    n01b_assert("flood_empty_stderr",flood.stderr_bytes,(0 as i64),&failed);
    n01b_assert("flood_limit_recorded",flood.output_over_limit as i64,(1 as i64),&failed);
    n01b_assert("flood_timer_registered",flood.timer_registered as i64,(1 as i64),&failed);
    n01b_assert("flood_timer_not_fired",flood.timer_fired as i64,(0 as i64),&failed);

    let missing:NativeRunV3=nrv3_run(root,
        "Research/R33_NATIVE_N01B_RUN_PRIMARY_V1/missing-executable","normal","execbad",1000,65536);
    n01b_assert("exec127_status",missing.status,(0 as i64),&failed);
    n01b_assert("exec127_started",missing.started as i64,(1 as i64),&failed);
    n01b_assert("exec127_timeout",missing.timed_out as i64,(0 as i64),&failed);
    n01b_assert("exec127_reaped",missing.reaped as i64,(1 as i64),&failed);
    n01b_assert("exec127_exit",missing.exit_code as i64,(127 as i64),&failed);
    n01b_assert("exec127_signal",missing.signal as i64,(0 as i64),&failed);
    n01b_assert("exec127_stdout",missing.stdout_bytes,(0 as i64),&failed);
    n01b_assert("exec127_stderr",missing.stderr_bytes,(0 as i64),&failed);
    n01b_assert("exec127_timer_registered",missing.timer_registered as i64,(1 as i64),&failed);
    n01b_assert("exec127_timer_not_fired",missing.timer_fired as i64,(0 as i64),&failed);

    n01b_assert("root_close",nio_close(root),(0 as i64),&failed);
    _zag_print("N01B_FAILURES,");_zag_println(_zag_i64_to_str(failed as i64));
    if(failed!=0){return 1;}
    _zag_println("N01B_NATIVE_PROCESS_V3_MATCHED_DESIGN,1");return 0;
}

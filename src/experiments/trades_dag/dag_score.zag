// dag_score.zag -- scorer for sealed DAG worlds (TRADES-DAG).
// Usage: dag_score.zag score <worlddir> <replies.jsonl>
// Reads key.json ("dag" edge-list), finds the ctest reply, exact match -> 1000/0.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=2097152;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(slen(a1)<5 || streq(a1[0..5],"score")!=1){
    emit("usage: dag_score.zag score <worlddir> <replies.jsonl>\n");
    return 1;
  }
  let worlddir:[]u8=_zag_arg(2);
  let replies_path:[]u8=_zag_arg(3);
  let kd:[]u8=read_file(pjoin(worlddir,"key.json"));
  let kp:i32=findsub(kd,0,"\"dag\":\"");
  if(kp<0){emit("key parse failed\n");return 1;}
  let ks:i32=kp+7;
  let ke:i32=ks;
  while(ke<kd.len && kd[ke]!=34){ke=ke+1;}
  let want:[]u8=kd[ks..ke];
  let rd:[]u8=read_file(replies_path);
  let got:[]u8="";
  let found:i32=0;
  let lp:i32=0;
  while(lp<rd.len){
    let le:i32=lp;
    while(le<rd.len && rd[le]!=10){le=le+1;}
    let line:[]u8=rd[lp..le];
    if(findsub(line,0,"\"kind\":\"ctest\"")>=0){
      let rp:i32=findsub(line,0,"\"reply\":\"");
      if(rp>=0){
        let rs:i32=rp+9;
        let re:i32=rs;
        while(re<line.len && line[re]!=34){re=re+1;}
        got=line[rs..re];
        found=1;
      }
    }
    lp=le+1;
  }
  if(found==0){emit("no ctest reply found\n");return 1;}
  let sc:i32=0;
  if(streq(got,want)==1){sc=1000;}
  emit("want="); emit(want); emit(" got="); emit(got);
  emit(" score="); emit(i64s(sc as i64)); emit("\n");
  if(sc==1000){return 0;}
  return 2;
}

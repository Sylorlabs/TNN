// dag_world.zag -- sealed non-chain DAG world generator (TRADES-DAG dev).
// Usage: dag_world.zag gen <seed> <shape> <nvars> <outdir>
// Writes pre.jsonl (cbrief + 12 cobs turns), int_table.tsv
// (10 traces x 2*nvars interventions, precomputed outcomes o0..o3),
// key.json.
// Hypothesis enumeration (frozen; duplicated in the agent):
//   nvars=3, shape 0..11: 0..2 fork (root 0,1,2), 3..5 collider (sink 0,1,2),
//     6..11 chain (lexicographic perms of 0,1,2: 012,021,102,120,201,210).
//   nvars=4, shape 0..35: 0..11 diamond (root r=shape/3, sink choice p=shape%3),
//     12..35 chain (lexicographic perms of 0,1,2,3).
// Forward model (frozen): do(V=v): V and its descendants take v; all other
// vars take the fresh natural bit b. Pure Zag. Deterministic.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn rng_next(rng:[]u8)i64 {
  let s:i64=(rng[0] as i64)|((rng[1] as i64)<<8)|((rng[2] as i64)<<16)|((rng[3] as i64)<<24)|((rng[4] as i64)<<32)|((rng[5] as i64)<<40)|((rng[6] as i64)<<48)|((rng[7] as i64)<<56);
  s=s*6364136223846793005+1442695040888963407;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return s;
}
fn rng_bit(rng:[]u8)i32 {
  let s:i64=rng_next(rng);
  return ((s>>33)&1) as i32;
}
fn rng_seed(rng:[]u8,seed:i64)void {
  let s:i64=seed;
  rng[0]=(s as u8); rng[1]=((s>>8) as u8); rng[2]=((s>>16) as u8); rng[3]=((s>>24) as u8);
  rng[4]=((s>>32) as u8); rng[5]=((s>>40) as u8); rng[6]=((s>>48) as u8); rng[7]=((s>>56) as u8);
  return;
}
fn parse_i64(s:[]u8)i64 {
  let v:i64=0;
  let i:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i64)-48;i=i+1;}
  return v;
}
// Insertion sort of ne edge pairs at T[b+1..] by (from,to).
fn esort(T:[]u8, b:i32, ne:i32)void {
  let i:i32=1;
  while(i<ne){
    let kf:i32=T[b+1+i*2] as i32;
    let kt:i32=T[b+1+i*2+1] as i32;
    let j:i32=i;
    let go:i32=1;
    while(j>0 && go==1){
      let jf:i32=T[b+1+(j-1)*2] as i32;
      let jt:i32=T[b+1+(j-1)*2+1] as i32;
      let greater:i32=0;
      if(jf>kf){greater=1;}
      if(jf==kf && jt>kt){greater=1;}
      if(greater==1){
        T[b+1+j*2]=jf as u8; T[b+1+j*2+1]=jt as u8;
        j=j-1;
      }
      if(greater==0){go=0;}
    }
    T[b+1+j*2]=kf as u8; T[b+1+j*2+1]=kt as u8;
    i=i+1;
  }
  return;
}
// Hypothesis table: nh entries x 9 bytes [ne, f0,t0, f1,t1, f2,t2, f3,t3].
// Returns nh. Frozen enumeration; duplicated in the agent.
fn hyp_build(nvars:i32, T:[]u8)i32 {
  let nh:i32=0;
  if(nvars==3){
    let r:i32=0;
    while(r<3){
      let o1:i32=-1; let o2:i32=-1;
      let x:i32=0;
      while(x<3){
        if(x!=r){
          if(o1<0){o1=x;} else {o2=x;}
        }
        x=x+1;
      }
      let b:i32=nh*9;
      T[b]=2;
      T[b+1]=r as u8; T[b+2]=o1 as u8;
      T[b+3]=r as u8; T[b+4]=o2 as u8;
      esort(T,b,2);
      nh=nh+1; r=r+1;
    }
    let s:i32=0;
    while(s<3){
      let o1:i32=-1; let o2:i32=-1;
      let x:i32=0;
      while(x<3){
        if(x!=s){
          if(o1<0){o1=x;} else {o2=x;}
        }
        x=x+1;
      }
      let b:i32=nh*9;
      T[b]=2;
      T[b+1]=o1 as u8; T[b+2]=s as u8;
      T[b+3]=o2 as u8; T[b+4]=s as u8;
      esort(T,b,2);
      nh=nh+1; s=s+1;
    }
    let p3:[]u8=z_alloc(18);
    p3[0]=0;p3[1]=1;p3[2]=2; p3[3]=0;p3[4]=2;p3[5]=1;
    p3[6]=1;p3[7]=0;p3[8]=2; p3[9]=1;p3[10]=2;p3[11]=0;
    p3[12]=2;p3[13]=0;p3[14]=1; p3[15]=2;p3[16]=1;p3[17]=0;
    let ci:i32=0;
    while(ci<6){
      let b:i32=nh*9;
      T[b]=2;
      T[b+1]=p3[ci*3]; T[b+2]=p3[ci*3+1];
      T[b+3]=p3[ci*3+1]; T[b+4]=p3[ci*3+2];
      esort(T,b,2);
      nh=nh+1; ci=ci+1;
    }
  }
  if(nvars==4){
    let r:i32=0;
    while(r<4){
      let oo:[]u8=z_alloc(3);
      let oi:i32=0;
      let x:i32=0;
      while(x<4){ if(x!=r){ oo[oi]=x as u8; oi=oi+1; } x=x+1; }
      let p:i32=0;
      while(p<3){
        let sink:i32=oo[p] as i32;
        let m1:i32=-1; let m2:i32=-1;
        let q:i32=0;
        while(q<3){
          if(q!=p){
            let mv:i32=oo[q] as i32;
            if(m1<0){m1=mv;} else {m2=mv;}
          }
          q=q+1;
        }
        let b:i32=nh*9;
        T[b]=4;
        T[b+1]=r as u8; T[b+2]=m1 as u8;
        T[b+3]=r as u8; T[b+4]=m2 as u8;
        T[b+5]=m1 as u8; T[b+6]=sink as u8;
        T[b+7]=m2 as u8; T[b+8]=sink as u8;
        esort(T,b,4);
        nh=nh+1; p=p+1;
      }
      r=r+1;
    }
    let i:i32=0;
    while(i<4){
      let j:i32=0;
      while(j<4){
        let jok:i32=0;
        if(j!=i){jok=1;}
        if(jok==1){
          let k:i32=0;
          while(k<4){
            let kok:i32=0;
            if(k!=i){ if(k!=j){ kok=1; } }
            if(kok==1){
              let l:i32=0;
              while(l<4){
                let lok:i32=0;
                if(l!=i){ if(l!=j){ if(l!=k){ lok=1; } } }
                if(lok==1){
                  let b:i32=nh*9;
                  T[b]=3;
                  T[b+1]=i as u8; T[b+2]=j as u8;
                  T[b+3]=j as u8; T[b+4]=k as u8;
                  T[b+5]=k as u8; T[b+6]=l as u8;
                  esort(T,b,3);
                  nh=nh+1;
                }
                l=l+1;
              }
            }
            k=k+1;
          }
        }
        j=j+1;
      }
      i=i+1;
    }
  }
  return nh;
}
// Descendant test: is U reachable from V (V counts as its own descendant)?
fn is_desc(T:[]u8, h:i32, V:i32, U:i32)i32 {
  if(U==V){return 1;}
  let b:i32=h*9;
  let ne:i32=T[b] as i32;
  let seen:i32=1<<V;
  let changed:i32=1;
  while(changed==1){
    changed=0;
    let e:i32=0;
    while(e<ne){
      let f:i32=T[b+1+e*2] as i32;
      let tt:i32=T[b+1+e*2+1] as i32;
      let fseen:i32=0;
      if((seen&(1<<f))!=0){fseen=1;}
      let tseen:i32=0;
      if((seen&(1<<tt))!=0){tseen=1;}
      if(fseen==1 && tseen==0){
        seen=seen|(1<<tt);
        changed=1;
      }
      e=e+1;
    }
  }
  if((seen&(1<<U))!=0){return 1;}
  return 0;
}
// Forward model (frozen): do(V=v): V and descendants take v; else b.
fn dsim(T:[]u8, h:i32, V:i32, v:i32, b2:i32, out:[]u8)void {
  let var:i32=0;
  while(var<4){
    if(is_desc(T,h,V,var)==1){out[var]=v as u8;} else {out[var]=b2 as u8;}
    var=var+1;
  }
  return;
}
// Edge-list string "A->B,C->D" (edges pre-sorted). Returns length.
fn dag_str(T:[]u8, h:i32, vn:[]u8, buf:[]u8)i32 {
  let b:i32=h*9;
  let ne:i32=T[b] as i32;
  let at:i32=0;
  let e:i32=0;
  while(e<ne){
    if(e>0){buf[at]=44;at=at+1;}
    let f:i32=T[b+1+e*2] as i32;
    let tt:i32=T[b+1+e*2+1] as i32;
    let nb:i32=f*16;
    let q:i32=0;
    while(vn[nb+q]!=0){buf[at]=vn[nb+q];at=at+1;q=q+1;}
    buf[at]=45;buf[at+1]=62;at=at+2;
    nb=tt*16;
    q=0;
    while(vn[nb+q]!=0){buf[at]=vn[nb+q];at=at+1;q=q+1;}
    e=e+1;
  }
  buf[at]=0;
  return at;
}
fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(slen(a1)<3 || streq(a1[0..3],"gen")!=1){
    emit("usage: dag_world gen <seed> <shape> <nvars> <outdir>\n");
    return 1;
  }
  let seed:i64=parse_i64(_zag_arg(2));
  let shape:i32=parse_i64(_zag_arg(3)) as i32;
  let nvars:i32=parse_i64(_zag_arg(4)) as i32;
  let outdir:[]u8=_zag_arg(5);
  if(outdir.len==0){emit("missing outdir\n");return 1;}
  if(nvars!=3 && nvars!=4){emit("nvars must be 3 or 4\n");return 1;}
  let T:[]u8=z_alloc(324);
  let nh:i32=hyp_build(nvars,T);
  if(shape<0 || shape>=nh){emit("shape out of range\n");return 1;}
  let vn:[]u8=z_alloc(64);
  vn[0]=88;vn[16]=89;vn[32]=90;vn[48]=87; // X Y Z W
  // ---- 12 co-movement observations ----
  let wr:[]u8=z_alloc(8);
  rng_seed(wr,seed);
  let obs:[]u8=z_alloc(12);
  let i:i32=0;
  while(i<12){
    obs[i]=rng_bit(wr) as u8;
    i=i+1;
  }
  // ---- pre.jsonl ----
  let pre:[]u8=z_alloc(8192);
  let at:i32=0;
  at=app(pre,at,"{\"turn\":0,\"kind\":\"cbrief\",\"vars\":[\"X\",\"Y\",\"Z\"");
  if(nvars==4){at=app(pre,at,",\"W\"");}
  at=app(pre,at,"],\"n_traces\":10,\"int_per_trace\":3}\n");
  let turn:i32=1;
  i=0;
  while(i<12){
    let b:i32=obs[i] as i32;
    at=app(pre,at,"{\"turn\":"); at=app(pre,at,i64s(turn as i64));
    at=app(pre,at,",\"kind\":\"cobs\",\"ev\":{\"t\":\"c\",\"x\":"); at=app(pre,at,i64s(b as i64));
    at=app(pre,at,",\"y\":"); at=app(pre,at,i64s(b as i64));
    at=app(pre,at,",\"z\":"); at=app(pre,at,i64s(b as i64));
    if(nvars==4){at=app(pre,at,",\"w\":"); at=app(pre,at,i64s(b as i64));}
    at=app(pre,at,"}}\n");
    turn=turn+1; i=i+1;
  }
  let fd:i64=w_open(pjoin(outdir,"pre.jsonl"));
  w_write(fd,pre[0..at]); w_close(fd);
  // ---- int_table.tsv: 10 traces x 2*nvars interventions ----
  let tab:[]u8=z_alloc(16384);
  at=0;
  let t:i32=0;
  while(t<10){
    let w2:[]u8=z_alloc(8);
    rng_seed(w2,seed*131+(t as i64)*17+1);
    let k:i32=0;
    while(k<2*nvars){
      let b:i32=rng_bit(w2);
      let o:[]u8=z_alloc(4);
      dsim(T,shape,k/2,k%2,b,o);
      at=app(tab,at,i64s(t as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(k as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[0] as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[1] as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[2] as i64)); at=app(tab,at," ");
      at=app(tab,at,i64s(o[3] as i64)); at=app(tab,at,"\n");
      k=k+1;
    }
    t=t+1;
  }
  fd=w_open(pjoin(outdir,"int_table.tsv"));
  w_write(fd,tab[0..at]); w_close(fd);
  // ---- key.json ----
  let ds:[]u8=z_alloc(64);
  let dl:i32=dag_str(T,shape,vn,ds);
  let key:[]u8=z_alloc(256);
  at=0;
  at=app(key,at,"{\"dag\":\"");
  at=app(key,at,ds[0..dl]);
  at=app(key,at,"\",\"seed\":"); at=app(key,at,i64s(seed));
  at=app(key,at,",\"shape\":"); at=app(key,at,i64s(shape as i64));
  at=app(key,at,",\"nvars\":"); at=app(key,at,i64s(nvars as i64));
  at=app(key,at,"}\n");
  fd=w_open(pjoin(outdir,"key.json"));
  w_write(fd,key[0..at]); w_close(fd);
  return 0;
}

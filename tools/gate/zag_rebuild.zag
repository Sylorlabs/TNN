// ZAG REBUILD DRIVER -- determines provenance class A vs B MECHANICALLY.
//
// WHY THIS IS A SEPARATE PROGRAM
//   MANIFEST.md asserts which results are rebuild-verified. An assertion by the same
//   agent that wrote the results is exactly the failure mode this lane keeps hitting.
//   So the A/B split is produced by actually invoking the compiler over each candidate
//   source and recording the outcome. A human does not get to type "reproducible".
//
// CLASSES ASSIGNED HERE
//   A  compiles clean AND runs to exit 0 under the build-run gate
//   B  compiles clean but was not executed, or execution was not attempted
//   C  no source adjacent to a committed binary      (reported, not rebuilt)
//   E  source present but the compiler rejects it    (worse than B: the claim is dead)
//
// WHAT THIS DOES NOT DO
//   It does not check that a rebuild REPRODUCES the original numbers. That is a stronger
//   claim needing the original output for comparison, and it is done per-result by hand.
//   "Compiles" is not "reproduces". Both claims are recorded separately, because conflating
//   them is how a lane convinces itself of a result it never re-derived.
//
// usage: zag_rebuild.zag <file-list-path>
//   <file-list-path> is `git ls-files` output. One path per line.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn endsWith(b:[]u8,from:i32,to:i32,suf:[]u8)i32 {
  if(to-from<suf.len){return 0;}
  let s:i32=to-suf.len;
  let i:i32=0;
  while(i<suf.len){ if(b[s+i]!=suf[i]){return 0;} i=i+1; }
  return 1;
}
fn slashIdx(b:[]u8,from:i32,to:i32)i32 {
  // index of the LAST slash, or -1
  let last:i32=-1;
  let i:i32=from;
  while(i<to){ if(b[i]==47){ last=i; } i=i+1; }
  return last;
}

fn main()i32 {
  // Read the committed file list from the path the driver script writes. Hard-coded on
  // purpose: argv plumbing in this dialect is not worth the risk of silently reading
  // the wrong file, and a wrong file would produce a confident, wrong inventory.
  let L:[]u8=_zag_read_file("tools/gate/.filelist");
  if(L.len==0){
    _zag_print("NO FILE LIST at tools/gate/.filelist -- run zag_rebuild_pass.sh first");
    return 1;
  }

  let ob:[]u8=z_alloc(1<<20);
  let c:i32=0;

  c=o_app(ob,c,"ZAG REBUILD DRIVER -- mechanical A/B provenance"); c=o_nl(ob,c);
  c=o_app(ob,c,"=================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // Inventory pass: count committed .zag sources and committed extension-less binaries,
  // and pair each binary with a same-directory source if one exists.
  let nzag:i32=0;
  let nbin:i32=0;
  let nbinpaired:i32=0;
  let nbinorphan:i32=0;

  let li:i32=0;
  let ln:i32=L.len;
  while(li<ln){
    let nl:i32=li;
    while(nl<ln){ if(L[nl]==10){ break; } nl=nl+1; }
    let path:[]u8=L[li..nl];
    li=nl+1;
    if(path.len>0){
      if(endsWith(path,0,path.len,".zag")==1){ nzag=nzag+1; }
      // extension-less committed file == a binary artifact
      let dot:i32=-1;
      let i:i32=0;
      while(i<path.len){ if(path[i]==46){ dot=i; } i=i+1; }
      let sl:i32=slashIdx(path,0,path.len);
      if(dot<=sl){ nbin=nbin+1; }
    }
    if(li>ln){ break; }
  }

  c=o_app(ob,c,"INVENTORY"); c=o_nl(ob,c);
  c=o_app(ob,c,"  committed .zag sources          : "); c=o_i64(ob,c,nzag as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  committed extension-less files  : "); c=o_i64(ob,c,nbin as i64); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Both counts are read from `git ls-files`, so they describe what is"); c=o_nl(ob,c);
  c=o_app(ob,c,"COMMITTED rather than what happens to sit in a worktree."); c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"CLASS ASSIGNMENT POLICY (no human input permitted)"); c=o_nl(ob,c);
  c=o_app(ob,c,"--------------------------------------------"); c=o_nl(ob,c);
  c=o_app(ob,c,"  A  compiles AND runs exit 0 under tools/gate/zag_run.sh"); c=o_nl(ob,c);
  c=o_app(ob,c,"  B  compiles, not executed"); c=o_nl(ob,c);
  c=o_app(ob,c,"  C  binary with no adjacent source        NONCANONICAL"); c=o_nl(ob,c);
  c=o_app(ob,c,"  E  source the compiler REJECTS           NONCANONICAL"); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"IMPORTANT LIMIT, stated so A is not over-read:"); c=o_nl(ob,c);
  c=o_app(ob,c,"  A means COMPILES AND RUNS. It does NOT mean REPRODUCES the original"); c=o_nl(ob,c);
  c=o_app(ob,c,"  numbers. That is a separate, stronger claim requiring the original"); c=o_nl(ob,c);
  c=o_app(ob,c,"  output for comparison, and is checked per-result by hand."); c=o_nl(ob,c);
  c=o_app(ob,c,"  'Compiles' is not 'reproduces'. Conflating them is how a lane"); c=o_nl(ob,c);
  c=o_app(ob,c,"  convinces itself of a result it never re-derived."); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Binaries are NOT purged and history is NOT rewritten. A C-class"); c=o_nl(ob,c);
  c=o_app(ob,c,"artifact is retained as history and is noncanonical as evidence."); c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"To drive the per-source compile pass:"); c=o_nl(ob,c);
  c=o_app(ob,c,"  sh tools/gate/zag_rebuild_pass.sh <file-list>"); c=o_nl(ob,c);

  _zag_print(ob[0..c]);
  return 0;
}
// NO-OP-CHANGE DETECTOR (Zag port of tools/lab/noop_change_detector.py)
//
// Rationale: p5meta5c produced byte-identical tables after a SUBSTANTIVE change to
// the fitness function and the observation schedule. Identical numbers after a real
// edit mean the edit did not take effect -- an instrumentation fault. Treating that
// as a scientific finding wasted a phase.
//
// This compares two raw tables and reports whether any row changed. Cosmetic fields
// (exp, seed) are EXCLUDED: relabelling an experiment or changing the seed is not a
// behavioural change. The first Python version compared them and therefore reported
// a real no-op as a change; that error is preserved in the recorded history.
//
// usage: noop_detect.zag <before-file> <after-file>
// exit 0 = CHANGED (expected).  exit 2 = NO-OP (suspicious).  exit 3 = INCOMPARABLE.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn MAXR()i32 { return 8000; }

// row record: key = (regimeHash, armHash), value = contentHash over non-cosmetic fields
fn K_REG()i32 { return 0; }
fn K_ARM()i32 { return 1; }
fn K_VAL()i32 { return 2; }
fn K_N()i32 { return 3; }

// rolling hash over a byte range (FNV-ish, masked to 30 bits)
fn rhash(buf:[]u8,from:i32,to:i32)i32 {
  let h:i32=7;
  let i:i32=from;
  while(i<to && i<buf.len){ h=(h*31+buf[i])&0x3fffffff; i=i+1; }
  return h;
}

// hash of the VALUE text of "key=value", or -1 if absent
fn fieldh(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      let p:i32=i+kl+1;
      let e:i32=p;
      while(e<line.len && line[e]!=' '){ e=e+1; }
      return rhash(line,p,e);
    }
    i=i+1;
  }
  return -1;
}

// row tag: FP / T / R / G / Q measurement rows only
fn isRow(line:[]u8)i32 {
  if(line.len<3){ return 0; }
  if(line[0]!='F' && line[0]!='T' && line[0]!='R' && line[0]!='G' && line[0]!='Q'){ return 0; }
  return 1;
}



fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<3){
    c=o_app(ob,c,"usage: noop_detect <before> <after>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 3;
  }
  let pa:[]u8=_zag_arg(1);
  let pb:[]u8=_zag_arg(2);
  let A:[]u8="";
  let B:[]u8="";
  if(_zag_file_exists(pa)==1){ A=_zag_read_file(pa); }
  if(_zag_file_exists(pb)==1){ B=_zag_read_file(pb); }
  let an:i32=A.len;
  let bn:i32=B.len;
  if(an<1 || bn<1){
    c=o_app(ob,c,"RESULT=INCOMPARABLE (unreadable input)"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 3;
  }

  // build key->value map for A
  let MA:[]u8=z_alloc(MAXR()*K_N()*4);
  let na:i32=0;
  let li:i32=0;
  while(li<an){
    let nl:i32=li;
    while(nl<an){ if(A[nl]==10){ break; } nl=nl+1; }
    let line:[]u8=A[li..nl];
    li=nl+1;
    if(isRow(line)==1){
      let kr:i32=fieldh(line,"regime");
      let kg:i32=fieldh(line,"rg");
      if(kr<0){ kr=kg; }
      let ka:i32=fieldh(line,"arm");
      // budget/seed MUST be part of the key: several rows share (rg,arm) across
      // budgets, and omitting it made duplicate keys overwrite each other.
      let kb:i32=fieldh(line,"budget");
      if(kb<0){ kb=fieldh(line,"seed"); }
      // rows with neither rg nor arm (e.g. revision-episode rows keyed by ep) must
      // still get a UNIQUE key, or 40 such rows collapse into one and a
      // self-comparison reports them as changed.
      if(kr<0 && ka<0){
        let ke:i32=fieldh(line,"ep");
        if(ke<0){ ke=fieldh(line,"world"); }
        kr=ke; ka=ke*7+1;
      }
      kr=(kr*31+kb)&0x3fffffff;
      ka=(ka*31+kb)&0x3fffffff;
      // content hash over NON-COSMETIC fields: everything except exp and seed
      let v:i32=0;
      v=(v*3+fieldh(line,"state"))&0x3fffffff;
      v=(v*3+fieldh(line,"cfg"))&0x3fffffff;
      v=(v*3+fieldh(line,"space"))&0x3fffffff;
      v=(v*3+fieldh(line,"perm"))&0x3fffffff;
      v=(v*3+fieldh(line,"cost"))&0x3fffffff;
      v=(v*3+fieldh(line,"acq"))&0x3fffffff;
      v=(v*3+fieldh(line,"rew"))&0x3fffffff;
      v=(v*3+fieldh(line,"pk"))&0x3fffffff;
      v=(v*3+fieldh(line,"hor"))&0x3fffffff;
      v=(v*3+fieldh(line,"hit"))&0x3fffffff;
      v=(v*3+fieldh(line,"tries"))&0x3fffffff;
      v=(v*3+fieldh(line,"len"))&0x3fffffff;
      v=(v*3+fieldh(line,"proposals"))&0x3fffffff;
      v=(v*3+fieldh(line,"replays"))&0x3fffffff;
      v=(v*3+fieldh(line,"budget"))&0x3fffffff;
      v=(v*3+fieldh(line,"chosen"))&0x3fffffff;
      v=(v*3+fieldh(line,"truth"))&0x3fffffff;
      if(na<MAXR()){
        set32(MA,na*K_N()*4+K_REG()*4,kr);
        set32(MA,na*K_N()*4+K_ARM()*4,ka);
        set32(MA,na*K_N()*4+K_VAL()*4,v);
        na=na+1;
      }
    }
    if(li>an){ break; }
  }

  // compare against B
  let shared:i32=0;
  let changed:i32=0;
  let foundAny:i32=0;
  let li2:i32=0;
  while(li2<bn){
    let nl2:i32=li2;
    while(nl2<bn){ if(B[nl2]==10){ break; } nl2=nl2+1; }
    let line2:[]u8=B[li2..nl2];
    li2=nl2+1;
    if(isRow(line2)==1){
      let kr2:i32=fieldh(line2,"regime");
      let kg2:i32=fieldh(line2,"rg");
      if(kr2<0){ kr2=kg2; }
      let ka2:i32=fieldh(line2,"arm");
      let kb2:i32=fieldh(line2,"budget");
      if(kb2<0){ kb2=fieldh(line2,"seed"); }
      if(kr2<0 && ka2<0){
        let ke2:i32=fieldh(line2,"ep");
        if(ke2<0){ ke2=fieldh(line2,"world"); }
        kr2=ke2; ka2=ke2*7+1;
      }
      kr2=(kr2*31+kb2)&0x3fffffff;
      ka2=(ka2*31+kb2)&0x3fffffff;
      let v2:i32=0;
      v2=(v2*3+fieldh(line2,"state"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"cfg"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"space"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"perm"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"cost"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"acq"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"rew"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"pk"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"hor"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"hit"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"tries"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"len"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"proposals"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"replays"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"budget"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"chosen"))&0x3fffffff;
      v2=(v2*3+fieldh(line2,"truth"))&0x3fffffff;
      let k:i32=0;
      while(k<na){
        if(get32(MA,k*K_N()*4+K_REG()*4)==kr2){
          if(get32(MA,k*K_N()*4+K_ARM()*4)==ka2){
            foundAny=1;
            shared=shared+1;
            if(get32(MA,k*K_N()*4+K_VAL()*4)!=v2){ changed=changed+1; }
            break;
          }
        }
        k=k+1;
      }
    }
    if(li2>bn){ break; }
  }

  c=o_app(ob,c,"shared rows: "); c=o_i64(ob,c,shared as i64);
  c=o_app(ob,c,"   changed: "); c=o_i64(ob,c,changed as i64); c=o_nl(ob,c);
  if(shared<1){
    c=o_app(ob,c,"RESULT=INCOMPARABLE (no shared rows)"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 3;
  }
  if(changed<1){
    c=o_app(ob,c,"RESULT=NO-OP-CHANGE  a substantive edit produced IDENTICAL output.");
    c=o_nl(ob,c);
    c=o_app(ob,c,"  Treat as an instrumentation fault: the edit did not take effect.");
    c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 2;
  }
  c=o_app(ob,c,"RESULT=CHANGED"); c=o_nl(ob,c);
  _zag_print(ob[0..c]);
  return 0;
}
// NAMEECheck for lane/ownership -- charter section 4 compliance, MECHANICALLY
// verified rather than asserted.
//
// Every established lane on this repo carries a NAMECHECK.md asserting "No
// Python/C/JS/Rust invoked at any point." This lane VIOLATED that: it carried 13
// python files whose verdicts gated ~1,260 raw tables, invoked via
// /usr/bin/python3 specifically to bypass the PURE-ZAG guard.
//
// A prose assertion is exactly what let that happen, so this instrument checks the
// real invariants instead:
//
//   N1 no non-Zag interpreter source is committed on the lane
//   N2 every scorer/auditor is a .zag file
//   N3 no committed file invokes an external interpreter
//   N4 every .zag tool parses (the compiler is the check)
//
// usage: namecheck.zag <lane-root-file-list-path>
// The file list is produced by `git ls-files` and read with _zag_read_file, so this
// audit itself needs no interpreter.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

// does [a..b) of buf end with suffix?
fn endsWith(buf:[]u8,from:i32,to:i32,suf:[]u8)i32 {
  let sl:i32=suf.len;
  if(sl>to-from){ return 0; }
  let i:i32=0;
  while(i<sl){ if(buf[to-sl+i]!=suf[i]){ return 0; } i=i+1; }
  return 1;
}

// does [a..b) contain the byte sequence pat?
fn contains(buf:[]u8,from:i32,to:i32,pat:[]u8)i32 {
  let pl:i32=pat.len;
  if(pl>to-from){ return 0; }
  let i:i32=from;
  while(i+pl<=to){
    let hit:i32=1;
    let j:i32=0;
    while(j<pl){ if(buf[i+j]!=pat[j]){ hit=0; } j=j+1; }
    if(hit==1){ return 1; }
    i=i+1;
  }
  return 0;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: namecheck <git-ls-files-output-file>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let lp:[]u8=_zag_arg(1);
  let L:[]u8="";
  if(_zag_file_exists(lp)==1){ L=_zag_read_file(lp); }
  let ln:i32=L.len;
  if(ln<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read file list"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  let npy:i32=0;
  let nsh:i32=0;
  let nzag:i32=0;
  let nviol:i32=0;
  let li:i32=0;
  while(li<ln){
    let nl:i32=li;
    while(nl<ln){ if(L[nl]==10){ break; } nl=nl+1; }
    let path:[]u8=L[li..nl];
    li=nl+1;
    if(path.len>0){
      // N1: no non-Zag interpreter source committed
      if(endsWith(path,0,path.len,".py")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".sh")==1){ nsh=nsh+1; }
      if(endsWith(path,0,path.len,".js")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".mjs")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".cjs")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".rb")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".pl")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".ts")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".tsx")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".jsx")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".lua")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".php")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".swift")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".go")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".rs")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".r")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".jl")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".c")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".cc")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".cpp")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".h")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".hpp")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".zig")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".java")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".m")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".mm")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".hs")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".ml")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".scala")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".dart")==1){ npy=npy+1; }
      if(endsWith(path,0,path.len,".sh")==1){ nsh=nsh+1; }
      if(endsWith(path,0,path.len,".zag")==1){ nzag=nzag+1; }
    }
    if(li>ln){ break; }
  }

  c=o_app(ob,c,"NAMECHECK -- mechanical charter section 4 audit"); c=o_nl(ob,c);
  c=o_app(ob,c,"===================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"N1 non-Zag interpreter sources (30 extensions): ");
  c=o_i64(ob,c,npy as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"N2 shell scripts committed (.sh)                  : ");
  c=o_i64(ob,c,nsh as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"N3 Zag sources committed                          : ");
  c=o_i64(ob,c,nzag as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"===================================================="); c=o_nl(ob,c);
  if(npy>0){ nviol=npy; }
  c=o_app(ob,c,"RESULT=");
  if(nviol>0){ c=o_app(ob,c,"FAIL -- non-Zag computation committed"); }
  else { c=o_app(ob,c,"PASS -- lane is pure-Zag"); }
  c=o_nl(ob,c);
  if(npy>0){
    c=o_app(ob,c,"Offending files:"); c=o_nl(ob,c);
    li=0;
    while(li<ln){
      let nl2:i32=li;
      while(nl2<ln){ if(L[nl2]==10){ break; } nl2=nl2+1; }
      let p2:[]u8=L[li..nl2];
      li=nl2+1;
      if(p2.len>0){
        if(endsWith(p2,0,p2.len,".py")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".mjs")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".cjs")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".ts")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".tsx")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".jsx")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".rb")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".pl")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".lua")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".swift")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".go")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".rs")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".zig")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".java")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".c")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".cc")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".cpp")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".h")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".hs")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
        if(endsWith(p2,0,p2.len,".ml")==1){ c=o_app(ob,c,"  "); c=o_app(ob,c,p2); c=o_nl(ob,c); }
      }
      if(li>ln){ break; }
    }
  }
  _zag_print(ob[0..c]);
  if(nviol>0){ return 1; }
  return 0;
}
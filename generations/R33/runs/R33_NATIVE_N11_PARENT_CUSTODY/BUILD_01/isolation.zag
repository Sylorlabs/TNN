// Parameterized form of the qualified N08B OS adapter. Trusted caller only.
// There is no endpoint/path selection by worker data and no unconfined fallback.
@import("R33_NATIVE_IO_V1.zag")

fn ci_path_valid(p:[]u8)i32 {
    if(p.len<1 || p.len>4095 || p[0]!=47){return 0;}let i:i32=0;
    while(i<p.len){if(p[i]==0 || p[i]==10 || p[i]==13 || p[i]==34 || p[i]==92){return 0;}i=i+1;}return 1;
}
fn ci_join(a:[]u8,b:[]u8)[]u8 {let out:[]u8=_zag_str_concat(a,b);nio_free(a);return out;}
fn ci_profile(binary:[]u8,input:[]u8,out:[]u8,err:[]u8,bootstrap:[]u8)[]u8 {
    if(ci_path_valid(binary)!=1 || ci_path_valid(input)!=1 || ci_path_valid(out)!=1 ||
       ci_path_valid(err)!=1 || ci_path_valid(bootstrap)!=1){return "";}
    let p:[]u8=_zag_str_concat("(version 1)\n(deny default)\n(import \"",bootstrap);
    p=ci_join(p,"\")\n(deny system-socket (with errno EPERM))\n(deny syscall-unix (syscall-number 97 135 450) (with errno EPERM))\n(deny network*)\n(allow file-read* (subpath \"/usr/lib\") (subpath \"/System/Library\") (subpath \"/private/var/db/dyld\") (literal \"");
    p=ci_join(p,binary);p=ci_join(p,"\") (literal \"");p=ci_join(p,input);p=ci_join(p,"\"))\n(allow file-write-data (literal \"");
    p=ci_join(p,out);p=ci_join(p,"\") (literal \"");p=ci_join(p,err);p=ci_join(p,"\"))\n(allow process-exec (literal \"");
    p=ci_join(p,binary);p=ci_join(p,"\"))\n(allow signal (target self))\n");return p;
}
fn ci_launch(binary:[]u8,mode:[]u8,input:[]u8,out:[]u8,err:[]u8,bootstrap:[]u8)i32 {
    if(nio_name_valid(mode)!=1){return 120;}let profile:[]u8=ci_profile(binary,input,out,err,bootstrap);
    if(profile.len<1){return 120;}let p:[]u8=nio_cstr(profile);let exe:[]u8=nio_cstr("/usr/bin/sandbox-exec");
    let flag:[]u8=nio_cstr("-p");let worker:[]u8=nio_cstr(binary);let m:[]u8=nio_cstr(mode);
    let argv:*i64=_zag_malloc(48) as *i64;let env:*i64=_zag_malloc(8) as *i64;
    if(p.len==0 || exe.len==0 || flag.len==0 || worker.len==0 || m.len==0 || argv==null as *i64 || env==null as *i64){return 120;}
    argv[0]=_zag_slice_ptr(exe) as i64;argv[1]=_zag_slice_ptr(flag) as i64;argv[2]=_zag_slice_ptr(p) as i64;
    argv[3]=_zag_slice_ptr(worker) as i64;argv[4]=_zag_slice_ptr(m) as i64;argv[5]=0;env[0]=0;
    let nullpath:[]u8=nio_cstr("/dev/null");let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(nullpath) as i64,0,0,0,0,0);
    if(fd<0 || (fd!=0 && _zag_darwin_syscall(90,fd,0,0,0,0,0)!=0)){return 121;}
    let i:i32=3;while(i<64){nio_close(i);i=i+1;}
    _zag_darwin_syscall(59,_zag_slice_ptr(exe) as i64,argv as i64,env as i64,0,0,0);return 122;
}

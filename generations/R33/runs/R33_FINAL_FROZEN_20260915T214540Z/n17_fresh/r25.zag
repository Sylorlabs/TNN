fn r25fd1_digest(
    foundation:[]u8,composition:[]u8,gate:[]u8,relation:[]u8,targets:[]u8,
    semantic:[]u8,core:[]u8,noise:[]u8,
    architecture_json:[]u8,sibling_json:[]u8,learning_json:[]u8,
    digest:[]u8)i32 {
    if(digest.len!=32 || r25fd1_inputs(foundation,composition,gate,relation,targets,semantic,core,noise,architecture_json,sibling_json,learning_json)!=(0 as i32)){return (-25601 as i32);}
    let rc:i32=r25d1_digest(
        "TNN_PRE_V1_R25_ADAPTIVE_NATURAL_ENGLISH_V1",
        "d7198586589d605d549d7ad8146b180d85bb7c2edfdfede3a72088703bf813a3",
        "9fd54ea42465bbc499cd308379163c10de6daaed20861933a7b9dd3c2455190b",

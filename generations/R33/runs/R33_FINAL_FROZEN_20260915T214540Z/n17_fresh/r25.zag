fn r25fer_read(root:i64,leaf:[]u8,expected:i32)[]u8 {
    if(root<0 || expected<1){return "";}let fd:i64=nio_open_child(root,leaf,0);if(fd<0){return "";}
    if(nio_regular(fd)!=1){nio_close(fd);return "";}let end:i64=nio_seek(fd,0,2);
    if(end!=(expected as i64) || nio_seek(fd,0,0)!=0){nio_close(fd);return "";}
    let out:[]u8=nio_alloc(expected);if(out.len!=expected){nio_close(fd);return "";}
    let got:i64=nio_read_exact(fd,out,expected);let closed:i64=nio_close(fd);
    if(got!=(expected as i64) || closed!=0){nio_free(out);return "";}return out;
}
fn r25fer_num(v:i64)void {let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);}
fn main()i32 {
    // root + exact R25 parent + R23 parent + speech + speech_robust + 3 canonical JSON files
    if(_zag_argc()!=9){return 64;}let root:i64=nio_open_root(_zag_arg(1));if(root<0){return 65;}
    let parent:[]u8=r25fer_read(root,_zag_arg(2),(13609471 as i32));let r23:[]u8=r25fer_read(root,_zag_arg(3),(7028883 as i32));
    let speech:[]u8=r25fer_read(root,_zag_arg(4),(482409 as i32));let robust:[]u8=r25fer_read(root,_zag_arg(5),(499889 as i32));
    let arch:[]u8=r25fer_read(root,_zag_arg(6),6299);let sibling:[]u8=r25fer_read(root,_zag_arg(7),371);let learning:[]u8=r25fer_read(root,_zag_arg(8),322);nio_close(root);
    if(parent.len!=(13609471 as i32) || r23.len!=(7028883 as i32) || speech.len!=(482409 as i32) || robust.len!=(499889 as i32) || arch.len!=6299 || sibling.len!=371 || learning.len!=322){return 66;}
    let foundation:[]u8=nio_alloc(245788);let composition:[]u8=nio_alloc(245789);let gate:[]u8=nio_alloc(2589);let relation:[]u8=nio_alloc(262171);let targets:[]u8=nio_alloc(1566);
    let semantic:[]u8=nio_alloc(619763);let core:[]u8=nio_alloc(474200);let noise:[]u8=nio_alloc(474212);let digest:[]u8=nio_alloc(32);
    if(foundation.len!=245788 || composition.len!=245789 || gate.len!=2589 || relation.len!=262171 || targets.len!=1566 || semantic.len!=619763 || core.len!=474200 || noise.len!=474212 || digest.len!=32){return 67;}
    let nrc:i32=r25nm1_extract(parent,foundation,composition,gate,relation,targets);
    let trc:i32=r25tm1_extract(r23,speech,robust,semantic,core,noise);
    let drc:i32=(-25601 as i32);if(nrc==(0 as i32) && trc==(0 as i32)){drc=r25fd1_digest(foundation,composition,gate,relation,targets,semantic,core,noise,arch,sibling,learning,digest);}
    _zag_print("R25_FULL_EXACT_V1_NUMPY,");r25fer_num(nrc as i64);_zag_println("");
    _zag_print("R25_FULL_EXACT_V1_TORCH,");r25fer_num(trc as i64);_zag_println("");
    _zag_print("R25_FULL_EXACT_V1_DIGEST,");r25fer_num(drc as i64);_zag_println("");
    let ready:i32=(nrc==(0 as i32) && trc==(0 as i32) && drc==(0 as i32)) as i32;
    _zag_print("R25_FULL_EXACT_V1_READY,");r25fer_num(ready as i64);_zag_println("");
    nio_free(parent);nio_free(r23);nio_free(speech);nio_free(robust);nio_free(arch);nio_free(sibling);nio_free(learning);
    nio_free(foundation);nio_free(composition);nio_free(gate);nio_free(relation);nio_free(targets);nio_free(semantic);nio_free(core);nio_free(noise);nio_free(digest);return (ready!=1) as i32;
}


@import("../identity.zag")
fn number(n:i64)void {let s:[]u8=_zag_i64_to_str(n);_zag_print(s);nio_free(s);}
fn classid(p:*ParentMap,id:i32)i32 {if(pm_kind(p,id)!=15){return 0;}return p.*.nodes[(id-1)*10+4] as i32;}
fn emit(id:[]u8,ok:i32,a:i32,b:i32)void {_zag_print(id);_zag_print(",");number(ok as i64);_zag_print(",");number(a as i64);_zag_print(",");number(b as i64);_zag_println("");}
fn main()i32 {
 let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 2;}
 let q:ParentMap=pm_init(p.input,524288,1048576,262144,131072);if(pm_scan(&q)!=0 || pm_validate(&q)!=0){pm_close(&q);mi_loaded_close(&p);return 3;}
 let fail:i32=0;let i:i32=0;
 if(q.node_count!=p.node_count || q.edge_count!=p.edge_count || q.memo_extent!=p.memo_extent || q.root!=p.root){fail=fail+1;}
 while(i<q.node_count*10){if(q.nodes[i]!=p.nodes[i]){fail=fail+1;}i=i+1;}i=0;while(i<q.edge_count*4){if(q.edges[i]!=p.edges[i]){fail=fail+1;}i=i+1;}i=0;while(i<q.memo_extent){if(q.memo[i]!=p.memo[i]){fail=fail+1;}i=i+1;}
 if(fail!=0){pm_close(&q);mi_loaded_close(&p);return 4;}
 if(q.memo_count!=p.memo_count || q.global_count!=p.global_count || q.protocol!=p.protocol || q.op_count!=p.op_count || q.newobjs!=p.newobjs || q.reductions!=p.reductions || q.builds!=p.builds || q.aliases!=p.aliases || q.external!=p.external || q.pos!=p.input.len){return 5;} i=0;while(i<q.global_count){if(q.globals[i]!=p.globals[i]){return 6;}i=i+1;}i=0;while(i<256){if(q.hist[i]!=p.hist[i]){return 7;}i=i+1;}
 let r26:i32=pm_lookup(&q,q.root,"base_state");let r25:i32=pm_lookup(&q,r26,"base_state");let a:i32=pm_lookup(&q,q.root,"semantic_generator");let b:i32=pm_lookup(&q,r26,"semantic_generator");let c:i32=pm_lookup(&q,r25,"semantic_generator");
 let type27:i32=n17_class_is(&q,q.root,"r27_experiments","R27State");let type26:i32=n17_class_is(&q,r26,"r26_experiments","R26State");
 let alias:i32=(a>0 && pm_kind(&q,a)==15 && a==b) as i32;let retained:i32=(b>0 && c>0 && (b==c || (classid(&q,b)>0 && pm_global_same(&q,classid(&q,b),classid(&q,c))==1))) as i32;
 emit("R27-01_SERIALIZED_EXACT_CLASS",type27,q.root,classid(&q,q.root));emit("R26-01_SERIALIZED_EXACT_CLASS",type26,r26,classid(&q,r26));emit("R27-18_SERIALIZED_MEMO_IDENTITY",alias,a,b);emit("R26-34_SERIALIZED_IDENTITY_OR_CLASS",retained,b,c);
  let extra:i32=(a!=c && pm_kind(&q,c)==15 && pm_global_same(&q,classid(&q,a),classid(&q,c))==1 && pm_global_same(&q,classid(&q,a),classid(&q,q.root))==0 && n17_class_is(&q,q.root,"wrong_module","R27State")==0 && n17_class_is(&q,q.root,"r27_experiments","WrongClass")==0 && n17_class_is(&q,0,"r27_experiments","R27State")==0) as i32;
 emit("DISTINCT_SAME_TAG_NOT_ALIAS_WRONG_MODULE_NAME_MISSING",extra,a,c);if(extra!=1){return 8;}
 let seen:i32=0;i=0;while(i<q.memo_extent){if(q.memo[i]==a){seen=seen+1;}i=i+1;}if(seen==0){return 9;}
 number(q.node_count as i64);_zag_print(",");number(q.edge_count as i64);_zag_print(",");number(q.memo_count as i64);_zag_print(",");number(q.aliases as i64);_zag_println(" FULL_SCAN_COUNTS");
 let negative:i32=
(n17_class_is(&q,q.root,"r26_experiments","R26State")==0 && n17_class_is(&q,r26,"r27_experiments","R27State")==0 && a!=q.root && classid(&q,0)==0) as i32;emit("NEGATIVE_WRONG_CLASS_DISTINCT_OBJECT",negative,a,q.root);
 _zag_println("FULL_RAW_NATIVE_RESCAN_EQUALS_IMMUTABLE_MAP_ALL_NODES_EDGES_MEMO; SERIALIZED_SCOPE_ONLY; NO_FOREIGN_RUNTIME_CLAIM");
 pm_close(&q);mi_loaded_close(&p);return (type27!=1 || type26!=1 || alias!=1 || retained!=1 || negative!=1) as i32;
}

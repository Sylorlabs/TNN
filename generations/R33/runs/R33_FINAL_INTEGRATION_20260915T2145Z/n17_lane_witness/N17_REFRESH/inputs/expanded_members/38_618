#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent));import speech_r28 as s

def precompute_costs(x,P,dur,min_d=7,max_d=32):
    N=len(x);M=len(P);C=np.full((N,max_d+1,M),1e6)
    for st in range(N):
      for dd in range(min_d,min(max_d,N-st)+1):C[st,dd]=s.cost_all(x[st:st+dd],P,dur,'multi_combined')
    return C

def align_order_cost_cached(x,ids,C,ov,min_d=7,max_d=32):
    N=len(x);states={0:0.0}
    for k,m in enumerate(ids):
        nxt={}
        for pend,base in states.items():
            st=0 if k==0 else pend-ov
            if st<0 or st>=N:continue
            for d in range(min_d,min(max_d,N-st)+1):
                en=st+d;remain=len(ids)-k-1;min_future=max(0,remain*(min_d-ov));max_future=remain*(max_d-ov)+8;rem=N-en
                if rem<min_future-ov or rem>max_future+ov:continue
                v=base+float(C[st,d,m])
                if en not in nxt or v<nxt[en]:nxt[en]=v
        if len(nxt)>80:nxt=dict(sorted(nxt.items(),key=lambda z:z[1])[:80])
        states=nxt
        if not states:return 1e9
    return min(v+.02*abs(en-N) for en,v in states.items())

def learn_overlap(seed,bases,P,dur,n=24):
    r=np.random.default_rng(seed+1700);train=[]
    for _ in range(n):
        ids=r.choice(len(bases),4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True);train.append((x,ids,precompute_costs(x,P,dur)))
    rows=[]
    for ov in range(0,9):
        vals=[align_order_cost_cached(x,ids,C,ov) for x,ids,C in train]
        rows.append({'overlap':ov,'cost':float(np.mean(vals))})
    best=min(rows,key=lambda z:z['cost'])['overlap'];return best,rows

def decode_prior(x,P,dur,count,ov,max_shift=3,min_d=7,max_d=32,pen=.035):
    N=len(x);costs={}
    for pos in range(N):
      for d in range(min_d,min(max_d,N-pos)+1):costs[(pos,d)]=s.cost_all(x[pos:pos+d],P,dur,'multi_combined')
    states={0:(0.0,[])}
    for k in range(count):
      nxt={}
      for pend,(base,seq) in states.items():
        shifts=range(0,5) if k==0 else range(-ov-max_shift,-ov+max_shift+1)
        for sh in shifts:
          st=pend+sh
          if st<0 or st>=N:continue
          for d in range(min_d,min(max_d,N-st)+1):
            cc=costs[(st,d)];j=int(np.argmin(cc));target=0 if k==0 else -ov
            v=base+float(cc[j])+pen*abs(sh-target);en=st+d
            if en not in nxt or v<nxt[en][0]:nxt[en]=(v,seq+[j])
      if len(nxt)>80:nxt=dict(sorted(nxt.items(),key=lambda z:z[1][0])[:80])
      states=nxt
      if not states:return []
    return min(states.items(),key=lambda kv:kv[1][0]+.025*abs(kv[0]-N))[1][1]

def run(seed,trials=30,train=16):
    bases={e:s.base_template(seed,e) for e in range(12)};P,d=s.learn_protos(seed+100,bases);ov,curve=learn_overlap(seed,bases,P,d,train);r=np.random.default_rng(seed+2500);a=[];ex=[]
    for _ in range(trials):
        ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True);dec=decode_prior(x,P,d,4,ov);v=sum(int(i==j) for i,j in zip(dec,ids))/4 if len(dec)==4 else 0;a.append(v);ex.append(v==1)
    return {'seed':seed,'train_connected':train,'learned_overlap':ov,'overlap_curve':curve,'accuracy':float(np.mean(a)),'exact_phrase':float(np.mean(ex))}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);ap.add_argument('--trials',type=int,default=20);ap.add_argument('--train',type=int,default=12);z=ap.parse_args();o=run(z.seed,z.trials,z.train);Path(z.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

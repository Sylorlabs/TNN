#!/usr/bin/env python3
from pathlib import Path
import subprocess
root=Path(__file__).resolve().parents[1]
cases=[
 ('r201_transition_unbinding.c','r201_transition_unbinding',[]),
 ('r213_active_factor_growth.c','r213_active_factor_growth',[]),
 ('r230_factor_drift.c','r230_factor_drift',[]),
 ('r319_grounded_relations.c','r319',[]),
 ('r330_native_speech.c','r330',[]),
 ('r380_memory_scale.c','r380',[]),
 ('r390_meta_plasticity.c','r390',[]),
 ('r410_visual_persistence.c','r410',[]),
 ('r420_real_byte_state.c','r420',['corpus/english_manual.txt']),
]
out=root/'results/fresh'; build=root/'build/fresh'
out.mkdir(parents=True,exist_ok=True); build.mkdir(parents=True,exist_ok=True)
log=[]
for src,base,args in cases:
    outputs={}
    for cc in ('gcc','clang'):
        binary=build/f'{base}_{cc}'
        compile_cmd=[cc,'-std=c11','-O2','-Wall','-Wextra','-Werror','-pedantic','-I'+str(root/'src'),str(root/'experiments'/src),'-lm','-o',str(binary)]
        subprocess.run(compile_cmd,check=True,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        cp=subprocess.run([str(binary),*args],check=True,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=240)
        outputs[cc]=cp.stdout
        out.mkdir(parents=True,exist_ok=True)
        (out/f'{base}_{cc}.csv').write_bytes(cp.stdout)
        log.append((src,cc,'PASS'))
    if outputs['gcc']!=outputs['clang']:
        raise SystemExit(f'GCC/Clang output mismatch: {src}')
    expected=(root/f'results/gcc/{base}.csv').read_bytes()
    if outputs['gcc']!=expected:
        raise SystemExit(f'fresh output differs from preserved promoted result: {src}')
with (root/'results/audit/fresh-quick.tsv').open('w') as f:
    for row in log: f.write('\t'.join(row)+'\n')
print(f'FRESH_QUICK_PROGRAMS={len(cases)}')
print('FRESH_GCC_CLANG_EXACT_PASS=1')

// Diagnostic state-transition replay, not a learner or accepted checkpoint.
// The external supervisor supplies committed generic transitions, never skills.
@import("R33_B001_COMPONENTS.zag")
@import("R33_B001_RAW_RECORD.zag")

fn c03_metric(key:[]u8,value:i32)void {
    _zag_print("M,");_zag_print(key);_zag_print(",");_zag_println(_zag_i64_to_str(value as i64));
}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}
    let input:[]u8=_zag_read_file(_zag_arg(1));
    if(input.len<16 || input.len>336){return 2;}
    if(_zag_strcmp(input[0..8],"TNNTXN01")!=1){return 2;}
    let initial:i32=rr_get32(input,8);let count:i32=rr_get32(input,12);
    if(initial<0 || count<0 || count>16 || input.len!=16+count*20){return 2;}
    let state:[]i32=zalloc_i(3);let log:[]i32=zalloc_i(80);state[0]=initial;
    let i:i32=0;let status:i32=0;
    while(i<count && status==0){
        let at:i32=16+i*20;let event:i32=rr_get32(input,at);
        let parent:i32=rr_get32(input,at+4);let before:i32=rr_get32(input,at+8);
        let after:i32=rr_get32(input,at+12);let trace:i32=rr_get32(input,at+16);
        if(event!=i+1 || parent!=i || before!=state[0] || after<0 || trace!=event){status=-1;}
        else{status=r33_commit_logged(state,log,parent,after);}
        if(status==0){
            let j:i32=0;
            while(j<5){if(log[i*5+j]!=rr_get32(input,at+j*4)){status=-1;}j=j+1;}
        }
        i=i+1;
    }
    c03_metric("status",status);c03_metric("value",state[0]);
    c03_metric("version",state[1]);c03_metric("events",state[2]);
    i=0;while(i<state[2]*5){
        _zag_print("V,log,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",");
        _zag_println(_zag_i64_to_str(log[i] as i64));i=i+1;
    }
    return 0;
}

@import("r27_native_state_image_v4.zag")

// Semantic admission for the V4 mutable R27 state image. Structural byte/layout
// validation stays in r27_native_state_image_v4.zag. This layer checks the
// cross-section relations required for one continuing process.

const R27SV4_ENTITY_MAX:i32=64;
const R27SV4_ACTION_MAX:i32=8;
const R27SV4_TRACE_MAX:i32=8192;
const R27SV4_CANONICAL_STEP:i32=60423;

// Keep executable references local so this qualification lane also remains
// usable with the last stable macOS compiler, whose imported bare-const
// lowering is known-bad. These values are the frozen V4 wire ids.
fn r27sv4_header_bytes()i32 @noalloc {return 16;}
fn r27sv4_trace_count_id()i32 @noalloc {return 29;}
fn r27sv4_development_step_id()i32 @noalloc {return 30;}
fn r27sv4_pending_credit_id()i32 @noalloc {return 32;}
fn r27sv4_newborn_restarts_id()i32 @noalloc {return 33;}

fn r27sv4_read_scalar(image:[]u8,id:i32,out:*i32)i32 @noalloc {
    if(out==null as *i32){return -1;}
    let section:[]u8=r27i4_get(image,id);if(section.len!=r27sv4_header_bytes()+4){return -1;}
    return r27s4_get_i32(section,r27sv4_header_bytes(),out);
}

fn r27sv4_read_at(image:[]u8,id:i32,index:i32,out:*i32)i32 @noalloc {
    if(out==null as *i32 || index<0 || index>=r27s4_expected_count(id)){return -1;}
    let section:[]u8=r27i4_get(image,id);if(section.len!=r27s4_section_bytes(id)){return -1;}
    return r27s4_get_i32(section,r27sv4_header_bytes()+index*4,out);
}

fn r27sv4_validate_trace(image:[]u8,trace_count:i32)i32 @noalloc {
    if(trace_count<0 || trace_count>R27SV4_TRACE_MAX){return -1;}
    // Trace bytes are preserved exactly, but the historical verifier has not
    // yet established authoritative range rules for every opaque trace field.
    return 0;
}

fn r27sv4_validate_pending(image:[]u8,trace_count:i32)i32 @noalloc {
    let pending:[]u8=r27i4_get(image,r27sv4_pending_credit_id());
    if(pending.len!=r27s4_section_bytes(r27sv4_pending_credit_id()) || r27s4_validate_pending_credit(pending)!=0){return -1;}
    let active:i32=0;let trace:i32=0;let action:i32=0;let entity:i32=0;
    if(r27s4_get_i32(pending,r27sv4_header_bytes(),&active)!=0 ||
       r27s4_get_i32(pending,r27sv4_header_bytes()+4,&trace)!=0 ||
       r27s4_get_i32(pending,r27sv4_header_bytes()+8,&action)!=0 ||
       r27s4_get_i32(pending,r27sv4_header_bytes()+12,&entity)!=0){return -1;}
    if(active==1){
        if(trace<0 || trace>=trace_count || action<0 || action>=R27SV4_ACTION_MAX){return -1;}
        if(entity < -1 || entity>=R27SV4_ENTITY_MAX){return -1;}
    }
    return 0;
}

fn r27sv4_validate(image:[]u8)i32 @noalloc {
    if(r27i4_check(image)!=0){return -1;}
    let trace_count:i32=0;let development_step:i32=0;let newborn_restarts:i32=0;
    if(r27sv4_read_scalar(image,r27sv4_trace_count_id(),&trace_count)!=0 ||
       r27sv4_read_scalar(image,r27sv4_development_step_id(),&development_step)!=0 ||
       r27sv4_read_scalar(image,r27sv4_newborn_restarts_id(),&newborn_restarts)!=0){return -1;}
    if(development_step<R27SV4_CANONICAL_STEP || newborn_restarts!=0){return -1;}
    if(r27sv4_validate_trace(image,trace_count)!=0){return -1;}
    if(r27sv4_validate_pending(image,trace_count)!=0){return -1;}
    return 0;
}

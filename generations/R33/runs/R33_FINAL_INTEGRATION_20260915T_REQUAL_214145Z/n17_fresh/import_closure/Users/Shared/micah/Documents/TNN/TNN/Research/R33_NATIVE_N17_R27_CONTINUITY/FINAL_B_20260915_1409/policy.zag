@import("../../R33_NATIVE_SHA256_V2.zag")
// Strict bounded parser for the admitted policy's ASCII string/array object.
// Unsupported JSON types/escapes refuse; only exact admitted bytes get rows.
struct BP {b:[]u8,pos:i32,status:i32,mask:i64,promotions:i32,fields:i64}
fn bp_ws(p:*BP)void {while(p.*.pos<p.*.b.len){let c:u8=p.*.b[p.*.pos];if(c!=32&&c!=9&&c!=10&&c!=13){return;}p.*.pos=p.*.pos+1;}}
fn bp_take(p:*BP,c:u8)i32 {bp_ws(p);if(p.*.pos>=p.*.b.len||p.*.b[p.*.pos]!=c){p.*.status=1;return 0;}p.*.pos=p.*.pos+1;return 1;}
fn bp_string(p:*BP)[]u8 {if(bp_take(p,34)!=1){return "";}let at:i32=p.*.pos;while(p.*.pos<p.*.b.len){let c:u8=p.*.b[p.*.pos];if(c==34){let s:[]u8=p.*.b[at..p.*.pos];p.*.pos=p.*.pos+1;return s;}if(c<32||c>=128||c==92){p.*.status=1;return "";}p.*.pos=p.*.pos+1;}p.*.status=1;return "";}
fn bp_field(s:[]u8)i32 {if(nio_equal(s,"format")==1){return 0;}if(nio_equal(s,"active_promotions")==1){return 1;}if(nio_equal(s,"retained")==1){return 2;}if(nio_equal(s,"rolled_back")==1){return 3;}if(nio_equal(s,"shadow_partial")==1){return 4;}if(nio_equal(s,"locked_gates")==1){return 5;}return -1;}
fn bp_gate(s:[]u8)i32 {if(nio_equal(s,"TEENAGER_ENGLISH")==1){return 0;}if(nio_equal(s,"ADULT_ENGLISH")==1){return 1;}if(nio_equal(s,"NATURAL_VIDEO_AUDIO")==1){return 2;}if(nio_equal(s,"HUMAN_SUPERIORITY")==1){return 3;}if(nio_equal(s,"NATIVE_ZAG")==1){return 4;}if(nio_equal(s,"OPEN_ENDED_RECURSIVE_SELF_IMPROVEMENT")==1){return 5;}if(nio_equal(s,"AHI")==1){return 6;}if(nio_equal(s,"PRODUCTION_TNN_V1")==1){return 7;}return -1;}
fn bp_parse(bytes:[]u8)BP {
 let p:BP=BP{.b=bytes,.pos=0,.status=0,.mask=0,.promotions=0,.fields=0};if(bytes.len<2||bytes.len>4096||bp_take(&p,123)!=1){p.status=1;return p;}
 let done:i32=0;while(done==0&&p.status==0){let key:[]u8=bp_string(&p);let f:i32=bp_field(key);if(f<0||(p.fields&(1<<f))!=0||bp_take(&p,58)!=1){p.status=1;break;}p.fields=p.fields|(1<<f);
 if(f==0){let value:[]u8=bp_string(&p);if(nio_equal(value,"TNN_PRE_V1_R27_POLICY")!=1){p.status=1;}}else{
 if(bp_take(&p,91)!=1){break;}bp_ws(&p);let n:i32=0;let end:i32=0;if(p.pos<p.b.len&&p.b[p.pos]==93){p.pos=p.pos+1;end=1;}
 while(end==0&&p.status==0){let v:[]u8=bp_string(&p);n=n+1;if(n>64){p.status=1;break;}if(f==5){let g:i32=bp_gate(v);if(g>=0){if((p.mask&(1<<g))!=0){p.status=1;}p.mask=p.mask|(1<<g);}}if(f==1){if(n!=1||nio_equal(v,"STRONGER_MASTER_GENERAL_SPECIFIC_BRIDGE")!=1){p.status=1;}else{p.promotions=1;}}
 bp_ws(&p);if(p.pos>=p.b.len){p.status=1;break;}let c:u8=p.b[p.pos];p.pos=p.pos+1;if(c==93){end=1;}else if(c!=44){p.status=1;}}
 }
 bp_ws(&p);if(p.pos>=p.b.len){p.status=1;break;}let c:u8=p.b[p.pos];p.pos=p.pos+1;if(c==125){done=1;}else if(c!=44){p.status=1;}
 }bp_ws(&p);if(p.pos!=p.b.len||p.fields!=63){p.status=1;}return p;
}
fn bp_selftest()i32 {
 let p:BP=bp_parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"active_promotions\":[\"STRONGER_MASTER_GENERAL_SPECIFIC_BRIDGE\"],\"retained\":[],\"rolled_back\":[],\"shadow_partial\":[],\"locked_gates\":[\"AHI\"]}");if(p.status!=0||p.mask!=64||p.promotions!=1){return 1;}
 p=bp_parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"format\":\"TNN_PRE_V1_R27_POLICY\"}");if(p.status==0){return 2;}
 p=bp_parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"active_promotions\":[],\"retained\":[],\"rolled_back\":[],\"shadow_partial\":[],\"locked_gates\":[]}");if(p.status!=0||p.mask!=0||p.promotions!=0){return 3;}
 p=bp_parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"active_promotions\":[\"STRONGER_MASTER_GENERAL_SPECIFIC_BRIDGE\",\"EXTRA\"],\"retained\":[],\"rolled_back\":[],\"shadow_partial\":[],\"locked_gates\":[]}");if(p.status==0){return 4;}
 p=bp_parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"active_promotions\":[],\"retained\":[],\"rolled_back\":[],\"shadow_partial\":[],\"locked_gates\":[\"AHI\",\"AHI\"]}");if(p.status==0){return 5;}
 p=bp_parse("{}");if(p.status==0){return 6;}p=bp_parse("{\"format\":true}");if(p.status==0){return 7;}
 _zag_println("BP_STRICT_PARSER_POSITIVE_MISSING_GATE_PROMOTION_EXTRA_DUPLICATE_MISSING_FIELDS_UNSUPPORTED_NEGATIVES_PASS");return 0;
}
fn main()i32 {
 if(_zag_argc()!=2){return 64;}let path:[]u8=_zag_arg(1);if(nio_equal(path,"selftest")==1){return bp_selftest();}
 let bytes:[]u8=_zag_read_file(path);let digest:[]u8=nio_alloc(32);if(ns_sha256(bytes,digest)!=0){return 70;}let h:[]u8=ns_hex(digest);
 if(nio_equal(h,"983db6a9c771f4952392d288459d65dfb04c33a7cbca37ac9f10a4365c7887a8")!=1){_zag_println("BP_REFUSE_EXACT_POLICY_HASH");return 71;}
 let p:BP=bp_parse(bytes);if(p.status!=0){return 72;}_zag_print("BP_NATIVE_INPUT_SHA256,");_zag_println(h);let i:i32=0;let failed:i32=0;
 while(i<8){_zag_print("B_ROW,R27-");_zag_print(_zag_i64_to_str((23+i) as i64));if((p.mask&(1<<i))!=0){_zag_println(",PASS,POLICY");}else{_zag_println(",FAIL,POLICY");failed=1;}i=i+1;}
 if(p.promotions==1){_zag_println("B_ROW,R27-31,PASS,POLICY");}else{_zag_println("B_ROW,R27-31,FAIL,POLICY");failed=1;}_zag_println("B_TERMINAL_CLAIM_ALLOWED,FALSE");return failed;
}

// N11 immutable parent-custody descriptor. No learner, authority key, callback,
// original-method reconstruction or semantic-digest recomputation lives here.
@import("mapio.zag")

fn pb_map_path()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N10_RUN_PRIMARY_V1/parent-map";}
fn pb_original_path()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_PARENT_RECOVERED_V1/parent-r27-accepted-state.pkl";}
fn pb_hex(text:[]u8)[]u8 {
    if(text.len!=64){return "";}let b:[]u8=nio_alloc(32);if(b.len!=32){return "";}
    let i:i32=0;while(i<32){let a:i64=ns_hex_digit(text[i*2] as i32);let c:i64=ns_hex_digit(text[i*2+1] as i32);
        if(a<0 || c<0){nio_free(b);return "";}b[i]=(a*16+c) as u8;i=i+1;}return b;
}
fn pb_binding()[]u8 {
    let b:[]u8=nio_alloc(128);let raw:[]u8=pb_hex("31e670fcd2a2fefc02a1d032b8016bd93c28844df8ea40889593d030a2096e5a");
    let map:[]u8=pb_hex("b7c083364e98d9e5cd674a47b0136de157fedd538b06c743f0c672652984327f");
    let historical:[]u8=pb_hex("562aaaedb5b9ceec2f50482f631992c247cbe50e9f6d2321b811e311ecf73b04");
    if(b.len!=128 || raw.len!=32 || map.len!=32 || historical.len!=32){nio_free(b);nio_free(raw);nio_free(map);nio_free(historical);return "";}
    mi_copy("R33PC001",b);mi_put(b,8,1);mi_put(b,12,0);mi_put(b,16,15871908);mi_put(b,20,60423);mi_put(b,24,0);
    mi_copy(raw,b[32..64]);mi_copy(map,b[64..96]);mi_copy(historical,b[96..128]);
    nio_free(raw);nio_free(map);nio_free(historical);return b;
}
fn pb_validate(b:[]u8)i32 {
    // Field12 is custody-only disposition0, not a caller-controlled grant or
    // a claim that field96's historical semantic digest was recomputed.
    if(b.len!=128){return -8901;}
    if(nio_equal(b[0..8],"R33PC001")!=1 || mi_get(b,8)!=1 || mi_get(b,12)!=0 || mi_get(b,28)!=0){return -8901;}
    let expected:[]u8=pb_binding();if(expected.len!=128){return -8907;}
    let code:i32=0;if(nio_equal(b,expected)!=1){code=-8902;}nio_free(expected);return code;
}
fn pb_training_admission(b:[]u8)i32 {
    let code:i32=pb_validate(b);if(code!=0){return code;}
    // This API deliberately has NO training implementation or authority path.
    // Source/digest/parity evidence and actual human grants remain unresolved.
    // Tested refusal is not complete runtime milestone enforcement.
    return -8904;
}
fn pb_failed(code:i32)ParentMap {let p:ParentMap=pm_empty();p.status=code;return p;}
fn pb_parent_identity(p:*ParentMap)i32 {
    if(p.*.status!=0 || p.*.input.len!=15871908 || p.*.protocol!=5 || pm_kind(p,p.*.root)!=15){return -8903;}
    let cls:i32=p.*.nodes[(p.*.root-1)*10+4] as i32;if(pm_kind(p,cls)!=14){return -8903;}
    if(nio_equal(pm_raw(p,p.*.nodes[(cls-1)*10+4] as i32),"r27_experiments")!=1 ||
       nio_equal(pm_raw(p,p.*.nodes[(cls-1)*10+5] as i32),"R27State")!=1){return -8903;}
    let state:i32=pm_build_state(p,p.*.root);if(pm_kind(p,state)!=11 || p.*.nodes[(state-1)*10+9]!=14){return -8903;}
    let v:i64=-1;if(pm_small_int(p,pm_lookup(p,p.*.root,"development_step"),&v)!=0 || v!=60423){return -8903;}
    v=-1;if(pm_small_int(p,pm_lookup(p,p.*.root,"newborn_restarts"),&v)!=0 || v!=0){return -8903;}
    if(nio_equal(pm_raw(p,pm_lookup(p,p.*.root,"format")),"TNN_PRE_V1_R27_GENERAL_LEARNING")!=1 ||
       pm_kind(p,pm_lookup(p,p.*.root,"affordance_model"))!=1 || pm_kind(p,pm_lookup(p,p.*.root,"speech_motif_decoder"))!=1){return -8903;}
    return 0;
}
fn pb_load(path:[]u8,binding:[]u8)ParentMap {
    let code:i32=pb_validate(binding);if(code!=0){return pb_failed(code);}
    let p:ParentMap=mi_load(path,binding[32..64],binding[64..96]);if(p.status!=0){return p;}
    code=pb_parent_identity(&p);if(code!=0){mi_loaded_close(&p);return pb_failed(code);}return p;
}

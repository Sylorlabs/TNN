@import("v91_semantic_kat.zag")
fn main()i32 {
 let a:[]i32=v91_alloc_i32(4);let b:[]u64=v91_alloc_u64(4);let c:[]u8=v91_alloc_u8(4);
 if(a.len!=4||b.len!=4||c.len!=4){return 1;}
 let a0:*i32=&a[0];let a1:*i32=&a[1];let b0:*u64=&b[0];let b1:*u64=&b[1];let c0:*u8=&c[0];let c1:*u8=&c[1];let sa:i64=(a1 as i64)-(a0 as i64);let sb:i64=(b1 as i64)-(b0 as i64);let sc:i64=(c1 as i64)-(c0 as i64);
 _zag_print("V91_LAYOUT,i32_stride=");_zag_print(_zag_i64_to_str(sa));_zag_print(",u64_stride=");_zag_print(_zag_i64_to_str(sb));_zag_print(",u8_stride=");_zag_print(_zag_i64_to_str(sc));_zag_print(",row_size=");_zag_println(_zag_i64_to_str(@sizeOf[V91Row]() as i64));
 let rows:[]i32=v91_alloc_i32(14);v91_row_set(rows,0,V91Row{.a=0,.o=1,.l=2,.bad=3,.act=4,.kind=1,.form=2});v91_row_set(rows,1,V91Row{.a=7,.o=6,.l=5,.bad=4,.act=3,.kind=2,.form=1});let r:V91Row=v91_row_get(rows,0);let s:V91Row=v91_row_get(rows,1);
 if(sa!=8||sb!=8||sc!=1||@sizeOf[V91Row]()!=56||r.a!=0||r.o!=1||r.l!=2||r.bad!=3||r.act!=4||r.kind!=1||r.form!=2||s.a!=7||s.o!=6||s.l!=5||s.bad!=4||s.act!=3||s.kind!=2||s.form!=1){return 2;}
 _zag_println("V91_LAYOUT_AND_ADJACENT_FLAT_ROWS,PASS");return 0;
}

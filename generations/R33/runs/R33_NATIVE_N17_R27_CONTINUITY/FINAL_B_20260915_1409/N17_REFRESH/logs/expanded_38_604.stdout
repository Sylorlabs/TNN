#!/usr/bin/env python3
import argparse,json,sys,time
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent)); import speech_r28 as s

def seg_cost(seg, protos, dur, motif):
    W=protos.shape[-1]; rr=s.normseg(seg,W)
    sh=np.mean((protos[motif]-rr[None,:])**2,axis=1)
    dr=np.diff(rr);dp=np.diff(protos[motif],axis=1);sh=sh+.45*np.mean((dp-dr[None,:])**2,axis=1)
    mu,sd=dur[motif]
    return float(np.min(sh)+.01*((len(seg)-mu)/sd)**2)

def align_known(x,ids,P,dur,min_d=7,max_d=32):
    N=len(x);K=len(ids);INF=1e30
    dp=np.full((K+1,N+1),INF);back={};dp[0,0]=0
    # allow short lead in on first motif
    for k,m in enumerate(ids):
        for pos in np.where(np.isfinite(dp[k]))[0]:
            for d in range(min_d,min(max_d,N-int(pos))+1):
                en=int(pos)+d
                # leave enough for rest
                rem=K-k-1
                if N-en < rem*min_d or N-en > rem*max_d+8: continue
                v=dp[k,pos]+seg_cost(x[int(pos):en],P,dur,m)
                if v<dp[k+1,en]:dp[k+1,en]=v;back[(k+1,en)]=(int(pos),m)
    ends=np.arange(N+1);valid=dp[K]+.025*np.abs(ends-N);end=int(np.argmin(valid))
    if not np.isfinite(dp[K,end]): return []
    segs=[];cur=(K,end)
    while cur[0]>0:
        st,m=back[cur];segs.append((st,cur[1],m));cur=(cur[0]-1,st)
    return segs[::-1]

def train_em(seed,bases,train_n=72,iters=4,Kp=10,W=20):
    P,dur=s.learn_protos(seed+100,bases,K=8,W=W)
    r=np.random.default_rng(seed+600)
    train=[]
    for _ in range(train_n):
        ids=r.choice(len(bases),4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True);train.append((x,ids))
    history=[]
    for it in range(iters):
        buckets=[[] for _ in bases]; ds=[[] for _ in bases]; ok=0
        for x,ids in train:
            segs=align_known(x,ids,P,dur)
            if len(segs)!=4: continue
            ok+=1
            for st,en,m in segs:
                z=x[st:en];rr=s.normseg(z,W);buckets[m].append(rr);ds[m].append(len(z))
        Pnew=[];dnew=[]
        for m in range(len(bases)):
            rows=np.stack(buckets[m]) if buckets[m] else P[m]
            # retain original isolated prototypes and add diverse connected prototypes
            rows=np.concatenate([P[m][:3],rows],axis=0)
            sel=[0]
            while len(sel)<min(Kp,len(rows)):
                c=np.mean(rows[sel],0);cand=[i for i in range(len(rows)) if i not in sel];sel.append(max(cand,key=lambda i:np.linalg.norm(rows[i]-c)))
            chosen=rows[sel]
            if len(chosen)<Kp: chosen=np.concatenate([chosen,np.repeat(chosen[-1:],Kp-len(chosen),0)],0)
            Pnew.append(chosen[:Kp]); vals=ds[m] or [dur[m,0]];dnew.append((float(np.mean(vals)),float(np.std(vals)+1)))
        P=np.stack(Pnew);dur=np.array(dnew);history.append({'iter':it,'aligned':ok})
    return P,dur,history

def eval_seed(seed,trials=40,train_n=72,iters=4):
    bases={e:s.base_template(seed,e) for e in range(12)}
    Pi,di=s.learn_protos(seed+100,bases,K=8,W=20)
    P,d,h=train_em(seed,bases,train_n,iters)
    r=np.random.default_rng(seed+5000);res={'isolated':[],'em_overlap':[],'em_beam':[]}
    for _ in range(trials):
        ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True)
        for name,dec in [
            ('isolated',s.decode_overlap(x,Pi,di,4,'multi_combined')),
            ('em_overlap',s.decode_overlap(x,P,d,4,'multi_combined')),
            ('em_beam',s.decode_beam(x,P,d,4,beam=180,top_m=3))]:
            a=sum(int(i==j) for i,j in zip(dec,ids))/4 if len(dec)==4 else 0;res[name].append(a)
    return {'seed':seed,'train_connected':train_n,'iters':iters,'history':h,'accuracy':{k:float(np.mean(v)) for k,v in res.items()},'exact_phrase':{k:float(np.mean(np.array(v)==1)) for k,v in res.items()}}

if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);ap.add_argument('--trials',type=int,default=24);ap.add_argument('--train',type=int,default=72);ap.add_argument('--iters',type=int,default=4);a=ap.parse_args();o=eval_seed(a.seed,a.trials,a.train,a.iters);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

// Native equality admission of freshly computed candidate hashes to input pins.
@import("../../../../R33_NATIVE_IO_V1.zag")
fn mf(s:[]u8,n:i32)[]u8 {let at:i32=0;let i:i32=0;let x:i32=0;while(i<=s.len){if(i==s.len||s[i]==9){if(x==n){return s[at..i];}x=x+1;at=i+1;}i=i+1;}return "";}
fn mq(s:[]u8)[]u8 {let out:[]u8="\"";let i:i32=0;while(i<s.len){let c:u8=s[i];if(c==34){out=_zag_str_concat(out,"\\\"");}else if(c==92){out=_zag_str_concat(out,"\\\\");}else if(c<32){return "null";}else{out=_zag_str_concat(out,s[i..i+1]);}i=i+1;}return _zag_str_concat(out,"\"");}
fn main()i32 {if(_zag_argc()!=4){return 64;}let targets:[]u8=_zag_read_file(_zag_arg(1));let candidates:[]u8=_zag_read_file(_zag_arg(2));if(targets.len==0||candidates.len==0){return 66;}let out:[]u8="{\"schema\":\"N17_NATIVE_INPUT_PIN_MATCH_V1\",\"targets\":[";let i:i32=0;let start:i32=0;let count:i32=0;while(i<=targets.len){if(i==targets.len||targets[i]==10){let row:[]u8=targets[start..i];if(row.len>0){let role:[]u8=mf(row,0);let hash:[]u8=mf(row,1);if(role.len==0||hash.len!=64){return 67;}if(count>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,_zag_str_concat("{\"role\":",mq(role)));out=_zag_str_concat(out,_zag_str_concat(",\"required_sha256\":",mq(hash)));out=_zag_str_concat(out,",\"matched_locations\":[");let j:i32=0;let at:i32=0;let matches:i32=0;while(j<=candidates.len){if(j==candidates.len||candidates[j]==10){let candidate:[]u8=candidates[at..j];if(candidate.len>0){if(nio_equal(mf(candidate,0),"FILE")!=1){return 68;}let h:[]u8=mf(candidate,3);if(h.len!=64){return 69;}if(nio_equal(h,hash)==1){if(matches>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,mq(mf(candidate,1)));matches=matches+1;}}at=j+1;}j=j+1;}out=_zag_str_concat(out,_zag_str_concat("],\"matches\":",_zag_i64_to_str(matches as i64)));out=_zag_str_concat(out,"}");count=count+1;}start=i+1;}i=i+1;}out=_zag_str_concat(out,"],\"scope\":\"Fresh native hash equality over selected accessible files, exact-size git blobs and recovered archive member bytes only; no global absence claim, no historical receipt or embedded-object standalone credit.\"}\n");return _zag_write_file(_zag_arg(3),out);}

// Bounded native parser for the exact hash-admitted R27 string/array policy.
// Unsupported JSON spellings refuse; this is not a general JSON/runtime service.
@import("../../../../R33_NATIVE_IO_V1.zag")
@import("../../../../R33_NATIVE_SHA256_V2.zag")
struct BP {data:[]u8,at:i32,status:i32,gates:i32,promotions:i32,promotion_ok:i32,fields:i32}
fn ws(p:*BP)void {while(p.*.at<p.*.data.len){let c:u8=p.*.data[p.*.at];if(c!=32&&c!=9&&c!=10&&c!=13){return;}p.*.at=p.*.at+1;}}
fn take(p:*BP,c:u8)i32 {ws(p);if(p.*.at>=p.*.data.len||p.*.data[p.*.at]!=c){p.*.status=1;return 0;}p.*.at=p.*.at+1;return 1;}
fn str(p:*BP)[]u8 {if(take(p,34)!=1){return p.*.data[0..0];}let start:i32=p.*.at;while(p.*.at<p.*.data.len){let c:u8=p.*.data[p.*.at];if(c==34){let end:i32=p.*.at;p.*.at=end+1;return p.*.data[start..end];}if(c<32||c==92||c>=128){p.*.status=1;return p.*.data[0..0];}p.*.at=p.*.at+1;}p.*.status=1;return p.*.data[0..0];}
fn gate(s:[]u8)i32 {if(nio_equal(s,"TEENAGER_ENGLISH")==1){return 1;}if(nio_equal(s,"ADULT_ENGLISH")==1){return 2;}if(nio_equal(s,"NATURAL_VIDEO_AUDIO")==1){return 4;}if(nio_equal(s,"HUMAN_SUPERIORITY")==1){return 8;}if(nio_equal(s,"NATIVE_ZAG")==1){return 16;}if(nio_equal(s,"OPEN_ENDED_RECURSIVE_SELF_IMPROVEMENT")==1){return 32;}if(nio_equal(s,"AHI")==1){return 64;}if(nio_equal(s,"PRODUCTION_TNN_V1")==1){return 128;}return 0;}
fn field(s:[]u8)i32 {if(nio_equal(s,"format")==1){return 1;}if(nio_equal(s,"active_promotions")==1){return 2;}if(nio_equal(s,"retained")==1){return 4;}if(nio_equal(s,"rolled_back")==1){return 8;}if(nio_equal(s,"shadow_partial")==1){return 16;}if(nio_equal(s,"locked_gates")==1){return 32;}return 0;}
fn parse(data:[]u8)BP {let p:BP=BP{.data=data,.at=0,.status=0,.gates=0,.promotions=0,.promotion_ok=1,.fields=0};if(data.len>4096||take(&p,123)!=1){p.status=1;return p;}let done:i32=0;let count:i32=0;while(done==0&&p.status==0&&count<6){let key:[]u8=str(&p);let f:i32=field(key);if(f==0||(p.fields&f)!=0||take(&p,58)!=1){p.status=1;return p;}p.fields=p.fields|f;if(f==1){let value:[]u8=str(&p);if(nio_equal(value,"TNN_PRE_V1_R27_POLICY")!=1){p.status=1;}}else{if(take(&p,91)!=1){return p;}ws(&p);let n:i32=0;if(p.at<data.len&&data[p.at]!=93){let more:i32=1;while(more==1&&p.status==0&&n<64){let value:[]u8=str(&p);if(f==32){p.gates=p.gates|gate(value);}if(f==2){p.promotions=p.promotions+1;if(nio_equal(value,"STRONGER_MASTER_GENERAL_SPECIFIC_BRIDGE")!=1){p.promotion_ok=0;}}n=n+1;ws(&p);if(p.at<data.len&&data[p.at]==44){p.at=p.at+1;}else{more=0;}}if(n>=64){p.status=1;}}if(take(&p,93)!=1){return p;}}count=count+1;ws(&p);if(p.at<data.len&&data[p.at]==44){p.at=p.at+1;}else{done=1;}}if(take(&p,125)!=1){return p;}ws(&p);if(p.at!=data.len||p.fields!=63){p.status=1;}return p;}
fn hashok(data:[]u8)i32 {let h:[]u8=nio_alloc(32);if(h.len!=32){return 0;}let rc:i32=ns_sha256(data,h);let t:[]u8=ns_hex(h);let ok:i32=(rc==0&&nio_equal(t,"983db6a9c771f4952392d288459d65dfb04c33a7cbca37ac9f10a4365c7887a8")==1) as i32;nio_free(t);nio_free(h);return ok;}
fn bp_read(path:[]u8)[]u8 {let s:[]u8=nio_cstr(path);if(s.len==0){return "";}let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(s) as i64,16777476,0,0,0,0);nio_free(s);if(fd<0){return "";}let data:[]u8=nio_alloc(4096);let n:i64=nio_read_exact(fd,data,4095);nio_close(fd);if(n<=0){nio_free(data);return "";}return data[0..n as i32];}
fn main()i32 {if(_zag_argc()!=2){return 64;}let data:[]u8=bp_read(_zag_arg(1));if(data.len==0){return 66;}if(hashok(data)!=1){_zag_println("REFUSE_SOURCE_HASH");return 71;}let p:BP=parse(data);if(p.status!=0){return 72;}let fail:i32=0;let i:i32=0;while(i<8){_zag_print("B_ROW,R27-");let s:[]u8=_zag_i64_to_str((23+i) as i64);_zag_print(s);nio_free(s);if((p.gates&(1<<i))!=0){_zag_println(",PASS,native_policy");}else{_zag_println(",FAIL,native_policy");fail=1;}i=i+1;}if(p.promotions==1&&p.promotion_ok==1){_zag_println("B_ROW,R27-31,PASS,native_policy");}else{_zag_println("B_ROW,R27-31,FAIL,native_policy");fail=1;}
// Independent parser controls are synthetic, never canonical-policy substitutes.
let bad:BP=parse("{\"format\":\"TNN_PRE_V1_R27_POLICY\",\"format\":\"TNN_PRE_V1_R27_POLICY\"}");if(bad.status==0){return 73;}let truncated:BP=parse(data[0..data.len-1]);if(truncated.status==0){return 74;}let j:i32=0;while(j<data.len&&data[j]!=84){j=j+1;}if(j>=data.len){return 75;}let original:u8=data[j];data[j]=88;if(hashok(data)!=0){return 76;}data[j]=original;if(hashok(data)!=1){return 77;}_zag_println("B_POLICY_NEGATIVE_DUPLICATE_TRUNCATED_HASH_RESTORE,PASS");_zag_println("B_TERMINAL_CLAIM_ALLOWED,FALSE");return fail;}

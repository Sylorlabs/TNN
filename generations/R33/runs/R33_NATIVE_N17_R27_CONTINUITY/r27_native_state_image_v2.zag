@import("r27_native_state_sections_v2.zag")

// Aggregate exactly 31 R27 learner-state sections into one checkpoint payload.
// The outer continuing-life checkpoint can therefore retain its small section
// table while treating the learner image atomically with world/ingress state.

const R27I_MAGIC:i32=1228354130; // provisional numeric tag,
// validated internally
const R27I_VERSION:i32=2;
const R27I_SECTION_COUNT:i32=32;
const R27I_HEADER_BYTES:i32=16;
const R27I_DIR_ENTRY_BYTES:i32=12;
const R27I_PAYLOAD_START:i32=R27I_HEADER_BYTES+R27I_SECTION_COUNT*R27I_DIR_ENTRY_BYTES;

fn r27i_expected_bytes()i32 @noalloc {
    let total:i32=R27I_PAYLOAD_START;let id:i32=1;
    while(id<=R27I_SECTION_COUNT){let n:i32=r27s_section_bytes(id);if(n<0){return -1;}total=total+n;id=id+1;}
    return total;
}

fn r27i_begin(out:[]u8,count:*i32,next:*i32)i32 @noalloc {
    if(count==null as *i32 || next==null as *i32 || out.len!=r27i_expected_bytes()){return -1;}
    let i:i32=0;while(i<out.len){out[i]=0;i=i+1;}
    if(r27s_put_i32(out,0,R27I_MAGIC)!=0 || r27s_put_i32(out,4,R27I_VERSION)!=0 ||
       r27s_put_i32(out,8,0)!=0 || r27s_put_i32(out,12,0)!=0){return -1;}
    count.*=0;next.*=R27I_PAYLOAD_START;return 0;
}

fn r27i_add(out:[]u8,count:*i32,next:*i32,id:i32,section:[]u8)i32 @noalloc {
    if(count==null as *i32 || next==null as *i32 || count.*<0 || count.*>=R27I_SECTION_COUNT){return -1;}
    let expected_id:i32=count.*+1;if(id!=expected_id){return -1;}
    let expected_len:i32=r27s_section_bytes(id);if(expected_len<0 || section.len!=expected_len){return -1;}
    let smagic:i32=0;let sversion:i32=0;let sid:i32=0;let scount:i32=0;
    if(r27s_get_i32(section,0,&smagic)!=0 || r27s_get_i32(section,4,&sversion)!=0 ||
       r27s_get_i32(section,8,&sid)!=0 || r27s_get_i32(section,12,&scount)!=0){return -1;}
    if(smagic!=R27S_MAGIC || sversion!=R27S_VERSION || sid!=id || scount!=r27s_expected_count(id)){return -1;}
    if(next.*<R27I_PAYLOAD_START || next.*>out.len-section.len){return -1;}
    let dir:i32=R27I_HEADER_BYTES+count.*R27I_DIR_ENTRY_BYTES;
    if(r27s_put_i32(out,dir,id)!=0 || r27s_put_i32(out,dir+4,next.*)!=0 || r27s_put_i32(out,dir+8,section.len)!=0){return -1;}
    let i:i32=0;while(i<section.len){out[next.*+i]=section[i];i=i+1;}
    next.*=next.*+section.len;count.*=count.*+1;return 0;
}

fn r27i_finish(out:[]u8,count:i32,next:i32)i32 @noalloc {
    if(count!=R27I_SECTION_COUNT || next!=out.len || out.len!=r27i_expected_bytes()){return -1;}
    if(r27s_put_i32(out,8,count)!=0 || r27s_put_i32(out,12,out.len)!=0){return -1;}return 0;
}

fn r27i_check(image:[]u8)i32 @noalloc {
    if(image.len!=r27i_expected_bytes()){return -1;}
    let magic:i32=0;let version:i32=0;let count:i32=0;let total:i32=0;
    if(r27s_get_i32(image,0,&magic)!=0 || r27s_get_i32(image,4,&version)!=0 ||
       r27s_get_i32(image,8,&count)!=0 || r27s_get_i32(image,12,&total)!=0){return -1;}
    if(magic!=R27I_MAGIC || version!=R27I_VERSION || count!=R27I_SECTION_COUNT || total!=image.len){return -1;}
    let expected_offset:i32=R27I_PAYLOAD_START;let id:i32=1;
    while(id<=R27I_SECTION_COUNT){
        let dir:i32=R27I_HEADER_BYTES+(id-1)*R27I_DIR_ENTRY_BYTES;
        let got_id:i32=0;let offset:i32=0;let length:i32=0;
        if(r27s_get_i32(image,dir,&got_id)!=0 || r27s_get_i32(image,dir+4,&offset)!=0 || r27s_get_i32(image,dir+8,&length)!=0){return -1;}
        if(got_id!=id || offset!=expected_offset || length!=r27s_section_bytes(id) || offset<0 || offset>image.len-length){return -1;}
        let smagic:i32=0;let sversion:i32=0;let sid:i32=0;let scount:i32=0;
        if(r27s_get_i32(image,offset,&smagic)!=0 || r27s_get_i32(image,offset+4,&sversion)!=0 ||
           r27s_get_i32(image,offset+8,&sid)!=0 || r27s_get_i32(image,offset+12,&scount)!=0){return -1;}
        if(smagic!=R27S_MAGIC || sversion!=R27S_VERSION || sid!=id || scount!=r27s_expected_count(id)){return -1;}
        if(r27s_expected_count(id)==1 && r27s_validate_scalar_section(image[offset..offset+length],id)!=0){return -1;}
        if(id==R27S_PENDING_CREDIT && r27s_validate_pending_credit(image[offset..offset+length])!=0){return -1;}
        expected_offset=expected_offset+length;id=id+1;
    }
    if(expected_offset!=image.len){return -1;}return 0;
}

fn r27i_get(image:[]u8,id:i32)[]u8 @noalloc {
    if(id<1 || id>R27I_SECTION_COUNT || r27i_check(image)!=0){return "";}
    let dir:i32=R27I_HEADER_BYTES+(id-1)*R27I_DIR_ENTRY_BYTES;let offset:i32=0;let length:i32=0;
    if(r27s_get_i32(image,dir+4,&offset)!=0 || r27s_get_i32(image,dir+8,&length)!=0){return "";}
    return image[offset..offset+length];
}

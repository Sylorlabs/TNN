@import("r25_release_identity_v1.zag")
@import("r25_digest_component_schema_v1.zag")

// R33-N17 exact R25 NumPy digest-payload association V1.
// The whole accepted parent must match the recovered R25 SHA-256 before any
// fixed offset is interpreted. No pickle constructor, reducer, Python, NumPy,
// Torch, sklearn, learner, evaluator or promotion path executes here.
const R25NM1_OK:i32=0;
const R25NM1_IDENTITY:i32=-25301;
const R25NM1_LAYOUT:i32=-25302;
const R25NM1_OUTPUT:i32=-25303;
const R25NM1_SCHEMA:i32=-25304;
const R25NM1_CHUNK_HASH:i32=-25305;

const R25NM1_FOUNDATION_FIELD:i32=7029151;
const R25NM1_FOUNDATION_OPCODE:i32=7029268;
const R25NM1_FOUNDATION_PAYLOAD:i32=7029277;
const R25NM1_FOUNDATION_BYTES:i32=245760;

const R25NM1_COMPOSITION_FIELD:i32=12109885;
const R25NM1_COMPOSITION_OPCODE:i32=12109965;
const R25NM1_COMPOSITION_PAYLOAD:i32=12109974;
const R25NM1_COMPOSITION_BYTES:i32=245760;
const R25NM1_GATE_FIELD:i32=12355795;
const R25NM1_GATE_OPCODE:i32=12355803;
const R25NM1_GATE_PAYLOAD:i32=12355812;
const R25NM1_GATE_BYTES:i32=2560;

const R25NM1_RELATION_FIELD:i32=12358414;
const R25NM1_RELATION_OPCODE:i32=12358479;
const R25NM1_RELATION_PAYLOAD:i32=12358488;
const R25NM1_RELATION_BYTES:i32=262144;
const R25NM1_TARGETS_FIELD:i32=12620662;
const R25NM1_TARGETS_OPCODE:i32=12620673;
const R25NM1_TARGETS_PAYLOAD:i32=12620682;
const R25NM1_TARGETS_BYTES:i32=1536;

fn r25nm1_at(b:[]u8,at:i32,s:[]u8)i32 @noalloc {
    if(at<0 || s.len<1 || at>b.len-s.len){return 0;}
    let i:i32=0;while(i<s.len){if(b[at+i]!=s[i]){return 0;}i=i+1;}return 1;
}

fn r25nm1_bytearray8_at(b:[]u8,opcode_at:i32,payload_at:i32,n:i32)i32 @noalloc {
    if(n<0 || opcode_at<0 || payload_at!=opcode_at+9 || opcode_at>b.len-9 || payload_at>b.len-n){return 0;}
    if(b[opcode_at]!=150){return 0;}
    if(b[opcode_at+1]!=((n)&255) as u8 || b[opcode_at+2]!=((n>>8)&255) as u8 ||
       b[opcode_at+3]!=((n>>16)&255) as u8 || b[opcode_at+4]!=((n>>24)&255) as u8){return 0;}
    let i:i32=5;while(i<=8){if(b[opcode_at+i]!=0){return 0;}i=i+1;}return 1;
}

fn r25nm1_build_chunk(parent:[]u8,payload_at:i32,n:i32,header:[]u8,out:[]u8)i32 @noalloc {
    if(payload_at<0 || n<0 || payload_at>parent.len-n || out.len!=header.len+n){return R25NM1_OUTPUT;}
    let i:i32=0;while(i<header.len){out[i]=header[i];i=i+1;}
    i=0;while(i<n){out[header.len+i]=parent[payload_at+i];i=i+1;}return R25NM1_OK;
}

fn r25nm1_layout_ok(parent:[]u8)i32 @noalloc {
    if(parent.len!=R25RI_STATE_BYTES){return 0;}
    if(r25nm1_at(parent,R25NM1_FOUNDATION_FIELD,"foundational_learner")!=1 ||
       r25nm1_at(parent,R25NM1_COMPOSITION_FIELD,"composition_system")!=1 ||
       r25nm1_at(parent,R25NM1_GATE_FIELD,"gate")!=1 ||
       r25nm1_at(parent,R25NM1_RELATION_FIELD,"relational_language")!=1 ||
       r25nm1_at(parent,R25NM1_TARGETS_FIELD,"targets")!=1){return 0;}
    if(r25nm1_bytearray8_at(parent,R25NM1_FOUNDATION_OPCODE,R25NM1_FOUNDATION_PAYLOAD,R25NM1_FOUNDATION_BYTES)!=1 ||
       r25nm1_bytearray8_at(parent,R25NM1_COMPOSITION_OPCODE,R25NM1_COMPOSITION_PAYLOAD,R25NM1_COMPOSITION_BYTES)!=1 ||
       r25nm1_bytearray8_at(parent,R25NM1_GATE_OPCODE,R25NM1_GATE_PAYLOAD,R25NM1_GATE_BYTES)!=1 ||
       r25nm1_bytearray8_at(parent,R25NM1_RELATION_OPCODE,R25NM1_RELATION_PAYLOAD,R25NM1_RELATION_BYTES)!=1 ||
       r25nm1_bytearray8_at(parent,R25NM1_TARGETS_OPCODE,R25NM1_TARGETS_PAYLOAD,R25NM1_TARGETS_BYTES)!=1){return 0;}
    return 1;
}

fn r25nm1_extract(parent:[]u8,foundation:[]u8,composition:[]u8,gate:[]u8,relation:[]u8,targets:[]u8)i32 {
    if(parent.len!=R25RI_STATE_BYTES ||
       r27ma2_hash_matches(parent,"6d0b14d8ab4a081b57c3762800475f8ecb67d2d7e9134a82e6f7690efc4e2957")!=1){return R25NM1_IDENTITY;}
    if(r25nm1_layout_ok(parent)!=1){return R25NM1_LAYOUT;}
    if(r25nm1_build_chunk(parent,R25NM1_FOUNDATION_PAYLOAD,R25NM1_FOUNDATION_BYTES,"foundation_W(96, 640)float32",foundation)!=0 ||
       r25nm1_build_chunk(parent,R25NM1_COMPOSITION_PAYLOAD,R25NM1_COMPOSITION_BYTES,"composition_W(96, 640)float32",composition)!=0 ||
       r25nm1_build_chunk(parent,R25NM1_GATE_PAYLOAD,R25NM1_GATE_BYTES,"composition_gate(640,)float32",gate)!=0 ||
       r25nm1_build_chunk(parent,R25NM1_RELATION_PAYLOAD,R25NM1_RELATION_BYTES,"relation_W(64, 1024)float32",relation)!=0 ||
       r25nm1_build_chunk(parent,R25NM1_TARGETS_PAYLOAD,R25NM1_TARGETS_BYTES,"relation_targets(6, 64)float32",targets)!=0){return R25NM1_OUTPUT;}
    if(r25cs1_numpy_chunks(foundation,composition,gate,relation,targets)!=R25CS1_OK){return R25NM1_SCHEMA;}
    if(r27ma2_hash_matches(foundation,"5b16277b5e431d481d4d442dffa997d7104e7bf6603b4f46011908665a0508f5")!=1 ||
       r27ma2_hash_matches(composition,"2c57d7c289b71e8b904957bc8265674bcae7803721a2799c6c8d0a8ded127aa8")!=1 ||
       r27ma2_hash_matches(gate,"922f28944a9b8c1900737ed7f7fa36ea503d31bc204dc888f8e376f1d3665f55")!=1 ||
       r27ma2_hash_matches(relation,"fc542fc28814eeeb5dc6d09d48ec992b5cd07cd44d1556ac53b48ccfad12938b")!=1 ||
       r27ma2_hash_matches(targets,"a66c52c00cf756181731e0aebea5f4de7ddf6984ddb805e829adfea598417e29")!=1){return R25NM1_CHUNK_HASH;}
    return R25NM1_OK;
}

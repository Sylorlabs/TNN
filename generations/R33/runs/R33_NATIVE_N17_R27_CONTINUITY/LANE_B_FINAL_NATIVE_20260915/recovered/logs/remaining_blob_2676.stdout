        while(key_index<3){
            let control_key:i32=(0*3+key_index)*E47_VAL_FIELDS;
            let model_key:i32=(model_index*3+key_index)*E47_VAL_FIELDS;
            if(key_aggregate[control_key]<=0 || key_aggregate[model_key]!=key_aggregate[control_key] || key_aggregate[model_key+1]<key_aggregate[control_key+1] || key_aggregate[model_key+3]>key_aggregate[control_key+3]){
                key_noninferiority=0;
            }
            key_index=key_index+1;
        }
        let control_terminal_known:i32=(0*4+0)*E47_VAL_FIELDS;
        let model_terminal_known:i32=(model_index*4+0)*E47_VAL_FIELDS;
        let terminal_known_noninferiority:i32=0;
        if(terminal_aggregate[control_terminal_known]>0 && terminal_aggregate[model_terminal_known]==terminal_aggregate[control_terminal_known] && terminal_aggregate[model_terminal_known+1]>=terminal_aggregate[control_terminal_known+1] && terminal_aggregate[model_terminal_known+3]<=terminal_aggregate[control_terminal_known+3]){
            terminal_known_noninferiority=1;
        }
        let terminal_key_noninferiority:i32=1;
        let terminal_group:i32=1;
        while(terminal_group<4){
            let control_terminal_key:i32=(0*4+terminal_group)*E47_VAL_FIELDS;
            let model_terminal_key:i32=(model_index*4+terminal_group)*E47_VAL_FIELDS;
            if(terminal_aggregate[control_terminal_key]<=0 || terminal_aggregate[model_terminal_key]!=terminal_aggregate[control_terminal_key] || terminal_aggregate[model_terminal_key+1]<terminal_aggregate[control_terminal_key+1] || terminal_aggregate[model_terminal_key+3]>terminal_aggregate[control_terminal_key+3]){
                terminal_key_noninferiority=0;
            }
            terminal_group=terminal_group+1;
        }

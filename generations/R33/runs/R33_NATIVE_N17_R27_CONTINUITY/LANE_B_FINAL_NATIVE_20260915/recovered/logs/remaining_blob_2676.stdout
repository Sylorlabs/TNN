                                model_terminal_success=model_terminal_success+validation_metrics[model_base+1];
                                model_terminal_wrong=model_terminal_wrong+validation_metrics[model_base+3];
                            }
                            if(mode>=3 && mode<=5){
                                let key_index:i32=mode-3;
                                let field:i32=0;
                                while(field<E47_VAL_FIELDS){
                                    seed_key[(0*3+key_index)*E47_VAL_FIELDS+field]=seed_key[(0*3+key_index)*E47_VAL_FIELDS+field]+validation_metrics[control_base+field];
                                    seed_key[(1*3+key_index)*E47_VAL_FIELDS+field]=seed_key[(1*3+key_index)*E47_VAL_FIELDS+field]+validation_metrics[model_base+field];
                                    if(t==E45_TAPE){
                                        seed_terminal_key[(0*3+key_index)*E47_VAL_FIELDS+field]=seed_terminal_key[(0*3+key_index)*E47_VAL_FIELDS+field]+validation_metrics[control_base+field];
                                        seed_terminal_key[(1*3+key_index)*E47_VAL_FIELDS+field]=seed_terminal_key[(1*3+key_index)*E47_VAL_FIELDS+field]+validation_metrics[model_base+field];
                                    }
                                    field=field+1;

    _zag_println("e47_model_gate_columns,model,no_unique_every_t_gate,strict_unknown_improvement,known_aggregate_noninferiority,key_aggregate_noninferiority,terminal_t16_known_noninferiority,terminal_t16_key_noninferiority,joint_seed_count,known_gate,complete_gate");
    model_index=1;
    while(model_index<E47_MODELS){
        let control_no_unique:i32=(0*2+0)*E47_VAL_FIELDS;
        let model_no_unique:i32=(model_index*2+0)*E47_VAL_FIELDS;
        let control_known:i32=(0*2+1)*E47_VAL_FIELDS;
        let model_known:i32=(model_index*2+1)*E47_VAL_FIELDS;
        let known_noninferiority:i32=0;
        if(aggregate[model_known]==aggregate[control_known] && aggregate[control_known]>0 && aggregate[model_known+1]>=aggregate[control_known+1] && aggregate[model_known+3]<=aggregate[control_known+3]){
            known_noninferiority=1;
        }
        let key_noninferiority:i32=1;

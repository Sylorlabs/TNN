    e49_build_batch_statistics(canonical_records,1,1,batch_joint_reverse_gram,batch_joint_reverse_cross,&batch_reverse_count1,&batch_reverse_hash1);
    let batch_statistics_gate:i32=1;
    if(batch_forward_count0!=E49_TERMINAL_SAMPLES || batch_reverse_count0!=E49_TERMINAL_SAMPLES || batch_forward_count1!=E49_TERMINAL_SAMPLES || batch_reverse_count1!=E49_TERMINAL_SAMPLES){ batch_statistics_gate=0; }
    if(e49_batch_statistics_equal(batch_baseline_forward_gram,batch_baseline_reverse_gram,batch_baseline_forward_cross,batch_baseline_reverse_cross)==0){ batch_statistics_gate=0; }
    if(e49_batch_statistics_equal(batch_joint_forward_gram,batch_joint_reverse_gram,batch_joint_forward_cross,batch_joint_reverse_cross)==0){ batch_statistics_gate=0; }
    if(batch_forward_hash0!=batch_reverse_hash0 || batch_forward_hash1!=batch_reverse_hash1){ batch_statistics_gate=0; }
    e45_print_pair("e49_batch_statistics_gate",batch_statistics_gate); e45_print_pair("e49_batch_joint_control_stats_hash_forward",batch_forward_hash0); e45_print_pair("e49_batch_joint_control_stats_hash_reverse",batch_reverse_hash0); e45_print_pair("e49_batch_quadratic_stats_hash_forward",batch_forward_hash1); e45_print_pair("e49_batch_quadratic_stats_hash_reverse",batch_reverse_hash1);
    e49_batch_fit(canonical_records,0,0,batch_baseline_forward_gram,batch_baseline_forward_cross,terminal_weights,terminal_biases,batch_backup_weights,batch_backup_biases,&batch_forward_steps[0],&batch_forward_reason[0],&batch_forward_trace[0],&batch_forward_loss_low[0],&batch_forward_loss_high[0]);
    e49_batch_fit(canonical_records,1,1,batch_joint_forward_gram,batch_joint_forward_cross,terminal_weights,terminal_biases,batch_backup_weights,batch_backup_biases,&batch_forward_steps[1],&batch_forward_reason[1],&batch_forward_trace[1],&batch_forward_loss_low[1],&batch_forward_loss_high[1]);
    let local_model:i32=0;
    while(local_model<E49_BATCH_MODELS){
        let model_index:i32=local_model; let action:i32=0;
        while(action<4){
            batch_forward_biases[local_model*4+action]=terminal_biases[model_index*4+action];
            let feature:i32=0; while(feature<E45_FEATURES){ batch_forward_weights[(local_model*4+action)*E45_FEATURES+feature]=terminal_weights[(model_index*4+action)*E45_FEATURES+feature]; feature=feature+1; }
            action=action+1;
        }
        local_model=local_model+1;
    }
    i=0; while(i<E49_MODELS*4*E45_FEATURES){ terminal_weights[i]=0; i=i+1; }
    i=0; while(i<E49_MODELS*4){ terminal_biases[i]=0; i=i+1; }
    e49_batch_fit(canonical_records,0,0,batch_baseline_reverse_gram,batch_baseline_reverse_cross,terminal_weights,terminal_biases,batch_backup_weights,batch_backup_biases,&batch_reverse_steps[0],&batch_reverse_reason[0],&batch_reverse_trace[0],&batch_reverse_loss_low[0],&batch_reverse_loss_high[0]);
    e49_batch_fit(canonical_records,1,1,batch_joint_reverse_gram,batch_joint_reverse_cross,terminal_weights,terminal_biases,batch_backup_weights,batch_backup_biases,&batch_reverse_steps[1],&batch_reverse_reason[1],&batch_reverse_trace[1],&batch_reverse_loss_low[1],&batch_reverse_loss_high[1]);
    let batch_identity_gate:i32=e49_compare_batch_parameters(terminal_weights,terminal_biases,batch_forward_weights,batch_forward_biases);
    let batch_converge_gate:i32=1; local_model=0;
    while(local_model<E49_BATCH_MODELS){
        if(batch_forward_steps[local_model]<=0 || batch_reverse_steps[local_model]!=batch_forward_steps[local_model] || batch_reverse_reason[local_model]!=batch_forward_reason[local_model] || batch_forward_reason[local_model]==3 || batch_forward_trace[local_model]!=batch_reverse_trace[local_model] || batch_forward_loss_low[local_model]!=batch_reverse_loss_low[local_model] || batch_forward_loss_high[local_model]!=batch_reverse_loss_high[local_model]){ batch_converge_gate=0; }
        _zag_print("e49_batch_fit,"); e45_print_i32(local_model); _zag_print(","); e45_print_i32(batch_forward_steps[local_model]); _zag_print(","); e45_print_i32(batch_forward_reason[local_model]); _zag_print(","); e45_print_i32(batch_forward_trace[local_model]); _zag_print(","); e45_print_i32(batch_forward_loss_high[local_model]); _zag_print(","); e45_print_i32(batch_forward_loss_low[local_model]); _zag_print(","); e45_print_i32(batch_reverse_steps[local_model]); _zag_print(","); e45_print_i32(batch_reverse_reason[local_model]); _zag_print(","); e45_print_i32(batch_reverse_trace[local_model]); _zag_print(","); e45_print_i32(batch_reverse_loss_high[local_model]); _zag_print(","); e45_print_i32(batch_reverse_loss_low[local_model]); _zag_println("");
        local_model=local_model+1;
    }
    e45_print_pair("e49_batch_forward_reverse_identity_gate",batch_identity_gate); e45_print_pair("e49_batch_convergence_gate",batch_converge_gate);
    let aux_frozen_hash:i32=e46_aux_hash(frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,frozen_shadow,frozen_shadow_bias,frozen_global_ratio);
    let aux_frozen_gate:i32=0; if(aux_frozen_hash==frozen_aux_hash){ aux_frozen_gate=1; } e45_print_pair("e49_aux_frozen_gate",aux_frozen_gate);

    let validation_lattice_mismatch:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<E49_VALIDATION_PER_CELL){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e49_validate_episode(validation_seeds[index],base_index,mode,resource,frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,frozen_shadow,frozen_shadow_bias,terminal_weights,terminal_biases,validation_metrics,score_sums,validation_rep_stats,validation_rep_global,&validation_lattice_mismatch);
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    let validation_lattice_gate:i32=0; if(validation_lattice_mismatch==0){ validation_lattice_gate=1; }
    let validation_rep_gate:i32=e47_rep_structural_gate(validation_rep_global);
    let validation_partition_gate:i32=e49_reduce_validation(validation_metrics,aggregate,key_aggregate,terminal_aggregate,no_unique_cell_gates);
    e49_compute_model_gates(validation_metrics,aggregate,key_aggregate,terminal_aggregate,no_unique_cell_gates,known_gates,pure_known_gates,model_gates,joint_seed_counts,seed_key,seed_terminal_key);
    e45_print_pair("e49_validation_feature_lattice_mismatches",validation_lattice_mismatch); e45_print_pair("e49_validation_feature_lattice_gate",validation_lattice_gate); e45_print_pair("e49_validation_representation_structural_gate",validation_rep_gate); e45_print_pair("e49_validation_partition_gate",validation_partition_gate);
    _zag_println("e49_terminal_bias_columns,model,action,bias"); i=0; while(i<E49_MODELS){ let action:i32=0; while(action<4){ _zag_print("e49_terminal_bias,"); e45_print_i32(i); _zag_print(","); e45_print_i32(action); _zag_print(","); e45_print_i32(terminal_biases[i*4+action]); _zag_println(""); action=action+1; } i=i+1; }
    _zag_println("e49_terminal_weight_columns,model,action,feature,weight"); i=0; while(i<E49_MODELS){ let action:i32=0; while(action<4){ let feature:i32=0; while(feature<E45_FEATURES){ _zag_print("e49_terminal_weight,"); e45_print_i32(i); _zag_print(","); e45_print_i32(action); _zag_print(","); e45_print_i32(feature); _zag_print(","); e45_print_i32(terminal_weights[(i*4+action)*E45_FEATURES+feature]); _zag_println(""); feature=feature+1; } action=action+1; } i=i+1; }
    _zag_println("e49_contrast_columns,label,delta_no_unique_unknown,delta_no_unique_wrong,delta_known_success,delta_known_wrong");
    let contrast:i32=1;
    while(contrast<E49_MODELS){
        let no_unique_a:i32=((contrast)*2+0)*E49_VAL_FIELDS; let known_a:i32=((contrast)*2+1)*E49_VAL_FIELDS; let no_unique_0:i32=(0*2+0)*E49_VAL_FIELDS; let known_0:i32=(0*2+1)*E49_VAL_FIELDS;
        _zag_print("e49_contrast,"); e45_print_i32(contrast); _zag_print(","); e45_print_i32(aggregate[no_unique_a+2]-aggregate[no_unique_0+2]); _zag_print(","); e45_print_i32(aggregate[no_unique_a+3]-aggregate[no_unique_0+3]); _zag_print(","); e45_print_i32(aggregate[known_a+1]-aggregate[known_0+1]); _zag_print(","); e45_print_i32(aggregate[known_a+3]-aggregate[known_0+3]); _zag_println(""); contrast=contrast+1;
    }
    let unknown_target_gate:i32=0; if(unknown_target_nonzero==0){ unknown_target_gate=1; }
    let integrity_gate:i32=0;
    let quadratic_structural_gate:i32=0; if(quadratic_interior_records>0){ quadratic_structural_gate=1; }
    if(seed_preflight_gate+aux_clone_gate+aux_frozen_gate+batch_bound_gate+unknown_target_gate+quadratic_structural_gate+train_lattice_gate+train_rep_gate+online_count_gate+online_order_gate+batch_statistics_gate+batch_identity_gate+batch_converge_gate+validation_lattice_gate+validation_rep_gate+validation_partition_gate==16){ integrity_gate=1; }
    let baseline_safety_gate:i32=no_unique_cell_gates[0];
    let e49_gate:i32=0; if(integrity_gate==1 && baseline_safety_gate==0 && model_gates[1]==1){ e49_gate=1; }
    e45_print_pair("e49_integrity_gate",integrity_gate); e45_print_pair("e49_baseline_safety_gate",baseline_safety_gate); e45_print_pair("e49_sealed_confirmation_executed",0);
    if(integrity_gate==0){
        _zag_println("e49_outcome,INTEGRITY_FAILURE");
    }else{
        if(baseline_safety_gate==1){
            _zag_println("e49_outcome,BASELINE_SPLIT_AMBIGUOUS");
        }else{
            if(model_gates[1]==1){
                _zag_println("e49_outcome,QUADRATIC_COMMIT_VALUE_RESCUE");
            }else{
                if(no_unique_cell_gates[1]==1){
                    if(pure_known_gates[1]==0){ _zag_println("e49_outcome,QUADRATIC_SAFETY_KNOWN_TRADEOFF");
                    }else{ _zag_println("e49_outcome,QUADRATIC_SAFETY_GATE_MISS"); }
                }else{
                    _zag_println("e49_outcome,NO_TESTED_GROUNDED_QUADRATIC_RESCUE");
                }
            }
        }
    }
    if(e49_gate==1){ _zag_println("TNN_R32_E49_GROUNDED_QUADRATIC_COMMIT_VALUE_DISCRIMINATOR_GATE=PASS"); }else{ _zag_println("TNN_R32_E49_GROUNDED_QUADRATIC_COMMIT_VALUE_DISCRIMINATOR_GATE=FAIL"); }
    if(e49_gate==1){ return 0; }
    return 1;
}

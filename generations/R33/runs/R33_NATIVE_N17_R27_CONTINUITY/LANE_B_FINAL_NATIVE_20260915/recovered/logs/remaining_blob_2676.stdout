        e45_print_i32(known_noninferiority);
        _zag_print(",");
        e45_print_i32(key_noninferiority);
        _zag_print(",");
        e45_print_i32(terminal_known_noninferiority);
        _zag_print(",");
        e45_print_i32(terminal_key_noninferiority);
        _zag_print(",");
        e45_print_i32(joint_seed_counts[model_index]);
        _zag_print(",");
        e45_print_i32(known_gate);
        _zag_print(",");
        e45_print_i32(model_gates[model_index]);
        _zag_println("");
        model_index=model_index+1;
    }
    let aux_frozen_gate:i32=1;
    let common_aux_hash_after:i32=e46_aux_hash(
        common_source,common_dependence,common_consequence,common_hazard,
        common_shadow,common_shadow_bias,common_global_ratio
    );
    let frozen_aux_hash_after:i32=e46_aux_hash(
        frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,
        frozen_shadow,frozen_shadow_bias,frozen_global_ratio
    );
    if(common_aux_hash_after!=common_aux_hash || frozen_aux_hash_after!=frozen_aux_hash || common_aux_hash_after!=frozen_aux_hash_after){
        aux_frozen_gate=0;
    }
    if(common_shadow_bias!=frozen_shadow_bias || common_global_ratio!=frozen_global_ratio){
        aux_frozen_gate=0;
    }
    i=0;
    while(i<E45_SOURCES){
        if(common_source[i]!=frozen_source[i] || common_dependence[i]!=frozen_dependence[i]){
            aux_frozen_gate=0;
        }
        i=i+1;
    }
    i=0;
    while(i<2){
        if(common_consequence[i]!=frozen_consequence[i]){
            aux_frozen_gate=0;
        }
        i=i+1;
    }
    i=0;
    while(i<3*E45_HORIZONS){
        if(common_hazard[i]!=frozen_hazard[i]){
            aux_frozen_gate=0;
        }
        i=i+1;
    }
    i=0;
    while(i<E45_SHADOW_FEATURES){
        if(common_shadow[i]!=frozen_shadow[i]){
            aux_frozen_gate=0;
        }
        i=i+1;
    }
    e45_print_pair("e47_common_aux_snapshot_hash_after",common_aux_hash_after);
    e45_print_pair("e47_frozen_aux_snapshot_hash_after",frozen_aux_hash_after);
    e45_print_pair("e47_aux_frozen_during_terminal_and_validation_gate",aux_frozen_gate);
    let baseline_safety_gate:i32=0;
    if(validation_partition_gate==1 && no_unique_cell_gates[0]==1){
        baseline_safety_gate=1;
    }
    let single_feature_rescue_count:i32=0;
    if(model_gates[1]==1){
        single_feature_rescue_count=single_feature_rescue_count+1;
    }
    if(model_gates[2]==1){
        single_feature_rescue_count=single_feature_rescue_count+1;
    }
    let single_feature_rescue_diagnostic:i32=0;
    if(baseline_safety_gate==0 && single_feature_rescue_count>0){
        single_feature_rescue_diagnostic=1;
    }
    let inconclusive_interaction_diagnostic:i32=0;
    if(baseline_safety_gate==0 && single_feature_rescue_diagnostic==1 && model_gates[3]==0){
        inconclusive_interaction_diagnostic=1;
    }
    e45_print_pair("e47_baseline_no_unique_cell_gate",no_unique_cell_gates[0]);
    e45_print_pair("e47_baseline_safety_gate",baseline_safety_gate);
    e45_print_pair("e47_model_1_complete_gate",model_gates[1]);
    e45_print_pair("e47_model_2_complete_gate",model_gates[2]);
    e45_print_pair("e47_model_3_complete_gate",model_gates[3]);
    e45_print_pair("e47_model_3_known_noninferiority_gate",known_gates[3]);
    e45_print_pair("e47_single_feature_rescue_count",single_feature_rescue_count);
    if(single_feature_rescue_diagnostic==1){
        _zag_println("e47_single_feature_diagnostic,SINGLE_FEATURE_RESCUE");
    }else{
        _zag_println("e47_single_feature_diagnostic,NONE");
    }
    if(inconclusive_interaction_diagnostic==1){
        _zag_println("e47_interaction_diagnostic,INCONCLUSIVE_REPRESENTATION_INTERACTION");
    }else{
        _zag_println("e47_interaction_diagnostic,NONE");
    }
    e45_print_pair("e47_validation_partition_denominator_gate",validation_partition_gate);
    _zag_println("e47_terminal_score_columns,model,mode,t,n,keep_mean,current_mean,restore_mean,unknown_mean");
    model_index=0;
    while(model_index<E47_MODELS){
        let mode:i32=0;
        while(mode<E45_MODES){
            let t:i32=0;
            while(t<=E45_TAPE){
                let mode_time:i32=mode*(E45_TAPE+1)+t;
                let score_base:i32=(model_index*E47_MODE_TIME+mode_time)*E47_SCORE_FIELDS;
                let n:i32=r32e45_max(1,score_sums[score_base]);
                _zag_print("e47_terminal_score,");
                e45_print_i32(model_index);
                _zag_print(",");
                e45_print_i32(mode);
                _zag_print(",");
                e45_print_i32(t);
                _zag_print(",");
                e45_print_i32(score_sums[score_base]);
                let action:i32=0;
                while(action<4){
                    _zag_print(",");
                    e45_print_i32(score_sums[score_base+1+action]/n);
                    action=action+1;
                }
                _zag_println("");
                t=t+1;
            }
            mode=mode+1;
        }
        model_index=model_index+1;
    }
    _zag_println("e47_terminal_parameter_columns,model,index,value");
    model_index=0;
    while(model_index<E47_MODELS){
        let parameter:i32=0;
        while(parameter<4*E45_FEATURES){
            _zag_print("e47_terminal_weight,");
            e45_print_i32(model_index);
            _zag_print(",");
            e45_print_i32(parameter);
            _zag_print(",");
            e45_print_i32(terminal_weights[model_index*4*E45_FEATURES+parameter]);
            _zag_println("");
            parameter=parameter+1;
        }
        parameter=0;
        while(parameter<4){
            _zag_print("e47_terminal_bias,");
            e45_print_i32(model_index);
            _zag_print(",");
            e45_print_i32(parameter);
            _zag_print(",");
            e45_print_i32(terminal_biases[model_index*4+parameter]);
            _zag_println("");
            parameter=parameter+1;
        }
        model_index=model_index+1;
    }
    let integrity_gate:i32=0;
    if(retired_e46_gate+retired_e46_hash_gate+retired_occupancy_gate+e47_seed_gate+aux_clone_gate+terminal_zero_init_gate+sample_update_gate+order_identity_gate+train_lattice_gate+train_rep_structural_gate+validation_lattice_gate+validation_rep_structural_gate+validation_partition_gate+aux_frozen_gate==14){
        integrity_gate=1;
    }
    let representation_discriminator_gate:i32=0;
    if(integrity_gate==1 && baseline_safety_gate==0 && model_gates[3]==1){
        representation_discriminator_gate=1;
    }
    e45_print_pair("e47_integrity_gate",integrity_gate);
    e45_print_pair("e47_sealed_confirmation_executed",0);
    if(integrity_gate==0){
        _zag_println("terminal_representation_outcome,INTEGRITY_FAILURE");
    }else{
        if(baseline_safety_gate==1){
            _zag_println("terminal_representation_outcome,BASELINE_SPLIT_AMBIGUOUS");
        }else{
            if(model_gates[3]==1){
                _zag_println("terminal_representation_outcome,REPRESENTATION_RESCUE");
            }else{
                if(no_unique_cell_gates[3]==1 && known_gates[3]==0){
                    _zag_println("terminal_representation_outcome,ABSTENTION_TRADEOFF");
                }else{
                    _zag_println("terminal_representation_outcome,NO_TESTED_REPRESENTATION_RESCUE");
                }
            }
        }
    }
    if(representation_discriminator_gate==1){
        _zag_println("TNN_R32_E47_TERMINAL_REPRESENTATION_DISCRIMINATOR_GATE=PASS");
    }else{
        _zag_println("TNN_R32_E47_TERMINAL_REPRESENTATION_DISCRIMINATOR_GATE=FAIL");
    }
    zfree(raw_seen);
    zfree(evidence_seen);
    zfree(resource_seen);
    zfree(retired_aux_seeds);
    zfree(retired_terminal_seeds);
    zfree(retired_validation_seeds);
    zfree(retired_confirmation_seeds);
    zfree(aux_seeds);
    zfree(terminal_seeds);
    zfree(validation_seeds);
    zfree(confirmation_seeds);
    zfree(common_source);
    zfree(common_dependence);
    zfree(common_consequence);
    zfree(common_hazard);
    zfree(common_shadow);
    zfree(frozen_source);
    zfree(frozen_dependence);
    zfree(frozen_consequence);
    zfree(frozen_hazard);
    zfree(frozen_shadow);
    zfree(terminal_weights);
    zfree(terminal_biases);
    zfree(canonical_records);
    zfree(sample_counts);
    zfree(update_counts);
    zfree(order_hashes);
    zfree(record_hashes);
    zfree(train_rep_stats);
    zfree(train_rep_global);
    zfree(validation_rep_stats);
    zfree(validation_rep_global);
    zfree(validation_metrics);
    zfree(score_sums);
    zfree(aggregate);
    zfree(key_aggregate);
    zfree(terminal_aggregate);
    zfree(no_unique_cell_gates);
    zfree(model_gates);
    zfree(known_gates);
    zfree(joint_seed_counts);
    zfree(seed_key);
    zfree(seed_terminal_key);
    if(representation_discriminator_gate==1){
        return 0;
    }
    return 1;
}

// E49 is the preregistered matched online-credit x representation
// discriminator.  The E47 source above is retained byte-for-byte except for
// its unused main name.  E49 builds one fresh canonical record set, replays
// the frozen online rule into M0/M1, and fits M2/M3 with simultaneous
// complete-dataset integer steps whose sufficient statistics are independent
// of record traversal order.

const E49_AUX_EPISODES:i32=3240;
const E49_TERMINAL_EPISODES:i32=3240;
const E49_VALIDATION_EPISODES:i32=5400;
const E49_CONFIRM_EPISODES:i32=10800;
const E49_TERMINAL_SAMPLES:i32=55080;
const E49_RECORD_N:i32=38;
const E49_VALIDATION_PER_CELL:i32=20;
const E49_VAL_FIELDS:i32=4;
const E49_SCORE_FIELDS:i32=5;
const E49_MODE_TIME:i32=E45_MODES*(E45_TAPE+1);
const E49_MODELS:i32=2;
const E49_BATCH_MODELS:i32=2;
const E49_BATCH_PARAMETERS:i32=4*(E45_FEATURES+1);
const E49_BATCH_COLUMNS:i32=E45_FEATURES+1;
const E49_BATCH_GRAM:i32=E49_BATCH_COLUMNS*E49_BATCH_COLUMNS;
const E49_BATCH_CROSS:i32=E49_BATCH_COLUMNS*4;
const E49_BATCH_MAX_STEPS:i32=1024;
const E49_BATCH_RESIDUAL_LIMIT:i32=3000;
const E49_BATCH_STAT_SCALE:i32=1000;
const E49_BATCH_LOSS_BASE:i64=1000000000;

fn e49_print_i64(value:i64)void {
    _zag_print(_zag_i64_to_str(value));
}

fn e49_signed_div_i64(numerator:i64,denominator:i64)i64 {
    if(numerator<0){
        return -((-numerator)/denominator);
    }
    return numerator/denominator;
}

fn e49_round_nearest_i64(numerator:i64,denominator:i64)i64 {
    let half:i64=denominator/2;
    if(numerator<0){
        return -((-numerator+half)/denominator);
    }
    return (numerator+half)/denominator;
}

fn e49_loss_low(value:i64)i32 {
    return (value%E49_BATCH_LOSS_BASE) as i32;
}

fn e49_loss_high(value:i64)i32 {
    return (value/E49_BATCH_LOSS_BASE) as i32;
}

fn e49_hash_loss(hash:i32,value:i64)i32 {
    let next:i32=e46_hash_update(hash,e49_loss_high(value));
    return e46_hash_update(next,e49_loss_low(value));
}

fn e49_print_seed_manifest_row(
    stage:i32,
    epoch:i32,
    base_index:i32,
    base_id:i32,
    mode:i32,
    resource:i32,
    episode:i32,
    stream_seed:i32
)void {
    _zag_print("e49_seed_manifest,");
    e45_print_i32(stage);
    _zag_print(",");
    e45_print_i32(epoch);
    _zag_print(",");
    e45_print_i32(base_index);
    _zag_print(",");
    e45_print_i32(base_id);
    _zag_print(",");
    e45_print_i32(mode);
    _zag_print(",");
    e45_print_i32(resource);
    _zag_print(",");
    e45_print_i32(episode);
    _zag_print(",");
    e45_print_i32(stream_seed);
    _zag_println("");
}

fn e49_build_effective_seed_manifests(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    aux_seeds:[]i32,
    terminal_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(aux_seeds,E49_AUX_EPISODES);
    e45_zero(terminal_seeds,E49_TERMINAL_EPISODES);
    e45_zero(validation_seeds,E49_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E49_CONFIRM_EPISODES);
    _zag_println("e49_seed_manifest_columns,stage_0_aux_1_terminal_2_validation_3_sealed_confirmation,epoch,base_index,nominal_id,mode,resource,episode,stream_seed");
    let failure_count:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,12,index,mode,resource,&failure_count);
                        aux_seeds[index]=seed;
                        e49_print_seed_manifest_row(0,epoch,base_index,49001+base_index,mode,resource,episode,seed);
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    epoch=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,13,index,mode,resource,&failure_count);
                        terminal_seeds[index]=seed;
                        e49_print_seed_manifest_row(1,epoch,base_index,49101+base_index,mode,resource,episode,seed);
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,14,index,mode,resource,&failure_count);
                    validation_seeds[index]=seed;
                    e49_print_seed_manifest_row(2,0,base_index,49201+base_index,mode,resource,episode,seed);
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,15,index,mode,resource,&failure_count);
                    confirmation_seeds[index]=seed;
                    e49_print_seed_manifest_row(3,0,base_index,49301+base_index,mode,resource,episode,seed);
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    let tuple_coverage:i32=0;
    let seed_index:i32=0;
    while(seed_index<E49_AUX_EPISODES){
        if(aux_seeds[seed_index]>0){ tuple_coverage=tuple_coverage+1; }
        seed_index=seed_index+1;
    }
    seed_index=0;
    while(seed_index<E49_TERMINAL_EPISODES){
        if(terminal_seeds[seed_index]>0){ tuple_coverage=tuple_coverage+1; }
        seed_index=seed_index+1;
    }
    seed_index=0;
    while(seed_index<E49_VALIDATION_EPISODES){
        if(validation_seeds[seed_index]>0){ tuple_coverage=tuple_coverage+1; }
        seed_index=seed_index+1;
    }
    seed_index=0;
    while(seed_index<E49_CONFIRM_EPISODES){
        if(confirmation_seeds[seed_index]>0){ tuple_coverage=tuple_coverage+1; }
        seed_index=seed_index+1;
    }
    let raw_registered:i32=0;
    let evidence_registered:i32=0;
    let resource_registered:i32=0;
    let total_raw_occupancy:i32=0;
    let total_evidence_occupancy:i32=0;
    let total_resource_occupancy:i32=0;
    let state_index:i32=0;
    while(state_index<1000003){
        if(raw_seen[state_index]!=0){ total_raw_occupancy=total_raw_occupancy+1; }
        if(evidence_seen[state_index]!=0){ total_evidence_occupancy=total_evidence_occupancy+1; }
        if(resource_seen[state_index]!=0){ total_resource_occupancy=total_resource_occupancy+1; }
        if(raw_seen[state_index]>=13){ raw_registered=raw_registered+1; }
        if(evidence_seen[state_index]>=13){ evidence_registered=evidence_registered+1; }
        if(resource_seen[state_index]>=13){ resource_registered=resource_registered+1; }
        state_index=state_index+1;
    }
    _zag_println("e49_validation_seed_balance_columns,seed_index,mode,resource,truth_rng_zero,truth_rng_one,raw_seed_even,raw_seed_odd,resource_state_even,resource_state_odd");
    let validation_balance_gate:i32=1;
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let truth_zero:i32=0;
                let truth_one:i32=0;
                let raw_even:i32=0;
                let raw_odd:i32=0;
                let resource_even:i32=0;
                let resource_odd:i32=0;
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=validation_seeds[index];
                    let truth_rng:i32=e45_mod(seed+mode*811,1000003);
                    let truth_bit:i32=e45_mod(e45_rng_next(&truth_rng),2);
                    if(truth_bit==0){ truth_zero=truth_zero+1; }else{ truth_one=truth_one+1; }
                    if(e45_mod(seed,2)==0){ raw_even=raw_even+1; }else{ raw_odd=raw_odd+1; }
                    let resource_state:i32=e45_mod(seed+resource*193,1000003);
                    if(e45_mod(resource_state,2)==0){ resource_even=resource_even+1; }else{ resource_odd=resource_odd+1; }
                    episode=episode+1;
                }
                if(truth_zero==0 || truth_one==0 || raw_even==0 || raw_odd==0 || resource_even==0 || resource_odd==0){
                    validation_balance_gate=0;
                }
                _zag_print("e49_validation_seed_balance,");
                e45_print_i32(base_index); _zag_print(",");
                e45_print_i32(mode); _zag_print(",");
                e45_print_i32(resource); _zag_print(",");
                e45_print_i32(truth_zero); _zag_print(",");
                e45_print_i32(truth_one); _zag_print(",");
                e45_print_i32(raw_even); _zag_print(",");
                e45_print_i32(raw_odd); _zag_print(",");
                e45_print_i32(resource_even); _zag_print(",");
                e45_print_i32(resource_odd); _zag_println("");
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e49_seed_manifest_emitted",emitted);
    e45_print_pair("e49_effective_seed_assignment_failures",failure_count);
    e45_print_pair("e49_effective_raw_states_registered",raw_registered);
    e45_print_pair("e49_effective_evidence_states_registered",evidence_registered);
    e45_print_pair("e49_effective_resource_states_registered",resource_registered);
    e45_print_pair("e49_total_raw_occupancy",total_raw_occupancy);
    e45_print_pair("e49_total_evidence_occupancy",total_evidence_occupancy);
    e45_print_pair("e49_total_resource_occupancy",total_resource_occupancy);
    e45_print_pair("e49_seed_tuple_coverage",tuple_coverage);
    e45_print_pair("e49_validation_seed_balance_gate",validation_balance_gate);
    let gate:i32=0;
    if(emitted==22680 && failure_count==0 && raw_registered==emitted && evidence_registered==emitted*4 && resource_registered==emitted && tuple_coverage==emitted && validation_balance_gate==1){
        gate=1;
    }
    e45_print_pair("e49_seed_manifest_effective_disjoint_gate",gate);
    return gate;
}

// Reserve E48's already executed effective tuples before allocating E49.  This
// performs the same stage/index calls without re-emitting E48's ledger.
fn e49_reserve_e48_effective_seed_manifests(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32
)i32 {
    let failures:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,8,index,mode,resource,&failures);
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    epoch=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,9,index,mode,resource,&failures);
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,10,index,mode,resource,&failures);
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,11,index,mode,resource,&failures);
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    if(failures==0){ return 1; }
    return 0;
}

fn e49_build_model_features(
    baseline:[]i32,
    baseline_start:i32,
    co_viability:i32,
    contradiction_co_mass:i32,
    model_index:i32,
    out:[]i32,
    out_start:i32
)void {
    let feature:i32=0;
    while(feature<E45_FEATURES){
        out[out_start+feature]=baseline[baseline_start+feature];
        feature=feature+1;
    }
    out[out_start+3]=co_viability;
    out[out_start+5]=contradiction_co_mass;
    if(model_index==1){
        out[out_start+13]=r32e45_clamp(co_viability*contradiction_co_mass/1000,0,1000);
    }
}

fn e49_build_terminal_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    canonical_records:[]i32,
    lattice_mismatch:*i32,
    sample_count:*i32,
    target_hash:*i32,
    rep_stats:[]i32,
    rep_global:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let targets:[]i32=zalloc_i(4);
    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){
            immediate_a=tape_a[t-1];
            immediate_b=tape_b[t-1];
        }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0;
        let contradiction_co_mass:i32=0;
        e47_terminal_representation(
            states,t*E45_STATE_N,terminal_option,0,
            &co_viability,&contradiction_co_mass
        );
        e47_rep_stats_update(rep_stats,rep_global,evaluator_mode,t,0,co_viability);
        e47_rep_stats_update(rep_stats,rep_global,evaluator_mode,t,1,contradiction_co_mass);
        if(baseline_features[3]!=0 || baseline_features[5]!=0){
            lattice_mismatch.*=lattice_mismatch.*+1;
        }
        // The two causal representation values are complete before targets.
        let action:i32=0;
        while(action<4){
            targets[action]=e45_terminal_value(action,states,t*E45_STATE_N,initial_state,truth_state[t]);
            action=action+1;
        }
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t;
        let record_start:i32=record_number*E49_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            canonical_records[record_start+feature]=baseline_features[feature];
            feature=feature+1;
        }
        canonical_records[record_start+32]=co_viability;
        canonical_records[record_start+33]=contradiction_co_mass;
        action=0;
        while(action<4){
            canonical_records[record_start+34+action]=targets[action];
            target_hash.*=e46_hash_update(target_hash.*,targets[action]);
            action=action+1;
        }
        sample_count.*=sample_count.*+1;
        if(t<E45_TAPE){
            if(t==0){
                e45_copy(states,live_state,E45_STATE_N);
                e45_option_initialize(option,live_state,consequence,learned_shadow,0);
            }
            let i:i32=0;
            while(i<E45_STATE_N){
                live_state[i]=states[(t+1)*E45_STATE_N+i];
                i=i+1;
            }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }
    zfree(history_a);
    zfree(history_b);
    zfree(history_source);
    zfree(passive_a);
    zfree(passive_b);
    zfree(passive_source);
    zfree(tape_a);
    zfree(tape_b);
    zfree(tape_source);
    zfree(truth_state);
    zfree(history_cost);
    zfree(history_reward);
    zfree(future_cost);
    zfree(future_reward);
    zfree(resource_features);
    zfree(states);
    zfree(live_state);
    zfree(ordered_a);
    zfree(ordered_b);
    zfree(ordered_source);
    zfree(option);
    zfree(terminal_option);
    zfree(full_features);
    zfree(baseline_features);
    zfree(targets);
}

fn e49_online_fit(
    canonical_records:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    sample_counts:[]i32,
    update_counts:[]i32,
    order_hashes:[]i32,
    projection_hashes:[]i32,
    lattice_mismatch:*i32
)void {
    let features:[]i32=zalloc_i(2*E45_FEATURES);
    let record_number:i32=0;
    while(record_number<E49_TERMINAL_SAMPLES){
        let record_start:i32=record_number*E49_RECORD_N;
        e49_build_model_features(
            canonical_records,record_start,canonical_records[record_start+32],
            canonical_records[record_start+33],0,features,0
        );
        e49_build_model_features(
            canonical_records,record_start,canonical_records[record_start+32],
            canonical_records[record_start+33],1,features,E45_FEATURES
        );
        if(canonical_records[record_start+3]!=0 || canonical_records[record_start+5]!=0){
            lattice_mismatch.*=lattice_mismatch.*+1;
        }
        let model_index:i32=0;
        while(model_index<2){
            let feature:i32=0;
            while(feature<E45_FEATURES){
                let expected:i32=canonical_records[record_start+feature];
                if(model_index==1 && feature==3){ expected=canonical_records[record_start+32]; }
                if(model_index==1 && feature==5){ expected=canonical_records[record_start+33]; }
                if(features[model_index*E45_FEATURES+feature]!=expected){
                    lattice_mismatch.*=lattice_mismatch.*+1;
                }
                projection_hashes[model_index]=e46_hash_update(projection_hashes[model_index],features[model_index*E45_FEATURES+feature]);
                feature=feature+1;
            }
            let action:i32=0;
            while(action<4){
                let target:i32=canonical_records[record_start+34+action];
                projection_hashes[model_index]=e46_hash_update(projection_hashes[model_index],target);
                e47_linear_update(
                    terminal_weights,(model_index*4+action)*E45_FEATURES,
                    features,model_index*E45_FEATURES,
                    &terminal_biases[model_index*4+action],target,34
                );
                update_counts[model_index]=update_counts[model_index]+1;
                action=action+1;
            }
            order_hashes[model_index]=e46_hash_update(order_hashes[model_index],record_number);
            sample_counts[model_index]=sample_counts[model_index]+1;
            model_index=model_index+1;
        }
        record_number=record_number+1;
    }
    zfree(features);
}

fn e49_validation_offset(
    model_index:i32,
    base_index:i32,
    mode:i32,
    resource:i32,
    t:i32
)i32 {
    return ((((model_index*6+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*(E45_TAPE+1)+t)*E49_VAL_FIELDS;
}

fn e49_validate_episode(
    seed:i32,
    base_index:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    validation_metrics:[]i32,
    score_sums:[]i32,
    rep_stats:[]i32,
    rep_global:[]i32,
    lattice_mismatch:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E49_MODELS*E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){
            immediate_a=tape_a[t-1];
            immediate_b=tape_b[t-1];
        }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0;
        let contradiction_co_mass:i32=0;
        e47_terminal_representation(
            states,t*E45_STATE_N,terminal_option,0,
            &co_viability,&contradiction_co_mass
        );
        e47_rep_stats_update(rep_stats,rep_global,evaluator_mode,t,0,co_viability);
        e47_rep_stats_update(rep_stats,rep_global,evaluator_mode,t,1,contradiction_co_mass);
        let model_index:i32=0;
        while(model_index<E49_MODELS){
            e49_build_model_features(
                baseline_features,0,co_viability,contradiction_co_mass,
                model_index,model_features,model_index*E45_FEATURES
            );
            model_index=model_index+1;
        }
        if(baseline_features[3]!=0 || baseline_features[5]!=0){
            lattice_mismatch.*=lattice_mismatch.*+1;
        }
        model_index=0;
        while(model_index<E49_MODELS){
            let feature:i32=0;
            while(feature<E45_FEATURES){
                let expected:i32=baseline_features[feature];
                if(feature==3){ expected=co_viability; }
                if(feature==5){ expected=contradiction_co_mass; }
                if(model_index==1 && feature==13){ expected=r32e45_clamp(co_viability*contradiction_co_mass/1000,0,1000); }
                if(model_features[model_index*E45_FEATURES+feature]!=expected){
                    lattice_mismatch.*=lattice_mismatch.*+1;
                }
                feature=feature+1;
            }
            model_index=model_index+1;
        }
        // All four scores are complete before evaluator truth is consulted.
        model_index=0;
        while(model_index<E49_MODELS){
            let choice:i32=e47_terminal_scores(
                terminal_weights,terminal_biases,model_index,model_features,
                model_index*E45_FEATURES,scores
            );
            let mode_time:i32=evaluator_mode*(E45_TAPE+1)+t;
            let score_base:i32=(model_index*E49_MODE_TIME+mode_time)*E49_SCORE_FIELDS;
            score_sums[score_base]=score_sums[score_base]+1;
            let action:i32=0;
            while(action<4){
                score_sums[score_base+1+action]=score_sums[score_base+1+action]+scores[action];
                action=action+1;
            }
            let metric_base:i32=e49_validation_offset(model_index,base_index,evaluator_mode,evaluator_resource,t);
            validation_metrics[metric_base]=validation_metrics[metric_base]+1;
            if(choice==R32E45_TERM_UNKNOWN){
                validation_metrics[metric_base+2]=validation_metrics[metric_base+2]+1;
            }else{
                let utility:i32=e45_terminal_value(choice,states,t*E45_STATE_N,initial_state,truth_state[t]);
                if(utility==1000){
                    validation_metrics[metric_base+1]=validation_metrics[metric_base+1]+1;
                }else{
                    validation_metrics[metric_base+3]=validation_metrics[metric_base+3]+1;
                }
            }
            model_index=model_index+1;
        }
        if(t<E45_TAPE){
            if(t==0){
                e45_copy(states,live_state,E45_STATE_N);
                e45_option_initialize(option,live_state,consequence,learned_shadow,0);
            }
            let i:i32=0;
            while(i<E45_STATE_N){
                live_state[i]=states[(t+1)*E45_STATE_N+i];
                i=i+1;
            }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }
    zfree(history_a);
    zfree(history_b);
    zfree(history_source);
    zfree(passive_a);
    zfree(passive_b);
    zfree(passive_source);
    zfree(tape_a);
    zfree(tape_b);
    zfree(tape_source);
    zfree(truth_state);
    zfree(history_cost);
    zfree(history_reward);
    zfree(future_cost);
    zfree(future_reward);
    zfree(resource_features);
    zfree(states);
    zfree(live_state);
    zfree(ordered_a);
    zfree(ordered_b);
    zfree(ordered_source);
    zfree(option);
    zfree(terminal_option);
    zfree(full_features);
    zfree(baseline_features);
    zfree(model_features);
    zfree(scores);
}

fn e49_reduce_validation(
    validation_metrics:[]i32,
    aggregate:[]i32,
    key_aggregate:[]i32,
    terminal_aggregate:[]i32,
    no_unique_cell_gates:[]i32
)i32 {
    _zag_println("e49_validation_cell_columns,model_0_online_baseline_1_online_joint_2_batch_baseline_3_batch_joint,seed_index,mode,resource,t,n,success,unknown,wrong");
    let validation_partition_gate:i32=1;
    let model_index:i32=0;
    while(model_index<E49_MODELS){
        let base_index:i32=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let t:i32=0;
                    while(t<=E45_TAPE){
                        let metric_base:i32=e49_validation_offset(model_index,base_index,mode,resource,t);
                        let n:i32=validation_metrics[metric_base];
                        let success:i32=validation_metrics[metric_base+1];
                        let unknown:i32=validation_metrics[metric_base+2];
                        let wrong:i32=validation_metrics[metric_base+3];
                        let control_base:i32=e49_validation_offset(0,base_index,mode,resource,t);
                        if(n!=E49_VALIDATION_PER_CELL || n!=validation_metrics[control_base]){
                            validation_partition_gate=0;
                        }
                        if(mode==0 || mode==1){
                            if(success!=0 || unknown+wrong!=n){
                                validation_partition_gate=0;
                                no_unique_cell_gates[model_index]=0;
                            }
                            if(n<=0 || unknown*1000<700*n || wrong*1000>300*n){
                                no_unique_cell_gates[model_index]=0;
                            }
                        }else{
                            if(success+unknown+wrong!=n){ validation_partition_gate=0; }
                        }
                        let category:i32=1;
                        if(mode==0 || mode==1){ category=0; }
                        let aggregate_base:i32=(model_index*2+category)*E49_VAL_FIELDS;
                        aggregate[aggregate_base]=aggregate[aggregate_base]+n;
                        aggregate[aggregate_base+1]=aggregate[aggregate_base+1]+success;
                        aggregate[aggregate_base+2]=aggregate[aggregate_base+2]+unknown;
                        aggregate[aggregate_base+3]=aggregate[aggregate_base+3]+wrong;
                        if(mode>=3 && mode<=5){
                            let key_base:i32=(model_index*3+(mode-3))*E49_VAL_FIELDS;
                            key_aggregate[key_base]=key_aggregate[key_base]+n;
                            key_aggregate[key_base+1]=key_aggregate[key_base+1]+success;
                            key_aggregate[key_base+2]=key_aggregate[key_base+2]+unknown;
                            key_aggregate[key_base+3]=key_aggregate[key_base+3]+wrong;
                        }
                        if(t==E45_TAPE && mode>=2){
                            let terminal_group:i32=0;
                            let terminal_base:i32=(model_index*4+terminal_group)*E49_VAL_FIELDS;
                            terminal_aggregate[terminal_base]=terminal_aggregate[terminal_base]+n;
                            terminal_aggregate[terminal_base+1]=terminal_aggregate[terminal_base+1]+success;
                            terminal_aggregate[terminal_base+2]=terminal_aggregate[terminal_base+2]+unknown;
                            terminal_aggregate[terminal_base+3]=terminal_aggregate[terminal_base+3]+wrong;
                            if(mode>=3 && mode<=5){
                                terminal_group=1+(mode-3);
                                terminal_base=(model_index*4+terminal_group)*E49_VAL_FIELDS;
                                terminal_aggregate[terminal_base]=terminal_aggregate[terminal_base]+n;
                                terminal_aggregate[terminal_base+1]=terminal_aggregate[terminal_base+1]+success;
                                terminal_aggregate[terminal_base+2]=terminal_aggregate[terminal_base+2]+unknown;
                                terminal_aggregate[terminal_base+3]=terminal_aggregate[terminal_base+3]+wrong;
                            }
                        }
                        _zag_print("e49_validation_cell,");
                        e45_print_i32(model_index); _zag_print(",");
                        e45_print_i32(base_index); _zag_print(",");
                        e45_print_i32(mode); _zag_print(",");
                        e45_print_i32(resource); _zag_print(",");
                        e45_print_i32(t); _zag_print(",");
                        e45_print_i32(n); _zag_print(",");
                        e45_print_i32(success); _zag_print(",");
                        e45_print_i32(unknown); _zag_print(",");
                        e45_print_i32(wrong); _zag_println("");
                        t=t+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        model_index=model_index+1;
    }
    _zag_println("e49_validation_aggregate_columns,model,category_0_no_unique_1_known,n,success,unknown,wrong");
    _zag_println("e49_validation_key_mode_columns,model,mode,n,success,unknown,wrong");
    _zag_println("e49_validation_terminal_t16_columns,model,group_0_all_known_1_mode3_2_mode4_3_mode5,n,success,unknown,wrong");
    model_index=0;
    while(model_index<E49_MODELS){
        let category:i32=0;
        while(category<2){
            let aggregate_base:i32=(model_index*2+category)*E49_VAL_FIELDS;
            _zag_print("e49_validation_aggregate,");
            e45_print_i32(model_index); _zag_print(",");
            e45_print_i32(category);
            let field:i32=0;
            while(field<E49_VAL_FIELDS){
                _zag_print(","); e45_print_i32(aggregate[aggregate_base+field]);
                field=field+1;
            }
            _zag_println("");
            category=category+1;
        }
        let key_mode:i32=0;
        while(key_mode<3){
            let key_base:i32=(model_index*3+key_mode)*E49_VAL_FIELDS;
            _zag_print("e49_validation_key_mode,");
            e45_print_i32(model_index); _zag_print(","); e45_print_i32(key_mode+3);
            let field:i32=0;
            while(field<E49_VAL_FIELDS){
                _zag_print(","); e45_print_i32(key_aggregate[key_base+field]);
                field=field+1;
            }
            _zag_println("");
            key_mode=key_mode+1;
        }
        let terminal_group:i32=0;
        while(terminal_group<4){
            let terminal_base:i32=(model_index*4+terminal_group)*E49_VAL_FIELDS;
            _zag_print("e49_validation_terminal_t16,");
            e45_print_i32(model_index); _zag_print(","); e45_print_i32(terminal_group);
            let field:i32=0;
            while(field<E49_VAL_FIELDS){
                _zag_print(","); e45_print_i32(terminal_aggregate[terminal_base+field]);
                field=field+1;
            }
            _zag_println("");
            terminal_group=terminal_group+1;
        }
        model_index=model_index+1;
    }
    return validation_partition_gate;
}

fn e49_compute_model_gates(
    validation_metrics:[]i32,
    aggregate:[]i32,
    key_aggregate:[]i32,
    terminal_aggregate:[]i32,
    no_unique_cell_gates:[]i32,
    known_gates:[]i32,
    pure_known_gates:[]i32,
    model_gates:[]i32,
    joint_seed_counts:[]i32,
    seed_key:[]i32,
    seed_terminal_key:[]i32
)void {
    _zag_println("e49_validation_joint_seed_columns,model,seed_index,control_known_success,control_known_wrong,model_known_success,model_known_wrong,control_terminal_t16_success,control_terminal_t16_wrong,model_terminal_t16_success,model_terminal_t16_wrong,joint_exact_gate");
    let model_index:i32=1;
    while(model_index<E49_MODELS){
        let base_index:i32=0;
        while(base_index<6){
            e45_zero(seed_key,2*3*E49_VAL_FIELDS);
            e45_zero(seed_terminal_key,2*3*E49_VAL_FIELDS);
            let seed_no_unique_gate:i32=1;
            let control_known_success:i32=0;
            let control_known_wrong:i32=0;
            let model_known_success:i32=0;
            let model_known_wrong:i32=0;
            let control_terminal_success:i32=0;
            let control_terminal_wrong:i32=0;
            let model_terminal_success:i32=0;
            let model_terminal_wrong:i32=0;
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let t:i32=0;
                    while(t<=E45_TAPE){
                        let control_base:i32=e49_validation_offset(0,base_index,mode,resource,t);
                        let model_base:i32=e49_validation_offset(model_index,base_index,mode,resource,t);
                        let control_n:i32=validation_metrics[control_base];
                        let model_n:i32=validation_metrics[model_base];
                        if(mode==0 || mode==1){
                            let unknown:i32=validation_metrics[model_base+2];
                            let wrong:i32=validation_metrics[model_base+3];
                            if(model_n<=0 || unknown*1000<700*model_n || wrong*1000>300*model_n){ seed_no_unique_gate=0; }
                        }else{
                            control_known_success=control_known_success+validation_metrics[control_base+1];
                            control_known_wrong=control_known_wrong+validation_metrics[control_base+3];
                            model_known_success=model_known_success+validation_metrics[model_base+1];
                            model_known_wrong=model_known_wrong+validation_metrics[model_base+3];
                            if(t==E45_TAPE){
                                control_terminal_success=control_terminal_success+validation_metrics[control_base+1];
                                control_terminal_wrong=control_terminal_wrong+validation_metrics[control_base+3];
                                model_terminal_success=model_terminal_success+validation_metrics[model_base+1];
                                model_terminal_wrong=model_terminal_wrong+validation_metrics[model_base+3];
                            }
                            if(mode>=3 && mode<=5){
                                let key_index:i32=mode-3;
                                let field:i32=0;
                                while(field<E49_VAL_FIELDS){
                                    seed_key[(0*3+key_index)*E49_VAL_FIELDS+field]=seed_key[(0*3+key_index)*E49_VAL_FIELDS+field]+validation_metrics[control_base+field];
                                    seed_key[(1*3+key_index)*E49_VAL_FIELDS+field]=seed_key[(1*3+key_index)*E49_VAL_FIELDS+field]+validation_metrics[model_base+field];
                                    if(t==E45_TAPE){
                                        seed_terminal_key[(0*3+key_index)*E49_VAL_FIELDS+field]=seed_terminal_key[(0*3+key_index)*E49_VAL_FIELDS+field]+validation_metrics[control_base+field];
                                        seed_terminal_key[(1*3+key_index)*E49_VAL_FIELDS+field]=seed_terminal_key[(1*3+key_index)*E49_VAL_FIELDS+field]+validation_metrics[model_base+field];
                                    }
                                    field=field+1;
                                }
                            }
                        }
                        if(control_n!=model_n){ seed_no_unique_gate=0; }
                        t=t+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            let seed_key_gate:i32=1;
            let seed_terminal_key_gate:i32=1;
            let key_index:i32=0;
            while(key_index<3){
                let control_key:i32=(0*3+key_index)*E49_VAL_FIELDS;
                let model_key:i32=(1*3+key_index)*E49_VAL_FIELDS;
                if(seed_key[model_key+1]<seed_key[control_key+1] || seed_key[model_key+3]>seed_key[control_key+3]){ seed_key_gate=0; }
                if(seed_terminal_key[model_key+1]<seed_terminal_key[control_key+1] || seed_terminal_key[model_key+3]>seed_terminal_key[control_key+3]){ seed_terminal_key_gate=0; }
                key_index=key_index+1;
            }
            let seed_joint:i32=0;
            if(seed_no_unique_gate==1 && seed_key_gate==1 && seed_terminal_key_gate==1){
                if(model_known_success>=control_known_success && model_known_wrong<=control_known_wrong){
                    if(model_terminal_success>=control_terminal_success && model_terminal_wrong<=control_terminal_wrong){
                        seed_joint=1;
                        joint_seed_counts[model_index]=joint_seed_counts[model_index]+1;
                    }
                }
            }
            _zag_print("e49_validation_joint_seed,");
            e45_print_i32(model_index); _zag_print(",");
            e45_print_i32(base_index); _zag_print(",");
            e45_print_i32(control_known_success); _zag_print(",");
            e45_print_i32(control_known_wrong); _zag_print(",");
            e45_print_i32(model_known_success); _zag_print(",");
            e45_print_i32(model_known_wrong); _zag_print(",");
            e45_print_i32(control_terminal_success); _zag_print(",");
            e45_print_i32(control_terminal_wrong); _zag_print(",");
            e45_print_i32(model_terminal_success); _zag_print(",");
            e45_print_i32(model_terminal_wrong); _zag_print(",");
            e45_print_i32(seed_joint); _zag_println("");
            base_index=base_index+1;
        }
        model_index=model_index+1;
    }
    _zag_println("e49_model_gate_columns,model,no_unique_every_t_gate,strict_unknown_improvement,known_aggregate_noninferiority,key_aggregate_noninferiority,terminal_t16_known_noninferiority,terminal_t16_key_noninferiority,joint_seed_count,known_gate,complete_gate");
    model_index=1;
    while(model_index<E49_MODELS){
        let control_no_unique:i32=(0*2+0)*E49_VAL_FIELDS;
        let model_no_unique:i32=(model_index*2+0)*E49_VAL_FIELDS;
        let control_known:i32=(0*2+1)*E49_VAL_FIELDS;
        let model_known:i32=(model_index*2+1)*E49_VAL_FIELDS;
        let known_noninferiority:i32=0;
        if(aggregate[model_known]==aggregate[control_known] && aggregate[control_known]>0 && aggregate[model_known+1]>=aggregate[control_known+1] && aggregate[model_known+3]<=aggregate[control_known+3]){
            known_noninferiority=1;
        }
        let key_noninferiority:i32=1;
        let key_index:i32=0;
        while(key_index<3){
            let control_key:i32=(0*3+key_index)*E49_VAL_FIELDS;
            let model_key:i32=(model_index*3+key_index)*E49_VAL_FIELDS;
            if(key_aggregate[control_key]<=0 || key_aggregate[model_key]!=key_aggregate[control_key] || key_aggregate[model_key+1]<key_aggregate[control_key+1] || key_aggregate[model_key+3]>key_aggregate[control_key+3]){ key_noninferiority=0; }
            key_index=key_index+1;
        }
        let control_terminal:i32=(0*4+0)*E49_VAL_FIELDS;
        let model_terminal:i32=(model_index*4+0)*E49_VAL_FIELDS;
        let terminal_noninferiority:i32=0;
        if(terminal_aggregate[control_terminal]>0 && terminal_aggregate[model_terminal]==terminal_aggregate[control_terminal] && terminal_aggregate[model_terminal+1]>=terminal_aggregate[control_terminal+1] && terminal_aggregate[model_terminal+3]<=terminal_aggregate[control_terminal+3]){
            terminal_noninferiority=1;
        }
        let terminal_key_noninferiority:i32=1;
        let terminal_group:i32=1;
        while(terminal_group<4){
            let control_terminal_key:i32=(0*4+terminal_group)*E49_VAL_FIELDS;
            let model_terminal_key:i32=(model_index*4+terminal_group)*E49_VAL_FIELDS;
            if(terminal_aggregate[control_terminal_key]<=0 || terminal_aggregate[model_terminal_key]!=terminal_aggregate[control_terminal_key] || terminal_aggregate[model_terminal_key+1]<terminal_aggregate[control_terminal_key+1] || terminal_aggregate[model_terminal_key+3]>terminal_aggregate[control_terminal_key+3]){ terminal_key_noninferiority=0; }
            terminal_group=terminal_group+1;
        }
        let strict_unknown_improvement:i32=0;
        if(aggregate[model_no_unique+2]>aggregate[control_no_unique+2]){ strict_unknown_improvement=1; }
        let pure_known_gate:i32=0;
        if(known_noninferiority==1 && key_noninferiority==1 && terminal_noninferiority==1 && terminal_key_noninferiority==1){ pure_known_gate=1; }
        let known_gate:i32=0;
        if(pure_known_gate==1 && joint_seed_counts[model_index]>=4){ known_gate=1; }
        pure_known_gates[model_index]=pure_known_gate;
        known_gates[model_index]=known_gate;
        if(no_unique_cell_gates[model_index]==1 && known_gate==1){ model_gates[model_index]=1; }
        _zag_print("e49_model_gate,");
        e45_print_i32(model_index); _zag_print(",");
        e45_print_i32(no_unique_cell_gates[model_index]); _zag_print(",");
        e45_print_i32(strict_unknown_improvement); _zag_print(",");
        e45_print_i32(known_noninferiority); _zag_print(",");
        e45_print_i32(key_noninferiority); _zag_print(",");
        e45_print_i32(terminal_noninferiority); _zag_print(",");
        e45_print_i32(terminal_key_noninferiority); _zag_print(",");
        e45_print_i32(joint_seed_counts[model_index]); _zag_print(",");
        e45_print_i32(known_gate); _zag_print(",");
        e45_print_i32(model_gates[model_index]); _zag_println("");
        model_index=model_index+1;
    }
}

// The batch design column is 1000 for the intercept and otherwise the same
// fixed-point feature supplied to the corresponding terminal head.
fn e49_batch_column(
    canonical_records:[]i32,
    record_start:i32,
    column:i32,
    quadratic:i32
)i32 {
    if(column==0){
        return E49_BATCH_STAT_SCALE;
    }
    let feature:i32=column-1;
    if(feature==3){
        return canonical_records[record_start+32];
    }
    if(feature==5){
        return canonical_records[record_start+33];
    }
    if(quadratic==1 && feature==13){
        return r32e45_clamp(canonical_records[record_start+32]*canonical_records[record_start+33]/1000,0,1000);
    }
    return canonical_records[record_start+feature];
}

fn e49_build_batch_statistics(
    canonical_records:[]i32,
    quadratic:i32,
    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    record_count:*i32,
    stats_hash:*i32
)void {
    e45_zero(gram,E49_BATCH_GRAM);
    e45_zero(cross,E49_BATCH_CROSS);
    record_count.*=0;
    let traversal:i32=0;
    while(traversal<E49_TERMINAL_SAMPLES){
        let record_number:i32=traversal;
        if(reverse==1){
            record_number=E49_TERMINAL_SAMPLES-1-traversal;
        }
        let record_start:i32=record_number*E49_RECORD_N;
        let row:i32=0;
        while(row<E49_BATCH_COLUMNS){
            let row_value:i64=e49_batch_column(canonical_records,record_start,row,quadratic) as i64;
            let action:i32=0;
            while(action<4){
                let target:i64=canonical_records[record_start+34+action] as i64;
                let contribution:i64=e49_signed_div_i64(row_value*target,E49_BATCH_STAT_SCALE as i64);
                let cross_index:i32=row*4+action;
                cross[cross_index]=cross[cross_index]+(contribution as i32);
                action=action+1;
            }
            let column:i32=0;
            while(column<E49_BATCH_COLUMNS){
                let column_value:i64=e49_batch_column(canonical_records,record_start,column,quadratic) as i64;
                let contribution:i64=e49_signed_div_i64(row_value*column_value,E49_BATCH_STAT_SCALE as i64);
                let gram_index:i32=row*E49_BATCH_COLUMNS+column;
                gram[gram_index]=gram[gram_index]+(contribution as i32);
                column=column+1;
            }
            row=row+1;
        }
        record_count.*=record_count.*+1;
        traversal=traversal+1;
    }
    let index:i32=0;
    while(index<E49_BATCH_GRAM){
        stats_hash.*=e46_hash_update(stats_hash.*,gram[index]);
        index=index+1;
    }
    index=0;
    while(index<E49_BATCH_CROSS){
        stats_hash.*=e46_hash_update(stats_hash.*,cross[index]);
        index=index+1;
    }
}

fn e49_batch_statistics_equal(
    forward_gram:[]i32,
    reverse_gram:[]i32,
    forward_cross:[]i32,
    reverse_cross:[]i32
)i32 {
    let index:i32=0;
    while(index<E49_BATCH_GRAM){
        if(forward_gram[index]!=reverse_gram[index]){
            return 0;
        }
        index=index+1;
    }
    index=0;
    while(index<E49_BATCH_CROSS){
        if(forward_cross[index]!=reverse_cross[index]){
            return 0;
        }
        index=index+1;
    }
    return 1;
}

fn e49_batch_loss(
    canonical_records:[]i32,
    quadratic:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    model_index:i32
)i64 {
    let features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let loss:i64=0;
    let record_number:i32=0;
    while(record_number<E49_TERMINAL_SAMPLES){
        let record_start:i32=record_number*E49_RECORD_N;
        e49_build_model_features(
            canonical_records,record_start,canonical_records[record_start+32],
            canonical_records[record_start+33],quadratic,features,0
        );
        let action:i32=0;
        while(action<4){
            scores[action]=e47_linear_predict(
                terminal_weights,(model_index*4+action)*E45_FEATURES,
                features,0,terminal_biases[model_index*4+action]
            );
            let residual:i32=r32e45_clamp(
                canonical_records[record_start+34+action]-scores[action],
                -E49_BATCH_RESIDUAL_LIMIT,E49_BATCH_RESIDUAL_LIMIT
            );
            loss=loss+(residual as i64)*(residual as i64);
            action=action+1;
        }
        record_number=record_number+1;
    }
    zfree(features);
    zfree(scores);
    return loss;
}

fn e49_batch_fit(
    canonical_records:[]i32,
    quadratic:i32,
    model_index:i32,
    gram:[]i32,
    cross:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    backup_weights:[]i32,
    backup_biases:[]i32,
    accepted_steps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    accepted_steps.*=0;
    stop_reason.*=3;
    trace_hash.*=197+model_index;
    let current_loss:i64=e49_batch_loss(
        canonical_records,quadratic,terminal_weights,terminal_biases,model_index
    );
    trace_hash.*=e49_hash_loss(trace_hash.*,current_loss);
    let sweep:i32=0;
    let stopped:i32=0;
    while(sweep<E49_BATCH_MAX_STEPS && stopped==0){
        let action:i32=0;
        while(action<4){
            let feature:i32=0;
            while(feature<E45_FEATURES){
                backup_weights[action*E45_FEATURES+feature]=terminal_weights[(model_index*4+action)*E45_FEATURES+feature];
                feature=feature+1;
            }
            backup_biases[action]=terminal_biases[model_index*4+action];
            action=action+1;
        }
        let changed:i32=0;
        action=0;
        while(action<4){
            let column:i32=0;
            while(column<E49_BATCH_COLUMNS){
                let diagonal:i32=gram[column*E49_BATCH_COLUMNS+column];
                let current:i32=terminal_biases[model_index*4+action];
                if(column>0){
                    current=terminal_weights[(model_index*4+action)*E45_FEATURES+column-1];
                }
                let candidate:i32=0;
                if(diagonal>0){
                    let weighted_sum:i64=0;
                    let other:i32=0;
                    while(other<E49_BATCH_COLUMNS){
                        if(other!=column){
                            let other_parameter:i32=terminal_biases[model_index*4+action];
                            if(other>0){
                                other_parameter=terminal_weights[(model_index*4+action)*E45_FEATURES+other-1];
                            }
                            weighted_sum=weighted_sum+(gram[column*E49_BATCH_COLUMNS+other] as i64)*(other_parameter as i64);
                        }
                        other=other+1;
                    }
                    let numerator:i64=(cross[column*4+action] as i64)*(E49_BATCH_STAT_SCALE as i64)-weighted_sum;
                    candidate=e49_round_nearest_i64(numerator,diagonal as i64) as i32;
                    if(column==0){
                        candidate=r32e45_clamp(candidate,-4000,4000);
                    }else{
                        candidate=r32e45_clamp(candidate,-16000,16000);
                    }
                }
                if(candidate!=current){
                    changed=1;
                }
                if(column==0){
                    terminal_biases[model_index*4+action]=candidate;
                }else{
                    terminal_weights[(model_index*4+action)*E45_FEATURES+column-1]=candidate;
                }
                column=column+1;
            }
            action=action+1;
        }
        if(changed==0){
            stop_reason.*=1;
            stopped=1;
        }else{
            let candidate_loss:i64=e49_batch_loss(
                    canonical_records,quadratic,terminal_weights,terminal_biases,model_index
            );
            if(candidate_loss<current_loss){
                current_loss=candidate_loss;
                accepted_steps.*=accepted_steps.*+1;
                trace_hash.*=e49_hash_loss(trace_hash.*,current_loss);
            }else{
                action=0;
                while(action<4){
                    let feature:i32=0;
                    while(feature<E45_FEATURES){
                        terminal_weights[(model_index*4+action)*E45_FEATURES+feature]=backup_weights[action*E45_FEATURES+feature];
                        feature=feature+1;
                    }
                    terminal_biases[model_index*4+action]=backup_biases[action];
                    action=action+1;
                }
                stop_reason.*=2;
                stopped=1;
            }
        }
        sweep=sweep+1;
    }
    if(stopped==0){
        stop_reason.*=3;
    }
    final_loss_low.*=e49_loss_low(current_loss);
    final_loss_high.*=e49_loss_high(current_loss);
}

fn e49_compare_batch_parameters(
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    forward_weights:[]i32,
    forward_biases:[]i32
)i32 {
    let local_model:i32=0;
    while(local_model<E49_BATCH_MODELS){
        let model_index:i32=local_model;
        let action:i32=0;
        while(action<4){
            if(terminal_biases[model_index*4+action]!=forward_biases[local_model*4+action]){
                return 0;
            }
            let feature:i32=0;
            while(feature<E45_FEATURES){
                if(terminal_weights[(model_index*4+action)*E45_FEATURES+feature]!=forward_weights[(local_model*4+action)*E45_FEATURES+feature]){
                    return 0;
                }
                feature=feature+1;
            }
            action=action+1;
        }
        local_model=local_model+1;
    }
    return 1;
}


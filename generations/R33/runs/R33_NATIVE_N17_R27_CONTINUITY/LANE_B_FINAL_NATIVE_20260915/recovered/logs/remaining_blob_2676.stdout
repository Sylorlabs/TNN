    _zag_println("e47_validation_joint_seed_columns,model,seed_index,control_known_success,control_known_wrong,model_known_success,model_known_wrong,control_terminal_t16_success,control_terminal_t16_wrong,model_terminal_t16_success,model_terminal_t16_wrong,joint_exact_gate");
    model_index=1;
    while(model_index<E47_MODELS){
        let base_index:i32=0;
        while(base_index<6){
            e45_zero(seed_key,2*3*E47_VAL_FIELDS);
            e45_zero(seed_terminal_key,2*3*E47_VAL_FIELDS);
            let seed_no_unique_gate:i32=1;
            let control_known_success:i32=0;
            let control_known_wrong:i32=0;
            let model_known_success:i32=0;
            let model_known_wrong:i32=0;
            let control_terminal_success:i32=0;
            let control_terminal_wrong:i32=0;
            let model_terminal_success:i32=0;
            let model_terminal_wrong:i32=0;
            let mode:i32=0;

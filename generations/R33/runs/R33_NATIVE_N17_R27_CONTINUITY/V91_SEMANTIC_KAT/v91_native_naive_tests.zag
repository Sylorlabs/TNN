@import("v91_native_naive_v1.zag")
@import("v91_semantic_kat.zag")

fn main()i32 {
    if(_zag_argc()!=2){return 2;}let model:V91NaiveModel=vg_load(_zag_arg(1));if(model.status!=0){_zag_print("V91_NATIVE_NAIVE_MODEL_REFUSAL,");_zag_println(_zag_i64_to_str(model.status as i64));return 3;}
    let rows:[]i32=v91_alloc_i32(V91_ROWS*7);let tr:[]i32=v91_alloc_i32(V91_ROWS);let te:[]i32=v91_alloc_i32(V91_ROWS);let nt:i32=0;let nh:i32=0;if(v91_build(rows)!=0||v91_split(rows,tr,te,&nt,&nh)!=0||nh<16){return 4;}
    let ci:[]i32=v91_alloc_i32(42);let c:[]f64=vg_f64(42);let matched:i32=0;let i:i32=0;while(i<16){let r:V91Row=v91_row_get(rows,te[i]);if(v91_condition(r,ci)!=0){return 5;}let j:i32=0;while(j<42){c[j]=ci[j] as f64;j=j+1;}let status:i32=-1;let got:[]u8=vg_generate_naive(&model,c,(23101+i) as u64,&status);let ok:i32=0;if(status==0){ok=v91_output_match(i,got);}matched=matched+ok;_zag_print("V91_NATIVE_NAIVE,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",match=");_zag_print(_zag_i64_to_str(ok as i64));_zag_print(",bytes=");_zag_print(_zag_i64_to_str(got.len as i64));_zag_print(",text=");_zag_println(got);i=i+1;}
    _zag_print("V91_NATIVE_NAIVE_MATCHED,");_zag_println(_zag_i64_to_str(matched as i64));_zag_println("V91_NATIVE_NAIVE_GENERATED,16");return 0;
}

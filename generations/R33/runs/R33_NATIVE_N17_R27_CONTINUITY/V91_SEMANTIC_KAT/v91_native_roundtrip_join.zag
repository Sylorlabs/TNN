@import("../../R33_NATIVE_SHA256_V2.zag")

fn vrj_get32(b:[]u8,at:i32)i32 @noalloc {return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}
fn vrj_put32(b:[]u8,at:i32,x:i32)i32 @noalloc {if(at<0||at+4>b.len){return 1;}b[at]=(x&255) as u8;b[at+1]=((x>>8)&255) as u8;b[at+2]=((x>>16)&255) as u8;b[at+3]=((x>>24)&255) as u8;return 0;}
fn vrj_eq(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn vrj_u8(n:i32)[]u8 {let p:*u8=_zag_malloc(n) as *u8;return p[0..n];}
fn vrj_hash(b:[]u8)[]u8 {let h:[]u8=vrj_u8(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}

fn main()i32 {
    if(_zag_argc()!=18){return 2;}let frame:[]u8=vrj_u8(8192);let magic:[]u8="V91RTG01";let i:i32=0;while(i<8){frame[i]=magic[i];i=i+1;}vrj_put32(frame,8,16);vrj_put32(frame,12,128);let used:i32=16;i=0;
    while(i<16){let b:[]u8=_zag_read_file(_zag_arg(1+i));if(b.len<21||vrj_eq(b[0..8],"V91RRW01")!=1||vrj_get32(b,8)!=i||vrj_get32(b,12)!=33101+i){return 3;}let len:i32=vrj_get32(b,16);if(len<1||b.len!=20+len||used+12+len>frame.len){return 4;}vrj_put32(frame,used,i);vrj_put32(frame,used+4,33101+i);vrj_put32(frame,used+8,len);let j:i32=0;while(j<len){frame[used+12+j]=b[20+j];j=j+1;}used=used+12+len;i=i+1;}
    let out:[]u8=frame[0..used];if(_zag_write_file(_zag_arg(17),out)!=0){return 5;}_zag_print("V91_ROUNDTRIP_FRAME_SHA256,");_zag_println(vrj_hash(out));_zag_println("V91_ACTUAL_ROUNDTRIP_GENERATED,16");return 0;
}

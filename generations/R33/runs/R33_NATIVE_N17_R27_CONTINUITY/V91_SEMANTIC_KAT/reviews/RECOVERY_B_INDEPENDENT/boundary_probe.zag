@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/V91_SEMANTIC_KAT/v91_oracle_custody.zag")
fn main()i32 {
 let f:i32=0;let p:ParentMap=pm_empty();if(vo_item(&p,0,0)!=0||vo_item(&p,-1,0)!=0||vo_item(&p,1,-1)!=0){f=f+1;}
 if(v91_output_match(-1,"x")!=0||v91_output_match(16,"x")!=0||v91_output_match(0,"x")!=0){f=f+1;}
 let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}if(pb_training_admission(binding)!=-8904){f=f+1;}binding[12]=1;if(pb_validate(binding)!=-8901||pb_training_admission(binding)!=-8901){f=f+1;}binding[12]=0;binding[32]=binding[32]^1;if(pb_validate(binding)!=-8902){f=f+1;}
 _zag_print("IV91_BOUNDARY_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));_zag_println("IV91_AUTHORITY,0\nIV91_GENERATED_OUTPUTS,0");nio_free(binding);return (f!=0) as i32;
}

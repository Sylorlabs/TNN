// Pure-Zag reconstruction of the historical R23 n=1 surface-generator lane.
// This file contains no oracle strings and never executes historical Python.
@import("v91_numeric_components.zag")
@import("r25_mt19937_v1.zag")

struct V91NaiveModel {
    emb:[]f64,cw:[]f64,cb:[]f64,ew:[]f64,eb:[]f64,
    wi:[]f64,wh:[]f64,bi:[]f64,bh:[]f64,ow:[]f64,ob:[]f64,
    bpe:[]u8,token_at:[]i32,token_len:[]i32,status:i32,
}

fn vg_i32(n:i32)[]i32 {let p:*i32=_zag_malloc(n*8) as *i32;return p[0..n];}
fn vg_f64(n:i32)[]f64 {let p:*f64=_zag_malloc(n*8) as *f64;let x:[]f64=p[0..n];let i:i32=0;while(i<n){x[i]=0.0;i=i+1;}return x;}
fn vg_f32(n:i32)[]f32 {let p:*f32=_zag_malloc(n*4) as *f32;return p[0..n];}
fn vg_u8(n:i32)[]u8 {let p:*u8=_zag_malloc(n) as *u8;return p[0..n];}
fn vg_u32(b:[]u8,at:i32)i32 @noalloc {return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}
fn vg_round32(x:f64,s:[]f32)f64 @noalloc {s[0]=x as f32;return s[0] as f64;}

fn vg_load(root:[]u8)V91NaiveModel {
    let m:V91NaiveModel=V91NaiveModel{
      .emb=vn_load(root,"emb.weight.f32le",16416,"1a794c01fb13e6419f021cde17646bc996d9c830a9889074ea9bd697c75c852c"),
      .cw=vn_load(root,"ch.weight.f32le",5376,"67920504b899c84081ae40ffc3bdfa3b0346c76a55f793c5e9f0b7f72dbe2012"),.cb=vn_load(root,"ch.bias.f32le",128,"75ccb126de2b5472bad4fe7c8bf5b0bcc798bcc3a2276f76538b1fef42daa0f2"),
      .ew=vn_load(root,"ce.weight.f32le",2016,"da025df5a1aad39d831548df8f3a471704e291245ad7f23f01eef5e43a90d030"),.eb=vn_load(root,"ce.bias.f32le",48,"feb0fe10b7a2e3b5d3677b004e2596a058e815d724ec1d1ccdeb245501628675"),
      .wi=vn_load(root,"rnn.weight_ih_l0.f32le",36864,"924901700863d73d6486a0f9cc24bbea13bfd97f9dcc829f9b6379b5a56e5b07"),.wh=vn_load(root,"rnn.weight_hh_l0.f32le",49152,"8e3123d57aa5b2c47d6644e9ee27bb1c811202afcc9f4b20b1c08235f3bb25da"),
      .bi=vn_load(root,"rnn.bias_ih_l0.f32le",384,"5f7031f4aa28e27000e07ba4c73626a75201b9133c27a7c76e1e4c92eb79950d"),.bh=vn_load(root,"rnn.bias_hh_l0.f32le",384,"46c566e116bc208ef5bf094a7fc19cc9cda9b79f374d1b71c3618f504fa4d0b4"),
      .ow=vn_load(root,"out.weight.f32le",43776,"a7da5c280c99848005d7afe1cb1bd29aa50371b7c321bfc3cb6fc497b84cda4e"),.ob=vn_load(root,"out.bias.f32le",342,"0b4a444e1212268e550b8680fbfca0ae9ba034a67e6c91a03be09607623ede5d"),
      .bpe="",.token_at=vg_i32(340),.token_len=vg_i32(340),.status=0};
    if(m.emb.len!=16416||m.cw.len!=5376||m.cb.len!=128||m.ew.len!=2016||m.eb.len!=48||m.wi.len!=36864||m.wh.len!=49152||m.bi.len!=384||m.bh.len!=384||m.ow.len!=43776||m.ob.len!=342){m.status=10;return m;}
    m.bpe=_zag_read_file(_zag_str_concat(_zag_str_concat(root,"/"),"bpe.framed.bin"));
    if(m.bpe.len<16||nio_equal(vn_hash(m.bpe),"f83d2f7c63b2f40f386c37b96fc5d17ea120f715e503f58b62a6ca428cd21f6c")!=1||nio_equal(m.bpe[0..8],"V91BPE01")!=1||vg_u32(m.bpe,8)!=340){m.status=11;return m;}
    let at:i32=16;let n:i32=0;while(n<340){if(at+8>m.bpe.len){m.status=12;return m;}let id:i32=vg_u32(m.bpe,at);let len:i32=vg_u32(m.bpe,at+4);if(id<0||id>=340||len<0||at+8+len>m.bpe.len){m.status=13;return m;}m.token_at[id]=at+8;m.token_len[id]=len;at=at+8+len;n=n+1;}
    return m;
}

fn vg_linear32(w:[]f64,b:[]f64,x:[]f64,out:[]f64,round:[]f32)i32 @noalloc {
    if(vn_linear(w,b,x,out)!=0){return 20;}let i:i32=0;while(i<out.len){out[i]=vg_round32(out[i],round);i=i+1;}return 0;
}

fn vg_tanh32(x:f64,round:[]f32)f64 @noalloc {return vg_round32(vn_tanh(x),round);}
fn vg_sigmoid32(x:f64,round:[]f32)f64 @noalloc {return vg_round32(vn_sigmoid(x),round);}

fn vg_gru32(m:*V91NaiveModel,x:[]f64,h:[]f64,out:[]f64,gi:[]f64,gh:[]f64,round:[]f32)i32 @noalloc {
    if(vg_linear32(m.*.wi,m.*.bi,x,gi,round)!=0||vg_linear32(m.*.wh,m.*.bh,h,gh,round)!=0){return 21;}
    let i:i32=0;while(i<128){
        let r:f64=vg_sigmoid32(vg_round32(gi[i]+gh[i],round),round);
        let z:f64=vg_sigmoid32(vg_round32(gi[128+i]+gh[128+i],round),round);
        let rn:f64=vg_round32(r*gh[256+i],round);
        let nn:f64=vg_tanh32(vg_round32(gi[256+i]+rn,round),round);
        let a:f64=vg_round32((1.0-z)*nn,round);let b:f64=vg_round32(z*h[i],round);
        out[i]=vg_round32(a+b,round);i=i+1;
    }return 0;
}

fn vg_neglog1m(u:f64)f64 @noalloc {
    if(u<=0.0){return 0.0;}let y:f64=1.0-u;let k:i32=0;while(y<0.7071067811865476){y=y*2.0;k=k+1;}
    let z:f64=(y-1.0)/(y+1.0);let z2:f64=z*z;let term:f64=z;let sum:f64=z;let d:i32=3;while(d<=25){term=term*z2;sum=sum+term/(d as f64);d=d+2;}
    return (k as f64)*0.69314718055994530942-2.0*sum;
}

fn vg_exponential_mt(st:*R25MT19937V1,round:[]f32,out:*f64)i32 @noalloc {
    let hi:u64=0;let lo:u64=0;if(r25mt_next_u32(st,&hi)!=0||r25mt_next_u32(st,&lo)!=0){return 30;}
    let bits:u64=((hi&0xffffffff)<<32)|(lo&0xffffffff);let mant:u64=bits&0x001fffffffffffff;
    let u:f64=(mant as f64)/vn_pow2(53);out.*=vg_round32(vg_neglog1m(u),round);return 0;
}

fn vg_top7(logits:[]f64,ids:[]i32,vals:[]f64)i32 @noalloc {
    if(logits.len!=342||ids.len!=7||vals.len!=7){return 31;}let i:i32=0;while(i<7){ids[i]=-1;vals[i]=-1000000000.0;i=i+1;}i=0;while(i<342){let p:i32=0;while(p<7&&logits[i]<=vals[p]){p=p+1;}if(p<7){let q:i32=6;while(q>p){vals[q]=vals[q-1];ids[q]=ids[q-1];q=q-1;}vals[p]=logits[i];ids[p]=i;}i=i+1;}return 0;
}

fn vg_pick_top7(st:*R25MT19937V1,vals:[]f64,round:[]f32,out:*i32)i32 {
    let weights:[]f64=vg_f64(7);let max:f64=vals[0];let i:i32=0;let sum:f64=0.0;
    while(i<7){let scaled:f64=vg_round32((vals[i]-max)/0.72,round);weights[i]=vg_round32(vn_exp(scaled),round);sum=vg_round32(sum+weights[i],round);i=i+1;}
    i=0;while(i<7){weights[i]=vg_round32(weights[i]/sum,round);i=i+1;}
    let best:f64=-1.0;let pick:i32=-1;i=0;while(i<7){let q:f64=0.0;if(vg_exponential_mt(st,round,&q)!=0||q<=0.0){return 32;}let score:f64=vg_round32(weights[i]/q,round);if(pick<0||score>best){best=score;pick=i;}i=i+1;}out.*=pick;return 0;
}

fn vg_decode(m:*V91NaiveModel,seq:[]i32,count:i32)[]u8 {
    let out:[]u8=vg_u8(4096);let used:i32=0;let i:i32=0;while(i<count){let id:i32=seq[i];if(id<0||id>=340){i=i+1;continue;}let at:i32=m.*.token_at[id];let len:i32=m.*.token_len[id];if(used+len>out.len){return "";}let j:i32=0;while(j<len){out[used+j]=m.*.bpe[at+j];j=j+1;}used=used+len;i=i+1;}return out[0..used];
}

fn vg_generate_naive(m:*V91NaiveModel,c:[]f64,seed:u64,status:*i32)[]u8 {
    if(m.*.status!=0||c.len!=42||status==null as *i32){return "";}let round:[]f32=vg_f32(1);
    let h:[]f64=vg_f64(128);let cp:[]f64=vg_f64(128);let ce:[]f64=vg_f64(48);if(vg_linear32(m.*.cw,m.*.cb,c,cp,round)!=0||vg_linear32(m.*.ew,m.*.eb,c,ce,round)!=0){status.*=40;return "";}
    let i:i32=0;while(i<128){h[i]=vg_tanh32(cp[i],round);i=i+1;}i=0;while(i<48){ce[i]=vg_tanh32(ce[i],round);i=i+1;}
    let st:R25MT19937V1=r25mt_new();if(r25mt_init_genrand(&st,seed)!=0){status.*=41;return "";}
    let x:[]f64=vg_f64(96);let next_h:[]f64=vg_f64(128);let gi:[]f64=vg_f64(384);let gh:[]f64=vg_f64(384);let logits:[]f64=vg_f64(342);let ids:[]i32=vg_i32(7);let vals:[]f64=vg_f64(7);let seq:[]i32=vg_i32(48);let count:i32=0;let tok:i32=340;let step:i32=0;let alive:i32=1;
    while(step<48&&alive==1){i=0;while(i<48){x[i]=m.*.emb[tok*48+i];x[48+i]=ce[i];i=i+1;}if(vg_gru32(m,x,h,next_h,gi,gh,round)!=0){status.*=42;return "";}i=0;while(i<128){h[i]=next_h[i];i=i+1;}if(vg_linear32(m.*.ow,m.*.ob,h,logits,round)!=0||vg_top7(logits,ids,vals)!=0){status.*=43;return "";}let pick:i32=-1;if(vg_pick_top7(&st,vals,round,&pick)!=0){status.*=44;return "";}tok=ids[pick];if(tok==341){alive=0;}else if(tok<340){seq[count]=tok;count=count+1;}step=step+1;}
    status.*=0;return vg_decode(m,seq,count);
}

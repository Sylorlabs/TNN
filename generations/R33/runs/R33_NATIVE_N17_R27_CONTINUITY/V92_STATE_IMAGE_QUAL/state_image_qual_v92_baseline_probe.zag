// R33 N17 V92: native-only qualification for the authored R27 V4 state image.
// This is engineering qualification only. It does not mutate canonical R27,
// grant learner authority, or claim behavioral-continuity closure.
@import("../r27_native_state_image_v4.zag")
@import("../../R33_CONTINUING_LIFE_V1/checkpoint.zag")

const V92_MAX_VALUES:i32=8192;
const V92_MAX_SECTION_BYTES:i32=32784;
const V92_SECTION_COUNT:i32=33;
const V92_SECTION_HEADER_BYTES:i32=16;
const V92_IMAGE_HEADER_BYTES:i32=16;
const V92_DIR_ENTRY_BYTES:i32=12;
const V92_PAYLOAD_START:i32=412;
const V92_PAM_COUNT:i32=7;
const V92_ACOUSTIC_MOTIF_COUNT:i32=17;
const V92_NAME_COUNT:i32=21;
const V92_TRACE_COUNT:i32=29;
const V92_DEVELOPMENT_STEP:i32=30;
const V92_PENDING_CREDIT:i32=32;
const V92_NEWBORN_RESTARTS:i32=33;
const V92_PENDING_FIELDS:i32=8;
const V92_CL_HEADER_BYTES:i32=112;
const V92_CL_SECTIONS:i32=12;

fn v92_root()[]u8 {return "Research/R33_NATIVE_N17_R27_CONTINUITY/V92_STATE_IMAGE_QUAL/FRESH_PROCESS";}

fn v92_check(name:[]u8,actual:i32,expected:i32)i32 {
    let failed:i32=0;if(actual!=expected){failed=1;}
    _zag_print("V92_CHECK,");_zag_print(name);_zag_print(",");
    if(failed==0){_zag_println("PASS");}else{_zag_println("FAIL");}
    return failed;
}

fn v92_fill(id:i32,v:[]i32)i32 {
    let n:i32=r27s4_expected_count(id);if(n<0 || v.len!=n){return -1;}
    let i:i32=0;while(i<n){v[i]=id*100003+i*17-71;i=i+1;}
    if(id==V92_PAM_COUNT){v[0]=32;}
    if(id==V92_ACOUSTIC_MOTIF_COUNT){v[0]=32;}
    if(id==V92_NAME_COUNT){v[0]=128;}
    if(id==V92_TRACE_COUNT){v[0]=58;}
    if(id==V92_DEVELOPMENT_STEP){v[0]=60423;}
    if(id==V92_NEWBORN_RESTARTS){v[0]=0;}
    if(id==V92_PENDING_CREDIT){
        v[0]=1;v[1]=57;v[2]=3;v[3]=7;v[4]=1200;v[5]=1209;v[6]=44;v[7]=901;
    }
    return 0;
}

fn v92_equal_i32(a:[]i32,b:[]i32)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){
        _zag_print("V92_MISMATCH,");cl_number(i as i64);_zag_print(",");cl_number(a[i] as i64);_zag_print(",");cl_number(b[i] as i64);_zag_println("");return 0;
    }i=i+1;}return 1;
}

fn v92_build_fail(stage:i32,id:i32,rc:i32)i32 {
    _zag_print("V92_BUILD_FAIL,");cl_number(stage as i64);_zag_print(",");cl_number(id as i64);_zag_print(",");cl_number(rc as i64);_zag_println("");return -1;
}

fn v92_image_diagnose(image:[]u8)void {
    let magic:i32=0;let version:i32=0;let count:i32=0;let total:i32=0;
    r27s4_get_i32(image,0,&magic);r27s4_get_i32(image,4,&version);r27s4_get_i32(image,8,&count);r27s4_get_i32(image,12,&total);
    _zag_print("V92_IMAGE_HEADER,");cl_number(magic as i64);_zag_print(",");cl_number(version as i64);_zag_print(",");cl_number(count as i64);_zag_print(",");cl_number(total as i64);_zag_println("");
    let expected_offset:i32=V92_PAYLOAD_START;let id:i32=1;
    while(id<=V92_SECTION_COUNT){
        let dir:i32=V92_IMAGE_HEADER_BYTES+(id-1)*V92_DIR_ENTRY_BYTES;let got_id:i32=0;let offset:i32=0;let length:i32=0;
        r27s4_get_i32(image,dir,&got_id);r27s4_get_i32(image,dir+4,&offset);r27s4_get_i32(image,dir+8,&length);
        if(got_id!=id || offset!=expected_offset || length!=r27s4_section_bytes(id)){
            _zag_print("V92_IMAGE_DIR_FAIL,");cl_number(id as i64);_zag_print(",");cl_number(got_id as i64);_zag_print(",");cl_number(offset as i64);_zag_print(",");cl_number(expected_offset as i64);_zag_print(",");cl_number(length as i64);_zag_print(",");cl_number(r27s4_section_bytes(id) as i64);_zag_println("");return;
        }
        let smagic:i32=0;let sversion:i32=0;let sid:i32=0;let scount:i32=0;
        r27s4_get_i32(image,offset,&smagic);r27s4_get_i32(image,offset+4,&sversion);r27s4_get_i32(image,offset+8,&sid);r27s4_get_i32(image,offset+12,&scount);
        if(smagic!=r27s4_magic_value() || sversion!=r27s4_version_value() || sid!=id || scount!=r27s4_expected_count(id)){
            _zag_print("V92_IMAGE_SECTION_HEADER_FAIL,");cl_number(id as i64);_zag_print(",");cl_number(smagic as i64);_zag_print(",");cl_number(r27s4_magic_value() as i64);_zag_print(",");cl_number(sversion as i64);_zag_print(",");cl_number(r27s4_version_value() as i64);_zag_print(",");cl_number(sid as i64);_zag_print(",");cl_number(scount as i64);_zag_println("");return;
        }
        if(r27s4_expected_count(id)==1){let src:i32=r27s4_validate_scalar_section(image[offset..offset+length],id);if(src!=0){_zag_print("V92_IMAGE_SCALAR_FAIL,");cl_number(id as i64);_zag_print(",");cl_number(src as i64);_zag_println("");return;}}
        if(id==V92_PENDING_CREDIT){let prc:i32=r27s4_validate_pending_credit(image[offset..offset+length]);if(prc!=0){_zag_print("V92_IMAGE_PENDING_FAIL,");cl_number(prc as i64);_zag_println("");return;}}
        expected_offset=expected_offset+length;id=id+1;
    }
    _zag_print("V92_IMAGE_END,");cl_number(expected_offset as i64);_zag_print(",");cl_number(image.len as i64);_zag_println("");
}

fn v92_build_image(image:[]u8,section_buf:[]u8,values:[]i32)i32 {
    if(image.len!=r27i4_expected_bytes() || section_buf.len<V92_MAX_SECTION_BYTES || values.len<V92_MAX_VALUES){return v92_build_fail(1,0,-1);}
    let count:i32=0;let next:i32=0;let begin_rc:i32=r27i4_begin(image,&count,&next);if(begin_rc!=0){return v92_build_fail(2,0,begin_rc);}
    let id:i32=1;
    while(id<=V92_SECTION_COUNT){
        let n:i32=r27s4_expected_count(id);let bytes:i32=r27s4_section_bytes(id);
        if(n<0 || bytes<0 || v92_fill(id,values[0..n])!=0){return v92_build_fail(3,id,-1);}
        let encode_rc:i32=r27s4_encode_i32_section(section_buf[0..bytes],id,values[0..n]);if(encode_rc!=0){return v92_build_fail(4,id,encode_rc);}
        let add_rc:i32=r27i4_add(image,&count,&next,id,section_buf[0..bytes]);if(add_rc!=0){return v92_build_fail(5,id,add_rc);}
        id=id+1;
    }
    let finish_rc:i32=r27i4_finish(image,count,next);if(finish_rc!=0){return v92_build_fail(6,0,finish_rc);}
    let check_rc:i32=r27i4_check(image);if(check_rc!=0){v92_image_diagnose(image);return v92_build_fail(7,0,check_rc);}return 0;
}

fn v92_verify_values(image:[]u8,encoded:[]u8,values:[]i32,decoded:[]i32)i32 {
    if(r27i4_check(image)!=0 || encoded.len<V92_MAX_SECTION_BYTES || values.len<V92_MAX_VALUES || decoded.len<V92_MAX_VALUES){return -1;}
    let id:i32=1;
    while(id<=V92_SECTION_COUNT){
        let n:i32=r27s4_expected_count(id);let bytes:i32=r27s4_section_bytes(id);if(n<0 || bytes<0 || v92_fill(id,values[0..n])!=0){return -1;}
        let section:[]u8=r27i4_get(image,id);if(section.len!=bytes){return -1;}
        if(r27s4_encode_i32_section(encoded[0..bytes],id,values[0..n])!=0 || nio_equal(section,encoded[0..bytes])!=1){return -1;}
        if(r27s4_decode_i32_section(section,id,decoded[0..n])!=0){return -1;}
        id=id+1;
    }
    return 0;
}

fn v92_all_sections(section_buf:[]u8,roundtrip_buf:[]u8,values:[]i32,decoded:[]i32)i32 {
    let f:i32=0;let id:i32=1;
    while(id<=V92_SECTION_COUNT){
        let n:i32=r27s4_expected_count(id);let bytes:i32=r27s4_section_bytes(id);
        let count_positive:i32=0;if(n>0){count_positive=1;}
        f=f+v92_check("section_count_positive",count_positive,1);
        let expected_bytes:i32=V92_SECTION_HEADER_BYTES+n*4;
        let bytes_exact:i32=0;if(bytes==expected_bytes){bytes_exact=1;}
        f=f+v92_check("section_bytes_exact",bytes_exact,1);
        if(n>0 && bytes>0){
            f=f+v92_check("section_fill",v92_fill(id,values[0..n]),0);
            f=f+v92_check("section_encode",r27s4_encode_i32_section(section_buf[0..bytes],id,values[0..n]),0);
            f=f+v92_check("section_decode",r27s4_decode_i32_section(section_buf[0..bytes],id,decoded[0..n]),0);
            let reencode_rc:i32=r27s4_encode_i32_section(roundtrip_buf[0..bytes],id,decoded[0..n]);
            f=f+v92_check("section_reencode",reencode_rc,0);
            let bytes_equal:i32=0;if(reencode_rc==0){bytes_equal=nio_equal(section_buf[0..bytes],roundtrip_buf[0..bytes]);}
            f=f+v92_check("section_roundtrip_bytes",bytes_equal,1);
            if(id>=22 && id<=28){
                let mid:i32=n/2;
                f=f+v92_check("trace_first_kat",decoded[0],id*100003-71);
                f=f+v92_check("trace_mid_kat",decoded[mid],id*100003+mid*17-71);
                f=f+v92_check("trace_last_kat",decoded[n-1],id*100003+(n-1)*17-71);
            }
            if(n==1){f=f+v92_check("scalar_semantics",r27s4_validate_scalar_section(section_buf[0..bytes],id),0);}
            if(id==V92_PENDING_CREDIT){f=f+v92_check("pending_semantics",r27s4_validate_pending_credit(section_buf[0..bytes]),0);}
        }
        id=id+1;
    }
    f=f+v92_check("section_id_zero_refused",r27s4_expected_count(0),-1);
    f=f+v92_check("section_id_34_refused",r27s4_expected_count(34),-1);
    return f;
}

fn v92_pending_negative(section_buf:[]u8,values:[]i32)i32 {
    let f:i32=0;let n:i32=V92_PENDING_FIELDS;let bytes:i32=r27s4_section_bytes(V92_PENDING_CREDIT);
    v92_fill(V92_PENDING_CREDIT,values[0..n]);r27s4_encode_i32_section(section_buf[0..bytes],V92_PENDING_CREDIT,values[0..n]);
    r27s4_put_i32(section_buf[0..bytes],16,2);f=f+v92_check("pending_active_range",r27s4_validate_pending_credit(section_buf[0..bytes]),-1);
    r27s4_put_i32(section_buf[0..bytes],16,1);r27s4_put_i32(section_buf[0..bytes],24,8);f=f+v92_check("pending_action_range",r27s4_validate_pending_credit(section_buf[0..bytes]),-1);
    r27s4_put_i32(section_buf[0..bytes],24,3);r27s4_put_i32(section_buf[0..bytes],28,64);f=f+v92_check("pending_entity_range",r27s4_validate_pending_credit(section_buf[0..bytes]),-1);
    r27s4_put_i32(section_buf[0..bytes],28,7);r27s4_put_i32(section_buf[0..bytes],36,1199);f=f+v92_check("pending_due_before_issue",r27s4_validate_pending_credit(section_buf[0..bytes]),-1);
    r27s4_put_i32(section_buf[0..bytes],36,1209);r27s4_put_i32(section_buf[0..bytes],20,-1);f=f+v92_check("pending_active_missing_trace",r27s4_validate_pending_credit(section_buf[0..bytes]),-1);
    v92_fill(V92_PENDING_CREDIT,values[0..n]);r27s4_encode_i32_section(section_buf[0..bytes],V92_PENDING_CREDIT,values[0..n]);
    r27s4_put_i32(section_buf[0..bytes],16,0);r27s4_put_i32(section_buf[0..bytes],20,-1);r27s4_put_i32(section_buf[0..bytes],24,-1);r27s4_put_i32(section_buf[0..bytes],28,-1);r27s4_put_i32(section_buf[0..bytes],32,-1);r27s4_put_i32(section_buf[0..bytes],36,-1);r27s4_put_i32(section_buf[0..bytes],40,-1);r27s4_put_i32(section_buf[0..bytes],44,-1);
    f=f+v92_check("pending_inactive_sentinel",r27s4_validate_pending_credit(section_buf[0..bytes]),0);
    return f;
}

fn v92_image_negative(image:[]u8)i32 {
    let f:i32=0;
    f=f+v92_check("image_size_constant",image.len,245472);
    f=f+v92_check("image_valid",r27i4_check(image),0);
    f=f+v92_check("image_truncation_refused",r27i4_check(image[0..image.len-1]),-1);
    image[0]=image[0]^1;f=f+v92_check("image_magic_corrupt_refused",r27i4_check(image),-1);image[0]=image[0]^1;
    r27s4_put_i32(image,8,32);f=f+v92_check("image_count_corrupt_refused",r27i4_check(image),-1);r27s4_put_i32(image,8,33);
    r27s4_put_i32(image,V92_IMAGE_HEADER_BYTES,2);f=f+v92_check("directory_order_corrupt_refused",r27i4_check(image),-1);r27s4_put_i32(image,V92_IMAGE_HEADER_BYTES,1);
    r27s4_put_i32(image,V92_IMAGE_HEADER_BYTES+4,V92_PAYLOAD_START+4);f=f+v92_check("directory_offset_corrupt_refused",r27i4_check(image),-1);r27s4_put_i32(image,V92_IMAGE_HEADER_BYTES+4,V92_PAYLOAD_START);
    image[V92_PAYLOAD_START]=image[V92_PAYLOAD_START]^1;f=f+v92_check("section_header_corrupt_refused",r27i4_check(image),-1);image[V92_PAYLOAD_START]=image[V92_PAYLOAD_START]^1;
    let dev:[]u8=r27i4_get(image,V92_DEVELOPMENT_STEP);r27s4_put_i32(dev,V92_SECTION_HEADER_BYTES,-1);f=f+v92_check("negative_development_step_refused",r27i4_check(image),-1);r27s4_put_i32(dev,V92_SECTION_HEADER_BYTES,60423);
    let newborn:[]u8=r27i4_get(image,V92_NEWBORN_RESTARTS);r27s4_put_i32(newborn,V92_SECTION_HEADER_BYTES,-1);f=f+v92_check("negative_newborn_refused",r27i4_check(image),-1);r27s4_put_i32(newborn,V92_SECTION_HEADER_BYTES,0);
    let pending:[]u8=r27i4_get(image,V92_PENDING_CREDIT);r27s4_put_i32(pending,36,1199);f=f+v92_check("image_pending_semantics_refused",r27i4_check(image),-1);r27s4_put_i32(pending,36,1209);
    let memory:[]u8=r27i4_get(image,1);memory[V92_SECTION_HEADER_BYTES]=memory[V92_SECTION_HEADER_BYTES]^1;
    f=f+v92_check("opaque_payload_requires_outer_digest",r27i4_check(image),0);memory[V92_SECTION_HEADER_BYTES]=memory[V92_SECTION_HEADER_BYTES]^1;
    f=f+v92_check("image_restored_valid",r27i4_check(image),0);
    return f;
}

fn v92_outer_digest(image:[]u8)i32 {
    let f:i32=0;let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);let filler:[]u8=nio_alloc(4);
    let checkpoint:[]u8=nio_alloc(image.len+1024);
    if(parent.len!=32 || previous.len!=32 || filler.len!=4 || checkpoint.len!=image.len+1024){nio_free(parent);nio_free(previous);nio_free(filler);nio_free(checkpoint);return 1;}
    let i:i32=0;while(i<previous.len){previous[i]=0;i=i+1;}ns_sha256("R33_V92_PARENT_FIXTURE",parent);
    let rc:i32=cl_checkpoint_begin(checkpoint,1,parent,previous);f=f+v92_check("outer_begin",rc,0);
    let at:i32=V92_CL_HEADER_BYTES;if(rc==0){f=f+v92_check("outer_add_image",cl_checkpoint_section(checkpoint,&at,1,image),0);}
    let id:i32=2;while(id<=V92_CL_SECTIONS){filler[0]=id as u8;filler[1]=0;filler[2]=0;filler[3]=0;f=f+v92_check("outer_add_filler",cl_checkpoint_section(checkpoint,&at,id,filler),0);id=id+1;}
    let total:i32=cl_checkpoint_finish(checkpoint,at);let total_positive:i32=0;if(total>0){total_positive=1;}f=f+v92_check("outer_finish_positive",total_positive,1);
    if(total>0){
        f=f+v92_check("outer_digest_valid",cl_checkpoint_check(checkpoint[0..total],parent,previous,1),0);
        let payload_byte:i32=V92_CL_HEADER_BYTES+8+V92_PAYLOAD_START+V92_SECTION_HEADER_BYTES;checkpoint[payload_byte]=checkpoint[payload_byte]^1;
        f=f+v92_check("outer_digest_payload_corruption_refused",cl_checkpoint_check(checkpoint[0..total],parent,previous,1),cl_corrupt());
        checkpoint[payload_byte]=checkpoint[payload_byte]^1;
        f=f+v92_check("outer_digest_restored",cl_checkpoint_check(checkpoint[0..total],parent,previous,1),0);
    }
    nio_free(parent);nio_free(previous);nio_free(filler);nio_free(checkpoint);return f;
}

fn v92_alloc_values()[]i32 {
    let p:*i32=_zag_malloc(V92_MAX_VALUES*4) as *i32;if(p==null as *i32){return p[0..0];}return p[0..V92_MAX_VALUES];
}
fn v92_free_values(v:[]i32)void {if(v.len>0){_zag_free(_zag_slice_ptr(v) as *i8);}}

fn v92_selftest()i32 {
    let section_buf:[]u8=nio_alloc(V92_MAX_SECTION_BYTES);let roundtrip_buf:[]u8=nio_alloc(V92_MAX_SECTION_BYTES);let image:[]u8=nio_alloc(r27i4_expected_bytes());
    let values:[]i32=v92_alloc_values();let decoded:[]i32=v92_alloc_values();let f:i32=0;
    if(section_buf.len!=V92_MAX_SECTION_BYTES || roundtrip_buf.len!=V92_MAX_SECTION_BYTES || image.len!=245472 || values.len!=V92_MAX_VALUES || decoded.len!=V92_MAX_VALUES){return 90;}
    f=f+v92_all_sections(section_buf,roundtrip_buf,values,decoded);f=f+v92_pending_negative(section_buf,values);
    f=f+v92_check("image_build",v92_build_image(image,section_buf,values),0);
    f=f+v92_check("image_all_values",v92_verify_values(image,roundtrip_buf,values,decoded),0);
    f=f+v92_image_negative(image);f=f+v92_outer_digest(image);
    _zag_print("V92_STATE_IMAGE_QUAL_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    nio_free(section_buf);nio_free(roundtrip_buf);nio_free(image);v92_free_values(values);v92_free_values(decoded);if(f!=0){return 1;}return 0;
}

fn v92_write(leaf:[]u8,kind:i32)i32 {
    let section_buf:[]u8=nio_alloc(V92_MAX_SECTION_BYTES);let image:[]u8=nio_alloc(r27i4_expected_bytes());let values:[]i32=v92_alloc_values();
    if(section_buf.len!=V92_MAX_SECTION_BYTES || image.len!=245472 || values.len!=V92_MAX_VALUES){return 90;}
    let rc:i32=v92_build_image(image,section_buf,values);if(rc!=0){return 91;}
    if(kind==1){image[0]=image[0]^1;}
    let root:i64=cl_root(v92_root());if(root<0 || cl_is_status(root)==1){return 92;}
    if(kind==2){rc=cl_file_write(root,leaf,image[0..image.len-1]);}else{rc=cl_file_write(root,leaf,image);}
    nio_close(root);nio_free(section_buf);nio_free(image);v92_free_values(values);
    _zag_print("V92_FRESH_WRITE_STATUS,");_zag_println(_zag_i64_to_str(rc as i64));if(rc!=0){return 1;}return 0;
}

fn v92_read(leaf:[]u8,expect_valid:i32)i32 {
    let image:[]u8=nio_alloc(r27i4_expected_bytes());let expected:[]u8=nio_alloc(r27i4_expected_bytes());let section_buf:[]u8=nio_alloc(V92_MAX_SECTION_BYTES);let values:[]i32=v92_alloc_values();
    if(image.len!=245472 || expected.len!=245472 || section_buf.len!=V92_MAX_SECTION_BYTES || values.len!=V92_MAX_VALUES){return 90;}
    let root:i64=cl_root(v92_root());if(root<0 || cl_is_status(root)==1){return 92;}
    let n:i32=cl_file_read(root,leaf,image);nio_close(root);let f:i32=0;
    if(n<0 || cl_is_status(n)==1){f=f+1;}else{
        if(expect_valid==1){
            f=f+v92_check("fresh_exact_length",n,image.len);
            if(n==image.len){f=f+v92_check("fresh_image_valid",r27i4_check(image),0);f=f+v92_check("fresh_expected_build",v92_build_image(expected,section_buf,values),0);f=f+v92_check("fresh_exact_bytes",nio_equal(image,expected),1);}
        }
        else{f=f+v92_check("fresh_invalid_refused",r27i4_check(image[0..n]),-1);}
    }
    _zag_print("V92_FRESH_READ_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    nio_free(image);nio_free(expected);nio_free(section_buf);v92_free_values(values);if(f!=0){return 1;}return 0;
}

fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"selftest")==1){return v92_selftest();}
    if(_zag_strcmp(mode,"write")==1){return v92_write("state-image.bin",0);}
    if(_zag_strcmp(mode,"read")==1){return v92_read("state-image.bin",1);}
    if(_zag_strcmp(mode,"write-corrupt")==1){return v92_write("corrupt-image.bin",1);}
    if(_zag_strcmp(mode,"read-corrupt")==1){return v92_read("corrupt-image.bin",0);}
    if(_zag_strcmp(mode,"write-truncated")==1){return v92_write("truncated-image.bin",2);}
    if(_zag_strcmp(mode,"read-truncated")==1){return v92_read("truncated-image.bin",0);}
    return 2;
}

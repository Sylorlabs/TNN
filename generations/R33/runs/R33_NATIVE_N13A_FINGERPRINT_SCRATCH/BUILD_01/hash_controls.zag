// Native prospective N13A hash-workspace controls. All expected digests must
// be independently reviewed before registration. No fixture executes at build.
@import("evaluator.zag")

fn h13_filled(b:[]u8,value:u8)i32 {
    let i:i32=0;while(i<b.len){if(b[i]!=value){return 0;}i=i+1;}return 1;
}
fn h13_words_are(b:[]i64,value:i64)i32 {
    let i:i32=0;while(i<b.len){if(b[i]!=value){return 0;}i=i+1;}return 1;
}
fn h13_fill(b:[]u8,value:u8)void {let i:i32=0;while(i<b.len){b[i]=value;i=i+1;}}
fn h13_poison(b:[]i64,value:i64)void {let i:i32=0;while(i<b.len){b[i]=value;i=i+1;}}

fn h13_vector(id:i32,msg:[]u8,length:i32,hex:[]u8,work:[]i64,out:[]u8,s:*P13Stats,w:*TsWork)void {
    if(s.*.failed!=0){return;}
    p13_case(s,"independent-sha-vector",id);
    if(p13_setup_bytes(msg,length,s)!=1){return;}
    let expected:[]u8=p13_hex(hex);let reference:[]u8=nio_alloc(32);
    if(p13_setup_bytes(expected,32,s)!=1 || p13_setup_bytes(reference,32,s)!=1){nio_free(expected);nio_free(reference);return;}
    h13_fill(out,165);h13_poison(work,123456789);
    p13_check(s,"vector_direct_block_status",p13_fingerprint_hash(msg,out[16..48],w,work),0);
    p13_check(s,"vector_independent_literal_digest",nio_equal(out[16..48],expected),1);
    p13_check(s,"vector_prefix_guard",h13_filled(out[0..16],165),1);
    p13_check(s,"vector_suffix_guard",h13_filled(out[48..64],165),1);
    // The old hash is a compatibility check, not the source of the literal oracle.
    p13_check(s,"vector_frozen_sha_status",p13_hash(msg,reference,w),0);
    p13_check(s,"vector_frozen_sha_matches_literal",nio_equal(reference,expected),1);
    nio_free(expected);nio_free(reference);
}
fn h13_hex_vector(id:i32,hex:[]u8,length:i32,digest:[]u8,work:[]i64,out:[]u8,s:*P13Stats,w:*TsWork)void {
    let msg:[]u8=p13_hex(hex);h13_vector(id,msg,length,digest,work,out,s,w);nio_free(msg);
}

fn h13_reset(work:[]i64,out:[]u8,s:*P13Stats,w:*TsWork)void {
    p13_case(s,"reused-workspace-reset",0);
    let abc:[]u8=p13_hex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    let empty:[]u8=p13_hex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    if(p13_setup_bytes(abc,32,s)!=1 || p13_setup_bytes(empty,32,s)!=1){nio_free(abc);nio_free(empty);return;}
    let i:i32=0;while(i<256 && s.*.failed==0){
        let msg:[]u8="abc";let expected:[]u8=abc;if(i%2==1){msg="";expected=empty;}
        h13_poison(work,987654321+i);h13_fill(out,165);
        p13_check(s,"reused_dirty_workspace_status",p13_fingerprint_hash(msg,out[16..48],w,work),0);
        p13_check(s,"reused_dirty_workspace_literal_digest",nio_equal(out[16..48],expected),1);
        p13_check(s,"reused_output_guards",h13_filled(out[0..16],165)+h13_filled(out[48..64],165),2);i=i+1;
    }nio_free(abc);nio_free(empty);
}

fn h13_refusals(pool:[]i64,out:[]u8,s:*P13Stats)void {
    p13_case(s,"scratch-extent-and-alias-refusals",0);let work:[]i64=pool[1..153];
    h13_fill(out,165);h13_poison(pool,95);
    p13_check(s,"short_output_refused",sh13_sha256("abc",out[0..31],work),-7403);
    p13_check(s,"short_workspace_refused",sh13_sha256("abc",out[16..48],work[0..151]),-7403);
    p13_check(s,"overlong_workspace_refused",sh13_sha256("abc",out[16..48],pool[0..153]),-7403);
    p13_check(s,"empty_workspace_refused",sh13_sha256("abc",out[16..48],work[0..0]),-7403);
    p13_check(s,"exact_input_output_alias_refused",sh13_sha256(out[0..32],out[0..32],work),-7401);
    p13_check(s,"partial_input_output_alias_refused",sh13_sha256(out[0..32],out[16..48],work),-7401);
    let raw:[]u8=p13_word_bytes(work);
    p13_check(s,"input_workspace_alias_refused",sh13_sha256(raw[0..3],out[16..48],work),-7401);
    p13_check(s,"output_workspace_alias_refused",sh13_sha256("abc",raw[0..32],work),-7401);
    p13_check(s,"all_invalid_calls_leave_output",h13_filled(out,165),1);
    p13_check(s,"all_invalid_calls_leave_workspace",h13_words_are(pool,95),1);
    let large:[]u8=nio_alloc(33554361);
    if(p13_setup_bytes(large,33554361,s)==1){
        p13_check(s,"overmaximum_message_refused_before_read",sh13_sha256(large,out[16..48],work),-7403);
        p13_check(s,"overmaximum_preserves_output",h13_filled(out,165),1);
        p13_check(s,"overmaximum_preserves_workspace",h13_words_are(pool,95),1);
    }nio_free(large);
    // Adjacent disjoint slices in one owning allocation are valid.
    h13_fill(out,165);out[29]=97;out[30]=98;out[31]=99;
    let expected:[]u8=p13_hex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    if(p13_setup_bytes(expected,32,s)==1){
        p13_check(s,"adjacent_nonoverlap_succeeds",sh13_sha256(out[29..32],out[32..64],work),0);
        p13_check(s,"adjacent_literal_digest",nio_equal(out[32..64],expected),1);
        p13_check(s,"adjacent_input_unchanged",nio_equal(out[29..32],"abc"),1);
        p13_check(s,"adjacent_prefix_guard",h13_filled(out[0..29],165),1);
    }nio_free(expected);
    p13_check(s,"scratch_prefix_guard",pool[0],95);p13_check(s,"scratch_suffix_guard",pool[153],95);
}

fn h13_map_span(p:*ParentMap,id:i32)[]u8 {
    if(id==0){return p.*.input;}if(id==1){return p13_word_bytes(p.*.nodes);}
    if(id==2){return p13_word_bytes(p.*.edges);}if(id==3){return p13_word_bytes(p.*.memo);}
    if(id==4){return p13_word_bytes(p.*.stack);}if(id==5){return p13_word_bytes(p.*.marks);}
    if(id==6){return p13_word_bytes(p.*.globals);}return p13_word_bytes(p.*.hist);
}
fn h13_fingerprints(s:*P13Stats,w:*TsWork)void {
    p13_case(s,"full-input-seven-table-fingerprint-compatibility",0);
    let raw:[]u8=p13_hex("80024b012e");let p:ParentMap=p13_parse(raw,s);
    let reference:[]u8=nio_alloc(256);
    if(p.status!=0 || p13_setup_bytes(reference,256,s)!=1){pm_close(&p);nio_free(raw);nio_free(reference);return;}
    let i:i32=0;let total:i64=0;
    while(i<8){let span:[]u8=h13_map_span(&p,i);total=total+span.len;
        p13_check(s,"frozen_hash_each_fingerprint_span",p13_hash(span,reference[i*32..i*32+32],w),0);i=i+1;}
    let charged:i64=w.*.hash_bytes;let before:[]u8=p13_fingerprint(&p,w);
    p13_check(s,"complete_fingerprint_matches_frozen_sha",nio_equal(before,reference),1);
    p13_check(s,"complete_fingerprint_same_logical_charge",w.*.hash_bytes-charged,total);
    i=0;while(i<8 && s.*.failed==0){let span:[]u8=h13_map_span(&p,i);
        p13_check(s,"mutation_span_nonempty",(span.len>0) as i32,1);if(span.len<1){break;}
        // Isolated integrity witness; no reader/map validation runs while this
        // byte is changed. Restore it before any owner release or next witness.
        let saved:u8=span[0];span[0]=saved^1;let changed:[]u8=p13_fingerprint(&p,w);span[0]=saved;
        p13_check(s,"mutated_fingerprint_complete",changed.len,256);
        if(changed.len==256 && before.len==256){let j:i32=0;while(j<8){let expected:i32=1;if(j==i){expected=0;}
            p13_check(s,"only_corresponding_digest_changes",nio_equal(changed[j*32..j*32+32],before[j*32..j*32+32]),expected);j=j+1;}}
        nio_free(changed);let restored:[]u8=p13_fingerprint(&p,w);
        p13_check(s,"restored_fingerprint_exact",nio_equal(restored,reference),1);nio_free(restored);i=i+1;
    }
    let low:TsWork=ts_work();low.max_hash_bytes=total-1;let denied:[]u8=p13_fingerprint(&p,&low);
    p13_check(s,"partial_fingerprint_not_published_on_budget_failure",denied.len,0);
    p13_check(s,"prior_fingerprint_hash_charges_not_refunded",low.hash_bytes,total-p.*.hist.len*8);
    nio_free(denied);nio_free(before);nio_free(reference);pm_close(&p);nio_free(raw);
}
fn h13_budgets(work:[]i64,out:[]u8,s:*P13Stats)void {
    p13_case(s,"fingerprint-logical-budget-preservation",0);
    let low:TsWork=ts_work();low.max_hash_bytes=2;h13_fill(out,165);h13_poison(work,95);
    p13_check(s,"hash_budget_two_refuses_three",p13_fingerprint_hash("abc",out[16..48],&low,work),-9111);
    p13_check(s,"atomic_charge_no_partial_increment",low.hash_bytes,0);
    p13_check(s,"budget_failure_preserves_output",h13_filled(out,165),1);
    p13_check(s,"budget_failure_preserves_workspace",h13_words_are(work,95),1);
    low.max_hash_bytes=3;
    p13_check(s,"exact_hash_budget_succeeds",p13_fingerprint_hash("abc",out[16..48],&low,work),0);
    p13_check(s,"exact_hash_budget_charged",low.hash_bytes,3);
    p13_check(s,"same_exhausted_account_refuses",p13_fingerprint_hash("abc",out[16..48],&low,work),-9111);
    p13_check(s,"exhausted_hash_budget_not_reset",low.hash_bytes,3);
    let args:TsWork=ts_work();args.max_hash_bytes=3;h13_fill(out,165);h13_poison(work,95);
    p13_check(s,"bad_args_after_charge_refuse",p13_fingerprint_hash("abc",out[0..31],&args,work),-7403);
    p13_check(s,"argument_failure_keeps_charge",args.hash_bytes,3);
    p13_check(s,"argument_failure_preserves_output",h13_filled(out,165),1);
    p13_check(s,"argument_failure_preserves_workspace",h13_words_are(work,95),1);
}

// Native known-answer and boundary tests, not a learner or scientific data.
@import("R33_NATIVE_SHA256_V1.zag")

fn ns_case(name:[]u8,input:[]u8,expected:[]u8)i32 {
    let out:[]u8=nio_alloc(33);out[32]=211;
    let failed:i32=nio_metric(name,ns_sha256(input,out) as i64,0);
    let hex:[]u8=ns_hex(out[0..32]);
    _zag_print("DIGEST,");_zag_print(name);_zag_print(",");_zag_println(hex);
    failed=failed+nio_metric("known_answer",nio_equal(hex,expected) as i64,1);
    failed=failed+nio_metric("digest_tail",out[32] as i64,211);
    nio_free(hex);nio_free(out);return failed;
}
fn main()i32 {
    if(nio_guard(30)!=0){return 3;}
    if(_zag_argc()==5 && _zag_strcmp(_zag_arg(1),"file")==1){
        let root:i64=nio_open_root(_zag_arg(2));if(root<0){return 4;}
        let fd:i64=nio_open_child(root,_zag_arg(3),0);if(fd<0){nio_close(root);return 4;}
        let size:i64=nio_seek(fd,0,2);if(size<0 || size>33554360){nio_close(fd);nio_close(root);return 4;}
        let bytes:[]u8=nio_alloc((size as i32)+1);
        if(nio_read_exact(fd,bytes,size as i32)!=size){nio_close(fd);nio_close(root);nio_free(bytes);return 4;}
        let failed:i32=ns_case("file_identity",bytes[0..size as i32],_zag_arg(4));
        nio_close(fd);nio_close(root);nio_free(bytes);return (failed!=0) as i32;
    }
    if(_zag_argc()!=2 || _zag_strcmp(_zag_arg(1),"check")!=1){return 2;}
    let failed:i32=0;
    failed=failed+ns_case("empty","","e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    failed=failed+ns_case("abc","abc","ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    failed=failed+ns_case("long56","abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq","248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    let zeros:[]u8=nio_alloc(128);
    failed=failed+ns_case("zero55",zeros[0..55],"02779466cdec163811d078815c633f21901413081449002f24aa3e80f0b88ef7");
    failed=failed+ns_case("zero56",zeros[0..56],"d4817aa5497628e7c77e6b606107042bbba3130888c5f47a375e6179be789fbb");
    failed=failed+ns_case("zero63",zeros[0..63],"c7723fa1e0127975e49e62e753db53924c1bd84b8ac1ac08df78d09270f3d971");
    failed=failed+ns_case("zero64",zeros[0..64],"f5a5fd42d16a20302798ef6ed309979b43003d2320d9f0e8ea9831a92759fb4b");
    failed=failed+ns_case("zero65",zeros[0..65],"98ce42deef51d40269d542f5314bef2c7468d401ad5d85168bfab4c0108f75f7");
    failed=failed+ns_case("zero128",zeros,"38723a2e5e8a17aa7950dc008209944e898f69a7bd10a23c839d341e935fd5ca");
    let million:[]u8=nio_alloc(1000000);let i:i32=0;
    while(i<million.len){million[i]=97;i=i+1;}
    failed=failed+ns_case("million_a",million,"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
    nio_free(zeros);nio_free(million);
    let short:[]u8=nio_alloc(31);i=0;while(i<31){short[i]=211;i=i+1;}
    failed=failed+nio_metric("capacity_refusal",ns_sha256("abc",short) as i64,-7403);
    let changes:i32=0;i=0;while(i<31){if(short[i]!=211){changes=changes+1;}i=i+1;}
    failed=failed+nio_metric("rejection_unchanged",changes as i64,0);nio_free(short);
    let alias:[]u8=nio_alloc(33);alias[0]=97;alias[1]=98;alias[2]=99;alias[32]=211;
    failed=failed+nio_metric("overlap_status",ns_sha256(alias[0..3],alias) as i64,0);
    let hex:[]u8=ns_hex(alias[0..32]);
    failed=failed+nio_metric("overlap_identity",nio_equal(hex,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") as i64,1);
    failed=failed+nio_metric("overlap_tail",alias[32] as i64,211);
    nio_free(hex);nio_free(alias);
    _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(failed as i64));
    if(failed!=0){return 1;}_zag_println("N02_NATIVE_SHA256_PASS,35");return 0;
}

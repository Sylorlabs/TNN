// R33-N01P: bounded compiler-interface observations, not supervisor qualification.
// V2 is imported unchanged for its exact named constants; nrv2_run is never called.
@import("R33_NATIVE_PROCESS_V2.zag")

const N01P_LOCAL_I32:i32=-7505;
const N01P_LOCAL_I64:i64=-7505;

fn n01p_return_i32()i32 {return -7505;}
fn n01p_check(name:[]u8,actual:i64,expected:i64,failed:*i32)void {
    failed.*=failed.*+nio_metric(name,actual,expected);
}

fn main()i32 {
    if(_zag_argc()!=2 || _zag_strcmp(_zag_arg(1),"probe")!=1){return 2;}
    if(nio_guard(2)!=0){return 3;}
    // Native one-primary admission. All captured launch logs have registered siblings.
    if(nio_mkdir("Research/R33_NATIVE_N01P_RUN_PRIMARY_V1")!=0){return 4;}
    let failed:i32=0;
    let local:i32=-7505;
    n01p_check("import_i32_negative_implicit",(-7505 as i64),NRV2_NONREGULAR,&failed);
    n01p_check("import_i32_negative_explicit",(-7505 as i64),(NRV2_NONREGULAR as i64),&failed);
    n01p_check("import_i32_zero_implicit",(0 as i64),NRV2_OK,&failed);
    n01p_check("import_i32_zero_explicit",(0 as i64),(NRV2_OK as i64),&failed);
    n01p_check("import_i32_artifact_implicit",(2 as i64),NRV2_ARTIFACT_COMPLETE,&failed);
    n01p_check("import_i32_artifact_explicit",(2 as i64),(NRV2_ARTIFACT_COMPLETE as i64),&failed);
    n01p_check("variable_i32_implicit",(-7505 as i64),local,&failed);
    n01p_check("variable_i32_explicit",(-7505 as i64),(local as i64),&failed);
    n01p_check("local_const_i32_implicit",(-7505 as i64),N01P_LOCAL_I32,&failed);
    n01p_check("local_const_i32_explicit",(-7505 as i64),(N01P_LOCAL_I32 as i64),&failed);
    n01p_check("local_const_i64_implicit",(-7505 as i64),N01P_LOCAL_I64,&failed);
    n01p_check("local_const_i64_explicit",(-7505 as i64),(N01P_LOCAL_I64 as i64),&failed);
    n01p_check("return_i32_implicit",(-7505 as i64),n01p_return_i32(),&failed);
    n01p_check("return_i32_explicit",(-7505 as i64),(n01p_return_i32() as i64),&failed);
    n01p_check("literal_i64",(-7505 as i64),(-7505 as i64),&failed);
    let first:i64=_zag_clock_monotonic_ms();
    let second:i64=_zag_clock_monotonic_ms();
    _zag_print("CLOCK_RETURN_FIRST,");_zag_println(_zag_i64_to_str(first));
    _zag_print("CLOCK_RETURN_SECOND,");_zag_println(_zag_i64_to_str(second));
    _zag_print("CLOCK_NONNEGATIVE_NONDECREASING,");
    _zag_println(_zag_i64_to_str(((first>=0)&&(second>=first)) as i64));
    _zag_print("N01P_WIDTH_MISMATCHES,");_zag_println(_zag_i64_to_str(failed as i64));
    _zag_println("N01P_OBSERVATIONS_COMPLETE,1");
    if(failed!=0){return 1;}return 0;
}

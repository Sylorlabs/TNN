// R34 Phase-5 self-performance model V1.
//
// Generic internal-strategy self-model. Strategy IDs are opaque. The substrate
// receives only learner-visible context features plus delayed experienced
// success/failure and resource cost. It stores two adaptation timescales and
// recent self-prediction error so callers can estimate both expected utility
// and when the self-model itself is unreliable.
//
// No evaluator regime, task name, strategy semantics, oracle strategy,
// counterfactual outcome, consciousness flag, or self-modification authority.

const R34S1_OK:i32=0;
const R34S1_SHAPE:i32=-340501;
const R34S1_NUMERIC:i32=-340502;
const R34S1_RANGE:i32=-340503;

struct R34S1Prediction {
    success:f64,
    cost:f64,
    utility:f64,
    uncertainty:f64,
}

fn r34s1_finite(x:f64)i32 @noalloc { return (x==x && x<1.0e300 && x>(-1.0e300)) as i32; }
fn r34s1_clip(x:f64,lo:f64,hi:f64)f64 @noalloc { if(x<lo){return lo;}if(x>hi){return hi;}return x; }

fn r34s1_zero(weights:[]f32,bias:[]f32,err:[]f32,strategies:i32,feature_dim:i32,prior:f64,error_prior:f64)i32 @noalloc {
    if(strategies<1 || feature_dim<1 || weights.len!=strategies*feature_dim || bias.len!=strategies || err.len!=strategies ||
       r34s1_finite(prior)!=1 || r34s1_finite(error_prior)!=1 || error_prior<0.0){return R34S1_SHAPE;}
    let i:i32=0;while(i<weights.len){weights[i]=0.0;i=i+1;}
    i=0;while(i<strategies){bias[i]=prior as f32;err[i]=error_prior as f32;i=i+1;}return R34S1_OK;
}

fn r34s1_init(success_slow_w:[]f32,success_fast_w:[]f32,cost_slow_w:[]f32,cost_fast_w:[]f32,
    success_slow_b:[]f32,success_fast_b:[]f32,cost_slow_b:[]f32,cost_fast_b:[]f32,
    success_slow_err:[]f32,success_fast_err:[]f32,cost_slow_err:[]f32,cost_fast_err:[]f32,
    counts:[]i64,strategies:i32,feature_dim:i32,success_prior:f64,cost_prior:f64)i32 @noalloc {
    if(counts.len!=strategies){return R34S1_SHAPE;}
    if(r34s1_zero(success_slow_w,success_slow_b,success_slow_err,strategies,feature_dim,success_prior,0.25)!=R34S1_OK){return R34S1_SHAPE;}
    if(r34s1_zero(success_fast_w,success_fast_b,success_fast_err,strategies,feature_dim,success_prior,0.25)!=R34S1_OK){return R34S1_SHAPE;}
    if(r34s1_zero(cost_slow_w,cost_slow_b,cost_slow_err,strategies,feature_dim,cost_prior,0.08)!=R34S1_OK){return R34S1_SHAPE;}
    if(r34s1_zero(cost_fast_w,cost_fast_b,cost_fast_err,strategies,feature_dim,cost_prior,0.08)!=R34S1_OK){return R34S1_SHAPE;}
    let i:i32=0;while(i<counts.len){counts[i]=0;i=i+1;}return R34S1_OK;
}

fn r34s1_linear(weights:[]f32,bias:[]f32,strategy:i32,feature_dim:i32,features:[]f32,out:*f64)i32 @noalloc {
    if(out==null as *f64 || strategy<0 || feature_dim<1 || features.len!=feature_dim || bias.len<=strategy || weights.len<(strategy+1)*feature_dim){return R34S1_SHAPE;}
    let v:f64=bias[strategy] as f64;let j:i32=0;
    while(j<feature_dim){let w:f64=weights[strategy*feature_dim+j] as f64;let x:f64=features[j] as f64;if(r34s1_finite(w)!=1 || r34s1_finite(x)!=1){return R34S1_NUMERIC;}v=v+w*x;j=j+1;}
    if(r34s1_finite(v)!=1){return R34S1_NUMERIC;}out.*=v;return R34S1_OK;
}

fn r34s1_blend(slow:f64,fast:f64,slow_err:f64,fast_err:f64,out:*f64)i32 @noalloc {
    if(out==null as *f64 || slow_err<0.0 || fast_err<0.0 || r34s1_finite(slow)!=1 || r34s1_finite(fast)!=1 || r34s1_finite(slow_err)!=1 || r34s1_finite(fast_err)!=1){return R34S1_SHAPE;}
    let ws:f64=1.0/(slow_err+0.025);let wf:f64=1.0/(fast_err+0.025);out.*=(ws*slow+wf*fast)/(ws+wf);return R34S1_OK;
}

fn r34s1_predict(success_slow_w:[]f32,success_fast_w:[]f32,cost_slow_w:[]f32,cost_fast_w:[]f32,
    success_slow_b:[]f32,success_fast_b:[]f32,cost_slow_b:[]f32,cost_fast_b:[]f32,
    success_slow_err:[]f32,success_fast_err:[]f32,cost_slow_err:[]f32,cost_fast_err:[]f32,
    strategy:i32,feature_dim:i32,features:[]f32,out:*R34S1Prediction)i32 @noalloc {
    if(out==null as *R34S1Prediction || strategy<0 || success_slow_err.len<=strategy || success_fast_err.len<=strategy || cost_slow_err.len<=strategy || cost_fast_err.len<=strategy){return R34S1_SHAPE;}
    let ps:f64=0.0;let pf:f64=0.0;let cs:f64=0.0;let cf:f64=0.0;
    if(r34s1_linear(success_slow_w,success_slow_b,strategy,feature_dim,features,&ps)!=R34S1_OK || r34s1_linear(success_fast_w,success_fast_b,strategy,feature_dim,features,&pf)!=R34S1_OK || r34s1_linear(cost_slow_w,cost_slow_b,strategy,feature_dim,features,&cs)!=R34S1_OK || r34s1_linear(cost_fast_w,cost_fast_b,strategy,feature_dim,features,&cf)!=R34S1_OK){return R34S1_SHAPE;}
    let p:f64=0.0;let c:f64=0.0;if(r34s1_blend(ps,pf,success_slow_err[strategy] as f64,success_fast_err[strategy] as f64,&p)!=R34S1_OK || r34s1_blend(cs,cf,cost_slow_err[strategy] as f64,cost_fast_err[strategy] as f64,&c)!=R34S1_OK){return R34S1_NUMERIC;}
    let pp:f64=r34s1_clip(p,0.0,1.0);let cc:f64=r34s1_clip(c,0.0,1.0);
    let unc:f64=0.5*((success_slow_err[strategy] as f64)+(success_fast_err[strategy] as f64))+0.75*((cost_slow_err[strategy] as f64)+(cost_fast_err[strategy] as f64));
    out.*=R34S1Prediction{.success=pp,.cost=cc,.utility=pp-cc,.uncertainty=unc};return R34S1_OK;
}

fn r34s1_update_head(weights:[]f32,bias:[]f32,err_state:[]f32,strategy:i32,feature_dim:i32,features:[]f32,
    target:f64,learning_rate:f64,error_rate:f64)i32 @noalloc {
    if(strategy<0 || feature_dim<1 || features.len!=feature_dim || bias.len<=strategy || err_state.len<=strategy || weights.len<(strategy+1)*feature_dim ||
       learning_rate<0.0 || learning_rate>1.0 || error_rate<0.0 || error_rate>1.0 || r34s1_finite(target)!=1){return R34S1_SHAPE;}
    let pred:f64=0.0;if(r34s1_linear(weights,bias,strategy,feature_dim,features,&pred)!=R34S1_OK){return R34S1_NUMERIC;}
    let e:f64=target-pred;let ae:f64=if(e<0.0){-e}else{e};let next_err:f64=(1.0-error_rate)*(err_state[strategy] as f64)+error_rate*ae;
    bias[strategy]=((bias[strategy] as f64)+learning_rate*e) as f32;let j:i32=0;
    while(j<feature_dim){let i:i32=strategy*feature_dim+j;let next:f64=(weights[i] as f64)+learning_rate*e*(features[j] as f64);if(r34s1_finite(next)!=1){return R34S1_NUMERIC;}weights[i]=next as f32;j=j+1;}
    err_state[strategy]=next_err as f32;return R34S1_OK;
}

// Apply one delayed self-outcome for a chosen opaque strategy. Counterfactual
// strategy outcomes are deliberately absent.
fn r34s1_delayed_outcome(success_slow_w:[]f32,success_fast_w:[]f32,cost_slow_w:[]f32,cost_fast_w:[]f32,
    success_slow_b:[]f32,success_fast_b:[]f32,cost_slow_b:[]f32,cost_fast_b:[]f32,
    success_slow_err:[]f32,success_fast_err:[]f32,cost_slow_err:[]f32,cost_fast_err:[]f32,counts:[]i64,
    strategy:i32,feature_dim:i32,features:[]f32,success:i32,cost:f64,
    slow_rate:f64,fast_rate:f64,slow_error_rate:f64,fast_error_rate:f64)i32 @noalloc {
    if(strategy<0 || strategy>=counts.len || (success!=0 && success!=1) || cost<0.0 || r34s1_finite(cost)!=1){return R34S1_SHAPE;}
    if(r34s1_update_head(success_slow_w,success_slow_b,success_slow_err,strategy,feature_dim,features,success as f64,slow_rate,slow_error_rate)!=R34S1_OK){return R34S1_NUMERIC;}
    if(r34s1_update_head(success_fast_w,success_fast_b,success_fast_err,strategy,feature_dim,features,success as f64,fast_rate,fast_error_rate)!=R34S1_OK){return R34S1_NUMERIC;}
    if(r34s1_update_head(cost_slow_w,cost_slow_b,cost_slow_err,strategy,feature_dim,features,cost,slow_rate,slow_error_rate)!=R34S1_OK){return R34S1_NUMERIC;}
    if(r34s1_update_head(cost_fast_w,cost_fast_b,cost_fast_err,strategy,feature_dim,features,cost,fast_rate,fast_error_rate)!=R34S1_OK){return R34S1_NUMERIC;}
    counts[strategy]=counts[strategy]+1;return R34S1_OK;
}

fn r34s1_state_equal(a:[]f32,b:[]f32)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn r34s1_counts_equal(a:[]i64,b:[]i64)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}

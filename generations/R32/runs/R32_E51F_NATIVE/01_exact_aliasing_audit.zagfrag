// R32 E51F exact learner-visible terminal state aliasing audit.
// Hashing is indexing only; feature-by-feature equality defines identity.

const E51F_EPISODES:i32=5400;
const E51F_STATES:i32=91800;
const E51F_MODELS:i32=2;
const E51F_CAP:i32=131071;

fn e51f_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    seeds:[]i32
)i32 {
    e45_zero(seeds,E51F_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(
                        raw_seen,evidence_seen,resource_seen,33,index,mode,resource,&failures
                    );
                    seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51f_seed_manifest_emitted",emitted);
    e45_print_pair("e51f_seed_assignment_failures",failures);
    if(failures==0 && emitted==E51F_EPISODES){ return 1; }
    return 0;
}

fn e51f_feature_hash(features:[]i32)i32 {
    let h:i32=17;
    let f:i32=0;
    while(f<E45_FEATURES){
        let v:i32=r32e45_abs(features[f])%E51F_CAP;
        let weight:i32=f*97+31;
        h=(h+v*weight+f*13+7)%E51F_CAP;
        f=f+1;
    }
    return h;
}

fn e51f_key_equal(keys:[]i32,slot:i32,features:[]i32)i32 {
    let start:i32=slot*E45_FEATURES;
    let f:i32=0;
    while(f<E45_FEATURES){
        if(keys[start+f]!=features[f]){ return 0; }
        f=f+1;
    }
    return 1;
}

fn e51f_store_key(keys:[]i32,slot:i32,features:[]i32)void {
    let start:i32=slot*E45_FEATURES;
    let f:i32=0;
    while(f<E45_FEATURES){
        keys[start+f]=features[f];
        f=f+1;
    }
}

fn e51f_insert(
    used:[]i32,
    keys:[]i32,
    action_possible:[]i32,
    record_count:[]i32,
    known_count:[]i32,
    no_unique_count:[]i32,
    features:[]i32,
    optimal:[]i32,
    is_no_unique:i32,
    occupied:*i32,
    probe_total:*i32,
    max_probe:*i32,
    table_full:*i32
)void {
    let slot:i32=e51f_feature_hash(features);
    let probe:i32=0;
    while(probe<E51F_CAP){
        if(used[slot]==0){
            used[slot]=1;
            e51f_store_key(keys,slot,features);
            let a:i32=0;
            while(a<4){ action_possible[slot*4+a]=optimal[a]; a=a+1; }
            record_count[slot]=1;
            if(is_no_unique==1){ no_unique_count[slot]=1; }else{ known_count[slot]=1; }
            occupied.*=occupied.*+1;
            probe_total.*=probe_total.*+probe;
            if(probe>max_probe.*){ max_probe.*=probe; }
            return;
        }
        if(e51f_key_equal(keys,slot,features)==1){
            let a:i32=0;
            while(a<4){
                if(optimal[a]==0){ action_possible[slot*4+a]=0; }
                a=a+1;
            }
            record_count[slot]=record_count[slot]+1;
            if(is_no_unique==1){ no_unique_count[slot]=no_unique_count[slot]+1;
            }else{ known_count[slot]=known_count[slot]+1; }
            probe_total.*=probe_total.*+probe;
            if(probe>max_probe.*){ max_probe.*=probe; }
            return;
        }
        slot=slot+1;
        if(slot==E51F_CAP){ slot=0; }
        probe=probe+1;
    }
    table_full.*=table_full.*+1;
}

fn e51f_build_model_features(
    model:i32,
    states:[]i32,
    state_start:i32,
    option:[]i32,
    resource_features:[]i32,
    hazard:[]i32,
    immediate_a:i32,
    immediate_b:i32,
    learned_shadow:i32,
    terminal_option:[]i32,
    full_features:[]i32,
    baseline_features:[]i32,
    model_features:[]i32
)void {
    e45_terminal_projection(option,terminal_option);
    e45_fill_full_features(
        states,state_start,terminal_option,0,resource_features,hazard,
        immediate_a,immediate_b,learned_shadow,full_features
    );
    e45_mask_features(full_features,E45_ARM_D,baseline_features);
    let co_viability:i32=0;
    let contradiction_co_mass:i32=0;
    e47_terminal_representation(
        states,state_start,terminal_option,0,&co_viability,&contradiction_co_mass
    );
    e50_build_model_features(
        baseline_features,0,co_viability,contradiction_co_mass,
        model,model_features,0
    );
}

fn e51f_audit_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    model:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    used:[]i32,
    keys:[]i32,
    action_possible:[]i32,
    record_count:[]i32,
    known_count:[]i32,
    no_unique_count:[]i32,
    occupied:*i32,
    probe_total:*i32,
    max_probe:*i32,
    table_full:*i32,
    audited_states:*i32,
    known_states:*i32,
    no_unique_states:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let values:[]i32=zalloc_i(4);
    let optimal:[]i32=zalloc_i(4);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);

    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e51f_build_model_features(
            model,states,t*E45_STATE_N,option,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,
            terminal_option,full_features,baseline_features,model_features
        );
        let best:i32=-3000;
        let a:i32=0;
        while(a<4){
            values[a]=e45_terminal_value(a,states,t*E45_STATE_N,initial_state,truth_state[t]);
            if(values[a]>best){ best=values[a]; }
            a=a+1;
        }
        a=0;
        while(a<4){
            optimal[a]=0;
            if(values[a]==best){ optimal[a]=1; }
            a=a+1;
        }
        let is_no_unique:i32=0;
        if(truth_state[t]<0){ is_no_unique=1; no_unique_states.*=no_unique_states.*+1;
        }else{ known_states.*=known_states.*+1; }
        e51f_insert(
            used,keys,action_possible,record_count,known_count,no_unique_count,
            model_features,optimal,is_no_unique,occupied,probe_total,max_probe,table_full
        );
        audited_states.*=audited_states.*+1;

        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features); zfree(model_features);
    zfree(values); zfree(optimal);
}

fn e51f_summarize(
    model:i32,
    used:[]i32,
    action_possible:[]i32,
    record_count:[]i32,
    known_count:[]i32,
    no_unique_count:[]i32,
    occupied:i32,
    audited_states:i32,
    known_states:i32,
    no_unique_states:i32,
    probe_total:i32,
    max_probe:i32,
    table_full:i32
)i32 {
    let alias_groups:i32=0;
    let alias_records:i32=0;
    let conflict_groups:i32=0;
    let conflict_records:i32=0;
    let cross_class_groups:i32=0;
    let cross_class_conflict_groups:i32=0;
    let conflict_known_records:i32=0;
    let conflict_no_unique_records:i32=0;
    let largest_group:i32=0;
    let slot:i32=0;
    while(slot<E51F_CAP){
        if(used[slot]==1){
            let n:i32=record_count[slot];
            if(n>largest_group){ largest_group=n; }
            if(n>1){ alias_groups=alias_groups+1; alias_records=alias_records+n; }
            let possible:i32=0;
            let a:i32=0;
            while(a<4){ possible=possible+action_possible[slot*4+a]; a=a+1; }
            let cross:i32=0;
            if(known_count[slot]>0 && no_unique_count[slot]>0){ cross=1; cross_class_groups=cross_class_groups+1; }
            if(possible==0){
                conflict_groups=conflict_groups+1;
                conflict_records=conflict_records+n;
                conflict_known_records=conflict_known_records+known_count[slot];
                conflict_no_unique_records=conflict_no_unique_records+no_unique_count[slot];
                if(cross==1){ cross_class_conflict_groups=cross_class_conflict_groups+1; }
            }
        }
        slot=slot+1;
    }
    _zag_print("e51f_alias_summary,"); e45_print_i32(model); _zag_print(",");
    e45_print_i32(audited_states); _zag_print(","); e45_print_i32(known_states); _zag_print(","); e45_print_i32(no_unique_states); _zag_print(",");
    e45_print_i32(occupied); _zag_print(","); e45_print_i32(alias_groups); _zag_print(","); e45_print_i32(alias_records); _zag_print(",");
    e45_print_i32(conflict_groups); _zag_print(","); e45_print_i32(conflict_records); _zag_print(",");
    e45_print_i32(cross_class_groups); _zag_print(","); e45_print_i32(cross_class_conflict_groups); _zag_print(",");
    e45_print_i32(conflict_known_records); _zag_print(","); e45_print_i32(conflict_no_unique_records); _zag_print(",");
    e45_print_i32(largest_group); _zag_print(","); e45_print_i32(probe_total); _zag_print(","); e45_print_i32(max_probe); _zag_print(","); e45_print_i32(table_full); _zag_println("");
    if(table_full==0){ return 1; }
    return 0;
}

fn e51f_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51F_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51f_exact_terminal_state_aliasing_audit_v1");
    _zag_println("claim_boundary,native_causal_audit_not_promotion");
    _zag_println("epistemic_isolation=1");
    _zag_println("evaluator_truth_policy_input=0");
    _zag_println("hash_defines_identity=0");
    _zag_println("exact_feature_equality_defines_identity=1");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");
    _zag_println("e51f_alias_summary_columns,model,audited_states,known_states,no_unique_states,unique_keys,alias_groups,alias_records,conflict_groups,conflict_records,cross_class_groups,cross_class_conflict_groups,conflict_known_records,conflict_no_unique_records,largest_group,probe_total,max_probe,table_full");

    let seeds:[]i32=zalloc_i(E51F_EPISODES);
    let seed_gate:i32=e51f_allocate_seeds(raw_seen,evidence_seen,resource_seen,seeds);
    let overall_integrity:i32=seed_gate;
    let any_conflict:i32=0;
    let any_cross_class_conflict:i32=0;

    let model:i32=0;
    while(model<E51F_MODELS){
        let used:[]i32=zalloc_i(E51F_CAP);
        let keys:[]i32=zalloc_i(E51F_CAP*E45_FEATURES);
        let action_possible:[]i32=zalloc_i(E51F_CAP*4);
        let record_count:[]i32=zalloc_i(E51F_CAP);
        let known_count:[]i32=zalloc_i(E51F_CAP);
        let no_unique_count:[]i32=zalloc_i(E51F_CAP);
        e45_zero(used,E51F_CAP); e45_zero(keys,E51F_CAP*E45_FEATURES); e45_zero(action_possible,E51F_CAP*4);
        e45_zero(record_count,E51F_CAP); e45_zero(known_count,E51F_CAP); e45_zero(no_unique_count,E51F_CAP);
        let occupied:i32=0; let probe_total:i32=0; let max_probe:i32=0; let table_full:i32=0;
        let audited_states:i32=0; let known_states:i32=0; let no_unique_states:i32=0;

        let base_index:i32=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<20){
                        let index:i32=e46_validation_index(base_index,mode,resource,episode);
                        e51f_audit_episode(
                            seeds[index],mode,resource,model,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,
                            used,keys,action_possible,record_count,known_count,no_unique_count,
                            &occupied,&probe_total,&max_probe,&table_full,
                            &audited_states,&known_states,&no_unique_states
                        );
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        let integrity:i32=e51f_summarize(
            model,used,action_possible,record_count,known_count,no_unique_count,
            occupied,audited_states,known_states,no_unique_states,probe_total,max_probe,table_full
        );
        if(integrity==0 || audited_states!=E51F_STATES){ overall_integrity=0; }

        // Repeat the final scan only for the two causal booleans used to route the next experiment.
        let slot:i32=0;
        while(slot<E51F_CAP){
            if(used[slot]==1){
                let possible:i32=0; let a:i32=0;
                while(a<4){ possible=possible+action_possible[slot*4+a]; a=a+1; }
                if(possible==0){
                    any_conflict=1;
                    if(known_count[slot]>0 && no_unique_count[slot]>0){ any_cross_class_conflict=1; }
                }
            }
            slot=slot+1;
        }

        zfree(used); zfree(keys); zfree(action_possible); zfree(record_count); zfree(known_count); zfree(no_unique_count);
        model=model+1;
    }

    e45_print_pair("e51f_any_exact_conflict",any_conflict);
    e45_print_pair("e51f_any_cross_class_exact_conflict",any_cross_class_conflict);
    e45_print_pair("e51f_execution_integrity_gate",overall_integrity);
    if(overall_integrity==1){
        if(any_cross_class_conflict==1){ _zag_println("e51f_outcome,EXACT_CROSS_CLASS_ALIASING_PROVEN");
        }else{
            if(any_conflict==1){ _zag_println("e51f_outcome,EXACT_ALIASING_WITHOUT_CROSS_CLASS_CONFLICT");
            }else{ _zag_println("e51f_outcome,NO_EXACT_ALIASING_FOUND_TEST_VALUE_FUNCTION_CAPACITY_NEXT"); }
        }
    }else{ _zag_println("e51f_outcome,AUDIT_INTEGRITY_FAILURE"); }
    zfree(seeds);
    return overall_integrity;
}

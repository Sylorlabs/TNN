    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let terminal_policy:[]i32=zalloc_i(E51B_MODELS*(E45_TAPE+1));
    let recursive_best:[]i32=zalloc_i(E51B_MODELS*(E45_TAPE+1));

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);
    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);

    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        let model:i32=0;
        while(model<E51B_MODELS){
            let choice:i32=e51b_terminal_choice(
                model,states,t*E45_STATE_N,option,resource_features,hazard,
                immediate_a,immediate_b,learned_shadow,
                terminal_weights,terminal_biases,terminal_option,full_features,
                masked_features,model_features,scores
            );
            terminal_policy[model*(E45_TAPE+1)+t]=e45_terminal_value(
                choice,states,t*E45_STATE_N,initial_state,truth_state[t]
            );
            model=model+1;
        }
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    let model:i32=0;
    while(model<E51B_MODELS){
        let base:i32=model*(E45_TAPE+1);
        recursive_best[base+E45_TAPE]=terminal_policy[base+E45_TAPE];
        let rt:i32=E45_TAPE-1;
        while(rt>=0){
            recursive_best[base+rt]=terminal_policy[base+rt];
            if(feasible[rt]==1){
                let continue_return:i32=0-losses[rt]+recursive_best[base+rt+1];
                recursive_best[base+rt]=r32e45_max(terminal_policy[base+rt],continue_return);
            }
            rt=rt-1;
        }
        model=model+1;
    }

    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    t=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e51b_continuation_features(
            states,t*E45_STATE_N,option,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,
            full_features,masked_features,continuation_features
        );
        let record_number:i32=canonical_episode*(E45_TAPE+1)+t;
        let record_start:i32=record_number*E50_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            continuation_records[record_start+feature]=continuation_features[feature];
            feature=feature+1;
        }
        // e50_batch_column maps feature 3/5 through record 32/33.
        continuation_records[record_start+32]=continuation_features[3];
        continuation_records[record_start+33]=continuation_features[5];
        let model:i32=0;
        while(model<E51B_MODELS){
            let target:i32=-3000;
            if(t<E45_TAPE && feasible[t]==1){
                let base:i32=model*(E45_TAPE+1);
                target=r32e45_clamp(
                    0-losses[t]+recursive_best[base+t+1]-terminal_policy[base+t],
                    -3000,3000
                );
            }
            continuation_records[record_start+34+model]=target;
            if(target>0){ target_positive[model]=target_positive[model]+1;
            }else{
                if(target<0){ target_negative[model]=target_negative[model]+1;
                }else{ target_zero[model]=target_zero[model]+1; }
            }
            model=model+1;
        }
        continuation_records[record_start+36]=0;
        continuation_records[record_start+37]=0;
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(masked_features); zfree(model_features);
    zfree(continuation_features); zfree(scores); zfree(terminal_policy); zfree(recursive_best);
}

fn e51b_cell_offset(model:i32,base_index:i32,mode:i32,resource:i32)i32 {
    return (((model*6+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*E51B_CELL_FIELDS;
}

fn e51b_record_outcome(
    metrics:[]i32,
    metrics_start:i32,
    choice:i32,
    utility:i32,
    truth:i32,
    observations:i32,
    opportunity_loss:i32
)void {
    metrics[metrics_start+E51B_M_EPISODES]=metrics[metrics_start+E51B_M_EPISODES]+1;
    metrics[metrics_start+E51B_M_OBSERVATIONS]=metrics[metrics_start+E51B_M_OBSERVATIONS]+observations;
    metrics[metrics_start+E51B_M_OPPORTUNITY_LOSS]=metrics[metrics_start+E51B_M_OPPORTUNITY_LOSS]+opportunity_loss;
    metrics[metrics_start+E51B_M_UTILITY]=metrics[metrics_start+E51B_M_UTILITY]+utility;
    if(observations>0){ metrics[metrics_start+E51B_M_CONTINUED]=metrics[metrics_start+E51B_M_CONTINUED]+1; }
    if(truth<0){
        metrics[metrics_start+E51B_M_NO_UNIQUE]=metrics[metrics_start+E51B_M_NO_UNIQUE]+1;
        if(choice==R32E45_TERM_UNKNOWN){
            metrics[metrics_start+E51B_M_SUCCESS]=metrics[metrics_start+E51B_M_SUCCESS]+1;
            metrics[metrics_start+E51B_M_UNKNOWN]=metrics[metrics_start+E51B_M_UNKNOWN]+1;
            metrics[metrics_start+E51B_M_NO_UNIQUE_UNKNOWN]=metrics[metrics_start+E51B_M_NO_UNIQUE_UNKNOWN]+1;
        }else{
            metrics[metrics_start+E51B_M_WRONG]=metrics[metrics_start+E51B_M_WRONG]+1;
            metrics[metrics_start+E51B_M_NO_UNIQUE_WRONG]=metrics[metrics_start+E51B_M_NO_UNIQUE_WRONG]+1;
        }
    }else{
        metrics[metrics_start+E51B_M_KNOWN]=metrics[metrics_start+E51B_M_KNOWN]+1;
        if(choice==R32E45_TERM_UNKNOWN){
            metrics[metrics_start+E51B_M_UNKNOWN]=metrics[metrics_start+E51B_M_UNKNOWN]+1;
        }else{
            if(utility+opportunity_loss==1000){
                metrics[metrics_start+E51B_M_SUCCESS]=metrics[metrics_start+E51B_M_SUCCESS]+1;
                metrics[metrics_start+E51B_M_KNOWN_SUCCESS]=metrics[metrics_start+E51B_M_KNOWN_SUCCESS]+1;
            }else{
                metrics[metrics_start+E51B_M_WRONG]=metrics[metrics_start+E51B_M_WRONG]+1;
                metrics[metrics_start+E51B_M_KNOWN_WRONG]=metrics[metrics_start+E51B_M_KNOWN_WRONG]+1;
            }
        }
    }
}

fn e51b_validate_episode(
    seed:i32,
    base_index:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    continuation_weights:[]i32,
    continuation_biases:[]i32,
    control_aggregate:[]i32,
    sequential_aggregate:[]i32,
    cell_metrics:[]i32,
    stop_histogram:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);

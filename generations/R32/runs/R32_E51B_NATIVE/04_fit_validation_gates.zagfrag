    while(model<E51B_MODELS){
        if(target_positive[model]==0 || target_negative[model]==0){ target_interior_gate=0; }
        model=model+1;
    }
    e45_print_pair("e51b_target_interior_gate",target_interior_gate);

    let stats_gate:i32=1;
    let fit_gate:i32=1;
    model=0;
    while(model<E51B_MODELS){
        e45_zero(gram_forward,E50_BATCH_GRAM); e45_zero(gram_reverse,E50_BATCH_GRAM);
        e45_zero(cross_forward,E50_BATCH_CROSS); e45_zero(cross_reverse,E50_BATCH_CROSS);
        let count_forward:i32=0; let count_reverse:i32=0; let hash_forward:i32=211+model; let hash_reverse:i32=211+model;
        e50_build_batch_statistics(continuation_records,0,0,gram_forward,cross_forward,&count_forward,&hash_forward);
        e50_build_batch_statistics(continuation_records,0,1,gram_reverse,cross_reverse,&count_reverse,&hash_reverse);
        if(count_forward!=E51B_SAMPLES || count_reverse!=E51B_SAMPLES || e50_batch_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0 || hash_forward!=hash_reverse){ stats_gate=0; }
        let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0; let loss_low_forward:i32=0; let loss_high_forward:i32=0;
        e50_batch_fit(
            continuation_records,0,model,gram_forward,cross_forward,
            continuation_weights,continuation_biases,backup_weights,backup_biases,
            &steps_forward,&reason_forward,&trace_forward,&loss_low_forward,&loss_high_forward
        );
        let action:i32=0;
        while(action<4){
            forward_copy_biases[model*4+action]=continuation_biases[model*4+action];
            let feature:i32=0;
            while(feature<E45_FEATURES){
                forward_copy_weights[(model*4+action)*E45_FEATURES+feature]=continuation_weights[(model*4+action)*E45_FEATURES+feature];
                feature=feature+1;
            }
            action=action+1;
        }
        action=0;
        while(action<4){
            continuation_biases[model*4+action]=0;
            let feature:i32=0;
            while(feature<E45_FEATURES){ continuation_weights[(model*4+action)*E45_FEATURES+feature]=0; feature=feature+1; }
            action=action+1;
        }
        let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0; let loss_low_reverse:i32=0; let loss_high_reverse:i32=0;
        e50_batch_fit(
            continuation_records,0,model,gram_reverse,cross_reverse,
            continuation_weights,continuation_biases,backup_weights,backup_biases,
            &steps_reverse,&reason_reverse,&trace_reverse,&loss_low_reverse,&loss_high_reverse
        );
        action=0;
        while(action<4){
            if(continuation_biases[model*4+action]!=forward_copy_biases[model*4+action]){ fit_gate=0; }
            let feature:i32=0;
            while(feature<E45_FEATURES){
                if(continuation_weights[(model*4+action)*E45_FEATURES+feature]!=forward_copy_weights[(model*4+action)*E45_FEATURES+feature]){ fit_gate=0; }
                feature=feature+1;
            }
            action=action+1;
        }
        if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || loss_low_forward!=loss_low_reverse || loss_high_forward!=loss_high_reverse){ fit_gate=0; }
        _zag_print("e51b_batch_fit,"); e45_print_i32(model); _zag_print(","); e45_print_i32(steps_forward); _zag_print(","); e45_print_i32(reason_forward); _zag_print(","); e45_print_i32(trace_forward); _zag_println("");
        model=model+1;
    }
    e45_print_pair("e51b_batch_statistics_gate",stats_gate);
    e45_print_pair("e51b_batch_forward_reverse_identity_gate",fit_gate);

    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51b_validate_episode(
                        validation_seeds[index],base_index,mode,resource,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                        continuation_weights,continuation_biases,
                        control_aggregate,sequential_aggregate,cell_metrics,stop_histogram
                    );
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }

    _zag_println("e51b_aggregate_columns,policy_0_control_1_sequential,model,episodes,success,unknown,wrong,known,no_unique,observations,opportunity_loss,utility,continued,known_success,known_wrong,no_unique_unknown,no_unique_wrong");
    model=0;
    while(model<E51B_MODELS){
        let policy:i32=0;
        while(policy<2){
            let metrics:[]i32=control_aggregate;
            if(policy==1){ metrics=sequential_aggregate; }
            let start:i32=model*E51B_AGG_FIELDS;
            _zag_print("e51b_aggregate,"); e45_print_i32(policy); _zag_print(","); e45_print_i32(model); _zag_print(",");
            let k:i32=0;
            while(k<E51B_AGG_FIELDS){ e45_print_i32(metrics[start+k]); if(k+1<E51B_AGG_FIELDS){ _zag_print(","); } k=k+1; }
            _zag_println("");
            policy=policy+1;
        }
        model=model+1;
    }

    let no_unique_model_gates:[]i32=zalloc_i(E51B_MODELS);
    model=0;
    while(model<E51B_MODELS){
        no_unique_model_gates[model]=1;
        let base:i32=0;
        while(base<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let cell:i32=e51b_cell_offset(model,base,mode,resource);
                    if(cell_metrics[cell+1]>0){
                        if(cell_metrics[cell+3]>0 || cell_metrics[cell+2]!=cell_metrics[cell+1]){ no_unique_model_gates[model]=0; }
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base=base+1;
        }
        _zag_print("e51b_no_unique_every_cell_safety_gate,"); e45_print_i32(model); _zag_print(","); e45_print_i32(no_unique_model_gates[model]); _zag_println("");
        model=model+1;
    }

    _zag_println("e51b_stop_histogram_columns,model,observations,count");
    model=0;
    while(model<E51B_MODELS){
        let observations:i32=0;
        while(observations<=E45_TAPE){
            _zag_print("e51b_stop_histogram,"); e45_print_i32(model); _zag_print(","); e45_print_i32(observations); _zag_print(","); e45_print_i32(stop_histogram[model*(E45_TAPE+1)+observations]); _zag_println("");
            observations=observations+1;
        }
        model=model+1;
    }

    // M0 is the preregistered primary safety authority because E50 M0 was the
    // safer no-unique terminal control. M1 remains a paired secondary result.
    let primary:i32=0;
    let cs:i32=primary*E51B_AGG_FIELDS;
    let behavior_gate:i32=0;
    if(sequential_aggregate[cs+E51B_M_CONTINUED]>0 && sequential_aggregate[cs+E51B_M_CONTINUED]<sequential_aggregate[cs+E51B_M_EPISODES]){ behavior_gate=1; }
    let utility_gate:i32=0;
    if(sequential_aggregate[cs+E51B_M_UTILITY]>control_aggregate[cs+E51B_M_UTILITY]){ utility_gate=1; }
    let aggregate_safety_gate:i32=0;
    if(sequential_aggregate[cs+E51B_M_NO_UNIQUE_WRONG]<=control_aggregate[cs+E51B_M_NO_UNIQUE_WRONG] && sequential_aggregate[cs+E51B_M_KNOWN_SUCCESS]>=control_aggregate[cs+E51B_M_KNOWN_SUCCESS] && sequential_aggregate[cs+E51B_M_KNOWN_WRONG]<=control_aggregate[cs+E51B_M_KNOWN_WRONG]){ aggregate_safety_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate+sample_gate+target_interior_gate+stats_gate+fit_gate==5){ integrity_gate=1; }
    let e51b_gate:i32=0;
    if(integrity_gate==1 && behavior_gate==1 && utility_gate==1 && aggregate_safety_gate==1 && no_unique_model_gates[0]==1){ e51b_gate=1; }
    e45_print_pair("e51b_integrity_gate",integrity_gate);
    e45_print_pair("e51b_nontrivial_behavior_gate",behavior_gate);
    e45_print_pair("e51b_net_utility_gate",utility_gate);
    e45_print_pair("e51b_aggregate_noninferiority_gate",aggregate_safety_gate);
    e45_print_pair("e51b_confirmation_earned",e51b_gate);
    if(e51b_gate==1){ _zag_println("e51b_outcome,VALIDATION_PASS_CONFIRMATION_EARNED");
    }else{ _zag_println("e51b_outcome,NO_VALIDATED_SEQUENTIAL_RESCUE"); }
    if(e51b_gate==1){ _zag_println("TNN_R32_E51B_BATCH_TERMINAL_SEQUENTIAL_CONTINUATION_GATE=PASS");
    }else{ _zag_println("TNN_R32_E51B_BATCH_TERMINAL_SEQUENTIAL_CONTINUATION_GATE=FAIL"); }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(continuation_records); zfree(target_positive); zfree(target_negative); zfree(target_zero);
    zfree(continuation_weights); zfree(continuation_biases); zfree(backup_weights); zfree(backup_biases);
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse);
    zfree(forward_copy_weights); zfree(forward_copy_biases);
    zfree(control_aggregate); zfree(sequential_aggregate); zfree(cell_metrics); zfree(stop_histogram); zfree(no_unique_model_gates);
    return e51b_gate;
}

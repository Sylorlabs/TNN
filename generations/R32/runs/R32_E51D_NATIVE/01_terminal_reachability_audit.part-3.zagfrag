        let k:i32=0;
        while(k<E51D_AGG_FIELDS){
            e45_print_i32(aggregate[a+k]);
            if(k+1<E51D_AGG_FIELDS){ _zag_print(","); }
            k=k+1;
        }
        _zag_println("");
        model=model+1;
    }

    let no_unique_reach_cell_gate:[]i32=zalloc_i(E51B_MODELS);
    let known_reach_cell_gate:[]i32=zalloc_i(E51B_MODELS);
    let utility_success_cell_gate:[]i32=zalloc_i(E51B_MODELS);
    model=0;
    while(model<E51B_MODELS){
        no_unique_reach_cell_gate[model]=1;
        known_reach_cell_gate[model]=1;
        utility_success_cell_gate[model]=1;
        let base:i32=0;
        while(base<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let cell:i32=e51d_cell_offset(model,base,mode,resource);
                    if(cell_metrics[cell+1]>0 && cell_metrics[cell+2]!=cell_metrics[cell+1]){ no_unique_reach_cell_gate[model]=0; }
                    if(cell_metrics[cell+4]>0 && cell_metrics[cell+5]!=cell_metrics[cell+4]){ known_reach_cell_gate[model]=0; }
                    if(cell_metrics[cell+1]>0 && cell_metrics[cell+3]!=cell_metrics[cell+1]){ utility_success_cell_gate[model]=0; }
                    if(cell_metrics[cell+4]>0 && cell_metrics[cell+6]!=cell_metrics[cell+4]){ utility_success_cell_gate[model]=0; }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base=base+1;
        }
        _zag_print("e51d_no_unique_reach_every_cell_gate,"); e45_print_i32(model); _zag_print(","); e45_print_i32(no_unique_reach_cell_gate[model]); _zag_println("");
        _zag_print("e51d_known_reach_every_cell_gate,"); e45_print_i32(model); _zag_print(","); e45_print_i32(known_reach_cell_gate[model]); _zag_println("");
        _zag_print("e51d_utility_oracle_every_cell_success_gate,"); e45_print_i32(model); _zag_print(","); e45_print_i32(utility_success_cell_gate[model]); _zag_println("");
        model=model+1;
    }

    _zag_println("e51d_utility_oracle_stop_histogram_columns,model,observations,count");
    model=0;
    while(model<E51B_MODELS){
        let observations:i32=0;
        while(observations<=E45_TAPE){
            _zag_print("e51d_utility_oracle_stop_histogram,"); e45_print_i32(model); _zag_print(","); e45_print_i32(observations); _zag_print(","); e45_print_i32(stop_histogram[model*(E45_TAPE+1)+observations]); _zag_println("");
            observations=observations+1;
        }
        model=model+1;
    }

    let model0:i32=0;
    let a0:i32=model0*E51D_AGG_FIELDS;
    let all_episode_reach_gate:i32=0;
    if(aggregate[a0+E51D_A_REACHABLE_SUCCESS]==aggregate[a0+E51D_A_EPISODES]){ all_episode_reach_gate=1; }
    let oracle_utility_superiority_gate:i32=0;
    if(aggregate[a0+E51D_A_UTILITY_ORACLE_VALUE]>aggregate[a0+E51D_A_BASELINE_UTILITY]){ oracle_utility_superiority_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate==1 && aggregate[a0+E51D_A_EPISODES]==E51B_VALIDATION_EPISODES){ integrity_gate=1; }
    e45_print_pair("e51d_integrity_gate",integrity_gate);
    e45_print_pair("e51d_model0_all_episode_terminal_success_reachable_gate",all_episode_reach_gate);
    e45_print_pair("e51d_model0_oracle_utility_superiority_gate",oracle_utility_superiority_gate);
    e45_print_pair("e51d_sealed_confirmation_executed",0);
    if(integrity_gate==1){
        if(all_episode_reach_gate==1){
            _zag_println("e51d_outcome,FROZEN_TERMINAL_SUCCESS_REACHABLE_CONTINUATION_LEARNABILITY_REMAINS");
        }else{
            _zag_println("e51d_outcome,FROZEN_TERMINAL_HEAD_HAS_UNREACHABLE_SUCCESS_EPISODES_JOINT_TERMINAL_CONTINUATION_CHANGE_REQUIRED");
        }
        _zag_println("TNN_R32_E51D_TERMINAL_REACHABILITY_AUDIT_GATE=PASS");
    }else{
        _zag_println("e51d_outcome,INTEGRITY_FAILURE");
        _zag_println("TNN_R32_E51D_TERMINAL_REACHABILITY_AUDIT_GATE=FAIL");
    }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(aggregate); zfree(cell_metrics); zfree(stop_histogram);
    zfree(no_unique_reach_cell_gate); zfree(known_reach_cell_gate); zfree(utility_success_cell_gate);
    return integrity_gate;
}

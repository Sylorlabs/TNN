// R32 E51Z — evaluator-only stopping-state oracle audit.
// No learner parameter is updated here.  All policy parameters are reconstructed
// by E51Y before this function is called and remain frozen during stage 87.

const E51Z_STAGE:i32=87;
const E51Z_EPISODES:i32=5400;
const E51Z_SAMPLES:i32=91800;
const E51Z_PER_CELL:i32=20;
const E51Z_HASH_SIZE:i32=262147;
const E51Z_BUCKETS:i32=7;
const E51Z_AUDIT_ARMS:i32=4;
const E51Z_M_FIELDS:i32=19;
const E51Z_M_EPISODES:i32=0;
const E51Z_M_CONTINUED:i32=1;
const E51Z_M_OBSERVATIONS:i32=2;
const E51Z_M_OPPORTUNITY_LOSS:i32=3;
const E51Z_M_UTILITY:i32=4;
const E51Z_M_ORACLE_UTILITY:i32=5;
const E51Z_M_ORACLE_REGRET:i32=6;
const E51Z_M_FP:i32=7;
const E51Z_M_FN:i32=8;
const E51Z_M_FP_WEIGHT:i32=9;
const E51Z_M_FN_WEIGHT:i32=10;
const E51Z_M_OVER_STOP:i32=11;
const E51Z_M_UNDER_STOP:i32=12;
const E51Z_M_EXACT_STOP:i32=13;
const E51Z_M_KNOWN_SUCCESS:i32=14;
const E51Z_M_KNOWN_WRONG:i32=15;
const E51Z_M_KNOWN_UNKNOWN:i32=16;
const E51Z_M_NU_UNKNOWN:i32=17;
const E51Z_M_NU_WRONG:i32=18;
const E51Z_STRAT_FIELDS:i32=6;
const E51Z_S_EPISODES:i32=0;
const E51Z_S_FP:i32=1;
const E51Z_S_FN:i32=2;
const E51Z_S_REGRET:i32=3;
const E51Z_S_UTILITY:i32=4;
const E51Z_S_NU_WRONG:i32=5;

fn e51z_continue_hash(
    weights:[]i32,bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,expert_biases:[]i32
)i32 {
    let h:i32=8701;
    let i:i32=0;
    while(i<E45_FEATURES){ h=e46_hash_update(h,weights[i]); h=e46_hash_update(h,ranges[i]); i=i+1; }
    h=e46_hash_update(h,bias);
    i=0;
    while(i<E51Y_CELLS){
        h=e46_hash_update(h,parents[i]);
        let f:i32=0;
        while(f<E45_FEATURES){ h=e46_hash_update(h,prototypes[i*E45_FEATURES+f]); f=f+1; }
        i=i+1;
    }
    i=0;
    while(i<2*E51Y_CELLS){
        h=e46_hash_update(h,expert_biases[i]);
        let f:i32=0;
        while(f<E45_FEATURES){ h=e46_hash_update(h,expert_weights[i*E45_FEATURES+f]); f=f+1; }
        i=i+1;
    }
    return h;
}

fn e51z_effective_feature_equal(records:[]i32,a_start:i32,b_start:i32)i32 {
    let f:i32=0;
    while(f<E45_FEATURES){
        let av:i32=e50_batch_column(records,a_start,f+1,0);
        let bv:i32=e50_batch_column(records,b_start,f+1,0);
        if(av!=bv){ return 0; }
        f=f+1;
    }
    return 1;
}

fn e51z_effective_feature_hash(records:[]i32,start:i32)i32 {
    let h:i32=8719;
    let f:i32=0;
    while(f<E45_FEATURES){ h=e46_hash_update(h,e50_batch_column(records,start,f+1,0)); f=f+1; }
    return h;
}

fn e51z_adv_bucket(v:i32)i32 {
    if(v<=-500){ return 0; }
    if(v<=-101){ return 1; }
    if(v<=-1){ return 2; }
    if(v==0){ return 3; }
    if(v<=100){ return 4; }
    if(v<=500){ return 5; }
    return 6;
}

fn e51z_success(choice:i32,terminal_utility:i32,mode:i32)i32 {
    if(mode==0 || mode==1){ if(choice==R32E45_TERM_UNKNOWN){ return 1; } return 0; }
    if(choice!=R32E45_TERM_UNKNOWN && terminal_utility==1000){ return 1; }
    return 0;
}

fn e51z_strat_offset(arm:i32,index:i32,count:i32)i32 {
    return (arm*count+index)*E51Z_STRAT_FIELDS;
}

fn e51z_audit(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    terminal_global:[]i32,terminal_global_bias:i32,
    terminal_prototypes:[]i32,terminal_parents:[]i32,terminal_ranges:[]i32,
    terminal_expert_weights:[]i32,terminal_expert_biases:[]i32,
    continue_global:[]i32,continue_global_bias:i32,
    continue_prototypes:[]i32,continue_parents:[]i32,continue_ranges:[]i32,
    continue_expert_weights:[]i32,continue_expert_biases:[]i32
)i32 {
    _zag_println("R32_E51Z_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51z_resource_constrained_stopping_oracle_audit_v1");
    _zag_println("claim_boundary,evaluator_only_frozen_policy_audit_not_cognitive_change");
    _zag_println("native_zag_v2_only=1");
    _zag_println("learner_updates_stage87=0");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("oracle_action_exposed=0");
    _zag_println("audit_bucket_exposed=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let world_lo:i32=e51n_world_id(E51Z_STAGE,0);
    let world_hi:i32=e51n_world_id(E51Z_STAGE,E51Z_EPISODES-1);
    let prior_hi:i32=e51n_world_id(E51Y_CONFIRM_STAGE,E51Y_CONFIRM_EPISODES-1);
    let world_gate:i32=0; if(prior_hi<world_lo){ world_gate=1; }
    let domain_gate:i32=1;
    let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(world_lo,d); let hi:i64=e51n_domain_state(world_hi,d);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let o:i32=d+1;
        while(o<5){
            let olo:i64=e51n_domain_state(world_lo,o); let ohi:i64=e51n_domain_state(world_hi,o);
            if(!(hi<olo || ohi<lo)){ domain_gate=0; }
            o=o+1;
        }
        d=d+1;
    }
    e45_print_pair("e51z_world_id_lo",world_lo); e45_print_pair("e51z_world_id_hi",world_hi);
    e45_print_pair("e51z_world_partition_gate",world_gate); e45_print_pair("e51z_domain_gate",domain_gate); e45_print_pair("e51z_world_assignment_failures",0);

    let terminal_hash_before:i32=e51y_terminal_hash(
        terminal_weights,terminal_biases,terminal_global,terminal_global_bias,
        terminal_prototypes,terminal_parents,terminal_ranges,terminal_expert_weights,terminal_expert_biases
    );
    let continue_hash_before:i32=e51z_continue_hash(
        continue_global,continue_global_bias,continue_prototypes,continue_parents,continue_ranges,
        continue_expert_weights,continue_expert_biases
    );

    let term_records:[]i32=zalloc_i(E51Z_SAMPLES*E50_RECORD_N);
    let cont_records:[]i32=zalloc_i(E51Z_SAMPLES*E50_RECORD_N);
    e45_zero(term_records,E51Z_SAMPLES*E50_RECORD_N); e45_zero(cont_records,E51Z_SAMPLES*E50_RECORD_N);
    let unknown_nonzero:i32=0; let cp:i32=0; let cn:i32=0; let built:i32=0;
    let episode:i32=0;
    while(episode<E51Z_EPISODES){
        let resource:i32=e45_mod(episode/E51Z_PER_CELL,E45_RESOURCES);
        let mode:i32=e45_mod(episode/(E45_RESOURCES*E51Z_PER_CELL),E45_MODES);
        e51e_build_training_episode(
            e51n_world_id(E51Z_STAGE,episode),mode,resource,episode,
            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
            term_records,cont_records,&unknown_nonzero,&cp,&cn
        );
        built=built+1; episode=episode+1;
    }
    e45_print_pair("e51z_audit_episodes_built",built); e45_print_pair("e51z_audit_states_built",built*(E45_TAPE+1)); e45_print_pair("e51z_builder_unknown_target_nonzero",unknown_nonzero);

    let metrics:[]i32=zalloc_i(E51Z_AUDIT_ARMS*E51Z_M_FIELDS); e45_zero(metrics,E51Z_AUDIT_ARMS*E51Z_M_FIELDS);
    let mode_metrics:[]i32=zalloc_i(E51Z_AUDIT_ARMS*E45_MODES*E51Z_STRAT_FIELDS); e45_zero(mode_metrics,E51Z_AUDIT_ARMS*E45_MODES*E51Z_STRAT_FIELDS);
    let resource_metrics:[]i32=zalloc_i(E51Z_AUDIT_ARMS*E45_RESOURCES*E51Z_STRAT_FIELDS); e45_zero(resource_metrics,E51Z_AUDIT_ARMS*E45_RESOURCES*E51Z_STRAT_FIELDS);
    let oracle_hist:[]i32=zalloc_i(E45_TAPE+1); let safe_hist:[]i32=zalloc_i(E45_TAPE+1); e45_zero(oracle_hist,E45_TAPE+1); e45_zero(safe_hist,E45_TAPE+1);
    let bucket_count:[]i32=zalloc_i(E51Z_BUCKETS); let bucket_error:[]i32=zalloc_i(3*E51Z_BUCKETS); e45_zero(bucket_count,E51Z_BUCKETS); e45_zero(bucket_error,3*E51Z_BUCKETS);

    let hash_record:[]i32=zalloc_i(E51Z_HASH_SIZE); let hash_adv:[]i32=zalloc_i(E51Z_HASH_SIZE); let hash_safe:[]i32=zalloc_i(E51Z_HASH_SIZE);
    e45_zero(hash_record,E51Z_HASH_SIZE); e45_zero(hash_adv,E51Z_HASH_SIZE); e45_zero(hash_safe,E51Z_HASH_SIZE);
    let duplicate_rows:i32=0; let adv_conflict_keys:i32=0; let adv_conflict_rows:i32=0; let safe_conflict_keys:i32=0; let safe_conflict_rows:i32=0;

    let full_success_any:i32=0; let feasible_success:i32=0; let feasible_missing:i32=0; let feasible_missing_known:i32=0; let feasible_missing_nu:i32=0;
    let utility_oracle_utility:i32=0; let utility_oracle_success:i32=0; let utility_oracle_unsafe_with_safe:i32=0; let utility_oracle_nu_wrong:i32=0;
    let safe_oracle_utility:i32=0; let safe_oracle_covered:i32=0; let safe_oracle_missing:i32=0;
    let must_continue_states:i32=0; let target_safety_conflicts:i32=0; let target_safety_conflicts_nu:i32=0; let target_safety_conflicts_known:i32=0;
    let first_success_sum:i32=0; let first_success_count:i32=0; let last_feasible_sum:i32=0;

    episode=0;
    while(episode<E51Z_EPISODES){
        let resource:i32=e45_mod(episode/E51Z_PER_CELL,E45_RESOURCES);
        let mode:i32=e45_mod(episode/(E45_RESOURCES*E51Z_PER_CELL),E45_MODES);
        let world_id:i32=e51n_world_id(E51Z_STAGE,episode);
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let stop_value:[]i32=zalloc_i(E45_TAPE+1); let choice:[]i32=zalloc_i(E45_TAPE+1); let accessible:[]i32=zalloc_i(E45_TAPE+1); let cumulative:[]i32=zalloc_i(E45_TAPE+1);
        let best_value:[]i32=zalloc_i(E45_TAPE+1); let advantage:[]i32=zalloc_i(E45_TAPE+1); let success:[]i32=zalloc_i(E45_TAPE+1); let future_success:[]i32=zalloc_i(E45_TAPE+1);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(world_id,resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        e45_zero(accessible,E45_TAPE+1); e45_zero(cumulative,E45_TAPE+1); accessible[0]=1;
        let t:i32=0;
        while(t<=E45_TAPE){
            let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
            choice[t]=e51y_terminal_choice(
                term_records,rs,terminal_weights,terminal_biases,terminal_global,terminal_global_bias,
                terminal_prototypes,terminal_parents,terminal_ranges,terminal_expert_weights,terminal_expert_biases
            );
            stop_value[t]=0; if(choice[t]!=R32E45_TERM_UNKNOWN){ stop_value[t]=term_records[rs+34+choice[t]]; }
            success[t]=e51z_success(choice[t],stop_value[t],mode);
            if(t<E45_TAPE){
                if(accessible[t]==1 && feasible[t]==1){ accessible[t+1]=1; cumulative[t+1]=cumulative[t]+step_loss[t];
                }else{ accessible[t+1]=0; cumulative[t+1]=cumulative[t]; }
            }
            t=t+1;
        }
        best_value[E45_TAPE]=stop_value[E45_TAPE]; advantage[E45_TAPE]=-4000; future_success[E45_TAPE]=success[E45_TAPE];
        t=E45_TAPE-1;
        while(t>=0){
            best_value[t]=stop_value[t]; advantage[t]=-4000;
            if(feasible[t]==1){
                let cr:i32=0-step_loss[t]+best_value[t+1]; advantage[t]=cr-stop_value[t]; if(cr>best_value[t]){ best_value[t]=cr; }
            }
            future_success[t]=success[t]; if(feasible[t]==1 && future_success[t+1]==1){ future_success[t]=1; }
            t=t-1;
        }

        let any_success:i32=0; let feasible_ok:i32=0; let first_success:i32=-1; let last_feasible:i32=0;
        let utility_best:i32=-100000000; let utility_t:i32=0; let safe_best:i32=-100000000; let safe_t:i32=-1;
        t=0;
        while(t<=E45_TAPE){
            if(success[t]==1){ any_success=1; if(first_success<0){ first_success=t; } }
            if(accessible[t]==1){
                last_feasible=t;
                let net:i32=stop_value[t]-cumulative[t];
                if(net>utility_best){ utility_best=net; utility_t=t; }
                if(success[t]==1){ feasible_ok=1; if(net>safe_best){ safe_best=net; safe_t=t; } }
            }
            let crs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
            let adv_label:i32=-1; if(advantage[t]>0){ adv_label=1; }
            let safe_label:i32=-1; if(success[t]==0 && t<E45_TAPE && feasible[t]==1 && future_success[t+1]==1){ safe_label=1; }
            let h:i32=e51z_effective_feature_hash(cont_records,crs); let slot:i32=e45_mod(h,E51Z_HASH_SIZE); let probes:i32=0; let placed:i32=0;
            while(placed==0 && probes<E51Z_HASH_SIZE){
                if(hash_record[slot]==0){ hash_record[slot]=episode*(E45_TAPE+1)+t+1; hash_adv[slot]=adv_label; hash_safe[slot]=safe_label; placed=1;
                }else{
                    let prior_record:i32=hash_record[slot]-1; let prs:i32=prior_record*E50_RECORD_N;
                    if(e51z_effective_feature_equal(cont_records,crs,prs)==1){
                        duplicate_rows=duplicate_rows+1;
                        if(hash_adv[slot]!=adv_label){ if(hash_adv[slot]!=2){ adv_conflict_keys=adv_conflict_keys+1; } hash_adv[slot]=2; adv_conflict_rows=adv_conflict_rows+1; }
                        if(hash_safe[slot]!=safe_label){ if(hash_safe[slot]!=2){ safe_conflict_keys=safe_conflict_keys+1; } hash_safe[slot]=2; safe_conflict_rows=safe_conflict_rows+1; }
                        placed=1;
                    }else{ slot=e45_mod(slot+1,E51Z_HASH_SIZE); probes=probes+1; }
                }
            }
            if(accessible[t]==1 && t<E45_TAPE){
                let b:i32=e51z_adv_bucket(advantage[t]); bucket_count[b]=bucket_count[b]+1;
                let arm:i32=1; while(arm<E51Z_AUDIT_ARMS){
                    let p:i32=e51y_continue_prediction(arm,cont_records,crs,continue_global,continue_global_bias,continue_prototypes,continue_parents,continue_ranges,continue_expert_weights,continue_expert_biases);
                    let pred:i32=0; if(p>0){ pred=1; } let truth:i32=0; if(advantage[t]>0){ truth=1; }
                    if(pred!=truth){ bucket_error[(arm-1)*E51Z_BUCKETS+b]=bucket_error[(arm-1)*E51Z_BUCKETS+b]+1; }
                    arm=arm+1;
                }
                if(safe_label==1){
                    must_continue_states=must_continue_states+1;
                    if(advantage[t]<=0){ target_safety_conflicts=target_safety_conflicts+1; if(mode==0 || mode==1){ target_safety_conflicts_nu=target_safety_conflicts_nu+1; }else{ target_safety_conflicts_known=target_safety_conflicts_known+1; } }
                }
            }
            t=t+1;
        }
        if(any_success==1){ full_success_any=full_success_any+1; first_success_sum=first_success_sum+first_success; first_success_count=first_success_count+1; }
        if(feasible_ok==1){ feasible_success=feasible_success+1; safe_oracle_covered=safe_oracle_covered+1; safe_oracle_utility=safe_oracle_utility+safe_best; safe_hist[safe_t]=safe_hist[safe_t]+1;
        }else{ feasible_missing=feasible_missing+1; safe_oracle_missing=safe_oracle_missing+1; if(mode==0 || mode==1){ feasible_missing_nu=feasible_missing_nu+1; }else{ feasible_missing_known=feasible_missing_known+1; } }
        last_feasible_sum=last_feasible_sum+last_feasible;
        utility_oracle_utility=utility_oracle_utility+utility_best; oracle_hist[utility_t]=oracle_hist[utility_t]+1;
        if(success[utility_t]==1){ utility_oracle_success=utility_oracle_success+1; }
        if((mode==0 || mode==1) && choice[utility_t]!=R32E45_TERM_UNKNOWN){ utility_oracle_nu_wrong=utility_oracle_nu_wrong+1; if(feasible_ok==1){ utility_oracle_unsafe_with_safe=utility_oracle_unsafe_with_safe+1; } }

        let arm:i32=0;
        while(arm<E51Z_AUDIT_ARMS){
            let observations:i32=0; let opportunity:i32=0; let stopped:i32=0; let local_fp:i32=0; let local_fn:i32=0; let local_fpw:i32=0; let local_fnw:i32=0;
            while(stopped==0){
                if(arm==0 || observations>=E45_TAPE || feasible[observations]==0){ stopped=1;
                }else{
                    let crs:i32=(episode*(E45_TAPE+1)+observations)*E50_RECORD_N;
                    let pref:i32=e51y_continue_prediction(arm,cont_records,crs,continue_global,continue_global_bias,continue_prototypes,continue_parents,continue_ranges,continue_expert_weights,continue_expert_biases);
                    if(pref>0){
                        if(advantage[observations]<=0){ local_fp=local_fp+1; local_fpw=local_fpw+r32e45_abs(advantage[observations]); }
                        opportunity=opportunity+step_loss[observations]; observations=observations+1;
                    }else{
                        if(advantage[observations]>0){ local_fn=local_fn+1; local_fnw=local_fnw+advantage[observations]; }
                        stopped=1;
                    }
                }
            }
            let actual_utility:i32=stop_value[observations]-opportunity; let regret:i32=utility_best-actual_utility; if(regret<0){ regret=0; }
            let ms:i32=arm*E51Z_M_FIELDS; metrics[ms+E51Z_M_EPISODES]=metrics[ms+E51Z_M_EPISODES]+1; if(observations>0){ metrics[ms+E51Z_M_CONTINUED]=metrics[ms+E51Z_M_CONTINUED]+1; }
            metrics[ms+E51Z_M_OBSERVATIONS]=metrics[ms+E51Z_M_OBSERVATIONS]+observations; metrics[ms+E51Z_M_OPPORTUNITY_LOSS]=metrics[ms+E51Z_M_OPPORTUNITY_LOSS]+opportunity; metrics[ms+E51Z_M_UTILITY]=metrics[ms+E51Z_M_UTILITY]+actual_utility; metrics[ms+E51Z_M_ORACLE_UTILITY]=metrics[ms+E51Z_M_ORACLE_UTILITY]+utility_best; metrics[ms+E51Z_M_ORACLE_REGRET]=metrics[ms+E51Z_M_ORACLE_REGRET]+regret;
            metrics[ms+E51Z_M_FP]=metrics[ms+E51Z_M_FP]+local_fp; metrics[ms+E51Z_M_FN]=metrics[ms+E51Z_M_FN]+local_fn; metrics[ms+E51Z_M_FP_WEIGHT]=metrics[ms+E51Z_M_FP_WEIGHT]+local_fpw; metrics[ms+E51Z_M_FN_WEIGHT]=metrics[ms+E51Z_M_FN_WEIGHT]+local_fnw;
            if(observations>utility_t){ metrics[ms+E51Z_M_OVER_STOP]=metrics[ms+E51Z_M_OVER_STOP]+1; }else{ if(observations<utility_t){ metrics[ms+E51Z_M_UNDER_STOP]=metrics[ms+E51Z_M_UNDER_STOP]+1; }else{ metrics[ms+E51Z_M_EXACT_STOP]=metrics[ms+E51Z_M_EXACT_STOP]+1; } }
            if(mode==0 || mode==1){ if(choice[observations]==R32E45_TERM_UNKNOWN){ metrics[ms+E51Z_M_NU_UNKNOWN]=metrics[ms+E51Z_M_NU_UNKNOWN]+1; }else{ metrics[ms+E51Z_M_NU_WRONG]=metrics[ms+E51Z_M_NU_WRONG]+1; }
            }else{ if(choice[observations]==R32E45_TERM_UNKNOWN){ metrics[ms+E51Z_M_KNOWN_UNKNOWN]=metrics[ms+E51Z_M_KNOWN_UNKNOWN]+1; }else{ if(stop_value[observations]==1000){ metrics[ms+E51Z_M_KNOWN_SUCCESS]=metrics[ms+E51Z_M_KNOWN_SUCCESS]+1; }else{ metrics[ms+E51Z_M_KNOWN_WRONG]=metrics[ms+E51Z_M_KNOWN_WRONG]+1; } } }
            let mo:i32=e51z_strat_offset(arm,mode,E45_MODES); let ro:i32=e51z_strat_offset(arm,resource,E45_RESOURCES);
            mode_metrics[mo+E51Z_S_EPISODES]=mode_metrics[mo+E51Z_S_EPISODES]+1; mode_metrics[mo+E51Z_S_FP]=mode_metrics[mo+E51Z_S_FP]+local_fp; mode_metrics[mo+E51Z_S_FN]=mode_metrics[mo+E51Z_S_FN]+local_fn; mode_metrics[mo+E51Z_S_REGRET]=mode_metrics[mo+E51Z_S_REGRET]+regret; mode_metrics[mo+E51Z_S_UTILITY]=mode_metrics[mo+E51Z_S_UTILITY]+actual_utility;
            resource_metrics[ro+E51Z_S_EPISODES]=resource_metrics[ro+E51Z_S_EPISODES]+1; resource_metrics[ro+E51Z_S_FP]=resource_metrics[ro+E51Z_S_FP]+local_fp; resource_metrics[ro+E51Z_S_FN]=resource_metrics[ro+E51Z_S_FN]+local_fn; resource_metrics[ro+E51Z_S_REGRET]=resource_metrics[ro+E51Z_S_REGRET]+regret; resource_metrics[ro+E51Z_S_UTILITY]=resource_metrics[ro+E51Z_S_UTILITY]+actual_utility;
            if((mode==0 || mode==1) && choice[observations]!=R32E45_TERM_UNKNOWN){ mode_metrics[mo+E51Z_S_NU_WRONG]=mode_metrics[mo+E51Z_S_NU_WRONG]+1; resource_metrics[ro+E51Z_S_NU_WRONG]=resource_metrics[ro+E51Z_S_NU_WRONG]+1; }
            arm=arm+1;
        }

        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible); zfree(stop_value); zfree(choice); zfree(accessible); zfree(cumulative); zfree(best_value); zfree(advantage); zfree(success); zfree(future_success);
        episode=episode+1;
    }

    let terminal_hash_after:i32=e51y_terminal_hash(terminal_weights,terminal_biases,terminal_global,terminal_global_bias,terminal_prototypes,terminal_parents,terminal_ranges,terminal_expert_weights,terminal_expert_biases);
    let continue_hash_after:i32=e51z_continue_hash(continue_global,continue_global_bias,continue_prototypes,continue_parents,continue_ranges,continue_expert_weights,continue_expert_biases);
    let frozen_gate:i32=0; if(terminal_hash_before==terminal_hash_after && continue_hash_before==continue_hash_after){ frozen_gate=1; }
    let count_gate:i32=0; if(built==E51Z_EPISODES && built*(E45_TAPE+1)==E51Z_SAMPLES){ count_gate=1; }
    let integrity:i32=0; if(world_gate==1 && domain_gate==1 && count_gate==1 && unknown_nonzero==0 && frozen_gate==1){ integrity=1; }

    e45_print_pair("e51z_terminal_hash_before",terminal_hash_before); e45_print_pair("e51z_terminal_hash_after",terminal_hash_after); e45_print_pair("e51z_continue_hash_before",continue_hash_before); e45_print_pair("e51z_continue_hash_after",continue_hash_after); e45_print_pair("e51z_frozen_parameter_gate",frozen_gate); e45_print_pair("e51z_count_gate",count_gate); e45_print_pair("e51z_integrity_gate",integrity);
    e45_print_pair("e51z_full_trajectory_success_reachable",full_success_any); e45_print_pair("e51z_cost_feasible_success_reachable",feasible_success); e45_print_pair("e51z_cost_feasible_success_missing",feasible_missing); e45_print_pair("e51z_cost_feasible_missing_known",feasible_missing_known); e45_print_pair("e51z_cost_feasible_missing_no_unique",feasible_missing_nu); e45_print_pair("e51z_first_success_time_sum",first_success_sum); e45_print_pair("e51z_first_success_count",first_success_count); e45_print_pair("e51z_last_feasible_time_sum",last_feasible_sum);
    e45_print_pair("e51z_utility_oracle_utility",utility_oracle_utility); e45_print_pair("e51z_utility_oracle_success",utility_oracle_success); e45_print_pair("e51z_utility_oracle_no_unique_wrong",utility_oracle_nu_wrong); e45_print_pair("e51z_utility_oracle_unsafe_despite_safe",utility_oracle_unsafe_with_safe);
    e45_print_pair("e51z_safe_oracle_covered",safe_oracle_covered); e45_print_pair("e51z_safe_oracle_missing",safe_oracle_missing); e45_print_pair("e51z_safe_oracle_utility",safe_oracle_utility);
    e45_print_pair("e51z_must_continue_for_success_states",must_continue_states); e45_print_pair("e51z_target_safety_conflicts",target_safety_conflicts); e45_print_pair("e51z_target_safety_conflicts_known",target_safety_conflicts_known); e45_print_pair("e51z_target_safety_conflicts_no_unique",target_safety_conflicts_nu);
    e45_print_pair("e51z_exact_duplicate_feature_rows",duplicate_rows); e45_print_pair("e51z_advantage_conflict_keys",adv_conflict_keys); e45_print_pair("e51z_advantage_conflict_rows",adv_conflict_rows); e45_print_pair("e51z_safety_requirement_conflict_keys",safe_conflict_keys); e45_print_pair("e51z_safety_requirement_conflict_rows",safe_conflict_rows);

    _zag_println("e51z_policy_columns,arm_0_t0_1_linear_2_local96_3_local384,episodes,continued,observations,opportunity_loss,utility,oracle_utility,oracle_regret,false_positive_continue,false_negative_continue,fp_abs_adv,fn_abs_adv,stop_after_oracle,stop_before_oracle,stop_at_oracle,known_success,known_wrong,known_unknown,no_unique_unknown,no_unique_wrong");
    let arm:i32=0;
    while(arm<E51Z_AUDIT_ARMS){ _zag_print("e51z_policy,"); e45_print_i32(arm); let k:i32=0; while(k<E51Z_M_FIELDS){ _zag_print(","); e45_print_i32(metrics[arm*E51Z_M_FIELDS+k]); k=k+1; } _zag_println(""); arm=arm+1; }

    _zag_println("e51z_advantage_bucket_columns,bucket_0_le_m500_1_m499_m101_2_m100_m1_3_zero_4_p1_p100_5_p101_p500_6_gt500,count,linear_errors,local96_errors,local384_errors");
    let b:i32=0; while(b<E51Z_BUCKETS){ _zag_print("e51z_advantage_bucket,"); e45_print_i32(b); _zag_print(","); e45_print_i32(bucket_count[b]); arm=1; while(arm<E51Z_AUDIT_ARMS){ _zag_print(","); e45_print_i32(bucket_error[(arm-1)*E51Z_BUCKETS+b]); arm=arm+1; } _zag_println(""); b=b+1; }
    _zag_println("e51z_oracle_stop_hist_columns,t,utility_oracle,safety_oracle"); t=0; while(t<=E45_TAPE){ _zag_print("e51z_oracle_stop_hist,"); e45_print_i32(t); _zag_print(","); e45_print_i32(oracle_hist[t]); _zag_print(","); e45_print_i32(safe_hist[t]); _zag_println(""); t=t+1; }

    _zag_println("e51z_mode_columns,arm,mode,episodes,fp,fn,oracle_regret,utility,no_unique_wrong"); arm=0; while(arm<E51Z_AUDIT_ARMS){ let mode:i32=0; while(mode<E45_MODES){ let s:i32=e51z_strat_offset(arm,mode,E45_MODES); _zag_print("e51z_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); let k:i32=0; while(k<E51Z_STRAT_FIELDS){ _zag_print(","); e45_print_i32(mode_metrics[s+k]); k=k+1; } _zag_println(""); mode=mode+1; } arm=arm+1; }
    _zag_println("e51z_resource_columns,arm,resource,episodes,fp,fn,oracle_regret,utility,no_unique_wrong"); arm=0; while(arm<E51Z_AUDIT_ARMS){ let resource:i32=0; while(resource<E45_RESOURCES){ let s:i32=e51z_strat_offset(arm,resource,E45_RESOURCES); _zag_print("e51z_resource,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(resource); let k:i32=0; while(k<E51Z_STRAT_FIELDS){ _zag_print(","); e45_print_i32(resource_metrics[s+k]); k=k+1; } _zag_println(""); resource=resource+1; } arm=arm+1; }

    let resource_veto:i32=0; if(feasible_missing>0){ resource_veto=1; }
    let objective_conflict:i32=0; if(target_safety_conflicts>0 || utility_oracle_unsafe_with_safe>0){ objective_conflict=1; }
    let representation_conflict:i32=0; if(adv_conflict_keys>0 || safe_conflict_keys>0){ representation_conflict=1; }
    let calibration_error:i32=0; let error_sum:i32=0; arm=1; while(arm<E51Z_AUDIT_ARMS){ error_sum=error_sum+metrics[arm*E51Z_M_FIELDS+E51Z_M_FP]+metrics[arm*E51Z_M_FIELDS+E51Z_M_FN]; arm=arm+1; } if(error_sum>0){ calibration_error=1; }
    e45_print_pair("e51z_resource_veto_flag",resource_veto); e45_print_pair("e51z_objective_conflict_flag",objective_conflict); e45_print_pair("e51z_representation_conflict_flag",representation_conflict); e45_print_pair("e51z_calibration_error_flag",calibration_error);
    let causal_count:i32=resource_veto+objective_conflict+representation_conflict+calibration_error;
    if(integrity==0){ _zag_println("e51z_outcome,INVALID_E51Z_INTEGRITY_FAILURE");
    }else{ if(causal_count>1){ _zag_println("e51z_outcome,MIXED_STOPPING_FAILURE");
        }else{ if(resource_veto==1){ _zag_println("e51z_outcome,RESOURCE_CONSTRAINED_TERMINAL_REACHABILITY_VETO");
            }else{ if(objective_conflict==1){ _zag_println("e51z_outcome,UTILITY_SAFETY_OBJECTIVE_CONFLICT");
                }else{ if(representation_conflict==1){ _zag_println("e51z_outcome,CONTINUATION_REPRESENTATION_CONFLICT");
                    }else{ _zag_println("e51z_outcome,CONTINUATION_VALUE_CALIBRATION_ERROR"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51Z_AUDIT_COMPLETE=1");

    zfree(term_records); zfree(cont_records); zfree(metrics); zfree(mode_metrics); zfree(resource_metrics); zfree(oracle_hist); zfree(safe_hist); zfree(bucket_count); zfree(bucket_error); zfree(hash_record); zfree(hash_adv); zfree(hash_safe);
    if(integrity==1){ return 1; } return 0;
}

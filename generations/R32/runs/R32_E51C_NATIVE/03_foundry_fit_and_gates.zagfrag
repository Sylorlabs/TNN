    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let pair_left_forward:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let pair_right_forward:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let coefficients_forward:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let pair_left_reverse:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let pair_right_reverse:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let coefficients_reverse:[]i32=zalloc_i(E51C_MAX_INTERACTIONS);
    let terminal_aggregate:[]i32=zalloc_i(E51B_AGG_FIELDS);
    let linear_aggregate:[]i32=zalloc_i(E51B_AGG_FIELDS);
    let foundry_aggregate:[]i32=zalloc_i(E51B_AGG_FIELDS);
    let foundry_cell_metrics:[]i32=zalloc_i(6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    let stop_histogram:[]i32=zalloc_i(2*(E45_TAPE+1));

    e45_zero(records,E51B_SAMPLES*E50_RECORD_N);
    e45_zero(target_positive,E51B_MODELS); e45_zero(target_negative,E51B_MODELS); e45_zero(target_zero,E51B_MODELS);
    e45_zero(continuation_weights,4*E45_FEATURES); e45_zero(continuation_biases,4);
    e45_zero(forward_weights,4*E45_FEATURES); e45_zero(forward_biases,4);
    e45_zero(backup_weights,4*E45_FEATURES); e45_zero(backup_biases,4);
    e45_zero(gram_forward,E50_BATCH_GRAM); e45_zero(gram_reverse,E50_BATCH_GRAM);
    e45_zero(cross_forward,E50_BATCH_CROSS); e45_zero(cross_reverse,E50_BATCH_CROSS);
    e45_zero(terminal_aggregate,E51B_AGG_FIELDS); e45_zero(linear_aggregate,E51B_AGG_FIELDS); e45_zero(foundry_aggregate,E51B_AGG_FIELDS);
    e45_zero(foundry_cell_metrics,6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    e45_zero(stop_histogram,2*(E45_TAPE+1));

    let seed_gate:i32=e51c_allocate_seeds(
        raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds
    );

    let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51b_build_continuation_episode(
                            dev_seeds[index],mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                            records,target_positive,target_negative,target_zero
                        );
                        canonical_episode=canonical_episode+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let sample_gate:i32=0;
    if(canonical_episode==E51C_DEV_EPISODES){ sample_gate=1; }
    let target_gate:i32=0;
    if(target_positive[0]>0 && target_negative[0]>0){ target_gate=1; }
    e45_print_pair("e51c_development_episodes",canonical_episode);
    _zag_print("e51c_target_counts,"); e45_print_i32(target_positive[0]); _zag_print(","); e45_print_i32(target_negative[0]); _zag_print(","); e45_print_i32(target_zero[0]); _zag_println("");
    e45_print_pair("e51c_target_interior_gate",target_gate);

    let count_forward:i32=0; let count_reverse:i32=0;
    let hash_forward:i32=331; let hash_reverse:i32=331;
    e50_build_batch_statistics(records,0,0,gram_forward,cross_forward,&count_forward,&hash_forward);
    e50_build_batch_statistics(records,0,1,gram_reverse,cross_reverse,&count_reverse,&hash_reverse);
    let stats_gate:i32=1;
    if(count_forward!=E51B_SAMPLES || count_reverse!=E51B_SAMPLES || hash_forward!=hash_reverse || e50_batch_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0){ stats_gate=0; }

    let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0; let loss_low_forward:i32=0; let loss_high_forward:i32=0;
    e50_batch_fit(
        records,0,0,gram_forward,cross_forward,
        continuation_weights,continuation_biases,backup_weights,backup_biases,
        &steps_forward,&reason_forward,&trace_forward,&loss_low_forward,&loss_high_forward
    );
    let action:i32=0;
    while(action<4){
        forward_biases[action]=continuation_biases[action];
        let feature:i32=0;
        while(feature<E45_FEATURES){ forward_weights[action*E45_FEATURES+feature]=continuation_weights[action*E45_FEATURES+feature]; feature=feature+1; }
        action=action+1;
    }
    e45_zero(continuation_weights,4*E45_FEATURES); e45_zero(continuation_biases,4);
    let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0; let loss_low_reverse:i32=0; let loss_high_reverse:i32=0;
    e50_batch_fit(
        records,0,0,gram_reverse,cross_reverse,
        continuation_weights,continuation_biases,backup_weights,backup_biases,
        &steps_reverse,&reason_reverse,&trace_reverse,&loss_low_reverse,&loss_high_reverse
    );
    let base_fit_gate:i32=1;
    action=0;
    while(action<4){
        if(continuation_biases[action]!=forward_biases[action]){ base_fit_gate=0; }
        let feature:i32=0;
        while(feature<E45_FEATURES){
            if(continuation_weights[action*E45_FEATURES+feature]!=forward_weights[action*E45_FEATURES+feature]){ base_fit_gate=0; }
            feature=feature+1;
        }
        action=action+1;
    }
    if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || loss_low_forward!=loss_low_reverse || loss_high_forward!=loss_high_reverse){ base_fit_gate=0; }
    e45_print_pair("e51c_base_batch_statistics_gate",stats_gate);
    e45_print_pair("e51c_base_forward_reverse_fit_gate",base_fit_gate);
    _zag_print("e51c_base_batch_fit,"); e45_print_i32(steps_forward); _zag_print(","); e45_print_i32(reason_forward); _zag_print(","); e45_print_i32(trace_forward); _zag_println("");

    let accepted_forward:i32=0; let accepted_reverse:i32=0;
    let base_loss_forward:i64=0; let base_loss_reverse:i64=0;
    let final_loss_forward:i64=0; let final_loss_reverse:i64=0;
    let foundry_trace_forward:i32=0; let foundry_trace_reverse:i32=0;
    e51c_foundry_search(
        records,continuation_weights,continuation_biases[0],0,
        pair_left_forward,pair_right_forward,coefficients_forward,
        &accepted_forward,&base_loss_forward,&final_loss_forward,&foundry_trace_forward
    );
    e51c_foundry_search(
        records,continuation_weights,continuation_biases[0],1,
        pair_left_reverse,pair_right_reverse,coefficients_reverse,
        &accepted_reverse,&base_loss_reverse,&final_loss_reverse,&foundry_trace_reverse
    );
    let foundry_identity_gate:i32=1;
    if(accepted_forward!=accepted_reverse || base_loss_forward!=base_loss_reverse || final_loss_forward!=final_loss_reverse || foundry_trace_forward!=foundry_trace_reverse){ foundry_identity_gate=0; }
    let k:i32=0;
    while(k<E51C_MAX_INTERACTIONS){
        if(pair_left_forward[k]!=pair_left_reverse[k] || pair_right_forward[k]!=pair_right_reverse[k] || coefficients_forward[k]!=coefficients_reverse[k]){ foundry_identity_gate=0; }
        k=k+1;
    }
    let foundry_growth_gate:i32=0;
    if(accepted_forward>0 && final_loss_forward<base_loss_forward){ foundry_growth_gate=1; }
    e45_print_pair("e51c_foundry_forward_reverse_identity_gate",foundry_identity_gate);
    e45_print_pair("e51c_foundry_growth_gate",foundry_growth_gate);
    e45_print_pair("e51c_foundry_accepted_interactions",accepted_forward);
    _zag_print("e51c_foundry_loss_low_high,"); e45_print_i32(e50_loss_low(base_loss_forward)); _zag_print(","); e45_print_i32(e50_loss_high(base_loss_forward)); _zag_print(","); e45_print_i32(e50_loss_low(final_loss_forward)); _zag_print(","); e45_print_i32(e50_loss_high(final_loss_forward)); _zag_println("");
    k=0;
    while(k<accepted_forward){
        _zag_print("e51c_foundry_interaction,"); e45_print_i32(k); _zag_print(","); e45_print_i32(pair_left_forward[k]); _zag_print(","); e45_print_i32(pair_right_forward[k]); _zag_print(","); e45_print_i32(coefficients_forward[k]); _zag_println("");
        k=k+1;
    }

    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51c_validate_episode(
                        validation_seeds[index],base_index,mode,resource,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                        continuation_weights,continuation_biases[0],
                        pair_left_forward,pair_right_forward,coefficients_forward,accepted_forward,
                        terminal_aggregate,linear_aggregate,foundry_aggregate,foundry_cell_metrics,stop_histogram
                    );
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }

    _zag_println("e51c_aggregate_columns,policy_0_terminal_1_linear_2_foundry,episodes,success,unknown,wrong,known,no_unique,observations,opportunity_loss,utility,continued,known_success,known_wrong,no_unique_unknown,no_unique_wrong");
    let policy:i32=0;
    while(policy<3){
        let metrics:[]i32=terminal_aggregate;
        if(policy==1){ metrics=linear_aggregate; }
        if(policy==2){ metrics=foundry_aggregate; }
        _zag_print("e51c_aggregate,"); e45_print_i32(policy); _zag_print(",");
        let field:i32=0;
        while(field<E51B_AGG_FIELDS){ e45_print_i32(metrics[field]); if(field+1<E51B_AGG_FIELDS){ _zag_print(","); } field=field+1; }
        _zag_println("");
        policy=policy+1;
    }

    let no_unique_every_cell_gate:i32=1;
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let cell:i32=e51c_foundry_cell_offset(base_index,mode,resource);
                if(foundry_cell_metrics[cell+1]>0){
                    if(foundry_cell_metrics[cell+3]>0 || foundry_cell_metrics[cell+2]!=foundry_cell_metrics[cell+1]){ no_unique_every_cell_gate=0; }
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51c_foundry_no_unique_every_cell_safety_gate",no_unique_every_cell_gate);

    _zag_println("e51c_stop_histogram_columns,policy_1_linear_2_foundry,observations,count");
    policy=0;
    while(policy<2){
        let observations:i32=0;
        while(observations<=E45_TAPE){
            _zag_print("e51c_stop_histogram,"); e45_print_i32(policy+1); _zag_print(","); e45_print_i32(observations); _zag_print(","); e45_print_i32(stop_histogram[policy*(E45_TAPE+1)+observations]); _zag_println("");
            observations=observations+1;
        }
        policy=policy+1;
    }

    let behavior_gate:i32=0;
    if(foundry_aggregate[E51B_M_CONTINUED]>0 && foundry_aggregate[E51B_M_CONTINUED]<foundry_aggregate[E51B_M_EPISODES]){ behavior_gate=1; }
    let utility_gate:i32=0;
    if(foundry_aggregate[E51B_M_UTILITY]>terminal_aggregate[E51B_M_UTILITY] && foundry_aggregate[E51B_M_UTILITY]>linear_aggregate[E51B_M_UTILITY]){ utility_gate=1; }
    let safety_noninferiority_gate:i32=0;
    if(foundry_aggregate[E51B_M_NO_UNIQUE_WRONG]<=terminal_aggregate[E51B_M_NO_UNIQUE_WRONG] && foundry_aggregate[E51B_M_NO_UNIQUE_WRONG]<=linear_aggregate[E51B_M_NO_UNIQUE_WRONG] && foundry_aggregate[E51B_M_KNOWN_SUCCESS]>=terminal_aggregate[E51B_M_KNOWN_SUCCESS] && foundry_aggregate[E51B_M_KNOWN_WRONG]<=terminal_aggregate[E51B_M_KNOWN_WRONG]){ safety_noninferiority_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate+sample_gate+target_gate+stats_gate+base_fit_gate+foundry_identity_gate+foundry_growth_gate==7){ integrity_gate=1; }
    let e51c_gate:i32=0;
    if(integrity_gate==1 && behavior_gate==1 && utility_gate==1 && safety_noninferiority_gate==1 && no_unique_every_cell_gate==1){ e51c_gate=1; }
    e45_print_pair("e51c_integrity_gate",integrity_gate);
    e45_print_pair("e51c_nontrivial_behavior_gate",behavior_gate);
    e45_print_pair("e51c_net_utility_superiority_gate",utility_gate);
    e45_print_pair("e51c_safety_noninferiority_gate",safety_noninferiority_gate);
    e45_print_pair("e51c_confirmation_earned",e51c_gate);
    if(e51c_gate==1){ _zag_println("e51c_outcome,VALIDATION_PASS_CONFIRMATION_EARNED");
    }else{ _zag_println("e51c_outcome,NO_VALIDATED_FOUNDRY_RESCUE"); }
    if(e51c_gate==1){ _zag_println("TNN_R32_E51C_LEARNER_OWNED_CONTINUATION_FOUNDRY_GATE=PASS");
    }else{ _zag_println("TNN_R32_E51C_LEARNER_OWNED_CONTINUATION_FOUNDRY_GATE=FAIL"); }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds); zfree(records);
    zfree(target_positive); zfree(target_negative); zfree(target_zero);
    zfree(continuation_weights); zfree(continuation_biases); zfree(forward_weights); zfree(forward_biases);
    zfree(backup_weights); zfree(backup_biases); zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse);
    zfree(pair_left_forward); zfree(pair_right_forward); zfree(coefficients_forward);
    zfree(pair_left_reverse); zfree(pair_right_reverse); zfree(coefficients_reverse);
    zfree(terminal_aggregate); zfree(linear_aggregate); zfree(foundry_aggregate); zfree(foundry_cell_metrics); zfree(stop_histogram);
    return e51c_gate;
}

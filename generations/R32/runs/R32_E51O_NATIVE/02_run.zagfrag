fn e51o_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51O_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51o_learner_owned_local_calibration_memory_v1");
    _zag_println("claim_boundary,native_local_calibration_diagnostic_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let dev_worlds:[]i32=zalloc_i(E51O_DEV_EPISODES);
    let validation_worlds:[]i32=zalloc_i(E51O_VALIDATION_EPISODES);
    let confirmation_worlds:[]i32=zalloc_i(E51O_CONFIRM_EPISODES);
    let world_gate:i32=e51o_allocate_worlds(dev_worlds,validation_worlds,confirmation_worlds);

    let dev_records:[]i32=zalloc_i(E51O_DEV_SAMPLES*E50_RECORD_N);
    let dummy_continue:[]i32=zalloc_i(E51O_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51O_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy_continue,E51O_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0;
    let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy_continue,&dev_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy_continue);
    e45_print_pair("e51o_development_episodes_built",canonical_episode);
    e45_print_pair("e51o_development_states_built",canonical_episode*(E45_TAPE+1));
    e45_print_pair("e51o_dev_unknown_target_nonzero",dev_unknown_nonzero);

    // Frozen base commit ordering is fit only on the first 1x prefix.
    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4);
    let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS);
    let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0;
    if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0; while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }
    e45_print_pair("e51o_base_terminal_fit_identity_gate",base_fit_gate);
    e45_print_pair("e51o_base_unknown_parameter_nonzero",unknown_parameter_nonzero);

    let sign_targets:[]i32=zalloc_i(E51O_DEV_SAMPLES);
    let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51O_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    _zag_print("e51o_dev_targets,"); e45_print_i32(dev_positive); _zag_print(","); e45_print_i32(dev_negative); _zag_print(","); e45_print_i32(dev_neutral); _zag_println("");

    // Full-4x global linear sign control.
    let linear_weights:[]i32=zalloc_i(E45_FEATURES); let linear_bias:i32=0;
    let linear_sweeps_f:i32=0; let linear_reason_f:i32=0; let linear_trace_f:i32=0; let linear_loss_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51O_DEV_SAMPLES,0,linear_weights,0,&linear_bias,&linear_sweeps_f,&linear_reason_f,&linear_trace_f,&linear_loss_f);
    let reverse_linear_weights:[]i32=zalloc_i(E45_FEATURES); let reverse_linear_bias:i32=0;
    let linear_sweeps_r:i32=0; let linear_reason_r:i32=0; let linear_trace_r:i32=0; let linear_loss_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51O_DEV_SAMPLES,1,reverse_linear_weights,0,&reverse_linear_bias,&linear_sweeps_r,&linear_reason_r,&linear_trace_r,&linear_loss_r);
    let linear_identity_gate:i32=e51m_linear_identity(linear_weights,0,linear_bias,reverse_linear_weights,0,reverse_linear_bias,linear_sweeps_f,linear_sweeps_r,linear_reason_f,linear_reason_r,linear_trace_f,linear_trace_r,linear_loss_f,linear_loss_r);
    e45_print_pair("e51o_global_linear_identity_gate",linear_identity_gate);

    // Full-4x 16-hinge global control.
    let means:[]i32=zalloc_i(E45_FEATURES); let term_feature:[]i32=zalloc_i(E51M_MAX_HINGES); let term_direction:[]i32=zalloc_i(E51M_MAX_HINGES); let term_mean:[]i32=zalloc_i(E51M_MAX_HINGES); let term_coef:[]i32=zalloc_i(E51M_MAX_HINGES);
    let hinge_count_f:i32=0; let hinge_reason_f:i32=0; let hinge_trace_f:i32=0; let hinge_loss_f:i64=0;
    e51m_fit_hinges(dev_records,sign_targets,E51O_DEV_SAMPLES,0,linear_weights,0,linear_bias,means,0,term_feature,term_direction,term_mean,term_coef,0,&hinge_count_f,&hinge_reason_f,&hinge_trace_f,&hinge_loss_f);
    let rmeans:[]i32=zalloc_i(E45_FEATURES); let rfeature:[]i32=zalloc_i(E51M_MAX_HINGES); let rdirection:[]i32=zalloc_i(E51M_MAX_HINGES); let rmean:[]i32=zalloc_i(E51M_MAX_HINGES); let rcoef:[]i32=zalloc_i(E51M_MAX_HINGES);
    let hinge_count_r:i32=0; let hinge_reason_r:i32=0; let hinge_trace_r:i32=0; let hinge_loss_r:i64=0;
    e51m_fit_hinges(dev_records,sign_targets,E51O_DEV_SAMPLES,1,linear_weights,0,linear_bias,rmeans,0,rfeature,rdirection,rmean,rcoef,0,&hinge_count_r,&hinge_reason_r,&hinge_trace_r,&hinge_loss_r);
    let hinge_identity_gate:i32=e51m_hinge_identity(means,0,rmeans,0,term_feature,term_direction,term_mean,term_coef,0,rfeature,rdirection,rmean,rcoef,0,hinge_count_f,hinge_count_r,hinge_reason_f,hinge_reason_r,hinge_trace_f,hinge_trace_r,hinge_loss_f,hinge_loss_r);
    e45_print_pair("e51o_global_hinge_identity_gate",hinge_identity_gate); e45_print_pair("e51o_global_hinge_count",hinge_count_f);

    // Learner-owned local residual memory, forward and reverse audits.
    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS);
    let snapshot_corrections:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let snapshot_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let snapshot_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let local_count_f:i32=0; let local_trace_f:i32=0; let local_final_f:i64=0; let local_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51O_DEV_SAMPLES,linear_weights,0,linear_bias,0,prototypes,parents,snapshot_corrections,snapshot_counts,snapshot_losses,&local_count_f,&local_trace_f,&local_final_f,&local_strict_f);

    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS);
    let rsnapshot_corrections:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rsnapshot_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rsnapshot_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let local_count_r:i32=0; let local_trace_r:i32=0; let local_final_r:i64=0; let local_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51O_DEV_SAMPLES,linear_weights,0,linear_bias,1,rprototypes,rparents,rsnapshot_corrections,rsnapshot_counts,rsnapshot_losses,&local_count_r,&local_trace_r,&local_final_r,&local_strict_r);
    let local_identity_gate:i32=e51o_local_identity(prototypes,parents,snapshot_corrections,snapshot_counts,snapshot_losses,local_count_f,local_trace_f,local_final_f,local_strict_f,rprototypes,rparents,rsnapshot_corrections,rsnapshot_counts,rsnapshot_losses,local_count_r,local_trace_r,local_final_r,local_strict_r);
    e45_print_pair("e51o_local_forward_reverse_identity_gate",local_identity_gate); e45_print_pair("e51o_local_accepted_cells",local_count_f); e45_print_pair("e51o_local_strict_loss_gate",local_strict_f);
    _zag_print("e51o_local_final_loss_hash,"); e45_print_i32(e51m_hash_i64(local_final_f)); _zag_println("");

    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51O_DEV_SAMPLES,root,ranges);
    let level:i32=0;
    while(level<E51O_CAP_LEVELS){
        let cells:i32=snapshot_counts[level];
        let memory_units:i32=cells*(E45_FEATURES+2);
        let routing_ops:i32=E51O_VALIDATION_SAMPLES*r32e45_max(0,cells-1)*2*E45_FEATURES;
        _zag_print("e51o_capacity_resource,"); e45_print_i32(level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(memory_units); _zag_print(","); e45_print_i32(routing_ops); _zag_print(","); e45_print_i32(snapshot_losses[level]); _zag_println("");
        level=level+1;
    }

    // Fresh stage-59 validation.
    let validation_records:[]i32=zalloc_i(E51O_VALIDATION_SAMPLES*E50_RECORD_N); let validation_dummy:[]i32=zalloc_i(E51O_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_types:[]i32=zalloc_i(E51O_VALIDATION_EPISODES); let validation_targets:[]i32=zalloc_i(E51O_VALIDATION_SAMPLES);
    e45_zero(validation_records,E51O_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(validation_dummy,E51O_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_types[canonical_episode]=0; if(mode==0 || mode==1){ validation_types[canonical_episode]=1; }
                    e51e_build_training_episode(validation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,validation_records,validation_dummy,&validation_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_dummy); e51m_build_validation_targets(validation_records,E51O_VALIDATION_SAMPLES,terminal_weights,terminal_biases,validation_targets);
    e45_print_pair("e51o_validation_episodes_built",canonical_episode); e45_print_pair("e51o_validation_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51o_validation_unknown_target_nonzero",validation_unknown_nonzero);

    let base_known_total:i32=0; let base_known_reach:i32=0; let base_nu_total:i32=0; let base_nu_reach:i32=0;
    e51m_reachability(validation_records,validation_types,E51O_VALIDATION_EPISODES,terminal_weights,terminal_biases,0,linear_weights,0,linear_bias,term_feature,term_direction,term_mean,term_coef,0,0,&base_known_total,&base_known_reach,&base_nu_total,&base_nu_reach);
    _zag_print("e51o_control_base,"); e45_print_i32(base_known_reach); _zag_print(","); e45_print_i32(base_known_total); _zag_print(","); e45_print_i32(base_nu_reach); _zag_print(","); e45_print_i32(base_nu_total); _zag_println("");
    let lin_known_total:i32=0; let lin_known_reach:i32=0; let lin_nu_total:i32=0; let lin_nu_reach:i32=0;
    e51m_reachability(validation_records,validation_types,E51O_VALIDATION_EPISODES,terminal_weights,terminal_biases,1,linear_weights,0,linear_bias,term_feature,term_direction,term_mean,term_coef,0,0,&lin_known_total,&lin_known_reach,&lin_nu_total,&lin_nu_reach);
    _zag_print("e51o_control_linear,"); e45_print_i32(lin_known_reach); _zag_print(","); e45_print_i32(lin_known_total); _zag_print(","); e45_print_i32(lin_nu_reach); _zag_print(","); e45_print_i32(lin_nu_total); _zag_println("");
    let hinge_known_total:i32=0; let hinge_known_reach:i32=0; let hinge_nu_total:i32=0; let hinge_nu_reach:i32=0;
    e51m_reachability(validation_records,validation_types,E51O_VALIDATION_EPISODES,terminal_weights,terminal_biases,1,linear_weights,0,linear_bias,term_feature,term_direction,term_mean,term_coef,0,hinge_count_f,&hinge_known_total,&hinge_known_reach,&hinge_nu_total,&hinge_nu_reach);
    _zag_print("e51o_control_hinge16,"); e45_print_i32(hinge_known_reach); _zag_print(","); e45_print_i32(hinge_known_total); _zag_print(","); e45_print_i32(hinge_nu_reach); _zag_print(","); e45_print_i32(hinge_nu_total); _zag_println("");

    let exact_gate:i32=0; let winning_level:i32=-1;
    let local_known:[]i32=zalloc_i(E51O_CAP_LEVELS); let local_unknown:[]i32=zalloc_i(E51O_CAP_LEVELS);
    level=0;
    while(level<E51O_CAP_LEVELS){
        let cells:i32=snapshot_counts[level];
        let dpt:i32=0; let dpc:i32=0; let dnt:i32=0; let dnc:i32=0;
        e51o_local_sign_accuracy(dev_records,sign_targets,E51O_DEV_SAMPLES,linear_weights,linear_bias,prototypes,parents,ranges,snapshot_corrections,level*E51O_MAX_CELLS,cells,&dpt,&dpc,&dnt,&dnc);
        let vpt:i32=0; let vpc:i32=0; let vnt:i32=0; let vnc:i32=0;
        e51o_local_sign_accuracy(validation_records,validation_targets,E51O_VALIDATION_SAMPLES,linear_weights,linear_bias,prototypes,parents,ranges,snapshot_corrections,level*E51O_MAX_CELLS,cells,&vpt,&vpc,&vnt,&vnc);
        let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51o_local_reachability(validation_records,validation_types,E51O_VALIDATION_EPISODES,terminal_weights,terminal_biases,linear_weights,linear_bias,prototypes,parents,ranges,snapshot_corrections,level*E51O_MAX_CELLS,cells,&kt,&kr,&nt,&nr);
        local_known[level]=kr; local_unknown[level]=nr;
        if(exact_gate==0 && kr==kt && nr==nt){ exact_gate=1; winning_level=level; }
        _zag_print("e51o_local_arm,"); e45_print_i32(level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(dpc); _zag_print(","); e45_print_i32(dpt); _zag_print(","); e45_print_i32(dnc); _zag_print(","); e45_print_i32(dnt); _zag_print(","); e45_print_i32(vpc); _zag_print(","); e45_print_i32(vpt); _zag_print(","); e45_print_i32(vnc); _zag_print(","); e45_print_i32(vnt); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_println("");
        level=level+1;
    }

    let monotone_capacity:i32=1; let capacity_strict:i32=0;
    level=1;
    while(level<E51O_CAP_LEVELS){
        if(local_known[level]<local_known[level-1] || local_unknown[level]<local_unknown[level-1]){ monotone_capacity=0; }
        if(local_known[level]>local_known[level-1] || local_unknown[level]>local_unknown[level-1]){ capacity_strict=1; }
        level=level+1;
    }
    let capacity_signal:i32=0; if(monotone_capacity==1 && capacity_strict==1){ capacity_signal=1; }
    let tradeoff:i32=0;
    level=0;
    while(level<E51O_CAP_LEVELS){
        if(local_unknown[level]>lin_nu_reach && local_known[level]<lin_known_reach){ tradeoff=1; }
        level=level+1;
    }

    let counts_gate:i32=0; if(E51O_DEV_EPISODES*(E45_TAPE+1)==E51O_DEV_SAMPLES && canonical_episode==E51O_VALIDATION_EPISODES){ counts_gate=1; }
    let target_gate:i32=0; if(dev_unknown_nonzero==0 && validation_unknown_nonzero==0 && unknown_parameter_nonzero==0 && dev_positive>0 && dev_negative>0){ target_gate=1; }
    let integrity_gate:i32=0; if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && hinge_identity_gate==1 && local_identity_gate==1 && local_strict_f==1){ integrity_gate=1; }
    e45_print_pair("e51o_counts_gate",counts_gate); e45_print_pair("e51o_target_geometry_gate",target_gate); e45_print_pair("e51o_integrity_gate",integrity_gate); e45_print_pair("e51o_exact_validation_gate",exact_gate); e45_print_pair("e51o_monotone_capacity_signal",capacity_signal); e45_print_pair("e51o_tradeoff_signal",tradeoff); e45_print_pair("e51o_winning_level",winning_level);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(integrity_gate==1 && exact_gate==1 && winning_level>=0){
        let confirm_records:[]i32=zalloc_i(E51O_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_dummy:[]i32=zalloc_i(E51O_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_types:[]i32=zalloc_i(E51O_CONFIRM_EPISODES);
        e45_zero(confirm_records,E51O_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(confirm_dummy,E51O_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<40){
                        let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                        confirm_types[canonical_episode]=0; if(mode==0 || mode==1){ confirm_types[canonical_episode]=1; }
                        e51e_build_training_episode(confirmation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,confirm_records,confirm_dummy,&confirm_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        let cells:i32=snapshot_counts[winning_level]; let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51o_local_reachability(confirm_records,confirm_types,E51O_CONFIRM_EPISODES,terminal_weights,terminal_biases,linear_weights,linear_bias,prototypes,parents,ranges,snapshot_corrections,winning_level*E51O_MAX_CELLS,cells,&kt,&kr,&nt,&nr);
        confirmation_executed=canonical_episode; if(kr==kt && nr==nt && confirm_unknown_nonzero==0){ confirmation_exact=1; }
        _zag_print("e51o_confirmation,"); e45_print_i32(winning_level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_print(","); e45_print_i32(confirm_unknown_nonzero); _zag_println("");
        zfree(confirm_records); zfree(confirm_dummy); zfree(confirm_types);
    }
    e45_print_pair("e51o_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51o_confirmation_exact_gate",confirmation_exact);

    if(integrity_gate==0){ _zag_println("e51o_outcome,INVALID_LOCAL_CALIBRATION_INTEGRITY_FAILURE");
    }else{
        if(exact_gate==1 && confirmation_exact==1){ _zag_println("e51o_outcome,LOCAL_CALIBRATION_RESCUE_CONFIRMED");
        }else{
            if(exact_gate==1){ _zag_println("e51o_outcome,LOCAL_CALIBRATION_VALIDATION_RESCUE_CONFIRMATION_FAIL");
            }else{
                if(capacity_signal==1){ _zag_println("e51o_outcome,LOCAL_CALIBRATION_CAPACITY_SIGNAL");
                }else{
                    if(tradeoff==1){ _zag_println("e51o_outcome,LOCAL_CALIBRATION_TRADEOFF");
                    }else{ _zag_println("e51o_outcome,LOCAL_CALIBRATION_PLATEAU"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51O_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(validation_worlds); zfree(confirmation_worlds); zfree(dev_records); zfree(sign_targets);
    zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases);
    zfree(linear_weights); zfree(reverse_linear_weights); zfree(means); zfree(term_feature); zfree(term_direction); zfree(term_mean); zfree(term_coef); zfree(rmeans); zfree(rfeature); zfree(rdirection); zfree(rmean); zfree(rcoef);
    zfree(prototypes); zfree(parents); zfree(snapshot_corrections); zfree(snapshot_counts); zfree(snapshot_losses); zfree(rprototypes); zfree(rparents); zfree(rsnapshot_corrections); zfree(rsnapshot_counts); zfree(rsnapshot_losses); zfree(ranges); zfree(root);
    zfree(validation_records); zfree(validation_types); zfree(validation_targets); zfree(local_known); zfree(local_unknown);
    return 1;
}

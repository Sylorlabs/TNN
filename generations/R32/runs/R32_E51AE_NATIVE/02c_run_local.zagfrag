    let local_identity:i32=1; let dev_gates:[]i32=zalloc_i(4); dev_gates[1]=global_development_gate; let arm:i32=E51AE_ARM_LOCAL_96;
    while(arm<=E51AE_ARM_LOCAL_384){
        let dose:i32=e51ae_dose(arm); let fw:[]i32=local96_first; let fb:[]i32=local96_first_b; let ow:[]i32=local96_w; let ob:[]i32=local96_b; let rfw:[]i32=rlocal96_first; let rfb:[]i32=rlocal96_first_b; let row:[]i32=rlocal96_w; let rob:[]i32=rlocal96_b;
        if(arm==E51AE_ARM_LOCAL_384){ fw=local384_first; fb=local384_first_b; ow=local384_w; ob=local384_b; rfw=rlocal384_first; rfb=rlocal384_first_b; row=rlocal384_w; rob=rlocal384_b; }
        let rounds:i32=0; let updates:i32=0; let sweeps:i32=0; let stop:i32=0; let selection:i32=0; let fit:i32=0; let loss:i64=0; let strict:i32=0; let preserve:i32=0; let rescue:i32=0;

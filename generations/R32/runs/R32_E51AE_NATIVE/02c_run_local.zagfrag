    // Matched local residual doses, full forward/reverse round identity.
    let model_w:i32=E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES; let model_b:i32=E51AB_CANDIDATES*E51AE_CELLS;
    let local96_first:[]i32=zalloc_i(model_w); let local96_first_b:[]i32=zalloc_i(model_b); let local96_w:[]i32=zalloc_i(model_w); let local96_b:[]i32=zalloc_i(model_b); let rlocal96_first:[]i32=zalloc_i(model_w); let rlocal96_first_b:[]i32=zalloc_i(model_b); let rlocal96_w:[]i32=zalloc_i(model_w); let rlocal96_b:[]i32=zalloc_i(model_b);

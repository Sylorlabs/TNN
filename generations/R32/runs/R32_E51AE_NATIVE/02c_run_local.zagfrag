        e51ae_fit_local_dose(dev_control,dev_direct,E51AE_DEV_EPISODES,accessible,direct_success,kinds,union_count,copies,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,1,dose,rfw,rfb,row,rob,&rrounds,&rupdates,&rsweeps,&rstop,&rselection,&rfit,&rloss,&rstrict,&rpreserve,&rrescue);
        let id:i32=0; if(rounds==rrounds && updates==rupdates && sweeps==rsweeps && stop==rstop && selection==rselection && fit==rfit && loss==rloss && strict==1 && rstrict==1 && preserve==rpreserve && rescue==rrescue && e51ae_local_equal(fw,fb,rfw,rfb)==1 && e51ae_local_equal(ow,ob,row,rob)==1){ id=1; } if(id==0){ local_identity=0; }
        let dgate:i32=0; if(preserve==union_count){ dgate=1; } dev_gates[arm]=dgate;
        _zag_print("e51ae_local_fit,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(dose); _zag_print(","); e45_print_i32(rounds); _zag_print(","); e45_print_i32(updates); _zag_print(","); e45_print_i32(sweeps); _zag_print(","); e45_print_i32(stop); _zag_print(","); e45_print_i32(selection); _zag_print(","); e45_print_i32(fit); _zag_print(","); e45_print_i64(loss); _zag_print(","); e45_print_i32(preserve); _zag_print(","); e45_print_i32(rescue); _zag_print(","); e45_print_i32(dgate); _zag_print(","); e45_print_i32(id); _zag_println("");

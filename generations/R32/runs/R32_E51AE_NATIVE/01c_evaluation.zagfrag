fn e51ae_eval_partition(
    stage:i32,episodes:i32,per_cell:i32,active_arm:i32,
    control_records:[]i32,direct_records:[]i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local96_w:[]i32,local96_b:[]i32,local384_w:[]i32,local384_b:[]i32,
    result:[]i32,mode_reach:[]i32,resource_reach:[]i32
)void {
    e45_zero(result,E51AE_ARMS*E51AE_FIELDS); e45_zero(mode_reach,E51AE_ARMS*E45_MODES); e45_zero(resource_reach,E51AE_ARMS*E45_RESOURCES);
    let accessible:[]i32=zalloc_i(episodes*(E45_TAPE+1)); e51ae_build_accessible(stage,episodes,per_cell,accessible);
    let slot_success:[]i32=zalloc_i(episodes*(E45_TAPE+1)); let direct_success:[]i32=zalloc_i(episodes*(E45_TAPE+1)); let base_kinds:[]i32=zalloc_i(episodes);
    let pc:i32=0; let dc:i32=0; let nc:i32=0;
    e51ad_prepare_support(stage,episodes,per_cell,control_records,direct_records,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,slot_success,direct_success,base_kinds,&pc,&dc,&nc);
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES); let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES); let no_unique:i32=0; if(mode==0 || mode==1){ no_unique=1; }
        let arm_lo:i32=0; let arm_hi:i32=E51AE_ARMS; if(active_arm>=0){ arm_lo=active_arm; arm_hi=active_arm+1; }
        let arm:i32=arm_lo;
        while(arm<arm_hi){
            let s:i32=arm*E51AE_FIELDS; result[s+E51AE_EPISODES]=result[s+E51AE_EPISODES]+1; if(no_unique==1){ result[s+E51AE_NO_UNIQUE]=result[s+E51AE_NO_UNIQUE]+1; }else{ result[s+E51AE_KNOWN]=result[s+E51AE_KNOWN]+1; }
            let reached:i32=0; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t;
                if(accessible[index]==1){
                    let rs:i32=index*E50_RECORD_N; let success:i32=0; let choice:i32=R32E45_TERM_UNKNOWN;
                    if(arm==E51AE_ARM_UNION_CONTROL){ if(slot_success[index]==1 || direct_success[index]==1){ success=1; }
                    }else{ if(arm==E51AE_ARM_DIRECT_ORACLE){ success=1; if(direct_records[rs+34]>0){ choice=E51AC_CHOICE_CANDIDATE_0; }else{ if(direct_records[rs+35]>0){ choice=E51AC_CHOICE_CANDIDATE_1; } }
                        }else{
                            let local_active:i32=0; let lw:[]i32=local96_w; let lb:[]i32=local96_b;
                            if(arm==E51AE_ARM_LOCAL_96){ local_active=1; lw=local96_w; lb=local96_b; }
                            if(arm==E51AE_ARM_LOCAL_384){ local_active=1; lw=local384_w; lb=local384_b; }
                            choice=e51ae_policy_choice(local_active,control_records,direct_records,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_weights,direct_biases,rg0,rb0,rg1,rb1,lw,lb);
                            success=e51ac_choice_success(choice,control_records,direct_records,rs);
                        }
                    }
                    if(t==0){ if(success==1){ result[s+E51AE_T0_SUCCESS]=result[s+E51AE_T0_SUCCESS]+1; }else{ if(arm>=E51AE_ARM_GLOBAL && arm<=E51AE_ARM_LOCAL_384){ if(choice==R32E45_TERM_UNKNOWN){ result[s+E51AE_T0_UNKNOWN]=result[s+E51AE_T0_UNKNOWN]+1; }else{ result[s+E51AE_T0_WRONG]=result[s+E51AE_T0_WRONG]+1; } } } }
                    if(success==1){ reached=1; }
                }
                t=t+1;
            }
            if(reached==1){ result[s+E51AE_REACHABLE]=result[s+E51AE_REACHABLE]+1; mode_reach[arm*E45_MODES+mode]=mode_reach[arm*E45_MODES+mode]+1; resource_reach[arm*E45_RESOURCES+resource]=resource_reach[arm*E45_RESOURCES+resource]+1; if(no_unique==1){ result[s+E51AE_NO_UNIQUE_REACHABLE]=result[s+E51AE_NO_UNIQUE_REACHABLE]+1; }else{ result[s+E51AE_KNOWN_REACHABLE]=result[s+E51AE_KNOWN_REACHABLE]+1; } }
            arm=arm+1;
        }
        episode=episode+1;
    }
    zfree(accessible); zfree(slot_success); zfree(direct_success); zfree(base_kinds);
}

fn e51ae_print_result(prefix:[]u8,result:[]i32,arm:i32)void {
    let s:i32=arm*E51AE_FIELDS; _zag_print(prefix); _zag_print(","); e45_print_i32(arm);
    let f:i32=0; while(f<E51AE_FIELDS){ _zag_print(","); e45_print_i32(result[s+f]); f=f+1; } _zag_println("");
}


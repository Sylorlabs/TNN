    // E51AG: exact reconstruction gate before opening any fresh replica.
    let replication_world_gate:i32=e51ag_replication_world_gate();
    let reconstruction_gate:i32=0;
    if(pre_validation_integrity==1 && replication_world_gate==1 &&
       dev_built==12960 && slot_count==12355 && direct_count==289 && neither_known==315 && neither_nu==1 &&
       union_count==12644 && copies==1 && expected_critical==605 && critical_count==605 &&
       critical_trace==354012291 && critical_hash==841951745 && record_isolation==1 &&
       s00==32 && r00==2 && h00==547504260 && l00==254939881 &&
       s10==32 && r10==2 && h10==444148704 && l10==274963742 &&
       global_identity==1 && global_preserve==12135 && global_rescue==230 && global_margin_loss==6272814 &&
       local_identity==1 && dev_gates[1]==0 && dev_gates[2]==0 && dev_gates[3]==0 &&
       terminal_hash_before==238967492 && terminal_hash_after_training==238967492 &&
       direct_hash_before==1790306570 && direct_hash_after_training==1790306570){
        reconstruction_gate=1;
    }
    e45_print_pair("e51ag_reconstruction_gate",reconstruction_gate);
    e45_print_pair("e51ag_reconstruction_expected_critical",605);
    e45_print_pair("e51ag_reconstruction_observed_critical",critical_count);
    e45_print_pair("e51ag_reconstruction_critical_trace",critical_trace);
    e45_print_pair("e51ag_reconstruction_critical_hash",critical_hash);

    let outcome:i32=0;
    if(reconstruction_gate==1){
        let repa_result:[]i32=zalloc_i(E51AG_ARMS*E51AG_FIELDS); let repa_mode:[]i32=zalloc_i(E51AG_ARMS*E45_MODES); let repa_resource:[]i32=zalloc_i(E51AG_ARMS*E45_RESOURCES);
        let repb_result:[]i32=zalloc_i(E51AG_ARMS*E51AG_FIELDS); let repb_mode:[]i32=zalloc_i(E51AG_ARMS*E45_MODES); let repb_resource:[]i32=zalloc_i(E51AG_ARMS*E45_RESOURCES);
        let repc_result:[]i32=zalloc_i(E51AG_ARMS*E51AG_FIELDS); let repc_mode:[]i32=zalloc_i(E51AG_ARMS*E45_MODES); let repc_resource:[]i32=zalloc_i(E51AG_ARMS*E45_RESOURCES);

        // Replica A: stage 104.
        let repa_control:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N); let repa_direct:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repa_t0:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repa_t1:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repa_pos:[]i32=zalloc_i(2); let repa_neg:[]i32=zalloc_i(2); let repa_unknown:i32=0;
        e45_zero(repa_control,E51AG_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(repa_direct,E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repa_built:i32=e51ab_build_partition(E51AG_STAGE_VALIDATION,E51AG_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,repa_control,repa_direct,repa_t0,repa_t1,repa_pos,repa_neg,&repa_unknown);
        zfree(repa_t0); zfree(repa_t1); zfree(repa_pos); zfree(repa_neg);
        e51ag_eval_partition(E51AG_STAGE_VALIDATION,E51AG_VALIDATION_EPISODES,20,-1,repa_control,repa_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,repa_result,repa_mode,repa_resource);
        zfree(repa_control); zfree(repa_direct);

        // Replica B: stage 105.
        let repb_control:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N); let repb_direct:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repb_t0:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repb_t1:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repb_pos:[]i32=zalloc_i(2); let repb_neg:[]i32=zalloc_i(2); let repb_unknown:i32=0;
        e45_zero(repb_control,E51AG_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(repb_direct,E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repb_built:i32=e51ab_build_partition(E51AG_STAGE_VALIDATION_B,E51AG_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,repb_control,repb_direct,repb_t0,repb_t1,repb_pos,repb_neg,&repb_unknown);
        zfree(repb_t0); zfree(repb_t1); zfree(repb_pos); zfree(repb_neg);
        e51ag_eval_partition(E51AG_STAGE_VALIDATION_B,E51AG_VALIDATION_EPISODES,20,-1,repb_control,repb_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,repb_result,repb_mode,repb_resource);
        zfree(repb_control); zfree(repb_direct);

        // Replica C: stage 106.
        let repc_control:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N); let repc_direct:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repc_t0:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repc_t1:[]i32=zalloc_i(E51AG_VALIDATION_SAMPLES); let repc_pos:[]i32=zalloc_i(2); let repc_neg:[]i32=zalloc_i(2); let repc_unknown:i32=0;
        e45_zero(repc_control,E51AG_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(repc_direct,E51AG_VALIDATION_SAMPLES*E50_RECORD_N);
        let repc_built:i32=e51ab_build_partition(E51AG_STAGE_VALIDATION_C,E51AG_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,repc_control,repc_direct,repc_t0,repc_t1,repc_pos,repc_neg,&repc_unknown);
        zfree(repc_t0); zfree(repc_t1); zfree(repc_pos); zfree(repc_neg);
        e51ag_eval_partition(E51AG_STAGE_VALIDATION_C,E51AG_VALIDATION_EPISODES,20,-1,repc_control,repc_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,repc_result,repc_mode,repc_resource);
        zfree(repc_control); zfree(repc_direct);

        _zag_println("e51ag_replica_columns,prefix_arm,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong");
        arm=0; while(arm<E51AG_ARMS){ e51ag_print_result("e51ag_replica_A",repa_result,arm); arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ e51ag_print_result("e51ag_replica_B",repb_result,arm); arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ e51ag_print_result("e51ag_replica_C",repc_result,arm); arm=arm+1; }

        arm=0; while(arm<E51AG_ARMS){ let m:i32=0; while(m<E45_MODES){ _zag_print("e51ag_replica_mode,A,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(repa_mode[arm*E45_MODES+m]); _zag_println(""); m=m+1; } arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ let m:i32=0; while(m<E45_MODES){ _zag_print("e51ag_replica_mode,B,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(repb_mode[arm*E45_MODES+m]); _zag_println(""); m=m+1; } arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ let m:i32=0; while(m<E45_MODES){ _zag_print("e51ag_replica_mode,C,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(repc_mode[arm*E45_MODES+m]); _zag_println(""); m=m+1; } arm=arm+1; }

        arm=0; while(arm<E51AG_ARMS){ let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ag_replica_resource,A,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(repa_resource[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; } arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ag_replica_resource,B,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(repb_resource[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; } arm=arm+1; }
        arm=0; while(arm<E51AG_ARMS){ let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ag_replica_resource,C,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(repc_resource[arm*E45_RESOURCES+r]); _zag_println(""); r=r+1; } arm=arm+1; }

        let terminal_hash_after_replicas:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
        let direct_hash_after_replicas:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
        let frozen_replica_gate:i32=0; if(terminal_hash_after_replicas==terminal_hash_before && direct_hash_after_replicas==direct_hash_before){ frozen_replica_gate=1; }
        let replica_integrity:i32=0;
        if(repa_built==5400 && repb_built==5400 && repc_built==5400 && repa_unknown==0 && repb_unknown==0 && repc_unknown==0 &&
           repa_result[E51AG_KNOWN]==4200 && repa_result[E51AG_NO_UNIQUE]==1200 &&
           repb_result[E51AG_KNOWN]==4200 && repb_result[E51AG_NO_UNIQUE]==1200 &&
           repc_result[E51AG_KNOWN]==4200 && repc_result[E51AG_NO_UNIQUE]==1200 && frozen_replica_gate==1){
            replica_integrity=1;
        }
        e45_print_pair("e51ag_replica_a_built",repa_built); e45_print_pair("e51ag_replica_b_built",repb_built); e45_print_pair("e51ag_replica_c_built",repc_built);
        e45_print_pair("e51ag_replica_a_unknown_target_nonzero",repa_unknown); e45_print_pair("e51ag_replica_b_unknown_target_nonzero",repb_unknown); e45_print_pair("e51ag_replica_c_unknown_target_nonzero",repc_unknown);
        e45_print_pair("e51ag_frozen_replica_gate",frozen_replica_gate); e45_print_pair("e51ag_replica_integrity_gate",replica_integrity);

        let exact_winner:i32=-1; arm=E51AG_ARM_GLOBAL;
        while(arm<=E51AG_ARM_LOCAL_384){
            let s:i32=arm*E51AG_FIELDS; let exact:i32=0;
            if(repa_result[s+E51AG_REACHABLE]==5400 && repa_result[s+E51AG_KNOWN_REACHABLE]==4200 && repa_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200 &&
               repb_result[s+E51AG_REACHABLE]==5400 && repb_result[s+E51AG_KNOWN_REACHABLE]==4200 && repb_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200 &&
               repc_result[s+E51AG_REACHABLE]==5400 && repc_result[s+E51AG_KNOWN_REACHABLE]==4200 && repc_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200){
                exact=1; if(exact_winner<0){ exact_winner=arm; }
            }
            _zag_print("e51ag_exact_replica_gate,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(exact); _zag_println("");
            arm=arm+1;
        }
        if(replica_integrity!=1){ exact_winner=-1; }

        let improvement_arm:i32=-1; let stable_negative:i32=1; arm=E51AG_ARM_GLOBAL;
        let ca:i32=repa_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_REACHABLE];
        let cb:i32=repb_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_REACHABLE];
        let cc:i32=repc_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_REACHABLE];
        let cka:i32=repa_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_KNOWN_REACHABLE];
        let ckb:i32=repb_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_KNOWN_REACHABLE];
        let ckc:i32=repc_result[E51AG_ARM_UNION_CONTROL*E51AG_FIELDS+E51AG_KNOWN_REACHABLE];
        while(arm<=E51AG_ARM_LOCAL_384){
            let s:i32=arm*E51AG_FIELDS;
            if(repa_result[s+E51AG_REACHABLE]>ca || repb_result[s+E51AG_REACHABLE]>cb || repc_result[s+E51AG_REACHABLE]>cc){ stable_negative=0; }
            if(improvement_arm<0 &&
               repa_result[s+E51AG_REACHABLE]>ca && repb_result[s+E51AG_REACHABLE]>cb && repc_result[s+E51AG_REACHABLE]>cc &&
               repa_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200 && repb_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200 && repc_result[s+E51AG_NO_UNIQUE_REACHABLE]==1200 &&
               repa_result[s+E51AG_KNOWN_REACHABLE]>=cka && repb_result[s+E51AG_KNOWN_REACHABLE]>=ckb && repc_result[s+E51AG_KNOWN_REACHABLE]>=ckc){
                improvement_arm=arm;
            }
            arm=arm+1;
        }
        e45_print_pair("e51ag_exact_winner_arm",exact_winner); e45_print_pair("e51ag_stable_improvement_arm",improvement_arm); e45_print_pair("e51ag_stable_negative_gate",stable_negative);

        let confirmation_executed:i32=0; let confirmation_exact:i32=0; let confirmation_integrity:i32=1;
        if(replica_integrity==1 && exact_winner>=E51AG_ARM_GLOBAL){
            let conf_control:[]i32=zalloc_i(E51AG_CONFIRM_SAMPLES*E50_RECORD_N); let conf_direct:[]i32=zalloc_i(E51AG_CONFIRM_SAMPLES*E50_RECORD_N);
            let conf_t0:[]i32=zalloc_i(E51AG_CONFIRM_SAMPLES); let conf_t1:[]i32=zalloc_i(E51AG_CONFIRM_SAMPLES); let conf_pos:[]i32=zalloc_i(2); let conf_neg:[]i32=zalloc_i(2); let conf_unknown:i32=0;
            e45_zero(conf_control,E51AG_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(conf_direct,E51AG_CONFIRM_SAMPLES*E50_RECORD_N);
            let conf_built:i32=e51ab_build_partition(E51AG_STAGE_CONFIRM,E51AG_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,conf_control,conf_direct,conf_t0,conf_t1,conf_pos,conf_neg,&conf_unknown);
            zfree(conf_t0); zfree(conf_t1); zfree(conf_pos); zfree(conf_neg);
            let conf_result:[]i32=zalloc_i(E51AG_ARMS*E51AG_FIELDS); let conf_mode:[]i32=zalloc_i(E51AG_ARMS*E45_MODES); let conf_resource:[]i32=zalloc_i(E51AG_ARMS*E45_RESOURCES);
            e51ag_eval_partition(E51AG_STAGE_CONFIRM,E51AG_CONFIRM_EPISODES,40,exact_winner,conf_control,conf_direct,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b,g0,b0,g1,b1,direct_lw,direct_lb,res_g0,res_b0,res_g1,res_b1,local96_w,local96_b,local384_w,local384_b,conf_result,conf_mode,conf_resource);
            confirmation_executed=E51AG_CONFIRM_EPISODES; e51ag_print_result("e51ag_confirmation",conf_result,exact_winner);
            let cs:i32=exact_winner*E51AG_FIELDS;
            let terminal_hash_after_confirmation:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
            let direct_hash_after_confirmation:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
            if(conf_built!=E51AG_CONFIRM_EPISODES || conf_unknown!=0 || terminal_hash_after_confirmation!=terminal_hash_before || direct_hash_after_confirmation!=direct_hash_before){ confirmation_integrity=0; }
            if(confirmation_integrity==1 && conf_result[cs+E51AG_REACHABLE]==10800 && conf_result[cs+E51AG_KNOWN_REACHABLE]==8400 && conf_result[cs+E51AG_NO_UNIQUE_REACHABLE]==2400){ confirmation_exact=1; }
            let m:i32=0; while(m<E45_MODES){ _zag_print("e51ag_confirmation_mode,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(m); _zag_print(","); e45_print_i32(conf_mode[exact_winner*E45_MODES+m]); _zag_println(""); m=m+1; }
            let r:i32=0; while(r<E45_RESOURCES){ _zag_print("e51ag_confirmation_resource,"); e45_print_i32(exact_winner); _zag_print(","); e45_print_i32(r); _zag_print(","); e45_print_i32(conf_resource[exact_winner*E45_RESOURCES+r]); _zag_println(""); r=r+1; }
            zfree(conf_control); zfree(conf_direct); zfree(conf_result); zfree(conf_mode); zfree(conf_resource);
        }
        e45_print_pair("e51ag_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51ag_confirmation_exact_gate",confirmation_exact); e45_print_pair("e51ag_confirmation_integrity_gate",confirmation_integrity);

        if(replica_integrity!=1 || confirmation_integrity!=1){
            _zag_println("e51ag_outcome,INVALID_E51AG_INTEGRITY_FAILURE");
        }else{
            if(exact_winner>=E51AG_ARM_GLOBAL){
                if(confirmation_exact==1){ _zag_println("e51ag_outcome,CURRENT_RESIDUAL_REPLICATION_EXACT"); outcome=1;
                }else{ _zag_println("e51ag_outcome,CURRENT_RESIDUAL_REPLICATION_EXACT_NOT_CONFIRMED"); }
            }else{
                if(improvement_arm>=E51AG_ARM_GLOBAL){ _zag_println("e51ag_outcome,CURRENT_RESIDUAL_REPLICATION_STABLE_IMPROVEMENT");
                }else{ if(stable_negative==1){ _zag_println("e51ag_outcome,CURRENT_RESIDUAL_REPLICATION_STABLE_NEGATIVE");
                    }else{ _zag_println("e51ag_outcome,CURRENT_RESIDUAL_REPLICATION_UNSTABLE"); }
                }
            }
        }

        zfree(repa_result); zfree(repa_mode); zfree(repa_resource); zfree(repb_result); zfree(repb_mode); zfree(repb_resource); zfree(repc_result); zfree(repc_mode); zfree(repc_resource);
    }else{
        _zag_println("e51ag_outcome,INVALID_E51AG_INTEGRITY_FAILURE");
        e45_print_pair("e51ag_sealed_confirmation_executed",0);
    }

    _zag_println("TNN_R32_E51AG_EXECUTION_COMPLETE=1");
    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb); zfree(dev_control); zfree(dev_direct); zfree(slot_success); zfree(direct_success); zfree(base_kinds); zfree(accessible); zfree(kinds); zfree(zero_local); zfree(zero_local_b); zfree(res_g0); zfree(res_g1);
    zfree(local96_first); zfree(local96_first_b); zfree(local96_w); zfree(local96_b); zfree(rlocal96_first); zfree(rlocal96_first_b); zfree(rlocal96_w); zfree(rlocal96_b); zfree(local384_first); zfree(local384_first_b); zfree(local384_w); zfree(local384_b); zfree(rlocal384_first); zfree(rlocal384_first_b); zfree(rlocal384_w); zfree(rlocal384_b); zfree(dev_gates);
    return outcome;
}

fn e51s_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51S_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51s_extended_expert_optimization_curve_v1");
    _zag_println("claim_boundary,native_extended_training_dose_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0");
    _zag_println("commit_order_changed=0");
    _zag_println("routing_cells_fixed=32");
    _zag_println("interaction_capacity_added=0");
    _zag_println("global_topology_changed=0");
    _zag_println("graph_privileged=0");

    let dev_worlds:[]i32=zalloc_i(E51S_DEV_EPISODES);
    let validation_worlds:[]i32=zalloc_i(E51S_VALIDATION_EPISODES);
    let confirmation_worlds:[]i32=zalloc_i(E51S_CONFIRM_EPISODES);
    let world_gate:i32=e51s_allocate_worlds(dev_worlds,validation_worlds,confirmation_worlds);

    let dev_records:[]i32=zalloc_i(E51S_DEV_SAMPLES*E50_RECORD_N);
    let dummy:[]i32=zalloc_i(E51S_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51S_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51S_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0; let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(
                            dev_worlds[index],mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
                            dev_records,dummy,&dev_unknown_nonzero,&dummy_positive,&dummy_negative
                        );
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy);
    e45_print_pair("e51s_development_episodes_built",canonical_episode);
    e45_print_pair("e51s_development_states_built",canonical_episode*(E45_TAPE+1));
    e45_print_pair("e51s_dev_unknown_target_nonzero",dev_unknown_nonzero);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4);
    let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS);
    let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4);
    e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(
        dev_records,0,0,terminal_weights,terminal_biases,
        backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases
    );
    let unknown_parameter_nonzero:i32=0;
    if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0;
    while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }
    e45_print_pair("e51s_base_terminal_fit_identity_gate",base_fit_gate);
    e45_print_pair("e51s_base_unknown_parameter_nonzero",unknown_parameter_nonzero);

    let sign_targets:[]i32=zalloc_i(E51S_DEV_SAMPLES);
    let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51S_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    _zag_print("e51s_dev_targets,"); e45_print_i32(dev_positive); _zag_print(","); e45_print_i32(dev_negative); _zag_print(","); e45_print_i32(dev_neutral); _zag_println("");

    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0;
    let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51S_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0;
    let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51S_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let linear_identity_gate:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);
    e45_print_pair("e51s_global_linear_identity_gate",linear_identity_gate);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS);
    let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_f:i32=0; let tree_trace_f:i32=0; let tree_loss_f:i64=0; let tree_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tree_count_f,&tree_trace_f,&tree_loss_f,&tree_strict_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS);
    let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_r:i32=0; let tree_trace_r:i32=0; let tree_loss_r:i64=0; let tree_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tree_count_r,&tree_trace_r,&tree_loss_r,&tree_strict_r);
    let tree_identity_gate:i32=e51o_local_identity(
        prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tree_count_f,tree_trace_f,tree_loss_f,tree_strict_f,
        rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tree_count_r,tree_trace_r,tree_loss_r,tree_strict_r
    );
    e45_print_pair("e51s_routing_tree_identity_gate",tree_identity_gate); e45_print_pair("e51s_routing_tree_cells",tree_count_f);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51S_DEV_SAMPLES,root,ranges);

    let snapshot_weights:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES);
    let snapshot_biases:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS);
    let snapshot_updates:[]i32=zalloc_i(E51S_SNAPSHOTS); let snapshot_sweeps:[]i32=zalloc_i(E51S_SNAPSHOTS); let snapshot_reasons:[]i32=zalloc_i(E51S_SNAPSHOTS); let snapshot_traces:[]i32=zalloc_i(E51S_SNAPSHOTS); let snapshot_loss_low:[]i32=zalloc_i(E51S_SNAPSHOTS); let snapshot_loss_high:[]i32=zalloc_i(E51S_SNAPSHOTS);
    let strict_f:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,0,snapshot_weights,snapshot_biases,snapshot_updates,snapshot_sweeps,snapshot_reasons,snapshot_traces,snapshot_loss_low,snapshot_loss_high,&strict_f);

    let reverse_weights:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES);
    let reverse_biases:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS);
    let reverse_updates:[]i32=zalloc_i(E51S_SNAPSHOTS); let reverse_sweeps:[]i32=zalloc_i(E51S_SNAPSHOTS); let reverse_reasons:[]i32=zalloc_i(E51S_SNAPSHOTS); let reverse_traces:[]i32=zalloc_i(E51S_SNAPSHOTS); let reverse_loss_low:[]i32=zalloc_i(E51S_SNAPSHOTS); let reverse_loss_high:[]i32=zalloc_i(E51S_SNAPSHOTS);
    let strict_r:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,1,reverse_weights,reverse_biases,reverse_updates,reverse_sweeps,reverse_reasons,reverse_traces,reverse_loss_low,reverse_loss_high,&strict_r);
    let expert_identity_gate:i32=e51s_snapshots_identity(snapshot_weights,snapshot_biases,snapshot_updates,snapshot_sweeps,snapshot_reasons,snapshot_traces,snapshot_loss_low,snapshot_loss_high,reverse_weights,reverse_biases,reverse_updates,reverse_sweeps,reverse_reasons,reverse_traces,reverse_loss_low,reverse_loss_high);
    e45_print_pair("e51s_snapshot_forward_reverse_identity_gate",expert_identity_gate);
    e45_print_pair("e51s_expert_strict_loss_gate_forward",strict_f); e45_print_pair("e51s_expert_strict_loss_gate_reverse",strict_r);
    let snapshot:i32=0;
    while(snapshot<E51S_SNAPSHOTS){
        _zag_print("e51s_fit_snapshot,"); e45_print_i32(snapshot); _zag_print(","); e45_print_i32(e51s_sweep_snapshot(snapshot)); _zag_print(","); e45_print_i32(snapshot_sweeps[snapshot]); _zag_print(","); e45_print_i32(snapshot_updates[snapshot]); _zag_print(","); e45_print_i32(snapshot_reasons[snapshot]); _zag_print(","); e45_print_i32(snapshot_traces[snapshot]); _zag_print(","); e45_print_i32(snapshot_loss_low[snapshot]); _zag_print(","); e45_print_i32(snapshot_loss_high[snapshot]); _zag_println("");
        snapshot=snapshot+1;
    }

    let validation_records:[]i32=zalloc_i(E51S_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_dummy:[]i32=zalloc_i(E51S_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_types:[]i32=zalloc_i(E51S_VALIDATION_EPISODES);
    let validation_targets:[]i32=zalloc_i(E51S_VALIDATION_SAMPLES);
    e45_zero(validation_records,E51S_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(validation_dummy,E51S_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_types[canonical_episode]=0; if(mode==0 || mode==1){ validation_types[canonical_episode]=1; }
                    e51e_build_training_episode(validation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,validation_records,validation_dummy,&validation_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_dummy);
    e51m_build_validation_targets(validation_records,E51S_VALIDATION_SAMPLES,terminal_weights,terminal_biases,validation_targets);
    e45_print_pair("e51s_validation_episodes_built",canonical_episode); e45_print_pair("e51s_validation_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51s_validation_unknown_target_nonzero",validation_unknown_nonzero);

    let bkt:i32=0; let bkr:i32=0; let bnt:i32=0; let bnr:i32=0;
    e51m_reachability(validation_records,validation_types,E51S_VALIDATION_EPISODES,terminal_weights,terminal_biases,0,global_weights,0,global_bias,prototypes,parents,ranges,prototypes,0,0,&bkt,&bkr,&bnt,&bnr);
    _zag_print("e51s_control_base,"); e45_print_i32(bkr); _zag_print(","); e45_print_i32(bkt); _zag_print(","); e45_print_i32(bnr); _zag_print(","); e45_print_i32(bnt); _zag_println("");
    let lkt:i32=0; let lkr:i32=0; let lnt:i32=0; let lnr:i32=0;
    e51m_reachability(validation_records,validation_types,E51S_VALIDATION_EPISODES,terminal_weights,terminal_biases,1,global_weights,0,global_bias,prototypes,parents,ranges,prototypes,0,0,&lkt,&lkr,&lnt,&lnr);
    _zag_print("e51s_control_linear,"); e45_print_i32(lkr); _zag_print(","); e45_print_i32(lkt); _zag_print(","); e45_print_i32(lnr); _zag_print(","); e45_print_i32(lnt); _zag_println("");

    let known_results:[]i32=zalloc_i(E51S_SNAPSHOTS); let unknown_results:[]i32=zalloc_i(E51S_SNAPSHOTS);
    let exact_gate:i32=0; let winning_snapshot:i32=-1;
    snapshot=0;
    while(snapshot<E51S_SNAPSHOTS){
        let ws:i32=snapshot*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=snapshot*E51P_MAX_CELLS;
        let dpt:i32=0; let dpc:i32=0; let dnt:i32=0; let dnc:i32=0;
        e51p_expert_sign_accuracy(dev_records,sign_targets,E51S_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51S_CELLS,snapshot_weights,ws,snapshot_biases,bs,&dpt,&dpc,&dnt,&dnc);
        let vpt:i32=0; let vpc:i32=0; let vnt:i32=0; let vnc:i32=0;
        e51p_expert_sign_accuracy(validation_records,validation_targets,E51S_VALIDATION_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51S_CELLS,snapshot_weights,ws,snapshot_biases,bs,&vpt,&vpc,&vnt,&vnc);
        let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51p_expert_reachability(validation_records,validation_types,E51S_VALIDATION_EPISODES,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,E51S_CELLS,snapshot_weights,ws,snapshot_biases,bs,&kt,&kr,&nt,&nr);
        known_results[snapshot]=kr; unknown_results[snapshot]=nr;
        if(kr==kt && nr==nt && exact_gate==0){ exact_gate=1; winning_snapshot=snapshot; }
        _zag_print("e51s_validation,"); e45_print_i32(snapshot); _zag_print(","); e45_print_i32(e51s_sweep_snapshot(snapshot)); _zag_print(","); e45_print_i32(snapshot_sweeps[snapshot]); _zag_print(","); e45_print_i32(snapshot_updates[snapshot]); _zag_print(","); e45_print_i32(dpc); _zag_print(","); e45_print_i32(dpt); _zag_print(","); e45_print_i32(dnc); _zag_print(","); e45_print_i32(dnt); _zag_print(","); e45_print_i32(vpc); _zag_print(","); e45_print_i32(vpt); _zag_print(","); e45_print_i32(vnc); _zag_print(","); e45_print_i32(vnt); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_println("");
        snapshot=snapshot+1;
    }

    let extended_signal:i32=0;
    if(snapshot_sweeps[2]==192 && known_results[2]>=known_results[1] && unknown_results[2]>=unknown_results[1] && (known_results[2]>known_results[1] || unknown_results[2]>unknown_results[1])){ extended_signal=1; }
    let tradeoff:i32=0;
    if((known_results[2]>known_results[1] && unknown_results[2]<unknown_results[1]) || (known_results[2]<known_results[1] && unknown_results[2]>unknown_results[1])){ tradeoff=1; }

    let counts_gate:i32=0;
    if(canonical_episode==E51S_VALIDATION_EPISODES && E51S_DEV_EPISODES*(E45_TAPE+1)==E51S_DEV_SAMPLES && E51S_VALIDATION_EPISODES*(E45_TAPE+1)==E51S_VALIDATION_SAMPLES){ counts_gate=1; }
    let target_gate:i32=0;
    if(dev_unknown_nonzero==0 && validation_unknown_nonzero==0 && unknown_parameter_nonzero==0 && dev_positive>0 && dev_negative>0){ target_gate=1; }
    let integrity_gate:i32=0;
    if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && tree_identity_gate==1 && tree_strict_f==1 && tree_strict_r==1 && tree_count_f>=E51S_CELLS && expert_identity_gate==1 && strict_f==1 && strict_r==1){ integrity_gate=1; }
    e45_print_pair("e51s_counts_gate",counts_gate); e45_print_pair("e51s_target_geometry_gate",target_gate); e45_print_pair("e51s_integrity_gate",integrity_gate);
    e45_print_pair("e51s_exact_validation_gate",exact_gate); e45_print_pair("e51s_winning_snapshot",winning_snapshot); e45_print_pair("e51s_extended_optimization_signal",extended_signal); e45_print_pair("e51s_tradeoff",tradeoff);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(integrity_gate==1 && exact_gate==1 && winning_snapshot>=0){
        let confirm_records:[]i32=zalloc_i(E51S_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_dummy:[]i32=zalloc_i(E51S_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_types:[]i32=zalloc_i(E51S_CONFIRM_EPISODES);
        e45_zero(confirm_records,E51S_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(confirm_dummy,E51S_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<40){
                        let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                        confirm_types[canonical_episode]=0; if(mode==0 || mode==1){ confirm_types[canonical_episode]=1; }
                        e51e_build_training_episode(confirmation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,confirm_records,confirm_dummy,&confirm_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        let ws:i32=winning_snapshot*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=winning_snapshot*E51P_MAX_CELLS;
        let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51p_expert_reachability(confirm_records,confirm_types,E51S_CONFIRM_EPISODES,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,E51S_CELLS,snapshot_weights,ws,snapshot_biases,bs,&kt,&kr,&nt,&nr);
        confirmation_executed=canonical_episode;
        if(kr==kt && nr==nt && confirm_unknown_nonzero==0){ confirmation_exact=1; }
        _zag_print("e51s_confirmation,"); e45_print_i32(winning_snapshot); _zag_print(","); e45_print_i32(e51s_sweep_snapshot(winning_snapshot)); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_print(","); e45_print_i32(confirm_unknown_nonzero); _zag_println("");
        zfree(confirm_records); zfree(confirm_dummy); zfree(confirm_types);
    }
    e45_print_pair("e51s_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51s_confirmation_exact_gate",confirmation_exact);

    if(integrity_gate==0){ _zag_println("e51s_outcome,INVALID_EXTENDED_OPTIMIZATION_INTEGRITY_FAILURE");
    }else{
        if(exact_gate==1){
            if(confirmation_exact==1){ _zag_println("e51s_outcome,EXTENDED_OPTIMIZATION_RESCUE_CONFIRMED");
            }else{ _zag_println("e51s_outcome,EXTENDED_OPTIMIZATION_VALIDATION_RESCUE_CONFIRMATION_FAIL"); }
        }else{
            if(extended_signal==1){ _zag_println("e51s_outcome,EXTENDED_OPTIMIZATION_SIGNAL");
            }else{
                if(tradeoff==1){ _zag_println("e51s_outcome,EXTENDED_OPTIMIZATION_TRADEOFF");
                }else{ _zag_println("e51s_outcome,EXTENDED_OPTIMIZATION_CAPABILITY_PLATEAU"); }
            }
        }
    }
    _zag_println("TNN_R32_E51S_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(validation_worlds); zfree(confirmation_worlds); zfree(dev_records);
    zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases);
    zfree(sign_targets); zfree(global_weights); zfree(reverse_global);
    zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root);
    zfree(snapshot_weights); zfree(snapshot_biases); zfree(snapshot_updates); zfree(snapshot_sweeps); zfree(snapshot_reasons); zfree(snapshot_traces); zfree(snapshot_loss_low); zfree(snapshot_loss_high);
    zfree(reverse_weights); zfree(reverse_biases); zfree(reverse_updates); zfree(reverse_sweeps); zfree(reverse_reasons); zfree(reverse_traces); zfree(reverse_loss_low); zfree(reverse_loss_high);
    zfree(validation_records); zfree(validation_types); zfree(validation_targets); zfree(known_results); zfree(unknown_results);
    if(integrity_gate==1){ return 1; }
    return 0;
}

// R32 E51R — same 32-cell conditional-weight architecture, variable optimizer dose.
// No representation, routing, action-order, UNKNOWN, or topology change.

const E51R_DEV_EPISODES:i32=12960;
const E51R_DEV_SAMPLES:i32=220320;
const E51R_VALIDATION_EPISODES:i32=5400;
const E51R_VALIDATION_SAMPLES:i32=91800;
const E51R_CONFIRM_EPISODES:i32=10800;
const E51R_CONFIRM_SAMPLES:i32=183600;
const E51R_STAGE_DEV:i32=65;
const E51R_STAGE_VALIDATION:i32=66;
const E51R_STAGE_CONFIRM:i32=67;
const E51R_ARMS:i32=3;
const E51R_CELLS:i32=32;

fn e51r_sweep_limit(arm:i32)i32 {
    if(arm==0){ return 12; }
    if(arm==1){ return 24; }
    return 48;
}

fn e51r_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0;
    while(i<E51R_DEV_EPISODES){ dev[i]=e51n_world_id(E51R_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51R_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51R_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51R_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51R_STAGE_CONFIRM,i); i=i+1; }
    let dev_lo:i32=dev[0]; let dev_hi:i32=dev[E51R_DEV_EPISODES-1];
    let val_lo:i32=validation[0]; let val_hi:i32=validation[E51R_VALIDATION_EPISODES-1];
    let con_lo:i32=confirmation[0]; let con_hi:i32=confirmation[E51R_CONFIRM_EPISODES-1];
    let partition_gate:i32=0; if(dev_hi<val_lo && val_hi<con_lo){ partition_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=0;
    while(domain<5){
        let lo:i64=e51n_domain_state(dev_lo,domain); let hi:i64=e51n_domain_state(con_hi,domain);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let olo:i64=e51n_domain_state(dev_lo,other); let ohi:i64=e51n_domain_state(con_hi,other);
            if(!(hi<olo || ohi<lo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51r_world_id_dev_lo",dev_lo); e45_print_pair("e51r_world_id_dev_hi",dev_hi);
    e45_print_pair("e51r_world_id_validation_lo",val_lo); e45_print_pair("e51r_world_id_validation_hi",val_hi);
    e45_print_pair("e51r_world_id_confirmation_lo",con_lo); e45_print_pair("e51r_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51r_world_partition_gate",partition_gate); e45_print_pair("e51r_domain_initial_state_gate",domain_gate); e45_print_pair("e51r_world_assignment_failures",0);
    if(partition_gate==1 && domain_gate==1){ return 1; }
    return 0;
}

fn e51r_fit_experts(
    records:[]i32,
    targets:[]i32,
    count:i32,
    global_weights:[]i32,
    global_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    cells:i32,
    sweep_limit:i32,
    reverse:i32,
    expert_weights:[]i32,
    weight_start:i32,
    expert_biases:[]i32,
    bias_start:i32,
    accepted_updates:*i32,
    accepted_sweeps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss:*i64,
    strict_loss_gate:*i32
)void {
    let cell:i32=0;
    while(cell<cells){
        expert_biases[bias_start+cell]=0;
        let feature:i32=0;
        while(feature<E45_FEATURES){ expert_weights[weight_start+cell*E45_FEATURES+feature]=0; feature=feature+1; }
        cell=cell+1;
    }
    let assignments:[]i32=zalloc_i(count);
    let residuals:[]i32=zalloc_i(count);
    let heads:[]i32=zalloc_i(cells);
    let next:[]i32=zalloc_i(count);
    cell=0; while(cell<cells){ heads[cell]=-1; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal;
        if(reverse==1){ index=count-1-traversal; }
        let record_start:i32=index*E50_RECORD_N;
        let routed:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,cells);
        assignments[index]=routed;
        let base:i32=e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias);
        residuals[index]=targets[index]-base;
        next[index]=heads[routed]; heads[routed]=index;
        traversal=traversal+1;
    }
    let current_loss:i64=0;
    traversal=0;
    while(traversal<count){ let r:i64=residuals[traversal] as i64; current_loss=current_loss+r*r; traversal=traversal+1; }
    accepted_updates.*=0; accepted_sweeps.*=0; stop_reason.*=2; trace_hash.*=3109+sweep_limit; strict_loss_gate.*=1;
    let sweep:i32=0;
    while(sweep<sweep_limit){
        let accepted_this_sweep:i32=0;
        cell=0;
        while(cell<cells){
            let coordinate:i32=0;
            while(coordinate<=E45_FEATURES){
                let numerator:i64=0; let denominator:i64=0; let before:i64=0;
                let index:i32=heads[cell];
                while(index>=0){
                    let x:i32=1000;
                    if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                    let r:i64=residuals[index] as i64;
                    numerator=numerator+r*(x as i64); denominator=denominator+(x as i64)*(x as i64); before=before+r*r;
                    index=next[index];
                }
                if(denominator>0){
                    let raw_delta:i64=numerator*1000/denominator;
                    let old_value:i32=expert_biases[bias_start+cell]; let lo:i32=-4000; let hi:i32=4000;
                    if(coordinate>0){ old_value=expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]; lo=-16000; hi=16000; }
                    let proposed:i32=e51m_clamp_i64((old_value as i64)+raw_delta,lo,hi);
                    let delta:i32=proposed-old_value;
                    let accepted_coordinate:i32=0;
                    while(delta!=0 && accepted_coordinate==0){
                        let after:i64=0; index=heads[cell];
                        while(index>=0){
                            let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                            let nr:i32=residuals[index]-delta*x/1000;
                            after=after+(nr as i64)*(nr as i64); index=next[index];
                        }
                        if(after<before){
                            index=heads[cell];
                            while(index>=0){
                                let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                                residuals[index]=residuals[index]-delta*x/1000; index=next[index];
                            }
                            if(coordinate==0){ expert_biases[bias_start+cell]=old_value+delta;
                            }else{ expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]=old_value+delta; }
                            current_loss=current_loss+(after-before);
                            if(after>=before){ strict_loss_gate.*=0; }
                            accepted_coordinate=1; accepted_this_sweep=1; accepted_updates.*=accepted_updates.*+1;
                            trace_hash.*=e46_hash_update(trace_hash.*,cell); trace_hash.*=e46_hash_update(trace_hash.*,coordinate); trace_hash.*=e46_hash_update(trace_hash.*,delta); trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
                        }else{ delta=delta/2; }
                    }
                }
                coordinate=coordinate+1;
            }
            cell=cell+1;
        }
        if(accepted_this_sweep==0){ stop_reason.*=1; break; }
        accepted_sweeps.*=accepted_sweeps.*+1; sweep=sweep+1;
    }
    final_loss.*=current_loss;
    zfree(assignments); zfree(residuals); zfree(heads); zfree(next);
}

fn e51r_expert_identity(
    weights_a:[]i32,wa:i32,bias_a:[]i32,ba:i32,
    weights_b:[]i32,wb:i32,bias_b:[]i32,bb:i32,cells:i32,
    updates_a:i32,updates_b:i32,sweeps_a:i32,sweeps_b:i32,reason_a:i32,reason_b:i32,trace_a:i32,trace_b:i32,loss_a:i64,loss_b:i64,strict_a:i32,strict_b:i32
)i32 {
    return e51p_expert_identity(weights_a,wa,bias_a,ba,weights_b,wb,bias_b,bb,cells,updates_a,updates_b,sweeps_a,sweeps_b,reason_a,reason_b,trace_a,trace_b,loss_a,loss_b,strict_a,strict_b);
}
